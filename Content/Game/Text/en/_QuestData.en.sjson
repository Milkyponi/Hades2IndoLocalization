      Speaker = "Moros"
      Event = "QuestDreamClearedWithShrinePoints.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0598"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dewa kematian nun jauh di sana, menggenggam Descura... tapi kapan?"
      Speaker = "Moros"
