      Event = "QuestDeliverHelAspect.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0603"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Perwujudan kehancuran, menggenggam Xinth... tapi demi tujuan apa?"
      Speaker = "Moros"
      Event = "QuestDeliverShivaAspect.CashedOutVoiceLines"
    }
    {
      Id = "Melinoe_5940"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harus kuapakan kau ini, Narcissus...?"
      Speaker = "Melinoe"
      Event = "QuestHelpNarcissusAndEcho.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_5941"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Narcissus dan Echo harus menyelesaikan urusan di antara mereka..."
      Speaker = "Melinoe"
      Event = "QuestHelpNarcissusAndEcho.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_5942"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan baik-baik saja, Narcissus..."
      Speaker = "Melinoe"
      Event = "QuestHelpNarcissusAndEcho.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_5943"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati Echo yang hancur bisa pulih seiring berjalannya waktu..."
      Speaker = "Melinoe"
      Event = "QuestHelpNarcissusAndEcho.OnViewedVoiceLines"
    }
    {
      Id = "Moros_0278"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dua Jiwa yang pernah terikat, akhirnya terurai juga."
      Speaker = "Moros"
      Event = "QuestHelpNarcissusAndEcho.CashedOutVoiceLines"
    }
    {
      Id = "Storyteller_0552"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hanya ada dua hal yang sanggup menggoyahkan dewa maupun fana: rajutan takdir para Moira, dan dambaan lubuk hati kita."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0553"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bagi Narcissus yang narsis, hatinya tak mendambakan siapa pun selain dirinya. Namun bagi Echo yang dirundung asmara, hatinya hanya mendambakan pria itu. Keduanya tak berdaya melawan perasaan masing-masing."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0554"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hingga akhirnya mereka bertemu Putri Kematian Melinoë, yang membantu mereka memahami rasa pedih yang membelenggu hidup mereka."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0555"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Untungnya, hati cenderung kuat, dan bahkan hati yang hancur pun bisa pulih... bahkan terkadang tumbuh lebih tangguh dari sebelumnya, terlepas dari bekas luka yang ada."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0556"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Begitu pula dengan Narcissus dan Echo. Andaikan dulu mereka adalah korban dari gejolak asmara mereka, kini keduanya menjadi lebih bijak, dan berterima kasih kepada sang Putri, masing-masing pada gilirannya."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0557"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dari teladan mereka, semoga kita semua bisa merenungkan apa yang kita miliki, dan apa yang telah sirna; dua sisi diri kita yang membentuk satu keutuhan."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Melinoe_5871"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kehilangan kitalah yang membentuk siapa diri kita..."
      Speaker = "Melinoe"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Moros_0629"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa kita berdua tahu hal ini pasti akan terjadi."
      Speaker = "Moros"
      Event = "QuestHelpMedea.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0610"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan diuji oleh biduanita dari kedalaman samudra."
      Speaker = "Moros"
      Event = "QuestHelpCirce.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chaos pasti punya rencana yang lebih besar untukmu."
