{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _QuestData.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "Melinoe_2317"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ramalan tentang Sang Malapetaka?"
      Speaker = "Melinoe"
      Event = "QuestUnlockMoros.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_2318"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku harus mencari Tuan Moros sekali lagi, dan memanggilnya ke sini..."
      Speaker = "Melinoe"
      Event = "QuestUnlockMoros.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_1728"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Moros sudah tiba... sekarang bagaimana...?"
      Speaker = "Melinoe"
      Event = "QuestUnlockMoros.CashedOutVoiceLines"
    }
    {
      Id = "Melinoe_4725"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Syukurlah pada Tiga Takdir..."
      Speaker = "Melinoe"
      Event = "QuestWakeHypnos.CashedOutVoiceLines"
    }
    {
      Id = "Storyteller_0558"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mimpi-mimpi buruk adalah satu-satunya hal yang pernah dikenal Putri Dunia Bawah, Melinoë, selagi ia tumbuh semakin kuat di Persimpangan antaralam."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0559"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Terkadang, mimpi buruk mengguncang jiwanya hingga ke palung terdalam. Namun, pemandangan Hypnos yang damai dan senantiasa tertidur pulas—Sang Wujud Tidur itu sendiri—selalu memantapkan kembali tekadnya."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0560"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ia mendambakan untuk memahami misteri alam bawah sadar, demi membangkitkan pelayan Wangsa Hades ini dari tidur panjangnya yang tak berkesudahan."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0561"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dan andai bukan karena pengabdian itu, Melinoë mungkin takkan pernah bersua dengan kakaknya, Zagreus, jauh di dalam kabut kenangan, lalu melangkah maju menuntaskan tugas takdirnya."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0562"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Siapa lagi selain Hypnos yang bisa begitu berguna dalam tidurnya? Melinoë akhirnya berhasil membangunkannya, namun ia bergegas pergi dengan amat terburu-buru, saking bersemangatnya untuk kembali bekerja."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0563"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Namun ia akan sering memikirkan Sang Putri yang menghantui mimpi-mimpinya, dan dengan berbuat demikian turut menenangkan mimpi sang Putri sendiri. Dan ia berjanji pada dirinya kelak akan mengunjunginya lagi."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Melinoe_5913"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Awas saja kalau tidak..."
      Speaker = "Melinoe"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Melinoe_5914"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya di dalam mimpiku."
      Speaker = "Melinoe"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Melinoe_5947"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang kau sembunyikan dari dirimu sendiri, Odisius...?"
      Speaker = "Melinoe"
      Event = "QuestHelpOdysseus.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_5948"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pernah mengarungi rintangan yang lebih buruk, Odisius..."
      Speaker = "Melinoe"
      Event = "QuestHelpOdysseus.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_5949"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak butuh Daftar Takdir untuk tahu Odisius pasti akan kembali."
      Speaker = "Melinoe"
      Event = "QuestHelpOdysseus.OnViewedVoiceLines"
    }
    {
      Id = "Moros_0587"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Ahli Taktik Ulung telah membaringkan bayang-bayang masa lalunya dalam damai."
      Speaker = "Moros"
      Event = "QuestHelpOdysseus.CashedOutVoiceLines"
    }
    {
      Id = "Storyteller_0534"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Begitu sarat kisah masa lalu Odisius yang penuh akal hingga hal itu membebaninya teramat berat, bukan hanya semasa hidupnya melainkan juga dalam kematian."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0535"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tugas rahasianya adalah memperhitungkan bahaya yang akan dihadapi Putri Dunia Bawah selama mengemban tugas takdirnya; namun ia tak pernah menduga sang Putri akan berbuat begitu banyak untuknya."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0536"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Melalui persahabatan dan keahliannya, Sang Putri meretas jalan bagi Odisius yang kalut untuk akhirnya mengubur masa lalunya, berdamai sedapat mungkin selagi meninggalkan sisanya di belakang."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0537"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Rasa cinta dan benci lama mungkin memudar seiring waktu, namun tak pernah benar-benar lenyap. Keduanya adalah arwah yang tak pernah tenang, sama seperti kita semua."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0538"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kini perangai santai Sang Ahli Taktik Ulung bukan lagi sekadar topeng, dan mereka yang ia kasihi tahu ke mana harus mencarinya."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0539"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dan meski keberadaannya mungkin tak diketahui siapa pun selain mereka, kisah-kisah petualangan agungnya akan tersohor ke seantero jagat."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Melinoe_5868"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau adalah pahlawan bagi kami semua, Odisius."
      Speaker = "Melinoe"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Moros_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kiklop itu pernah mencicipi kekalahan sebelumnya."
      Speaker = "Moros"
      Event = "QuestMeetCyclopsWithOdysseusKeepsake.CashedOutVoiceLines"
    }
    {
      Id = "Melinoe_5937"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita bisa melakukannya, Arakhne..."
      Speaker = "Melinoe"
      Event = "QuestHelpArachne.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_5938"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kumohon berbelaskasihanlah, Nyonya Athena..."
      Speaker = "Melinoe"
      Event = "QuestHelpArachne.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_5939"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Arakhne, apa kau bakal baik-baik saja...?"
      Speaker = "Melinoe"
      Event = "QuestHelpArachne.OnViewedVoiceLines"
    }
    {
      Id = "Moros_0588"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang penenun bernama Arakhne memilih Takdirnya sendiri."
      Speaker = "Moros"
      Event = "QuestHelpArachne.CashedOutVoiceLines"
    }
    {
      Id = "Storyteller_0540"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tatkala insan fana berhasrat mencapai taraf dewa, para dewa kerap turun tangan sendiri untuk membuat mereka sadar diri. Si kecil Arakhne hanyalah satu dari sekian contohnya."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0541"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sekian lama ia nestapa dalam rupa seekor laba-laba, hingga Putri Dunia Bawah Melinoë tergerak untuk campur tangan, dan berupaya melenyapkan kutukan Arakhne."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0542"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sang penenun tak pernah kembali ke wujud asalnya; ia malah memilih untuk mempertahankan martabat dan harga dirinya. Namun kebaikan yang dicurahkan Melinoë tetaplah mengubah jalan hidupnya."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0543"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sebab jiwa luhur Arakhne kini menyala lebih benderang dari sebelumnya. Dan kutukan benci diri serta penyesalan, yang akan terus membuntutinya dalam wujud apa pun, kini telah sirna."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0544"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ia dan kita semua kini menginsafi bahwa dewa dan insan fana bisa sangat serupa; baik dalam sisi mulia, maupun sisi celanya. Dan mereka pun bisa menjadi sedekat jiwa mana pun."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0545"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Maka, andai para dewa menjadikannya sebuah contoh pelajaran, Arakhne pun menjadi pengingat: Hal-hal baik terkadang hadir dalam rupa yang mungil; dan dunia membutuhkan laba-laba."
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Melinoe_5869"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bahagia kau tetap menjadi dirimu sendiri, Arakhne..."
      Speaker = "Melinoe"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Melinoe_5944"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang Titan itu ketahui tentang temanku...?"
      Speaker = "Melinoe"
      Event = "QuestHelpDora.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_5945"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dora ingin mengingatnya... Aku bisa melakukan sesuatu untuk membantunya."
      Speaker = "Melinoe"
      Event = "QuestHelpDora.OnViewedVoiceLines"
    }
    {
      Id = "Melinoe_5946"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita akan lalui ini bersama, Dora..."
      Speaker = "Melinoe"
      Event = "QuestHelpDora.OnViewedVoiceLines"
    }
    {
      Id = "Moros_0586"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Arwah yang kita kenal sebagai Dora tak gentar oleh masa lalunya."
      Speaker = "Moros"
      Event = "QuestHelpDora.CashedOutVoiceLines"
    }
    {
      Id = "Storyteller_0546"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Siapakah yang melepaskan kejahatan dunia ini kepada kita semua? Apakah para dewa yang berhati dingin, ataukah kita sendiri, orang-orang bodoh ini?{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0547"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Arwah bernama Dora tampaknya tak peduli. Namun persahabatannya dengan Putri Kematian kita, Melinoë, menyingkapkan suatu kebenaran dalam dirinya yang menolak tuk terus terpendam:{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0548"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Masa lalu menghantui kita selamanya. Kita tak bisa lari darinya selamanya. Kita tak bisa melupakannya selamanya.{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0549"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kita boleh mencoba mengabaikannya, seperti yang Dora lakukan; atau, kita bisa mencoba menerimanya, seperti yang kini Dora lakukan, berkat dorongan sang Putri.{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0550"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kisah tentang bagaimana kita para manusia fana kehilangan kepolosan sudah tersohor, dan di dalamnya, Dora memainkan peran penting. Namun kisahnya bukanlah semata-mata kisah nestapa.{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0551"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ini adalah kisah tentang menemukan harapan di tempat yang paling tak terduga. Ini adalah kisah tentang bagaimana kita menjadi seperti sekarang. Dan Dora, setidaknya, kini menjadi persis seperti apa yang dia inginkan.{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Melinoe_5870"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia sempurna."
      Speaker = "Melinoe"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Moros_0240"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Engkau akan selalu melangkah di bawah sinar Rembulan."
      Speaker = "Moros"
      Event = "QuestDarkSorceries.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0279"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Takdir paham betul segalanya tentang menyusun daftar."
      Speaker = "Moros"
      Event = "QuestPurchasePinnedItems.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa pun yang meresahkanmu, kawan amfibimu akan selalu mendengarkan."
      Speaker = "Moros"
      Event = "QuestPetFrog.CashedOutVoiceLines"
    }
    {
      Id = "Melinoe_1730"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Takdir sudah menduga aku akan sampai sejauh ini..."
      Speaker = "Melinoe"
      Event = "QuestBeatHecate.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Langkah yang memang harus ditempuh di sepanjang jalanmu."
      Speaker = "Moros"
      Event = "QuestBeatHecate.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0594"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah menjadi takdirmu sejak lama tuk menyandang setiap Senjata Nokturnal."
      Speaker = "Moros"
      Event = "QuestUnlockAllWeapons.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0620"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Engkau akan menguasai berbagai wujud dari Senjata Nokturnal."
      Speaker = "Moros"
      Event = "QuestUnlockAllWeaponAspects.CashedOutVoiceLines"
    }
    {
      Id = "Melinoe_1901"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, ini berhasil rupanya."
      Speaker = "Melinoe"
      Event = "QuestGiftNectar.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedermawananmu takkan pernah dilupakan."
      Speaker = "Moros"
      Event = "QuestGiftNectar.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Langit itu sendiri senantiasa menerimamu."
      Speaker = "Moros"
      Event = "QuestZeusUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lautan luas tunduk pada panggilanmu."
      Speaker = "Moros"
      Event = "QuestPoseidonUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cahaya mentari bersinar hanya untukmu."
      Speaker = "Moros"
      Event = "QuestApolloUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0230"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nenekmu adalah sekutu yang luar biasa kuat."
      Speaker = "Moros"
      Event = "QuestDemeterUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0232"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sangat setialah sang dewi perapian."
      Speaker = "Moros"
      Event = "QuestHestiaUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang dewa perang memberimu kehausan akan darah."
      Speaker = "Moros"
      Event = "QuestAresUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0231"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang dewi cinta punya rencana lanjutan untukmu."
      Speaker = "Moros"
      Event = "QuestAphroditeUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang dewa penempa akan selalu mendukungmu."
      Speaker = "Moros"
      Event = "QuestHephaestusUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ratu Olimpus berpihak kepadamu."
      Speaker = "Moros"
      Event = "QuestHeraUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0234"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang utusan akan terus memberimu kabar terkini."
      Speaker = "Moros"
      Event = "QuestHermesUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau dan sang dewi perburuan memiliki banyak kemiripan."
      Speaker = "Moros"
      Event = "QuestArtemisUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0238"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang dewi bermata kelabu akan senantiasa mengawasimu."
      Speaker = "Moros"
      Event = "QuestAthenaUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang dewa anggur akan membantumu menenangkan pikiran."
      Speaker = "Moros"
      Event = "QuestDionysusUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekacauan adalah sumber kehidupan, beserta seluruh kesukarannya."
      Speaker = "Moros"
      Event = "QuestChaosCurses.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berkat tertua yang pernah ada akan menjadi milikmu."
      Speaker = "Moros"
      Event = "QuestChaosBlessings.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0607"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para dewa mungkin tak selalu bersatu, tapi untuk saat ini, mereka searah."
      Speaker = "Moros"
      Event = "QuestSynergyUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0608"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua berkat agung para dewa akan menjadi milikmu."
      Speaker = "Moros"
      Event = "QuestLegendaryUpgrades.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0284"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saudaraku Charon begitu mengabdi pada alam ini."
      Speaker = "Moros"
      Event = "QuestWellShopItems.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih banyak yang harus kau pelajari dari buku itu..."
      Speaker = "Moros"
      Event = "QuestCodexSmall.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0592"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Persimpangan Jalan ini kelak akan berkembang lebih pesat dari sebelumnya."
      Speaker = "Moros"
      Event = "QuestCosmeticsSmall.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua yang kau ambil dari bumi kelak akan dikembalikan."
      Speaker = "Moros"
      Event = "QuestToolsUnlocks.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0595"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana bisa Tiga Moira meramalkan ini jika mereka..."
      Speaker = "Moros"
      Event = "QuestFirstUnderworldClear.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0596"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkinkah para Moira sudah memperkirakan pendakianmu...?"
      Speaker = "Moros"
      Event = "QuestFirstSurfaceClear.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0597"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tiap Senjata Nokturnal akan mengobarkan perang di surga."
      Speaker = "Moros"
      Event = "QuestBeatTyphonWithWeapons.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0590"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saudaraku, si Dewa Tidur, pada akhirnya pasti akan terbangun..."
