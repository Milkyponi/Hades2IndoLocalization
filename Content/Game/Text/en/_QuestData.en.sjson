      Event = "QuestCollectDreamPoints.CashedOutVoiceLines"
    }
    {
      Id = "Moros_0622"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Penaklukanmu bersama Senjata Nokturnal takkan terhitung jumlahnya."
