    }
    {
      Id = "Melinoe_5156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Fates... mereka sudah dekat..."
      Speaker = "Melinoe"
      Event = "QuestRescueFatesTrue.OnViewedVoiceLines"
    }
    {
      Id = "Moros_0613"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Entah bagaimana, akhirnya kau berhasil menemukan saudari-saudariku..."
      Speaker = "Moros"
      Event = "QuestRescueFatesTrue.CashedOutVoiceLines"
    }
    {
      Id = "Storyteller_0475"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Demikianlah Tiga Fates yang mengasingkan diri dan ditakuti, yang tenunan tak terduganya menentukan segala hal yang akan terjadi bahkan bagi para dewa, memaklumkan fajar era baru...{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0476"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...suatu era di mana manusia fana dan abadi akan bebas memilih jalan mereka, selama mereka percaya bahwa pilihan itu ada...{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0477"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...era keemasan, di mana umat manusia tak lagi diperintah seutuhnya oleh hak ilahi, melainkan oleh diri mereka sendiri.{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0478"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kabar menyebar dengan cepat, dari puncak Olympus hingga dasar terdalam Underworld, menubuatkan masa depan yang mungkin masih sangat, sangat jauh namun sarat akan kemungkinan dan ketidaktahuan.{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Banyak yang bersukacita; namun yang lain tahu bahwa para dewa takkan menyerah begitu saja, dan sejarah akan berulang.{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
      Id = "Storyteller_0480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Untuk saat ini, kita hanya bisa memanfaatkan Waktu yang kita miliki; baik untuk bersiap, maupun, sebaik mungkin, untuk hidup.{#Prev}"
      Speaker = "Storyteller"
      Event = "InterstitialData.VoiceLines"
    }
    {
