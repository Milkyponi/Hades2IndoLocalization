    }
    {
      Id = "MelinoeField_2044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku merasa... tak terhentikan..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak ada urutan pasti untuk Ujian ini."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuserahkan rincian Ujian ini agar kau cari tahu sendiri."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah Ujian ini akan berjalan sesuai perkiraan kita, mari kita buktikan."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0311"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutentukan setiap rincian Ujian ini secara acak."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0313"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini tidak akan berjalan seperti sebelumnya."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0314"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau boleh mencoba mencari polanya, tapi kau takkan berhasil."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0315"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ujian ini tidak memiliki ketetapan sama sekali."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0316"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bahkan belum mempertimbangkan semua kemungkinan yang ada di sini."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin sebaiknya kau berhenti mencoba Ujian ini untuk sementara."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0249"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin jika senjatamu lebih kuat? Atau mungkin tidak juga."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku punya waktu abadi untuk semua percobaan ini; apakah kau juga?"
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lanjutkan saja Ujian ini jika itu memang maumu."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kegagalan berulang kali tak masalah bagiku, karena itu cukup menghibur."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kegagalanmu sebelumnya dalam Ujian ini sangat menarik untuk diamati."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ujian ini terbukti sulit, namun kau tetap mencobanya lagi."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupikir Ujian ini mungkin terlalu sulit untukmu."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cobalah sesukamu; upaya berulangmu cukup menarik bagiku."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita pernah melewati ini sebelumnya, dan akan melakukannya lagi."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pengulangan terkadang diperlukan demi mencapai keberhasilan."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku penasaran ingin melihat apakah kau akan gagal lagi dalam Ujian ini."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0238"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akankah Ujian ini kembali terasa terlalu berat bagimu?"
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0232"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kaulah variabel penentunya dalam Ujian ini, Keturunan Hades."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0234"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Suatu Ujian mungkin membutuhkan beberapa kali percobaan."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam ini telah Kuatur sedemikian rupa, serupa dengan yang pernah kau lalui."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0240"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin kali ini kau punya gambaran yang lebih baik tentang apa yang akan dihadapi."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuhargai kesediaanmu untuk mencoba kembali Ujian ini."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini Ujian yang sudah kau kenal; namun hasilnya masih bisa berubah."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tertarik melihat apa yang akan kau lakukan secara berbeda kali ini."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengan demikian Ujian kita dimulai, wahai Keturunan Hades."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Balas dendam adalah dorongan nafsu yang ingin kupahami lebih baik."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0265"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Emas mengalir bebas di seluruh alam kekuasaanku; ambillah."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita lihat apakah sang Pengguncang Bumi mampu membuktikan julukannya."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0277"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini adalah Ujian kekuatan, jadi gunakanlah dengan cermat."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dewa pandai besi itu sendiri sedikit banyak memahami soal penciptaan."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0275"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini adalah Ujian kehancuran, jadi cobalah tunjukkan apa yang sanggup kau lakukan."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak berminat melihat sang dewa cahaya, hanya kekuatannya saja."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hawa dingin yang dibawa oleh sang dewi musim, Aku mengenalnya dengan sangat baik."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang dewi cinta sudah sangat terbiasa diperhatikan."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0273"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang dewi perapian, beserta potensi dari kobaran apinya..."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0276"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini adalah Ujian kecepatan, jadi jangan ragu-ragu."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau kehilangan kekuatan yang telah kau kumpulkan; namun tidak dengan pengetahuanmu."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bisa melucuti kekuatanmu, tapi bukan pengalamanmu."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0264"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau memiliki ikatan yang kuat dengan Bulan; tunjukkan itu padaku."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Ratu Olimpus memahami ikatan yang terjalin di antara kita."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah para Takdir yang menentukan apa yang terjadi, ataukah dirimu?"
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Raja Olimpus mengendalikan petir, tapi Akulah yang menciptakannya."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tiba di sini cukup cepat, Keturunan Hades."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita mulai Ujian kita saat ini dari titik ini."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mulailah Ujian ini dari titik ini, mulai dari sekarang."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berminat untuk mengevaluasi alam ini."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau boleh langsung melanjutkan, Keturunan Hades."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ujian ini akan berusaha meremukkanmu, Keturunan Hades."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada kemungkinan bahwa Ujian ini memang mustahil diselesaikan, Keturunan Hades."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa kau takkan mampu menuntaskan Ujian ini, tapi silakan dicoba."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Tiga Takdir sendirilah yang menentukan rincian dari Ujian ini."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0230"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuserahkan kendali atas rincian Ujian ini kepada Sang Tiga Takdir."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0231"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengan memilih Ujian ini, semua pilihan lain akan ditentukan untukmu."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0298"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Raja para Dewa Olimpus bergantung pada badainya sebagai perlindungan."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak banyak yang akan bertahan hidup andai dewi pergantian musim menghendakinya."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0300"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Patuhi panggilan dari Ratu Olimpus ini sekarang."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pengaruh Sang Perselisihan menyebar begitu cepat, namun masih bisa diperlambat."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salah satu kerabatmu mendedikasikan dirinya untuk perang; ini dipersembahkan untuknya."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0274"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ujian ini akan membandingkan dirimu dengan pengurus wilayah kekuasaanmu."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuingatkan bahwa Ujian ini kemungkinan besar mustahil bagimu."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau kini semestinya sudah sangat terbiasa dengan kedalaman ini."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini bakal menarik..."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku telah membuat sejumlah penyesuaian pada realitas..."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Perubahan kecil bisa mendatangkan dampak yang sangat besar..."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sedikit perubahan pada jalinan realitas..."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah semua ini sudah selaras dengan rancangan Sang Takdir?"
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
      Id = "Chaos_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari kemungkinan tak terhingga, inilah yang menjadi pilihanmu."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.StartPackagedBountyRunVoiceLines"
    }
    {
