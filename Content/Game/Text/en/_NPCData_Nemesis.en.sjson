      Event = "NPC_Nemesis_01.SpawnVoiceLines"
    }
    {
      Id = "NemesisField_0236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau taruhan kecil-kecilan di sini?"
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.SpawnVoiceLines"
    }
    {
      Id = "NemesisField_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Taruhan aku bakal habisi lebih banyak dari kau."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.SpawnVoiceLines"
    }
    {
      Id = "NemesisField_0238"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mundur, atau tanggung sendiri akibatnya."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.SpawnVoiceLines"
    }
    {
      Id = "NemesisField_0239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kira kau bisa habisi lebih banyak dariku?"
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.SpawnVoiceLines"
    }
    {
      Id = "NemesisField_0240"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan menghalangi jalanku."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.SpawnVoiceLines"
    }
    {
      Id = "NemesisField_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih kira kau bisa mengalahkanku?"
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.SpawnVoiceLines"
    }
    {
      Id = "NemesisField_0242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kira kau lebih hebat? Buktikan."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.SpawnVoiceLines"
    }
    {
      Id = "NemesisField_0243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalahkan aku di sini, Emasku jadi milikmu."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.SpawnVoiceLines"
    }
    {
      Id = "NemesisField_0244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau aku habisi lebih banyak, Emasmu jadi milikku."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.SpawnVoiceLines"
    }
    {
      Id = "NemesisField_0245"
