    }
    {
      Id = "MelinoeField_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunjukkan kemampuanmu, Nem!"
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Nemesis_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru segitu udah mentok! Pantat kurusmu ditendang balik sampai ke sini. Gila memang, bisa-bisanya beliau menyuruhmu jalan kaki sendirian."
      Speaker = "Nemesis"
      Event = "NemesisFirstMeeting"
    }
    {
      Id = "Melinoe_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau beruntung masih diberi tanggung jawab {#Emph}ini{#Prev}, mengingat kau selalu mempertanyakan perintah dan suka mengeluh."
      Speaker = "Melinoe"
      Event = "NemesisFirstMeeting"
    }
    {
      Id = "Nemesis_0458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halah, diamlah."
      Speaker = "Nemesis"
      Event = "NemesisFirstMeeting"
    }
    {
      Id = "Nemesis_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka tak bakal membantumu, asal kau tahu. Maksudku para Takdir. Mereka tak kenal belas kasihan pada siapa pun yang memohon. Malah-malah, kau cuma bakal memperburuk keadaan."
      Speaker = "Nemesis"
      Event = "NemesisAboutFates01"
    }
    {
      Id = "Melinoe_1541"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau saja yang terlalu meremehkan saudari-saudarimu. Kalau mereka pernah membantu kakakku, pasti ada kemungkinan mereka membantu kita juga. Mereka juga punya kepentingan dalam hal ini."
      Speaker = "Melinoe"
      Event = "NemesisAboutFates01"
    }
    {
      Id = "Nemesis_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, maksudmu urusan {#Emph}keluarga? {#Prev}Boro-boro peduli. Terlalu sibuk mengobrak-abrik hidup semua orang, lalu membuatnya tampak seperti kecelakaan belaka."
      Speaker = "Nemesis"
      Event = "NemesisAboutFates01"
    }
    {
      Id = "Melinoe_1542"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak boleh membicarakan mereka seperti itu."
      Speaker = "Melinoe"
      Event = "NemesisAboutFates01"
    }
    {
      Id = "Nemesis_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gak habis pikir caramu menjilat para Takdir ternyata beneran berhasil. Gulungan besar di sebelah sana itu... benaran dari mereka?"
      Speaker = "Nemesis"
      Event = "NemesisAboutMoros01"
    }
    {
      Id = "Melinoe_1543"
      InheritFrom = "BaseNarrative"
      DisplayName = "Diantar langsung oleh Tuan Moros sendiri. Beliau tampaknya agak terburu-buru, jadi kami tak sempat mengobrol banyak. Apakah kalian berdua dekat?"
      Speaker = "Melinoe"
      Event = "NemesisAboutMoros01"
    }
    {
      Id = "Nemesis_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami ini anak-anak Nyx; tak ada satu pun dari kami yang dekat. Tapi kami pernah berpapasan. Saat manusia-manusia fana tertentu menerima ganjaran setimpal, kami berdua pasti terlibat."
      Speaker = "Nemesis"
      Event = "NemesisAboutMoros01"
    }
    {
      Id = "Melinoe_1544"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa kubayangkan."
      Speaker = "Melinoe"
      Event = "NemesisAboutMoros01"
    }
    {
      Id = "Nemesis_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gak pernah terpikir bakal melihat Moros di tempat seperti ini. Tapi dipikir-pikir, masuk akal juga kalau Sang Ajal cepat atau lambat bakal mendatangi Persimpangan."
      Speaker = "Nemesis"
      Event = "NemesisAboutMoros02"
    }
    {
      Id = "Melinoe_1545"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bicaramu seolah itu hal yang {#Emph}buruk{#Prev}. Semua keturunan Nyx disambut baik di sini. Kepala Sekolah sudah berjanji."
      Speaker = "Melinoe"
      Event = "NemesisAboutMoros02"
    }
    {
      Id = "Nemesis_0039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah. Sebaiknya aku pergi menyapa..."
      Speaker = "Nemesis"
      Event = "NemesisAboutMoros02"
    }
    {
      Id = "Melinoe_2234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hubunganmu murni urusan bisnis dengan Yang Mulia Charon, kan? Tak pernah kulihat kau bicara dengannya kecuali soal dagangannya. Setidaknya kau memberinya Koin Emas."
      Speaker = "Melinoe"
      Event = "NemesisAboutCharon01"
    }
    {
      Id = "Nemesis_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Secara teknis kau memang punya saudara laki-laki, tapi kau tak tahu rasanya hidup berdampingan dengannya. Charon tak suka banyak bicara; aku menghargai itu."
      Speaker = "Nemesis"
      Event = "NemesisAboutCharon01"
    }
    {
      Id = "Melinoe_2235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Dia sepertinya tak keberatan bicara denganku, dengan caranya sendiri."
      Speaker = "Melinoe"
      Event = "NemesisAboutCharon01"
    }
    {
      Id = "Nemesis_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin karena kau itu {#Emph}istimewa."
      Speaker = "Nemesis"
      Event = "NemesisAboutCharon01"
    }
    {
      Id = "Nemesis_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau mengobrol santai dengan Chaos, dari sekian banyak makhluk... mencoba membujuk kekuatan tertua di dunia untuk memihak? Kekuatan yang pada dasarnya {#Emph}tak memihak{#Prev}. Cerdas sekali."
      Speaker = "Nemesis"
      Event = "NemesisAboutChaos01"
    }
    {
      Id = "Melinoe_3228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepertinya kau sendiri juga mengobrol dengannya! Kulihat kau melompat ke Gerbang Chaos, seolah tahu persis tujuannya. Bukan yang pertama kali, ya?"
      Speaker = "Melinoe"
      Event = "NemesisAboutChaos01"
    }
    {
      Id = "Nemesis_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan urusanmu. Jangan sampai kau berpikir Chaos bakal membantu {#Emph}dirimu {#Prev}dan bukan orang lain. Itu tidak akan adil namanya."
      Speaker = "Nemesis"
      Event = "NemesisAboutChaos01"
    }
    {
      Id = "Melinoe_3229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa memang tidak."
      Speaker = "Melinoe"
      Event = "NemesisAboutChaos01"
    }
    {
      Id = "Nemesis_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar kutebak. Para Takdir cuma memberimu segudang tugas remeh. Tak ada pewahyuan agung, cuma kerja serabutan."
      Speaker = "Nemesis"
      Event = "NemesisAboutQuestLog01"
    }
    {
      Id = "Melinoe_1546"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu diri untuk tidak mempertanyakan rancangan mereka. Ramalan kecil yang terwujud bisa berujung pada terwujudnya ramalan yang lebih besar."
      Speaker = "Melinoe"
      Event = "NemesisAboutQuestLog01"
    }
    {
      Id = "Nemesis_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terus saja yakinkan dirimu begitu."
      Speaker = "Nemesis"
      Event = "NemesisAboutQuestLog01"
    }
    {
      Id = "Nemesis_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita jalan di tempat. Seharusnya aku di luar sana bertarung! Bukan berjaga di tempat yang tak pernah didatangi siapa pun tanpa diundang. Sialan..."
      Speaker = "Nemesis"
      Event = "NemesisAboutTask01"
    }
    {
      Id = "Melinoe_0679"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa keadaan saat ini memang menuntut pengamanan ketat di sekitar sini. Tapi kalau kau tak setuju, proteslah ke Kepala Sekolah, jangan ke aku."
      Speaker = "Melinoe"
      Event = "NemesisAboutTask01"
    }
    {
      Id = "Nemesis_0045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ugh..."
      Speaker = "Nemesis"
      Event = "NemesisAboutTask01"
    }
    {
      Id = "Nemesis_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak pantas menerima ini. Semua ini. Ini tidak adil. Tapi kau telanjur terjebak di dalamnya. Jadi satu-satunya pertanyaan adalah, apa yang bakal kau perbuat sekarang?"
      Speaker = "Nemesis"
      Event = "NemesisAboutTask02"
    }
    {
      Id = "Melinoe_3930"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau akan segera mengetahuinya! Lagipula, bagaimana kau bisa seyakin itu kalau aku tak pantas mengalaminya atau bahwa ini tidak adil?"
      Speaker = "Melinoe"
      Event = "NemesisAboutTask02"
    }
    {
      Id = "Nemesis_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah! {#Prev}Nyaris saja kau membuatku percaya."
      Speaker = "Nemesis"
      Event = "NemesisAboutTask02"
    }
    {
      Id = "Nemesis_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tenang saja, kau tak ketinggalan banyak hal selagi pergi. Cuma banyak berdiri melamun, melantunkan doa demi kemenangan dan keselamatanmu. Ngomong-ngomong, mujarab tidak doa-doa itu?"
      Speaker = "Nemesis"
      Event = "NemesisAboutTask03"
    }
    {
      Id = "Melinoe_1549"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lancar, terima kasih. Dan kurangnya dukungan darimu justru jadi pelecut semangat yang lebih berarti daripada yang kau duga."
      Speaker = "Melinoe"
      Event = "NemesisAboutTask03"
    }
    {
      Id = "Nemesis_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau paham betul rupanya soal kurangnya dukungan..."
      Speaker = "Nemesis"
      Event = "NemesisAboutTask03"
    }
    {
      Id = "Nemesis_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah percobaan ke berapa ini? Untung kawan Titan kita terlalu sibuk meladeni kerabatmu di permukaan sampai tak sempat memedulikanmu."
      Speaker = "Nemesis"
      Event = "NemesisAboutTask04"
    }
    {
      Id = "Melinoe_1568"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf, aku tidak menghitungnya. Aku akan sampai saat waktunya tiba. Tapi pastinya {#Emph}kau {#Prev}bisa mengalahkan Sang Penguasa Titan pada percobaan pertama, kan?"
      Speaker = "Melinoe"
      Event = "NemesisAboutTask04"
    }
    {
      Id = "Nemesis_0082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa kita takkan pernah tahu, ya?"
      Speaker = "Nemesis"
      Event = "NemesisAboutTask04"
    }
    {
      Id = "Nemesis_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu kupikir... kalau saja aku bisa berlatih lebih keras darimu, beliau akan mempertimbangkannya kembali. Dan menyerahkan tugas itu padaku. Aku sudah banting tulang setengah mati. Tapi tak ada gunanya."
      Speaker = "Nemesis"
      Event = "NemesisAboutTraining01"
    }
    {
      Id = "Melinoe_1547"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga bekerja keras. Dan Kepala Sekolah selalu memperjelas peran kita masing-masing. Kau tak bisa mengubah takdir kelahiranmu, begitu pula aku."
      Speaker = "Melinoe"
      Event = "NemesisAboutTraining01"
    }
    {
      Id = "Nemesis_0047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini tidak adil..."
      Speaker = "Nemesis"
      Event = "NemesisAboutTraining01"
    }
    {
      Id = "Nemesis_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngapain kau malah ngajak ngobrol aku? Bawa pantat cekingmu itu balik ke {#Emph}luar {#Prev}sana, dan bereskan Titan itu! Nunggu apa lagi?"
      Speaker = "Nemesis"
      Event = "NemesisAboutWaiting01"
    }
    {
      Id = "Melinoe_1567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kasar sekali!"
      Speaker = "Melinoe"
      Event = "NemesisAboutWaiting01"
    }
    {
      Id = "Nemesis_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percobaan gagal lainnya. Sudah siap menyerah? Kau tak punya bara api itu. Bagimu ini kurang personal."
      Speaker = "Nemesis"
      Event = "NemesisAboutFamily01"
    }
    {
      Id = "Melinoe_1550"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurang {#Emph}personal? {#Prev}Kau juga tak melihat ibuku ada di sini, kan, Nem? Begitu pula ayahku, atau saudaraku. Chronos merenggut mereka semua!"
      Speaker = "Melinoe"
      Event = "NemesisAboutFamily01"
    }
    {
      Id = "Nemesis_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga kehilangan lebih dari sekadar ibuku. Dan aku {#Emph}mengenal {#Prev}ibuku. Memangnya ibumu itu siapa bagi {#Emph}dirimu? {#Prev}Kau bahkan cuma sekadar brojol dari rahimnya."
      Speaker = "Nemesis"
      Event = "NemesisAboutFamily01"
    }
    {
      Id = "Melinoe_1551"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Diam."
      Speaker = "Melinoe"
      Event = "NemesisAboutFamily01"
    }
    {
      Id = "Melinoe_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang kau katakan padaku tadi, soal ibuku. Itu sangat kejam."
      Speaker = "Melinoe"
      Event = "NemesisAboutFamily02"
    }
    {
      Id = "Nemesis_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm{#Prev}. Masuk akal. Kita tak bisa saling membunuh di sini, tapi kita bisa melampiaskannya lewat kata-kata. Kalau kita bertarung sungguhan pun, aku juga takkan menahan diri."
      Speaker = "Nemesis"
      Event = "NemesisAboutFamily02"
    }
    {
      Id = "Melinoe_0603"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukira juga begitu."
      Speaker = "Melinoe"
      Event = "NemesisAboutFamily02"
    }
    {
      Id = "Nemesis_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, bagaimana keadaan mereka? Keluargamu. Ratu Persephone, Pangeran Zagreus, dan siapa pun lagi itu. Dia belum minta pedang ini dikembalikan, kan?"
      Speaker = "Nemesis"
      Event = "NemesisAboutFamily03"
    }
    {
      Id = "Melinoe_5251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia belum menyinggungnya, dia itu... entahlah, aku cukup menyukainya. Mungkin karena aku belum menghabiskan waktu berabad-abad dengannya seperti halnya dengan saudara dari keluarga lain yang kukenal. Dan ibu serta ayahku, mereka... kurasa persis seperti yang kubayangkan."
      Speaker = "Melinoe"
      Event = "NemesisAboutFamily03"
    }
    {
      Id = "Nemesis_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah. Mungkin karena imajinasimu yang menambal banyak kekosongan itu. Tapi, setidaknya kau sudah menemukan mereka, dan ini permulaan yang bagus. Jangan disia-siakan."
      Speaker = "Nemesis"
      Event = "NemesisAboutFamily03"
    }
    {
      Id = "Melinoe_5252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja tidak."
      Speaker = "Melinoe"
      Event = "NemesisAboutFamily03"
    }
    {
      Id = "Nemesis_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katanya kau berhasil menembus sampai ke Tartarus tempo hari. Seberapa jauh kau melangkah? Berhasil pulang sampai ke rumah {#Emph}hakmu{#Prev}?"
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosBossL02"
    }
    {
      Id = "Melinoe_3223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika yang kau maksud adalah Kediaman Hades, ya, aku berhasil sampai ke sana. Meski untuk saat ini, tempat itu lebih tepat disebut Kediaman {#Emph}Chronos{#Prev}. Dia sedang menunggu di dalam, persis seperti dugaanku, dan... dia sangat kuat, persis seperti dugaanku juga."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosBossL02"
    }
    {
      Id = "Nemesis_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Terlalu {#Prev}kuat, maksudmu. Yah, aku tak bisa menyalahkanmu karena sudah mencoba. Jadi apa rencananya sekarang, terus melemparkan dirimu ke arahnya sampai kau benar-benar patah arang? Kalau kau belum merasakannya sekarang?"
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosBossL02"
    }
    {
      Id = "Melinoe_3224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tugasnya tetap sama."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosBossL02"
    }
    {
      Id = "Nemesis_0251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus kalau begitu!"
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosBossL02"
    }
    {
      Id = "Nemesis_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka kau berhasil mencapai Chronos sebelum aku. Aku tahu kau tak punya peluang melawannya, tapi... kukira kau takkan bisa sampai ke sana secepat ini."
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosBossL01"
    }
    {
      Id = "Melinoe_3098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah itu semacam pujian? Atau mungkin permintaan maaf?"
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosBossL01"
    }
    {
      Id = "Nemesis_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan."
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosBossL01"
    }
    {
      Id = "Nemesis_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Datang ke sini mau menyombong, {#Emph}hah. Aku mengalahkannya! Aku mengalahkan sang Titan! {#Prev}Yah, tak ada pengaruhnya. Dia masih hidup, kau sadar akan hal itu, kan?"
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosBossW01"
    }
    {
      Id = "Melinoe_2965"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku datang ke sini bukan untuk menyombong, dan ya, aku sadar. Tapi ini tetaplah sebuah kemajuan. Kalau aku bisa menundukkan Chronos sekali, aku bisa melakukannya lagi. Dan pada suatu malam nanti... dia takkan pernah kembali lagi."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosBossW01"
    }
    {
      Id = "Nemesis_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya. Karena pada suatu malam nanti, aku sendiri yang akan menghabisinya dengan tanganku."
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosBossW01"
    }
    {
      Id = "Melinoe_2966"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, saat itu tiba giliranmu yang menyombong, kan?"
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosBossW01"
    }
    {
      Id = "Nemesis_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus mengakui kesalahanku. Tak pernah terpikir kau bakal bisa sampai ke Chronos lebih dulu dariku. Apalagi menghajarnya berkali-kali. Jadi — aku salah. Maaf."
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosBossFights01"
    }
    {
      Id = "Melinoe_3225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nemesis, aku ingin kau tahu bahwa sungguh mencengangkan mendengar kata-kata itu keluar dari mulutmu barusan. Tampaknya kita berdua sama-sama sanggup mengejutkan satu sama lain. Tapi yang terpenting... terima kasih."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosBossFights01"
    }
    {
      Id = "Nemesis_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu terima kasih. Adil ya adil. Aku punya kesempatan untuk menyusulmu, tapi tak bisa lolos dari segala jebakan di sepanjang jalan. Mungkin saja aku juga bisa menghadapi Chronos. Tapi sekarang aku jadi tak begitu yakin."
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosBossFights01"
    }
    {
      Id = "Melinoe_3226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan patah semangat dulu! Masih banyak yang harus diselesaikan, dan kami butuh segenap kekuatan dan kewaspadaanmu. Kita adalah sang Unseen; bersama kita berjaya, atau kita binasa."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosBossFights01"
    }
    {
      Id = "Nemesis_0254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak tahan ya kalau tak memberi wejangan penyemangatmu itu, ya."
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosBossFights01"
    }
    {
      Id = "Melinoe_3227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Tidak juga."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosBossFights01"
    }
    {
      Id = "Nemesis_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak bisa membunuh Chronos, tak bisa membunuh Typhon, jadi sekarang bagaimana? Terus begini sampai ada yang menyerah? Kukira kita punya rencana yang lebih baik."
      Speaker = "Nemesis"
      Event = "NemesisAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_4428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Titan mengira dia berada di atas angin dengan membangkitkan monster itu. Tapi kita akan membalikkan kemunduran itu menjadi keuntungan kita. Typhon sangat luar biasa kuat; sebuah kekuatan yang bisa kita manfaatkan."
      Speaker = "Melinoe"
      Event = "NemesisAboutUltimateProgress01"
    }
    {
      Id = "Nemesis_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh mengira sang Titan bakal menyodorkan kunci kehancurannya sendiri begitu saja? Kedengarannya tidak begitu cerdas."
      Speaker = "Nemesis"
      Event = "NemesisAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_4429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rencana kita memang selalu memanfaatkan apa yang tidak dia ketahui."
      Speaker = "Melinoe"
      Event = "NemesisAboutUltimateProgress01"
    }
    {
      Id = "Nemesis_0310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa dia tahu jauh lebih banyak daripada dirimu."
      Speaker = "Nemesis"
      Event = "NemesisAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_1570"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mendapat salah satu mimpi itu lagi, Nem. Ibumu ada di sana, begitu pula ayahku. Ayah menunjukkan rasa cemas padanya, sementara dia... berada di bawah pengaruh sang Titan."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosNightmare01"
    }
    {
      Id = "Nemesis_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Nyx membuat kesalahan karena memercayakan begitu banyak bagian Underworld kepada Hades. Alam ini tak pernah menjadi haknya, sebelum para Fates memutuskan sebaliknya. Ibu sudah bekerja keras. Mereka mungkin cuma berniat mengirimkan bantuan untuknya."
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosNightmare01"
    }
    {
      Id = "Melinoe_0621"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu para Fates memberikan otoritas atas alam kematian kepada ayahku cuma demi membantu meringankan tanggung jawab Nyx?"
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosNightmare01"
    }
    {
      Id = "Nemesis_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali."
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosNightmare01"
    }
    {
      Id = "Melinoe_0622"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu rupanya."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosNightmare01"
    }
    {
      Id = "Melinoe_0623"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nemesis, soal mimpi yang kualami... Chronos, dia... menuntut agar ayahku memberitahukan di mana keberadaan para Fates."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosNightmare02"
    }
    {
      Id = "Nemesis_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cerdas. Ibu Nyx takkan pernah sudi memberitahunya. Para Fates mungkin saudariku, tapi bahkan aku pun tak tahu di mana mereka berada. Selama mereka tersembunyi, tak ada yang bisa mengacaukan rancangan takdir mereka."
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosNightmare02"
    }
    {
      Id = "Melinoe_1571"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terdengar tak terlalu peduli bahwa Chronos tampaknya telah menemukan ketiga penenun takdir dan mungkin memaksa mereka mengubah masa depan."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosNightmare02"
    }
    {
      Id = "Nemesis_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Masa? {#Prev}Memangnya kapan aku pernah memberimu kesan kalau semua ini bakal berakhir baik?"
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosNightmare02"
    }
    {
      Id = "Melinoe_1572"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa dia menemukan mereka? Bukankah para Moirai bisa melihat ancaman itu datang?"
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosNightmare02"
    }
    {
      Id = "Nemesis_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka selalu menenun. Itu artinya mereka sendiri cuma tahu sedikit ke depan. Chronos itu Sang Waktu. {#Emph}Waktu {#Prev}bergerak lebih cepat dari dugaan."
      Speaker = "Nemesis"
      Event = "NemesisAboutChronosNightmare02"
    }
    {
      Id = "Melinoe_5278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terdengar tak terlalu peduli bahwa Chronos entah bagaimana menemukan ketiga penenun takdir dan mengasingkan mereka. Bahkan kini tak bisa menemukannya lagi."
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosNightmare02_B"
    }
    {
      Id = "Melinoe_5279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana dia melakukannya...? Bukankah para Moirai bisa melihat ancaman itu datang?"
      Speaker = "Melinoe"
      Event = "NemesisAboutChronosNightmare02_B"
    }
    {
      Id = "Nemesis_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan senjata Bunda Nyx lebih memilihmu. Kupikir Senjata Nokturnal bakal bangkit untukku duluan. Kurasa para Moirai punya rencana lain."
      Speaker = "Nemesis"
      Event = "NemesisAboutWeapons01"
    }
    {
      Id = "Melinoe_1569"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir para Moirai sudah memberimu yang terbaik. Kau adalah pembawa Stygius! Penakluk para pahlawan, dewa, dan Titan."
      Speaker = "Melinoe"
      Event = "NemesisAboutWeapons01"
    }
    {
      Id = "Nemesis_0087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya pedang itu memang butuh istirahat panjang."
      Speaker = "Nemesis"
      Event = "NemesisAboutWeapons01"
    }
    {
      Id = "Melinoe_4466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabarmu di Tartarus setelah menemukan terowongan kumuh itu? Usaha membabi butamu untuk membunuh Chronos sudah membuahkan hasil?"
      Speaker = "Melinoe"
      Event = "NemesisAboutTartarus01"
    }
    {
      Id = "Nemesis_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum. Masih belum menemukan jalan masuk ke Kediaman. Tapi, sering berpapasan dengan banyak Satyr. Mengurangi jumlah kawanan mereka, kasarnya begitu."
      Speaker = "Nemesis"
      Event = "NemesisAboutTartarus01"
    }
    {
      Id = "Melinoe_4467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, setidaknya kau membantuku membuka jalan! Meski, mungkin itu hal terakhir yang kauinginkan. Kau takkan berhenti sampai kau sendiri yang menghabisi Titan itu."
      Speaker = "Melinoe"
      Event = "NemesisAboutTartarus01"
    }
    {
      Id = "Nemesis_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang tak berniat berhenti, entah sebelum atau sesudahnya."
      Speaker = "Nemesis"
      Event = "NemesisAboutTartarus01"
    }
    {
      Id = "Melinoe_0017"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sama sekali tak meragukannya."
      Speaker = "Melinoe"
      Event = "NemesisAboutTartarus01"
    }
    {
      Id = "Melinoe_0613"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nem. Kau begitu peduli pada keadilan manusia fana. Mana semangatmu demi keadilan kita? Chronos merebut {#Emph}segalanya {#Prev}dari kita! Kau sendiri yang bilang kita semua harus mendapatkan apa yang pantas kita terima, kan?"
      Speaker = "Melinoe"
      Event = "NemesisAboutGoldenAge01"
    }
    {
      Id = "Nemesis_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Khh. {#Prev}Ya, masalahnya itu. Andai kau tahu sedikit saja tentang manusia fana, hidup mereka dulu jauh lebih baik. Saat Chronos berkuasa. Mereka menyebutnya {#Emph}Zaman Keemasan."
      Speaker = "Nemesis"
      Event = "NemesisAboutGoldenAge01"
    }
    {
      Id = "Melinoe_2749"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti luar biasa sekali bagi mereka! Andai saja Chronos bisa bermurah hati kepada anak-anak kandung dan anak-anak asuhnya. Kaupikir bersikap ramah pada segelintir manusia bisa menebus semua perbuatannya?"
      Speaker = "Melinoe"
      Event = "NemesisAboutGoldenAge01"
    }
    {
      Id = "Nemesis_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan begitu. Dengar. Bagaimana kalau... bagaimana kalau memang inilah yang {#Emph}pantas {#Prev}kita terima?"
      Speaker = "Nemesis"
      Event = "NemesisAboutGoldenAge01"
    }
    {
      Id = "Melinoe_0615"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita pantas mendapatkan yang lebih baik dari ini, Nemesis. Hidup dalam bayang-bayang. Terpisah dari keluarga kita. Tidakkah kau menginginkan keadilan bagi {#Emph}mereka?"
      Speaker = "Melinoe"
      Event = "NemesisAboutGoldenAge01"
    }
    {
      Id = "Nemesis_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah."
      Speaker = "Nemesis"
      Event = "NemesisAboutGoldenAge01"
    }
    {
      Id = "Melinoe_0616"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserahlah."
      Speaker = "Melinoe"
      Event = "NemesisAboutGoldenAge01"
    }
    {
      Id = "Melinoe_1561"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sudah berapa lama sejak terakhir kali kau mengunjungi permukaan?"
      Speaker = "Melinoe"
      Event = "NemesisAboutSurface01"
    }
    {
      Id = "Nemesis_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah terlalu lama. Terkurung di sini sekarang, kalau-kalau kau belum sadar. Tapi, itu usaha yang sia-sia saja. Kenapa kau tanya?"
      Speaker = "Nemesis"
      Event = "NemesisAboutSurface01"
    }
    {
      Id = "Melinoe_1562"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hermes memintaku berkunjung jika sempat. Aku cuma ingin tahu apa yang bakal kuhadapi."
      Speaker = "Melinoe"
      Event = "NemesisAboutSurface01"
    }
    {
      Id = "Nemesis_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya seperti yang kubilang. Orang-orang mati berkeliaran bebas di atas sana berkat teman Titan kita. Kau bakal merasa seperti di rumah sendiri."
      Speaker = "Nemesis"
      Event = "NemesisAboutSurface01"
    }
    {
      Id = "Melinoe_1563"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terdengar menyenangkan."
      Speaker = "Melinoe"
      Event = "NemesisAboutSurface01"
    }
    {
      Id = "Melinoe_3211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hermes memintaku berkunjung jika sempat. Kupikir aku harus bertanya barangkali kau punya saran."
      Speaker = "Melinoe"
      Event = "NemesisAboutSurface01_B"
    }
    {
      Id = "Nemesis_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar pergi ke atas sana. Mereka bisa saja memanggil seseorang yang berpengalaman, tapi kurasa aku memang tak pantas menerimanya seperti dugaanku."
      Speaker = "Nemesis"
      Event = "NemesisAboutSurface02"
    }
    {
      Id = "Melinoe_1575"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehadiranku dibutuhkan di sana sebagai bagian dari tugasku. Walau begitu, mereka pasti merindukanmu di permukaan. Begitu banyak penderitaan..."
      Speaker = "Melinoe"
      Event = "NemesisAboutSurface02"
    }
    {
      Id = "Nemesis_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keadilan tak penting lagi. Manusia fana menuai apa yang mereka tabur. Mungkin kita semua juga."
      Speaker = "Nemesis"
      Event = "NemesisAboutSurface02"
    }
    {
      Id = "Melinoe_1576"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan bicara begitu..."
      Speaker = "Melinoe"
      Event = "NemesisAboutSurface02"
    }
    {
      Id = "Nemesis_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terus saja pergi ke atas padahal seharusnya menuju ke bawah, ke target utamamu. Lupakan gunung itu. Itu bukan pertarunganmu."
      Speaker = "Nemesis"
      Event = "NemesisAboutSurface03"
    }
    {
      Id = "Melinoe_0618"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluargaku di Olympus sedang diserang oleh pasukan Chronos, dan kau bilang itu bukan pertarunganku?"
      Speaker = "Melinoe"
      Event = "NemesisAboutSurface03"
    }
    {
      Id = "Nemesis_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan. Dia ada di bawah sana, duduk nyaman di atas takhta ayahmu. Dan kau tak perlu mengkhawatirkan apa pun selain dirinya."
      Speaker = "Nemesis"
      Event = "NemesisAboutSurface03"
    }
    {
      Id = "Melinoe_0619"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja, terserah katamu."
      Speaker = "Melinoe"
      Event = "NemesisAboutSurface03"
    }
    {
      Id = "Melinoe_4424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa aku tak pernah melihatmu di permukaan, Nem? Pasti ada musuh di sana yang pantas mendapatkan perhatianmu."
      Speaker = "Melinoe"
      Event = "NemesisAboutSurface04"
    }
    {
      Id = "Nemesis_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mati Chronos adalah satu-satunya tugas. Takkan kuusutkan pikiranku dengan tetek bengek sepertimu. Tiap malam yang kau buang di pegunungan, sang Titan makin memperkuat cengkeramannya di bawah."
      Speaker = "Nemesis"
      Event = "NemesisAboutSurface04"
    }
    {
      Id = "Melinoe_4425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak paham kalau kebangkitan kembali Typhon justru memperumit keadaan? Masalah semacam itu bukan hal yang bisa diabaikan begitu saja."
      Speaker = "Melinoe"
      Event = "NemesisAboutSurface04"
    }
    {
      Id = "Nemesis_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masa, sih? Lihat saja nanti."
      Speaker = "Nemesis"
      Event = "NemesisAboutSurface04"
    }
    {
      Id = "Nemesis_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris balik lagi. Kau ngapain? Kau memanggilnya? Kulihat kalian bicara tadi."
      Speaker = "Nemesis"
      Event = "NemesisAboutEris01"
    }
    {
      Id = "Melinoe_3099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sama sekali tidak senang melihat saudarimu lagi? Aku tak punya kendali apa-apa atas dirinya, sama sepertimu. Walau Kepala Sekolah sampai sekarang masih mendiamkannya."
      Speaker = "Melinoe"
      Event = "NemesisAboutEris01"
    }
    {
      Id = "Nemesis_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harusnya, Eris ada di tempat yang amat sangat jauh dari sini. Untung saja tempat ini mustahil ditemukan, kalau tidak, aku yakin dia pasti sudah membawa Chronos langsung ke depan pintu kita."
      Speaker = "Nemesis"
      Event = "NemesisAboutEris01"
    }
    {
      Id = "Melinoe_3100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh mengira seorang putri Nyx bakal mengkhianati kita? Aku tahu watak Eris memang berbeda, tapi tetap saja..."
      Speaker = "Melinoe"
      Event = "NemesisAboutEris01"
    }
    {
      Id = "Nemesis_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu itu putranya Chronos. Hubungan {#Emph}mereka {#Prev}bagaimana, coba?"
      Speaker = "Nemesis"
      Event = "NemesisAboutEris01"
    }
    {
      Id = "Melinoe_3101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Masuk akal juga."
      Speaker = "Melinoe"
      Event = "NemesisAboutEris01"
    }
    {
      Id = "Melinoe_3102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris menghalangi langkah kita. Pas aku hampir sampai ke tujuan di permukaan, dia ada di sana. Membiarkan Adamant Rail yang banyak bicara."
      Speaker = "Melinoe"
      Event = "NemesisAboutErisFight01"
    }
    {
      Id = "Nemesis_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kagetnya bukan main. Terus mau bagaimana? Mengusirnya jelas tak bisa, berhubung {#Emph}semua anak Nyx diterima di sini{#Prev}—ide brilian siapa pun itu asalnya. Mau kasih dia kesempatan kedua {#Emph}lagi{#Prev}?"
      Speaker = "Nemesis"
      Event = "NemesisAboutErisFight01"
    }
    {
      Id = "Melinoe_3103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, aku paham maksudmu."
      Speaker = "Melinoe"
      Event = "NemesisAboutErisFight01"
    }
    {
      Id = "Melinoe_3220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa tidak ada yang bisa kau lakukan untuk menyadarkan Eris? Singkirkan dia dari jalanku menuju Olympus. Atau kalau gagal, kunci tangannya atau kuncian kaki, mungkin?"
      Speaker = "Melinoe"
      Event = "NemesisAboutErisFight02"
    }
    {
      Id = "Nemesis_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Buang-buang waktu mengurusinya, walau ide kuncian tangan atau kaki kedengaran lumayan menggoda. Akhir-akhir ini tak pernah lihat dia terbang di Underworld, kan?"
      Speaker = "Nemesis"
      Event = "NemesisAboutErisFight02"
    }
    {
      Id = "Melinoe_3221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak ada selain di Crossroads ini. Tapi apa maksudmu, aku harus menjauhinya dan fokus saja pada Chronos di bawah? Bagiku semuanya tak sesederhana itu lagi."
      Speaker = "Melinoe"
      Event = "NemesisAboutErisFight02"
    }
    {
      Id = "Nemesis_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak pernah kubilang sederhana. Tapi kalau tak sudi berurusan dengan {#Emph}Eris{#Prev}, kau bisa tetap fokus ke tujuan utamamu. Atau serahkan saja padaku {#Emph}seorang{#Prev}, seperti yang harusnya kau lakukan sedari awal."
      Speaker = "Nemesis"
      Event = "NemesisAboutErisFight02"
    }
    {
      Id = "Melinoe_3222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kucatat itu."
      Speaker = "Melinoe"
      Event = "NemesisAboutErisFight02"
    }
    {
      Id = "Nemesis_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau beri Eris pelajaran, ya? Tangisannya kedengaran hampir sampai sini. Sudah lama sekali sejak terakhir kali kuhajar bokongnya sendiri. Setidaknya ada {#Emph}seseorang {#Prev}yang mengambil alih tugasku."
      Speaker = "Nemesis"
      Event = "NemesisAboutErisFightW01"
    }
    {
      Id = "Melinoe_3218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin pertarungan liar tanpa henti di antara kalian berdualah yang membuat sifatnya jadi menyebalkan. Atau sifatmu juga, dalam hal ini. Kecuali kalau kau yakin kalian berdua sama sekali belum berubah—kalau begitu, untuk apa semua pertarungan itu?"
      Speaker = "Melinoe"
      Event = "NemesisAboutErisFightW01"
    }
    {
      Id = "Nemesis_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah kenal dia. Dia memang suka cari gara-gara. Dan kau sudah kenal {#Emph}aku. {#Prev}Aku tak pernah suka mundur dari tantangan. Soal dirimu, lain kali belajarlah cara menerima pujian."
      Speaker = "Nemesis"
      Event = "NemesisAboutErisFightW01"
    }
    {
      Id = "Melinoe_3219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Pasti tadi terlewat olehku."
      Speaker = "Melinoe"
      Event = "NemesisAboutErisFightW01"
    }
    {
      Id = "Nemesis_0246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti."
      Speaker = "Nemesis"
      Event = "NemesisAboutErisFightW01"
    }
    {
      Id = "Melinoe_5260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernah ada yang bilang kalau kau mirip ibumu, Nemesis? Setelah bertemu beliau, aku bisa melihat kemiripannya. Malah saat pertama kali melihatnya, aku... yah, lupakan."
      Speaker = "Melinoe"
      Event = "NemesisAboutNyx01"
    }
    {
      Id = "Nemesis_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan dipotong, selesaikan kalimatmu. Saat pertama kali melihatnya, kau kenapa?"
      Speaker = "Nemesis"
      Event = "NemesisAboutNyx01"
    }
    {
      Id = "Melinoe_5261"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehem{#Prev}, saat pertama kali melihatnya, aku... dengar, aku terperangah melihat penampilannya! Dalam arti positif, tentu saja. Beliau terlihat seperti dirimu kalau saja kau mengenakan gaun anggun dan mengistirahatkan otot keningmu."
      Speaker = "Melinoe"
      Event = "NemesisAboutNyx01"
    }
    {
      Id = "Nemesis_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu caramu memuji? Tak ada orang yang mau disamakan dengan ibunya. Lagipula aku sama sekali tak mirip dengannya. Kecuali mungkin rambutnya."
      Speaker = "Nemesis"
      Event = "NemesisAboutNyx01"
    }
    {
      Id = "Melinoe_5262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lady Demeter bilang aku sangat mirip dengan ibuku, dan kurasa itu pujian yang sangat manis! Ratu Persephone memang memesona."
      Speaker = "Melinoe"
      Event = "NemesisAboutNyx01"
    }
    {
      Id = "Nemesis_0427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kira-kira hubungan beliau dan Nyx seakrab hubungan kita tidak, ya?"
      Speaker = "Nemesis"
      Event = "NemesisAboutNyx01"
    }
    {
      Id = "Melinoe_5263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mustahil bisa seakrab kita."
      Speaker = "Melinoe"
      Event = "NemesisAboutNyx01"
    }
    {
      Id = "Nemesis_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semalam aku berpapasan dengan Nyx. Rupanya tiap kali dia sudah muak berada di dekat Hades dan Persephone, dia pergi ke tempat Chaos untuk mencari ketenangan. Masuk akal juga."
      Speaker = "Nemesis"
      Event = "NemesisAboutNyx02"
    }
    {
      Id = "Melinoe_5258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beliau melakukannya bukan untuk menjauhi orang tuaku! Mengingat semua yang telah dilalui Underworld, tidakkah terpikir olehmu kalau sang Malam dan Chaos punya banyak hal untuk dibicarakan?"
      Speaker = "Melinoe"
      Event = "NemesisAboutNyx02"
    }
    {
      Id = "Nemesis_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa jadi. Cuma mencoba membayangkan apa yang sebenarnya mereka bicarakan. {#Emph}'Di sini masih gelap gulita ya, Chaos.' 'Ya, memang begitu, Nyx.'{#Prev}"
      Speaker = "Nemesis"
      Event = "NemesisAboutNyx02"
    }
    {
      Id = "Melinoe_5259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tertawa> {#Prev}Maaf."
      Speaker = "Melinoe"
      Event = "NemesisAboutNyx02"
    }
    {
      Id = "Melinoe_5255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana rasanya ibumu sudah kembali? Aku sendiri masih membiasakan diri memiliki ibu kandung di hidupku, meski aku tak bisa melihatnya setiap malam."
      Speaker = "Melinoe"
      Event = "NemesisAboutNyxRescue01"
    }
    {
      Id = "Nemesis_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa Ibu Nyx juga takkan sering muncul. Tak pernah, malah. Tapi dia tak pernah benar-benar lenyap. Malam sudah ada jauh sebelum Sang Waktu. Tak ada yang berani mengusiknya."
      Speaker = "Nemesis"
      Event = "NemesisAboutNyxRescue01"
    }
    {
      Id = "Melinoe_5256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bicara soal itu, sepertinya kau punya kebebasan penuh untuk menjatuhkan Pembalasan lagi—bukan berarti kau tak melakukannya sebelumnya. Tak perlu lagi mengejar Chronos sekarang!"
      Speaker = "Melinoe"
      Event = "NemesisAboutNyxRescue01"
    }
    {
      Id = "Nemesis_0422"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, urusanku dengannya belum selesai."
      Speaker = "Nemesis"
      Event = "NemesisAboutNyxRescue01"
    }
    {
      Id = "Melinoe_5257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Entah kenapa aku sama sekali tidak terkejut!"
      Speaker = "Melinoe"
      Event = "NemesisAboutNyxRescue01"
    }
    {
      Id = "Melinoe_1552"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi seberapa besar masalahmu gara-gara membantah Kepala Sekolah, Nem? Tindakanmu tadi benar-benar keterlaluan, bahkan untuk ukuranmu."
      Speaker = "Melinoe"
      Event = "NemesisAboutHecate01"
    }
    {
      Id = "Nemesis_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh! {#Prev}Yah, sepertinya bakal makin banyak tugas jaga menungguku. Tapi itu sepadan. Biar mengimbangi kelakuanmu yang terus-terusan menjilatnya."
      Speaker = "Nemesis"
      Event = "NemesisAboutHecate01"
    }
    {
      Id = "Melinoe_1553"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga kau tak bisa membedakan antara sopan santun dasar dengan apa yang kausebut menjilat."
      Speaker = "Melinoe"
      Event = "NemesisAboutHecate01"
    }
    {
      Id = "Nemesis_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau cuma alat baginya, asal kau tahu."
      Speaker = "Nemesis"
      Event = "NemesisAboutHecate01"
    }
    {
      Id = "Melinoe_1554"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa dari dulu hubunganmu dengan Kepala Sekolah memang begini? Kukira {#Emph}akulah {#Prev}yang paling kaubenci di sini."
      Speaker = "Melinoe"
      Event = "NemesisAboutHecate02"
    }
    {
      Id = "Nemesis_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu saja naif, Tuan Putri. Soal Hecate, aku lebih menyukainya sebelum dia memutuskan kalau {#Emph}tempat ini {#Prev}adalah pemanfaatan terbaik dari bakatku."
      Speaker = "Nemesis"
      Event = "NemesisAboutHecate02"
    }
    {
      Id = "Melinoe_1555"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keputusan itu dia ambil sudah lama sekali. Jadi kau mau mendendam padanya selamanya? Atau kau bakal mengambil tindakan?"
      Speaker = "Melinoe"
      Event = "NemesisAboutHecate02"
    }
    {
      Id = "Nemesis_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}sedang {#Prev}mengambil tindakan! Aku sedang menepati sumpahku pada Ibu Nyx. Kalau bukan karena itu, aku sudah lama pergi dari sini—pasti kau bakal sangat kecewa, kan?"
      Speaker = "Nemesis"
      Event = "NemesisAboutHecate02"
    }
    {
      Id = "Melinoe_1556"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, aku pasti akan sangat kecewa."
      Speaker = "Melinoe"
      Event = "NemesisAboutHecate02"
    }
    {
      Id = "Nemesis_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sempat heran kenapa Hecate mendadak pergi tadi. Ternyata cuma buat menghalangi jalanmu! Biar kau pulang sambil menangis. Sepertinya dia tak ingin kau berhasil."
      Speaker = "Nemesis"
      Event = "NemesisAboutLosingToHecate01"
    }
    {
      Id = "Melinoe_1557"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia ingin memastikan aku siap menghadapi apa pun yang menanti di depan sana."
      Speaker = "Melinoe"
      Event = "NemesisAboutLosingToHecate01"
    }
    {
      Id = "Nemesis_0062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau gampang sekali dibodohi kadang-kadang."
      Speaker = "Nemesis"
      Event = "NemesisAboutLosingToHecate01"
    }
    {
      Id = "Nemesis_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil lolos dari ujian kecilnya tadi. Pasti puas sekali rasanya bisa menghajar dan menjatuhkannya ke tanah. Aku tak pernah bisa bertanding dengannya, jadi cuma bisa membayangkan."
      Speaker = "Nemesis"
      Event = "NemesisAboutDefeatingHecate01"
    }
    {
      Id = "Melinoe_1558"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami bukan sekadar bertanding. Kau tidak mengerti seni sihir kami."
      Speaker = "Melinoe"
      Event = "NemesisAboutDefeatingHecate01"
    }
    {
      Id = "Nemesis_0064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang kutahu, aku pasti bisa mengalahkannya..."
      Speaker = "Nemesis"
      Event = "NemesisAboutDefeatingHecate01"
    }
    {
      Id = "Nemesis_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lain kali kalau ada yang mau kaubicarakan tentangku, katakan langsung di depan mukaku. Meski aku tahu kalian para penyihir lebih suka mengendap-endap di belakang."
      Speaker = "Nemesis"
      Event = "NemesisAboutOdysseus01"
    }
    {
      Id = "Melinoe_2236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ini bicara apa, sih? Menurutku kau cuma bersikap menuduh dan menyebalkan. Nah! Sudah kukatakan {#Emph}itu {#Prev}langsung di depan mukamu."
      Speaker = "Melinoe"
      Event = "NemesisAboutOdysseus01"
    }
    {
      Id = "Nemesis_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus mencoba menceramahiku tadi. Mau bilang bukan kau yang mengadu padanya?"
      Speaker = "Nemesis"
      Event = "NemesisAboutOdysseus01"
    }
    {
      Id = "Melinoe_2237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia cuma mengkhawatirkan hubungan kita. Kau sendiri sama sekali tidak berusaha menutup-nutupinya, dan dia orang yang cukup peka kalau kau belum sadar."
      Speaker = "Melinoe"
      Event = "NemesisAboutOdysseus01"
    }
    {
      Id = "Nemesis_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Diam. Kau."
      Speaker = "Nemesis"
      Event = "NemesisAboutOdysseus01"
    }
    {
      Id = "Melinoe_1559"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya aku berpapasan dengan Artemis di luar sana. Apa setidaknya dia sempat mampir ke sini dan menyapamu?"
      Speaker = "Melinoe"
      Event = "NemesisAboutArtemis01"
    }
    {
      Id = "Nemesis_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, dia tidak mampir. Jadi dia selama ini mengendap-endap di hutan itu? Kukira dia sibuk mengumpulkan paman dan bibimu untukmu. Tunggu, kau tetap gagal melangkah jauh meski sudah dibantu olehnya{#Emph}?{#Prev}"
      Speaker = "Nemesis"
      Event = "NemesisAboutArtemis01"
    }
    {
      Id = "Melinoe_1560"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Urusannya tidak sesederhana itu...!"
      Speaker = "Melinoe"
      Event = "NemesisAboutArtemis01"
    }
    {
      Id = "Melinoe_2242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernahkah kau bertemu Artemis di luar sana? Kurasa melanggar perintah berulang kali mungkin sepadan demi kesempatan untuk melihatnya."
      Speaker = "Melinoe"
      Event = "NemesisAboutArtemis02"
    }
    {
      Id = "Nemesis_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu apa kau soal itu. Kau benar-benar berpikir aku menyelinap keluar ke hutan itu cuma untuk main-main?"
      Speaker = "Nemesis"
      Event = "NemesisAboutArtemis02"
    }
    {
      Id = "Melinoe_2243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa semuanya baik-baik saja di antara kalian berdua, setidaknya?"
      Speaker = "Melinoe"
      Event = "NemesisAboutArtemis02"
    }
    {
      Id = "Nemesis_0144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semuanya baik-baik saja."
      Speaker = "Nemesis"
      Event = "NemesisAboutArtemis02"
    }
    {
      Id = "Nemesis_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bernyanyi, {#Emph}cih. {#Prev}Dewi perburuan itu rupanya sedang mengincar pekerjaan saudara laki-lakinya. Heran kau tak ikut bergabung di sana. Bukankah itu keahlian lain yang bisa kaupelajari?"
      Speaker = "Nemesis"
      Event = "NemesisAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_4460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kelihatannya sepele, tapi kami bernyanyi bukan sekadar karena tak ada kerjaan lain di sini, Nemesis. Ini punya khasiat menyucikan jiwa."
      Speaker = "Melinoe"
      Event = "NemesisAboutArtemisSinging01"
    }
    {
      Id = "Nemesis_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu. Artemis sudah menceritakan semuanya tentang maksudmu saat bicara soal penyucian. Setidaknya aku hampir tak bisa mendengarnya dari sini."
      Speaker = "Nemesis"
      Event = "NemesisAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_4461"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu kami harus bernyanyi lebih keras lagi untukmu."
      Speaker = "Melinoe"
      Event = "NemesisAboutArtemisSinging01"
    }
    {
      Id = "Nemesis_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Habis ngobrol lagi sama Hypnos? Dia nggak bisa dengar kamu, tahu. Wajar saja kalau orang lagi tidur pulas."
      Speaker = "Nemesis"
      Event = "NemesisAboutHypnos01"
    }
    {
      Id = "Melinoe_0686"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidur itu tidak sesederhana anggapanmu. Kurasa dia bisa merasakan ucapan dan niatku."
      Speaker = "Melinoe"
      Event = "NemesisAboutHypnos01"
    }
    {
      Id = "Nemesis_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Merasakan ucapan dan niat, ya... kedengarannya pas sekali dengan Hypnos yang kukenal."
      Speaker = "Nemesis"
      Event = "NemesisAboutHypnos01"
    }
    {
      Id = "Nemesis_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak percaya aku! Kamu akhirnya berhasil bangunkan Hypnos, dan {#Emph}aku {#Prev}malah tidur sepanjang waktu? Orangnya seindah impianmu?"
      Speaker = "Nemesis"
      Event = "NemesisAboutHypnosWakeUp01"
    }
    {
      Id = "Melinoe_5276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, {#Emph}emm... {#Prev}sikapnya tidak seperti yang kuduga, dan dia tidak terlalu berterima kasih. Meski aku sendiri sering kali uring-uringan kalau bangun kesiangan. Lalu, dia langsung pergi terburu-buru..."
      Speaker = "Melinoe"
      Event = "NemesisAboutHypnosWakeUp01"
    }
    {
      Id = "Nemesis_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kena apes, ya! Kupikir dia memang tipemu. Yah, kalau kamu memang berakhir kerja di Griya ayahmu, kalian bakal ketemu lagi. Untuk sekarang, setidaknya kita nggak perlu dengar dengkurannya {#Emph}setiap malam."
      Speaker = "Nemesis"
      Event = "NemesisAboutHypnosWakeUp01"
    }
    {
      Id = "Melinoe_5277"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa ada benarnya juga..."
      Speaker = "Melinoe"
      Event = "NemesisAboutHypnosWakeUp01"
    }
    {
      Id = "Melinoe_2238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong-omong, kenapa kamu begitu dendam pada Narcissus? Aku tahu dia memang agak menyebalkan, tapi dia tidak seburuk itu."
      Speaker = "Melinoe"
      Event = "NemesisAboutNarcissus01"
    }
    {
      Id = "Nemesis_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harusnya kamu lihat apa yang dia perbuat pada Nimfa malang itu. Benar-benar bikin patah hati. Bahkan dia nggak sadar, atau nggak peduli sama sekali."
      Speaker = "Nemesis"
      Event = "NemesisAboutNarcissus01"
    }
    {
      Id = "Melinoe_2239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kamu bukan tipe orang yang sentimentil. Kupikir urusanmu lebih ke hal-hal yang lebih parah dari sekadar pertengkaran sepasang kekasih."
      Speaker = "Melinoe"
      Event = "NemesisAboutNarcissus01"
    }
    {
      Id = "Nemesis_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Narcissus cuma peduli sama dirinya sendiri, bukan orang di sekitarnya. Aku harus memberi dia pelajaran. Akhirnya dia jatuh cinta setengah mati. Sama bayangannya sendiri. Sampai ajal menjemputnya."
      Speaker = "Nemesis"
      Event = "NemesisAboutNarcissus01"
    }
    {
      Id = "Melinoe_2240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi sekarang dia hanyalah Arwah di Dunia Bawah. Dan masih terus menatap matanya sendiri dengan penuh kerinduan."
      Speaker = "Melinoe"
      Event = "NemesisAboutNarcissus01"
    }
    {
      Id = "Nemesis_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kamu itu penyihirnya, bukan aku. Kamu tahu sendirilah bagaimana kutukan bekerja."
      Speaker = "Nemesis"
      Event = "NemesisAboutNarcissus01"
    }
    {
      Id = "Melinoe_2241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutukan itu mudah disalahgunakan."
      Speaker = "Melinoe"
      Event = "NemesisAboutNarcissus01"
    }
    {
      Id = "Melinoe_3232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, soal Narcissus. Aku tidak akan membatalkan kutukanmu padanya, andai pun aku bisa. Dia tampak cukup puas, dan lagi... aku tahu kamu benar-benar percaya dia pantas mendapatkannya. Masalahnya, kutukan itu sama sekali tidak membantu penderitaan Echo."
      Speaker = "Melinoe"
      Event = "NemesisAboutNarcissus02"
    }
    {
      Id = "Nemesis_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Echo... dia itu Nimfa yang memasukkan Narcissus ke daftar urusanku. Maksudmu, pembalasan dendam ilahi cuma-cuma tanpa ikatan itu masih belum cukup untuk menenangkan hatinya?"
      Speaker = "Nemesis"
      Event = "NemesisAboutNarcissus02"
    }
    {
      Id = "Melinoe_3233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Kamu menyamakan kedudukan di antara mereka, tapi kamu tidak menyelesaikan masalah bagi keduanya. Mereka harus membereskannya sendiri."
      Speaker = "Melinoe"
      Event = "NemesisAboutNarcissus02"
    }
    {
      Id = "Nemesis_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan bantuan dan dorongan darimu, begitu? {#Emph}Yah{#Prev}, sama saja bagiku selama nggak ada yang berakhir jauh lebih mujur. Kedengarannya kamu menceramahi mereka berdua, jadi kurasa impas."
      Speaker = "Nemesis"
      Event = "NemesisAboutNarcissus02"
    }
    {
      Id = "Melinoe_3234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kamu tidak peduli bagaimana nasib mereka, asalkan seimbang."
      Speaker = "Melinoe"
      Event = "NemesisAboutNarcissus02"
    }
    {
      Id = "Nemesis_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mulai paham juga kamu."
      Speaker = "Nemesis"
      Event = "NemesisAboutNarcissus02"
    }
    {
      Id = "Nemesis_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada Titan lain lagi yang melawan kita, ya? {#Emph}Prometheus! {#Prev}Salah satu yang paling cerdas, kata mereka. Dan sekarang, malah jadi musuh. Harusnya dia bisa di pihak kita andai keluargamu nggak... yah, begitulah."
      Speaker = "Nemesis"
      Event = "NemesisAboutPrometheus01"
    }
    {
      Id = "Melinoe_3604"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, soal {#Emph}merantainya-di-gunung-agar-elang-bisa-memakan-hatinya-yang-terus-tumbuh-selama-berabad-abad {#Prev}itu. Bukan momen yang membanggakan bagi Olimpus, kurasa."
      Speaker = "Melinoe"
      Event = "NemesisAboutPrometheus01"
    }
    {
      Id = "Nemesis_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba tanya aku apakah dia pantas menuntut balas kalau sewaktu-waktu kamu mau merasa lebih bersalah soal kekacauan itu."
      Speaker = "Nemesis"
      Event = "NemesisAboutPrometheus01"
    }
    {
      Id = "Melinoe_3605"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga mulutmu, Nem. Itu pengkhianatan."
      Speaker = "Melinoe"
      Event = "NemesisAboutPrometheus01"
    }
    {
      Id = "Nemesis_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi sekarang Olimpus harus berurusan dengan Typhon, ya? Penasaran apa Chronos bikin kesepakatan dengannya atau cuma membangkitkan lalu melepaskannya begitu saja. Bagaimanapun, rencana semacam itu butuh nyali besar."
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphon01"
    }
    {
      Id = "Melinoe_3927"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya kamu cukup kagum! Aku yakin Chronos akan menyambutmu di barisannya juga kalau kamu ungkapkan perasaanmu yang sebenarnya."
      Speaker = "Melinoe"
      Event = "NemesisAboutTyphon01"
    }
    {
      Id = "Nemesis_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kena telak, ya? Baguslah. Nggak mengubah fakta kalau musuh kita mengungguli kita dengan cerdik. Jadi, nggak usah buang-buang waktumu di permukaan lagi... tunggu, kamu nggak berniat mencoba {#Emph}melawan {#Prev}makhluk itu, kan?"
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphon01"
    }
    {
      Id = "Melinoe_3928"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu benar-benar berpikir aku akan membiarkan keluargaku di Olimpus menghadapi monster itu sendirian? Kamu sama sekali tidak mengenalku."
      Speaker = "Melinoe"
      Event = "NemesisAboutTyphon01"
    }
    {
      Id = "Nemesis_0266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, senang pernah mengenalmu kalau begitu."
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphon01"
    }
    {
      Id = "Melinoe_3929"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama-sama."
      Speaker = "Melinoe"
      Event = "NemesisAboutTyphon01"
    }
    {
      Id = "Nemesis_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti dapat banyak bantuan sampai bisa menjatuhkan Typhon dari singgasananya. Oh, kita semua sudah dengar kok. Kamu punya belasan anggota keluarga di atas sana, beberapa di antaranya kuat. Jadi buat apa mereka butuh kamu?"
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphonW01"
    }
    {
      Id = "Melinoe_4422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka memang tangguh, tapi mereka tersudut di Olimpus. Yang terpenting pertempuran terakhir kita berbuah kemenangan, dan aku melakukan semampuku untuk menuntaskannya."
      Speaker = "Melinoe"
      Event = "NemesisAboutTyphonW01"
    }
    {
      Id = "Nemesis_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau berbagi keberhasilan, atau cuma berusaha menenangkanku? Alasan utama kamu menang cuma karena monster itu memang sudah sewajarnya binasa. Tapi, semua bakal impas pada waktunya."
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphonW01"
    }
    {
      Id = "Melinoe_4423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa maksud perkataanmu itu?"
      Speaker = "Melinoe"
      Event = "NemesisAboutTyphonW01"
    }
    {
      Id = "Nemesis_0302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat saja nanti."
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphonW01"
    }
    {
      Id = "Nemesis_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar bikin Typhon murka. Memangnya apa rencanamu selain itu? Terbuai oleh semua kejayaan sampai lupa siapa musuh kita sebenarnya?"
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphonW02"
    }
    {
      Id = "Melinoe_4426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bapa Segala Monster adalah ancaman mendesak; kau pasti paham kalau melihatnya sendiri. Jika Olimpus luluh lantak, Chronos yang menang. Kita takkan mampu menghentikannya."
      Speaker = "Melinoe"
      Event = "NemesisAboutTyphonW02"
    }
    {
      Id = "Nemesis_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bicara saja sendiri. Dunia Bawah tak pernah butuh para dewa itu. Kalau bukan karena mereka, Chronos bahkan takkan ada di sini."
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphonW02"
    }
    {
      Id = "Melinoe_4427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Syukurlah pada Tiga Takdir, kita punya kau untuk mengatasinya."
      Speaker = "Melinoe"
      Event = "NemesisAboutTyphonW02"
    }
    {
      Id = "Nemesis_0307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, syukurlah pada Tiga Takdir."
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphonW02"
    }
    {
      Id = "Nemesis_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membungkuk begitu lama di kuali itu, setidaknya sihirmu akhirnya membuahkan hasil di tempat ini. Begitu banyak jerih payah tanpa hasil..."
      Speaker = "Nemesis"
      Event = "NemesisAboutCauldron01"
    }
    {
      Id = "Melinoe_0691"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sihir kami biasanya berfokus pada diri sendiri, dan hasilnya cenderung tidak langsung terlihat. Tapi, aku hargai kau menyadarinya."
      Speaker = "Melinoe"
      Event = "NemesisAboutCauldron01"
    }
    {
      Id = "Nemesis_0089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, begitulah..."
      Speaker = "Nemesis"
      Event = "NemesisAboutCauldron01"
    }
    {
      Id = "Melinoe_3235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa aku tak pernah melihatmu di area latihan lagi? Dulu kau melampiaskan seluruh amarahmu di sana, tapi sekarang sepertinya kau menyimpannya untuk {#Emph}ku."
      Speaker = "Melinoe"
      Event = "NemesisAboutTrainingGrounds01"
    }
    {
      Id = "Nemesis_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan kegeeran. Aku menyimpannya untuk {#Emph}Chronos. {#Prev}Lagi pula tempat latihan itu semakin dikhususkan untuk {#Emph}mu{#Prev}, kalau kau belum sadar. Mulai dari Altar itu, sampai deretan senjatanya."
      Speaker = "Nemesis"
      Event = "NemesisAboutTrainingGrounds01"
    }
    {
      Id = "Melinoe_3236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya aku satu-satunya yang menggunakannya..."
      Speaker = "Melinoe"
      Event = "NemesisAboutTrainingGrounds01"
    }
    {
      Id = "Nemesis_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku butuh ruang sendiri."
      Speaker = "Nemesis"
      Event = "NemesisAboutTrainingGrounds01"
    }
    {
      Id = "Melinoe_1564"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nemesis, mengingat banyaknya waktu yang kau habiskan di permukaan dulu... pasti ada sesuatu di sana yang sepadan dengan usahamu, kan?"
      Speaker = "Melinoe"
      Event = "NemesisAboutEvil01"
    }
    {
      Id = "Nemesis_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}tentu saja ada. {#Prev}Kaum fana suka bertindak melampaui batas, mengira mereka setara dengan kita. Kulacak mereka, lalu kukembalikan mereka ke tempat asalnya."
      Speaker = "Nemesis"
      Event = "NemesisAboutEvil01"
    }
    {
      Id = "Melinoe_1565"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengembalikan ke tempat asalnya... dengan menghukum mereka lewat cara-cara kreatif, begitu?"
      Speaker = "Melinoe"
      Event = "NemesisAboutEvil01"
    }
    {
      Id = "Nemesis_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Kita semua harus mendapat balasan yang setimpal, tak kurang, tak lebih."
      Speaker = "Nemesis"
      Event = "NemesisAboutEvil01"
    }
    {
      Id = "Melinoe_0608"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi bukankah kaum fana sudah punya cara sendiri untuk menegakkan keadilan, seperti yang dilakukan ayahku?"
      Speaker = "Melinoe"
      Event = "NemesisAboutEvil01"
    }
    {
      Id = "Nemesis_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah! {#Prev}Tentu saja punya."
      Speaker = "Nemesis"
      Event = "NemesisAboutEvil01"
    }
    {
      Id = "Melinoe_0680"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei. Kau rindu berada di atas sana, kan? Di antara kaum fana dan semacamnya."
      Speaker = "Melinoe"
      Event = "NemesisAboutEvil02"
    }
    {
      Id = "Nemesis_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal tahu saja, kaum fana punya sebutan untuk kekejaman yang disengaja atau kelalaian tanpa nurani: mereka menyebutnya jahat. Aku selalu bisa mencium baunya. Kulacak sampai ke akarnya. Dan siapa pun pelakunya, kubuat mereka menanggung akibatnya."
      Speaker = "Nemesis"
      Event = "NemesisAboutEvil02"
    }
    {
      Id = "Melinoe_1566"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi sekarang kau terkurung di sini, dan kejahatan itu merajalela tanpa hukuman..."
      Speaker = "Melinoe"
      Event = "NemesisAboutEvil02"
    }
    {
      Id = "Nemesis_0076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti banyak sekali, aku yakin itu."
      Speaker = "Nemesis"
      Event = "NemesisAboutEvil02"
    }
    {
      Id = "Nemesis_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar yang sering kau bagi-bagikan itu? Aku tak paham kenapa kau repot-repot begitu. Toh, tak semua orang pantas menerimanya."
      Speaker = "Nemesis"
      Event = "NemesisAboutNectar01"
    }
    {
      Id = "Melinoe_0611"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Pantas? {#Prev}Dan kau merasa {#Emph}kau {#Prev}berhak menjadi penilainya?"
      Speaker = "Melinoe"
      Event = "NemesisAboutNectar01"
    }
    {
      Id = "Nemesis_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja. Kau pikir aku ini {#Emph}siapa? {#Prev}Kalau semua orang bisa begitu saja mendapatkan balasan yang pantas secara ajaib, aku tak punya alasan untuk ada."
      Speaker = "Nemesis"
      Event = "NemesisAboutNectar01"
    }
    {
      Id = "Melinoe_0612"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mengerikan sekali..."
      Speaker = "Melinoe"
      Event = "NemesisAboutNectar01"
    }
    {
      Id = "Nemesis_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itulah kenyataannya."
      Speaker = "Nemesis"
      Event = "NemesisAboutNectar01"
    }
    {
      Id = "Melinoe_1573"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak bermaksud membuatmu risi soal Nektar tempo hari. Hanya saja, aku selalu mengagumimu, dan... aku cuma berusaha sebaik mungkin."
      Speaker = "Melinoe"
      Event = "NemesisAboutNectar02"
    }
    {
      Id = "Nemesis_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak usah dipikirkan. Kemarin malam aku sempat minum sedikit, dan setahuku itu tidak beracun. Jadi kita impas."
      Speaker = "Nemesis"
      Event = "NemesisAboutNectar02"
    }
    {
      Id = "Melinoe_1574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau lagi?"
      Speaker = "Melinoe"
      Event = "NemesisAboutNectar02"
    }
    {
      Id = "Nemesis_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah..."
      Speaker = "Nemesis"
      Event = "NemesisAboutNectar02"
    }
    {
      Id = "Nemesis_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah bisa berdiri lagi, Tuan Putri? Segalanya aman di Crossroads, tak ada yang perlu dilaporkan."
      Speaker = "Nemesis"
      Event = "NemesisAboutFieldMeeting01"
    }
    {
      Id = "Melinoe_2229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beruntung sekali kita punya dirimu yang berjaga dengan begitu waspada di sini, Nemesis...! Oh ayolah, sudahi sandiwaranya. Apa yang terjadi, kapan kau kembali?"
      Speaker = "Melinoe"
      Event = "NemesisAboutFieldMeeting01"
    }
    {
      Id = "Nemesis_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak paham maksudmu, dan lagipula itu bukan urusanmu. Semoga Tiga Takdir membantumu dalam {#Emph}tugasmu."
      Speaker = "Nemesis"
      Event = "NemesisAboutFieldMeeting01"
    }
    {
      Id = "Melinoe_2230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak semudah yang kau bayangkan, kan? Tak kusangka perwujudan Pembalasan bisa searogan ini."
      Speaker = "Melinoe"
      Event = "NemesisAboutFieldMeeting01"
    }
    {
      Id = "Nemesis_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tutup mulutmu."
      Speaker = "Nemesis"
      Event = "NemesisAboutFieldMeeting01"
    }
    {
      Id = "Melinoe_2231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah Kepala Sekolah sudah tahu soal tamasya kecilmu itu? Seingatku, tak banyak hal yang luput dari perhatiannya."
      Speaker = "Melinoe"
      Event = "NemesisAboutFieldMeeting02"
    }
    {
      Id = "Nemesis_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kusarankan lebih baik kau urus saja tanggung jawabmu sendiri. Hecate tidak mengendalikanku, dan {#Emph}kau {#Prev}seharusnya menunjukkan sedikit rasa terima kasih."
      Speaker = "Nemesis"
      Event = "NemesisAboutFieldMeeting02"
    }
    {
      Id = "Melinoe_2232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk apa, membahayakan kita semua? Aku tidak pernah meminta bantuanmu, Nemesis."
      Speaker = "Melinoe"
      Event = "NemesisAboutFieldMeeting02"
    }
    {
      Id = "Nemesis_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Karena kau itu lemah."
      Speaker = "Nemesis"
      Event = "NemesisAboutFieldMeeting02"
    }
    {
      Id = "Melinoe_3230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa kali pertama aku melihatmu di luar sana, kukira kau cuma melampiaskan amarah. Tapi kau terus keluar malam demi malam. Kau memang gigih, tapi kau bakal tertangkap basah."
      Speaker = "Melinoe"
      Event = "NemesisAboutFieldMeeting03"
    }
    {
      Id = "Nemesis_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak akan kalau tak ada yang buka mulut. Lagipula, Hecate kemungkinan besar sudah tahu. Dia tidak sebodoh itu. Dia cuma membiarkanku belajar lewat cara keras, apa pun yang menurutnya perlu kupelajari. Menguntungkan bagi kami berdua."
      Speaker = "Nemesis"
      Event = "NemesisAboutFieldMeeting03"
    }
    {
      Id = "Melinoe_3231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah. Kurasa kita berdua sama-sama belajar banyak hal. Tapi aku tidak berniat melalaikan tanggung jawabku sedikit pun, cuma gara-gara kau mencoba meraih apa yang ditugaskan kepadaku."
      Speaker = "Melinoe"
      Event = "NemesisAboutFieldMeeting03"
    }
    {
      Id = "Nemesis_0261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seseorang harus melakukannya."
      Speaker = "Nemesis"
      Event = "NemesisAboutFieldMeeting03"
    }
    {
      Id = "Nemesis_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ceroboh. Semua gara-gara taruhan kecil itu. Begitu ngebetnya kau ingin mengalahkanku?"
      Speaker = "Nemesis"
      Event = "NemesisAboutCombatFailure01"
    }
    {
      Id = "Melinoe_2233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa menanyakan hal yang sama padamu. Kenapa kau sudah kembali secepat ini? Langkahmu tak mungkin jauh lebih maju dariku."
      Speaker = "Melinoe"
      Event = "NemesisAboutCombatFailure01"
    }
    {
      Id = "Nemesis_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya. Aku juga ceroboh..."
      Speaker = "Nemesis"
      Event = "NemesisAboutCombatFailure01"
    }
    {
      Id = "Nemesis_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah kalau Evil Eye itu berguna. Apa pun atau siapa pun di luar sana yang memaksamu tewas lebih awal, malam berikutnya gantian kau yang habisi mereka. Tradisi kuno, tapi manjur."
      Speaker = "Nemesis"
      Event = "NemesisAboutKeepsake01"
    }
    {
      Id = "Melinoe_4462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas hadiahnya. Mata itu terbukti sangat berguna dalam beberapa kesempatan saat aku berhasil mengungguli musuh-musuhku. Meski entah apakah aku sedang menegakkan keadilan pembalasan atau sekadar melampiaskan dendam, aku tak selalu yakin."
      Speaker = "Melinoe"
      Event = "NemesisAboutKeepsake01"
    }
    {
      Id = "Nemesis_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menyortir setiap tindak pembalasan memang butuh waktu. Tapi jangan terlalu mencemaskan urusan teknis seperti itu. Tindakanmu sah."
      Speaker = "Nemesis"
      Event = "NemesisAboutKeepsake01"
    }
    {
      Id = "Melinoe_4463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setiap tindak pembalasan disortir?"
      Speaker = "Melinoe"
      Event = "NemesisAboutKeepsake01"
    }
    {
      Id = "Nemesis_0346"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seharusnya memang begitu."
      Speaker = "Nemesis"
      Event = "NemesisAboutKeepsake01"
    }
    {
      Id = "Nemesis_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lebih sombong daripada Narcissus. Kulihat patung-patung dirimu di tempat latihan. Kau harus bekerja jauh lebih keras lagi untuk bisa kelihatan sehebat itu."
      Speaker = "Nemesis"
      Event = "NemesisAboutTrophyQuest01"
    }
    {
      Id = "Melinoe_4464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, a... aku tak ada sangkut pautnya dengan patung-patung itu. Yah, aku memang layak mendapatkannya, itu Anugerah dari Tabir yang diberikan kepada Jawara Malam...! Aduh, kedengarannya memang agak sombong..."
      Speaker = "Melinoe"
      Event = "NemesisAboutTrophyQuest01"
    }
    {
      Id = "Nemesis_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak usah dipikirkan. Patung-patung itu memang luar biasa. Dulu aku selalu bilang kau tak akan pernah bisa lebih besar dariku. Kena batunya aku sekarang."
      Speaker = "Nemesis"
      Event = "NemesisAboutTrophyQuest01"
    }
    {
      Id = "Melinoe_4465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keadilan pembalasan..."
      Speaker = "Melinoe"
      Event = "NemesisAboutTrophyQuest01"
    }
    {
      Id = "Nemesis_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa dengan singgasana yang sengaja ditaruh di dekat pos jagaanku itu? Itu cuma godaan. Tak pernah sekalipun kulihat {#Emph}kau {#Prev}duduk saat bertugas; kau pernah lihat aku duduk?"
      Speaker = "Nemesis"
      Event = "NemesisAboutThrone01"
    }
    {
      Id = "Melinoe_4458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan begitu, cuma... kupikir mungkin kau setidaknya ingin punya pilihan itu. Asal jangan berlebihan, kan? Dan kau {#Emph}memang {#Prev}harus berdiri lama sekali."
      Speaker = "Melinoe"
      Event = "NemesisAboutThrone01"
    }
    {
      Id = "Nemesis_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aturanku, bukan aturanmu. Kalau aku mulai duduk, aku bakal malas berdiri lagi. Apalagi pakai zirah seberat {#Emph}ini. {#Prev}Lagipula, esensi utama tugas jaga adalah harus tetap berdiri {#Emph}sepanjang waktu."
      Speaker = "Nemesis"
      Event = "NemesisAboutThrone01"
    }
    {
      Id = "Melinoe_4459"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Singgasananya bisa kusuruh singkirkan kalau kau lebih suka begitu."
      Speaker = "Melinoe"
      Event = "NemesisAboutThrone01"
    }
    {
      Id = "Nemesis_0341"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biarkan saja di situ untuk sekarang."
      Speaker = "Nemesis"
      Event = "NemesisAboutThrone01"
    }
    {
      Id = "Melinoe_4447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kita bersama di luar sana, rasanya hampir seperti mimpi. Terutama karena rasanya bukan seperti kita berdua yang biasanya, bisa-bisanya mengesampingkan semua tanggung jawab kita seperti itu..."
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship01"
    }
    {
      Id = "Nemesis_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau bilang kau menyesalinya, ya sudah; aku sih tidak. Kita kan tidak menjadikannya kebiasaan, lagipula... itu berhasil menyingkirkanmu dari kepalaku, persis seperti yang kuinginkan."
      Speaker = "Nemesis"
      Event = "NemesisAboutRelationship01"
    }
    {
      Id = "Melinoe_4448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitukah? Kalau bagiku dampaknya sama sekali tidak seperti itu. Aku justru jadi {#Emph}lebih sering {#Prev}memikirkanmu sejak saat itu. Dan aku {#Emph}tidak {#Prev}menyesalinya!"
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship01"
    }
    {
      Id = "Nemesis_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa? Yah, begitulah Pembalasan. Ada yang menang, ada yang kalah, tak ada yang bisa mendapatkan segalanya. Tapi mungkin seiring waktu, kita bisa... menyeimbangkannya. Urusan di antara kita tak boleh berat sebelah."
      Speaker = "Nemesis"
      Event = "NemesisAboutRelationship01"
    }
    {
      Id = "Melinoe_4449"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kupegang kata-katamu itu."
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship01"
    }
    {
      Id = "Nemesis_0329"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku juga."
      Speaker = "Nemesis"
      Event = "NemesisAboutRelationship01"
    }
    {
      Id = "Melinoe_4450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kita bersama di luar sana, Nem... Aku cuma ingin memastikan kau tidak marah padaku. Setidaknya tidak lebih marah dari biasanya. Kau bilang aku membuatmu tidak fokus dan bukan itu tujuanku."
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship01_B"
    }
    {
      Id = "Nemesis_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu, tak apa-apa, kita baik-baik saja. Kecuali kalau kau terus membesar-besarkannya. Kurasa sekarang kita sudah saling memahami, dan kita berdua menyukainya saat semuanya sudah pasti. Pokoknya, sampai jumpa di luar sana."
      Speaker = "Nemesis"
      Event = "NemesisAboutRelationship01_B"
    }
    {
      Id = "Melinoe_4451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa."
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship01_B"
    }
    {
      Id = "Nemesis_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sejak kapan ini dimulai. Dulu kau bahkan muak melihat mukaku. Aku juga muak melihat tampang cungkringmu itu. Lalu terjadi sesuatu. Masih kucoba ingat-ingat kapan tepatnya."
      Speaker = "Nemesis"
      Event = "NemesisAboutRelationship02"
    }
    {
      Id = "Melinoe_4452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perasaanku padamu perlahan menguat seiring berjalannya waktu. Amarah yang kau picu dalam diriku... aku mulai menyukainya. Hanya saja, aku tak pernah menyangka kau akan membalasnya."
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship02"
    }
    {
      Id = "Nemesis_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira kau cuma jago pamer. Tak pernah kusangka kau sekuat ini, dan bukan cuma secara fisik. Lagipula kau tak berlagak berlebihan lagi sekarang."
      Speaker = "Nemesis"
      Event = "NemesisAboutRelationship02"
    }
    {
      Id = "Melinoe_4453"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu barusan pujian, ya?"
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship02"
    }
    {
      Id = "Nemesis_0333"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Iya."
      Speaker = "Nemesis"
      Event = "NemesisAboutRelationship02"
    }
    {
      Id = "Melinoe_4471"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kadang aku bisa membaca gelagatmu, Nem, dan ada yang mengganjal. Jadi ada apa sebenarnya? Kalau kau tak keberatan cerita..."
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship03"
    }
    {
      Id = "Nemesis_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, begini... dengar, aku tak pernah sedekat ini dengan siapa pun dalam waktu lama. Memang sudah sifatku begitu. Jadi, aku kepikiran ke mana hubungan kita ini akan bermuara, dan aku tak suka ke mana arahnya."
      Speaker = "Nemesis"
      Event = "NemesisAboutRelationship03"
    }
    {
      Id = "Melinoe_4472"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh berpikir jalan kita sudah ditakdirkan kaku? Para Takdir memang saudarimu, tapi tak perlu kalian {#Emph}semua {#Prev}terjebak dalam ramalan yang digenapi sendiri."
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship03"
    }
    {
      Id = "Nemesis_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan itu, tapi... masalahnya, aku mulai lebih suka berada di dekatmu daripada sendirian. Kalau terus begini, aku bakal..."
      Speaker = "Nemesis"
      Event = "NemesisAboutRelationship03"
    }
    {
      Id = "Melinoe_4473"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku paham. Terlalu banyak hal manis bisa berbahaya. Tapi, haruskah kita terus-terusan mengkhawatirkan masa depan? Kita nikmati saja kebersamaan selagi bisa. Tanpa beban."
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship03"
    }
    {
      Id = "Nemesis_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tanpa beban, ya... mungkin kau benar. Selalu ada cara untuk menyeimbangkannya tanpa mengacaukannya."
      Speaker = "Nemesis"
      Event = "NemesisAboutRelationship03"
    }
    {
      Id = "Melinoe_4474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Usaha yang patut dicoba."
      Speaker = "Melinoe"
      Event = "NemesisAboutRelationship03"
    }
    {
      Id = "Nemesis_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada urusan apa sebenarnya kau dengan Eris? Kukira kau cukup waras untuk menjauhinya, paling tidak saat kau punya pilihan."
      Speaker = "Nemesis"
      Event = "NemesisAboutErisRelationship01"
    }
    {
      Id = "Melinoe_4454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin pertimbanganku kurang tepat dalam memilih kawan, Nemesis. Aku dan dia hampir tak punya kesamaan, tapi... dia membuatku sulit berpikir sepenuhnya rasional."
      Speaker = "Melinoe"
      Event = "NemesisAboutErisRelationship01"
    }
    {
      Id = "Nemesis_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kau bakal menuai getahnya nanti kalau berurusan dengannya. Begitu juga denganku, meski dengan cara yang beda. Mungkin justru itu daya tariknya. Pokoknya, jangan sampai kau bawa-bawa dia ke sini."
      Speaker = "Nemesis"
      Event = "NemesisAboutErisRelationship01"
    }
    {
      Id = "Melinoe_4455"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang tidak ada niat ke sana."
      Speaker = "Melinoe"
      Event = "NemesisAboutErisRelationship01"
    }
    {
      Id = "Nemesis_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masuk akal juga kau dan Takdir Kematian bisa akrab. Awalnya kukira dia bakal bikin kau muak seperti orang lain, tapi kalian berdua kelewat suka patuh pada perintah. Artinya kalian punya banyak kesamaan."
      Speaker = "Nemesis"
      Event = "NemesisAboutMorosRelationship01"
    }
    {
      Id = "Melinoe_4456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seingatku kami tak pernah sekalipun mengobrol soal betapa kami suka patuh perintah, meski kurasa kami memang cukup akrab. Itu tak mengganggumu, kan? Kau pasti bilang kalau iya."
      Speaker = "Melinoe"
      Event = "NemesisAboutMorosRelationship01"
    }
    {
      Id = "Nemesis_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pasti bilang kalau memang terganggu. Moros tak pernah jadi tipe yang ceria, ya kita semua juga tidak; tapi kalau keadaannya membaik, mungkin itu pertanda bagus buat yang lain. Mengingat siapa relasinya dan segala macamnya."
      Speaker = "Nemesis"
      Event = "NemesisAboutMorosRelationship01"
    }
    {
      Id = "Melinoe_4457"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menurutmu dia terlihat lebih bahagia?"
      Speaker = "Melinoe"
      Event = "NemesisAboutMorosRelationship01"
    }
    {
      Id = "Nemesis_0338"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin cuma perasaanku saja."
      Speaker = "Nemesis"
      Event = "NemesisAboutMorosRelationship01"
    }
    {
      Id = "Nemesis_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Orang-orang bilang kau sudah menyingkirkan Typhon untuk selamanya. Jangan harap aku percaya begitu saja. Apa yang sebenarnya terjadi di atas sana?"
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_5006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menyingkirkan Typhon untuk selamanya adalah cara paling ringkas untuk menggambarkannya. Ada mantra rumit bernama {#Emph}Pelenyapan Monster {#Prev}dan beberapa detail lain yang lebih baik tak usah dibahas. Tapi ya, kuyakini dia sudah tiada."
      Speaker = "Melinoe"
      Event = "NemesisAboutTyphonDeath01"
    }
    {
      Id = "Nemesis_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia abadi... mustahil dia bisa {#Emph}lenyap {#Prev}begitu saja. Dan kalaupun iya, kenapa tak lakukan hal yang sama pada Chronos? Atau pada siapa pun yang cari gara-gara denganmu cukup lama?"
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_5007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada hal lain yang kami siapkan untuk Chronos. Kalau untuk yang lainnya, mereka belum sampai sebegitunya mengusikku."
      Speaker = "Melinoe"
      Event = "NemesisAboutTyphonDeath01"
    }
    {
      Id = "Nemesis_0402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Belum? {#Emph}Hah."
      Speaker = "Nemesis"
      Event = "NemesisAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_5008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu Kepala Sekolah diculik? Chronos merebutnya tepat di depan mataku! Kalau saja kau berjaga sebagaimana mestinya, beliau... {#Emph}augh!"
      Speaker = "Melinoe"
      Event = "NemesisAboutHecateKidnapped01"
    }
    {
      Id = "Nemesis_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bicara apa kau ini, {#Emph}Chronos merebutnya. {#Prev}Kemarin malam aku baru saja melihatnya. Tapi, ke mana dia sekarang...?"
      Speaker = "Nemesis"
      Event = "NemesisAboutHecateKidnapped01"
    }
    {
      Id = "Melinoe_5009"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kan baru saja kubilang! {#Prev}Beliau mungkin disekap di Griya itu bersama yang lainnya, tapi aku... aku belum bisa menemukan posisinya. Bagaimana ini bisa terjadi, apa yang harusnya kita perbuat?"
      Speaker = "Melinoe"
      Event = "NemesisAboutHecateKidnapped01"
    }
    {
      Id = "Nemesis_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau serius? Sebentar, kenapa kau tak {#Emph}berbuat {#Prev}sesuatu kalau melihat kejadiannya sendiri? {#Emph}Aku {#Prev}bahkan tidak ada di sana!"
      Speaker = "Nemesis"
      Event = "NemesisAboutHecateKidnapped01"
    }
    {
      Id = "Melinoe_5010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku terlambat! Apa alasanmu? Setidaknya kau bisa memperhitungkan kemungkinan ancaman semacam itu!"
      Speaker = "Melinoe"
      Event = "NemesisAboutHecateKidnapped01"
    }
    {
      Id = "Nemesis_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selene yang serba melihat saja tak tahu ini bakal terjadi, mana mungkin {#Emph}aku {#Prev}bisa?! Tapi... rahasiakan ini. Bawa dia kembali, atau aku yang akan turun tangan."
      Speaker = "Nemesis"
      Event = "NemesisAboutHecateKidnapped01"
    }
    {
      Id = "Melinoe_5011"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aku {#Prev}yang akan membawanya."
      Speaker = "Melinoe"
      Event = "NemesisAboutHecateKidnapped01"
    }
    {
      Id = "Nemesis_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya kau balik dari Griya ayahmu. Hecate baik-baik saja? Setelah sang Titan menculiknya, aku... mestinya menjalankan tugas jaga lebih serius, dan... rasanya sulit memaafkan diriku sendiri, itu saja."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEnding01"
    }
    {
      Id = "Melinoe_5012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah hanya ingin kau memetik pelajaran dari kejadian itu. Aku bahkan sempat menduga beliau sengaja membiarkan dirinya ditangkap agar bisa lebih dekat ke target kita. Mungkin kau sebaiknya bicara dengannya...?"
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEnding01"
    }
    {
      Id = "Nemesis_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya. Terus bagaimana dengan Chronos? Kudengar dia belum benar-benar mati dan lenyap. Kenapa semua orang malah bersorak untukmu?"
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEnding01"
    }
    {
      Id = "Melinoe_5013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia sudah tiada dalam artian ancaman darinya sudah kita netralkan. Sekarang aku harus membiasakan diri menerimanya sebagai kakek, bukan lagi sebagai musuh bebuyutan."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEnding01"
    }
    {
      Id = "Nemesis_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada salahnya kalau dia merangkap keduanya. Ini tak pernah jadi bagian dari misi, dan sama sekali bukan sifatmu melenceng dari tujuan. Kita yakin Titan Waktu yang konon sudah 'dinetralkan' ini bisa dipercaya?"
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEnding01"
    }
    {
      Id = "Melinoe_5763"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah sudah menyegel kekuatan terkuatnya untuk berjaga-jaga. Bagaimanapun juga... kita berhasil, Nem!"
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEnding01"
    }
    {
      Id = "Nemesis_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu kenapa tampangmu kelihatan seperti mau berangkat bertarung lagi? Kudengar masih ada urusan terkait Waktu yang harus dibereskan."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEnding01"
    }
    {
      Id = "Melinoe_5015"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, memang, tapi..."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEnding01"
    }
    {
      Id = "Nemesis_0411"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berarti urusan kita {#Emph}belum {#Prev}selesai."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEnding01"
    }
    {
      Id = "Nemesis_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau masih melawan Chronos, dan kau masih melawan Typhon... bedanya sekarang, bukan cuma soal di mana tempatnya, tapi soal {#Emph}kapan {#Prev}waktunya. Kurang lebih begitu?"
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEnding02"
    }
    {
      Id = "Melinoe_5253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurang lebih begitu. Chronos {#Emph}kita{#Prev}, yang bisa dibilang telah mengalami semacam pencerahan batin, sedang memastikan agar {#Emph}waktu mengalir bebas ke depan{#Prev}, meminjam istilahnya sendiri. Kami ingin mencegah kemungkinan sekecil apa pun agar peristiwa kelam itu tak terulang lagi."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEnding02"
    }
    {
      Id = "Nemesis_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tidak paham. Yang sudah terjadi ya {#Emph}sudah terjadi. {#Prev}Waktu itu konsep yang sederhana; menjaga semuanya terus bergerak maju untuk {#Emph}semua orang {#Prev}dengan {#Emph}kecepatan yang sama persis."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEnding02"
    }
    {
      Id = "Melinoe_5254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rupanya, ada hal yang jauh lebih rumit dari sekadar itu."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEnding02"
    }
    {
      Id = "Nemesis_0416"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semuanya jadi makin rumit..."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEnding02"
    }
    {
      Id = "Melinoe_5273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih betah di Underworld meski tugasmu sudah selesai? Pasti banyak urusan yang tertunda di permukaan."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEnding03"
    }
    {
      Id = "Nemesis_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hecate bilang kondisinya harus {#Emph}benar-benar tepat {#Prev}untuk apa pun yang sedang kau usahakan sekarang. Aku tak mau mengacaukan segalanya."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEnding03"
    }
    {
      Id = "Melinoe_5274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas bantuannya. Aku cuma mengira kau rindu berada di atas sana, dan umat fana pasti merindukanmu juga. Masih banyak ketidakadilan yang harus kau beri ganjaran."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEnding03"
    }
    {
      Id = "Nemesis_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat sadar soal itu, terima kasih. Aku bakal kembali ke atas setelah kondisi Underworld membaik. Lagipula, kurasa keluargamu mengawasi ketat apa yang terjadi di sana."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEnding03"
    }
    {
      Id = "Melinoe_5275"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemungkinan besar memang begitu."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEnding03"
    }
    {
      Id = "Nemesis_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau menghabisi Typhon lainnya semalam. Kerja bagus, Tuan Putri. Urusan di Underworld juga sudah beres, terutama soal {#Emph}aliran waktu yang bebas meluncur {#Prev}dan segala macam omong kosong itu."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEndingTimeStopped01"
    }
    {
      Id = "Melinoe_5445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Urusan di Underworld beres, {#Emph}bagaimana caranya? {#Prev}Tunggu, kau bicara dengan Kakek Chronos, ya? Berarti... jangan-jangan..."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEndingTimeStopped01"
    }
    {
      Id = "Nemesis_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakekmu melakukan hal yang tak pernah bisa kau wujudkan, dan membawaku masuk ke Graha Hades. Salah satu sisa garis waktunya, berisi Chronos masa lalu yang selama ini kita buru. Dan aku berhasil menghabisinya."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEndingTimeStopped01"
    }
    {
      Id = "Melinoe_5265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}menghabisinya? {#Prev}Menaklukkan Chronos pada percobaan pertamamu? Mustahil... bahkan andai kau menang sekalipun, kau kemungkinan besar akan terjebak selamanya di celah temporal..."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEndingTimeStopped01"
    }
    {
      Id = "Nemesis_0446"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sana tanyakan sendiri pada kakekmu kapan-kapan."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEndingTimeStopped01"
    }
    {
      Id = "Melinoe_5266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tidak bercanda...!"
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEndingTimeStopped01"
    }
    {
      Id = "Melinoe_5267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh melenyapkan salah satu sisa eksistensi Chronos, Kakek sudah memastikannya. Itu... {#Emph}luar biasa{#Prev}, Nemesis. Kalau begitu, jika aku memusatkan kekuatanku pada sisa Typhon di Olympus..."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEndingTimeStopped02"
    }
    {
      Id = "Nemesis_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Biar aku yang menangani sisa Chronos di Underworld. Dari awal aku memang berencana melanjutkannya, apa pun yang terjadi. Hecate bahkan sudah memberiku lampu hijau."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEndingTimeStopped02"
    }
    {
      Id = "Melinoe_5268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar-benar luar biasa. Meski begitu, aku tetap berhak membasmi sisa Chronos dengan tanganku sendiri. Setidaknya, jalur itu memberiku kesempatan untuk menemui keluargaku."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEndingTimeStopped02"
    }
    {
      Id = "Nemesis_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terserah maumu saja. Perasaanku mengatakan jumlah {#Emph}sisa eksistensi Chronos yang berpotensi muncul {#Prev}di luar sana sudah lebih dari cukup untuk kita berdua."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEndingTimeStopped02"
    }
    {
      Id = "Melinoe_5269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, mari kita habisi mereka."
      Speaker = "Melinoe"
      Event = "NemesisPostTrueEndingTimeStopped02"
    }
    {
      Id = "Nemesis_0449"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo."
      Speaker = "Nemesis"
      Event = "NemesisPostTrueEndingTimeStopped02"
    }
    {
      Id = "Nemesis_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau menemukan Tiga Moirae. Aku ragu begitu kejadiannya. Paling-paling kau bahkan tidak mencari mereka. Merekalah yang menemukan {#Emph}dirimu."
      Speaker = "Nemesis"
      Event = "NemesisPostEpilogue01"
    }
    {
      Id = "Melinoe_5270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemungkinan besar memang demikian. Barangkali saat Chronos mengira telah mengasingkan mereka, mereka hanya berpura-pura tunduk. Dan kini memutuskan untuk menampakkan diri setelah ancaman darinya berlalu."
      Speaker = "Melinoe"
      Event = "NemesisPostEpilogue01"
    }
    {
      Id = "Nemesis_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "Khas mereka sekali. Tapi tak ada gunanya berspekulasi, kan? Lalu sekarang bagaimana, kita semua kembali tak punya kehendak bebas lagi? Atau mungkin dari dulu memang tak pernah punya."
      Speaker = "Nemesis"
      Event = "NemesisPostEpilogue01"
    }
    {
      Id = "Melinoe_5271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin mereka tak ingin kita mengetahui kepastiannya. Tampaknya mereka juga tak menuntut pengakuan penuh atas setiap tindakan yang kita ambil."
      Speaker = "Melinoe"
      Event = "NemesisPostEpilogue01"
    }
    {
      Id = "Nemesis_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa sebaiknya kita bersikap seolah-olah semuanya terkendali."
      Speaker = "Nemesis"
      Event = "NemesisPostEpilogue01"
    }
    {
      Id = "Melinoe_5272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau bagaimana lagi?"
      Speaker = "Melinoe"
      Event = "NemesisPostEpilogue01"
    }
    {
      Id = "Nemesis_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat dia, begitu damai. Tanpa beban sedikit pun di dunia. Bisa kau bayangkan?"
      Speaker = "Nemesis"
      Event = "NemesisWithHypnos01"
    }
    {
      Id = "Melinoe_0681"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia rupawan. Ada kebijaksanaan yang terpancar darinya, bahkan saat tertidur. Nyx pasti telah banyak mengajari kalian semua."
      Speaker = "Melinoe"
      Event = "NemesisWithHypnos01"
    }
    {
      Id = "Nemesis_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak juga. Hypnos melayani di Graha Hades di bawah asuhan Ibu. Tapi sesekali aku berpapasan dengannya. Kalau dia terbangun nanti, kuharap aku bisa ada di sana saat kalian akhirnya bertemu."
      Speaker = "Nemesis"
      Event = "NemesisWithHypnos01"
    }
    {
      Id = "Melinoe_0682_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, Nem..."
      Speaker = "Melinoe"
      Event = "NemesisWithHypnos01"
    }
    {
      Id = "Hecate_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dibutuhkan di pos jagamu, Nemesis. Atau kau berniat membangkangiku secara terang-terangan seperti saudarimu? Bergidik aku membayangkan apa yang akan dikatakan ibumu tentang kalian berdua."
      Speaker = "Hecate"
      Event = "NemesisWithHecate01"
    }
    {
      Id = "Nemesis_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau tak berhak mengungkit ibuku. Semua ini takkan terjadi andai kau menjalankan peranmu sebagai Dayang, dan memperingatkannya bahwa serangan sudah di depan mata."
      Speaker = "Nemesis"
      Event = "NemesisWithHecate01"
    }
    {
      Id = "Hecate_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jaga bicaramu atau kubungkam mulutmu itu! Kau boleh terus meratapi masa lalu yang bahkan tak kausaksikan sendiri, atau kau bisa melakukan apa yang diharapkan dari putri-putri Nyx. Atau terserah apa pun yang sedang Eris perbuat! Pilihanmu."
      Speaker = "Hecate"
      Event = "NemesisWithHecate01"
    }
    {
      Id = "Nemesis_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Hela napas>"
      Speaker = "Nemesis"
      Event = "NemesisWithHecate01"
    }
    {
      Id = "Hecate_0868"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Pembangkangan, kelalaian tugas, kepalsuan, intimidasi, keras kepala, belum lagi memberi contoh buruk bagi para Arwah... ada lagi yang mau kau tambahkan?"
      Speaker = "Hecate"
      Event = "NemesisWithHecate02"
    }
    {
      Id = "Nemesis_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kelewatan, ketidakpedulian, kecerobohan. Hecate, aku... Guru, kuterima penilaianmu, dan tak ada pembelaan atas tindakanku."
      Speaker = "Nemesis"
      Event = "NemesisWithHecate02"
    }
    {
      Id = "Hecate_0869"
      InheritFrom = "BaseNarrative"
      DisplayName = "Syukurlah pada Tiga Takdir setidaknya kau tak berbelit-belit. Nah kalau begitu, dengan pulihnya Nyx, sudah sepatutnya kumohon padanya agar membawamu kembali. Graha Hades tentu bisa memanfaatkan sepasang tangan tambahan, bukan?"
      Speaker = "Hecate"
      Event = "NemesisWithHecate02"
    }
    {
      Id = "Nemesis_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jangan. Kau tahu betul tempatku di sini. Tapi aku adalah Penjelmaan Pembalasan... Aku di sini bukan sekadar untuk berjaga."
      Speaker = "Nemesis"
      Event = "NemesisWithHecate02"
    }
    {
      Id = "Hecate_0870"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jelas sekali. Banyak pembalasan yang akan tiba, baik di atas maupun di bawah di masa-masa pergolakan ini... dan kau akan melaksanakannya sesuai kehendak Malam, kapan pun dan di mana pun kau anggap pantas."
      Speaker = "Hecate"
      Event = "NemesisWithHecate02"
    }
    {
      Id = "Nemesis_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pembalasan kapan pun dan di mana pun kuanggap pantas... kau mengizinkanku bertindak? Kebaikan apa yang telah kuperbuat sampai berhak mendapatkannya?"
      Speaker = "Nemesis"
      Event = "NemesisWithHecate02"
    }
    {
      Id = "Hecate_0871"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nemesis, jawaban itu ada padamu, bukan aku. Sekarang pergilah, dan pastikan tugas bersama kita tercapai: agar sang waktu dapat kembali mengalir bebas."
      Speaker = "Hecate"
      Event = "NemesisWithHecate02"
    }
    {
      Id = "Nemesis_0420"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Anggap saja sudah terlaksana, Guru."
      Speaker = "Nemesis"
      Event = "NemesisWithHecate02"
    }
    {
      Id = "Nemesis_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Nah, ini dia orangnya! Bukankah seharusnya kau sudah separuh jalan menuju Tartarus sekarang?"
      Speaker = "Nemesis"
      Event = "NemesisWithMoros01"
    }
    {
      Id = "Moros_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Putri. Syukurlah pada Tiga Takdir kau baik-baik saja. Nemesis dan aku baru saja bertukar kabar. Dia banyak bercerita tentangmu."
      Speaker = "Moros"
      Event = "NemesisWithMoros01"
    }
    {
      Id = "Melinoe_0906"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, hebat sekali. Bisa kubayangkan! Tapi, kau tak pernah cerita tentang saudaramu ini, Nemesis..."
      Speaker = "Melinoe"
      Event = "NemesisWithMoros01"
    }
    {
      Id = "Nemesis_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudaraku banyak. Apa yang perlu diceritakan? Tak pernah jadi pertanda baik kalau dia sampai muncul."
      Speaker = "Nemesis"
      Event = "NemesisWithMoros01"
    }
    {
      Id = "Moros_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayangnya, dia memang benar."
      Speaker = "Moros"
      Event = "NemesisWithMoros01"
    }
    {
      Id = "Nemesis_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ini tugasku, Moros. Sesederhana itu. Tak ada orang lain yang mau melakukannya. Tak ada orang lain yang {#Emph}mampu {#Prev}melakukannya."
      Speaker = "Nemesis"
      Event = "NemesisWithMoros02"
    }
    {
      Id = "Moros_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi pembalasan yang kau anggap pantas kau bagikan itu... bagaimana kau bisa begitu yakin bahwa keputusan atas konsekuensi seperti itu sepenuhnya milikmu seorang? {#Emph}Tiga Takdir {#Prev}pun punya andil besar dalam menentukannya."
      Speaker = "Moros"
      Event = "NemesisWithMoros02"
    }
    {
      Id = "Nemesis_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, kau pikir aku cuma boneka tanpa pikiran yang seenaknya disetir saudari-saudari kita itu? Yang benar saja! Ramalan mereka samar karena mereka sendiri tak benar-benar tahu apa yang akan terjadi."
      Speaker = "Nemesis"
      Event = "NemesisWithMoros02"
    }
    {
      Id = "Moros_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekalipun itu benar, beban untuk memilih siapa yang berhak menerima apa... aku takkan sudi menanggungnya sendirian. Kalau tidak, penilaianku harus sempurna setiap saat; padahal kita makhluk yang tak luput dari salah."
      Speaker = "Moros"
      Event = "NemesisWithMoros02"
    }
    {
      Id = "Nemesis_0234"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bicara saja tentang dirimu sendiri."
      Speaker = "Nemesis"
      Event = "NemesisWithMoros02"
    }
    {
      Id = "Moros_0333"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang sedang kubicarakan..."
      Speaker = "Moros"
      Event = "NemesisWithMoros02"
    }
    {
      Id = "Moros_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Situasi yang cukup pelik bagi kita, Saudari. Jelas bukan hal yang bisa kuantisasi saat pertama kali tiba di sini. Aneh sekali... jadi apa yang harus kita lakukan? Bukan niatku untuk ikut campur."
      Speaker = "Moros"
      Event = "NemesisWithMorosAboutRelationships01"
    }
    {
      Id = "Nemesis_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak usah cemaskan itu, cemaskan saja caramu tutup mulut saat dia berjalan mendekati kita. Santai sekali lagaknya seolah tak tahu apa-apa."
      Speaker = "Nemesis"
      Event = "NemesisWithMorosAboutRelationships01"
    }
    {
      Id = "Melinoe_3241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, memangnya {#Emph}ada {#Prev}apa? Apa yang sedang kalian berdua bicarakan, kalau boleh kutahu?"
      Speaker = "Melinoe"
      Event = "NemesisWithMorosAboutRelationships01"
    }
    {
      Id = "Nemesis_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membicarakan {#Emph}dirimu{#Prev}, Putri, meski bukan hal yang perlu dipusingkan oleh {#Emph}kepala cantikmu {#Prev}itu. Urusanmu sudah cukup banyak, dan... kami bisa menyelesaikannya sendiri. Permisi dulu, ya?"
      Speaker = "Nemesis"
      Event = "NemesisWithMorosAboutRelationships01"
    }
    {
      Id = "Moros_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu. Tidak, aku lebih memilih berterus terang. Tuan Putri, persoalannya adalah kami berdua menaruh perasaan padamu yang, dalam kondisi tertentu, bisa menjelma menjadi rasa iri yang justru harus dihukum oleh Nemesis. Suatu akibat yang berusaha kami hindari."
      Speaker = "Moros"
      Event = "NemesisWithMorosAboutRelationships01"
    }
    {
      Id = "Melinoe_3242"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}A... aku paham. Terima kasih sudah memberitahuku. Aku takkan pernah ingin melukai kalian berdua. Yah, mungkin terkecuali {#Emph}kau{#Prev}, Nemesis, tapi itu cuma saat kita bertarung tanding. Bagaimana kita menyelesaikannya? Perasaan kita tak boleh menghalangi tujuan kita."
      Speaker = "Melinoe"
      Event = "NemesisWithMorosAboutRelationships01"
    }
    {
      Id = "Nemesis_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Takkan menghalangi kok. Lagipula, kau sibuk, bukan berarti kau akan menyerahkan jiwa dan ragamu untuk salah satu dari kami. Seperti kaum fana bodoh yang tak tahu apa-apa."
      Speaker = "Nemesis"
      Event = "NemesisWithMorosAboutRelationships01"
    }
    {
      Id = "Melinoe_3243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja tidak... mengapa aku atau siapa pun di antara kita harus memilih? Kita ini dewa. Jika kalian ingin mengenalku lebih jauh, baguslah. Namun terimalah bahwa aku takkan membiarkan diriku terikat pada siapa pun, begitu pula aku tak mengharapkan hal sebaliknya dari kalian. Jelas semuanya?"
      Speaker = "Melinoe"
      Event = "NemesisWithMorosAboutRelationships01"
    }
    {
      Id = "Nemesis_0238"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Ya."
      Speaker = "Nemesis"
      Event = "NemesisWithMorosAboutRelationships01"
    }
    {
      Id = "Moros_0336"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, begitulah."
      Speaker = "Moros"
      Event = "NemesisWithMorosAboutRelationships01"
    }
    {
      Id = "Nemesis_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bukan. Satu hal terakhir, Eris. Hecate mungkin berjanji pada Ibu untuk menjagamu, tapi aku tidak. Jadi enyah dari sini sebelum aku naik darah."
      Speaker = "Nemesis"
      Event = "NemesisWithEris01"
    }
    {
      Id = "Eris_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh tolong deh, Nemmie, kamu kan sudah sewot duluan! Dan aku bakal keluar-masuk sesuka hatiku, makasih. Di sini ngebosenin banget kok, aku juga nggak bakal tahan lama-lama."
      Speaker = "Eris"
      Event = "NemesisWithEris01"
    }
    {
      Id = "Nemesis_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Keluar-masuk sesuka hatimu? {#Prev}Kau membahayakan tugas kita. Jangan bersikap kekanak-kanakan."
      Speaker = "Nemesis"
      Event = "NemesisWithEris01"
    }
    {
      Id = "Eris_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jangan bersikap kekanak-kanakan. {#Prev}Tunggutunggutunggu... apa itu artinya kamu jadi {#Emph}ibuku? {#Prev}Aku bahkan nggak pernah tunduk pada Nyx. Kamu pikir aku bakal mulai nurut sama {#Emph}kamu?"
      Speaker = "Eris"
      Event = "NemesisWithEris01"
    }
    {
      Id = "Nemesis_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimanapun juga, kau akan menuai ganjaranmu."
      Speaker = "Nemesis"
      Event = "NemesisWithEris01"
    }
    {
      Id = "Eris_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Uuuh! {#Prev}Ancaman nih!"
      Speaker = "Eris"
      Event = "NemesisWithEris01"
    }
    {
      Id = "Eris_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}...Ya terus? {#Prev}Dan menurutmu apa yang bisa kamu lakuin, heh, Nemmie? Kamu nggak bisa ngajak aku gelut di tengah {#Emph}Crossroads-mu {#Prev}ini."
      Speaker = "Eris"
      Event = "NemesisWithEris02"
    }
    {
      Id = "Nemesis_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang tak bisa berbuat apa-apa di {#Emph}sini. {#Prev}Tapi aku bisa saja memergokimu kelayapan di luar sana. Dan nanti kau takkan dapat perlakuan khusus. Cuma sekadar target lain."
      Speaker = "Nemesis"
      Event = "NemesisWithEris02"
    }
    {
      Id = "Eris_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh! {#Prev}Nemesis, tega banget sih kamu? Kamu kan {#Emph}saudariku! {#Prev}Kita nggak perlu {#Emph}bertengkar! {#Prev}Lagi pula, kenapa kamu pikir kamu bakal bisa {#Emph}menangkapku? {#Prev}Kamu itu terlalu {#Emph}lambat."
      Speaker = "Eris"
      Event = "NemesisWithEris02"
    }
    {
      Id = "Nemesis_0243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita lihat saja nanti."
      Speaker = "Nemesis"
      Event = "NemesisWithEris02"
    }
    {
      Id = "Eris_0113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kamu {#Prev}yang bakal lihat nanti."
      Speaker = "Eris"
      Event = "NemesisWithEris02"
    }
    {
      Id = "Nemesis_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Charon, masukkan ini ke otakmu, ini bukan apa yang kupesan. Kau mau kembalikan uangku atau tidak?"
      Speaker = "Nemesis"
      Event = "NemesisWithCharon01"
    }
    {
      Id = "Charon_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nrrnnn, rrnnngghhhhh..."
      Speaker = "Charon"
      Event = "NemesisWithCharon01"
    }
    {
      Id = "Nemesis_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dengar satu kata pun dari yang kuucapkan tidak sih? {#Emph}Ungh{#Prev}, buang-buang waktu saja."
      Speaker = "Nemesis"
      Event = "NemesisWithCharon01"
    }
    {
      Id = "Nemesis_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Siapa di antara kami yang membawakanmu lebih banyak Emas? Kau bisa beri tahu aku. Beri aku tanda. Mengangguk dua kali kalau itu aku."
      Speaker = "Nemesis"
      Event = "NemesisWithCharon02"
    }
    {
      Id = "Charon_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrnnnngghh, grrrr..."
      Speaker = "Charon"
      Event = "NemesisWithCharon02"
    }
    {
      Id = "Nemesis_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya tadi satu anggukan... atau mungkin dua..."
      Speaker = "Nemesis"
      Event = "NemesisWithCharon02"
    }
    {
      Id = "Nemesis_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tahu hal-hal semacam ini, Nak. Untuk ukuran kehidupan fana, hidupmu masuk ke salah satu kategori terendah. Jauh lebih singkat dan sengsara dibanding rata-rata. Jadi sekarang kau menebusnya sedikit."
      Speaker = "Nemesis"
      Event = "NemesisWithIcarus01"
    }
    {
      Id = "Icarus_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Erm{#Prev}, jadi maksud Anda, Dewi, hidup saya setelah kematian lebih baik karena hidup saya {#Emph}sebelum {#Prev}mati berada di {#Emph}salah satu kategori terendah {#Prev}menurut semacam sistem pemeringkatan milik Anda... begitu ya?"
      Speaker = "Icarus"
      Event = "NemesisWithIcarus01"
    }
    {
      Id = "Nemesis_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Jangan sia-siakan, jangan serakah, kau bakal baik-baik saja. Lanjutkan saja apa yang sedang kau kerjakan."
      Speaker = "Nemesis"
      Event = "NemesisWithIcarus01"
    }
    {
      Id = "Icarus_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi... saya sangat beruntung bisa berada di sini bersama kalian semua. Hidup singkat demi keabadian yang layak, menurut nalar Anda itu bukanlah pertukaran yang adil. Apa yang sudah saya perbuat hingga pantas menerima {#Emph}ini...?"
      Speaker = "Icarus"
      Event = "NemesisWithIcarus01"
    }
    {
      Id = "Nemesis_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertama, kau tidak terlalu banyak tanya. Dan jangan sepelekan keabadian."
      Speaker = "Nemesis"
      Event = "NemesisWithIcarus01"
    }
    {
      Id = "Icarus_0480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak akan. Saya bersumpah."
      Speaker = "Icarus"
      Event = "NemesisWithIcarus01"
    }
    {
      Id = "Nemesis_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum fana belakangan ini pasti mengira mereka bisa lolos dari hukuman apa pun..."
      Speaker = "Nemesis"
      Event = "NemesisChat01"
    }
    {
      Id = "Nemesis_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi sibuk sekali berjaga seperti yang bisa kau lihat."
      Speaker = "Nemesis"
      Event = "NemesisChat02"
    }
    {
      Id = "Nemesis_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak sekali kejahatan terjadi di luar sana, dibiarkan begitu saja..."
      Speaker = "Nemesis"
      Event = "NemesisChat03"
    }
    {
      Id = "Nemesis_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sana jalan. Tugasmu itu takkan selesai dengan sendirinya."
      Speaker = "Nemesis"
      Event = "NemesisChat04"
    }
    {
      Id = "Nemesis_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya sekarang aku berada di permukaan, menjatuhkan ganjaran yang setimpal..."
      Speaker = "Nemesis"
      Event = "NemesisChat05"
    }
    {
      Id = "Nemesis_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak ke mana-mana, jadi sana pergi dan selesaikan {#Emph}tugasmu."
      Speaker = "Nemesis"
      Event = "NemesisChat06"
    }
    {
      Id = "Nemesis_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita semua akan menerima apa yang pantas kita terima. Tidak lebih, tidak kurang."
      Speaker = "Nemesis"
      Event = "NemesisChat07"
    }
    {
      Id = "Nemesis_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketinggalan semua keseruan selagi kau pergi."
      Speaker = "Nemesis"
      Event = "NemesisChat08"
    }
    {
      Id = "Nemesis_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lakukan sesukamu. Aku akan tetap di sini."
      Speaker = "Nemesis"
      Event = "NemesisChat09"
    }
    {
      Id = "Nemesis_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Permisi, aku masih bertugas, seperti yang bisa kau lihat."
      Speaker = "Nemesis"
      Event = "NemesisChat10"
    }
    {
      Id = "Nemesis_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ungh, {#Prev}dosa apa coba sampai aku harus nanggung ini..."
      Speaker = "Nemesis"
      Event = "NemesisChat11"
    }
    {
      Id = "Nemesis_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah mau patroli lagi, Tuan Putri?"
      Speaker = "Nemesis"
      Event = "NemesisChat12"
    }
    {
      Id = "Nemesis_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pecahkan beberapa tengkorak mewakiliku, mereka memang pantas mendapatkannya."
      Speaker = "Nemesis"
      Event = "NemesisChat13"
    }
    {
      Id = "Nemesis_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma bisa membayangkan apa saja yang kau lakukan di luar sana."
      Speaker = "Nemesis"
      Event = "NemesisChat14"
    }
    {
      Id = "Nemesis_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kau tak kelewat serakah di luar sana."
      Speaker = "Nemesis"
      Event = "NemesisChat15"
    }
    {
      Id = "Nemesis_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mending bawa bokong krempengmu itu balik ke luar sana, ya?"
      Speaker = "Nemesis"
      Event = "NemesisChat16"
    }
    {
      Id = "Nemesis_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sana menangis pada Kepala Sekolahmu, Hecate. Orangnya ada di sebelah sana."
      Speaker = "Nemesis"
      Event = "NemesisChat17"
    }
    {
      Id = "Nemesis_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ajaran Penyihir Persimpangan Jalan cuma bisa membawamu sejauh ini."
      Speaker = "Nemesis"
      Event = "NemesisChat18"
    }
    {
      Id = "Nemesis_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cepat atau lambat, semuanya bakal berputar kembali ke titik awal, Tuan Putri."
      Speaker = "Nemesis"
      Event = "NemesisChat19"
    }
    {
      Id = "Nemesis_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lumayan lama di permukaan tadi, ya..."
      Speaker = "Nemesis"
      Event = "NemesisChat20"
    }
    {
      Id = "Nemesis_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergi lama sekali tadi, kukira kau tersesat."
      Speaker = "Nemesis"
      Event = "NemesisChat21"
    }
    {
      Id = "Nemesis_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jauh-jauh balik kemari cuma buat menjilat lukamu lalu berangkat lagi?"
      Speaker = "Nemesis"
      Event = "NemesisChat22"
    }
    {
      Id = "Nemesis_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kau pasti sudah menyerah sekarang."
      Speaker = "Nemesis"
      Event = "NemesisChat23"
    }
    {
      Id = "Nemesis_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Persimpangan Jalan aman terkendali, untuk yang keseribu kalinya..."
      Speaker = "Nemesis"
      Event = "NemesisChat24"
    }
    {
      Id = "Nemesis_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bakal terus menyiksa dirimu seperti ini, ya."
      Speaker = "Nemesis"
      Event = "NemesisChat25"
    }
    {
      Id = "Nemesis_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugas jaga yang tak ada gunanya ini terkendali dengan baik."
      Speaker = "Nemesis"
      Event = "NemesisChat26"
    }
    {
      Id = "Nemesis_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sana pergi, urusanmu jauh lebih penting daripada ngobrol denganku."
      Speaker = "Nemesis"
      Event = "NemesisChat27"
    }
    {
      Id = "Nemesis_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau gantikan tugasku? Silakan saja."
      Speaker = "Nemesis"
      Event = "NemesisChat28"
    }
    {
      Id = "Nemesis_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Temukan Chronos, bunuh Chronos. Cepat jalan."
      Speaker = "Nemesis"
      Event = "NemesisChat29"
    }
    {
      Id = "Nemesis_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kematian bagi Chronos, Tuan Putri."
      Speaker = "Nemesis"
      Event = "NemesisChat30"
    }
    {
      Id = "Nemesis_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau sudah siap menyerah, bilang ke Hecate aku masih bersedia menggantikanmu."
      Speaker = "Nemesis"
      Event = "NemesisChat31"
    }
    {
      Id = "Nemesis_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sendiri baru saja kembali, walau hasilnya tidak terlalu bagus."
      Speaker = "Nemesis"
      Event = "NemesisChat32"
    }
    {
      Id = "Nemesis_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin sampai ketemu di luar sana nanti malam, kalau kau belum kapok."
      Speaker = "Nemesis"
      Event = "NemesisChat33"
    }
    {
      Id = "Nemesis_0461"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah beberapa malam tak melihatmu di luar sana, jadi mungkin sebentar lagi kita berpapasan."
      Speaker = "Nemesis"
      Event = "NemesisChat34"
    }
    {
      Id = "Nemesis_0462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih betah di permukaan untuk sementara, atau aku bakal melihatmu di bawah sana?"
      Speaker = "Nemesis"
      Event = "NemesisChat35"
    }
    {
      Id = "Nemesis_0463"
      InheritFrom = "BaseNarrative"
      DisplayName = "Situasi di permukaan akhir-akhir ini mulai membaik, atau bagaimana?"
      Speaker = "Nemesis"
      Event = "NemesisChat36"
    }
    {
      Id = "Nemesis_0464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kubereskan urusan di Tartarus saat kau sibuk di permukaan."
      Speaker = "Nemesis"
      Event = "NemesisChat37"
    }
    {
      Id = "Nemesis_0465"
      InheritFrom = "BaseNarrative"
      DisplayName = "Serahkan Underworld padaku, dan sana urus masalah di atas."
      Speaker = "Nemesis"
      Event = "NemesisChat38"
    }
    {
      Id = "Nemesis_0466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa menghadapi Chronos lagi kalau kau lebih memilih berurusan dengan Typhon."
      Speaker = "Nemesis"
      Event = "NemesisChat39"
    }
    {
      Id = "Nemesis_0467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan tetap di Underworld kalau kau mau pergi ke atas."
      Speaker = "Nemesis"
      Event = "NemesisChat40"
    }
    {
      Id = "Nemesis_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kembalilah ke luar sana, mungkin aku akan menyusul setelah menyelesaikan beberapa urusan."
      Speaker = "Nemesis"
      Event = "NemesisChat41"
    }
    {
      Id = "MelinoeField_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini, Nemesis! Demi ketidakpatuhanmu yang keras kepala itu. Semoga nalurimu tak pernah menyesatkanmu."
      Speaker = "Melinoe"
      Event = "NemesisGiftDecline01"
    }
    {
      Id = "NemesisField_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar mengira ini saat yang tepat buat kita santai-santai dan tertawa sambil minum sebotol miras enak? Seperti tak ada kerjaan lain yang lebih penting saja."
      Speaker = "Nemesis"
      Event = "NemesisGiftDecline01"
    }
    {
      Id = "Melinoe_0685"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nemesis? Mungkin kita bisa mulai dari awal lagi. Ini, aku bawakan sesuatu untukmu..."
      Speaker = "Melinoe"
      Event = "NemesisGift01"
    }
    {
      Id = "Nemesis_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak butuh belas kasihanmu, Tuan Putri, atau godaan apa pun baik saat aku bertugas maupun lepas tugas. Lagi pula kau melakukan ini karena menginginkan sesuatu dariku, kan? Jadi nih! Ambil sepuasmu."
      Speaker = "Nemesis"
      Event = "NemesisGift01"
    }
    {
      Id = "Nemesis_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau cari gara-gara biar aku dimarahi Hecate, ya? Mending bawa pergi botolmu ini sebelum kuhancurkan, lalu angkat pantat kurusmu itu dari sini."
      Speaker = "Nemesis"
      Event = "NemesisGift02"
    }
    {
      Id = "Melinoe_0627"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak bermaksud cari gara-gara untukmu, Nem, aku cuma... {#Emph}ngh{#Prev}. Sudahlah, lupakan saja."
      Speaker = "Melinoe"
      Event = "NemesisGift02"
    }
    {
      Id = "Nemesis_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, buatku? Nggak ada cara lain ya buat menguji salah satu racunmu? Kalian para penyihir nggak secerdik yang kalian kira."
      Speaker = "Nemesis"
      Event = "NemesisGift03"
    }
    {
      Id = "Melinoe_0628"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu persis kata-kata yang bakal diucapkan orang yang diam-diam diracuni oleh penyihir, tahu."
      Speaker = "Melinoe"
      Event = "NemesisGift03"
    }
    {
      Id = "Nemesis_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ugh."
      Speaker = "Nemesis"
      Event = "NemesisGift03"
    }
    {
      Id = "Nemesis_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, jangan mulai lagi. Dengar ya, aku sudah memaafkanmu kemarin. Bukan berarti itu undangan buat memberiku barang begini lagi. Aku tak suka berutang budi pada siapa pun."
      Speaker = "Nemesis"
      Event = "NemesisGift04"
    }
    {
      Id = "Melinoe_2097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima saja dan nikmati, Nem. Lagipula, kudengar kau sedang mencari racun penyihir kami lagi. Sepertinya tidak ada yang bisa menikmatinya sebaik dirimu."
      Speaker = "Melinoe"
      Event = "NemesisGift04"
    }
    {
      Id = "Nemesis_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa kau terus begini, sih? Kau menang, oke? Kau mengalahkanku. Bahkan sebelum kau mulai. Hal terakhir yang kubutuhkan sekarang adalah rasa kasihanmu."
      Speaker = "Nemesis"
      Event = "NemesisGift05"
    }
    {
      Id = "Melinoe_0629"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nemesis... Aku tak tahu harus bagaimana lagi. Di luar sana kita sudah dikepung musuh. Apa kita benar-benar butuh musuh tambahan?"
      Speaker = "Melinoe"
      Event = "NemesisGift05"
    }
    {
      Id = "Nemesis_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau bukan musuhku, Melinoë. Aku cuma... Pergi saja sana."
      Speaker = "Nemesis"
      Event = "NemesisGift05"
    }
    {
      Id = "Melinoe_2250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, Nem..."
      Speaker = "Melinoe"
      Event = "NemesisGift05"
    }
    {
      Id = "Nemesis_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kusarankan kau segera berhenti memberiku Nektar-Nektar ini. Segala sesuatu yang berlebihan itu tidak baik. Harusnya kau sudah tahu itu tentang diriku."
      Speaker = "Nemesis"
      Event = "NemesisGift06"
    }
    {
      Id = "Melinoe_4430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, kau tidak boleh berlebihan sama seperti yang lain. Tapi, apa yang akan terjadi kalau berlebihan? Kau harus menghukum dirimu sendiri?"
      Speaker = "Melinoe"
      Event = "NemesisGift06"
    }
    {
      Id = "Nemesis_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya. Dan jangan sok suci seolah kau tidak bakal melakukan hal yang sama. Satu hal yang kuakui dari Hecate adalah dia sangat menghargai disiplin. Kadang kita harus mendisiplinkan diri kita sendiri."
      Speaker = "Nemesis"
      Event = "NemesisGift06"
    }
    {
      Id = "Melinoe_4431"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita juga harus merawat diri kita sendiri."
      Speaker = "Melinoe"
      Event = "NemesisGift06"
    }
    {
      Id = "Melinoe_4432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau membenci segala hal yang berlebihan, tapi kurasa satu botol Ambrosia lagi tidak akan menggoyahkan timbanganmu, kan, Nem?"
      Speaker = "Melinoe"
      Event = "NemesisGift07"
    }
    {
      Id = "Nemesis_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa jadi. Aku tak akan pergi ke kedai cuma buat membuktikannya, jadi mending kau bawa pulang lagi. Sekarang bukan waktunya buat bermewah-mewah."
      Speaker = "Nemesis"
      Event = "NemesisGift07"
    }
    {
      Id = "Melinoe_4433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kau simpan saja sampai kau merasa pantas menerimanya? Kalau kau tidak menikmatinya, tidak perlu khawatir, kan?"
      Speaker = "Melinoe"
      Event = "NemesisGift07"
    }
    {
      Id = "Nemesis_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terserah kalau kau mau membuang-buang barang berharga begini. Tapi ini bakal masuk tumpukan simpanan, dan mungkin tak akan pernah melihat sedikit cahaya yang kita punya. Selama kau tak keberatan."
      Speaker = "Nemesis"
      Event = "NemesisGift07"
    }
    {
      Id = "Melinoe_4434"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak keberatan."
      Speaker = "Melinoe"
      Event = "NemesisGift07"
    }
    {
      Id = "Melinoe_4435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir aku bisa membawakanmu tambahan untuk simpanan tak-tersentuhmu itu, Nemesis. Karena siapa tahu di suatu saat nanti kau pantas menerimanya."
      Speaker = "Melinoe"
      Event = "NemesisGift08"
    }
    {
      Id = "Nemesis_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kau {#Prev}yang tidak tahu. Atas dasar apa kau berpikir aku pantas mendapatkan barang begini? Akhir-akhir ini aku sama sekali tidak sedang berada di puncak kemampuanku."
      Speaker = "Nemesis"
      Event = "NemesisGift08"
    }
    {
      Id = "Melinoe_4436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku tentu bukan penentu perkara seperti itu, tapi menurutku kau {#Emph}memang {#Prev}pantas mendapatkannya. Kau pasti menuntut dirimu sendiri lebih keras dari siapa pun. Andaikan sesekali kau bisa melihat dirimu seperti caraku memandangmu."
      Speaker = "Melinoe"
      Event = "NemesisGift08"
    }
    {
      Id = "Nemesis_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak tahu apa maksud perkataanmu {#Emph}tadi{#Prev}. Kita berdua mengincar tujuan yang sama, dan sama-sama berusaha keras. Terus kenapa? Ya sudahlah, barang ini masuk simpanan juga."
      Speaker = "Nemesis"
      Event = "NemesisGift08"
    }
    {
      Id = "Melinoe_4437"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tempat yang semestinya."
      Speaker = "Melinoe"
      Event = "NemesisGift08"
    }
    {
      Id = "Nemesis_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ambrosia. Dengar ya, kau harus tahu kalau simpanan tak-tersentuhku sudah hampir penuh. Nggak mau kan sampai meluap?"
      Speaker = "Nemesis"
      Event = "NemesisGift09"
    }
    {
      Id = "Melinoe_4438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu bisa mengajakku ke kedai agar kita bisa mencicipi sedikit simpananmu itu. Buat apa menimbunnya selamanya? Selain alasan-alasan yang kau sebutkan tadi."
      Speaker = "Melinoe"
      Event = "NemesisGift09"
    }
    {
      Id = "Nemesis_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku nggak bakal mengajakmu ke mana pun selama kau terus bersikap begini. Dan aku nggak suka kau meremehkan hal soal menghindari hal berlebihan. Itu bidang keahlianku. Bukan milikmu."
      Speaker = "Nemesis"
      Event = "NemesisGift09"
    }
    {
      Id = "Melinoe_4439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf, Nemesis, aku tak berniat kasar; kata-kata yang rasanya sulit kupercaya kuucapkan sendiri, apalagi kurasakan, mengingat dulunya kita selalu saling sindir."
      Speaker = "Melinoe"
      Event = "NemesisGift09"
    }
    {
      Id = "Nemesis_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu semuanya jauh lebih menyenangkan dan sederhana, ya. Tapi sekarang kita terjebak dalam hubungan yang entah apa ini, sampai kita bisa lepas darinya, dan kita akhiri itu sekarang. Tidak ada Ambrosia lagi. Selamanya."
      Speaker = "Nemesis"
      Event = "NemesisGift09"
    }
    {
      Id = "Melinoe_4440"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamanya? Kalau Garam Mandi bagaimana?"
      Speaker = "Melinoe"
      Event = "NemesisGift09"
    }
    {
      Id = "Nemesis_0320"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Terkekeh>"
      Speaker = "Nemesis"
      Event = "NemesisGift09"
    }
    {
      Id = "Melinoe_3354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku tahu kemungkinan besarnya kau bakal bilang {#Emph}tidak{#Prev}, tapi... aku punya sebotol racun ekstra spesial di sini, dan kupikir mungkin kita bisa menikmatinya berdua di kedai, kau dan aku?"
      Speaker = "Melinoe"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Nemesis_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sopan amat, sih! Yah, kurasa tidak terlalu berlebihan kalau kita bagi dua botolnya... {#Emph}ngh{#Prev}, tahu tidak? Terserah deh, ayo."
      Speaker = "Nemesis"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Nemesis_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ayo, katakan: Kau kubuat babak belur. Olehku. Kurasa waktu itulah aku pertama kali berpikir punya kesempatan. Bahwa Hecate akan memilihku. Seandainya aku bisa mengalahkanmu seperti itu beberapa kali lagi."
      Speaker = "Nemesis"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Melinoe_2099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ini monster, Nem! Aku sampai mulai takut harus bertarung tanding denganmu. Tapi, cara terbaik untuk bertambah kuat adalah berlatih melawan lawan yang lebih tangguh."
      Speaker = "Melinoe"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Nemesis_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin itu sebabnya kemampuanku jalan di tempat. Kita sudah tak pernah bertarung lagi seperti dulu. Memikirkannya saja membuatku muak."
      Speaker = "Nemesis"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Melinoe_2100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu... kau melamun memikirkan latihan tanding kita dulu? Aku harus tersanjung atau takut, nih?"
      Speaker = "Melinoe"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Nemesis_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cepat habiskan jatah racun sialanmu itu! Aku tak punya waktu semalaman untuk duduk santai dan memanjakan egomu. Sumpah, manusia fana memang menuruni sifat-sifat terburuk kita."
      Speaker = "Nemesis"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Melinoe_2101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma bercanda. Tapi, mungkin aku memang lebih mementingkan diri sendiri daripada yang kusadari. Aku {#Emph}kan {#Prev}setengah fana dari garis keturunan ibuku..."
      Speaker = "Melinoe"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Nemesis_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu membuatmu berbeda, kuakui itu. Sekarang ayolah, aku harus segera kembali. Sebelum Hecate memergoki kita akur dan kita berdua diceramahi habis-habisan tanpa henti."
      Speaker = "Nemesis"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Nemesis_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bisa kurasakan racunnya mulai bereaksi. Sebaiknya kau segera angkat kaki dari sini sebelum aku pingsan."
      Speaker = "Nemesis"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Melinoe_2102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini akan jadi rahasia kita."
      Speaker = "Melinoe"
      Event = "NemesisTaverna01"
    }
    {
      Id = "Nemesis_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira kubilang sudah tak ada lagi Ambrosia. Jangan minta-minta lagi."
      Speaker = "Nemesis"
      Event = "NemesisTavernaDecline01"
    }
    {
      Id = "Melinoe_5874"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke, oke..."
      Speaker = "Melinoe"
      Event = "NemesisTavernaDecline01"
    }
    {
      Id = "Melinoe_3104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nemesis, kita sudah sibuk begini sekian lama, dan aku ingin tahu apa kau mau istirahat sebentar. Di Pemandian Air Panas."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Nemesis_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm. {#Prev}Dipikir-pikir, memang butuh mandi air hangat. Maksudku, {#Emph}kamu{#Prev}. Tapi kurasa aku juga butuh, jadi... kenapa tidak."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Melinoe_3105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah berapa lama sejak terakhir kali kau melepas zirahmatu?"
      Speaker = "Melinoe"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Nemesis_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah agak lama. Tak ada alasan kuat untuk membukanya. Kau tahu sendiri betapa merepotkannya melepas tali-temali dan sabuknya. Rasanya aneh tanpa zirah ini, seperti aku... aku... entahlah."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Melinoe_3106"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bebas dari beban? Atau setidaknya lebih nyaman?"
      Speaker = "Melinoe"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Nemesis_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh. {#Prev}Melepas penat sesekali memang enak, kurasa. Tapi ada batas tipis antara istirahat dan rasa berpuas diri."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Melinoe_3107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa kita sama sekali tidak dalam risiko berpuas diri di sini, Nem."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Nemesis_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Risikonya lebih besar daripada yang kau kira. Kita sedang santai berendam sementara entah apa yang sedang terjadi di luar sana..."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Melinoe_3108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tidak sedang bermalas-malasan. Kita akan jauh lebih siap menghadapi apa pun di luar sana jika otot-otot kita tidak kaku dan tegang begini."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Nemesis_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, harus kembali bekerja. Meskipun, zirah ini memang terasa agak lebih ringan sekarang..."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Melinoe_3109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga dirimu, Nem."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse01"
    }
    {
      Id = "Melinoe_3110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei Nem, ada waktu untuk pergi ke pemandian air panas lagi? Melepas penat sejenak, mengembalikan kesegaran pikiran kita..."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Nemesis_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh. {#Prev}Pundakku mulai berulah lagi, mungkin ini bisa membantu. Malas sebenarnya harus melepas zirah ini, tapi ya impaslah."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Nemesis_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertama kali kau mengalahkanku dalam pertarungan? {#Emph}Latihan tanding{#Prev}, entah apa pun itu. Kau mengenaiku tepat di tengkuk. Memanfaatkan perbedaan tinggi badan kita. Cukup mengejutkan."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Melinoe_3111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah terlalu sering kalah darimu, sampai pada titik aku berpikir bisa membuatmu lengah karena terlalu percaya diri. Bahwa kau pun bisa terjebak hal semacam itu."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Nemesis_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak salah. Itu membuatku sangat {#Emph}marah. {#Prev}Kubersumpah tak akan pernah meremehkan lawanku lagi. Lalu kuputuskan untuk meyakinkan diriku sendiri bahwa kau tak akan pernah bisa mengalahkanku dalam tugas itu. Tugas {#Emph}kita{#Prev}."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Melinoe_3112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau punya sedikit gengsi. Kau tidak berusaha melenyapkannya sama sekali, kan? Cuma mengendalikannya. Lagipula, kupikir tujuan yang ingin kita capai tidak saling bertentangan."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Nemesis_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang tidak. Tapi ada batas seberapa jauh aku bisa memaksakan diri. Melihatmu bertambah kuat, semakin mendekat... memberiku dorongan ekstra yang kubutuhkan."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Melinoe_3113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak tahu sama sekali. Selama ini kukira jiwa kompetitifku tertular dari{#Emph}mu. {#Prev}Ngomong-ngomong... beri tahu aku jika kau butuh bantuan lain. Seperti membantu memasang zirahmu itu."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Nemesis_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atau melepasnya, ya. Tapi, aku tak boleh membiarkan diriku terlalu terbiasa dengan ini."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Nemesis_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, sudah cukup duduk-duduknya. Waktunya berdiri santai untuk mengimbanginya."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Melinoe_3115"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo kita berangkat kalau begitu."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse02"
    }
    {
      Id = "Melinoe_4441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak pernah menolak Garam Mandi, Nemesis, jadi bagaimana? Asalkan kau merasa kita pantas mendapatkan setidaknya sedikit waktu rehat."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Nemesis_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah kita memang pantas atau tidak. Tapi otot-ototku sudah menegang cukup parah sampai mengganggu gerakanku. Jadi kenapa tidak."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Nemesis_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak percaya aku sedang duduk di sini bersamamu. Dulu melihat wajahmu saja aku muak. Ingin kupatahkan tubuhmu seperti ranting. Sekarang kau malah membantuku melepas tali zirahku."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Melinoe_4442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita bisa berubah, bukan? Kau sendiri pasti percaya itu, kalau tidak, untuk apa semua pembalasan yang kau timpakan? Itu tak mungkin semata-mata demi hukuman saja."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Nemesis_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hukuman itu cuma separuhnya. Tapi ya. Penting untuk belajar, jika bukan dari kegagalan kita sendiri, ya dari kegagalan yang terus terjadi di sekitar kita. Tapi kurasa aku sama sekali tak berubah; kaulah yang berubah."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Melinoe_4443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berubah? Aku masih bersikeras menanggung semua tanggung jawabku. Menghitung waktu sebelum aku bisa kembali ke tugasku yang seharusnya... alih-alih menikmati saat bersamamu di sini."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Nemesis_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kecuali fakta bahwa kita cuma ada di sini karena kau memberanikan diri untuk mengajak. Tapi sudahlah, mungkin kau tak banyak berubah. Mungkin entah kenapa aku cuma lebih menyukai dirimu yang sekarang dibanding dulu."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Melinoe_4444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga merasakan hal yang sama. Meski begitu, aku sudah mengagumimu sejak masa latihan. Senang rasanya bisa bersamamu seperti ini... dan melihat kita bertarung di pihak yang sama belakangan ini."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Nemesis_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita selalu menginginkan hal yang sama, cuma kupikir porsinya tak cukup untuk kita berdua. Sekarang, cukup bicaranya. Kau mau bantu melemaskan punggungku yang kaku ini atau tidak?"
      Speaker = "Nemesis"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Nemesis_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Rasanya jauh lebih baik dari sebelumnya, kuakui itu. Tapi jangan harap aku bakal melunak padamu di luar sana. Anggap saja kita sekarang impas."
      Speaker = "Nemesis"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Melinoe_4446"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang sudah semestinya begitu."
      Speaker = "Melinoe"
      Event = "NemesisBathHouse03"
    }
    {
      Id = "Nemesis_0375"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru saja berpikir tak ada salahnya berendam di pemandian lagi, jadi, ya."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[1]"
    }
    {
      Id = "Nemesis_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergi ke pemandian air panas kedengarannya bagus. Tapi sebaiknya jangan lama-lama."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[1]"
    }
    {
      Id = "Nemesis_0381"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa tak akan terlalu lama, meski aku butuh bantuanmu untuk melepas baju zirah ini."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[1]"
    }
    {
      Id = "Nemesis_0376"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tak banyak hal yang sepadan dengan repotnya melepas zirah ini, tapi yang ini pengecualian bagiku."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[3]"
    }
    {
      Id = "Nemesis_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}...Fyuuh. {#Prev}Bisa kurasakan semua rasa pegal di pundakku meleleh begitu saja."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[3]"
    }
    {
      Id = "Nemesis_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kurasa tak adil kalau aku bisa menjalankan semua tugas jagaku tepat dari sini."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[3]"
    }
    {
      Id = "Nemesis_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kurasa staminaku sudah cukup pulih untuk berjaga di sini beberapa saat setelah tadi."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[4]"
    }
    {
      Id = "Nemesis_0380"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Rupanya aku jauh lebih butuh berendam tadi daripada yang kukira."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[4]"
    }
    {
      Id = "Nemesis_0383"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Malas sekali rasanya harus beranjak dari sana, tapi kalau memang itu konsekuensinya, baiklah."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[4]"
    }
    {
      Id = "Nemesis_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Yah, kembali berdiri mematung... tepat di sebelah sini."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[4]"
    }
    {
      Id = "Nemesis_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tuh kan, sama sekali tak ada apa pun yang terjadi di sini selagi kita pergi."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseRepeatable01[4]"
    }
    {
      Id = "Melinoe_0683"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, {#Emph}umm{#Prev}, sepertinya aku sudah tahu jawabannya, tapi apa kau tak berniat pergi ke pemandian air panas? Menyegarkan pikiran kita?"
      Speaker = "Melinoe"
      Event = "NemesisBathHouseDecline01"
    }
    {
      Id = "Nemesis_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}yah... {#Prev}Terima kasih atas ajakannya, tapi aku sedang bertugas jaga sekarang, mungkin sampai Sang Waktu merenggut kita semua. Lagipula baju zirah ini butuh waktu seharian untuk dipakai atau dilepas..."
      Speaker = "Nemesis"
      Event = "NemesisBathHouseDecline01"
    }
    {
      Id = "Melinoe_0684"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, mau menemaniku sebentar ke tepi sungai? Melepas penat, atau... mungkin aku bisa mendorongmu ke air atau semacamnya?"
      Speaker = "Melinoe"
      Event = "NemesisFishingDecline01"
    }
    {
      Id = "Nemesis_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa saja memburu para pelaku kejahatan keji di permukaan, tapi kau malah mengajakku memburu ikan-ikan malang? Uh, tidak."
      Speaker = "Nemesis"
      Event = "NemesisFishingDecline01"
    }
    {
      Id = "Melinoe_3487"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir aku melihat pergerakan di dekat dermaga pemancingan. Penyelidikan menyeluruh sepertinya perlu dilakukan, kan?"
      Speaker = "Melinoe"
      Event = "NemesisFishing01"
    }
    {
      Id = "Nemesis_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihannya antara itu atau membusuk di sini sambil berdiri berjaga, kan? Tahu tidak, baiklah, aku ikut. Aku ragu bakal ada ikan yang terpancing."
      Speaker = "Nemesis"
      Event = "NemesisFishing01"
    }
    {
      Id = "Nemesis_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terlahir sebagai seekor ikan. Menghabiskan hidup mengais lumpur di Sungai Ratapan, hanya untuk ditarik keluar oleh {#Emph}dirimu. {#Prev}Dosa apa yang mereka perbuat sampai pantas menerima ini?"
      Speaker = "Nemesis"
      Event = "NemesisFishing01"
    }
    {
      Id = "Melinoe_3237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukankah kaulah yang seharusnya tahu jawabannya? Mungkin kehendak Para Takdir yang menentukan bagaimana kita dilahirkan. Lalu kau memastikan kita mendapat ganjaran yang setimpal berdasarkan pilihan yang kita buat."
      Speaker = "Melinoe"
      Event = "NemesisFishing01"
    }
    {
      Id = "Nemesis_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakal jauh lebih mudah kalau semua orang dilahirkan dengan kedudukan setara. Tapi tak seorang pun di keluargaku menganggap hidup ini seharusnya adil, selain diriku."
      Speaker = "Nemesis"
      Event = "NemesisFishing01"
    }
    {
      Id = "Melinoe_3238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana mungkin hidup ini bisa adil, mengetahui ada begitu banyak jenis makhluk, seperti yang menghuni perairan ini?"
      Speaker = "Melinoe"
      Event = "NemesisFishing01"
    }
    {
      Id = "Nemesis_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita harus menyusun aturan yang lebih jelas tentang siapa yang menentukan bagaimana manusia fana dilahirkan. Atau bagaimana jiwa mereka hidup kembali. Topik untuk lain waktu. Kurasa aku melihat sedikit pergerakan di sebelah sana."
      Speaker = "Nemesis"
      Event = "NemesisFishing01"
    }
    {
      Id = "Nemesis_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sudah memberi mereka kesempatan yang adil, kan. Adu kecerdikan yang sengit tadi."
      Speaker = "Nemesis"
      Event = "NemesisFishing01"
    }
    {
      Id = "Nemesis_0384"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi tak banyak hal yang terjadi sekarang, jadi kurasa aku bisa mencuri waktu istirahat sejenak. Kenapa tidak."
      Speaker = "Nemesis"
      Event = "NemesisFishingRepeatable01[1]"
    }
    {
      Id = "Nemesis_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa tidak. Tak ada salahnya jalan-jalan sedikit untuk meregangkan kakiku."
      Speaker = "Nemesis"
      Event = "NemesisFishingRepeatable01[1]"
    }
    {
      Id = "Nemesis_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin bakal kelihatan jelas kalau aku lagi tak punya kerjaan sekarang, tapi ya sudahlah."
      Speaker = "Nemesis"
      Event = "NemesisFishingRepeatable01[1]"
    }
    {
      Id = "Nemesis_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berdiri di sebelah sini, atau berdiri di sebelah sana, kurasa tak ada bedanya sama sekali saat ini."
      Speaker = "Nemesis"
      Event = "NemesisFishingRepeatable01[1]"
    }
    {
      Id = "Nemesis_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi sepi juga, dan ganti suasana bakal bagus buatku sekarang. Jadi ya, kenapa enggak."
