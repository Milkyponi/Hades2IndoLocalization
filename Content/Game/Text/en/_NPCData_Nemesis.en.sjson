      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0414"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bercanda kau?"
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0415"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ikut bertarung sana!"
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0416"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang sedang kau lakukan?"
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0417"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Balas serang!"
