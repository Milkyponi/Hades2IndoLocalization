    }
    {
      Id = "Nemesis_0159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dah."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Nemesis_0160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai ketemu lagi."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Nemesis_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan sampai mengacaukannya."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Nemesis_0162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lanjutkan."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Nemesis_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pergilah."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "NemesisField_0604"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan menungguku."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "NemesisField_0603"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku masuk."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "NemesisField_0602"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benda apa ini...?"
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "NemesisField_0601"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menarik..."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "NemesisField_0605"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chaos memanggil..."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "NemesisField_0606"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Boleh juga."
      Speaker = "Nemesis"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_2253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa dia barusan...?"
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_1480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia memakai Gerbang Chaos..."
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_1481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia masuk ke sana..."
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_1482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia pergi menemui Chaos?"
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_2245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lenyap."
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_2251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia sudah pergi."
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_2252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah...!"
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_2246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam..."
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_2247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa..."
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_2248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga."
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_2249"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati."
      Speaker = "Melinoe"
      Event = "NPC_Nemesis_01.ExitVoiceLines"
    }
    {
      Id = "NemesisField_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketinggalan semua keseruannya, ya. Setidaknya kali ini tanganmu tak perlu kotor."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItemIntro01"
    }
    {
      Id = "Melinoe_2140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nemesis, apa yang kau lakukan di sini? Siapa yang berjaga di Crossroads?"
      Speaker = "Melinoe"
      Event = "NemesisGetFreeItemIntro01"
    }
    {
      Id = "NemesisField_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka bisa atasi sendiri, aku sedang istirahat. Mengadu ke Hecate kalau melihatku, kau bakal menyesal. Dan, {#Emph}terima kasih kembali karena kau aman di sini{#Prev}, mengingat aku sudah membersihkan jalannya untukmu."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItemIntro01"
    }
    {
      Id = "Melinoe_2141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak butuh bantuanmu dalam hal ini, selain tanggung jawab yang sudah ditugaskan padamu."
      Speaker = "Melinoe"
      Event = "NemesisGetFreeItemIntro01"
    }
    {
      Id = "NemesisField_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa? Kelihatannya kau justru butuh semua {#Emph}bantuan {#Prev}yang bisa didapat. Ini sekadar imbalan atas repotmu, lalu sebaiknya kau segera angkat kaki."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItemIntro01"
    }
    {
      Id = "NemesisField_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlambat. Aku sudah bereskan semuanya di sini, meski kurasa kau tetap akan dapat bagianmu."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItemIntro02"
    }
    {
      Id = "MelinoeField_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau bersikeras memburu Chronos, tidak bisakah setidaknya kita bekerja sama?"
      Speaker = "Melinoe"
      Event = "NemesisGetFreeItemIntro02"
    }
    {
      Id = "NemesisField_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak sudi terlihat bersamamu, lagipula aku tak butuh bantuanmu. Tapi kutahu kau butuh bantuanku, jadi ini. Ambil ini, dan kau tak pernah melihatku. Paham?"
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItemIntro02"
    }
    {
      Id = "NemesisField_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau butuh semua bantuan yang ada, jadi terimalah! Lagipula aku tak butuh ini."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem01"
    }
    {
      Id = "NemesisField_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak sekali sampah tak berguna berserakan. Nih, harusnya kau yang bersih-bersih, bukan aku."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem02"
    }
    {
      Id = "NemesisField_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak butuh ini, tapi tampangmu bilang sebaliknya."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem03"
    }
    {
      Id = "NemesisField_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anggap saja kau tak pernah melihatku, dan aku tidak mempermudah urusanmu."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem04"
    }
    {
      Id = "NemesisField_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau benar-benar menghabisi mereka, ya. Dan dapat hadiah yang lumayan pula."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem05"
    }
    {
      Id = "NemesisField_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebaiknya tutup mulutmu soal ini saat mengobrol dengan Hecate nanti."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem06"
    }
    {
      Id = "NemesisField_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita lihat siapa yang sampai duluan. Nih, bahkan kuberi sedikit dorongan."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem07"
    }
    {
      Id = "NemesisField_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bawaanmu lebih enteng daripada punyaku, jadi nih, biar seimbang bebannya."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem08"
    }
    {
      Id = "NemesisField_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru saja mau kubuang barang ini waktu kau tiba-tiba muncul..."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem09"
    }
    {
      Id = "NemesisField_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mustahil kau sampai duluan. Bahkan kuberi kau waktu untuk mulai duluan."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem10"
    }
    {
      Id = "NemesisField_0518"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya tak begitu kubutuhkan, tapi kurasa lebih baik kusimpan untukmu."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem11"
    }
    {
      Id = "NemesisField_0519"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedikit oleh-oleh untukmu, Tuan Putri. Memang bukan Nektar, tapi lumayanlah."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem12"
    }
    {
      Id = "NemesisField_0520"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedang berbaik hati, jadi tak bakal kuambil sekoin pun untuk barang ini."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem13"
    }
    {
      Id = "NemesisField_0521"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak pernah tahu barang-barang begini buat apa selain kuberikan padamu."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem14"
    }
    {
      Id = "NemesisField_0522"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hampir sampai. Ini seharusnya bisa membantumu menempuh sisa perjalanan."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItem15"
    }
    {
      Id = "NemesisField_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepertinya ada yang tidak beres dengan zirahku. Ada waktu untuk memeriksanya?"
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem01"
    }
    {
      Id = "MelinoeField_5334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, saat ini bukan waktu yang tepat..."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem01"
    }
    {
      Id = "MelinoeField_5298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, biar kubantu memeriksa itu."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem01"
    }
    {
      Id = "MelinoeField_5299"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Zirahmu sepertinya masih berfungsi dengan baik."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem01"
    }
    {
      Id = "NemesisField_0461"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih baik. Seharusnya bisa bertahan untuk sementara."
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem01"
    }
    {
      Id = "NemesisField_0462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suka kalau suasananya tenang begini. Tak ada siapa pun di sini selain kita. Kita bisa... maksudku..."
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem02"
    }
    {
      Id = "MelinoeField_5336"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku agak terburu-buru malam ini, itu saja..."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem02"
    }
    {
      Id = "MelinoeField_5300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu berkata apa-apa lagi, Nem..."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem02"
    }
    {
      Id = "NemesisField_0463"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kurasa waktu istirahat sudah habis, tapi senang bisa berpapasan denganmu."
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem02"
    }
    {
      Id = "MelinoeField_5301"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Penting untuk beristirahat sesekali, bukan?"
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem02"
    }
    {
      Id = "NemesisField_0464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru saja mau pergi, tapi firasatku bilang kau bakal muncul. Mau tinggal sebentar?"
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem03"
    }
    {
      Id = "MelinoeField_5337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak bisa sekarang, maaf..."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem03"
    }
    {
      Id = "MelinoeField_5302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh, kurasa aku mau."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem03"
    }
    {
      Id = "MelinoeField_5303"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Menyenangkan juga ya kalau sesekali bersantai sejenak?"
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem03"
    }
    {
      Id = "NemesisField_0465"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin sebaiknya kita lekas lanjut, setidaknya kita sudah menyempatkan waktu sejenak."
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem03"
    }
    {
      Id = "NemesisField_0466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kalau kau tidak sedang buru-buru, suasana di sini lagi tenang, jadi..."
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem04"
    }
    {
      Id = "MelinoeField_5341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf, tapi sekarang bukan waktu yang tepat."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem04"
    }
    {
      Id = "MelinoeField_5304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak sedang buru-buru juga, sih..."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem04"
    }
    {
      Id = "MelinoeField_5305"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Fyuuh. {#Prev}Kurasa kita harus segera melanjutkan urusan kita."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem04"
    }
    {
      Id = "NemesisField_0467"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm. {#Prev}Tempat yang bagus kalau sedang tidak dirayapi makhluk-makhluk yang harus dibantai."
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem04"
    }
    {
      Id = "NemesisField_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak usah buru-buru pergi. Tak ada yang bakal sadar kalau kau pulang agak telat."
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem05"
    }
    {
      Id = "MelinoeField_5335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebaiknya jangan. Mungkin lain kali saja."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem05"
    }
    {
      Id = "MelinoeField_5306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu banyak membujukku, Nem."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem05"
    }
    {
      Id = "MelinoeField_5307"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Yah, seperti katamu, tak perlu buru-buru."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem05"
    }
    {
      Id = "NemesisField_0469"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berdua harus lekas kembali beraksi, tapi kapan-kapan kita harus santai begini lagi."
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem05"
    }
    {
      Id = "NemesisField_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aaargh{#Prev}, ada sesuatu yang tersangkut di zirahku dan harus dikeluarkan. Keberatan membantu?"
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem06"
    }
    {
      Id = "MelinoeField_5339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan aku, tapi tidak untuk malam ini."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem06"
    }
    {
      Id = "MelinoeField_5308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama sekali tidak keberatan. Mari kita periksa bersama."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem06"
    }
    {
      Id = "NemesisField_0471"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sekarang rasanya jauh lebih mendingan, jadi makasih."
      Speaker = "Nemesis"
      Event = "NemesisBecomingCloserGetFreeItem06"
    }
    {
      Id = "MelinoeField_5309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa bakal aman-aman saja untuk sementara waktu."
      Speaker = "Melinoe"
      Event = "NemesisBecomingCloserGetFreeItem06"
    }
    {
      Id = "NemesisField_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi nunggu orang lain? Cuma mau rehat sebentar buat nyari arah. Tadi di sini sepi dan tenang sampai kau nongol."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItemIntroBridge01"
    }
    {
      Id = "MelinoeField_1972"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak melihat Nimfa berwajah lembut di sekitar sini, kan? Dia sering berada di jembatan ini."
      Speaker = "Melinoe"
      Event = "NemesisGetFreeItemIntroBridge01"
    }
    {
      Id = "NemesisField_0436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin sudah kukuliti atau kutakut-takuti sampai kabur. Ada urusan yang lebih penting daripada ngejar-ngejar Nimfa. Pokoknya, sana pergi. Arwah-arwah di tempat ini bakal kesal melihat kita bersikap ramah."
      Speaker = "Nemesis"
      Event = "NemesisGetFreeItemIntroBridge01"
    }
    {
      Id = "NemesisField_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu Emas selalu ada di Underworld, tertanam di nadinya. Tapi Chronos malah menjadikannya kepingan-kepingan koin sialan! Berceceran di mana-mana sekarang."
      Speaker = "Nemesis"
      Event = "NemesisBuyItemIntro01"
    }
    {
      Id = "MelinoeField_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Charon yang akan membereskannya segera. Semua Emas yang kutemukan kuberikan padanya. Ditukar dengan barang dagangannya."
      Speaker = "Melinoe"
      Event = "NemesisBuyItemIntro01"
    }
    {
      Id = "NemesisField_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku juga bisa melakukan hal yang sama, kalau kau mau bikin kesepakatan. Tenang saja, semua Emas yang kudapat darimu, Charon bakal dapat dariku juga."
      Speaker = "Nemesis"
      Event = "NemesisBuyItemIntro01"
    }
    {
      Id = "NemesisField_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat siapa ini! Tersesat juga di Padang ini? Bakal kutukar peta atau apalah kalau punya, tapi kau takkan sanggup membayarnya, jadi mending kupakai sendiri buat keluar dari sini."
      Speaker = "Nemesis"
      Event = "NemesisBuyItemFields01"
    }
    {
      Id = "MelinoeField_1970"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuragukan peta akan berguna, jalur-jalur ini tampaknya bergeser dari malam ke malam. Setidaknya aku bisa memanfaatkan Dahan Emas yang tersebar di sekitar. Bagaimana denganmu?"
      Speaker = "Melinoe"
      Event = "NemesisBuyItemFields01"
    }
    {
      Id = "NemesisField_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dahan Emas. Aku sama sekali tidak tahu benda itu ada gunanya selain terlihat muram. Kurasa harusnya aku menyimak lebih baik waktu Kepala Sekolah terus mengoceh panjang lebar di depan Kuali itu."
      Speaker = "Nemesis"
      Event = "NemesisBuyItemFields01"
    }
    {
      Id = "NemesisField_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa kutukar sesuatu dengan sedikit Emas. Buat jajan di tempat Charon."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem01"
    }
    {
      Id = "NemesisField_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Butuh Emas dan rasanya tidak adil kalau harus menghajarmu sampai koinnya rontok, jadi bagaimana kalau kita barter saja."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem02"
    }
    {
      Id = "NemesisField_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana kalau kita bikin kesepakatan kecil kalau kau punya koinnya."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem03"
    }
    {
      Id = "NemesisField_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Punya sesuatu yang berguna buatmu, tapi tentu saja tidak gratis."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem04"
    }
    {
      Id = "NemesisField_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa membantumu melangkah lebih jauh dari ini, tapi harganya tidak murah."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem05"
    }
    {
      Id = "NemesisField_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau jadi yang terbaik, tentu tidak murah harganya."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem06"
    }
    {
      Id = "NemesisField_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutawari kesepakatan, tapi cuma kalau kau punya koinnya."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem07"
    }
    {
      Id = "NemesisField_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau seorang putri, pasti punya koin berlebih, kan?"
      Speaker = "Nemesis"
      Event = "NemesisBuyItem08"
    }
    {
      Id = "NemesisField_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berapa banyak Emas yang kau dapat di luar sana? Bisa kubuat itu sepadan."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem09"
    }
    {
      Id = "NemesisField_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa saja kurampas semua Emasmu, tapi rasanya tidak adil."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem10"
    }
    {
      Id = "NemesisField_0527"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penawaran khusus buatmu, Tuan Putri. Bayar sekarang, atau barangnya lenyap."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem11"
    }
    {
      Id = "NemesisField_0528"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi butuh sedikit koin tambahan dan kurasa kau butuh barang ini."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem12"
    }
    {
      Id = "NemesisField_0529"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bayangkan saja aku ini Charon dan punya persis apa yang kau perlukan."
      Speaker = "Nemesis"
      Event = "NemesisBuyItem13"
    }
    {
      Id = "NemesisField_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kroco-kroco ini bukan tandingan. Waktu kita dulu latihan tanding... hampir tidak pernah aku bisa mendaratkan pukulan telak ke arahmu. Kau selalu berhasil berkelit."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItemIntro01"
    }
    {
      Id = "MelinoeField_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihan apa lagi yang kupunya? Satu pukulan telak darimu sudah lebih dari cukup untuk menumbangkanku waktu itu. Tapi aku sudah banyak berlatih!"
      Speaker = "Melinoe"
      Event = "NemesisTakeDamageForItemIntro01"
    }
    {
      Id = "NemesisField_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau makin tangguh, ya. Tapi seberapa tangguh? Bagaimana kalau kupukul kau sekarang juga, dan kalau kau sanggup menerimanya, kau dapat hadiah bagus yang kutemukan ini. Gimana?"
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItemIntro01"
    }
    {
      Id = "NemesisField_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membuntutiku atau apa? Tidak biasanya berpapasan denganmu sesering ini dalam semalam. Cari jalanmu sendiri sana."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItemRepeatSightings01"
    }
    {
      Id = "MelinoeField_1971"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cari jalan {#Emph}sendiri{#Prev}? Maksudmu {#Emph}selain {#Prev}jalur yang susah payah dirancang Kepala Sekolah dan Sang Taktisi demi memperbesar peluang keberhasilanku?"
      Speaker = "Melinoe"
      Event = "NemesisTakeDamageForItemRepeatSightings01"
    }
    {
      Id = "NemesisField_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan halangi jalanku. Tapi sebelumnya, bagaimana kalau kuberi kau satu tebasan telak dulu, mumpung mulutmu lagi banyak bicara begitu?"
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItemRepeatSightings01"
    }
    {
      Id = "NemesisField_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, rasanya tanganku gatal ingin memukul sesuatu. Kau pasti paham maksudku. Bisa kubuat ini sepadan buatmu..."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem01"
    }
    {
      Id = "NemesisField_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Darahku masih mendidih... harus kuluapkan sekarang. Cuma satu tebasan telak, itu saja."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem02"
    }
    {
      Id = "NemesisField_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Darahku tertumpah demi mendapatkan barang ini. Tumpahkan sedikit darahmu kalau kau menginginkannya."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem03"
    }
    {
      Id = "NemesisField_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau kan tangguh. Sanggup kena satu pukulan, kan? Menguntungkan buat kita berdua..."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem04"
    }
    {
      Id = "NemesisField_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bakal kena lebih dari satu pukulan kalau lewat jalur kacau balau ini..."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem05"
    }
    {
      Id = "NemesisField_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kena hantaman keras sampai ke sini, gimana kalau kau kena juga?"
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem06"
    }
    {
      Id = "NemesisField_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau sesuatu dariku, kau harus bayar pakai darah."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem07"
    }
    {
      Id = "NemesisField_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau menuntaskan ini, lebih baik bersiaplah untuk berdarah."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem08"
    }
    {
      Id = "NemesisField_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuragukan kau bahkan bisa menahan satu hantaman saja dariku."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem09"
    }
    {
      Id = "NemesisField_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir kalau kau kena hantamanku saja tak tahan, kau tak punya harapan."
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem10"
    }
    {
      Id = "NemesisField_0534"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu tahan banting, Tuan Putri. Jadi bagaimana kalau sekarang?"
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem11"
    }
    {
      Id = "NemesisField_0535"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau tahu seberapa keras aku dihantam saat membersihkan tempat ini?"
      Speaker = "Nemesis"
      Event = "NemesisTakeDamageForItem12"
    }
    {
      Id = "NemesisField_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kadang aku dapat sedikit bantuan dari Artemis, tapi {#Emph}kau? {#Prev}Hampir seluruh Olympus mendukungmu, dan {#Emph}bahkan begitu pun{#Prev}, masih belum cukup. Nggak guna banget {#Emph}mereka{#Prev}."
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItemIntro01"
    }
    {
      Id = "MelinoeField_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arahkan kritikanmu langsung ke para dewa itu sendiri. Sekarang apa maumu denganku?"
      Speaker = "Melinoe"
      Event = "NemesisGiveTraitForItemIntro01"
    }
    {
      Id = "NemesisField_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau mencicipi sedikit dari semua kekuatan itu untuk diriku sendiri. Ayolah, kita barter..."
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItemIntro01"
    }
    {
      Id = "NemesisField_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua pemberian cuma-cuma dari kerabatmu ini... kau jelas tak butuh {#Emph}semuanya{#Prev}, kan?"
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItem01"
    }
    {
      Id = "NemesisField_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu yang kau butuhkan di sini, tapi kau harus tukar dengan sebagian kekuatan semu dari Olympus-mu itu."
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItem02"
    }
    {
      Id = "NemesisField_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beri aku sebagian kekuatan pinjamanmu itu, dan kau akan dapat sebagian kekuatanku."
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItem03"
    }
    {
      Id = "NemesisField_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak butuh Olympus menyuapi segalanya untukmu."
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItem04"
    }
    {
      Id = "NemesisField_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau apa yang kupunya, harus ada yang kau korbankan."
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItem05"
    }
    {
      Id = "NemesisField_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak dibantu Olympus, adilnya kau juga tidak usah."
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItem06"
    }
    {
      Id = "NemesisField_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa gunung itu tak menawarkan bantuan {#Emph}padaku{#Prev}, tapi bagaimana denganmu?"
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItem07"
    }
    {
      Id = "NemesisField_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olympus takkan peduli kalau kau melepaskan satu berkah kecil, kan?"
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItem08"
    }
    {
      Id = "NemesisField_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang bisa membuatmu merelakan sebagian sokongan Olympus itu?"
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItem09"
    }
    {
      Id = "NemesisField_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu saja bergantung pada bantuan kerabatmu. Bagaimana kalau kau lepaskan saja."
      Speaker = "Nemesis"
      Event = "NemesisGiveTraitForItem10"
    }
    {
      Id = "NemesisField_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sampai jauh sebelum kau. Sudah kubereskan juga. Bikin kesal, kan? Jangan ditahan... kita lihat seberapa kuat kau sebenarnya."
      Speaker = "Nemesis"
      Event = "NemesisDamageContestIntro01"
    }
    {
      Id = "MelinoeField_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak mau bertarung denganmu, Nemesis. Bahkan bicara denganmu saja aku enggan sekarang."
      Speaker = "Melinoe"
      Event = "NemesisDamageContestIntro01"
    }
    {
      Id = "NemesisField_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan memintamu bertarung denganku. Cuma memintamu {#Emph}menghantamku{#Prev}. Lihat apa kau bahkan bisa membuatku bergeming. Bakal sepadan kok hasilnya."
      Speaker = "Nemesis"
      Event = "NemesisDamageContestIntro01"
    }
    {
      Id = "NemesisField_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua amarah yang terpendam itu. Luapkan saja. Kalau sampai terasa, bakal kubikin sepadan buatmu."
      Speaker = "Nemesis"
      Event = "NemesisDamageContest01"
    }
    {
      Id = "NemesisField_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para cecunguk tadi bahkan tak bisa mengenaku. Nggak adil rasanya. Bagaimana kalau kau yang membalaskannya?"
      Speaker = "Nemesis"
      Event = "NemesisDamageContest02"
    }
    {
      Id = "NemesisField_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat gayamu sok tangguh begitu. Ayo, hantam aku sekeras mungkin. Serangan gratis."
      Speaker = "Nemesis"
      Event = "NemesisDamageContest03"
    }
    {
      Id = "NemesisField_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita lihat seberapa kuat kau sebenarnya. Hantam aku, jangan menahan diri."
      Speaker = "Nemesis"
      Event = "NemesisDamageContest04"
    }
    {
      Id = "NemesisField_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatan kau sedang kesal. Kalau begitu luapkan dan tunjukkan kemampuanmu padaku."
      Speaker = "Nemesis"
      Event = "NemesisDamageContest05"
    }
    {
      Id = "NemesisField_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat dirimu, begitu garang dan tangguh. Tunjukkan seberapa kuat kau sebenarnya."
      Speaker = "Nemesis"
      Event = "NemesisDamageContest06"
    }
    {
      Id = "NemesisField_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemenang berhak atas rampasan perang. Jadi tunjukkan apa yang kau punya."
      Speaker = "Nemesis"
      Event = "NemesisDamageContest07"
    }
    {
      Id = "NemesisField_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak satu pun cecunguk ini yang bisa menyentuhku. Tapi kau lebih kuat dari mereka, kan?"
      Speaker = "Nemesis"
      Event = "NemesisDamageContest08"
    }
    {
      Id = "NemesisField_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir kau tak sanggup, tapi silakan coba buktikan kalau aku salah."
      Speaker = "Nemesis"
      Event = "NemesisDamageContest09"
    }
    {
      Id = "NemesisField_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makin kuat rupanya, tapi kau takkan pernah selevel denganku. Ayo, coba aku."
      Speaker = "Nemesis"
      Event = "NemesisDamageContest10"
    }
    {
      Id = "NemesisField_0536"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau makin kuat, tapi tak selalu kelihatan seberapa jauh peningkatanmu. Jadi buktikan."
      Speaker = "Nemesis"
      Event = "NemesisDamageContest11"
    }
    {
      Id = "NemesisField_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepatah kata saja soal ini ke Hecate, kau tamat, paham? Sekarang pergilah selagi aku membereskan semuanya."
      Speaker = "Nemesis"
      Event = "NemesisCombatFirstIntro"
    }
    {
      Id = "MelinoeField_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini tugasku, bukan tugasmu. Dan aku kecewa melihatmu melalaikan kewajiban. Apa kau begitu putus asa ingin membuktikan kau lebih unggul dariku?"
      Speaker = "Melinoe"
      Event = "NemesisCombatFirstIntro"
    }
    {
      Id = "NemesisField_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, mungkin saja iya. Jadi begini: Kau bawa Emas, kan? Makhluk-makhluk keparat itu sebentar lagi bakal menyerbu. Siapa yang membunuh lebih banyak bakal meraup koin yang kalah. Gimana?"
      Speaker = "Nemesis"
      Event = "NemesisCombatFirstIntro"
    }
    {
      Id = "MelinoeField_0015"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harus selalu bertaruh ya kalau denganmu?"
      Speaker = "Melinoe"
      Event = "NemesisCombatFirstIntro"
    }
    {
      Id = "NemesisField_0007"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Peluangmu menang cukup adil kok kalau kau tutup mulut dan bertarung!"
      Speaker = "Nemesis"
      Event = "NemesisCombatFirstIntro"
    }
    {
      Id = "MelinoeField_4082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, siap berkeringat lagi, Nem?"
      Speaker = "Melinoe"
      Event = "NemesisPreCombatBecomingCloser01"
    }
    {
      Id = "NemesisField_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan meremehkanku, atau aku bakal merampas lebih dari sekadar Emasmu setelah ini. Sekarang, ayo."
      Speaker = "Nemesis"
      Event = "NemesisPreCombatBecomingCloser01"
    }
    {
      Id = "NemesisField_0481"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang brutal. Aku harus berjuang mati-matian cuma untuk sampai ke titik ini. Semuanya memukul balik dengan keras. Awas saja kalau ini ulahmu."
      Speaker = "Nemesis"
      Event = "NemesisPreCombatAboutShrine01"
    }
    {
      Id = "MelinoeField_4083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Secara teknis ini ulah Sumpah Para Gaib, bukan perbuatanku. Ada apa, bukannya kau ingin keinginan ibumu terwujud?"
      Speaker = "Melinoe"
      Event = "NemesisPreCombatAboutShrine01"
    }
    {
      Id = "NemesisField_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi {#Emph}memang {#Prev}kau yang mengutak-atik Sumpah itu. Kau sudah gila, tahu tidak? Nah, mereka datang. Kau sebaiknya bersiap."
      Speaker = "Nemesis"
      Event = "NemesisPreCombatAboutShrine01"
    }
    {
      Id = "NemesisField_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengerikan di luar sana, ya, Tuan Putri? Tidak mau dengar nasihatku soal Sumpah itu, kan. Malah memutuskan menambah Rasa Takut adalah jalan terbaik."
      Speaker = "Nemesis"
      Event = "NemesisPreCombatAboutShrine02"
    }
    {
      Id = "MelinoeField_4085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira Rasa Takut tak akan mempan padamu, Nemesis! Coba katakan, apa yang sebenarnya kau takuti? Kau kan bisa mengatasi segalanya."
      Speaker = "Melinoe"
      Event = "NemesisPreCombatAboutShrine02"
    }
    {
      Id = "NemesisField_0486"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa mengatasi banyak hal. Tapi aku tidak segila itu sampai mengira bisa mengatasi {#Emph}segalanya{#Prev}. Sudahlah, tak ada waktu mengobrol, mereka datang."
      Speaker = "Nemesis"
      Event = "NemesisPreCombatAboutShrine02"
    }
    {
      Id = "NemesisField_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar kubereskan sendiri si Chronos itu kalau kau memang tidak becus. Tapi yang pertama selesaikan dulu ini."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart01"
    }
    {
      Id = "NemesisField_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setelah kita selesai di sini, satu dari kita bakal makin kaya, dan satunya lagi bakal makin melarat."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart02"
    }
    {
      Id = "NemesisField_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau sudah sampai sini? {#Emph}Ungh{#Prev}, terserahlah. Emasmu taruhannya melawan punyaku."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart03"
    }
    {
      Id = "NemesisField_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya mau muntah melihat semua air dan nyanyian ini, tapi tugas ini tetap harus diselesaikan."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart04"
    }
    {
      Id = "NemesisField_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru saja mau membuka jalan, jadi kenapa kau tidak ikut membantu sekalian."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart05"
    }
    {
      Id = "NemesisField_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi Takdir pasti sedang berpihak padamu, karena sebentar lagi aku yang bakal membereskan {#Emph}semua {#Prev}pekerjaan."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart06"
    }
    {
      Id = "NemesisField_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebentar lagi bakal ada lebih dari cukup makhluk keparat untuk kita berdua di sini."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart07"
    }
    {
      Id = "NemesisField_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak butuh bantuan darimu di sini, tapi bagaimana kalau kita buat ini sedikit menarik..."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart08"
    }
    {
      Id = "NemesisField_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar kutangani ini, dan begitu urusanku selesai, aku harus dibayar."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart09"
    }
    {
      Id = "NemesisField_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita lihat apakah Dewi Takdir sedang berpihak padamu atau padaku kali ini."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart10"
    }
    {
      Id = "NemesisField_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau dipikir-pikir, harusnya saat ini aku sedang berdiri santai berjaga di sana."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart11"
    }
    {
      Id = "NemesisField_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingat, bertarunglah lebih nekat karena Emasmu yang jadi taruhannya."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart12"
    }
    {
      Id = "NemesisField_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku butuh koin tambahan. Bagaimana kalau kuambil punyamu, begitu kita selesai di sini."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart13"
    }
    {
      Id = "NemesisField_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersiaplah bertarung seolah-olah ada barang incaran yang bisa kaubeli dari Charon sebagai taruhannya."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart14"
    }
    {
      Id = "NemesisField_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau muncul tepat saat aku mau membereskan semuanya sendirian. Yah, kau boleh ambil bagianmu."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart15"
    }
    {
      Id = "NemesisField_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita bagi rata jumlah mangsanya, kurang lebih begitu. Maksudku, {#Emph}aku {#Prev}yang bakal mengambil Emasmu."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart16"
    }
    {
      Id = "NemesisField_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau tidak becus membantu, Emasmu bakal kusita begitu aku membereskan ini."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart17"
    }
    {
      Id = "NemesisField_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pedang Dunia Bawah sudah di tanganku. Aku tidak butuh bantuanmu di sini, terima kasih."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart18"
    }
    {
      Id = "NemesisField_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau Emas tambahan? Usaha dulu. Awas, mereka datang."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart19"
    }
    {
      Id = "NemesisField_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana dengan sedikit kompetisi persahabatan, Tuan Putri? Ayo, tunjukkan taringmu."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart20"
    }
    {
      Id = "NemesisField_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katanya Chronos suka Emas, jadi dia pasti tak keberatan dengan taruhan kecil kita ini."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart21"
    }
    {
      Id = "NemesisField_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi di sinilah tempat sihir {#Emph}sejati {#Prev}beraksi, ya. Mari kita lihat sehebat apa pasukan terbaik sang Titan ini."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart22"
    }
    {
      Id = "NemesisField_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepertinya sekarang kitalah yang gentayangan menghantui hutan ini."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart23"
    }
    {
      Id = "NemesisField_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagi-bagi monster ikan aneh ini denganku, atau kurebut saja semua Emasmu?"
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart24"
    }
    {
      Id = "NemesisField_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak semua jiwa di Padang ini pantas berakhir di sini, tapi saat ini ya mau bagaimana lagi."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart25"
    }
    {
      Id = "NemesisField_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa bereskan ini sendiri, tapi rasanya bakal lebih seru kalau {#Emph}kau {#Prev}ikut mengacau."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart26"
    }
    {
      Id = "NemesisField_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, nggak adil banget. Kenapa kau dapat dua bilah pedang sedangkan aku cuma satu?"
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart27"
    }
    {
      Id = "NemesisField_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapak itu kelihatan kebesaran buatmu. Tapi memang begitu seleramu, kan?"
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart28"
    }
    {
      Id = "NemesisField_0503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pakai tengkorak itu lagi. Itu bukan senjata betulan, tapi terserah deh selama masih mempan."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart29"
    }
    {
      Id = "NemesisField_0504"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, itu sabit saudaraku. Mari kita lihat apa kau bisa mengayunkannya lebih baik daripada dia."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart30"
    }
    {
      Id = "NemesisField_0505"
      InheritFrom = "BaseNarrative"
      DisplayName = "Charon dulu sering menenteng-nenteng kapak itu ke mana-mana. Pasti kau lagi cari muka padanya, kan."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart31"
    }
    {
      Id = "NemesisField_0506"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan baju zirah sungguhan, tapi lumayanlah sebagai permulaan."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart32"
    }
    {
      Id = "NemesisField_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita bikin keadaan jadi lebih menarik lagi, Tuan Putri?"
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart33"
    }
    {
      Id = "NemesisField_0508"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jelas jauh lebih baik daripada cuma bengong di Crossroads. Apalagi kalau ujung-ujungnya aku yang mengantongi Emasmu."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart34"
    }
    {
      Id = "NemesisField_0509"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gerakkan kakimu lebih cepat, Tuan Putri, atau kurebut semua Emasmu."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart35"
    }
    {
      Id = "NemesisField_0510"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, taruhan-taruhan belakangan ini kurang berpihak padaku."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart36"
    }
    {
      Id = "NemesisField_0511"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua Emas ini toh ujung-ujungnya bakal jatuh ke tangan Charon juga, jadi apa pedulinya siapa yang dapat lebih banyak."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart37"
    }
    {
      Id = "NemesisField_0512"
      InheritFrom = "BaseNarrative"
      DisplayName = "Diam saja dan tonton aksiku, atau ikut bertarung. Hasilnya bakal sama saja bagiku."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart38"
    }
    {
      Id = "NemesisField_0513"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pikir badan cekingmu itu bisa menyaingi jumlah tebasanku di sini sekarang?"
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart39"
    }
    {
      Id = "NemesisField_0514"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lama sekali sejak terakhir kali aku menguras habis semua Emasmu, Tuan Putri."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart40"
    }
    {
      Id = "NemesisField_0515"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah agak lama nggak melihatmu turun ke sini. Terlalu sibuk mengurusi urusan di atas sana, ya?"
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart41"
    }
    {
      Id = "NemesisField_0516"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa Takut di udara ini rasanya begitu pekat sampai bisa kucecap. Mari buat mereka takut pada {#Emph}kita{#Prev}."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart42"
    }
    {
      Id = "NemesisField_0517"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan Sumpah itu cuma bikin segalanya jadi jauh lebih merepotkan dari yang seharusnya."
      Speaker = "Nemesis"
      Event = "NemesisCombatMiscStart43"
    }
    {
      Id = "NemesisField_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaget juga kau nggak langsung kabur pakai trik kembali andalanmu itu."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatFirstMeeting"
    }
    {
      Id = "MelinoeField_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak tahu apa-apa tentangku. Apa yang kau pikirkan sampai berkeliaran sejauh ini dari posmu, melanggar perintah langsung Kepala Sekolah Hecate?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatFirstMeeting"
    }
    {
      Id = "NemesisField_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang kupikirkan {#Emph}adalah {#Prev}kau nggak punya nyali atau kemampuan untuk menumbangkan sang Titan. Sedangkan {#Emph}aku {#Prev}punya. Sekarang, menyingkirlah."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatFirstMeeting"
    }
    {
      Id = "NemesisField_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadinya kukira begitu pertama kali melihatku di sini, kau bakal langsung mengadu ke Hecate secepat mungkin. Ternyata tidak."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutProgress01"
    }
    {
      Id = "MelinoeField_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beruntunglah kau karena Kepala Sekolah tidak menuntut laporan dariku. Setidaknya keberadaanmu di sini mungkin sedikit mengalihkan perhatian musuh dari tujuanku."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutProgress01"
    }
    {
      Id = "NemesisField_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya cuma itu yang bisa kulakukan. Lagipula aku nggak bakal mundur apa pun tindakanmu, tapi kalau dengan cara {#Emph}begini{#Prev}... aku bisa tetap fokus. Pada tugas yang ada di depan mata."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutProgress01"
    }
    {
      Id = "NemesisField_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aww{#Prev}, kau membawa Evil Eye yang kuberikan padamu, manis sekali. Buat musuh-musuhmu menyesal karena berani cari gara-gara denganmu."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutKeepsake01"
    }
    {
      Id = "MelinoeField_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yakin musuh-musuh kita akan mendapatkan ganjaran setimpal. Tapi Mata ini... nyaris terlihat hidup. Kau tidak menggunakannya untuk memata-mataiku, kan?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutKeepsake01"
    }
    {
      Id = "NemesisField_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak lah. Melihat tampangmu langsung saja sudah bikin bosan. Sekarang pergi sana sebelum Mata itu berdampak buruk padaku."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutKeepsake01"
    }
    {
      Id = "MelinoeField_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, bagaimana caramu melewati Kepala Sekolah saat turun ke sini? Beliau selalu menungguku di perbatasan Erebus."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutHecate01"
    }
    {
      Id = "NemesisField_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau baru saja menjawab pertanyaanmu sendiri. Beliau menunggumu {#Emph}kau{#Prev}, bukan aku. Bukan aku yang masih terus diuji dan dilatih. Dan aku juga lihai menghindarinya."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutHecate01"
    }
    {
      Id = "NemesisField_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi aku berpapasan dengan Artemis di belakang sana. Gabungan kekuatanku dan dia malam ini pasti sudah meringankan separuh beban beratmu."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutArtemis01"
    }
    {
      Id = "MelinoeField_3632"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin memang itu yang pantas kudapatkan, bukan? Dan jangan cemas, masih banyak musuh di depan yang harus kuhadapi sendirian. Bagaimana kabar sang dewi perburuan malam ini?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutArtemis01"
    }
    {
      Id = "NemesisField_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya baik-baik saja, obrolan kami lumayan santai. Tadinya kupikir dia sengaja menghindariku beberapa waktu belakangan, walau aku nggak habis pikir kenapa dia sampai harus melakukan hal semacam itu."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutArtemis01"
    }
    {
      Id = "MelinoeField_3633"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku pun sama sekali tak tahu."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutArtemis01"
    }
    {
      Id = "NemesisField_0490"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bekerja sama dengan Selene, ya? Tak pernah terpikir sihir bulannya bakal begitu berguna, apalagi dari tempat sejauh itu di atas sana. Sedangkan pedangku... kapan pun kubutuhkan, selalu bisa kuayunkan."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutSelene01"
    }
    {
      Id = "MelinoeField_4088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal bisa berhasil, kan? Aku ke sini bukan untuk meyakinkanmu soal ilmu sihir, Nemesis. Pikiranmu sudah tertutup. Lagipula, kau dan Selene memang tidak akur, ya...?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutSelene01"
    }
    {
      Id = "NemesisField_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan bukan anak kandung Nyx, tapi dia tetap diistimewakan. Mungkin karena dia selalu jadi penjilat sama sepertimu."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutSelene01"
    }
    {
      Id = "MelinoeField_4089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia mungkin mendengar omonganmu itu, lho."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutSelene01"
    }
    {
      Id = "NemesisField_0492"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau itu penjilat, Selene!"
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutSelene01"
    }
    {
      Id = "NemesisField_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selene benar-benar banyak membantumu dalam semua ini, ya. Maksudku, membantu {#Emph}kita{#Prev}. Kukira dia cuma akan diam menonton dari tempat tinggi, tapi ternyata dia turun tangan juga."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutSelene02"
    }
    {
      Id = "MelinoeField_4090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah apa jadinya kita tanpa bantuannya. Selain meminjamkan kekuatannya malam demi malam, dia juga berperan penting dalam berkoordinasi dengan sekutu kita di permukaan."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutSelene02"
    }
    {
      Id = "NemesisField_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami putri-putri Nyx memang tidak selalu akur satu sama lain. Berebut perhatian Ibu, atau apa pun yang merasuki pikiran kami. Pokoknya... aku salah menilainya."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutSelene02"
    }
    {
      Id = "MelinoeField_4091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir sebaiknya kau katakan langsung padanya, bukan padaku. Dia mungkin sedang mendengarkan."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutSelene02"
    }
    {
      Id = "NemesisField_0495"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku salah menilaimu, Selene...! Maaf soal yang kemarin."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutSelene02"
    }
    {
      Id = "NemesisField_0472"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa butuh minum Ambrosia di Crossroads kalau kita bisa berada di sini dan melakukan ini bersama-sama, ya kan?"
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutRelationship01"
    }
    {
      Id = "MelinoeField_3629"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membantai musuh tanpa konsekuensi itu caramu bersenang-senang? Yah, bukan berarti aku tidak puas dengan pekerjaan yang tuntas. Tunggu, apa maksudmu dengan {#Emph}bersama-sama?{#Prev}"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutRelationship01"
    }
    {
      Id = "NemesisField_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah, diamlah. Dulu kita sering tanding latih, dan ini hal yang paling mendekati itu. Tak ada orang lain yang sanggup mengimbangiku, apalagi melampauiku."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutRelationship01"
    }
    {
      Id = "MelinoeField_3630"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi hanya rivalitas kompetitif yang sehat ini saja yang ada di antara kita?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutRelationship01"
    }
    {
      Id = "NemesisField_0474"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kubilang diam. Memangnya kau mau ini jadi apa lagi?"
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutRelationship01"
    }
    {
      Id = "MelinoeField_3631"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Nanti kupikirkan lagi jawabannya."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutRelationship01"
    }
    {
      Id = "NemesisField_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sampai berkeringat? Aku berkeringat. Itu tak pernah terjadi, mereka itu cuma kroco, aku... {#Emph}sialan...{#Prev}"
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutRelationship02"
    }
    {
      Id = "MelinoeField_3620"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa, Nem, kau tidak apa-apa? Musuh kita mungkin memakai racun atau semacamnya, boleh kuperiksa kalau ada luka luar..."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutRelationship02"
    }
    {
      Id = "NemesisField_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan sentuh aku! Bukan itu masalahnya. Sudah, lanjutkan saja perjalananmu."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutRelationship02"
    }
    {
      Id = "MelinoeField_3621"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei..."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutRelationship02"
    }
    {
      Id = "NemesisField_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak senyaman berendam di pemandian air panas, kan, Tuan Putri? Ditambah lagi tugas ini terasa sepi."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "MelinoeField_3622"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak harus sepi, tapi dulu kau menolak saat kuajak menyusuri kedalaman ini bersama-sama. Sekarang berubah pikiran?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "NemesisField_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pikiranku memang sedang terusik, tapi bukan soal itu. Kau merasuki kepalaku. Dan aku mau kau keluar dari sana. Dulu kau selalu mencoba mengalihkan fokusku saat kita bertanding, dan sekarang, kau malah membuatnya makin parah."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "MelinoeField_3623"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maksudmu, apa yang sudah {#Emph}kulakukan{#Prev}...? ...Oh. Terusik yang kau maksud itu... perasaan. Lalu sekarang bagaimana...?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "NemesisField_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum tahu, tapi... yah, kita bisa tinggal di sini sebentar, sampai cukup. Mumpung suasananya tenang. Bukan memaksamu, cuma... belakangan ini terasa terlalu sepi, dan aku mau mengimbanginya."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "NemesisField_0453"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, aku tak butuh ini, tapi mungkin kau butuh."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "MelinoeField_3627"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, Nem..."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "MelinoeField_3628"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sama sepertimu, tak ingin terlena oleh hal yang berlebihan. Aku punya tugas yang harus kukerjakan, kau pun sedang berdinas; pikiranku pasti tidak akan tenang. Kau paham maksudku, kan?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "NemesisField_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paham. Lupakan saja tawaranku. Setidaknya kita sempat mengobrol begini. Aku harus pergi, tapi... sampai ketemu lagi nanti."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "MelinoeField_3624"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Mengimbanginya, ya... kalau kita mau bersantai dan menikmati ketenangan ini, baju zirarmu {#Emph}harus{#Prev} dilepas dulu. Biar kubantu membukanya, lalu kita lihat kelanjutannya?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "MelinoeField_3625"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Yah, baju zirarmu ternyata jauh lebih sulit dipasang kembali, tapi kita berhasil. Kau baik-baik saja, Nem? Rasa gelisahnya setidaknya sudah hilang...?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "NemesisField_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir begitu, dan ya, aku merasa lebih baik sekarang. Aku lega. Bagaimana denganmu, apa kau... maksudku..."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "MelinoeField_3626"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga lega! Tadi itu mendebarkan...! Seharusnya kita fokus bertugas, bukan melampiaskan rasa sepi, tapi... kau lebih tahu dari siapa pun apakah ini sudah kelewatan atau belum."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "NemesisField_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi sudah pas untuk saat ini. Aku harus pergi, tapi kita selalu bisa melakukan ini lagi jika memang perlu."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatBecomingCloser01"
    }
    {
      Id = "MelinoeField_1968"
      InheritFrom = "BaseNarrative"
      DisplayName = "Air sebanyak ini pasti sangat mengganggu baju zirarmu. Belum menemukan jalan lain untuk turun, ya?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutOceanus01"
    }
    {
      Id = "NemesisField_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu-satunya jalur lain cuma lewat Elysium, dan itu mustahil buat kau ataupun aku. Cara apa lagi yang lebih jitu buat Chronos nunjukin siapa bosnya selain menyegel Underworld selamanya?"
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutOceanus01"
    }
    {
      Id = "MelinoeField_1969"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untung ada celah yang dia lewatkan. Walau sekarang dia pasti sadar kalau kita memakai jalur ini. Setidaknya, sadar kalau aku memakainya."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutOceanus01"
    }
    {
      Id = "NemesisField_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makasih infonya! Pantesan ikannya pada galak. Ya sudah, aku cabut dulu. Baju zirah ini mestinya anti-karat sih, tapi buat jaga-jaga saja."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutOceanus01"
    }
    {
      Id = "MelinoeField_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau bisa melewati Scylla dan gerombolan Siren-nya? Sekali saja, aku ingin lewat tanpa harus mendengarkan nyanyian mereka..."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutScylla01"
    }
    {
      Id = "NemesisField_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka cukup waras buat nggak macam-macam denganku. Tunggu, kau beneran {#Emph}bertarung {#Prev}lawan mereka? Gimana ceritanya kau bisa musuhan sama grup musik?"
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutScylla01"
    }
    {
      Id = "MelinoeField_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... juga tidak sepenuhnya yakin. Tapi mereka langsung menyerangku tanpa ampun."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutScylla01"
    }
    {
      Id = "NemesisField_0020"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti ada alasannya."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutScylla01"
    }
    {
      Id = "MelinoeField_0760"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di seberang Padang Duka, tempat jalurnya turun menuju Tartarus... monster raksasa di sana... kau tahu makhluk apa itu?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutCerberus01"
    }
    {
      Id = "NemesisField_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bikin pusing. Nggak selalu bisa nemu jalan ke sana, dan sekalinya sampai, makhluk itu langsung memukulku mundur. Tapi tenang saja; aku sudah mengincarnya."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutCerberus01"
    }
    {
      Id = "NemesisField_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba jawab pertanyaanku, dan jangan berani-berani mengejekku atau kau bakal menyesal: Gimana caranya... masuk ke Tartarus? Aku berhasil menembus Padang Duka, lalu mentok di jalan buntu. Terus-terusan mentok."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutTartarus01"
    }
    {
      Id = "MelinoeField_1966"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tartarus sudah disegel. Alasan satu-satunya aku bisa masuk adalah karena Chronos sekalipun tak bisa mencabut hak kelahiranku dan otoritas dewataku atas tempat itu. Walau andai bukan berkat Guru, aku takkan tahu cara menggunakannya."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutTartarus01"
    }
    {
      Id = "NemesisField_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak membantu sama sekali, anggap saja aku nggak pernah nanya. Pasti ada jalan lain ke dalam, dan kalau nggak ada, ya tinggal kubuat sendiri. Untuk sekarang, nikmatilah masa-masa tanpa saingan selagi bisa."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutTartarus01"
    }
    {
      Id = "MelinoeField_3676"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada kemajuan mencari jalan masuk ke Tartarus? Aku rela meminjamkan hak kelahiranku kalau memungkinkan dalam situasi ini, meski aku cukup yakin itu hal mustahil."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutTartarus02"
    }
    {
      Id = "NemesisField_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya hak kelahiranku sendiri, makasih. Dan ya, ada kemajuan. Monster berkepala tiga di dekat akses pemeliharaan Tartarus... dia menggali jalan menembus tanah."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutTartarus02"
    }
    {
      Id = "MelinoeField_3677"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berencana masuk ke dasar Underworld lewat lubang neraka bekas galian monster itu? Kau tahu makhluk itu Cerberus, anjing ayahku, kan?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutTartarus02"
    }
    {
      Id = "NemesisField_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malah makin meyakinkan kalau terowongan itu bakal mengantarku tepat ke tempat tujuanku, cepat atau lambat. Camkan kata-kataku."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutTartarus02"
    }
    {
      Id = "MelinoeField_3678"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah kucamkan baik-baik..."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutTartarus02"
    }
    {
      Id = "NemesisField_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kubilang juga apa, aku pasti sampai sejauh ini. Tempat yang bagus kepunyaan ayahmu. Walau kayaknya sudah direnovasi total sama Chronos."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutTartarus03"
    }
    {
      Id = "MelinoeField_3679"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat atas keberhasilanmu menyusup ke dasar terdalam, Nemesis. Dan kalau kau sempat memancing pasukan musuh kita, itu lebih bagus lagi; musuh kita banyak sekali. Sudah sampai ke Chronos?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutTartarus03"
    }
    {
      Id = "NemesisField_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sampai di tempat yang mestinya Kediaman Hades, tapi tahu nggak? Mereka nggak ngizinin aku masuk. Sudah gedor-gedor, sudah coba kudobrak pintunya, tetap nggak mempan. Jadi Charon mengantarku balik."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutTartarus03"
    }
    {
      Id = "MelinoeField_3680"
      InheritFrom = "BaseNarrative"
      DisplayName = "Charon mau membawamu naik perahunya? Dia bahkan belum pernah mengizinkanku sekali pun!"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutTartarus03"
    }
    {
      Id = "NemesisField_0459"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin kau cuma nggak punya hak kelahiran buat itu, Tuan Putri."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutTartarus03"
    }
    {
      Id = "MelinoeField_3681"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...Ah."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutTartarus03"
    }
    {
      Id = "NemesisField_0477"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga kau belum selesai, dan tahu nggak? Aku juga belum. Apa pun yang lagi kau rencanakan sekarang, aku nggak mau ketinggalan."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja! Tinggal bicara saja dengan Guru atau Kakek Chronos, mereka pasti dengan senang hati memberitahumu semua rencana kita sekarang."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatPostTrueEnding01"
    }
    {
      Id = "NemesisField_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terserah. Sementara ini, kalau ada yang nanya, bilang saja aku cuma lagi cari angin dan memanaskan tangan biar tebasanku tetap tajam."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatPostTrueEnding01"
    }
    {
      Id = "MelinoeField_0761"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti mengira kau sudah berhasil menumbangkan Chronos sekarang. Apa kau bahkan sudah pernah melihat wujudnya? Mendekati Kediaman ayahku saja pernah?"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutChronos01"
    }
    {
      Id = "NemesisField_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu saja ada rintangan di jalan. Jalur menuju Tartarus sudah banyak berubah. Terutama begitu sampai di Padang Duka."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutChronos01"
    }
    {
      Id = "MelinoeField_0762"
      InheritFrom = "BaseNarrative"
      DisplayName = "Firasatku bisa menuntun ke mana kita harus pergi. Aku akan mengajakmu maju bersama seandainya Guru tidak melarangnya keras-keras."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutChronos01"
    }
    {
      Id = "NemesisField_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak bakal, tak peduli apa katanya. Aku bakal selesaikan ini sendirian. Peluangku lebih besar dengan cara begini."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutChronos01"
    }
    {
      Id = "MelinoeField_1211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa baju zirah seberat itu tidak membuat gerakanmu lambat? Pasti sangat tidak nyaman, terutama di bagian pinggang."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutArmor01"
    }
    {
      Id = "NemesisField_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang sangat nggak nyaman, kau benar. Lagian, nggak semua orang mau maju ke medan perang setengah telanjang."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutArmor01"
    }
    {
      Id = "MelinoeField_1212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh harus mencoba maju bertarung setengah telanjang. Siapa tahu kau malah suka!"
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutArmor01"
    }
    {
      Id = "NemesisField_0015"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mending kebal senjata, makasih."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutArmor01"
    }
    {
      Id = "NemesisField_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sialan! {#Prev}Berapa kali lagi kau mau nguras Emasku? Aturan taruhan ini kayaknya terlalu menguntungkanmu."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutLosing01"
    }
    {
      Id = "MelinoeField_1967"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sendiri yang menentukan aturan taruhan ini. Kau takkan pernah memberiku kemudahan, kan, Nem? Meski kau juga tak tega membuat taruhannya kelewat tidak adil untukku."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutLosing01"
    }
    {
      Id = "NemesisField_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mulai kepikiran kalau itu mungkin salah satu kelemahanku. Ya sudah, belilah sesuatu yang bagus, Tuan Putri. Lagian aku tak sudi mendengar gemerincing logam di setiap langkah kakiku."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutLosing01"
    }
    {
      Id = "NemesisField_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Taruhan pertama kita setelah sekian lama. Lagi sibuk di atas sana ya, menghirup udara permukaan? Kukira kau akhirnya sadar diri dan menyerahkan segalanya padaku."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutSurface01"
    }
    {
      Id = "MelinoeField_1213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, urusanku di sini sama sekali belum selesai. Dan terbukti kau juga begitu. Masih berjuang seperti sebelumnya? Memang cukup sulit, aku tahu."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutSurface01"
    }
    {
      Id = "NemesisField_0023"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halah, diam kau."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutSurface01"
    }
    {
      Id = "NemesisField_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan mengulur waktu. Makin cepat kau gagal, makin cepat pula aku bisa menunjukkan cara yang benar padamu."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutFailure01"
    }
    {
      Id = "NemesisField_0483"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa untungnya sih mempersulit dirimu sendiri seperti ini?"
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutShrine01"
    }
    {
      Id = "MelinoeField_4084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertanyaan yang lucu dari seseorang yang memaksakan diri masuk ke baju zirah paling tak nyaman yang pernah diciptakan. Menjalankan Surat Wasiat Malam itu sepadan dengan sedikit usaha ekstra."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutShrine01"
    }
    {
      Id = "NemesisField_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau cuma ingin memberi makan senjata-senjata milik-Nya, membuat mereka dan dirimu lebih kuat. Jangan serakah. Hal begitu tak pernah berakhir baik."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutShrine01"
    }
    {
      Id = "NemesisField_0487"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, kita berhasil. Kau sadar tidak kalau kau mengutak-atik Ikrar itu, kau bukan cuma mempersulit dirimu sendiri, tapi juga aku?"
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutShrine02"
    }
    {
      Id = "MelinoeField_4086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku tak yakin soal kata {#Emph}mempersulit. {#Prev}Kita ini melayani alam baka. Memang tak pernah ada ceritanya bakal mudah. Aku kaget kau malah ingin hal ini jadi gampang."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutShrine02"
    }
    {
      Id = "NemesisField_0488"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang kuinginkan, Tuan Putri, adalah agar kesulitannya {#Emph}pas. {#Prev}Supaya aku bisa menuntaskan apa yang harus kulakukan tanpa gagal lebih sering dari yang seharusnya."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutShrine02"
    }
    {
      Id = "MelinoeField_4087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan kegagalan kalau kau bisa belajar darinya."
      Speaker = "Melinoe"
      Event = "NemesisPostCombatAboutShrine02"
    }
    {
      Id = "NemesisField_0489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sudah cukup banyak belajar."
      Speaker = "Nemesis"
      Event = "NemesisPostCombatAboutShrine02"
    }
    {
      Id = "NemesisField_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat nih, laris manis sekali daganganmu, Charon."
      Speaker = "Nemesis"
      Event = "NemesisShopping01"
    }
    {
      Id = "NemesisField_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa lihat tidak kalau saudaraku dan aku sedang ada urusan?"
      Speaker = "Nemesis"
      Event = "NemesisShopping02"
    }
    {
      Id = "NemesisField_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan ganggu, aku lagi mau transaksi."
      Speaker = "Nemesis"
      Event = "NemesisShopping03"
    }
    {
      Id = "NemesisField_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Antre sana. Aku duluan yang sampai."
      Speaker = "Nemesis"
      Event = "NemesisShopping04"
    }
    {
      Id = "NemesisField_0607"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngobrolnya nanti saja. Lagi hitung Emasku."
      Speaker = "Nemesis"
      Event = "NemesisShopping05"
    }
    {
      Id = "NemesisField_0608"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesempatan terakhir untuk menimbun persediaan sebelum melangkah lebih jauh."
      Speaker = "Nemesis"
      Event = "NemesisShopping06"
    }
    {
      Id = "NemesisField_0609"
      InheritFrom = "BaseNarrative"
      DisplayName = "Charon saja bisa tutup mulut, mending kau juga begitu."
      Speaker = "Nemesis"
      Event = "NemesisShopping07"
    }
    {
      Id = "NemesisField_0610"
      InheritFrom = "BaseNarrative"
      DisplayName = "Urus saja urusanmu sendiri seolah-olah aku tak ada di sini."
      Speaker = "Nemesis"
      Event = "NemesisShopping08"
    }
    {
      Id = "NemesisField_0611"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi menikmati waktu berkualitas bersama saudaraku ini."
      Speaker = "Nemesis"
      Event = "NemesisShopping09"
    }
    {
      Id = "NemesisField_0612"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bakal dapat lebih banyak untung dari Charon dibanding dariku."
      Speaker = "Nemesis"
      Event = "NemesisShopping10"
    }
    {
      Id = "NemesisField_0326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pulang sana ke Hecate, biar kutangani dari sini."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisDeathReactionVoiceLines"
    }
    {
      Id = "NemesisField_0327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari dulu kubilang kau memang tak punya kemampuan untuk ini."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisDeathReactionVoiceLines"
    }
    {
      Id = "NemesisField_0328"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Awas saja kalau kudengar kau menyalahkan Sang Takdir atas hal ini."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisDeathReactionVoiceLines"
    }
    {
      Id = "NemesisField_0329"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukira kau sanggup menahan derita lebih banyak dari itu."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisDeathReactionVoiceLines"
    }
    {
      Id = "NemesisField_0330"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau dapat ganjaran yang setimpal; aku paham betul soal itu."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisDeathReactionVoiceLines"
    }
    {
      Id = "NemesisField_0331"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua ini rupanya terlalu berat buatmu ya, kasihan sekali."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisDeathReactionVoiceLines"
    }
    {
      Id = "NemesisField_0332"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita semua disuruh mengandalkanmu? Yang benar saja."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisDeathReactionVoiceLines"
    }
    {
      Id = "NemesisField_0333"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo dong, harusnya kau bisa berbuat lebih baik dari itu."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisDeathReactionVoiceLines"
    }
    {
      Id = "NemesisField_0334"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pergi sana, angkat pantat kurusmu itu dari sini."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisDeathReactionVoiceLines"
    }
    {
      Id = "NemesisField_0335"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau memang tak pernah bisa tahan tekanan, tahu tidak."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisDeathReactionVoiceLines"
    }
    {
      Id = "NemesisField_0402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah kalau begitu."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0403"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Syukurlah para Fates."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mujur sekali kau."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pantas kau dapatkan."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0406"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terus kenapa."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0407"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buat apa kau butuh barang itu?"
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0418"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beruntung sekali kau."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0419"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0420"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.NemesisGatherReactionVoiceLines"
    }
    {
      Id = "NemesisField_0421"
      InheritFrom = "BaseSubtitle"
