{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Dionysus.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "MelinoeField_2392"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam ini aku sudah ada rencana, maaf..."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_2400"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia orang yang hebat, aku yakin..."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_2897"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sepertinya aku harus menolaknya."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_2900"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Ya."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Melinoe_0601"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak, aku... {#Emph}ugh."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Melinoe_1308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita lihat saja nanti."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_3684"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Harusnya tadi aku diam saja."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_4476"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau aku kebetulan bertemu dengannya, tentu."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Dionysus_0084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Coba lihat yang ini."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Dionysus_0075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Coba kita lihat..."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Dionysus_0076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada apa saja ya..."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Dionysus_0077"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Punya barang yang pas nih..."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Dionysus_0078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang kamu butuhkan..."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Dionysus_0079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang menarik?"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Dionysus_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau coba salah satu yang ini?"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Dionysus_0081"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menu spesial malam ini."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Dionysus_0082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lagi kepingin apa nih?"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Dionysus_0083"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau yang ini?"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_2576_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan rumah yang sangat berbesar hati."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_2577"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat berpesta, Yang Mulia."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Haaaii."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Haaaii!"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada kabar apa?"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersulang!"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, aku tak ke mana-mana, kok."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pastinya."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu luar biasa banget."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Apa katamu barusan?"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu keren juga."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yoi!!"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.InteractVoiceLines"
    }
    {
      Id = "Dionysus_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, siapa {#Emph}ini{#Prev}, Nimfa macam apa yang mampir ke sini? Bukan dari perairan atau pedalaman hutan, tapi tunggu tunggu {#Emph}tunggu! {#Prev}Mata {#Emph}itu! {#Prev}Zag, kawan, apa itu {#Emph}kau?! {#Prev}Kau banyak {#Emph}berubah! {#Prev}Keren juga!"
      Speaker = "Dionysus"
      Event = "DionysusFirstMeeting"
    }
    {
      Id = "MelinoeField_2386"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewa Dionisius, bukan? Aku Melinoë, saudari Zagreus. Aku datang demi membantu Olympus atas titah keluarga! Tapi, apa maksud dari perayaan ini? Bukankah kalian sedang berperang?"
      Speaker = "Melinoe"
      Event = "DionysusFirstMeeting"
    }
    {
      Id = "Dionysus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohhh, Mel{#Prev}, benar juga, yang lain sempat membicarakanmu. {#Emph}Emm{#Prev}, dengar ya manis, ada {#Emph}banyak {#Prev}hal yang kusuka, tapi perang sama sekali bukan salah satunya. Lagian buat apa, kita para dewa kan tak bisa mati! Justru kita harus {#Emph}menikmati hidup!"
      Speaker = "Dionysus"
      Event = "DionysusFirstMeeting"
    }
    {
      Id = "MelinoeField_2387"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunungmu sedang dikepung. Chronos telah menawan keluargaku di sana, dan sebentar lagi dia akan menawan keluargamu juga!"
      Speaker = "Melinoe"
      Event = "DionysusFirstMeeting"
    }
    {
      Id = "Dionysus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Justru makin ada alasan untuk bersulang selagi kita masih bisa, ya kan? {#Emph}Heh. {#Prev}Tapi aku paham, kok! Itu bukan gayamu. Tapi bagaimana kalau cicipi sedikit penghangat badan untuk bekal di jalan?"
      Speaker = "Dionysus"
      Event = "DionysusFirstMeeting"
    }
    {
      Id = "MelinoeField_4329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewa Dionysus, benar begitu? Aku Melinoë, adik Zagreus. Aku datang membantu gunung ini atas mandat keluarga. Kenapa ada pesta pora begini? Perangnya sudah selesai?"
      Speaker = "Melinoe"
      Event = "DionysusFirstMeeting_B"
    }
    {
      Id = "MelinoeField_4330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kataku tadi {#Emph}akhir {#Prev}dari perang. Walau kurasa secara teknis gunungmu masih dikepung."
      Speaker = "Melinoe"
      Event = "DionysusFirstMeeting_B"
    }
    {
      Id = "Dionysus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heeey{#Prev}, lihat siapa yang akhirnya berubah pikiran buat mampir ke pesta kecil kita! Selamat datang kembali, Mel sayang, ayo sana, ambil cangkirmu sendiri dan berbaurlah dengan yang lain!"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast01"
    }
    {
      Id = "MelinoeField_2388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terdengar sangat menggoda, Dewa Dionysus, tapi sayangnya kurasa aku tak bisa. Ada banyak bahaya di depan sana, dan rekan-rekan Olympian-mu kewalahan menahan mereka sendirian."
      Speaker = "Melinoe"
      Event = "DionysusAboutFeast01"
    }
    {
      Id = "Dionysus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku ikut prihatin buat mereka, beneran! Para dewa mahakuasa dengan kekuatan tanpa batas terpaksa berjuang sendirian. Untunglah aku bisa menenggelamkan kesedihanku di sini, dan tahu apa? Kau juga bisa!"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast01"
    }
    {
      Id = "Dionysus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar cuma numpang lewat? Lihat semua godaan dalam berbagai rupa ini! Yang berupa minuman cair, yang santapan mewah, {#Emph}mm! {#Prev}Tapi kau sama sekali tak goyah dan tak tergoda?"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast02"
    }
    {
      Id = "MelinoeField_2389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, aku sebenarnya ingin sekali tinggal. Menikmati minuman dan kudapan... berbincang dengan para tamu yang niscaya menarik ini... tapi aku tak bisa. Apa kau tak paham? Gunungmu sedang terbakar!"
      Speaker = "Melinoe"
      Event = "DionysusAboutFeast02"
    }
    {
      Id = "Dionysus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah kalau memang terbakar, sayang, biarkan saja terbakar, kataku mah! Tapi aku tak mau berdebat lagi, maksudku, itu kan cuma bentuk lain dari bertengkar, ya 'kan? Jadi lakukan saja urusanmu, dan aku urus urusanku!"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast02"
    }
    {
      Id = "MelinoeField_2391"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewa Dionysus, sudah berapa lama kau berpesta pora begini? Maksudku, di tempat ini. Tiap malam, kalian terus berpesta seolah tak ada hari esok."
      Speaker = "Melinoe"
      Event = "DionysusAboutFeast03"
    }
    {
      Id = "Dionysus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mel sayang, panggil saja aku Dionysus, embel-embel Dewa itu rasanya tak cocok buatku, ya 'kan? Soal sudah berapa lama kita berpesta begini, entahlah! Lumayan lama kayaknya. Mungkin rekor baru! {#Emph}Heh. {#Prev}Yakin tak mau ikut gabung?"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast03"
    }
    {
      Id = "MelinoeField_2393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kau tak bisa berpesta lagi? Bayangkan sesuatu yang begitu mengerikan sampai memaksamu menghentikan gaya hidup seperti ini. Menghancurkan segala hal yang kau sayangi!"
      Speaker = "Melinoe"
      Event = "DionysusAboutFeast04"
    }
    {
      Id = "Dionysus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu apa yang sedang kau coba lakukan, sayang, dan itu takkan mempan. Aku sudah menulikan telinga dari {#Emph}semua {#Prev}hal negatif, termasuk ocehanmu! Dan berhubung aku tuan rumah yang baik, aku {#Emph}tetap {#Prev}akan memberimu {#Emph}ini."
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast04"
    }
    {
      Id = "MelinoeField_2394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya dalam rangka apa pesta pora ini? Aku sama sekali tak melihat alasan untuk berpesta saat ini."
      Speaker = "Melinoe"
      Event = "DionysusAboutFeast05"
    }
    {
      Id = "Dionysus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau belum paham juga ya, sayang? Tiap detik kita hidup dan bernapas itu sudah lebih dari cukup jadi alasan! Mungkin kau suka bersedih-sedih ria, entahlah, tapi aku? Aku sukanya merasa {#Emph}senang!"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast05"
    }
    {
      Id = "Dionysus_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, senang kau bisa mampir! Aku tahu lagi banyak masalah di luar sana, tapi buat apa semua itu kalau kau tak bisa santai sesekali, ya 'kan? Jadi {#Emph}santai {#Prev}dulu sedikit, kau sudah {#Emph}sampai di sini!"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast06"
    }
    {
      Id = "MelinoeField_2972"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma numpang lewat. Namun, aku sangat menghargai keramahanmu. Mungkin jika dan saat semua ini akhirnya selesai, aku bisa santai sejenak, seperti katamu."
      Speaker = "Melinoe"
      Event = "DionysusAboutFeast06"
    }
    {
      Id = "Dionysus_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, bakal kupegang kata-katamu itu, kalau aku ingat kau pernah mengatakannya! Tapi untuk sekarang, bersulang buat keberhasilanmu, dan semoga perangmu lekas rampung dengan damai!"
      Speaker = "Dionysus"
      Event = "DionysusAboutFeast06"
    }
    {
      Id = "Dionysus_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Punya kekasih spesial dalam hidupmu atau semacamnya, Mel sayang? Soalnya tinggal bilang saja, bakal kumasukkan ke sini! Gampang banget nyisain satu dua undangan lagi di pesta ini!"
      Speaker = "Dionysus"
      Event = "DionysusAboutRelationships01"
    }
    {
      Id = "MelinoeField_4759"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas tawarannya. Aku tidak terikat dalam ikatan suci seperti Yang Mulia Paman Zeus dan Ratu Hera jika itu maksudmu, tapi sebagian besar kebutuhanku terpenuhi."
      Speaker = "Melinoe"
      Event = "DionysusAboutRelationships01"
    }
    {
      Id = "Dionysus_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, bisa dibilang begitu juga sih. Aku juga suka kalau semua kebutuhan{#Emph}ku {#Prev}terpenuhi! Asal {#Emph}hasrat{#Prev}mu juga terpuaskan, tapi ya sudahlah, pasangan atau kekasih-kekasihmu sangat dipersilakan mampir!"
      Speaker = "Dionysus"
      Event = "DionysusAboutRelationships01"
    }
    {
      Id = "Dionysus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mel sayang, penampilanmu kacau banget kalau boleh jujur, maksudku apa kau jatuh menggelinding dari lereng gunung dalam perjalanan ke sini? Mau cuci muka dulu?"
      Speaker = "Dionysus"
      Event = "DionysusLowHealth01"
    }
    {
      Id = "MelinoeField_2896"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong maafkan penampilanku yang berantakan ini. Aku harus melintasi kota terkutuk yang penuh mayat hidup, menyusup ke armada musuh, dan mendaki separuh jalan menuju Istana Zeus untuk sampai ke sini."
      Speaker = "Melinoe"
      Event = "DionysusLowHealth01"
    }
    {
      Id = "Dionysus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan banyak alasan! Sekarang, pilihannya cuma lepas pakaianmu yang baunya sudah luar biasa itu dan bergabunglah seperti tamu-tamuku yang lain, atau lekas pergi! Kami menerapkan aturan berpakaian yang ketat."
      Speaker = "Dionysus"
      Event = "DionysusLowHealth01"
    }
    {
      Id = "Dionysus_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Daun Ara yang kau bawa itu... itu dari {#Emph}lemari pribadiku! {#Prev}Kenapa bisa ada padamu dan bukan padaku? Masa langsung kuberikan begitu saja sebagai hadiah?"
      Speaker = "Dionysus"
      Event = "DionysusAboutKeepsake01"
    }
    {
      Id = "MelinoeField_2901"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang persis seperti itu kejadiannya. Aku memberimu sebotol Nektar, dan kau memberiku Daun ini sebagai gantinya. Apa kau tak ingat?"
      Speaker = "Melinoe"
      Event = "DionysusAboutKeepsake01"
    }
    {
      Id = "Dionysus_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa aku tak ingat... {#Emph}erm{#Prev}, kadang-kadang sih ingat! Tapi tidak selalu, apalagi akhir-akhir ini! Yah, kalau diriku di masa lalu merasa harus memberimu barang seperti itu, berarti dia pasti punya kesan yang sangat bagus tentangmu, ya 'kan?"
      Speaker = "Dionysus"
      Event = "DionysusAboutKeepsake01"
    }
    {
      Id = "Dionysus_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bawa apa kau itu, semacam {#Emph}katak? {#Prev}Baguslah, soalnya katak dan aku punya ikatan masa lalu yang erat! Satu-satunya aturan cuma jangan berenang di mata air, nanti para tamu bisa merasa agak {#Emph}ihh!"
      Speaker = "Dionysus"
      Event = "DionysusAboutFrogFamiliar01"
    }
    {
      Id = "MelinoeField_2911"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu Frinos, dan tak perlu cemas, bukan berarti kau pernah cemas juga sih. Dia takkan membuat onar, lagipula dia selalu menjauhi orang lain. Terima kasih sudah mengizinkannya ke sini... juga mengizinkanku, omong-omong."
      Speaker = "Melinoe"
      Event = "DionysusAboutFrogFamiliar01"
    }
    {
      Id = "Dionysus_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh tentu saja, ini jenis pesta di mana kalau kau bisa masuk kemari, artinya kau orang yang asyik! Katakmu itu juga boleh, asal dia tidak bernyanyi! Dia tidak bisa bernyanyi, 'kan...?"
      Speaker = "Dionysus"
      Event = "DionysusAboutFrogFamiliar01"
    }
    {
      Id = "Dionysus_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hei, {#Prev}anak kucing manis, {#Emph}meoow, hahaha! {#Prev}Dan hei juga buat {#Emph}kamu{#Prev}, Mel sayang! Jadi, bagaimana kalau kau kenalkan teman berbulumu itu, ya?"
      Speaker = "Dionysus"
      Event = "DionysusAboutCatFamiliar01"
    }
    {
      Id = "MelinoeField_2973"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}erm{#Prev}, ini Toula, dan kami saling menjaga satu sama lain. Jangan khawatir, aku akan mengawasinya baik-baik, jangan sampai dia mencuri semua hidangan di sekitar sini."
      Speaker = "Melinoe"
      Event = "DionysusAboutCatFamiliar01"
    }
    {
      Id = "Dionysus_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu khawatir soal itu, makanan kita di sini melimpah ruah, bahkan untuk {#Emph}berbagai macam {#Prev}selera yang berbeda! Kita semua ini cuma sekumpulan hewan liar, jadi hewan peliharaan{#Emph}mu {#Prev}{#Emph}sangat {#Prev}disambut untuk bergabung dengan kawanannya!"
      Speaker = "Dionysus"
      Event = "DionysusAboutCatFamiliar01"
    }
    {
      Id = "Dionysus_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Waduh{#Prev}, siapa tuh si {#Emph}burung{#Prev}, dan maksudku bukan {#Emph}kau{#Prev}, Mel sayang! Gagak itu terbang ke sini dengan tampang gelisah banget, kayak habis melihat hantu! Gagak minum anggur tidak ya? Siapa tahu bisa bikin dia agak santai sedikit."
      Speaker = "Dionysus"
      Event = "DionysusAboutRavenFamiliar01"
    }
    {
      Id = "MelinoeField_2974"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gagakku, Raki, memang bisa sedikit gugup di dekat orang asing... atau di dekat hal apa pun, sebenarnya. Kurasa dia tak suka anggur, tapi suasana di sini mungkin bisa berdampak baik untuknya."
      Speaker = "Melinoe"
      Event = "DionysusAboutRavenFamiliar01"
    }
    {
      Id = "Dionysus_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa berdampak baik buat {#Emph}kamu {#Prev}juga, lho. Hewan-hewanmu selalu diterima di sini, soalnya di lubuk hati terdalam, kita semua ini kan cuma hewan, tahu maksudku 'kan?"
      Speaker = "Dionysus"
      Event = "DionysusAboutRavenFamiliar01"
    }
    {
      Id = "Dionysus_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mel sayang, aku {#Emph}harus {#Prev}minta kamu kenalkan aku sama anjingmu itu {#Emph}sekarang juga! {#Prev}Belum pernah aku lihat ras se-{#Emph}cantik {#Prev}itu sejak terakhir kali aku jalan-jalan ke barat! Dulu aku suka keliling dunia, lho."
      Speaker = "Dionysus"
      Event = "DionysusAboutHoundFamiliar01"
    }
    {
      Id = "MelinoeField_2975"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dionysus, perkenalkan ini Hecuba, yang untuk saat ini ada di bawah asuhanku, dan perilakunya selalu sangat baik, kau akan melihatnya sendiri. Perjalananmu pasti luar biasa... menjelajahi dunia..."
      Speaker = "Melinoe"
      Event = "DionysusAboutHoundFamiliar01"
    }
    {
      Id = "Dionysus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh jelas luar biasa, tapi sekarang aku di sini dan tempat ini juga luar biasa! Hal-hal di dunia tak pernah bertahan lama, jadi nikmatilah selagi ada. Tak ada yang abadi! Kecuali kita!"
      Speaker = "Dionysus"
      Event = "DionysusAboutHoundFamiliar01"
    }
    {
      Id = "Dionysus_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, itu polecat, dia ikut denganmu? Pernah kulihat dia berkeliaran di gunung ini ke sana kemari, cari aman saja, sama sepertiku dan semua orang di sini! Dia ada nama?"
      Speaker = "Dionysus"
      Event = "DionysusAboutPolecatFamiliar01"
    }
    {
      Id = "MelinoeField_4753"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh iya, perkenalkan ini Gale, dia hewan yang cukup mandiri dan membantuku mengintai jalan di depan. Aku kagum kau langsung tahu dia seekor polecat!"
      Speaker = "Melinoe"
      Event = "DionysusAboutPolecatFamiliar01"
    }
    {
      Id = "Dionysus_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku paham soal binatang, Mel sayang! Ya ampun, aku sendiri ini binatang, kita semua binatang! Tapi kami bakal coba bersikap sopan di depan Gale. Dan jangan khawatir soal Maena di sampingku ini juga, dia tidak menggigit! Tidak keras-keras."
      Speaker = "Dionysus"
      Event = "DionysusAboutPolecatFamiliar01"
    }
    {
      Id = "MelinoeField_4754"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kucing yang mengesankan sekali di sampingmu itu. Bagaimana kau bisa menjinakkannya? Kukira makhluk seperti itu lebih suka berkeliaran bebas."
      Speaker = "Melinoe"
      Event = "DionysusAboutLeopard01"
    }
    {
      Id = "Dionysus_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Menjinakkannya, {#Prev}Mel sayang? Kamu mestinya tahu kalau Maena ini se-{#Emph}liar {#Prev}yang kau bayangkan! Dan percayalah, aku sudah kenal {#Emph}banyak {#Prev}leopard seumur hidupku!"
      Speaker = "Dionysus"
      Event = "DionysusAboutLeopard01"
    }
    {
      Id = "Dionysus_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Whoa{#Prev}, awas dengan belati-belati itu, Mel sayang, jangan sampai kamu tak sengaja menusuk orang di sini! Tapi, {#Emph}tunggu tunggu tunggu{#Prev}, sepertinya aku pernah melihat sepasang belati itu..."
      Speaker = "Dionysus"
      Event = "DionysusAboutPanAspect01"
    }
    {
      Id = "MelinoeField_4475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau mengenali bilah-bilah ini saat masih dimiliki oleh dewa alam liar bernama Pan. Tapi aku tidak mencurinya atau semacamnya! Dan aku akan berhati-hati."
      Speaker = "Melinoe"
      Event = "DionysusAboutPanAspect01"
    }
    {
      Id = "Dionysus_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, ya, {#Emph}Paaan! {#Prev}Aku suka Pan, dia orangnya {#Emph}liar{#Prev}, dan dia benar-benar {#Emph}gaul ke mana-mana! {#Prev}Bahkan dulu pernah bantu Ayah mengatasi masalah Typhon zaman baheula. Sampaikan salamku padanya, ya! Pada Pan, bukan Ayah."
      Speaker = "Dionysus"
      Event = "DionysusAboutPanAspect01"
    }
    {
      Id = "MelinoeField_2898"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau pernah bermasalah dengan para Automaton yang konon bertugas mempertahankan wilayahmu? Mereka menyerangku tanpa pandang bulu, menganggapku sama seperti musuh-musuhmu."
      Speaker = "Melinoe"
      Event = "DionysusAboutAutomatons01"
    }
    {
      Id = "Dionysus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin mereka pikir kamu terlalu tegang! Ayolah, Mel sayang, kamu tidak usah mencemaskan kami! Aku punya jurus-jurus jituku sendiri, yang bahkan karya ciptaan Tuan Hephaestus pun tak sanggup melawannya."
      Speaker = "Dionysus"
      Event = "DionysusAboutAutomatons01"
    }
    {
      Id = "MelinoeField_2899"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jurus jitu... jadi kau tahu cara mengelabui sistem pendeteksi ancaman mereka. Bisakah kau ajari aku caranya?"
      Speaker = "Melinoe"
      Event = "DionysusAboutAutomatons01"
    }
    {
      Id = "Dionysus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku bisa mengajarimu {#Emph}banyak {#Prev}hal. Rombongan kaleng rombeng yang kamu bicarakan itu, mereka sudah seperti keluarga! Tentu saja, kadang mereka suka ribut, tapi niat mereka baik. Hindari saja jalan mereka, beres kan?"
      Speaker = "Dionysus"
      Event = "DionysusAboutAutomatons01"
    }
    {
      Id = "Dionysus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yakin tidak mau ikut berendam di mata air bersama kami? Di luar memang dingin, ya, tapi di dalam sini hangat! Tungku Tempa Hephaestus memompakan panas dalam jumlah yang {#Emph}pas! {#Prev}"
      Speaker = "Dionysus"
      Event = "DionysusAboutSprings01"
    }
    {
      Id = "MelinoeField_2907"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami punya mata air seperti ini di tempat tinggalku! Rasanya sangat nyaman... hanya saja, aku benar-benar tak boleh mandi sekarang. Karena berbagai macam alasan."
      Speaker = "Melinoe"
      Event = "DionysusAboutSprings01"
    }
    {
      Id = "Dionysus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kamu terus-terusan mampir ke sini! Ayo{#Emph}lah {#Prev}Mel sayang, kamu mau ikutan kan, tak usah malu-malu, kita semua berteman di sini, {#Emph}semuanya! {#Prev}Bahkan ada yang {#Emph}lebih {#Prev}dari sekadar teman! {#Emph}Heh! {#Prev}Nanti juga bakal terbiasa, kurasa?"
      Speaker = "Dionysus"
      Event = "DionysusAboutSprings01"
    }
    {
      Id = "MelinoeField_2908"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu guruku juga seorang pengelana sepertimu. Beliau mengajariku sedikit tentang perjalanan dan kepayahanmu. Kau telah melintasi dunia... bertemu banyak makhluk berbeda! Namun kau lebih memilih berada di sini, seperti ini?"
      Speaker = "Melinoe"
      Event = "DionysusAboutTravels01"
    }
    {
      Id = "Dionysus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Haha, oh {#Prev}tentu saja, {#Emph}ya! {#Prev}Maksudku, coba lihat sekelilingmu, {#Emph}semua orang {#Prev}tampak menawan, cuacanya sempurna, dan persediaan kita melimpah! Kenapa, kamu pikir aku lebih suka jalan-jalan di luar sana?"
      Speaker = "Dionysus"
      Event = "DionysusAboutTravels01"
    }
    {
      Id = "MelinoeField_2909"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, aku... hanya mengira hidup berpindah-pindah mungkin membuat watakmu agak berbeda! Entahlah... lebih introspektif? Lebih menyukai kesendirian, mungkin."
      Speaker = "Melinoe"
      Event = "DionysusAboutTravels01"
    }
    {
      Id = "Dionysus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu masih muda, sayang! Kalau kamu sudah melihat semua yang pernah kulihat, kamu pasti bisa menghargai hal-hal nikmat seperti diriku. Tak perlu dipaksakan! Nanti kamu juga bakal sampai ke tahap itu, mungkin setelah semua urusan ini beres!"
      Speaker = "Dionysus"
      Event = "DionysusAboutTravels01"
    }
    {
      Id = "MelinoeField_2910"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, aku tidak terbiasa melihat Satir yang tidak langsung mencoba menusukku begitu melihatku. Teman lamamu?"
      Speaker = "Melinoe"
      Event = "DionysusAboutSatyrs01"
    }
    {
      Id = "Dionysus_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh ya, semua kambing tua ini dan aku, hubungan kami sudah terjalin {#Emph}lama {#Prev}sekali! Satir-satir sejati yang doyan pesta pora sejati. Kalau soal hal-hal lain di luar sana, mereka masa bodoh saja. Dan aku pun begitu!"
      Speaker = "Dionysus"
      Event = "DionysusAboutSatyrs01"
    }
    {
      Id = "Dionysus_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu bukan berasal dari sekitar sini, jadi bagaimana kabar kaum fana belakangan ini? Kamu pasti sempat melihat beberapa dari mereka di sepanjang jalanmu. Sudah agak lama aku tidak mendengar kabar mereka!"
      Speaker = "Dionysus"
      Event = "DionysusAboutMortals01"
    }
    {
      Id = "MelinoeField_2912"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka pernah mengalami masa yang jauh lebih baik! Kebanyakan mungkin sedang berdoa memohon kedamaian pada keluarga kita, sejak Chronos membuka lebar-lebar gerbang Dunia Bawah, membiarkan orang mati berkeliaran di daratan."
      Speaker = "Melinoe"
      Event = "DionysusAboutMortals01"
    }
    {
      Id = "Dionysus_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang berarti orang-orang fana bisa menghabiskan lebih banyak waktu bersama kerabat mereka yang sudah lama tiada! Ayolah, tetaplah berpikiran {#Emph}positif{#Prev}, Mel sayang! Begitulah cara kaum fana bertahan hidup! Semuanya bakal baik-baik saja!"
      Speaker = "Dionysus"
      Event = "DionysusAboutMortals01"
    }
    {
      Id = "Dionysus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu belum memberi tahu Ayahku soal pesta kecil kita ini, kan? Soalnya kita tak mau sampai harus beres-beres dan mencari tempat rahasia lainnya. Di sini sudah sempurna!"
      Speaker = "Dionysus"
      Event = "DionysusAboutOlympians01"
    }
    {
      Id = "MelinoeField_2390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir Tuan Zeus punya urusan yang jauh lebih mendesak untuk dipikirkan daripada perjamuan tak berujungmu ini, yang menurutku akan jauh lebih baik jika legiun Chronos tidak berkeliaran di sekitar sini. Bangsa Olimpus yang lain bahkan tidak tahu perjamuan ini sedang berlangsung?"
      Speaker = "Melinoe"
      Event = "DionysusAboutOlympians01"
    }
    {
      Id = "Dionysus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali, sayang! Karena ini pesta {#Emph}eksklusif {#Prev}hanya untuk tamu-tamu yang ku-{#Emph}tahu {#Prev}pasti orangnya asyik. Yang sebenarnya tidak menjelaskan kenapa {#Emph}kamu {#Prev}bisa terus-terusan nyasar ke sini, tapi ya sudahlah! Detail sepele, kan?"
      Speaker = "Dionysus"
      Event = "DionysusAboutOlympians01"
    }
    {
      Id = "Dionysus_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi kamu bilang apa yang terjadi pada Zag, semuanya masih baik-baik saja dengannya, kan? Kamu harus mengajaknya saat mampir ke sini lagi nanti, oh dia pasti {#Emph}suka {#Prev}banget!"
      Speaker = "Dionysus"
      Event = "DionysusAboutZagreus01"
    }
    {
      Id = "MelinoeField_2398"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebelumnya sudah kubilang, Chronos, kakek Titan kita yang tanpa henti menyerang gunung ini, menawan seluruh keluarga intiku; termasuk Zagreus. Jadi dia tidak bisa datang ke perjamuan ini sekarang."
      Speaker = "Melinoe"
      Event = "DionysusAboutZagreus01"
    }
    {
      Id = "Dionysus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah, {#Prev}sayang sekali, tapi mungkin lain kali, ya? Aku selalu merasa punya ikatan dengannya, kecocokan sejati, jadi kalau kamu bertemu Mas Zag, beri tahu dia kalau dia diterima di pestaku ini {#Emph}kapan saja!"
      Speaker = "Dionysus"
      Event = "DionysusAboutZagreus01"
    }
    {
      Id = "MelinoeField_2399"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya kau dan kakakku Zagreus cukup dekat. Seperti apa dia orangnya? Soalnya aku sama sekali tak ingat sosoknya, karena Chronos membawanya pergi saat aku masih sangat kecil."
      Speaker = "Melinoe"
      Event = "DionysusAboutZagreus02"
    }
    {
      Id = "Dionysus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu sendiri kan, aku sudah lama tidak mendengar kabar darinya, ya? {#Emph}Emm{#Prev}, kalau dipikir-pikir lagi, kami sebenarnya tidak terlalu sering mengobrol, meski aku mengirimkan banyak Berkah untuknya! Ngomong-ngomong, bagaimana kabarnya sekarang?"
      Speaker = "Dionysus"
      Event = "DionysusAboutZagreus02"
    }
    {
      Id = "Dionysus_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong gimana kabar si bung Zag akhir-akhir ini, dia baik-baik aja kan? Udah agak lama sih aku berhenti ngirim Rahmatku ke dia..."
      Speaker = "Dionysus"
      Event = "DionysusAboutZagreus03"
    }
    {
      Id = "MelinoeField_4492"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, sekarang Zagreus sudah bebas dari kurungan sang waktu, begitu pula ibuku, ayahku, dan segenap staf Grya Hades, kurasa kabarnya sangat baik! Aku yakin dia bakal senang mendengar kabar darimu."
      Speaker = "Melinoe"
      Event = "DionysusAboutZagreus03"
    }
    {
      Id = "Dionysus_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah lega dengarnya, kukira aku sempat bikin dia tersinggung gara-gara sesuatu! Bisa aja dia mutus kontak denganku, tapi ternyata enggak."
      Speaker = "Dionysus"
      Event = "DionysusAboutZagreus03"
    }
    {
      Id = "Dionysus_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kamu kelihatan, {#Emph}ah{#Prev}, maksudku, {#Emph}wah. {#Prev}Kamu makin tinggi ya, dan ini murni pujian lho... atau akunya yang memendek, atau... {#Emph}aduh{#Prev}, kepalaku..."
      Speaker = "Dionysus"
      Event = "DionysusAboutCirce01"
    }
    {
      Id = "MelinoeField_2971"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, maksudmu... tinggi badanku yang tak biasa ini! Ini berkat sedikit sihir sementara dari rekanku, penyihir bernama Circe. Jadi efeknya kelihatan banget, ya?"
      Speaker = "Melinoe"
      Event = "DionysusAboutCirce01"
    }
    {
      Id = "Dionysus_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudku, {#Emph}jelas banget! {#Prev}Circe, ya, aku kenal nama itu! Kelihatannya dia paham satu-dua trik menarik! Mungkin dia bakal dapet undangan ke pesta {#Emph}berikutnya!"
      Speaker = "Dionysus"
      Event = "DionysusAboutCirce01"
    }
    {
      Id = "Dionysus_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kamu kelihatan, {#Emph}ngh... {#Prev}kamu mengecil atau gimana, atau... aku yang tiba-tiba makin gede, atau... {#Emph}aduh{#Prev}, kepalaku..."
      Speaker = "Dionysus"
      Event = "DionysusAboutCirce01_B"
    }
    {
      Id = "MelinoeField_3074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, benar... sekadar pengingat soal tubuhku yang mengecil untuk sementara ini. Ini akibat sedikit sihir dari rekanku, sang penyihir Circe. Jadi efeknya kelihatan kentara sekali, ya?"
      Speaker = "Melinoe"
      Event = "DionysusAboutCirce01_B"
    }
    {
      Id = "Dionysus_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, coba lihat dirimu, Mel sayang, kamu {#Emph}gede banget! {#Prev}Aku {#Emph}suka! {#Prev}Dulu pernah kenal beberapa prajurit Amazon seukuranmu, mereka {#Emph}susah banget diatur{#Prev}, paham kan maksudku!"
      Speaker = "Dionysus"
      Event = "DionysusAboutCirce02"
    }
    {
      Id = "MelinoeField_4755"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku paham, ya, setelah kau berbaik hati mengingatkanku bahwa tubuhku membesar sementara ini. Ini memberiku keuntungan taktis malam ini."
      Speaker = "Melinoe"
      Event = "DionysusAboutCirce02"
    }
    {
      Id = "Dionysus_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku yakin seratus persen memang begitu! Dan kalau kawan-kawan Amazo-ku ada di sini, mereka pasti setuju banget. Terus mungkin mereka bakal ngajak kamu gulat."
      Speaker = "Dionysus"
      Event = "DionysusAboutCirce02"
    }
    {
      Id = "Dionysus_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aww{#Prev}, lihat deh betapa {#Emph}mungilnya {#Prev}kamu, manis! {#Emph}Ehem{#Prev}, kedengarannya agak kurang ajar ya, pas aku bilang {#Emph}manis {#Prev}kamu tahu kan maksudku bukan kayak {#Emph}gitu!"
      Speaker = "Dionysus"
      Event = "DionysusAboutCirce03"
    }
    {
      Id = "MelinoeField_4756"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak apa-apa kok. Aku tahu tubuh mungilku ini mungkin terlihat aneh. Semuanya bagian dari keuntungan taktis yang kudapatkan."
      Speaker = "Melinoe"
      Event = "DionysusAboutCirce03"
    }
    {
      Id = "Dionysus_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku suka semuanya dalam segala bentuk dan ukuran, nggak semuanya harus sama, semuanya {#Emph}berbeda! {#Prev}Kecil? Keren. Lebih gede? {#Emph}Mantap! {#Prev}Aku pencinta variasi!"
      Speaker = "Dionysus"
      Event = "DionysusAboutCirce03"
    }
    {
      Id = "MelinoeField_2902"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau sempat berpapasan dengan Prometheus? Berhubung Chronos tak berani menampakkan batang hidungnya di gunung ini, dia pasti mengutus anteknya ini untuk menyibukkan seisi Olympus."
      Speaker = "Melinoe"
      Event = "DionysusAboutPrometheus01"
    }
    {
      Id = "Dionysus_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Prometheus{#Prev}, dia {#Emph}balik lagi?! {#Prev}Wah, aku kudet nih. Kukira dia masih terikat di tebing gunung mana gitu, jeroannya lagi dikoyak-koyak burung Elang, atau siksaan mengerikan semacam itulah!"
      Speaker = "Dionysus"
      Event = "DionysusAboutPrometheus01"
    }
    {
      Id = "MelinoeField_2903"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu konon memang pernah terjadi. Tapi dia benar-benar sudah kembali, memimpin sendiri barisan terdepan untuk memporak-porandakan Olympus. Kalau dia menang... takkan ada pesta lagi."
      Speaker = "Melinoe"
      Event = "DionysusAboutPrometheus01"
    }
    {
      Id = "Dionysus_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hahahaha{#Prev}, ayolah, manis, nggak mungkin {#Emph}seburuk {#Prev}itu! Memangnya dia mau ngapain, masak makanan kita pakai api yang dia curi dari Ayah? Gini aja deh, lain kali kalau ketemu dia, ajak dia mampir ke sini!"
      Speaker = "Dionysus"
      Event = "DionysusAboutPrometheus01"
    }
    {
      Id = "MelinoeField_5278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau sempat berpapasan dengan sang Titan Prometheus? Chronos bersekongkol dengannya. Singkat cerita, dia membuat keributan yang cukup parah."
      Speaker = "Melinoe"
      Event = "DionysusAboutPrometheus01_B"
    }
    {
      Id = "MelinoeField_5279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu konon memang pernah terjadi, tapi dia benar-benar sudah kembali, memimpin sendiri barisan terdepan yang berusaha meruntuhkan Olympus. Dan dia masih berkeliaran di luar sana, menebar perpecahan."
      Speaker = "Melinoe"
      Event = "DionysusAboutPrometheus01_B"
    }
    {
      Id = "Dionysus_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kamu udah ngobrol sama Prometheus tua atas namaku belum? Pengennya sih aku samperin terus kuundang sendiri ke sini, tapi kan aku tuan rumahnya, {#Emph}heh! {#Prev}Nggak pantes dong kalau aku nyelonong pergi gitu aja, ya kan?"
      Speaker = "Dionysus"
      Event = "DionysusAboutPrometheus02"
    }
    {
      Id = "MelinoeField_2904"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari sekian banyak hal, justru itu yang kau ingat jelas. Kau benar-benar ingin aku mengajak salah satu musuh paling bebuyutan kita ke {#Emph}sini{#Prev}, ke perjamuan yang bahkan kerabat terdekatmu sendiri tak tahu?"
      Speaker = "Melinoe"
      Event = "DionysusAboutPrometheus02"
    }
    {
      Id = "Dionysus_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudku... {#Emph}iya dong, heh! {#Prev}Kita para dewa ini suka keras kepala dan sok gengsi, malah saling todong senjata padahal seharusnya saling ulur ranting zaitun perdamaian! Sekarang, buruan kasih tahu si kepala batu itu kalau kita udah nyiapin tempat buat dia!"
      Speaker = "Dionysus"
      Event = "DionysusAboutPrometheus02"
    }
    {
      Id = "MelinoeField_2905"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya konyol sekali, tapi aku tetap bertanya pada Prometheus atas namamu apakah dia mau menghadiri pesta ini. Dia sudah tahu apa yang akan kukatakan, tentu saja karena dia Titan Peramal. Dia tak merasakan niat jahat... dan justru karena itulah dia mengiranya jebakan licik."
      Speaker = "Melinoe"
      Event = "DionysusAboutPrometheus03"
    }
    {
      Id = "Dionysus_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan dia katanya salah satu yang paling bijak? Kenapa sih kalian semua jadi begitu {#Emph}sinis{#Prev}, manis? Nggak ada yang percaya sama siapa pun atau apa {#Emph}pun! {#Prev}Pantes aja di luar sana semuanya jadi kacau balau!"
      Speaker = "Dionysus"
      Event = "DionysusAboutPrometheus03"
    }
    {
      Id = "MelinoeField_2906"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau {#Emph}sadar {#Prev}situasinya sedang gawat! Kukira kau sama sekali tak peduli, menutup mata dan telinga dari apa pun yang enggan kau dengar."
      Speaker = "Melinoe"
      Event = "DionysusAboutPrometheus03"
    }
    {
      Id = "Dionysus_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tebakanmu separuh bener. Gini lho, aku nggak suka mencemaskan hal-hal yang nggak bisa kukendalikan! {#Emph}Anggur{#Prev}, bisa kukendalikan. Kualitas pesta ini, {#Emph}bisa {#Prev}kukendalikan! Tapi soal saling serang antar-keluarga? {#Emph}Heh. {#Prev}Udah banyak dewa lain yang ahlinya dalam urusan {#Emph}itu."
      Speaker = "Dionysus"
      Event = "DionysusAboutPrometheus03"
    }
    {
      Id = "MelinoeField_3682"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa Herakles yang perkasa pernah mampir ke sini? Tampaknya dia yang menanggung beban terberat di garis depan dan mungkin butuh istirahat... walau barangkali bisa merusak suasana pesta."
      Speaker = "Melinoe"
      Event = "DionysusAboutHeracles01"
    }
    {
      Id = "Dionysus_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh percaya deh, udah nggak terhitung {#Emph}berapa kali {#Prev}kuundang, tapi dia sama sekali nggak mau {#Emph}goyah{#Prev}, orang berotot gede kayak gitu ya wajarlah, kan? Kerjanya terobsesi melulu sama {#Emph}tugas-tugas berat{#Prev}, nggak mau santai sebentar pun! Tapi mungkin kalau kamu yang ngomong, dia bakal dengar..."
      Speaker = "Dionysus"
      Event = "DionysusAboutHeracles01"
    }
    {
      Id = "MelinoeField_3683"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, bergabung minum bersamamu dan berendam di pemandian air panas? Mana mungkin Herakles sudi mendengarkanku {#Emph}kalau {#Prev}kemampuan bujuk rayumu saja tak mempan?"
      Speaker = "Melinoe"
      Event = "DionysusAboutHeracles01"
    }
    {
      Id = "Dionysus_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Soalnya kamu itu {#Emph}cewek{#Prev}, manis! Suaramu manis, caramu memainkan rambut, terus gelagat {#Emph}aku-gadis-polos {#Prev}itu lho, beneran bikin siapa pun kepincut! Jadi, coba {#Emph}ajak {#Prev}dia, ya?"
      Speaker = "Dionysus"
      Event = "DionysusAboutHeracles01"
    }
    {
      Id = "Dionysus_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Herakles tua mutusin buat mampir lho, lihat kan dia ada di situ?! Udah kayak lembu raksasa tua aja! Nyebur gih ke pemandian bareng dia, ayolah, pengen lihat kamu nyoba! Kecuali kamu udah nyoba duluan terus aku kelewatan, {#Emph}aduh..."
      Speaker = "Dionysus"
      Event = "DionysusAboutHeracles02"
    }
    {
      Id = "MelinoeField_2976"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau tahu kenapa gunung ini terus berguncang tanpa henti, yang tentu saja sesekali membuat para tamu kehormatanmu ketakutan?"
      Speaker = "Melinoe"
      Event = "DionysusAboutTyphon01"
    }
    {
      Id = "Dionysus_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu dong! Kadang pestanya kelewat liar, paham kan maksudku, gara-gara dansanya heboh banget! Paman Poseidon bukan {#Emph}satu-satunya {#Prev}Pencipta Gempa di Olympus!"
      Speaker = "Dionysus"
      Event = "DionysusAboutTyphon01"
    }
    {
      Id = "MelinoeField_2977"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan itu. {#Emph}Typhon {#Prev}telah bangkit! Sang Bapak Segala Monster kini mengancam istana ayahmu sendiri. Kau mungkin bisa mengabaikan Chronos entah bagaimana caranya, baiklah. Prometheus juga, mungkin. Tapi bukan ancaman yang satu ini."
      Speaker = "Melinoe"
      Event = "DionysusAboutTyphon01"
    }
    {
      Id = "Dionysus_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh gawat! Typhon berkeliaran di luar sana, datang buat mengacaukan segalanya! Terus kita harus bagaimana?! Hahaha{#Prev}, lihat kan, Sayang? Nggak ada yang {#Emph}peduli! {#Prev}Terjadilah apa yang harus terjadi! Dan kita bakal berpesta sampai saat itu tiba, apa pun yang terjadi! Tapi boleh juga usahamu menakut-nakuti tadi."
      Speaker = "Dionysus"
      Event = "DionysusAboutTyphon01"
    }
    {
      Id = "Dionysus_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kamu nggak cerita apa-apa ke Apollo tentang apa yang terjadi di sini, kan? Soalnya aku, {#Emph}ehem{#Prev}, belum sempat mengirim undangan buat dia. Aku tahu dia lagi sibuk dan mau menyendiri!"
      Speaker = "Dionysus"
      Event = "DionysusAboutApollo01"
    }
    {
      Id = "MelinoeField_4757"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewa Apollo berbaik hati mendukungku dengan Berkahnya, tapi tidak, aku tidak memberitahunya ataupun kerabatmu yang lain tentang pestamu ini. Itu urusanmu, bukan urusanku."
      Speaker = "Melinoe"
      Event = "DionysusAboutApollo01"
    }
    {
      Id = "Dionysus_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh{#Prev}, syukurlah! Dia kan suka segala sesuatunya rapi jali dan bersih berkilau, tapi aku lebih suka yang berantakan begini! Tadi ada sesuatu darimu yang membuatku teringat padanya, tapi mungkin aku cuma lagi melantur saja!"
      Speaker = "Dionysus"
      Event = "DionysusAboutApollo01"
    }
    {
      Id = "Dionysus_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, jadi nimfa macam apa {#Emph}kamu ini? {#Prev}Eh tunggu, tunggu, tunggu dulu, Mel Sayang, aku kan kenal {#Emph}kamu{#Prev}, sudah berapa lama ya kita nggak ketemu?!"
      Speaker = "Dionysus"
      Event = "DionysusAboutTimePassing01"
    }
    {
      Id = "MelinoeField_4758"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti sudah berlalu sekian malam, sampai-sampai ingatanmu memudar begitu. Bagaimana kabarmu, beserta semua tamu-tamumu?"
      Speaker = "Melinoe"
      Event = "DionysusAboutTimePassing01"
    }
    {
      Id = "Dionysus_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kita di sini sesegar buah anggur, ya kan? Tiap malam itu serasa pengembaraan melintasi {#Emph}pikiran! {#Prev}Nih, coba renungkan salah satu dari {#Emph}ini!"
      Speaker = "Dionysus"
      Event = "DionysusAboutTimePassing01"
    }
    {
      Id = "Dionysus_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, sudah ada petunjuk buat mencarikan sekotak botol Ambrosia bermutu buat kita belum? Persediaan kita tinggal {#Emph}jatah darurat {#Prev}nih, lagi dihemat-hemat {#Emph}biar awet. {#Prev}Aku berusaha bikin semua orang tetap {#Emph}tenang!"
      Speaker = "Dionysus"
      Event = "DionysusAboutAmbrosia01"
    }
    {
      Id = "MelinoeField_4480"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku belum menemukan kotak seperti itu, dan aku tidak yakin bagaimana cara membedakan botol yang bagus dari yang biasa. Aku bahkan tidak tahu kalau Ambrosia bisa basi..."
      Speaker = "Melinoe"
      Event = "DionysusAboutAmbrosia01"
    }
    {
      Id = "Dionysus_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah kalau begitu, kuberi tahu rahasia kecil ya, Sayang...! Begitu aku ingat tadi mau ngomong apa... {#Emph}haha{#Prev}, gempa melulu akhir-akhir ini, sampai nggak bisa {#Emph}mikir! Ehem{#Prev}, kamu mau salah satu dari {#Emph}ini?"
      Speaker = "Dionysus"
      Event = "DionysusAboutAmbrosia01"
    }
    {
      Id = "Dionysus_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh hei! Akhirnya gunungnya berhenti berguncang sebentar dan aku ingat apa yang mau kuberi tahu padamu! {#Emph}Sekotak botol Ambrosia{#Prev}, itu artinya empat botol sekaligus. Istilah teknis, tahu!"
      Speaker = "Dionysus"
      Event = "DionysusAboutAmbrosia02"
    }
    {
      Id = "MelinoeField_4481"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi maksudmu kamu tidak cuma mau {#Emph}satu {#Prev}botol Ambrosia tapi {#Emph}empat{#Prev}, dan kamu tidak mau aku membawanya satu per satu..."
      Speaker = "Melinoe"
      Event = "DionysusAboutAmbrosia02"
    }
    {
      Id = "Dionysus_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, lihat dong sebanyak apa {#Emph}tamuku{#Prev}... satu botol saja mana cukup! Tapi sekarang kamu tahu apa yang kita butuhkan buat bertahan hidup. Aku mengandalkanmu ya, Mel Sayang!"
      Speaker = "Dionysus"
      Event = "DionysusAboutAmbrosia02"
    }
    {
      Id = "Dionysus_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, andai kamu lihat tadi, Sayang, Ambrosia yang kamu bawa itu benar-benar bikin suasana pecah luar {#Emph}biasa!"
      Speaker = "Dionysus"
      Event = "DionysusAboutAmbrosia03"
    }
    {
      Id = "MelinoeField_4485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa kubayangkan! Meski keadaannya tidak tampak berbeda dari sebelumnya. Apa kotaknya sudah kalian habiskan semua?"
      Speaker = "Melinoe"
      Event = "DionysusAboutAmbrosia03"
    }
    {
      Id = "Dionysus_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak! {#Prev}Maksudku... nggak juga sih! Ya maksudku, mungkin iya. Tapi aku dapat petunjuk soal cadangan raksasa yang melimpah ruah sampai kita nggak butuh sumbangan lagi. Dan buat {#Emph}kamu{#Prev}, ada sesuatu yang istimewa di {#Emph}sini."
      Speaker = "Dionysus"
      Event = "DionysusAboutAmbrosia03"
    }
    {
      Id = "MelinoeField_4486"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir seharusnya kamu sudah bisa keluar sekarang, karena ancaman terbesar yang dihadapi gunungmu sebagian besar sudah musnah. Ya, meski memang masih ada satir-satir ganas di luar sana."
      Speaker = "Melinoe"
      Event = "DionysusPostTrueEnding01"
    }
    {
      Id = "Dionysus_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, jangan sembarangan kalau bicara soal Satir, nggak keren tahu! Memangnya teman-teman Satirku di sini pernah ngomong jelek soal para dewa? Lagian apa maksudmu dengan {#Emph}ancaman terbesar?"
      Speaker = "Dionysus"
      Event = "DionysusPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4487"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon, Bapa Segala Monster; Chronos, Titan Pengendali Waktu; yang pertama dihancurkan sepenuhnya, yang kedua telah ditundukkan. Perangnya sudah {#Emph}usai! {#Prev}Olimpus sudah aman!"
      Speaker = "Melinoe"
      Event = "DionysusPostTrueEnding01"
    }
    {
      Id = "Dionysus_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perangnya sudah {#Emph}usai?! {#Prev}Dengar itu semuanya, perangnya sudah {#Emph}usai! {#Prev}Kalau itu bukan alasan buat pesta pora, aku nggak tahu lagi deh apa alasannya, jadi ayo angkat {#Emph}minumanmu{#Prev}, ayo {#Emph}berendam{#Prev}, goyang {#Emph}pinggulmu{#Prev}, kalian tahu kan maksudku, {#Emph}asikan!"
      Speaker = "Dionysus"
      Event = "DionysusPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu tidak akan pergi dari sini, kan?"
      Speaker = "Melinoe"
      Event = "DionysusPostTrueEnding01"
    }
    {
      Id = "Dionysus_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak bakal, Sayang!"
      Speaker = "Dionysus"
      Event = "DionysusPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4489"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dionysus, tidak bisakah setidaknya kamu memberi kabar kepada keluargamu bahwa kamu baik-baik saja? Pasti ada di antara mereka yang mencemaskanmu."
      Speaker = "Melinoe"
      Event = "DionysusPostTrueEnding02"
    }
    {
      Id = "Dionysus_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti bakal kukabari suatu malam nanti kok, Sayang, tapi sekarang kita masih merayakan keberhasilanmu, {#Emph}kamu memenangkan perangnya!"
      Speaker = "Dionysus"
      Event = "DionysusPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4490"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan aku sendiri yang memenangkan perang itu. Kami berdiri bersama sebagai keluarga dan menang. Aku hanya melakukan bagianku."
      Speaker = "Melinoe"
      Event = "DionysusPostTrueEnding02"
    }
    {
      Id = "Dionysus_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku lagi melakukan bagian{#Emph}ku {#Prev}sekarang! Yang lain juga tahu aku bakal baik-baik saja kok, aku cuma butuh sedikit ketenangan setelah semua keributan itu... ketenangan bersama semua tamu yang {#Emph}luar biasa ini!"
      Speaker = "Dionysus"
      Event = "DionysusPostTrueEnding02"
    }
    {
      Id = "Dionysus_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, tunggu, tunggu dulu, kalau kamu nggak lagi bercanda soal perang yang sudah selesai itu, terus kenapa kamu terus-terusan datang ke sini meminta Berkah tempur dariku?"
      Speaker = "Dionysus"
      Event = "DionysusPostTrueEnding03"
    }
    {
      Id = "MelinoeField_4491"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Cukup kukatakan bahwa masih ada pertempuran yang harus dimenangkan. Tapi aku tak perlu menceritakan rinciannya, demi kewarasanmu dan kewarasanku juga."
      Speaker = "Melinoe"
      Event = "DionysusPostTrueEnding03"
    }
    {
      Id = "Dionysus_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah syukurlah, kewarasanku memang tinggal sedikit! Kelihatannya kamu bakal sering mampir ke sini, kamu kan punya jalur khusus, jadi datang saja kapan pun kamu mau!"
      Speaker = "Dionysus"
      Event = "DionysusPostTrueEnding03"
    }
    {
      Id = "Dionysus_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku dengar cerita-cerita liar dari luar, ada yang benar nggak sih, Sayang? Katanya ada soal {#Emph}lahirnya zaman baru?"
      Speaker = "Dionysus"
      Event = "DionysusPostEpilogue01"
    }
    {
      Id = "MelinoeField_4493"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nubuat terbaru dari Tiga Fates. Mereka meramalkan masa depan yang jauh ketika manusia fana tidak lagi terikat pada para dewa... mungkin itu baru alasan untuk pesta yang sesungguhnya."
      Speaker = "Melinoe"
      Event = "DionysusPostEpilogue01"
    }
    {
      Id = "Dionysus_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kamu {#Prev}pikir mungkin semua dewa lainnya bakal ikut berpesta di {#Emph}sini! {#Prev}Dengan begitu kita punya kegiatan yang lebih asyik daripada mengatur-atur umat manusia. Dan itu bakal jadi {#Emph}nubuat yang terwujud!"
      Speaker = "Dionysus"
      Event = "DionysusPostEpilogue01"
    }
    {
      Id = "Dionysus_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mel Sayang, hubungan kita sudah lewat dari tahap basa-basi biasa, jadi kita harus melangkah ke tingkat berikutnya: {#Emph}basa-basi super singkat!"
      Speaker = "Dionysus"
      Event = "DionysusAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_4494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan apa persisnya perbedaan antara basa-basi biasa dan basa-basi super singkat? Suara kita harus dipelankan?"
      Speaker = "Melinoe"
      Event = "DionysusAboutSayingLittle01"
    }
    {
      Id = "Dionysus_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan lebih mantap lagi, kita nyaris nggak bicara sama sekali! Ikatan di antara kita sudah mewakili segalanya kok! Ini {#Emph}keren banget{#Prev}, coba deh, siap? {#Emph}Mulai!"
      Speaker = "Dionysus"
      Event = "DionysusAboutSayingLittle01"
    }
    {
      Id = "Dionysus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di luar sana emang lagi banyak ribut-ribut, tapi cuma tempat ini yang paling asyik di gunung {#Emph}ini{#Prev}, Manis."
      Speaker = "Dionysus"
      Event = "DionysusChat01"
    }
    {
      Id = "Dionysus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu teguk doang nggak bakal bikin celaka! Malah bakal bikin {#Emph}segar{#Prev}, buktikan sendiri deh!"
      Speaker = "Dionysus"
      Event = "DionysusChat02"
    }
    {
      Id = "Dionysus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak bisa nongkrong lama-lama, ya? Ada urusan dan orang yang mesti ditemui, paham banget aku, Manis!"
      Speaker = "Dionysus"
      Event = "DionysusChat03"
    }
    {
      Id = "Dionysus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya malammu berat banget! Dan tahu nggak? Malamku juga {#Emph}sama!{#Prev}"
      Speaker = "Dionysus"
      Event = "DionysusChat04"
    }
    {
      Id = "Dionysus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pesta kami udah jalan dari tadi, Manis, dan kami berniat {#Emph}terus{#Prev} lanjut sampai semua kekacauan ini kelar!"
      Speaker = "Dionysus"
      Event = "DionysusChat05"
    }
    {
      Id = "Dionysus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo dong, santai dulu, minum segelas, {#Emph}baur{#Prev} dikit. Ini namanya {#Emph}pesta pora{#Prev}, tahu!"
      Speaker = "Dionysus"
      Event = "DionysusChat06"
    }
    {
      Id = "Dionysus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingat ya, jangan bocorkan soal kumpul-kumpul kecil kita ini ke Ayah, oke?"
      Speaker = "Dionysus"
      Event = "DionysusChat07"
    }
    {
      Id = "Dionysus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pintu kami selalu terbuka buatmu, tapi tidak untuk beban pikiranmu, Manis. Tinggalkan saja semua itu di luar!"
      Speaker = "Dionysus"
      Event = "DionysusChat08"
    }
    {
      Id = "Dionysus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, segarkan dirimu, Manis! Kita baru aja mulai, lho!"
      Speaker = "Dionysus"
      Event = "DionysusChat09"
    }
    {
      Id = "Dionysus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yakin nggak mau berendam sebentar di pemandian air panas? Dijamin langsung hangat dan segar!"
      Speaker = "Dionysus"
      Event = "DionysusChat10"
    }
    {
      Id = "Dionysus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunung ini nggak bakal lari ke mana-mana, begitu juga kami!"
      Speaker = "Dionysus"
      Event = "DionysusChat11"
    }
    {
      Id = "Dionysus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Udah jauh-jauh sampai sini tapi nggak sempat nongkrong? Ah, nggak asyik banget, Manis!"
      Speaker = "Dionysus"
      Event = "DionysusChat12"
    }
    {
      Id = "Dionysus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kamu muak dengan semua pertarungan itu, aku punya penawar yang {#Emph}paling pas{#Prev} buatmu!"
      Speaker = "Dionysus"
      Event = "DionysusChat13"
    }
    {
      Id = "Dionysus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Airnya hangat dan nikmat banget, tapi kalau kamu lagi nggak mau berendam, santai aja!"
      Speaker = "Dionysus"
      Event = "DionysusChat14"
    }
    {
      Id = "Dionysus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadinya mau nitip salam 'tos' buat keluarga besar, tapi kayaknya bakal rada canggung ya?"
      Speaker = "Dionysus"
      Event = "DionysusChat15"
    }
    {
      Id = "Dionysus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tinggalkan semua kekhawatiranmu di depan gerbang dan nikmati segelas minuman, {#Emph}nih!{#Prev}"
      Speaker = "Dionysus"
      Event = "DionysusChat16"
    }
    {
      Id = "Dionysus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketahuilah kami semua mendukungmu {#Emph}sepenuhnya{#Prev}, jadi mari bersulang untuk keberhasilanmu!"
      Speaker = "Dionysus"
      Event = "DionysusChat17"
    }
    {
      Id = "Dionysus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengarkan kataku: {#Emph}nggak pernah ada{#Prev} waktu yang salah untuk pesta yang meriah!"
      Speaker = "Dionysus"
      Event = "DionysusChat18"
    }
    {
      Id = "Dionysus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, tunggu, bukannya barusan kamu ke sini? Waduh, kepalaku agak berkabut nih!"
      Speaker = "Dionysus"
      Event = "DionysusChat19"
    }
    {
      Id = "Dionysus_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak ada gunanya melawan takdir kalau tenggorokanmu lagi kering kerontang, iya kan?"
      Speaker = "Dionysus"
      Event = "DionysusChat20"
    }
    {
      Id = "Dionysus_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lepaskan bebanmu, rileks, minum-minum santai! Malam masih panjang!"
      Speaker = "Dionysus"
      Event = "DionysusChat21"
    }
    {
      Id = "Dionysus_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo, jangan cuma berdiri di situ! Makan! Minum! Nikmati apa pun sesukamu!"
      Speaker = "Dionysus"
      Event = "DionysusChat22"
    }
    {
      Id = "Dionysus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rembulan bersinar terang, airnya hangat, Nektar mengalir deras, kurang nikmat apa lagi coba?"
      Speaker = "Dionysus"
      Event = "DionysusChat23"
    }
    {
      Id = "Dionysus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu bolak-balik mampir tapi nggak pernah mau singgah lama, jangan bikin kami {#Emph}penasaran{#Prev} terus dong, Manis!"
      Speaker = "Dionysus"
      Event = "DionysusChat24"
    }
    {
      Id = "Dionysus_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, Mel manis, mukamu murung begitu bikin suasana pesta jadi agak suram nih, ngerti kan maksudku?"
      Speaker = "Dionysus"
      Event = "DionysusChat25"
    }
    {
      Id = "Dionysus_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kamu melewatkan pesta yang {#Emph}seru banget{#Prev} semalam... atau mungkin kemarin malam ya..."
      Speaker = "Dionysus"
      Event = "DionysusChat26"
    }
    {
      Id = "Dionysus_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya! Ini dia adiknya si sobat Zag, ayo kita sambut dia dengan hangat!"
      Speaker = "Dionysus"
      Event = "DionysusChat27"
    }
    {
      Id = "Dionysus_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kamu melewatkan keseruan tadi, Manis, tapi tenang aja, bakal selalu ada pesta seru lainnya!"
      Speaker = "Dionysus"
      Event = "DionysusChat28"
    }
    {
      Id = "Dionysus_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Santai aja, Mel manis, semua orang lagi asyik sendiri-sendiri, jadi mari kita nikmati bagian kita, ya?"
      Speaker = "Dionysus"
      Event = "DionysusChat29"
    }
    {
      Id = "Dionysus_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kayaknya aku punya salah satu barang favoritmu di suatu tempat, mungkin yang ini?"
      Speaker = "Dionysus"
      Event = "DionysusChat30"
    }
    {
      Id = "Dionysus_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu pasti mau tampil maksimal di luar sana, jadi tarik napas dulu dan isi ulang energimu, oke?"
      Speaker = "Dionysus"
      Event = "DionysusChat31"
    }
    {
      Id = "Dionysus_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu aku bisa memberimu Berkah dan semacamnya, tapi bilang aja kalau kamu butuh dipijat!"
      Speaker = "Dionysus"
      Event = "DionysusChat32"
    }
    {
      Id = "Dionysus_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukannya barusan kamu ke sini, Manis, atau kitanya yang udah berpesta semalaman suntuk?"
      Speaker = "Dionysus"
      Event = "DionysusChat33"
    }
    {
      Id = "Dionysus_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingat ya, jangan sampai ada yang tahu kalau kami ada di sini, mereka nggak bakal paham!"
      Speaker = "Dionysus"
      Event = "DionysusChat34"
    }
    {
      Id = "Dionysus_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kasih tahu aku ya kalau kamu butuh sesuatu selain suguhan yang biasanya, oke?"
      Speaker = "Dionysus"
      Event = "DionysusChat35"
    }
    {
      Id = "Dionysus_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi ngidam apa pun, kayaknya kita punya deh di sekitaran sini!"
      Speaker = "Dionysus"
      Event = "DionysusChat36"
    }
    {
      Id = "Dionysus_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan langsung noleh, tapi salah satu Satir di sana kayaknya naksir berat sama kamu tuh!"
      Speaker = "Dionysus"
      Event = "DionysusChat37"
    }
    {
      Id = "Dionysus_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keren banget kamu mampir ke pesta eksklusif kita di sini, selalu menyenangkan, Sayang!"
      Speaker = "Dionysus"
      Event = "DionysusChat38"
    }
    {
      Id = "Dionysus_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat para Nimfa dan Satir di sana? Hei, bisa kukenalkan kalau kamu mau!"
      Speaker = "Dionysus"
      Event = "DionysusChat39"
    }
    {
      Id = "Dionysus_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Woa-hoho{#Prev}, entah aku kebanyakan minum barusan... atau malah kurang banyak!"
      Speaker = "Dionysus"
      Event = "DionysusChat40"
    }
    {
      Id = "MelinoeField_2395"
      InheritFrom = "BaseNarrative"
      DisplayName = "A... aku tak ingin jadi tamu yang tak tahu terima kasih. Aku tahu kalian punya tradisi di sini, dan aku sudah mempelajarinya. Jadi, terimalah! Demi semua keceriaan dan kemurahan hatimu!"
      Speaker = "Melinoe"
      Event = "DionysusGift01"
    }
    {
      Id = "Dionysus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Woa, ini Nektar, asli pula! Kita butuh banget tiap tetesnya! Nah, ini imbalan buat tamu paling terhormatku, dan sudah kuputuskan, {#Emph}kamulah orangnya!"
      Speaker = "Dionysus"
      Event = "DionysusGift01"
    }
    {
      Id = "Dionysus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, {#Emph}mantap{#Prev}, makin banyak Nektar makin bagus buat jaga-jaga kalau anggur kita habis—bukan berarti bakal habis juga sih! Nah, sekarang kita mau bersulang untuk apa lagi, nih?"
      Speaker = "Dionysus"
      Event = "DionysusGift02"
    }
    {
      Id = "MelinoeField_2397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk lolos dari bahaya tanpa terluka? Atau terserah apa pun maumu. Aku tahu menjaga moral tetap tinggi itu sangat penting, apalagi saat gunung ini sedang dikepung."
      Speaker = "Melinoe"
      Event = "DionysusGift02"
    }
    {
      Id = "MelinoeField_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersulang."
      Speaker = "Melinoe"
      Event = "DionysusGift02"
    }
    {
      Id = "Dionysus_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, tentu saja, sini Nektarnya kubawa! Karena di sinilah {#Emph}tempat paling pas{#Prev} buat memanfaatkannya dengan benar. Tapi jangan pasang muka sedih dan melow gitu dong, kamu lagi di {#Emph}pesta pora{#Prev}, bukan di rumah duka!"
      Speaker = "Dionysus"
      Event = "DionysusGift03"
    }
    {
      Id = "MelinoeField_2913"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, aku tak bisa mengesampingkan rasa takut dan kekhawatiran sepertimu, Dionisos. Tak heran bangsa fana sering mempersembahkan sesaji atas namamu... seperti yang kulakukan sekarang."
      Speaker = "Melinoe"
      Event = "DionysusGift03"
    }
    {
      Id = "Dionysus_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, gitu dong, berbagi kebaikan pada sesama, aku {#Emph}suka{#Prev} gayamu! Lagian, kamu tahu sendiri kan kalau aku nggak bisa bikin pesta dan keseruan buat semua orang sendirian? Tapi rahasia kita berdua ya, aku masih bisa bikin {#Emph}banyaaak{#Prev} banget pesta kok."
      Speaker = "Dionysus"
      Event = "DionysusGift04"
    }
    {
      Id = "MelinoeField_2914"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keceriaan dan pesta yang kau ciptakan seakan muncul begitu saja dari udara hampa... terlebih di masa-masa seperti ini. Yah, jika ini memang pesta tanpa akhir, kau bakal butuh banyak persediaan!"
      Speaker = "Melinoe"
      Event = "DionysusGift04"
    }
    {
      Id = "Dionysus_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, ini {#Emph}mantap{#Prev}, kita nggak narik tiket masuk atau apa pun kok, tapi saweran selalu diterima karena stok Nektar kita sudah {#Emph}menipis parah.{#Prev} Masih ada sisa lagi nggak?"
      Speaker = "Dionysus"
      Event = "DionysusGift05"
    }
    {
      Id = "MelinoeField_4477"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}umm{#Prev}, menurutku kalian semua sudah minum cukup banyak untuk saat ini. Tapi kalau aku punya sisa lebih... kubawakan lagi nanti."
      Speaker = "Melinoe"
      Event = "DionysusGift05"
    }
    {
      Id = "Dionysus_0233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harus ya, {#Emph}hahahaha!"
      Speaker = "Dionysus"
      Event = "DionysusGift05"
    }
    {
      Id = "Dionysus_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sip, ini pas banget dengan yang kita butuhkan, dan mestinya bakal cukup sampai... yaa, besok malam lah paling nggak? Terima kasih banyak ya, Mel Sayang! Boleh tahu nggak, pemasokmu siapa sih?"
      Speaker = "Dionysus"
      Event = "DionysusGift06"
    }
    {
      Id = "MelinoeField_4478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak punya sumber Nektar tetap yang bisa diandalkan; aku kenal seorang Makelar yang biasanya punya stok, dan di waktu lain aku cuma nemu sebotol di sana-sini. Memangnya sesulit itu mencarinya sekarang?"
      Speaker = "Melinoe"
      Event = "DionysusGift06"
    }
    {
      Id = "Dionysus_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, barang ginian biasanya nggak susah-susah amat didapat, cuma konsumsi kita aja yang kelewat gila-gilaan! Dan sekarang para tamuku makin rewel minta Ambrosia. Kebetulan punya sekotak nggak?"
      Speaker = "Dionysus"
      Event = "DionysusGift06"
    }
    {
      Id = "MelinoeField_4479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekotak? Maksudmu sebotol."
      Speaker = "Melinoe"
      Event = "DionysusGift06"
    }
    {
      Id = "Dionysus_0236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sekotak{#Prev} penuh botol! Botol-botol yang {#Emph}bagus!"
      Speaker = "Dionysus"
      Event = "DionysusGift06"
    }
    {
      Id = "MelinoeField_4482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini dia pesananmu, Dionisos! Sekotak penuh botol Ambrosia bermutu. Semoga ini bisa menjaga pesta tamumu tetap meriah untuk waktu yang cukup lama... setidaknya sampai aku sempat mampir lagi ke mari..."
      Speaker = "Melinoe"
      Event = "DionysusGift07"
    }
    {
      Id = "Dionysus_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mel, {#Emph}Sayang{#Prev}, rasanya pengin {#Emph}kucium{#Prev} deh, kamu beneran bawa semua ini buat {#Emph}kami?!{#Prev} Ini pas banget dengan yang kami butuhkan, maksudku... kok kamu bisa {#Emph}tahu?{#Prev} Kamu bisa baca pikiran ya?"
      Speaker = "Dionysus"
      Event = "DionysusGift07"
    }
    {
      Id = "MelinoeField_4483"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sebelumnya kau sendiri yang bertanya apakah aku punya akses ke Ambrosia, tapi... sebagian besar waktu aku belum bisa membaca pikiran orang lain. Itu keahlian tingkat sangat tinggi."
      Speaker = "Melinoe"
      Event = "DionysusGift07"
    }
    {
      Id = "Dionysus_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah yang {#Emph}bener, {#Prev}kamu pasti bisa baca semua yang ada di kepalaku {#Emph}sekarang!{#Prev} Dan isinya sebagian besar cuma rasa terima kasih. Awalnya kukira kamu orangnya kaku, tapi ternyata asyik juga!"
      Speaker = "Dionysus"
      Event = "DionysusGift07"
    }
    {
      Id = "MelinoeField_4484"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pujian itu sangat berarti jika datang darimu."
      Speaker = "Melinoe"
      Event = "DionysusGift07"
    }
    {
      Id = "Dionysus_0243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Hah, gimana?"
      Speaker = "Dionysus"
      Event = "DionysusGift07"
    }
    {
      Id = "MelinoeField_2396"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sangat berterima kasih... dan andai saja aku bisa berlama-lama di pesta ini."
      Speaker = "Melinoe"
      Event = "NPC_Dionysus_01.GiftGivenVoiceLines"
    }
    {
      Id = "Dionysus_0061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo dong!"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ah, udahlah."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hampir tumpah nih!"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, santai."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0065"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bawa {#Emph}santai aja!"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pelan-pelan saja."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Yoi{#Prev}, lepasin aja!"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Santai aja keles."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Eits, jangan gitu dong!"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waduh, santai dulu, Sayang."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa agak selow sedikit?"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Perlu kami seret kamu keluar?"
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak asyik banget, deh."
      Speaker = "Dionysus"
      Event = "NPC_Dionysus_01.OnHitVoiceLines"
    }
    {
      Id = "Dionysus_0044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wuidih...!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wah-hoo...!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0046"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, {#Emph}halo di sana."
      Speaker = "Dionysus"
