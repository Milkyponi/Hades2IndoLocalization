    }
    {
      Id = "Dionysus_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heei!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0050"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heei."
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, Mel, hei!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0052"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hah?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa? {#Emph}Oh!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0054"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat semuanya!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu berhasil sampai!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, anggap rumah sendiri!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Balik lagi buat nambah, nih!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, si cakep."
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat siapa yang datang!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada kabar apa, nih?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGreetingLines"
    }
    {
      Id = "Dionysus_0032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hahaha, mantap! {#Prev}Ayo semuanya, kita tambah satu putaran lagi!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Jadi aku ingin bersulang {#Emph}sekali lagi{#Prev}. Untuk kalian semua! {#Emph}Tos!!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Jadi aku ingin bersulang {#Emph}sekali lagi{#Prev}? Untuk pesta pora ini! {#Emph}Tos!!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0035"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo kawan-kawanku, minumlah sepuasnya, seolah tak ada hari esok!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0036"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...satu putaran lagi, katamu? Yah, kenapa enggak! {#Emph}Ah, haha!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0037"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan ada yang khawatir soal apa pun, semuanya aman terkendali!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0038"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Suka sama minumannya, kan? Tenang, masih banyak stoknya, tinggal bilang aja ke aku!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keren banget gayamu, Sobat! Ya kan, airnya pas banget! Gimana minumannya, udah butuh nambah lagi belum?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0040"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh pasti tahu lah, Sobat! Di sinilah tempat keseruan yang {#Emph}sebenarnya {#Prev}di gunung ini!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Minum! Minum! Minum! Minum! Minum! Minum! Minum! {#Emph}Hehe, mantap!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi tahu nggak apa kataku? Kubilang, Yah... {#Emph}hah. {#Prev}Kubilang, Yah, bagaimana kalau aku memang tidak mau? Dan beliau bilang, {#Emph}Kalau begitu enyah dari pandanganku! {#Prev}Jadi kujawab, {#Emph}Enyah dari pandangan? Beres! Hahahaha!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi kubilang, apa kita nggak bisa undang dia ke pesta lalu selesaikan masalah sambil minum anggur bareng, ya kan? Dan {#Emph}mereka {#Prev}semua menatap{#Emph}ku {#Prev}seolah aku gila beneran, {#Emph}hahaha, hahahaha."
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0213"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, ayolah, {#Emph}jangan {#Prev}bicara soal begituan di sini, ayo santai {#Emph}aja! {#Prev}Nggak usah murung gara-gara hal kayak gitu!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pernah kuceritakan belum soal perjalananku ke timur, melintasi lautan? Ada pulau yang luar biasa di sana, orang-orangnya ramah pula. Kamu pernah jalan-jalan ke tempat lain belum?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0215"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berapa kali harus kubilang, jangan bahas soal ibu kita, kita ini lagi kumpul di tongkrongan terhormat! Itu topik yang {#Emph}terlarang {#Prev}untuk jenis pesta yang berbeda, tahu sendiri kan?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maksudku, {#Emph}seriusan deh{#Prev}, apa yang harus ditakuti dari para Titan, apa mereka mau mencabik-cabik tubuhku sampai hancur? Yah, aku kan nggak bisa mati, tinggal susun lagi tubuhku... lalu minum secangkir lagi!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hahahahaha, nakal banget{#Prev}, sekarang tolong diam semuanya, kurasa itu dia lagi, tunjukkan sikap terbaik kalian ya?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah{#Prev}, kamu ngomong apa sih, dia melakukan {#Emph}apa? {#Prev}Pasti lagi ngerjain aku, nggak percaya sepatah kata pun, {#Emph}hahaha!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudahlah, ayolah, aku bahkan nggak {#Emph}mau {#Prev}tahu apa yang terjadi di luar sana. Yang beneran {#Emph}lagi seru {#Prev}itu di sini!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayolah, kakimu harus tetap di dalam kolam, ya kan? Atau terpaksa aku harus nyebur dan menyeretmu keluar!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0295"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, ayolah, nggak asyik banget! Tapi kamu tahu apa yang {#Emph}asyik? Haha{#Prev}, kurasa kamu tahu, {#Emph}hahaha!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0296"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fiuh{#Prev}, mulai terasa gerah nih di sini! Atau mungkin gara-gara kalian para Nimfa di pojokan sana, ya? Oh, aku {#Emph}bisa melihat {#Prev}kalian!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei tunggu, sepertinya aku dengar ada yang masuk. Hei, {#Emph}ehm, halo?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0298"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Whoa, {#Emph}santai {#Prev}dulu, jangan digigit, Maena! Sudah kubilang berkali-kali itu {#Emph}Satir! Bukan {#Prev}kambing!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Suhu airnya pas buat kalian semua, semuanya sudah beres? Mau minum lagi nggak, makanannya masih aman kan...?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0218"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi kubilang, apa kita nggak bisa langsung, tunggu... cerita ini sudah pernah kubilang belum ya? Kasih tahu kalau sudah ya? Atau kalau kamu nggak ingat, nggak masalah! Aku juga lupa, {#Emph}haha. {#Prev}Tadi kita lagi bahas apa ya?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusFeastingLines"
    }
    {
      Id = "Dionysus_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa itu yang kamu pegang?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGatherReactionVoiceLines"
    }
    {
      Id = "Dionysus_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Simpan saja, itu milikmu!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGatherReactionVoiceLines"
    }
    {
      Id = "Dionysus_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semuanya {#Prev}kebagian hadiah!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGatherReactionVoiceLines"
    }
    {
      Id = "Dionysus_0138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pegang baik-baik itu!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGatherReactionVoiceLines"
    }
    {
      Id = "Dionysus_0142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keren banget!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusGatherReactionVoiceLines"
    }
    {
      Id = "Dionysus_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa yang satu itu memang nggak dapat undangan resmi sih..."
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusExorcismReactionVoiceLines"
    }
    {
      Id = "Dionysus_0208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, itu kan pendukung {#Emph}setia-ku!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusExorcismReactionVoiceLines"
    }
    {
      Id = "Dionysus_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cari pengikut setiamu sendiri sana!"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusExorcismReactionVoiceLines"
    }
    {
      Id = "Dionysus_0211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Iuh{#Prev}, lagi pula yang tadi itu agak kaku banget..."
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusExorcismReactionVoiceLines"
    }
    {
      Id = "Dionysus_0212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan ganggu tamu-tamuku, paham?"
      Speaker = "Dionysus"
      Event = "GlobalVoiceLines.DionysusExorcismReactionVoiceLines"
    }
  ]
