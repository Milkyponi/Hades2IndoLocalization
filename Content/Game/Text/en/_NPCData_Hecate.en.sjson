    {
      Id = "Hecate_0399"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pandanglah baik-baik perlindungan di sekeliling tempat ini,"
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2579"
