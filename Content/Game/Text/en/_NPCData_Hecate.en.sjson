      Event = "NPC_Hecate_01.InteractVoiceLines"
    }
    {
      Id = "Hecate_0192_01"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Di atas kawah ini, demi kehendak Sang Malam,"
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Di atas kawah ini, demi kehendak Sang Malam,"
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0192_02"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dengarkan aku, Arwah orang-orang mati, pasang telinga kalian baik-baik,"
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2466"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dengarkan aku, Arwah orang-orang mati, pasang telinga kalian baik-baik,"
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0192_03"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kekuatan kalian kini dibutuhkan tuk bergabung dalam pertempuran kita,"
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kekuatan kalian kini dibutuhkan tuk bergabung dalam pertempuran kita,"
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0192_04"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Di atas Olimpus dan di kedalaman neraka."
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Di atas Olimpus dan di kedalaman neraka."
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0192_05"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Di dalam Persimpangan ini kalian aman bersama kami,"
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Di dalam Persimpangan ini kalian aman bersama kami,"
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0192_06"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Namun kami meminta pengabdian kalian demi perjuangan kita."
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
