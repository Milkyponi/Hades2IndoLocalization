    }
    {
      Id = "Hecate_0466"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga bayang-bayang menyelubungimu."
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.InteractVoiceLines"
    }
    {
      Id = "Hecate_0467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita semua."
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.InteractVoiceLines"
    }
    {
      Id = "Hecate_0468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan semoga bayang-bayang menyelubungi kita."
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.InteractVoiceLines"
    }
    {
      Id = "Hecate_0469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan dirimu juga, Melinoë."
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.InteractVoiceLines"
    }
    {
      Id = "Hecate_0867"
      InheritFrom = "BaseSubtitle"
