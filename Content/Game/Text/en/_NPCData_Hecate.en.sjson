    }
    {
      Id = "Hecate_0192_07"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kehendak kalian milik kalian sendiri, pilihan terbentang di hadapan kalian:"
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kehendak kalian milik kalian sendiri, pilihan terbentang di hadapan kalian:"
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0192_08"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bersama-sama, mari kita bangkit melampaui segala kelemahan kita."
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
