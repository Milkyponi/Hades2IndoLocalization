    }
    {
      Id = "Hecate_0400"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Yang menjaga kita tersembunyi dalam rengkuhan Malam dewi."
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2580"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Yang menjaga kita tersembunyi dalam rengkuhan Malam dewi."
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0401"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pastikan semuanya utuh, kekuatannya teguh tak tergoyahkan,"
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2581"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pastikan semuanya utuh, kekuatannya teguh tak tergoyahkan,"
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Selagi kita bertahan menghadapi musuh bersama kita sekalian;"
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2582"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Selagi kita bertahan menghadapi musuh bersama kita sekalian;"
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0403"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Demi merengkuh kejayaan, kita wajib bertahan melampaui"
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2583"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Demi merengkuh kejayaan, kita wajib bertahan melampaui"
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Segala petaka yang bakal ditimpakan oleh sang Waktu ini."
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2584"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Segala petaka yang bakal ditimpakan oleh sang Waktu ini."
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga terwujud seturut kehendak."
      Speaker = "Hecate"
      Event = "NPC_Hecate_01.CauldronWitchcraftVoiceLines"
    }
    {
      Id = "Melinoe_2585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga terwujud seturut kehendak."
      Speaker = "Melinoe"
      Event = "PlayedThreadedFunctionArgs.VoiceLines"
    }
    {
      Id = "Hecate_0725"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Waktu memaksa langkah kita, Melinoë. Tak ada satu jiwa pun yang mengira kau sanggup menghabisi musuh kita tadi malam, apalagi tepat di malam bulan mati!"
      Speaker = "Hecate"
      Event = "HecateFirstMeeting"
    }
    {
      Id = "Melinoe_2906_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa memaafkan kegagalanku begitu saja, Kepala Sekolah Hecate. Sang Titan masih hidup, Olimpus masih membara, sementara aku malah terlempar kembali ke titik awal!"
      Speaker = "Melinoe"
      Event = "HecateFirstMeeting"
    }
    {
      Id = "Hecate_0726"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar; ragamu telah pulih meski jiwamu belum sepenuhnya, dan kau menjadi makin bijak karenanya. Kau belum gagal... ini baru permulaan! Semua ini bagian dari tugas. {#Emph}Kematian bagi Chronos."
      Speaker = "Hecate"
      Event = "HecateFirstMeeting"
    }
    {
      Id = "Melinoe_0014_V3"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kematian bagi Chronos."
      Speaker = "Melinoe"
      Event = "HecateFirstMeeting"
    }
    {
      Id = "Hecate_0621"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali, kawah ini masih kotor. Tapi ada sesuatu di Altar kita yang bisa kau gunakan, dan aku juga sudah membuka segel Kolam Perak."
      Speaker = "Hecate"
      Event = "HecateFirstMeetingCont1"
    }
    {
      Id = "Hecate_0622"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami menanti kepulanganmu dengan selamat. Semoga cahaya bulan memandu langkahmu."
      Speaker = "Hecate"
      Event = "HecateFirstMeetingCont2"
    }
    {
      Id = "Hecate_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Upaya pertama yang sangat berharga, Melinoë. Kuyakin kau bisa melangkah lebih jauh andai aku tak menghalangi jalanmu. Yang ternyata gagal total kuhalau, kuakui itu."
      Speaker = "Hecate"
      Event = "HecateFirstMeeting_B"
    }
    {
      Id = "Melinoe_1802"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Guru harus memastikan aku benar-benar siap. Dan aku tahu masih banyak hal yang harus kubuktikan."
      Speaker = "Melinoe"
      Event = "HecateFirstMeeting_B"
    }
    {
      Id = "Hecate_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Percayalah pada naluri serta ilmu sihirmu, dan lanjutkan tugas ini. {#Emph}Kematian bagi Chronos."
      Speaker = "Hecate"
      Event = "HecateFirstMeeting_B"
    }
    {
      Id = "Hecate_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang merisaukanmu, Melinoë? Kerutan di dahimu bukan tanda kegigihan, melainkan keraguan... satu-satunya emosi yang tak boleh kita biarkan ada."
      Speaker = "Hecate"
      Event = "HecateAboutTask01"
    }
    {
      Id = "Melinoe_0582"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ungh{#Prev}, Ibu Guru, hanya saja... aku kesulitan memunculkan amarah yang seharusnya kurasakan. Aku ditugaskan menghabisi Titan yang bahkan tak kukenal, demi membalaskan dendam keluarga yang tak bisa kuingat..."
      Speaker = "Melinoe"
      Event = "HecateAboutTask01"
    }
    {
      Id = "Hecate_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perasaanmu tak pernah membohongimu; asal-usulnya lah yang kerap memperdaya. Kau tak merasa marah? Itu artinya kendali penuh ada di tangan{#Emph}mu{#Prev}. Katakan padaku, apa kau meragukan keharusan menyelesaikan tugas kita?"
      Speaker = "Hecate"
      Event = "HecateAboutTask01"
    }
    {
      Id = "Melinoe_0583"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, Ibu Guru. Pengkhianatan terhadap Wangsa Hades pantang dibiarkan tanpa ganjaran."
      Speaker = "Melinoe"
      Event = "HecateAboutTask01"
    }
    {
      Id = "Hecate_0212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali. Pusatkan pikiranmu pada hal itu."
      Speaker = "Hecate"
      Event = "HecateAboutTask01"
    }
    {
      Id = "Hecate_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana perkembangan tugas sejauh ini, Melinoë? Musuh kita saat ini masih disibukkan oleh urusan lain yang lebih mendesak. Inilah saat yang tepat untuk menghantamnya."
      Speaker = "Hecate"
      Event = "HecateAboutTask02"
    }
    {
      Id = "Melinoe_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih banyak yang harus diselesaikan, Ibu Guru. Anda pasti tahu itu. Berapa banyak sisa waktu yang kumiliki?"
      Speaker = "Melinoe"
      Event = "HecateAboutTask02"
    }
    {
      Id = "Hecate_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa yang tahu? Musuh kita adalah sang Waktu itu sendiri. Aliran waktu tampaknya tak lagi bermakna banyak. Jangan terburu-buru tanpa perhitungan. Cara seperti itu hanya akan membuat tugas ini memakan waktu lebih lama."
      Speaker = "Hecate"
      Event = "HecateAboutTask02"
    }
    {
      Id = "Hecate_0529"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beban harapan besar bertumpu padamu. Tekanan yang kau rasakan; kau tak pernah membicarakannya, tapi aku tahu persis beban itu ada. Menemanimu setiap saat tanpa henti."
      Speaker = "Hecate"
      Event = "HecateAboutPressure01"
    }
    {
      Id = "Melinoe_2133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bahkan nyaris tak bisa lagi membedakan antara tekanan dan keyakinan. Seluruh hidupku ditempa demi saat ini, dan kalian semua menggantungkan harapan padaku. Apakah Ibu Guru benar-benar seyakin itu akan keberhasilanku yang tak terelakkan ini?"
      Speaker = "Melinoe"
      Event = "HecateAboutPressure01"
    }
    {
      Id = "Hecate_0530"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tekanan dan keyakinan memang saling berkaitan, itu benar. Selalu berseteru. Jika tekanan menguasai segalanya, keputusasaan akan merasuk. Saat itulah kita benar-benar goyah."
      Speaker = "Hecate"
      Event = "HecateAboutPressure01"
    }
    {
      Id = "Melinoe_2134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru belum menjawab pertanyaanku. Kekuatan gabungan para dewa saja tak cukup untuk menghentikan Chronos dulu. Dan Guru tahu sendiri Tiga Takdir sulit ditebak. Keberhasilanku bukanlah sebuah kepastian..."
      Speaker = "Melinoe"
      Event = "HecateAboutPressure01"
    }
    {
      Id = "Hecate_0531"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keyakinanku bukan pada hasil akhir, melainkan padamu! Dan aku punya lebih dari cukup untuk bertahan. Jika keyakinanmu mulai goyah, aku akan selalu membagikan sebagian milikku untukmu."
      Speaker = "Hecate"
      Event = "HecateAboutPressure01"
    }
    {
      Id = "Melinoe_2135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Terima kasih sudah percaya padaku."
      Speaker = "Melinoe"
      Event = "HecateAboutPressure01"
    }
    {
      Id = "Hecate_0532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak perlu sungkan."
      Speaker = "Hecate"
      Event = "HecateAboutPressure01"
    }
    {
      Id = "Hecate_0623"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya kuali kita akhirnya disucikan, puji Sang Tiga Takdir! Omong-omong, apa kau masih mempertimbangkan pemanggilan kepada mereka? Aku ragu mereka mau mendengarkan, bahkan sampai sekarang..."
      Speaker = "Hecate"
      Event = "HecateAboutQuestLog01"
    }
    {
      Id = "Melinoe_2900"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika ada secercah harapan Tiga Takdir akan membantu kita, aku akan mengambilnya. Terima kasih sudah mempersiapkannya untukku. Meski begitu, reagen segar yang kupetik masih sangat kurang."
      Speaker = "Melinoe"
      Event = "HecateAboutQuestLog01"
    }
    {
      Id = "Hecate_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm. {#Prev}Akan kuberi reagen itu jika aku bisa, tapi saat kau berkelana keluar dari hutan ini, perhatikan jalanmu baik-baik dan kau pasti akan menemukannya. Jika Sang Takdir mengizinkan..."
      Speaker = "Hecate"
      Event = "HecateAboutQuestLog01"
    }
    {
      Id = "Melinoe_0585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baik, Guru."
      Speaker = "Melinoe"
      Event = "HecateAboutQuestLog01"
    }
    {
      Id = "Hecate_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rupanya Tiga Takdir mengabulkan permintaanmu. Itu gulungan mereka di samping tendamu; gulungan itu mengikutimu keluar dari bayang-bayang. Barangkali itu bisa memberikan sejumlah jawaban."
      Speaker = "Hecate"
      Event = "HecateAboutQuestLog02"
    }
    {
      Id = "Melinoe_0968"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap begitu. Daftar Takdir menugaskanku untuk memastikan nubuat-nubuat kecil tertentu terwujud, meski belum banyak hal lain yang terungkap."
      Speaker = "Melinoe"
      Event = "HecateAboutQuestLog02"
    }
    {
      Id = "Hecate_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga itu setimpal dengan usahamu. Namun jangan harap Sang Takdir akan selalu berpihak padamu; musuh dari musuh kita belum tentu adalah kawan."
      Speaker = "Hecate"
      Event = "HecateAboutQuestLog02"
    }
    {
      Id = "Melinoe_1800"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita harus berani mengambil risiko..."
      Speaker = "Melinoe"
      Event = "HecateAboutQuestLog02"
    }
    {
      Id = "Hecate_0625"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalan dan kemungkinan itu sangat mungkin nyata; begitu pula kemegahan yang menanti, andai kau menuruti kehendak sang pelindung purba kita. Selalu ada ketidakpastian jika menyangkut Chaos... tapi aku yakin orang tua Nyx adalah sekutu, bukan ancaman."
      Speaker = "Hecate"
      Event = "HecateAboutBountyBoard01"
    }
    {
      Id = "Melinoe_2902"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuharap begitu juga."
      Speaker = "Melinoe"
      Event = "HecateAboutBountyBoard01"
    }
    {
      Id = "Hecate_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahkah kau sempat memetik banyak hal dari Kitab Bayangan, Melinoë? Tugas kita akan membawamu jauh melampaui Persimpangan ini; masih banyak yang harus kau pelajari."
      Speaker = "Hecate"
      Event = "HecateAboutCodex01"
    }
    {
      Id = "Melinoe_1011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seiring bertambahnya wawasan dari pengalamanku, Kitab ini mengungkap lebih banyak hal. Apakah itu ajaran-ajaran {#Emph}Guru {#Prev}di dalamnya?"
      Speaker = "Melinoe"
      Event = "HecateAboutCodex01"
    }
    {
      Id = "Hecate_0274"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan ajaranku semata, tapi perhatikanlah baik-baik..."
      Speaker = "Hecate"
      Event = "HecateAboutCodex01"
    }
    {
      Id = "Melinoe_5287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kitab Bayangan... Aku tak selalu yakin siapa penulisnya. Dulu kuterka itu adalah Guru, dari caranya mendahului pikiranku sendiri sebelum terwujud seutuhnya."
      Speaker = "Melinoe"
      Event = "HecateAboutCodex02"
    }
    {
      Id = "Hecate_0848"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dugaanmu tidak sepenuhnya tepat, meski kau mendekati alasan mengapa sang penulis begitu memahami pikiranmu. Itu kitab yang sangat tua... tolong rawat baik-baik untukku."
      Speaker = "Hecate"
      Event = "HecateAboutCodex02"
    }
    {
      Id = "Melinoe_5288"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bersumpah akan merawatnya."
      Speaker = "Melinoe"
      Event = "HecateAboutCodex02"
    }
    {
      Id = "Hecate_0642"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuingat saat diriku sendiri pertama kali menggenggam Api Ygnium. Umurku pasti sebayadenganmu waktu itu. Kini kau telah menguasai kekuatannya."
      Speaker = "Hecate"
      Event = "HecateAboutTorch01"
    }
    {
      Id = "Melinoe_1014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya butuh seberkas cahaya untuk menimbulkan bayangan panjang; bukankah begitu, Guru? Aku akan berusaha sebaik mungkin untuk menggunakan Api ini seperti yang telah Guru ajarkan."
      Speaker = "Melinoe"
      Event = "HecateAboutTorch01"
    }
    {
      Id = "Hecate_0643"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengan caramu {#Emph}sendiri{#Prev}, Melinoë."
      Speaker = "Hecate"
      Event = "HecateAboutTorch01"
    }
    {
      Id = "Melinoe_0970"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memimpikan Ayah lagi. Saat Chronos datang menjemputnya, dan Guru membawaku ke tempat aman. Hanya saja kali ini, aku berada di sana lebih lama dari sebelumnya."
      Speaker = "Melinoe"
      Event = "HecateAboutFates01"
    }
    {
      Id = "Hecate_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu jelas lebih dari sekadar mimpi. Dan apa lagi yang kau ketahui selagi kau berdiam di sana?"
      Speaker = "Hecate"
      Event = "HecateAboutFates01"
    }
    {
      Id = "Melinoe_2916"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu Chronos ingin Ayah memberi tahunya di mana keberadaan Tiga Takdir. Chronos membenci mereka, atau merasa terancam oleh mereka. Selama ini dia terus memburu mereka, bukan? Dan akhirnya berhasil menemukan mereka."
      Speaker = "Melinoe"
      Event = "HecateAboutFates01"
    }
    {
      Id = "Hecate_0640"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu artinya mereka mungkin takkan memihak kita jika dipaksa memilih. Aku sudah menduganya, namun tak ingin mengucapkannya keras-keras. Yah, ini jelas cocok dengan inti kabar yang disampaikan Hermes yang lincah saat dia mendesak kita bertindak! {#Emph}Sesuatu yang gawat, gawat sekali{#Prev}, kurasa begitu kata-katanya?"
      Speaker = "Hecate"
      Event = "HecateAboutFates01"
    }
    {
      Id = "Melinoe_2917"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Gawat, gawat sekali{#Prev}, benar..."
      Speaker = "Melinoe"
      Event = "HecateAboutFates01"
    }
    {
      Id = "Hecate_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mimpimu mengusikmu lagi, kulihat. Terlepas dari upayamu yang berani untuk menyembunyikannya."
      Speaker = "Hecate"
      Event = "HecateAboutNightmares01"
    }
    {
      Id = "Melinoe_1021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa mengatasinya, Guru, hanya saja... ini tentang Chronos. Aku sekarang bisa mendengarnya bahkan saat aku diam bagai kematian."
      Speaker = "Melinoe"
      Event = "HecateAboutNightmares01"
    }
    {
      Id = "Hecate_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maka ubahlah mimpi burukmu menjadi mimpi buruknya. Alam bawah sadarmu adalah suaka terbesarmu. Jangan biarkan siapa pun tinggal di sana tanpa izinmu."
      Speaker = "Hecate"
      Event = "HecateAboutNightmares01"
    }
    {
      Id = "Hecate_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari Selene memberi tahu bahwa dia meminjamkan kilau dan kekuatannya padamu. Kau sanggup memanggilnya turun bahkan di dalam tempat ini?"
      Speaker = "Hecate"
      Event = "HecateAboutSelene01"
    }
    {
      Id = "Melinoe_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menemukan sumber cahaya bulan dan memohon bantuan Selene menggunakan Kata-Kata Sakral, Guru. Aku tak bisa membayangkan betapa luas kekuatannya."
      Speaker = "Melinoe"
      Event = "HecateAboutSelene01"
    }
    {
      Id = "Hecate_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau paham betul kekuatannya. Kau hanya belum punya kesempatan untuk menggunakannya. Kesempatan itu akan segera datang, kurasa."
      Speaker = "Hecate"
      Event = "HecateAboutSelene01"
    }
    {
      Id = "Melinoe_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugas ini... kenapa hanya dibebankan kepadaku, Guru? Karena, Nemesis, dia..."
      Speaker = "Melinoe"
      Event = "HecateAboutNemesis01"
    }
    {
      Id = "Hecate_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Dia {#Prev}itu beban. Seandainya aku tidak bersumpah pada Nyx untuk menjaga anak-anaknya, sudah kuusir dia sejak lama karena membangkang."
      Speaker = "Hecate"
      Event = "HecateAboutNemesis01"
    }
    {
      Id = "Melinoe_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia frustrasi karena Guru belum memberinya kesempatan. Kekuatannya jauh melampauiku dan latihannya setidaknya sekeras latihanku; aku melihatnya sendiri!"
      Speaker = "Melinoe"
      Event = "HecateAboutNemesis01"
    }
    {
      Id = "Hecate_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa membela dia sedemikian rupa, Melinoë? Sikapnya jauh lebih lantang daripada kata-katanya. Aku takkan memercayakan hal penting apa pun pada orang macam itu."
      Speaker = "Hecate"
      Event = "HecateAboutNemesis01"
    }
    {
      Id = "Melinoe_2244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mencibir>"
      Speaker = "Melinoe"
      Event = "HecateAboutNemesis01"
    }
    {
      Id = "Hecate_0853"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hypnos jelas-jelas pergi terburu-buru. Butuh waktu lebih lama bagimu untuk membangunkannya daripada dugaanku semula, tapi itu demi kebaikan."
      Speaker = "Hecate"
      Event = "HecateAboutHypnosWakeUp01"
    }
    {
      Id = "Melinoe_5292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, Guru {#Emph}tahu {#Prev}ini akan terjadi? Kenapa Guru tidak bilang apa-apa selama aku berusaha membangunkannya dari lelap tidurnya? Kukira Guru mengabaikannya."
      Speaker = "Melinoe"
      Event = "HecateAboutHypnosWakeUp01"
    }
    {
      Id = "Hecate_0854"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, memang kuabaikan, setelah kulihat kau sudah cukup belajar. Afinitasmu terhadap mimpi dan sejenisnya terbukti penting bagi tugas ini, dan Hypnos, dengan caranya sendiri, adalah sarana untuk itu."
      Speaker = "Hecate"
      Event = "HecateAboutHypnosWakeUp01"
    }
    {
      Id = "Melinoe_5293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Guru membawanya kemari agar aku bisa berlatih?"
      Speaker = "Melinoe"
      Event = "HecateAboutHypnosWakeUp01"
    }
    {
      Id = "Hecate_0855"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia memang butuh tempat berteduh."
      Speaker = "Hecate"
      Event = "HecateAboutHypnosWakeUp01"
    }
    {
      Id = "Hecate_1006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lihat Hypnos membawakan sesuatu untukmu? {#Emph}Pesanan khusus dari Kediaman{#Prev}, begitulah kabar yang kuterima. Dan maksudku bukan tumpukan kecil di sana tempat dia biasa mendengkur."
      Speaker = "Hecate"
      Event = "HecateAboutHypnosWakeUp02"
    }
    {
      Id = "Melinoe_5813"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah! Awalnya kukira itu tempat beristirahat di area latihan. Tapi itu adalah sarana agar aku bisa terhubung lebih dalam dengan mimpiku... kekhawatiranku dan semacamnya."
      Speaker = "Melinoe"
      Event = "HecateAboutHypnosWakeUp02"
    }
    {
      Id = "Hecate_1007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë, tujuan beristirahat adalah menyingkirkan kekhawatiranmu jauh-jauh. Tapi aku tahu sebagian darinya tak bisa dihindari, dan jika ini caramu menenangkan sudut-sudut gelisah dalam pikiranmu, ya sudahlah. Gunakanlah waktu sebanyak yang kau mau dengannya."
      Speaker = "Hecate"
      Event = "HecateAboutHypnosWakeUp02"
    }
    {
      Id = "Melinoe_5814"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Boleh juga!"
      Speaker = "Melinoe"
      Event = "HecateAboutHypnosWakeUp02"
    }
    {
      Id = "Melinoe_2914"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi malam, Guru, aku melewati gerbang yang membawaku ke kedalaman Chaos... tempat aku bertemu dengannya! Aku sudah mendengar begitu banyak dari Guru tentang Nyx, tapi entah bagaimana aku tidak pernah menyangka akan bertemu orang tuanya."
      Speaker = "Melinoe"
      Event = "HecateAboutChaos01"
    }
    {
      Id = "Hecate_0638"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa menghadap Chaos Primordial... tak kusangka sama sekali! Meski mengingat Nyx sendiri tak pernah terlihat sejak Chronos merebut Kediaman Hades, aku tak heran. Tak ada amarah sebesar orang tua yang kehilangan anaknya. Jadi, apakah Chaos tampak seperti sekutu bagi kita?"
      Speaker = "Hecate"
      Event = "HecateAboutChaos01"
    }
    {
      Id = "Melinoe_2915"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupikir begitu."
      Speaker = "Melinoe"
      Event = "HecateAboutChaos01"
    }
    {
      Id = "Hecate_0639"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah, terima kasih Nyx untuk itu..."
      Speaker = "Hecate"
      Event = "HecateAboutChaos01"
    }
    {
      Id = "Hecate_0601"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris telah kembali ke sini, kurasa kau sudah melihatnya? Harapan terbesarku adalah membiarkan semua sampahnya di sini cepat atau lambat akan membuatnya tergerak memungutnya, tapi sayang sekali.... Menjauhlah darinya."
      Speaker = "Hecate"
      Event = "HecateAboutEris01"
    }
    {
      Id = "Melinoe_2528"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira Guru akhirnya mencabut izin masuknya. Aku takkan membiarkan Eris mengubah tempat ini menjadi kandang babi, bahkan jika itu berarti aku harus membereskannya sendiri."
      Speaker = "Melinoe"
      Event = "HecateAboutEris01"
    }
    {
      Id = "Hecate_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, betapa terbahak-bahaknya dia andai bisa melihat kekesalan di wajahmu sekarang. Aku tahu, mengabaikan masalah jarang bisa menyelesaikannya, tapi... jika menyangkut Eris, kurasa hanya itu cara terbaik kita..."
      Speaker = "Hecate"
      Event = "HecateAboutEris01"
    }
    {
      Id = "Hecate_0645"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari Selene memberitahuku bahwa Erismu sendirilah yang menghalangimu mencapai puncak Olimpus. Harusnya dia tak pernah menyentuh Rel Adamant lagi, dasar {#Emph}bedebah."
      Speaker = "Hecate"
      Event = "HecateAboutErisFight01"
    }
    {
      Id = "Melinoe_3445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru, apa sungguh tak ada yang bisa kita lakukan? Sumpah Guru pada Nyx berarti Eris bisa keluar-masuk kemari sesuka hatinya, hanya untuk mencoba meledakkanku berkeping-keping saat aku mendekati tujuanku?"
      Speaker = "Melinoe"
      Event = "HecateAboutErisFight01"
    }
    {
      Id = "Hecate_0646"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seseorang harus menimbang baik-baik syarat dari perjanjian yang mengikat, Melinoë. Kesalahan dari pihakku yang harus kau tanggung akibatnya secara langsung, {#Emph}heh. {#Prev}Dan aku minta maaf. Beri dia neraka saat kalian bertemu lagi nanti, ya?"
      Speaker = "Hecate"
      Event = "HecateAboutErisFight01"
    }
    {
      Id = "Melinoe_3446"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja..."
      Speaker = "Melinoe"
      Event = "HecateAboutErisFight01"
    }
    {
      Id = "Hecate_0706"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil memancing Prometheus keluar dari tempat persembunyiannya. Entah bagaimana bisa lolos dari rantainya! Apakah dia seorang idealis murni atau sekadar ingin memberontak, aku belum bisa memastikannya."
      Speaker = "Hecate"
      Event = "HecateAboutPrometheus01"
    }
    {
      Id = "Melinoe_3895"
      InheritFrom = "BaseNarrative"
      DisplayName = "Alasannya memihak Chronos tampak cukup jelas; pertama, dia ingin membalas dendam pada Paman Dewa Zeus dan yang lainnya. Dan kedua, dia sendiri adalah seorang Titan."
      Speaker = "Melinoe"
      Event = "HecateAboutPrometheus01"
    }
    {
      Id = "Hecate_0707"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aku {#Prev}juga seorang Titaness, begitu pula Saudari Selene, jangan sampai kau lupa! Garis keturunan kita tak perlu mendikte kesetiaan atau prinsip kita. Walaupun mungkin Prometheus berpandangan lain."
      Speaker = "Hecate"
      Event = "HecateAboutPrometheus01"
    }
    {
      Id = "Melinoe_3896"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benarkah dia bisa melihat semua yang akan terjadi?"
      Speaker = "Melinoe"
      Event = "HecateAboutPrometheus01"
    }
    {
      Id = "Hecate_0708"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin dia cuma gila. Dan bukan cuma dalam satu hal."
      Speaker = "Hecate"
      Event = "HecateAboutPrometheus01"
    }
    {
      Id = "Hecate_0709"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hermes memberitahuku bahwa Prometheus melipatgandakan serangannya ke Olimpus, setelah dia menghempaskanmu. Bukankah sudah kulatih kau cara menahan kobaran api?"
      Speaker = "Hecate"
      Event = "HecateAboutPrometheusL01"
    }
    {
      Id = "Melinoe_3897"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya dia cuma punya api, tapi tidak, dia punya hewan peliharaan Elang yang ganas dan banyak lagi. Bagaimana dengan Olimpus, apa yang telah dia perbuat?"
      Speaker = "Melinoe"
      Event = "HecateAboutPrometheusL01"
    }
    {
      Id = "Hecate_0710"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia membuat para dewa terdesak. Tak pernah mengerahkan seluruh pasukannya, menghindari pertarungan yang tak bisa dia menangkan! Lawan yang menyebalkan, meski dia takkan pernah menang."
      Speaker = "Hecate"
      Event = "HecateAboutPrometheusL01"
    }
    {
      Id = "Melinoe_3898"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenapa tidak?"
      Speaker = "Melinoe"
      Event = "HecateAboutPrometheusL01"
    }
    {
      Id = "Hecate_0711"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia hanyalah satu Titan melawan selusin dewa atau lebih."
      Speaker = "Hecate"
      Event = "HecateAboutPrometheusL01"
    }
    {
      Id = "Hecate_0760"
      InheritFrom = "BaseNarrative"
      DisplayName = "Si pencuri api Prometheus bersikukuh tetap menghalangi jalanmu menuju puncak gunung. Omong kosong apa lagi yang dia jejalkan ke kepalamu belakangan ini?"
      Speaker = "Hecate"
      Event = "HecateAboutPrometheus02"
    }
    {
      Id = "Melinoe_4048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia tampak memikul rasa tanggung jawab dan bersalah yang mendalam terhadap bangsa fana. Aku cemas dia bermaksud menyebarkan perselisihan di barisan kita... pasti ada beberapa Arwah bawahan kita yang menaruh simpati padanya."
      Speaker = "Melinoe"
      Event = "HecateAboutPrometheus02"
    }
    {
      Id = "Hecate_0761"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagi pendengaranku, sepertinya kau sendiri mulai menaruh simpati semacam itu. Jangan teperdaya oleh dalih mulianya; dia berpihak pada musuh kita, dan dia sudah menegaskan hal itu."
      Speaker = "Hecate"
      Event = "HecateAboutPrometheus02"
    }
    {
      Id = "Melinoe_4049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baik... kupahami."
      Speaker = "Melinoe"
      Event = "HecateAboutPrometheus02"
    }
    {
      Id = "Hecate_0774"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hermes mengabarkan bahwa kau berperan penting dalam melepaskan cengkeraman Typhon di Gunung Olympus baru-baru ini. Kuharap kerabatmu yang kewalahan itu turut menyumbang andil mereka dalam hasil tersebut?"
      Speaker = "Hecate"
      Event = "HecateAboutTyphonW02"
    }
    {
      Id = "Melinoe_4355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mungkin hanya pengalih perhatian di garis depan untuk menghentikan serangan monster itu, tapi berhasil. Setidaknya Tuan Zeus sempat mengingatkan Typhon akan kedahsyatan petirnya. Yang lainnya sedang sibuk di tempat lain..."
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonW02"
    }
    {
      Id = "Hecate_0775"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa pasti bersyukur atas {#Emph}pengalih perhatian garis depan{#Prev} yang begitu ampuh, dan Chronos pasti juga bersyukur atas jeda singkat ini. Namun lanjutkanlah sesuai rencanamu; semua ini bagian dari rencana sang Titan, dan begitu pula akan menjadi bagian dari rencana kita."
      Speaker = "Hecate"
      Event = "HecateAboutTyphonW02"
    }
    {
      Id = "Melinoe_4356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat seperti yang kupikirkan."
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonW02"
    }
    {
      Id = "Hecate_0849"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selene mengabarkan bahwa kau tampaknya berhasil bertahan dari Sumpah Persaingan hingga akhir. Dia bukanlah sosok yang mudah keliru, tapi klaim seperti itu perlu kupastikan kebenarannya."
      Speaker = "Hecate"
      Event = "HecateAboutTyphonAltFightW01"
    }
    {
      Id = "Melinoe_5289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu anggap saja klaim itu sudah terbukti. Aku nyaris mengharapkan perjamuan agung atau upacara mengingat semua jerih payah yang telah kukerahkan. Meski kurasa bukan begitu cara kehendak Malam diwujudkan."
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonAltFightW01"
    }
    {
      Id = "Hecate_0850"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyx sendiri pernah berujar, {#Emph}carilah keberhargaan, bukan ketenaran.{#Prev} Setidaknya Selene dan aku tahu apa yang telah kau capai. Tapi jika kejayaan yang kau dambakan, kau terlahir di alam yang salah."
      Speaker = "Hecate"
      Event = "HecateAboutTyphonAltFightW01"
    }
    {
      Id = "Melinoe_5290"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini sudah lebih dari cukup."
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonAltFightW01"
    }
    {
      Id = "Hecate_0777"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah puncak Olympus seindah yang kau bayangkan, di Istana Tuan Zeus? Jika kau harus menembus rintangan seberat itu demi mencapainya, pemandangannya harus sepadan dengan usahamu."
      Speaker = "Hecate"
      Event = "HecateAboutPalace01"
    }
    {
      Id = "Melinoe_4726"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pelataran istananya belum pernah kulihat sebelumnya. Namun semuanya begitu menyilaukan hingga aku nyaris tak bisa melihat sama sekali. Aku merasa bagai orang asing di sana."
      Speaker = "Melinoe"
      Event = "HecateAboutPalace01"
    }
    {
      Id = "Hecate_0778"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang bukan tempatmu. Yah, asalkan kerabat gunungmu sempat menunjukkan sedikit keramahtamahan dalam waktu singkat yang kau miliki!"
      Speaker = "Hecate"
      Event = "HecateAboutPalace01"
    }
    {
      Id = "Melinoe_4727"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka melakukannya, tapi... aku senang bisa kembali."
      Speaker = "Melinoe"
      Event = "HecateAboutPalace01"
    }
    {
      Id = "Hecate_0762"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedua musuh besar yang kita hadapi telah kau taklukkan satu demi satu. Dengan begitu, kita mulai memegang kendali..."
      Speaker = "Hecate"
      Event = "HecateAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_4050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mungkin bisa mengalahkan Chronos atau Typhon dalam pertarungan, tapi terkadang aku merasa sama sekali tak mendekati tujuan untuk menghentikan mereka. Sungguh menenangkan mendengar engkau berpikir sebaliknya."
      Speaker = "Melinoe"
      Event = "HecateAboutUltimateProgress01"
    }
    {
      Id = "Hecate_0763"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan sekadar berpikir; kau telah membuktikan bahwa dirimu memiliki kekuatan dan pengetahuan untuk menuntaskan tugasmu. Mengenai apakah kau memiliki kesabaran, itu yang harus kita buktikan nanti."
      Speaker = "Hecate"
      Event = "HecateAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_4051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, kesabaran..."
      Speaker = "Melinoe"
      Event = "HecateAboutUltimateProgress01"
    }
    {
      Id = "Hecate_0791"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Pelenyapan Waktu. Pemusnahan Monster.{#Prev} Mantra yang saling bertaut, meniadakan apa yang telah terlanjur terjadi, dan secara kejam. Penggunaan seni kita yang amat mengerikan..."
      Speaker = "Hecate"
      Event = "HecateAboutUltimateProgress02"
    }
    {
      Id = "Melinoe_5777"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang benar. Engkau selalu bilang kekuatan seperti itu pantang digunakan, kecuali saat tiada pilihan lain yang tersisa... mungkin bahkan tidak juga dalam situasi itu. Bagaimana engkau bisa menemukan mantra semacam itu? Engkau bisa dibilang lebih mengenal Chronos daripada dirinya sendiri."
      Speaker = "Melinoe"
      Event = "HecateAboutUltimateProgress02"
    }
    {
      Id = "Hecate_0792"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat mengetahui apa yang Chronos lakukan padamu dan yang lainnya... aku menolak untuk menerimanya. Namun aku tetap mempelajarinya. Kekuatan selalu menyimpan rahasia kehancurannya sendiri."
      Speaker = "Hecate"
      Event = "HecateAboutUltimateProgress02"
    }
    {
      Id = "Melinoe_4742"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan miliknya dan milik Typhon..."
      Speaker = "Melinoe"
      Event = "HecateAboutUltimateProgress02"
    }
    {
      Id = "Hecate_0793"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan miliknya dan milik Typhon."
      Speaker = "Hecate"
      Event = "HecateAboutUltimateProgress02"
    }
    {
      Id = "Melinoe_4733"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tombak ayahku, Gigaros... pusaka itu ada di kediaman sang Pangeran untuk kutemukan. Zagreus pasti pernah menggunakannya pada masanya, seperti aku sekarang. Satu langkah terakhir, bukan?"
      Speaker = "Melinoe"
      Event = "HecateAboutUltimateProgress03_A"
    }
    {
      Id = "Hecate_0788_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum sepenuhnya. Kita hanya punya satu kesempatan untuk menggunakannya melawan Chronos, dan kita harus mengambil setiap pencegahan demi memastikan hasilnya sesuai harapan."
      Speaker = "Hecate"
      Event = "HecateAboutUltimateProgress03_A"
    }
    {
      Id = "Melinoe_5016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entropi adalah reagen terakhir yang kita butuhkan untuk Pelenyapan Waktu, tapi... di mana aku harus mencarinya? Belum kutemukan jejaknya sejauh ini... bahkan dari Typhon."
      Speaker = "Melinoe"
      Event = "HecateAboutUltimateProgress03_A"
    }
    {
      Id = "Hecate_0795"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di mana kau harus {#Emph}menciptakannya{#Prev} adalah pertanyaan yang lebih tepat untuk diajukan. Suatu kekuatan yang cukup dahsyat harus diistirahatkan sepenuhnya. Kau mengerti maksudku?"
      Speaker = "Hecate"
      Event = "HecateAboutUltimateProgress03_A"
    }
    {
      Id = "Melinoe_5017"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kurasa begitu. Kalau begitu, kembali ke permukaan."
      Speaker = "Melinoe"
      Event = "HecateAboutUltimateProgress03_A"
    }
    {
      Id = "Melinoe_5730"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kurasa begitu. Langkah pertama, Pemusnahan Monster."
      Speaker = "Melinoe"
      Event = "HecateAboutUltimateProgress03_A"
    }
    {
      Id = "Hecate_0982"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuhargai fokus tunggalmu dalam menghadapi Chronos di Kediaman ayahmu... namun, harus kuakui masalah yang dihadapi kerabat gunungmu tak lagi bisa diabaikan."
      Speaker = "Hecate"
      Event = "HecateAboutUltimateProgressSurface01"
    }
    {
      Id = "Melinoe_5792"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, apa engkau menyarankan agar aku mengalihkan perhatian ke permukaan, saat kita sudah sedekat ini dengan kemenangan?"
      Speaker = "Melinoe"
      Event = "HecateAboutUltimateProgressSurface01"
    }
    {
      Id = "Hecate_0983"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tidak sedekat itu dengan kemenangan seperti dugaanmu. Pertama-tama, Pelenyapan Waktu membutuhkan reagen utama yang belum kau miliki. Benda itu takkan kau temukan di bawah sini; aku menyadarinya sekarang, dan kau pun harus demikian."
      Speaker = "Hecate"
      Event = "HecateAboutUltimateProgressSurface01"
    }
    {
      Id = "Melinoe_5793"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, akan kucari di atas sana."
      Speaker = "Melinoe"
      Event = "HecateAboutUltimateProgressSurface01"
    }
    {
      Id = "Hecate_0752"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, dan sebaiknya kau terus mengingatnya sebelum menghadapi Sang Ayah Segala Monster itu lagi. Jangan ambil risiko yang tak perlu, atau melupakan tugasmu."
      Speaker = "Hecate"
      Event = "HecateAboutTyphonFight01"
    }
    {
      Id = "Melinoe_4047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita lakukan apa yang harus kita lakukan."
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonFight01"
    }
    {
      Id = "Hecate_0753"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin memujimu atas hasilnya seandainya aku tidak begitu terperangah. Sang Ayah Segala Monster mungkin tak akan semudah itu dikejutkan saat kau menghadapinya lagi nanti. Jangan ambil risiko yang tak perlu atau melupakan tugasmu."
      Speaker = "Hecate"
      Event = "HecateAboutTyphonFight01_B"
    }
    {
      Id = "Hecate_0754"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh sebuah keajaiban kerabat gunungmu masih bisa membantumu sementara Typhon berada tepat di depan gerbang mereka. Apakah mereka punya semacam strategi untuk menghentikannya, apa kau tahu?"
      Speaker = "Hecate"
      Event = "HecateAboutTyphonFight02"
    }
    {
      Id = "Melinoe_4044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka bekerja sama untuk memukulnya mundur, bersama dengan legiun sang Titan. Tapi jika mereka punya rencana yang lebih besar untuk mengakhiri penyerbuan itu, mereka belum membocorkannya."
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonFight02"
    }
    {
      Id = "Hecate_0755"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu anggap saja mereka tak punya rencana seperti itu. Namun, aku mulai berpikir Sang Ayah Segala Monster mungkin bisa dimanfaatkan dalam rencana kita. Kumpulkan sampel apa pun yang kau bisa darinya."
      Speaker = "Hecate"
      Event = "HecateAboutTyphonFight02"
    }
    {
      Id = "Melinoe_0042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baik, Guru."
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonFight02"
    }
    {
      Id = "Hecate_0756"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemenangan-kemenanganmu melawan Typhon... apa ada bukti yang bisa kau tunjukkan? Semacam spesimen atau sampel dari dagingnya?"
      Speaker = "Hecate"
      Event = "HecateAboutTyphonFight03"
    }
    {
      Id = "Melinoe_4045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap Guru suka mata yang mengerikan. Apakah ada mantra dalam benakmu yang membutuhkan kotoran semacam itu?"
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonFight03"
    }
    {
      Id = "Hecate_0757"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja. Simpan dulu semua itu untuk sekarang. Tapi saat waktunya tepat, kita akan membalikkan semua kekuatan monster itu untuk melawannya sendiri. Dan memusnahkan monster keparat itu dari dunia ini untuk selamanya."
      Speaker = "Hecate"
      Event = "HecateAboutTyphonFight03"
    }
    {
      Id = "Melinoe_2519_A"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Baik, Guru."
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonFight03"
    }
    {
      Id = "Hecate_0756_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemenanganmu melawan Typhon... apa ada bukti yang bisa kau tunjukkan? Semacam spesimen atau sampel dari dagingnya?"
      Speaker = "Hecate"
      Event = "HecateAboutTyphonFight03_B"
    }
    {
      Id = "Melinoe_1177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru, aku melihatnya. {#Emph}Chronos! {#Prev}Dia berada di jalur setapak di luar Erebus. Aku langsung menyerang begitu menyadari siapa dia, tapi sia-sia."
      Speaker = "Melinoe"
      Event = "HecateAboutChronos01"
    }
    {
      Id = "Hecate_0776"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bajingan congkak, merasa dirinya cerdik. Berarti dia sudah tahu tentangmu. Apa katanya?"
      Speaker = "Hecate"
      Event = "HecateAboutChronos01"
    }
    {
      Id = "Melinoe_1178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia berterima kasih pada Takdir karena akhirnya kami bertemu, seolah-olah dia telah mencariku selama ini... dan memberitahuku agar tidak melakukan kesalahan yang sama seperti keluargaku."
      Speaker = "Melinoe"
      Event = "HecateAboutChronos01"
    }
    {
      Id = "Hecate_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Enyahkan memori beracun itu dari pikiranmu; dia tidak tahu apa-apa tentang rencana Takdir. Aku akan memperkuat semua sihir pelindung kita, dan {#Emph}kau: {#Prev}Jangan takuti musuhmu; {#Emph}habisi dia!"
      Speaker = "Hecate"
      Event = "HecateAboutChronos01"
    }
    {
      Id = "Melinoe_2520"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos menungguku lagi di luar Erebus. Kali ini aku langsung mengenalinya, tapi aku tak bisa berbuat apa-apa melawannya..."
      Speaker = "Melinoe"
      Event = "HecateAboutChronos02"
    }
    {
      Id = "Hecate_0033_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bajingan licik. Sombong sampai akhir.... Apa katanya?"
      Speaker = "Hecate"
      Event = "HecateAboutChronos02"
    }
    {
      Id = "Melinoe_2903"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru, aku menemukannya! {#Emph}Chronos! {#Prev}Jauh di dalam Tartarus, persis seperti yang Guru katakan. Kulakukan segalanya sesuai latihan dan rencana, hanya saja... dia terlalu kuat."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossEarlyL01"
    }
    {
      Id = "Hecate_0591"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tenangkan hatimu, Melinoë, kau aman. Dan kau berhasil kembali lagi ke sini, artinya semua latihanmu membuahkan hasil.... Jadi... dia menyadari siapa dirimu?"
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossEarlyL01"
    }
    {
      Id = "Melinoe_2904"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia sadar. Kita kehilangan elemen kejutan sekarang, bukan? Sialan... bagaimana bisa aku gagal?"
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossEarlyL01"
    }
    {
      Id = "Hecate_0592"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang berubah; kau harus menghadapinya di tempat kediamannya. Tempat ibunda dan ayahmu seharusnya berada. Namun majulah dengan sabar, bukan tergesa-gesa. Dia mungkin tahu sedikit tentang kekuatanmu sekarang, tapi belum cukup."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossEarlyL01"
    }
    {
      Id = "Melinoe_2905"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku akan menghabisinya."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossEarlyL01"
    }
    {
      Id = "Melinoe_2797"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil mencapai Graha, Guru. Kulakukan segalanya sesuai latihan dan rencana, hanya saja... dia terlalu kuat."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossL01"
    }
    {
      Id = "Hecate_0630"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tidak{#Prev}, ini hasil yang {#Emph}sangat luar biasa! {#Prev}Kau masih di sini, dan telah mempelajari lebih banyak tentang apa yang dibutuhkan untuk menjangkau musuh kita, serta apa yang bisa {#Emph}dia {#Prev}lakukan untuk melawan! Apa kau merasa siap untuk melanjutkan perburuanmu?"
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossL01"
    }
    {
      Id = "Melinoe_2798"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya. Kalau aku bisa mencapainya... aku bisa menghabisinya."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossL01"
    }
    {
      Id = "Hecate_0631"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Habisi dia."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossL01"
    }
    {
      Id = "Melinoe_3469"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekali lagi aku gagal menghancurkan sang Titan, Guru. Malam demi malam dia menggagalkanku, mengira aku pada akhirnya akan menyerah..."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossL02"
    }
    {
      Id = "Hecate_0668"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau tak berniat begitu, kan? Kau memang belum bisa menghentikannya, namun dia pun belum mampu menghentikan {#Emph}dirimu. {#Prev}Kau kebal terhadap kekuatannya dan dia tak bisa mengusirmu dari {#Emph}alammu."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossL02"
    }
    {
      Id = "Melinoe_3470"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru membuatnya terdengar seolah-olah aku sudah mengalahkannya."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossL02"
    }
    {
      Id = "Hecate_0669"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Belum; tapi tak lama lagi, aku yakin."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossL02"
    }
    {
      Id = "Hecate_0632"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau kembali...! Sekarang ceritakan semuanya padaku. Kau berhasil menemukan sasaranmu? Lalu bagaimana?"
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW01"
    }
    {
      Id = "Melinoe_2799"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil mencapai ujung Tartarus dan masuk ke dalam Graha, persis seperti rencana kita. Chronos ada di sana, di atas takhta ayahku. Kami bertarung. Dia kalah. Tapi aku tahu dia belum musnah sepenuhnya. Dan aku tak bisa berlama-lama di sana."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossW01"
    }
    {
      Id = "Hecate_0779"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kau memanfaatkan setiap detiknya dengan baik. Kita memang tak akan pernah bisa menghancurkan sang Titan hanya dengan kekuatan kasar, tapi sebentar lagi, dia mungkin akan binasa seutuhnya. Asalkan kau punya kabar baik lainnya untuk dilaporkan...?"
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW01"
    }
    {
      Id = "Melinoe_4728"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cermin itu masih utuh... ditinggalkan di kamar sang Pangeran. Dan mantranya berhasil! Aku menemukan kakakku di masa lalu dan berbicara dengannya, tapi waktunya sangat sempit. Aku nyaris tak sempat meyakinkannya tentang siapa diriku."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossW01"
    }
    {
      Id = "Hecate_0780"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu bicaralah cepat-cepat begitu ada kesempatan lagi. Dan jangan berlama-lama di sana, jangan sampai tugas ini berakhir dengan kegagalan. Mengenai sang Titan... pelajari dia, sebagaimana aku akan mempelajari apa yang kau temukan."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW01"
    }
    {
      Id = "Hecate_0635"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, ngomong-ngomong... ada sesuatu yang menunggumu di area latihan. Kau sudah membuktikan tanpa keraguan bahwa kau siap."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW01Cont1"
    }
    {
      Id = "Hecate_0781"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menundukkan sang Titan lagi, tapi apa yang terjadi setelah itu? Apakah saudaramu dari masa lalu itu lebih kooperatif dari sebelumnya?"
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW02"
    }
    {
      Id = "Melinoe_4729"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia tidak tahu di mana Chronos berada, meski tampaknya bersedia menyelidikinya. Mungkin dia akan menemukan sesuatu. Aku masih sulit percaya bahwa yang kuajak bicara benar-benar dirinya di masa lalu..."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossW02"
    }
    {
      Id = "Hecate_0782"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bayangkan bagaimana perasaan {#Emph}dia{#Prev}. Teruslah periksa keadaannya, tapi jangan ceritakan hal ini kepada siapa pun. Waktu selalu mengalir maju, dan kita tidak ditakdirkan untuk berenang melawan arus itu."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW02"
    }
    {
      Id = "Melinoe_4730"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seharusnya ini mustahil..."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossW02"
    }
    {
      Id = "Hecate_0783"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kita{#Prev} yang menentukan apa yang mungkin, Melinoë."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW02"
    }
    {
      Id = "Hecate_0784"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami mendengar tentang kemalangan terbaru sang Titan di tanganmu. Apakah hal-hal lain berjalan sesuai rencana menurut perkiraanmu?"
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW03"
    }
    {
      Id = "Melinoe_4731"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa begitu. Kita hanya perlu menemukan senjata yang cocok sekarang, lalu... semua yang telah terjadi bisa dibatalkan."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossW03"
    }
    {
      Id = "Hecate_0785"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin tidak {#Emph}semuanya{#Prev}, tapi cukup banyak. Kau tahu sisanya di luar kepala dan aku takkan mengorek rincian lebih lanjut. Namun jika ada rintangan tak terduga yang menghadang, segera beri tahu aku."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW03"
    }
    {
      Id = "Melinoe_4732"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baik, Guru."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossW03"
    }
    {
      Id = "Melinoe_4735"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru ingin aku mengalihkan perhatianku ke Olympus untuk sementara waktu, agar kita bisa menguji Tombak Waktu di sana terlebih dahulu?"
      Speaker = "Melinoe"
      Event = "HecateAboutChronosBossW04_A"
    }
    {
      Id = "Hecate_0789"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya. Kau harus membuktikan bahwa ini akan berhasil."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW04_A"
    }
    {
      Id = "Hecate_0788"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak secepat itu. Kita hanya punya satu kesempatan untuk menggunakannya melawan Chronos, dan harus mengambil segala pencegahan untuk memastikan hasilnya sesuai harapan. Barangkali apa pun yang merundung kerabat Olympian-mu bisa menjadi sasaran yang tepat."
      Speaker = "Hecate"
      Event = "HecateAboutChronosBossW04_B"
    }
    {
      Id = "Hecate_0796"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perbuatan keji itu telah usai. Jangan menaruh belas kasihan pada monster itu, bersyukurlah saja... karena kekuatannya telah beralih saat dia tiada. Sekarang kau siap untuk tahap terakhir."
      Speaker = "Hecate"
      Event = "HecateAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_5018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebelum aku berangkat... saudaraku menanyakan sesuatu yang tak tahu bagaimana cara menjawabnya. Jika Chronos dihancurkan sebelum semua ini terjadi... apa yang sebenarnya akan terjadi pada kita di sini saat ini?"
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonDeath01"
    }
    {
      Id = "Hecate_0797"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita temukan kebenarannya bersama-sama. Aku hanya yakin akan satu hal: ini bukan perpisahan. Akhir dari tugasmu sudah di depan mata. {#Emph}Pergilah{#Prev}, akhiri semua ini."
      Speaker = "Hecate"
      Event = "HecateAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_5019"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sampai jumpa lagi, Guru."
      Speaker = "Melinoe"
      Event = "HecateAboutTyphonDeath01"
    }
    {
      Id = "Hecate_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu lagi kerabat Nyx yang harus kita awasi di sini. Mantramu berhasil melacaknya! Tentu saja, {#Emph}Sang Petaka {#Prev}biasanya datang {#Emph}tanpa diundang{#Prev}."
      Speaker = "Hecate"
      Event = "HecateAboutMoros01"
    }
    {
      Id = "Melinoe_1591"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Moros akan menjadi tamu kita. Aku tahu kehadirannya terkesan seperti pertanda buruk, tapi jika para Fates menginginkannya di sini, siapa kita berani menentangnya?"
      Speaker = "Melinoe"
      Event = "HecateAboutMoros01"
    }
    {
      Id = "Hecate_0422"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, siapa pula yang berani."
      Speaker = "Hecate"
      Event = "HecateAboutMoros01"
    }
    {
      Id = "Melinoe_1029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menemukannya, Guru! Ayahku! Chronos mengurungnya di Tartarus. Tapi, aku tak bisa menyelamatkannya... dia memintaku untuk meninggalkannya..."
      Speaker = "Melinoe"
      Event = "HecateAboutHades01"
    }
    {
      Id = "Hecate_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Sungguh perangai Chronos yang sangat bisa ditebak, selalu menyombongkan diri seperti itu. Aku menyesal reuni kalian bersama Lord Hades berlangsung demikian... meski begitu, aku lega kau berhasil menemukannya. Bagaimana keadaannya?"
      Speaker = "Hecate"
      Event = "HecateAboutHades01"
    }
    {
      Id = "Melinoe_1030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia... {#Emph}ugh. {#Prev}Aku sungguh tak tahu pasti. Pikiran dan tubuhnya tampak masih utuh, dan dia langsung mengenaliku. Dia memberiku berkat apa pun yang masih bisa dia berikan. Apa yang bisa kita lakukan?"
      Speaker = "Melinoe"
      Event = "HecateAboutHades01"
    }
    {
      Id = "Hecate_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika dia memintamu meninggalkannya, itu bukti bahwa dia ingin tetap tak terlihat. Berhati-hatilah dan bicaralah singkat saja jika kau bertemu dengannya lagi; dan {#Emph}aku {#Prev}akan memastikan Chronos tetap tak menyadari hubungan yang baru kalian jalin ini."
      Speaker = "Hecate"
      Event = "HecateAboutHades01"
    }
    {
      Id = "Melinoe_1031"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku mohon pamit."
      Speaker = "Melinoe"
      Event = "HecateAboutHades01"
    }
    {
      Id = "Melinoe_5474"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya aku memberi tahu Guru sejak dulu, tapi aku telah menemukannya... ayahku. Chronos mengurungnya di Tartarus layaknya tahanan biasa... dia memintaku untuk meninggalkannya."
      Speaker = "Melinoe"
      Event = "HecateAboutHades01_B"
    }
    {
      Id = "Melinoe_3456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru, ada pesan dari ayahku yang diminta untuk kusampaikan: Beliau menitipkan rasa terima kasihnya yang terdalam..."
      Speaker = "Melinoe"
      Event = "HecateAboutHades02"
    }
    {
      Id = "Hecate_0654"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Hades berkata begitu kepadamu? {#Emph}Untuk apa coba? {#Prev}Dia {#Emph}membusuk {#Prev}di penjaranya sendiri selagi sang Titan menjarah wilayah kekuasaannya! Tugasku adalah melindungi alam ini dan aku telah gagal."
      Speaker = "Hecate"
      Event = "HecateAboutHades02"
    }
    {
      Id = "Melinoe_3457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah berbicara tentang saat dia menitipkanku dalam asuhan Guru, ketika Chronos menyerang. Dia pasti mencemaskan kemungkinan terburuk. Sekarang dia tahu aku baik-baik saja... ini semua berkat Guru."
      Speaker = "Melinoe"
      Event = "HecateAboutHades02"
    }
    {
      Id = "Hecate_0655"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, Melinoë, semua ini terjadi karena ulah {#Emph}Chronos. {#Prev}Ayahmu sebaiknya menyimpan rasa terima kasihnya sebelum kita menyelesaikan perhitungan lama. Tapi... jangan bicarakan tanggapanku yang... memalukan ini padanya. Aku hanya terkejut tadi."
      Speaker = "Hecate"
      Event = "HecateAboutHades02"
    }
    {
      Id = "Melinoe_3458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja. Aku mengerti."
      Speaker = "Melinoe"
      Event = "HecateAboutHades02"
    }
    {
      Id = "Melinoe_2909"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di tepi Mourning Fields... aku berhadapan dengan sejenis binatang buas gelap dari neraka. Tiga moncong anjing raksasa, melolong penuh amarah dan duka. Itu anjing tua milik ayahku... milik {#Emph}keluargaku{#Prev}... kan?"
      Speaker = "Melinoe"
      Event = "HecateAboutCerberus01"
    }
    {
      Id = "Hecate_0628"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari Odysseus, kami menerima beberapa laporan mengenai makhluk yang kurang lebih cocok dengan deskripsi itu, tapi... Cerberus berwarna {#Emph}merah{#Prev}, semerah darah. Kendati demikian, berdiam lama di dalam Fields bisa membawa efek perubahan bentuk. {#Emph}Cih{#Prev}, makhluk malang. Direnggut dari rumahnya sendiri."
      Speaker = "Hecate"
      Event = "HecateAboutCerberus01"
    }
    {
      Id = "Melinoe_2910"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia tampak tak mengenali siapa diriku. Entah karena sudah terlalu lama, atau terlalu banyak hal yang membebani pikirannya. Pikiran-pikirannya? Tapi aku merasakan sekilas ada tatapan mengenali. Dia belum hilang akal sepenuhnya, kan...?"
      Speaker = "Melinoe"
      Event = "HecateAboutCerberus01"
    }
    {
      Id = "Hecate_0629"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sifat alami binatang buas takkan pernah berubah. Namun sama seperti kita, terkadang mereka harus melawan para Daemon yang menyiksa mereka... pertarungan di mana kau bisa membantu! Percayalah pada latihanmu, dan mungkin dia masih bisa melepaskan diri dari sihir yang merasukinya."
      Speaker = "Hecate"
      Event = "HecateAboutCerberus01"
    }
    {
      Id = "Melinoe_2911"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku yakin dia bisa."
      Speaker = "Melinoe"
      Event = "HecateAboutCerberus01"
    }
    {
      Id = "Hecate_0666"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau belum juga berhasil lolos dari Mourning Fields. Monster yang menjaga pintu masuk Tartarus seolah mustahil ditaklukkan. Itulah pengaruh dari Padang tersebut."
      Speaker = "Hecate"
      Event = "HecateAboutCerberus02"
    }
    {
      Id = "Melinoe_3468"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harapan apa pun yang kumiliki terkuras begitu saja saat aku melangkah ke sana. Aku tahu itu cuma tipuan pikiran, tapi..."
      Speaker = "Melinoe"
      Event = "HecateAboutCerberus02"
    }
    {
      Id = "Hecate_0667"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...tapi tipuan yang amat ampuh, aku tahu."
      Speaker = "Hecate"
      Event = "HecateAboutCerberus02"
    }
    {
      Id = "Melinoe_0946"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, Yang Mulia Zeus meminta {#Emph}laporan berkala yang cepat{#Prev}, persis kata-katanya, darimu mengenai situasi di Underworld. Dia tampak sedikit gusar. Memintaku menyampaikannya padamu."
      Speaker = "Melinoe"
      Event = "HecateAboutZeus01"
    }
    {
      Id = "Hecate_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau selalu patuh seperti biasa, bukan? Persis seperti yang diinginkan Yang Mulia Zeus dari kita. Kaupikir dia benar-benar peduli dengan laporan-laporan Underworld ini?"
      Speaker = "Hecate"
      Event = "HecateAboutZeus01"
    }
    {
      Id = "Melinoe_0947"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... belum memikirkan kemungkinan itu. Beliau tipe orang yang ingin tahu segala kejadian yang sedang berlangsung, terutama yang berbahaya baginya."
      Speaker = "Melinoe"
      Event = "HecateAboutZeus01"
    }
    {
      Id = "Hecate_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat! Dia menjadi gelisah saat keheningan merayap. Dia akan mendapatkan laporan cepatnya; tapi ingat, dia sudah {#Emph}punya {#Prev}seorang pembawa pesan."
      Speaker = "Hecate"
      Event = "HecateAboutZeus01"
    }
    {
      Id = "Melinoe_1592"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, aku bertemu Artemis di luar sana. Aku tak menyangka dia datang secepat itu, tapi ya, dia memang gesit. Omong-omong, bagaimana dengan Hermes, ada kabar?"
      Speaker = "Melinoe"
      Event = "HecateAboutArtemis01"
    }
    {
      Id = "Hecate_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayangnya belum. Namun, mereka berdua banyak akal dan berhati-hati... dan Olympus masih belum tahu-menahu soal hubungan lama kita dengan mereka, jika memang itu yang kaucemaskan."
      Speaker = "Hecate"
      Event = "HecateAboutArtemis01"
    }
    {
      Id = "Melinoe_1593"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang kucemaskan adalah keselamatan mereka. Semoga Hermes segera mengetahui rencana Chronos yang sebenarnya dan kembali, meski aku tahu kita tak punya waktu untuk menunggu."
      Speaker = "Melinoe"
      Event = "HecateAboutArtemis01"
    }
    {
      Id = "Hecate_0418"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar, kita tak bisa menunggu. Hermes telah meyakinkanku soal itu."
      Speaker = "Hecate"
      Event = "HecateAboutArtemis01"
    }
    {
      Id = "Hecate_0747"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang dewi perburuan memutuskan bahwa pemanfaatan terbaik dari bakatnya saat ini adalah menghibur kita dengan nyanyian! Seperti yang kaudengar, aku berhasil menahan keinginanku untuk melarang hal semacam itu."
      Speaker = "Hecate"
      Event = "HecateAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_4039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bersyukur kau tak melarangnya. Aku tahu Artemis bernyanyi untuk menjernihkan pikiran dan menenangkan diri, tapi kurasa semua Shade di sekitar tempat ini juga menikmatinya."
      Speaker = "Melinoe"
      Event = "HecateAboutArtemisSinging01"
    }
    {
      Id = "Hecate_0748"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan cara yang kupilih untuk menghadapi kesulitan, meski aku {#Emph}selalu {#Prev}terbuka pada teknik apa pun yang berhasil."
      Speaker = "Hecate"
      Event = "HecateAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_1173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hermes sudah kembali, Kepala Sekolah. Dia sempat meminjamkan kecepatannya, dan... juga memintaku datang membantu Olympus. Apakah situasinya di atas sana sudah segenting itu?"
      Speaker = "Melinoe"
      Event = "HecateAboutHermes01"
    }
    {
      Id = "Hecate_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia takkan meminta jika tidak terpaksa. Tentu saja, ini merumitkan tugas kita. Namun pandanganku tetap, kau belum siap untuk permukaan. Aku takkan mencabut segel yang menghalangi jalan itu."
      Speaker = "Hecate"
      Event = "HecateAboutHermes01"
    }
    {
      Id = "Melinoe_1174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan jika aku mencabutnya sendiri? Aku pernah melihatmu melakukannya."
      Speaker = "Melinoe"
      Event = "HecateAboutHermes01"
    }
    {
      Id = "Hecate_0424"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, kau sudah lebih siap daripada sekarang."
      Speaker = "Hecate"
      Event = "HecateAboutHermes01"
    }
    {
      Id = "Hecate_0715"
      InheritFrom = "BaseNarrative"
      DisplayName = "Laporan para Shade kepada Odysseus mengisyaratkan Athena sendiri menampakkan diri di hadapanmu di sini? Maksudku bukan di {#Emph}sini{#Prev}, tapi di Underworld. Apakah itu sesuatu yang patut kupercaya, atau tidak?"
      Speaker = "Hecate"
      Event = "HecateAboutAthena01"
    }
    {
      Id = "Melinoe_3902"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau patut memercayainya. Athena memberiku Jimat Gorgon miliknya, yang dengannya dia bisa menemukanku jauh dari tempat kediamannya yang biasa. Kuharap aku tak terlalu merepotkannya."
      Speaker = "Melinoe"
      Event = "HecateAboutAthena01"
    }
    {
      Id = "Hecate_0716"
      InheritFrom = "BaseNarrative"
      DisplayName = "Athena tak bisa pergi sesuka hatinya, tak peduli bagaimana kelihatannya. Namun kini kau jelas punya ikatan yang lebih kuat dengannya. Dan dia, pada gilirannya, punya sarana untuk mengawasimu."
      Speaker = "Hecate"
      Event = "HecateAboutAthena01"
    }
    {
      Id = "Melinoe_3903"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maksudmu mengawasi {#Emph}dan melindungiku{#Prev}...?"
      Speaker = "Melinoe"
      Event = "HecateAboutAthena01"
    }
    {
      Id = "Hecate_0717"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia punya tugasnya sendiri, begitu pula kau."
      Speaker = "Hecate"
      Event = "HecateAboutAthena01"
    }
    {
      Id = "Melinoe_3134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, pasti ada yang bisa kita perbuat untuk Arachne. Kutukannya menyiksanya tiada henti. Apa gunanya ilmu kita jika kita tak bisa meringankan penderitaan seorang sahabat?"
      Speaker = "Melinoe"
      Event = "HecateAboutArachne01"
    }
    {
      Id = "Hecate_0551"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nasib Arachne bukan hakmu untuk kauubah. Itu urusan antara dirinya dan Athena. Kusarankan jangan ikut campur."
      Speaker = "Hecate"
      Event = "HecateAboutArachne01"
    }
    {
      Id = "Melinoe_3135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana... kau bisa tahu itu urusan antara dirinya dan Athena?"
      Speaker = "Melinoe"
      Event = "HecateAboutArachne01"
    }
    {
      Id = "Hecate_0552"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak suka dengan nada menuduhmu itu, Melinoë."
      Speaker = "Hecate"
      Event = "HecateAboutArachne01"
    }
    {
      Id = "Melinoe_3136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisakah kau membantuku mencari tahu siapa yang menciptakan kutukan Arachne, jika memang bukan Athena sendiri pelakunya?"
      Speaker = "Melinoe"
      Event = "HecateAboutArachne02"
    }
    {
      Id = "Hecate_0553"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengapa tidak kautanyakan saja pada {#Emph}dia {#Prev}alih-alih padaku? Aku tahu tangannya sedang penuh, mencegah kehancuran Olympus... tapi pastinya dia bisa meluangkan sedikit waktu untukmu."
      Speaker = "Hecate"
      Event = "HecateAboutArachne02"
    }
    {
      Id = "Hecate_0554"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengenai kawanmu si Arachne dan kutukannya: Terlepas dari pertimbangan pribadiku... aku telah menyelidikinya, dan mengetahui siapa yang meracik racun tersebut."
      Speaker = "Hecate"
      Event = "HecateAboutArachne03"
    }
    {
      Id = "Melinoe_3137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Luar biasa! Terima kasih, Kepala Sekolah! Siapa yang bertanggung jawab atas hal itu?"
      Speaker = "Melinoe"
      Event = "HecateAboutArachne03"
    }
    {
      Id = "Hecate_0555"
      InheritFrom = "BaseNarrative"
      DisplayName = "Urusan itu murni antara diriku dan laba-laba itu. Kerahasiaan mutlak diperlukan dalam hal semacam ini. Jika kau masih ingin menjadi perantara, beri tahu dia untuk menemuiku di sini."
      Speaker = "Hecate"
      Event = "HecateAboutArachne03"
    }
    {
      Id = "Melinoe_3138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah... {#Emph}kau {#Prev}yang mengutuk sahabatku... meracuninya! Kau mengajariku untuk tak cepat menghakimi, jadi tolong beri tahu alasannya..."
      Speaker = "Melinoe"
      Event = "HecateAboutArachne04"
    }
    {
      Id = "Hecate_0593"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pahamilah, kesetiaanku terikat kuat pada para dewa, bukan pada manusia fana yang sombong. Kau tak mengenal Arachne di masa lalu; dia telah direndahkan dalam wujudnya yang sekarang."
      Speaker = "Hecate"
      Event = "HecateAboutArachne04"
    }
    {
      Id = "Melinoe_3139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu dia sudah memetik pelajarannya! Tolong bantu aku mengembalikannya ke wujud semula."
      Speaker = "Melinoe"
      Event = "HecateAboutArachne04"
    }
    {
      Id = "Hecate_0594"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kukatakan, ini urusan antara dia dan Athena! Dari pihakku, aku hanya bisa menyampaikan penyesalan... kepadamu, juga kepadanya. Mungkin seiring waktu Athena sendiri bisa luluh."
      Speaker = "Hecate"
      Event = "HecateAboutArachne04"
    }
    {
      Id = "Melinoe_3140"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi... {#Emph}<mendengus>"
      Speaker = "Melinoe"
      Event = "HecateAboutArachne04"
    }
    {
      Id = "Hecate_0851"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hutan punya mata dan telinga, maka aku tahu Arachne dan Athena akhirnya menuntaskan perselisihan mereka. Setidaknya sejauh yang mereka bisa."
      Speaker = "Hecate"
      Event = "HecateAboutArachne05"
    }
    {
      Id = "Melinoe_5291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arachne selalu memegang teguh harga dirinya, tapi... kurasa dia sudah menemukan semacam ketenteraman."
      Speaker = "Melinoe"
      Event = "HecateAboutArachne05"
    }
    {
      Id = "Hecate_0852"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga memang demikian. Seiring waktu, rasa dendam dan hinaan tertanam begitu dalam di daging; di lubuk hati. Dan tak mudah untuk mencabutnya. Namun mereka berdua cukup keras kepala untuk melakukannya."
      Speaker = "Hecate"
      Event = "HecateAboutArachne05"
    }
    {
      Id = "Melinoe_2513"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak menyangka Lady Medea masih ditempatkan di Ephyra, Guru. Tak disangka bahkan penyihir seberpengalaman beliau pun tak sanggup mencegah runtuhnya kota itu."
      Speaker = "Melinoe"
      Event = "HecateAboutMedea01"
    }
    {
      Id = "Hecate_0588"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan tanggung jawabnya untuk mencegah hal itu. Medea ada di sana untuk membaur dengan warga setempat. Tampaknya dia malah kian berhasil melakukannya sekarang, mengingat sebagian besar dari mereka sudah binasa. Dia membantumu dengan caranya sendiri, bukan?"
      Speaker = "Hecate"
      Event = "HecateAboutMedea01"
    }
    {
      Id = "Melinoe_2514"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang demikian, benar."
      Speaker = "Melinoe"
      Event = "HecateAboutMedea01"
    }
    {
      Id = "Hecate_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar Medea di permukaan belakangan ini menurut pengamatanmu? Bersenang-senang menurut pengakuannya sendiri, dan Saudari Selene tampaknya beranggapan sama! Mungkin aku tak perlu heran."
      Speaker = "Hecate"
      Event = "HecateAboutMedea02"
    }
    {
      Id = "Melinoe_2515"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lady Medea tampak sangat nyaman di tengah segala kematian dan kebusukan, yang menjadi bahan penelitiannya. Beliau selalu sibuk meracik satu kutukan demi kutukan lain. Apakah itu mengkhawatirkan?"
      Speaker = "Melinoe"
      Event = "HecateAboutMedea02"
    }
    {
      Id = "Hecate_0590"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekhawatiranku hanyalah demi keselamatannya, dan terdengar seolah dia baik-baik saja untuk saat ini. Asalkan {#Emph}penelitiannya {#Prev}itu tidak berbalik menghantuinya dalam waktu dekat."
      Speaker = "Hecate"
      Event = "HecateAboutMedea02"
    }
    {
      Id = "Melinoe_2516"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan terus memantau keadaannya."
      Speaker = "Melinoe"
      Event = "HecateAboutMedea02"
    }
    {
      Id = "Hecate_1008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Medea memberitahuku bahwa kalian berdua sempat berselisih belakangan ini, namun dia memintaku untuk tak perlu cemas. Tampaknya kehendak Sang Malam-lah yang memicunya!"
      Speaker = "Hecate"
      Event = "HecateAboutMedeaAltFight01"
    }
    {
      Id = "Melinoe_5815"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lady Medea berkata benar, meski aku tak menyangka beliau berpihak pada Kiklops Polyphemus dalam perselisihan kami. Jadi, bukan Guru yang memerintahkannya untuk mengujiku?"
      Speaker = "Melinoe"
      Event = "HecateAboutMedeaAltFight01"
    }
    {
      Id = "Hecate_1009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memerintahkannya untuk mematuhi Sumpah, dan tampaknya dia melaksanakannya. Yah, setidaknya itu cara yang bagus untuk membakar semangat kerjanya."
      Speaker = "Hecate"
      Event = "HecateAboutMedeaAltFight01"
    }
    {
      Id = "Melinoe_5816"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Juga semangatnya terhadap sesosok Kiklops..."
      Speaker = "Melinoe"
      Event = "HecateAboutMedeaAltFight01"
    }
    {
      Id = "Hecate_0856"
      InheritFrom = "BaseNarrative"
      DisplayName = "Taktisi kita telah memutuskan untuk pamit undur diri sejenak. Berangkat menuntaskan beberapa urusan pribadinya, begitu katanya. Waktu yang tepat, kurasa."
      Speaker = "Hecate"
      Event = "HecateAboutOdysseusWandering01"
    }
    {
      Id = "Melinoe_5294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak terbiasa melihat Odysseus pergi lama. Dia akan kembali, kan? Dia selalu berbakti pada tempat ini."
      Speaker = "Melinoe"
      Event = "HecateAboutOdysseusWandering01"
    }
    {
      Id = "Hecate_0857"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita lihat saja apa keputusannya nanti. Pilihan ada di tangannya."
      Speaker = "Hecate"
      Event = "HecateAboutOdysseusWandering01"
    }
    {
      Id = "Hecate_0984"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu dia sudah berterima kasih kepadamu secara pribadi, namun aku pun ingin menyampaikan rasa terima kasihku karena kau telah membantu Taktisi kita mengatasi beban yang mengganjal pikirannya. Kurasa kita semua di sini dihantui oleh masa lalu masing-masing dengan berbagai cara."
      Speaker = "Hecate"
      Event = "HecateAboutOdysseusReturn01"
    }
    {
      Id = "Melinoe_5794"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus yang menuntaskan segalanya. Aku hanya mengatur beberapa pertemuan di mana jarak sempat menjadi kendala. Meski begitu, aku tahu lebih baik menghindari sihir kita untuk urusan seperti itu."
      Speaker = "Melinoe"
      Event = "HecateAboutOdysseusReturn01"
    }
    {
      Id = "Hecate_0985"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau tak menggunakan sihir kita untuk mengubah hasil akhir dari pertemuan-pertemuan itu, maka kau tidak melanggar batas. Bagi Odysseus sendiri, dia terlihat jauh lebih lega, setelah akhirnya berani menghadapi persoalan yang belum tuntas itu... dan mungkin akhirnya berhasil melayarinya."
      Speaker = "Hecate"
      Event = "HecateAboutOdysseusReturn01"
    }
    {
      Id = "Melinoe_5795"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku senang mendengarnya."
      Speaker = "Melinoe"
      Event = "HecateAboutOdysseusReturn01"
    }
    {
      Id = "Melinoe_3464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bertemu Sang Penyihir Circe dalam perjalananku menuju Olympus; atau tepatnya, dia yang menemukanku. Beliau tak berubah sedikit pun dari yang kuingat. Guru menugaskannya untuk mengawasi lautan?"
      Speaker = "Melinoe"
      Event = "HecateAboutCirce01"
    }
    {
      Id = "Hecate_0661"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Selene takut air bagaikan kucing, sedangkan Circe berasal dari laut. Maka ini menjadi kesepakatan yang bagus selama ini. Aku percaya khasiat sihir Circe masih tetap ampuh?"
      Speaker = "Hecate"
      Event = "HecateAboutCirce01"
    }
    {
      Id = "Melinoe_3465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beliau sangat luar biasa membantu."
      Speaker = "Melinoe"
      Event = "HecateAboutCirce01"
    }
    {
      Id = "Hecate_0662"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita memiliki sedikit kendala kepegawaian dengan Sang Penyihir Circe. Pulaunya berada di posisi strategis untuk mengintai armada musuh, dan laporannya seharusnya langsung diserahkan kepada Odysseus. Sayangnya laporannya malah masuk kepadaku."
      Speaker = "Hecate"
      Event = "HecateAboutCirce02"
    }
    {
      Id = "Melinoe_3466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesenjangan komunikasi. Atas izinmu, Guru, aku bisa memberitahukan protokol yang benar kepadanya saat kami bertemu nanti."
      Speaker = "Melinoe"
      Event = "HecateAboutCirce02"
    }
    {
      Id = "Hecate_0663"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan ungkit masalah ini kepadanya sama sekali. Aku mengangkat topik ini semata agar kau waspada. Circe telah lama menjadi aset dan sekutu yang berharga. Kunjunganmu ke pulaunya bisa membantu menjaga hubungan baik itu."
      Speaker = "Hecate"
      Event = "HecateAboutCirce02"
    }
    {
      Id = "Melinoe_3467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dimengerti."
      Speaker = "Melinoe"
      Event = "HecateAboutCirce02"
    }
    {
      Id = "Melinoe_3899"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru, aku melihat Icarus di atas sana, dalam perjalananku menuju Olympus. Dia terbang bebas, namun masih bertarung demi kita... berupaya semampunya untuk mengacaukan legiun sang Titan."
      Speaker = "Melinoe"
      Event = "HecateAboutIcarus01"
    }
    {
      Id = "Hecate_0712"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu...? Kau tak perlu berusaha membuatnya tampak baik di mata{#Emph}ku. {#Prev}Penilaianku terhadap kepribadian seseorang tidak perlu memengaruhi pandanganmu."
      Speaker = "Hecate"
      Event = "HecateAboutIcarus01"
    }
    {
      Id = "Melinoe_3900"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya... terkadang aku cemas Guru berpikir dia menelantarkan kita di saat genting, dan memberikan pengaruh buruk terhadap diriku..."
      Speaker = "Melinoe"
      Event = "HecateAboutIcarus01"
    }
    {
      Id = "Hecate_0713"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu mereka-reka isi kepalaku. Kebodohan Icarus muda terbilang sangat sepele jika dibandingkan dengan yang lain. Aku tak menaruh dendam padanya; dia takkan bisa terbang andai aku berniat demikian."
      Speaker = "Hecate"
      Event = "HecateAboutIcarus01"
    }
    {
      Id = "Melinoe_3901"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya, apakah dia masih diterima di sini?"
      Speaker = "Melinoe"
      Event = "HecateAboutIcarus01"
    }
    {
      Id = "Hecate_0714"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika itu memang keinginanmu dan keinginannya..."
      Speaker = "Hecate"
      Event = "HecateAboutIcarus01"
    }
    {
      Id = "Hecate_0986"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada kerutan samar di alismu yang mengkhianati rasa frustrasimu, Melinoë. Aku pun bisa merasakannya di hatimu. Utarakanlah, dan enyahkan beban itu."
      Speaker = "Hecate"
      Event = "HecateAboutComradeQuests01"
    }
    {
      Id = "Melinoe_5796"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku hanya sedang memikirkan soal kutukan. Diubah menjadi laba-laba... dipaksa mengulangi semua perkataan orang... terjebak selamanya menatap pantulan diri sendiri. Sihir seperti milik kita mampu menimbulkan penderitaan semacam itu, tapi tak bisa mencabutnya?"
      Speaker = "Melinoe"
      Event = "HecateAboutComradeQuests01"
    }
    {
      Id = "Hecate_0987"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu penderitaan yang spesifik nan aneh dari rekan-rekanmu itu. Katakan padaku, apakah mereka masih menderita? Ataukah kau telah menolong mereka semampumu, tanpa hanya bergantung pada sihir kita semata?"
      Speaker = "Hecate"
      Event = "HecateAboutComradeQuests01"
    }
    {
      Id = "Melinoe_5797"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti ada lebih banyak hal yang bisa kulakukan untuk mereka, andai aku tak menahan diri dalam mengerahkan seluruh kemampuanku."
      Speaker = "Melinoe"
      Event = "HecateAboutComradeQuests01"
    }
    {
      Id = "Hecate_0988"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa saja bertindak gegabah, ya. Namun kau memilih menahan diri. Bukankah itu yang terbaik dalam urusan menyangkut orang-orang yang kita pedulikan? Kau membantu mereka agar tak lagi terkekang oleh kutukan itu, dan memberi mereka kekuatan baru."
      Speaker = "Hecate"
      Event = "HecateAboutComradeQuests01"
    }
    {
      Id = "Melinoe_5798"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana Guru bisa seyakin itu? Aku bahkan belum menyebut siapa yang kumaksud."
      Speaker = "Melinoe"
      Event = "HecateAboutComradeQuests01"
    }
    {
      Id = "Hecate_0989"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë, aku bisa menebaknya. Dan aku pun tahu rekan-rekanmu sangat berterima kasih atas semua yang telah kau perbuat."
      Speaker = "Hecate"
      Event = "HecateAboutComradeQuests01"
    }
    {
      Id = "Melinoe_5799"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru berkata begitu hanya untuk menghiburku."
      Speaker = "Melinoe"
      Event = "HecateAboutComradeQuests01"
    }
    {
      Id = "Hecate_0990"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang benar. Namun itu juga kenyataannya."
      Speaker = "Hecate"
      Event = "HecateAboutComradeQuests01"
    }
    {
      Id = "Hecate_0991"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku patut memujimu, Melinoë... membantu Ahli Taktik kita berdamai dengan hubungan masa lalunya, Arachne dengan kutukannya, Arwah pengikutmu itu dengan ingatannya, dan masih banyak lagi. Kau sebenarnya bisa saja hanya berfokus pada tugasmu."
      Speaker = "Hecate"
      Event = "HecateAboutComradeQuests02"
    }
    {
      Id = "Melinoe_5800"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukankah Guru lebih menyukai hal itu, Kepala Sekolah? Saat mencoba menolong rekan-rekanku, terkadang aku merasa ada yang keliru dengan tindakanku. Terlebih lagi, aku bahkan tak bisa menuntaskan masalah mereka. Tidak sepenuhnya..."
      Speaker = "Melinoe"
      Event = "HecateAboutComradeQuests02"
    }
    {
      Id = "Hecate_0992"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada masalah-masalah yang berakar begitu dalam hingga menyatu menjadi bagian dari diri kita. Hal-hal seperti itu tak bisa diselesaikan, melainkan diterima dan dipahami. Rekan-rekanmu mungkin takkan pernah mencapainya tanpa bantuanmu, setidaknya tidak dalam waktu dekat."
      Speaker = "Hecate"
      Event = "HecateAboutComradeQuests02"
    }
    {
      Id = "Melinoe_5801"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jiwa-jiwa yang tersesat harus terlebih dahulu menerima bahwa mereka tersesat{#Prev}, begitu yang biasa Guru katakan. Rupanya itu berlaku bukan hanya bagi para Arwah di Erebus, ya..."
      Speaker = "Melinoe"
      Event = "HecateAboutComradeQuests02"
    }
    {
      Id = "Hecate_0993"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Kau adalah Putri Underworld, dan kau dianugerahi bakat istimewa. Bukan kecakapan sihirmu, karena itu kau pelajari dengan bersusah payah. Melainkan caramu menginspirasi orang lain untuk percaya pada diri mereka sendiri... begitu pula padamu."
      Speaker = "Hecate"
      Event = "HecateAboutComradeQuests02"
    }
    {
      Id = "Melinoe_5802"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rekan-rekanku bertekad kuat... rasanya sulit dipercaya kalau aku yang menginspirasi mereka."
      Speaker = "Melinoe"
      Event = "HecateAboutComradeQuests02"
    }
    {
      Id = "Hecate_0994"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kau adalah seorang dewi. {#Prev}Jangan remehkan pencapaianmu sendiri, terlebih lagi di hadapanku."
      Speaker = "Hecate"
      Event = "HecateAboutComradeQuests02"
    }
    {
      Id = "Melinoe_5803"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah. Dan terima kasih."
      Speaker = "Melinoe"
      Event = "HecateAboutComradeQuests02"
    }
    {
      Id = "Hecate_0995"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami semualah yang berterima kasih {#Emph}padamu."
      Speaker = "Hecate"
      Event = "HecateAboutComradeQuests02"
    }
    {
      Id = "Hecate_0996"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau merapal mantra Pengembalian Ingatan Terpendam pada Arwah kawanmu yang masih mendiami kediamanmu itu. Kau yakin dia memang menginginkannya, dan telah siap menghadapi kebenaran?"
      Speaker = "Hecate"
      Event = "HecateAboutDoraQuest01"
    }
    {
      Id = "Melinoe_5804"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku jarang sekali melihat Dora begitu menginginkan sesuatu, dan dia memiliki jiwa yang tangguh. Tunggu, apakah Guru tahu tentang masa lalunya?"
      Speaker = "Melinoe"
      Event = "HecateAboutDoraQuest01"
    }
    {
      Id = "Hecate_0997"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat menaruh curiga, tapi bukanlah hakku untuk membicarakannya. Kerumitan antara para dewa dan manusia fana telah bermula sejak lama, dan kini tak mudah untuk diurai kembali, jika memang bisa."
      Speaker = "Hecate"
      Event = "HecateAboutDoraQuest01"
    }
    {
      Id = "Melinoe_5805"
      InheritFrom = "BaseNarrative"
      DisplayName = "Haruskah kuterima begitu saja bahwa keluargaku mungkin bertindak sedemikian ceroboh atau kejam kepada mereka yang mendongak memuja para dewa? Mungkin Prometheus memang benar soal kita, para dewa."
      Speaker = "Melinoe"
      Event = "HecateAboutDoraQuest01"
    }
    {
      Id = "Hecate_0998"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prometheus melontarkan kecaman yang terlalu digeneralisasi. Hiduplah cukup lama, Melinoë, dan kau pun kelak akan membuat keputusan-keputusan yang kau sesali. Dora jelas mengalaminya! Beberapa kerabatmu pasti juga begitu. Yang bisa kita lakukan hanyalah memetik pelajaran, lalu melangkah maju jika mampu."
      Speaker = "Hecate"
      Event = "HecateAboutDoraQuest01"
    }
    {
      Id = "Melinoe_5806"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru bilang {#Emph}beberapa {#Prev}dari kerabatku. Apa menurut Guru yang lainnya mungkin bernasib seperti Dora dulu... tak menyadari kesalahan di masa lalu?"
      Speaker = "Melinoe"
      Event = "HecateAboutDoraQuest01"
    }
    {
      Id = "Hecate_0999"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir mereka tak bisa terus memikirkannya, terutama belakangan ini, dengan pelajaran-pelajaran yang lebih keras dari masa lalu kini lebih mendesak. Mungkin suatu saat nanti, kau akan membantu kerabatmu berdamai dengan semua ini. Saat mereka siap menghadapi kebenaran mereka sendiri."
      Speaker = "Hecate"
      Event = "HecateAboutDoraQuest01"
    }
    {
      Id = "Melinoe_5807"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah bodoh dan naif bagiku jika ingin mencobanya?"
      Speaker = "Melinoe"
      Event = "HecateAboutDoraQuest01"
    }
    {
      Id = "Hecate_1000"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Justru aku yang bodoh dan naif andai berkata demikian."
      Speaker = "Hecate"
      Event = "HecateAboutDoraQuest01"
    }
    {
      Id = "Hecate_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu mengingatkanku pada ayahmu, Melinoë, namun akhir-akhir ini kau semakin mengingatkanku pada ibumu... kian hari kian serupa. Rasa kepedulian pada orang lain yang sesekali kau perlihatkan... bisa menjadi kelemahan yang mudah dimanfaatkan."
      Speaker = "Hecate"
      Event = "HecateAboutFamily01"
    }
    {
      Id = "Melinoe_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan pernah mendahulukan kepedulian semacam itu di atas tugasku, Kepala Sekolah."
      Speaker = "Melinoe"
      Event = "HecateAboutFamily01"
    }
    {
      Id = "Hecate_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pastikan kau tepati itu! Kendati demikian, ucapanku tadi bukan bermaksud mencelamu; merupakan kehormatan bagiku pernah mengenal keluargamu... meski hanya dari balik bayang-bayang."
      Speaker = "Hecate"
      Event = "HecateAboutFamily01"
    }
    {
      Id = "Melinoe_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka akan terbalaskan."
      Speaker = "Melinoe"
      Event = "HecateAboutFamily01"
    }
    {
      Id = "Hecate_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pembalasan dendam bagi keluargamu menantimu, jauh di dasar sana. Aku yakin mereka pasti bangga melihat dirimu yang sekarang. Ingatlah mereka di dalam hatimu saat kau menghantam musuh."
      Speaker = "Hecate"
      Event = "HecateAboutFamily02"
    }
    {
      Id = "Melinoe_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru, aku akan selalu mengingat mereka di hatiku, tapi... aku tak punya kenangan sama sekali tentang mereka. Bagaimana mungkin punya? Kaulah sosok yang selalu ada untukku selama ini."
      Speaker = "Melinoe"
      Event = "HecateAboutFamily02"
    }
    {
      Id = "Hecate_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Augh{#Prev}, jangan bicara begitu; aku {#Emph}bukan {#Prev}ibumu, Melinoë. Begitu banyak hal yang bisa dia ajarkan kepadamu, yang tak bisa kuberikan. Jangan pernah membandingkan kami."
      Speaker = "Hecate"
      Event = "HecateAboutFamily02"
    }
    {
      Id = "Melinoe_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "A... aku paham."
      Speaker = "Melinoe"
      Event = "HecateAboutFamily02"
    }
    {
      Id = "Melinoe_3459"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lukisan keluarga di tendaku... belakangan ini aku semakin memikirkannya. Aku... belum pernah menanyakan dari mana kau mendapatkannya."
      Speaker = "Melinoe"
      Event = "HecateAboutFamilyPortrait01"
    }
    {
      Id = "Hecate_0656"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malah akan lebih aneh jika kau tak menanyakannya, padahal jawabannya sudah cukup jelas bagimu. Namun, kau ingin tahu keadaannya saat itu?"
      Speaker = "Hecate"
      Event = "HecateAboutFamilyPortrait01"
    }
    {
      Id = "Melinoe_3460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Iya, Guru, jika berkenan. Aku tahu itu masa lalu yang tak pernah ingin kau ingat kembali, tapi ini sangat penting bagiku."
      Speaker = "Melinoe"
      Event = "HecateAboutFamilyPortrait01"
    }
    {
      Id = "Hecate_0657"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak meragukan hal itu. Saat Chronos menyerbu Kediaman ayahmu, aku melarikan diri hanya dengan membawa tiga hal: Hypnos, karena dia ada di sana; lukisan keluarga itu, yang begitu menyentuh hatiku; dan dirimu."
      Speaker = "Hecate"
      Event = "HecateAboutFamilyPortrait01"
    }
    {
      Id = "Melinoe_3461"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya tiga hal itu...?"
      Speaker = "Melinoe"
      Event = "HecateAboutFamilyPortrait01"
    }
    {
      Id = "Hecate_0658"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktuku cuma sekejap, dan wujudku terbagi tiga."
      Speaker = "Hecate"
      Event = "HecateAboutFamilyPortrait01"
    }
    {
      Id = "Hecate_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melihat begitu getolnya kau merapal mantra akhir-akhir ini, aku mesti memperingatkanmu agar jangan memforsir diri. Aku tahu kau ingin menguasai segala mantra dan ilusi di luar kepala, tapi semua itu butuh ruang, dan waktu."
      Speaker = "Hecate"
      Event = "HecateAboutWitchcraft01"
    }
    {
      Id = "Melinoe_1017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menggunakan kawah ini tak lagi menguras tenagaku seperti dulu. Meski begitu, aku tahu tak boleh sampai gegabah."
      Speaker = "Melinoe"
      Event = "HecateAboutWitchcraft01"
    }
    {
      Id = "Hecate_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar sekali, jangan sampai tangan {#Emph}kananmu {#Prev}yang mulus itu bernasib sama dengan tangan kirimu. Walau mungkin arwah pemuda Icarus itu bakal makin menyukaimu jika itu terjadi. Dia sudah lama pergi, kan?"
      Speaker = "Hecate"
      Event = "HecateAboutWitchcraft01"
    }
    {
      Id = "Melinoe_1018"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Iya, memang..."
      Speaker = "Melinoe"
      Event = "HecateAboutWitchcraft01"
    }
    {
      Id = "Hecate_0599"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu urusanmu dengan kawah ini selesai malam ini, mungkin aku sendiri yang akan menggunakannya... azimat pelindung perlu diperbarui, bangsal pertahanan mesti diperkuat..."
      Speaker = "Hecate"
      Event = "HecateAboutCauldronWitchcraft01"
    }
    {
      Id = "Melinoe_2526"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika ada mantra tertentu yang hendak kau rapalkan, apa aku boleh membantu? Entah itu {#Emph}Panggilan Arwah, Perlindungan Dekapan Malam{#Prev}, atau yang lainnya..."
      Speaker = "Melinoe"
      Event = "HecateAboutCauldronWitchcraft01"
    }
    {
      Id = "Hecate_0600"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau punya urusan sendiri yang harus dipikirkan sekarang, Melinoë. Tapi jika kau kebetulan ada di sekitar sini saat aku merapal, suaramu selalu terbuka lebar untuk berpadu denganku."
      Speaker = "Hecate"
      Event = "HecateAboutCauldronWitchcraft01"
    }
    {
      Id = "Melinoe_2527"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersama kita bersinar, Guru."
      Speaker = "Melinoe"
      Event = "HecateAboutCauldronWitchcraft01"
    }
    {
      Id = "Hecate_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, kau memanfaatkan kawah tua kita dengan sangat baik. Aku melihat dan merasakan perubahan di tempat ini. Perubahan demi kebaikan kita semua, bukan hanya dirimu sendiri."
      Speaker = "Hecate"
      Event = "HecateAboutCauldron01"
    }
    {
      Id = "Melinoe_0652"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mantra yang benar tidak boleh digunakan demi kepentingan pribadi. Tapi, jika aku membantu menciptakan perubahan positif yang juga menguntungkanku, bukankah itu tetap terhitung egois?"
      Speaker = "Melinoe"
      Event = "HecateAboutCauldron01"
    }
    {
      Id = "Hecate_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Buang keraguan semacam itu. Kau tidak hanya memikirkan dirimu semata, jadi kau sama sekali tidak egois. Aku tak pernah mengajarimu untuk mengabaikan kebutuhanmu sendiri, bukan?"
      Speaker = "Hecate"
      Event = "HecateAboutCauldron01"
    }
    {
      Id = "Melinoe_0653"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja tidak."
      Speaker = "Melinoe"
      Event = "HecateAboutCauldron01"
    }
    {
      Id = "Hecate_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah kalau begitu."
      Speaker = "Hecate"
      Event = "HecateAboutCauldron01"
    }
    {
      Id = "Hecate_0718"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih lebih menyukai kawah tua kita. Kawah yang kau dapatkan dengan mengorbankan begitu banyak bintang ini... sihirmu takkan mendadak meningkat secara gaib hanya karenanya."
      Speaker = "Hecate"
      Event = "HecateAboutAltCauldron01"
    }
    {
      Id = "Melinoe_3904"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita masih menyimpan kawah lama itu, tentu saja. Katakan saja sepatah kata dan aku bisa langsung mengembalikannya! Sedangkan untuk yang ini, awal yang baru bisa membuahkan hasil yang luar biasa, bukan begitu?"
      Speaker = "Melinoe"
      Event = "HecateAboutAltCauldron01"
    }
    {
      Id = "Hecate_0719"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, jika bongkahan logam mewah ini bisa menginspirasimu untuk melakukan hal-hal yang lebih hebat, berarti sepadan dengan nilainya! Aku takkan memintamu mengembalikannya seperti semula. Dan bahkan jika kuminta, ikuti naluri {#Emph}milikmu{#Prev}, bukan naluriku."
      Speaker = "Hecate"
      Event = "HecateAboutAltCauldron01"
    }
    {
      Id = "Melinoe_3905"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku juga memercayai nalurimu."
      Speaker = "Melinoe"
      Event = "HecateAboutAltCauldron01"
    }
    {
      Id = "Hecate_0720"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kawah yang cukup menawan dan berwibawa. Mungkin lebih cocok untuk beberapa keahlian khusus... pemanggilan iblis, kutukan, dan semacamnya. Apa kau berniat untuk mengambil spesialisasi lebih jauh?"
      Speaker = "Hecate"
      Event = "HecateAboutAltCauldron02"
    }
    {
      Id = "Melinoe_3906"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum tentu, Guru. Aku... masih punya banyak ide berbeda, terkadang muncul beberapa ide sekaligus dalam satu malam. Mimpiku adalah menguasai segala dimensi dari ilmu sihir kita."
      Speaker = "Melinoe"
      Event = "HecateAboutAltCauldron02"
    }
    {
      Id = "Hecate_0721"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mimpimu{#Prev}, katamu. Masing-masing dari kita punya kecenderungan tersendiri, dan milikmu kelak akan terwujud seiring berjalannya waktu. Tapi aku paham keinginanmu untuk tidak ingin merasa {#Emph}terbatasi{#Prev}, jadi berlatihlah sesukamu. Mau pakai kawah Python ini atau kawah lainnya."
      Speaker = "Hecate"
      Event = "HecateAboutAltCauldron02"
    }
    {
      Id = "Melinoe_3907"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kawah yang pas untuk setiap kesempatan!"
      Speaker = "Melinoe"
      Event = "HecateAboutAltCauldron02"
    }
    {
      Id = "Hecate_0722"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selalu saja jadi sang pemimpi."
      Speaker = "Hecate"
      Event = "HecateAboutAltCauldron02"
    }
    {
      Id = "Melinoe_5300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aneh sekali, aku... tak terpikir mantra apa pun untuk dirapal belakangan ini. Maksudku, di depan kawah ini. Apa kau pernah mengalaminya juga?"
      Speaker = "Melinoe"
      Event = "HecateAboutCauldronEmpty01"
    }
    {
      Id = "Hecate_0941"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seberapa sering kau melihatku merapal mantra di kawah? Ini adalah bagian alami dari proses perkembanganmu. Mantra-mantra lain akan mendatangi benakmu pada waktunya, walau mungkin tidak dalam waktu dekat. Aku tahu ini sulit bagimu, tapi jangan terlalu dipikirkan."
      Speaker = "Hecate"
      Event = "HecateAboutCauldronEmpty01"
    }
    {
      Id = "Melinoe_5301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah kalau begitu."
      Speaker = "Melinoe"
      Event = "HecateAboutCauldronEmpty01"
    }
    {
      Id = "Hecate_0723"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membudidayakan berbagai macam tanaman hijau seperti itu. Kita sedang berada di alam orang mati, jangan sampai lupa, Melinoë! Tapi di sinilah kau, malah asyik merawat kebunmu."
      Speaker = "Hecate"
      Event = "HecateAboutGarden01"
    }
    {
      Id = "Melinoe_3908"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada tempat yang lebih baik untuk menanam reagen di alam atas maupun bawah. Tapi lebih dari itu, ini hal kecil yang bisa kunantikan setiap kali aku kembali. Membantu menjaga ketenanganku."
      Speaker = "Melinoe"
      Event = "HecateAboutGarden01"
    }
    {
      Id = "Hecate_0724"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu dijelaskan. Bumi berbaik hati padamu; bijak rasanya memanfaatkan keberuntungan semacam itu."
      Speaker = "Hecate"
      Event = "HecateAboutGarden01"
    }
    {
      Id = "Melinoe_3909"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku hanya meminjam."
      Speaker = "Melinoe"
      Event = "HecateAboutGarden01"
    }
    {
      Id = "Hecate_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kembali dari bayang-bayang memulihkan ragamu, sementara bermeditasi di Altarmu menguatkan jiwamu. Begitu banyak pengetahuan yang terkandung dalam abu masa lalu."
      Speaker = "Hecate"
      Event = "HecateAboutArcana01"
    }
    {
      Id = "Melinoe_0658"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih kesulitan mendalami Arcana, Guru. Jika potensiku sama besarnya dengan para pendahuluku, mengapa aku belum merasakan ikatan yang lebih kuat?"
      Speaker = "Melinoe"
      Event = "HecateAboutArcana01"
    }
    {
      Id = "Hecate_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ikatanmu hanya akan sekuat pemahamanmu. Seseorang akan belajar dari sejarah atau mengulangi kesalahan yang sama. Kusalankan kau memilih yang pertama."
      Speaker = "Hecate"
      Event = "HecateAboutArcana01"
    }
    {
      Id = "Melinoe_0659"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku akan terus belajar."
      Speaker = "Melinoe"
      Event = "HecateAboutArcana01"
    }
    {
      Id = "Hecate_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini perhatianmu semakin terpusat pada Altar lebih dari biasanya. Apakah Arcana memperlihatkan sesuatu yang penting kepadamu?"
      Speaker = "Hecate"
      Event = "HecateAboutArcana02"
    }
    {
      Id = "Melinoe_1169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mulai memandang kartu-kartu itu dari sudut pandang baru... masing-masing menggambarkan pilihan penting di masa lalu. Pengetahuan seperti itu mungkin bisa membantu membuat pilihan yang lebih baik di masa depan."
      Speaker = "Melinoe"
      Event = "HecateAboutArcana02"
    }
    {
      Id = "Hecate_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Kita memilih sebijak mungkin, memanfaatkan pengetahuan yang kita miliki. Jadi, kini kau bisa melihat lebih jelas ke dalam {#Emph}kartu-kartu{#Prev} itu, begitu kau menyebutnya..."
      Speaker = "Hecate"
      Event = "HecateAboutArcana02"
    }
    {
      Id = "Melinoe_0596"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali."
      Speaker = "Melinoe"
      Event = "HecateAboutArcana02"
    }
    {
      Id = "Hecate_0649"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku penasaran apakah kau akan menyucikan Altar Abu itu atas kemauanmu sendiri. Dengan begitu, tempat itu semestinya kian selaras denganmu; rahasia Arcana pun kian dekat dalam genggamanmu."
      Speaker = "Hecate"
      Event = "HecateAboutCardUpgradeSystem01"
    }
    {
      Id = "Melinoe_3453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Altar adalah ambang pintu yang kita semua lewati saat pergi dan pulang ke Persimpangan ini. Gerbang menuju masa lalu, masa kini, dan masa depan. Aku tahu itu bukan milikku seorang; itu milik kita bersama."
      Speaker = "Melinoe"
      Event = "HecateAboutCardUpgradeSystem01"
    }
    {
      Id = "Hecate_0650"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar, untuk ketiga hal itu."
      Speaker = "Hecate"
      Event = "HecateAboutCardUpgradeSystem01"
    }
    {
      Id = "Hecate_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kau menemukan sesuatu yang berguna di luar sana, dalam penjelajahanmu? Tak ada gunanya kembali dengan tangan hampa. Meski kurasa, kau mungkin kekurangan alat yang diperlukan."
      Speaker = "Hecate"
      Event = "HecateAboutResources01"
    }
    {
      Id = "Melinoe_0660"
      InheritFrom = "BaseNarrative"
      DisplayName = "Erebus masih dipenuhi kehidupan tersembunyi. Aku menemukan berbagai macam hal yang kita perlukan di luar sana. Aku sangat berterima kasih atas kantong ini! Sama sekali tak terasa membebani."
      Speaker = "Melinoe"
      Event = "HecateAboutResources01"
    }
    {
      Id = "Hecate_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir tak boleh sampai terbebani. Berkah dan pemberian semacamnya dari kerabatmu mungkin fana, tapi apa pun yang masuk ke dalam kantong itu tak akan ke mana-mana. Tentu saja, sampai kau menggunakannya."
      Speaker = "Hecate"
      Event = "HecateAboutResources01"
    }
    {
      Id = "Melinoe_1022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang ingin kutanyakan, Guru. Mengenai semua reagen yang kukumpulkan, yang kuambil dari Bumi. Dari Ibu Gaia. Bagaimana caraku membalas kebaikannya?"
      Speaker = "Melinoe"
      Event = "HecateAboutResources02"
    }
    {
      Id = "Hecate_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa memulainya dengan tidak tenggelam dalam rasa bersalah yang sia-sia. Apa kau pikir Gaia sudi memperlihatkan kelimpahannya kepadamu jika dia yakin kau takkan memanfaatkannya dengan baik?"
      Speaker = "Hecate"
      Event = "HecateAboutResources02"
    }
    {
      Id = "Melinoe_1023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau mengajariku untuk jangan pernah mengambil lebih dari yang kuperlukan. Sekarang aku malah mengambil segalanya yang tampak di depan mata."
      Speaker = "Melinoe"
      Event = "HecateAboutResources02"
    }
    {
      Id = "Hecate_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan Gaia tahu kau membutuhkan semua itu bahkan lebih. Jangan cemas, hasil jarahanmu akan kembali ke asalnya melalui keahlian sihirmu. Jika bukan ke kebunmu di sana."
      Speaker = "Hecate"
      Event = "HecateAboutResources02"
    }
    {
      Id = "Hecate_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau merasa frustrasi, Melinoë. Mengapa aku tak langsung menyediakan semua reagen yang kau butuhkan saja? Ada begitu banyak mantra yang bisa lebih cepat kau gunakan..."
      Speaker = "Hecate"
      Event = "HecateAboutResources03"
    }
    {
      Id = "Melinoe_1024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu betul jawabannya, Guru. Reagen milikmu memberi kekuatan pada sihirmu, begitu pula milikku pada sihirku. Sifat magisnya hanya bisa didapatkan melalui jerih payah dalam mengumpulkannya."
      Speaker = "Melinoe"
      Event = "HecateAboutResources03"
    }
    {
      Id = "Hecate_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Harus kuakui, terkadang hal itu cukup merepotkan. Namun apa arti sihir kita selain mewujudkan niat kita menjadi nyata? Dan untuk hal itu, tak ada jalan pintas."
      Speaker = "Hecate"
      Event = "HecateAboutResources03"
    }
    {
      Id = "Melinoe_1025"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada jalan pintas."
      Speaker = "Melinoe"
      Event = "HecateAboutResources03"
    }
    {
      Id = "Hecate_0858"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Taktisi memberimu beberapa reagen yang kau perlukan. Namun mengapa bukan aku? Ada begitu banyak mantra yang bisa lebih cepat kau gunakan."
      Speaker = "Hecate"
      Event = "HecateAboutResources03_B"
    }
    {
      Id = "Hecate_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Amfibia kecil pemalas yang kau pelihara itu... apakah mataku salah lihat, atau dia tadi melompat dengan begitu bersemangat menuju jalan keluar?"
      Speaker = "Hecate"
      Event = "HecateAboutFamiliars01"
    }
    {
      Id = "Melinoe_1019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penglihatanmu benar! Aku mengajak Frinos kecil untuk menemaniku dalam upayaku di luar sana. Kau pasti sudah mengajariku cukup banyak jimat dan perlindungan untuk menjaga Familiar tetap selamat, bukan?"
      Speaker = "Melinoe"
      Event = "HecateAboutFamiliars01"
    }
    {
      Id = "Hecate_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita hanya bisa berharap! Dan semoga Familiarmu juga bisa menjaga {#Emph}dirimu{#Prev} tetap aman. Serta mungkin mengais beberapa akar dan tanaman lain untuk kita."
      Speaker = "Hecate"
      Event = "HecateAboutFamiliars01"
    }
    {
      Id = "Hecate_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum lama ini seekor kucing melenggang santai masuk ke suaka kita, seolah dinding bayanganku sama sekali tak ada! Tolong katakan kalau itu Familiar barumu?"
      Speaker = "Hecate"
      Event = "HecateAboutFamiliars02"
    }
    {
      Id = "Melinoe_1020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu Toula, Guru, dan benar! Kupikir aku butuh pendamping yang percaya diri dan mandiri seperti dia."
      Speaker = "Melinoe"
      Event = "HecateAboutFamiliars02"
    }
    {
      Id = "Hecate_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita semua memang butuh. Satwa yang kau percayai dipersilakan berada di sini. Kuharap semua kenalan kita juga sama menyenangkannya saat dipandang..."
      Speaker = "Hecate"
      Event = "HecateAboutFamiliars02"
    }
    {
      Id = "Melinoe_2523"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar Hecuba dan Gale belakangan ini, Guru? Mereka pasti merasa tidak nyaman dengan semua keramaian, orang-orang baru, dan hal serupa lainnya."
      Speaker = "Melinoe"
      Event = "HecateAboutFamiliars03"
    }
    {
      Id = "Hecate_0597"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, mereka baik-baik saja. Anjing dan cerpelai memang paduan yang aneh, tapi mereka sanggup bertahan melewati berbagai kesulitan atau ketidaknyamanan. Terutama saat kau memanjakan mereka dengan perhatianmu!"
      Speaker = "Hecate"
      Event = "HecateAboutFamiliars03"
    }
    {
      Id = "Melinoe_2524_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti suatu malam nanti aku bisa merebut hati mereka!"
      Speaker = "Melinoe"
      Event = "HecateAboutFamiliars03"
    }
    {
      Id = "Hecate_0535"
      InheritFrom = "BaseNarrative"
      DisplayName = "Crossroads ini berkembang pesat berkat proyek {#Emph}pembaruanmu {#Prev}ini. Kau masih sempat mencari kesempatan untuk mewujudkannya bahkan di saat seperti ini?"
      Speaker = "Hecate"
      Event = "HecateAboutCosmetics01"
    }
    {
      Id = "Melinoe_2162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini rumah kita. Tempat ini harus dirawat, bersih, dan indah. Aku mengajak Dora untuk membantuku agar pekerjaannya tidak terbengkalai selamanya."
      Speaker = "Melinoe"
      Event = "HecateAboutCosmetics01"
    }
    {
      Id = "Hecate_0536"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Dora? {#Prev}Belum pernah sekali pun kudengar namanya disandingkan dengan kata {#Emph}bekerja{#Prev}. Tak kusangka kau bisa membujuk hantu {#Emph}yang satu itu {#Prev}untuk berguna."
      Speaker = "Hecate"
      Event = "HecateAboutCosmetics01"
    }
    {
      Id = "Melinoe_2163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia senang bisa membantu."
      Speaker = "Melinoe"
      Event = "HecateAboutCosmetics01"
    }
    {
      Id = "Hecate_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Bayangan di tempat ini ramai membicarakan dukungan mereka untukmu, kau tahu. Kau punya bakat memikat hati mereka. Dan membujuk lebih banyak dari mereka untuk bergabung bersama kita."
      Speaker = "Hecate"
      Event = "HecateAboutShades01"
    }
    {
      Id = "Melinoe_0661"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu mereka hanya manusia biasa, atau makhluk hidup lainnya. Yang mereka butuhkan hanyalah sesuatu untuk dipercaya, dalam kematian maupun kehidupan. Serta jalan keluar dari Erebus."
      Speaker = "Melinoe"
      Event = "HecateAboutShades01"
    }
    {
      Id = "Hecate_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm{#Prev}, begitu rupanya. Mereka bersumpah setia padamu, itu jelas bagiku. Aku sudah melenyapkan mereka semua jika sempat ragu! Mungkin mereka mengira akan mendapat tempat nyaman di Elysium setelah semua ini selesai."
      Speaker = "Hecate"
      Event = "HecateAboutShades01"
    }
    {
      Id = "Melinoe_0662"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupikir lebih dari sekadar itu."
      Speaker = "Melinoe"
      Event = "HecateAboutShades01"
    }
    {
      Id = "Melinoe_5046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, apa yang sedang kau dan Odysseus rencanakan? Dia selalu berkutat dengan peta dan diagramnya."
      Speaker = "Melinoe"
      Event = "HecateAboutSurface01"
    }
    {
      Id = "Hecate_0859"
      InheritFrom = "BaseNarrative"
      DisplayName = "Taktisi kita selalu berencana jauh ke depan. Dia sedang memetakan rute dari pintu masuk Underworld terdekat langsung menuju Olympus, menembus barisan musuh... untuk berjaga-jaga."
      Speaker = "Hecate"
      Event = "HecateAboutSurface01"
    }
    {
      Id = "Melinoe_5047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berjaga-jaga untuk apa...? Aku tak bisa pergi ke sana, dan Chronos ada di arah yang berlawanan. Apakah situasi di Olympus semakin memburuk?"
      Speaker = "Melinoe"
      Event = "HecateAboutSurface01"
    }
    {
      Id = "Hecate_0860"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami masih menunggu kepastian tentang hal itu. Untuk saat ini semua itu hanyalah kemungkinan belaka; bahkan sekadar {#Emph}pengalih perhatian{#Prev}. Tetaplah fokus."
      Speaker = "Hecate"
      Event = "HecateAboutSurface01"
    }
    {
      Id = "Melinoe_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi... {#Emph}mm."
      Speaker = "Melinoe"
      Event = "HecateAboutSurface01"
    }
    {
      Id = "Melinoe_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, jika Olympus sedang dikepung, lalu mengapa aku tidak diizinkan pergi ke permukaan? Jika aku bisa membantu para dewa, mereka bisa membantu kita lebih banyak lagi!"
      Speaker = "Melinoe"
      Event = "HecateAboutSurface02"
    }
    {
      Id = "Hecate_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë, bagaimanapun caramu menyelesaikan tugas ini terserah padamu; aku tak pernah melarangmu ke permukaan. Namun kuperingatkan, jika kau pergi, kekuatanmu akan sirna. Takdir kelahiranmulah penyebabnya; bukan salahmu."
      Speaker = "Hecate"
      Event = "HecateAboutSurface02"
    }
    {
      Id = "Melinoe_0587"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lahir di Underworld dan di sinilah aku bernaung, puji para Fates. Aku tak berniat tinggal di atas sana, aku hanya.... Kau tahu berapa lama aku bisa bertahan?"
      Speaker = "Melinoe"
      Event = "HecateAboutSurface02"
    }
    {
      Id = "Hecate_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang kutahu, kakak dan ayahmu paling lama hanya bertahan sehari sebelum mereka tak sanggup menahannya lagi. Mungkin kau berbeda, tapi jangan terlalu berharap."
      Speaker = "Hecate"
      Event = "HecateAboutSurface02"
    }
    {
      Id = "Melinoe_0588"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Paling lama sehari...?"
      Speaker = "Melinoe"
      Event = "HecateAboutSurface02"
    }
    {
      Id = "Hecate_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah mengunjungi permukaan. Tak terbayangkan olehku betapa buruknya keadaan di {#Emph}sana{#Prev}. Setidaknya kau berhasil kembali hidup-hidup."
      Speaker = "Hecate"
      Event = "HecateAboutSurface03"
    }
    {
      Id = "Melinoe_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya menguras tenaga... bahkan di malam hari, entah mengapa saat berada di bawah bintang-bintang, aku... tidak tahu ada sebanyak itu. Rasanya melebihi apa yang sanggup kutanggung. Kau benar."
      Speaker = "Melinoe"
      Event = "HecateAboutSurface03"
    }
    {
      Id = "Hecate_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pelajaran telah dipetik, dan pengalaman telah didapat. Para Fates sendiri tak ingin kau berada di sana. Apa yang akan kau lakukan?"
      Speaker = "Hecate"
      Event = "HecateAboutSurface03"
    }
    {
      Id = "Melinoe_0590"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya mantra yang harus kuselesaikan. Aku tak perlu tinggal selamanya di permukaan... Aku hanya perlu bertahan cukup lama sampai tiba di Olympus..."
      Speaker = "Melinoe"
      Event = "HecateAboutSurface03"
    }
    {
      Id = "Hecate_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, jadi kau berusaha memperbaiki aspek dirimu ini, tanpa menolaknya mentah-mentah. Masuk akal juga..."
      Speaker = "Hecate"
      Event = "HecateAboutSurface03"
    }
    {
      Id = "Melinoe_0591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti bisa..."
      Speaker = "Melinoe"
      Event = "HecateAboutSurface03"
    }
    {
      Id = "Melinoe_2947"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya tugasku."
      Speaker = "Melinoe"
      Event = "HecateAboutSurface03_B"
    }
    {
      Id = "Melinoe_0592"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah... Olympus sepertinya enggan memintanya secara gamblang, tapi aku tahu keluargaku di sana membutuhkanku. Aku tak bisa menepis firasat bahwa aku harus membantu mereka, sebelum bisa menuntaskan tugas kita."
      Speaker = "Melinoe"
      Event = "HecateAboutSurfaceSurvival01"
    }
    {
      Id = "Hecate_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu menepis firasat itu, karena bisa jadi itu benar. Apa kau masih memikirkan mantra yang bisa membantumu bertahan dalam perjalanan semacam itu?"
      Speaker = "Hecate"
      Event = "HecateAboutSurfaceSurvival01"
    }
    {
      Id = "Melinoe_0593"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar. Di atas sana, aku bagaikan ikan keluar dari air, kan? Tercekik. Namun dengan mantra yang tepat, kupikir mungkin aku bisa menahan napas. Sampai Olympus aman."
      Speaker = "Melinoe"
      Event = "HecateAboutSurfaceSurvival01"
    }
    {
      Id = "Hecate_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mantra seperti itu tidaklah sederhana. Meski begitu, jika kau membuktikan dirimu cukup berpengalaman menjelajah, maka... mungkin sihir semacam itu bisa membantumu melangkah lebih jauh lagi."
      Speaker = "Hecate"
      Event = "HecateAboutSurfaceSurvival01"
    }
    {
      Id = "Melinoe_0594"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sangat mengandalkannya."
      Speaker = "Melinoe"
      Event = "HecateAboutSurfaceSurvival01"
    }
    {
      Id = "Hecate_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjalananmu ke permukaan baru-baru ini. Bagaimana caramu bisa bertahan di atas sana? Kau pergi lebih lama dari yang kukira."
      Speaker = "Hecate"
      Event = "HecateAboutSurfaceSurvival02"
    }
    {
      Id = "Melinoe_0595"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mantra bernapas di permukaanku ternyata membuahkan hasil, Kepala Sekolah. Aku masih merasakan hawa yang mencekik di atas sana, menindih diriku... tapi tak meremukkanku separah sebelumnya."
      Speaker = "Melinoe"
      Event = "HecateAboutSurfaceSurvival02"
    }
    {
      Id = "Hecate_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sihir yang lahir dari tekad bulatmu. Aku kagum, meski tidak sepenuhnya terkejut. Semoga sihirmu terus melindungimu sebelum Olympus aman."
      Speaker = "Hecate"
      Event = "HecateAboutSurfaceSurvival02"
    }
    {
      Id = "Hecate_0749"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti sangat berat bagimu di atas sana. Tujuanku adalah mempersiapkanmu menghadapi bahaya Underworld, bukan marabahaya yang seharusnya bisa diatasi sendiri oleh Olympus."
      Speaker = "Hecate"
      Event = "HecateAboutSurfaceSurvival03"
    }
    {
      Id = "Melinoe_4040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap langkah salah di permukaan memberi pelajaran yang lebih keras daripada di bawah sini. Aku mulai terbiasa, tapi aku selalu diingatkan bahwa seharusnya aku sama sekali tak bisa menjejakkan kaki di sana."
      Speaker = "Melinoe"
      Event = "HecateAboutSurfaceSurvival03"
    }
    {
      Id = "Hecate_0750"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan nyatanya kau tetap melangkah! Lihatlah bagaimana aku bahkan tak mencoba menyembuhkan sifat keras kepalamu itu; mungkin itulah sifat paling menonjol dari keluargamu. Baiklah, jika kau ingin terus mempersulit dirimu sendiri, setidaknya kau tahu jalannya."
      Speaker = "Hecate"
      Event = "HecateAboutSurfaceSurvival03"
    }
    {
      Id = "Melinoe_4041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku suka punya banyak pilihan."
      Speaker = "Melinoe"
      Event = "HecateAboutSurfaceSurvival03"
    }
    {
      Id = "Hecate_0659"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar armada kapal yang terus tenggelam di Celah Thessaly? Mengherankan sekali Chronos bisa mengumpulkan pengikut sebanyak itu menggunakan rakitan kapal yang begitu bobrok."
      Speaker = "Hecate"
      Event = "HecateAboutThessaly01"
    }
    {
      Id = "Melinoe_3462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Armada itu sama sekali tak menunjukkan tanda-tanda melambat. Untungnya, sihir yang menyatukan kapal-kapal itu justru membuatku bisa berpindah cepat dari satu kapal ke kapal lain. Apa semua kapal di permukaan seaneh itu bentuknya?"
      Speaker = "Melinoe"
      Event = "HecateAboutThessaly01"
    }
    {
      Id = "Hecate_0660"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir jelas tidak. Kapal-kapal {#Emph}ini {#Prev}hanyalah cerminan janji palsu sang Titan tentang era baru. Mereka bukan cuma menyerang Olympus, tapi juga menyinggung selera kita."
      Speaker = "Hecate"
      Event = "HecateAboutThessaly01"
    }
    {
      Id = "Melinoe_3463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita akan memukul mundur mereka."
      Speaker = "Melinoe"
      Event = "HecateAboutThessaly01"
    }
    {
      Id = "Hecate_0703"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus dan aku... sejak lama salah satu dari kami yakin kau akan menemukan jalan ke Gunung Olympus dan memusatkan upayamu di sana. Sedangkan yang satu lagi yakin kau takkan melakukannya."
      Speaker = "Hecate"
      Event = "HecateAboutOlympus01"
    }
    {
      Id = "Melinoe_3893"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebelum Guru bertanya, takkan sudi aku disuruh menebak siapa yang memihak apa dalam perdebatan itu, Guru."
      Speaker = "Melinoe"
      Event = "HecateAboutOlympus01"
    }
    {
      Id = "Hecate_0704"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu bilang, cara menuntaskan tugas ini terserah padamu. Bukan tugasku memandu setiap langkahmu! Jadi, apakah sepadan mendaki ketinggian itu?"
      Speaker = "Hecate"
      Event = "HecateAboutOlympus01"
    }
    {
      Id = "Melinoe_3894"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sangat sepadan. Dan aku berniat ke sana lagi."
      Speaker = "Melinoe"
      Event = "HecateAboutOlympus01"
    }
    {
      Id = "Hecate_0705"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga niatmu terwujud teguh."
      Speaker = "Hecate"
      Event = "HecateAboutOlympus01"
    }
    {
      Id = "Hecate_0514"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beruntung sekali wilayah ayahmu begitu luas, sehingga kau bisa mengitarinya lewat pinggiran Oceanus, tempat musuh kita relatif lemah."
      Speaker = "Hecate"
      Event = "HecateAboutOceanus01"
    }
    {
      Id = "Melinoe_1027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kita tak bisa lewat langsung menembus Elysium, kita akan cari jalan lain semampu kita. Meski monster-monster yang mengintai di perbatasan samudra tak menyukai kehadiranku."
      Speaker = "Melinoe"
      Event = "HecateAboutOceanus01"
    }
    {
      Id = "Hecate_0515"
      InheritFrom = "BaseNarrative"
      DisplayName = "Monster pembenci dewa yang berdarahkan air garam; lautan yang menutupi permukaan dunia rupanya belum cukup bagi mereka. Setidaknya, bilik-bilik tenggelam yang mereka huni belum jatuh ke tangan Chronos."
      Speaker = "Hecate"
      Event = "HecateAboutOceanus01"
    }
    {
      Id = "Melinoe_2517"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru, aku melihatnya. Chronos! Pertama di luar Erebus, dalam wujud pria tua. Lalu dia berusaha menjebakku dalam semacam penglihatan di luar waktu... sungai berapi, segalanya berkobar..."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosAnomaly01"
    }
    {
      Id = "Melinoe_2518"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitulah klaimnya. Aku lepas dari mantranya secara naluriah, tapi... aku juga tak bisa mengangkat senjata melawannya. Apa yang harus kulakukan sekarang?"
      Speaker = "Melinoe"
      Event = "HecateAboutChronosAnomaly01"
    }
    {
      Id = "Melinoe_2519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baik, Guru."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosAnomaly01"
    }
    {
      Id = "Melinoe_2164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengaruh Chronos jauh lebih kuat di Oceanus dibanding di sini. Dia berusaha menjebakku dalam ilusi waktu lain. Ladang berapi."
      Speaker = "Melinoe"
      Event = "HecateAboutChronosAnomaly02"
    }
    {
      Id = "Hecate_0537"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun kau sanggup melepaskan diri dari cengkeramannya. Aspek dari kondisimu yang sudah kami duga akan bangkit saat kau kian mendekati musuh kita. Kendati demikian, teruslah melangkah dengan kewaspadaan yang lebih tinggi..."
      Speaker = "Hecate"
      Event = "HecateAboutChronosAnomaly02"
    }
    {
      Id = "Hecate_0636"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasir yang kau rebut kembali dari musuh kita itu. Ada serpihan hakikatnya di setiap butir halusnya. Semacam kunci untuk Pelarutan Waktu. Kau sepakat?"
      Speaker = "Hecate"
      Event = "HecateAboutTimeStop01"
    }
    {
      Id = "Melinoe_2912"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sepakat. Mantra itu langsung tebersit di benakku... perwujudan dari semua yang Guru ajarkan tentang kelemahannya. Cara untuk mengurai hakikat wujudnya... membawa kematian bagi Chronos akhirnya. Dia sepertinya tak sadar ini mungkin... masih mengira aku cuma pesuruh Olympus."
      Speaker = "Melinoe"
      Event = "HecateAboutTimeStop01"
    }
    {
      Id = "Hecate_0637"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukti nyata bahwa kerja keras kita bersama tidaklah sia-sia. Kau menerjang Underworld bak badai, sementara aku bersembunyi dalam bayangan. Namun, saat waktu sang Titan akhirnya habis, aku {#Emph}sangat {#Prev}ingin berada di sana sendiri. Menyaksikan raut wajahnya."
      Speaker = "Hecate"
      Event = "HecateAboutTimeStop01"
    }
    {
      Id = "Melinoe_2913"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita pasti akan menghabisinya, Guru..."
      Speaker = "Melinoe"
      Event = "HecateAboutTimeStop01"
    }
    {
      Id = "Hecate_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senjata Nokturnal mulai bangkit. Semoga kita masih sempat menyaksikan era di mana mereka bisa terlelap kembali. Dari semuanya, sudahkah kau punya saudari kesayangan?"
      Speaker = "Hecate"
      Event = "HecateAboutWeapons01"
    }
    {
      Id = "Melinoe_0656"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bersyukur persenjataan Malam sudi menerimaku. Aku berniat memperlakukan semuanya secara setara, Guru."
      Speaker = "Melinoe"
      Event = "HecateAboutWeapons01"
    }
    {
      Id = "Hecate_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sikap yang terpuji, namun tidak mutlak perlu. Senjata Nokturnal memiliki tujuan yang sama dengan kita. Mereka tak peduli mana yang kau gunakan, asalkan tugasmu tuntas."
      Speaker = "Hecate"
      Event = "HecateAboutWeapons01"
    }
    {
      Id = "Melinoe_0657"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita akan tuntaskan ini sampai akhir."
      Speaker = "Melinoe"
      Event = "HecateAboutWeapons01"
    }
    {
      Id = "Hecate_0595"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, Senjata Malam telah memperlihatkan kepadamu sebagian rupa masa lalu mereka; atau mungkin rupa masa depan mereka. Sedikit sekali yang berhak menyandang senjata-senjata semacam itu. Apalagi memanfaatkan berbagai wujud rupa mereka!"
      Speaker = "Hecate"
      Event = "HecateAboutAspects01"
    }
    {
      Id = "Melinoe_2521"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berbagai Aspek yang kutemukan... beberapa penyandangnya kukenal baik. Medea, Artemis... mereka semua terhubung dengan {#Emph}Guru{#Prev}, bukan?"
      Speaker = "Melinoe"
      Event = "HecateAboutAspects01"
    }
    {
      Id = "Hecate_0596"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak sesederhana yang kau duga... kau membawa serangkaian pusaka yang bertujuan melindungi Underworld. Tiap Aspek berasal dari sosok yang pernah berperan dalam hal ini, atau yang kelak akan berperan."
      Speaker = "Hecate"
      Event = "HecateAboutAspects01"
    }
    {
      Id = "Melinoe_2522"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya aku berada di tengah rekan-rekan yang hebat..."
      Speaker = "Melinoe"
      Event = "HecateAboutAspects01"
    }
    {
      Id = "Hecate_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë. Aku menahan diri saat melawanmu di luar sana. Dan bahkan begitu pun, kau masih belum bisa melampauiku. Kau tahu kenapa?"
      Speaker = "Hecate"
      Event = "HecateLostAgainstHer01"
    }
    {
      Id = "Melinoe_1032"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tahu aku masih bisa bertambah kuat, tapi... kurangnya pengetahuankulah yang mengkhianatiku pada akhirnya. Sebagian dari sekian banyak trik Guru masih belum kupelajari."
      Speaker = "Melinoe"
      Event = "HecateLostAgainstHer01"
    }
    {
      Id = "Hecate_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali! Kekuatan; pengetahuan; kesabaran. Saat berhadapan dengan lawan yang tampak tak terkalahkan, ketiganya mutlak dibutuhkan. Atau secuil campur tangan takdir..."
      Speaker = "Hecate"
      Event = "HecateLostAgainstHer01"
    }
    {
      Id = "Melinoe_1033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan mengandalkan yang pertama tadi."
      Speaker = "Melinoe"
      Event = "HecateLostAgainstHer01"
    }
    {
      Id = "Hecate_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil menggagalkan langkahmu lagi di luar sana. Memang tidak adil, aku tahu. Aku datang bugar dan segar menanti bentrokan kita, sedangkan kau mungkin sudah kelelahan bertempur."
      Speaker = "Hecate"
      Event = "HecateLostAgainstHer02"
    }
    {
      Id = "Melinoe_0655"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keadilan itu barang mewah, Kepala Sekolah. Meski begitu, terkadang aku iri dengan kemampuanmu berpindah jarak sejauh itu dalam sekejap mata."
      Speaker = "Melinoe"
      Event = "HecateLostAgainstHer02"
    }
    {
      Id = "Hecate_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan terburu-buru mendambakan apa yang belum kau pahami. Di sepanjang jalurmu terbentang sumber daya dan reagen yang kita perlukan. Dan jika kau tak bisa melewatinu, berarti kau belum siap menghadapi apa yang menanti di depan sana."
      Speaker = "Hecate"
      Event = "HecateLostAgainstHer02"
    }
    {
      Id = "Hecate_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melangkah jauh, Melinoë, dan berhasil mengalahkanku. Bahkan sempat membuatku kewalahan! Masih banyak yang harus diselesaikan. Namun, kau terus belajar."
      Speaker = "Hecate"
      Event = "HecateWonAgainstHer01"
    }
    {
      Id = "Melinoe_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Kepala Sekolah. Walaupun aku tahu, aku tak mungkin bisa mengalahkanmu andai kau bertarung sekuat tenaga."
      Speaker = "Melinoe"
      Event = "HecateWonAgainstHer01"
    }
    {
      Id = "Hecate_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}tahu? {#Prev}Mengapa kau membatasi kemampuanmu sendiri seperti itu? {#Emph}Ubah pola pikirmu{#Prev}. Kita akan bertemu lagi di luar sana."
      Speaker = "Hecate"
      Event = "HecateWonAgainstHer01"
    }
    {
      Id = "Hecate_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil dalam upayamu! Namun musuh kita adalah sang Waktu itu sendiri, dan tampaknya dia belum bersedia turun dari takhta curiannya begitu saja."
      Speaker = "Hecate"
      Event = "HecateUnderworldRunCleared01"
    }
    {
      Id = "Melinoe_5685"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sering kali menepis perasaan bahwa tugas ini mustahil. Tapi kita mulai membuat kemajuan, bukan?"
      Speaker = "Melinoe"
      Event = "HecateUnderworldRunCleared01"
    }
    {
      Id = "Hecate_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemustahilan itu biasanya hanya bersifat sementara. Waktu berniat mengikis tekad kita, tetapi dengan kesabaran, kita sanggup bertahan menghadapinya hingga malam milik kita akhirnya tiba."
      Speaker = "Hecate"
      Event = "HecateUnderworldRunCleared01"
    }
    {
      Id = "Melinoe_1799"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, bersabar..."
      Speaker = "Melinoe"
      Event = "HecateUnderworldRunCleared01"
    }
    {
      Id = "Melinoe_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, apa kau selalu begitu menyayangi para satwa? Tampaknya kalian rela melakukan apa pun demi satu sama lain."
      Speaker = "Melinoe"
      Event = "HecateAboutBeasts01"
    }
    {
      Id = "Hecate_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satwa... dibebani sebutan yang begitu dingin. Para satwa jauh lebih tulus menaruh percaya ketimbang sebagian besar makhluk fana maupun abadi yang pernah kutemui."
      Speaker = "Hecate"
      Event = "HecateAboutBeasts01"
    }
    {
      Id = "Melinoe_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka membuatnya terasa begitu sederhana, ya? Untuk menaruh kepercayaan penuh."
      Speaker = "Melinoe"
      Event = "HecateAboutBeasts01"
    }
    {
      Id = "Hecate_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seseorang tahu persis posisinya di mata para satwa, apakah ia disayangi atau ditakdirkan untuk mengenyangkan perut mereka. Kuharap para dewa bisa sejelas dan seandal itu."
      Speaker = "Hecate"
      Event = "HecateAboutBeasts01"
    }
    {
      Id = "Hecate_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tampak kurang sehat. Kembali lewat kematian itu berat, aku tahu. Beritahu aku jika kau butuh sesuatu."
      Speaker = "Hecate"
      Event = "HecateAboutWellness01"
    }
    {
      Id = "Melinoe_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku baik-baik saja, terima kasih, Kepala Sekolah. Bagaimana caramu mengatasinya saat kau merasa tak enak badan?"
      Speaker = "Melinoe"
      Event = "HecateAboutWellness01"
    }
    {
      Id = "Hecate_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku punya ramuan untuk segala suasana hati, bahkan lebih. Duka, perih, cemas, mabuk asmara, mati rasa, amarah, takut, mual, rasa gentar... semua perasaan bisa dipulihkan, entah dengan keteguhan mental atau, jika itu gagal, sebotol minuman keras yang manjur."
      Speaker = "Hecate"
      Event = "HecateAboutWellness01"
    }
    {
      Id = "Melinoe_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin lain kali saja."
      Speaker = "Melinoe"
      Event = "HecateAboutWellness01"
    }
    {
      Id = "Hecate_0664"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wajahmu memerah merona, bisa kulihat jelas saat kau mendekat tadi! Tak perlu bercerita tentang penyebabnya, jika kau lebih suka merahasiakan siapa orangnya."
      Speaker = "Hecate"
      Event = "HecateAboutRelationships01"
    }
    {
      Id = "Melinoe_3472"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Siapa orangnya{#Prev}, Kepala Sekolah? Bukankah ini bisa saja karena malam yang gerah, atau efek sisa dari kepulanganku?"
      Speaker = "Melinoe"
      Event = "HecateAboutRelationships01"
    }
    {
      Id = "Hecate_0665"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kecil kemungkinannya. Dengar, Melinoë, aku dulu persis sepertimu. Sudah pernah kukatakan sebelumnya bahwa perasaan itu pantang diabaikan. Rangkullah yang memacu semangatmu, itu pertanda baik! Lalu hadapi sisanya."
      Speaker = "Hecate"
      Event = "HecateAboutRelationships01"
    }
    {
      Id = "Melinoe_3473"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada banyak dari keduanya..."
      Speaker = "Melinoe"
      Event = "HecateAboutRelationships01"
    }
    {
      Id = "Hecate_0644"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan sampai kau terikat pada tempat seperti ini; tempatmu adalah di tengah kemewahan kediaman ayah agungmu."
      Speaker = "Hecate"
      Event = "HecateAboutCrossroads01"
    }
    {
      Id = "Melinoe_1667"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sesuai petunjukmu, Kepala Sekolah..."
      Speaker = "Melinoe"
      Event = "HecateAboutCrossroads01"
    }
    {
      Id = "Hecate_0694"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senjata Nokturnal yang kau genggam begitu perkasa, namun membebanimu dengan tanggung jawab yang mengerikan. Tanggung jawab yang baru mulai kau pahami."
      Speaker = "Hecate"
      Event = "HecateGrantsWeaponUpgradeSystem01"
    }
    {
      Id = "Melinoe_3830"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang pembawa wajib menegakkan kehendak Malam demi mengabdi pada Underworld. {#Prev}Hampir terasa seolah-olah aku yang tunduk pada perintah mereka, bukan sebaliknya..."
      Speaker = "Melinoe"
      Event = "HecateGrantsWeaponUpgradeSystem01"
    }
    {
      Id = "Hecate_0695"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu cara pandang yang tepat. Dan aku ingin membagikan sebuah mantra tertentu yang akan memperdalam ikatanmu dengan mereka."
      Speaker = "Hecate"
      Event = "HecateGrantsWeaponUpgradeSystem01"
    }
    {
      Id = "Hecate_0794"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu lagi rahasia dari Sumpah sang Gaib akan kuungkapkan sekarang. Saat kau merasa sudah cukup siap, renungkanlah ini. Lalu mungkin kita akan beradu tanding dalam keadaan yang sama sekali baru..."
      Speaker = "Hecate"
      Event = "HecateGrantsShrineUpgrade01"
    }
    {
      Id = "Melinoe_4600"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rahasia dari Janji Persaingan..."
      Speaker = "Melinoe"
      Event = "HecateGrantsShrineUpgrade01"
    }
    {
      Id = "Hecate_0585"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau senantiasa memastikan keselamatan para Familiar-mu, walau aku sama sekali tak meragukannya. Kita ada di sini untuk melindungi makhluk-makhluk itu, lebih dari mereka melindungi kita."
      Speaker = "Hecate"
      Event = "HecateGrantsFamiliars01"
    }
    {
      Id = "Melinoe_2511"
      InheritFrom = "BaseNarrative"
      DisplayName = "Familiar adalah keluarga, Kepala Sekolah. Barangkali lewat cobaan ini, ikatanku dengan mereka akan seerat ikatanmu dengan milikmu."
      Speaker = "Melinoe"
      Event = "HecateGrantsFamiliars01"
    }
    {
      Id = "Hecate_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "Soal itu pun aku tak ragu sedikit pun. Aku sudah membicarakan hal ini dengan Hecuba dan Gale, dan mereka bersedia menjagamu. Tentu saja, jika kau memintanya baik-baik."
      Speaker = "Hecate"
      Event = "HecateGrantsFamiliars01"
    }
    {
      Id = "Melinoe_2512"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, sungguh? Tapi ikatan mereka kan dengan {#Emph}dirimu! {#Prev}Tunggu, siapa yang harus kumintai izin baik-baik, kau atau mereka?"
      Speaker = "Melinoe"
      Event = "HecateGrantsFamiliars01"
    }
    {
      Id = "Hecate_0587"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya mulailah dari {#Emph}mereka!"
      Speaker = "Hecate"
      Event = "HecateGrantsFamiliars01"
    }
    {
      Id = "Hecate_0861"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berkat pencapaianmu, nama kita sebagai Sang Gaib kian tersohor. Asalkan kita tidak menjadi buah bibir dalam terlalu banyak kisah, selain kisah yang menebar kegentaran."
      Speaker = "Hecate"
      Event = "HecateGrantsBadgeSeller01"
    }
    {
      Id = "Melinoe_5295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Bayangan kita sepertinya paham perlunya menjaga kerahasiaan secara terus-menerus. Mereka tampak amat antusias menyambut kembalinya Nyx yang kini mengawasi kita."
      Speaker = "Melinoe"
      Event = "HecateGrantsBadgeSeller01"
    }
    {
      Id = "Hecate_0862"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka akan segera menyadari bahwa Wujud Malam tidaklah mudah dipuaskan."
      Speaker = "Hecate"
      Event = "HecateGrantsBadgeSeller01"
    }
    {
      Id = "Melinoe_5567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tangan Panjang Kaum Tak Kasatmata...{#Prev}"
      Speaker = "Melinoe"
      Event = "HecateGrantsBadgeSeller01"
    }
    {
      Id = "Hecate_0863"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya kita menjadi Kaum Tak Kasatmata I, dan ditakuti di seantero alam semesta. Kupikir hal itu baru akan tercapai di zaman berikutnya..."
      Speaker = "Hecate"
      Event = "HecateAboutBadgeProgress01"
    }
    {
      Id = "Melinoe_5296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prosesnya memang tidak sebentar, tapi kita berhasil mencapainya. Karena Kaum Tak Kasatmata pantang menyerah."
      Speaker = "Melinoe"
      Event = "HecateAboutBadgeProgress01"
    }
    {
      Id = "Hecate_0864"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rupanya demikian. Lalu apa rencanamu sekarang? Mengejar pencapaian lain yang nyaris mustahil?"
      Speaker = "Hecate"
      Event = "HecateAboutBadgeProgress01"
    }
    {
      Id = "Melinoe_5297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita lihat saja nanti!"
      Speaker = "Melinoe"
      Event = "HecateAboutBadgeProgress01"
    }
    {
      Id = "Hecate_0758"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos pasti merasa berada di atas angin sekarang karena Olimpus terus dihantam Ayah Segala Monster malam demi malam. Namun dia telah membuat kesalahan fatal..."
      Speaker = "Hecate"
      Event = "HecateAboutStormStop01"
    }
    {
      Id = "Melinoe_4046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon takkan bisa dikendalikan... jika Olimpus bukan lagi tandingannya, dia kemungkinan besar akan mengincar Chronos selanjutnya. Pasti ada cara untuk mengalihkan amarahnya."
      Speaker = "Melinoe"
      Event = "HecateAboutStormStop01"
    }
    {
      Id = "Hecate_0759"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika bukan amarahnya, maka hakikat keberadaannya... Aku selalu mengajarkanmu bahwa sihir kita pantang digunakan hanya demi kehancuran semata. Namun, tak ada aturan yang mutlak. Mari kita manfaatkan kekuatan musuh untuk melawan mereka sendiri, demi melenyapkan mereka semua."
      Speaker = "Hecate"
      Event = "HecateAboutStormStop01"
    }
    {
      Id = "Melinoe_4737"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pelenyapan Kemonsteran...{#Prev}"
      Speaker = "Melinoe"
      Event = "HecateAboutStormStop01"
    }
    {
      Id = "Hecate_0945"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mantra Pelenyapan Kemonsteran kini milikmu untuk dirapal sesukamu, namun kau masih ragu. Haruskah aku merasa cemas?"
      Speaker = "Hecate"
      Event = "HecateAboutStormStopNotCast01"
    }
    {
      Id = "Melinoe_5734"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak melebihi kecemasan yang kita semua rasakan akhir-akhir ini, Kepala Sekolah. Aku hanya ingin membuat persiapan tambahan sebelum melangkah ke tahap akhir tugas ini. Atau apakah aku harus terburu-buru menerjangnya sekarang?"
      Speaker = "Melinoe"
      Event = "HecateAboutStormStopNotCast01"
    }
    {
      Id = "Hecate_0946"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan kurang ajar padaku. Ini bukan saatnya bersikap santai ketika sebelumnya kau nyaris tak pernah begitu. Bersiaplah kalau begitu. Selambat dan secermat apa pun yang kau butuhkan."
      Speaker = "Hecate"
      Event = "HecateAboutStormStopNotCast01"
    }
    {
      Id = "Melinoe_5735"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sedang diusahakan."
      Speaker = "Melinoe"
      Event = "HecateAboutStormStopNotCast01"
    }
    {
      Id = "Melinoe_4942"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar Anda akhir-akhir ini, Kepala Sekolah? Anda tampak... yah, lebih tertutup dari yang kukira sejak dari Kediaman Hades. Anda bilang kita akan bicara lebih lanjut nanti."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding01"
    }
    {
      Id = "Hecate_0813"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu cepat kata {#Emph}nanti {#Prev}berubah menjadi {#Emph}sekarang. {#Prev}Begini, Melinoë, seharusnya aku berada dalam suasana hati yang lebih meriah, menimbang apa yang akhirnya berhasil kau capai. Terlebih dari segalanya, aku sangat bangga padamu. Namun kembali ke Kediaman itu membangkitkan kenangan-kenangan yang seharusnya tetap terlelap."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding01"
    }
    {
      Id = "Melinoe_5683"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski... Anda bisa bertemu Ibu dan Ayah lagi, juga Nyx? Mereka begitu berterima kasih pada Anda, aku bisa merasakannya! {#Emph}Aku {#Prev}pun amat berterima kasih pada Anda. Segalanya mungkin tidak berjalan persis sesuai rencana, tapi hasilnya {#Emph}adalah {#Prev}apa yang kita tuju, bukan?"
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding01"
    }
    {
      Id = "Hecate_0814"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maksudmu Chronos. Aku sangat mendambakan melihat bajingan itu binasa. Hatiku masih teracuni oleh pikiran itu. Hingga kini aku masih berusaha membuang racun tersebut... tolong beri aku waktu."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding01"
    }
    {
      Id = "Melinoe_4944"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingat Anda pernah bilang padaku bahwa menghancurkan Chronos takkan mengubah masa lalu, dan rasa sakitnya akan tetap ada."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding01"
    }
    {
      Id = "Hecate_0815"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan, kemungkinan besar ucapanku benar. Namun kita tak bisa menahan diri untuk merenungkan kembali jalan yang diambil hidup kita, baik lewat pilihan kita sendiri maupun bukan. Bagaimanapun, apa kau siap untuk melanjutkan?"
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding01"
    }
    {
      Id = "Melinoe_4945"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hampir siap. Menelusuri kembali jejak langkahku pasti akan menarik..."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding01"
    }
    {
      Id = "Hecate_0816"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau itu, aku tak meragukannya sedikit pun."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding01"
    }
    {
      Id = "Hecate_0818"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, apa sejauh ini berhasil? {#Emph}Perubahan rencana {#Prev}ini, seperti yang kerap dikatakan Taktisi kita. Jika kau melihat sedikit saja gelagat Chronos yang dulu, segera beri tahu aku."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding02"
    }
    {
      Id = "Melinoe_5020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakek muncul di tempat dan waktu yang kita bicarakan. Klaimnya tentang sisa-sisa kemungkinan di luar Sang Waktu tampaknya akurat. Apa kita lanjutkan?"
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding02"
    }
    {
      Id = "Hecate_0819"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita lihat saja ke mana arahnya. Aku juga ingin berterima kasih atas kepedulianmu padaku tadi. Serta menyampaikan rasa terima kasihku karena kau memutuskan untuk tetap tinggal bersama kami. Awalnya aku... {#Emph}marah {#Prev}atas keputusanmu. Tapi sekarang tidak lagi."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding02"
    }
    {
      Id = "Melinoe_5021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan keputusan yang sulit bagiku, Kepala Sekolah. Justru akan lebih berat jika aku tahu itu membuat Anda marah. Aku sudah pernah ke Istana Zeus dan Kediaman Hades... dan keduanya tak memiliki kawah ataupun tanah gembur di bawah kakiku."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding02"
    }
    {
      Id = "Hecate_0820"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat memahaminya, Melinoë, dan aku pasti akan memilih hal yang sama, hanya saja... kupikir kau akan lebih bijak. Kini kau terjebak di sini, satu lagi jiwa yang tersesat di persimpangan jalan antara surga dan neraka..."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding02"
    }
    {
      Id = "Melinoe_5022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi aku tidak tersesat. Aku berada di tempat yang kuinginkan."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding02"
    }
    {
      Id = "Hecate_0821"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benarkah begitu..."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding02"
    }
    {
      Id = "Melinoe_5742"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah... aku hanya ingin minta maaf karena Anda tak bisa ikut merasakan kenangan-kenangan di Kediaman Hades itu... tentang bagaimana aku mungkin tumbuh dewasa andai Chronos mengambil keputusan berbeda."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding03"
    }
    {
      Id = "Hecate_0947"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu menghiburku, tapi terima kasih. Kau telah melihat alur waktu di mana campur tanganku tidak diperlukan. Itu demi yang terbaik. Aku senang kau bisa merasakan penglihatan semacam itu."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding03"
    }
    {
      Id = "Melinoe_5743"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya saja aku tak mengerti kenapa Anda tak ada di sana. Aneh mengatakannya, tapi... entah mengapa, kurasa aku selalu merasakan ketiadaan Anda. Aku tak pernah mempelajari seni sihirku... begitu banyak hal yang amat kucintai."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding03"
    }
    {
      Id = "Hecate_0948"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi sekarang kau {#Emph}telah {#Prev}mempelajarinya. Sedangkan untuk kemungkinan yang lain itu... tampaknya sang Titan terbukti berguna di luar dugaan bagi Kediaman tersebut. Maka dari itu aku tak ada di sana karena ibumu tak pernah membutuhkanku."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding03"
    }
    {
      Id = "Melinoe_5744"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi {#Emph}aku {#Prev}membutuhkan Anda. Dan masih membutuhkannya."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding03"
    }
    {
      Id = "Hecate_0949"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heh. {#Prev}Mungkin saja."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding03"
    }
    {
      Id = "Hecate_0950"
      InheritFrom = "BaseNarrative"
      DisplayName = "Agar kau tak tergiur melakukan hal sebaliknya, jaga baik-baik rincian tentang apa yang terjadi di Rumah Hades... seperti hal-hal yang kini kau ingat kembali. Desas-desus mengenai kendalimu atas mimpi dan waktu mungkin saja tersebar, tetapi {#Emph}bukan {#Prev}kebenarannya."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding04"
    }
    {
      Id = "Melinoe_5745"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena kita telah mencapai hal yang seharusnya mustahil... tapi, semua ingatan yang telah kudapatkan ini... mungkinkah suatu saat nanti aku bisa menceritakan {#Emph}lebih banyak padamu{#Prev}, setidaknya? Serta pada orang-orang lain yang dekat denganku."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding04"
    }
    {
      Id = "Hecate_0951"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin suatu saat nanti... namun untuk saat ini, kehati-hatian adalah prioritas utama atas kehendak Sang Malam sendiri. Dengan begitu, kau juga terhindar dari keharusan memberi berbagai penjelasan yang rumit."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding04"
    }
    {
      Id = "Melinoe_5746"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu memang benar."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding04"
    }
    {
      Id = "Hecate_1001"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sihirmu mungkin terbukti berperan penting dalam mendamaikan keluargamu baru-baru ini, namun itu hanya bisa membawa dirimu dan mereka sejauh ini. Ingatlah betapa kerasnya latihanmu... kini semua orang harus mengerahkan upaya serupa."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding05"
    }
    {
      Id = "Melinoe_5808"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua hubungan antar-keluarga ini memang perlu dirawat layaknya taman. Namun kerabat-kerabatku selalu kesulitan untuk berkomunikasi dan akur, bukan? Ayah bahkan tak mampu menjaga hubungan baik dengan para dewa Olimpus."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding05"
    }
    {
      Id = "Hecate_1002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu memang bukan salah satu kelebihan terbesar keluargamu, hal itu tak terbantahkan. Dan mungkin takkan pernah menjadi kelebihan kalian. Kendati demikian, kita telah melihat akibat dari kesalahan masa lalu, dan hal-hal itu tak boleh terulang kembali. Kau akan memastikannya, bukan?"
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding05"
    }
    {
      Id = "Melinoe_5809"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepenuh hatiku."
      Speaker = "Melinoe"
      Event = "HecatePostTrueEnding05"
    }
    {
      Id = "Hecate_1003"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuyakini itu sudah cukup."
      Speaker = "Hecate"
      Event = "HecatePostTrueEnding05"
    }
    {
      Id = "Hecate_0798"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menghadap Tiga Dewi Takdir! Mantramu dari sekian malam yang lalu pasti telah membuahkan hasil. Hermes mengabarkan bahwa keadaan mereka baik-baik saja, namun mereka masih akan melanjutkan cuti. Bagaimanapun, kerja bagus telah memancing mereka keluar."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4884"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Guru. Rasanya merekalah yang mencari {#Emph}diriku{#Prev}, bukan sebaliknya, tapi setidaknya kita tahu mereka aman. Mereka... juga menyinggung tentang {#Emph}dirimu{#Prev}."
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0799"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah demikian...? Dalam hal apa?"
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4885"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata mereka kau telah... yah... menurutmu, adakah tempat yang lebih tertutup untuk membicarakan hal ini?"
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0800"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Mendesah> {#Prev}Mari ke pemandian air panas. Kau pantas beristirahat, dan kita bisa duduk santai membicarakan apa yang ada di benakmu... serta benak mereka."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0802"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, apa yang diketahui ketiga saudari pemintal itu tentang diriku, {#Emph}hm? {#Prev}Tadi kau hendak mengatakannya..."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4886"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka bilang padaku... kurasa ungkapan yang mereka pakai adalah, kau telah {#Emph}ikut campur menarik benang takdir. {#Prev}Mereka tidak merincinya, namun menyarankan agar aku menanyakannya padamu."
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0803"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Menarik benang takdir. {#Prev}Aku paham betul apa maksud mereka. Namun hingga saat ini, aku tak yakin apakah {#Emph}mereka {#Prev}tahu. Coba kubalikkan pertanyaanmu; menurut {#Emph}dugaanmu{#Prev}, apa yang mereka maksudkan?"
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4887"
      InheritFrom = "BaseNarrative"
      DisplayName = "Firasatku mengatakan bahwa menurut mereka, kau telah mengubah rancangan mereka. Menarik benang... merombak tenunan mereka. Dan bukan dalam skala kecil, tapi... itu hanyalah tebakanku."
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0804"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tindakanmu tak pernah {#Emph}sekadar {#Prev}tebakan biasa, Melinoë. Baiklah, jika ketiga saudari itu telah mengetahui masa laluku, kau pun berhak mengetahuinya. Dan kurasa, akan lebih mudah dijelaskan jika kau memandang diriku yang sebenarnya."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4888"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru, apa... a-aku... kau... kau sangat cantik... tapi apa maksudnya ini, a — aku tidak mengerti... tipuan macam apa yang kau mainkan, atau semacam ilusi, atau...?"
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0805"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan. Tipuannya adalah saat cadar itu {#Emph}terpasang. {#Prev}Tataplah aku, dan jangan palingkan pandanganmu. Aku lebih mengenal mata itu daripada dirimu sendiri."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4889"
      InheritFrom = "BaseNarrative"
      DisplayName = "A-aku... kau... bagaimana ini mungkin terjadi...? Siapa dirimu {#Emph}sebenarnya{#Prev}?"
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0806"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketika masih bayi merah, aku terdampar di tepian sungai Kokitos tanpa ada yang menuntunku selain cahaya rembulan. Selene merawatku; memberitahuku bahwa Titan Chronos telah merenggut keluargaku, dan hanya aku seorang yang selamat. Karena itulah aku berlatih."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4890"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berlatih... demi tugas itu. {#Emph}Kematian bagi Chronos. {#Prev}Kau mencoba melakukan semua itu... sebelum {#Emph}aku{#Prev}?"
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0807"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebelum {#Prev}tidaklah sepenuhnya tepat. Dulu aku murid yang cakap, namun masih sangat mentah; dendam adalah guruku. Dan pada suatu malam, kutemukan bajingan itu. Kulontarkan setiap kutukan yang kuketahui... lalu menyelami jurang bawah sadarnya."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4891"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi, aku memiliki {#Emph}dirimu {#Prev}yang mengajariku cara menyelami jurang bawah sadar... maksudmu {#Emph}kau {#Prev}mencari tahunya sendiri secara mandiri? Itu mustahil!"
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0808"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berdasarkan pengalamanku, hal itu tidak mustahil. Namun bagaimanapun juga, terjadi suatu kekacauan. Waktu dan mimpi buruk melebur, dan aku mendapati diriku berada di tempat lain. Kutuju akhir dari Waktu... namun aku malah tiba di masa yang mendekati permulaannya."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4892"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu, kau hidup... selama berabad-abad... menunggu, tenunan para Dewi Takdir dan diriku? Demi kesempatan kedua. Guru, aku... demi para dewa..."
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0809"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak berani mengusik rancangan para Dewi Takdir melebihi batas yang benar-benar diperlukan. Dalam wujud ini, aku mengambil hati ayah dan ibumu; bahkan menjadi dayang Sang Ratu. Karena itulah saat Chronos akhirnya menyerang... mereka menyerahkan putri mereka yang baru lahir bukan ke Sungai Styx, melainkan kepadaku."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4893"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu... kau melakukan segala daya upayamu demi mempersiapkanku, agar aku bisa berhasil di saat kau gagal..."
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0810"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Seperti yang selalu kukatakan padamu, aku bukanlah ibumu, Melinoë. Aku sendiri pun tak pernah memiliki ibu. Namun, aku punya alasan kuat untuk yakin pada kemampuanmu.... Nah, begitulah ceritanya! Betapa kau pasti membenciku atas semua ini..."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4894"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak... bagaimana bisa kau masih berkata begitu, Guru? Aku menyayangimu... dan kau {#Emph}adalah {#Prev}ibuku, terlepas dari kau mau mengakuinya atau tidak. Dan andai pun tidak... kita berdua terlalu mirip."
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0811"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tentu saja aku juga menyayangimu, Melinoë, dengan segenap jiwa dan ragaku. Jauh melampaui rasa cintaku pada diriku sendiri. Dan aku sungguh meminta maaf... atas segala hal yang harus kau lalui. Atas keluarga yang tak pernah kaumiliki."
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0812"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jangan sampai ada satu jiwa pun yang mengetahui hal ini, kau paham maksudku, kan? Tiga Dewi Takdir, baiklah; serta kita berdua, dan tak ada orang lain lagi. Sekarang... haruskah kita berpura-pura seolah hal ini tak pernah terjadi?"
      Speaker = "Hecate"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Melinoe_4896"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tentu akan berhati-hati... tapi aku takkan berpura-pura."
      Speaker = "Melinoe"
      Event = "HecateBathHouseEpilogue01"
    }
    {
      Id = "Hecate_0840"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabarmu akhir-akhir ini, Melinoë? Kau tak bisa menyembunyikan gundahmu dariku selamanya, jadi kukira lebih baik kau ceritakan saja bila berkenan."
      Speaker = "Hecate"
      Event = "HecatePostEpilogue01"
    }
    {
      Id = "Melinoe_5040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya... masih memikirkan percakapan kita di pemandian air panas tempo hari, itu saja. Aku tahu kita tak boleh membicarakannya, tapi... sekarang aku mengerti mengapa Guru bertindak seperti itu sewaktu kita masih di Graha."
      Speaker = "Melinoe"
      Event = "HecatePostEpilogue01"
    }
    {
      Id = "Hecate_0841"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah. Kalau begitu, simpan saja rasa simpati itu. Aku ini sangat beruntung, melebihi siapa pun. Sebagian besar dari kita tak pernah mendapat kesempatan kedua untuk memperbaiki kegagalan."
      Speaker = "Hecate"
      Event = "HecatePostEpilogue01"
    }
    {
      Id = "Melinoe_5041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah mendapat kesempatan yang tak terhitung jumlahnya. Malam demi malam, terus berusaha menggapai hasil yang sama."
      Speaker = "Melinoe"
      Event = "HecatePostEpilogue01"
    }
    {
      Id = "Hecate_0842"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak pernah gagal sekali pun. Itu hanyalah hambatan sesaat dalam langkahmu menuju kemenangan."
      Speaker = "Hecate"
      Event = "HecatePostEpilogue01"
    }
    {
      Id = "Melinoe_5042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, hal yang sama juga berlaku bagi Guru."
      Speaker = "Melinoe"
      Event = "HecatePostEpilogue01"
    }
    {
      Id = "Hecate_0843"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heh! {#Prev}Mungkin saja."
      Speaker = "Hecate"
      Event = "HecatePostEpilogue01"
    }
    {
      Id = "Hecate_0844"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beban itu tampaknya masih menekanmu, padahal tugasmu pada dasarnya sudah selesai. Padahal aku ingin melihatmu melepaskan beban itu dari pundakmu sekarang. Mengapa masih membekas?"
      Speaker = "Hecate"
      Event = "HecatePostEpilogue02"
    }
    {
      Id = "Melinoe_5043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru, setiap malam aku harus berhadapan dengan sisa-sisa kekuatan Chronos ataupun Typhon. Segala kemungkinan itu rupanya nyata dan tak terhitung jumlahnya, memperlihatkan begitu banyak skenario ketika, karena satu dan lain hal, aku gagal..."
      Speaker = "Melinoe"
      Event = "HecatePostEpilogue02"
    }
    {
      Id = "Hecate_0845"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atau sekadar belum berhasil. Aku adalah bukti nyata bahwa kau tidak sendirian dalam memperjuangkan apa yang ingin kau capai, Melinoë."
      Speaker = "Hecate"
      Event = "HecatePostEpilogue02"
    }
    {
      Id = "Melinoe_5044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maksud perkataan Guru, bahwa ada orang lain seperti Guru... atau sepertiku? Yang juga berusaha menggapai hasil yang sama?"
      Speaker = "Melinoe"
      Event = "HecatePostEpilogue02"
    }
    {
      Id = "Hecate_0846"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya memintamu merenungkan bagaimana jerih payahmu, seberapa {#Emph}jauh {#Prev}usahamu, bisa saling {#Emph}bergema. {#Prev}Energi yang kita curahkan ke dunia ini akan berbalik kembali kepada kita. Sederhananya, aku hanya bisa berada di sini karena keberadaan-{#Emph}mu{#Prev}."
      Speaker = "Hecate"
      Event = "HecatePostEpilogue02"
    }
    {
      Id = "Melinoe_5045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi bukankah justru sebaliknya..."
      Speaker = "Melinoe"
      Event = "HecatePostEpilogue02"
    }
    {
      Id = "Hecate_0847"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benarkah begitu...?"
      Speaker = "Hecate"
      Event = "HecatePostEpilogue02"
    }
    {
      Id = "Hecate_0865"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua ini perlahan menjadi rutinitas yang nyaman. Setiap malam kau kembali bugar; tak kenal lelah. Tapi aku, setidaknya, harus beristirahat sejenak."
      Speaker = "Hecate"
      Event = "HecateAboutSayingLittle01"
    }
    {
      Id = "Melinoe_5298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir akhir-akhir ini situasi sudah terkendali dengan baik, jadi beristirahatlah, Guru. Apakah Guru hendak pergi ke suatu tempat?"
      Speaker = "Melinoe"
      Event = "HecateAboutSayingLittle01"
    }
    {
      Id = "Hecate_0866"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum saatnya. Namun mungkin aku akan lebih sedikit bicara, seperti biasanya."
      Speaker = "Hecate"
      Event = "HecateAboutSayingLittle01"
    }
    {
      Id = "Hecate_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga sinar rembulan menuntun jalanmu dan membutakan musuh-musuhmu."
      Speaker = "Hecate"
      Event = "HecateChat01"
    }
    {
      Id = "Hecate_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "...sari apsintus, apel tanah, jaring laba-laba, batu lilin..."
      Speaker = "Hecate"
      Event = "HecateChat03"
    }
    {
      Id = "Hecate_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "...bebesaran, taring ular, kuntum sesawi, ekor kalajengking..."
      Speaker = "Hecate"
      Event = "HecateChat04"
    }
    {
      Id = "Hecate_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lanjutkan tugasmu. Perhatian musuh kita sedang teralihkan."
      Speaker = "Hecate"
      Event = "HecateChat05"
    }
    {
      Id = "Hecate_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga bayanganmu menjulang tinggi di bawah temaram Cahaya Rembulan."
      Speaker = "Hecate"
      Event = "HecateChat06"
    }
    {
      Id = "Hecate_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kubernakan kutukan seberat timah hitam kepada musuh-musuh kita. Terjadilah seturut kehendak."
      Speaker = "Hecate"
      Event = "HecateChat07"
    }
    {
      Id = "Hecate_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah kembali kepada kami, begitu pula dengan kekuatanmu. Pergilah dan manfaatkan sebaik-baiknya."
      Speaker = "Hecate"
      Event = "HecateChat08"
    }
    {
      Id = "Hecate_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kerahkan seluruh kemampuanmu, Melinoë, tapi jangan sampai kau hancur."
      Speaker = "Hecate"
      Event = "HecateChat10"
    }
    {
      Id = "Hecate_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh kita sedang lengah. Cari dia, dan tumbangkan."
      Speaker = "Hecate"
      Event = "HecateChat11"
    }
    {
      Id = "Hecate_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terus belajar dan bertumbuh setiap kali melangkah pergi. Lanjutkanlah."
      Speaker = "Hecate"
      Event = "HecateChat12"
    }
    {
      Id = "Hecate_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Teruskan dengan teratur. Tak ada tugas penting yang bisa diselesaikan tanpa pengorbanan jerih payah."
      Speaker = "Hecate"
      Event = "HecateChat13"
    }
    {
      Id = "Hecate_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih banyak yang harus diselesaikan, baik di permukaan maupun di bawah sana..."
      Speaker = "Hecate"
      Event = "HecateChat14"
    }
    {
      Id = "Hecate_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita para penyihir kerap kali diremehkan. Namun aku sangat paham betapa hebatnya kemampuanmu."
      Speaker = "Hecate"
      Event = "HecateChat15"
    }
    {
      Id = "Hecate_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos sudah teramat tua sampai-sampai mengira tak ada lagi yang perlu dipelajarinya, dasar si tua renta dungu."
      Speaker = "Hecate"
      Event = "HecateChat16"
    }
    {
      Id = "Hecate_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatanmu bertumpu pada rasa percaya dirimu. Jangan biarkan dirimu goyah."
      Speaker = "Hecate"
      Event = "HecateChat17"
    }
    {
      Id = "Hecate_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pulihkanlah dirimu seperlunya. Kembali ke sini bukanlah sebuah langkah mundur."
      Speaker = "Hecate"
      Event = "HecateChat18"
    }
    {
      Id = "Hecate_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan mengendurkan tekadmu, Melinoë. Musuh kita sama sekali takkan memberi ampun."
      Speaker = "Hecate"
      Event = "HecateChat19"
    }
    {
      Id = "Hecate_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "...kelopak moly, daun siprus, akar mandrake, serbuk kuarsa, bawang putih..."
      Speaker = "Hecate"
      Event = "HecateChat20"
    }
    {
      Id = "Hecate_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "...air rembulan, jelatang, cangkang kumbang, kecubung..."
      Speaker = "Hecate"
      Event = "HecateChat21"
    }
    {
      Id = "Hecate_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "...kulit dedalu, belerang, sayap kelelawar, kulit bawang..."
      Speaker = "Hecate"
      Event = "HecateChat22"
    }
    {
      Id = "Hecate_0929"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bulan mati malam ini, menyajikan banyak kemungkinan atas apa yang akan terjadi."
      Speaker = "Hecate"
      Event = "HecateChat23"
    }
    {
      Id = "Hecate_0930"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melangkahlah seolah jalanmu adalah pilihanmu sendiri; tak ada yang berhak memutuskannya untukmu."
      Speaker = "Hecate"
      Event = "HecateChat24"
    }
    {
      Id = "Hecate_0931"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah bosan dengan Dunia Bawah? Permukaan tentu butuh sentuhan seorang penyihir."
      Speaker = "Hecate"
      Event = "HecateChat25"
    }
    {
      Id = "Hecate_0932"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dunia Bawah selalu membutuhkanmu jika urusan di permukaan sudah terkendali."
      Speaker = "Hecate"
      Event = "HecateChat26"
    }
    {
      Id = "Hecate_0933"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak kemenangan, kau sampai bisa melupakan sepenuhnya rasa pahitnya kekalahan."
      Speaker = "Hecate"
      Event = "HecateChat27"
    }
    {
      Id = "Hecate_0934"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengumpulkan kemenangan-kemenangan itu seakan mengumpulkan bahan ramuan untuk dimasukkan ke kuali."
      Speaker = "Hecate"
      Event = "HecateChat28"
    }
    {
      Id = "Hecate_0935"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan sisa-sisa dari Ayah Segala Monster telah berkurang satu. Kerja bagus."
      Speaker = "Hecate"
      Event = "HecateChat29"
    }
    {
      Id = "Hecate_0936"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu lagi wujud kemungkinan Typhon yang telah tumpas. Kabar baiknya sudah sampai ke telinga kami."
      Speaker = "Hecate"
      Event = "HecateChat30"
    }
    {
      Id = "Hecate_0937"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti aneh rasanya, harus berhadapan dengan Chronos tua dalam salah tafsirnya tentang Graha ayahmu."
      Speaker = "Hecate"
      Event = "HecateChat31"
    }
    {
      Id = "Hecate_0938"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong lemparkan satu atau dua kutukan pada sisa-sisa pasukannya Chronos tua atas namaku."
      Speaker = "Hecate"
      Event = "HecateChat32"
    }
    {
      Id = "Hecate_0939"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita hanya bisa terus belajar, Melinoë. Teruslah melangkah, dan lihat apa lagi yang bisa diajarkan dunia ini."
      Speaker = "Hecate"
      Event = "HecateChat33"
    }
    {
      Id = "Hecate_0940"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa takut begitu kental malam ini. Namun kau sudah tak asing lagi dengan rasa itu sekarang."
      Speaker = "Hecate"
      Event = "HecateChat34"
    }
    {
      Id = "Melinoe_0663"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, sekiranya berkenan, aku punya sedikit hadiah. Mengingat persediaan pribadimu sudah habis beberapa waktu lalu?"
      Speaker = "Melinoe"
      Event = "HecateGift01"
    }
    {
      Id = "Hecate_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, anjing-anjingku pasti akan melahap habis minuman ini! Akan kusimpan untuk suguhan mereka. Dan kenapa kau tidak menyimpan {#Emph}ini{#Prev}, sebagai gantinya?"
      Speaker = "Hecate"
      Event = "HecateGift01"
    }
    {
      Id = "Hecate_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Melinoë, kau tak perlu mempengaruhiku dengan hadiah-hadiah seperti ini. Kita punya tugas. Mari tetap fokus ke sana, ya?"
      Speaker = "Hecate"
      Event = "HecateGift02"
    }
    {
      Id = "Melinoe_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengajariku untuk mencurahkan perhatian pada banyak hal sekaligus, Kepala Sekolah. Mengapa aku tak boleh tetap fokus bertugas sembari menyampaikan rasa hormatku?"
      Speaker = "Melinoe"
      Event = "HecateGift02"
    }
    {
      Id = "Hecate_0538"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh{#Prev}, baiklah... Aku memang menyukai minuman ini, kuakui. Dulu aku lebih sering berkelana, ke tempat-tempat yang lebih mudah untuk mendapatkannya. Barangkali kau merasakan sedikit kerinduan itu dariku."
      Speaker = "Hecate"
      Event = "HecateGift03"
    }
    {
      Id = "Melinoe_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah belajar banyak darimu, Kepala Sekolah. Jadi, ini sekadar tanda terima kasih kecil dariku."
      Speaker = "Melinoe"
      Event = "HecateGift03"
    }
    {
      Id = "Hecate_0539"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku menghargai niat baikmu, juga minumannya, kau sama sekali tak perlu melakukannya. Bukankah sudah kutempa dirimu agar kebal terhadap godaan kontrak terselubung seperti ini?"
      Speaker = "Hecate"
      Event = "HecateGift04"
    }
    {
      Id = "Melinoe_0664"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu untuk tidak mengharapkan imbalan apa pun, Kepala Sekolah. Tindakan memberi itu sendiri seharusnya sudah cukup memberi kepuasan. Dan percayalah padaku, bersamamu, itu sangat bermakna."
      Speaker = "Melinoe"
      Event = "HecateGift04"
    }
    {
      Id = "Hecate_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak terlalu menyukai tradisi para dewa, asal kau tahu. Jangan sampai kau lupa, aku ini seorang Titan. Kurasa aku punya lebih banyak kesamaan dengan musuh lama kita daripada dengan orang-orang seperti Zeus dan komplotannya."
      Speaker = "Hecate"
      Event = "HecateGift05"
    }
    {
      Id = "Melinoe_2166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari mana pun asal-usulmu, Kepala Sekolah, kau selalu menjadi pelindung yang tangguh dan setia sepanjang hidupku. Sedikit tradisi ini membantuku mengungkapkan rasa terima kasihku."
      Speaker = "Melinoe"
      Event = "HecateGift05"
    }
    {
      Id = "Hecate_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tradisi itu sah-sah saja asalkan tidak diikuti secara buta; tanpa akal sehat, maksudku, karena orang buta pun sering kali sangat peka. Namun aku tak ingin mengabaikan kebaikanmu; aku berterima kasih, sungguh."
      Speaker = "Hecate"
      Event = "HecateGift05"
    }
    {
      Id = "Hecate_0540"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira kubilang kau tak perlu mengambil hatiku seperti ini. Namun botol ini tetap kuterima; anggap saja sebagai hukuman karena tidak memberikannya kepada orang lain yang lebih pantas menerima kasih sayangmu."
      Speaker = "Hecate"
      Event = "HecateGift06"
    }
    {
      Id = "Melinoe_2167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada orang lain yang lebih pantas menerimanya selain dirimu, Kepala Sekolah. Kaulah yang menjadikanku dewi seperti sekarang, dan tiada satu malam pun berlalu tanpa rasa syukur atas hal itu."
      Speaker = "Melinoe"
      Event = "HecateGift06"
    }
    {
      Id = "Hecate_0541"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berapa kali harus kukatakan, aku bukan ibumu, Melinoë. Kau tak perlu menghujaniku dengan pujian berlebih seperti itu... Aku membesarkanmu untuk membinasakan musuh bersama kita. Kau tak berutang terima kasih apa pun padaku."
      Speaker = "Hecate"
      Event = "HecateGift06"
    }
    {
      Id = "Melinoe_2168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sering bilang, apa yang kita niatkan dan apa yang kita perbuat itu berbeda. Aku tahu kau bukan ibu kandungku, lalu kenapa? Kau telah merawatku; itu sudah lebih dari cukup."
      Speaker = "Melinoe"
      Event = "HecateGift06"
    }
    {
      Id = "Hecate_0542"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah memanfaatkanmu, dan masih memanfaatkannya sampai sekarang. Tidakkah kau menyadarinya? Aku bahkan tak berusaha menyembunyikan kenyataan itu darimu. Namun kau malah menepisnya."
      Speaker = "Hecate"
      Event = "HecateGift06"
    }
    {
      Id = "Melinoe_2169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membesarkanku sesuai dengan janji yang kau buat kepada ayahku. Dia tak pernah memintamu memanjakanku, kan? Beliau pasti ingin aku bisa berdiri di atas kakiku sendiri."
      Speaker = "Melinoe"
      Event = "HecateGift06"
    }
    {
      Id = "Hecate_0543"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau pikir kau sudah sanggup? Kau masih berada di bawah naunganku, masih menerima bantuan dari Olympus! Kau belum semandiri yang kurancang. Dan terlebih lagi, aku tanpa sengaja membuatmu berpikir bahwa hidupmu lebih baik karenaku!"
      Speaker = "Hecate"
      Event = "HecateGift06"
    }
    {
      Id = "Melinoe_2170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yakin memang begitu. Aku tak mengenal cara lain. Hatiku perih mengetahui kau merasa tak layak menerima kasih sayang yang kurasakan untukmu."
      Speaker = "Melinoe"
      Event = "HecateGift06"
    }
    {
      Id = "Hecate_0544"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Simpan dulu rasa perihmu itu baik-baik. Akan kuminum Nektarmu dan kunikmati, jika itu maumu."
      Speaker = "Hecate"
      Event = "HecateGift06"
    }
    {
      Id = "Melinoe_2171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Melinoe"
      Event = "HecateGift06"
    }
    {
      Id = "Hecate_1010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah memanfaatkanmu demi mencapai hasil tertentu, dan bahkan bukan hasil yang kucari. Kau pasti menyadarinya, bukan? Aku tak pernah berusaha menyembunyikan hal ini darimu. Tapi kau malah menepisnya."
      Speaker = "Hecate"
      Event = "HecateGift06_B"
    }
    {
      Id = "Hecate_1011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ternyata tidak! Kau masih berada di bawah naunganku; menerima bantuan dari Olympus! Kau mungkin bisa berpikir sendiri, tapi tetap bergantung pada banyak pihak lain. Terlebih lagi, tanpa sengaja aku membuatmu mengira bahwa aku telah menjadikan hidupmu lebih baik!"
      Speaker = "Hecate"
      Event = "HecateGift06_B"
    }
    {
      Id = "Melinoe_5029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita pergi ke kedai lagi? Sebelumnya Anda telah menghormati{#Emph}ku{#Prev}, dan aku sangat ingin menghormati {#Emph}Anda{#Prev}."
      Speaker = "Melinoe"
      Event = "HecateGift07"
    }
    {
      Id = "Hecate_0830"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu anggap saja aku sudah dihormati. Aku tak bernafsu untuk dipuja-puja seperti itu; para Arwah bisa melemparkan sesaji mereka untuk anjing-anjing saja."
      Speaker = "Hecate"
      Event = "HecateGift07"
    }
    {
      Id = "Melinoe_5030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, Anda adalah alasan kami semua berada di sini. Para Arwah mengagumi Anda, dan ingin merayakan bahwa tugas agung yang Anda rancang akhirnya tuntas!"
      Speaker = "Melinoe"
      Event = "HecateGift07"
    }
    {
      Id = "Hecate_0831"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita telah menuntaskan apa yang semestinya dikerjakan, dan kita sudah merayakannya terakhir kali kita ke kedai. Sekarang, serahkan Ambrosia itu, dan akan kusimpan untuk kesempatan berikutnya."
      Speaker = "Hecate"
      Event = "HecateGift07"
    }
    {
      Id = "Melinoe_5686"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini untuk Anda..."
      Speaker = "Melinoe"
      Event = "HecateGift07"
    }
    {
      Id = "Melinoe_5032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anda sempat bilang ingin menyimpan Ambrosia untuk perayaan berikutnya, jadi aku ingin menyumbang lebih banyak saat waktunya tiba. Demi kemenangan besar Kaum Gaib berikutnya!"
      Speaker = "Melinoe"
      Event = "HecateGift08"
    }
    {
      Id = "Hecate_0832"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}sudahlah{#Prev}, Melinoë! Jelas sekali kita berdua sama-sama kikuk dan tak tahu harus berbuat apa sekarang, sampai-sampai kau begitu {#Emph}ngotot {#Prev}memberi hadiah yang amat tidak perlu ini! Biarkan aku tenang."
      Speaker = "Hecate"
      Event = "HecateGift08"
    }
    {
      Id = "Melinoe_5687"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bermaksud membuat Anda kesal.... Apakah Anda benar-benar ingin aku tinggal di Graha saja? Bersama Ayah dan Ibu... tempatku yang sesungguhnya, seperti yang selalu Anda katakan."
      Speaker = "Melinoe"
      Event = "HecateGift08"
    }
    {
      Id = "Hecate_0833"
      InheritFrom = "BaseNarrative"
      DisplayName = "Enyahkan pikiran beracun {#Emph}itu {#Prev}sekarang juga. Aku mengajarkan banyak hal padamu dalam beberapa aspek, tapi itu mengorbankan pengalamanmu di jalan kehidupan lainnya."
      Speaker = "Hecate"
      Event = "HecateGift08"
    }
    {
      Id = "Melinoe_5688"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku cepat belajar."
      Speaker = "Melinoe"
      Event = "HecateGift08"
    }
    {
      Id = "Melinoe_3886"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah? Aku punya sebotol Ambrosia di sini, dan... kupikir mungkin kita bisa menikmatinya bersama di kedai, jika Anda berkenan meluangkan waktu sejenak! Aku tahu ini waktu yang aneh..."
      Speaker = "Melinoe"
      Event = "HecateTaverna01"
    }
    {
      Id = "Hecate_0696"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Melinoë, aku akan menahan doronganku untuk menolak mentah-mentah, agar aku bisa membuktikan sendiri apakah hidangan terlezat kaum Olympus ini sepadan dengan reputasinya! Ayo berangkat."
      Speaker = "Hecate"
      Event = "HecateTaverna01"
    }
    {
      Id = "Hecate_0697"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tak pernah benar-benar memikirkan kedai ini. Tempat berkumpul semacam ini, di mana orang bisa lengah... atau bahkan santai? Sungguh berbahaya. Panca indra kita harus selalu waspada."
      Speaker = "Hecate"
      Event = "HecateTaverna01"
    }
    {
      Id = "Melinoe_3887"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi sekarang setelah Anda berada di sini, Anda mulai menyadari bahwa memiliki tempat di mana kita dan para Arwah bisa membaur memiliki manfaatnya tersendiri? Dan bahwa aku tidak lancang saat memugarnya?"
      Speaker = "Melinoe"
      Event = "HecateTaverna01"
    }
    {
      Id = "Hecate_0698"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, aku menyadarinya, dan tidak, kau tidak lancang. Ketegangan di Persimpangan Jalan ini sudah terlalu pekat untuk seleraku, lagipula energi gelisah yang berlebihan tidak ada gunanya bagi perjuangan kita. Namun, aku melenceng. Pembahasan soal perjuangan kita seharusnya dilarang di sini."
      Speaker = "Hecate"
      Event = "HecateTaverna01"
    }
    {
      Id = "Melinoe_3888"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah ya, peraturan lagi! Persis seperti yang dibutuhkan kedai ini untuk meredakan ketegangan kelompok kecil kita yang setia. Tampaknya ide bagus, Kepala Sekolah!"
      Speaker = "Melinoe"
      Event = "HecateTaverna01"
    }
    {
      Id = "Hecate_0699"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, jadi begitu caramu bersikap. Apa, seteguk dua teguk Ambrosia dan tiba-tiba rasa seganmu lenyap seketika? Pengaruh yang luar biasa! Kita sebaiknya menggunakan ini di kuali kawah jika tidak di sini."
      Speaker = "Hecate"
      Event = "HecateTaverna01"
    }
    {
      Id = "Melinoe_3889"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kita masih membicarakan perjuangan dan ilmu sihir kita. Kenapa Anda tidak... menceritakan masa lalu Anda saat seusia denganku, jika tidak keberatan?"
      Speaker = "Melinoe"
      Event = "HecateTaverna01"
    }
    {
      Id = "Hecate_0700"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku keberatan. Walau mungkin seiring kita menghabiskan botol ini, aku takkan terlalu keberatan lagi! Haruskah kita buktikan? Demi menyingkap kebenaran!"
      Speaker = "Hecate"
      Event = "HecateTaverna01"
    }
    {
      Id = "Hecate_0701"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Abaikan sikap muramku tadi, Melinoë. Akhir-akhir ini aku lebih mengkhawatirkan masa depan daripada masa lalu. Kuharap aku tidak terlalu merusak suasananya."
      Speaker = "Hecate"
      Event = "HecateTaverna01"
    }
    {
      Id = "Melinoe_3891"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama sekali tidak, Kepala Sekolah. Kami bersyukur Anda bersedia bergabung bersama kami."
      Speaker = "Melinoe"
      Event = "HecateTaverna01"
    }
    {
      Id = "Melinoe_5023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah Anda berminat berbagi botol Ambrosia ini, Kepala Sekolah? Kita belum sempat benar-benar merayakan kembalinya Raja dan Ratu Underworld di sini."
      Speaker = "Melinoe"
      Event = "HecateTaverna02"
    }
    {
      Id = "Hecate_0824"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meneguk minuman kerabat gunungmu rasanya bukan perayaan yang pantas, tapi baiklah. Kau benar bahwa para Arwah ini pasti mengharapkan {#Emph}sesuatu."
      Speaker = "Hecate"
      Event = "HecateTaverna02"
    }
    {
      Id = "Hecate_0825"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maka dari itu, kuajak kalian semua memberi hormat kepada Putri Underworld kalian, yang tak pernah gentar menghadapi ancaman Sang Waktu itu sendiri, dan Sang Bapa Segala Monster, beserta banyak musuh lainnya!"
      Speaker = "Hecate"
      Event = "HecateTaverna02"
    }
    {
      Id = "Melinoe_5024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Kepala Sekolah. {#Emph}Semuanya! {#Prev}Aku takkan pernah bisa melakukan ini tanpa kalian... tanpa Persimpangan Jalan ini, satu-satunya tempat yang selalu bisa kukunjungi kembali di saat aku terdesak."
      Speaker = "Melinoe"
      Event = "HecateTaverna02"
    }
    {
      Id = "Hecate_0826"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu diterima di sini dan aman, Melinoë. Dan kendati kami menaruh keyakinan penuh padamu, apa yang telah kau capai sungguh melampaui segala bayangan."
      Speaker = "Hecate"
      Event = "HecateTaverna02"
    }
    {
      Id = "Melinoe_5025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya melakukan apa yang telah Anda ajarkan padaku. Aku bersyukur atas kesabaran Anda menghadapi begitu banyak rintangan yang harus kulalui."
      Speaker = "Melinoe"
      Event = "HecateTaverna02"
    }
    {
      Id = "Hecate_0827"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana lagi kita bisa melawan Sang Waktu itu sendiri jika bukan dengan kesabaran? Aku tahu kau akan menjadi murid yang cakap. 'Tis itulah satu-satunya alasan aku mendesakmu sekeras itu."
      Speaker = "Hecate"
      Event = "HecateTaverna02"
    }
    {
      Id = "Melinoe_5026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu apa yang akan terjadi pada Kaum Gaib sekarang? Para Arwah kita masing-masing memiliki tempat kehormatan di Elysium yang menanti mereka..."
      Speaker = "Melinoe"
      Event = "HecateTaverna02"
    }
    {
      Id = "Hecate_0828"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja begitu, andai mereka memilih pergi. Tapi, kuduga mereka tidak terburu-buru meninggalkan tempat ini, sama sepertimu. Selalu ada hal lain yang bisa kita capai di sini, dan kita bisa melangkah lebih jauh bersama daripada seorang diri."
      Speaker = "Hecate"
      Event = "HecateTaverna02"
    }
    {
      Id = "Hecate_0829"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Yah, tadi memang bukan perkumpulan yang paling formal, tapi kurasa ada faedahnya, bukan? Semua Arwah ini... mereka tiba di sini karena tak punya tempat lain untuk dituju. Sekarang, tempat ini sudah menjadi rumah tetap."
      Speaker = "Hecate"
      Event = "HecateTaverna02"
    }
    {
      Id = "Melinoe_5028"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan sekadar tempat singgah... melainkan tempat untuk menetap."
      Speaker = "Melinoe"
      Event = "HecateTaverna02"
    }
    {
      Id = "Melinoe_3892"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira Kepala Sekolah berkenan menemani saya ke kedai minum untuk menikmati sebotol Ambrosia, tidak ya?"
      Speaker = "Melinoe"
      Event = "HecateTavernaDecline01"
    }
    {
      Id = "Hecate_0702"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, kurasa tidak untuk saat ini. Aku tak ingin merusak suasana di sana di antara para Bayangan yang butuh ketenangan."
      Speaker = "Hecate"
      Event = "HecateTavernaDecline01"
    }
    {
      Id = "Melinoe_2095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka pasti merugi kalau begitu."
      Speaker = "Melinoe"
      Event = "HecateTavernaDecline01"
    }
    {
      Id = "Hecate_0905"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, baiklah kalau begitu. Asal kita tidak menarik perhatian."
      Speaker = "Hecate"
      Event = "HecateTavernaRepeatable01[1]"
    }
    {
      Id = "Hecate_0908"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan menemanimu, tapi hanya untuk satu tegukan saja, kalau sempat."
      Speaker = "Hecate"
      Event = "HecateTavernaRepeatable01[1]"
    }
    {
      Id = "Hecate_0911"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, mari menyelinap ke sana sebentar. Memangnya siapa yang berani menghentikan kita?"
      Speaker = "Hecate"
      Event = "HecateTavernaRepeatable01[1]"
    }
    {
      Id = "Hecate_0906"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Membayangkan dulu Olimpus punya persediaan benda ini tanpa batas..."
      Speaker = "Hecate"
      Event = "HecateTavernaRepeatable01[2]"
    }
    {
      Id = "Hecate_0909"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Para Bayangan kita menghabiskan sebagian besar eksistensi mereka di sini..."
      Speaker = "Hecate"
      Event = "HecateTavernaRepeatable01[2]"
    }
    {
      Id = "Hecate_0912"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Rasa minuman ini memang benar-benar semakin nikmat seiring berjalannya waktu."
      Speaker = "Hecate"
      Event = "HecateTavernaRepeatable01[2]"
    }
    {
      Id = "Hecate_0907"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kini setelah pikiran kita lebih tenang, bagaimana kalau kita kembali bertugas?"
      Speaker = "Hecate"
      Event = "HecateTavernaRepeatable01[3]"
    }
    {
      Id = "Hecate_0910"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi itu sebotol Ambrosia yang jauh lebih nikmat dari biasanya! Terima kasih."
      Speaker = "Hecate"
      Event = "HecateTavernaRepeatable01[3]"
    }
    {
      Id = "Hecate_0913"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita memang pantas mendapatkan rehat sejenak itu. Nah, sampai di mana kita tadi?"
      Speaker = "Hecate"
      Event = "HecateTavernaRepeatable01[3]"
    }
    {
      Id = "Melinoe_0669"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungai Kositus kembali dipenuhi kehidupan di tepiannya, Kepala Sekolah. Maukah Anda menemani saya melihat ke sana?"
      Speaker = "Melinoe"
      Event = "HecateFishing01"
    }
    {
      Id = "Hecate_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, baiklah, mengapa tidak! Kurasa aku memang butuh sedikit jalan santai, dan kita juga butuh ikannya."
      Speaker = "Hecate"
      Event = "HecateFishing01"
    }
    {
      Id = "Hecate_0651"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Belum lama berselang, kau takkan pernah mengizinkan dirimu bersantai seperti ini. Maupun punya nyali untuk meminta kutemani."
      Speaker = "Hecate"
      Event = "HecateFishing01"
    }
    {
      Id = "Melinoe_3454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah benar. Saya seharusnya memburu musuh kita saat ini juga, dan Anda... tanggung jawab Anda begitu banyak, tapi saya malah membuang waktu Anda. Ini sebuah kesalahan."
      Speaker = "Melinoe"
      Event = "HecateFishing01"
    }
    {
      Id = "Hecate_0652"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tenanglah, nanti kau mengagetkan para penghuni sungai; waktu kita di sini baru benar-benar terbuang jika hal itu terjadi, Melinoë! Kau salah menangkap maksud perkataanku. Kemampuanmu menenangkan pikiran yang kalut bukanlah kelemahan. Itu adalah kekuatan yang kian terasah!"
      Speaker = "Hecate"
      Event = "HecateFishing01"
    }
    {
      Id = "Melinoe_3455"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saya... terkejut Anda melihatnya begitu. Terkadang saya merasa kehilangan fokus. Untuk apa lagi saya mengajak kita ke sini?"
      Speaker = "Melinoe"
      Event = "HecateFishing01"
    }
    {
      Id = "Hecate_0653"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau berpikir bahwa kita berdua perlu mengalihkan pikiran ke hal lain untuk sementara. Dan kita justru gagal melakukannya jika terus berbicara! Mari hening sejenak bersama dan pusatkan perhatian kita ke air di sana."
      Speaker = "Hecate"
      Event = "HecateFishing01"
    }
    {
      Id = "Hecate_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungai selalu memberi, dan jangan pernah ada tugas mulia semacam ini yang kita anggap rendahan."
      Speaker = "Hecate"
      Event = "HecateFishing01"
    }
    {
      Id = "Melinoe_5035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira Anda bersedia pergi ke dermaga pemancingan bersama saya lagi? Tempat yang bagus untuk mengalihkan pikiran ke hal lain sejenak."
      Speaker = "Melinoe"
      Event = "HecateFishing02"
    }
    {
      Id = "Hecate_0834"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tempat itu memang cocok. Baiklah kalau begitu. Lagipula, ada sesuatu yang ingin kubicarakan denganmu."
      Speaker = "Hecate"
      Event = "HecateFishing02"
    }
    {
      Id = "Hecate_0835"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau sungguh percaya aku ingin menyingkirkanmu? Antara itu, atau kau memang berniat melukaiku lebih dalam lewat kata-katamu daripada yang sanggup dilakukan Senjata Nokturnal."
      Speaker = "Hecate"
      Event = "HecateFishing02"
    }
    {
      Id = "Melinoe_5036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan saya, Kepala Sekolah, hanya saja... saat di Kediaman, saya tersadar bahwa saya tidak sekadar ingin keluarga saya kembali... Saya juga ingin Anda bahagia. Namun saya merasa Anda justru menjauhkan diri dari saya."
      Speaker = "Melinoe"
      Event = "HecateFishing02"
    }
    {
      Id = "Hecate_0836"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebahagiaanku bukanlah tanggung jawabmu ataupun dalam jangkauanmu. Dan seharusnyalah aku yang meminta maaf. Atas semua yang telah kuberikan padamu. Maafkan aku."
      Speaker = "Hecate"
      Event = "HecateFishing02"
    }
    {
      Id = "Melinoe_5037"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jangan pernah meminta maaf saat kau tidak bersalah{#Prev}, itulah ajaran Anda dahulu. Anda tak pernah bersikap lunak pada saya, tapi Anda juga tidak pernah kejam. Anda mengajari saya perbedaannya, di antara banyak hal lainnya."
      Speaker = "Melinoe"
      Event = "HecateFishing02"
    }
    {
      Id = "Hecate_0837"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak berbuat kejam bukanlah standar yang paling tinggi. Bagaimanapun juga, jelas aku sudah mengajarimu cukup banyak. Aku akan tetap menantangmu di Erebus demi kebugaran dan penyelarasan, tetapi kelak, mungkin kau tak perlu lagi memanggil gelarku, melainkan dengan namaku..."
      Speaker = "Hecate"
      Event = "HecateFishing02"
    }
    {
      Id = "Melinoe_5038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan sebagai Kepala Sekolah, melainkan sebagai Hecate... butuh waktu untuk membiasakannya. Mengingat saya begitu santai memanggil nama Anda sewaktu masih kecil. Banyak hal yang kembali ke titik awal seiring berjalannya waktu."
      Speaker = "Melinoe"
      Event = "HecateFishing02"
    }
    {
      Id = "Hecate_0838"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih dari yang kau tahu. Sekarang, mari alihkan fokus kita pada para penghuni sungai yang sepertinya menguping terlalu dekat..."
      Speaker = "Hecate"
      Event = "HecateFishing02"
    }
    {
      Id = "Hecate_0839"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi itu tamasya yang cukup menyenangkan, namun jangan pernah lagi bicara padaku soal kebahagiaan. Itu hal konyol untuk dipusingkan; sekadar akibat dari pemenuhan tugas, tak lebih."
      Speaker = "Hecate"
      Event = "HecateFishing02"
    }
    {
      Id = "Melinoe_5039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja. Terima kasih, Kepala Sekolah... Hecate."
      Speaker = "Melinoe"
      Event = "HecateFishing02"
    }
    {
      Id = "Hecate_0899"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh punya sesuatu yang ingin kau buktikan di dermaga pemancingan itu...?"
      Speaker = "Hecate"
      Event = "HecateFishingRepeatable01[1]"
    }
    {
      Id = "Hecate_0901"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah! Mari kita lihat bagaimana perkembangan teknik memancingmu."
      Speaker = "Hecate"
      Event = "HecateFishingRepeatable01[1]"
    }
    {
      Id = "Hecate_0903"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir segalanya sudah beres, kurang lebih... kalau begitu, mari ke dermaga."
      Speaker = "Hecate"
      Event = "HecateFishingRepeatable01[1]"
    }
    {
      Id = "Hecate_0981"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, mari tunjukkan padaku apa saja yang sudah kau pelajari soal cara memancing."
      Speaker = "Hecate"
      Event = "HecateFishingRepeatable01[1]"
    }
    {
      Id = "Hecate_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... kurasa menatap air Sungai Cocytus mungkin ada baiknya untuk saat ini..."
      Speaker = "Hecate"
      Event = "HecateFishingRepeatable01[1]"
    }
    {
      Id = "Hecate_0900"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lama Sungai Cocytus menawarkan kelimpahannya kepada kita."
      Speaker = "Hecate"
      Event = "HecateFishingRepeatable01[2]"
    }
    {
      Id = "Hecate_0902"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menenangkan merenung sejenak di tepi sungai itu..."
      Speaker = "Hecate"
      Event = "HecateFishingRepeatable01[2]"
    }
    {
      Id = "Hecate_0904"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu banyak yang bisa dilihat dan direnungkan di tepi sungai itu..."
      Speaker = "Hecate"
      Event = "HecateFishingRepeatable01[2]"
    }
    {
      Id = "Hecate_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, yang jelas jiwa kita jadi lebih segar setelah tamasya tadi."
      Speaker = "Hecate"
      Event = "HecateFishingRepeatable01[2]"
    }
    {
      Id = "Hecate_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengalihan yang menyenangkan, meski kita berdua sebaiknya segera kembali ke tugas utama."
      Speaker = "Hecate"
      Event = "HecateFishingRepeatable01[2]"
    }
    {
      Id = "Melinoe_0665"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru, aku bertanya-tanya apakah Guru sudi menemaniku ke pemandian air panas sebentar? Itu pun kalau Guru tidak terlalu sibuk?"
      Speaker = "Melinoe"
      Event = "HecateBathHouse01"
    }
    {
      Id = "Hecate_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, yah, kurasa berendam sebentar bukan ide buruk. Punggungku terasa lebih kaku daripada pohon itu! Kalau begitu, jangan lama-lama."
      Speaker = "Hecate"
      Event = "HecateBathHouse01"
    }
    {
      Id = "Hecate_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, nikmat sekali. Terima kasih sudah memulihkan air panas ini! Salah satu hal yang sudah lama ingin kukerjakan, tapi... yah, begitulah."
      Speaker = "Hecate"
      Event = "HecateBathHouse01"
    }
    {
      Id = "Melinoe_0670"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama-sama, Guru. Senang mendengarnya, tadinya kukira Guru bakal memarahiku karena memakai sihir dan sumber daya untuk hal semacam ini."
      Speaker = "Melinoe"
      Event = "HecateBathHouse01"
    }
    {
      Id = "Hecate_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tujuan utama sihir memang {#Emph}untuk {#Prev}pengembangan diri, Melinoë. Tapi ingat, bukan jalan pintas. Dan kalau berendam air panas sekali-kali tidak termasuk pengembangan diri, berarti pemahamanku tentang itu keliru besar."
      Speaker = "Hecate"
      Event = "HecateBathHouse01"
    }
    {
      Id = "Melinoe_0671"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap aku bisa benar-benar rileks. Rasanya seperti membuang waktu berharga saat berdiam di sini."
      Speaker = "Melinoe"
      Event = "HecateBathHouse01"
    }
    {
      Id = "Hecate_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu yang dihabiskan untuk merawat diri tak pernah sia-sia... kecuali jika kau terlalu banyak berpikir! Kita ada {#Emph}di sini. {#Prev}Nikmati saat ini sebelum berlalu."
      Speaker = "Hecate"
      Event = "HecateBathHouse01"
    }
    {
      Id = "Hecate_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali kita tak bisa berendam selamanya di mata air itu, tapi... berendam sejenak lebih baik daripada tidak sama sekali."
      Speaker = "Hecate"
      Event = "HecateBathHouse01"
    }
    {
      Id = "Melinoe_0667"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berniat menggunakan garam pemurni ini, Guru. Anggap saja sebagai ritual penyucian. Maukah Guru menemaniku?"
      Speaker = "Melinoe"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Hecate_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergi ke pemandian air panas mestinya bisa menyingkirkan pikiran kalut untuk sementara. Mari kita sucikan diri bersama kalau begitu."
      Speaker = "Hecate"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Hecate_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm. {#Prev}Kita seperti dua daun jelatang yang direbus dalam kuali, ya?"
      Speaker = "Hecate"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Melinoe_0673"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingat pernah berendam di mata air ini saat masih sangat kecil. Guru selalu melarangku menciprati rambut Guru, tapi aku tetap melakukannya. Dulu Guru sabar sekali menghadapiku."
      Speaker = "Melinoe"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Hecate_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, setidaknya sekarang kau tahu alasan latihanmu begitu keras! Ada saatnya kesabaranku yang seluas samudera menghadapi cipratanmu itu akhirnya habis juga."
      Speaker = "Hecate"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Melinoe_0674"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu... Guru melatihku sampai ke puncak kemampuanku sebagai penyihir hanya gara-gara rambut Guru basah?"
      Speaker = "Melinoe"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Hecate_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm{#Prev}, pilihannya cuma itu, atau mengubahmu jadi kadal air, atau apalah! Sudahlah, Melinoë. Kau terkadang terlalu kaku dan serius."
      Speaker = "Hecate"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Melinoe_3471"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh. {#Prev}Pelajaran yang sampai sekarang belum bisa kuresapi, Guru. Rasanya sudah lama sekali kita tidak berbincang santai seperti ini."
      Speaker = "Melinoe"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Hecate_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, begitulah proses menjadi dewasa. Ditambah lagi situasi kita saat ini tidak membantu. Pemandian air panas terkutuk ini tadinya tertutup lumut dan terabaikan entah berapa lama. Berada di sini lagi... membuatku bernostalgia."
      Speaker = "Hecate"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Melinoe_0676"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurut Guru, apakah kita bisa mencegah lumut mengambil alih tempat ini lagi?"
      Speaker = "Melinoe"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Hecate_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yang awasi lumutnya, kau awasi cipratan airmu. Sepakat?"
      Speaker = "Hecate"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Hecate_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh! {#Prev}Jauh lebih segar. Terkadang kupikir pemandian air panas itu bahkan sanggup membangkitkan orang mati."
      Speaker = "Hecate"
      Event = "HecateBathHouse02"
    }
    {
      Id = "Melinoe_0668"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu sekarang situasi sedang sulit, Guru, tapi sekadar memastikan, apa Guru berminat menemaniku berendam sebentar di pemandian air panas?"
      Speaker = "Melinoe"
      Event = "HecateBathHouseDecline01"
    }
    {
      Id = "Hecate_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku ingin sekali berendam di mata air itu, masih ada mantra yang harus kuselesaikan, bangsal perlindungan yang harus kuperkuat.... Tidak, aku tidak bisa. Tidak sekarang."
      Speaker = "Hecate"
      Event = "HecateBathHouseDecline01"
    }
    {
      Id = "Hecate_0890"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah kalau begitu. Sesekali membersihkan diri memang sudah semestinya."
      Speaker = "Hecate"
      Event = "HecateBathHouseRepeatable01[1]"
    }
    {
      Id = "Hecate_0893"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kenapa tidak. Berendam sejenak di mata air itu kurasa sudah cukup."
      Speaker = "Hecate"
      Event = "HecateBathHouseRepeatable01[1]"
    }
    {
      Id = "Hecate_0896"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, mari kita sucikan diri lagi dalam hangatnya pemandian itu."
      Speaker = "Hecate"
      Event = "HecateBathHouseRepeatable01[1]"
    }
    {
      Id = "Hecate_0891"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Air ini terus bergolak tanpa henti, tapi apa sebenarnya yang ingin disampaikannya...?"
      Speaker = "Hecate"
      Event = "HecateBathHouseRepeatable01[3]"
    }
    {
      Id = "Hecate_0894"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}<Menghela napas> {#Prev}Yah, jika ada yang mengganjal di pikiranmu, bicarakan saja."
      Speaker = "Hecate"
      Event = "HecateBathHouseRepeatable01[3]"
    }
    {
      Id = "Hecate_0897"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dahulu kenyamanan semacam ini tidak selalu bisa kita nikmati."
      Speaker = "Hecate"
      Event = "HecateBathHouseRepeatable01[3]"
    }
    {
      Id = "Hecate_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Hrm{#Prev}, kandungan garamnya pas dan airnya cukup panas."
      Speaker = "Hecate"
      Event = "HecateBathHouseRepeatable01[3]"
    }
    {
      Id = "Hecate_0892"
      InheritFrom = "BaseNarrative"
      DisplayName = "Momen-momen menenangkan seperti ini membuat segala jerih payah kita terasa berharga."
      Speaker = "Hecate"
      Event = "HecateBathHouseRepeatable01[4]"
    }
    {
      Id = "Hecate_0895"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau cukup pendiam tadi, tapi tampaknya kau merasa nyaman..."
      Speaker = "Hecate"
      Event = "HecateBathHouseRepeatable01[4]"
    }
    {
      Id = "Hecate_0898"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah. {#Prev}Kuharap kau membiarkan semua beban pikiranmu mendidih dan lenyap di kolam tadi."
      Speaker = "Hecate"
      Event = "HecateBathHouseRepeatable01[4]"
    }
    {
      Id = "Melinoe_5306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurut Guru, bisakah kita istirahat sejenak dari semua ini dan mampir ke sungai dekat dermaga?"
      Speaker = "Melinoe"
      Event = "HecateFishingDecline01"
    }
    {
      Id = "Hecate_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang ingin melihat langsung apakah kemampuan memancingmu sudah membaik, namun sayangnya ada urusan lain yang harus segera kutangani."
      Speaker = "Hecate"
      Event = "HecateFishingDecline01"
    }
    {
      Id = "Melinoe_1725"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kepala Sekolah sedang pergi."
      Speaker = "Melinoe"
      Event = "NPC_Hecate_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_1726"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak ada tanda-tanda keberadaan Kepala Sekolah."
      Speaker = "Melinoe"
      Event = "NPC_Hecate_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_1148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Roda Perakmu? Ini boleh untukku?"
      Speaker = "Melinoe"
      Event = "NPC_Hecate_01.GiftGivenVoiceLines"
    }
    {
      Id = "Melinoe_2120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kena kau, Hecate!! Kau kalah!"
      Speaker = "Melinoe"
      Event = "HecateHideAndSeek01"
    }
    {
      Id = "Hecate_0516"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Haha{#Prev}, kau berhasil menangkapku, Melinoë. Tapi jangan salah, aku masih bisa lolos dari cengkeramanmu!"
      Speaker = "Hecate"
      Event = "HecateHideAndSeek01"
    }
    {
      Id = "Melinoe_2121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei...!"
      Speaker = "Melinoe"
      Event = "HecateHideAndSeek01"
    }
    {
      Id = "Hecate_0522"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Awooo..."
      Speaker = "Hecate"
      Event = "HecateHideAndSeek01"
    }
    {
      Id = "Melinoe_2112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak bisa bersembunyi dariku...!"
      Speaker = "Melinoe"
      Event = "HecateHideAndSeek01"
    }
    {
      Id = "Melinoe_2122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu dia! Kena kau lagi!"
      Speaker = "Melinoe"
      Event = "HecateHideAndSeek02"
    }
    {
      Id = "Hecate_0517"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aah! {#Prev}Gigih sekali! Menyerah sajalah, Penyihir cilik! Karena aku ini seorang Titaness! {#Emph}Kau {#Prev}tidak akan bisa mengalahkan{#Emph}ku!"
      Speaker = "Hecate"
      Event = "HecateHideAndSeek02"
    }
    {
      Id = "Melinoe_2123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bisa, dan aku pasti akan melakukannya!"
      Speaker = "Melinoe"
      Event = "HecateHideAndSeek02"
    }
    {
      Id = "Melinoe_2124"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hahaha{#Prev}, kena {#Emph}kau!{#Prev}! ...Hecate...? Ada apa?"
      Speaker = "Melinoe"
      Event = "HecateHideAndSeek03"
    }
    {
      Id = "Hecate_0518"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Ah{#Prev}, hanya saja... {#Emph}ck{#Prev}, aku belum pernah mendengar tawamu sebelumnya. Mengingatkanku pada ibumu! Suara yang jauh lebih menyenangkan daripada ratapan duka."
      Speaker = "Hecate"
      Event = "HecateHideAndSeek03"
    }
    {
      Id = "Melinoe_2343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berjanji tidak akan menangis lagi! Kadang aku masih sedih, tapi tidak sesering dulu..."
      Speaker = "Melinoe"
      Event = "HecateHideAndSeek03"
    }
    {
      Id = "Hecate_0519"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan membuat janji yang tak bisa kaukepati. Saat air mata menggenang, biarkanlah mengalir; air mata itu bukan hal berharga yang harus selalu kaupendam."
      Speaker = "Hecate"
      Event = "HecateHideAndSeek03"
    }
    {
      Id = "Melinoe_2126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau tak pernah menangis, Hecate! Dan aku ingin menjadi kuat, sepertimu! Supaya aku bisa menemukan Chronos dan menghancurkannya atas apa yang telah dia perbuat. Dan dengan begitu, kau bisa mendengar tawa ibuku lagi!"
      Speaker = "Melinoe"
      Event = "HecateHideAndSeek03"
    }
    {
      Id = "Hecate_0520"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku akan mengerahkan segalanya untuk mempersiapkanmu, agar kau bisa berhasil di tempat aku gagal. Jika bukan demi keluargamu, maka demi hak kelahirannmu... sebagai Putri Underworld."
      Speaker = "Hecate"
      Event = "HecateHideAndSeek03"
    }
    {
      Id = "Melinoe_2344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maksudmu kau gagal? Kau pernah mencoba mengalahkan Chronos sendiri? Apa dia melukaimu?"
      Speaker = "Melinoe"
      Event = "HecateHideAndSeek03"
    }
    {
      Id = "Hecate_0521"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pikirkanlah rasa sakitmu sendiri, bukan milikku. Menghancurkan Chronos takkan mengubah masa lalu, dan rasa sakit itu akan tetap membekas, meski kian mereda seiring berjalannya usia... tapi sudahlah! Besok, kita akan mengajarimu cara memburu mangsa yang lebih besar."
      Speaker = "Hecate"
      Event = "HecateHideAndSeek03"
    }
    {
      Id = "Melinoe_2128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Terkesiap> {#Prev}Benarkah?"
      Speaker = "Melinoe"
      Event = "HecateHideAndSeek03"
    }
  ]
}
