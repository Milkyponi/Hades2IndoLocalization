{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Dora.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "Dora_0562"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, awas dong!"
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0563"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga jarak, Mel."
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0564"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waduh, pelan-pelan."
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0565"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aduh."
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, mundur dikit."
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan sentuh-sentuh."
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0568"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa mundur dikit?"
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0570"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Permisi, {#Emph}situ {#Prev}yang nabrak ya."
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0573"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lumayan kerasa tuh."
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0571"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukutuk kau!"
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0572"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kena kutuk tahu rasa."
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Beraninya kau?!"
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Dora_0575"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Terkutuklah kau!"
      Speaker = "Dora"
      Event = "PostTriggerFunctionArgs.ThreadedVoiceLines"
    }
    {
      Id = "Melinoe_1885"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, arwah!"
      Speaker = "Melinoe"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kau memanggilku?!"
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Siapa yang berani memanggilku?!"
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Berlututlah, penyihir!"
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Binasalah kalian semua!"
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Rasakan seribu siksaan!"
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dan biarkan mentari memutihkan tulang-belulangmu!"
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Biarlah teror melanda kita!"
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah apa pun yang mempan deh."
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tetap di sini aja."
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo dong, Mel."
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aduh, santai dikit napa..."
      Speaker = "Dora"
      Event = "NPC_Dora_01.InteractVoiceLines"
    }
    {
      Id = "Dora_0004_01_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Siapa yang berani mengusik istirahat abadiku?! Kau bermain-main dengan kekuatan yang jauh melampaui akalmu, hai penyihir!"
      Speaker = "Dora"
      Event = "DoraFirstMeeting"
    }
    {
      Id = "Dora_0646"
      InheritFrom = "BaseNarrative"
      DisplayName = " {#Prev}Lumayan seram kan, Mel? Atau manggilmu penyihir kayak tadi agak kelewatan ya?"
      Speaker = "Dora"
      Event = "DoraFirstMeeting"
    }
    {
      Id = "Melinoe_5191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Secara keseluruhan akting menakut-nakutimu mantap, Dora, dan bagian penyihir tadi pas kok. Tapi, aku harus pergi sekarang. Ada urusan yang harus kuselesaikan."
      Speaker = "Melinoe"
      Event = "DoraFirstMeeting"
    }
    {
      Id = "Dora_0005"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kalau begitu enyahlah!"
      Speaker = "Dora"
      Event = "DoraFirstMeeting"
    }
    {
      Id = "Melinoe_1302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, aku butuh bantuanmu, kalau kamu lagi senggang. Karena tugasku, aku tak bisa lagi mengawasi proyek pemugaran di sekitar sini. Maukah kamu yang mengurusnya?"
      Speaker = "Melinoe"
      Event = "DoraGrantsCosmeticsShop01"
    }
    {
      Id = "Dora_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bentar, kamu minta {#Emph}aku {#Prev}mengawasi perombakan total seluruh perkemahan ini jadi suaka impian bagi para Arwah dan kaum terbuang?"
      Speaker = "Dora"
      Event = "DoraGrantsCosmeticsShop01"
    }
    {
      Id = "Melinoe_1303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}tahu {#Prev}aku bisa mengandalkanmu. Aku yang sediakan bahannya, kamu yang jadi penanggung jawab utamanya."
      Speaker = "Melinoe"
      Event = "DoraGrantsCosmeticsShop01"
    }
    {
      Id = "Dora_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hhhmmmmmm {#Prev}ya udah deh, boleh."
      Speaker = "Dora"
      Event = "DoraGrantsCosmeticsShop01"
    }
    {
      Id = "Melinoe_1304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah!"
      Speaker = "Melinoe"
      Event = "DoraGrantsCosmeticsShop01"
    }
    {
      Id = "Melinoe_2021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Proyek pemugarannya dimulai dengan sangat baik! Bagaimana rasanya memegang semua tanggung jawab baru ini?"
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics01"
    }
    {
      Id = "Dora_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Uh, {#Prev}oke deh, kayaknya! Kadang kupikir lebih enak nggak ngapa-ngapain... tapi, ya kupaham harus ada yang ngerjain hal-hal beginian, dan rasanya mustahil {#Emph}pemalas-pemalas {#Prev}di luar sana itu mau ngerjainnya."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics01"
    }
    {
      Id = "Melinoe_2022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah-arwah lain punya tugas mereka masing-masing. Pekerjaan ini tak harus melelahkan, justru bisa memberi kepuasan batin! Membantu orang lain, memiliki tujuan hidup..."
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics01"
    }
    {
      Id = "Dora_0173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tujuanku{#Prev}, Mel, cuma nongkrong santai."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics01"
    }
    {
      Id = "Dora_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu akal-akalanmu menyuruhku mengurus semua dekorasi ini, Mel. Kenapa, kau pikir aku bakal menemukan jati diriku dalam kematian hanya dengan mengganti beberapa kap lampu tua?"
      Speaker = "Dora"
      Event = "DoraAboutCosmetics02"
    }
    {
      Id = "Melinoe_3697"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah menemukan jati dirimu, sebagai arwah pengganggu terbaik di seluruh Crossroads, bahkan mungkin di seluruh dunia. Proyek pembaruan ini hanya salah satu cara untuk membalas budi pada tempat ini."
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics02"
    }
    {
      Id = "Dora_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja... tapi aku bakal jadi arwah pengganggu yang payah kalau keberadaanku nggak benar-benar hampa makna. Jadi jangan sampai ketahuan kau mencoba membantuku menemukan suatu tujuan... soalnya aku sama sekali nggak mau."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics02"
    }
    {
      Id = "Melinoe_3698"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan sampai terpikir begitu."
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics02"
    }
    {
      Id = "Dora_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kadang aku hampir nggak mengenali tempat ini lagi... maksudku tenda ini. Coba {#Emph}lihat {#Prev}semua barang ini! Sekarang praktis sudah kayak istana."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics03"
    }
    {
      Id = "Melinoe_3695"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah mengira akan ingin tinggal di istana. Meski kalau kau mengatakannya seperti itu, aku jadi ragu. Apakah semua sentuhan dekorasi terbaru ini sesuai seleramu?"
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics03"
    }
    {
      Id = "Dora_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makin banyak barang buat diisengi berarti makin banyak peluang buat bergentayangan, jadi ya! Menurutku oke saja. Justru {#Emph}kamu {#Prev}yang kukhawatirkan... tempat ini nggak se-{#Emph}rapi {#Prev}dan se-{#Emph}lega {#Prev}dulu lagi..."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics03"
    }
    {
      Id = "Melinoe_3696"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita selalu bisa merapikannya lagi."
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics03"
    }
    {
      Id = "Dora_0309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tolong jangan..."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics03"
    }
    {
      Id = "Dora_0612"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, waktu dulu kau mengajakku ikut urusan {#Emph}Proyek Pembaruan{#Prev}-mu itu... aku tahu apa maumu, Mel. Nggak ada yang bisa bikin kita berhenti memikirkan betapa sia-sianya hidup ini selain setumpuk kerjaan remeh-temeh, kan?"
      Speaker = "Dora"
      Event = "DoraAboutCosmetics04"
    }
    {
      Id = "Melinoe_4681"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah menganggapnya sebagai kerjaan remeh-temeh. Lihat seberapa banyak yang sudah berhasil kita capai di sini! Tempat ini berkembang pesat, Arwah-arwah lain tampak bersemangat... kau punya andil besar dalam hal itu!"
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics04"
    }
    {
      Id = "Dora_0613"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar berpikir begitu...? Yang mau kubilang tadi itu, entah sejak kapan kerjaan remeh ini mulai terasa menyenangkan bagiku. Nggak terasa sia-sia lagi, biarpun kenyataannya memang begitu."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics04"
    }
    {
      Id = "Melinoe_4682"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika tak {#Emph}terasa {#Prev}sia-sia, berarti memang tidak sia-sia."
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics04"
    }
    {
      Id = "Dora_0614"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Entahlah. Mungkin saja."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics04"
    }
    {
      Id = "Dora_0649"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dapat semua figur Chthonic Chid itu sampai yang terakhir, {#Emph}ya? {#Prev}Nggak nyangka kau tipe orang yang suka menimbun barang-barang nggak berguna."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics05"
    }
    {
      Id = "Melinoe_5470"
      InheritFrom = "BaseNarrative"
      DisplayName = "Barang-barang ini {#Emph}tidak {#Prev}tidak berguna! Aku {#Emph}menikmati {#Prev}mengoleksi semuanya, dan menatanya dengan rapi. Dan nilainya kemungkinan akan bertambah seiring berjalannya waktu!"
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics05"
    }
    {
      Id = "Dora_0650"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, kau berniat menjualnya demi {#Emph}keuntungan? {#Prev}Kira-kira siapa juga yang mau beli barang begituan darimu! Tapi... aku nggak bermaksud jahat, kok. Menurutku lucu saja kau punya setumpuk mainan anak-anak."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics05"
    }
    {
      Id = "Melinoe_5471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu bukan konsumsi anak-anak!"
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics05"
    }
    {
      Id = "Dora_0652"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Iya deh, iya."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics05"
    }
    {
      Id = "Dora_0643"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kita sudah selesai? Dengan Proyek Pembaruan ini. Sudah nggak banyak barang yang tersisa untuk diambil. Walaupun, kurasa kau masih bisa terus menukar-nukar posisinya."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics06"
    }
    {
      Id = "Melinoe_5467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hampir tak menyadarinya. Mungkin untuk saat ini perabotan baru dan semacamnya sudah cukup. Lihat seberapa jauh kita melangkah!"
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics06"
    }
    {
      Id = "Dora_0644"
      InheritFrom = "BaseNarrative"
      DisplayName = "Iya... mencicilnya sedikit demi sedikit, satu karpet atau meja dalam satu waktu, ya? Wah. Tapi jangan diulang lagi ya, aku capek banget."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics06"
    }
    {
      Id = "Melinoe_5468"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu cuma jiwa resahmu yang sedang berbicara."
      Speaker = "Melinoe"
      Event = "DoraAboutCosmetics06"
    }
    {
      Id = "Dora_0645"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu saatnya menidurkan jiwa resah ini."
      Speaker = "Dora"
      Event = "DoraAboutCosmetics06"
    }
    {
      Id = "Dora_0785"
      InheritFrom = "BaseNarrative"
      DisplayName = "Barang-barang baru yang ada di persediaan kita... asalnya dari Griya Hades, kan? Berkualitas banget! Nggak heran kau ngotot mau menyelamatkan keluargamu."
      Speaker = "Dora"
      Event = "DoraAboutDreamRunCosmetics01"
    }
    {
      Id = "Melinoe_5888"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, dari sekian banyak faktor yang memotivasiku menjalankan tugas ini, kesempatan mengumpulkan memorabilia dari rumah asliku jelas bukan salah satunya! Kebetulan saja sekarang aku menyukainya."
      Speaker = "Melinoe"
      Event = "DoraAboutDreamRunCosmetics01"
    }
    {
      Id = "Dora_0786"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku nggak menghakimi kok, dan kelihatannya kenalan-kenalanmu di bawah sana juga nggak. Tapi heran saja, kenapa mereka memaksamu membayar pakai stiker bintang emas kecil begitu."
      Speaker = "Dora"
      Event = "DoraAboutDreamRunCosmetics01"
    }
    {
      Id = "Melinoe_5889"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga belum memahami semua tradisi mereka."
      Speaker = "Melinoe"
      Event = "DoraAboutDreamRunCosmetics01"
    }
    {
      Id = "Dora_0787"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya sudahlah, kabari saja kalau ada info baru."
      Speaker = "Dora"
      Event = "DoraAboutDreamRunCosmetics01"
    }
    {
      Id = "Dora_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, bagaimana kabar Bawang Hantu tua itu? Kupikir benda yang membantumu tetap hidup bakal lebih berguna buatmu ketimbang buatku saat ini... selain itu, baunya agak menjijikkan."
      Speaker = "Dora"
      Event = "DoraAboutKeepsake01"
    }
    {
      Id = "Melinoe_3694"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sangat membantu, terima kasih banyak, Dora. Meski Bawangmu itu membuatku bertahan lebih lama dari biasanya di luar hampir setiap malam, sementara kau sendirian di sini..."
      Speaker = "Melinoe"
      Event = "DoraAboutKeepsake01"
    }
    {
      Id = "Dora_0306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kulihat semuanya berjalan sesuai rencana..."
      Speaker = "Dora"
      Event = "DoraAboutKeepsake01"
    }
    {
      Id = "Dora_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mel! Kukira akhirnya aku bisa sendirian di sini, eh tahu-tahu kamu sudah balik lagi. Bikin kaget setengah mati—maksudku, setengah hidup! Malam yang berat lagi?"
      Speaker = "Dora"
      Event = "DoraAboutReturning01"
    }
    {
      Id = "Melinoe_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang berat, Dora. Jangan khawatir, nanti tenda ini bakal jadi milikmu sepenuhnya kok! Sampai jumpa."
      Speaker = "Melinoe"
      Event = "DoraAboutReturning01"
    }
    {
      Id = "Dora_0003"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, sampai jumpa juga."
      Speaker = "Dora"
      Event = "DoraAboutReturning01"
    }
    {
      Id = "Dora_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu nggak, seram juga ya melihatmu nggak pernah masuk lewat pintu depan lagi belakangan ini. Pernah kepikiran buat jadi hantu penasaran juga?"
      Speaker = "Dora"
      Event = "DoraAboutReturning02"
    }
    {
      Id = "Melinoe_1827"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu saja! Kupikir kalau rencana ini gagal semua, kita sekalian saja bergentayangan di muka bumi, menebar teror ke hati manusia fana mana pun yang berani menatap kita."
      Speaker = "Melinoe"
      Event = "DoraAboutReturning02"
    }
    {
      Id = "Dora_0190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Terkesiap> {#Prev}Nah, gitu dong, baru seru..."
      Speaker = "Dora"
      Event = "DoraAboutReturning02"
    }
    {
      Id = "Dora_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh! {#Prev}Kukira kamu nggak bakal sadar lagi. Kamu nggak apa-apa?"
      Speaker = "Dora"
      Event = "DoraAboutReturning03"
    }
    {
      Id = "Melinoe_2018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Iya, terima kasih, Dora. Kuharap aku tidak membuatmu cemas. Apa kamu menemaniku di sini sepanjang waktu?"
      Speaker = "Melinoe"
      Event = "DoraAboutReturning03"
    }
    {
      Id = "Dora_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hah, aku? Nggak lah. Cuma lagi cari angin segar saja."
      Speaker = "Dora"
      Event = "DoraAboutReturning03"
    }
    {
      Id = "Melinoe_2819"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi kamu bahkan tidak bernapas..."
      Speaker = "Melinoe"
      Event = "DoraAboutReturning03"
    }
    {
      Id = "Dora_0152"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan mulai, deh...!"
      Speaker = "Dora"
      Event = "DoraAboutReturning03"
    }
    {
      Id = "Dora_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu tahu kan bisa cerita apa saja padaku, Mel? Nggak bakal kuhakimi, kok! Yah... paling cuma sedikit lebih bawel dibanding makhluk hijau kenyal satunya yang sering kamu curhati tiap malam, tapi tetap saja."
      Speaker = "Dora"
      Event = "DoraAboutFrinos01"
    }
    {
      Id = "Melinoe_3692"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak pernah menyamakanmu dengan Frinos sebelumnya. Aku bercerita padanya soal kegagalan dan kesalahanku... tapi aku bersedia menyisihkan beberapa cerita untukmu kalau kamu mau!"
      Speaker = "Melinoe"
      Event = "DoraAboutFrinos01"
    }
    {
      Id = "Dora_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sip, tumpahkan saja semuanya padaku! Semakin parah kekacauannya, semakin ingin aku tahu {#Emph}setiap detail serunya."
      Speaker = "Dora"
      Event = "DoraAboutFrinos01"
    }
    {
      Id = "Melinoe_3693"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku menghargai jasamu."
      Speaker = "Melinoe"
      Event = "DoraAboutFrinos01"
    }
    {
      Id = "Melinoe_3375"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, aku perhatikan koleksi toplesku tidak tersusun rapi. Apa kamu sengaja mau membuatku perlahan-lahan gila?"
      Speaker = "Melinoe"
      Event = "DoraAboutTent01"
    }
    {
      Id = "Dora_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak, kok.... Meskipun, setelah kamu bilang begitu, mungkin nanti-nanti bakal {#Emph}iya{#Prev}. Tadi aku lagi melatih kemampuan merasuki benda kecil, terus botol jamurmu agak meleset. Jadi kukembalikan ke tempatnya!"
      Speaker = "Dora"
      Event = "DoraAboutTent01"
    }
    {
      Id = "Melinoe_0964"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu mengembalikannya dengan {#Emph}posisi yang salah{#Prev}. Aku... {#Emph}ugh{#Prev}. Lain kali beri tahu aku dulu kalau ada hal semacam itu, ya?"
      Speaker = "Melinoe"
      Event = "DoraAboutTent01"
    }
    {
      Id = "Dora_0159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa iya, bisa nggak."
      Speaker = "Dora"
      Event = "DoraAboutTent01"
    }
    {
      Id = "Dora_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu nggak, Mel, kamu tuh kadang terlalu tegang. Dari mana sih sifat begitu? Kepala Penyihir saja lebih santai daripada kamu."
      Speaker = "Dora"
      Event = "DoraAboutTent02"
    }
    {
      Id = "Melinoe_1820"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, aku sedang berada di bawah tekanan besar sekarang, paham? Semua orang mengandalkanku untuk secara harfiah {#Emph}membunuh Sang Waktu... {#Prev}jadi aku ingin tenda ini tetap rapi! Apalagi aku harus bolak-balik ke sini begitu sering..."
      Speaker = "Melinoe"
      Event = "DoraAboutTent02"
    }
    {
      Id = "Dora_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Halah{#Prev}, terus kenapa? Menghabiskan waktu itu keahlian utamaku, tuh lihat {#Emph}aku {#Prev}nggak pernah heboh panik."
      Speaker = "Dora"
      Event = "DoraAboutTent02"
    }
    {
      Id = "Melinoe_1821"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ungh..."
      Speaker = "Melinoe"
      Event = "DoraAboutTent02"
    }
    {
      Id = "Melinoe_1822"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, aku sedang berpikir... kalau aku berjanji tidak akan terlalu {#Emph}tegang{#Prev}, seperti katamu... apa kamu mau berjanji tidak mengotak-atik barang-awalku saat aku pergi?"
      Speaker = "Melinoe"
      Event = "DoraAboutTent03"
    }
    {
      Id = "Dora_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Berani-beraninya kamu menuntutku, dasar remahan tak berarti? Mmm{#Prev}, ogah, nggak ada kesepakatan. Mau tegang ya silakan saja, jangan berhenti cuma demi aku."
      Speaker = "Dora"
      Event = "DoraAboutTent03"
    }
    {
      Id = "Melinoe_1823"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu cuma mau terus mengacak-acak barangku!"
      Speaker = "Melinoe"
      Event = "DoraAboutTent03"
    }
    {
      Id = "Dora_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mmm{#Prev}, tepat sekali."
      Speaker = "Dora"
      Event = "DoraAboutTent03"
    }
    {
      Id = "Dora_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, Kepala Penyihir nggak terlalu memarahimu, kan? Soalnya belakangan ini kamu lumayan sering pulang ke sini."
      Speaker = "Dora"
      Event = "DoraAboutHecate01"
    }
    {
      Id = "Melinoe_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu Ibu Guru bisa sangat menuntut. Aku yakin beliau berharap aku sudah meraih lebih banyak keberhasilan sekarang, tapi... beliau selalu bersikap sabar."
      Speaker = "Melinoe"
      Event = "DoraAboutHecate01"
    }
    {
      Id = "Dora_0052"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benaran? Yah, kuharap kesabarannya {#Emph}itu {#Prev}bisa awet!"
      Speaker = "Dora"
      Event = "DoraAboutHecate01"
    }
    {
      Id = "Melinoe_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kamu pernah mengobrol dengan Komandan Schelemeus, Dora? Atau Odysseus? Kita punya tokoh-tokoh hebat di pihak kita, yang tahu begitu banyak sejarah. Banyak hal yang bisa mereka ajarkan pada kita."
      Speaker = "Melinoe"
      Event = "DoraAboutCompanions01"
    }
    {
      Id = "Dora_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sejarah? Begitu ya namanya zaman sekarang? Yah, dalam waktu dekat aku nggak ada rencana besar ikut perang bareng kalian, tapi kalau berubah pikiran, mungkin aku bakal sowan ke orang-orang itu."
      Speaker = "Dora"
      Event = "DoraAboutCompanions01"
    }
    {
      Id = "Melinoe_0436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka orang-orang baik!"
      Speaker = "Melinoe"
      Event = "DoraAboutCompanions01"
    }
    {
      Id = "Melinoe_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kamu tidak punya teman di antara para Arwah lainnya, Dora? Kamu bisa bergabung dengan mereka untuk berkegiatan di luar sana. Tempat itu makin ramai akhir-akhir ini."
      Speaker = "Melinoe"
      Event = "DoraAboutShades01"
    }
    {
      Id = "Dora_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Penyihir bodoh! {#Prev}Menghantui tenda ini adalah obsesi purna-waktu. Kami para Arwah rendahan bisa sangat berpikiran sempit, tahu! Kurasa mirip manusia fana juga, sih."
      Speaker = "Dora"
      Event = "DoraAboutShades01"
    }
    {
      Id = "Melinoe_0430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan cuma manusia fana..."
      Speaker = "Melinoe"
      Event = "DoraAboutShades01"
    }
    {
      Id = "Dora_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, gimana caramu nyuruh Arwah-arwah lain di luar sana ngerjain tugas remeh-temeh di sini? Mereka kayaknya sampai menyembah tanah tempatmu berpijak."
      Speaker = "Dora"
      Event = "DoraAboutShades02"
    }
    {
      Id = "Melinoe_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah yang menampung mereka. Aku membantu melatih dan berkomunikasi dengan mereka. Banyak yang datang karena terjebak di antara alam fana dan baka. Beberapa tidak pernah dimakamkan secara layak. Yang lain mati penasaran, atau secara mengenaskan. Mereka tidak pernah berhasil sampai ke Underworld."
      Speaker = "Melinoe"
      Event = "DoraAboutShades02"
    }
    {
      Id = "Dora_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}... nyesek banget. Hei, kamu nggak mengira {#Emph}aku {#Prev}termasuk dalam salah satu kategori itu, kan? Nggak sudi rasanya membayangkan kalau dulu aku nggak dapat {#Emph}pemakaman yang layak{#Prev}."
      Speaker = "Dora"
      Event = "DoraAboutShades02"
    }
    {
      Id = "Melinoe_0434"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini bukan bahan lelucon, Dora."
      Speaker = "Melinoe"
      Event = "DoraAboutShades02"
    }
    {
      Id = "Dora_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di luar makin ramai saja! Makin banyak Arwah, ada cowok bertanduk itu juga. Aku nggak suka, Mel! Nggak suka sama sekali."
      Speaker = "Dora"
      Event = "DoraAboutShades03"
    }
    {
      Id = "Melinoe_1824"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seiring bertambahnya jumlah kita, kekuatan kita pun bertambah. Apa yang kamu khawatirkan dari itu?"
      Speaker = "Melinoe"
      Event = "DoraAboutShades03"
    }
    {
      Id = "Dora_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak suka berbagi. Kecuali tenda ini, aku nggak keberatan berbagi denganmu! Ya, hampir setiap saat, sih."
      Speaker = "Dora"
      Event = "DoraAboutShades03"
    }
    {
      Id = "Melinoe_1825"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku merasa terhormat."
      Speaker = "Melinoe"
      Event = "DoraAboutShades03"
    }
    {
      Id = "Melinoe_2034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora! {#Emph}Wah! {#Prev}Ada angin apa sampai kamu mau main ke sini? Kedai ini tempat terakhir di mana aku menyangka bakal melihatmu."
      Speaker = "Melinoe"
      Event = "DoraAboutShades04"
    }
    {
      Id = "Dora_0196_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Um{#Prev}, makasih lho, Mel, sukses bikin aku jadi luar biasa minder! Tapi, ya... aku cuma, cuma lagi berusaha sedikit lebih berbaur, kayaknya...!"
      Speaker = "Dora"
      Event = "DoraAboutShades04"
    }
    {
      Id = "Melinoe_2035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus kalau begitu. Walau begitu, aku tahu betapa sulitnya itu. Dulu aku sama sekali tidak bisa mendekati orang lain, tapi aku terus memaksakan diri, dan... sekarang rasanya lebih mudah."
      Speaker = "Melinoe"
      Event = "DoraAboutShades04"
    }
    {
      Id = "Dora_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih mudah, tapi... nggak pernah benar-benar {#Emph}gampang{#Prev}, kan? {#Emph}Hhh{#Prev}, ngapain juga aku repot-repot... sebagian besar Arwah ini membosankan banget."
      Speaker = "Dora"
      Event = "DoraAboutShades04"
    }
    {
      Id = "Melinoe_2036"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka saja yang belum mengenal {#Emph}dirimu{#Prev}!"
      Speaker = "Melinoe"
      Event = "DoraAboutShades04"
    }
    {
      Id = "Dora_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Um{#Prev}, makasih lho, Mel, sukses bikin aku jadi luar biasa minder! Tapi, ya... aku cuma, cuma lagi berusaha sedikit lebih berbaur, kayaknya...! Apalagi setelah kamu membebaniku dengan tugas besar nan penting itu."
      Speaker = "Dora"
      Event = "DoraAboutShades04_B"
    }
    {
      Id = "Melinoe_2032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihatmu belakangan ini agak lebih sering jalan-jalan di luar, tidak cuma mendekam di sini. Bagaimana keadaanmu?"
      Speaker = "Melinoe"
      Event = "DoraAboutOutside01"
    }
    {
      Id = "Dora_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Yah{#Prev}, aman terkendali. Arwah-arwah lain itu sama sekali nggak tahu seluk-beluk bergentayangan, dan ternyata mereka punya rahasia memalukan tentang {#Emph}semua orang {#Prev}di sini... termasuk {#Emph}kamu."
      Speaker = "Dora"
      Event = "DoraAboutOutside01"
    }
    {
      Id = "Melinoe_2033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cukup menenangkan tahu bahwa tulang punggung perlawanan kita begitu menikmati acara gosip ria."
      Speaker = "Melinoe"
      Event = "DoraAboutOutside01"
    }
    {
      Id = "Dora_0175"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oh jelas {#Prev}dong."
      Speaker = "Dora"
      Event = "DoraAboutOutside01"
    }
    {
      Id = "Melinoe_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu pasti masih ingat sesuatu tentang kehidupan di permukaan, kan, Dora? Apa pun itu? Aku penasaran rasanya seperti apa."
      Speaker = "Melinoe"
      Event = "DoraAboutSurface01"
    }
    {
      Id = "Dora_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}nggak {#Prev}ingat, dan aku juga {#Emph}nggak {#Prev}penasaran! Siapa peduli? Di {#Emph}sinilah {#Prev}tempat paling asyik."
      Speaker = "Dora"
      Event = "DoraAboutSurface01"
    }
    {
      Id = "Dora_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, tadi kamu sempat ngigau sedikit pas tidur. Bukannya aku merhatiin banget, sih, tapi... sebenarnya kamu ke mana semalam? Kelihatan agak linglung."
      Speaker = "Dora"
      Event = "DoraAboutSurface02"
    }
    {
      Id = "Melinoe_3724"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, cuma... aku ke sana, ke permukaan. Aku tidak pernah mengira akan melihatnya sendiri, dan sekarang aku berada di sana malam demi malam. Dingin, lembap... dibanjiri oleh orang-orang mati."
      Speaker = "Melinoe"
      Event = "DoraAboutSurface02"
    }
    {
      Id = "Dora_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Deskripsimu sukses bikin tempat itu kedengaran luar biasa suram. Kalau seburuk itu, kenapa kamu masih terus ke sana? Kalau aku jadi kamu... atau tetap jadi aku, mending diam di sini saja."
      Speaker = "Dora"
      Event = "DoraAboutSurface02"
    }
    {
      Id = "Melinoe_3725"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu tidak paham. Aku harus pergi ke sana. Itu bagian dari tugasku. Yah, tidak secara resmi, tapi... sudahlah, aku tidak akan membuatmu bosan dengan rinciannya. Aku harus pergi."
      Speaker = "Melinoe"
      Event = "DoraAboutSurface02"
    }
    {
      Id = "Dora_0344"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat menikmati kedinginan dan kelembapanmu itu."
      Speaker = "Dora"
      Event = "DoraAboutSurface02"
    }
    {
      Id = "Dora_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, sudah bangun. Lama juga kamu perginya. Lihat sesuatu yang seru di bawah sana kali ini?"
      Speaker = "Dora"
      Event = "DoraAboutOceanus01"
    }
    {
      Id = "Melinoe_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil menembus Erebus, turun sampai ke Oceanus. Rasanya aneh sekali, berada di bawah laut. Apa kamu ingat tentang laut, Dora?"
      Speaker = "Melinoe"
      Event = "DoraAboutOceanus01"
    }
    {
      Id = "Dora_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Laut... laut, laut, laut, {#Emph}itu {#Prev}yang isinya penuh {#Emph}air{#Prev}, {#Emph}kan? {#Prev}Katanya {#Emph}kadang-kadang {#Prev}bagus! Tapi juga {#Emph}membunuh {#Prev}banyak orang karena tenggelam, jadi — kayaknya ulasannya agak campur aduk, deh."
      Speaker = "Dora"
      Event = "DoraAboutOceanus01"
    }
    {
      Id = "Melinoe_0438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tempat itu luas sekali..."
      Speaker = "Melinoe"
      Event = "DoraAboutOceanus01"
    }
    {
      Id = "Dora_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, tampangmu kucel amat, jujur saja nih, Mel. Mau curhat, atau setidaknya kasih tahu bagian gosip serunya karena aku lagi bosan?"
      Speaker = "Dora"
      Event = "DoraAboutFields01"
    }
    {
      Id = "Melinoe_3380"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semalam aku mengunjungi Mourning Fields, dan... dikelilingi keputusasaan sebanyak itu... kurasa ada sebagian darinya yang terbawa pulang."
      Speaker = "Melinoe"
      Event = "DoraAboutFields01"
    }
    {
      Id = "Dora_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, gimana kalau aku {#Emph}kejutkan saja biar kabur rasa sedihmu itu, dasar cacing hina?!"
      Speaker = "Dora"
      Event = "DoraAboutFields01"
    }
    {
      Id = "Melinoe_3381"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, berhasil!"
      Speaker = "Melinoe"
      Event = "DoraAboutFields01"
    }
    {
      Id = "Dora_0297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuh kan, apa kubilang?"
      Speaker = "Dora"
      Event = "DoraAboutFields01"
    }
    {
      Id = "Dora_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, dari mana saja kau? Kau {#Emph}berbau! {#Prev}Bukan bau tak sedap sih, dan aku tak tahu bagaimana aku {#Emph}bisa {#Prev}mencium bau, atau mengingat bau apa pun, jadi... itu agak aneh."
      Speaker = "Dora"
      Event = "DoraAboutThessaly01"
    }
    {
      Id = "Melinoe_3382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru dari permukaan. Pasti karena hawa laut dan garamnya, berbeda dengan Oceanus di bawah sini. Aku berlayar melintasi perairan, menuju Olympus, di atas kapal!"
      Speaker = "Melinoe"
      Event = "DoraAboutThessaly01"
    }
    {
      Id = "Dora_0299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seru sekali! Sedangkan aku cuma di sini sepanjang waktu."
      Speaker = "Dora"
      Event = "DoraAboutThessaly01"
    }
    {
      Id = "Dora_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mencoba {#Emph}tidak {#Prev}mendengarkan ocehan para Arwah di luar sana, tapi dari omongan mereka sepertinya akhir-akhir ini kau melewati hal-hal yang cukup gila?"
      Speaker = "Dora"
      Event = "DoraAboutOlympus01"
    }
    {
      Id = "Melinoe_3703"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sulit untuk tahu persis apa yang mereka maksud, tapi... salah satunya, aku berhasil mencapai Gunung Olympus. Tak pernah kusangka aku bakal melihatnya. Pertempuran di sana sangat sengit..."
      Speaker = "Melinoe"
      Event = "DoraAboutOlympus01"
    }
    {
      Id = "Dora_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Olympus... {#Prev}tempat anggota keluargamu yang lain berkumpul itu, kan! Sekarang mereka meributkan apa lagi?"
      Speaker = "Dora"
      Event = "DoraAboutOlympus01"
    }
    {
      Id = "Melinoe_3704"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuasaan mereka atas langit dan Bumi, serta kelangsungan tempat tinggal mereka."
      Speaker = "Melinoe"
      Event = "DoraAboutOlympus01"
    }
    {
      Id = "Dora_0319"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh! Kalau itu sih bukan hal baru."
      Speaker = "Dora"
      Event = "DoraAboutOlympus01"
    }
    {
      Id = "Dora_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, bagaimana perkembangan di Olympus akhir-akhir ini? Atau di mana pun kau berada tadi malam. Melihat sesuatu yang menarik di atas sana selain salju? Heran kenapa aku bisa tahu soal salju..."
      Speaker = "Dora"
      Event = "DoraAboutTyphon01"
    }
    {
      Id = "Melinoe_4419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil sampai ke puncaknya, tempat aku berhadapan langsung dengan monster kuno bernama {#Emph}Typhon. {#Prev}Konon semua monster lain berakar darinya... tapi, dia jauh lebih besar dan lebih mengerikan dari apa pun yang pernah kulihat."
      Speaker = "Melinoe"
      Event = "DoraAboutTyphon01"
    }
    {
      Id = "Dora_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mel, {#Emph}akulah {#Prev}yang seharusnya menakut-nakuti {#Emph}dirimu{#Prev}, bukan sebaliknya. Jadi, kau berhasil mengalahkan makhluk ini, atau bagaimana?"
      Speaker = "Dora"
      Event = "DoraAboutTyphon01"
    }
    {
      Id = "Melinoe_4421"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Erm... {#Prev}belum sepenuhnya. Tapi aku bertekad melakukannya."
      Speaker = "Melinoe"
      Event = "DoraAboutTyphon01"
    }
    {
      Id = "Dora_0499"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beri tahu aku kalau butuh bantuan, ya!"
      Speaker = "Dora"
      Event = "DoraAboutTyphon01"
    }
    {
      Id = "Melinoe_4420"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenyataannya, aku berhasil!"
      Speaker = "Melinoe"
      Event = "DoraAboutTyphon01_B"
    }
    {
      Id = "Dora_0498"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, kalau begitu dia tak seseram itu, kan."
      Speaker = "Dora"
      Event = "DoraAboutTyphon01_B"
    }
    {
      Id = "Dora_0782"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, tampangmu kelihatan sangat... entahlah. Dan seperti sedang buru-buru, tapi aku ingin tahu apa yang terjadi kalau kau tak keberatan cerita sebentar. Meski aku tetap berhak untuk tak peduli, ya."
      Speaker = "Dora"
      Event = "DoraAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_5886"
      InheritFrom = "BaseNarrative"
      DisplayName = "Monster Typhon... tadi malam aku memusnahkannya. Benar-benar tak ada yang tersisa darinya. Kita masih harus menghadapi Chronos, tapi... Olympus tak lagi dalam bahaya besar. Dan kita memegang kendali."
      Speaker = "Melinoe"
      Event = "DoraAboutTyphonDeath01"
    }
    {
      Id = "Dora_0783"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh! Wah, itu {#Emph}hebat{#Prev}, kan? Kedengarannya tugas penting dan besarmu hampir beres! Bebanmu bakal jauh berkurang, kan?"
      Speaker = "Dora"
      Event = "DoraAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_5887"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita lihat saja nanti... Aku harus pergi."
      Speaker = "Melinoe"
      Event = "DoraAboutTyphonDeath01"
    }
    {
      Id = "Dora_0784"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga beruntung, Mel."
      Speaker = "Dora"
      Event = "DoraAboutTyphonDeath01"
    }
    {
      Id = "Dora_0816"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, ada sesuatu yang terjadi? Pasti ada apa-apa. Kau tak {#Emph}harus {#Prev}memberitahuku, sih... maksudku, kau {#Emph}boleh {#Prev}saja cerita kalau mau."
      Speaker = "Dora"
      Event = "DoraAboutHecateKidnapped01"
    }
    {
      Id = "Melinoe_5890"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa membaca pikiranku dengan mudah, ya...? Seseorang yang kupedulikan sedang dalam bahaya. Aku harus menolongnya."
      Speaker = "Melinoe"
      Event = "DoraAboutHecateKidnapped01"
    }
    {
      Id = "Dora_0817"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu jangan sampai {#Emph}aku {#Prev}menghambatmu, cepat sana pergi."
      Speaker = "Dora"
      Event = "DoraAboutHecateKidnapped01"
    }
    {
      Id = "Dora_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Gah! Terkutuklah garis keturunanmu karena memanggilku kembali, penyihir! {#Prev}Hei, {#Emph}um, {#Prev}semuanya baik-baik saja di sana, Mel?"
      Speaker = "Dora"
      Event = "DoraRunProgress01"
    }
    {
      Id = "Melinoe_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, iya Dora, hanya saja... seharusnya aku bisa melangkah lebih jauh tadi. Nanti aku beri masukan lebih lanjut soal caramu menakut-nakuti, ya?"
      Speaker = "Melinoe"
      Event = "DoraRunProgress01"
    }
    {
      Id = "Dora_0036"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh. Tentu saja..."
      Speaker = "Dora"
      Event = "DoraRunProgress01"
    }
    {
      Id = "Melinoe_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, apa kau sama sekali tak memerhatikan apa yang terjadi di luar sana? Bangkitnya sang Titan Waktu? Pengepungan Olympus?"
      Speaker = "Melinoe"
      Event = "DoraAboutChronos01"
    }
    {
      Id = "Dora_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak tuh. Tak ada satu pun yang kukenali. Olympus, itu tempat tinggal anggota keluarga yang {#Emph}tidak {#Prev}kaukukai itu, kan? Dan sang Titan Waktu, aku {#Emph}paham {#Prev}dia orang jahat, tapi dia tak pernah berbuat jahat kepadaku secara pribadi, setahuku, jadi..."
      Speaker = "Dora"
      Event = "DoraAboutChronos01"
    }
    {
      Id = "Melinoe_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seluruh perkemahan ini ada demi menentang upayanya menggulingkan para dewa dan menguasai dunia, tahu?"
      Speaker = "Melinoe"
      Event = "DoraAboutChronos01"
    }
    {
      Id = "Dora_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah kalau begitu! Mungkin aku harus berterima kasih padanya, soalnya kebetulan aku suka perkemahan ini."
      Speaker = "Dora"
      Event = "DoraAboutChronos01"
    }
    {
      Id = "Melinoe_0418"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hush, diamlah!"
      Speaker = "Melinoe"
      Event = "DoraAboutChronos01"
    }
    {
      Id = "Dora_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah{#Prev}, tunggu dulu, ada apa denganmu? Seumur hidupku belum pernah melihatmu sebersemangat ini. Seumur matiku, deh. Terserah. Apa kau baru saja menemukan spesies umbi baru atau semacamnya?"
      Speaker = "Dora"
      Event = "DoraAboutChronosBossW01"
    }
    {
      Id = "Melinoe_3378"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, aku menemukannya... Chronos... dan aku {#Emph}mengalahkannya! {#Prev}Aku menahan setiap trik miliknya, sampai dia menyerah dan binasa."
      Speaker = "Melinoe"
      Event = "DoraAboutChronosBossW01"
    }
    {
      Id = "Dora_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}mantap! {#Prev}Jadi semuanya sudah {#Emph}selesai{#Prev}, kan? Atau bagaimana...?"
      Speaker = "Dora"
      Event = "DoraAboutChronosBossW01"
    }
    {
      Id = "Melinoe_3379"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, tidak, dia belum {#Emph}mati... {#Prev}Maksudku, dia belum benar-benar {#Emph}lenyap{#Prev}. Belum saatnya. Aku harus pergi... ya?"
      Speaker = "Melinoe"
      Event = "DoraAboutChronosBossW01"
    }
    {
      Id = "Dora_0294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya. Aman terkendali."
      Speaker = "Dora"
      Event = "DoraAboutChronosBossW01"
    }
    {
      Id = "Dora_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kau pikir kau telah meraih kemenangan, wahai penyihir? Kau hanya menunda ajalmu belaka. Sebab sang Titan yang kau kalahkan itu cuma memiliki secuil dari kekuatanku!{#Prev}"
      Speaker = "Dora"
      Event = "DoraAboutChronosBossW02"
    }
    {
      Id = "Melinoe_3722"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau sudah dengar! Aku terkejut sekaligus tersanjung karena kau sudi memedulikan pencapaian kecilku, wahai Roh. Bagaimana kau bisa tahu?"
      Speaker = "Melinoe"
      Event = "DoraAboutChronosBossW02"
    }
    {
      Id = "Dora_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aku ini serbatahu! {#Prev}Lagipula para Arwah di luar sana lagi heboh membicarakannya. Beberapa dari mereka ada di depan tenda, sudah kubilang tak boleh masuk, tapi kurasa mereka masih nangkring di luar..."
      Speaker = "Dora"
      Event = "DoraAboutChronosBossW02"
    }
    {
      Id = "Melinoe_3723"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih sudah menahan mereka di luar."
      Speaker = "Melinoe"
      Event = "DoraAboutChronosBossW02"
    }
    {
      Id = "Dora_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu sebentar, bagaimana ceritanya kau memburu sang Titan Waktu jauh di bawah sana, tapi dia juga menyerang Olympus jauh di atas sana? Apa dia ada dua orang yang berbeda atau cuma satu?"
      Speaker = "Dora"
      Event = "DoraAboutPrometheus01"
    }
    {
      Id = "Melinoe_3705"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos tidak menyerang Olympus secara langsung, Dora. Dia hanya mengirim pasukannya ke sana. Dia punya panglima berbahaya yang memimpin penyerbuan... sesama Titan bernama Prometheus."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus01"
    }
    {
      Id = "Dora_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan lain bernama... Prometheus...? {#Emph}Prometheus... {#Prev}hmm..."
      Speaker = "Dora"
      Event = "DoraAboutPrometheus01"
    }
    {
      Id = "Melinoe_3706"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, sang Titan Pandangan Masa Depan. Kau pun mungkin tahu kisah tentang hukumannya karena mencuri dari para dewa."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus01"
    }
    {
      Id = "Dora_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, itu... kurasa... {#Emph}ah{#Prev}, lupakan saja. Sampai jumpa nanti, Mel!"
      Speaker = "Dora"
      Event = "DoraAboutPrometheus01"
    }
    {
      Id = "Melinoe_3707"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau yakin...?"
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus01"
    }
    {
      Id = "Dora_0323"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Prometheus... hrm...{#Prev}"
      Speaker = "Dora"
      Event = "DoraAboutPrometheus01"
    }
    {
      Id = "Melinoe_5192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, sebenarnya bukan dia lagi yang kuburu sekarang. Namun bagaimanapun juga, Chronos menunjuk orang lain untuk memimpin penyerbuan ke Olympus... Titan lain bernama Prometheus."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus01_B"
    }
    {
      Id = "Dora_0324"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Prometheus... Titan... Pandangan Masa Depan...? {#Emph}Cih... ya...{#Prev}"
      Speaker = "Dora"
      Event = "OnQueuedFunctionArgs.VoiceLines"
    }
    {
      Id = "Melinoe_3708"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kau baik-baik saja, Dora? Aku tidak bermaksud membuatmu risau dengan obrolan tentang Titan terakhir kali kita bicara."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus02"
    }
    {
      Id = "Dora_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh, {#Prev}aku tidak apa-apa, Mel. Aku sudah jarang marah-marah sungguhan sekarang, dan jarang merasa aneh juga, cuma... ada sesuatu tentang nama {#Emph}Prometheus{#Prev}? Rasanya... seperti pernah berarti sesuatu bagiku...?"
      Speaker = "Dora"
      Event = "DoraAboutPrometheus02"
    }
    {
      Id = "Melinoe_3709"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun, Prometheus sudah dipenjara selama ribuan tahun sebelum saat ini. Jika kau mengingatnya... itu pasti dari masa lalu yang teramat jauh."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus02"
    }
    {
      Id = "Dora_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berarti aku setua sejarah kuno! Tapi, mengingat kejadian kemarin saja aku susah, tidak tahu kenapa aku bisa mengingat sesuatu dari zaman sedalam itu. Bukannya aku beneran {#Emph}ingat {#Prev}sesuatu dari masa itu, sih... kecuali..."
      Speaker = "Dora"
      Event = "DoraAboutPrometheus02"
    }
    {
      Id = "Melinoe_3710"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kecuali apa?"
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus02"
    }
    {
      Id = "Dora_0327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, cuma firasat... tapi, rasanya tidak enak."
      Speaker = "Dora"
      Event = "DoraAboutPrometheus02"
    }
    {
      Id = "Melinoe_3711"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, kuharap kau tak keberatan, tapi aku sempat bertanya langsung pada Prometheus tentang hubungan masa lalu yang kau rasakan ini. Ucapannya berbelit-belit, tapi tampaknya dia juga mengingatmu."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus03"
    }
    {
      Id = "Dora_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Agak aneh sih kau menanyakan itu, apalagi dia lagi berusaha membantai keluargamu di atas sana, tapi terima kasih ya! Apa katanya?"
      Speaker = "Dora"
      Event = "DoraAboutPrometheus03"
    }
    {
      Id = "Melinoe_3712"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, dia bilang... dia bukan penyebab segala kemalangan kaum fana dan semacamnya, dan... kau pun bukan. Dia memintaku menyampaikan hal itu padamu. Sebelum akhirnya menyerangku seperti biasa, tentu saja."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus03"
    }
    {
      Id = "Dora_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fyuuh, syukurlah kalau begitu! {#Prev}Selama ini, kupikir kalau ada dua makhluk yang bertanggung jawab atas segala penderitaan bangsa fana, mereka adalah {#Emph}Prometheus dan aku! {#Prev}Mulai dari sakit perut, patah hati, penarikan pajak, kebohongan, perselingkuhan... sebut saja semuanya."
      Speaker = "Dora"
      Event = "DoraAboutPrometheus03"
    }
    {
      Id = "Melinoe_3713"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu sungguh tidak masuk akal, tapi... apa kau tahu apa maksud ucapannya tadi?"
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus03"
    }
    {
      Id = "Dora_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Enggak tahu! Tapi karena kau yang sering berurusan dengannya, mungkin kau bisa tanyakan lagi. Sekarang kita berdua kan jadi penasaran."
      Speaker = "Dora"
      Event = "DoraAboutPrometheus03"
    }
    {
      Id = "Melinoe_3714"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kita akan cari tahu bersama."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus03"
    }
    {
      Id = "Melinoe_3715"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prometheus menolak menjelaskan masa lalumu bersamanya, Dora. Tapi dia yakin tak lama lagi kau akan mengingatnya sendiri. Yang kukhawatirkan adalah... kau mungkin lebih baik tidak tahu."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus04"
    }
    {
      Id = "Dora_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan, kenapa kau bisa bilang begitu? Selain bagian di mana aku sudah bilang kalau firasatku rasanya tak enak tiap kali mendengar namanya? {#Emph}Prometheus... iuh{#Prev}, ya ampun! Tuh, kerasa lagi!"
      Speaker = "Dora"
      Event = "DoraAboutPrometheus04"
    }
    {
      Id = "Melinoe_3716"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia memberi kesan seolah kau melupakannya, dan banyak hal lainnya, atas kehendakmu sendiri. Jika itu benar, mungkin memang begitulah yang terbaik. Demi dirimu di masa lalu."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus04"
    }
    {
      Id = "Dora_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lupakan diriku di {#Emph}masa lalu{#Prev}, Mel, diriku yang {#Emph}sekarang {#Prev}sudah terlanjur penasaran setengah mati untuk mengusut ini sampai tuntas! Tak adakah semacam {#Emph}mantra sihir {#Prev}yang bisa kau rapalkan untuk memulihkan ingatanku, atau semacamnya?"
      Speaker = "Dora"
      Event = "DoraAboutPrometheus04"
    }
    {
      Id = "Melinoe_3717"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... berhubung sekarang aku tahu keterikatan khusus yang kau rasakan ini, ada petunjuk yang bisa kugunakan. Tapi, apa kau benar-benar yakin ini yang kau inginkan?"
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus04"
    }
    {
      Id = "Dora_0333"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, tentu saja! Pasti sesuatu yang {#Emph}hebat...{#Prev}"
      Speaker = "Dora"
      Event = "DoraAboutPrometheus04"
    }
    {
      Id = "Melinoe_2093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupepercayakan ucapanmu itu..."
      Speaker = "Melinoe"
      Event = "DoraAboutPrometheus04"
    }
    {
      Id = "Dora_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada kabar baik soal sihir pemulih ingatan itu, atau belum ada? Santai saja, aku bisa menunggu kok, tapi... cuma mau nanya!"
      Speaker = "Dora"
      Event = "DoraAboutMemorySpell01"
    }
    {
      Id = "Melinoe_3718"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mantra yang melibatkan ingatan dan masa lalu butuh kehati-hatian tingkat tinggi, jadi kita tidak boleh terburu-buru. Dan kalau kau berubah pikiran, langsung beri tahu aku ya."
      Speaker = "Melinoe"
      Event = "DoraAboutMemorySpell01"
    }
    {
      Id = "Dora_0335"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan terlalu khawatir, Mel!"
      Speaker = "Dora"
      Event = "DoraAboutMemorySpell01"
    }
    {
      Id = "Melinoe_4830"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dora..."
      Speaker = "Melinoe"
      Event = "OnQueuedFunctionArgs.VoiceLines"
    }
    {
      Id = "Dora_0577"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku ingat semuanya... alasan kenapa aku {#Emph}melupakan {#Prev}semuanya... {#Emph}Aku {#Prev}pernah berbuat hal yang buruk banget, Mel."
      Speaker = "Dora"
      Event = "DoraAboutMemories01"
    }
    {
      Id = "Melinoe_4654"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun itu, kau tidak wajib menceritakannya padaku. Kecuali, tentu saja, kalau kau memang mau... jika begitu, aku siap mendengarkan."
      Speaker = "Melinoe"
      Event = "DoraAboutMemories01"
    }
    {
      Id = "Dora_0578"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ya, intinya aku kayak menghancurkan segalanya, untuk semua orang. Setidaknya bagi seluruh bangsa fana."
      Speaker = "Dora"
      Event = "DoraAboutMemories01"
    }
    {
      Id = "Melinoe_4655"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maksudmu? Itu rasanya tidak mungkin!"
      Speaker = "Melinoe"
      Event = "DoraAboutMemories01"
    }
    {
      Id = "Dora_0579"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, bayangkan dulu ada sebuah guci penyimpanan yang besar, ya? Mirip tempat buat nyimpan acar, cuma saja para dewa mengisinya penuh dengan segala hal terburuk yang bisa terjadi. Kebencian, patah hati, rambut rontok, bau mulut... sebut saja apa pun."
      Speaker = "Dora"
      Event = "DoraAboutMemories01"
    }
    {
      Id = "Melinoe_4656"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak paham. Mengapa segala keburukan dan kelemahan bangsa fana ditempatkan di guci itu? Kedengarannya seperti kau sedang memikirkan semacam kiasan kiasan belaka."
      Speaker = "Melinoe"
      Event = "DoraAboutMemories01"
    }
    {
      Id = "Dora_0580"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, itu guci beneran yang isinya semua hal itu, dan aku... yah, detailnya masih agak buram. Kita bicarakan lagi lain kali ya, aku capek banget."
      Speaker = "Dora"
      Event = "DoraAboutMemories01"
    }
    {
      Id = "Melinoe_4657"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah maumu..."
      Speaker = "Melinoe"
      Event = "DoraAboutMemories01"
    }
    {
      Id = "Dora_0581"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Guci yang kuceritakan tadi, yang penuh dengan segala hal {#Emph}buruk{#Prev}? {#Emph}Aku {#Prev}yang membukanya. Penasaran isinya apa! Terus bunyinya {#Emph}wuuush... {#Prev}Aku melepaskan {#Emph}hampir {#Prev}semuanya keluar, ke dunia. Ke dalam hidup kita."
      Speaker = "Dora"
      Event = "DoraAboutMemories02"
    }
    {
      Id = "Melinoe_4658"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Kenapa kau sampai melakukan hal seperti itu? Bagaimana bisa kau bahkan menemukan guci itu?"
      Speaker = "Melinoe"
      Event = "DoraAboutMemories02"
    }
    {
      Id = "Dora_0582"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu hadiah pernikahan, dari para Olimpus. Prometheus, yang sekarang kuingat, orangnya {#Emph}menarik{#Prev}, dia punya saudara yang tampan dan kami lumayan cocok..."
      Speaker = "Dora"
      Event = "DoraAboutMemories02"
    }
    {
      Id = "Melinoe_4659"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi para dewa ingin kau memiliki guci penuh hal-hal mengerikan. Tampaknya aneh memberi hadiah semacam itu kepada... siapa sebenarnya {#Emph}dirimu {#Prev}dulu?"
      Speaker = "Melinoe"
      Event = "DoraAboutMemories02"
    }
    {
      Id = "Dora_0583"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Halah{#Prev}, cuma wanita biasa! Tapi populasi kami belum banyak waktu itu, dan kurasa para dewa tidak terlalu {#Emph}suka {#Prev}Prometheus? Jadi pokoknya, lain kali ada orang fana yang tersandung jempol kakinya, bayar pajak, keringat dingin, hal-hal semacam itu... itu salahku."
      Speaker = "Dora"
      Event = "DoraAboutMemories02"
    }
    {
      Id = "Melinoe_4660"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan jika ucapanmu benar, terdengar seolah kau tidak berniat melakukannya. Jadi itu bukan salahmu."
      Speaker = "Melinoe"
      Event = "DoraAboutMemories02"
    }
    {
      Id = "Dora_0584"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masalahnya aku {#Emph}memang {#Prev}melakukannya, jadi itu {#Emph}tetap {#Prev}salahku... Aku pergi dulu ya."
      Speaker = "Dora"
      Event = "DoraAboutMemories02"
    }
    {
      Id = "Melinoe_4661_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dora...!"
      Speaker = "Melinoe"
      Event = "DoraAboutMemories02"
    }
    {
      Id = "Dora_0585"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jadi, ya, kurasa aku pernah mengutuk seluruh bangsa fana dulu sekali. Memangnya kenapa kalau aku {#Emph}tidak sengaja? {#Prev}Niat itu tidak penting."
      Speaker = "Dora"
      Event = "DoraAboutMemories03"
    }
    {
      Id = "Melinoe_4662"
      InheritFrom = "BaseNarrative"
      DisplayName = "Niat itu mutlak penting. Jadi karena itulah kau meminum air Sungai Lethe demi menghapus ingatan tentang kejadian itu, untuk melenyapkan rasa bersalahmu?"
      Speaker = "Melinoe"
      Event = "DoraAboutMemories03"
    }
    {
      Id = "Dora_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kurang lebih begitu. Tapi kau mau tahu satu hal yang tidak sempat kubiarkan keluar dari guci itu? Harapan. Aku keburu panik, lalu menguncinya di dalam. Satu-satunya hal yang {#Emph}seharusnya {#Prev}kubebaskan, malah tidak kubiarkan keluar."
      Speaker = "Dora"
      Event = "DoraAboutMemories03"
    }
    {
      Id = "Melinoe_4663"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak begitu yakin. Kita merasakan Harapan sepanjang waktu, baik dewa maupun kaum fana. Kalau saja kau melepaskannya... mungkin Harapan itu akan tercekik oleh kekuatan-kekuatan lain, lalu bagaimana jadinya?"
      Speaker = "Melinoe"
      Event = "DoraAboutMemories03"
    }
    {
      Id = "Dora_0587"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu mungkin bangsa fana tidak akan terlalu banyak berhalusinasi? Sudahlah... kurasa aku mau sendirian dulu sebentar. Makasih sudah mau membicarakan ini denganku, Mel. Dan sudah membuatku ingat kembali."
      Speaker = "Dora"
      Event = "DoraAboutMemories03"
    }
    {
      Id = "Melinoe_4664"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan baik-baik saja?"
      Speaker = "Melinoe"
      Event = "DoraAboutMemories03"
    }
    {
      Id = "Dora_0588"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya... mungkin."
      Speaker = "Dora"
      Event = "DoraAboutMemories03"
    }
    {
      Id = "Melinoe_4665"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, aku masih tidak percaya para dewa menjebakmu untuk mengutuk seluruh bangsa fana... mungkinkah ingatanmu yang keliru?"
      Speaker = "Melinoe"
      Event = "DoraAboutMemories04"
    }
    {
      Id = "Dora_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Mungkin saja? Tapi aku mengingatnya cukup jelas sekarang, meski itu sudah lama sekali. Tapi hal lainnya, bukankah kalian para dewa juga mengalami sebagian besar hal-hal buruk itu sendiri? Maksudku, kalian memang tidak mati seperti bangsa fana, tapi... kalian tetap kena kesialan lainnya..."
      Speaker = "Dora"
      Event = "DoraAboutMemories04"
    }
    {
      Id = "Melinoe_4666"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, tentu saja tidak semuanya, tapi sebagian besar iya. Kalau begitu... mungkinkah guci ini hanyalah sarana untuk mendekatkan bangsa fana dan para dewa...? Menuju kenyataan, sebagaimana yang kita ketahui."
      Speaker = "Melinoe"
      Event = "DoraAboutMemories04"
    }
    {
      Id = "Dora_0590"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya kayak Harapan yang kutinggalkan di dalam guci itu yang sedang bicara, Mel. Kau tidak berpikir para dewa cuma... balas dendam pada Prometheus, saudaranya, dan istrinya yang cantik jelita?"
      Speaker = "Dora"
      Event = "DoraAboutMemories04"
    }
    {
      Id = "Melinoe_4667"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja, tapi... apa untungnya bagi mereka melakukan hal sekejam itu?"
      Speaker = "Melinoe"
      Event = "DoraAboutMemories04"
    }
    {
      Id = "Dora_0591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para dewa terkadang bisa menyebalkan. Mirip bangsa fana, cuma lebih kuat."
      Speaker = "Dora"
      Event = "DoraAboutMemories04"
    }
    {
      Id = "Dora_0592"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau belum menceritakan tentang aku dan {#Emph}guci {#Prev}itu ke siapa-siapa, kan? Aku lebih suka ini jadi rahasia kita berdua saja. Senang sih sekarang sudah ingat, tapi... aku tidak mau jadi pusat perhatian kalau detailnya sampai bocor..."
      Speaker = "Dora"
      Event = "DoraAboutMemories05"
    }
    {
      Id = "Melinoe_4668"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya membicarakannya dengan Prometheus, karena dia sudah tahu situasinya sejak dulu. Tapi aku tidak akan membocorkannya ke jiwa lain mana pun."
      Speaker = "Melinoe"
      Event = "DoraAboutMemories05"
    }
    {
      Id = "Dora_0593"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah. Mungkin suatu saat nanti, aku sendiri yang bakal cerita ke semua orang kalau lagi pengin usil? Dan biarpun tidak, ini {#Emph}sudah {#Prev}memberiku {#Emph}banyak {#Prev}materi baru buat menakut-nakuti orang! Bahan yang sangat menyeramkan."
      Speaker = "Dora"
      Event = "DoraAboutMemories05"
    }
    {
      Id = "Melinoe_4669"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong jangan anggap enteng, Dora. Tapi menghadapi masa lalumu lebih baik daripada menghapusnya, menurutku. Untuk hal itu, kau sangat berani."
      Speaker = "Melinoe"
      Event = "DoraAboutMemories05"
    }
    {
      Id = "Dora_0594"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dan kau sangat bodoh! Tinggalkan aku sendiri."
      Speaker = "Dora"
      Event = "DoraAboutMemories05"
    }
    {
      Id = "Dora_0620"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, cuma mau bilang, makasih ya sudah membangkitkan kembali semua kenangan masa lalu burukku yang berusaha mati-matian kuhapus... Aku serius! Aku lebih suka mengunyahnya daripada memuntahkannya begitu saja."
      Speaker = "Dora"
      Event = "DoraAboutMemoryQuest01"
    }
    {
      Id = "Melinoe_4687"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutku, itu lebih merupakan pilihanmu sendiri daripada pilihanku. Aku hanya ingin mendukungmu sebagai teman. Kita berdua tahu apa yang akan kau temukan berpotensi menyakitkan."
      Speaker = "Melinoe"
      Event = "DoraAboutMemoryQuest01"
    }
    {
      Id = "Dora_0621"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh{#Prev}, entahlah kalau soal {#Emph}menyakitkan. {#Prev}Itu salah satu enaknya jadi Arwah! Nggak ada lagi rasa sakit! Paling cuma pikiran buruk tentang bagaimana segalanya {#Emph}dulu{#Prev}, ya... mungkin beberapa di antaranya."
      Speaker = "Dora"
      Event = "DoraAboutMemoryQuest01"
    }
    {
      Id = "Melinoe_4688"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tetap menganggap itu sebagai rasa sakit. Memang tidak sama dengan dipukul sekuat tenaga oleh Nemesis, tapi rasanya bisa melukai lebih dalam, dan proses penyembuhannya bisa jauh lebih lama. Tapi, setidaknya kau ingat lebih dari sekadar kenangan buruk, kan?"
      Speaker = "Melinoe"
      Event = "DoraAboutMemoryQuest01"
    }
    {
      Id = "Dora_0622"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa begitu, tapi hal-hal lainnya nggak begitu menarik, tahu nggak? Lagipula itu semua cuma masa lalu. Inilah diriku yang sekarang."
      Speaker = "Dora"
      Event = "DoraAboutMemoryQuest01"
    }
    {
      Id = "Melinoe_4689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Syukurlah kalau begitu."
      Speaker = "Melinoe"
      Event = "DoraAboutMemoryQuest01"
    }
    {
      Id = "Dora_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, ada apa, tampangmu aneh banget atau gimana ya, entahlah. Nggak lama amat perginya. Habis bawa seseorang ke hutan, ya...?"
      Speaker = "Dora"
      Event = "DoraAboutPackagedBounties01"
    }
    {
      Id = "Melinoe_3373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, Dora, meski kurasa aku tak bisa menjelaskannya dengan cukup baik. Kau tahu Batu Hitam Pekat itu? Ternyata batu itu bisa... melakukan hal-hal tak biasa."
      Speaker = "Melinoe"
      Event = "DoraAboutPackagedBounties01"
    }
    {
      Id = "Dora_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Batu ungu itu bisa {#Emph}melakukan hal-hal tak biasa{#Prev}, katamu. Tahu nggak? Aku bahkan {#Emph}nggak mau {#Prev}tahu kelanjutannya, biar imajinasiku saja yang berliar-liar menggantikanmu, makasih."
      Speaker = "Dora"
      Event = "DoraAboutPackagedBounties01"
    }
    {
      Id = "Melinoe_3374"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama-sama?"
      Speaker = "Melinoe"
      Event = "DoraAboutPackagedBounties01"
    }
    {
      Id = "Dora_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau makin sering saja menatap lukisan itu. {#Emph}Keluarga bahagia! {#Prev}Yah, itu mulai menggangguku, karena kurasa itu mulai mempengaruhi {#Emph}dirimu. {#Prev}Jangan mulai melankolis di depanku, Mel."
      Speaker = "Dora"
      Event = "DoraAboutPainting01"
    }
    {
      Id = "Melinoe_3376"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Dora. Tapi kau tak perlu khawatir. Aku tak akan tersesat dalam kenangan karena memang tak banyak yang bisa kuingat. Aku hanya bertanya-tanya seperti apa rupa kakak dan orang tua kandungku."
      Speaker = "Melinoe"
      Event = "DoraAboutPainting01"
    }
    {
      Id = "Dora_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Uh-huh! {#Prev}Kedengarannya persis seperti orang yang meratapi masa lalu buatku. Nggak ada yang bisa kau perbuat juga! Hei... kau bisa saja nggak ngapa-ngapain sekarang {#Emph}juga."
      Speaker = "Dora"
      Event = "DoraAboutPainting01"
    }
    {
      Id = "Melinoe_3377"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kupikirkan nanti."
      Speaker = "Melinoe"
      Event = "DoraAboutPainting01"
    }
    {
      Id = "Dora_0291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atau nggak usah sekalian!"
      Speaker = "Dora"
      Event = "DoraAboutPainting01"
    }
    {
      Id = "Dora_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh {#Prev}hei Mel, aku cuma lagi... melayang! Melayang-layang saja, kurasa. Dan eksis! Akhir-akhir ini rasanya kebanyakan cuma sekadar eksis. Kau sendiri?"
      Speaker = "Dora"
      Event = "DoraAboutExisting01"
    }
    {
      Id = "Melinoe_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gagal. Mengalami kemajuan, entahlah. Ngomong-ngomong, bukankah kau seharusnya berlatih cara menghantui, Dora?"
      Speaker = "Melinoe"
      Event = "DoraAboutExisting01"
    }
    {
      Id = "Dora_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh! Ya, nggak juga sih, kupikir mungkin aku mau istirahat dulu dari latihan itu. Kenapa harus dikerjakan sekarang kalau bisa ditunda nanti, ya kan?"
      Speaker = "Dora"
      Event = "DoraAboutExisting01"
    }
    {
      Id = "Melinoe_0410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi rasa pencapaian?"
      Speaker = "Melinoe"
      Event = "DoraAboutExisting01"
    }
    {
      Id = "Dora_0041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pfft!"
      Speaker = "Dora"
      Event = "DoraAboutExisting01"
    }
    {
      Id = "Dora_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei..."
      Speaker = "Dora"
      Event = "OnQueuedFunctionArgs.VoiceLines"
    }
    {
      Id = "Dora_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak bohong ya, Mel, terkadang aku berharap {#Emph}aku {#Prev}punya tugas besar yang penting. Bukannya melayang-layang itu bukan tugas penting, sih."
      Speaker = "Dora"
      Event = "DoraListless01"
    }
    {
      Id = "Melinoe_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu bagaimana pandanganku soal ini, Dora. Kau harus keluar dari tenda ini. Kau sangat berbakat! Aku belum pernah bertemu Arwah yang bisa bicara sepertimu!"
      Speaker = "Melinoe"
      Event = "DoraListless01"
    }
    {
      Id = "Dora_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, aku bisa bicara, bikin aku jadi {#Emph}istimewa banget ya. Cih! {#Prev}Arwah rendahan mana pun pasti bisa melakukannya setelah terjebak di sini mendengarkan ocehan {#Emph}kalian {#Prev}cukup lama."
      Speaker = "Dora"
      Event = "DoraListless01"
    }
    {
      Id = "Melinoe_4272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atau kau bisa mengajari mereka?"
      Speaker = "Melinoe"
      Event = "DoraListless01"
    }
    {
      Id = "Dora_0495"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Ogah ah!"
      Speaker = "Dora"
      Event = "DoraListless01"
    }
    {
      Id = "Dora_0532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, Mel."
      Speaker = "Dora"
      Event = "OnQueuedFunctionArgs.VoiceLines"
    }
    {
      Id = "Melinoe_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya baik-baik saja, Dora? Ada teror hantu baru yang perlu dievaluasi atau semacamnya?"
      Speaker = "Melinoe"
      Event = "DoraListless02"
    }
    {
      Id = "Dora_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak! {#Prev}A — a-aku — aku baik-baik saja, cuma... kurasa aku lagi agak suntuk saja. {#Emph}Biasa lah{#Prev}, kan? Nanti juga baikan."
      Speaker = "Dora"
      Event = "DoraListless02"
    }
    {
      Id = "Melinoe_0415"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah."
      Speaker = "Melinoe"
      Event = "DoraListless02"
    }
    {
      Id = "Dora_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kalau aku jadi kau, aku bakal... yah, kalau dipikir-pikir, aku bakal... aku bakal melakukan banyak hal. Pergi lari pagi! Kayaknya asyik tuh. Punya kaki! Merasakan detak jantung yang terpacu, punya jantung kayaknya enak!"
      Speaker = "Dora"
      Event = "DoraListless03"
    }
    {
      Id = "Melinoe_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hentikan, Dora. Aku tidak suka saat kau mulai bersikap seperti ini."
      Speaker = "Melinoe"
      Event = "DoraListless03"
    }
    {
      Id = "Dora_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bikin sesuatu pakai tanganku! Entahlah, cangkir? Mangkuk. Aku bakal makan! Makan kayaknya {#Emph}enak banget. {#Prev}Atau setidaknya mengingat kembali seperti apa rasanya..."
      Speaker = "Dora"
      Event = "DoraListless03"
    }
    {
      Id = "Melinoe_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga dirimu, Dora..."
      Speaker = "Melinoe"
      Event = "DoraListless03"
    }
    {
      Id = "Dora_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernah kepikiran nggak kalau kita berdua ini mungkin nggak cocok buat urusan begini, Mel? Aku dengan urusan gentayangan, kau dengan urusan... apa sih yang lagi kau coba lakuin lagi?"
      Speaker = "Dora"
      Event = "DoraAboutTask01"
    }
    {
      Id = "Melinoe_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Menemukan Titan Waktu. Menghukumnya atas kejahatan terhadap keluargaku. Memulihkan penguasa Underworld yang sah.... {#Prev}Hei, kau cocok kok jadi hantu gentayangan, Dora!"
      Speaker = "Melinoe"
      Event = "DoraAboutTask01"
    }
    {
      Id = "Dora_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aww{#Prev}, makasih! Sama seperti aku yang yakin kau juga cocok buat semua urusan itu."
      Speaker = "Dora"
      Event = "DoraAboutTask01"
    }
    {
      Id = "Dora_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi apa sih yang kau lakuin waktu di luar, ngumpulin lebih banyak tanaman dan hal semacam itu? Dulu padahal kau diam di dalam terus."
      Speaker = "Dora"
      Event = "DoraAboutTask02"
    }
    {
      Id = "Melinoe_3699"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, selama ini aku berlatih diam-diam! Tiap malam saat keluar, sebagian besar waktuku kuhabiskan bertarung menuju Chronos... menerobos berbagai hal yang nggak suka melihat keberadaanku."
      Speaker = "Melinoe"
      Event = "DoraAboutTask02"
    }
    {
      Id = "Dora_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak habis pikir kenapa. Dan kau terus mencoba hal yang sama berulang kali, ya. Kalau aku sih sudah menyerah dari dulu! Kau mesti coba sesekali. Menyerah, maksudku."
      Speaker = "Dora"
      Event = "DoraAboutTask02"
    }
    {
      Id = "Melinoe_3700"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak, terima kasih."
      Speaker = "Melinoe"
      Event = "DoraAboutTask02"
    }
    {
      Id = "Melinoe_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi pula, apa yang bakal kau lakukan kalau punya kemah ini sepenuhnya untuk dirimu sendiri, Dora? Kau bisa mengundang semua Arwah lain dan benar-benar mengobrak-abrik tempat ini, kurasa..."
      Speaker = "Melinoe"
      Event = "DoraAboutHaunting01"
    }
    {
      Id = "Dora_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "A, apa, maksudmu {#Emph}berbagi {#Prev}kemah? Mel, {#Emph}nggak berbagi {#Prev}kemah itu justru intinya, gentayangan yang benar itu rasionya harus satu lawan satu antara yang di{#Emph}hantui {#Prev}dan si peng{#Emph}hantu{#Prev}. Bahkan {#Emph}aku {#Prev}pun belum lupa prinsip dasarnya."
      Speaker = "Dora"
      Event = "DoraAboutHaunting01"
    }
    {
      Id = "Melinoe_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku nggak bisa membayangkan kalau yang ingin kau lakukan hanyalah melayang-layang di sini, minus bagian saat kita mengobrol."
      Speaker = "Melinoe"
      Event = "DoraAboutHaunting01"
    }
    {
      Id = "Dora_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu imajinasimu kurang luas, kawan!"
      Speaker = "Dora"
      Event = "DoraAboutHaunting01"
    }
    {
      Id = "Melinoe_0413"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heh."
      Speaker = "Melinoe"
      Event = "DoraAboutHaunting01"
    }
    {
      Id = "Dora_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Rasa sakit dan penderitaan abadi atasmu, penyihir! Kau lancang menginjak tanah keramatku. Jeritan minta ampunmu akan tercekat di tenggorokanmu!"
      Speaker = "Dora"
      Event = "DoraAboutHaunting02"
    }
    {
      Id = "Melinoe_2019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong! Maafkan kelancanganku yang ceroboh ini, nyonya roh, kubohon padamu! Aku tak bermaksud menyinggung..."
      Speaker = "Melinoe"
      Event = "DoraAboutHaunting02"
    }
    {
      Id = "Dora_0188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ho-hoh, wow! {#Prev}Kau mendalami banget perannya, ya?"
      Speaker = "Dora"
      Event = "DoraAboutHaunting02"
    }
    {
      Id = "Melinoe_2020"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ah, yang benar saja!"
      Speaker = "Melinoe"
      Event = "DoraAboutHaunting02"
    }
    {
      Id = "Dora_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu apa hal paling menakutkan yang baru-baru ini kau temui di luar sana, Mel? Penting buat seseorang di posisiku untuk selalu tahu kabar terbaru soal ini."
      Speaker = "Dora"
      Event = "DoraAboutHaunting03"
    }
    {
      Id = "Melinoe_3701"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... kurasa monster neraka mengamuk yang menjaga satu-satunya jalan masuk menuju Tartarus. Sangat masif, taring tajam tak terhitung jumlahnya, tiga mulut yang menyemburkan api... walau dia juga anjing peliharaan keluargaku."
      Speaker = "Melinoe"
      Event = "DoraAboutHaunting03"
    }
    {
      Id = "Dora_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, kukira beneran! Yah kalau kau bilang nggak ada yang lebih seram di luar sana selain anjing peliharaan... berarti aku nggak punya saingan dong! Saatnya santai-santai lagi menikmati prestasiku."
      Speaker = "Dora"
      Event = "DoraAboutHaunting03"
    }
    {
      Id = "Melinoe_3702"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Silakan nikmati sesukamu."
      Speaker = "Melinoe"
      Event = "DoraAboutHaunting03"
    }
    {
      Id = "Dora_0316"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semua yang kau lihat ini adalah wilayah kekuasaanku."
      Speaker = "Dora"
      Event = "DoraAboutHaunting03"
    }
    {
      Id = "Dora_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kau, yang telah lancang melangkah ke kediamanku, akan menderita siksaan abadi atas perbuatanmu! Kecuali, tentu saja, jika kau bersedia mengabulkan permintaan terakhirku..."
      Speaker = "Dora"
      Event = "DoraAboutHaunting04"
    }
    {
      Id = "Melinoe_3719"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan kelancanganku, Roh, dan sebutkan permintaanmu! Aku siap menjalankan titahmu! Tentu yang masih masuk akal."
      Speaker = "Melinoe"
      Event = "DoraAboutHaunting04"
    }
    {
      Id = "Dora_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kalau begitu bersumpahlah kau akan menjalankan titahku, sekarang juga! Tepatnya sih... {#Prev}aku belum kepikiran soal bagian permintaan terakhirnya. Menyuruhmu mengambil tulang kekasihku, atau semacamnya?"
      Speaker = "Dora"
      Event = "DoraAboutHaunting04"
    }
    {
      Id = "Melinoe_3720"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kabari saja kalau sudah kepikiran."
      Speaker = "Melinoe"
      Event = "DoraAboutHaunting04"
    }
    {
      Id = "Dora_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Majulah ke depan, penyihir! Di balik tanah yang terkutuk tiga kali lipat ini, hanyalah maut yang menanti. Apakah kau siap mengorbankan darah hidupmu demi apa yang kaucari? Ataukah kau akan berbalik arah?"
      Speaker = "Dora"
      Event = "DoraAboutHaunting05"
    }
    {
      Id = "Melinoe_3721"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau aku berbalik arah, jatuhnya juga jalan buntu, Roh. Sepertinya mau ke mana pun aku tetap buntu! Aku harus mengecek urusan dengan yang lain dulu, jadi..."
      Speaker = "Melinoe"
      Event = "DoraAboutHaunting05"
    }
    {
      Id = "Dora_0339"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah! {#Prev}Gih sana, lanjutin."
      Speaker = "Dora"
      Event = "DoraAboutHaunting05"
    }
    {
      Id = "Dora_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Whoa, ada apa itu, Mel? K-kau kelihatan seperti habis melihat... {#Emph}ungh{#Prev}, entahlah, tapi... apa pun itu, kelihatannya itu benar-benar mengusikmu. {#Emph}<Tersentak> Oh! {#Prev}Punya kulit kayaknya enak juga!"
      Speaker = "Dora"
      Event = "DoraAboutNightmares01"
    }
    {
      Id = "Melinoe_2015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku nggak apa-apa, cuma agak terguncang. Mimpi buruk pertamaku sejak semua ini dimulai."
      Speaker = "Melinoe"
      Event = "DoraAboutNightmares01"
    }
    {
      Id = "Dora_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah saatnya, malah telat. Oh, seseram apa mimpinya kalau dibandingkan dengan, {#Emph}um, sosok mengerikan yang ada di hadapanmu sekarang ini?"
      Speaker = "Dora"
      Event = "DoraAboutNightmares01"
    }
    {
      Id = "Melinoe_2016"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan nggak ada apa-apanya."
      Speaker = "Melinoe"
      Event = "DoraAboutNightmares01"
    }
    {
      Id = "Dora_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira dulu aku pernah punya mimpi buruk nggak ya... ja, jadi kau bisa langsung... {#Emph}membayangkan {#Prev}dirimu berada dalam situasi mengerikan yang {#Emph}benar-benar {#Prev}berbeda {#Emph}begitu{#Prev}?"
      Speaker = "Dora"
      Event = "DoraAboutNightmares02"
    }
    {
      Id = "Melinoe_2017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Iya. Dan terkadang aku bahkan tidak ada di sana, yang justru membuatnya jauh lebih meresahkan. Walau mimpi-mimpi itu sekarang sudah tidak terlalu menggangguku..."
      Speaker = "Melinoe"
      Event = "DoraAboutNightmares02"
    }
    {
      Id = "Dora_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah... paling tidak kau masih punya {#Emph}aku."
      Speaker = "Dora"
      Event = "DoraAboutNightmares02"
    }
    {
      Id = "Dora_0647"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya tidurmu belakangan ini lebih nyenyak. Bukannya aku suka memelototimu pas kau lagi pingsan tidur, ya."
      Speaker = "Dora"
      Event = "DoraAboutNightmares03"
    }
    {
      Id = "Melinoe_5469"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah kenapa belakangan ini mimpi-mimpiku tidak begitu mengganggu. Mungkin karena itu. Kau... benar-benar memperhatikanku tidur?"
      Speaker = "Melinoe"
      Event = "DoraAboutNightmares03"
    }
    {
      Id = "Dora_0648"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak, kok. Cuma pas lagi bosan saja."
      Speaker = "Dora"
      Event = "DoraAboutNightmares03"
    }
    {
      Id = "Dora_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, andai kau datang sedikit lebih awal, kau pasti bisa dengar Nemesis ngomel-ngomel heboh lagi!"
      Speaker = "Dora"
      Event = "DoraAboutNemesis01"
    }
    {
      Id = "Melinoe_1602"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebaiknya jangan mengejek Sang Wujud Pembalasan jika kau masih sayang nyawamu. Dia dan Kepala Sekolah sedang bersitegang..."
      Speaker = "Melinoe"
      Event = "DoraAboutNemesis01"
    }
    {
      Id = "Dora_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kan aku bisa, semacam, {#Emph}merasukinya {#Prev}buat membantumu? Tinggal... wus meluncur ke sana, bikin ribut di kepalanya sebentar, bikin dia melakukan hal-hal {#Emph}buruk... {#Prev}{#Emph}<Gasp> {#Prev}hal-hal yang {#Emph}memalukan! {#Prev}Sebentar saja, maksudku. Kalau aku sampai ketahuan di dalam sana..."
      Speaker = "Dora"
      Event = "DoraAboutNemesis01"
    }
    {
      Id = "Melinoe_0069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dora, jangan..."
      Speaker = "Melinoe"
      Event = "DoraAboutNemesis01"
    }
    {
      Id = "Dora_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sempat tidur nyenyak nggak pas kau tepar di belakang sana? {#Emph}Hah{#Prev}, nggak habis pikir rasanya seperti apa bagi dirimu. Tidur? Kata... kata orang rasanya seperti mati, kan? Tapi aku sudah mati, dan aku selalu melek."
      Speaker = "Dora"
      Event = "DoraAboutHypnos01"
    }
    {
      Id = "Melinoe_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa satu-satunya yang tidurnya nyenyak belakangan ini hanyalah Hypnos sendiri. Masih belum bergerak sedikit pun, tak peduli apa pun yang sudah diusahakan Kepala Sekolah."
      Speaker = "Melinoe"
      Event = "DoraAboutHypnos01"
    }
    {
      Id = "Dora_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Enak betul jadi dia."
      Speaker = "Dora"
      Event = "DoraAboutHypnos01"
    }
    {
      Id = "Dora_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong-omong, ada masalah apa sih dengan pria bertanduk itu? Kulihat dia dan Nemesis mengobrol seperti orang pacaran, atau semacamnya. Aneh banget."
      Speaker = "Dora"
      Event = "DoraAboutMoros01"
    }
    {
      Id = "Melinoe_1826"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka bersaudara, Dora. Yang bertanduk itu adalah Tuan Moros, utusan Tiga Takdir. Tamu terhormat kita, dan sekutu yang berharga."
      Speaker = "Melinoe"
      Event = "DoraAboutMoros01"
    }
    {
      Id = "Dora_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Iya deh! Kelihatannya kita menyambut dia dengan gaya banget..."
      Speaker = "Dora"
      Event = "DoraAboutMoros01"
    }
    {
      Id = "Dora_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, jadi cowok bertanduk di sana itu... {#Emph}dia {#Prev}yang bakal muncul tiap kali ada manusia fana yang mau {#Emph}mati {#Prev}secara mengenaskan dan tak terduga?"
      Speaker = "Dora"
      Event = "DoraAboutMoros02"
    }
    {
      Id = "Melinoe_2029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, benar. Dia memastikan kehendak Tiga Takdir terlaksana. Tapi jangan salah menilainya karena hal itu, dan tak ada alasan untuk takut padanya juga."
      Speaker = "Melinoe"
      Event = "DoraAboutMoros02"
    }
    {
      Id = "Dora_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bercanda, ya? Menurutku itu keren banget, aku... aku penasaran apa dia melihat {#Emph}aku {#Prev}mati! Jangan-jangan aku tewas tertimpa batu besar! Tersambar petir! {#Emph}<Gasp> {#Prev}Dibunuh oleh kekasihku sendiri...! Bisa kenalkan kami nggak?"
      Speaker = "Dora"
      Event = "DoraAboutMoros02"
    }
    {
      Id = "Melinoe_2030"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Diajar... {#Emph}Emm... {#Prev}tentu?"
      Speaker = "Melinoe"
      Event = "DoraAboutMoros02"
    }
    {
      Id = "Dora_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat kau ngobrol lagi sama si Tanduk! Ya, dia memang agak kaku, tapi kurasa dia lumayan baik. Jangan-jangan aku pernah {#Emph}bertemu {#Prev}dengannya dulu, pas aku mati..."
      Speaker = "Dora"
      Event = "DoraAboutMoros03"
    }
    {
      Id = "Melinoe_2023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku ragu. Kau pasti ingat kalau pernah bertemu sosok seperti dia. Dan dia pun pasti akan mengingatmu! Meskipun, kau memang sudah lama mati..."
      Speaker = "Melinoe"
      Event = "DoraAboutMoros03"
    }
    {
      Id = "Dora_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya sih. Mungkin aku salah satu tugas pertamanya. Gadis muda tak berdosa, ditakdirkan menuju masa depan kejam dan tak terelakkan yang tak pantas diterimanya..."
      Speaker = "Dora"
      Event = "DoraAboutMoros03"
    }
    {
      Id = "Melinoe_2024"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Iya deh, Dora."
      Speaker = "Melinoe"
      Event = "DoraAboutMoros03"
    }
    {
      Id = "Dora_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei Mel! Bapak {#Emph}Komandan {#Prev}yang baik itu menawarkan untuk melatihku sebagai salah satu {#Emph}muridnya. {#Prev}Ini keputusan besar, jadi aku masih memikirkannya..."
      Speaker = "Dora"
      Event = "DoraAboutSkelly01"
    }
    {
      Id = "Melinoe_2025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku belajar banyak darinya, Dora. Kepala Sekolah mengajariku ilmu sihir. Tapi Komandan Schelemeus mengajariku... {#Emph}emm..."
      Speaker = "Melinoe"
      Event = "DoraAboutSkelly01"
    }
    {
      Id = "Dora_0199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cara menghajar kakek-kakek...?"
      Speaker = "Dora"
      Event = "DoraAboutSkelly01"
    }
    {
      Id = "Melinoe_2026"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan!"
      Speaker = "Melinoe"
      Event = "DoraAboutSkelly01"
    }
    {
      Id = "Melinoe_5893"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi bagaimana keputusanmu soal tawaran Komandan untuk melatihmu sebagai salah satu muridnya? Siapa tahu kau bisa jadi pejuang hebat."
      Speaker = "Melinoe"
      Event = "DoraAboutSkelly02"
    }
    {
      Id = "Dora_0813"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau benar, cuma urusanku lagi lumayan banyak sekarang? Salah satunya, aku harus selalu mengintilimu {#Emph}ke mana-mana. {#Prev}Aku nggak mau memikul beban yang melebihi kemampuanku."
      Speaker = "Dora"
      Event = "DoraAboutSkelly02"
    }
    {
      Id = "Melinoe_5894"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mampu menahan diri butuh kedisiplinan. Kau tahu, kau sudah berkembang jauh dibanding Dora yang lesu dulu. Bahkan tanpa latihan dari Komandan sekalipun."
      Speaker = "Melinoe"
      Event = "DoraAboutSkelly02"
    }
    {
      Id = "Dora_0814"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Penyihir bodoh! Jangan bicarakan hal ini lagi, atau kukutuk kau dan keturunanmu selama dua masa keabadian, bukan cuma satu!"
      Speaker = "Dora"
      Event = "DoraAboutSkelly02"
    }
    {
      Id = "Melinoe_5895"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku menyesali setiap kata-kataku, Arwah."
      Speaker = "Melinoe"
      Event = "DoraAboutSkelly02"
    }
    {
      Id = "Dora_0815"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah kalau sadar."
      Speaker = "Dora"
      Event = "DoraAboutSkelly02"
    }
    {
      Id = "Dora_0810"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu nggak, di luar sini lumayan asyik juga, mengingat kita lagi nggak di dalam tenda... lebih tenang daripada kedai, dan para Arwah murid Komandan itu sangat memujaku."
      Speaker = "Dora"
      Event = "DoraAboutTrainingGrounds01"
    }
    {
      Id = "Melinoe_5891"
      InheritFrom = "BaseNarrative"
      DisplayName = "Syukurlah kalau kau mulai merasa nyaman di tempat latihan ini. Tapi omong-omong soal murid-murid Komandan, kau tidak menakut-nakuti mereka, kan?"
      Speaker = "Melinoe"
      Event = "DoraAboutTrainingGrounds01"
    }
    {
      Id = "Dora_0811"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, anggap saja mereka tahu {#Emph}aku bisa mengubah mereka menjadi wujud penderitaan itu sendiri, kalau mereka sampai berani menantangku!"
      Speaker = "Dora"
      Event = "DoraAboutTrainingGrounds01"
    }
    {
      Id = "Melinoe_5892"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kumohon jangan bikin kesan buruk..."
      Speaker = "Melinoe"
      Event = "DoraAboutTrainingGrounds01"
    }
    {
      Id = "Dora_0812"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Siapa, aku?!"
      Speaker = "Dora"
      Event = "DoraAboutTrainingGrounds01"
    }
    {
      Id = "Dora_0618"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, tadinya mau nanya, {#Emph}kenapa {#Prev}sih sama patung-patung di area latihan itu? Itu patungmu, ya? {#Emph}Soalnya... {#Prev}yah... badannya jauh lebih {#Emph}gede {#Prev}daripada kamu..."
      Speaker = "Dora"
      Event = "DoraAboutStatues01"
    }
    {
      Id = "Melinoe_4685"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Patung terkadang menggambarkan sosoknya secara berlebihan atau dramatis! Tapi bagaimanapun juga, aku berhasil meraih gelar Jawara Malam, dan... itu hadiahku."
      Speaker = "Melinoe"
      Event = "DoraAboutStatues01"
    }
    {
      Id = "Dora_0619"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Caraku melihatmu nggak bakal sama lagi! Aku {#Emph}suka banget {#Prev}sama yang bawa kapak raksasa."
      Speaker = "Dora"
      Event = "DoraAboutStatues01"
    }
    {
      Id = "Melinoe_4686"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, {#Emph}begitu, {#Prev}ya?"
      Speaker = "Melinoe"
      Event = "DoraAboutStatues01"
    }
    {
      Id = "Dora_0780"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu nggak? Kalau kamu terus-terusan pingsan di benda yang mirip selimut hangat di sebelah sana itu, artinya tenda ini akhirnya jadi milikku sepenuhnya! Ide bagus, Mel."
      Speaker = "Dora"
      Event = "DoraAboutDreamRuns01"
    }
    {
      Id = "Melinoe_5884"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, aku bukan sekadar {#Emph}pingsan! {#Prev}Itu caraku menyelami alam bawah sadarku lewat mimpi! Dan aku berhak kembali ke tendaku kapan pun aku mau."
      Speaker = "Melinoe"
      Event = "DoraAboutDreamRuns01"
    }
    {
      Id = "Dora_0781"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, ya. Lagian aku juga nggak bakal mengusirmu atau semacamnya. Maksudku cuma, kalau kamu mau terus menyelami alam bawah sadarmu, aku dukung banget."
      Speaker = "Dora"
      Event = "DoraAboutDreamRuns01"
    }
    {
      Id = "Melinoe_5885"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih atas dukungannya."
      Speaker = "Melinoe"
      Event = "DoraAboutDreamRuns01"
    }
    {
      Id = "Melinoe_2027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau ingat nama {#Emph}Herakles? {#Prev}Pahlawan setengah dewa terhebat di permukaan, pembantai Singa Nemea, dan sebagainya?"
      Speaker = "Melinoe"
      Event = "DoraAboutHeracles01"
    }
    {
      Id = "Dora_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak juga, sih. Tapi sesekali aku dengar Arwah-arwah lain {#Emph}terus-terusan {#Prev}ngomongin dia. Kenapa emangnya?"
      Speaker = "Dora"
      Event = "DoraAboutHeracles01"
    }
    {
      Id = "Melinoe_2028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berpapasan dengannya. Badannya memang sebesar yang dikatakan orang-orang, itu sudah pasti. Kisah masa lalunya begitu legendaris, kupikir mungkin kau ingat salah satu ceritanya."
      Speaker = "Melinoe"
      Event = "DoraAboutHeracles01"
    }
    {
      Id = "Dora_0195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, tebakanmu salah besar, Sobat."
      Speaker = "Dora"
      Event = "DoraAboutHeracles01"
    }
    {
      Id = "Dora_0615"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, {#Emph}eh{#Prev}, kamu sama cowok itu, yang punya sayap, siapa namanya? Kukira dia udah lama {#Emph}mati{#Prev}, tapi pas {#Emph}aku {#Prev}lihat dia di sini bersamamu, dia kelihatan... yah, sangat hidup? Gimana caranya?"
      Speaker = "Dora"
      Event = "DoraAboutIcarusRelationship01"
    }
    {
      Id = "Melinoe_4683"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu Ikaros? Dan apa kau... apa kau menguping sesuatu yang jelas-jelas momen pribadi di antara kenalan lama? Kukira kau sedang di tempat lain!"
      Speaker = "Melinoe"
      Event = "DoraAboutIcarusRelationship01"
    }
    {
      Id = "Dora_0616"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, nggak kok, aku cuma berdiri di {#Emph}sana. {#Prev}Nggak mau ganggu aja. Jadi kamu menghidupkannya lagi pakai ritual nekromansi, atau gimana?"
      Speaker = "Dora"
      Event = "DoraAboutIcarusRelationship01"
    }
    {
      Id = "Melinoe_4684"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu urusan pribadiku, terima kasih!"
      Speaker = "Melinoe"
      Event = "DoraAboutIcarusRelationship01"
    }
    {
      Id = "Dora_0617"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Percaya deh, {#Emph}nggak ada {#Prev}yang perlu kamu malukan."
      Speaker = "Dora"
      Event = "DoraAboutIcarusRelationship01"
    }
    {
      Id = "Dora_0606"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, jadi sebenarnya {#Emph}apa yang terjadi {#Prev}di sini? Kamu sudah menuntaskan tugas besar nan pentingmu itu? Soalnya begitu yang kudengar dari Arwah-arwah lain."
      Speaker = "Dora"
      Event = "DoraPostTrueEnding01"
    }
    {
      Id = "Melinoe_4873"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, sebagian besarnya, iya! Keluargaku telah kembali! Ibu dan ayahku kembali bertahta di Underworld, dan saudaraku juga sudah pulang! Tapi masih banyak rincian yang harus kami bereskan, dan... Titan Chronos akan membantu kami mengurusnya."
      Speaker = "Melinoe"
      Event = "DoraPostTrueEnding01"
    }
    {
      Id = "Dora_0607"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan yang katanya mau kamu bantai sepanjang waktu itu... {#Emph}membantu kita. {#Prev}Nggak enak ngomongnya, Mel, tapi kedengarannya kamu gagal total. Yah, setidaknya di bagian Titannya."
      Speaker = "Dora"
      Event = "DoraPostTrueEnding01"
    }
    {
      Id = "Melinoe_4874"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia bukan dirinya yang dulu lagi, atau lebih tepatnya... tidak lagi seperti yang dulu. Dan kami akan terus mengawasinya dengan ketat."
      Speaker = "Melinoe"
      Event = "DoraPostTrueEnding01"
    }
    {
      Id = "Dora_0608"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, deh. Berarti... pada dasarnya sudah boleh ngucapin selamat, kan?"
      Speaker = "Dora"
      Event = "DoraPostTrueEnding01"
    }
    {
      Id = "Melinoe_4875"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, jika kau mau..."
      Speaker = "Melinoe"
      Event = "DoraPostTrueEnding01"
    }
    {
      Id = "Dora_0609"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau dong. Selamat, Mel."
      Speaker = "Dora"
      Event = "DoraPostTrueEnding01"
    }
    {
      Id = "Dora_0623"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada lukisan baru di situ, kulihat. Itu dari ibu dan ayahmu? Kelihatan lebih baru dari yang satunya. Kamu sudah dewasa banget!"
      Speaker = "Dora"
      Event = "DoraPostTrueEnding02"
    }
    {
      Id = "Melinoe_4876"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu semacam hadiah perpisahan, mengingat aku tak akan tinggal di Kediaman Hades bersama mereka. Walau kurasa, kami masih akan sering bertemu."
      Speaker = "Melinoe"
      Event = "DoraPostTrueEnding02"
    }
    {
      Id = "Dora_0624"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh, tega amat! {#Prev}Kenapa mereka nggak mau kamu tinggal di benteng bawah tanah bareng {#Emph}mereka? {#Prev}Kamu kan {#Emph}anak mereka!"
      Speaker = "Dora"
      Event = "DoraPostTrueEnding02"
    }
    {
      Id = "Melinoe_4877"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka justru ingin aku tinggal di sana, hanya saja... rumahku ada di sini. Mereka memang keluargaku, tapi tempat ini juga."
      Speaker = "Melinoe"
      Event = "DoraPostTrueEnding02"
    }
    {
      Id = "Dora_0625"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kamu sudah gila? Tunggu, aku juga keluargamu, {#Emph}itu {#Prev}maksudmu?"
      Speaker = "Dora"
      Event = "DoraPostTrueEnding02"
    }
    {
      Id = "Melinoe_4878"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu, jika kau tak keberatan."
      Speaker = "Melinoe"
      Event = "DoraPostTrueEnding02"
    }
    {
      Id = "Dora_0626"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oh, {#Prev}ya sudah, kurasa kenapa nggak?"
      Speaker = "Dora"
      Event = "DoraPostTrueEnding02"
    }
    {
      Id = "Melinoe_4879"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei Dora, bagaimana seandainya secara hipotetis suatu saat nanti zaman baru akan dimulai, dan para dewa benar-benar membiarkan manusia hidup tenang? Lebih dari sebelumnya."
      Speaker = "Melinoe"
      Event = "DoraPostEpilogue01"
    }
    {
      Id = "Dora_0627"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu gimana, kamu lagi ngasih semacam {#Emph}tawaran {#Prev}ke aku? Aku tahu kamu orang penting belakangan ini, tapi {#Emph}kamu pun {#Prev}nggak punya kekuatan untuk mewujudkan hal {#Emph}seperti itu{#Prev}, Mel. Kenapa pula para dewa mau melepaskan kedudukan mereka?"
      Speaker = "Dora"
      Event = "DoraPostEpilogue01"
    }
    {
      Id = "Melinoe_4880"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan para dewa pun tunduk pada kehendak Tiga Moirai. Tak satu pun dari kita yang bisa sepenuhnya mengendalikan apa yang akan terjadi, dan ada nubuat-nubuat yang tak bisa diubah bagaimanapun caranya."
      Speaker = "Melinoe"
      Event = "DoraPostEpilogue01"
    }
    {
      Id = "Dora_0628"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu beneran percaya hal begituan, bahkan setelah semua yang kamu lakuin? Maksudku, apa {#Emph}beneran {#Prev}ada semacam nubuat tentang Chronos, dan gimana akhirnya kamu ngalahin dia pas kamu sadar sama potensi sejatimu berkat bantuanku?"
      Speaker = "Dora"
      Event = "DoraPostEpilogue01"
    }
    {
      Id = "Melinoe_4881"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, tidak juga, karena Moirai menghilang selama sebagian besar cobaan ini, tapi... mereka biasanya tidak pernah keliru."
      Speaker = "Melinoe"
      Event = "DoraPostEpilogue01"
    }
    {
      Id = "Dora_0629"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Iya deh. Aku baru percaya kalau udah kejadian."
      Speaker = "Dora"
      Event = "DoraPostEpilogue01"
    }
    {
      Id = "Dora_0653"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak banyak yang terjadi belakangan ini. Enak juga! Aku bisa mandang kamu terus kayak, {#Emph}bum{#Prev}, kita langsung paham satu sama lain tanpa ngomong sepatah kata pun."
      Speaker = "Dora"
      Event = "DoraAboutLittleToSay01"
    }
    {
      Id = "Melinoe_5472"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu kau cukup dekat dengan seseorang, kau sering kali tak perlu bertukar kata untuk memahami perasaan mereka."
      Speaker = "Melinoe"
      Event = "DoraAboutLittleToSay01"
    }
    {
      Id = "Dora_0654"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ooh. Aku mau coba ah. Jadi tahan bicaramu sebisa mungkin, ya?"
      Speaker = "Dora"
      Event = "DoraAboutLittleToSay01"
    }
    {
      Id = "Melinoe_5473"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke! Maksudku, {#Emph}mph."
      Speaker = "Melinoe"
      Event = "DoraAboutLittleToSay01"
    }
    {
      Id = "Dora_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maka dari itu kukatakan, {#Emph}enyahlah wahai penyihir terlaknat! Aku sudah mendiami hutan kecil ini selama berabad-abad, jauh sebelum tenda menyedihkanmu berdiri di sini! {#Prev}Oh halo, Mel."
      Speaker = "Dora"
      Event = "DoraWithMoros01"
    }
    {
      Id = "Melinoe_2031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rupanya kalian berdua sudah saling kenal! Tuan Moros, Dora berkata jujur seperti biasa. Dia sudah berada di sini lebih lama dariku, kalau kau percaya!"
      Speaker = "Melinoe"
      Event = "DoraWithMoros01"
    }
    {
      Id = "Moros_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja aku percaya. Karena aku tahu betul jiwa yang sudah tua saat melihatnya. Senang bertemu denganmu, Dora. Beritahu aku jika ada yang bisa kubantu."
      Speaker = "Moros"
      Event = "DoraWithMoros01"
    }
    {
      Id = "Dora_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Haha. {#Prev}Pasti, Si Tanduk! Nah kalau begitu, {#Emph}aku undur diri dulu. Sampai jumpa!"
      Speaker = "Dora"
      Event = "DoraWithMoros01"
    }
    {
      Id = "Moros_0185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa!"
      Speaker = "Moros"
      Event = "DoraWithMoros01"
    }
    {
      Id = "Dora_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Saudara {#Emph}kandungnya sendiri? Eugh, {#Prev}nggak banget, kacau parah! Saudari-saudarimu beneran sakit!"
      Speaker = "Dora"
      Event = "DoraWithMoros02"
    }
    {
      Id = "Moros_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... mereka harus mengurai begitu banyak benang kehidupan manusia fana. Pekerjaan itu bisa menjadi repetitif, kehilangan keindahannya. Jadi sesekali mereka membuatnya lebih menarik."
      Speaker = "Moros"
      Event = "DoraWithMoros02"
    }
    {
      Id = "Dora_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh jelas, kalau jadi mereka sih aku bakal lakuin hal yang sama persis. Penasaran apa yang mereka lakuin ke {#Emph}aku.... {#Prev}Bisa nggak, coba cari tahu soal aku, atau semacamnya...?"
      Speaker = "Dora"
      Event = "DoraWithMoros02"
    }
    {
      Id = "Moros_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heh! {#Prev}Sayangnya aku tidak berhak melakukan hal semacam itu."
      Speaker = "Moros"
      Event = "DoraWithMoros02"
    }
    {
      Id = "Dora_0184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, ayolah..."
      Speaker = "Dora"
      Event = "DoraWithMoros02"
    }
    {
      Id = "Dora_0655"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sekarang bersujudlah di hadapanku, wahai Raja Bertanduk, dan ketahuilah tempatmu! Kalau tidak, akan kulumat dirimu beserta surai berkilaumu itu menjadi debu lalu kusebarkan ke empat penjuru mata angin!"
      Speaker = "Dora"
      Event = "DoraWithMoros03"
    }
    {
      Id = "Moros_0697"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ya, tadi itu luar biasa sekali, Dora. Hanya saja, {#Emph}Raja Bertanduk? {#Prev}Itu terdengar seolah aku orang penting, padahal kupikir kau berniat untuk sekadar mendominasi."
      Speaker = "Moros"
      Event = "DoraWithMoros03"
    }
    {
      Id = "Dora_0656"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Iya juga sih{#Prev}, masukan yang bagus. Cuma mendadak kepikiran aja, tahu kan? Tanduk itu... {#Emph}emang {#Prev}mencolok banget! Asli nggak tuh?"
      Speaker = "Dora"
      Event = "DoraWithMoros03"
    }
    {
      Id = "Moros_0698"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan coba-coba menyentuhnya."
      Speaker = "Moros"
      Event = "DoraWithMoros03"
    }
    {
      Id = "Dora_0657"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau kusentuh ah."
      Speaker = "Dora"
      Event = "DoraWithMoros03"
    }
    {
      Id = "Moros_0699"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kubilang jangan."
      Speaker = "Moros"
      Event = "DoraWithMoros03"
    }
    {
      Id = "Dora_0658"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bodo, tetap kusentuh!"
      Speaker = "Dora"
      Event = "DoraWithMoros03"
    }
    {
      Id = "Moros_0700"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kumohon?"
      Speaker = "Moros"
      Event = "DoraWithMoros03"
    }
    {
      Id = "Dora_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jadi pada dasarnya kamu cuma berdiri di sini, ngoceh sembarangan, apa pun yang terlintas di kepalamu, terus Arwah-arwah {#Emph}lainnya{#Prev}, sama Mel... nelan mentah-mentah omonganmu?"
      Speaker = "Dora"
      Event = "DoraWithSkelly01"
    }
    {
      Id = "Skelly_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka {#Emph}jelas {#Prev}menelannya, Muridku, karena itu adalah santapan yang lahir dari kebijaksanaan pengalaman yang amat luas, yang mendasari apa pun yang terlintas di kepalaku! Sekarang bisakah kau memberiku sedikit ketenangan...?"
      Speaker = "Skelly"
      Event = "DoraWithSkelly01"
    }
    {
      Id = "Dora_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke. Aku paham kok, {#Emph}Komandan."
      Speaker = "Dora"
      Event = "DoraWithSkelly01"
    }
    {
      Id = "Skelly_0173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai di mana kita tadi?"
      Speaker = "Skelly"
      Event = "DoraWithSkelly01"
    }
    {
      Id = "Dora_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakal kujagain semua barangmu selagi kamu pergi."
      Speaker = "Dora"
      Event = "DoraChat01"
    }
    {
      Id = "Dora_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang ngobrol sama kamu, tapi mending aku balik gentayangan lagi."
      Speaker = "Dora"
      Event = "DoraChat02"
    }
    {
      Id = "Dora_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak banget barang aneh di sini, kamu tahu kan?"
      Speaker = "Dora"
      Event = "DoraChat03"
    }
    {
      Id = "Dora_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma lagi gentayangan di tempat ini. Nggak usah cemasin aku..."
      Speaker = "Dora"
      Event = "DoraChat04"
    }
    {
      Id = "Dora_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hai, Mel. Maksudku, {#Emph}Burung gagak akan berpesta melahap kedua matamu!"
      Speaker = "Dora"
      Event = "DoraChat05"
    }
    {
      Id = "Dora_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hai, Mel. Maksudku, {#Emph}Mencariku sama saja dengan menjemput ajalmu!"
      Speaker = "Dora"
      Event = "DoraChat06"
    }
    {
      Id = "Dora_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Berani-beraninya menggangguku, bakal kusiiksa kau selama tiga keabadian!"
      Speaker = "Dora"
      Event = "DoraChat07"
    }
    {
      Id = "Dora_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Semoga siangmu dipenuhi kengerian, dan malammu dicekam ketakutan!"
      Speaker = "Dora"
      Event = "DoraChat08"
    }
    {
      Id = "Dora_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Seribu kutukan menimpamu karena telah memanggilku!"
      Speaker = "Dora"
      Event = "DoraChat09"
    }
    {
      Id = "Dora_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jangan berani-berani berlama-lama di dalam tendaku, penyihir!"
      Speaker = "Dora"
      Event = "DoraChat10"
    }
    {
      Id = "Dora_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lakuin aja urusanmu. Anggap aja aku nggak ada di sini."
      Speaker = "Dora"
      Event = "DoraChat11"
    }
    {
      Id = "Dora_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cumaaa melayang-layang santai kok, jangan peduliin aku."
      Speaker = "Dora"
      Event = "DoraChat12"
    }
    {
      Id = "Dora_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bebas kok kalau mau diam di tendamu sendiri selama yang kamu mau."
      Speaker = "Dora"
      Event = "DoraChat13"
    }
    {
      Id = "Dora_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kasih tahu ya kalau ada yang mau kamu suruh aku siksa, oke?"
      Speaker = "Dora"
      Event = "DoraChat14"
    }
    {
      Id = "Dora_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga tugas besarmu itu lancar-lancar aja ya!"
      Speaker = "Dora"
      Event = "DoraChat15"
    }
    {
      Id = "Dora_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakal kuusahain nggak bikin berantakan selagi kamu pergi."
      Speaker = "Dora"
      Event = "DoraChat16"
    }
    {
      Id = "Dora_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Emm{#Prev}, bisa kasih aku sedikit privasi di sini, Mel?"
      Speaker = "Dora"
      Event = "DoraChat17"
    }
    {
      Id = "Dora_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makin cepat kamu pergi dari sini, makin cepat aku bisa obrak-abrik barang-barangmu."
      Speaker = "Dora"
      Event = "DoraChat18"
    }
    {
      Id = "Dora_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kamu {#Prev}ada, {#Emph}aku {#Prev}ada... bisa lebih buruk dari ini, kan?"
      Speaker = "Dora"
      Event = "DoraChat19"
    }
    {
      Id = "Dora_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat beraktivitas di jam berapa pun ini selagi ngerjain apa pun yang kamu kerjain!"
      Speaker = "Dora"
      Event = "DoraChat20"
    }
    {
      Id = "Dora_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hajar mereka sampai mati buatku, atau hidupkan lagi sekalian! Mana aja deh yang lebih buruk."
      Speaker = "Dora"
      Event = "DoraChat21"
    }
    {
      Id = "Dora_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bakal gentayangan di tenda ini {#Emph}parah banget {#Prev}begitu kamu keluar dari sini..."
      Speaker = "Dora"
      Event = "DoraChat22"
    }
    {
      Id = "Dora_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ikuti alur aja di luar sana! Itu yang biasa kulakuin!"
      Speaker = "Dora"
      Event = "DoraChat23"
    }
    {
      Id = "Dora_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Gila{#Prev}, Mel! {#Emph}Waduh. {#Prev}Andai tatapan mata bisa membunuh, ya nggak?"
      Speaker = "Dora"
      Event = "DoraChat24"
    }
    {
      Id = "Dora_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga nggak ada hal mengerikan yang nimpa kamu di luar sana!"
      Speaker = "Dora"
      Event = "DoraChat25"
    }
    {
      Id = "Dora_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mel, kamu sudah menginspirasiku... buat melayang di sini aja, untuk saat ini."
      Speaker = "Dora"
      Event = "DoraChat26"
    }
    {
      Id = "Dora_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hai, Mel! Maksudku, {#Emph}Kau tak punya kuasa atasku, penyihir!"
      Speaker = "Dora"
      Event = "DoraChat27"
    }
    {
      Id = "Dora_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kemunculanmu yang terus-menerus ini mulai bisa kuterima, penyihir!"
      Speaker = "Dora"
      Event = "DoraChat28"
    }
    {
      Id = "Dora_0630"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira ada yang perlu kita ubah nggak ya soal perabotan dan semacamnya?"
      Speaker = "Dora"
      Event = "DoraChat29"
    }
    {
      Id = "Dora_0631"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kadang aku rasanya pengin, kayak, {#Emph}merasukin {#Prev}seseorang gitu, tahu kan? Sebentar aja kok."
      Speaker = "Dora"
      Event = "DoraChat30"
    }
    {
      Id = "Dora_0632"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan peduliin aku! Cuma lagi nyantai kayak biasa di sini, Mel."
      Speaker = "Dora"
      Event = "DoraChat31"
    }
    {
      Id = "Dora_0633"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Arwah di luar sana pada bilang kamu beraksi hebat lagi malam ini, bener kan?"
      Speaker = "Dora"
      Event = "DoraChat32"
    }
    {
      Id = "Dora_0634"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau mau ada orang di sekitar sini yang disiksa sebentar, tinggal kasih kode aja."
      Speaker = "Dora"
      Event = "DoraChat33"
    }
    {
      Id = "Dora_0635"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kau sudi memandangku, penyihir? Akan kugentayangi setiap saat kau terjaga!"
      Speaker = "Dora"
      Event = "DoraChat34"
    }
    {
      Id = "Dora_0636"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mereka yang menatap mataku ditakdirkan selamanya menderita sepertiku!"
      Speaker = "Dora"
      Event = "DoraChat35"
    }
    {
      Id = "Dora_0637"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Penderitaan abadi dan gigitan serangga menanti siapa pun yang berani menghalangi jalanku."
      Speaker = "Dora"
      Event = "DoraChat36"
    }
    {
      Id = "Dora_0638"
      InheritFrom = "BaseNarrative"
      DisplayName = "Udah kujagain tempat ini selagi kamu pergi, dan {#Emph}menakut-nakuti siapa pun yang berani mendekat!"
      Speaker = "Dora"
      Event = "DoraChat37"
    }
    {
      Id = "Dora_0639"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakal kujagain tenda ini buatmu selagi kamu keluyuran semalaman, Mel."
      Speaker = "Dora"
      Event = "DoraChat38"
    }
    {
      Id = "Dora_0640"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau butuh apa-apa, aku ada di sini kok. Atau di tempat lain yang kamu tuju."
      Speaker = "Dora"
      Event = "DoraChat40"
    }
    {
      Id = "Dora_0641"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada Arwah lain yang nyapa aku tadi, {#Emph}untuk yang pertama dan terakhir kalinya!"
      Speaker = "Dora"
      Event = "DoraChat41"
    }
    {
      Id = "Dora_0642"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya lumayan beres di sini akhir-akhir ini, asalkan kau juga bisa bilang begitu."
      Speaker = "Dora"
      Event = "DoraChat42"
    }
    {
      Id = "Melinoe_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin memberikan ini untukmu, Dora. Untuk arwah penggentayangan terbaik di seluruh Crossroads!"
      Speaker = "Melinoe"
      Event = "DoraGift01"
    }
    {
      Id = "Dora_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuh kan, aku {#Emph}tahu {#Prev}cepat atau lambat kau bakal mempraktikkan tradisi kasih-hadiah ini padaku, jadi aku sudah bersiap-siap. Tangkap!"
      Speaker = "Dora"
      Event = "DoraGift01"
    }
    {
      Id = "Dora_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, kau tak perlu repot-repot membelikan barang beginian buatku! Lagian aku bisa mengambil barang apa pun milikmu saat kau sedang keluar!"
      Speaker = "Dora"
      Event = "DoraGift02"
    }
    {
      Id = "Melinoe_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau tak bisa mengambil yang {#Emph}ini {#Prev}saat aku pergi! Aku selalu membawanya ke mana-mana, khusus untuk momen seperti ini."
      Speaker = "Melinoe"
      Event = "DoraGift02"
    }
    {
      Id = "Dora_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Dasar bodoh! Aku takkan mempan dengan pernak-pernik murahan semacam ini! Ah{#Prev}, bercanda deng. {#Emph}Mempan banget{#Prev}. Siniin!"
      Speaker = "Dora"
      Event = "DoraGift03"
    }
    {
      Id = "Melinoe_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya, aku berhasil menemukan titik celah di pertahananmu!"
      Speaker = "Melinoe"
      Event = "DoraGift03"
    }
    {
      Id = "Dora_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mulai merasa kayaknya aku dulu suka barang-barang begini waktu masih punya bola mata dan semacamnya."
      Speaker = "Dora"
      Event = "DoraGift04"
    }
    {
      Id = "Melinoe_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak masalah apakah dulu kau menyukainya atau tidak, yang terpenting adalah kau menyukainya sekarang."
      Speaker = "Melinoe"
      Event = "DoraGift04"
    }
    {
      Id = "Dora_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ungh{#Prev}, di satu sisi, aku benar-benar tak tahu apa jasaku sampai pantas menerima ini. Tapi di sisi lain, masa bodoh juga sih! Sekarang ini sudah jadi milikku."
      Speaker = "Dora"
      Event = "DoraGift05"
    }
    {
      Id = "Melinoe_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja memang milikmu! Dan masih banyak lagi yang bisa kau dapatkan kalau kau terus menggentayangi tenda ini!"
      Speaker = "Melinoe"
      Event = "DoraGift05"
    }
    {
      Id = "Dora_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Persembahan menyedihkan seperti ini sama sekali tak layak kulirik, hai penyihir! {#Prev}Enggak deh, tapi seriusan, makasih ya. Tak pernah ada yang memberiku apa-apa! Selain kau, maksudku. Rasanya menyenangkan, tahu?"
      Speaker = "Dora"
      Event = "DoraGift06"
    }
    {
      Id = "Melinoe_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga merasa senang! Ditemani olehmu di sini sangat berarti bagiku, jadi ini cuma hal kecil yang bisa kulakukan."
      Speaker = "Melinoe"
      Event = "DoraGift06"
    }
    {
      Id = "Dora_0595"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, {#Emph}santai dulu {#Prev}soal Nectar-nya, dong, Mel? Sejak kita mencicipi Ambrosia, seleraku sudah berkembang jadi {#Emph}jauh {#Prev}lebih berkelas, untuk ukuran sebuah Arwah. Jangan kasih yang murah-murah lagi."
      Speaker = "Dora"
      Event = "DoraGift07"
    }
    {
      Id = "Melinoe_4670"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora, Nectar para dewa sama sekali tak bisa dibilang {#Emph}murah! {#Prev}Sebagian besar makhluk fana menjalani seluruh hidup mereka tanpa pernah {#Emph}mencicipinya {#Prev}sedikit pun! Dan kau malah tak suka?"
      Speaker = "Melinoe"
      Event = "DoraGift07"
    }
    {
      Id = "Dora_0596"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya aku {#Emph}suka {#Prev}sih, tapi buatku rasanya agak kemanisan? Tapi ya, aku menghargai caramu memperlakukanku bak bangsawan... {#Emph}bagaikan arwah dengan kekuatan yang tak terduga...!"
      Speaker = "Dora"
      Event = "DoraGift07"
    }
    {
      Id = "Melinoe_4671"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah bertemu banyak Arwah yang hebat dan terhormat, Dora, tapi aku bisa bilang dengan yakin bahwa tak ada satu pun dari mereka yang seperti {#Emph}dirimu. {#Prev}Ambrosia ini milikmu; mau kita buka di kedai?"
      Speaker = "Melinoe"
      Event = "DoraGift08"
    }
    {
      Id = "Dora_0597"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aku akan menerima persembahanmu kali ini, hai penyihir. {#Prev}Tapi kusimpan dulu saja deh untuk sekarang. Kecuali kalau kau mau menikmatinya bersamaku di sini? Intinya aku cuma malas ke mana-mana, itu saja."
      Speaker = "Dora"
      Event = "DoraGift08"
    }
    {
      Id = "Melinoe_4672"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Tentu saja. Ini, aromanya saja sudah sangat semerbak. Bersulang untuk gentayanganmu yang tiada henti!"
      Speaker = "Melinoe"
      Event = "DoraGift08"
    }
    {
      Id = "Dora_0598"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makasih. Minuman ini beneran enak banget. Ngomong-ngomong, kenapa kau punya Nectar {#Emph}dan juga {#Prev}Ambrosia sekaligus? Aneh deh. Dua minuman para dewa yang berbeda, cuma yang satu jauh lebih mewah."
      Speaker = "Dora"
      Event = "DoraGift08"
    }
    {
      Id = "Melinoe_4673"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keduanya cocok untuk acara yang berbeda. Kurang pantas rasanya menawarkan Ambrosia kepada orang yang baru dikenal, misalnya. Minuman itu biasanya dikhususkan untuk perjamuan bersama sahabat dekat atau kekasih."
      Speaker = "Melinoe"
      Event = "DoraGift08"
    }
    {
      Id = "Dora_0599"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, itu terdengar persis seperti {#Emph}kita! {#Prev}Tapi kayaknya aku mulai bosan juga dengan minuman ini..."
      Speaker = "Dora"
      Event = "DoraGift08"
    }
    {
      Id = "Melinoe_4674"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh..."
      Speaker = "Melinoe"
      Event = "DoraGift08"
    }
    {
      Id = "Melinoe_3814"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau berminat pergi ke pemandian air panas bersamaku, Dora? Berendam air hangat bisa menyegarkan jiwa."
      Speaker = "Melinoe"
      Event = "DoraBathHouseDecline01"
    }
    {
      Id = "Dora_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "Enggak deh. Lagi agak sibuk rebahan tanpa ngapa-ngapain sekarang, tapi mungkin lain kali aku mau berendam."
      Speaker = "Dora"
      Event = "DoraBathHouseDecline01"
    }
    {
      Id = "Melinoe_3815"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita pergi sebentar ke dermaga pemancingan bersamaku? Di sana suasananya tenang dan sunyi!"
      Speaker = "Melinoe"
      Event = "DoraFishingDecline01"
    }
    {
      Id = "Dora_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh{#Prev}, lagi malas gerak nih. Lagian ikan-ikan itu pasti bakal {#Emph}gampang banget {#Prev}ketakutan kalau melihat penggentayangan sehebat diriku."
      Speaker = "Dora"
      Event = "DoraFishingDecline01"
    }
    {
      Id = "Melinoe_3816"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau menemaniku ke Kedai untuk menikmati sebotol Ambrosia? Kunjungan kita yang sebelumnya terasa menyenangkan."
      Speaker = "Melinoe"
      Event = "DoraTavernaDecline01"
    }
    {
      Id = "Dora_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga senang sih, tapi rasanya agak {#Emph}melelahkan {#Prev}berada di tengah kerumunan itu... kayaknya masih agak lemas gara-gara yang kemarin."
      Speaker = "Dora"
      Event = "DoraTavernaDecline01"
    }
    {
      Id = "Melinoe_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kalau kau sedang senggang, mau ikut sebentar ke tepi sungai bersamaku? Aku punya umpan ganda yang bisa kita pakai sekarang."
      Speaker = "Melinoe"
      Event = "DoraFishing01"
    }
    {
      Id = "Dora_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah bakal banyak membantu atau tidak, secara aku tak bisa pakai joran pancing dan tak bisa diam juga, tapi ya sudahlah! Kau sendiri yang mengajak."
      Speaker = "Dora"
      Event = "DoraFishing01"
    }
    {
      Id = "Dora_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungai Ratapan. Isinya cuma tumpukan hal-hal menyedihkan yang mengapung di sana. Yakin kau tak mau membiarkannya saja?"
      Speaker = "Dora"
      Event = "DoraFishing01"
    }
    {
      Id = "Melinoe_3690"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang terpuruk di sana akan tetap menetap di situ, kecuali jika mereka akhirnya memutuskan sudah muak dengan keadaannya. Untuk jiwa-jiwa semacam itu, kupikir kita justru membantu mereka."
      Speaker = "Melinoe"
      Event = "DoraFishing01"
    }
    {
      Id = "Dora_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita kan tak berutang apa-apa pada mereka, dan mereka juga tak bakal membalas budi kita. Dan kalau yang bisa mereka lakukan sekarang cuma meratapi nasib di dasar sungai berlumpur, memancing mereka keluar mungkin takkan mengubah apa pun juga."
      Speaker = "Dora"
      Event = "DoraFishing01"
    }
    {
      Id = "Melinoe_3691"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita bukan sekadar memancing mereka keluar, sebenarnya. Lebih seperti memberi mereka kesempatan untuk meloloskan diri dari nasib mereka. Dalam hal itu, rasanya agak berbeda dari cara memancing kaum fana."
      Speaker = "Melinoe"
      Event = "DoraFishing01"
    }
    {
      Id = "Dora_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagian kalau mereka nggak suka tinggal di atas sini, ya derita mereka..."
      Speaker = "Dora"
      Event = "DoraFishing01"
    }
    {
      Id = "Dora_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, setidaknya tadi itu kejadian juga. Makasih!"
      Speaker = "Dora"
      Event = "DoraFishing01"
    }
    {
      Id = "Melinoe_0063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dah."
      Speaker = "Melinoe"
      Event = "DoraFishing01"
    }
    {
      Id = "Dora_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke, dah."
      Speaker = "Dora"
      Event = "DoraFishing01"
    }
    {
      Id = "Dora_0509"
      InheritFrom = "BaseNarrative"
      DisplayName = "Butuh teman memancing? Jangan banyak cakap. Aku ikut banget."
      Speaker = "Dora"
      Event = "DoraFishingRepeatable01[1]"
    }
    {
      Id = "Dora_0511"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu, baru saja aku berpikir kenapa nggak mampir ke tepi sungai lagi. Bukan berarti aku mau pergi kalau kamu nggak minta, ya."
      Speaker = "Dora"
      Event = "DoraFishingRepeatable01[1]"
    }
    {
      Id = "Dora_0513"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Seluruh penghuni sungai akan merasakan kengerian yang sesungguhnya!"
      Speaker = "Dora"
      Event = "DoraFishingRepeatable01[1]"
    }
    {
      Id = "Dora_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh hei, kebetulan banget jadwal padatku mendadak kosong melompong saat ini! Ayo pimpin jalannya."
      Speaker = "Dora"
      Event = "DoraFishingRepeatable01[1]"
    }
    {
      Id = "Dora_0510"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski tanpa tangan, aku ogah balik dengan tangan hampa setelah semua tadi."
      Speaker = "Dora"
      Event = "DoraFishingRepeatable01[2]"
    }
    {
      Id = "Dora_0512"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebanyakan mikir di sana tadi, tapi setidaknya kita dapat ini."
      Speaker = "Dora"
      Event = "DoraFishingRepeatable01[2]"
    }
    {
      Id = "Dora_0514"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aneh rasanya gimana kita bisa melakukan sesuatu sekaligus nggak ngapa-ngapain di waktu yang bersamaan."
      Speaker = "Dora"
      Event = "DoraFishingRepeatable01[2]"
    }
    {
      Id = "Dora_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu nggak, setelah dipikir-pikir, tadi itu lumayan asyik! Makasih, Mel."
      Speaker = "Dora"
      Event = "DoraFishingRepeatable01[2]"
    }
    {
      Id = "Melinoe_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong-omong Dora? Kamu keberatan nggak menemaniku ke pemandian air panas? Sayang rasanya kalau tempat itu nggak ada hantunya."
      Speaker = "Melinoe"
      Event = "DoraBathHouse01"
    }
    {
      Id = "Dora_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa aku mau mengapung tanpa tujuan di air yang nyaris mendidih? Mau banget, lah! Tunggu apa lagi?"
      Speaker = "Dora"
      Event = "DoraBathHouse01"
    }
    {
      Id = "Dora_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira dulu aku pernah malu-malu nggak ya soal ginian..."
      Speaker = "Dora"
      Event = "DoraBathHouse01"
    }
    {
      Id = "Melinoe_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu masih bisa merasakan hangatnya air, kan, Dora?"
      Speaker = "Melinoe"
      Event = "DoraBathHouse01"
    }
    {
      Id = "Dora_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku bisa lihat uapnya mengepul, yang biasanya kuanggap hangat, jadi... kurasa itu bikin pikiranku tersugesti merasa hangat."
      Speaker = "Dora"
      Event = "DoraBathHouse01"
    }
    {
      Id = "Melinoe_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya lumayan. Tapi, kamu masih ingat seperti apa rasanya hangat? Dari zaman fana dulu?"
      Speaker = "Melinoe"
      Event = "DoraBathHouse01"
    }
    {
      Id = "Dora_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, sejujurnya nggak juga, sih. A-aku rasa aku cuma sering banget mendengar tentang itu, sampai rasanya seolah pernah mengalaminya sendiri."
      Speaker = "Dora"
      Event = "DoraBathHouse01"
    }
    {
      Id = "Dora_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh! {#Prev}Tadi itu sebenarnya cuma berasa kayak ngambang di tendamu, tapi tetap saja aku menghargainya!"
      Speaker = "Dora"
      Event = "DoraBathHouse01"
    }
    {
      Id = "Melinoe_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku punya garam mandi ini yang lebih dari cukup buatku, kalau kamu lagi senggang saat ini...?"
      Speaker = "Melinoe"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Dora_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mel, kamu tahu sendiri aku suka bermalas-malasan. Berendam di sumber air panas bareng kamu? Yah, itu pasti pilihan terbaik kedua setelahnya, jadi, berangkat?"
      Speaker = "Dora"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Dora_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya kayak lagi dimasak di dalam kuali, kan?"
      Speaker = "Dora"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Melinoe_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernahkah kamu penasaran seperti apa rupamu dulu, Dora? Waktu kamu masih berwujud daging dan darah? Pasti kamu sangat cantik jelita."
      Speaker = "Melinoe"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Dora_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! A-apaan{#Prev}, seriusan? Karena suaraku atau lekuk tubuhku? Ah, kamu pasti cuma ngerjain aku."
      Speaker = "Dora"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Melinoe_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak, kok! Kurasa karena rasa percaya dirimu. Kamu sangat yakin pada dirimu sendiri! Sebagian Arwah ciut di hadapanku, tapi kita berdua selalu akrab."
      Speaker = "Melinoe"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Dora_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, beberapa Arwah memang tolol kuadrat. Lagian, nggak masalah juga bagiku rupaku dulu seperti apa. Kalau dulu aku bahagia, kurasa aku pasti bakal ingat."
      Speaker = "Dora"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Melinoe_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu pikir kamu sengaja melupakan masa lalumu?"
      Speaker = "Melinoe"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Dora_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Iya. Kalau nggak, kenapa lagi aku bisa lupa semuanya? Mungkin dulu aku nenggak beberapa teguk dari Sungai Lethe, terus kelar deh! Lembaran baru."
      Speaker = "Dora"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Melinoe_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungai Kelupaan... kamu pikir dulunya kamu ada di Elysium?"
      Speaker = "Melinoe"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Dora_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu nggak, kalau nggak salah tadi itu rasanya menyenangkan juga bareng kamu di sana. Makasih, Mel!"
      Speaker = "Dora"
      Event = "DoraBathHouse02"
    }
    {
      Id = "Melinoe_4675"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lupakan soal Nektar dan Ambrosia, bagaimana kalau kita ke pemandian air panas lagi? Di sana tenang. Rasanya lebih cocok dengan seleramu... dan seleraku juga."
      Speaker = "Melinoe"
      Event = "DoraBathHouse03"
    }
    {
      Id = "Dora_0600"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadinya aku berencana menolak apa pun maumu cuma demi ngerjain kamu, tapi pemandian air panas {#Emph}kedengarannya {#Prev}oke juga. Ayo gas."
      Speaker = "Dora"
      Event = "DoraBathHouse03"
    }
    {
      Id = "Melinoe_4676"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kamu nggak marah pada para dewa...? Atas apa yang telah mereka perbuat padamu, dan sepertinya pada seluruh umat manusia fana. Terus kenapa kalau itu sudah lama berlalu! Semakin kupikirkan, semakin marah rasanya..."
      Speaker = "Melinoe"
      Event = "DoraBathHouse03"
    }
    {
      Id = "Dora_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudku, {#Emph}jujur saja{#Prev}, itu lelucon yang cukup bagus! Tapi, jahat juga, sih. Aku nggak tahu siapa di antara kalian yang bertanggung jawab, tapi aku nggak begitu peduli. Marah-marah bukan gayaku banget."
      Speaker = "Dora"
      Event = "DoraBathHouse03"
    }
    {
      Id = "Melinoe_4677"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlalu baik... setidaknya lebih baik daripada keluargaku {#Emph}sendiri{#Prev}. Kurasa apa yang sudah terjadi tak bisa ditarik kembali, tapi... kalau ini ada artinya, begitu semua ini berakhir, aku akan berusaha sebisaku agar kami para dewa bersikap lebih pantas kepada manusia fana mulai sekarang."
      Speaker = "Melinoe"
      Event = "DoraBathHouse03"
    }
    {
      Id = "Dora_0603"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mewakili semua manusia fana yang pernah hidup atau yang akan hidup, kurasa kami bakal lebih senang kalau kalian tinggalkan kami sendiri saja. Mungkin ada banyak kejahatan di dunia ini, tapi... kami punya cara sendiri untuk menyelesaikannya."
      Speaker = "Dora"
      Event = "DoraBathHouse03"
    }
    {
      Id = "Melinoe_4678"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Setidaknya, bisakah kau dan aku tetap berteman?"
      Speaker = "Melinoe"
      Event = "DoraBathHouse03"
    }
    {
      Id = "Dora_0604"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hmm, biar kupikirkan dulu sebentar dan nanti kukabari lagi, oke?"
      Speaker = "Dora"
      Event = "DoraBathHouse03"
    }
    {
      Id = "Dora_0605"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Setelah kupikir-pikir panjang, soal tetap-jadi-teman itu aman, Mel. Tapi nanti kukabari lagi kalau ada apa-apa!"
      Speaker = "Dora"
      Event = "DoraBathHouse03"
    }
    {
      Id = "Melinoe_4680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah kalau begitu, Dora."
      Speaker = "Melinoe"
      Event = "DoraBathHouse03"
    }
    {
      Id = "Dora_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadwalku malam ini cukup padat, tapi kurasa aku bisa menyempatkannya."
      Speaker = "Dora"
      Event = "DoraBathHouseRepeatable01[1]"
    }
    {
      Id = "Dora_0503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kalau kita berdua sama-sama punya waktu luang, kurasa kenapa tidak."
      Speaker = "Dora"
      Event = "DoraBathHouseRepeatable01[1]"
    }
    {
      Id = "Dora_0506"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Huh. {#Prev}Tentu saja. Pemandian air panas adalah salah satu tempat favoritku buat melayang santai."
      Speaker = "Dora"
      Event = "DoraBathHouseRepeatable01[1]"
    }
    {
      Id = "Dora_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Berada di sini benar-benar membangkitkan kenangan, tahu? Terutama kenangan waktu terakhir kali."
      Speaker = "Dora"
      Event = "DoraBathHouseRepeatable01[3]"
    }
    {
      Id = "Dora_0504"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Terkadang kurasa tempat ini bahkan lebih asyik daripada melayang-layang di dalam tenda. Mungkin sebaiknya aku gentayangan di sini saja..."
      Speaker = "Dora"
      Event = "DoraBathHouseRepeatable01[3]"
    }
    {
      Id = "Dora_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kurasa sisi baik dari otot-otot yang pegal linu adalah kau bisa meredakannya dengan berendam di tempat ini."
      Speaker = "Dora"
      Event = "DoraBathHouseRepeatable01[3]"
    }
    {
      Id = "Dora_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini bagian di mana aku seharusnya merasa lebih segar atau semacamnya, kan?"
      Speaker = "Dora"
      Event = "DoraBathHouseRepeatable01[4]"
    }
    {
      Id = "Dora_0505"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu yang menyenangkan tadi, Mel. Makasih sudah mengajakku ke sana."
      Speaker = "Dora"
      Event = "DoraBathHouseRepeatable01[4]"
    }
    {
      Id = "Dora_0508"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, tadi itu waktu yang cukup menyenangkan untuk eksis tanpa tujuan."
      Speaker = "Dora"
      Event = "DoraBathHouseRepeatable01[4]"
    }
    {
      Id = "Melinoe_3726"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, sekarang kedai sudah buka kembali, bagaimana kalau kutraktir sedikit Ambrosia para dewa? Kujamin rasanya enak!"
      Speaker = "Melinoe"
      Event = "DoraTaverna01"
    }
    {
      Id = "Dora_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kurasa aku lagi tidak sibuk, dan karena kau {#Emph}memang {#Prev}menjaminnya... tahu tidak, aku ikut."
      Speaker = "Dora"
      Event = "DoraTaverna01"
    }
    {
      Id = "Dora_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dianggap hidangan mewah, ya, masuk akal. Teksturnya agak aneh, benda ini sebenarnya harus {#Emph}diminum {#Prev}atau {#Emph}dimakan{#Prev}?"
      Speaker = "Dora"
      Event = "DoraTaverna01"
    }
    {
      Id = "Melinoe_3727"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya kau hanya perlu menikmatinya bersama teman-teman. Aku setuju ini agak tak lazim, tapi ya, ini memang ditujukan untuk saat-saat istimewa."
      Speaker = "Melinoe"
      Event = "DoraTaverna01"
    }
    {
      Id = "Dora_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa? Apa yang membuat momen ini begitu istimewa? Kita cuma... nongkrong santai. Memang sih bukan di dalam tenda, yang mana bukan kebiasaanku, tapi... tetap saja."
      Speaker = "Dora"
      Event = "DoraTaverna01"
    }
    {
      Id = "Melinoe_3728"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terserah kita untuk menentukan apa yang istimewa, bukan begitu? Ya, kita bertemu setiap malam. Tapi kita belum pernah menikmati sebotol minuman mewah seperti ini, hanya berdua saja."
      Speaker = "Melinoe"
      Event = "DoraTaverna01"
    }
    {
      Id = "Dora_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku paham maksudmu, tapi... agak paradoks atau semacamnya, kan? Ambrosia ditujukan untuk acara luar biasa, tapi Ambrosia itu sendiri yang membuat suasananya jadi... meriah secara tak wajar."
      Speaker = "Dora"
      Event = "DoraTaverna01"
    }
    {
      Id = "Melinoe_3729"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan {#Emph}secara gaib{#Prev}. Kulitku, rasanya meremang, seolah-olah... ada sesuatu di sini bersama kita! Oh, para dewa..."
      Speaker = "Melinoe"
      Event = "DoraTaverna01"
    }
    {
      Id = "Dora_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Para dewa pun akan gemetar ketakutan, sesuatu yang takkan pernah bisa dipahami oleh kesadaran rapuhmu!"
      Speaker = "Dora"
      Event = "DoraTaverna01"
    }
    {
      Id = "Dora_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Baiklah, jadi Ambrosia tidak seburuk itu. Aku harus pergi istirahat, tapi... tadi itu seru."
      Speaker = "Dora"
      Event = "DoraTaverna01"
    }
    {
      Id = "Melinoe_3731"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lakukanlah, Dora."
      Speaker = "Melinoe"
      Event = "DoraTaverna01"
    }
    {
      Id = "Dora_0515"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan pergi ke tempat ramai bersama sembarang orang, tapi kalau bersamamu, Mel? Boleh saja."
      Speaker = "Dora"
      Event = "DoraTavernaRepeatable01[1]"
    }
    {
      Id = "Dora_0518"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah apa yang membuat malam ini pantas dirayakan dengan sebotol Ambrosia, tapi hei, kalau kau memaksa!"
      Speaker = "Dora"
      Event = "DoraTavernaRepeatable01[1]"
    }
    {
      Id = "Dora_0521"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Berani-beraninya kau menuntut hal seperti itu dariku, penyihir? {#Prev}Tapi boleh deh, ayo berangkat, kenapa tidak."
      Speaker = "Dora"
      Event = "DoraTavernaRepeatable01[1]"
    }
    {
      Id = "Dora_0516"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dulu aku tak pernah mengira bakal cocok bergaul di sekitar sini. Tapi lihatlah tempat ini... sepertinya aku sangat cocok di sini."
      Speaker = "Dora"
      Event = "DoraTavernaRepeatable01[2]"
    }
    {
      Id = "Dora_0519"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}...Tuangkan persembahanmu untukku, penyihir, dan aku akan memutuskan apakah akan menerimanya atau mengutukmu ke dalam seribu kematian yang menyakitkan!"
      Speaker = "Dora"
      Event = "DoraTavernaRepeatable01[2]"
    }
    {
      Id = "Dora_0522"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Banyak arwah dari berbagai tempat di sini. Jangan berani-berani mengenalkanku pada mereka, ya. Aku suka terkesan misterius begini!"
      Speaker = "Dora"
      Event = "DoraTavernaRepeatable01[2]"
    }
    {
      Id = "Dora_0517"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Cukup sudah berada di keramaian untuk sementara waktu, terima kasih! Tapi tadi menyenangkan kok."
      Speaker = "Dora"
      Event = "DoraTavernaRepeatable01[3]"
    }
    {
      Id = "Dora_0520"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Makasih ya, Mel! Ngeri juga kalau dipikir-pikir, ternyata aku mulai agak menyukai kedai itu..."
      Speaker = "Dora"
      Event = "DoraTavernaRepeatable01[3]"
    }
    {
      Id = "Dora_0523"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Yah, ternyata tidak seburuk yang kubayangkan, dan dari awal aku bahkan tak mengira bakal seburuk itu!"
      Speaker = "Dora"
      Event = "DoraTavernaRepeatable01[3]"
    }
    {
      Id = "Dora_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kayaknya tadi rasanya agak beda dibanding cuma berdiam di tenda lama..."
      Speaker = "Dora"
      Event = "DoraTavernaRepeatable01[3]"
    }
    {
      Id = "Melinoe_1154"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau di sana, Dora...?"
      Speaker = "Melinoe"
      Event = "NPC_Dora_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_1155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dora pasti sedang sembunyi sebentar."
      Speaker = "Melinoe"
      Event = "NPC_Dora_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Dora_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, hentikan."
      Speaker = "Dora"
      Event = "NPC_Dora_01.OnHitVoiceLines"
    }
    {
      Id = "Dora_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah! {#Prev}Gak mempan."
      Speaker = "Dora"
      Event = "NPC_Dora_01.OnHitVoiceLines"
    }
    {
      Id = "Dora_0150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Agak geli, sih."
      Speaker = "Dora"
      Event = "NPC_Dora_01.OnHitVoiceLines"
    }
    {
      Id = "Dora_0151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sori, aku gak bisa mati."
      Speaker = "Dora"
      Event = "NPC_Dora_01.OnHitVoiceLines"
    }
    {
      Id = "Dora_0153"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Serius nih?"
      Speaker = "Dora"
      Event = "NPC_Dora_01.OnHitVoiceLines"
    }
    {
      Id = "Melinoe_0442"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buatku? Terima kasih, Dora!"
      Speaker = "Melinoe"
      Event = "NPC_Dora_01.GiftGivenVoiceLines"
    }
    {
      Id = "Dora_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dor!!"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gimana kabarnya?"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0146"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Emm..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0147"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, jadi gini..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Siapa yang berani-beraninya?"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Berlututlah di hadapanku!"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mendekatlah, wahai penyihir!"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kau telah kembali."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, hai..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0533"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku benci banget di luar sini!"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0535"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat deh barang sebanyak ini..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0537"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ngapain juga aku di sini..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0539"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku kangen tenda kita."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0541"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Butuh sesuatu?"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0546"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tempat ini aneh banget."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0538"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamatkan aku, Mel."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0542"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Batinku lagi menjerit nih."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0540"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makin ramai aja..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0534"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Banyak Arwah berkeliaran..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0536"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cukup sampai sini aja aku melangkah."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0543"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuh ada sang {#Emph}Komandan..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0544"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan pergi dulu."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0545"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau {#Emph}bisa {#Prev}pergi begitu saja, lho..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0547"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Boleh pulang gak?"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
    {
      Id = "Dora_0229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lama amat sih."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.DoraSummonedVoiceLines"
    }
