{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _LootData_Hera.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "MelinoeField_1749"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lambang sang Ratu..."
      Speaker = "Melinoe"
      Event = "HeraUpgrade.FirstSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1472"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu dia."
      Speaker = "Melinoe"
      Event = "HeraUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1473"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ratu Hera..."
      Speaker = "Melinoe"
      Event = "HeraUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_3123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ratu Hera...!"
      Speaker = "Melinoe"
      Event = "HeraUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Hera_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah! {#Prev}Lihat, Sayang! Ini suamiku tercinta. Sang {#Emph}Raja Para Olympian{#Prev} yang terhormat, yang akan menuntun kita semua keluar dari kekacauan ini. Bagaimana perkembangannya, Putra Chronos, ada kabar terbaru?"
      Speaker = "Hera"
      Event = "HeraWithZeus01"
    }
    {
      Id = "Zeus_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}hahaha! {#Prev}Sudahlah, Hera sayang, semua leluconmu itu bisa menimbulkan salah paham bagi orang yang belum terbiasa dengan kecerdasan dan humor ketusmu! Kau lihat itu, Melinoë? Rasa humor adalah ikatan yang memperkokoh pernikahan!"
      Speaker = "Zeus"
      Event = "HeraWithZeus01"
    }
    {
      Id = "Hera_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Persatuan keluarga kita tidak didapat dengan cuma-cuma. Kita semua harus bekerja sama memastikan ikatan yang menyatukan kita tidak merenggang, atau terputus sama sekali seperti halnya Chronos. Paduka Suamiku tahu betul hal ini dibanding siapa pun, bukan begitu, Zeus?"
      Speaker = "Hera"
      Event = "HeraWithZeus02"
    }
    {
      Id = "Zeus_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar sekali, Sayang, pernikahan memang bisa terasa seperti beban pekerjaan! Dulu begitu mudah bagi kita di masa-masa awal, tapi tanggung jawab kita kian bertambah sejak saat itu, bukan?"
      Speaker = "Zeus"
      Event = "HeraWithZeus02"
    }
    {
      Id = "Hera_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali kau tak pernah mengenal ayahmu, Gadis Kecil... tapi setidaknya sekarang kau mengenal saudaranya yang baik, Poseidon, di sini! Bayangkan dia ini, tapi tanpa cengiran konyol, tanpa ucapan tak pantas, dan sejujurnya dengan rambut yang lebih bagus serta bentuk fisik yang lebih menawan."
      Speaker = "Hera"
      Event = "HeraWithPoseidon01"
    }
    {
      Id = "Poseidon_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah, hahaha! {#Prev}Lihat betapa kokohnya keluarga kita, Keponakanku?! Bahkan saat menghadapi malapetaka hebat yang menimpa kita semua, sang Ratu sendiri masih sempat melontarkan lelucon jenaka! Mengorbankan diriku pula. Tapi {#Emph}tetap saja!"
      Speaker = "Poseidon"
      Event = "HeraWithPoseidon01"
    }
    {
      Id = "Hera_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengkhawatirkan generasi muda. Apa yang bisa kalian capai jika terlahir dengan mewarisi sifat-sifat terburuk kami dan bukan sifat-sifat terbaik kami saja? Coba lihat Apollo yang baik ini... persis seperti ayahnya."
      Speaker = "Hera"
      Event = "HeraWithApollo01"
    }
    {
      Id = "Apollo_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Ibu Tiri, bukankah kita semua para dewa bercita-cita menyamai keagungan suamimu? Aku sangat menghargai perbandingan manis itu! Sepupuku yang jelita ini pun pastinya mewarisi sifat-sifat terbaik dari ayahnya!"
      Speaker = "Apollo"
      Event = "HeraWithApollo01"
    }
    {
      Id = "Hera_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagaimana ayahmu adalah penjaga seluruh orang mati, kita pun bertanggung jawab atas seisi dunia! Waktu kian menggelap, memang, tapi... kita punya kekuatan untuk {#Emph}memulihkan{#Prev}. Puji syukur kepada saudariku yang baik, Demeter..."
      Speaker = "Hera"
      Event = "HeraWithDemeter01"
    }
    {
      Id = "Demeter_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu untuk pemulihan akan selalu datang bagaikan musim semi. Namun kita sedang berada di tengah musim dingin yang panjang, tanpa akhir yang pasti. Tak ada hal lain yang perlu kita risaukan, wahai Ratu."
      Speaker = "Demeter"
      Event = "HeraWithDemeter01"
    }
    {
      Id = "Hera_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan para Titan dan dewa pun adalah makhluk yang cukup rapuh, jauh di lubuk hatinya. Karena kita semua digerakkan oleh instrumen yang teramat peka, yang begitu mudah mengobarkan semangat atau menjerumuskan kita ke dalam keputusasaan, sebagaimana yang sangat dipahami oleh Aphrodite tersayang."
      Speaker = "Hera"
      Event = "HeraWithAphrodite01"
    }
    {
      Id = "Aphrodite_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Ratuku! Hati adalah bagian terkuat yang kita punya dan lebih tangguh daripada kelihatannya! Kita telah bertahan melalui banyak hal di puncak gunung ini, tapi kita masih bisa menahan jauh lebih banyak lagi. Terutama saat hati kita {#Emph}semua {#Prev}berdetak menjadi satu!"
      Speaker = "Aphrodite"
      Event = "HeraWithAphrodite01"
    }
    {
      Id = "Hera_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu betul kita tak bisa terlalu terpaku pada tata krama saat seluruh tatanan hidup kita terancam! Namun tentunya putraku tersayang, Hephaestus, tak perlu bersikap begitu {#Emph}kasar {#Prev}di setiap kesempatan, bukan?"
      Speaker = "Hera"
      Event = "HeraWithHephaestus01"
    }
    {
      Id = "Hephaestus_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu juga tak pernah mengajariku sopan santun yang benar, Ibu. Untungnya, aku belajar beberapa hal meski tanpa panutan seperti Ibu atau Ayah untuk meluruskanku! {#Emph}Lihat {#Prev}saja nanti. Dan kau juga, Penyihir Cilik!"
      Speaker = "Hephaestus"
      Event = "HeraWithHephaestus01"
    }
    {
      Id = "Hera_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, {#Emph}ini {#Prev}perkembangan yang luar biasa, Sayang! Hephaestus akhirnya keluar, meski sebentar, dari ruang tempanya. Aku meminta putraku menyapa sepupunya dengan baik, tapi tak kusangka dia benar-benar melakukannya."
      Speaker = "Hera"
      Event = "HeraWithHephaestus02"
    }
    {
      Id = "Hephaestus_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah, {#Prev}ayolah, Ibu, Ibu memang tak pernah mengira aku bakal melakukan apa pun. Aku tahu yang terbaik dariku tak selalu cukup memuaskan, tapi lagipula, siapa yang bisa? Sekarang, bolehkah aku kembali bekerja?"
      Speaker = "Hephaestus"
      Event = "HeraWithHephaestus02"
    }
    {
      Id = "Hera_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami para dewi terkadang terlalu angkuh untuk memohon bantuan! Aku sendiri tak akan pernah sudi merendahkan diri seperti itu. Untuk apa repot-repot, kalau saudariku yang keras kepala, Hestia, pasti akan memaksakan diri untuk campur tangan? Dan bahkan tepat pada saat ini {#Emph}selagi aku berbicara!"
      Speaker = "Hera"
      Event = "HeraWithHestia01"
    }
    {
      Id = "Hestia_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena, dengan segala hormat, kau itu memang tak tahu apa yang {#Emph}terbaik {#Prev}untukmu, wahai Ratu! Terkadang mereka yang tak sanggup meminta tolonglah yang {#Emph}paling {#Prev}membutuhkannya! Sekarang, bagaimana kalau kita beri teladan yang {#Emph}pantas {#Prev}untuk anggota terbaru keluarga kita yang hadir tanpa basa-basi ini?"
      Speaker = "Hestia"
      Event = "HeraWithHestia01"
    }
    {
      Id = "Hera_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya Paduka Ares sudah kembali ke tempat di mana {#Emph}lebih mudah {#Prev}bagiku untuk {#Emph}mengawasinya{#Prev}. Kemarilah, Putraku, mari kita buat diri kita terlihat sedikit pantas. Demi keponakanku di sana."
      Speaker = "Hera"
      Event = "HeraWithAres01"
    }
    {
      Id = "Ares_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan terlaksana sesuai kehendakmu, wahai Ratu. Suatu kehormatan bagiku karena engkau mencariku, dan aku yakin kerabat kita akan sangat berterima kasih kepadamu pada gilirannya, sebagai wadah dari seluruh puncak murka kita."
      Speaker = "Ares"
      Event = "HeraWithAres01"
    }
    {
      Id = "Melinoe_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga ini bersatu demi perjuangan kita... {#Emph}Atas nama Hades! Olympus, kuterima pesan ini!{#Prev}"
      Speaker = "Melinoe"
      Event = "HeraFirstPickUp"
    }
    {
      Id = "Hera_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang akhirnya bisa berkenalan denganmu, Sayang! Sudah muak dengan dunia permukaan, ya? {#Emph}Heh{#Prev}, yah, aku sudah berjanji pada keluarga bahwa begitu kau menunjukkan tekadmu kepada kami, aku akan melindungimu di bawah naunganku. Dan aku {#Emph}selalu {#Prev}menepati sumpahku."
      Speaker = "Hera"
      Event = "HeraFirstPickUp"
    }
    {
      Id = "Hera_0080_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang akhirnya bisa berkenalan denganmu, Sayang! Selamat datang di dunia permukaan kami, apa adanya begini. Aku sudah berjanji pada keluarga bahwa begitu kau menunjukkan tekadmu kepada kami, maka aku akan melindungimu di bawah naunganku... dan, aku {#Emph}selalu {#Prev}menepati sumpahku."
      Speaker = "Hera"
      Event = "HeraFirstPickUpAlt"
    }
    {
      Id = "Hera_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, itu dia! Sudah muak dengan dunia permukaan, ya? {#Emph}Heh{#Prev}, yah, aku sudah berjanji pada keluarga bahwa begitu kau menunjukkan tekadmu kepada kami, aku akan melindungimu di bawah naunganku. Dan aku {#Emph}selalu {#Prev}menepati sumpahku."
      Speaker = "Hera"
      Event = "HeraFirstPickUpPostPalace"
    }
    {
      Id = "Hera_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, itu kau, Sayang! Selamat datang di dunia permukaan kami, apa adanya begini. Aku sudah berjanji pada keluarga bahwa begitu kau menunjukkan tekadmu kepada kami, maka aku akan melindungimu di bawah naunganku... dan, aku {#Emph}selalu {#Prev}menepati sumpahku."
      Speaker = "Hera"
      Event = "HeraFirstPickUpPostPalaceAlt"
    }
    {
      Id = "Hera_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Keadaanmu kacau-balau dan mengenaskan, maaf saja jika aku mengatakannya secara terang-terangan, Gadis Muda! Aku tak bisa membantumu jika kau sudah nyaris mati begini! Setidaknya, tak banyak yang bisa kulakukan."
      Speaker = "Hera"
      Event = "HeraLowHealth01"
    }
    {
      Id = "Hera_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang terjadi dengan seluruh darah kehidupanmu? Itu hal yang sangat berharga! Namun kau malah menumpahkannya ke mana-mana, lalu punya {#Emph}keberanian {#Prev}untuk menampakkan diri di hadapanku dalam keadaan begini."
      Speaker = "Hera"
      Event = "HeraLowHealth02"
    }
    {
      Id = "Hera_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebanyak apa pun latihanmu, rupanya itu {#Emph}masih jauh {#Prev}dari kata cukup, kalau kau {#Emph}sudah {#Prev}babak belur {#Emph}dihajar {#Prev}bahkan sebelum aku sempat mulai melindungimu!"
      Speaker = "Hera"
      Event = "HeraLowHealth03"
    }
    {
      Id = "Hera_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malammu tidak berjalan mulus...? Luka-lukamu pada akhirnya akan sembuh, Sayang. Tapi, aku tak bisa menjamin hal yang sama untuk harga dirimu."
      Speaker = "Hera"
      Event = "HeraLowHealth04"
    }
    {
      Id = "Hera_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap malam memberi kita sebuah awal yang baru, bukankah begitu, Sayang? Dan pada malam {#Emph}ini{#Prev}, {#Emph}aku {#Prev}akan menemanimu dari awal mula... hingga akhir yang pahit."
      Speaker = "Hera"
      Event = "HeraRunStart01"
    }
    {
      Id = "Hera_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dunia Bawahmu telah lama runtuh, tapi Olympus kami masih berdiri tegak; tindakan bijak bagimu untuk menuju ke sini, tempat kau bisa membawa perubahan yang {#Emph}nyata{#Prev}, di sini dan saat ini. Sebagaimana yang akan {#Emph}kulakukan {#Prev}sebentar lagi!"
      Speaker = "Hera"
      Event = "HeraRunStartSurface01"
    }
    {
      Id = "Hera_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seorang petarung tangguh yang menyerang musuh kita dari sisi sayap mereka yang terbuka mungkin adalah {#Emph}satu-satunya {#Prev}hal yang kita butuhkan untuk memukul mundur mereka. Tampaknya {#Emph}kaulah {#Prev}yang siap mengemban tugas itu malam ini!"
      Speaker = "Hera"
      Event = "HeraRunStartSurface02"
    }
    {
      Id = "Hera_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suamiku Zeus dan aku kerap berdebat {#Emph}sengit {#Prev}mengenai bagaimana kau dapat memastikan kemenangan kita. Dia terlalu angkuh untuk memohon bantuanmu di puncak gunung ini, sementara aku menyambutnya dengan tangan terbuka, jadi... mendekatlah!"
      Speaker = "Hera"
      Event = "HeraAboutRouteChoice01"
    }
    {
      Id = "Hera_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjalananmu menuruni Dunia Bawah baru saja dimulai, tapi aku ingin menyertaimu sejak langkah pertama. Percayalah, aku jauh lebih memilih ini daripada semua kewajibanku yang lain digabung jadi satu!"
      Speaker = "Hera"
      Event = "HeraRunStartUnderworld01"
    }
    {
      Id = "Hera_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, gadis pintar, akhirnya kau mengalihkan perhatianmu ke Dunia Bawah! Sungguh memalukan semua yang telah menimpa kita di sini. Paling tidak kita bisa membereskan kekacauan kita sendiri."
      Speaker = "Hera"
      Event = "HeraAboutSwitchToUnderworld01"
    }
    {
      Id = "Hera_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah! {#Prev}Kau di sana {#Emph}lagi{#Prev}, Sayangku! Sayang sekali kita hanya bisa bertemu dalam keadaan seperti ini. Namun setiap keluarga pasti mengalami pasang surut, bukan? Biarkan kubantu dirimu agar kau bisa membantu kita semua."
      Speaker = "Hera"
      Event = "HeraAboutMeeting01"
    }
    {
      Id = "Hera_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sejujurnya, Gadis, aku tidak tahu apakah kau punya kemampuan yang cukup untuk menggagalkan sang Titan. Tapi, apa lagi pilihan kita saat ini? Aku bersedia memberimu kesempatan untuk membuktikannya."
      Speaker = "Hera"
      Event = "HeraAboutMission01"
    }
    {
      Id = "Hera_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, ayahmu yang malang. Kau pasti pernah menjadi permata terindah di matanya, hanya untuk direnggut begitu saja! Dia pasti akan sangat bangga. Yah, mungkin bukan {#Emph}bangga {#Prev}dalam arti sebenarnya. Dia tidak pernah pandai merasa bangga akan apa pun, kalau kupikir-pikir lagi. Setidaknya, {#Emph}aku {#Prev}bangga padamu!"
      Speaker = "Hera"
      Event = "HeraAboutHades01"
    }
    {
      Id = "Hera_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini bukan pertama kalinya aku didesak untuk campur tangan demi pihak keluargamu {#Emph}itu{#Prev}. Aku tetap bergeming! Kita tidak boleh terus mencampuri urusan satu sama lain. Namun, jika kau datang demi membela kami, kau pantas mendapat pengecualian..."
      Speaker = "Hera"
      Event = "HeraAboutFamily01"
    }
    {
      Id = "Hera_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melihat bagaimana kami tidak selalu rukun, tapi begitu kau tinggal bersama gerombolan ini cukup lama, kau akan terbiasa. Menahan sabar itu butuh latihan! Namun bagaimanapun juga, kami saling menyayangi..."
      Speaker = "Hera"
      Event = "HeraAboutFamily02"
    }
    {
      Id = "Hera_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, berkat yang kulimpahkan bersama kerabatku, yah... rasanya mirip seperti anak-anak. Kau tak selalu mendapatkan jenis yang kau inginkan, tapi jika kau cerdik, kau bisa membuatnya berguna!"
      Speaker = "Hera"
      Event = "HeraAboutChildren01"
    }
    {
      Id = "Hera_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu menginginkan seorang anak perempuan, kau tahu? Tapi aku malah mendapatkan Ares. Hephaestus. {#Emph}Cih! {#Prev}Putri-putri Zeus, Athena dan Artemis, menjaga jarak dariku, dan Aphrodite, oh, dia berbuat sesuka hatinya. Benar-benar keluarga yang luar biasa."
      Speaker = "Hera"
      Event = "HeraAboutChildren02"
    }
    {
      Id = "Hera_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga besar kita yang luar biasa ini, yah, ukurannya mungkin hanya tinggal secuil saja kalau bukan karena ulah nakal suamiku! Begitu banyak anak-anak yang menyenangkan dalam hidupku karenanya."
      Speaker = "Hera"
      Event = "HeraAboutChildren03"
    }
    {
      Id = "Hera_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernahkah kau berpikir untuk memiliki anak sendiri, Sayangku? Jika iya, mungkin kau akan berpikir dua kali setelah semua kekacauan {#Emph}ini. {#Prev}Namun kita akan membutuhkan generasi penerus segera! Dan sebaiknya itu berasal dari garis keturunan yang bermutu."
      Speaker = "Hera"
      Event = "HeraAboutChildren04"
    }
    {
      Id = "Hera_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Carilah pasangan yang tahu cara memujimu dengan pantas, Gadis! Paduka Suamiku, yah, dia terkadang memanggilku {#Emph}Nyonya Hera yang bermata sapi{#Prev}! Katanya aku punya mata yang besar dan indah bak {#Emph}hewan ternak{#Prev}, betapa romantisnya dia!"
      Speaker = "Hera"
      Event = "HeraAboutCompliments01"
    }
    {
      Id = "Hera_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku tak pernah mengenakan gaun yang sama selama dua malam berturut-turut, apalagi selama ini. Tapi sekarang kita tak punya waktu untuk kemegahan semacam itu. Aku rindu busana-busana itu, yang berkilauan bak bintang! {#Emph}Hera si Lengan Putih{#Prev}, begitulah julukanku sejak hari pernikahanku... "
      Speaker = "Hera"
      Event = "HeraAboutCompliments02"
    }
    {
      Id = "Hera_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu hal yang kupelajari, Sayangku, adalah bahwa {#Emph}keabadian {#Prev}itu waktu yang amat sangat panjang. Bagiku, sepertinya tak ada lagi yang {#Emph}benar-benar {#Prev}abadi sekarang. Barangkali itulah alasan kita terjerumus ke dalam kesulitan ini."
      Speaker = "Hera"
      Event = "HeraAboutEternity01"
    }
    {
      Id = "Hera_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu kami punya kewajiban terhadap ayahmu di sini. Bagaimanapun juga, setiap kematian fana menambah populasi Dunia Bawah! Aku sudah berusaha melakukan bagianku yang terkutuk ini untuk membendung arusnya sedikit. Tahukah kau betapa merepotkannya proses melahirkan bagi kaum fana?"
      Speaker = "Hera"
      Event = "HeraAboutMortals01"
    }
    {
      Id = "Hera_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau pernah bertanya-tanya dari mana datangnya semua {#Emph}jiwa malang {#Prev}di Dunia Bawahmu, ada kaum fana yang menganggap sudah menjadi kewajiban {#Emph}kami {#Prev}untuk melindungi {#Emph}mereka! {#Prev}Bisa kau percaya itu?"
      Speaker = "Hera"
      Event = "HeraAboutMortals02"
    }
    {
      Id = "Hera_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak sepenuhnya menyalahkan mereka, tapi {#Emph}beberapa {#Prev}kaum fana mulai skeptis terhadap pemerintahan kita. Mereka punya gagasan baru yang aneh tentang {#Emph}keberuntungan... {#Prev}keberkahan nasib yang muncul entah dari mana! Murni kebetulan yang {#Emph}tanpa akal{#Prev}, bukan kehendak para dewa ataupun Tiga Takdir."
      Speaker = "Hera"
      Event = "HeraAboutMortals03"
    }
    {
      Id = "Hera_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, umat fana pasti menganggap kita sekumpulan orang bodoh yang suka bertengkar, meski mereka takkan pernah mengakuinya. Kita harus menjaga gengsi di depan mereka bagaimanapun caranya. Aku akan meminta Demeter memastikan masa-masa kelimpahan pangan akan tiba, dan semacamnya."
      Speaker = "Hera"
      Event = "HeraAboutMortals04"
    }
    {
      Id = "Hera_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingatlah, Gadis, dunia ini adalah milik kita menurut haknya. Para Takdir sendiri yang memutuskannya! Sekarang Chronos berniat menggulingkan takhta kita? Dia sudah pernah mencicipi kesempatannya untuk memerintah. Tak ada jalan kembali ke masa lalu."
      Speaker = "Hera"
      Event = "HeraAboutChronos01"
    }
    {
      Id = "Hera_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan Chronos itu bukan ayahku. Namun ayahmu terlahir darinya, begitu pula suamiku, dan juga Poseidon. Jadi, sekarang kita semua terseret dalam urusan keluarga kecil ini!"
      Speaker = "Hera"
      Event = "HeraAboutChronos02"
    }
    {
      Id = "Hera_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap aku bisa menancapkan sebutir panah lagi tepat di antara kedua mata Chronos dengan tanganku sendiri, tapi sayang, posisimu lebih dekat dan aku terjebak di sini. Bunuh dia untukku, ya?"
      Speaker = "Hera"
      Event = "HeraAboutChronos03"
    }
    {
      Id = "Hera_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masalah dengan Chronos ini, mungkin terdengar tak masuk akal bahwa orang tua bisa membenci anak-anak mereka sendiri. Namun percayalah, Gadis, ada saat-saat di mana aku {#Emph}hampir {#Prev}bisa bersimpati padanya."
      Speaker = "Hera"
      Event = "HeraAboutChronos04"
    }
    {
      Id = "Hera_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu tahu Chronos akan kembali. Zeus terus mengatakan bahwa ketakutanku tak beralasan! Bagaimanapun juga, kita telah mengubur bajingan tua itu di kedalaman Tartarus. Tapi dia adalah Titan abadi. {#Emph}Waktu{#Prev}, tampaknya, lolos dari genggaman kita..."
      Speaker = "Hera"
      Event = "HeraAboutChronos05"
    }
    {
      Id = "Hera_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu Typhon keparat, Gadis! Monster paling mengerikan yang pernah kau bayangkan. Chronos seenaknya membangunkannya dari tidur panjangnya, dan mengarahkannya kepada {#Emph}kita! {#Prev}Lantas kenapa kalau kita tak bisa mati? Keadaan tetap bisa menjadi sangat buruk bagi kita..."
      Speaker = "Hera"
      Event = "HeraAboutTyphon01"
    }
    {
      Id = "Hera_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon tua sempat tersungkur semalam, tapi sudah mulai menggeliat lagi, menurut laporan Hermes. Sasarannya sudah pasti puncak gunung kita... andai saja menggagalkannya semudah memprediksi langkahnya."
      Speaker = "Hera"
      Event = "HeraAboutTyphonW01"
    }
    {
      Id = "Hera_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar membebaskan kami dari Typhon {#Emph}keparat {#Prev}itu. Kami tak pernah menghadapi ancaman sebesar ini sebelumnya, dan {#Emph}satu-satunya {#Prev}hal yang bisa kami lakukan hanyalah menahannya! Sekarang kita memegang kendali lagi berkat {#Emph}dirimu{#Prev}, Sayangku."
      Speaker = "Hera"
      Event = "HeraAboutTyphonDeath01"
    }
    {
      Id = "Hera_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan luar biasa yang kau miliki, Sayangku... apa pun yang kau lakukan pada Typhon, itu rahasia yang harus dijaga rapat-rapat. Kami bisa menyimpannya untukmu! Ruang khazanah kami belum pernah dibobol {#Emph}sekali pun{#Prev}. Pikirkanlah, ya?"
      Speaker = "Hera"
      Event = "HeraAboutTyphonDeath02"
    }
    {
      Id = "Hera_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan kejutan kalau sang Perwujudan Perselisihan mendadak muncul akhir-akhir ini, seperti tabiatnya. Eris pernah mempermainkan kita sebelumnya! Pasti dia mengira kita bodoh dan mangsa yang empuk. Kau akan memberinya pelajaran, kan?"
      Speaker = "Hera"
      Event = "HeraAboutEris01"
    }
    {
      Id = "Hera_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertama Chronos dan sekarang Prometheus kembali menghantui kita, semua karena kita gagal memusnahkan mereka saat ada kesempatan dulu. Siapa lagi selanjutnya, aku penasaran. Kalian para penyihir benar-benar harus menemukan cara untuk melenyapkan makhluk abadi untuk selamanya."
      Speaker = "Hera"
      Event = "HeraAboutPrometheus01"
    }
    {
      Id = "Hera_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Suamiku dan Prometheus hubungannya tidak sedang, katakanlah, akur. Dan Titan itu telah memperjelas pandangannya terhadap kami para dewi dan dewa. Namun, sekarang kita menoleransinya, demi membersihkan kekacauan yang ikut dia ciptakan? Konyol..."
      Speaker = "Hera"
      Event = "HeraAboutPrometheus02"
    }
    {
      Id = "Hera_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Takdir telah tiada, begitu kan? Menurut Hermes? Perubahan situasi yang sangat disayangkan jika itu benar. Yah, jika Chronos bernafsu membalas dendam, masuk akal bila dia melampiaskannya pada {#Emph}mereka{#Prev}, bukan hanya pada {#Emph}kita."
      Speaker = "Hera"
      Event = "HeraAboutFates01"
    }
    {
      Id = "Hera_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus percaya bahwa Chronos {#Emph}benar-benar tidak {#Prev}tahu di mana dia meninggalkan Tiga Takdir? Sang {#Emph}penenun takdir {#Prev}itu sendiri, salah taruh dan terlupakan bagai seonggok {#Emph}pernak-pernik! {#Prev}Mereka mungkin malah {#Emph}menikmati {#Prev}terbebas dari kita semua."
      Speaker = "Hera"
      Event = "HeraAboutFates02"
    }
    {
      Id = "Hera_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sendiri paham sedikit tentang sihir, Gadis. Seni yang terselubung, dan di situlah letak kekuatannya. Mudah untuk disangsikan, atau diabaikan sebagai sekadar kebetulan. Namun kekuatan sejati tak perlu menyombongkan diri."
      Speaker = "Hera"
      Event = "HeraAboutWitchcraft01"
    }
    {
      Id = "Hera_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita mungkin tak menyukainya, tapi selalu diremehkan itu justru punya kekuatan tersendiri. Benar kan, Gadis Kecil? Biarkan mereka berpikir sesukanya; berkahku ini bukan cuma untuk pasangan yang mau mengikat janji suci."
      Speaker = "Hera"
      Event = "HeraAboutReputation01"
    }
    {
      Id = "Hera_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang, Sayangku, di permukaan dunia kita! Pertama kali kemari? Tempat ini begitu luas! Ada berbagai macam iklim, budaya fana, dan semacamnya. Jadi jangan biarkan kesan pertamamu menggoyahkan keyakinanmu; tempat ini tak selalu sehancur ini!"
      Speaker = "Hera"
      Event = "HeraAboutSurface01"
    }
    {
      Id = "Hera_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum fana mengeluh bahwa kota Ephyra mereka telah ditelantarkan para dewa, tapi lihatlah, kami ada di sini! Dasar makhluk-makhluk tak tahu terima kasih. Belakangan ini tak banyak pernikahan. Tak banyak pemakaman juga... meski kematian, kehancuran, dan semacamnya ada di mana-mana!"
      Speaker = "Hera"
      Event = "HeraAboutSurface02"
    }
    {
      Id = "Hera_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada banyak bahan berkekuatan dahsyat yang tumbuh di permukaan ini, asal kau tahu ke mana harus mencari! Hanya akar dan bunga biasa bagi mata yang awam, tapi di tanganmu, atau lebih bagus lagi, di dalam kualimu? Mereka akan membuatmu merapal sihir yang belum pernah ada tandingannya."
      Speaker = "Hera"
      Event = "HeraAboutSurface03"
    }
    {
      Id = "Hera_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak paham {#Emph}kenapa {#Prev}kau terus mengarah kemari, padahal {#Emph}Alam Baka milikmu {#Prev}tampaknya jauh lebih butuh pertolongan. Gunung ini {#Emph}baik-baik saja! {#Prev}Yah, sebagian besar. Selain sisa-sisa pasukan sang Titan yang masih saja mengusik kami..."
      Speaker = "Hera"
      Event = "HeraPostTrueEndingAboutSurface01"
    }
    {
      Id = "Hera_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata mereka kau tak ditakdirkan untuk berada di atas tanah! Kutukan Alam Baka mengikatmu katanya... Sedetik pun aku tak percaya kabar burung itu, dan dugaanku tepat. Mungkin mereka cuma takut pada potensimu."
      Speaker = "Hera"
      Event = "HeraAboutSurfaceSurvival01"
    }
    {
      Id = "Hera_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru-baru ini ada gemuruh di sekitar Olympus yang cukup membuat kami cemas. Maksudku, gemuruh yang {#Emph}nyata! {#Prev}Bahkan Poseidon saja terkejut oleh getarannya. Apa Chronos bermaksud meruntuhkan seluruh gunung ini?"
      Speaker = "Hera"
      Event = "HeraAboutSurfaceThreat01"
    }
    {
      Id = "Hera_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, menghubungimu di dalam kegelapan itu saja sudah sulit bagiku, dan sekarang kau malah tampak semakin jauh. Di pinggiran wilayah ayahmu, ya? Itu... bukan jalur yang lazim menuju Alam Baka...."
      Speaker = "Hera"
      Event = "HeraAboutOceanus01"
    }
    {
      Id = "Hera_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melihat Padang Ratapan di Alam Bakamu, kan? Sebagian besar penghuni di sana bersemayam akibat pernikahan yang gagal... biasanya pernikahan mereka sendiri. Aku memberkati setiap pernikahan semampuku, tapi kekuatanku pun ada batasnya."
      Speaker = "Hera"
      Event = "HeraAboutFields01"
    }
    {
      Id = "Hera_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aphrodite memberitahuku dengan riang gembira bahwa {#Emph}kau {#Prev}dan teman-teman tertentu sudah semakin dekat. Nah, jika satu hal berlanjut ke hal lain dan kau memutuskan untuk berkomitmen serius, aku akan dengan {#Emph}senang hati {#Prev}merestuinya!"
      Speaker = "Hera"
      Event = "HeraAboutRelationships01"
    }
    {
      Id = "Hera_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gadis secantik dirimu pasti punya banyak pemuja! Hanya saja jangan buru-buru menikah jika kau bisa menghindarinya, paham? Kaum fana suka mengikatkan diri seumur hidup tapi nyatanya nyaris tak pernah sanggup. Padahal umur {#Emph}mereka {#Prev}itu seujung kuku saja tidak!"
      Speaker = "Hera"
      Event = "HeraAboutRelationships02"
    }
    {
      Id = "Hera_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sadar ini terdengar aneh datang dari mulutku, Sayangku, tapi dari sesama dewi: Jangan terburu-buru menikah! Betapa pun indahnya gagasan itu. Jadikan aku contoh; dan aku ini sang Dewi Pernikahan itu sendiri, astaga!"
      Speaker = "Hera"
      Event = "HeraAboutMarriage01"
    }
    {
      Id = "Hera_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di balik semua kekurangannya, suamiku adalah lawan yang sangat berbahaya. Kalau bukan karena itu, bagaimana mungkin kami bisa memerintah selama berabad-abad ini? Zeus jelas punya musuh, tapi sedikit sekali yang cukup bernyali—atau cukup bodoh—untuk menunjukkannya secara terang-terangan."
      Speaker = "Hera"
      Event = "HeraAboutZeusMarriage01"
    }
    {
      Id = "Hera_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Zeus dan aku, kami sudah saling mengenal sejak lama sekali. Kami ini pasangan suami istri yang sudah lama bersama! Namun hal-hal buruk sering kali dikatakan tentang kami. Aku berusaha tak memikirkannya! Tak ada pasangan yang luput dari cela; tentu saja, apalagi yang bertahan selama kami."
      Speaker = "Hera"
      Event = "HeraAboutZeusMarriage02"
    }
    {
      Id = "Hera_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudariku Demeter, Hestia, dan aku, ayah kami adalah sang Titan bernama Hyperion. Paling tidak secara teknis dia adalah {#Emph}Ayah{#Prev}. Kau tak lagi banyak mendengar tentang {#Emph}dia {#Prev}sekarang! Seharusnya dulu kita bereskan Chronos dengan cara yang sama selagi ada kesempatan."
      Speaker = "Hera"
      Event = "HeraAboutHyperion01"
    }
    {
      Id = "Hera_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami melihat laporan yang menandakan kau sudah mencapai kedalaman terdalam! Kupikir mungkin kau sudah menang... meski tampaknya belum. Tapi bagaimanapun, itu tanda kemajuan! Teruslah melangkah."
      Speaker = "Hera"
      Event = "HeraUnderworldRunCleared01"
    }
    {
      Id = "Hera_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar di sini menyebutkan kau berhasil mengalahkan bajingan tua itu semalam! Luar biasa jika benar. Seharusnya {#Emph}Waktu itu sendiri {#Prev}tahu kapan harus menyingkir demi generasi muda. Namun jika Chronos butuh diyakinkan lebih keras lagi, ya biarlah."
      Speaker = "Hera"
      Event = "HeraUnderworldRunCleared02"
    }
    {
      Id = "Hera_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa pun memuaskannya memangkas kesombongan Chronos, itu saja belum cukup. Tidak, kau dan Penyihir Simpang Jalan itu pasti sedang meracik rencana yang jauh lebih besar..."
      Speaker = "Hera"
      Event = "HeraUnderworldRunCleared03"
    }
    {
      Id = "Hera_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah berada jauh lebih dekat ke puncak gunung kami dari sebelumnya! Kuharap, barangkali, kita akhirnya bisa bertemu, tapi... ada masalah yang lebih mendesak untuk kita urus sekarang, bagi kita berdua."
      Speaker = "Hera"
      Event = "HeraSurfaceRunCleared01"
    }
    {
      Id = "Hera_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu yang terasa sangat ganjil malam ini; dan menurut pengalamanku, firasat semacam itu {#Emph}tak boleh {#Prev}diabaikan. Barangkali kekuatan aneh yang bekerja ini hanyalah akibat dari rapalan mantramu! Hanya saja... berhati-hatilah, Gadis Kecil."
      Speaker = "Hera"
      Event = "HeraAboutPackageBounty01"
    }
    {
      Id = "Hera_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu ada sesuatu yang sedang terjadi malam ini, tapi aku tak bisa memastikannya. Mungkin itu Penyihir Simpang Jalan yang sedang bermantera demi keuntungan kita bersama. Atau ini hasil perbuatanmu sendiri?"
      Speaker = "Hera"
      Event = "HeraAboutPackageBounty02"
    }
    {
      Id = "Hera_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini membuatku merasa resah, karena banyak dari musuh kita mulai bertindak sangat berani. Kaum fana merasakan ketakutan ketika nyawa mereka terancam, tapi ini tak mungkin perasaan {#Emph}seperti itu!"
      Speaker = "Hera"
      Event = "HeraAboutShrine01"
    }
    {
      Id = "Hera_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hawa mencekam di udara itu, jadi ini benar-benar perbuatanmu, kan, Gadis Kecil? Aku tak habis pikir bagaimana memancing amarah musuh bisa memberi kita {#Emph}keuntungan{#Prev}. Sekarang cepat bereskan mereka!"
      Speaker = "Hera"
      Event = "HeraAboutShrine02"
    }
    {
      Id = "Hera_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam tempo hari, saat diberi kesempatan, kau malah berpihak pada kerabatku, menolak Berkahku saat aku menawarkannya dengan murah hati. Meski perselisihan kecil itu sudah berlalu, aku {#Emph}sama sekali tak suka {#Prev}dilecehkan seperti itu. Kuharap perkataanku ini cukup jelas bagimu?"
      Speaker = "Hera"
      Event = "HeraAboutDevotionTest01"
    }
    {
      Id = "Hera_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana perkembangan tugasmu belakangan ini, Sayangku? Kuharap jauh lebih baik daripada keadaan kami di sini. Oh, kami semua baik-baik saja, hanya saja... dikepung begini membuat kami terjebak berdesakan lebih dekat dari yang kusukai. Tak ada ketenangan barang sesaat pun!"
      Speaker = "Hera"
      Event = "HeraPostGift01"
    }
    {
      Id = "Hera_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengarkan nasihatku, Sayangku, jangan dengarkan kata hatimu. Aku tahu itu sulit, mengingat benda sialan itu suaranya cenderung sangat berisik. Tapi jika kau menuruti bisikannya, lebih sering daripada tidak, itu akan membawamu lurus menuju kesalahan terbesarmu."
      Speaker = "Hera"
      Event = "HeraPostGift02"
    }
    {
      Id = "Hera_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita melepaskan diri dari kemandekan ini, Gadis Kecil, nah ambillah ini! Ini yang terbaik yang bisa kuberikan padamu untuk saat ini. Manfaatkan sebaik-baiknya, ya?"
      Speaker = "Hera"
      Event = "HeraLegendaryPickUp01"
    }
    {
      Id = "Hera_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suasana hatiku memburuk lagi, Sayangku, meski kurasa itu membuatku jadi agak dermawan. Nah, kalau begitu! Berkah terbaik dariku. Majulah, dan jalin ikatan maut itu!"
      Speaker = "Hera"
      Event = "HeraLegendaryPickUp02"
    }
    {
      Id = "Hera_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir Simpang Jalan jelas mendidikmu dengan baik! Generasi muda di sini benar-benar kurang berkarakter, dan sopan santun mereka sering kali {#Emph}sangat {#Prev}mengecewakan. Seolah-olah generasiku {#Emph}ini {#Prev}tidak memberikan teladan yang baik saja!"
      Speaker = "Hera"
      Event = "HeraAboutHecate01"
    }
    {
      Id = "Hera_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar sampai padaku bahwa kau bertemu dengan Heracles yang perkasa! Pria bertubuh besar dan berotak tumpul itu? Jangan bantu dia dalam tugas-tugasnya, kau paham? Dia sedang berada di tengah-tengah apa yang kami, kaum Olympus, sebut sebagai {#Emph}perjalanan pencarian jati diri."
      Speaker = "Hera"
      Event = "HeraAboutHeracles01"
    }
    {
      Id = "Hera_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kan, Heracles itu anak Zeus. {#Emph}Kemuliaan Hera! {#Prev}Harusnya aku merasa terhormat. Bagiku dia cuma satu mulut lagi yang harus kuberi makan, dan nafsu makannya luar biasa besar. Tapi, aku akan membuatnya tetap sibuk, tentu saja! Kita butuh semua bantuan yang bisa kita dapatkan."
      Speaker = "Hera"
      Event = "HeraAboutHeracles02"
    }
    {
      Id = "Hera_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau akan memberitahu kami jika Heracles tak memenuhi harapan, kan? Rahasia di antara kita saja, kami sedang berpikir setelah semua kekacauan ini mereda, kami mungkin akan mengajaknya bergabung secara permanen. Dia sudah cukup bekerja keras, dan kita butuh ototnya."
      Speaker = "Hera"
      Event = "HeraAboutHeracles03"
    }
    {
      Id = "Hera_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah berhadapan dengan Polyphemus, ya? Memang begitulah jenis {#Emph}bantuan {#Prev}yang dipekerjakan Chronos. Si pandir yang hampa! Tapi harus diakui, dia kuat. Tak ada cara menyelinap melewatinya{#Prev}, sayangnya. Kami sudah pernah mencoba...."
      Speaker = "Hera"
      Event = "HeraAboutPolyphemus01"
    }
    {
      Id = "Hera_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah! {#Prev}Kulihat suamiku yang terhormat sudah menghubungimu lebih dulu. Nah, untuk berjaga-jaga seandainya dia tak memercikkan kilatan api dengan cara yang {#Emph}benar-benar {#Prev}kau harapkan, aku punya sesuatu milikku sendiri untukmu."
      Speaker = "Hera"
      Event = "HeraAboutZeus01"
    }
    {
      Id = "Hera_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi-lagi Lord Zeus mendahuluiku menemuimu, ya? {#Emph}Heh. {#Prev}Putra Chronos yang agung beserta kecepatan kilatnya! Kau takkan bisa membayangkan seberapa cepat dia melarikan diri dari {#Emph}hadapanku{#Prev}, kadang-kadang."
      Speaker = "Hera"
      Event = "HeraAboutZeus02"
    }
    {
      Id = "Hera_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalaulah aku tahu Poseidon yang sok jagoan itu repot-repot membantumu tadi, tentu aku sudah tiba lebih cepat. Lautan itu tak bisa diandalkan, sedangkan ikatan denganku abadi selamanya. Paling tidak, secara kiasan!"
      Speaker = "Hera"
      Event = "HeraAboutPoseidon01"
    }
    {
      Id = "Hera_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pembalasan dendam yang dingin... bisa kurasakan dari kejauhan. Kurasa saudariku, Demeter, menanggung taruhan yang jauh lebih besar dibanding siapa pun di puncak gunung ini. Musuh-musuh kita akan menyesal seumur hidup karena telah mengusiknya."
      Speaker = "Hera"
      Event = "HeraAboutDemeter01"
    }
    {
      Id = "Hera_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apollo si Emas rupanya sudah mengulurkan bantuannya padamu, ya? Selalu saja bernafsu cari muka. Sikapnya yang sok memanjakan itu sangat menjengkelkan bagiku... tapi tentu saja kau jauh lebih penyabar dibanding aku."
      Speaker = "Hera"
      Event = "HeraAboutApollo01"
    }
    {
      Id = "Hera_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang dewi cinta, selalu saja selangkah lebih maju dariku. Menurutmu, berapa banyak makhluk fana yang sudi mencariku demi memberkati janji suci mereka, jika Aphrodite belum menebarkan {#Emph}pesonanya {#Prev}pada mereka? Tampaknya kekuatan kita saling melengkapi."
      Speaker = "Hera"
      Event = "HeraAboutAphrodite01"
    }
    {
      Id = "Hera_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, setidaknya Hephaestus {#Emph}berusaha {#Prev}menjadi berguna! Maklumi saja putraku yang kuper itu, gadis manis. Dia jauh lebih suka memukul-mukul tempaannya tanpa henti daripada berbaur dalam tata krama sosial."
      Speaker = "Hera"
      Event = "HeraAboutHephaestus01"
    }
    {
      Id = "Hera_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putraku yang pendiam, Hephaestus, menganggapku bisa bersikap {#Emph}terlalu kejam. {#Prev}Mungkin dia benar! Memangnya kau pikir ibuku dulu menghujani {#Emph}aku {#Prev}dengan cinta? Begitu pula ibumu {#Emph}kepadamu{#Prev}. Dunia ini kejam, Nak. Tak ada seorang pun yang minta dilahirkan ke dalamnya."
      Speaker = "Hera"
      Event = "HeraAboutHephaestus02"
    }
    {
      Id = "Hera_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang melihatmu bisa akrab dengan Hestia, Sayang. Perangainya dan perangaiku jarang sekali sejalan, tapi aku menghormati kebijaksanaannya, serta kekuatannya untuk membumihanguskan segalanya jika memang diperlukan."
      Speaker = "Hera"
      Event = "HeraAboutHestia01"
    }
    {
      Id = "Hera_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hampir semua dari kita punya selera akan kekerasan, Nak, tapi putraku Ares membawanya ke tingkat yang {#Emph}amat {#Prev}keterlaluan. Dia mungkin berguna di saat-saat genting seperti ini, tapi kita tak boleh membiarkannya kelewat bernafsu."
      Speaker = "Hera"
      Event = "HeraAboutAres01"
    }
    {
      Id = "Hera_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami sudah mengutus Artemis muda ke dekat perbatasan antara alammu dan alam kami. Kami butuh kewaspadaan ekstra di sana, dan kau pun agaknya diuntungkan dengan sedikit tembakan perlindungan. Terkadang aku rindu memegang busur panah sendiri..."
      Speaker = "Hera"
      Event = "HeraAboutArtemis01"
    }
    {
      Id = "Hera_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ke mana perginya si {#Emph}Hermes {#Prev}itu saat sedang dibutuhkan? Kau melihatnya akhir-akhir ini, Nak? Selalu saja {#Emph}keluyuran{#Prev}, mustahil untuk dicari. {#Emph}Hih. {#Prev}Kabar apa lagi sih yang mesti disampaikan di saat genting seperti {#Emph}ini?"
      Speaker = "Hera"
      Event = "HeraAboutHermes01"
    }
    {
      Id = "Hera_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, tadi aku melihat kilatan di langit, seolah-olah cahaya rembulan bergeser sejenak. Namun sekarang cahaya itu seakan memancar dari {#Emph}dirimu. {#Prev}Kau berhasil memanggil Selene turun! Kebanyakan dewa takkan pernah ditanggapi olehnya seperti itu."
      Speaker = "Hera"
      Event = "HeraAboutSelene01"
    }
    {
      Id = "Hera_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami punya Athena yang bijak untuk menahan garis depan, namun kita mungkin butuh puluhan dewa lain yang {#Emph}sama {#Prev}cakapnya. Dia memang berhasil membuat para penjarah Titan lari ketakutan, tapi... bahkan dia pun tak selalu bisa menghadang mereka semua."
      Speaker = "Hera"
      Event = "HeraAboutAthena01"
    }
    {
      Id = "Hera_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan harap ada bantuan dari Dionysus, yang saat ini pasti sedang teler di suatu tempat, kecuali bila bantuan yang kaucari ada di dasar cawan anggur. Namun, kalau dipikir-pikir lagi, itu bukan ide yang buruk belakangan ini..."
      Speaker = "Hera"
      Event = "HeraAboutDionysus01"
    }
    {
      Id = "Hera_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menguasai Kutukan Senja, oh aku bisa merasakannya. Kekuatan untuk mengubah wujud menjadi makhluk lain! Salah satu sihir favoritku, tinggal selangkah lagi menuju kemampuan mengubah wujud diri sendiri. Kemungkinannya sungguh tak terbatas."
      Speaker = "Hera"
      Event = "HeraAboutPolymorph01"
    }
    {
      Id = "Hera_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kau tahu Bunga Malam, tentu saja. Cara praktis membangkitkan orang mati untuk sementara waktu. Sejujurnya jauh lebih mudah daripada membesarkan anak yang masih hidup... dan jelas jauh lebih singkat prosesnya."
      Speaker = "Hera"
      Event = "HeraAboutSummoning01"
    }
    {
      Id = "Hera_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau seorang penyihir. Kau pasti gemar mengutuk orang, benar? Aku pun sudah menimpakan beberapa kutukanku sendiri... satu untuk Nimfa cerewet yang terlalu banyak omong, dan yang lain untuk perbuatan yang jauh lebih keji. Kita harus menegaskan wibawa kita."
      Speaker = "Hera"
      Event = "HeraAboutCurses01"
    }
    {
      Id = "Hera_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya kau mahir menjaga jarak dari musuh-musuhmu. Dulu aku pun sangat piawai dalam hal ini, walau aku lebih menyukai sebutir anak panah yang menembus jantung ketimbang sihir, yang kuanggap agak kurang bisa diandalkan. Tapi yah, pakailah apa pun yang cocok untukmu!"
      Speaker = "Hera"
      Event = "HeraAboutBows01"
    }
    {
      Id = "Hera_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, bukankah ini Kipas Warna-warni milikku, yang bersinar terang bahkan di tengah kegelapan malam! Sangat memudahkan untuk melihat keberadaanmu di mana pun kau berada. Bila kau butuh bantuan segeraku, kibaskan saja kipas itu."
      Speaker = "Hera"
      Event = "HeraAboutKeepsake01"
    }
    {
      Id = "Hera_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kipas Warna-warni yang kuberikan padamu jelas terbukti lebih dari sekadar pemanis penampilan! Firasatku benar bahwa kau akan menyukainya, Sayang. Jangan pernah ragu untuk mengibaskannya jika kau membutuhkanku."
      Speaker = "Hera"
      Event = "HeraAboutKeepsake02"
    }
    {
      Id = "Hera_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu menjadi salah satu harapan terbaik yang kami miliki dalam kemelut ini, Sayang. Namun sejujurnya, tadinya aku ragu kita bisa menang, baik {#Emph}bersamamu {#Prev}maupun tanpa dirimu. Jadi untuk kali ini saja, aku senang telah salah duga, dan aku takkan pernah melupakan semua yang telah kauperbuat."
      Speaker = "Hera"
      Event = "HeraAboutHope01"
    }
    {
      Id = "Hera_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang rasanya akhirnya bisa bertatap muka secara lebih pantas, Sayang! Kau telah memberi gunung kami ini sedikit waktu bernapas, jadi kami memperkuat pertahanan sebaik mungkin... karena itu aku memohon padamu untuk segera kembali ke sini!"
      Speaker = "Hera"
      Event = "HeraAboutPalace01"
    }
    {
      Id = "Hera_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ck{#Prev}, kau bahkan belum sempat melihat Istana kami yang sebenarnya, Sayang. Lagipula keadaannya sedang tak layak dilihat. Mungkin saat Kediaman ayahmu sudah tertata kembali, istana kami pun demikian! Saat itu tiba, aku sangat bersikeras agar kau berkunjung."
      Speaker = "Hera"
      Event = "HeraAboutPalace02"
    }
    {
      Id = "Hera_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihan terakhir itu, yang semestinya kami gunakan untuk melawan Typhon seandainya kau tak menemukan jalan keluar yang lebih terarah... itu hanyalah sesuatu yang digarap Hephaestus setengah hati. Senjata itu bakal memakan bengkel tempa kesayangan putraku, bahkan {#Emph}lebih dari itu!"
      Speaker = "Hera"
      Event = "HeraAboutLastResort01"
    }
    {
      Id = "Hera_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hendak turun ke bawah untuk menjenguk ibu dan ayahmu, Sayang? Kediaman Hades sepertinya butuh sentuhan tanganmu. Andaikan anak-anakku {#Emph}sendiri {#Prev}bisa seperhatian itu. Yah, walau kurasa mereka pun masih membantumu saat ini..."
      Speaker = "Hera"
      Event = "HeraAboutUnderworld01"
    }
    {
      Id = "Hera_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bepergian ke arah sini {#Emph}lagi{#Prev}, ya, Sayang? Pasti demi menguji teori-teori konyol dari kakek Titan-mu itu! Bila kau mencium gelagat dusta sekecil apa pun, beri tahu aku. Sekalipun kita harus berbelaskasih, bukan berarti kita boleh jadi orang bodoh."
      Speaker = "Hera"
      Event = "HeraAboutOlympus01"
    }
    {
      Id = "Hera_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melihat sendiri betapa mengenaskannya kondisi gunung kami yang malang ini. Ciptaan-ciptaan Hephaestus yang memalukan itu merajalela tak karuan, persis seperti musuh-musuh kita! Sebagian dari kami memilih mengurung diri di Istana Zeus demi menghindari semua kegaduhan itu. Setidaknya di sini masih cukup nyaman!"
      Speaker = "Hera"
      Event = "HeraAboutOlympus02"
    }
    {
      Id = "Hera_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Armada yang begitu mengerikan berlayar ke arah kita... terakhir kali aku menyaksikan armada sebesar itu, kapal-kapalnya berlayar demi menghormatiku, bukannya menyerang rumahku."
      Speaker = "Hera"
      Event = "HeraAboutThessaly01"
    }
    {
      Id = "Hera_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luar biasa, Nak. Mengantarkan Chronos yang merangkak tak berdaya langsung ke hadapan kami, setelah menghancurkan Typhon hingga luluh lantak... rentetan mukjizat yang mencengangkan, bahkan untuk dewi dengan garis keturunan sepertimu. Bagaimana mungkin kami bisa membalas budimu?"
      Speaker = "Hera"
      Event = "HeraPostTrueEnding01"
    }
    {
      Id = "Hera_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Tiga Takdir telah ditemukan! Sungguh lega rasanya karena takdir kita kini kembali aman di tangan mereka. Aku sempat khawatir masa depan kita selamanya harus ditentukan oleh tangan kita {#Emph}sendiri{#Prev}. Mungkin nanti saja saat kita sudah lebih tua, dan jauh lebih bertanggung jawab."
      Speaker = "Hera"
      Event = "HeraPostEpilogue01"
    }
    {
      Id = "Hera_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebuah zaman baru akan segera tiba, begitukah {#Emph}adanya{#Prev}? Hanya hal itu yang bisa dijamin oleh Sang Tiga Takdir, tapi selain itu kita bebas berbuat sesuka hati! Baguslah kalau begitu. Jika manusia fana mengira mereka bisa bertahan hidup tanpa campur tangan {#Emph}kita{#Prev}, aku ingin sekali melihat usaha mereka!"
      Speaker = "Hera"
      Event = "HeraPostEpilogue02"
    }
    {
      Id = "Hera_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, ini {#Emph}benar-benar {#Prev}sebuah perjalanan yang panjang, bukan begitu, Sayang? Aku mungkin akan berbicara lebih singkat denganmu mulai sekarang, karena urusan lain semakin mendesak perhatianku. Namun, berkatku akan selalu menyertaimu selama kau membutuhkannya."
      Speaker = "Hera"
      Event = "HeraAboutSayingLittle01"
    }
    {
      Id = "Hera_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebuah berkat untuk{#Emph}mu{#Prev}, dan kutukan bagi musuh-musuh kita, Sayang."
      Speaker = "Hera"
      Event = "HeraChat01"
    }
    {
      Id = "Hera_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aneh sekali bagaimana pertikaian yang mencabik-cabik kita ini justru membuat kita semakin dekat, {#Emph}kan?"
      Speaker = "Hera"
      Event = "HeraChat02"
    }
    {
      Id = "Hera_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos itu orang tua bangka bodoh yang masanya sudah lama berlalu."
      Speaker = "Hera"
      Event = "HeraChat03"
    }
    {
      Id = "Hera_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu salah satu dari berkat-berkatku ini ada yang cocok untukmu, bukan?"
      Speaker = "Hera"
      Event = "HeraChat04"
    }
    {
      Id = "Hera_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan perlihatkan kelemahan, jangan beri ampun, Gadis."
      Speaker = "Hera"
      Event = "HeraChat05"
    }
    {
      Id = "Hera_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba lihat kita berdua, Gadis! Keluarga kita memang kacau balau, tapi kita berhasil melewatinya."
      Speaker = "Hera"
      Event = "HeraChat06"
    }
    {
      Id = "Hera_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hera ada di sini membantumu, Gadis; dan sebentar lagi, semua musuhmu bakal menyesal pernah dilahirkan ke dunia."
      Speaker = "Hera"
      Event = "HeraChat07"
    }
    {
      Id = "Hera_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi Buyutmu telah kembali, Sayang, jadi mari kita buat malam ini jauh lebih menarik."
      Speaker = "Hera"
      Event = "HeraChat08"
    }
    {
      Id = "Hera_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang bisa merekatkan keharmonisan keluarga selain membantai musuh kita bersama-sama, {#Emph}hm?"
      Speaker = "Hera"
      Event = "HeraChat09"
    }
    {
      Id = "Hera_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kejutan, oh kejutan, kau sekali lagi berada persis di tempat yang kuduga."
      Speaker = "Hera"
      Event = "HeraChat10"
    }
    {
      Id = "Hera_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Gadis, mari kulihat kondisimu dan apa yang bisa kita perbuat."
      Speaker = "Hera"
      Event = "HeraChat11"
    }
    {
      Id = "Hera_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Barangkali keluarga kita memang pantas menerima semua ini, meski begitu kita akan tetap melawan habis-habisan."
      Speaker = "Hera"
      Event = "HeraChat12"
    }
    {
      Id = "Hera_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak disangka kita butuh ancaman krisis mematikan hanya demi menyatukan keluarga ini, sekali saja!"
      Speaker = "Hera"
      Event = "HeraChat13"
    }
    {
      Id = "Hera_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tegakkan kepalamu, Gadis! Keadaan bisa saja berakhir jauh lebih buruk dari sekarang."
      Speaker = "Hera"
      Event = "HeraChat14"
    }
    {
      Id = "Hera_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga kita mungkin dikutuk oleh sang Trio Takdir itu sendiri, tapi kita sangat tahu cara bertarung."
      Speaker = "Hera"
      Event = "HeraChat15"
    }
    {
      Id = "Hera_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh kita terlampau banyak, aku tak sanggup mengutuk mereka semua! Tapi aku {#Emph}bisa {#Prev}memberkati {#Emph}dirimu."
      Speaker = "Hera"
      Event = "HeraChat16"
    }
    {
      Id = "Hera_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berminat memiliki secuil kuasa atas kehidupan itu sendiri? Atau kematian. Aku punya keduanya."
      Speaker = "Hera"
      Event = "HeraChat17"
    }
    {
      Id = "Hera_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, aku mulai menikmati perjalanan kecil kita ini."
      Speaker = "Hera"
      Event = "HeraChat18"
    }
    {
      Id = "Hera_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dibesarkan di Dunia Bawah, namun pembawaan dan keanggunanmu jauh melebihi mereka semua yang ada di atas sini."
      Speaker = "Hera"
      Event = "HeraChat19"
    }
    {
      Id = "Hera_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makin hari makin terasa kalau belakangan ini hanya kaulah satu-satunya yang bisa kuandalkan, Gadis."
      Speaker = "Hera"
      Event = "HeraChat20"
    }
    {
      Id = "Hera_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suasana hatiku sedang agak buruk sekarang, jadi lekas pilih, lalu pergilah."
      Speaker = "Hera"
      Event = "HeraChat21"
    }
    {
      Id = "Hera_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tradisi kecil kita ini perlahan menjadi sesuatu yang kunanti-nantikan, Gadis manis."
      Speaker = "Hera"
      Event = "HeraChat22"
    }
    {
      Id = "Hera_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Trio Takdir tak mengaruniakanku anak perempuan, tapi setidaknya mereka menghadirkanmu untukku, Sayang."
      Speaker = "Hera"
      Event = "HeraChat23"
    }
    {
      Id = "Hera_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hidup memang sesekali diselingi masa-masa menyedihkan, agar masa-masa indah terasa lebih bermakna."
      Speaker = "Hera"
      Event = "HeraChat24"
    }
    {
      Id = "Hera_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami di Olympus menanggapi urusan balas dendam dengan sangat pribadi, Gadis."
      Speaker = "Hera"
      Event = "HeraChat25"
    }
    {
      Id = "Hera_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap beberapa orang yang kukenal punya sekelumit saja dari komitmenmu."
      Speaker = "Hera"
      Event = "HeraChat26"
    }
    {
      Id = "Hera_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah menjadi garis nasib kita untuk memikul beban jauh lebih banyak daripada yang semestinya, Gadis."
      Speaker = "Hera"
      Event = "HeraChat27"
    }
    {
      Id = "Hera_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau takkan paham sudah berapa lama sejak terakhir kali aku bisa mengandalkan seseorang dari garis darah kita."
      Speaker = "Hera"
      Event = "HeraChat28"
    }
    {
      Id = "Hera_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh kita telah meremehkan kita, dan kita akan membuatnya menyesali hari kelahirannya, bukan?"
      Speaker = "Hera"
      Event = "HeraChat29"
    }
    {
      Id = "Hera_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan yang bersemayam dalam diriku lebih dari cukup, dengan senang hati kubagi sedikit untukmu saat ini."
      Speaker = "Hera"
      Event = "HeraChat30"
    }
    {
      Id = "Hera_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kharisma bangsawannmu ternyata jauh lebih memancar dari dugaanku..."
      Speaker = "Hera"
      Event = "HeraChat31"
    }
    {
      Id = "Hera_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebentar lagi seluruh perkara ini akan dibereskan, tapi hingga saat itu tiba, kita harus bertahan."
      Speaker = "Hera"
      Event = "HeraChat32"
    }
    {
      Id = "Hera_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melihat kesabaran dan komitmenmu sebesar ini, kurasa kau sudah siap untuk dipinang!"
      Speaker = "Hera"
      Event = "HeraChat33"
    }
    {
      Id = "Hera_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunung kami masih berantakan parah, jika kau tak keberatan membantu sedikit bersih-bersih."
      Speaker = "Hera"
      Event = "HeraChat34"
    }
    {
      Id = "Hera_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Istana untuk saat ini terpaksa ditutup, meski kau tetap dipersilakan berkunjung."
      Speaker = "Hera"
      Event = "HeraChat35"
    }
    {
      Id = "Hera_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami masih belum bisa menjangkau kedalaman Dunia Bawah milikmu, bisakah kau mengawasinya sebentar?"
      Speaker = "Hera"
      Event = "HeraChat36"
    }
    {
      Id = "Hera_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergilah pastikan ayahandamu dan ibundamu tercinta masih dalam keadaan baik-baik saja."
      Speaker = "Hera"
      Event = "HeraChat37"
    }
    {
      Id = "Hera_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari tetap waspada selagi kita berbenah, jangan sampai kita mengulangi kesalahan yang sama."
      Speaker = "Hera"
      Event = "HeraChat38"
    }
    {
      Id = "Hera_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terlepas dari segala pertengkaran keluarga kita, kita tak boleh membiarkannya kacau seperti ini lagi."
      Speaker = "Hera"
      Event = "HeraChat39"
    }
    {
      Id = "Hera_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Majulah kalau begitu, Gadis Muda, dan buat semua musuh kita menyesali hari kelahiran mereka."
      Speaker = "Hera"
      Event = "HeraChat40"
    }
    {
      Id = "Hera_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tak boleh gegabah, Gadis Muda. Misalnya saja, kami {#Emph}tak {#Prev}keberatan berkat kami diangkut layaknya kiriman paket biasa, jika dengan begitu, kemenanganmu dan kemenangan kami terjamin."
      Speaker = "Hera"
      Event = "HeraBlindBox01"
    }
    {
      Id = "Hera_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akui saja, Gadis Muda! Kau pasti akan menerima berkat apa pun di sini sekarang juga, entah dari {#Emph}diriku {#Prev}atau kerabatku yang lain. Ya, berkat takdir dari Sang Moirai, kau justru mendapatkan yang terbaik dari yang terbaik."
      Speaker = "Hera"
      Event = "HeraBlindBox02"
    }
    {
      Id = "Hera_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak disangka berkat Ratu Olympus bisa diambil dari karung sederhana yang kumal! Kerusakan apa pun yang dialami gunung ini, harga diri kitalah yang terluka jauh lebih parah."
      Speaker = "Hera"
      Event = "HeraBlindBox03"
    }
    {
      Id = "Hera_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami punya kemitraan lama dengan tukang perahu andalanmu itu. Aku melahirkan manusia fana ke dunia dan menikahkan mereka beberapa saat kemudian, lalu dia yang membawa mereka ke alam baka kalian! Yah, setidaknya dulu begitu."
      Speaker = "Hera"
      Event = "HeraLootBought01"
    }
    {
      Id = "Hera_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekayaan tak bisa diukur hanya dengan koin belaka! Gagasan itu sungguh konyol; namun, lihat dirimu di sana, membayar barang dan jasa seolah-olah Chronos sudah menang mutlak!"
      Speaker = "Hera"
      Event = "HeraLootBought02"
    }
    {
      Id = "Hera_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami tak selalu bisa menjangkaumu di kedalaman sana, meski tukang perahumu tampaknya tak punya masalah sama sekali. Tak banyak bicara, mandiri mengurus diri sendiri... Aku cukup menyukainya!"
      Speaker = "Hera"
      Event = "HeraLootBought03"
    }
    {
      Id = "Hera_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya pengantaran kali ini lebih dekat bagi tukang perahu tepercaya kalian, dibanding harus menyeret Berkat kami sepanjang jalan ke Dunia Bawah. Walau begitu, dia mungkin memang lebih suka di sana..."
      Speaker = "Hera"
      Event = "HeraLootBought04"
    }
    {
      Id = "Hera_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perlukah kuingatkan padamu bahwa aku sama sekali tak menyukai orang-orang yang berpaling dariku?"
      Speaker = "Hera"
      Event = "HeraRejection01"
    }
    {
      Id = "Hera_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa {#Emph}mengecewakan {#Prev}namun sudah kuduga! Sekarang giliranku."
      Speaker = "Hera"
      Event = "HeraRejection02"
    }
    {
      Id = "Hera_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pikir aku ini siapa? Kau kira aku akan pasrah begitu saja dan menerimanya?"
      Speaker = "Hera"
      Event = "HeraRejection03"
    }
    {
      Id = "Hera_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau memang pantas berada di Olympus ini, melihat betapa lancangnya sikapmu padaku."
      Speaker = "Hera"
      Event = "HeraRejection04"
    }
    {
      Id = "Hera_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berhati-hatilah agar tak membuatku murka seperti ini, Sayang. Kau akan tahu bahwa ingatanku ini {#Emph}sangat amat {#Prev}tajam."
      Speaker = "Hera"
      Event = "HeraRejection05"
    }
    {
      Id = "Hera_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebaiknya kau jangan bersikap kurang ajar padaku. {#Emph}Rasakan ini! {#Prev}Biar kuingatkan tempatmu."
      Speaker = "Hera"
      Event = "HeraRejection06"
    }
    {
      Id = "Hera_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jauh di lubuk hati, aku menghargai suara dan pendapat yang berbeda, tapi secara terbuka... {#Emph}jelas tidak."
      Speaker = "Hera"
      Event = "HeraRejection07"
    }
    {
      Id = "Hera_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita harus menjaga tata krama; kita juga tak bisa menoleransi pembangkangan semacam ini."
      Speaker = "Hera"
      Event = "HeraRejection08"
    }
    {
      Id = "Hera_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau bersikeras menentangku, maka aku bersikeras membuat {#Emph}dirimu {#Prev}menyesalinya."
      Speaker = "Hera"
      Event = "HeraRejection09"
    }
    {
      Id = "Hera_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sesama dewi sungguh harus lebih saling mendukung daripada bersikap seperti {#Emph}ini."
      Speaker = "Hera"
      Event = "HeraRejection10"
    }
    {
      Id = "Hera_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suamiku memang sangat terbiasa mendapatkan apa pun kemauannya; kau tak perlu memanjakannya seperti itu."
      Speaker = "Hera"
      Event = "HeraRejection11"
    }
    {
      Id = "Hera_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putraku yang berkulit legam itu lebih menarik bagimu daripada diriku? {#Emph}Hahaha!"
      Speaker = "Hera"
      Event = "HeraRejection12"
    }
    {
      Id = "Hera_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lain kali saat Suamiku dan aku berselisih paham, {#Emph}berpihakhah padaku."
      Speaker = "Hera"
      Event = "HeraRejection13"
    }
    {
      Id = "Hera_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putraku yang haus perang itu kemungkinan besar adalah dalang di balik semua ini, tapi kau malah memilih {#Emph}dia?"
      Speaker = "Hera"
      Event = "HeraRejection14"
    }
    {
      Id = "Hera_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saudariku kurang awet muda, tapi dia menebusnya dengan kebijaksanaan, begitu kan maksudmu?"
      Speaker = "Hera"
      Event = "HeraRejection15"
    }
    {
      Id = "Hera_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengampunan itu ibarat salep penyembuh yang berharga, harus digunakan sehemat mungkin."
      Speaker = "Hera"
      Event = "HeraMakeUp01"
    }
    {
      Id = "Hera_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cukup! Kupikir sudah sampai di sini saja. Pertengkaran semacam ini terlalu murahan bagi martabat kita berdua."
      Speaker = "Hera"
      Event = "HeraMakeUp02"
    }
    {
      Id = "Hera_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ingin mengujiku, maka aku akan mengujimu balik, Sayang. Tolong, ingat baik-baik hal itu."
      Speaker = "Hera"
      Event = "HeraMakeUp03"
    }
    {
      Id = "Hera_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sudah cukup! {#Prev}Ini berkat yang sebenarnya bisa kau dapatkan {#Emph}tanpa {#Prev}harus bertarung!"
      Speaker = "Hera"
      Event = "HeraMakeUp04"
    }
    {
      Id = "Hera_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melihat perjuanganmu hanya menghiburku sesaat saja. Enyahlah sekarang juga, Gadis Muda."
      Speaker = "Hera"
      Event = "HeraMakeUp05"
    }
    {
      Id = "Hera_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat kita berdua, bertengkar layaknya sepasang suami istri tua! Bagaimana kalau kita sudahi saja dan lanjut?"
      Speaker = "Hera"
      Event = "HeraMakeUp06"
    }
    {
      Id = "Hera_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anggap dirimu sudah ditegur, Sayang. Ketahuilah bahwa kali ini kau lolos dengan mudah."
      Speaker = "Hera"
      Event = "HeraMakeUp07"
    }
    {
      Id = "Hera_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, musuh kita sudah terlalu banyak sampai-sampai kita {#Emph}hampir tak butuh {#Prev}musuh tambahan lagi."
      Speaker = "Hera"
      Event = "HeraMakeUp08"
    }
    {
      Id = "Hera_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita ini kaum bangsawan agung, Sayang. Kita seharusnya bersikap dengan pembawaan yang lebih anggun, bukan begitu?"
      Speaker = "Hera"
      Event = "HeraMakeUp09"
    }
    {
      Id = "Hera_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cih! {#Prev}Kita seharusnya membentuk aliansi yang kuat, bukan saling cakar satu sama lain."
      Speaker = "Hera"
      Event = "HeraMakeUp10"
    }
    {
      Id = "Hera_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa kita malah bertarung, sialan? Kau benar-benar {#Emph}bagian {#Prev}dari keluarga kami sampai-sampai bisa memancing amarahku sebesar ini."
      Speaker = "Hera"
      Event = "HeraMakeUp11"
    }
    {
      Id = "Hera_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah! Memang kita tak boleh memendam {#Emph}semua {#Prev}kemarahan kita, tapi tetap simpanlah sedikit untuk cadangan."
      Speaker = "Hera"
      Event = "HeraMakeUp12"
    }
    {
      Id = "Melinoe_0506"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ratu Hera, dari sekian banyak urusan penting yang bisa Kauberikan perhatian, Kau memilih untuk membantuku. Aku merasa sangat terhormat, dan ingin membalas kehormatan ini kepadamu."
      Speaker = "Melinoe"
      Event = "HeraGift01"
    }
    {
      Id = "Hera_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa ada tanggal pernikahan yang perlu kuketahui, atau kau cuma sekadar bermurah hati padaku? Bagaimanapun juga, saat aku diberi persembahan, pasti selalu ada udang di balik batu. Jadi, terimalah ini!"
      Speaker = "Hera"
      Event = "HeraGift01"
    }
    {
      Id = "Melinoe_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ratu Agung Olympus! Aku merasa terhormat telah mendapatkan perkenanmu, dan aku akan melakukan segalanya demi menjunjung tinggi namamu!"
      Speaker = "Melinoe"
      Event = "HeraGift02"
    }
    {
      Id = "Hera_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum terikat pernikahan tapi kau sudah memujiku sedemikian rupa? Harus kuakui kau penuh kejutan, Sayang. Atau mungkin kau cuma sangat naif. Atau malah dua-duanya!"
      Speaker = "Hera"
      Event = "HeraGift02"
    }
    {
      Id = "MelinoeField_1771"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar keemasan ini tiada artinya dibanding kemegahanmu, Ratu Hera; tapi inilah yang terbaik yang kami punya di tempat asalku. Demi kecantikan, keanggunan, dan kebijaksanaanmu yang abadi!"
      Speaker = "Melinoe"
      Event = "HeraGift03"
    }
    {
      Id = "Hera_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu menjilat begitu, kau tahu? Aku membantumu bukan karena sayang, melainkan karena terpaksa. Jika ada satu pelajaran yang bisa kuberikan padamu, itu adalah kau harus selalu waspada setiap saat."
      Speaker = "Hera"
      Event = "HeraGift03"
    }
    {
      Id = "MelinoeField_2241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi Ratu Olympus! Semoga tahtamu bertahan lama, dan kiranya masa pemerintahanmu dipenuhi kemakmuran dan kedamaian besar, baik bagi keluarga dan rakyatmu yang setia, maupun untukmu sendiri!"
      Speaker = "Melinoe"
      Event = "HeraGift04"
    }
    {
      Id = "Hera_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahlah, Nak. Kita berdua tahu aku bukan ratumu yang sesungguhnya. Kau bahkan bukan dewi Olympus, jadi kenapa tidak hentikan saja sandiwara ini? Atau kalau ini memang bukan sandiwara, melek lah sedikit. Dunia ini rumit."
      Speaker = "Hera"
      Event = "HeraGift04"
    }
    {
      Id = "MelinoeField_2242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ratu Hera, meski pertemuan di antara kita harus sesingkat ini, aku bersyukur atas setiap detik waktu yang bisa Kau luangkan. Aku tahu keluargamu membutuhkanmu, dan Olympus pun membutuhkanmu... dan pengabdianmu pada keduanya tampak begitu nyata."
      Speaker = "Melinoe"
      Event = "HeraGift05"
    }
    {
      Id = "Hera_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, Sayang, kalau kau merasa tak punya masa depan di dunia sihirmu itu, kau bisa banting setir jadi pemain sandiwara panggung! Soalnya aku hampir memercayai setiap kata-katamu tadi. Kejujuran memang bukan keahlian keluarga kita, tapi ya sudahlah! Kuisap jempol usahamu itu."
      Speaker = "Hera"
      Event = "HeraGift05"
    }
    {
      Id = "MelinoeField_2243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin tak memercayai kata-kataku, Wahai Ratu; namun lewat persembahan Nektar ini, Kau akan tahu aku tak punya niat dusta ataupun bermuka dua. Bagiku Kau bukan sekadar bangsawan penguasa... Kau adalah Bibi Buyutku. Dan Kau semegah yang pernah kubayangkan."
      Speaker = "Melinoe"
      Event = "HeraGift06"
    }
    {
      Id = "Hera_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar bersungguh-sungguh, ya? Dengar, Nak. Kau sepertinya belum paham bagaimana rasanya berada di gunung ini. Tak ada ruang untuk berbuat salah di sini; tak ada celah untuk terpeleset sedikit pun! Meski mungkin kau sudah mulai mencicipi sendiri {#Emph}tekanan {#Prev}semacam itu..."
      Speaker = "Hera"
      Event = "HeraGift06"
    }
    {
      Id = "MelinoeField_4166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih telah mempersatukan keluarga kita melalui masa-masa paling kelam ini, Ratu Hera! Dan terima kasih telah percaya padaku untuk membuat perubahan. Semoga manisnya Ambrosia ini mulai melunturkan kepahitan dari segala pergulatan kita."
      Speaker = "Melinoe"
      Event = "HeraGift07"
    }
    {
      Id = "Hera_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Manis sekali ucapanmu, Sayang. Tapi ingatanku ini {#Emph}panjang {#Prev}dan {#Emph}tajam{#Prev}, dan aku tak sudi membiarkannya tumpul, baik disengaja maupun tidak. Ingatan kita memberi kita keteguhan hati, dan mencegah kita mengulangi kesalahan yang sama. Bersyukurlah pada Sang Takdir, perkiraanku tentangmu ternyata tidak keliru."
      Speaker = "Hera"
      Event = "HeraGift07"
    }
    {
      Id = "MelinoeField_0644"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Padahal Anda sungguh tidak perlu repot-repot, Yang Mulia."
      Speaker = "Melinoe"
      Event = "HeraUpgrade.GiftGivenVoiceLines"
    }
    {
      Id = "Hera_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku paling suka drama perpisahan yang berantakan!"
      Speaker = "Hera"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hera_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saksikanlah murka Sang Ratu!"
      Speaker = "Hera"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hera_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka bakal menyesal pernah dilahirkan ke dunia!"
      Speaker = "Hera"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hera_0262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bangkit dan layanilah majikanmu!"
      Speaker = "Hera"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hera_0263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wahai yang mati, terlahirlah kembali!"
      Speaker = "Hera"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hera_0264"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluarga kita makin lama makin besar!"
      Speaker = "Hera"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hera_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau berani mempermainkan {#Emph}aku{#Prev}, Nak?"
      Speaker = "Hera"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hera_0260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rupanya ada orang cerdik di antara kita!"
      Speaker = "Hera"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hera_0261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, kurasa {#Emph}boleh juga{#Prev}!"
      Speaker = "Hera"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Heracles_0541"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Ratu...?"
      Speaker = "Heracles"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Heracles_0542"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ratu Hera...!"
      Speaker = "Heracles"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Heracles_0543"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ibu Tiri...!"
      Speaker = "Heracles"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Si wanita yang menyebut dirinya {#Emph}Ratu {#Prev}itu?!"
      Speaker = "Chronos"
      Event = "HeraUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Istri tercinta dari putraku?"
