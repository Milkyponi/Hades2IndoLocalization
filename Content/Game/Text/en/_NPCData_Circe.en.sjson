      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "MelinoeField_1887"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ehm{#Prev}, permisi...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "MelinoeField_1888"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Madam Circe!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "MelinoeField_1889"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, Madam."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Taring dan bulu, sejumput wol domba, \n {#Emph}Sayap kelam dan tanduk banteng perkasa,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Biji-biji mungil dan daun palem lebar, \n {#Emph}Batu dari sungai, lumut kolam segar,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Gelembung mendidih, daun teh, bayu lautan, \n {#Emph}Duri semak mawar, dan lilin sarang lebah hutan,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0065"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hembusan angin, dan percikan air laut, \n\t{#Emph}Gumpalan tanah, ranting pohon terpaut,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Potongan apel, zaitun, buah ara manis, \n {#Emph}Akar jahe dan ranting cemara berbaris,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Lumut kerak, bawang putih, kulit pinus tua, \n {#Emph}Percikan minyak, setetes anggur pemuja,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tudung jamur payung, sisik ular melata, \n {#Emph}Perasan lemon dan pasir danau jelita,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sulur melingkar dan gambut rawa basah, \n {#Emph}Bit gula manis dan telur ayam terbelah,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kristal oniks berkilau, sisik Piton melingkar, \n {#Emph}Embun pagi hari, dan serpihan kuku mekar,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0071"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sutra laba-laba, gigi hiu pemangsa, \n {#Emph}Seberkas cahaya, dan serpihan gulita perkasa,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Timbunan tanah gembur, serpihan batu cadas, \n {#Emph}Bulu unggas Harpy, ruas tulang ruas,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tanaman kapas dan serpihan batu api, \n {#Emph}Biji buah ceri dan tangkai daun min rapi,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tangkai jelai gandum, lempengan es membeku, \n {#Emph}Bulu cahaya rembulan, bulu lembut tikus berdebu,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kelopak emas jelita, sutra laba-laba kencana, \n {#Emph}Serbuk sari bunga, susu sapi sempurna,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bunga kamomil dan sebutir beras putih, \n {#Emph}Kayu manis harum dan bongkah es jernih,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Biji miju-miju, bubuk daun sesawi, \n {#Emph}Garam pegunungan, matang merasuki raga dan jiwa ini,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0295"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Rempah rahasia, kaldu ayam sedap, \n {#Emph}Sayur pahit segar dan sebongkah mentega mantap,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0296"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mimpi-mimpi indah dan gemerincing genta, \n {#Emph}Biji wijen gurih dan cangkang siput semesta,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Buih ombak samudra dan terumbu karang indah, \n {#Emph}Debu berkilau emas dan daun murtus merekah,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0298"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Secuil arang membara, kaki kelinci cepat, \n {#Emph}Serpihan kayu berjelaga api pekat,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sesiung bawang putih, embun petang temaram, \n {#Emph}Bunga iris mekar, beberapa kuntum tersulam,"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChanting"
    }
    {
      Id = "Circe_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Secuil jamur beracun, cakar kucing liar, \n {#Emph}Panaskan, aduk rata, ramuan pun berbinar!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChantingWrapUp"
    }
    {
      Id = "Circe_0075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kuku kaki babi, dan bulu anjing berpadu, \n {#Emph}Raciklah ramuan, manjur nan syahdu!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChantingWrapUp"
    }
    {
      Id = "Circe_0076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kelopak bunga Moly, melimpah di kualiku! \n {#Emph}Didihkan perlahan, matanglah di belangaku!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChantingWrapUp"
    }
    {
      Id = "Circe_0077"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Berjemurlah di bawah Sinar Rembulan, wahai kalian, \n\t{#Emph}Hingga kalian menyatu jadi ramuan sang penyihir sekalian!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChantingWrapUp"
    }
    {
      Id = "Circe_0300"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sejumput gula manis, getah pohon ek perkasa, \n {#Emph}Menyingkirlah sejenak dan biarkan meresap sempurna!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChantingWrapUp"
    }
    {
      Id = "Circe_0301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bentuk lingkaran, pikirkan yang jauh di sana, \n {#Emph}Kunci isinya di dalam bejana!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChantingWrapUp"
    }
    {
      Id = "Circe_0302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bubuk kristal, parutan kulit jeruk kesturi, \n {#Emph}Kini terwujudlah kehendak diri!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceChantingWrapUp"
    }
    {
      Id = "Circe_0243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang pergilah, {#Emph}hmhm!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0218"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin di lain malam..."
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terjadilah seperti yang dirapalkan!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terjadilah seperti yang dirapalkan."
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah kalau begitu!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maka kau akan mendapatkannya."
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0094"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maka kau akan mendapatkannya!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga terberkati, anak manis."
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itulah kehendakmu!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pergilah dengan anggun."
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukankah ini menakjubkan?"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di jalan!"
