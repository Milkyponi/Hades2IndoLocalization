      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga Sang Nyonya melindungimu."
      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "Circe_0287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sudah besar sekali!"
