      Speaker = "Circe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "MelinoeField_5653"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nyonya Circe pasti tahu banyak soal mimpi..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "MelinoeField_2049"
      InheritFrom = "BaseSubtitle"
