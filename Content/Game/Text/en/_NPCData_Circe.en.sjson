      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ehm{#Prev}, halo!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ehm, oh!{#Prev}"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah terlalu lama!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nona kecil!"
