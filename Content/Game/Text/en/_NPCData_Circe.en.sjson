      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "MelinoeField_2054"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ukuranku sebesar Titan..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Circe"
    }
    {
      Id = "MelinoeField_1894"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, Nyonya."
