{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Circe.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "MelinoeField_5652"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah itu benar-benar Anda, Nyonya Circe?"
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_3400"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kulihat dirimu menjaga makam para fana yang berpulang ke kegelapan seberang."
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Melinoe_0926_C"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maafkan aku..."
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_4342"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga ambisimu... tenggelam..."
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_4345"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Beralih Menjadi Bentuk Sederhana..."
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_3664"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, tidak, sama sekali tidak..."
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_4532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pengubahan Wujud Familiar..."
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_1890"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Damai menyertaimu, Nyonya Circe."
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_1892"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga sehat selalu, Nyonya."
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_1893"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam takzim, Nyonya."
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersama kita bersinar!"
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, salam!"
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pun padamu."
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0104_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pun padamu."
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan salam bagimu."
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan damai untukmu."
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga!"
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demikian titah Junjungan Kita..."
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pula untukmu."
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, Manis."
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak pernah sekali pun dia ingkar!"
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau dengar itu, Selene?"
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selene tak pernah mengecewakan!"
      Speaker = "Circe"
      Event = "NPC_Circe_01.InteractVoiceLines"
    }
    {
      Id = "Circe_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, bukankah ini luar biasa! Betapa kau telah {#Emph}tumbuh{#Prev}, nona kecil! Apa kau masih ingat pada Circe sang Penyihir? {#Emph}Ah? {#Prev}Oh, tak usah dipikirkan, {#Emph}hahaha. {#Prev}Bukan saat yang tepat untuk basa-basi! Coba perlihatkan telapak tanganmu."
      Speaker = "Circe"
      Event = "CirceFirstMeeting"
    }
    {
      Id = "MelinoeField_1756"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja aku mengingat Anda, Nyonya Circe! Jadi ini pulau Anda yang tersohor itu! Sungguh melegakan bisa berada di sini daripada di kapal karam lainnya. Kurasa pertemuan kita ini bukan sekadar kebetulan?"
      Speaker = "Melinoe"
      Event = "CirceFirstMeeting"
    }
    {
      Id = "Circe_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paham betul dengan cara kerja kita seperti biasa! Junjungan Kita Hekate dan aku memutuskan sebaiknya aku pindah untuk sementara waktu, dan mengawasi kejadian sedekat mungkin dari gunung para dewa. Lalu malam ini di dalam kristalku, kulihat {#Emph}dirimu! {#Prev}Nah, bagaimana kami bisa membuatmu lebih baik?"
      Speaker = "Circe"
      Event = "CirceFirstMeeting"
    }
    {
      Id = "Circe_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan aku sangat mirip dalam hal Junjungan Kita Hekate menemukan kita saat kita paling membutuhkan sosok seperti dirinya, Manis. Barangkali, kegemarannya yang serupa terhadap hewan membuatnya sedikit berbelaskasih padaku kala itu... seorang penyihir wanita, di tengah cerpelai dan babi-babi!"
      Speaker = "Circe"
      Event = "CirceAboutBackstory01"
    }
    {
      Id = "MelinoeField_1981"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berbelaskasih pada Anda, bagaimana mungkin? Itu tidak terdengar seperti Ibu Kepala Sekolah yang kukenal. Beliau selalu memandang tinggi Anda, dan mengandalkan Anda untuk menjadi mata kami di titik krusial ini."
      Speaker = "Melinoe"
      Event = "CirceAboutBackstory01"
    }
    {
      Id = "Circe_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berutang budi atas ini, dan lebih banyak lagi padanya. Saat aku masih seorang buangan muda, mempraktikkan seni yang kerap dianggap nista, Junjungan Kitalah yang menemukanku dan menunjukkan bahwa jalanku tidak berujung pada kehancuran, melainkan pada keselarasan. Jalan itu memang panjang dan berliku-liku, tapi aku tak akan pernah tersesat lagi darinya."
      Speaker = "Circe"
      Event = "CirceAboutBackstory01"
    }
    {
      Id = "Circe_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku meramalkan di balik faset kristalku bahwa kau akan menuju ke sini lagi... atau {#Emph}melewati {#Prev}sini, bisa dibilang. Adakah salep, ramuan, atau tapal yang bisa meringankan perjalananmu?"
      Speaker = "Circe"
      Event = "CirceAboutMiracles01"
    }
    {
      Id = "MelinoeField_1939"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja ada, dan terima kasih, Nyonya Circe. Anda kira-kira punya sesuatu yang membuatku kebal, atau memungkinkanku menemukan banyak reagen langka di sepanjang jalan?"
      Speaker = "Melinoe"
      Event = "CirceAboutMiracles01"
    }
    {
      Id = "Circe_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja {#Emph}tidak{#Prev}, Manis, {#Emph}hah! {#Prev}Semakin besar khasiatnya, semakin besar pula dampak tak terduganya, kita semua tahu itu benar adanya. {#Emph}Ehm{#Prev}, ada {#Emph}keseimbangan {#Prev}dalam menciptakan mukjizat! Apakah salah satu dari ini cukup?"
      Speaker = "Circe"
      Event = "CirceAboutMiracles01"
    }
    {
      Id = "Circe_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa kau {#Emph}selalu {#Prev}tekun belajar, nona kecil! Keberadaanmu di sini menandakan seberapa banyak yang telah kau capai. Aku selalu ingin kau mengunjungiku; dulu kau selalu bilang hal itu {#Emph}mustahil!"
      Speaker = "Circe"
      Event = "CirceAboutStudies01"
    }
    {
      Id = "MelinoeField_1940"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ternyata ramalan Tiga Moirai pun bisa diakali. Meskipun begitu, masih banyak yang harus kupelajari... setidaknya begitulah yang terus kuingatkan pada diriku malam demi malam. Bagaimana dengan Anda? Anda pasti sudah menguasai ilmu sihir kita secara sempurna sekarang!"
      Speaker = "Melinoe"
      Event = "CirceAboutStudies01"
    }
    {
      Id = "Circe_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang giliranku {#Emph}mengatakan {#Prev}bahwa itu hal yang {#Emph}mustahil! {#Prev}Aku telah mempraktikkan sihir selama tiga perempat hidupku, dan belum pernah sekalipun mengubah hakikat dari suatu benda! Hanya {#Emph}wujudnya. {#Prev}Namun pencarian ini kurasa sungguh memikat tanpa akhir!"
      Speaker = "Circe"
      Event = "CirceAboutStudies01"
    }
    {
      Id = "Circe_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Persetan {#Prev}dengan armada kapal-kapal mengerikan yang tiada habisnya itu, semuanya berlayar menuju gunung para dewa, {#Emph}hah! {#Prev}Pulaus kembarku terkadang {#Emph}tepat {#Prev}menghalangi jalan mereka! Tak ada keramahan bagi para awak kapal {#Emph}kasar {#Prev}itu, {#Emph}ahaha! {#Prev}Sementara {#Emph}aku {#Prev}bisa mengisi ulang persediaan kayu bakarku."
      Speaker = "Circe"
      Event = "CirceAboutThessaly01"
    }
    {
      Id = "MelinoeField_1941"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti merindukan masa-masa ketika pulamu masih lebih terpencil, dan jauh dari tamu-tamu tak diundang. Kuharap kedatanganku tak mengganggu ketenanganmu, Madame!"
      Speaker = "Melinoe"
      Event = "CirceAboutThessaly01"
    }
    {
      Id = "Circe_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, tentu saja {#Emph}tidak! {#Prev}Kenyataannya, suasana di sini kadang bisa terlalu sepi jika hanya ada gemersik dedaunan, dengusan babi-babiku, dan semacamnya. Aku menyambut hangat kepulanganmu ke sini!"
      Speaker = "Circe"
      Event = "CirceAboutThessaly01"
    }
    {
      Id = "Circe_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Selamat datang, Sayang! {#Prev}Tapi, maafkan aku karena belum bisa mengundangmu masuk ke {#Emph}dalam {#Prev}pondok kecilku. Keramahan semacam itu tak pernah kuberikan kepada siapa pun, {#Emph}hmhm! {#Prev}Dan aku tak membuat pengecualian, bahkan untukmu!"
      Speaker = "Circe"
      Event = "CirceAboutHut01"
    }
    {
      Id = "MelinoeField_1942"
      InheritFrom = "BaseNarrative"
      DisplayName = "Madame Circe, tidak apa-apa sama sekali. Tak perlu dijelaskan! Kita semua hidup dalam pengasingan dengan cara masing-masing; cara apa lagi yang tersisa? Privasi menghadirkan ketenangan batin."
      Speaker = "Melinoe"
      Event = "CirceAboutHut01"
    }
    {
      Id = "Circe_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bersyukur kau memahaminya. Akhir-akhir ini, aku berbagi rumah sederhanaku hanya dengan para binatang, itu saja! Pulau Aiaia ini tentu bukan milikku seutuhnya; melainkan kawan baikku, dan bisa menjadi kawan {#Emph}mu juga. {#Prev}Jadi, silakan ambil apa pun yang kau butuhkan selagi di sini."
      Speaker = "Circe"
      Event = "CirceAboutHut01"
    }
    {
      Id = "Circe_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sebenarnya aku sudah lama ingin bertanya, bagaimana mungkin kau bisa bepergian sejauh ini dari alam asalmu, Nona Kecil? Setahuku, kau nyaris tak bisa menghirup udara di sini!"
      Speaker = "Circe"
      Event = "CirceAboutSurfacePenalty01"
    }
    {
      Id = "MelinoeField_3494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kau tahu pepatah kita, Madame: Selalu ada mantra untuk segala hal. Mantra yang satu ini rasanya hampir seperti mematahkan sebuah kutukan."
      Speaker = "Melinoe"
      Event = "CirceAboutSurfacePenalty01"
    }
    {
      Id = "Circe_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu rupanya! Barangkali kita semua memang dikutuk dengan cara yang aneh; pilihannya kita belajar hidup berdampingan dengannya, atau mencari cara untuk menaklukkannya."
      Speaker = "Circe"
      Event = "CirceAboutSurfacePenalty01"
    }
    {
      Id = "Circe_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lady Hecate terkadang bercerita tentang kemajuanmu, dan membocorkan bahwa kau akhirnya bisa menyelaraskan diri dengan Altar Abu, {#Emph}hoho! {#Prev}Sungguh luar biasa... sebab Arcana punya begitu banyak hal untuk kita."
      Speaker = "Circe"
      Event = "CirceAboutArcana01"
    }
    {
      Id = "MelinoeField_1977"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat setuju. Lewat pemahaman akan Arcana, aku menemukan kekuatan yang tak pernah kusadari kumiliki. Dulu kupikir Altar kami hanya berguna untuk menenangkan pikiran."
      Speaker = "Melinoe"
      Event = "CirceAboutArcana01"
    }
    {
      Id = "Circe_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menenangkan pikiran itu sudah sangat berharga! Pikiranku sendiri sering kali buyar ke mana-mana. Mengenai bakat alamiah dan kepekaan sihirmu, barangkali kita akan menemukan lebih banyak lagi."
      Speaker = "Circe"
      Event = "CirceAboutArcana01"
    }
    {
      Id = "Circe_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam genggaman Arcanamu terdapat kekuatan yang membuat diriku tersohor. Saat usiaku sebaya denganmu, oh betapa aku mendambakan gelar Sang Penyihir! Sekarang lihatlah kita berdua di sini."
      Speaker = "Circe"
      Event = "CirceAboutArcana02"
    }
    {
      Id = "MelinoeField_3495"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalan hidupmu selalu menginspirasiku, Madame. Kau tak menerima keadaan begitu saja; kau belajar mengubah takdir demi kepentinganmu sendiri. Mengubah banyak hal besar, setahuku."
      Speaker = "Melinoe"
      Event = "CirceAboutArcana02"
    }
    {
      Id = "Circe_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan ikuti jalan {#Emph}ku{#Prev}, tapi carilah jalan{#Emph}mu sendiri! {#Prev}Awalnya aku berniat mengubah dunia, tahu? Karena aku sangat muak dengan sebagian besar hal yang kulihat. Namun berkat ajaran Lady Hecate, kini aku berusaha memahaminya lebih baik... dengan sedikit penyesuaian di sana-sini, {#Emph}hahaha!"
      Speaker = "Circe"
      Event = "CirceAboutArcana02"
    }
    {
      Id = "MelinoeField_3496"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada satu hal yang membuatku penasaran tentang Arcana, Madame. Kau tampaknya digambarkan pada salah satu Kartu... hanya saja wanita itu memiliki tatapan mata yang begitu murka. Itu bukan dirimu yang {#Emph}sebenarnya{#Prev}, kan?"
      Speaker = "Melinoe"
      Event = "CirceAboutArcana03"
    }
    {
      Id = "Circe_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa yang tahu, Nona Kecil? Tentu saja sosok itu bukan {#Emph}diriku{#Prev}, karena aku ada di sini, dan dia ada di sana! Arcana hanyalah perwujudan rupa, yang mencerminkan kekuatan batin{#Emph}mu sendiri{#Prev}. Barangkali tatapan matamu juga..."
      Speaker = "Circe"
      Event = "CirceAboutArcana03"
    }
    {
      Id = "Circe_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu punya {#Emph}bakat luar biasa {#Prev}dalam seni sihir kita! Aku sempat penasaran bagaimana sihir itu akan mengubahmu seiring waktu, karena godaan di jalan ini sungguh banyak! Namun kau punya guru terbaik yang pernah ada!"
      Speaker = "Circe"
      Event = "CirceAboutLearning01"
    }
    {
      Id = "MelinoeField_4524"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah Hecate pasti akan berkata {#Emph}guru terbaik ada di luar sana... {#Prev}mungkin yang dimaksud adalah pulaumu, Madame Circe. Apa maksudmu dengan godaan?"
      Speaker = "Melinoe"
      Event = "CirceAboutLearning01"
    }
    {
      Id = "Circe_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudku adalah {#Emph}kekuasaan{#Prev}, Nona Kecil. Begitu kau sanggup mewujudkan segala hasratmu, apa yang bisa {#Emph}menghentikanmu{#Prev}? Pelajaran yang dipetik lewat cara yang pahit, jika beruntung. Tangan kirimu itu adalah salah satu pengingatnya..."
      Speaker = "Circe"
      Event = "CirceAboutLearning01"
    }
    {
      Id = "Circe_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan padaku Sayang, apakah firasatku masih tepat? Langit kelam dan muram di malam seperti ini, energi di udara, semuanya mengisyaratkan suatu kehendak yang disengaja... Wasiat Sang Malam itu sendiri."
      Speaker = "Circe"
      Event = "CirceAboutShrine01"
    }
    {
      Id = "MelinoeField_4744"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau merasakan Rasa Takut di udara, Madame, karena aku telah mengikrarkan Sumpah. Nyx punya ikatan yang begitu kuat dengan Dunia Bawah, namun karyanya justru paling tersohor di permukaan, bukan?"
      Speaker = "Melinoe"
      Event = "CirceAboutShrine01"
    }
    {
      Id = "Circe_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali, dan semoga kau segera menuntaskan kehendaknya! Misteri di balik kegelapan tentu berasal dari alammu, bukan alam ini. Semoga kegelapan itu selalu membimbing langkahmu."
      Speaker = "Circe"
      Event = "CirceAboutShrine01"
    }
    {
      Id = "Circe_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, betapa bergolaknya lautan! Aku belum pernah merasakan malam segelap dan semencekam ini sejak pindah ke mari! Wasiat Sang Malam pasti menuntut banyak hal darimu, Sayang."
      Speaker = "Circe"
      Event = "CirceAboutShrine02"
    }
    {
      Id = "MelinoeField_4750"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami melayani Sang Malam atas kehendak sendiri. Namun ya, Sumpahku membuat perjalanan ini semakin berbahaya. Aku tahu setiap makhluk merespons pengaruhnya dengan berbeda... apa babi-babimu baik-baik saja?"
      Speaker = "Melinoe"
      Event = "CirceAboutShrine02"
    }
    {
      Id = "Circe_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, coba lihat mereka, mereka {#Emph}baik-baik saja! {#Prev}Sama sekali tak peduli pada bahaya di dunia ini, asyik menikmati kebersamaan satu sama lain dan segala kelimpahan yang disediakan pulau ini!"
      Speaker = "Circe"
      Event = "CirceAboutShrine02"
    }
    {
      Id = "Circe_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sering terpikir untuk mengubahmu menjadi seekor burung agar perjalananmu lebih mudah, tapi kau harus meninggalkan persenjataan dan bahan-bahan pemberian Sang Malam... kau akan tiba di gunung para dewa tanpa sehelai benang pun, dan kedinginan..."
      Speaker = "Circe"
      Event = "CirceAboutTransformation01"
    }
    {
      Id = "MelinoeField_3521"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Kalau begitu, tidak usah, Madame. Walaupun terkadang aku iri pada banyak kenalanku yang bisa terbang bebas, aku sudah cukup nyaman berjalan kaki."
      Speaker = "Melinoe"
      Event = "CirceAboutTransformation01"
    }
    {
      Id = "Circe_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu sudah sangat jelas bagiku, Nona Kecil! Tapi, jika kau {#Emph}suatu saat {#Prev}berubah pikiran dan ingin sesekali merasakan hidup sebagai seekor binatang, langsung panggil aku tanpa ragu, ya?"
      Speaker = "Circe"
      Event = "CirceAboutTransformation01"
    }
    {
      Id = "Circe_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terlepas dari semua kepayahan di malam-malam ini, Nona Kecil, setidaknya studimu akhirnya selesai juga! Sekarang kau belajar langsung dari {#Emph}guru terbaik dari segalanya{#Prev}, seperti kata Lady Hecate."
      Speaker = "Circe"
      Event = "CirceAboutTraining01"
    }
    {
      Id = "MelinoeField_3522"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian besar memang benar, Madame, hanya saja Kepala Sekolah masih sering mengujiku sendiri malam demi malam, tepat saat aku hendak berangkat dari Erebus. Meski tidak saat aku menuju ke mari!"
      Speaker = "Melinoe"
      Event = "CirceAboutTraining01"
    }
    {
      Id = "Circe_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yakin ujian yang kau hadapi di permukaan tak kalah beratnya dibanding ujian di bawah sana! Dan lihatlah seberapa jauh kau telah melangkah dengan semua bekal yang kau pelajari!"
      Speaker = "Circe"
      Event = "CirceAboutTraining01"
    }
    {
      Id = "Circe_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana suasana hati Lady Hecate belakangan ini? Sudah lama sekali sejak terakhir kali aku mereguk kebijaksanaannya; karena aku punya kebijaksanaanku sendiri, katanya! Kau pasti jauh lebih membutuhkan perhatiannya ketimbang aku..."
      Speaker = "Circe"
      Event = "CirceAboutHecate01"
    }
    {
      Id = "MelinoeField_1980"
      InheritFrom = "BaseNarrative"
      DisplayName = "Madame Circe, a... aku tak bermaksud merenggut perhatian beliau darimu. Kepala Sekolah sedang disibukkan bukan hanya dengan latihanku, tapi juga memimpin kaum Tak Kasat Mata, melindungi Persimpangan dari marabahaya, dan menyiapkan rencana untuk merebut kembali hak kita. Beliau mengandalkan kita... mengandalkanmu."
      Speaker = "Melinoe"
      Event = "CirceAboutHecate01"
    }
    {
      Id = "Circe_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu, aku tahu... dan aku minta maaf jika terkesan menyimpan rasa dongkol; sungguh tak ada kekesalan kepadamu, apalagi kepadanya! Kau pegang janji{#Emph}ku{#Prev}, Sayang. Hanya saja... beliau sudah seperti ibu bagiku! {#Emph}Oh{#Prev}, betapa beliau benci saat aku mengatakannya, {#Emph}haha!"
      Speaker = "Circe"
      Event = "CirceAboutHecate01"
    }
    {
      Id = "Circe_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa salah satu berkah agung Selene malam ini, aku bisa merasakannya, Sayang! Bahkan dari kejauhan, Sang Rembulan selalu menemaniku. Cahayanya bisa begitu {#Emph}benar-benar {#Prev}mengubah rupa!"
      Speaker = "Circe"
      Event = "CirceAboutSelene01"
    }
    {
      Id = "MelinoeField_1978"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan semoga cahaya Selene selalu menyinari jalan kita, Nyonya. Aku mungkin takkan menemukan jalan kemari tanpa bantuannya. Mengenai sihirnya... terkadang aku bertanya-tanya, apakah sihir itu benar-benar mengubahku, atau justru memperlihatkan jati diriku yang sebenarnya."
      Speaker = "Melinoe"
      Event = "CirceAboutSelene01"
    }
    {
      Id = "Circe_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa jadi memang begitu! Siapa yang bisa menduga letak hakikat diri kita yang sejati? Mantra pengubah wujud sejatinya adalah mantra penyingkap tabir; saat kita berubah, kita menjadi kian mirip dengan {#Emph}diri kita sendiri{#Prev}. Bukan sebaliknya!"
      Speaker = "Circe"
      Event = "CirceAboutSelene01"
    }
    {
      Id = "Circe_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cepat sekali kau tiba di sini, Sayang! Dan kurasa ini bukan semata-mata karena dorongan {#Emph}angin {#Prev}dan {#Emph}ombak {#Prev}lautan. Dewa kurir Hermes yang melesatkan langkahmu, ya?"
      Speaker = "Circe"
      Event = "CirceAboutHermes01"
    }
    {
      Id = "MelinoeField_3391"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini aku menerima Berkahnya. Para dewa belum begitu terdesak sampai-sampai tak bisa membantuku dalam perjalanan ini, dan kekuatan kita paling besar saat dipadukan. Tapi, kenapa kau bertanya?"
      Speaker = "Melinoe"
      Event = "CirceAboutHermes01"
    }
    {
      Id = "Circe_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya saja para dewa tak begitu tahu tentang keberadaanku di sini, dan aku ingin tetap seperti itu! Tempat ini tak muat untuk banyak tetamu! Dan kaum Olimpus pasti {#Emph}benar-benar {#Prev}terperangah melihat tempat sesahaja ini."
      Speaker = "Circe"
      Event = "CirceAboutHermes01"
    }
    {
      Id = "Circe_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belakangan ini kudengar kepakan begitu banyak sayap yang berbeda. Para Harpy, melayang menuju pengepungan gunung; Strife bersayap hitam, yang mengaduk-aduk pusaran udara dan laut; dan bahkan anak bernama Icarus itu, yang terbang kian kemari tanpa tambatan!"
      Speaker = "Circe"
      Event = "CirceAboutIcarus01"
    }
    {
      Id = "MelinoeField_3392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia berusaha membantu perjuangan kita... walau kurasa dia juga menikmati kebebasan yang tak pernah ia rasakan saat masih hidup, maupun saat menjadi Arwah di Dunia Bawah. Untuk sekarang, dia bisa pergi ke mana pun sesuka hatinya."
      Speaker = "Melinoe"
      Event = "CirceAboutIcarus01"
    }
    {
      Id = "Circe_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun dia justru memilih berada di {#Emph}sini! {#Prev}Itu benar-benar membuktikan tekadnya. Betapa miripnya dia dengan ayahnya yang pekerja keras itu! Yah, semoga dia menikmati sayap-sayap kebebasan itu selagi masih bertahan!"
      Speaker = "Circe"
      Event = "CirceAboutIcarus01"
    }
    {
      Id = "Circe_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau jadi apa dunia ini, Gadis Kecil? {#Emph}Uh! {#Prev}Tinggal di pulau terpencil begini, sepertinya aku orang terakhir yang tahu kalau malapetaka telah merembet dari kahyangan hingga ke bawah Bumi!"
      Speaker = "Circe"
      Event = "CirceAboutChronos01"
    }
    {
      Id = "MelinoeField_1979"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan Chronos bertanggung jawab atas semuanya. {#Emph}Sang Waktu {#Prev}rupanya ingin membinasakan segalanya perlahan-lahan, tapi kami takkan membiarkannya seenaknya sendiri. Kami akan mengusir pasukannya dari Olimpus dan melengserkannya dari takhta ayahku."
      Speaker = "Melinoe"
      Event = "CirceAboutChronos01"
    }
    {
      Id = "Circe_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, dasar kita kaum abadi yang gemar berperang! Teladan macam apa yang kita berikan bagi {#Emph}kaum fana? {#Prev}Namun aku tahu ada pertempuran tertentu yang mau tak mau harus dilalui; dan aku tetap setia pada Yang Mulia Hecate, juga padamu."
      Speaker = "Circe"
      Event = "CirceAboutChronos01"
    }
    {
      Id = "Circe_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belakangan ini aku tak melihat batang hidung Medea sama sekali! Tugasnya jauh kurang menyenangkan dibanding tugasku, harus mengawasi kota mengerikan itu. Aku cemas dia malah membiasakan hal buruk, berlatih di tempat semacam itu!"
      Speaker = "Circe"
      Event = "CirceAboutMedea01"
    }
    {
      Id = "MelinoeField_1982"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku belum lama ini bertemu Nyonya Medea. Dia tampak cukup nyaman di Ephyra, terlepas dari apa yang telah terjadi di sana. Namun, apakah dia memang selalu memiliki ketertarikan yang begitu mendalam pada kutukan dan ilmu necromancy?"
      Speaker = "Melinoe"
      Event = "CirceAboutMedea01"
    }
    {
      Id = "Circe_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sejak dia cukup umur untuk berpikir sendiri, ya, {#Emph}heh{#Prev}. Tepatnya untuk {#Emph}bertahan hidup {#Prev}sendiri. Dia memang keponakanku, tapi dia selalu {#Emph}jauh {#Prev}lebih tertarik pada khasiat darah kami yang {#Emph}lain{#Prev}. Setidaknya dia belum mengutuk {#Emph}diriku, haha. Ah! {#Prev}Setahu diriku, sih!"
      Speaker = "Circe"
      Event = "CirceAboutMedea01"
    }
    {
      Id = "Circe_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hawa di sini memburuk begitu kau tiba. Kau habis bekerja sama dengan Medea, bukan? Mendekam terus di nekropolis itu pasti berdampak buruk bagi jiwanya..."
      Speaker = "Circe"
      Event = "CirceAboutMedea02"
    }
    {
      Id = "MelinoeField_4751"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang menemuinya tadi malam ini. Apa terjadi sesuatu di antara kalian berdua? Kesanku kalian berdua sudah hampir tak pernah saling berhubungan sama sekali."
      Speaker = "Melinoe"
      Event = "CirceAboutMedea02"
    }
    {
      Id = "Circe_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja kehadiranku mengingatkan Medea pada terlalu banyak kejadian di masa lampau, yang bukan hakku untuk menceritakannya! Tak ada gunanya terus berkubang di masa lalu, Sayang. Barangkali beberapa abad lagi, dia akan terbebas dari masa lalunya... tapi dia butuh waktu."
      Speaker = "Circe"
      Event = "CirceAboutMedea02"
    }
    {
      Id = "Circe_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua air laut ini pasti terasa sangat merisaukan, Gadis Kecil. Tapi bagiku, ini terasa sangat menenteramkan layaknya rumah sendiri! Bahkan kedalaman Oceanus sekalipun lebih membawakan rasa nyaman daripada ketakutan!"
      Speaker = "Circe"
      Event = "CirceAboutScylla01"
    }
    {
      Id = "MelinoeField_1985"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mulai terbiasa. Jalanku menuju Dunia Bawah mengharuskanku menyusuri tepian Oceanus. Airnya memang indah, walau aku tak terlalu suka monster-monster lautnya. Terutama Scylla dan kawan-kawan Siren-nya... mungkinkah kau tahu tentang mereka?"
      Speaker = "Melinoe"
      Event = "CirceAboutScylla01"
    }
    {
      Id = "Circe_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}tentu saja! {#Prev}Aku kenal baik. Aku tumbuh besar di dasar laut, dan aku ingat Scylla sejak masa mudaku. Selalu saja merengek meributkan {#Emph}ini {#Prev}atau {#Emph}itu! {#Prev}Suaranya {#Emph}memekakkan telinga! {#Prev}Mungkin itu sebabnya sekarang aku lebih suka keheningan."
      Speaker = "Circe"
      Event = "CirceAboutScylla01"
    }
    {
      Id = "Circe_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar Scylla tua belakangan ini? Aku belum mendengar kabar kalau dia turun ke kedalaman kalian. Katamu dia berkomplot dengan beberapa Siren, ya? Untuk apa, mendendangkan lagu-lagu mereka?"
      Speaker = "Circe"
      Event = "CirceAboutScylla02"
    }
    {
      Id = "MelinoeField_3526"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, begitulah. Dia mendambakan ketenaran di atas segalanya, dan gemar menenggelamkan mangsa. Sudah berulang kali aku terpaksa menghentikan pertunjukannya. Kitab Bayangan milikku menyebutkan dia adalah korban kutukan seorang penyihir... apa kau tahu siapa penyihirnya?"
      Speaker = "Melinoe"
      Event = "CirceAboutScylla02"
    }
    {
      Id = "Circe_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, pasti Kitab yang sangat menarik itu! Aku tidak pernah mengutuk, Sayang. Praktik sihirku bertujuan menyingkap hakikat sejati suatu hal. Terakhir kali kuingat, Scylla sudah memperjelas hakikat dirinya sendiri."
      Speaker = "Circe"
      Event = "CirceAboutScylla02"
    }
    {
      Id = "Circe_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat berpikir, Sayang, jika Scylla itu terus menyulitkanmu selama perjalanan turun, mungkinkah aku bisa sedikit membantu? Tapi pertama-tama aku butuh sesuatu: Mutiara khusus darinya."
      Speaker = "Circe"
      Event = "CirceAboutScyllaQuest01"
    }
    {
      Id = "MelinoeField_4340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Kebetulan aku punya beberapa Mutiara darinya di sini, pilihlah yang kau mau. Tapi, ceritakan dulu apa rencana sebenarnya di benakmu."
      Speaker = "Melinoe"
      Event = "CirceAboutScyllaQuest01"
    }
    {
      Id = "Circe_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, tak satu pun dari ini yang cocok! Mutiara itu harus diambil darinya dengan niat khusus, di bawah malam yang gelap dan mencekam, untuk menenggelamkan ambisinya, layaknya Siren menenggelamkan pelaut...! Bisakah kau lakukan itu untukku?"
      Speaker = "Circe"
      Event = "CirceAboutScyllaQuest01"
    }
    {
      Id = "MelinoeField_4341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja, tapi... apa yang akan terjadi pada Scylla jika kulakukan? Dia memang menghalangi jalanku, tapi setidaknya dia menjadi hiburan tersendiri bagi para Arwah di Oceanus."
      Speaker = "Melinoe"
      Event = "CirceAboutScyllaQuest01"
    }
    {
      Id = "Circe_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia takkan lagi menjadi ancaman. Di saat pengaruh Sang Malam sedang kuat, renggutlah salah satu Mutiara berharga Scylla, lalu serukan: {#Emph}Semoga ambisimu karam tenggelam. {#Prev}Setidaknya pertimbangkanlah itu, ya?"
      Speaker = "Circe"
      Event = "CirceAboutScyllaQuest01"
    }
    {
      Id = "MelinoeField_4343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku membawa sebutir Mutiara dari Scylla di sini, Nyonya, walau belum kutuangi niat khususmu. Kau sendiri yang bilang sihirmu bertujuan menyingkap hakikat sejati suatu hal. Hakikat dirinya sudah sangat jelas."
      Speaker = "Melinoe"
      Event = "CirceAboutScyllaQuestComplete01"
    }
    {
      Id = "Circe_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itulah alasan kubilang kita perlu {#Emph}menundukkannya{#Prev}. Tapi rupanya kau tak berminat pada mantra semacam itu... yang artinya kau lulus satu ujian lagi, {#Emph}hahaha! {#Prev}Selamat, Sayang!"
      Speaker = "Circe"
      Event = "CirceAboutScyllaQuestComplete01"
    }
    {
      Id = "MelinoeField_4344"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa? {#Prev}Apa Kepala Asrama yang menyuruhmu melakukan ini? Untuk melihat apakah aku akan gegabah mengutuk musuh tak penting hanya karena aku mampu melakukannya...?"
      Speaker = "Melinoe"
      Event = "CirceAboutScyllaQuestComplete01"
    }
    {
      Id = "Circe_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk melihat apakah kau akan buta menuruti perintah tetua hanya karena diminta. Sihir kita paling ampuh jika disertai menahan diri; pelajaran berharga yang lambat laun kita pelajari semua. Tentu saja kalau Scylla menjadi ancaman yang lebih gawat, {#Emph}hm... {#Prev}datanglah padaku."
      Speaker = "Circe"
      Event = "CirceAboutScyllaQuestComplete01"
    }
    {
      Id = "Circe_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupenasaran, apakah Yang Mulia Hecate masih sering berunding dengan Arwah Ahli Taktik kesayangannya itu, {#Emph}heh? {#Prev}Perawakannya tidak terlalu tinggi, bicaranya banyak. {#Emph}Oh{#Prev}, siapa lagi namanya waktu itu...?"
      Speaker = "Circe"
      Event = "CirceAboutOdysseus01"
    }
    {
      Id = "MelinoeField_1983"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu Odysseus? Dia tetap sosok yang sangat berharga bagi perjuangan kami. Pengetahuan yang kumiliki tentang rute ini dan marabahaya di sepanjang jalannya sebagian besar berkat jasanya. Kenapa kau bertanya?"
      Speaker = "Melinoe"
      Event = "CirceAboutOdysseus01"
    }
    {
      Id = "Circe_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Bukan karena alasan apa-apa! Hanya saja seingatku dia itu tipe orang yang plin-plan, suka sekali kelayapan ke sana kemari! Jadi melihatnya masih setia mengabdi agak mengejutkan bagiku. Kejutan yang menyenangkan, tentu saja!"
      Speaker = "Circe"
      Event = "CirceAboutOdysseus01"
    }
    {
      Id = "MelinoeField_1984"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah Nyonya dulu mengenalnya? Seingatku kalian tak pernah berinteraksi di Persimpangan. Bukannya dulu aku memperhatikan hal lain selain pelajaranku, sih. Aku masih sangat kecil waktu terakhir kali Nyonya berkunjung!"
      Speaker = "Melinoe"
      Event = "CirceAboutOdysseus01"
    }
    {
      Id = "Circe_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu kupindahkan pulau ini, perjalanan ke Persimpangan jadi {#Emph}jauh {#Prev}lebih melelahkan. Soal Odysseus, ya, aku pernah bertemu dengannya. Dia dan para awak kapalnya yang berkepala babi itu! Itu di zaman yang berbeda, Manis, {#Emph}haha! {#Prev}Barangkali dia sudah belajar sedikit sejak saat itu."
      Speaker = "Circe"
      Event = "CirceAboutOdysseus01"
    }
    {
      Id = "MelinoeField_5233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seingatku kalian tak pernah berinteraksi di Persimpangan. Bukannya dulu aku memperhatikan hal lain selain pelajaranku, sih. Aku masih sangat kecil waktu terakhir kali Nyonya berkunjung!"
      Speaker = "Melinoe"
      Event = "CirceAboutOdysseus01_B"
    }
    {
      Id = "Circe_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu kupindahkan pulau ini, perjalanan ke Persimpangan jadi {#Emph}jauh {#Prev}lebih melelahkan. Soal Odysseus dan para awak kapalnya yang berkepala babi itu... barangkali dia sudah belajar sedikit sejak saat itu."
      Speaker = "Circe"
      Event = "CirceAboutOdysseus01_B"
    }
    {
      Id = "Circe_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang kau bawa itu, Nona Kecil? {#Emph}Uh, mm{#Prev}, sepertinya Tulang Sendi tua yang terkutuk... Kusarankan kau {#Emph}segera {#Prev}menyingkirkannya dari sini! Benda itu mengganggu aliran energi di tempat ini!"
      Speaker = "Circe"
      Event = "CirceAboutOdysseusKeepsake01"
    }
    {
      Id = "Circe_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa artefak itu lagi bersamamu, Tulang Sendi itu...! Kalau begitu pembicaraan kita singkat saja ya, Manis, karena aku benar-benar tak sudi benda itu ada di sini!"
      Speaker = "Circe"
      Event = "CirceAboutOdysseusKeepsake02"
    }
    {
      Id = "Circe_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa hawa buruk bersamamu, Nona Kecil. Aku sama sekali tak menyukainya! Hawa Tulang Sendi tua itulah yang kurasakan, benda itu... benda itu pertama kali menginjakkan kaki di pulau ini dahulu kala..."
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest00"
    }
    {
      Id = "MelinoeField_4519"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kumohon, Nyonya. Aku mendapatkan ini dari Odysseus sendiri, dan benda ini sangat membantuku. Dia memohon apakah Nyonya bersedia berbicara dengannya lewat benda ini. Aku tak tahu apa yang ingin kalian bicarakan, tapi aku tahu ini membebani kalian berdua."
      Speaker = "Melinoe"
      Event = "CirceAboutOdysseusQuest00"
    }
    {
      Id = "Circe_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aneh sekali dimintai tolong begini! Kau punya urusan yang jauh lebih mendesak daripada menjadi pesuruhnya! Dia bisa saja berlayar ke sini sendiri kalau memang ada hal berguna yang ingin disampaikan, {#Emph}hoho! {#Prev}Tapi {#Emph}tidak{#Prev}."
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest00"
    }
    {
      Id = "MelinoeField_4520"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami butuh Sang Ahli Taktik tetap berjaga di posnya. Dengar, jika Nyonya bisa merasakan Tulang itu, tentu Nyonya juga bisa merasakan tak ada niat buruk di baliknya. Bagaimanapun juga, maaf telah mengganggu Nyonya."
      Speaker = "Melinoe"
      Event = "CirceAboutOdysseusQuest00"
    }
    {
      Id = "Circe_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tidak apa-apa, ini bukan salahmu, Manis. Tapi aku belum siap berbicara dengannya sekarang. Namun, saat kau membawa Tulang-Tulang itu ke sini lagi nanti... {#Emph}eugh... {#Prev}mungkin aku akan bersedia."
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest00"
    }
    {
      Id = "Circe_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tulang Sendi itu lagi. Baiklah kalau begitu, aku ini penyihir yang memegang kata-kataku, Manis. Kau boleh memanggil kawan lama kita, Arwah Ahli Taktik itu; aku ingin mendengar apa yang hendak dia katakan."
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "MelinoeField_4357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Nyonya. {#Emph}Dengarkan suaraku, Odysseus; orang yang kau cari ada di sini!"
      Speaker = "Melinoe"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Odysseus_0575"
      InheritFrom = "BaseNarrative"
      DisplayName = "Puan Circe. Aku tak akan menyita waktumu lebih dari sejenak. Kulihat Puan masih merawat babi-babi itu!"
      Speaker = "Odysseus"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Circe_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir mereka cukup penurut. Tapi kutahu kau ke sini bukan demi mereka, Odysseus. Ada angin apa gerangan...?"
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Odysseus_0576"
      InheritFrom = "BaseNarrative"
      DisplayName = "Adakah tempat di mana kita bisa bicara berdua sebentar? Dewi di sampingku mungkin tak bisa memproyeksikan wujudku di sini terlalu lama."
      Speaker = "Odysseus"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Circe_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang ingin kau katakan, katakan saja di sini dan sekarang. Aku ingat betul kita berdua sudah sepakat bahwa pembicaraan lebih lanjut di antara kita bukanlah hal yang bijak, setelah jalan buntu yang kita capai, serupa rintangan yang {#Emph}kau {#Prev}hadapi di {#Emph}lautan!"
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Odysseus_0577"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingatan yang sama-sama kupahami, tapi... dengar, aku tak pernah menemui jalan buntu yang tak bisa kuseberangi, dan Puan sendiri telah menguasai perubahan. Daripada membiarkan masa lalu kita membusuk, kupikir mungkin kita bisa... mengembalikannya ke tanah, seperti kata pepatahmu."
      Speaker = "Odysseus"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Circe_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu sungguh posisi yang rawan, karena tak satu pun dari kita akan meminta maaf dan tak satu pun yang akan lupa! Kita sudah membahas masalah ini panjang lebar. Aku sudah mempelajarinya lebih dari cukup!"
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Odysseus_0578"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku pun sudah selesai mempelajarinya, Puanku. Itu adalah masa yang sangat berbeda bagi kita berdua, dan sekarang... kita dekat dengan orang-orang yang kita sayangi. Aku ingin melangkah maju demi mereka, jika bukan demi diri kita sendiri."
      Speaker = "Odysseus"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Circe_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sudah melangkah maju, setidaknya begitu pikirku. Aku tak menaruh dendam padamu, Pelaut! Kukatakan itu saat kita pertama bertemu, dan kukatakan lagi sekarang. Kita pernah punya masa itu, tapi kini ia tak lagi berkuasa."
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Odysseus_0579"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu mari kita sepakati hal itu. Sekarang semoga Puan senantiasa sehat. Semua yang ingin kusampaikan hanyalah, keberadaan dan kenanganku menjadi lebih kaya setelah mengenalmu... Aku jadi lebih mengenal diriku sendiri. Dan aku berterima kasih karena Puan sudi membantu kami."
      Speaker = "Odysseus"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Circe_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dan begitulah dia berlalu, selalu ingin memegang kata terakhir seperti biasanya. Pergilah, Manis, aku sudah {#Emph}terlalu {#Prev}banyak bicara untuk malam ini."
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest01"
    }
    {
      Id = "Circe_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin berterima kasih atas pertemuan kita tempo hari. Dan karena telah mempertemukan Odysseus denganku. Awalnya aku... merasa sangat gelisah, tapi kemudian, setelah kau pergi... rasa gelisah itu pun turut sirna. Dia adalah sesosok Arwah; barangkali selama ini dia memang sedikit menghantuiku."
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest02"
    }
    {
      Id = "MelinoeField_4358"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu bagaimana kelanjutan hubungan kalian berdua sekarang, Nyonya? Apakah ada pesan yang bisa kusampaikan atas nama Nyonya?"
      Speaker = "Melinoe"
      Event = "CirceAboutOdysseusQuest02"
    }
    {
      Id = "Circe_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu. Aku sadar kita memang ditakdirkan untuk berpisah jalan, karena dia bukanlah tipe orang yang betah berdiam diri! Namun, jika sebuah kenangan memang harus terus membekas, kenangan yang damai adalah yang terbaik."
      Speaker = "Circe"
      Event = "CirceAboutOdysseusQuest02"
    }
    {
      Id = "Circe_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti sudah melihat bagaimana sayap hitam sang Dewi Perselisihan yang dengki sering kali menggelapkan langit ini! Dia mengawasi pulau kecilku, bahkan terbang begitu dekat hingga membahayakan. Apa lagi gerangan alasan di balik amarahnya kali ini?"
      Speaker = "Circe"
      Event = "CirceAboutEris01"
    }
    {
      Id = "MelinoeField_3390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, Eris malah tampak lebih ceria dari biasanya, kalau boleh jujur. Awalnya kukira dia bekerja untuk Chronos, tapi kurasa dia cuma tak suka melihat ada orang lain yang berhasil. Selain dirinya sendiri."
      Speaker = "Melinoe"
      Event = "CirceAboutEris01"
    }
    {
      Id = "Circe_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, itu sama sekali bukan cara berpikir yang sehat. Betapa aku mendambakan dunia tanpa Perselisihan... namun aku nyaris tak bisa membayangkannya. Dia adalah kekuatan yang pantang diabaikan, melainkan harus diredam."
      Speaker = "Circe"
      Event = "CirceAboutEris01"
    }
    {
      Id = "Circe_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh disayangkan mengetahui Prometheus memberontak melawan para dewa... tentu dia sadar bahwa mengejar pembalasan dendam takkan memberinya kedamaian! Apakah dia sudah tak bisa diajak bicara baik-baik lagi?"
      Speaker = "Circe"
      Event = "CirceAboutPrometheus01"
    }
    {
      Id = "MelinoeField_3380"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia tak banyak bicara, tapi akhir-akhir ini memang siapa sih yang begitu? Ujung-ujungnya kami saling bertarung tepat di bawah puncak gunung. Rupanya dia selalu tahu siapa yang akan keluar sebagai pemenang... bahkan jika pemenangnya adalah aku."
      Speaker = "Melinoe"
      Event = "CirceAboutPrometheus01"
    }
    {
      Id = "Circe_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, dia sudah pernah meramalkan kekalahannya sendiri sebelumnya. Bisakah kau bayangkan, Manis? Mengetahui setiap kesialan dan malapetaka yang menantimu di depan. Kurasa tak ada hukuman yang pernah dia tanggung yang lebih buruk daripada hal itu."
      Speaker = "Circe"
      Event = "CirceAboutPrometheus01"
    }
    {
      Id = "MelinoeField_3381"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah Nyonya percaya bahwa sang Titan Tinjauan Masa Depan benar-benar bisa melihat masa depan, Nyonya? Prometheus bersikukuh soal itu. Aku malah mengira Nyonya sendirilah yang punya kemampuan semacam itu."
      Speaker = "Melinoe"
      Event = "CirceAboutPrometheus02"
    }
    {
      Id = "Circe_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengenai apa yang akan terjadi nanti, terkadang aku bisa melihat sekilas bayangannya, Nona Kecil; asalkan aku mencurahkan banyak waktu dan sumber daya. Sedangkan Prometheus, kurasa dia melihat masa depan di luar kendalinya sendiri."
      Speaker = "Circe"
      Event = "CirceAboutPrometheus02"
    }
    {
      Id = "MelinoeField_3382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi jika kau tahu pasti apa yang akan terjadi, bukankah kau bisa mengubahnya begitu saja? Misalnya, andai aku tahu kita akan membicarakan ini, aku bisa saja menghindari topik ini..."
      Speaker = "Melinoe"
      Event = "CirceAboutPrometheus02"
    }
    {
      Id = "Circe_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kalau begitu, pengetahuanmu soal masa depan jadi keliru, dong. Lagipula, pengetahuan semacam itu bisa berbahaya! Kemampuan hebat kita untuk menaruh harapan bergantung pada ketidaktahuan kita akan apa yang bakal terjadi..."
      Speaker = "Circe"
      Event = "CirceAboutPrometheus02"
    }
    {
      Id = "Circe_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau sudah melihat sendiri monster raksasa itu dengan mata kepalamu, ya, Manis? Maksudku Typhon, tentu saja! Sering kali aku bertanya-tanya tentang keterikatannya yang mendalam dengan alam..."
      Speaker = "Circe"
      Event = "CirceAboutTyphon01"
    }
    {
      Id = "MelinoeField_3385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan keterikatan macam apa {#Emph}itu{#Prev}? Dia itu monster, persis seperti katamu! Makhluk yang tak seharusnya ada di dunia kita."
      Speaker = "Melinoe"
      Event = "CirceAboutTyphon01"
    }
    {
      Id = "Circe_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun nyatanya dia ada di sana, tempat yang sebentar lagi akan kau tuju! Siapa sih yang benar-benar tahu batas dunia kita, serta apa saja yang ada di dalamnya...? Yang jelas bukan kau ataupun aku, Manis! Bagiku, {#Emph}semua yang ada di sini berhak berada di sini{#Prev}."
      Speaker = "Circe"
      Event = "CirceAboutTyphon01"
    }
    {
      Id = "Circe_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Badai mengerikan yang menyelimuti gunung para dewa itu, tahu tidak, baru kemarin malam badainya {#Emph}mereda{#Prev}, berganti dengan cahaya rembulan yang begitu benderang! Kukira kau mungkin sudah berhasil menuntaskan urusanmu, {#Emph}hah! Aduh{#Prev}, tapi sekarang kau kembali, dan... badainya juga."
      Speaker = "Circe"
      Event = "CirceAboutTyphonW01"
    }
    {
      Id = "MelinoeField_3386"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ternyata Sang Ayah Segala Monster tidak semudah itu untuk dibujuk mundur... Entah siapa yang dendamnya lebih membara pada Dewa Zeus; Typhon, Prometheus, atau Chronos."
      Speaker = "Melinoe"
      Event = "CirceAboutTyphonW01"
    }
    {
      Id = "Circe_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Hecate dan dirimu juga sama-sama menuntut balas, kan. Kau sudah bertemu Charybdis di Celah ini, bukan? Kekuatan yang menelan segalanya! Kalau membayangkan soal balas dendam, yang terbayang olehku hanyalah rahang yang melahap apa pun itu..."
      Speaker = "Circe"
      Event = "CirceAboutTyphonW01"
    }
    {
      Id = "Circe_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, kacau sekali! Sudah kubilang pada Nyonya Hecate kalau memindahkan seluruh pulau ini pasti bakal menimbulkan efek samping tertentu. Tapi sampai tak sengaja menyeret Charybdis yang kejam ke sini? Yah, tentu bukan ke {#Emph}sini{#Prev}, tapi {#Emph}dekat sekali{#Prev}!"
      Speaker = "Circe"
      Event = "CirceAboutCharybdis01"
    }
    {
      Id = "MelinoeField_3523"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau dipikir-pikir, pusaran air raksasa bergigi dan bertentakel itu {#Emph}memang{#Prev} terasa agak ganjil berada di selat ini."
      Speaker = "Melinoe"
      Event = "CirceAboutCharybdis01"
    }
    {
      Id = "Circe_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya dia tak kekurangan kapal-kapal layar untuk dihantamkan ke rahangnya! Tapi, dia tidak merepotkanmu, kan, Manis...?"
      Speaker = "Circe"
      Event = "CirceAboutCharybdis01"
    }
    {
      Id = "Circe_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya apa yang sedang terjadi di gunung para dewa sana? Di malam-malam tertentu, gumpalan api raksasa membubung di cakrawala, disusul awan badai yang {#Emph}paling mengerikan {#Prev}yang pernah {#Emph}kulihat{#Prev}!"
      Speaker = "Circe"
      Event = "CirceAboutOlympus01"
    }
    {
      Id = "MelinoeField_3379"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemicu fenomena itu adalah serangan dua arah ke Gunung Olympus: dari Titan Prometheus beserta para penjarahnya, dan monster Typhon sendiri. Aku sedang menuju ke sana untuk menghadapi mereka."
      Speaker = "Melinoe"
      Event = "CirceAboutOlympus01"
    }
    {
      Id = "Circe_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga naga, maksudmu menghadapi mereka {#Emph}semua{#Prev}, Manis? Meski mungkin bahaya yang kau hadapi di {#Emph}bawah {#Prev}Bumi sana jauh lebih buruk! Kalau begitu, biar kulindungi dirimu semampuku...!"
      Speaker = "Circe"
      Event = "CirceAboutOlympus01"
    }
    {
      Id = "Circe_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sering lupa, kita masih punya ikatan darah, kan? Ayahku adalah Sang Mentari itu sendiri, Titan Helios. Rekan yang menjaga jarak dari para dewa! Tidak akrab dengan siapa pun. Tapi dia itu... saudara Nyonya Demeter, bibiku, yang merupakan nenekmu, benar kan...?"
      Speaker = "Circe"
      Event = "CirceAboutFamily01"
    }
    {
      Id = "MelinoeField_1973"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah Nyonya Circe, tepat sekali! Kurasa itu membuat kita sepupu jauh. Aku sendiri heran bagaimana orang-orang bisa menghafal silsilah yang rumit ini! Bagaimanapun juga, ikatan batin jauh lebih penting daripada hubungan darah, bukan?"
      Speaker = "Melinoe"
      Event = "CirceAboutFamily01"
    }
    {
      Id = "Circe_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar sekali! Tapi, maafkan aku ya kalau selama ini aku menarik diri dari semua itu. Di tengah keluarga, aku dituntut bersikap berbeda kepada setiap orang. Sampai-sampai aku nyaris lupa cara menjadi {#Emph}diriku sendiri! {#Prev}Segalanya jauh lebih sederhana di pulau ini."
      Speaker = "Circe"
      Event = "CirceAboutFamily01"
    }
    {
      Id = "MelinoeField_3383"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa malam lalu kau sempat menyinggung tentang {#Emph}kemampuan hebat kita untuk menaruh harapan{#Prev}. Itu mengingatkanku pada ucapan Prometheus sendiri, tapi waktu itu kuabaikan begitu saja..."
      Speaker = "Melinoe"
      Event = "CirceAboutHope01"
    }
    {
      Id = "Circe_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham kalau harapan saja tidaklah cukup bagi seseorang yang belajar begitu keras sepertimu! Namun bahkan dirimu pun, kurasa, memulai tiap malam dengan membuka diri pada kemungkinan segalanya berjalan sesuai rencanamu..."
      Speaker = "Circe"
      Event = "CirceAboutHope01"
    }
    {
      Id = "MelinoeField_3384"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi aku menyusun rencana untuk segala kemungkinan, dan bersiap berimprovisasi saat keadaan tak terelakkan berjalan di luar kendali. Persiapan dan antisipasi, bukan sekadar harapan."
      Speaker = "Melinoe"
      Event = "CirceAboutHope01"
    }
    {
      Id = "Circe_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebutlah sesukamu. Namun di balik semua yang kau jabarkan itu, ada sebutir benih dari sesuatu yang lebih bermakna; sumber dari segala daya dorong kita. Seperti api, ia harus dirawat, agar tak padam."
      Speaker = "Circe"
      Event = "CirceAboutHope01"
    }
    {
      Id = "Circe_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu yang terasa {#Emph}berbeda {#Prev}begitu kau tiba. Itu harum {#Emph}Moly{#Prev}, kan? Dan tampaknya {#Emph}banyak sekali{#Prev}! Kau tak butuh perlindungan semacam itu di sini. Keajaiban sekali tumbuhan itu tidak mengganggu sihirmu sendiri!"
      Speaker = "Circe"
      Event = "CirceAboutMoly01"
    }
    {
      Id = "MelinoeField_1974"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengumpulkan Moly sebanyak yang kutemukan di Erebus. Manfaatnya memang banyak, tapi di dalam kantongku ia tak menggangguku sama sekali, dan tetap segar. Kau tidak menyukainya? Padahal kukira kau menyayangi semua jenis tumbuhan dan herba."
      Speaker = "Melinoe"
      Event = "CirceAboutMoly01"
    }
    {
      Id = "Circe_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa tanaman justru membuatku waspada alih-alih sayang! Moly punya efek {#Emph}pengekang {#Prev}yang sama sekali tak kusukai! Saking bencinya, sampai-sampai aku belajar cara menetralkannya. Berhubung kau tak butuh kekuatannya di sini, tanaman itu takkan merugikan kita berdua! Tapi, tetaplah berhati-hati, Nona kecil."
      Speaker = "Circe"
      Event = "CirceAboutMoly01"
    }
    {
      Id = "Circe_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aha{#Prev}, sudah kuduga kau bakal tiba saat ini juga, Manis, {#Emph}haha! {#Prev}Tak butuh bakat meramal masa depan kok, murni intuisi dan kristal-kristalku di sekitar sini saja. Apa kau sudah memasukkan kristal ke dalam rutinitas{#Emph}mu{#Prev}?"
      Speaker = "Circe"
      Event = "CirceAboutCrystals01"
    }
    {
      Id = "MelinoeField_1976"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... aku sudah belajar melihat ke dalam Batu Hitam Pekat kami! Dulu kukira benda itu cuma berguna untuk menyembunyikan kita, tapi ternyata ada kegunaan ampuh lainnya juga. Kristal! Benar-benar penuh potensi."
      Speaker = "Melinoe"
      Event = "CirceAboutCrystals01"
    }
    {
      Id = "Circe_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karunia aneka warna dari Ibu Gaia, {#Emph}wah! {#Prev}Kadang aku iri kau tinggal di bawah Bumi tempat kristal dan batu permata tumbuh melimpah ruah! Betapa kemilau semuanya!"
      Speaker = "Circe"
      Event = "CirceAboutCrystals01"
    }
    {
      Id = "MelinoeField_3393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong-omong, mantra apa yang kau rapalkan malam demi malam itu, Nyonya? Memperkuat tenaga dalam, menyamarkan pulau, menyuburkan tanah, atau semacamnya?"
      Speaker = "Melinoe"
      Event = "CirceAboutMagick01"
    }
    {
      Id = "Circe_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku cuma sedang menyiapkan makan malam untuk babi-babi kecil di sana! Tadinya ingin kuajak kau makan bersama kami kapan-kapan, tapi hidangan seperti itu belum tentu cocok di lidah semua orang; lagipula kau punya urusan yang jauh lebih penting untuk diselesaikan!"
      Speaker = "Circe"
      Event = "CirceAboutMagick01"
    }
    {
      Id = "Circe_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aah{#Prev}, kau membawa Patung Kristal dariku! Harusnya benda itu bisa memberi sedikit tenaga di malam-malam genting seperti belakangan ini; dan pantulan cahaya bulannya tampak begitu indah, kurasa!"
      Speaker = "Circe"
      Event = "CirceAboutKeepsake01"
    }
    {
      Id = "MelinoeField_3387"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang indah, terima kasih, Nyonya. Di tempat asalku, satwa dan floranya sangat berbeda dari yang ada di sini. Memiliki lambang dari perbedaan itu sangat berharga bagiku."
      Speaker = "Melinoe"
      Event = "CirceAboutKeepsake01"
    }
    {
      Id = "Circe_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, satwa dan flora memang sahabat terbaik, ya kan? Mereka mau mendengarkan! Dan mereka bicara dari jiwa, bukan dengan lidah bercabang penuh tipu daya. {#Emph}Ah{#Prev}, tapi sudahlah, mari kita persiapkan keberangkatanmu!"
      Speaker = "Circe"
      Event = "CirceAboutKeepsake01"
    }
    {
      Id = "Circe_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau punya Familiar Hewan di situ, Manis! Senang sekali rasanya melihat seekor satwa dan {#Emph}dirimu {#Prev}terikat begitu erat! Masing-masing menjadi sumber rasa aman dan sandaran! Pola siklus yang indah, seperti {#Emph}banyak {#Prev}hal lainnya!"
      Speaker = "Circe"
      Event = "CirceAboutFrogFamiliar01"
    }
    {
      Id = "MelinoeField_3388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Circe, perkenalkan ini Frinos, sahabat karibku tempatku selalu berkeluh kesah. Dari sekian banyak pengetahuanmu soal Familiar, adakah satu hal yang paling kau sesali tak kau ketahui sejak awal?"
      Speaker = "Melinoe"
      Event = "CirceAboutFrogFamiliar01"
    }
    {
      Id = "Circe_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, jelas {#Emph}ada! {#Prev}Meski begitu, kau tak boleh melewatkan nikmatnya proses penemuan dalam perjalanan yang sedang kau tempuh ini. Tapi mungkin ada sepatah dua patah kata yang bisa kubagikan..."
      Speaker = "Circe"
      Event = "CirceAboutFrogFamiliar01"
    }
    {
      Id = "Circe_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gagak yang sungguh menawan! Jarang ada burung laut yang berani bertualang sejauh ini, dan aku biasanya mengusir sisanya."
      Speaker = "Circe"
      Event = "CirceAboutRavenFamiliar01"
    }
    {
      Id = "MelinoeField_4745"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya, ini Raki. Aku yakin dia lebih nyaman di hutan Erebus, tapi terbukti dia mau ikut menjelajah."
      Speaker = "Melinoe"
      Event = "CirceAboutRavenFamiliar01"
    }
    {
      Id = "Circe_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Raki, ya? Bagaimana kabarmu, burung kecil? Pulau ini mestinya jadi tempat bersantap yang sempurna sampai kau siap berangkat lagi. {#Emph}Oh{#Prev}, jaga diri kalian baik-baik!"
      Speaker = "Circe"
      Event = "CirceAboutRavenFamiliar01"
    }
    {
      Id = "Circe_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kucing kecil di sana itu, dia pasti bersamamu! Kasihan sekali dia pasti sangat membenci air di mana-mana, tapi tidak menunjukkan tanda-tanda merajuk... yah, tidak lebih dari sifat alami makhluk sepertinya."
      Speaker = "Circe"
      Event = "CirceAboutCatFamiliar01"
    }
    {
      Id = "MelinoeField_4746"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Circe, ini Familier-ku, Toula. Dia mungkin lebih terbiasa dengan air dibanding kebanyakan kucing... Aku menemukannya di dermaga Ephyra, meski dia tampak ingin segera pergi dari sana."
      Speaker = "Melinoe"
      Event = "CirceAboutCatFamiliar01"
    }
    {
      Id = "Circe_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Halo, Toula! Jiwanya kuat sekali, itu langsung terlihat jelas. Dan kalau dia memang seekor kucing sejati, dia akan segera merasa betah seperti di rumah sendiri!"
      Speaker = "Circe"
      Event = "CirceAboutCatFamiliar01"
    }
    {
      Id = "Circe_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, bukankah ini Hecuba yang anggun dan santun di sisimu! Belum pernah aku bertemu anjing yang begitu berwibawa. Lady Hecate mengizinkanmu bepergian berdampingan dengannya!"
      Speaker = "Circe"
      Event = "CirceAboutHoundFamiliar01"
    }
    {
      Id = "MelinoeField_4747"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya Hecuba juga masih mengingatmu, Nyonya. Apakah Anda memang selalu memiliki ikatan kuat dengan para hewan, atau Ibu Kepala Asrama yang membimbingmu?"
      Speaker = "Melinoe"
      Event = "CirceAboutHoundFamiliar01"
    }
    {
      Id = "Circe_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh ho ho{#Prev}, dua-duanya! Kalau bukan karena bakat alamiku, barangkali aku takkan layak menerima ajaran Sang Dewi. Dan kau sendiri jelas-jelas telah memenangkan kepercayaan terdalam darinya!"
      Speaker = "Circe"
      Event = "CirceAboutHoundFamiliar01"
    }
    {
      Id = "Circe_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, bukankah ini si Gale kecil yang berlarian kian kemari di dekat kakimu! Jarang-jarang aku menemui makhluk kecil yang selicik dia. Jadi Lady Hecate menugaskannya padamu?"
      Speaker = "Circe"
      Event = "CirceAboutPolecatFamiliar01"
    }
    {
      Id = "MelinoeField_4748"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa dibilang begitu! Aku menemukan Gale di Olympus, tempat yang memang sedang kutuju. Apa cerpelai kecil ini benar-benar senakal yang Nyonya maksud? Dia berkelakuan sangat baik bersamaku!"
      Speaker = "Melinoe"
      Event = "CirceAboutPolecatFamiliar01"
    }
    {
      Id = "Circe_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anggap saja dirimu beruntung, Sayang. Yang satu itu masih cukup liar! Barangkali dia cuma mulai jinak sedikit seiring bertambahnya usia."
      Speaker = "Circe"
      Event = "CirceAboutPolecatFamiliar01"
    }
    {
      Id = "Circe_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar Descura-ku yang {#Emph}luar biasa{#Prev}, Nona Manis? Aku tahu kau penerus berikutnya, tapi aku masih merasa agak emosional melihat tongkat kesayanganku lagi, {#Emph}hohoho. {#Prev}Lady Hecate harus mendesakku lebih dari {#Emph}sekadar{#Prev} membujuk agar aku mau merelakannya, {#Emph}hehehoho!"
      Speaker = "Circe"
      Event = "CirceAboutCirceAspect01"
    }
    {
      Id = "MelinoeField_1975"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah berusaha sekuat tenaga untuk mengayunkan Descura dengan penuh hormat; demi menghargai para pemegang Tongkat Penyihir terdahulu. Dan tongkat ini... atau lebih tepatnya dia telah melayaniku dengan baik. Kehadiranku di sini adalah buktinya. Apakah Anda... ingin menggenggamnya lagi?"
      Speaker = "Melinoe"
      Event = "CirceAboutCirceAspect01"
    }
    {
      Id = "Circe_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tidak, jangan! Masa-masaku dengannya sudah berlalu. Lagipula, dia sudah lama terasa berat di tanganku sebelum akhirnya kuserahkan. Semoga dia melindungimu segarang yang kutahu dia mampu!"
      Speaker = "Circe"
      Event = "CirceAboutCirceAspect01"
    }
    {
      Id = "Circe_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah menjadi ibu yang layak bagi Descura, aku bisa merasakannya. Memuaskan nafsu makannya dengan banyak jiwa! Karena itu, aku ingin membagikan sebuah {#Emph}mimpi{#Prev} yang kuingat sangat jelas..."
      Speaker = "Circe"
      Event = "CirceGrantsHiddenAspect01"
    }
    {
      Id = "MelinoeField_3398"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mimpi tentang diriku dan Tongkat Senja, Nyonya? Kedengarannya cukup spesifik. Meski mimpi terkadang memang bisa seperti itu..."
      Speaker = "Melinoe"
      Event = "CirceGrantsHiddenAspect01"
    }
    {
      Id = "Circe_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam mimpi itu, awalnya kulihat apa yang kusangka sebagai serigala jakal, dikelilingi oleh orang-orang mati. Pemandangan sosoknya sungguh menakjubkan, seraya kata-kata ini bergema di benakku: {#Emph}Kulihat dirimu menjaga makam para fana yang berpulang ke kegelapan seberang."
      Speaker = "Circe"
      Event = "CirceGrantsHiddenAspect01"
    }
    {
      Id = "MelinoeField_3399"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kulihat dirimu menjaga makam para fana yang berpulang ke kegelapan seberang. {#Prev}Kedengarannya seperti kalimat pembangun mantra. Jadi kalau kuucapkan ini pada Descura di tepi Kolam Perak..."
      Speaker = "Melinoe"
      Event = "CirceGrantsHiddenAspect01"
    }
    {
      Id = "Circe_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maka kuramalkan dia akan menyingkapkan suatu Aspek dari dirinya kepadamu! Sebagai mantan pembawanya, keterikatanmu denganku bukanlah suatu kebetulan! Karena itu pengetahuan ini sudah semestinya menjadi milikmu."
      Speaker = "Circe"
      Event = "CirceGrantsHiddenAspect01"
    }
    {
      Id = "Circe_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau sudah bicara dengan Descura seperti saranku, Nona Manis? Kata-kata itu masih terus terngiang di benakku: {#Emph}Kulihat dirimu menjaga makam para fana yang berpulang ke kegelapan seberang."
      Speaker = "Circe"
      Event = "CirceAboutHiddenAspectProgress01"
    }
    {
      Id = "MelinoeField_3492"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih ragu-ragu, Nyonya. Bagaimana jika ini adalah kekuatan yang belum sanggup kutanggung? Kalau Descura memang ingin menyingkapkan Aspek ini padaku, kenapa harus ada syarat tambahan?"
      Speaker = "Melinoe"
      Event = "CirceAboutHiddenAspectProgress01"
    }
    {
      Id = "Circe_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena sebagian pengetahuan memang harus diwariskan. Waktu kita sebagai pembawa Descura ada batasnya, tapi tanggung jawab kita terhadap alam Malam tidak akan pernah pudar."
      Speaker = "Circe"
      Event = "CirceAboutHiddenAspectProgress01"
    }
    {
      Id = "Circe_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh luar biasa, kau membawa Descura dalam Aspek yang kulihat di mimpiku! Jadi pesan yang kusampaikan itu memang beresonansi. Apa yang bisa kuceritakan tentang wujud barunya?"
      Speaker = "Circe"
      Event = "CirceAboutHiddenAspect01"
    }
    {
      Id = "MelinoeField_3493"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini adalah Aspek dari dewa kematian... bukan ayahku, melainkan sosok bernama Anubis. Jauh dari kita baik dari segi tempat maupun zaman, tapi dia adalah pelindung Dunia Bawah dengan caranya sendiri. Terima kasih telah membimbingku menemukan ini."
      Speaker = "Melinoe"
      Event = "CirceAboutHiddenAspect01"
    }
    {
      Id = "Circe_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama-sama, tentu saja, Sayang! Anubis, ya namanya? Tak kusangka ada dewa kematian lain selain ayahmu! Tapi kalau para Takdir membebaninya {#Emph}tanggung jawab{#Prev} itu, barangkali mereka juga membebankannya pada yang lain... atau kelak akan melakukannya."
      Speaker = "Circe"
      Event = "CirceAboutHiddenAspect01"
    }
    {
      Id = "Circe_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuat sekali ikatan yang kau jalin dengan para Familier-mu, Sayang! Tidak ada yang lebih mencerminkan kepribadian seseorang selain dicintai oleh binatang. Apa rahasiamu?"
      Speaker = "Circe"
      Event = "CirceAboutFamiliars01"
    }
    {
      Id = "MelinoeField_4749"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... sejujurnya mereka semua sepertinya cuma suka Camilan Penyihir. Itu resep ajaib warisan dari Ibu Kepala Asrama... atau bolehkah kutebak, mungkin sebenarnya berasal dari Nyonya?"
      Speaker = "Melinoe"
      Event = "CirceAboutFamiliars01"
    }
    {
      Id = "Circe_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}hahahaha! {#Prev}Aku takkan mengakui tuduhan itu; tapi inilah rahasiaku sendiri: Camilan Penyihir sebenarnya tak seampuh yang kaukira. Cinta dari para Familier-mulah yang paling utama."
      Speaker = "Circe"
      Event = "CirceAboutFamiliars01"
    }
    {
      Id = "Circe_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku terkesan dengan caramu merawat para Familier-mu, Sayang! Atas kehendak Lady Hecate, aku memiliki pengetahuan tertentu mengenai hal ini yang kini akan kuberikan padamu."
      Speaker = "Circe"
      Event = "CirceGrantsFamiliarCostumes01"
    }
    {
      Id = "MelinoeField_4531"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, terima kasih Nyonya! Pengetahuan macam apa yang Anda maksud? Anda pasti mengenal hewan lebih baik daripada siapa pun."
      Speaker = "Melinoe"
      Event = "CirceGrantsFamiliarCostumes01"
    }
    {
      Id = "Circe_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau akan tahu, {#Emph}kau akan tahu! {#Prev}Ini salah satu hal kesukaanku, jadi aku tak mau merusak kejutannya!"
      Speaker = "Circe"
      Event = "CirceGrantsFamiliarCostumes01"
    }
    {
      Id = "Circe_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, aku hampir tak mengenali Hewan Familier-mu itu, yang artinya kau telah memanfaatkan Pengubahan Wujud Familier dengan {#Emph}baik! {#Prev}{#Emph}Hah! {#Prev}Apakah hewan-hewan kecilmu menyukai perubahan besar ini?"
      Speaker = "Circe"
      Event = "CirceAboutFamiliarCostumes01"
    }
    {
      Id = "MelinoeField_4533"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka sama sekali tidak mengeluh! Meski perubahan yang kulihat tampaknya hanya memengaruhi penampilan luar mereka saja. Apa memang itu hasil yang diharapkan?"
      Speaker = "Melinoe"
      Event = "CirceAboutFamiliarCostumes01"
    }
    {
      Id = "Circe_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, iya! Itu setara dengan berganti gaun atau gaya bagi seorang Familier. Akhir-akhir ini, kita sendiri punya sedikit waktu untuk memanjakan diri seperti itu, tapi setidaknya kita bisa memanjakan kawan-kawan kita!"
      Speaker = "Circe"
      Event = "CirceAboutFamiliarCostumes01"
    }
    {
      Id = "Circe_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eugh{#Prev}, aura milikmu mengerikan sekali, kalau boleh jujur, Sayang! Penderitaan yang kau tanggung malam ini begitu berat; maafkan aku, tapi kau tak boleh berlama-lama di sini..."
      Speaker = "Circe"
      Event = "CirceLowHealth01"
    }
    {
      Id = "MelinoeField_3389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan keadaanku yang menyedihkan ini, Nyonya. Lautan tadi sungguh ganas, belum lagi nekropolis luas yang terpaksa kuseberangi. Tapi semua itu cuma dalih belaka..."
      Speaker = "Melinoe"
      Event = "CirceLowHealth01"
    }
    {
      Id = "Circe_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar kuberi bantuan semampuku, tapi demi langit, {#Emph}jangan {#Prev}larut dalam kesedihan lagi! Waktumu tak banyak! Paling buruk, kembalilah ke dalam bayangan, istirahat, lalu maju lagi."
      Speaker = "Circe"
      Event = "CirceLowHealth01"
    }
    {
      Id = "Circe_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh kulihat tanganmu lagi, Nona kecil? {#Emph}Mm, oh, hmm... {#Prev}masih belum ada apa-apa setelah sekian lama. Setidaknya, pada tangan kirimu. Mungkinkah bakat membaca garis tanganku yang masih kurang mumpuni..."
      Speaker = "Circe"
      Event = "CirceAboutPalmistry01"
    }
    {
      Id = "MelinoeField_4752"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya, tangan kiriku ini bahkan nyaris tembus pandang. Tanganku selalu menolak pembacaanmu semenjak keadaannya jadi seperti ini. Mana mungkin ada yang berubah?"
      Speaker = "Melinoe"
      Event = "CirceAboutPalmistry01"
    }
    {
      Id = "Circe_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu, aku tahu, hanya saja... aku belum pernah bertemu orang yang garis tangannya sama sekali {#Emph}tak memperlihatkan {#Prev}masa depannya seperti ini! Tiga Takdir pasti merencanakan sesuatu untukmu, tapi jejaknya sama sekali tak terlihat!"
      Speaker = "Circe"
      Event = "CirceAboutPalmistry01"
    }
    {
      Id = "Circe_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ke mana saja kau selama ini, Sayang? Banyak sekali keanehan yang terjadi, dan setiap kejadian {#Emph}makin aneh {#Prev}dari yang sebelumnya! Kapal-kapal layar mengerikan di luar sana {#Emph}semuanya {#Prev}seperti kehilangan {#Emph}arah haluan{#Prev}, misalnya. Aku tak tahu apa yang terjadi!"
      Speaker = "Circe"
      Event = "CircePostTrueEnding01"
    }
    {
      Id = "MelinoeField_4534"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos sudah dikalahkan, Nyonya... dan maksudku untuk selamanya! Itu sebabnya pasukannya tampak sangat kacau, meski mereka belum lenyap seutuhnya, begitu pula dirinya. Apakah Kepala Sekolah belum mengabarinya?"
      Speaker = "Melinoe"
      Event = "CircePostTrueEnding01"
    }
    {
      Id = "Circe_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga naga, ya ampun, {#Emph}tidak! {#Prev}Kecuali... yah, aku memang sangat terasing di sini, mungkin saja aku melewatkan pesan darinya, aku... {#Emph}oh! {#Prev}Jadi maksudmu kau berhasil menang?"
      Speaker = "Circe"
      Event = "CircePostTrueEnding01"
    }
    {
      Id = "MelinoeField_4535"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu, {#Emph}ya! {#Prev}Kini yang tersisa hanyalah memastikan dia takkan pernah bangkit lagi melawan para dewa, selamanya. Baik dia maupun Typhon."
      Speaker = "Melinoe"
      Event = "CircePostTrueEnding01"
    }
    {
      Id = "Circe_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! Ah, astaga... hah, ya ampun{#Prev}, ini, {#Emph}oh! {#Prev}Aku harus segera berunding dengan Nyonya Hecate! Tapi sebelumnya, ayo cepat, tentukan pilihanmu!"
      Speaker = "Circe"
      Event = "CircePostTrueEnding01"
    }
    {
      Id = "Circe_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Hecate mengonfirmasi setiap rincian pencapaianmu, meski dengan sikap yang {#Emph}jauh {#Prev}kurang rendah hati dibanding dirimu! {#Emph}Oh... {#Prev}sungguh pencapaian yang luar biasa, Sayang...!"
      Speaker = "Circe"
      Event = "CircePostTrueEnding02"
    }
    {
      Id = "MelinoeField_4536"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Nyonya Circe. Tanpa sihir pemikatmu, aku mungkin takkan pernah mencapai puncak Olympus, yang mana merupakan langkah krusial. Kau tak keberatan jika kita terus bekerja sama seperti ini?"
      Speaker = "Melinoe"
      Event = "CircePostTrueEnding02"
    }
    {
      Id = "Circe_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, aku malah keberatan kalau kita menyudahinya! Selama masih ada hal yang harus kau selesaikan, kau bisa sepenuhnya mengandalkan bantuanku!"
      Speaker = "Circe"
      Event = "CircePostTrueEnding02"
    }
    {
      Id = "Circe_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuaca di Olympus akhir-akhir ini membaik, dari sini sering kulihat begitu cerah! Tak ada lagi jejak makhluk mengerikan yang kau hadapi tempo hari."
      Speaker = "Circe"
      Event = "CircePostTrueEnding03"
    }
    {
      Id = "MelinoeField_4537"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sisa-sisa Typhon memang masih ada, meski nyaris tak kasatmata. Namun sisa-sisa itu bisa dimusnahkan."
      Speaker = "Melinoe"
      Event = "CircePostTrueEnding03"
    }
    {
      Id = "Circe_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau sedang menuju gunung itu demi menuntaskannya. Typhon bukan sepenuhnya makhluk alami; itulah yang membedakan monster dari binatang buas! Jadi aku takkan meratapi kematiannya, kurasa orang lain pun demikian."
      Speaker = "Circe"
      Event = "CircePostTrueEnding03"
    }
    {
      Id = "Circe_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Hecate memberitahuku kabar yang luar biasa... kau berpapasan dengan Tiga Takdir? Jarang sekali ada yang bisa membanggakan hal {#Emph}itu, hah! Ooh... {#Prev}apa kau sempat melihat telapak tangan mereka?"
      Speaker = "Circe"
      Event = "CircePostEpilogue01"
    }
    {
      Id = "MelinoeField_4538"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayangnya tidak, Nyonya, mereka terselubung dalam kegelapan saat aku menjumpai mereka. Bagaimana pendapatmu tentang ramalan baru mereka...?"
      Speaker = "Melinoe"
      Event = "CircePostEpilogue01"
    }
    {
      Id = "Circe_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, ramalan bahwa zaman pada akhirnya akan {#Emph}berubah? Hah! {#Prev}Menurutku itu {#Emph}bukan {#Prev}ramalan mereka yang paling berani, kalau kau mau tahu pendapatku! Kalau hidupmu cukup panjang, kau akan tahu bahwa zaman {#Emph}tidak {#Prev}berubah, melainkan berputar bagai roda."
      Speaker = "Circe"
      Event = "CircePostEpilogue01"
    }
    {
      Id = "Circe_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini terasa makin damai, bukan? Mengingat situasinya, dengan segala kapal layar mengerikan itu dan sebagainya. Tapi sekarang ritmenya terasa menyenangkan. Menghadirkan rasa tenang..."
      Speaker = "Circe"
      Event = "CirceAboutSayingLittle01"
    }
    {
      Id = "Circe_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku bisa menyihirmu menjadi apa saja, {#Emph}menurutku {#Prev}kau sudah {#Emph}nyaris sempurna {#Prev}apa adanya!"
      Speaker = "Circe"
      Event = "CirceChat01"
    }
    {
      Id = "Circe_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anggap saja rumah sendiri, meski aku tahu kau tak bisa tinggal lama-lama. Mana telapak tanganmu?"
      Speaker = "Circe"
      Event = "CirceChat02"
    }
    {
      Id = "Circe_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Pasti ada salep, ramuan, atau tapal di sini yang sangat cocok untukmu!"
      Speaker = "Circe"
      Event = "CirceChat03"
    }
    {
      Id = "Circe_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingatlah bahwa kita tak bisa mengubah siapa diri kita, Sayang. Hanya wujud {#Emph}apa. {#Prev}Nah, sekarang: telapak tanganmu."
      Speaker = "Circe"
      Event = "CirceChat04"
    }
    {
      Id = "Circe_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, betapa beruntungnya kita bisa bertemu lagi di malam yang memesona seperti ini!"
      Speaker = "Circe"
      Event = "CirceChat05"
    }
    {
      Id = "Circe_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hidupku di sini cukup damai. Sangat kurekomendasikan setelah perangmu selesai nanti!"
      Speaker = "Circe"
      Event = "CirceChat06"
    }
    {
      Id = "Circe_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu kata-kata selama berada di Pulau Aiaia, Nona kecil. Tatapanmu saja sudah menjelaskan segalanya!"
      Speaker = "Circe"
      Event = "CirceChat07"
    }
    {
      Id = "Circe_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingin kuajak kau minum teh, tapi aku tahu kau harus bergegas pergi. Lain waktu, ya?"
      Speaker = "Circe"
      Event = "CirceChat08"
    }
    {
      Id = "Circe_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Babi-babi kecilku memekik gembira saat kuramalkan kau akan berkunjung lagi malam ini!"
      Speaker = "Circe"
      Event = "CirceChat09"
    }
    {
      Id = "Circe_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jarang-jarang aku dan babi-babi kecilku menyambut tamu, pulau kecil ini kan nyaris mustahil ditemukan!"
      Speaker = "Circe"
      Event = "CirceChat10"
    }
    {
      Id = "Circe_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau aman dan disambut hangat di sini, Nona kecil! Tarik napas dalam-dalam, rilekskan bahu dan pikiranmu..."
      Speaker = "Circe"
      Event = "CirceChat11"
    }
    {
      Id = "Circe_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tak bisa mengubah diri kita {#Emph}sepenuhnya{#Prev}, Sayang, tapi: Kita bisa sedikit mengubah peruntungan kita! {#Emph}Hahaha, haha!"
      Speaker = "Circe"
      Event = "CirceChat12"
    }
    {
      Id = "Circe_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga, kau menjelma menjadi {#Emph}dewi muda yang begitu memikat{#Prev}, dari malam ke malam!"
      Speaker = "Circe"
      Event = "CirceChat13"
    }
    {
      Id = "Circe_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan mengubah apa pun darimu, Sayang. Tapi aku bisa! Kita buat sementara saja untuk berjaga-jaga!"
      Speaker = "Circe"
      Event = "CirceChat14"
    }
    {
      Id = "Circe_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunung para dewa sudah tidak begitu jauh lagi di depan! Ayo kita persiapkan dirimu untuk pendakian {#Emph}brutal {#Prev}itu!"
      Speaker = "Circe"
      Event = "CirceChat15"
    }
    {
      Id = "Circe_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hidup itu hanyalah serangkaian transformasi kecil yang terus berulang, nona kecil."
      Speaker = "Circe"
      Event = "CirceChat16"
    }
    {
      Id = "Circe_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pikiran dan pilihanmu membentuk siapa dirimu, tapi aku bisa membuatmu menjadi sesuatu yang {#Emph}lebih!"
      Speaker = "Circe"
      Event = "CirceChat17"
    }
    {
      Id = "Circe_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita semua berusaha menemukan jati diri sejati kita, tapi pencarian itu sering kali panjang dan sulit! Jadi, mari kita bersiap-siap."
      Speaker = "Circe"
      Event = "CirceChat18"
    }
    {
      Id = "Circe_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gubuk kecilku ini benar-benar memalukan dan berantakan! Yah, takkan ada yang tahu juga selain diriku."
      Speaker = "Circe"
      Event = "CirceChat19"
    }
    {
      Id = "Circe_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lewat kristal-kristalku, aku sudah meramalkan perjalananmu malam ini, dan aku sangat senang kau menerima undanganku untuk kembali!"
      Speaker = "Circe"
      Event = "CirceChat20"
    }
    {
      Id = "Circe_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemandangan yang menyenangkan di malam yang mengerikan ini! Tapi kita akan mengubahnya menjadi lebih baik di sini."
      Speaker = "Circe"
      Event = "CirceChat21"
    }
    {
      Id = "Circe_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Secara alami kita tidaklah kekal tanpa perubahan, dan mengubah diri kita berarti menjadi {#Emph}siapa diri kita sebenarnya..."
      Speaker = "Circe"
      Event = "CirceChat22"
    }
    {
      Id = "Circe_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meskipun aku sudah terbiasa menyendiri, kedatanganmu jauh lebih kusambut dengan hangat."
      Speaker = "Circe"
      Event = "CirceChat23"
    }
    {
      Id = "Circe_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkinkah malam ini kau bisa memanfaatkan salah satu mantra sihir yang sudah kusiapkan?"
      Speaker = "Circe"
      Event = "CirceChat24"
    }
    {
      Id = "Circe_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunung di seberang sana masih membutuhkanmu bahkan hingga saat ini, bukan begitu, nona kecil?"
      Speaker = "Circe"
      Event = "CirceChat25"
    }
    {
      Id = "Circe_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjalanan ini pastilah melelahkan, jadi tolong, beristirahatlah sejenak dari pelayaranmu selagi ada di sini."
      Speaker = "Circe"
      Event = "CirceChat26"
    }
    {
      Id = "Circe_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Manakah dari berbagai mantraku yang paling bermanfaat bagimu malam ini, sayang?"
      Speaker = "Circe"
      Event = "CirceChat27"
    }
    {
      Id = "Circe_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kubilang pada babi-babiku kalau kau pasti akan mampir lagi malam ini, {#Emph}ahah! {#Prev}Dan benar saja, kau di sini!"
      Speaker = "Circe"
      Event = "CirceChat28"
    }
    {
      Id = "Circe_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mantra-mantraku sudah siap sedia agar tidak menunda perjalananmu lebih lama dari yang kauinginkan."
      Speaker = "Circe"
      Event = "CirceChat29"
    }
    {
      Id = "Circe_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tersembunyi dan terlindungi dengan sangat baik di sini, sayang. Pegang kata-kataku untuk yang satu itu."
      Speaker = "Circe"
      Event = "CirceChat30"
    }
    {
      Id = "Circe_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Hekate telah mempersiapkanmu dengan baik untuk bertahan hidup di alam liar!"
      Speaker = "Circe"
      Event = "CirceChat31"
    }
    {
      Id = "Circe_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang aku merindukan Persimpangan, tapi jelas babi-babiku membutuhkanku di sini."
      Speaker = "Circe"
      Event = "CirceChat32"
    }
    {
      Id = "Circe_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa mengubah siapa atau apa jati dirimu, tapi sudah pasti bisa mengubah hampir segala hal lainnya!"
      Speaker = "Circe"
      Event = "CirceChat33"
    }
    {
      Id = "Circe_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya sedikit masalah yang sampai ke pulau ini, tapi aku tahu para dewa Olimpus punya masalah segudang."
      Speaker = "Circe"
      Event = "CirceChat34"
    }
    {
      Id = "Circe_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah terlalu banyak malam terlewat sejak terakhir kali kau berkunjung, sayang! Segeralah kembali lagi, ya!"
      Speaker = "Circe"
      Event = "CirceChat35"
    }
    {
      Id = "Circe_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga hasil malam ini sama mujurnya seperti malam sebelumnya!"
      Speaker = "Circe"
      Event = "CirceChat36"
    }
    {
      Id = "Circe_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kumohon, beristirahatlah di sini sejenak sebelum kembali ke kapal-kapal mengerikan di luar sana!"
      Speaker = "Circe"
      Event = "CirceChat37"
    }
    {
      Id = "Circe_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menemukanku lagi, sayang, dan atas pencapaian itu, kau berhak mendapatkan hadiah sihir yang memikat!"
      Speaker = "Circe"
      Event = "CirceChat38"
    }
    {
      Id = "Circe_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pendakian yang harus kautempuh sangatlah sulit, tapi mari kita pastikan kau benar-benar siap menghadapinya."
      Speaker = "Circe"
      Event = "CirceChat39"
    }
    {
      Id = "Circe_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang di pulau kecilku, nona kecil! Coba perlihatkan telapak tanganmu padaku."
      Speaker = "Circe"
      Event = "CirceChat40"
    }
    {
      Id = "MelinoeField_1943"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Circe, aku bersyukur kita berkesempatan bertemu lagi setelah sekian lama. Kebaikanmu padaku selalu sangat berarti, dan aku ingin memberikan tanda mata kecil ini sebagai balasannya."
      Speaker = "Melinoe"
      Event = "CirceGift01"
    }
    {
      Id = "Circe_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nektar! Ohh, terima kasih{#Prev}, nona kecil! Aku sudah sering mencoba meracik buatanku sendiri tapi tak pernah berhasil! Omong-omong, ambillah {#Emph}ini {#Prev}sebagai gantinya! Anggap saja ini oleh-oleh kecil dari pulau ini!"
      Speaker = "Circe"
      Event = "CirceGift01"
    }
    {
      Id = "Circe_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga naga! Lagi, untuk{#Emph}ku? {#Prev}Aku tak terbiasa menerima hadiah di pulau kecilku ini. Tapi aku senang untuk membiasakan diri, {#Emph}ahaha! {#Prev}Kalau kau memang begitu {#Emph}bersikeras!"
      Speaker = "Circe"
      Event = "CirceGift02"
    }
    {
      Id = "MelinoeField_1945"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bersikeras {#Prev}mungkin kata yang terlalu keras, Nyonya, tapi aku memang ingin Anda menerimanya. Barangkali ini bisa membantumu menyempurnakan resepmu sendiri... atau sekadar menemani malam yang tenang, jika ada waktu luang."
      Speaker = "Melinoe"
      Event = "CirceGift02"
    }
    {
      Id = "Circe_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak semua dewa menuntut persembahan, tahu. Kerabat Olimpus kita... mereka selalu mengharapkan pemberian semacam ini, tapi tidak denganku! Jangan coba-coba memanjakanku, ya!"
      Speaker = "Circe"
      Event = "CirceGift03"
    }
    {
      Id = "MelinoeField_3524"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olimpus memang sudah sangat terbiasa menerima persembahan dari seantero negeri. Tinggal di pulau terpencil seperti ini, kurasa Anda takkan sampai semanja itu!"
      Speaker = "Melinoe"
      Event = "CirceGift03"
    }
    {
      Id = "Circe_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah{#Prev}, ini {#Emph}luar biasa! {#Prev}Aku sangat berterima kasih, nona kecil! Kaum kita sering kali kekurangan teman; kehadiran sosok sepertimu yang sesekali berkunjung, ini adalah angin segar yang menyenangkan, terlepas dari tugas mengerikan yang sedang dihadapi, {#Emph}hahahaha!"
      Speaker = "Circe"
      Event = "CirceGift04"
    }
    {
      Id = "MelinoeField_3525"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan jika dan saat semua ini berakhir suatu hari nanti, aku tetap ingin kita terus bertemu seperti ini. Pulaumu adalah tempat yang menakjubkan, dan aku benar-benar mengagumi dedikasimu pada seni sihir kita."
      Speaker = "Melinoe"
      Event = "CirceGift04"
    }
    {
      Id = "Circe_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang aku khawatir hatimu sudah membeku... mengeras karena semua kekacauan ini. Namun nyatanya, kau justru menunjukkan kebaikan seperti ini padaku! Kau telah belajar banyak, meski kelembutan budi pekerti ini tampaknya sudah mengalir di darahmu sejak lahir!"
      Speaker = "Circe"
      Event = "CirceGift05"
    }
    {
      Id = "MelinoeField_4521"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, aku... ini cuma Nektar, yang kurasa pasti tidak mudah didapat di sini. Belakangan ini di Olympus pun persediaannya menipis! Tapi, aku bersyukur kau melihat sesuatu dalam diriku, apa pun itu."
      Speaker = "Melinoe"
      Event = "CirceGift05"
    }
    {
      Id = "Circe_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh, {#Prev}terima kasih banyak, nona kecil, {#Emph}lagi-lagi! {#Prev}Nektar yang kaubawakan ini rasanya begitu manis, namun perasaanku terhadapnya belakangan ini agak sedikit {#Emph}berkabut{#Prev}... jadi, bisakah ini menjadi yang terakhir untuk saat ini...?"
      Speaker = "Circe"
      Event = "CirceGift06"
    }
    {
      Id = "MelinoeField_4522"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Madame {#Prev}Circe, apa ada perbuatan atau perkataanku yang salah? Kau tinggal menyendiri di pulaumu ini, jadi kupikir mungkin kau ingin menikmati sedikit kemewahan eksotis..."
      Speaker = "Melinoe"
      Event = "CirceGift06"
    }
    {
      Id = "Circe_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku sangat menikmatinya! Tapi setiap botolnya mengingatkanku pada kehidupan masa lalu yang bergelimang kemewahan... yang sebagian besarnya telah kutinggalkan. Dan aku tak berniat untuk kembali ke masa itu."
      Speaker = "Circe"
      Event = "CirceGift06"
    }
    {
      Id = "MelinoeField_4523"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat paham. Tapi terima kasih banyak, {#Emph}Madame{#Prev}. Atas semua kebijaksanaanmu, dan telah menerimaku sebagai tamumu."
      Speaker = "Melinoe"
      Event = "CirceGift06"
    }
    {
      Id = "MelinoeField_4525"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau sedang tidak menginginkan Nektar saat ini, {#Emph}Madame{#Prev}, tapi kupikir mungkin kau tertarik dengan yang satu ini? Untuk sihirmu, atau bahkan untuk sahabat-sahabat hewanmu."
      Speaker = "Melinoe"
      Event = "CirceGift07"
    }
    {
      Id = "Circe_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Astaga! {#Prev}Bukankah ini {#Emph}Ambrosia! {#Prev}Hadiah yang luar biasa berharga, bahkan bisa menjadi lentera kemilau di malam-malam gelap gulita begini! Dalam rangka apa ini diberikan? Rasanya tak ada perayaan yang {#Emph}kuingat{#Prev}?"
      Speaker = "Circe"
      Event = "CirceGift07"
    }
    {
      Id = "MelinoeField_4526"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, berhubung kau telah banyak mengajariku cara mewujudkan kehendak batinku... kurasa tindakan memberi ini sendiri sudah cukup menjadikannya perayaan istimewa, bukan?"
      Speaker = "Melinoe"
      Event = "CirceGift07"
    }
    {
      Id = "Circe_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh {#Emph}benar, terima kasih{#Prev}! Kalau begitu, demi keberuntungan pertemuan kita, saat ini dan seterusnya! Soal apakah aku akan menyimpannya sendiri atau membaginya ke babi-babi kecilku, sepertinya aku harus merenungkannya sejenak..."
      Speaker = "Circe"
      Event = "CirceGift07"
    }
    {
      Id = "MelinoeField_4527"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Silakan dinikmati!"
      Speaker = "Melinoe"
      Event = "CirceGift07"
    }
    {
      Id = "MelinoeField_4528"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sempat bilang ragu hendak menyimpan Ambrosia sebelumnya atau membagikannya ke babi-babi kecilmu. Jadi, izinkan aku meringankan dilema mustahil itu."
      Speaker = "Melinoe"
      Event = "CirceGift08"
    }
    {
      Id = "Circe_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, kalau begitu yang {#Emph}ini {#Prev}jelas untuk kusimpan sendiri! Soalnya terakhir kali babi-babi kecilku {#Emph}sudah pasti {#Prev}makan sampai kenyang. Aku tak menyangka Yang Mulia Hecate mendidikmu menjadi sosok yang {#Emph}begitu dermawan!"
      Speaker = "Circe"
      Event = "CirceGift08"
    }
    {
      Id = "MelinoeField_4529"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Guru mengajariku melindungi diri, tetap fokus, dan banyak hal lainnya. Tapi apa yang kuketahui tentang kedermawanan pastinya sebagian besar berasal darimu, {#Emph}Madame{#Prev}. Persimpangan selalu terasa jauh lebih hangat saat kau berada di sana."
      Speaker = "Melinoe"
      Event = "CirceGift08"
    }
    {
      Id = "Circe_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, manis sekali perkataanmu... tapi aku sama sekali tak dikenal karena kehangatanku, tahu. Kau sendirilah yang memancingnya keluar dariku, persis seperti yang baru saja kaulakukan barusan! Jadi... terima kasih banyak."
      Speaker = "Circe"
      Event = "CirceGift08"
    }
    {
      Id = "MelinoeField_4530"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama-sama, dengan senang hati."
      Speaker = "Melinoe"
      Event = "CirceGift08"
    }
    {
      Id = "MelinoeField_1944"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cantik sekali, dan menggemaskan pula! Terima kasih!"
      Speaker = "Melinoe"
      Event = "NPC_Circe_01.GiftGivenVoiceLines"
    }
    {
      Id = "Circe_0178"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tenang{#Prev}, nona kecil!"
      Speaker = "Circe"
      Event = "NPC_Circe_01.OnHitVoiceLines"
    }
    {
      Id = "Circe_0179"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh{#Prev}, sudahlah."
      Speaker = "Circe"
      Event = "NPC_Circe_01.OnHitVoiceLines"
    }
    {
      Id = "Circe_0180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lain kali saja, bagaimana?"
      Speaker = "Circe"
      Event = "NPC_Circe_01.OnHitVoiceLines"
    }
    {
      Id = "Circe_0181"
      InheritFrom = "BaseSubtitle"
