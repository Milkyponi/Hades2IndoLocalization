    }
    {
      Id = "Circe_0079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oh! {#Prev}Halo!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, kau {#Emph}kembali! {#Prev}"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0081"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang kembali!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sudah tahu kau pasti akan datang!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0083"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau datang di waktu yang {#Emph}sangat {#Prev}tepat!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Babi-babi kecil{#Prev}, lihat siapa yang kembali!"
      Speaker = "Circe"
