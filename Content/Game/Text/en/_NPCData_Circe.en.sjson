      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Itu {#Prev}dia!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0303"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, selamat datang!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami menyambutmu!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia kembali, babi-babi kecilku!"
      Speaker = "Circe"
      Event = "GlobalVoiceLines.CirceGreetingLines"
    }
    {
      Id = "Circe_0307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, halo lagi..."
