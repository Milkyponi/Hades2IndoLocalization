      DisplayName = "{#Emph}Haha{#Prev}, meleset!"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.OnHitVoiceLines"
    }
    {
      Id = "Arachne_0297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hampir saja!"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.OnHitVoiceLines"
    }
    {
      Id = "Arachne_0298"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ahh! {#Prev}Bercanda. Meleset."
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.OnHitVoiceLines"
    }
    {
      Id = "Arachne_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, halo, sobat! Aku kebetulan melihat sang Tukang Perahu mendayung menyusuri Cocytus, kemungkinan besar menuju {#Emph}tempatmu{#Prev}, karena dia membawa {#Emph}berbagai macam {#Prev}persediaan. Dia berbaik hati menawariku tumpangan. Entah dia menyadarinya atau tidak, {#Emph}ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneHubFirstMeeting01"
    }
    {
      Id = "Melinoe_3141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihatmu di sini dan selamat datang, Arachne! Aku yakin Charon tidak keberatan dengan penumpang gelap yang begitu sopan. Ada yang bisa kami lakukan untuk membuat singgahmu di sini lebih nyaman?"
      Speaker = "Melinoe"
      Event = "ArachneHubFirstMeeting01"
    }
    {
      Id = "Arachne_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, terima kasih. Aku tak berniat tinggal lama di sini. Terutama karena sang Tukang Perahu adalah tiket pulangku. Aku hanya akan memastikan semua sutraku di sini tertambal rapi, lalu melanjutkan perjalanan. Jaga dirimu baik-baik, ya?"
      Speaker = "Arachne"
      Event = "ArachneHubFirstMeeting01"
    }
    {
      Id = "Melinoe_3142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga..."
      Speaker = "Melinoe"
      Event = "ArachneHubFirstMeeting01"
    }
    {
      Id = "Arachne_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Oh{#Prev}, jangan cemas. Aku bakal baik-baik saja! Hutan di luar sana sudah kuhafal luar kepala, persis punggung, {#Emph}um... kakiku{#Prev}, kurasa begitu! Aku selalu bersyukur atas kebaikan dan keramahanmu, wahai Titaness agung."
      Speaker = "Arachne"
      Event = "ArachneWithHecateInHub01"
    }
    {
      Id = "Hecate_0545"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau selalu diterima di sini dengan aman, Arachne. Sekarang maafkan aku. Masalah-masalah yang merebak akhir-akhir ini butuh lebih banyak perhatianku daripada yang kuinginkan..."
      Speaker = "Hecate"
      Event = "ArachneWithHecateInHub01"
    }
    {
      Id = "Arachne_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat paham. Kalau begitu aku tidak akan mengganggumu lagi. Sampai jumpa lagi!"
      Speaker = "Arachne"
      Event = "ArachneWithHecateInHub01"
    }
    {
      Id = "Hecate_0546"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa juga."
      Speaker = "Hecate"
      Event = "ArachneWithHecateInHub01"
    }
    {
      Id = "Arachne_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "...T-tapi, ini {#Emph}mustahil{#Prev}.... Titaness, apa maksudmu sebenarnya? Kalau memang begitu maksud ucapanmu, lalu... segala sambutan hangat dan jaminan amanku di sini selama ini... cuma kebohongan belaka? Begitukah?"
      Speaker = "Arachne"
      Event = "ArachneWithHecateInHub02"
    }
    {
      Id = "Hecate_0547"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemarahanmu memang beralasan. Racunku lah yang dipakai Athena saat mengutukmu. Namun kutukan itu miliknya, bukan milikku. Aku sama sekali tak berniat kau mengetahui {#Emph}semua {#Prev}ini. Namun Melinoë berhasil menggoyahkan firasatku."
      Speaker = "Hecate"
      Event = "ArachneWithHecateInHub02"
    }
    {
      Id = "Arachne_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku kehabisan kata-kata. Jadi semua ini gara-gara {#Emph}kau{#Prev}. Athena mustahil bisa melakukan ini padaku tanpa {#Emph}bantuanmu{#Prev}. Kalian para Titan dan dewa... kelakuan kalian sama saja. Selamat malam!"
      Speaker = "Arachne"
      Event = "ArachneWithHecateInHub02"
    }
    {
      Id = "Hecate_0548"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Arachne, berpikirlah jernih... {#Emph}ungh...{#Prev}"
      Speaker = "Hecate"
      Event = "ArachneWithHecateInHub02"
    }
    {
      Id = "Arachne_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja!"
      Speaker = "Arachne"
      Event = "GlobalVoiceLines.CostumeChangedVoiceLines"
    }
    {
      Id = "Arachne_0172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti!"
      Speaker = "Arachne"
