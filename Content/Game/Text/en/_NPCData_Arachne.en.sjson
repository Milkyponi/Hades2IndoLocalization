{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Arachne.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "Melinoe_1880"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga damai menyertaimu, Arachne."
      Speaker = "Melinoe"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0157"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga dirimu baik-baik, ya?"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di luar sana."
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga damai juga menyertaimu."
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0152"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana kabarmu?"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0153"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih banyak, ya."
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0154"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, aku paham betul seluk-beluk tempat ini."
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana pun langkah kita membawa."
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih atas perhatianmu."
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu sopan sekali, sih."
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak perlu seformal itu denganku."
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aduh, {#Emph}kamu ini!"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayolah."
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.InteractVoiceLines"
    }
    {
      Id = "Arachne_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi apa kamu di sini? Selain menginjak-injak jaring sutraku, tentunya! Ah, tidak apa-apa, kok! Aku selalu bisa menenun sutra baru yang seindah ini! Tapi aku kan tak selalu bisa bertemu denganmu."
      Speaker = "Arachne"
      Event = "ArachneFirstMeeting"
    }
    {
      Id = "Melinoe_0636"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Emm{#Prev}, hai, Arachne. Maaf soal jaringmu, ya! Sepertinya mulai sekarang kita bakal lebih sering bertemu. Tugasku sudah dimulai."
      Speaker = "Melinoe"
      Event = "ArachneFirstMeeting"
    }
    {
      Id = "Arachne_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Kalau begitu, aku tak mau menghambat langkahmu, kamu harus segera pergi. Tapi sebelumnya, kamu {#Emph}wajib {#Prev}mencoba salah satu pakaian ini. Dan jangan khawatir kalau sampai rusak atau robek! Stok buatanku masih banyak sekali, {#Emph}ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneFirstMeeting"
    }
    {
      Id = "Arachne_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga, kamu terluka, kawan! Padahal perjalananmu masih sangat panjang. Tapi jangan cemas! Sutra buatanku bakal membuatmu bugar kembali seperti semula."
      Speaker = "Arachne"
      Event = "ArachneLowHealth01"
    }
    {
      Id = "Arachne_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sutra ini segalanya bagiku! Jauh lebih kuat dari kelihatannya, lho. Menjagaku tetap aman! Bahkan mangsa terkuat pun bisa terjerat sampai kehabisan napas. Kamu suka, kan? Ada kombinasi corak dan warna tertentu yang kamu minati?"
      Speaker = "Arachne"
      Event = "ArachneAboutSilk01"
    }
    {
      Id = "Melinoe_1806"
      InheritFrom = "BaseNarrative"
      DisplayName = "Indah sekali, Arachne. Sejujurnya, aku ingin berlama-lama mengaguminya di sini, tapi..."
      Speaker = "Melinoe"
      Event = "ArachneAboutSilk01"
    }
    {
      Id = "Arachne_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tapi kamu tak bisa berlama-lama. Aku mengerti, sungguh. Tapi bakal {#Emph}sangat {#Prev}berarti bagiku kalau kamu mau membawa sedikit sutraku untuk menemanimu di perjalanan."
      Speaker = "Arachne"
      Event = "ArachneAboutSilk01"
    }
    {
      Id = "MelinoeField_1785"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sutramu terasa begitu mewah, dan jalinan sihir pada benangnya begitu kuat. Arachne, ini luar biasa, sungguh. Kamu menyadarinya, kan?"
      Speaker = "Melinoe"
      Event = "ArachneAboutSilk02"
    }
    {
      Id = "Arachne_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja aku tahu, kawan. Meski kekuatanku mungkin tak sebanding denganmu, untuk ukuran tubuh sekecil ini, kemampuanku tak main-main, lho. Dan aku tak mudah lelah! Kalau soal sisanya... rahasia dapur, {#Emph}hah, ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutSilk02"
    }
    {
      Id = "MelinoeField_1786"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti ada sesuatu yang bisa kulakukan untuk membalas semua kerja kerasmu. Hidup kami di Crossroads memang bersahaja, tapi pasokan perbekalan kami tidak kekurangan. Katakan saja apa yang kamu butuhkan."
      Speaker = "Melinoe"
      Event = "ArachneAboutPay01"
    }
    {
      Id = "Arachne_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kamu baik sekali menawarkannya secara langsung begitu, kawan, dan aku sangat menghargainya, sungguh. Apa yang kubutuhkan, ya... Harus kupikirkan dulu masak-masak! Tapi untuk sekarang, yang kubutuhkan adalah kamu memilih gaun mana yang kamu suka, lalu mencobanya."
      Speaker = "Arachne"
      Event = "ArachneAboutPay01"
    }
    {
      Id = "Melinoe_1810"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arachne, pakaian yang kautenen untukku kemarin sungguh indah. Tapi maaf, aku sempat terlibat pertempuran sengit... dan pakaian itu akhirnya hancur."
      Speaker = "Melinoe"
      Event = "ArachneAboutOutfits01"
    }
    {
      Id = "Arachne_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}hah{#Prev}, tidak apa-apa sama sekali! Pakaian itu memang tidak dirancang untuk bertahan selamanya. Mana ada yang abadi? Pakaian itu dibuat khusus untuk menemani momenmu saat itu {#Emph}saja. {#Prev}Nah, kebetulan aku masih punya banyak stok."
      Speaker = "Arachne"
      Event = "ArachneAboutOutfits01"
    }
    {
      Id = "Arachne_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jangan begitu, kawan. Kumohon, kamu tak perlu menatapku seperti itu. Malah sebenarnya, tak usah menatapku sama sekali! Lihat saja busana-busana indah yang kubuat ini! Ada sutra dengan beragam bentuk dan warna, lihat kan? Cantik sekali, bukan?"
      Speaker = "Arachne"
      Event = "ArachneAboutSelf01"
    }
    {
      Id = "Melinoe_1807"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang sangat indah, Arachne, tapi... memikirkan kalau lirikan sepintasku barusan melukai perasaanmu... Aku hanya mengkhawatirkan keselamatanmu tinggal sendirian di tempat seperti ini."
      Speaker = "Melinoe"
      Event = "ArachneAboutSelf01"
    }
    {
      Id = "Arachne_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tak perlu mencemaskan hal itu. Soalnya, wujud baruku ini punya keuntungan tersendiri, lho. Umurku jadi sangat, {#Emph}sangat {#Prev}panjang untuk menikmatinya. Lagipula, mentang-mentang {#Emph}kamu {#Prev}bisa menemukanku di sini, bukan berarti sembarang orang bisa melakukannya juga."
      Speaker = "Arachne"
      Event = "ArachneAboutSelf01"
    }
    {
      Id = "Arachne_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bahkan sudah lupa rasanya... berjalan hanya dengan dua kaki. Cuma sepasang kaki saja. Wujudku memang menjijikkan, aku tahu, tapi... setidaknya aku tak gampang tersandung lagi seperti dulu. Merayap lincah ke sana kemari sudah jadi sifat alamiku sekarang."
      Speaker = "Arachne"
      Event = "ArachneAboutSelf02"
    }
    {
      Id = "Melinoe_1808"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan bicara begitu! Tugasku pasti bakal tuntas jauh lebih cepat kalau saja aku punya kaki selincah kakimu, Arachne."
      Speaker = "Melinoe"
      Event = "ArachneAboutSelf02"
    }
    {
      Id = "Arachne_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Simpan rasa ibamu untuk jiwa lain saja, kawan. Nah, sekarang! Sudah kusisihkan beberapa helai sutra {#Emph}terlembutku {#Prev}khusus untuk {#Emph}kamu."
      Speaker = "Arachne"
      Event = "ArachneAboutSelf02"
    }
    {
      Id = "Melinoe_1809"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu yakin tak apa-apa tinggal di sini sendirian? Melangkah lima puluh tindak saja di hutan ini aku sudah harus mengangkat senjata."
      Speaker = "Melinoe"
      Event = "ArachneAboutLair01"
    }
    {
      Id = "Arachne_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasa nyaman menyendiri begini. Aku punya sarang mungil, makananku tercukupi, dan aku bisa terus menenun! Aku bahkan tak butuh alat tenun dan benang lagi. Aku sangat bersyukur. Dan, aku senang sekali kamu sudi mampir! Datang lagi lain kali, ya?"
      Speaker = "Arachne"
      Event = "ArachneAboutLair01"
    }
    {
      Id = "Arachne_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hutan ini biasanya sunyi senyap. Arwah-Arwah Tersesat lebih sering menyendiri dan tidak mengusikku. Jadi aku sering mendengarkan bisikan pepohonan... mereka begitu {#Emph}tinggi{#Prev}, {#Emph}bijaksana{#Prev}, dan {#Emph}jauh lebih tua {#Prev}daripada pepohonan di tempat asalku dulu..."
      Speaker = "Arachne"
      Event = "ArachneAboutTrees01"
    }
    {
      Id = "MelinoeField_1782"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu kecil, aku juga selalu mendengarkan bisikan pepohonan! Dalam beberapa hal, itu mengingatkanku pada arwah-arwah yang mendiami tempat ini. Suara mereka tidak mudah terdengar."
      Speaker = "Melinoe"
      Event = "ArachneAboutTrees01"
    }
    {
      Id = "Arachne_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi suara mereka {#Emph}bisa {#Prev}didengar, kan? Aku tidak berkhayal saat mendengar mereka memanggil dan menenangkanku, kan? Yah, tak perlu dijawab juga, sih! Untuk hal-hal tertentu, aku lebih memilih untuk tidak memastikannya."
      Speaker = "Arachne"
      Event = "ArachneAboutTrees01"
    }
    {
      Id = "Arachne_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hutan ini sudah banyak berubah akhir-akhir ini. Terkadang aku terpikir untuk pindah dari sini. Kudengar udaranya semakin dingin dan lembap kalau turun lebih jauh ke bawah?"
      Speaker = "Arachne"
      Event = "ArachneAboutOceanus01"
    }
    {
      Id = "MelinoeField_1789"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada jalur yang kutahu melintasi tepi Oceanus, tempat dasar laut dan Dunia Bawah bertemu. Tak ada pepohonan, yang ada hanyalah... pipa-pipa logam aneh... dan air asin."
      Speaker = "Melinoe"
      Event = "ArachneAboutOceanus01"
    }
    {
      Id = "Arachne_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya seperti suasana yang benar-benar baru! Rasanya aku takkan begitu menyukainya tanpa pepohonanku. Tapi {#Emph}pipa-pipa logam? {#Prev}Aku bisa menggantung jaring-jaringku di sana...! Ah sudahlah... mimpi hanyalah mimpi, {#Emph}ha ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutOceanus01"
    }
    {
      Id = "Arachne_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ke mana saja kau belakangan ini, sobat? Aku sudah begitu terbiasa melihatmu berkunjung ke hutan ini sampai-sampai, saat kau tidak muncul selama semalam atau dua malam, yah... aku jadi agak cemas, itu saja."
      Speaker = "Arachne"
      Event = "ArachneAboutSurface01"
    }
    {
      Id = "MelinoeField_1784"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf sudah membuatmu cemas. Tugasku menuntutku untuk pergi ke permukaan sekarang, begitu pula ke bawah sana. Banyak hal yang harus kusosialisasikan dan kubiasakan di sana."
      Speaker = "Melinoe"
      Event = "ArachneAboutSurface01"
    }
    {
      Id = "Arachne_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pergi ke {#Emph}arah sana? {#Prev}{#Emph}Ha ha ha ha{#Prev}, aku bahkan tak merindukan tempat asalku lagi. Yah, kau pasti tahu jalanmu sendiri. Tapi kalau kau butuh sudut pandang penduduk setempat, kau tinggal minta saja."
      Speaker = "Arachne"
      Event = "ArachneAboutSurface01"
    }
    {
      Id = "Arachne_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini kau semakin sering naik ke permukaan. Kau tidak benar-benar lebih menyukai tempat itu, kan?"
      Speaker = "Arachne"
      Event = "ArachneAboutTimePassing01"
    }
    {
      Id = "MelinoeField_4412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu tidak. Tidak sampai seperti itu. Aku ke sana murni karena tuntutan tugas, bukan untuk bersenang-senang. Iklimnya sama sekali tidak cocok denganku."
      Speaker = "Melinoe"
      Event = "ArachneAboutTimePassing01"
    }
    {
      Id = "Arachne_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga lebih suka di bawah sini. Tempatnya lebih terpencil... lebih tenang. Tapi tetap ada sedikit sinar rembulan untuk memancarkan keindahan terbaik dari segalanya. Aku senang kau kembali."
      Speaker = "Arachne"
      Event = "ArachneAboutTimePassing01"
    }
    {
      Id = "Arachne_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merindukanmu, sobat. Lebih banyak urusan di Olympus yang menyita waktumu, kurasa? Oh, itu bukan urusanku, sih. Tapi aku sungguh senang kau kembali."
      Speaker = "Arachne"
      Event = "ArachneAboutDreamRuns01"
    }
    {
      Id = "MelinoeField_5297"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, terima kasih Arachne, senang bertemu denganmu lagi. Akhir-akhir ini aku sedang mendalami dunia mimpi, berusaha memahami misteri di dalam benak kita sendiri. Kurasa aku agak terlalu larut di sana."
      Speaker = "Melinoe"
      Event = "ArachneAboutDreamRuns01"
    }
    {
      Id = "Arachne_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Helaan napas> {#Prev}Seandainya saja kita bisa mengerti apa yang terjadi di dalam benak mungil kita ini! Kabari aku ya kalau kau berhasil memahaminya. Wah, terkadang kupikir hidup itu sendiri hanyalah sebuah mimpi... benarkan?"
      Speaker = "Arachne"
      Event = "ArachneAboutDreamRuns01"
    }
    {
      Id = "Arachne_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah suka menenun sejak masih sangat kecil. Ayahku, beliau biasa membuat pewarna terbaik... merah layaknya matahari terbenam, biru sedalam lautan, dan {#Emph}oh{#Prev}, warna {#Emph}ungunya! {#Prev}Aku ingin membuat kain yang pantas untuk warna-warna seindah itu..."
      Speaker = "Arachne"
      Event = "ArachneAboutWeaving01"
    }
    {
      Id = "MelinoeField_1484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan sekarang kau berhasil. Bakatmu luar biasa. Butuh waktu berapa lama untuk bisa semahir ini? Aku telah melatih kemampuanku seumur hidup, tapi masih terlalu sering gagal mencapai tujuanku..."
      Speaker = "Melinoe"
      Event = "ArachneAboutWeaving01"
    }
    {
      Id = "Arachne_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti akan sampai ke titik yang kau tuju, sobat. Aku melihat betapa kerasnya usahamu! Kalau aku, sewaktu masih gadis belia, aku memang sudah cukup mahir. Tapi sejujurnya, kemampuanku jauh lebih hebat setelah menjadi seperti ini. Suatu berkah... sekaligus kutukan, {#Emph}ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutWeaving01"
    }
    {
      Id = "Arachne_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang kuinginkan hanyalah membuka sebuah toko kecil. {#Emph}Pakaian, Pewarna, dan Kain Arachne! {#Prev}Bukan nama yang paling memikat, kalau kuucapkan keras-keras sekarang. Tapi reputasi kami pasti takkan tertandingi."
      Speaker = "Arachne"
      Event = "ArachneAboutWeaving02"
    }
    {
      Id = "MelinoeField_1485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu ini bukan yang kau bayangkan... tapi kau memiliki pelanggan setia dalam diriku. Walaupun, bagian di mana kau sama sekali tidak memungut bayaran untuk jasamu membuatku merasa agak bersalah, kurasa."
      Speaker = "Melinoe"
      Event = "ArachneAboutWeaving02"
    }
    {
      Id = "Arachne_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan mulai lagi dengan omong kosong itu! Tenunan dan pakaian buatanku bukan sekadar untuk pajangan, ini busana malam yang fungsional! {#Emph}Kau{#Prev}, sobat, sedang membantu mereka memenuhi tujuan hidupnya, {#Emph}ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutWeaving02"
    }
    {
      Id = "MelinoeField_4421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang ada permadani indah di Persimpangan Jalan... tenunannya begitu terampil hingga aku langsung tahu itu buatanmu. Maukah kau datang melihatnya kapan-kapan?"
      Speaker = "Melinoe"
      Event = "ArachneAboutTapestry01"
    }
    {
      Id = "Arachne_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh tidak, sobat, aku sama sekali tak berniat kembali ke sana. Hubunganku dengan si penyihir agung itu sedang renggang! Tapi setidaknya sekarang kalian punya sesuatu untuk mengenangku."
      Speaker = "Arachne"
      Event = "ArachneAboutTapestry01"
    }
    {
      Id = "MelinoeField_4422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sedih mendengarnya, tapi aku mengerti. Aku menyadari permadani itu menggambarkan dewa-dewi Olympus dengan cara yang agak tak lazim..."
      Speaker = "Melinoe"
      Event = "ArachneAboutTapestry01"
    }
    {
      Id = "Arachne_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Athena sama sekali tidak menyukai penggambaran itu. Tapi mata indahmu bisa melihat hal-hal yang tak mampu dilihat oleh sepasang mata kelabunya yang kusam itu, {#Emph}ha ha ha ha ha."
      Speaker = "Arachne"
      Event = "ArachneAboutTapestry01"
    }
    {
      Id = "Melinoe_1811"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sibuk sekali, ya, Arachne. Bukan cuma gaun-gaun ini, tapi... seisi Erebus penuh dengan kepompong sutra. Kau yakin aku boleh memecahkannya?"
      Speaker = "Melinoe"
      Event = "ArachneAboutCocoons01"
    }
    {
      Id = "Arachne_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja boleh, dasar bodoh! Apa kau mengira kepompong itu berisi kawanan anak-anakku yang tak terhitung jumlahnya? Pada saat kau melihat sebuah kepompong, apa pun di dalamnya kalau bukan {#Emph}untukmu{#Prev}, ya tadinya mau {#Emph}mencelakaimu{#Prev}. Nah, ambillah ini."
      Speaker = "Arachne"
      Event = "ArachneAboutCocoons01"
    }
    {
      Id = "Arachne_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak benar-benar berpikir kalau {#Emph}aku {#Prev}yang menenun sendiri semua kepompong yang kau lihat di luar sana, kan? Aku memang menenun lebih cepat dari siapa pun, tapi bahkan {#Emph}aku {#Prev}pun tidak secepat itu...!"
      Speaker = "Arachne"
      Event = "ArachneAboutCocoons02"
    }
    {
      Id = "Melinoe_1812"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masuk akal juga. Jadi, sebagai gantinya, kau memimpin pasukan laba-laba tersembunyi yang berbaris rapi menunggu perintahmu?"
      Speaker = "Melinoe"
      Event = "ArachneAboutCocoons02"
    }
    {
      Id = "Arachne_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh {#Prev}tidak, sebagian besar dari mereka lebih suka menggantung terbalik daripada berbaris rapi. {#Emph}Khh, {#Prev}ayolah! Aku bukan satu-satunya laba-laba di hutan ini! Yang lainnya sibuk dengan urusan mereka sendiri. Tapi mereka memang mendengarkanku {#Emph}sesekali{#Prev}, kurasa, {#Emph}ha ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutCocoons02"
    }
    {
      Id = "Arachne_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti kelaparan! Tertarik dengan sedikit santapan? Dan yang kumaksud benar-benar {#Emph}sedikit, hahaha! {#Prev}Aku punya tangkapan segar di sini kalau kau mau mencobanya!"
      Speaker = "Arachne"
      Event = "ArachneAboutFood01"
    }
    {
      Id = "MelinoeField_1486"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh! Terima kasih banyak, Arachne, tapi tidak usah. Aku... sama sekali tidak berselera makan. Dan aku kurang suka memakan hewan, serangga sekalipun. Meskipun aku yakin lalat-lalatmu pasti sangat lezat."
      Speaker = "Melinoe"
      Event = "ArachneAboutFood01"
    }
    {
      Id = "Arachne_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja {#Emph}lezat! {#Prev}Rasanya memang butuh sedikit pembiasaan, aku tahu. Tapi aku bisa terbiasa memakannya jauh lebih cepat daripada hal-hal lain di kehidupan ini. {#Emph}Ah {#Prev}sudahlah! Rugi sendiri, deh."
      Speaker = "Arachne"
      Event = "ArachneAboutFood01"
    }
    {
      Id = "MelinoeField_1487"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu sendirian di sini. Hutan ini penuh dengan laba-laba... apa kalian tidak pernah berkumpul bersama, atau semacamnya? Menenun sarang raksasa yang mustahil kau buat sendirian?"
      Speaker = "Melinoe"
      Event = "ArachneAboutSpiders01"
    }
    {
      Id = "Arachne_0368"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kurasa kami tentu saja bisa melakukannya. Hanya saja, kebetulan aku {#Emph}membenci {#Prev}laba-laba. Sejauh yang kutahu, semua laba-laba juga begitu. Menenun adalah kegiatan menyendiri, dan lagi... aku jauh lebih menikmati kebersamaan {#Emph}denganmu{#Prev}."
      Speaker = "Arachne"
      Event = "ArachneAboutSpiders01"
    }
    {
      Id = "MelinoeField_1488"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... kalau boleh jujur, aku sendiri tak pernah membenci laba-laba. Mereka menjaga hutan tetap bebas dari hama. Dan apa jadinya tempat ini tanpa jaring-jaring mereka?"
      Speaker = "Melinoe"
      Event = "ArachneAboutSpiders02"
    }
    {
      Id = "Arachne_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, sobat. Aku tahu niatmu baik saat mengatakan hal-hal seperti itu. Kalau ini bisa membuatmu merasa lebih baikan, aku tak cuma membenci diriku yang {#Emph}sekarang{#Prev}. Kalian para dewa... aku juga membenci kalian. {#Emph}Ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutSpiders02"
    }
    {
      Id = "Arachne_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu hal soal laba-laba, sobat? Yaitu... yah, mereka itu kerabatku. Keturunanku sendiri, tahu kan. Tapi mereka itu bajingan-bajingan yang {#Emph}tak tahu terima kasih{#Prev} sampai akhir! Mereka sama sekali tak sudi berurusan denganku."
      Speaker = "Arachne"
      Event = "ArachneAboutSpiders03"
    }
    {
      Id = "MelinoeField_1489"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keturunanmu sendiri...?! Kau adalah yang paling pertama. Tapi, bagaimana bisa kau, {#Emph}ng... {#Prev}bukankah kau butuh...?"
      Speaker = "Melinoe"
      Event = "ArachneAboutSpiders03"
    }
    {
      Id = "Arachne_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seorang {#Emph}pasangan? {#Prev}Oh, dia langsung kabur. Jadi kau tahu kan, kutukan ini bukan hanya {#Emph}milikku{#Prev}. Ini turun-temurun ke generasi berikutnya. Mungkin kami para laba-laba tak jauh berbeda dari kalian para dewa. {#Emph}Ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutSpiders03"
    }
    {
      Id = "Arachne_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah benar-benar memikirkan betapa miripnya kita berdua. Sama-sama terbuang, bukan? Harusnya kau tinggal di sebuah {#Emph}istana! {#Prev}Bukan... berbicara dengan seekor {#Emph}laba-laba{#Prev} di antah berantah begini."
      Speaker = "Arachne"
      Event = "ArachneAboutRelationship01"
    }
    {
      Id = "MelinoeField_1783"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan harusnya kau menjadi penenun paling tersohor dan paling dicintai di seluruh pelosok negeri! Namun bukan itu takdir yang digariskan Moirai untuk kita. Walaupun... ini tidak sepenuhnya buruk, kan?"
      Speaker = "Melinoe"
      Event = "ArachneAboutRelationship01"
    }
    {
      Id = "Arachne_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak buruk? Ya... benar juga. Karena andai aku masih di atas sana... dicemburui dewa maupun manusia fana... aku pasti takkan pernah bertemu {#Emph}denganmu{#Prev}. Sahabat sejatiku satu-satunya. {#Emph}Ha ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutRelationship01"
    }
    {
      Id = "Arachne_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Soal yang kemarin... Aku tahu ada orang-orang lain dalam hidupmu yang kau sayangi. Dan itu membuatku senang. Kau berhak merasa {#Emph}dicintai! {#Prev}Sangat dicintai! Tapi lihatlah {#Emph}aku... {#Prev}satu-satunya hal yang bisa kulakukan cuma {#Emph}menenun{#Prev}."
      Speaker = "Arachne"
      Event = "ArachneAboutRelationship02"
    }
    {
      Id = "MelinoeField_1803"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ukuran tubuhmu tak ada hubungannya dengan cinta yang bisa kau berikan. Namun caramu memandang dirimu sendiri... itu pasti memengaruhi cinta yang bisa kau terima. Apakah kau sanggup mempercayai ketulusannya."
      Speaker = "Melinoe"
      Event = "ArachneAboutRelationship02"
    }
    {
      Id = "Arachne_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membuatku merasakan apa yang kurasakan dulu. Dan saat itu...? Saat aku masih menjadi diriku sendiri? Kau tahu, kami manusia fana bisa bersikap {#Emph}sama {#Prev}cemburuannya dengan para dewa. Tapi mengetahui kau peduli padaku walau hanya sedikit saja, yah... itu sudah lebih dari cukup. Nih, pergilah..."
      Speaker = "Arachne"
      Event = "ArachneAboutRelationship02"
    }
    {
      Id = "Arachne_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku terus berpikir, sobat... tentang bagaimana aku bisa begitu tertarik padamu. Seperti lalat yang terpikat jaring-jaringku... hanya saja aku memang berniat menangkap {#Emph}mereka{#Prev}, dan kurasa kau tak berniat melakukan hal serupa padaku."
      Speaker = "Arachne"
      Event = "ArachneAboutRelationship03"
    }
    {
      Id = "MelinoeField_4398"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja aku tak pernah bermaksud {#Emph}menjeratmu{#Prev}, Arachne. Seperti yang sudah kubilang... kurasa kita saling menemani di hutan yang sunyi ini, tapi... apakah ada... sesuatu yang lebih?"
      Speaker = "Melinoe"
      Event = "ArachneAboutRelationship03"
    }
    {
      Id = "Arachne_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "A... aku rasa tidak, bukan begitu. Tidak selama wujudku masih seperti ini. Gadis yang {#Emph}dulu{#Prev}, wah... dia mungkin cuma manusia fana, tapi dia {#Emph}jauh {#Prev}lebih baik dari wujud ini, {#Emph}ha ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutRelationship03"
    }
    {
      Id = "Arachne_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini, tiap kali aku rindu menjadi seorang gadis lagi, sobat... kurasa sebagian karena aku menyukai angan-angan bisa bersamamu. Kau tahu kan, seperti orang-orang normal."
      Speaker = "Arachne"
      Event = "ArachneAboutRelationship04"
    }
    {
      Id = "MelinoeField_4399"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arachne, ikatan kita istimewa. Sekalipun aku bertemu dengan gadis fana dirimu yang dulu, mungkin aku takkan menaruh perhatian dengan cara yang sama. Arwah fana itu sudah lumrah... kau tidak."
      Speaker = "Melinoe"
      Event = "ArachneAboutRelationship04"
    }
    {
      Id = "Arachne_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat menghargai ucapanmu itu. Dulu saat aku mendamprat Athena terang-terangan... aku tahu aku merelakan sesuatu. Namun itu hanyalah khayalan belaka, sedangkan hubungan {#Emph}kita {#Prev}adalah sesuatu yang {#Emph}nyata{#Prev}."
      Speaker = "Arachne"
      Event = "ArachneAboutRelationship04"
    }
    {
      Id = "Arachne_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi para dewa di atas sana membantumu, ya? Yah, kenapa juga aku bertanya, padahal aku sudah tahu. Aku sudah melihat seisi hutan ini bersinar terang oleh pesan-pesan warna-warni mereka..."
      Speaker = "Arachne"
      Event = "ArachneAboutGods01"
    }
    {
      Id = "MelinoeField_1776"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu benar. Olimpus dan aku punya tujuan yang sama, karena sang Titan Waktu mengancam kita semua. Harusnya aku memberitahumu, hanya saja... aku tak tahu harus bicara apa."
      Speaker = "Melinoe"
      Event = "ArachneAboutGods01"
    }
    {
      Id = "Arachne_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah, ha ha ha ha{#Prev}... jadi Moirai mempermainkanku {#Emph}lagi{#Prev}. Aku mungkin penenun yang lebih hebat dari gabungan seluruh dewa, tapi tiga bersaudara itu selalu mengalahkanku {#Emph}setiap saat{#Prev}. Tapi tenang saja! Aku takkan membelakangi dan meninggalkanmu. Sekalipun para dewa akan diuntungkan..."
      Speaker = "Arachne"
      Event = "ArachneAboutGods01"
    }
    {
      Id = "MelinoeField_1777"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terkesan menjauh, Arachne. Apa semuanya baik-baik saja? Apa ini gara-gara aku membantu kaum Olimpus?"
      Speaker = "Melinoe"
      Event = "ArachneAboutGods02"
    }
    {
      Id = "Arachne_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah, hahaha... {#Prev}tunggu dulu. Maksudmu {#Emph}kau yang{#Prev} membantu kaum Olimpus? Bukannya kau bilang malah sebaliknya! Merekalah yang membantu {#Emph}dirimu!{#Prev}"
      Speaker = "Arachne"
      Event = "ArachneAboutGods02"
    }
    {
      Id = "MelinoeField_1778"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama saja, bukan? Saling memberi dan menerima. Seperti sebuah persahabatan! Harus ada timbal balik. Namun, aku tahu ini menempatkanmu dalam posisi yang serbapelik, dan... aku takkan pernah meremehkan bantuanmu."
      Speaker = "Melinoe"
      Event = "ArachneAboutGods02"
    }
    {
      Id = "Arachne_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah! Kau mungkin tahu {#Emph}segalanya {#Prev}tentang para dewa, jauh lebih banyak dariku. Namun tampaknya masih ada satu dua hal yang perlu kau pelajari soal {#Emph}persahabatan{#Prev}. Bahkan seekor laba-laba tua nan mungil pun paham soal itu! Nah, ambillah gaun ini."
      Speaker = "Arachne"
      Event = "ArachneAboutGods02"
    }
    {
      Id = "Arachne_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau bingung mau bicara apa, sobat. Tapi aku ingin kau tahu... kau tak perlu bicara apa-apa sama sekali! Malahan, aku lebih suka kau diam saja untuk saat ini. Hati-hati di luar sana, ya?"
      Speaker = "Arachne"
      Event = "ArachneAboutGods03"
    }
    {
      Id = "Arachne_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam lainnya lagi di mana kau dipaksa menuruti kemauan para dewa? Hubunganmu dengan mereka itu bukan sebuah {#Emph}kemitraan{#Prev}, asal kau tahu saja. Mereka hanya akan mentolerirmu selama mereka menganggap dirimu {#Emph}lebih rendah{#Prev} dari mereka. Nah, ini. Ambil ini lalu pergilah."
      Speaker = "Arachne"
      Event = "ArachneAboutGods04"
    }
    {
      Id = "Arachne_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kan para dewa yang membuatku jadi begini? Walau tak seharusnya kubilang {#Emph}para {#Prev}dewa. Sebenarnya cuma ulah satu dewa saja. Tapi yang lainnya... mereka sama sekali tak {#Emph}peduli{#Prev}. Mereka berkomplot membiarkan semua itu terjadi! Seolah-olah dari dulu {#Emph}aku {#Prev}hanyalah seekor laba-laba di mata mereka."
      Speaker = "Arachne"
      Event = "ArachneAboutGods05"
    }
    {
      Id = "MelinoeField_1779"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arachne... para dewa memang harusnya bisa bersikap lebih ramah pada manusia fana. Aku takkan menyangkal hal itu. Aku sendiri punya sudut pandang tersendiri soal itu. Sebagian besar manusia fana yang kutemui... semuanya sudah mati."
      Speaker = "Melinoe"
      Event = "ArachneAboutGods05"
    }
    {
      Id = "Arachne_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun kau tetap membela Olimpus bagaimanapun juga! Aku paham, sungguh. Mereka itu keluarga. Dan itu adalah satu hal yang tak pernah bisa kita ubah... tidak sungguh-sungguh. Meskipun sang Titan yang kau lawan itu... bukankah dia juga keluargamu? {#Emph}Ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutGods05"
    }
    {
      Id = "Arachne_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi seperti apa dia sebenarnya? {#Emph}Athena bermata kelabu{#Prev}. Sebijak dan sesintetis yang orang-orang katakan? {#Emph}Ha ha ha ha... {#Prev}mengingat dia konon katanya adalah yang paling {#Emph}berakal sehat{#Prev}. Padahal dia sama kejam dan pendendamnya seperti yang lain..."
      Speaker = "Arachne"
      Event = "ArachneAboutGods06"
    }
    {
      Id = "MelinoeField_1780"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kurang tahu. Aku sudah mendengar kabar dari sebagian besar dewa Olimpus sekarang, tapi belum dari Athena. Tampaknya dia sangat sibuk menahan serbuan pasukan Titan yang berkumpul di kaki gunung."
      Speaker = "Melinoe"
      Event = "ArachneAboutGods06"
    }
    {
      Id = "Arachne_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan main mulianya! Kalau kelak kau bertemu dengannya, kau harus menceritakan bagaimana keadaannya padaku. Dan jangan ragu untuk memberitahunya bahwa Arachne masih hidup sehat walafiat, dan menenun bahkan jauh {#Emph}lebih indah{#Prev} dari sebelumnya."
      Speaker = "Arachne"
      Event = "ArachneAboutGods06"
    }
    {
      Id = "Arachne_0077_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi seperti apa dia sebenarnya? {#Emph}Athena bermata kelabu{#Prev}. Sebijak dan seperhitungan yang orang-orang katakan? {#Emph}Ha ha ha ha... {#Prev}mengingat dia konon katanya adalah yang paling {#Emph}berakal sehat{#Prev}."
      Speaker = "Arachne"
      Event = "ArachneAboutGods06_B"
    }
    {
      Id = "MelinoeField_2721"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... jarang mendengar kabarnya tidak seperti dewa-dewi yang lain. Dia pasti sangat kewalahan menahan serbuan pasukan Titan yang berkumpul di kaki gunung."
      Speaker = "Melinoe"
      Event = "ArachneAboutGods06_B"
    }
    {
      Id = "Arachne_0078_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan main mulianya! Jangan ragu untuk memberitahunya bahwa Arachne masih hidup sehat walafiat, dan menenun bahkan jauh {#Emph}lebih indah{#Prev} dari sebelumnya."
      Speaker = "Arachne"
      Event = "ArachneAboutGods06_B"
    }
    {
      Id = "Arachne_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Haruskah aku mengalah saat itu? Ketika aku ditantang oleh para dewa itu sendiri? Demi menentukan siapa penenun {#Emph}terhebat{#Prev} di jagat raya. Aku hanyalah seorang gadis fana biasa. Bisa kau bayangkan besarnya tekanan itu?"
      Speaker = "Arachne"
      Event = "ArachneAboutPride01"
    }
    {
      Id = "MelinoeField_1781"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga takkan menahan diri kalau ada di posisimu. Saat batas kemampuan kita diuji... baru di saat itulah kita tahu siapa diri kita yang sebenarnya."
      Speaker = "Melinoe"
      Event = "ArachneAboutPride01"
    }
    {
      Id = "Arachne_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu-satunya hal yang kutahu adalah aku bukan lagi gadis fana. Harusnya kau {#Emph}melihat {#Prev}mahakarya yang kubuat! {#Emph}Permadani {#Prev}kecil Athena bahkan tak ada apa-apanya. Mungkin semua ini sepadan... kehancuranku dibayar dengan rasa malunya..."
      Speaker = "Arachne"
      Event = "ArachneAboutPride01"
    }
    {
      Id = "Arachne_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sahabatku, aku sungguh tak enak menanyakannya, tapi apa menurutmu... mengetahui keahlian sihirmu, apa mungkin masih ada cara untuk mengembalikanku ke wujud semula?"
      Speaker = "Arachne"
      Event = "ArachneAboutCurse01"
    }
    {
      Id = "MelinoeField_1790"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arachne... Aku sudah mencoba segala cara yang kutahu. Kutukan metamorfosis yang menimpamu ini, yah... teramat sangat kuat. Sejauh yang kupahami, perubahan seperti ini tak bisa diputarbalikkan. Maafkan aku."
      Speaker = "Melinoe"
      Event = "ArachneAboutCurse01"
    }
    {
      Id = "Arachne_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah, tak apa-apa sama sekali. Aku cuma penasaran dan bertanya. Kutukan semacam itu takkan ada artinya kalau bisa dihilangkan begitu saja dengan sekali kibas, kan? {#Emph}Ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutCurse01"
    }
    {
      Id = "MelinoeField_1791"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arachne, a... aku sebelumnya tidak sepenuhnya berterus terang padamu soal kutukanmu. Secara teori, ada satu cara untuk membatalkannya. Tapi kemungkinan berhasilnya sangat kecil, dan prosesnya akan sangat berbahaya."
      Speaker = "Melinoe"
      Event = "ArachneAboutCurse02"
    }
    {
      Id = "Arachne_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa?! {#Prev}Aku tak peduli seberat apa pun risikonya, kau harus memberi tahuku, sahabatku, {#Emph}kumohon!"
      Speaker = "Arachne"
      Event = "ArachneAboutCurse02"
    }
    {
      Id = "MelinoeField_1792"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertama, kita harus mencari tahu sumber kutukan itu; Athena bukanlah penyihir. Pasti ada yang membantunya. Dan kedua... Athena sendiri harus mengubah niat awalnya. Dia harus rela melepaskan kutukan itu."
      Speaker = "Melinoe"
      Event = "ArachneAboutCurse02"
    }
    {
      Id = "Arachne_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi dia {#Emph}sangat membenciku! {#Prev}Dan untuk apa dia membeberkan siapa yang memberinya kutukan itu? Oh, sahabatku, andai saja kau tak memberitahuku! Sudahlah, lupakan saja, {#Emph}ha ha ha ha. {#Prev}Harapan itu memang suka mempermainkan perasaan..."
      Speaker = "Arachne"
      Event = "ArachneAboutCurse02"
    }
    {
      Id = "MelinoeField_1793"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengenai kutukanmu, Arachne... Kepala Sekolah berhasil mencari tahu siapa yang menciptakannya. Jadi, jika kau butuh kepastian untuk menutup lembaran hidupmu ini... datanglah berkunjung ke Persimpangan. Tapi, pengetahuan semacam itu bisa menjadi kutukan tersendiri, jadi... tolong pertimbangkan baik-baik."
      Speaker = "Melinoe"
      Event = "ArachneAboutCurse03"
    }
    {
      Id = "Arachne_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh... wah... kurasa aku harus memikirkannya masak-masak! Apa yang bisa kuubah dengan mengetahui hal seperti itu? Beri aku waktu sebentar... boleh kan, sahabatku?"
      Speaker = "Arachne"
      Event = "ArachneAboutCurse03"
    }
    {
      Id = "MelinoeField_1795"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arachne, kita harus bicara soal apa yang terjadi dengan Kepala Sekolah. Beliau tidak meracik racun itu sengaja demi menghancurkan hidupmu. Waktu itu beliau bahkan tidak mengenalmu."
      Speaker = "Melinoe"
      Event = "ArachneAboutCurse05"
    }
    {
      Id = "Arachne_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pikir aku tidak tahu semua itu? Tapi aku harus bagaimana, {#Emph}berterima kasih {#Prev}padanya? Wujudku sekarang memang sangat kecil, sahabatku, tapi harga diriku masih utuh... dan kau masih boleh mengambil gaunmu."
      Speaker = "Arachne"
      Event = "ArachneAboutCurse05"
    }
    {
      Id = "Arachne_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini kita terlalu banyak membicarakan kutukanku! Bagaimana kalau kita kembali seperti biasa saja, setuju? Semua {#Emph}ketegangan {#Prev}ini... aku tak membutuhkannya, begitu pula dirimu. Kau hanya berniat membantu. Begitu pun aku."
      Speaker = "Arachne"
      Event = "ArachneAboutCurse06"
    }
    {
      Id = "MelinoeField_1796"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya ingin kau baik-baik saja, itu saja. Masa lalu sudah berlalu dan tak bisa diubah. Tapi {#Emph}kita {#Prev}yang berhak menentukan apa yang akan terjadi selanjutnya."
      Speaker = "Melinoe"
      Event = "ArachneAboutCurse06"
    }
    {
      Id = "Arachne_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau benar! Entah kita atau para Moirai, kurasa. Terima kasih sudah mau mendengarkanku, sahabatku. Dan jaga dirimu baik-baik juga, ya?"
      Speaker = "Arachne"
      Event = "ArachneAboutCurse06"
    }
    {
      Id = "MelinoeField_4390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arachne, karena sekarang kita tahu Kepala Sekolah Hekate turut andil dalam kutukanmu, ada sedikit kemungkinan kita bisa membujuk Athena untuk membatalkannya. Atau lebih tepatnya, kau yang membujuknya."
      Speaker = "Melinoe"
      Event = "ArachneCurseQuest01"
    }
    {
      Id = "Arachne_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba jelaskan lebih lanjut soal ini, sahabatku. Apa sebenarnya rencanamu? Olympos itu lumayan tinggi untuk dipanjat dari sini..."
      Speaker = "Arachne"
      Event = "ArachneCurseQuest01"
    }
    {
      Id = "MelinoeField_4391"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya cara yang lebih praktis: sebuah Jimat yang bisa kugunakan untuk memanggilnya sebentar ke mari. Jika kau tak keberatan, dia bisa datang ke sini, dan kau bisa menyampaikan permohonanmu."
      Speaker = "Melinoe"
      Event = "ArachneCurseQuest01"
    }
    {
      Id = "Arachne_0380"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memangnya apa yang harus kukatakan? Tapi... {#Emph}aduh{#Prev}, aku pasti akan memikirkannya. Lain kali jika kau membawa Jimat itu, aku {#Emph}mungkin {#Prev}akan menerima tawaranmu. Terima kasih."
      Speaker = "Arachne"
      Event = "ArachneCurseQuest01"
    }
    {
      Id = "MelinoeField_4392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku membawa Jimat Athena, Arachne. Apa kau bersedia menghadapinya sekarang? Katakan saja bagaimana kau telah berubah, betapa kau ingin kembali ke wujud aslimu! Apa pun yang dia inginkan."
      Speaker = "Melinoe"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Arachne_0381"
      InheritFrom = "BaseNarrative"
      DisplayName = "A... aku akan melakukan apa yang harus kulakukan, sahabatku. Sekarang, kalau kau bersedia memanggil dewi kebijaksanaan itu ke mari, aku akan sangat berterima kasih."
      Speaker = "Arachne"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "MelinoeField_4393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, kita mulai. Dan apa pun yang terjadi, aku akan tetap di sisimu. {#Emph}Dengarkan suaraku, Yang Mulia Dewi Athena; seseorang yang mencarimu kini bersamaku!"
      Speaker = "Melinoe"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Athena_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salam, Melinoë. {#Emph}Ah{#Prev}, hutan ini. Dan benar saja, di situ ada sang Penenun Paling Berbakat di Dunia. Masih giat menekuni keahlianmu, Arachne?"
      Speaker = "Athena"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Arachne_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, Yang Mulia Dewi Athena! Memangnya apa lagi yang bisa kulakukan? Sekalipun aku masih menjadi gadis fana seperti dulu, kurasa aku akan tetap menekuninya. Dan kau sendiri, bagaimana kabarmu?"
      Speaker = "Arachne"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Athena_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sangat sibuk. Aku tak bisa berlama-lama di sini, karena urusan perang dan hal lainnya, jadi ada apa? Kau sudah muak dengan wujudmu itu?"
      Speaker = "Athena"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Arachne_0383"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku rindu bentuk dan ukuran tubuhku yang dulu, dan... aku sudah begini cukup lama, jadi... kupikir mungkin kau bisa mengembalikanku ke wujud semula. Aku rela melakukan apa saja, kumohon."
      Speaker = "Arachne"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Athena_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa saja? {#Prev}Kalau begitu permintaanku cukup sederhana: Minta maaflah atas perbuatanmu dengan setulus hati, dan beri tahu aku pelajaran apa yang telah kau petik."
      Speaker = "Athena"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Arachne_0384"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, wah, tentu... {#Emph}um{#Prev}, a... aku minta maaf, Yang Mulia Dewi Athena. Sungguh minta maaf. Maaf karena aku telah... merendahkan diriku di hadapanmu seperti ini! Di depan sahabatku sendiri!"
      Speaker = "Arachne"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "MelinoeField_4394"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Arachne! {#Prev}Kumohon, Yang Mulia Dewi Athena, emosinya sedang kalut dan dia belum berpikir jernih. Aku tahu betapa besar penyesalannya."
      Speaker = "Melinoe"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Arachne_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan ikut campur, sahabatku. Dan untuk {#Emph}dirimu{#Prev}, Yang Mulia Dewi Athena, kau mau tahu apa yang kupelajari?"
      Speaker = "Arachne"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Athena_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuperingatkan agar kau menjaga ucapanmu baik-baik, laba-laba. Aku tak menempuh perjalanan sejauh ini hanya untuk menjadi bahan olok-olokanmu."
      Speaker = "Athena"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Arachne_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Baru saja kupelajari, bahwa aku {#Emph}takkan pernah {#Prev}meminta maaf padamu {#Emph}dengan setulus hati. {#Prev}Aku lebih sudi menjadi laba-laba hina sampai akhir zaman. Dan lihatlah karya-karyaku! Tenunanku {#Emph}tetap {#Prev}jauh lebih indah daripada buatanmu."
      Speaker = "Arachne"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Athena_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kukira luapan amarah ini bisa menggoyahkan hatiku dan membuatku mengabulkan keinginanmu? Tidak. Wujudmu mungkin tampak menyedihkan, tapi kau jelas tak berubah sama sekali, Arachne."
      Speaker = "Athena"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Arachne_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pun begitu. Sekarang silakan injak dan remukkan aku seperti yang kau mau, atau pergilah dari sini. Kau membuat lalat-lalatku ketakutan."
      Speaker = "Arachne"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Athena_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah. Aku pamit, dan kita tak akan pernah saling bertemu lagi. Nikmatilah pesta lalatmu itu. Melinoë? Ini sebuah kesalahan."
      Speaker = "Athena"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "MelinoeField_4395"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arachne... kenapa kau melakukan itu? Kita melewati begitu banyak hal demi kesempatan ini, dan sekarang malah lenyap!"
      Speaker = "Melinoe"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Arachne_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, sahabatku. Itulah kesempatan yang selama ini kunanti-nantikan. Aku baru menyadarinya saat menatap mata Athena lagi barusan. Nah, {#Emph}hus-hus. {#Prev}Aku sudah menahanmu terlalu lama. {#Emph}Ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneCurseQuestComplete01"
    }
    {
      Id = "Arachne_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ternyata, minta maaf pada Athena itu bukan gayaku, sahabatku. Namun, aku minta maaf padamu. Karena sudah membuatmu repot-repot... sampai bikin keributan di hadapan dewi lain. Maaf ya."
      Speaker = "Arachne"
      Event = "ArachneAboutCurseQuest01"
    }
    {
      Id = "MelinoeField_4396"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aduh, Arachne. Aku lebih suka kalau kau mengatakannya pada Yang Mulia Athena dan mendapatkan apa yang kauinginkan. Aku ragu kau akan dapat kesempatan lain lagi."
      Speaker = "Melinoe"
      Event = "ArachneAboutCurseQuest01"
    }
    {
      Id = "Arachne_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak apa-apa, sungguh. Saat melihat Athena lagi, begitu lelah bertarung tapi tetap congkak seperti biasa, ada sesuatu dalam diriku yang meledak. Dan sekarang aku bebas! Kalian para dewa sedang mengalami masa-masa sulit... ternyata kalian juga harus menghadapi konsekuensi dari kesombongan kalian, sama seperti kami semua."
      Speaker = "Arachne"
      Event = "ArachneAboutCurseQuest01"
    }
    {
      Id = "MelinoeField_4397"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kurasa kau benar. Kau benar-benar mendampratnya! Aku masih hampir tidak percaya. Termasuk fakta bahwa dia akhirnya membiarkanmu hidup."
      Speaker = "Melinoe"
      Event = "ArachneAboutCurseQuest01"
    }
    {
      Id = "Arachne_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kau tahu sendiri. Aku ini selalu punya sedikit sifat lekas naik darah. Rasanya lega bisa melampiaskan semuanya sekali-kali, masa bodoh apa pun yang terjadi! Dan sejak saat itu, aku menenun tanpa henti seolah hari esok takkan datang."
      Speaker = "Arachne"
      Event = "ArachneAboutCurseQuest01"
    }
    {
      Id = "Arachne_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau masih sering bertemu dengannya? Maksudku, Athena bermata kelabu itu. Dia pasti sudah tak memedulikan Arachne yang malang ini lagi, dan kembali mengurus masalah-masalah besarnya sebagai dewa, kurasa."
      Speaker = "Arachne"
      Event = "ArachneAboutCurseQuest02"
    }
    {
      Id = "MelinoeField_5295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang masih sesekali melihat Yang Mulia Athena, ya. Hubungan kami sudah kembali normal... setidaknya aku berpura-pura begitu. Aku tumbuh besar dengan membenci kakekku. Sekarang aku punya sepupu yang juga kubenci."
      Speaker = "Melinoe"
      Event = "ArachneAboutCurseQuest02"
    }
    {
      Id = "Arachne_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan biarkan hatimu membebanimu seperti itu, sahabatku. Percayalah padaku! Orang fana tidak terikat mati dengan keluarga mereka seperti halnya para dewa, dan kurasa kalian semua sudah cukup banyak bertikai untuk sementara waktu."
      Speaker = "Arachne"
      Event = "ArachneAboutCurseQuest02"
    }
    {
      Id = "MelinoeField_5296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma... aku hampir rindu saat-saat belum mengenal beberapa kerabatku ini sedalam sekarang. Perasaanku terhadap mereka sering kali berubah-ubah... sedetik kagum, sedetik kemudian jengkel."
      Speaker = "Melinoe"
      Event = "ArachneAboutCurseQuest02"
    }
    {
      Id = "Arachne_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitulah kenyataannya dalam keluarga, setidaknya bagi sebagian besar dari kita. Meski keluargamu tidak {#Emph}seburuk {#Prev}itu juga. Siapa tahu? Mungkin yang lainnya kelak bisa belajar satu atau dua hal dari{#Emph}mu. {#Prev}{#Emph}Ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutCurseQuest02"
    }
    {
      Id = "Arachne_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi kulihat kau baku hantam dengan penyihir yang sangat besar itu. Kenapa kalian berkelahi? Kukira kalian berada di pihak yang sama! {#Emph}Aduh{#Prev}, aku hampir tak bisa mengikuti segala hal belakangan ini."
      Speaker = "Arachne"
      Event = "ArachneAboutHecate01"
    }
    {
      Id = "Melinoe_1813"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Guru dan aku sebenarnya tidak benar-benar berkelahi. Yah... tidak juga sih, kurasa kami memang bertarung, tapi bukan karena amarah atau kesalahpahaman. Itu cuma caranya untuk memastikan aku benar-benar siap."
      Speaker = "Melinoe"
      Event = "ArachneAboutHecate01"
    }
    {
      Id = "Arachne_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hoo. {#Prev}Kalau begitu, tunjukkan padanya kemampuanku di kesempatan berikutnya ya, sahabatku? Jangan merasa terbebani lho! Tapi mungkin aku akan menonton diam-diam untuk berjaga-jaga. Aku janji tak akan mengganggu jalannya pertarungan."
      Speaker = "Arachne"
      Event = "ArachneAboutHecate01"
    }
    {
      Id = "Arachne_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, bagaimana kabar si penyihir besar itu, sahabatku? Aku sering melihatnya di hutan ini! Dan sesekali, dia menyapaku. Menyempatkan diri untuk Arachne yang malang ini. Betapa {#Emph}tidak seperti dewa-dewi {#Prev}lainnya, {#Emph}ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutHecate02"
    }
    {
      Id = "MelinoeField_1787"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Guru tampaknya setegar karang. Aneh rasanya... keyakinannya pada kemampuanku justru menjadi salah satu sumber beban terbesarku. Walaupun, aku tidak mungkin mengatakan hal itu padanya..."
      Speaker = "Melinoe"
      Event = "ArachneAboutHecate02"
    }
    {
      Id = "Arachne_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kenapa tidak boleh? Aku sendiri selalu ingin mendengar kejujuran darimu. Dia itu orang pintar, kan? Kemungkinan besar dia tahu ada yang tidak beres. Sebaiknya kalian berdua mengobrol {#Emph}empat mata{#Prev}, {#Emph}ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutHecate02"
    }
    {
      Id = "MelinoeField_1490"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, apa kau kebetulan melihat seorang dewi hutan berpatroli lewat sini? Pakaiannya serbahijau, membawa busur panah setinggi badannya?"
      Speaker = "Melinoe"
      Event = "ArachneAboutArtemis01"
    }
    {
      Id = "Arachne_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu dewi mana yang kaumaksud, sahabatku, dan aku tahu dia sedang mengintai ke sana-kemari. Biasanya, aku selalu menjauh dari dewi-dewi seperti {#Emph}itu. {#Prev}Bahkan meski mereka adalah keluargamu."
      Speaker = "Arachne"
      Event = "ArachneAboutArtemis01"
    }
    {
      Id = "MelinoeField_1491"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi seperti apa? Nadanya seolah-olah kau lebih takut pada Olimpus daripada Chronos sendiri."
      Speaker = "Melinoe"
      Event = "ArachneAboutArtemis01"
    }
    {
      Id = "Arachne_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, memang {#Emph}begitu! {#Prev}Bukan Chronos yang membuatku jadi seperti ini; malah aku sudah makin terbiasa seiring berjalannya waktu. Nah, pergilah temui dewi hutanmu itu. Dan hati-hati, jangan sampai membimbingnya ke sini, paham?"
      Speaker = "Arachne"
      Event = "ArachneAboutArtemis01"
    }
    {
      Id = "Arachne_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam tempo hari, kulihat kau sedang mengobrol dengan si Tukang Perahu tua yang belakangan ini makin sering muncul. Omong-omong, bagaimana kabarnya?"
      Speaker = "Arachne"
      Event = "ArachneAboutCharon01"
    }
    {
      Id = "MelinoeField_1788"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Charon menerima hampir segala hal dengan tenang. Tapi sampai dia bisa kembali menyeberangkan arwah orang mati ke tempat peristirahatan terakhir mereka, kurasa dia belum akan kembali sepenuhnya seperti dulu."
      Speaker = "Melinoe"
      Event = "ArachneAboutCharon01"
    }
    {
      Id = "Arachne_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingat saat aku menyelinap di perahu kecilnya! Entah bagaimana dia bisa melihatku di antara kargonya. Aduh, kukira riwayatku sudah tamat! Tapi dia terus mendayung begitu saja. Bahkan rela berhenti menurunkanku di Erebus, {#Emph}ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutCharon01"
    }
    {
      Id = "Arachne_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, itu kan Selendang yang kuberikan padamu! Lembut sekali, bukan? Semoga selendang itu bisa membantumu tetap hangat dan aman, ke mana pun perjalananmu membawamu. Nah, {#Emph}ini dia {#Prev}sedikit hiasan pelengkapnya..."
      Speaker = "Arachne"
      Event = "ArachneAboutKeepsake01"
    }
    {
      Id = "Arachne_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melangkah sangat jauh mengenakan selendang buatanku itu. Jauh lebih awet daripada gaun sutra murahan biasa, kan?"
      Speaker = "Arachne"
      Event = "ArachneAboutKeepsake02"
    }
    {
      Id = "MelinoeField_4423"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja. Dan tidak ada yang membuatku begitu percaya diri untuk terjun ke medan pertempuran selain hadiah yang kauberikan padaku malam-malam yang lalu ini."
      Speaker = "Melinoe"
      Event = "ArachneAboutKeepsake02"
    }
    {
      Id = "Arachne_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Syukurlah kalau begitu. Meski aku tidak bisa ikut menemanimu secara langsung, mengenakan pakaian buatanku adalah hal terbaik berikutnya."
      Speaker = "Arachne"
      Event = "ArachneAboutKeepsake02"
    }
    {
      Id = "Arachne_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aaah! {#Prev}Bukan, a-apa itu? Amfibia?! Singkirkan itu dari sini, sahabatku! {#Emph}Tolong {#Prev}bantu aku menyingkirkannya!"
      Speaker = "Arachne"
      Event = "ArachneAboutFrogFamiliar01"
    }
    {
      Id = "MelinoeField_1804"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tenanglah, Arachne. Ini Frinos! Frinos adalah teman; sebenarnya dia Familiarku. Dia sama sekali tidak berniat jahat padamu. Tapi stok lalatmu... yah, yang itu mungkin memang harus kita amankan."
      Speaker = "Melinoe"
      Event = "ArachneAboutFrogFamiliar01"
    }
    {
      Id = "Arachne_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}haha, ah {#Prev}syukurlah kalau {#Emph}begitu! {#Prev}Baiklah kalau begitu, {#Emph}Frinos... {#Prev}kalau kau memang benar seorang teman, kau diterima dengan hangat di sini. Dan kalau kau ingin camilan, kau {#Emph}sangat {#Prev}dipersilakan melahapnya juga."
      Speaker = "Arachne"
      Event = "ArachneAboutFrogFamiliar01"
    }
    {
      Id = "Arachne_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu kucing{#Emph}mu{#Prev}, sahabatku? Aku kurang suka dengan caranya yang terus {#Emph}mengawasiku. {#Prev}Untunglah aku ada di atas sini, {#Emph}haha! {#Prev}Tapi tunggu dulu... bukankah hewan itu bisa {#Emph}memanjat?"
      Speaker = "Arachne"
      Event = "ArachneAboutCatFamiliar01"
    }
    {
      Id = "MelinoeField_1805"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan khawatir, ini Toula, familiarku. Dan dia akan mengendalikan naluri kucingnya dengan baik di sekitar Arachne, kan, manis?"
      Speaker = "Melinoe"
      Event = "ArachneAboutCatFamiliar01"
    }
    {
      Id = "Arachne_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku suka sekali pada kucing... tapi sekarang mereka tak seakrab dulu denganku. Ya, kurasa alasannya sudah cukup jelas..."
      Speaker = "Arachne"
      Event = "ArachneAboutCatFamiliar01"
    }
    {
      Id = "Arachne_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kenapa aku ada di hutan ini alih-alih di atas sana? Karena di bawah sini jarang sekali ada burung. Jadi, tolong jauhkan si sayap putih itu dariku, ya?"
      Speaker = "Arachne"
      Event = "ArachneAboutRavenFamiliar01"
    }
    {
      Id = "MelinoeField_4413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Raki di sini bahkan takkan berani melirikmu...! Yah, dia memang beda dari burung gagak lainnya soal itu. Tapi maaf aku malah membawanya kemari. Seharusnya aku sadar."
      Speaker = "Melinoe"
      Event = "ArachneAboutRavenFamiliar01"
    }
    {
      Id = "Arachne_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tidak apa-apa, dasar konyol. Asalkan dia bersikap manis selama ada aku. Aku memang takkan pernah memercayai burung, tapi... aku memercayaimu."
      Speaker = "Arachne"
      Event = "ArachneAboutRavenFamiliar01"
    }
    {
      Id = "Arachne_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, maaf ya untuk semua bom sutra di luar sana! Itu gelembung lumpur korosif kecil yang kucoba bungkus agar mereda. Tapi, kalau kau meletuskannya terlalu cepat, mereka bakal berkobar seperti ngengat terbakar api, {#Emph}ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutMines01"
    }
    {
      Id = "Arachne_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Bisikan yang kau lihat melayang-layang itu... begitulah jadinya saat sesosok Arwah terjerat di pepohonan. Lama-kelamaan, mereka tak bisa membedakan mana ranting dan mana diri mereka. Mereka memang marah. Tapi bukan padamu, {#Emph}sahabatku."
      Speaker = "Arachne"
      Event = "ArachneAboutGuards01"
    }
    {
      Id = "Arachne_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Segala macam Arwah bisa berakhir di sini, tahu. Gelendong-gelendong kecil di seluruh tempat ini... entah mereka itu apa waktu masih bernapas dulu. Yang kutahu hanyalah mereka mati sebelum waktunya. Yah, begitulah jalan hidup, {#Emph}ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutRadiators01"
    }
    {
      Id = "Arachne_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih suka saat tempat ini belum dipenuhi para Pemboros itu. Kurasa mereka kehilangan arah sebelum mati. Sekarang setelah mereka semua tiada... kita bisa melihat wujud asli mereka yang sebenarnya, ya?"
      Speaker = "Arachne"
      Event = "ArachneAboutBrawlers01"
    }
    {
      Id = "Arachne_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu, sudah berapa banyak Peti yang harus kau tangkis? Begitu mencium apa pun yang bernapas, mereka langsung berkerumun seperti sedang tren saja. Dan, selalu saja {#Emph}meludah! {#Prev}Untungnya tubuhku terlalu kecil untuk bisa mereka lihat."
      Speaker = "Arachne"
      Event = "ArachneAboutMages01"
    }
    {
      Id = "Arachne_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hati-hatilah terhadap Peratap Duri di luar sana. Untung ada jaring-jaringku, jadi aku bisa tinggal di atas di tempat sulur-sulur jahat mereka tak bisa menjangkau. Tapi kalau untuk {#Emph}dirimu{#Prev}, kau mangsa empuk, apalagi dengan kaki telanjangmu..."
      Speaker = "Arachne"
      Event = "ArachneAboutSiegeVines01"
    }
    {
      Id = "Arachne_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jarang kulihat Penumpah Bayangan di sekitar sini! Untunglah, mengingat tempat ini sudah cukup gelap apa adanya. Bagaimana bisa ada begitu banyak jiwa yang membiarkan diri mereka {#Emph}terbelit {#Prev}seperti itu, aku takkan pernah mau tahu..."
      Speaker = "Arachne"
      Event = "ArachneAboutFogEmitters01"
    }
    {
      Id = "Arachne_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti sudah berulang kali berhadapan dengan Pengintai Akar sekarang. Mujur bagiku karena mereka biasanya lebih suka diam di tempat, jadi aku bisa menghindari mereka. Tapi badanmu kan lebih besar, tak bisa menyelinap begitu saja, kan...?"
      Speaker = "Arachne"
      Event = "ArachneAboutTreants01"
    }
    {
      Id = "Arachne_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah ada pelanggan lagi! Kau baru saja berpapasan dengan penyihir bertubuh besar itu. Jarang-jarang aku mendapat kehormatan dikunjungi olehnya. Kalau kau melihatnya lagi di luar sana, beri dia balasan yang setimpal untukku, ya? {#Emph}Hm ha ha ha..."
      Speaker = "Arachne"
      Event = "HecateWithArachne01_FollowUp"
    }
    {
      Id = "MelinoeField_1794"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau tidak apa-apa, sahabatku?"
      Speaker = "Melinoe"
      Event = "HecateWithArachne01_FollowUp"
    }
    {
      Id = "Arachne_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... {#Emph}ya! {#Prev}Ya, aku punya beberapa gaun baru untukmu. Nih! Mana yang kau inginkan?"
      Speaker = "Arachne"
      Event = "HecateWithArachne01_FollowUp"
    }
    {
      Id = "Arachne_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah hafal setiap ukuran tubuhmu sekarang, sahabatku, dan kurasa aku tahu gaya yang kau sukai, jadi... ada sedikit bingkisan di sini yang kupikir bakal kau sukai."
      Speaker = "Arachne"
      Event = "ArachneGrantsReward01"
    }
    {
      Id = "MelinoeField_4411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh? Arachne, kurasa mustahil bagimu melampaui karya-karyamu sebelumnya, tapi aku siap melihatmu mencobanya, jika kau bersikeras!"
      Speaker = "Melinoe"
      Event = "ArachneGrantsReward01"
    }
    {
      Id = "Arachne_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu saja aku bersikeras. Lihat ini... sutra sewarna darah. Warna keluargamu. Ini sangat halus, tapi jika kau menginginkannya, ini semua milikmu."
      Speaker = "Arachne"
      Event = "ArachneGrantsReward01"
    }
    {
      Id = "Arachne_0366"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hutan ini bisa jadi sangat sunyi. Suara tenunanku, yah, hampir tak terdengar... mungkin terdengar seperti desau dedaunan saja. Makanya aku bernyanyi kecil untuk diriku sendiri."
      Speaker = "Arachne"
      Event = "ArachneAboutQuiet01"
    }
    {
      Id = "MelinoeField_4389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hutan ini mungkin sunyi, tapi dipenuhi arwah-arwah yang resah. Kau bagaikan seberkas sinar rembulan di tengah-tengah semua ini."
      Speaker = "Melinoe"
      Event = "ArachneAboutQuiet01"
    }
    {
      Id = "Arachne_0367"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, manis sekali perkataanmu itu. Meski sinar rembulan tak punya begitu banyak warna berbeda seperti sutraku, kan?"
      Speaker = "Arachne"
      Event = "ArachneAboutQuiet01"
    }
    {
      Id = "Arachne_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau sudah mencapai suatu kemajuan, sahabatku? Aku tahu, apa pun yang kau lakukan, kau {#Emph}tidak pernah {#Prev}menyerah. Tapi aku sungguh tak tahu seberapa dekat kau dengan apa yang ingin kau raih."
      Speaker = "Arachne"
      Event = "ArachneAboutUltimateProgress01"
    }
    {
      Id = "MelinoeField_4414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah lebih dekat dari sebelumnya, tapi seberapa jauh lagi yang tersisa, sulit untuk dikatakan. Sutramu sungguh sangat membantu!"
      Speaker = "Melinoe"
      Event = "ArachneAboutUltimateProgress01"
    }
    {
      Id = "Arachne_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang sutra itu berguna dan sudah kuduga memang bakal begitu. Hanya yang {#Emph}terbaik {#Prev}untuk {#Emph}dirimu{#Prev}. Dan suatu malam nanti, kau pasti akan berhasil menembus {#Emph}semuanya{#Prev}. Dan mungkin berkat sutraku, {#Emph}ha ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneAboutUltimateProgress01"
    }
    {
      Id = "Arachne_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedang ada banyak peristiwa aneh di hutan ini, jauh lebih ramai dari biasanya! Para Jiwa Tersesat bertingkah aneh. Apa ada sesuatu yang terjadi dan harus kuketahui?"
      Speaker = "Arachne"
      Event = "ArachnePostTrueEnding01"
    }
    {
      Id = "MelinoeField_4415"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arachne, itu karena tugasku akhirnya tuntas! Yah, untuk sebagian besar. Raja Hades dan Ratu Persephone telah kembali, dan mereka akan segera memberi para Jiwa Tersesat di sini tempat untuk bernaung."
      Speaker = "Melinoe"
      Event = "ArachnePostTrueEnding01"
    }
    {
      Id = "Arachne_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, itu kabar yang {#Emph}sangat {#Prev}menyenangkan! Kau {#Emph}berhasil{#Prev}, sahabatku! Tapi kalau begitu, tampaknya perjuanganmu belum benar-benar selesai..."
      Speaker = "Arachne"
      Event = "ArachnePostTrueEnding01"
    }
    {
      Id = "MelinoeField_4416"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum, dan mungkin masih agak lama. Jadi kalau kau tidak keberatan, aku mungkin akan terus mampir sesekali. Bukan cuma demi gaun-gaun sutra yang indah ini, tapi juga untuk menyapamu."
      Speaker = "Melinoe"
      Event = "ArachnePostTrueEnding01"
    }
    {
      Id = "Arachne_0436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, salam kembali untukmu! Dan kau selalu diterima di sini kapan pun kau mau. Aku sangat bahagia untukmu!"
      Speaker = "Arachne"
      Event = "ArachnePostTrueEnding01"
    }
    {
      Id = "Arachne_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong-omong, jika Raja dan Ratu sudah kembali seperti katamu tadi, bukankah itu berarti... kenapa kau tak kembali ke istana mereka saja?"
      Speaker = "Arachne"
      Event = "ArachnePostTrueEnding02"
    }
    {
      Id = "MelinoeField_4417"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tumbuh besar di dekat hutan ini dan aku berniat untuk tetap tinggal di sini hingga waktu yang belum ditentukan. Terlalu banyak hal yang belum siap kutinggalkan."
      Speaker = "Melinoe"
      Event = "ArachnePostTrueEnding02"
    }
    {
      Id = "Arachne_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, dasar konyol. Hidupmu bisa jauh lebih {#Emph}enak{#Prev}, tahu. Mereka pasti akan memberimu gaun-gaun yang paling {#Emph}indah{#Prev}, aku yakin itu. Walau mungkin takkan seindah buatanku ini..."
      Speaker = "Arachne"
      Event = "ArachnePostTrueEnding02"
    }
    {
      Id = "MelinoeField_4418"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin takkan percaya ini, Arachne, tapi baru-baru ini aku bertemu dengan para Takdir sendiri! Ketiganya!"
      Speaker = "Melinoe"
      Event = "ArachnePostEpilogue01"
    }
    {
      Id = "Arachne_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, ya ampun, benarkah? Dan, apa kau sempat melihat apa yang sedang mereka kerjakan? Aku suka mengikuti perkembangan terbaru di dunia tenun-menenun."
      Speaker = "Arachne"
      Event = "ArachnePostEpilogue01"
    }
    {
      Id = "MelinoeField_4419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kalau boleh jujur, kurasa mereka sedang jeda di antara proyek-proyek, dan mungkin akan {#Emph}lebih sedikit {#Prev}menenun mulai sekarang..."
      Speaker = "Melinoe"
      Event = "ArachnePostEpilogue01"
    }
    {
      Id = "Arachne_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terdengar seperti mereka {#Emph}memang {#Prev}sudah tidak sanggup lagi. Tapi tidak apa-apa. Yang tua selalu harus memberi jalan bagi yang muda dan yang baru! Dan sebelum kau terlalu cemas kalau aku lancang bicara, kurasa mereka takkan memperhatikan orang kecil sepertiku, {#Emph}ha ha ha ha ha."
      Speaker = "Arachne"
      Event = "ArachnePostEpilogue01"
    }
    {
      Id = "Arachne_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku jadi penasaran apa lagi yang dikatakan para Dewi Takdir kepadamu. Memikirkan bahwa setiap helai benang yang mereka tenun memengaruhi hidup kita..."
      Speaker = "Arachne"
      Event = "ArachnePostEpilogue02"
    }
    {
      Id = "MelinoeField_4420"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesan yang kutangkap adalah mereka hendak pensiun. Membiarkan kita membuat keputusan kita sendiri. Namun, aku tak tahu apakah rasanya bakal berbeda dari sebelumnya."
      Speaker = "Melinoe"
      Event = "ArachnePostEpilogue02"
    }
    {
      Id = "Arachne_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat meragukannya. Pilihan-pilihan yang telah kubuat... kurasa tak ada seorang pun yang bisa membuatkannya untukku. Bahkan mereka bertiga sekalipun, {#Emph}ha ha ha ha ha."
      Speaker = "Arachne"
      Event = "ArachnePostEpilogue02"
    }
    {
      Id = "Arachne_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang sekali bisa bertemu denganmu di sini. Aku sudah menenun tanpa henti, jadi sering-seringlah mampir sesukamu, ya?"
      Speaker = "Arachne"
      Event = "ArachneAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_4424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Takkan kulewatkan. Malam-malamku tak selalu menyenangkan, tapi dirimu dan gaun sutramu selalu begitu!"
      Speaker = "Melinoe"
      Event = "ArachneAboutSayingLittle01"
    }
    {
      Id = "Arachne_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih banyak untuk itu, sungguh. Nah, pergilah, aku tak ingin menahanmu. Yah, sebenarnya ingin sih, tapi kau paham maksudku, {#Emph}ha ha ha ha ha."
      Speaker = "Arachne"
      Event = "ArachneAboutSayingLittle01"
    }
    {
      Id = "Arachne_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti kau melihat beberapa tenunan yang sedang kukerjakan di sepanjang jalan tadi, kan?"
      Speaker = "Arachne"
      Event = "ArachneChat01"
    }
    {
      Id = "Arachne_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat bersyukur kau ada di sini! Anggap saja rumah sendiri."
      Speaker = "Arachne"
      Event = "ArachneChat02"
    }
    {
      Id = "Arachne_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu tak banyak yang bisa kubantu, tapi terimalah ini."
      Speaker = "Arachne"
      Event = "ArachneChat03"
    }
    {
      Id = "Arachne_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan bisa bertemu denganmu. Kau tahu itu, kan?"
      Speaker = "Arachne"
      Event = "ArachneChat04"
    }
    {
      Id = "Arachne_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berhati-hatilah sebisa mungkin saat melangkah di luar sana, ya? {#Emph}Hm hm hm hm hm..."
      Speaker = "Arachne"
      Event = "ArachneChat05"
    }
    {
      Id = "Arachne_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutenun masing-masing pakaian ini dengan penuh cinta dan perhatian {#Emph}khusus {#Prev}untuk malam seperti ini!"
      Speaker = "Arachne"
      Event = "ArachneChat06"
    }
    {
      Id = "Arachne_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, jangan cemaskan jaring-jaring itu. Lagipula aku memang berniat menggantinya!"
      Speaker = "Arachne"
      Event = "ArachneChat07"
    }
    {
      Id = "Arachne_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin kau tampil {#Emph}paling {#Prev}menawan di luar sana malam ini, kawan."
      Speaker = "Arachne"
      Event = "ArachneChat08"
    }
    {
      Id = "Arachne_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pakaian terbaruku seringan bulu, dan sekukuh perak, kau akan lihat sendiri!"
      Speaker = "Arachne"
      Event = "ArachneChat09"
    }
    {
      Id = "Arachne_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang kembali di {#Emph}Busana, Pewarna, dan Kain Arachne! {#Prev}Ada yang bisa kubantu?"
      Speaker = "Arachne"
      Event = "ArachneChat10"
    }
    {
      Id = "Arachne_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih telah mengunjungi {#Emph}Busana, Pewarna, dan Kain Arachne! {#Prev}Silakan datang lagi!"
      Speaker = "Arachne"
      Event = "ArachneChat11"
    }
    {
      Id = "Arachne_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, bukankah ini pelanggan favoritku! Apa yang bisa kulakukan untukmu malam ini?"
      Speaker = "Arachne"
      Event = "ArachneChat12"
    }
    {
      Id = "Arachne_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau tak bisa tinggal lama... tapi sungguh luar biasa bisa melihatmu di sini, kawan."
      Speaker = "Arachne"
      Event = "ArachneChat13"
    }
    {
      Id = "Arachne_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya banyak pakaian yang baru ditenun ini untuk kau pilih!"
      Speaker = "Arachne"
      Event = "ArachneChat14"
    }
    {
      Id = "Arachne_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sutraku lebih kuat dari kelihatannya, semoga ini bisa membantumu tetap aman di luar sana."
      Speaker = "Arachne"
      Event = "ArachneChat15"
    }
    {
      Id = "Arachne_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tampak benar-benar memesona mengenakan sutra, kau tahu itu, kan?"
      Speaker = "Arachne"
      Event = "ArachneChat16"
    }
    {
      Id = "Arachne_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cobalah salah satu dari ini untuk melihat ukurannya, kawan, setelah itu aku takkan mengganggumu lagi."
      Speaker = "Arachne"
      Event = "ArachneChat17"
    }
    {
      Id = "Arachne_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu sarang kecilku ini agak melenceng dari jalurmu, jadi terima kasih sudah mengunjungiku di sini."
      Speaker = "Arachne"
      Event = "ArachneChat18"
    }
    {
      Id = "Arachne_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau yakin tak ingin mencicipi beberapa lalat? Masih segar, lho!"
      Speaker = "Arachne"
      Event = "ArachneChat19"
    }
    {
      Id = "Arachne_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, apa kau... melihat sesuatu yang kau sukai? {#Emph}Ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneChat20"
    }
    {
      Id = "Arachne_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, perhatikan baik-baik beberapa kepompongku di luar sana! Sengaja kubungkus khusus untukmu."
      Speaker = "Arachne"
      Event = "ArachneChat21"
    }
    {
      Id = "Arachne_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau takkan menemukan sutra berkualitas lebih tinggi di mana pun, baik di atas permukaan maupun di bawah sini."
      Speaker = "Arachne"
      Event = "ArachneChat22"
    }
    {
      Id = "Arachne_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku sudah merindukanmu. Kau akan segera kembali, kan?"
      Speaker = "Arachne"
      Event = "ArachneChat23"
    }
    {
      Id = "Arachne_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melihatmu di bawah siraman cahaya bulan purnama, astaga, benar-benar membuatku takjub."
      Speaker = "Arachne"
      Event = "ArachneChat24"
    }
    {
      Id = "Arachne_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir aku mendengar langkah lembutmu di antara pepohonan, dan kini kau benar-benar di sini!"
      Speaker = "Arachne"
      Event = "ArachneChat25"
    }
    {
      Id = "Arachne_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya saja ada lebih banyak hal yang bisa kulakukan untukmu, kawan..."
      Speaker = "Arachne"
      Event = "ArachneChat26"
    }
    {
      Id = "Arachne_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti rasanya sangat berat bagimu saat ini, tapi tetaplah bersemangat, ya?"
      Speaker = "Arachne"
      Event = "ArachneChat27"
    }
    {
      Id = "Arachne_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berjanjilah kau akan memberitahuku jika pakaian ini tidak pas sempurna di tubuhmu."
      Speaker = "Arachne"
      Event = "ArachneChat28"
    }
    {
      Id = "Arachne_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka selalu bilang sutraku ini bagai pelukan hangat, {#Emph}ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneChat29"
    }
    {
      Id = "Arachne_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak sudi membiarkanmu pergi tanpa mengenakan pakaian yang terbaik."
      Speaker = "Arachne"
      Event = "ArachneChat30"
    }
    {
      Id = "Arachne_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua ini baru saja ditenun dan pasti pas sekali untukmu, Sahabatku!"
      Speaker = "Arachne"
      Event = "ArachneChat31"
    }
    {
      Id = "Arachne_0370"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mana pun yang paling memikat hatimu saat ini, ambillah sesukamu."
      Speaker = "Arachne"
      Event = "ArachneChat32"
    }
    {
      Id = "Arachne_0371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kamu bakal mampir lagi! Sudah beberapa malam berlalu sejak terakhir kali, kan?"
      Speaker = "Arachne"
      Event = "ArachneChat33"
    }
    {
      Id = "Arachne_0372"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu baru saja dari permukaan belakangan ini, kan? Kalau begitu, selamat datang kembali!"
      Speaker = "Arachne"
      Event = "ArachneChat34"
    }
    {
      Id = "Arachne_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gaun-gaunku memang tak diciptakan tahan lama, tapi aku yakin kamu bisa memanfaatkannya sebaik mungkin!"
      Speaker = "Arachne"
      Event = "ArachneChat35"
    }
    {
      Id = "Arachne_0374"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini semestinya melindungimu dari penyihir raksasa itu dan rintangan apa pun berikutnya."
      Speaker = "Arachne"
      Event = "ArachneChat36"
    }
    {
      Id = "Arachne_0375"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa memberimu perlindungan, sekaligus penampilan baru yang menawan!"
      Speaker = "Arachne"
      Event = "ArachneChat37"
    }
    {
      Id = "Arachne_0376"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu kelihatannya pantang menyerah, Sahabatku. Jadi aku pun tidak akan menyerah."
      Speaker = "Arachne"
      Event = "ArachneChat38"
    }
    {
      Id = "Arachne_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku suka menyendiri, tapi juga suka ditemani olehmu. Jadi ini benar-benar hal yang menyenangkan!"
      Speaker = "Arachne"
      Event = "ArachneChat39"
    }
    {
      Id = "Arachne_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba lihat semua sutra ini! {#Emph}Ha ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneChat40"
    }
    {
      Id = "Melinoe_1606"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap kali melewati Erebus, rasanya menenangkan mengetahui aku mungkin berpapasan denganmu di sepanjang jalan. Ini sesuatu untuk sarang manismu."
      Speaker = "Melinoe"
      Event = "ArachneGift01"
    }
    {
      Id = "Arachne_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, ini manis sekali! Semestinya ini bisa memikat sekawanan lalat, jadi terima kasih banyak, {#Emph}banyak {#Prev}sekali! Nah, maukah kamu menerima ini? Anggap saja imbalan yang adil...!"
      Speaker = "Arachne"
      Event = "ArachneGift01"
    }
    {
      Id = "Arachne_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, apa ini yang kupikirkan? Aduh, {#Emph}jangan{#Prev}, jangan lagi. Menenun busana sutra seindah ini untuk sosok sepertimu adalah kehormatan dan imbalan tersendiri bagiku! Lagi pula, barang ini kan untuk para dewa..."
      Speaker = "Arachne"
      Event = "ArachneGift02"
    }
    {
      Id = "MelinoeField_1797"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa mungkin yang paling sering menikmatinya, tapi ini bukan cuma buat mereka. Ini untukmu! Untuk orang-orang yang kuanggap sebagai sahabat."
      Speaker = "Melinoe"
      Event = "ArachneGift02"
    }
    {
      Id = "Arachne_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, kamu terlalu baik padaku! Aku cuma melakukan apa yang akan dilakukan siapa saja di posisiku, tapi {#Emph}kamu? {#Prev}Kamu memperlakukanku bak bangsawan! Nektar ini... aku sempat mencicipi sedikit sebelumnya. Ini terlalu mewah untuk lalat... atau laba-laba."
      Speaker = "Arachne"
      Event = "ArachneGift03"
    }
    {
      Id = "MelinoeField_1798"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terlalu mewah untuk lalat, mungkin saja. Tapi ini khusus untuk{#Emph}mu. {#Prev}Tanda persahabatan, yang kelezatannya kian terasa seiring dalamnya persahabatan kita. Semoga ini bisa menghangatkanmu di malam sedingin ini."
      Speaker = "Melinoe"
      Event = "ArachneGift03"
    }
    {
      Id = "Arachne_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahlah, ini sungguh berlebihan! Andai aku masih menjadi diriku yang dulu, pipiku pasti sudah bersemu merah sampai ke ujung kaki. Hanya saja... sudah lama sekali tidak ada yang memberiku apa pun, kamu tahu kan?"
      Speaker = "Arachne"
      Event = "ArachneGift04"
    }
    {
      Id = "MelinoeField_1799"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang memberimu hal-hal seperti ini, Arachne. Terkadang sedih rasanya melihatmu sendirian seperti ini. Aku tak pernah bisa singgah lama-lama... jadi mungkin Nektar ini bisa mengingatkanmu pada saat-saat menyenangkan yang kita lalui bersama, saat aku tak ada di sini."
      Speaker = "Melinoe"
      Event = "ArachneGift04"
    }
    {
      Id = "Arachne_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah pasti. Kebaikanmu takkan pernah kulupakan."
      Speaker = "Arachne"
      Event = "ArachneGift04"
    }
    {
      Id = "Arachne_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ha ha ha ha{#Prev}, aku bukannya mau bersikap lancang, hanya saja... {#Emph}bayangkan {#Prev}apa kata para dewa di atas sana, melihat tradisi mereka yang {#Emph}paling dibanggakan {#Prev}dipakai untuk menghormati makhluk yang {#Emph}paling hina {#Prev}di dunia ini."
      Speaker = "Arachne"
      Event = "ArachneGift05"
    }
    {
      Id = "MelinoeField_1800"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu tidak hina! Kamu punya bakat yang luar biasa. Suara yang indah. Sahabat tepercaya. Aku tak kenal siapa pun yang sepertimu, Arachne! Dan aku senang kamu adalah {#Emph}kamu. {#Prev}Persis seperti dirimu saat ini. Aku bersungguh-sungguh."
      Speaker = "Melinoe"
      Event = "ArachneGift05"
    }
    {
      Id = "Arachne_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "A... aku—aku merasa tersanjung kamu menganggapku begitu... hanya saja... sayang sekali kamu tak pernah mengenalku di masa kejayaanku dulu, ya? {#Emph}Ah{#Prev}, tapi bicara apa sih aku ini, aku cuma... {#Emph}ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneGift05"
    }
    {
      Id = "Arachne_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kamu melakukan ini hanya karena berbaik hati, Sahabatku, tapi... hati tak bisa diatur, dan... a, yah... aku khawatir mulai salah mengartikannya! Aku memang suka menyendiri... tapi terkadang aku masih merasa kesepian."
      Speaker = "Arachne"
      Event = "ArachneGift06"
    }
    {
      Id = "MelinoeField_1801"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun merasa kesepian. Tapi saat berada di sini, bersamamu di sarang kecil yang nyaman ini, rasanya... entahlah, aku... cuma ingin kamu lebih bahagia! Mungkin seperti katamu barusan; hati tak bisa diatur."
      Speaker = "Melinoe"
      Event = "ArachneGift06"
    }
    {
      Id = "Arachne_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, malangnya hatimu jika yang didambakannya hanyalah {#Emph}ini! {#Prev}Kamu ini seorang dewi... sungguh menawan, apa kamu sadar? Pasti ada belasan orang yang rela jungkir balik hanya demi meraih kasih sayangmu!"
      Speaker = "Arachne"
      Event = "ArachneGift06"
    }
    {
      Id = "MelinoeField_1802"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalaupun ada, hubunganku dengan yang lain... tak ada yang bisa menggantikan persahabatan yang kujalin denganmu."
      Speaker = "Melinoe"
      Event = "ArachneGift06"
    }
    {
      Id = "Arachne_0115"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu rupanya... {#Emph}ha ha ha ha..."
      Speaker = "Arachne"
      Event = "ArachneGift06"
    }
    {
      Id = "MelinoeField_4400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin kamu memiliki ini: Ambrosia para dewa. Kamu memiliki bakat kami, bahkan memiliki kebanggaan kami. Kupikir, apalah artinya menambah satu lagi anugerah terbesar kami untukmu?"
      Speaker = "Melinoe"
      Event = "ArachneGift07"
    }
    {
      Id = "Arachne_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ambrosia... kamu bakal memanjakanku kalau begini terus, dasar konyol! Mau kubuat apa sebanyak ini? Bisa kusesap selamanya!"
      Speaker = "Arachne"
      Event = "ArachneGift07"
    }
    {
      Id = "MelinoeField_4401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamanya itu waktu yang lama. Dan idealnya, ini memang untuk dinikmati bersama. Mungkin saat pembukaan besar tokomu kelak!"
      Speaker = "Melinoe"
      Event = "ArachneGift07"
    }
    {
      Id = "Arachne_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, {#Emph}itu {#Prev}ide bagus. Kalau begitu, sebaiknya kusimpan ini baik-baik, dan aku tahu {#Emph}persis {#Prev}caranya... dibungkus dengan sutra terhalus."
      Speaker = "Arachne"
      Event = "ArachneGift07"
    }
    {
      Id = "MelinoeField_4402"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga kelak 'Busana, Pewarna, dan Kain Arachne' sukses besar, kapan pun saatnya tiba. Rasanya menyenangkan selalu punya sesuatu untuk dinanti-nantikan, walau masih lama sekalipun."
      Speaker = "Melinoe"
      Event = "ArachneGift08"
    }
    {
      Id = "Arachne_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, murah hati sekali kamu, Sahabatku, dan aku pasti sudah memelukmu andai saja bisa terjangkau, dan andai kamu bersedia, tapi... lebih baik aku mengagumimu dari jauh saja."
      Speaker = "Arachne"
      Event = "ArachneGift08"
    }
    {
      Id = "MelinoeField_4403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi aku tidak jauh; aku ada di sini. Dan aku ingin kau tahu, aku senang kau tidak berubah. Jika kau berubah... mungkin aku sudah kehilanganmu."
      Speaker = "Melinoe"
      Event = "ArachneGift08"
    }
    {
      Id = "Arachne_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa saja kehilangan aku sekarang karena tubuhku {#Emph}memang {#Prev}cukup kecil! Tapi terima kasih, sungguh. Dulu kupikir kau hanya bicara begitu karena kasihan padaku, tapi sekarang aku tahu tidak demikian."
      Speaker = "Arachne"
      Event = "ArachneGift08"
    }
    {
      Id = "Arachne_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cukup Ambrosia-nya, {#Emph}kumohon{#Prev}, sobat. Tempatku sudah tidak muat lagi! Dan kau sudah memberi makhluk kecil ini lebih dari cukup."
      Speaker = "Arachne"
      Event = "ArachneGift09"
    }
    {
      Id = "MelinoeField_4404"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, tapi... mungkin kapan-kapan kita bisa menikmatinya berdua. Sekarang pun boleh...? Berhubung tempatmu {#Emph}memang {#Prev}sudah tidak muat."
      Speaker = "Melinoe"
      Event = "ArachneGift09"
    }
    {
      Id = "Arachne_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Yah, kalau kau tidak terlalu sibuk, dengan senang hati kuterima. Mau tolong buka botolnya? Tutupnya agak terlalu keras untukku..."
      Speaker = "Arachne"
      Event = "ArachneGift09"
    }
    {
      Id = "Arachne_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau begitu bermurah hati dengan waktu dan kasih sayangmu. Sebagian besar manusia fana membenci laba-laba... aku tak bisa membayangkan para dewi atau dewa merasakan hal yang berbeda."
      Speaker = "Arachne"
      Event = "ArachneGift09"
    }
    {
      Id = "MelinoeField_4405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wajar jika orang takut pada apa yang tidak mereka pahami. Aku seorang penyihir; kami sering mengalaminya. Mungkin itu sebabnya aku merasa terhubung denganmu sejak awal."
      Speaker = "Melinoe"
      Event = "ArachneGift09"
    }
    {
      Id = "Arachne_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau merasa terhubung denganku karena kau {#Emph}menginjakku{#Prev}, sobat! Untung saja kau mendengar jeritanku sekuat tenaga. Itu bukan cara terbaik untuk berkenalan..."
      Speaker = "Arachne"
      Event = "ArachneGift09"
    }
    {
      Id = "MelinoeField_4406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin tidak, tapi kurasa ujung-ujungnya berjalan baik. Dan aku tak pernah menginjakmu lagi, kan?"
      Speaker = "Melinoe"
      Event = "ArachneGift09"
    }
    {
      Id = "Arachne_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, memang tidak, kurasa. Ngomong-ngomong, Ambrosia ini {#Emph}benar-benar {#Prev}luar biasa! Sedikit saja rasanya sudah begitu nikmat!"
      Speaker = "Arachne"
      Event = "ArachneGift09"
    }
    {
      Id = "MelinoeField_4407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, kan? Aku senang kau menikmatinya. Selalu paling nikmat bersama orang yang kau sayangi, dan yang ini jelas racikan yang bagus."
      Speaker = "Melinoe"
      Event = "ArachneGift09"
    }
    {
      Id = "Arachne_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar peduli padaku, {#Emph}ya. {#Prev}Sudah sekian lama aku tak membiarkan diriku percaya. Tapi sekarang kau {#Emph}tahu {#Prev}aku takkan pernah kembali seperti dulu, dan kau tetaplah dirimu."
      Speaker = "Arachne"
      Event = "ArachneGift09"
    }
    {
      Id = "MelinoeField_4408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak tahu harus menjadi siapa lagi. Bagaimana denganmu? Jika kau bisa menjadi apa pun atau siapa pun yang lain, apa yang akan kau pilih?"
      Speaker = "Melinoe"
      Event = "ArachneGift09"
    }
    {
      Id = "Arachne_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, aku... yah, aku akan memilih untuk menjadi penenun terhebat yang pernah dikenal dunia. Dan aku memilih itu sekarang juga."
      Speaker = "Arachne"
      Event = "ArachneGift09"
    }
    {
      Id = "Arachne_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi itu benar-benar menyenangkan, sobat. Terima kasih banyak sudah berada di sini bersamaku. Untuk segalanya."
      Speaker = "Arachne"
      Event = "ArachneGift09"
    }
    {
      Id = "MelinoeField_4410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja. Kau juga temanku."
      Speaker = "Melinoe"
      Event = "ArachneGift09"
    }
    {
      Id = "Melinoe_1915"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Arachne, ini indah sekali...!"
      Speaker = "Melinoe"
      Event = "NPC_Arachne_01.GiftGivenVoiceLines"
    }
    {
      Id = "Arachne_0252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, ayolah...!"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.LastStandReactionVoiceLines"
    }
    {
      Id = "Arachne_0253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, tidak...!"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.LastStandReactionVoiceLines"
    }
    {
      Id = "Arachne_0254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak sanggup melihatnya...!"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.LastStandReactionVoiceLines"
    }
    {
      Id = "Arachne_0255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Terkesiap>"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.LastStandReactionVoiceLines"
    }
    {
      Id = "Arachne_0289"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei!"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.OnHitVoiceLines"
    }
    {
      Id = "Arachne_0290"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Eits!"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.OnHitVoiceLines"
    }
    {
      Id = "Arachne_0291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau main-main, ya?"
      Speaker = "Arachne"
      Event = "NPC_Arachne_01.OnHitVoiceLines"
    }
    {
      Id = "Arachne_0292"
