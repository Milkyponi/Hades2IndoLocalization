      Event = "GlobalVoiceLines.CostumeChangedVoiceLines"
    }
    {
      Id = "Arachne_0183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, kau tampak {#Emph}menakjubkan!{#Prev}"
      Speaker = "Arachne"
      Event = "GlobalVoiceLines.CostumeChangedVoiceLines"
    }
    {
      Id = "Arachne_0189"
