      Event = "HoundFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3778"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kepala Sekolah mendidikmu dengan sangat baik."
      Speaker = "Melinoe"
      Event = "HoundFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3779"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau aman bersamaku."
      Speaker = "Melinoe"
      Event = "HoundFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3780"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gadis pintar, Hecuba."
