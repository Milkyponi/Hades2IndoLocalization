{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _FamiliarData.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "Melinoe_2500"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, Frinos."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.EquipVoiceLines"
    }
    {
      Id = "Melinoe_2501"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau ikut denganku, Frinos?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.EquipVoiceLines"
    }
    {
      Id = "Melinoe_3880"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo berangkat, Frinos."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.EquipVoiceLines"
    }
    {
      Id = "Melinoe_2766"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini camilan yang sangat istimewa, Frinos."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.RecruitVoiceLines"
    }
    {
      Id = "Melinoe_2767"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Artinya kau akan terlindungi saat bersamaku; dan sebaliknya, kau juga bisa melindungiku."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.RecruitVoiceLines"
    }
    {
      Id = "HecateField_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Katak sialan itu..."
      Speaker = "Hecate"
      Event = "FrogFamiliar.OnHitVoiceLines"
    }
    {
      Id = "HecateField_0138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutukan itu tadi ditujukan untuk {#Emph}kamu!"
      Speaker = "Hecate"
      Event = "FrogFamiliar.OnHitVoiceLines"
    }
    {
      Id = "ErisField_0427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ditangkis?!"
      Speaker = "Eris"
      Event = "FrogFamiliar.OnHitVoiceLines"
    }
    {
      Id = "ErisField_0428"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa-apaan?!"
      Speaker = "Eris"
      Event = "FrogFamiliar.OnHitVoiceLines"
    }
    {
      Id = "ErisField_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Katak sialan!"
      Speaker = "Eris"
      Event = "FrogFamiliar.OnHitVoiceLines"
    }
    {
      Id = "ErisField_0430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kecil-kecil begini...!"
      Speaker = "Eris"
      Event = "FrogFamiliar.OnHitVoiceLines"
    }
    {
      Id = "Melinoe_2948"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat kan apa akibatnya kalau keluyuran semalaman, Frinos?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku baru saja bertemu Sang Takdir Kematian, Frinos...! Tak yakin apa aku harus senang soal itu."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sempat melihat sosok tinggi bertanduk lewat sini...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3440"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama sepertimu yang bisa bernapas di luar air... aku pun bisa menghirup udara permukaan."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semalam serasa mimpi... terutama bagian akhirnya. Kira-kira Gusti Moros ada di sekitar sini tidak, ya."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2836"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chronos menawan keluargaku... dan bahkan para Dewi Takdir Moirai...? Oh, Frinos..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia sudah tiada, Frinos... Sang Bapa Segala Monster. Kini tinggal satu ancaman besar tersisa."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5775"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Typhon sudah binasa, Frinos...! Sebentar lagi, aku bisa mengakhiri semua ini..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5197"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku harus melakukannya... Aku harus melakukannya... Aku harus melakukannya..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan kira aku melupakanmu, kawan kecil. Kita benar-benar berhasil, ya?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak setiap malam kita bisa bertemu para Dewi Takdir... mungkin aku masih agak syok."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5776"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aneh sekali... pernahkah kau merasa semua ini sudah pernah terjadi sebelumnya, Frinos...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5771"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku butuh satu bahan lagi untuk Pelarutan Waktu... tapi takkan kutemukan di Dunia Bawah."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5193"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam yang luar biasa! Chronos berhasil ditaklukkan, dan setelah itu... kau pasti takkan percaya."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5726"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku paham jalan pikiran Zagreus, tapi... dia belum pernah merasakan semua penderitaan ini."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5728"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupikir kakakku mulai melunak. Mungkin aku juga. Pasti ada jalan keluarnya..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5773"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tugasku, caraku... Kuharap ini berhasil... dan Kepala Sekolah bisa memahaminya."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada kemajuan, Frinos... sebentar lagi semua ini akhirnya bisa usai."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5772"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dunia Bawah dan Zagreus harus menunggu sebentar... Aku masih punya urusan di Olympus."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5774"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Frinos... andai kita bisa menghentikan Chronos tanpa membinasakannya... bukankah sebaiknya begitu...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2846"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sudah tahu aku pasti bisa, kan, Frinos?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2848"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hasil yang memuaskan untuk kali ini, bukan begitu?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2850"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senang bisa kembali ke sini bersamamu... tapi, malam baru telah tiba..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu kemungkinan lagi telah berkurang bagi segalanya untuk menjadi kacau bagi kita."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau coba lagi, Frinos? Mungkin kita berhadapan dengan kemungkinan tanpa batas."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2845"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa percaya nggak, si kecil? Berhasil... berhasil kukalahkan...! Sekarang bagaimana...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2847"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita benar-benar memberinya {#Emph}pelajaran{#Prev}, kan, Frinos?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2849"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kena lagi dia. Tapi perjalanan kita belum selesai, bukan?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2931"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa kau takkan suka tinggal di Rumah itu dibanding di sini..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3953"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mmm-muah! {#Prev}Kita mengalahkan Sang Ayah Segala Monster, Frinos...!"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak pernah terbayang aku bisa melihat Istana Zeus dengan mataku sendiri... tapi aku lega bisa kembali."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3954"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu seharusnya bisa memperlambat Typhon sebentar... atau malah membuatnya makin murka."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_4025"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah lama tak dengar lagu lama kita, kan? Nikmatilah selagi dia masih di sini!"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seumur hidupku bersiap, tapi rasanya masih jauh dari kata siap, ya..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapan-kapan kau harus ikut denganku ke luar sana, si kecil. Asalkan aku bisa melindungimu."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita berhasil kembali ke sini dengan selamat, kan, Frinos?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2316"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menurutmu Nemesis berniat membantu, atau cuma ingin menang?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1675"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku pernah menghadapi Root-Stalker sebelumnya... tapi tadi rasanya pikiranku mendadak kosong..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1676"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana bisa aku kalah dari Shadow-Spiller seperti itu? {#Emph}Ungh{#Prev}, memalukan sekali..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1887"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia sudah hampir tumbang, tapi aku gagal menghabisinya."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Frinos, bagaimana caraku bisa mengalahkan Ibu Kepala Sekolah...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ibu Kepala Sekolah mengalahkanku lagi, Frinos... tapi aku takkan mundur."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasanya seperti tiga lawan satu saat menghadapi Ibu Kepala Sekolah di luar sana..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2311"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beliau mengajariku untuk lebih tangguh dari ini. Akan kubuktikan padanya..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5475"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seharusnya aku tak kalah dari Ular Laut, meski yang tadi {#Emph}memang {#Prev}besar sekali..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2315"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beberapa amfibi makan hewan pengerat, kan, Frinos...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5476"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayangnya, hama kecil tadi menimbulkan masalah yang cukup merepotkan..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_4127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita rahasiakan saja kegagalanku mengalahkan sekawanan Hellifish tadi..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Frinos, nyanyian Siren terkutuk itu tak bisa hilang dari kepalaku..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2313"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siren itu bangsa amfibi... kau tahu kelemahan mereka, Frinos?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya Scylla sempat menggelar pertunjukan besar seperti yang selalu dia inginkan, kan?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2314"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mungkin lebih menyukai Oceanus di bawah sana dibanding diriku saat ini..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2765"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para Phantom pasti girang menemukan darah segar, kurasa..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2764"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa kau dan Lamia takkan cocok berteman, Frinos..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2762"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu tadi anjing keluargaku... pasti dia. Aku harus menolongnya...!"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2763"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cerberus dibutakan oleh amarahnya... dia butuh pertolongan kita, Frinos."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cerberus benar-benar ganas, persis seperti reputasinya yang tersohor, bukan...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2712"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tempat tadi {#Emph}sungguh {#Prev}kelam dan menyedihkan, ya...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2714"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jiwaku nyaris hancur di sana... aku tak sanggup bertahan."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2715"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Penuh derita dan duka di Ladang itu... tapi aku harus melewatinya."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2810"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chronos masih meremehkanku... itu artinya aku punya peluang nyata untuk menundukkannya..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Titan Waktu... bahkan dengan semua latihanku, aku tetap tak bisa mengalahkannya..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2809"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berhasil mencapai Chronos... satu-satunya tempat aku bisa mengalahkannya. Tapi aku belum mampu. Belum saatnya..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2840"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di mana sih Chronos menemukan para Satyr sialan itu...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2837"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hampir sampai, tapi yah, hampir saja tidaklah cukup, kan?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2838"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang sudah mereka perbuat pada Tartarus, Frinos? Sama sekali tak seperti yang kudengar..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2839"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukira Tartarus bakal sangat mengerikan, dan dugaanku benar-benar tepat..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0359"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pernah berhadapan dengan Cyclops, Frinos? Belum pernah?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3831"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu Cyclops itu sangat kuat, tapi tak perlu juga belajar lewat pengalaman pahit seperti tadi..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nyonya Medea bekerja sama dengan Polyphemus? Kehendak Malam terkadang {#Emph}amat {#Prev}aneh..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2841"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Udara di atas sana sama sekali tak cocok denganku..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2842"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan malam terbaikku tadi, tapi aku harus mencobanya..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2843"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya aku memang tak cocok hidup di kota, Frinos..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2844"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak banyak keramahan yang kutemukan di kota besar di atas sana..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana bisa putri Nyx berbalik melawan kita? Dan menghajarku habis-habisan pula..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak mungkin bisa berdamai dengan orang seperti Eris, kan? Sifatnya memang begitu."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3819"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya sedikit pelaut yang hidup untuk menceritakan pertemuan mereka dengan Charybdis, jadi lumayanlah, Frinos..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_4126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari mana kapten kapal itu mendapatkan senjata yang begitu mirip dengan Rail of Adamant...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mulai merasa kehidupan pelaut bukan untukku."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dulu aku bermimpi berlayar di lautan permukaan, tapi bukan seperti tadi..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3817"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika Prometheus tahu semua yang akan terjadi, maka dia pasti tahu aku takkan menyerah..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3818"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kebencian Titan itu pada para dewa... telah membutakan akal sehatnya. Dia bisa dikalahkan."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ternyata teman Prometheus bukan cuma seekor elang... sebaiknya rahasiakan ini dulu untuk sekarang."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3820"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu banyak masalah di Olympus yang harus dihadapi, dan Talos juga melawanku...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3821"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tahu keadaan Olympus sedang gawat saat bukan cuma Harpy, tapi para Dracon juga mulai bersarang di sana."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_4124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Monster tadi malam benar-benar menutupi kebodohannya dengan kekuatan fisik..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_4125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Monster-monster mengerikan itu menjadikanku mangsa... takkan kubiarkan hal itu terulang lagi..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3950"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berlatih untuk membunuh Chronos, bukan sang Ayah Segala Monster... apa yang harus kulakukan...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_4246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Typhon bukannya tak bisa dilukai, bagaimanapun kelihatannya. Aku harus kembali ke sana..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3951"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya aku segera kembali ke Olympus sebelum Typhon mendapatkan apa yang diinginkannya."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3952"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kuhabisi Typhon sialan itu atas perbuatannya, Frinos. Lihat saja nanti."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3955"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Typhon bakal meratakan gunung itu sampai ke tanah, kecuali..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayah Segala Monster dan Sang Titan Waktu, bersama-sama... mana mungkin aku bisa melawan mereka berdua...?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3822"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayangnya gunung para dewa tak seramah yang kuharapkan..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3823"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ternyata mendaki Gunung Olimpus bisa cukup berbahaya ya, Frinos."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5705"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ternyata kakakku lumayan lihai dengan tombak... sementara aku sedang tidak dalam kondisi terbaik."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5706"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Zagreus mengalahkanku lagi... ini sama sekali tidak bisa dibiarkan, Frinos."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ungh{#Prev}, Frinos... mungkin harusnya aku lebih sadar diri sebelum mengutak-atik Sumpah Gaib."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sudah mengucapkan Sumpah itu, wajar kalau aku harus menanggung akibatnya, Frinos..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah cukup lama sejak terakhir kali aku mengobrol denganmu begini, aku tahu..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1886"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau suka hujan-hujanan begini, kan, si kecil?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih karena selalu ada di sisiku..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana menurutmu rutinitas malam kita akhir-akhir ini, {#Emph}hm?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin kau ingin ikut denganku lagi suatu malam nanti."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat, Frinos? Aku perginya tidak terlalu lama, kan."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0831"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sialan, Frinos. Aku tak bisa melakukan ini. Bagaimana kalau aku memang tak sanggup?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0832"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang terjadi tadi, Frinos? Harusnya aku bisa lebih baik dari ini."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0833"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu harusnya tadi aku bisa berbuat lebih baik."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Orang terkutuk sialan itu berhasil mengenaku, Frinos. Lain kali aku akan menjaga jarak aman."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0012_V3"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tadi benar-benar tidak berjalan sesuai rencana, Frinos. Maukah kau memaafkanku?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0354"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bertindak ceroboh tadi di sana, ya, Frinos..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0355"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya aku membuat beberapa kesalahan tadi di sana, Frinos."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku harus lebih berhati-hati, kan, Frinos..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0360"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pasti tidak ingin tahu apa yang terjadi tadi di sana, Frinos..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1677"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tahu apa kata pepatah, Frinos: Kegagalan adalah guru yang paling berharga."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2811"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mungkin bisa membayangkan bagaimana jadinya tadi, Frinos..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2812"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan beritahu siapa pun soal kecerobohanku tadi di sana, ya, Frinos..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3824"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kira-kira apa yang seharusnya kulakukan secara berbeda tadi malam, {#Emph}hm?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3441"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selalu ada untukku, kan..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3442"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam berganti, pelajaran baru didapat..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3443"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau selalu mengawasiku... kau dan Arwah-Arwah kecil ini..."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0357"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih sudah membantuku kembali, Frinos."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0358"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, Frinos. Aku harus segera pergi. Jaga dirimu baik-baik, ya."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3825"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Istirahatku sudah cukup untuk lanjut lagi, tapi kau santai saja dulu lebih lama, oke?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3826"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih sudah menjaga tempat ini selagi aku pergi, Frinos."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3827"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya aku bergegas kembali, Frinos. Tapi aku ingin menyapamu dulu sebelum berangkat lagi."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ujian Chaos ini... kita tidak mengubah realitas {#Emph}terlalu {#Prev}banyak, kan, Frinos?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Entah Chaos memang tertarik melihat kemenanganku, atau mungkin aku cuma sekadar hiburan baginya."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1888"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mmm-mwah."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1889"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mmm-hmhmhm."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1890"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau selalu ada untukku."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1891"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan biarkan keadaanku membuatmu murung."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1892"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tetap di sana saja, ya?"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1893"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarilah, serangga kecil."
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0351"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tertawa>"
      Speaker = "Melinoe"
      Event = "FrogFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3974"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Toula."
      Speaker = "Melinoe"
      Event = "CatFamiliar.PreAttackVoiceLines"
    }
    {
      Id = "Melinoe_3975"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Toula?"
      Speaker = "Melinoe"
      Event = "CatFamiliar.PreAttackVoiceLines"
    }
    {
      Id = "Melinoe_3969"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Toula!"
      Speaker = "Melinoe"
      Event = "CatFamiliar.PreAttackVoiceLines"
    }
    {
      Id = "Melinoe_3970"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maju, Toula!"
      Speaker = "Melinoe"
      Event = "CatFamiliar.PreAttackVoiceLines"
    }
    {
      Id = "Melinoe_3971"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Toula, {#Emph}sekarang!"
      Speaker = "Melinoe"
      Event = "CatFamiliar.PreAttackVoiceLines"
    }
    {
      Id = "Melinoe_3972"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bangun, Toula!"
      Speaker = "Melinoe"
      Event = "CatFamiliar.PreAttackVoiceLines"
    }
    {
      Id = "Melinoe_3973"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, pus!"
      Speaker = "Melinoe"
      Event = "CatFamiliar.PreAttackVoiceLines"
    }
    {
      Id = "Melinoe_3976"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ckc-ckc-ckc!"
      Speaker = "Melinoe"
      Event = "CatFamiliar.PreAttackVoiceLines"
    }
    {
      Id = "Melinoe_2502"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, Toula."
      Speaker = "Melinoe"
      Event = "CatFamiliar.EquipVoiceLines"
    }
    {
      Id = "Melinoe_2503"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ikut denganku, Toula."
      Speaker = "Melinoe"
      Event = "CatFamiliar.EquipVoiceLines"
    }
    {
      Id = "Melinoe_3882"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, Toula."
      Speaker = "Melinoe"
      Event = "CatFamiliar.EquipVoiceLines"
    }
    {
      Id = "MelinoeField_1915"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika kau menyukai camilan ini, berarti kita memiliki ikatan batin."
      Speaker = "Melinoe"
      Event = "CatFamiliar.RecruitVoiceLines"
    }
    {
      Id = "MelinoeField_1916"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ternyata benar! Namamu Toula, kan?"
      Speaker = "Melinoe"
      Event = "CatFamiliar.RecruitVoiceLines"
    }
    {
      Id = "MelinoeField_1918"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita saling melindungi mulai sekarang."
      Speaker = "Melinoe"
      Event = "CatFamiliar.RecruitVoiceLines"
    }
    {
      Id = "Melinoe_0983"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tersesat, si mungil?"
      Speaker = "Melinoe"
      Event = "CatFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0985"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan takut..."
      Speaker = "Melinoe"
      Event = "CatFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2509"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarilah, manis."
      Speaker = "Melinoe"
      Event = "CatFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3398"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pintarnya."
      Speaker = "Melinoe"
      Event = "CatFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3399"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Anak pintar."
      Speaker = "Melinoe"
      Event = "CatFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3400"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei..."
      Speaker = "Melinoe"
      Event = "CatFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3401"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada kabar apa...?"
      Speaker = "Melinoe"
      Event = "CatFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Terkekeh>"
      Speaker = "Melinoe"
      Event = "CatFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3403"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ck-ck-ck."
      Speaker = "Melinoe"
      Event = "CatFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ck-ck-ck-ck!"
      Speaker = "Melinoe"
      Event = "CatFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2504"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, Raki."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.EquipVoiceLines"
    }
    {
      Id = "Melinoe_2505"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ikutlah, Raki."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.EquipVoiceLines"
    }
    {
      Id = "Melinoe_3881"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maju, Raki."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.EquipVoiceLines"
    }
    {
      Id = "MelinoeField_1917"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ternyata benar! Raki, senang berkenalan denganmu."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.RecruitVoiceLines"
    }
    {
      Id = "Melinoe_0984"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, gagak kecil."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_0986"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan menyakitimu..."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3864"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gagak kecil..."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3865"
      InheritFrom = "BaseSubtitle"
