      Event = "RavenFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3783"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo, Raki."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3784"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau baik-baik saja, Raki."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3785"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenanglah, Raki."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3786"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Burung pintar."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3787"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semuanya akan baik-baik saja."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3867"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam, gagak kecil."
      Speaker = "Melinoe"
      Event = "RavenFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2497"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hecuba, maukah kau menemaniku menjalankan tugas ini?"
      Speaker = "Melinoe"
      Event = "HoundFamiliar.EquipVoiceLines"
    }
    {
      Id = "Melinoe_2508"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, Hecuba."
      Speaker = "Melinoe"
      Event = "HoundFamiliar.EquipVoiceLines"
    }
    {
      Id = "Melinoe_3883"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maju terus, Hecuba."
      Speaker = "Melinoe"
      Event = "HoundFamiliar.EquipVoiceLines"
    }
    {
      Id = "MelinoeField_2545"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika kau menyukai camilan ini, tandanya kita memiliki ikatan batin."
      Speaker = "Melinoe"
      Event = "HoundFamiliar.RecruitVoiceLines"
    }
    {
      Id = "MelinoeField_2546"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja kita terikat! Hecuba, suatu kehormatan bagiku."
      Speaker = "Melinoe"
      Event = "HoundFamiliar.RecruitVoiceLines"
    }
    {
      Id = "MelinoeField_2547"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mulai sekarang, kita akan saling melindungi."
      Speaker = "Melinoe"
      Event = "HoundFamiliar.RecruitVoiceLines"
    }
    {
      Id = "MelinoeField_2816"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sedang menjalankan misi pengintaian untuk Kepala Sekolah, ya, Manis?"
      Speaker = "Melinoe"
      Event = "HoundFamiliar.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_2819"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita sudah melangkah sejauh ini dari Crossroads, ya?"
      Speaker = "Melinoe"
      Event = "HoundFamiliar.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_2817"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku belum melihat Gale di mana pun, bagaimana denganmu?"
      Speaker = "Melinoe"
      Event = "HoundFamiliar.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_3330"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya kutanyakan soal dirimu pada Kepala Sekolah."
      Speaker = "Melinoe"
      Event = "HoundFamiliar.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_2818"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tolong jaga Echo di sana, ya?"
      Speaker = "Melinoe"
      Event = "HoundFamiliar.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3776"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa gadis pintar kesayangan?"
