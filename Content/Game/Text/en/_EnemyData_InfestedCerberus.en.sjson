      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_2118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, kembali ke sini...!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_2119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cerberus, kembalilah...!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_1241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baru pemanasan..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_1242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan kita mulai..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_1244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini bukan dirimu yang sebenarnya!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_1245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebentar lagi kau akan kembali bersih dan jinak!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_3535"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari liang neraka mana kalian berasal?"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_2120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian semua, jangan ikut campur!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_2121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan ganggu anjing itu!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_2122"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berhenti mengganggu anjing itu!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_2123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pergi kalian dari sini!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_2124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian menyiksanya, ya?"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_2125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dikerumuni makhluk-makhluk ini..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_2126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu banyaknya Daemon..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_3533"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hawa panasnya mulai mereda...!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_3534"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tinggal lapisan terakhirnya..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "MelinoeField_1221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wahai Roh Keputusasaan, enyahlah!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_1222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian para Bayangan Jiwa, tinggalkan dia sendiri!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_1223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cerberus, kau sudah bebas!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_1224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kini kulepaskan kau!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_4572"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenanglah, Sobat, tenangkan dirimu!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_4573"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah cukup coba membantaiku cuma untuk senang-senang!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_4574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa kita sudah cukup mengulang langkah kita..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_4575"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kelihatannya kau sudah puas untuk sekarang!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_4576"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Duduk, Sobat, sudah cukup!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_4577"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah! Kau pasti sudah kelelahan sekarang!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_4186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu bermain... {#Emph}sudah habis!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_4187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu bermain... {#Emph}sudah habis...!"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_0936"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana dia pergi...?"
      Speaker = "Melinoe"
      Event = "InfestedCerberus.PostOutroVoiceLines"
    }
    {
      Id = "MelinoeField_0937"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cepat pulih ya, Cerberus..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.PostOutroVoiceLines"
    }
    {
      Id = "MelinoeField_0938"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sudah aman sekarang, kau tak apa-apa..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.PostOutroVoiceLines"
    }
    {
      Id = "MelinoeField_0939"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sudah terlihat lebih baik sekarang..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.PostOutroVoiceLines"
    }
    {
      Id = "MelinoeField_5572"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kira-kira apa yang kau impikan, Sobat..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.PostOutroVoiceLines"
    }
    {
      Id = "MelinoeField_5573"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebentar lagi kita akan mengukir kenangan yang lebih baik dari ini..."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.PostOutroVoiceLines"
    }
    {
      Id = "MelinoeField_0941"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bebas lagi, untuk saat ini."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.PostOutroVoiceLines"
    }
    {
      Id = "MelinoeField_0942"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pergilah temui tuanmu sekarang."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.PostOutroVoiceLines"
    }
    {
      Id = "MelinoeField_0943"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembalilah sekarang ke sisi tuanmu dan tempat tinggalmu."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.PostOutroVoiceLines"
    }
    {
      Id = "MelinoeField_0944"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang tenanglah kembali."
      Speaker = "Melinoe"
      Event = "InfestedCerberus.PostOutroVoiceLines"
    }
    {
      Id = "MelinoeField_0934"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cerberus... ini benar-benar kau."
      Speaker = "Melinoe"
      Event = "CerberusBossOutro01"
    }
    {
      Id = "Storyteller_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Setelah meluruhkan selubung siksaannya, sang Monster Neraka pelahap jiwa di balik gerbang Tartarus menampakkan bahwa wujud aslinya bukanlah monster mengerikan itu, melainkan sosok lain yang jauh lebih buas dan tersohor kejamnya."
      Speaker = "Storyteller"
      Event = "CerberusBossOutro01"
    }
    {
      Id = "MelinoeField_0935"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan, tunggu, tetaplah di sini!"
      Speaker = "Melinoe"
      Event = "CerberusBossOutro01"
    }
    {
      Id = "Storyteller_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kemurkaannya sirna, dan wujud aslinya terungkap, anjing penjaga neraka Cerberus memandangi sang Putri Dunia Bawah dengan sekelebat binar pengenalan yang amat samar di keenam matanya yang mengerikan."
      Speaker = "Storyteller"
      Event = "CerberusBossOutro02"
    }
    {
      Id = "MelinoeField_0940"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenanglah sekarang. Ini cuma aku...!"
      Speaker = "Melinoe"
      Event = "CerberusBossOutro02"
    }
    {
      Id = "Storyteller_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bisa ditenangkan untuk sesaat, Cerberus yang mengerikan mengalihkan perhatiannya dari sang Putri ke gerbang Tartarus di bawah."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro01"
    }
    {
      Id = "Storyteller_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Entah apakah ia bertarung dengan seganas itu atau cuma sekadar bermain, sang monster berkepala tiga Cerberus tak menunjukkan gelagatnya sama sekali."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro02"
    }
    {
      Id = "Storyteller_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang penjaga buas Tartarus berkepala tiga kembali memperoleh akal sehatnya sekali lagi."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro03"
    }
    {
      Id = "Storyteller_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bulu-bulunya masih kusut dipenuhi jiwa-jiwa yang melolong merana, namun sang Anjing Neraka tampaknya merasa puas."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro04"
    }
    {
      Id = "Storyteller_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Terbebas dari jeratan belenggu untuk sesaat, Cerberus yang menakutkan menatap sang Putri dengan penuh rasa terima kasih."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro05"
    }
    {
      Id = "Storyteller_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sekelebat ingatan melintas di raut-raut muka sang Anjing Neraka yang mengerikan."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro06"
    }
    {
      Id = "Storyteller_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tersucikan dari jubah miasma tebalnya, sang Cerberus berkepala tiga akhirnya luluh."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro07"
    }
    {
      Id = "Storyteller_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tiga paras anjing yang mengerikan namun tak asing lantas kembali tampak."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro08"
    }
    {
      Id = "Storyteller_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Lalu ketiga kepala bertaring setajam monster milik Cerberus menunduk malu."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro09"
    }
    {
      Id = "Storyteller_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Putri penakluk binatang buas mengembalikan akal sehat dan rupa Cerberus yang amat dikenalinya."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro10"
    }
    {
      Id = "Storyteller_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Putri Orang Mati yang napasnya terengah-engah entah bagaimana berhasil menundukkan monster buas itu."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro11"
    }
    {
      Id = "Storyteller_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cerberus berkepala tiga meredam amukan tanpa batasnya dan menyembunyikan taring-taringnya untuk saat ini."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro12"
    }
    {
      Id = "Storyteller_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Akhirnya terbebas dari rasa gatal neraka yang tak tertahankan, sang anjing penjaga penyembur api tampak terpuaskan."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro13"
    }
    {
      Id = "Storyteller_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tiga moncong merah penuh taring tajam kini berpaling dengan penuh rasa terima kasih ke arah sang Putri Orang Mati."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro14"
    }
    {
      Id = "Storyteller_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Anjing Neraka yang ditakuti kembali merengkuh wujud yang begitu seram sampai-sampai sulit diungkapkan dengan kata-kata."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro15"
    }
    {
      Id = "Storyteller_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hal yang dianggap sesi bermain belaka bagi sang Anjing Neraka yang mengerikan kini telah usai untuk sementara."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro16"
    }
    {
      Id = "Storyteller_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Putri Dunia Bawah yang tabah dan cerdik entah bagaimana sanggup menenangkan binatang buas tersebut."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro17"
    }
    {
      Id = "Storyteller_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Usai bentrokan dahsyat yang mengguncang dunia, Cerberus yang mengerikan kembali merengkuh wujud sejatinya."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro18"
    }
    {
      Id = "Storyteller_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Akhirnya sang Putri pembalas dendam sekali lagi mengatasi monster neraka yang merintangi jalannya."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro19"
    }
    {
      Id = "Storyteller_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cerberus yang bak mimpi buruk kembali tenang dan beranjak pergi, barangkali untuk memberi tahu tuannya bahwa putri sang majikan berada di dekatnya."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro20"
    }
    {
      Id = "Storyteller_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang anjing neraka penyembur api sesaat menjadi begitu tenang, usai akhirnya menyadari keberadaan sang Putri Orang Mati."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro21"
    }
    {
      Id = "Storyteller_0471"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Segerombolan daimon kecil yang membuat Cerberus menggaruk-garuk kegatalan hebat tak lagi mengganggunya, untuk saat ini."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro22"
    }
    {
      Id = "Storyteller_0472"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kobaran api terpanas sekalipun bisa dipadamkan, kendati sang penjaga neraka berkepala tiga dapat selalu memanggil kobaran baru."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro23"
    }
    {
      Id = "Storyteller_0469"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jika semua ini hanyalah sesi bermain-main bagi Cerberus berkepala tiga, setidaknya kini ia sudah benar-benar kelelahan."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro24"
    }
    {
      Id = "Storyteller_0489"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Waktu bermain akhirnya usai bagi Cerberus tua, tetapi ia kelak bakal bersenang-senang lagi nanti."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro25"
    }
    {
      Id = "Storyteller_0490"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang anjing neraka yang terus berkobar akhirnya mereda untuk sementara waktu."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro26"
    }
    {
      Id = "Storyteller_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Anjing penjaga gerbang Neraka yang mengerikan memutuskan bahwa sudah saatnya ia pamit undur diri."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro27"
    }
    {
      Id = "Storyteller_0492"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cerberus berkepala banyak yang garang dan kini telah bersih total kembali turun ke liang hangatnya yang nyaman."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro28"
    }
    {
      Id = "Storyteller_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Putri entah bagaimana sekali lagi berhasil bertahan dari taring dan kobaran api Cerberus sendiri."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro29"
    }
    {
      Id = "Storyteller_0510"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Waktu bermain bagi anjing neraka berkepala banyak ini telah usai untuk malam ini."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro30"
    }
    {
      Id = "Storyteller_0511"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Memastikan waktu mengalir bebas ke depan tampaknya menuntut pembersihan anjing neraka yang berlumur lumpur ini."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro31"
    }
    {
      Id = "Storyteller_0512"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bagi binatang buas yang luar biasa garang ini, semua yang baru saja terjadi hanyalah sekadar kudapan lezat."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro32"
    }
    {
      Id = "Storyteller_0513"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang penjaga neraka penyembur api telah cukup puas berolahraga menguras tenaga untuk saat ini."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro33"
    }
    {
      Id = "Storyteller_0514"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Setelah berpikir sejenak, Cerberus yang buas memutuskan untuk tidak memangsa sang Putri."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro34"
    }
    {
      Id = "Storyteller_0515"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ini jelas jauh lebih asyik daripada menjaga gerbang Dunia Bawah, mungkin begitulah yang dipikirkan sang anjing raksasa saat ini."
      Speaker = "Storyteller"
      Event = "CerberusBossMiscOutro35"
    }
  ]
}
