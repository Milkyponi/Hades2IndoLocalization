    }
    {
      Id = "Dora_0404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kelihatannya nyaman banget, bukan berarti aku bisa merasakannya sih."
      Speaker = "Dora"
      Event = "Cosmetic_TentBlanket01a.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasanya seperti tidur di bawah naungan Bulan. Bedanya ini di dalam ruangan."
      Speaker = "Dora"
      Event = "Cosmetic_TentBlanket01b.RevealReactionVoiceLines"
    }
    {
      Id = "Melinoe_4145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Asalkan baunya sama sekali tidak seperti domba..."
      Speaker = "Melinoe"
      Event = "Cosmetic_TentBlanket01c.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0408"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak ada yang lebih keren selain meletakkan alat musik di sudut ruangan."
      Speaker = "Dora"
      Event = "Cosmetic_ApolloLyre.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0406"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenda penyihir memang selalu butuh lebih banyak gantungan pernak-pernik."
      Speaker = "Dora"
      Event = "Cosmetic_TentHangingOrnaments01.RevealReactionVoiceLines"
    }
    {
      Id = "Melinoe_3672"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Peninggalan apa pun dari Wangsa Hades harus dilestarikan."
      Speaker = "Melinoe"
      Event = "Cosmetic_EmployeeOfTheMonth.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0407"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Entah buat apa kamu butuh barang tua {#Emph}itu{#Prev}, tapi ya sudahlah."
      Speaker = "Dora"
      Event = "Cosmetic_EmployeeOfTheMonth.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, aku sudah menanti-nantikan barang yang satu ini!"
      Speaker = "Dora"
      Event = "Cosmetic_ThanPoster.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0409"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cukup yakin kamu butuh banyak barang kayak gini untuk jadi penyihir."
      Speaker = "Dora"
      Event = "Cosmetic_WitchTrinkets01.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beberapa pernak-pernik lagi untuk kamu tata rapi, siap meluncur."
      Speaker = "Dora"
      Event = "Cosmetic_WitchTrinkets02.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau lilin lamamu kembali? Barangnya sudah ada di sini."
      Speaker = "Dora"
      Event = "Cosmetic_TentCandle01.CosmeticReAddedVoiceLines[2]"
    }
    {
      Id = "Dora_0412"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, baru ini lilin kelas atas yang sesungguhnya, Mel."
      Speaker = "Dora"
      Event = "Cosmetic_TentCandle01a.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0413"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Barang bertema amfibi lagi, sudah kuduga..."
      Speaker = "Dora"
      Event = "Cosmetic_TentCandle01b.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0411"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak ada gunanya sih buatku, tapi pasti terasa lebih empuk di kakimu."
      Speaker = "Dora"
      Event = "Cosmetic_TentQuilt.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0415"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau kamu mencoba menjauhkanku dari barang-barangmu... itu nggak bakal mempan."
      Speaker = "Dora"
      Event = "Cosmetic_TentShelf01a.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0416"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus! Sekarang kamu bisa jadi {#Emph}jauh lebih{#Prev} teratur..."
      Speaker = "Dora"
      Event = "Cosmetic_TentShelf01b.RevealReactionVoiceLines"
    }
    {
      Id = "Melinoe_3668"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini semata-mata agar aku bisa mempelajari lawanku dengan lebih baik."
      Speaker = "Melinoe"
      Event = "Cosmetic_FanPoster01.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0417"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang kamu suka atau dengarkan itu bukan urusan siapa pun selain dirimu. Dan diriku."
      Speaker = "Dora"
      Event = "Cosmetic_FanPoster01.RevealReactionVoiceLines"
    }
    {
      Id = "Melinoe_3669"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gulungan Selene Agung pasti cocok untuk mengawasiku bahkan di tempat ini."
      Speaker = "Melinoe"
      Event = "Cosmetic_FanPoster01a.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0418"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau mau lihat Bulan terus, kasih saja tenda ini seutuhnya buatku."
      Speaker = "Dora"
      Event = "Cosmetic_FanPoster01a.RevealReactionVoiceLines"
    }
    {
      Id = "Melinoe_3670"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gulungan Heracles mestinya bisa menginspirasiku untuk mengerahkan kekuatan yang lebih dahsyat."
      Speaker = "Melinoe"
      Event = "Cosmetic_FanPoster01b.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0419"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak nyangka dia tipemu, tapi percayalah, aku paham kok."
      Speaker = "Dora"
      Event = "Cosmetic_FanPoster01b.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu nggak bakal puas sampai seluruh lantai tertutup karpet, ya kan?"
      Speaker = "Dora"
      Event = "Cosmetic_TentRug.RevealReactionVoiceLines"
    }
    {
      Id = "Melinoe_4142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini sepertinya sangat cocok untuk tenda berhantu."
      Speaker = "Melinoe"
      Event = "Cosmetic_TentTable01a.RevealReactionVoiceLines"
    }
    {
      Id = "Melinoe_4143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mengingatkanku pada fase-fase bulan... yah, salah satunya."
      Speaker = "Melinoe"
      Event = "Cosmetic_TentTable01b.RevealReactionVoiceLines"
    }
    {
      Id = "Melinoe_4144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sisa-sisa Pohon Kehidupan bisa jadi perabotan yang sangat indah."
      Speaker = "Melinoe"
      Event = "Cosmetic_TentTable01c.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0700"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenang-kenangan dari kakekmu yang baik hati dan suka menolong, aku suka itu."
      Speaker = "Dora"
      Event = "Cosmetic_ChronosHourglass.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0701"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kayaknya kamu nggak bakal pernah pakai itu... buat aku aja, ya?"
      Speaker = "Dora"
      Event = "Cosmetic_HermesShoes.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0702"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ogah banget ketemu burung yang rentang sayapnya {#Emph}selebar itu{#Prev}..."
      Speaker = "Dora"
      Event = "Cosmetic_IcarusWings.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0706"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang ini jelas-jelas kosong, tapi biarin aja deh, buat jaga-jaga."
      Speaker = "Dora"
      Event = "Cosmetic_PandoraJar.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0424"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu benar-benar memanjakan katak atau kodok atau hewan apa pun itu."
      Speaker = "Dora"
      Event = "Cosmetic_FrinosRock01a.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0425"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu berniat mengubah tempat ini jadi kebun binatang atau gimana?"
      Speaker = "Dora"
      Event = "Cosmetic_FrinosRock01b.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0426"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terbangun disambut seikat bunga, kedengarannya asyik juga."
      Speaker = "Dora"
      Event = "Cosmetic_RespawnCircleFlowers.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0420"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuil pemujaan bagi segenap amfibi, tepat di halaman belakang kita."
      Speaker = "Dora"
      Event = "Cosmetic_FamiliarEffigy01.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0421"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku lebih suka menganggap yang satu ini patung kecil burung raksasa."
      Speaker = "Dora"
      Event = "Cosmetic_FamiliarEffigy01a.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0422"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pintar, patung kucing nggak bakal mencakar-cakar barang-barangmu."
      Speaker = "Dora"
      Event = "Cosmetic_FamiliarEffigy01b.RevealReactionVoiceLines"
    }
    {
      Id = "Moros_0295_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Tiga Takdir melimpahkan anugerah."
      Speaker = "Moros"
      Event = "Cosmetic_MorosChaise.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tebakanku si Bertanduk terlalu gengsi buat duduk, tapi ya sudahlah."
      Speaker = "Dora"
      Event = "Cosmetic_MorosChaise.RevealReactionVoiceLines"
    }
    {
      Id = "Moros_0204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sangat menghargainya."
      Speaker = "Moros"
      Event = "Cosmetic_MorosTentCanopy.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0428"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, si Bertanduk pasti bakal suka ini... dan kalau nggak, bakal kuambil lagi."
      Speaker = "Dora"
      Event = "Cosmetic_MorosTentCanopy.RevealReactionVoiceLines"
    }
    {
      Id = "Moros_0202"
