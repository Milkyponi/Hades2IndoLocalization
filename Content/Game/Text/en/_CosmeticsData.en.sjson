      Event = "Cosmetic_MorosRug.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harus menggelar permadani terbaik kalau lagi kedatangan tamu."
      Speaker = "Dora"
      Event = "Cosmetic_MorosRug.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0431"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benda-benda ini mestinya bikin si Bertanduk tua merasa betah."
