      Event = "Cosmetic_MorosScrolls.RevealReactionVoiceLines"
    }
    {
      Id = "Dora_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Si Bertanduk {#Emph}memang{#Prev} kelihatan suka punya banyak bahan bacaan..."
      Speaker = "Dora"
      Event = "Cosmetic_MorosScrolls.RevealReactionVoiceLines"
    }
    {
      Id = "Moros_0209"
