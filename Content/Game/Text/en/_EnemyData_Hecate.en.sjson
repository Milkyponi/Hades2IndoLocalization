      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cepat sekali."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0367"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wujud Tersembunyi dari Senjata Malam..."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
