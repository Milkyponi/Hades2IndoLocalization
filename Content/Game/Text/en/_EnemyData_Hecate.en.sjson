    }
    {
      Id = "Hecate_0071"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kehadiranmu sudah kurasakan."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "Hecate_0334"
