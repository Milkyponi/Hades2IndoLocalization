    }
    {
      Id = "Hecate_0488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat seperti dugaan."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0179"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0180"
      InheritFrom = "BaseSubtitle"
