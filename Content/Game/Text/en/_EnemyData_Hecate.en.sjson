      Id = "HecateField_0084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan! Luar biasa."
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "HecateField_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah cukup!"
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "Hecate_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Urgh... {#Prev}luar biasa."
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "Hecate_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, baiklah!"
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "HecateField_0445"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan! Cepat sekali...!"
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "HecateField_0446"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan! Tak butuh waktu lama...!"
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "HecateField_0447"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan! Dituntaskan dengan sigap!"
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "HecateField_0448"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan! Tadi nyaris tak adil..."
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "HecateField_0449"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan! Kurasa kau yang menang...!"
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "HecateField_0450"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan! Kuda-kuda yang sempurna."
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "HecateField_0451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan! Aku kalah tanding...!"
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "HecateField_0452"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan! {#Emph}Fyuuh! {#Prev}Bagus."
      Speaker = "Hecate"
      Event = "Hecate.BossKillVoiceLines"
    }
    {
      Id = "Hecate_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang di perbatasan Erebus. Kerja bagus, Melinoë."
      Speaker = "Hecate"
      Event = "HecateBossFirstAppearance"
    }
    {
      Id = "Melinoe_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Kepala Sekolah Hecate. Aku takkan sampai di titik ini tanpa bimbinganmu."
      Speaker = "Melinoe"
      Event = "HecateBossFirstAppearance"
    }
    {
      Id = "Hecate_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan sebaliknya, kau takkan boleh {#Emph}melewati {#Prev}titik ini tanpa membuktikan kemampuanmu terlebih dahulu."
      Speaker = "Hecate"
      Event = "HecateBossFirstAppearance"
    }
    {
      Id = "Melinoe_1171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemampuanku? Kau ingin kita saling berhadapan di sini... padahal tugasku sudah dimulai?"
      Speaker = "Melinoe"
      Event = "HecateBossFirstAppearance"
    }
    {
      Id = "Hecate_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Latihanmu takkan pernah selesai. Dan aku ingin tahu apakah kau punya sedikit saja peluang melawan musuh kita."
      Speaker = "Hecate"
      Event = "HecateBossFirstAppearance"
    }
    {
      Id = "Hecate_0436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah berhasil mencapai perbatasan Erebus secepat ini. Kau melampaui dugaanku, Melinoë."
      Speaker = "Hecate"
      Event = "HecateBossFirstAppearanceAlt"
    }
    {
      Id = "Melinoe_1170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Kepala Sekolah Hecate. Untuk semua bimbingan serta pujianmu."
      Speaker = "Melinoe"
      Event = "HecateBossFirstAppearanceAlt"
    }
    {
      Id = "HecateField_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan pujian, semata-mata fakta belaka. Meski begitu, aku ingin menyaksikan langsung bukti kemampuanmu."
      Speaker = "Hecate"
      Event = "HecateBossFirstAppearanceAlt"
    }
    {
      Id = "HecateField_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kali ini kau lebih siap? Lihat dirimu, kau {#Emph}terlalu tenang. {#Prev}Menahan amarahmu demi ilusi kendali diri."
      Speaker = "Hecate"
      Event = "HecateBossAboutRage01"
    }
    {
      Id = "MelinoeField_4301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengajariku kesabaran, Kepala Sekolah. Tapi kini kau memintaku menyerangmu dalam amarah yang meluap. Mana yang benar?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutRage01"
    }
    {
      Id = "HecateField_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunjukkan keduanya padaku: amarah yang sanggup kau {#Emph}kendalikan. {#Prev}Biarkan ketenangan itu menjadi urusan Saudari kita, Sang Rembulan, dan {#Emph}bertarunglah denganku dengan sungguh-sungguh!"
      Speaker = "Hecate"
      Event = "HecateBossAboutRage01"
    }
    {
      Id = "Hecate_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari Selene membantumu sampai ke hadapanku. Tapi apa kau sudah belajar menguasai kekuatannya?"
      Speaker = "Hecate"
      Event = "HecateBossAboutSelene01"
    }
    {
      Id = "Melinoe_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Soal itu, aku lebih suka langsung membuktikannya daripada sekadar bicara. Tentu saja atas izinmu, Kepala Sekolah."
      Speaker = "Melinoe"
      Event = "HecateBossAboutSelene01"
    }
    {
      Id = "Hecate_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Izin kuberikan. Sekarang, tunjukkan padaku apa yang bisa dilakukan Sang Rembulan saat berada dalam genggamanmu."
      Speaker = "Hecate"
      Event = "HecateBossAboutSelene01"
    }
    {
      Id = "Hecate_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar sang dewi perburuan? Hutan ini pasti sudah terasa seperti rumah kedua baginya sekarang."
      Speaker = "Hecate"
      Event = "HecateBossAboutArtemis01"
    }
    {
      Id = "Melinoe_1601"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari Artemis terlihat baik-baik saja, sebaik mungkin di tengah situasi akhir-akhir ini. Malah, suasana hatinya tampak lebih ceria dari sebelumnya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutArtemis01"
    }
    {
      Id = "Hecate_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus. Dia, Selene, kau, dan aku telah bersiap menghadapi segala kemungkinan ini, dan kini saatnya kita bersinar... terutama kau dan aku, sekarang juga."
      Speaker = "Hecate"
      Event = "HecateBossAboutArtemis01"
    }
    {
      Id = "HecateField_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Athena sudi menyinggahi hutan kita ini, ya? Mungkin hanya proyeksi kekuatannya, mengingat hubungan kerja sama kalian kini semakin erat."
      Speaker = "Hecate"
      Event = "HecateBossAboutAthena01"
    }
    {
      Id = "MelinoeField_3476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jimat Gorgon miliknya memudahkan dia melacak keberadaanku hampir di mana saja, meski dia tak pernah bisa tinggal lama. Aku tak enak sudah merepotkannya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutAthena01"
    }
    {
      Id = "HecateField_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia takkan repot-repot datang jika menganggapmu tak pantas. Kendati kekuatannya terbatas di luar Olympus, aku takkan meremehkannya di sini."
      Speaker = "Hecate"
      Event = "HecateBossAboutAthena01"
    }
    {
      Id = "MelinoeField_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa ada orang lain selain diriku yang pernah menjumpaimu di padang rumput ini? Barangkali suatu malam Artemis atau yang lain yang muncul."
      Speaker = "Melinoe"
      Event = "HecateBossAboutNemesis01"
    }
    {
      Id = "HecateField_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Padang terbuka ini, percayalah, hanya milik kita berdua; hutan ini cukup luas. Namun aku melihat siapa pun yang lewat melintasinya. Tak peduli seberapa sembunyi-sembunyi menurut anggapan mereka..."
      Speaker = "Hecate"
      Event = "HecateBossAboutNemesis01"
    }
    {
      Id = "HecateField_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hawa dingin berembus saat kau mendekat. Dingin yang tak wajar di musim ini; meski mungkin memang itu kehendak Demeter. Dia membantumu, bukan?"
      Speaker = "Hecate"
      Event = "HecateBossAboutDemeter01"
    }
    {
      Id = "MelinoeField_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar. Beliau langsung mengenaliku sebagai cucunya. Apakah Ibu Guru sempat berbicara dengannya, tentang diriku dan semua yang telah terjadi?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutDemeter01"
    }
    {
      Id = "HecateField_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum; urusanku sedang agak menumpuk. Setidaknya di sini, Demeter bisa meredakan murkanya padaku karena merahasiakanmu begitu lama..."
      Speaker = "Hecate"
      Event = "HecateBossAboutDemeter01"
    }
    {
      Id = "HecateField_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan Demeter berpihak padamu sekali lagi. Sedari awal sudah kuduga, beliau akan menjadi yang pertama mengulurkan bantuan, atau justru menolaknya mentah-mentah."
      Speaker = "Hecate"
      Event = "HecateBossAboutDemeter02"
    }
    {
      Id = "MelinoeField_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidakkah Ibu Guru bisa memberitahunya tentang diriku? Kehilangan putri dan para cucunya... Aku tak sanggup membayangkan kepedihannya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutDemeter02"
    }
    {
      Id = "HecateField_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihan yang menyakitkan untuk membiarkannya dalam kegelapan. Beliau pasti langsung mengibarkan perang saat itu juga; padahal misi kita membutuhkan kesabaran, seperti yang kau tahu."
      Speaker = "Hecate"
      Event = "HecateBossAboutDemeter02"
    }
    {
      Id = "MelinoeField_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Guru, aku cemas Chronos akan menemukan kita. Pertama kali aku menjumpainya tak jauh di luar hutan ini..."
      Speaker = "Melinoe"
      Event = "HecateBossAboutChronos01"
    }
    {
      Id = "HecateField_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada begitu banyak lorong menuju Erebus, kecil kemungkinannya dia bisa menemukan jalan ke sini. Malahan {#Emph}kau {#Prev}yang menghadapi bahaya lebih besar daripada {#Emph}itu {#Prev}saat ini..."
      Speaker = "Hecate"
      Event = "HecateBossAboutChronos01"
    }
    {
      Id = "Hecate_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan musuh kita bahkan melampaui kekuatanku sendiri. Kami berdua memang Titan, Chronos dan aku, tapi dia lebih tua dariku... seperti halnya aku lebih tua darimu. Bagaimana menurutmu?"
      Speaker = "Hecate"
      Event = "HecateBossAboutChronos02"
    }
    {
      Id = "Melinoe_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Usianya sama sekali tak berarti bagiku. Orang tua jarang sekali bijak, dan sering kali rapuh. Lagipula, dia tidak berguru padamu, Ibu Guru. Hanya aku yang mendapat kehormatan itu."
      Speaker = "Melinoe"
      Event = "HecateBossAboutChronos02"
    }
    {
      Id = "Hecate_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Tepat sekali. Dia hanyalah orang tua bangka yang pongah. Ilusi kebijaksanaan sering kali datang bersama usia ketimbang kebijaksanaan yang sejati. Ingatlah itu."
      Speaker = "Hecate"
      Event = "HecateBossAboutChronos02"
    }
    {
      Id = "Melinoe_2136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan membekuknya, Ibu Guru. Aku bersumpah. Semua yang telah kau ajarkan akan kukerahkan sepenuhnya. Dan tak peduli rintangan apa pun yang menghadang, Chronos akan tumbang di tanganku."
      Speaker = "Melinoe"
      Event = "HecateBossAboutChronos03"
    }
    {
      Id = "HecateField_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu meyakinkanku, Melinoë, meski mungkin kau sendiri yang butuh diyakinkan. Sebanyak apa pun yang kuajarkan, yang terpenting adalah kau seorang murid yang cakap."
      Speaker = "Hecate"
      Event = "HecateBossAboutChronos03"
    }
    {
      Id = "Melinoe_2137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku harus bisa lebih dari sekadar itu."
      Speaker = "Melinoe"
      Event = "HecateBossAboutChronos03"
    }
    {
      Id = "MelinoeField_1513"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah menaklukkan Chronos... memenuhi semua tujuan dari latihanku bersamamu. Namun kau masih saja menghadang jalanku. Masih ada lagi yang harus kupelajari bahkan sampai sekarang?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutChronosBossW01"
    }
    {
      Id = "HecateField_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kini dan selamanya. Secuil rasa frustrasi yang kau tunjukkan barusan? Aku ingin melihatmu melenyapkannya, saat kau berupaya menyingkirkan {#Emph}aku."
      Speaker = "Hecate"
      Event = "HecateBossAboutChronosBossW01"
    }
    {
      Id = "HecateField_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh kita pasti mulai bertanya-tanya bagaimana kau bisa menggagalkan rencananya. Biarkan dia tetap dalam ketidaktahuan. Semakin sedikit yang dia ketahui tentang kita, semakin baik."
      Speaker = "Hecate"
      Event = "HecateBossAboutChronosBossW02"
    }
    {
      Id = "MelinoeField_1514"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos tampaknya mengira ikatan darahku dengannyalah yang membuatku sanggup melawan. Dia belum menyadari bahwa engkaulah yang telah mempersiapkanku."
      Speaker = "Melinoe"
      Event = "HecateBossAboutChronosBossW02"
    }
    {
      Id = "HecateField_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kaulah {#Prev}yang telah mempersiapkan {#Emph}dirimu sendiri. {#Prev}Bagus jika kau berhasil menarik perhatian dan amarahnya, sementara aku tetap tak terlihat. Perlahan kita gerogoti kekuatannya... dan lewat usaha kita, kita ulurkan lebih banyak waktu bagi kerabatmu di gunung itu."
      Speaker = "Hecate"
      Event = "HecateBossAboutChronosBossW02"
    }
    {
      Id = "HecateField_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percayalah pada latihanmu, sebelum kau tiba di tujuanmu di Graha. Latihan itu serta ikatan darahmu dengan Chronos memberimu sedikit kendali atas kemampuannya... warisan tak sengaja yang dia berikan padamu."
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath00"
    }
    {
      Id = "MelinoeField_5185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengetahuanku tentang alam mimpi, kendalinya atas Waktu... perpaduan yang sangat kuat, tapi kutahu aku harus menghadapinya dengan penuh kehati-hatian dan rasa hormat."
      Speaker = "Melinoe"
      Event = "HecateBossAboutEndingPath00"
    }
    {
      Id = "HecateField_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menghadapi segala hal dengan kehati-hatian dan rasa hormat jarang sekali menyesatkanmu. Aku akan menanti kabar tentang apa pun yang kau temukan... dan apakah rencana kita bisa terwujud."
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath00"
    }
    {
      Id = "HecateField_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ke jurang alam bawah sadar aku turun melangkah... {#Prev}ingatlah baik-baik kata-kata itu dan bait setelahnya, jangan sampai serunya pertempuran mengaburkan ingatanmu."
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath01"
    }
    {
      Id = "MelinoeField_3483"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ke jurang alam bawah sadar aku turun melangkah. Malam dan Kegelapan, bimbinglah aku menuju darahku yang melampaui cengkeraman Sang Waktu."
      Speaker = "Melinoe"
      Event = "HecateBossAboutEndingPath01"
    }
    {
      Id = "HecateField_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Doa yang ampuh, meski di sini takkan ada gunanya bagimu. Barangkali sebentar lagi kau akan berkesempatan merapalkan seruan itu di tempat dan waktu yang tepat."
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath01"
    }
    {
      Id = "MelinoeField_5098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah memberi tahu kakakku tentang perbuatan Chronos... tapi dia enggan jika harus memusnahkan anggota keluarga kami sendiri. Dia bahkan... menduga Ayah mungkin turut bersalah."
      Speaker = "Melinoe"
      Event = "HecateBossAboutEndingPath02"
    }
    {
      Id = "HecateField_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kerepotan baru. Kakakmu memang tak pernah sudi diatur, terutama oleh ayahmu. Dan kini dia malah memenuhi kepalamu dengan keraguan. Kita tak punya pilihan lain di sini, Melinoë. Bujuk dia, atau semua usaha ini akan sia-sia belaka."
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath02"
    }
    {
      Id = "MelinoeField_5099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia juga bertanya padaku apa yang sebenarnya terjadi antara Chronos dan Ayah, dan... aku tersadar bahwa aku tak tahu. Adakah yang tahu? Perang yang dikobarkannya ini... bukan melulu soal siapa yang berhak berkuasa."
      Speaker = "Melinoe"
      Event = "HecateBossAboutEndingPath02"
    }
    {
      Id = "HecateField_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa lalu mereka yang sebenarnya tak ada sangkut pautnya dengan keadaan kita sekarang. Dalam perang, orang bijak takkan memberi celah bagi musuh untuk dipahami secara berlebihan. Jika kau menghabiskan seluruh waktumu melamun sedalam itu, kau akan ragu melangkah... dan kesempatanmu akan sirna begitu saja!"
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath02"
    }
    {
      Id = "HecateField_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan padaku, sebelum kita beradu senjata lagi: Apakah kakakmu sudah mulai memahami pentingnya peran serta dirinya dalam tugasmu?"
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath03"
    }
    {
      Id = "MelinoeField_5100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Agak alot membujuknya. Dia sudah menemukan senjata yang cocok dari tombak Ayah... tapi dia belum mau meminjamkan esensinya padaku."
      Speaker = "Melinoe"
      Event = "HecateBossAboutEndingPath03"
    }
    {
      Id = "HecateField_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, katakan saja apa yang ingin dia dengar, jika memang itu yang dibutuhkan untuk menggerakkannya. Aku sama sekali tak suka harus bergantung padanya seperti halnya dirimu, tapi... kerja samanya adalah keharusan mutlak."
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath03"
    }
    {
      Id = "MelinoeField_5101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku butuh lebih dari sekadar kerja samanya... Aku butuh kepercayaannya. Aku tak sudi membohonginya, jika memang itu yang Ibu Guru sarankan."
      Speaker = "Melinoe"
      Event = "HecateBossAboutEndingPath03"
    }
    {
      Id = "HecateField_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak menyarankan {#Emph}apa pun. {#Prev}Tugas itu milikmu, begitu pula siasat yang kau tempuh demi menuntaskannya. Tapi ingat, {#Emph}tuntaskan tugas itu!"
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath03"
    }
    {
      Id = "MelinoeField_5102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti akan kutuntaskan!"
      Speaker = "Melinoe"
      Event = "HecateBossAboutEndingPath03"
    }
    {
      Id = "Melinoe_5731"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zagreus dan aku akhirnya mencapai kesepahaman. Dia tahu apa yang harus dilakukan... tapi, ada yang ingin kutanyakan padamu, Kepala Sekolah. Terkait Chronos, di masa lalu... apa benar-benar tak ada jalan lain selain menghancurkannya?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutEndingPath04"
    }
    {
      Id = "Hecate_0942"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, demi darah dan kegelapan, dia berhasil memengaruhimu, bukan? Setidaknya kakakmu, jika bukan Chronos sendiri. Mengapa kau menanyakan hal seperti itu padaku saat kau sudah begitu dekat untuk menuntaskan tugasmu, Melinoë?"
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath04"
    }
    {
      Id = "Melinoe_5732"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, salah satunya... kita berada di ambang memusnahkan Waktu itu sendiri. Terlepas dari semua yang telah kau ajarkan padaku, aku tak pernah benar-benar memahami dampak apa yang akan ditimbulkan dari hal ini."
      Speaker = "Melinoe"
      Event = "HecateBossAboutEndingPath04"
    }
    {
      Id = "Hecate_0943"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita takkan bisa mengetahui dampak semacam itu sebelum semuanya terjadi. Kewajiban kita, kewajiban {#Emph}mu{#Prev}, adalah menghentikan Chronos. Apa pun risikonya. Kuharap kau tak butuh peringatan tambahan lagi?"
      Speaker = "Hecate"
      Event = "HecateBossAboutEndingPath04"
    }
    {
      Id = "Melinoe_5733"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Tidak butuh."
      Speaker = "Melinoe"
      Event = "HecateBossAboutEndingPath04"
    }
    {
      Id = "MelinoeField_3477"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini aku memimpikan Ayah lagi, saat Chronos datang merenggutnya, dan kau membawaku ke tempat aman. Tapi kali ini, aku melihat lebih banyak dari sebelumnya..."
      Speaker = "Melinoe"
      Event = "HecateBossAboutFates01"
    }
    {
      Id = "HecateField_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan sekadar mimpi biasa, tentu saja. Apa lagi yang kau ketahui selagi kau terhanyut di dalamnya?"
      Speaker = "Hecate"
      Event = "HecateBossAboutFates01"
    }
    {
      Id = "MelinoeField_3478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos menuntut Ayah memberitahunya cara menemukan Tiga Moirae. Chronos membenci mereka, atau merasa terancam oleh mereka. Dia mencari mereka selama ini... dan pasti akhirnya berhasil menemukannya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutFates01"
    }
    {
      Id = "HecateField_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sialan... {#Prev}Hermes mencurigai hal ini, tetapi belum bisa membuktikannya tanpa keraguan. Untuk saat ini, mari kita bertindak seolah-olah sang Takdir sendiri menentang kita; seolah-olah kita tak punya siapa pun untuk diandalkan selain diri kita sendiri."
      Speaker = "Hecate"
      Event = "HecateBossAboutFates01"
    }
    {
      Id = "MelinoeField_5274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku tahu di mana mereka berada sekarang, Kepala Sekolah. Maksudku, Tiga Moirae. Aku mungkin bisa menemukan mereka pada akhirnya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutFatesQuest01"
    }
    {
      Id = "HecateField_0503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, itu perkembangan yang luar biasa! Dari semua kejahatan kakekmu, menculik para Takdir adalah salah satu yang paling lancang. Di mana menurutmu mereka berada?"
      Speaker = "Hecate"
      Event = "HecateBossAboutFatesQuest01"
    }
    {
      Id = "MelinoeField_5275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak jauh di bawah, atau setidaknya, kurasa aku bisa menjangkau mereka di sana. Penasaran seperti apa rupa mereka... anak-anak Nyx semuanya tampak sangat berbeda antara satu dan yang lain."
      Speaker = "Melinoe"
      Event = "HecateBossAboutFatesQuest01"
    }
    {
      Id = "HecateField_0504"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau sudah dekat untuk menemukan mereka, maka kau tak perlu bertanya-tanya lebih lama lagi. Yang kuketahui tentang mereka adalah, tak ada yang tahu apa yang telah mereka siapkan bagi kita semua."
      Speaker = "Hecate"
      Event = "HecateBossAboutFatesQuest01"
    }
    {
      Id = "Hecate_0751"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah udara tipis di gunung itu membuatmu gila, Melinoë? Menghadapi Typhon secara langsung, dari sekian banyak makhluk! Hermes menceritakan segalanya padaku. Kecuali apa yang sebenarnya ada di dalam kepalamu."
      Speaker = "Hecate"
      Event = "HecateBossAboutTyphonFight01"
    }
    {
      Id = "Melinoe_4042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan berpaling dari keluargaku, terutama setelah melangkah sejauh ini. Apa yang seharusnya kulakukan, kabur begitu melihat monster itu? Kita kabur hanya sebagai jalan terakhir."
      Speaker = "Melinoe"
      Event = "HecateBossAboutTyphonFight01"
    }
    {
      Id = "Hecate_0752_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Dan sebaiknya kau terus mengingatnya sebelum menghadapi sang Ayah Segala Monster lagi. Jangan mengambil risiko yang tak perlu, atau melupakan tugasmu."
      Speaker = "Hecate"
      Event = "HecateBossAboutTyphonFight01"
    }
    {
      Id = "Melinoe_4043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia jauh, jauh lebih besar daripada musuh mana pun yang pernah kuhadapi, tapi itu tak membuatnya kebal. Aku menduga dia akan kesulitan menghadapi lawan yang kecil dan gesit."
      Speaker = "Melinoe"
      Event = "HecateBossAboutTyphonFight01_B"
    }
    {
      Id = "Hecate_0753_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan memujimu atas hasilnya seandainya aku tidak begitu terperangah. Sang Ayah Segala Monster mungkin takkan semudah itu dikejutkan sebelum kau menghadapinya lagi. Jangan ambil risiko yang tak perlu, atau melupakan tugasmu!"
      Speaker = "Hecate"
      Event = "HecateBossAboutTyphonFight01_B"
    }
    {
      Id = "HecateField_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah puas dengan Olympus untuk sementara waktu? Mengungguliku di sini pasti jauh lebih ringan daripada harus mencungkil semua mata Typhon."
      Speaker = "Hecate"
      Event = "HecateBossAboutTyphonFight02"
    }
    {
      Id = "MelinoeField_3158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya jauh lebih menyenangkan jika dibandingkan. Tapi aku akan segera kembali berurusan dengan sang Ayah Segala Monster."
      Speaker = "Melinoe"
      Event = "HecateBossAboutTyphonFight02"
    }
    {
      Id = "HecateField_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maka kumpulkan kekuatan sebanyak yang kau bisa untuk sementara ini. Sekarang, Dunia Bawah telah menanti; tetapi akulah yang masih memegang kuncinya."
      Speaker = "Hecate"
      Event = "HecateBossAboutTyphonFight02"
    }
    {
      Id = "Hecate_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Auramu berbeda. Lebih kuat. Kau telah mempelajari Arcana. Bermeditasi di Mezbahmu untuk mempersiapkan setiap upayamu."
      Speaker = "Hecate"
      Event = "HecateBossAboutArcana01"
    }
    {
      Id = "Melinoe_0581"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap Kartu memperlihatkan kekuatan yang berbeda padaku. Jika aku menenangkan diri dan berkonsentrasi, rasanya seolah-olah aku menyatu dengan siapa pun yang terlukis di sana. Andai saja aku bisa fokus pada semuanya sekaligus."
      Speaker = "Melinoe"
      Event = "HecateBossAboutArcana01"
    }
    {
      Id = "Hecate_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fokus, pada hakikatnya, adalah memilih. Majulah, tunjukkan padaku pemahaman barumu ini..."
      Speaker = "Hecate"
      Event = "HecateBossAboutArcana01"
    }
    {
      Id = "Hecate_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mezbah di tempat latihan kita adalah demi kebaikanmu, tapi kau berani menghadapiku sambil mengabaikan Arcana! Suatu kelalaian, atau sekadar kelancangan?"
      Speaker = "Hecate"
      Event = "HecateBossAboutArcana02"
    }
    {
      Id = "MelinoeField_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya sedikit tipu muslihat untuk membuatmu lengah, Kepala Sekolah."
      Speaker = "Melinoe"
      Event = "HecateBossAboutArcana02"
    }
    {
      Id = "Hecate_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Kurasa tidak. Aku sangat waspada, dan kusarankan {#Emph}kau {#Prev}juga waspada."
      Speaker = "Hecate"
      Event = "HecateBossAboutArcana02"
    }
    {
      Id = "Hecate_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan keterusteranganku tapi kondisimu tampak menyedihkan, Penyihir. Sungguh tak adil bagiku bertarung denganmu saat aku berada di kondisi terbaik sedangkan kau tidak."
      Speaker = "Hecate"
      Event = "HecateBossLowHealth01"
    }
    {
      Id = "Melinoe_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun hidup ini memang tak adil, bukan begitu, Kepala Sekolah? Kurasa ada pelajaran yang bisa dipetik di sini."
      Speaker = "Melinoe"
      Event = "HecateBossLowHealth01"
    }
    {
      Id = "Hecate_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Kuharap kemampuan bertarungmu sehebat ucapanmu. Sekarang, mulailah!"
      Speaker = "Hecate"
      Event = "HecateBossLowHealth01"
    }
    {
      Id = "Hecate_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menderita luka-luka, Melinoë. Kau tahu aku bisa menyembuhkannya untukmu, dan kau tahu aku takkan melakukannya. Tidak di sini. Hal ini sama sekali tak membuatku senang."
      Speaker = "Hecate"
      Event = "HecateBossLowHealth02"
    }
    {
      Id = "Melinoe_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luka-lukaku adalah pelajaran, Kepala Sekolah. Aku seharusnya bisa lebih berhati-hati saat menuju ke sini. Sekarang aku harus menanggung akibatnya."
      Speaker = "Melinoe"
      Event = "HecateBossLowHealth02"
    }
    {
      Id = "Hecate_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat! Kalau begitu, berdirilah tegak dan hadapi aku. Manfaatkan sisa kekuatanmu dengan sebaik-baiknya."
      Speaker = "Hecate"
      Event = "HecateBossLowHealth02"
    }
    {
      Id = "Hecate_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luka-lukamu memberiku keunggulan, Melinoë. Harapan apa yang kau miliki untuk menemukan musuh kita dalam kondisi seperti itu?"
      Speaker = "Hecate"
      Event = "HecateBossLowHealth03"
    }
    {
      Id = "MelinoeField_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak punya banyak harapan untuk itu, Kepala Sekolah. Kendati begitu, setidaknya mungkin aku bisa melewati {#Emph}dirimu{#Prev}."
      Speaker = "Melinoe"
      Event = "HecateBossLowHealth03"
    }
    {
      Id = "HecateField_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mungkin saja{#Prev}, seperti katamu. Kita berjuang demi setiap jengkal langkah, demi setiap serpihan yang bisa kita raih. Lewati {#Emph}aku{#Prev} jika kau mampu!"
      Speaker = "Hecate"
      Event = "HecateBossLowHealth03"
    }
    {
      Id = "Hecate_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kilatan perak... Lim dan Oros. Jadi, Bilah Kembar telah tunduk kepadamu. Kurasa Senjata Malam lainnya akan segera menyusul."
      Speaker = "Hecate"
      Event = "HecateBossAboutDagger01"
    }
    {
      Id = "Melinoe_1801"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyx memercayakannya kepadamu untuk melindungi alam ini sebagai upaya terakhir. Tapi, rasanya senjata ini tidak seharusnya digunakan dengan cara seperti ini..."
      Speaker = "Melinoe"
      Event = "HecateBossAboutDagger01"
    }
    {
      Id = "Hecate_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kenapa memangnya? Demi melindungi alam ini, kau harus menyingkirkan berbagai rintangan yang menghadang jalanmu. Dan {#Emph}aku{#Prev} hanyalah salah satunya."
      Speaker = "Hecate"
      Event = "HecateBossAboutDagger01"
    }
    {
      Id = "HecateField_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kegelapan Erebus tidak terlalu menyulitkanmu, ditemani Kobaran Api Ygnium yang tak pernah padam untuk menerangi jalanmu?"
      Speaker = "Hecate"
      Event = "HecateBossAboutTorch01"
    }
    {
      Id = "Melinoe_1034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, Kepala Sekolah, sama sekali tidak. Meski begitu, masih banyak yang harus kupelajari dalam menggunakan Api ini."
      Speaker = "Melinoe"
      Event = "HecateBossAboutTorch01"
    }
    {
      Id = "Hecate_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu kau datang ke tempat yang tepat. Tunjukkan padaku bagaimana caramu membuat bayang-bayang menari."
      Speaker = "Hecate"
      Event = "HecateBossAboutTorch01"
    }
    {
      Id = "HecateField_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kobaran Api Kelam Ygnium, kini berada di bawah kendalimu! Gunakan dengan caramu sendiri; jangan sekadar meniru teknikku."
      Speaker = "Hecate"
      Event = "HecateBossAboutTorch02"
    }
    {
      Id = "MelinoeField_0506"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu bilang, begitu aku siap menggunakan Api ini, aku harus mengayunkannya dengan intuisi sebagai penuntunku."
      Speaker = "Melinoe"
      Event = "HecateBossAboutTorch02"
    }
    {
      Id = "HecateField_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Aku selalu menyukai Api tuaku ini, tapi... mengenai apakah {#Emph}kau{#Prev} dan {#Emph}milikmu{#Prev} benar-benar terhubung, kita lihat saja nanti."
      Speaker = "Hecate"
      Event = "HecateBossAboutTorch02"
    }
    {
      Id = "HecateField_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemandangan yang menarik, kau menerjang ke arahku dengan Kapak Batu Bulan raksasa itu! Aku sempat ragu kau akan menyukai yang satu itu."
      Speaker = "Hecate"
      Event = "HecateBossAboutAxe01"
    }
    {
      Id = "MelinoeField_0504"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zorephet memang lebih berat dibanding Senjata lainnya. Tapi membawa kapak semacam ini di hutan seperti ini terasa sangat praktis, secara keseluruhan."
      Speaker = "Melinoe"
      Event = "HecateBossAboutAxe01"
    }
    {
      Id = "HecateField_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, meski aku benci harus {#Emph}merepotkanmu{#Prev}, ini harus kulakukan. Walau melihat benda mengerikan itu, kurasa pertarungan ini takkan memakan waktu lama..."
      Speaker = "Hecate"
      Event = "HecateBossAboutAxe01"
    }
    {
      Id = "HecateField_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang kau memakai Tengkorak Perak Revaal, ya? Kau benar-benar berkembang menjadi necromancer yang sangat cakap, sampai berhasil memenangkan kepercayaannya."
      Speaker = "Hecate"
      Event = "HecateBossAboutLob01"
    }
    {
      Id = "MelinoeField_0505"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah dulunya ini tengkorak makhluk hidup, Kepala Sekolah? Lalu disuntikkan perak dan disihir menjadi instrumen Sang Malam..."
      Speaker = "Melinoe"
      Event = "HecateBossAboutLob01"
    }
    {
      Id = "HecateField_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Itu{#Prev} pertanyaan yang cukup pribadi, mengingat semua bukti yang ada di depan mata! Mungkin Revaal sendiri yang akan memberitahumu jawabannya pada waktunya nanti."
      Speaker = "Hecate"
      Event = "HecateBossAboutLob01"
    }
    {
      Id = "HecateField_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mantel Hitam yang kini kau kenakan... melindungimu seolah memang ditempa khusus untukmu. Dulu aku takut mantel itu sudah rusak dan tak bisa diperbaiki, tapi... ternyata ia hanya sedang menunggu."
      Speaker = "Hecate"
      Event = "HecateBossAboutSuit01"
    }
    {
      Id = "MelinoeField_2857"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menungguku... Aku belum pernah menggunakan senjata seperti ini. Xinth tidak benar-benar mendengarkan pikiranku, tapi ia menuruti setiap naluriku."
      Speaker = "Melinoe"
      Event = "HecateBossAboutSuit01"
    }
    {
      Id = "HecateField_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan {#Emph}setiap{#Prev} nalurimu; Senjata Sang Malam punya tujuan tunggal, yang mereka jalankan dengan keunikan masing-masing. Tugasmu adalah menjalankan tujuan itu tanpa gagal."
      Speaker = "Hecate"
      Event = "HecateBossAboutSuit01"
    }
    {
      Id = "HecateField_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tongkatmu berwujud tak biasa. Terakhir kali aku melihatnya seperti itu di pulau terpencil di lautan atas. Tempat penyihir Circe menjalankan sihirnya."
      Speaker = "Hecate"
      Event = "HecateBossAboutCirceAspect01"
    }
    {
      Id = "MelinoeField_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini wujud yang diambil Descura saat bersamanya. Aku merasakan ketenangan dan fokus yang jauh lebih besar sekarang, seolah pengalamannya menyatu dengan milikku."
      Speaker = "Melinoe"
      Event = "HecateBossAboutCirceAspect01"
    }
    {
      Id = "HecateField_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Circe tahu pembawa Descura berikutnya akan membutuhkannya untuk tugas yang sangat penting. Karena itulah dia meminjamkan sebagian kekuatannya untuk melengkapi kekuatanmu."
      Speaker = "Hecate"
      Event = "HecateBossAboutCirceAspect01"
    }
    {
      Id = "HecateField_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kali ini wujud siapa yang diambil Ygnium? Kalau kau tak keberatan menjawabnya. Jelas sekali itu bukan Aspek Kobaran Api Kelam {#Emph}milikmu{#Prev}."
      Speaker = "Hecate"
      Event = "HecateBossAboutMorosAspect01"
    }
    {
      Id = "MelinoeField_2129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini adalah Aspek Moros, Kepala Sekolah. Tapi dia belum pernah menggunakan Api ini. Mungkin dengan mengetahuinya terlebih dahulu... kita berperan penting dalam membawanya ke pihak kita."
      Speaker = "Melinoe"
      Event = "HecateBossAboutMorosAspect01"
    }
    {
      Id = "HecateField_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitulah cara Tiga Takdir bekerja. Begitu kita tahu apa yang disimpan masa depan, kita mungkin mencoba menolaknya... namun akhirnya justru terjerumus mewujudkannya."
      Speaker = "Hecate"
      Event = "HecateBossAboutMorosAspect01"
    }
    {
      Id = "HecateField_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wujud Ygnium yang satu itu cukup memikat! Kau bisa selalu menghiasi Persimpangan Jalan dengan lentera-lentera itu andai mereka terbukti kurang bisa diandalkan untuk tugasmu."
      Speaker = "Hecate"
      Event = "HecateBossAboutEosAspect01"
    }
    {
      Id = "MelinoeField_3480"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aspek Eos tidak seringkih kelihatannya. Walau kuakui, aku sempat mengira Aspek Api ini adalah milikmu sendiri."
      Speaker = "Melinoe"
      Event = "HecateBossAboutEosAspect01"
    }
    {
      Id = "HecateField_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong kosong. Kalau aku sendiri yang menggunakan obor-obor itu, {#Emph}kau{#Prev} takkan mungkin membawanya. Sekarang, kemarilah dan ingatkan aku apa yang bisa dilakukan kerlipan fajar nan merah muda itu."
      Speaker = "Hecate"
      Event = "HecateBossAboutEosAspect01"
    }
    {
      Id = "HecateField_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan bentuk ramping Kapak Batu Bulan yang biasa. {#Emph}Ah!{#Prev} Aspek Charon! Sekarang dia sudah beralih menggunakan dayung sederhana."
      Speaker = "Hecate"
      Event = "HecateBossAboutCharonAspect01"
    }
    {
      Id = "MelinoeField_3479"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi {#Emph}ini{#Prev} alasan kenapa lengan Tuan Charon begitu berotot. Apa menurutmu dia dulu mendayung perahunya dengan Zorephet?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutCharonAspect01"
    }
    {
      Id = "HecateField_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja, atau memenggal beberapa kepala. Jika Nyx dan Tiga Takdir memercayakan perlindungan Dunia Bawah kepada segelintir orang tertentu, pilihan mereka sama sekali tidak buruk."
      Speaker = "Hecate"
      Event = "HecateBossAboutCharonAspect01"
    }
    {
      Id = "HecateField_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tengkorak Perak pasti punya selera humor yang aneh sampai-sampai mengambil wujud seperti itu untuk Medea. Dia selalu bilang sangat menyukai tengkorak, tapi Aspek miliknya sendiri nyaris tak menyerupai tengkorak."
      Speaker = "Hecate"
      Event = "HecateBossAboutMedeaAspect01"
    }
    {
      Id = "MelinoeField_5282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lady Medea pasti tetap senang menggunakan Revaal. Tapi, aku penasaran kenapa Senjata Malam mengambil wujud yang begitu berbeda bagi pembawa yang berlainan."
      Speaker = "Melinoe"
      Event = "HecateBossAboutMedeaAspect01"
    }
    {
      Id = "HecateField_0508"
      InheritFrom = "BaseNarrative"
      DisplayName = "Haruskah selalu ada alasannya? Kita semua punya sisi diri yang berbeda, yang bisa kita perlihatkan atau sembunyikan dari orang yang kita temui. Majulah sekarang: Bangkitkan amarah Medea itu."
      Speaker = "Hecate"
      Event = "HecateBossAboutMedeaAspect01"
    }
    {
      Id = "HecateField_0509"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa Aspek sang Ratu. Mungkin ini sebuah pengingat, bahwa Senjata Malam pun tidak sempurna dan tak luput dari celah, kalau tidak, Ratu Persephone takkan pernah tertawan."
      Speaker = "Hecate"
      Event = "HecateBossAboutPersephoneAspect01"
    }
    {
      Id = "MelinoeField_5283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang bisa Ibu lakukan waktu itu... melawan Chronos seorang diri saat dia menyergap semua orang di Kediaman?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutPersephoneAspect01"
    }
    {
      Id = "HecateField_0510"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali maksudku. Ibumu bahkan belum memegang Revaal saat itu. Yang paling waspada di antara kita pun sesekali lengah... meski takkan pernah di padang rumput ini."
      Speaker = "Hecate"
      Event = "HecateBossAboutPersephoneAspect01"
    }
    {
      Id = "HecateField_0511"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan sang Bulan. Tak mengherankan bila akhirnya kau mewarisi Wujud Jubah Hitam favorit Selene, tapi aku senang melihatnya."
      Speaker = "Hecate"
      Event = "HecateBossAboutSeleneAspect01"
    }
    {
      Id = "MelinoeField_5284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau pernah melihat Selene mengayunkan Xinth sendiri? Dia selalu tampak begitu tenang sampai-sampai aku sulit membayangkan dia bertarung langsung secara tatap muka."
      Speaker = "Melinoe"
      Event = "HecateBossAboutSeleneAspect01"
    }
    {
      Id = "HecateField_0512"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, dia memang bukan tipe yang suka meneriakkan pekik perang atau semacamnya, tapi ya, aku pernah menyaksikan amarahnya yang langka... dan itu pemandangan yang luar biasa. Dan untuk amarahmu, di sinilah tempatmu meluapkannya."
      Speaker = "Hecate"
      Event = "HecateBossAboutSeleneAspect01"
    }
    {
      Id = "HecateField_0513"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wujud yang kau miliki itu sangat istimewa... Senjata Nokturnal harus memenuhi standar tertentu, dan siapa lagi yang lebih pantas menguji standar itu selain sang Malam sendiri?"
      Speaker = "Hecate"
      Event = "HecateBossAboutNyxAspect01"
    }
    {
      Id = "MelinoeField_5285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari semua yang kuketahui tentang Nyx, dia bukan tipe yang suka main fisik. Dia butuh senjata seperti ini untuk menertibkan Dunia Bawah?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutNyxAspect01"
    }
    {
      Id = "HecateField_0514"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia butuh senjata seperti ini agar {#Emph}ditakuti! {#Prev}Tapi, itu dulu sekali... Malam belum seterkenal sekarang. Namun Jubah Hitam itu tetap berfungsi dengan sempurna...!"
      Speaker = "Hecate"
      Event = "HecateBossAboutNyxAspect01"
    }
    {
      Id = "HecateField_0515"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tongkat Kerajaan Ankh milik Anubis... Pernah kulihat dalam perjalananku, tapi melihatnya begitu dekat dengan tempat tinggal kita sungguh tak biasa. Mungkin senjata itu bisa merasakan semua Bayangan orang mati di sekitar sini."
      Speaker = "Hecate"
      Event = "HecateBossAboutAnubisAspect01"
    }
    {
      Id = "MelinoeField_5286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sosok yang memegang tongkat ini juga menguasai orang mati, jika pemahamanku benar. Memangnya ada berapa banyak dewa kematian di luar sana?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutAnubisAspect01"
    }
    {
      Id = "HecateField_0516"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa yang tahu? Ada begitu banyak orang mati, dan jumlahnya bertambah setiap saat. Sebagian dari mereka akan mencari bimbingan dari Tongkat Kerajaanmu itu. Tunjukkan jalannya kepada mereka."
      Speaker = "Hecate"
      Event = "HecateBossAboutAnubisAspect01"
    }
    {
      Id = "HecateField_0517"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penebas Gagak milik Morrigan... nah, itu kombinasi yang mematikan. Mirip sekali dengan sang dewi hantu yang pernah menghunusnya."
      Speaker = "Hecate"
      Event = "HecateBossAboutMorriganAspect01"
    }
    {
      Id = "MelinoeField_5287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari Artemis mendeskripsikan Morrigan sebagai tridewi bayangan lainnya, tapi dari zaman dan tempat yang berbeda... Kukira kau satu-satunya yang seperti itu, Kepala Sekolah."
      Speaker = "Melinoe"
      Event = "HecateBossAboutMorriganAspect01"
    }
    {
      Id = "HecateField_0518"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atau mungkin saja Morrigan begitu terpikat dengan teknik tiada taraku sampai-sampai aku jadi panutannya! Penjelasan apa lagi yang paling masuk akal?"
      Speaker = "Hecate"
      Event = "HecateBossAboutMorriganAspect01"
    }
    {
      Id = "HecateField_0519"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percikan Iblis milik Supay... kobaran api dari celah terdalam dan terpanas di Bumi, kini berada di tanganmu sendiri. Mereka bergerak atas kehendak mereka sendiri, bukan?"
      Speaker = "Hecate"
      Event = "HecateBossAboutSupayAspect01"
    }
    {
      Id = "MelinoeField_5288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wujud ini memang tak biasa dalam hal itu. Aku tahu tiap Senjata Nokturnal punya kehendaknya sendiri sampai batas tertentu, tapi pada Wujud Supay, itu terlihat sangat jelas."
      Speaker = "Melinoe"
      Event = "HecateBossAboutSupayAspect01"
    }
    {
      Id = "HecateField_0520"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, kurasa jika kau menang dalam duel ini, kemuliaannya layak diberikan pada Api-Api itu alih-alih kepadamu! Ayo, mari kita lihat percikan apinya beterbangan."
      Speaker = "Hecate"
      Event = "HecateBossAboutSupayAspect01"
    }
    {
      Id = "HecateField_0521"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, itu baru persenjataan yang berbobot... Gada Singa Batu, kah? Lambat dan sulit dikendalikan... jelas bukan gayaku {#Emph}sama sekali."
      Speaker = "Hecate"
      Event = "HecateBossAboutNergalAspect01"
    }
    {
      Id = "MelinoeField_5289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senjata ini cocok untukku. Bukan cuma daya rusaknya yang mengerikan, aku juga merasa senjata ini cukup ampuh untuk melepas stres! Suara dentangannya sangat memuaskan. Sebentar lagi kau akan melihatnya... atau mendengarnya, kurasa."
      Speaker = "Melinoe"
      Event = "HecateBossAboutNergalAspect01"
    }
    {
      Id = "HecateField_0522"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, benarkah? Tampaknya Wujud Nergal menganugerahi pembawanya selera humor yang luar biasa sebanding dengan palu raksasa itu! Majulah kalau begitu dan berdentanglah sesukamu."
      Speaker = "Hecate"
      Event = "HecateBossAboutNergalAspect01"
    }
    {
      Id = "HecateField_0523"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, Surai Beku... Tadi sempat kurasakan hawa dingin menusuk di udara, pasti berasal dari Wujud itu. Tanah tempat pertama kali aku menjumpainya adalah tempat terdingin yang pernah kurasakan sejauh ini."
      Speaker = "Hecate"
      Event = "HecateBossAboutHelAspect01"
    }
    {
      Id = "MelinoeField_5290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pernah ke alam orang mati lain tempat dewi Hel bersemayam? Aku tak bisa membayangkan ada tempat di bawah Bumi yang lebih dingin dari puncak Olympus."
      Speaker = "Melinoe"
      Event = "HecateBossAboutHelAspect01"
    }
    {
      Id = "HecateField_0524"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dunia ini luas. Nenekmu mungkin menguasai perputaran musim, tapi ada dewi-dewi lain di luar sana yang memiliki sentuhan yang amat {#Emph}membekukan{#Prev}. Dan sekarang, kau adalah salah satunya."
      Speaker = "Hecate"
      Event = "HecateBossAboutHelAspect01"
    }
    {
      Id = "HecateField_0525"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, aku berdiri di hadapan Rahmat Pemurni milik Siwa sang Penghancur... setidaknya di hadapan {#Emph}Wujud{#Prev} Siwa. Apakah kekuatan penghancur itu membantumu dengan baik sejauh ini?"
      Speaker = "Hecate"
      Event = "HecateBossAboutShivaAspect01"
    }
    {
      Id = "MelinoeField_5291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa dibilang begitu. Dari semua Wujud yang pernah kulihat, yang satu ini tampaknya mampu menghasilkan kehancuran paling dahsyat dalam satu tebasan. Siwa pasti sangat kuat."
      Speaker = "Melinoe"
      Event = "HecateBossAboutShivaAspect01"
    }
    {
      Id = "HecateField_0526"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang bilang Siwa adalah pencipta sekaligus penghancur... tak jauh berbeda dengan nenekmu, mungkin, dengan siklus kematian dan kelahirannya kembali. Tunjukkan padaku apa yang bisa kaulakukan dengan kekuatan sebesar itu!"
      Speaker = "Hecate"
      Event = "HecateBossAboutShivaAspect01"
    }
    {
      Id = "HecateField_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang sedang kaukibaskan itu? {#Emph}Aah{#Prev}, Senjata Nokturnal mulai memperlihatkan warna-warninya yang beraneka ragam. Perak yang sangat kaukenal itu hanyalah salah satunya."
      Speaker = "Hecate"
      Event = "HecateBossAboutWeaponAspects01"
    }
    {
      Id = "MelinoeField_0503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap Wujud dari Senjata Malam mewakili seorang pembawa dari masa lain. Aku masih mempelajari seluruh potensi dari apa yang bisa mereka lakukan."
      Speaker = "Melinoe"
      Event = "HecateBossAboutWeaponAspects01"
    }
    {
      Id = "HecateField_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kuduga kau akan terus melakukannya. Setidaknya, ini akan membuat segalanya jadi jauh lebih menarik di sini bagi kita berdua."
      Speaker = "Hecate"
      Event = "HecateBossAboutWeaponAspects01"
    }
    {
      Id = "HecateField_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap malam, aku selalu bertanya-tanya wujudmu mana yang akan kuhadapi. Pernahkah kau memikirkan mengapa ada begitu banyak Wujud Senjata Nokturnal yang berbeda dalam genggamanmu?"
      Speaker = "Hecate"
      Event = "HecateBossAboutWeaponAspects02"
    }
    {
      Id = "MelinoeField_3475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para pembawa Senjata menjaga Dunia Bawah, tapi... kurasa mereka tak semuanya bisa menggunakan Wujud selain milik mereka sendiri. Mungkin ada sesuatu dari tugasku yang menuntut hal ini."
      Speaker = "Melinoe"
      Event = "HecateBossAboutWeaponAspects02"
    }
    {
      Id = "HecateField_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atau mungkin Senjata-senjata itu mulai merasa terikat denganmu; tak ubahnya seperti sahabat karib yang memercayakan rahasia yang tak boleh dibocorkan kepada siapa pun! Jangan sia-siakan kepercayaan mereka."
      Speaker = "Hecate"
      Event = "HecateBossAboutWeaponAspects02"
    }
    {
      Id = "HecateField_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap Wujud tersembunyi dari Senjata Malam kini berada dalam genggamanmu, setidaknya yang memang disiapkan untukmu. Apa yang bisa kausimpulkan tentang para pembawa aslinya?"
      Speaker = "Hecate"
      Event = "HecateBossAboutHiddenAspects01"
    }
    {
      Id = "MelinoeField_4300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahwa mereka semua adalah dewa atau dewi kematian dan kehancuran. Sebagian dari masa lalu, sebagian dari masa depan, yang lainnya mungkin hidup di masa yang sama tapi di alam lain selain alam kita. Tapi, di mana...?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutHiddenAspects01"
    }
    {
      Id = "HecateField_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Alam kita tersembunyi; alam mereka mungkin juga begitu. Lagipula, sebanyak apa pun bagian dunia yang sudah kaulihat, itu baru sebagian kecil saja. Kau punya waktu abadi untuk bertemu dewa-dewa lain itu, atau tidak sama sekali."
      Speaker = "Hecate"
      Event = "HecateBossAboutHiddenAspects01"
    }
    {
      Id = "HecateField_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak banyak kemuliaan dalam duel satu lawan satu. Aku sendiri membangkitkan Arwah orang mati demi membalikkan keadaan. Bisa jadi sebagian dari mereka justru memihak {#Emph}padamu{#Prev}."
      Speaker = "Hecate"
      Event = "HecateBossAboutFamiliarSystem01"
    }
    {
      Id = "MelinoeField_1998"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin lain kali aku harus membawa sepasukan Hewan Mistis, Kepala Sekolah? Meski kurasa takkan ada satu pun binatang yang berani unjuk taring ke arahmu."
      Speaker = "Melinoe"
      Event = "HecateBossAboutFamiliarSystem01"
    }
    {
      Id = "HecateField_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bercanda, tapi Hewan Mistis bisa sangat membantu mengingat betapa berat tugasmu. Sebuah kemungkinan yang layak kau renungkan, setelah kau berhasil mengalahkanku..."
      Speaker = "Hecate"
      Event = "HecateBossAboutFamiliarSystem01"
    }
    {
      Id = "HecateField_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa teman! Pilihan yang tak terduga. Kawan amfibimu itu kelihatannya tak punya kemampuan untuk mengubah hasil akhir di sini."
      Speaker = "Hecate"
      Event = "HecateBossAboutFrogFamiliar01"
    }
    {
      Id = "MelinoeField_2026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah menilai segalanya hanya dari penampilan, Kepala Sekolah, dan aku tahu kau pun begitu. Ini pasti malam yang mendebarkan bagi Frinos."
      Speaker = "Melinoe"
      Event = "HecateBossAboutFrogFamiliar01"
    }
    {
      Id = "HecateField_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita ke sini bukan untuk menghibur teman-teman hutanmu, Melinoë. Berdoalah semoga mereka tidak terinjak-injak."
      Speaker = "Hecate"
      Event = "HecateBossAboutFrogFamiliar01"
    }
    {
      Id = "HecateField_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa kawan gagak! Burung jarang sekali berkeliaran di Erebus, itu pun jika mereka sanggup sampai ke sini! Kupikir mata-mata awalnya, tapi bukan. Mungkin Selene yang mengirimkannya padamu."
      Speaker = "Hecate"
      Event = "HecateBossAboutRavenFamiliar01"
    }
    {
      Id = "MelinoeField_3155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini Raki, kutemukan sendirian di sebuah ceruk tersembunyi dekat sini. Aku memang tak gampang percaya pada orang lain, tapi aku merasa ada ikatan batin yang kuat dengannya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutRavenFamiliar01"
    }
    {
      Id = "HecateField_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun tidak merasakan niat buruk darinya. Hewan Mistis kita bisa mengambil berbagai rupa, tak ubahnya seperti kawan ataupun lawan kita. Mari kita lihat seberapa baik dia mengimbangimu!"
      Speaker = "Hecate"
      Event = "HecateBossAboutRavenFamiliar01"
    }
    {
      Id = "HecateField_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kucing kecil di sampingmu itu, aku sempat melihatnya di Persimpangan akhir-akhir ini. Kekuatanmu pasti sangat hebat, sampai-sampai bisa membujuknya untuk mengikutimu..."
      Speaker = "Hecate"
      Event = "HecateBossAboutCatFamiliar01"
    }
    {
      Id = "MelinoeField_2027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Toula memang butuh sedikit bujukan, Kepala Sekolah. Tapi sepertinya dia menikmati kebersamaannya denganku! Setidaknya, hampir sepanjang waktu."
      Speaker = "Melinoe"
      Event = "HecateBossAboutCatFamiliar01"
    }
    {
      Id = "HecateField_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kucing adalah makhluk yang moody; pemburu alami tapi tak bisa diatur. Aku hampir-hampir takut melihat apa yang bisa dilakukan si kecil ini! Kalau anjing, setidaknya aku tahu pasti di mana posisi batasku."
      Speaker = "Hecate"
      Event = "HecateBossAboutCatFamiliar01"
    }
    {
      Id = "HecateField_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat postur anggun itu! Kita sedang berada di hadapan Hecuba yang agung...! Bagaimana kabar anjing kesayanganku?"
      Speaker = "Hecate"
      Event = "HecateBossAboutHoundFamiliar01"
    }
    {
      Id = "MelinoeField_0509"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia sangat sehat, dan merupakan rekan yang luar biasa cakap untuk mendampingiku. Meski aku merasa bersalah harus menguji kesetiaannya seperti ini."
      Speaker = "Melinoe"
      Event = "HecateBossAboutHoundFamiliar01"
    }
    {
      Id = "HecateField_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, kau sendiri ingin melihat kemampuannya, kan! Kesetiaannya itu mutlak. Kuizinkan dia melayanimu sebagaimana dia melayaniku! Sekarang, mari kita unjuk taring bersama-sama."
      Speaker = "Hecate"
      Event = "HecateBossAboutHoundFamiliar01"
    }
    {
      Id = "HecateField_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, bukankah itu si kecil Gale yang berlarian di kakimu! {#Emph}Ah{#Prev}, roda nasib benar-benar telah berputar. Dendamnya akhirnya akan terbalaskan!"
      Speaker = "Hecate"
      Event = "HecateBossAboutPolecatFamiliar01"
    }
    {
      Id = "MelinoeField_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bercanda, Kepala Sekolah, tapi aku merasa menaruh Gale di posisi yang sangat serba salah, harus berhadapan denganmu. Tak bisakah dia menolak ikut campur dalam pertarungan ini?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutPolecatFamiliar01"
    }
    {
      Id = "HecateField_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugasnya adalah menuruti perintahmu saat dibutuhkan, lagipula, kupikir dia bakal menikmati ini. Kuizinkan kau bertarung habis-habisan; begitu pula {#Emph}dengannya{#Prev}."
      Speaker = "Hecate"
      Event = "HecateBossAboutPolecatFamiliar01"
    }
    {
      Id = "HecateField_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pikiranmu sedang kalut memikirkan kutukan Arachne! Ya, aku mengetahuinya. Penawarnya bukanlah perkara yang gampang."
      Speaker = "Hecate"
      Event = "HecateBossAboutArachne01"
    }
    {
      Id = "MelinoeField_2877"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu pula tugasku, tapi di sinilah kita berdiri, malam demi malam. Jika ada cara untuk menolong temanku, aku ingin mengetahuinya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutArachne01"
    }
    {
      Id = "HecateField_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Athena-lah yang harus kau bujuk; selama dia ingin kutukan itu bertahan, maka kutukan itu akan tetap ada. Selain itu, kau juga harus mencari tahu siapa perajut kutukannya."
      Speaker = "Hecate"
      Event = "HecateBossAboutArachne01"
    }
    {
      Id = "MelinoeField_2878"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedengarannya cukup sederhana!"
      Speaker = "Melinoe"
      Event = "HecateBossAboutArachne01"
    }
    {
      Id = "MelinoeField_2879"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menghargai keterusteranganmu pada Arachne, Kepala Sekolah. Kau pasti tahu betul bahwa dia takkan memaafkanmu."
      Speaker = "Melinoe"
      Event = "HecateBossAboutArachne02"
    }
    {
      Id = "HecateField_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jauh lebih mudah memohon maaf daripada memberikannya. Seiring bertambahnya usiamu, kau pun kelak akan mendapati hubungan-hubungan yang mustahil untuk diperbaiki."
      Speaker = "Hecate"
      Event = "HecateBossAboutArachne02"
    }
    {
      Id = "HecateField_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengenakan gaun sutra itu lagi, warnanya selalu begitu mencolok. Aku tahu siapa pembuatnya. Gaun ini sangat cocok untukmu, meski sepertinya takkan tahan diterpa panas..."
      Speaker = "Hecate"
      Event = "HecateBossAboutArachneOutfit01"
    }
    {
      Id = "MelinoeField_2029"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tinggal kuhindari saja panasnya!"
      Speaker = "Melinoe"
      Event = "HecateBossAboutArachneOutfit01"
    }
    {
      Id = "HecateField_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada tujuan khusus yang ingin kau capai di sini, benar kan? Kau telah melihat apa yang harus dituntaskan dari balik kilau {#Emph}Batu Hitam Pekat{#Prev}."
      Speaker = "Hecate"
      Event = "HecateBossAboutPackagedBounties01"
    }
    {
      Id = "MelinoeField_1928"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ujian di atas ujian. Ini adalah salah satu kemungkinan tak terbatas yang telah diantisipasi oleh Chaos. Aku memilih jalan ini, tapi... jalan itu memang sudah ada menungguku."
      Speaker = "Melinoe"
      Event = "HecateBossAboutPackagedBounties01"
    }
    {
      Id = "HecateField_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cukup menggelisahkan rasanya mengetahui bahwa pilihan yang kita buat mungkin sudah ditakdirkan sampai batas tertentu. Kendati demikian, kehendak Malam harus tetap terlaksana."
      Speaker = "Hecate"
      Event = "HecateBossAboutPackagedBounties01"
    }
    {
      Id = "Hecate_0624"
      InheritFrom = "BaseNarrative"
      DisplayName = "Batu Hitam Pekat di tempat latihan kita... Aku bisa merasakannya sejak kau merapalkan mantra itu. Pengaruh samar Chaos terhadap alam ini."
      Speaker = "Hecate"
      Event = "HecateBossAboutPackagedBounties01_B"
    }
    {
      Id = "Melinoe_2796"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tujuan kita saling bertaut. Saat menatap Batu itu, aku mulai melihat berbagai jalan dan kemungkinan di setiap sudutnya. Sebagian di antaranya membawa kita kian dekat menuju kemenangan."
      Speaker = "Melinoe"
      Event = "HecateBossAboutPackagedBounties01_B"
    }
    {
      Id = "HecateField_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasakan perubahan dalam malam ini; pada dirimu{#Emph}. {#Prev}Kekuatanmu telah merosot drastis. Jadi Chaos ingin melihat hasil akhir dari kesepakatan khusus ini?"
      Speaker = "Hecate"
      Event = "HecateBossAboutPackagedBounties02"
    }
    {
      Id = "MelinoeField_2030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ujian yang lain lagi, Kepala Sekolah. Sihirku mungkin melemah, tapi kau sendiri yang mengajariku untuk tak pernah bergantung sepenuhnya pada hal itu."
      Speaker = "Melinoe"
      Event = "HecateBossAboutPackagedBounties02"
    }
    {
      Id = "HecateField_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan apakah kau benar-benar meresapi pelajaran itu, sebentar lagi akan kita buktikan. Bersaksikan Selene di atas sana, dan Chaos di bawah sini."
      Speaker = "Hecate"
      Event = "HecateBossAboutPackagedBounties02"
    }
    {
      Id = "HecateField_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah mengucap Sumpah Sang Gaib, dan hendak menuntaskan Wasiat Malam petang ini. Aku merasakan Ketakutan yang kian membuncah. Berapa banyak dari rasa itu yang berasal darimu?"
      Speaker = "Hecate"
      Event = "HecateBossAboutShrine01"
    }
    {
      Id = "MelinoeField_1510"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa takut yang wajar, tidak kurang dan tidak lebih, Kepala Sekolah. Suatu kehormatan bagiku karena Anda mengizinkanku mengambil Sumpah itu. Itu pun kalau memang Anda yang mengizinkannya, bukan Komandan Schelemeus."
      Speaker = "Melinoe"
      Event = "HecateBossAboutShrine01"
    }
    {
      Id = "HecateField_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebaiknya jangan terlalu banyak berspekulasi. Ini semua terjadi terutama karena perbuatanmu sendiri. Kalau begitu, hadapi aku di malam yang mencekam ini! Kau telah mengikrarkan sumpah tertentu, dan kini harus menanggung akibatnya."
      Speaker = "Hecate"
      Event = "HecateBossAboutShrine01"
    }
    {
      Id = "HecateField_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memutuskan untuk mengabaikan Sumpah itu untuk saat ini? Langkah yang bijak, mungkin saja. Atau paling tidak, bukti bahwa kau bisa menahan diri dan bersikap waspada."
      Speaker = "Hecate"
      Event = "HecateBossAboutShrine02"
    }
    {
      Id = "MelinoeField_1511"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalanku sudah cukup berbahaya seperti sekarang ini; untuk apa membuat Sumpah yang justru memperkecil peluang keberhasilanku?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutShrine02"
    }
    {
      Id = "HecateField_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Justru melalui rintanganlah kita menjadi kuat! Tapi menanggapi ucapanmu tadi, rintangan yang kau hadapi memang sudah cukup berat. Sumpah itu ada untuk menjamin bahwa kau akan selalu merasakannya."
      Speaker = "Hecate"
      Event = "HecateBossAboutShrine02"
    }
    {
      Id = "HecateField_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa Takut yang menyelimuti udara... hampir bisa diraba malam ini. Kau telah mengikrarkan banyak Sumpah malam ini. Merasa sangat bernyali, atau sekadar penasaran ingin melihat apa yang akan terjadi?"
      Speaker = "Hecate"
      Event = "HecateBossAboutShrine03"
    }
    {
      Id = "MelinoeField_1512"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedikit dari keduanya, Kepala Sekolah? Mungkin saja aku telah membuat kesalahan fatal. Untungnya ikrar yang ada di dalam Sumpah itu bisa dibatalkan... tidak seperti kebanyakan sumpah lainnya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutShrine03"
    }
    {
      Id = "HecateField_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Semua {#Prev}sumpah bisa dibatalkan. Namun ya, Sumpah ini terbilang cukup bermurah hati dalam hal tersebut; ikrarnya tidak pernah benar-benar mengikat. Mungkin agar setiap malam bisa terasa berbeda dan menarik dari malam sebelumnya."
      Speaker = "Hecate"
      Event = "HecateBossAboutShrine03"
    }
    {
      Id = "HecateField_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wasiat Sang Malam secara khusus menuntut kekalahanku, bukankah begitu? Sang Penguasa Titan bisa menunggu; kunci untuk memperkuat Senjata Nokturnal ada tepat di hadapanmu saat ini."
      Speaker = "Hecate"
      Event = "HecateBossAboutShrine04"
    }
    {
      Id = "MelinoeField_3484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anda tahu jauh lebih banyak tentang Sumpah Gaib daripada aku, Kepala Sekolah. Jadi mengapa Anda tidak memberitahuku apa yang diinginkannya?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutShrine04"
    }
    {
      Id = "HecateField_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, baru saja kuberi tahu! Barangkali saat kau mencapai usiaku kelak, kau pun akan menemukan ikatan baru dengan Sumpah itu. Untuk saat ini, datanglah dan rebut Mimpi Buruk yang kau cari."
      Speaker = "Hecate"
      Event = "HecateBossAboutShrine04"
    }
    {
      Id = "HecateField_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guru terhebat ada di luar sana, dan terbukti telah mengajarkan banyak hal kepadamu. Kau sudah mampu melampauiku di sini secara konsisten. Namun apakah ini sudah terbukti cukup...?"
      Speaker = "Hecate"
      Event = "HecateBossAboutShrineUpgrade01"
    }
    {
      Id = "MelinoeField_3473"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu ada hal baru untuk dipelajari, Kepala Sekolah; Anda sendiri yang mengajarkan hal itu kepadaku. Jika Anda yakin aku sudah siap, mengapa harus ragu?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutShrineUpgrade01"
    }
    {
      Id = "HecateField_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena jalanmu menuju penguasaan sejati adalah milikmu seorang; saat kau memutuskan bahwa kau siap untuk tantangan lebih, ingatlah bahwa Sumpah Gaib selalu ada untukmu. Begitu pula denganku."
      Speaker = "Hecate"
      Event = "HecateBossAboutShrineUpgrade01"
    }
    {
      Id = "HecateField_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang mengerikan... dingin, gelap, dan {#Emph}segalanya. {#Prev}Kau telah mengikrarkan sumpah tertentu, dan dengan Bulan sebagai saksi kita, aku pun telah mengikrarkan sumpahku. Sekarang, akhirnya kita bisa bertarung dengan sungguh-sungguh."
      Speaker = "Hecate"
      Event = "HecateBossAboutAltFight01"
    }
    {
      Id = "MelinoeField_3394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan sungguh-sungguh... jadi selama ini Anda {#Emph}memang {#Prev}menahan diri saat melawanku. Anda bilang Anda akan mendorongku hingga ke batas kemampuanku dan melampauinya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutAltFight01"
    }
    {
      Id = "HecateField_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Batas kemampuan kita berkembang seiring dengan diri kita. Aku sudah cukup mengenal batasku saat ini; apakah kau tahu batasmu? Aku sangat ingin mengetahuinya sendiri!"
      Speaker = "Hecate"
      Event = "HecateBossAboutAltFight01"
    }
    {
      Id = "MelinoeField_3395"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sisi Gelapnya..."
      Speaker = "Melinoe"
      Event = "HecateBossAboutAltFight01"
    }
    {
      Id = "HecateField_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menatap Sumpah Gaib itu malam demi malam, tetapi: Apakah kau sudah memahami pelajaran yang disampaikannya?"
      Speaker = "Hecate"
      Event = "HecateBossAboutAltFight02"
    }
    {
      Id = "MelinoeField_3397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa takut mewujud di malam hari. Entah kita tunduk pada ketakutan itu, atau kitalah yang menjadi penyebabnya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutAltFight02"
    }
    {
      Id = "HecateField_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Entah tunduk pada ketakutan atau menjadi penyebabnya. {#Prev}Itu perkataanmu, bukan perkataanku, meski aku menyetujuinya. Mari kita menjadi ketakutan itu bagi satu sama lain sekali lagi."
      Speaker = "Hecate"
      Event = "HecateBossAboutAltFight02"
    }
    {
      Id = "HecateField_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bijak atau tidaknya mengikrarkan Sumpah Rivalitas adalah keputusanmu sendiri, tapi... aku bisa melihat kebijaksanaan dalam mencabut sumpah yang {#Emph}satu itu{#Prev}. Aku sendiri pun tak ingin menghadapi diriku saat berada di kondisi terbaik."
      Speaker = "Hecate"
      Event = "HecateBossAboutAltFight03"
    }
    {
      Id = "MelinoeField_4201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin urusanku dengan Sumpah itu belum selesai, Kepala Sekolah. Aku penasaran hal apa lagi yang Anda sembunyikan, jika Anda memiliki kekuatan sebesar itu yang hanya bisa Anda kekang atas kehendak Sang Malam semata."
      Speaker = "Melinoe"
      Event = "HecateBossAboutAltFight03"
    }
    {
      Id = "HecateField_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Teruslah penasaran, silakan saja. Dan andai kau membutuhkan ujian kemampuan yang lebih tingkat lanjut, aku akan menunggu."
      Speaker = "Hecate"
      Event = "HecateBossAboutAltFight03"
    }
    {
      Id = "HecateField_0505"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kau mengikrarkan Sumpah Rivalitas itu lagi! Aku bahkan tak perlu memintanya. Apakah keganasan tambahan dari ujian ini yang memikatmu, ataukah perubahan tempatnya?"
      Speaker = "Hecate"
      Event = "HecateBossAboutAltFight04"
    }
    {
      Id = "MelinoeField_5281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin keduanya, Kepala Sekolah. Aku ingin suasananya tetap hidup dan terus memanfaatkan ujian darimu ini semaksimal mungkin."
      Speaker = "Melinoe"
      Event = "HecateBossAboutAltFight04"
    }
    {
      Id = "HecateField_0506"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menjaga suasana tetap {#Emph}hidup {#Prev}mungkin sulit di alam baka ini, tapi aku paham maksudmu. Aku telah memintamu untuk mengerahkan segalanya melawanku... dan dengan cara ini, aku bisa menuruti nasihatku sendiri dengan sebaik-baiknya."
      Speaker = "Hecate"
      Event = "HecateBossAboutAltFight04"
    }
    {
      Id = "Melinoe_1035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang bisa kita lakukan untuk jiwa-jiwa malang yang tersesat di Erebus ini, Kepala Sekolah? Kehidupan setelah mati yang hanya dihabiskan dengan mengamuk dalam amarah yang sia-sia..."
      Speaker = "Melinoe"
      Event = "HecateBossAboutErebus01"
    }
    {
      Id = "Hecate_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita bisa menuntaskan tugas kita. Jiwa-jiwa di Erebus seharusnya ditempatkan di suatu tempat di dalam alam ayahmu, tapi semua itu terhenti begitu Chronos merebut takhta. Pergilah, rebut kembali takhta itu darinya."
      Speaker = "Hecate"
      Event = "HecateBossAboutErebus01"
    }
    {
      Id = "Melinoe_1599"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hutan kecil ini sudah tumbuh kembali sejak terakhir kali kita bertarung. Terlepas dari segala kematian di Erebus, kehidupan pun ikut bersemi."
      Speaker = "Melinoe"
      Event = "HecateBossAboutErebus02"
    }
    {
      Id = "Hecate_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kematian dan kehidupan; keduanya saling terikat erat. Pepohonan ini akan dengan mudah bertahan dari pertarungan kita di sini. Tapi bagaimana dengan {#Emph}dirimu?"
      Speaker = "Hecate"
      Event = "HecateBossAboutErebus02"
    }
    {
      Id = "Melinoe_1172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mendengar kabar dari Hermes, Kepala Sekolah. Dia memberiku kesan bahwa Olympus membutuhkan bantuanku. Bagaimana dengan tugasku?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutHermes01"
    }
    {
      Id = "Hecate_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugasmu tetap sama, begitu pula musuh yang kau hadapi. Kita akan membahas urusan Hermes ini di tempat lain. Kita punya urusan lain terlebih dahulu."
      Speaker = "Hecate"
      Event = "HecateBossAboutHermes01"
    }
    {
      Id = "Hecate_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hermes mendesakku untuk membicarakan suatu hal denganmu di sini. Namun, menurut pandanganku, kau belum siap untuk pergi ke permukaan."
      Speaker = "Hecate"
      Event = "HecateBossAboutHermes02"
    }
    {
      Id = "Melinoe_1175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artinya Anda tidak akan mencabut segel penangkal yang menghalangi jalan ke permukaan. Bagaimana jika aku menghilangkannya sendiri? Aku pernah melihat cara Anda melakukannya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutHermes02"
    }
    {
      Id = "Hecate_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, kau akan lebih siap dibanding sekarang. Sampai saat itu tiba, ingatlah bahwa tujuanmu ada di bawah sana. Menembus {#Emph}aku."
      Speaker = "Hecate"
      Event = "HecateBossAboutHermes02"
    }
    {
      Id = "Melinoe_4840"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Penembusan Penangkal Sihir..."
      Speaker = "Melinoe"
      Event = "HecateBossAboutHermes02"
    }
    {
      Id = "MelinoeField_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin suatu malam nanti aku bisa tiba di titik ini begitu cepat sampai-sampai bisa menyelinap lewat sebelum Ibu Kepala Sekolah tiba."
      Speaker = "Melinoe"
      Event = "HecateBossAboutHermes03"
    }
    {
      Id = "HecateField_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak berniat membiarkan hal semacam itu terjadi, bahkan jika kau melesat secepat Hermes sekalipun. Tapi, bagaimana kalau kita mulai saja sekarang?"
      Speaker = "Hecate"
      Event = "HecateBossAboutHermes03"
    }
    {
      Id = "Hecate_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak bisa mengalahkanku dengan kecemasan, asal kau tahu. Tenangkan inderamu, dan bersiaplah. Kau paham apa tujuan dari duel kita ini?"
      Speaker = "Hecate"
      Event = "HecateBossAboutLearning01"
    }
    {
      Id = "Melinoe_1036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk menuntaskan latihanku. Setiap bentrokan di antara kita adalah kesempatan untuk belajar dan tumbuh lebih kuat."
      Speaker = "Melinoe"
      Event = "HecateBossAboutLearning01"
    }
    {
      Id = "Hecate_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar separuhnya. Sebab latihan kita takkan pernah tuntas. Namun, kita harus terus melangkah maju."
      Speaker = "Hecate"
      Event = "HecateBossAboutLearning01"
    }
    {
      Id = "Hecate_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa jimat Roda yang kuberikan. Dulu aku menggunakannya untuk mengasah keahlianku. Semoga kini ia bisa membantumu melakukan hal yang sama."
      Speaker = "Hecate"
      Event = "HecateBossAboutHecateKeepsake01"
    }
    {
      Id = "Melinoe_1037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Roda ini bagaikan labirin tanpa awal dan tanpa akhir... jalan setapak yang berputar kembali ke dirinya sendiri. Mirip Erebus..."
      Speaker = "Melinoe"
      Event = "HecateBossAboutHecateKeepsake01"
    }
    {
      Id = "Hecate_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaikan kehidupan itu sendiri! Tiga tahapan yang saling terjalin. Mari kita lalui tahapan-tahapan itu sekarang."
      Speaker = "Hecate"
      Event = "HecateBossAboutHecateKeepsake01"
    }
    {
      Id = "HecateField_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi-lagi kau membawa Roda yang kuberikan padamu; lebih tepatnya, yang {#Emph}kusimpan {#Prev}untukmu sampai kau siap, karena benda itu memang selalu jadi milikmu. Anggap saja sarana untuk memusatkan ketajaman sihirmu."
      Speaker = "Hecate"
      Event = "HecateBossAboutHecateKeepsake02"
    }
    {
      Id = "MelinoeField_1997"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini jauh lebih berharga dari itu. Labirin tanpa akhir dengan tiga sisi berbeda... pengingat akan rumah kita, dan batas-batas kekuatan kita."
      Speaker = "Melinoe"
      Event = "HecateBossAboutHecateKeepsake02"
    }
    {
      Id = "HecateField_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Persimpangan Jalan mungkin terasa seperti semacam rumah bagimu, tapi itu jelas-jelas {#Emph}bukan rumahmu. {#Prev}Itu adalah labirin tempatmu terperangkap. {#Emph}Bebaskan dirimu!"
      Speaker = "Hecate"
      Event = "HecateBossAboutHecateKeepsake02"
    }
    {
      Id = "HecateField_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artefak busuk apa yang kau bawa itu? {#Emph}Ah! {#Prev}Mata Nemesis. Penangkal terhadap mereka yang memendam niat jahat. Sungguh sebuah ironi, datang dari orang seperti dia."
      Speaker = "Hecate"
      Event = "HecateBossAboutNemesisKeepsake01"
    }
    {
      Id = "MelinoeField_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bermaksud lancang, Ibu Kepala Sekolah. Mata ini tak pandang bulu dalam khasiatnya, dan membuatku bertarung lebih tangguh melawan musuh terkuatku."
      Speaker = "Melinoe"
      Event = "HecateBossAboutNemesisKeepsake01"
    }
    {
      Id = "HecateField_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh ajaib Mata ini tidak membuat kita berdua meledak terbakar di tempat! Kalau begitu, lakukan pembalasanmu jika kau mampu!"
      Speaker = "Hecate"
      Event = "HecateBossAboutNemesisKeepsake01"
    }
    {
      Id = "HecateField_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi darah dan kegelapan, aku bisa merasakan Tulang Jari terkutuk itu ada padamu. Aku harus berterima kasih pada Odysseus karena telah memberikan hadiah semacam itu..."
      Speaker = "Hecate"
      Event = "HecateBossAboutOdysseusKeepsake01"
    }
    {
      Id = "MelinoeField_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cinderamataku? Aku terkejut benda ini mempan padamu, Ibu Kepala Sekolah. Kupikir kau sendiri yang menyihirnya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutOdysseusKeepsake01"
    }
    {
      Id = "HecateField_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus sudah mengenal banyak penyihir selain kita. Baiklah, aku siap menahan hantamannya; Tulang Jari menyerang lebih dulu, lalu, kita bertarung."
      Speaker = "Hecate"
      Event = "HecateBossAboutOdysseusKeepsake01"
    }
    {
      Id = "HecateField_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah aku mencium bau artefak dari Moros? Sesuatu yang mendatangkan Ajal dengan cepat ke musuhmu sembari menunda ajalmu sendiri. Benda yang cukup berguna, rupanya."
      Speaker = "Hecate"
      Event = "HecateBossAboutMorosKeepsake01"
    }
    {
      Id = "MelinoeField_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yakin Tuan Moros tidak bermaksud menyinggungmu. Namun Cinderamatanya sangat berguna bagiku, dan aku harus memanfaatkan setiap celah sebaik mungkin."
      Speaker = "Melinoe"
      Event = "HecateBossAboutMorosKeepsake01"
    }
    {
      Id = "HecateField_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar. Tak heran jika Ajal kini menetap bersama kita untuk sementara waktu. Kehadirannya membayangi setiap tindakan yang kita ambil..."
      Speaker = "Hecate"
      Event = "HecateBossAboutMorosKeepsake01"
    }
    {
      Id = "HecateField_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Udara di sekitarmu terasa begitu berat malam ini. {#Emph}Ah! {#Prev}Itu berasal dari secuil barang yang diberikan Medea padamu. Hadiah, bukan kutukan, kuharap?"
      Speaker = "Hecate"
      Event = "HecateBossAboutMedeaKeepsake01"
    }
    {
      Id = "MelinoeField_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cinderamatanya, benar. Secuil bulu wol... domba-domba berkeliaran di Ephyra, tapi tak ada yang mantel bulunya sehitam dan seberkilau ini. Ini sesuatu yang istimewa, aku bisa merasakannya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutMedeaKeepsake01"
    }
    {
      Id = "HecateField_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, setidaknya jika dibandingkan wol pada umumnya. Medea tidak mudah menerima orang lain ke dalam lingkarannya; dia sendiri agak seperti domba hitam. Tapi, bukankah kita semua juga begitu?"
      Speaker = "Hecate"
      Event = "HecateBossAboutMedeaKeepsake01"
    }
    {
      Id = "HecateField_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh...! {#Prev}Cinderamata busuk apa pun yang kau putuskan untuk bawa demi keberuntungan malam ini, itu barang yang mengerikan. Rekan macam apa yang menghadiahimu hal semacam itu?"
      Speaker = "Hecate"
      Event = "HecateBossAboutErisKeepsake01"
    }
    {
      Id = "MelinoeField_2028"
      InheritFrom = "BaseNarrative"
      DisplayName = "I-itu... hadiah dari Eris, Ibu Kepala Sekolah. Aku tahu efeknya tidak sepenuhnya menguntungkanku, ataupun orang lain... tapi kupikir..."
      Speaker = "Melinoe"
      Event = "HecateBossAboutErisKeepsake01"
    }
    {
      Id = "HecateField_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bahwa Eris berniat membantumu? Atau dia punya tujuan {#Emph}apa pun {#Prev}selain menabur kekacauan di mana pun dia bisa? Kalian berdua pasangan yang aneh, Melinoë. Begitu pula pertarungan {#Emph}ini."
      Speaker = "Hecate"
      Event = "HecateBossAboutErisKeepsake01"
    }
    {
      Id = "Hecate_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olympus telah membesarkan hatimu, dan membuatmu kuat. Namun, itu kekuatan yang fana; satu langkah salah saja, dan aku bisa melenyapkannya semua."
      Speaker = "Hecate"
      Event = "HecateBossAboutOlympians01"
    }
    {
      Id = "Melinoe_1038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih memilih kekuatan yang fana daripada tak punya kekuatan sama sekali. Kita manfaatkan setiap keuntungan yang terbuka."
      Speaker = "Melinoe"
      Event = "HecateBossAboutOlympians01"
    }
    {
      Id = "Hecate_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Kalau begitu, maju dan tunjukkan padaku bagaimana kau memanfaatkan {#Emph}keuntungan-keuntungan {#Prev}itu."
      Speaker = "Hecate"
      Event = "HecateBossAboutOlympians01"
    }
    {
      Id = "Hecate_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hmm. {#Prev}Tadinya kupikir kau sudah begitu terpikat pada permukaan sampai-sampai takkan kembali kemari dalam waktu dekat."
      Speaker = "Hecate"
      Event = "HecateBossAboutSurface01"
    }
    {
      Id = "Melinoe_0654"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugas kita membawaku sampai ke ujung Bumi. Aku punya urusan yang belum selesai di sana maupun di sini. Tapi aku jauh lebih nyaman berada di lingkungan ini."
      Speaker = "Melinoe"
      Event = "HecateBossAboutSurface01"
    }
    {
      Id = "Hecate_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nyaman? {#Prev}Kau seharusnya bersiaga penuh, dan bersiap untuk bertempur! Mari kita lihat seberapa {#Emph}nyaman {#Prev}duel ini bagi kita berdua."
      Speaker = "Hecate"
      Event = "HecateBossAboutSurface01"
    }
    {
      Id = "Hecate_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memutuskan untuk beristirahat dari semua jalan-jalanmu ke permukaan belakangan ini, ya?"
      Speaker = "Hecate"
      Event = "HecateBossAboutFlattery01"
    }
    {
      Id = "Melinoe_1176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak hal yang harus diselesaikan, baik di atas maupun di bawah. Anda selalu bilang guru terbaik ada di {#Emph}luar sana{#Prev}. Tapi sepertinya aku selalu menemukannya di sini."
      Speaker = "Melinoe"
      Event = "HecateBossAboutFlattery01"
    }
    {
      Id = "Hecate_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}tidak pernah {#Prev}mengajarimu rayuan murahan seperti itu. Salah satu trik Odysseus, mungkin...! Mari kita lihat apa lagi yang sudah kau pelajari."
      Speaker = "Hecate"
      Event = "HecateBossAboutFlattery01"
    }
    {
      Id = "Melinoe_2138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anda pasti memakai cadar itu agar tidak memperlihatkan kekecewaan Anda, Kepala Sekolah. Begitu banyak kegagalan, tapi Anda masih belum menegurku?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutFailure01"
    }
    {
      Id = "HecateField_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, diamlah, Melinoë. Untuk kemunduranmu, kesabaranku tak terbatas, tapi untuk rengekanmu, aku sama sekali tak punya. Cari pemantik yang lebih baik untuk gejolak batin seperti itu, karena aku tak punya simpati untuk hal cengeng!"
      Speaker = "Hecate"
      Event = "HecateBossAboutFailure01"
    }
    {
      Id = "Melinoe_2139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah kalau begitu...!"
      Speaker = "Melinoe"
      Event = "HecateBossAboutFailure01"
    }
    {
      Id = "MelinoeField_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bermaksud membuat Anda menunggu lama, Kepala Sekolah. Atau Anda memang selalu tiba tepat pada waktunya?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutSolitude01"
    }
    {
      Id = "HecateField_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedikit menyendiri di sini bukanlah buang-buang waktu; aku tak pernah sekadar menunggu. Lagipula masih banyak urusan yang harus kuurus di hutan ini. Tapi {#Emph}pertama-tama..."
      Speaker = "Hecate"
      Event = "HecateBossAboutSolitude01"
    }
    {
      Id = "HecateField_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini sunyi sekali. Rasakan keheningannya sejenak, sebelum kita memulai ujian kecil untuk melihat sejauh mana kemampuanmu sekarang."
      Speaker = "Hecate"
      Event = "HecateBossAboutSilence01"
    }
    {
      Id = "MelinoeField_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang terasa luar biasa hening, dan Bulan pun kian menyusut. Pertanda buruk, Kepala Sekolah? Arwah-arwah kita sebaiknya memeriksa anjing-anjing peliharaan Anda..."
      Speaker = "Melinoe"
      Event = "HecateBossAboutSilence01"
    }
    {
      Id = "HecateField_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu, anjing-anjing itu bisa mengurus diri sendiri. Kemungkinan besar mereka memanfaatkan waktu ini untuk beristirahat; sesuatu yang bijak jika sesekali kau tiru."
      Speaker = "Hecate"
      Event = "HecateBossAboutSilence01"
    }
    {
      Id = "Hecate_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan; pengetahuan; kesabaran. Kau telah menunjukkan ketiganya berulang kali. Kerja bagus."
      Speaker = "Hecate"
      Event = "HecateBossRepeatedWins01"
    }
    {
      Id = "Melinoe_1040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Kepala Sekolah. Meskipun aku selalu mendapat pelajaran baru dari setiap benturan kita."
      Speaker = "Melinoe"
      Event = "HecateBossRepeatedWins01"
    }
    {
      Id = "Hecate_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus, karena aku tak berniat memberi jalan begitu saja. Ilmu kita disebut {#Emph}latihan {#Prev}bukan tanpa alasan. Sekarang, pasang kudakudamu."
      Speaker = "Hecate"
      Event = "HecateBossRepeatedWins01"
    }
    {
      Id = "Hecate_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil mengalahkanku sebelumnya, tapi aku penasaran: Apakah itu murni berkat penguasaan ilmumu, atau mungkin para Moirai memberi sedikit {#Emph}dorongan takdir?{#Prev}"
      Speaker = "Hecate"
      Event = "HecateBossRepeatedWins02"
    }
    {
      Id = "Melinoe_1600"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Kepala Sekolah. Kalau aku {#Emph}semudah itu {#Prev}terpancing, aku takkan punya peluang sama sekali. Bahkan jika para Moirai menghendaki sebaliknya."
      Speaker = "Melinoe"
      Event = "HecateBossRepeatedWins02"
    }
    {
      Id = "Hecate_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keberuntungan jarang menghampiri mereka yang tak siap menerimanya. Tunjukkan padaku bahwa kemenanganmu bukan sekadar kebetulan belaka."
      Speaker = "Hecate"
      Event = "HecateBossRepeatedWins02"
    }
    {
      Id = "Hecate_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau hampir mengalahkanku di pertarungan terakhir, tapi kekalahan tipis tetaplah sebuah kekalahan. Kali ini, kuharap kau menuntaskannya hingga menang telak."
      Speaker = "Hecate"
      Event = "HecateBossCloseMatch01"
    }
    {
      Id = "HecateField_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat terakhir kali kita bertarung seperti ini, aku tahu aku sama sekali bukan ancaman bagimu. Namun musuh-musuhmu sangat keras kepala; tak ada yang bisa kau lakukan untuk membuat kami menyingkir dari jalanmu."
      Speaker = "Hecate"
      Event = "HecateBossQuickMatch01"
    }
    {
      Id = "MelinoeField_3482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Justru karena itu aku ingin menyelesaikannya secepat mungkin. Meski jika suasana hatiku sedang lain, mungkin aku akan membuat segalanya jauh lebih buruk hanya dengan beberapa Sumpah dari Ikrar."
      Speaker = "Melinoe"
      Event = "HecateBossQuickMatch01"
    }
    {
      Id = "HecateField_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap malam menawarkan tantangan tersendiri. Entah kau sedang berfokus pada kecepatan atau kekuatanmu, pastikan kau memanfaatkan waktu yang kita miliki ini dengan baik."
      Speaker = "Hecate"
      Event = "HecateBossQuickMatch01"
    }
    {
      Id = "Hecate_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kau akan tiba di sini kemarin malam, tapi bukan hakku untuk menghentikan usahamu saat itu. Namun, aku takkan ragu menghentikan usahamu yang {#Emph}kali ini{#Prev}."
      Speaker = "Hecate"
      Event = "HecateBossMissedFight01"
    }
    {
      Id = "Hecate_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak kemelut akhir-akhir ini, baik di Olympus maupun di bawah sana. Namun aku ingin kau menyingkirkan semua urusan duniawi itu selama berada di sini."
      Speaker = "Hecate"
      Event = "HecateBossStrictlyBusiness01"
    }
    {
      Id = "Melinoe_1041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keadaan inilah yang justru terus memacuku. Menyingkirkannya akan sangat sulit, Kepala Sekolah..."
      Speaker = "Melinoe"
      Event = "HecateBossStrictlyBusiness01"
    }
    {
      Id = "Hecate_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak peduli soal kata {#Emph}sulit{#Prev}. Kita punya banyak waktu untuk merenung tak jelas di Persimpangan. Di sini, kita adalah lawan. Tak lebih dari itu."
      Speaker = "Hecate"
      Event = "HecateBossStrictlyBusiness01"
    }
    {
      Id = "Hecate_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu kau. Aku tak bisa berlama-lama. Hanya cukup waktu untuk mengujimu."
      Speaker = "Hecate"
      Event = "HecateBossAboutTesting01"
    }
    {
      Id = "Melinoe_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kemari secepat yang kubisa, Kepala Sekolah. Dan Anda tetap harus menunggu."
      Speaker = "Melinoe"
      Event = "HecateBossAboutTesting01"
    }
    {
      Id = "Hecate_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menunggu adalah bagian dari melatih kesabaran. Sekarang, kurasa saatnya beralih ke latihan yang lain."
      Speaker = "Hecate"
      Event = "HecateBossAboutTesting01"
    }
    {
      Id = "Hecate_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Singkirkan rasa hormatmu padaku selama di sini. Kau tak boleh memberi ampunan semacam itu kepada musuh-musuh kita."
      Speaker = "Hecate"
      Event = "HecateBossAboutRespect01"
    }
    {
      Id = "Melinoe_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi Anda bukan musuhku, Kepala Sekolah. Bagaimana bisa aku memperlakukan Anda sebagai lawan?"
      Speaker = "Melinoe"
      Event = "HecateBossAboutRespect01"
    }
    {
      Id = "Hecate_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bagaimana? {#Prev}Kalau begitu, biar kuberi peragaan langsung."
      Speaker = "Hecate"
      Event = "HecateBossAboutRespect01"
    }
    {
      Id = "MelinoeField_3156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, kenapa kita harus terus mengulang ini? Aku sudah lolos ujian Anda berkali-kali; kita berdua sama-sama dibutuhkan di tempat lain."
      Speaker = "Melinoe"
      Event = "HecateBossAboutRepetition01"
    }
    {
      Id = "HecateField_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin kuat, tapi belum cukup tangguh! Dan terbukti sangat tidak sabaran pula. Apa kau juga akan mencoba membujuk Chronos agar membatalkan pertarungan?"
      Speaker = "Hecate"
      Event = "HecateBossAboutRepetition01"
    }
    {
      Id = "MelinoeField_3157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja tidak, tapi... aku bisa saja sudah separuh jalan menuju Padang Ratapan sekarang, kalau bukan karena ini."
      Speaker = "Melinoe"
      Event = "HecateBossAboutRepetition01"
    }
    {
      Id = "HecateField_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali segalanya tak selalu berjalan sesuai kehendak kita. Ayo maju, luapkan amarah yang kau pendam! Kita berdua punya amarah yang lebih dari cukup untuk dihabiskan."
      Speaker = "Hecate"
      Event = "HecateBossAboutRepetition01"
    }
    {
      Id = "HecateField_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Segalanya persis seperti dulu, namun tak ada lagi yang sama! Perasaan yang sangat kupahami. Tampaknya kita harus memperpanjang latihanmu untuk beberapa saat lagi..."
      Speaker = "Hecate"
      Event = "HecateBossPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Latihanku takkan pernah selesai, bukan begitu? Meski aneh rasanya memikirkan bahwa mengulang langkahku sebelumnya ke Tartarus akan membantu menjaga jalannya Sang Waktu..."
      Speaker = "Melinoe"
      Event = "HecateBossPostTrueEnding01"
    }
    {
      Id = "HecateField_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kita benar-benar mampu menjaga Sang Waktu, itu masih harus dibuktikan! Tapi setidaknya kita masih bisa menjaga diri kita sendiri."
      Speaker = "Hecate"
      Event = "HecateBossPostTrueEnding01"
    }
    {
      Id = "HecateField_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakekmu Chronos kemungkinan besar menanti di balik ambang pintu ini, di mana dulu dia mengintai tanah lapang itu sebagai musuh bebuyutan kita. Bagaimana rasanya bekerja sama dengannya?"
      Speaker = "Hecate"
      Event = "HecateBossPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luar biasa aneh, bisa dibilang... dia terbukti sangat berperan dalam melenyapkan sisa-sisa dirinya di masa lalu. Pasti rasanya sangat janggal menghadapi diri sendiri dengan cara seperti itu."
      Speaker = "Melinoe"
      Event = "HecateBossPostTrueEnding02"
    }
    {
      Id = "HecateField_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh sangat janggal memang. Tapi jika berhasil, aku takkan terlalu mempertanyakannya. Mungkin kita semua akan belajar lebih banyak tentang misteri Sang Waktu sebelum semua ini berakhir."
      Speaker = "Hecate"
      Event = "HecateBossPostTrueEnding02"
    }
    {
      Id = "HecateField_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan padaku sekarang, Melinoë. Siapa musuh paling sengit yang berhasil kau taklukkan dalam semua ini? Chronos? Typhon?"
      Speaker = "Hecate"
      Event = "HecateBossPostEpilogue01"
    }
    {
      Id = "MelinoeField_4203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu apa yang kau maksud, Kepala Sekolah... Hecate. Aku lebih sering menghalangi diriku {#Emph}sendiri {#Prev}daripada musuh-musuhku. Kecuali kau, mungkin, tapi itu kurang lebih sama saja."
      Speaker = "Melinoe"
      Event = "HecateBossPostEpilogue01"
    }
    {
      Id = "HecateField_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Batasan yang kita buat untuk diri kita sendirilah yang menghalangi apa yang bisa kita capai. Mengatasi batasan-batasan itu luar biasa sulitnya. Tapi, kau telah berhasil melakukannya... lagi, dan lagi."
      Speaker = "Hecate"
      Event = "HecateBossPostEpilogue01"
    }
    {
      Id = "MelinoeField_4387"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah memiliki api-api itu sejak lama sekali, bukan, Hecate? Apakah itu... berasal dari tempat asalmu?"
      Speaker = "Melinoe"
      Event = "HecateBossPostEpilogue02"
    }
    {
      Id = "HecateField_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "Api-api itu menerangi jalanku di masa muda, dan bahkan sampai sekarang. Rawatlah milikmu baik-baik, dan mereka akan bertahan lama bersamamu..."
      Speaker = "Hecate"
      Event = "HecateBossPostEpilogue02"
    }
    {
      Id = "MelinoeField_4388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu bertanya-tanya mengapa tak satu pun Aspek dari Senjata Nokturnal yang kutemukan adalah milikmu..."
      Speaker = "Melinoe"
      Event = "HecateBossPostEpilogue02"
    }
    {
      Id = "HecateField_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cobalah untuk tidak terlalu memikirkannya, jangan sampai itu membuyarkan pikiranmu tanpa henti. Tapi ya, api-api ini dan diriku memang bukan bagian dari sini. Dan justru karena alasan itulah, kurasa para Fates berhasil mengetahuinya."
      Speaker = "Hecate"
      Event = "HecateBossPostEpilogue02"
    }
    {
      Id = "HecateField_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belakangan ini jarang melihatmu di sini, Melinoë. Dan kau juga belum pergi ke permukaan akhir-akhir ini. Mimpimulah yang memanggilmu, bukan begitu?"
      Speaker = "Hecate"
      Event = "HecateBossAboutDreamRuns01"
    }
    {
      Id = "MelinoeField_5273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mendengar kabar dari Yang Mulia Hypnos lagi setelah kepergiannya yang agak mendadak. Dia membantuku menjelajahi mimpi-mimpiku, ya... menghadapi ketakutanku yang masih tersisa akibat melakukan ini malam demi malam."
      Speaker = "Melinoe"
      Event = "HecateBossAboutDreamRuns01"
    }
    {
      Id = "HecateField_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mimpi yang berakar pada kenyataan adalah jenis yang paling meresahkan. Yah, asalkan kau tidak selamanya terperangkap dalam lamunan khayalan! Aku mulai menikmati bentrokan sesekali kita ini."
      Speaker = "Hecate"
      Event = "HecateBossAboutDreamRuns01"
    }
    {
      Id = "HecateField_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Haruskah kita melanjutkan bentrokan ini untuk selamanya? Sepertinya ada cukup banyak kemungkinan dari Chronos untuk membuatmu sibuk selama itu."
      Speaker = "Hecate"
      Event = "HecateBossAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_4302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak terburu-buru, Hecate. Lagi pula, jika dulu aku takut harus menghadapimu di sini, entah sejak kapan aku mulai menikmatinya."
      Speaker = "Melinoe"
      Event = "HecateBossAboutSayingLittle01"
    }
    {
      Id = "HecateField_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih suka jika menang lebih sering, tapi aku pun mulai menikmatinya. Kalau begitu, mari kita lanjutkan... berapa lama pun waktu yang dibutuhkan."
      Speaker = "Hecate"
      Event = "HecateBossAboutSayingLittle01"
    }
    {
      Id = "Hecate_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berdua saja; bahkan lolongan anjing pun tak terdengar. Selene nun jauh di atas sana harus cukup sebagai penonton kita."
      Speaker = "Hecate"
      Event = "HecateBossAboutSolitude02"
    }
    {
      Id = "Hecate_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak yang diharapkan darimu. Jadi kau harus belajar memikul beban itu dengan penuh keanggunan."
      Speaker = "Hecate"
      Event = "HecateBossAboutExpectations01"
    }
    {
      Id = "Hecate_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu tugasmu berat, dan aku juga tahu kau punya kemampuan untuk berhasil."
      Speaker = "Hecate"
      Event = "HecateBossAboutTask01"
    }
    {
      Id = "Hecate_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugasmu mungkin sebuah kehormatan, tapi orang paling bijak yang kau kenal sekalipun takkan merasa iri padamu karenanya."
      Speaker = "Hecate"
      Event = "HecateBossAboutTask02"
    }
    {
      Id = "HecateField_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keahlian kita menyisakan sedikit ruang untuk keraguan, namun pasti selalu ada yang tersisa; dan sedikit saja bisa jadi terlalu fatal."
      Speaker = "Hecate"
      Event = "HecateBossAboutWitchcraft01"
    }
    {
      Id = "HecateField_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau kurang percaya diri, lalu bagaimana kau akan mewujudkan kehendakmu? Pastikan apa yang diinginkan oleh hatimu."
      Speaker = "Hecate"
      Event = "HecateBossAboutConfidence01"
    }
    {
      Id = "HecateField_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sedang marah; luapkanlah. Kemarahan bukan untuk dipendam, bukan pula untuk salah diarahkan. Menjadi {#Emph}marah{#Prev}... artinya menjadi {#Emph}hidup{#Prev}."
      Speaker = "Hecate"
      Event = "HecateBossAboutAnger01"
    }
    {
      Id = "Chronos_0973"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya jalur menuju Erebus tidak lagi dijaga seketat dulu. Kutebak sosok di sini adalah orang yang mengadumu denganku, benarkah begitu?"
      Speaker = "Chronos"
      Event = "HecateBossKidnapped01"
    }
    {
      Id = "MelinoeField_3873"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah! Kepala Sekolah, lawan dia, {#Emph}lawan! {#Prev}Lawan balik!!"
      Speaker = "Melinoe"
      Event = "HecateBossKidnapped01"
    }
    {
      Id = "/EmptyCue"
      InheritFrom = "BaseNarrative"
      DisplayName = ". . . ."
      Speaker = "Empty"
      Event = "HecateBossKidnapped01"
    }
    {
      Id = "Chronos_0974"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kepala sekolahmu {#Prev}ini punya pengetahuan yang cukup hebat, sampai bisa menyembunyikanmu sedemikian rupa... tapi dia kelelahan, hingga akhirnya {#Emph}Waktu {#Prev}bisa menyusulnya. Dia tak mendengar sepatah kata pun darimu."
      Speaker = "Chronos"
      Event = "HecateBossKidnapped01"
    }
    {
      Id = "MelinoeField_3874"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lepaskan dia, keparat. Lepaskan dia, atau kurobek-robek kau jadi berkeping-keping."
      Speaker = "Melinoe"
      Event = "HecateBossKidnapped01"
    }
    {
      Id = "Chronos_0975"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anak-anak kandungku sendiri pernah merobekku jadi berkeping-keping dulu. Lihat apa jadinya {#Emph}mereka! {#Prev}Siapa pun sosok ini, mungkin dia akan lebih kooperatif darimu, meski aku tidak terlalu optimis; kau pun jangan terlalu berharap. Selamat malam!"
      Speaker = "Chronos"
      Event = "HecateBossKidnapped01"
    }
    {
      Id = "MelinoeField_3875"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali kau! {#Emph}Augh!!"
      Speaker = "Melinoe"
      Event = "HecateBossKidnapped01"
    }
    {
      Id = "Hecate_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemarilah, tunjukkan padaku apa yang baru saja kau pelajari."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart01"
    }
    {
      Id = "Hecate_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, mari kita mulai pelajarannya, Melinoë."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart02"
    }
    {
      Id = "Hecate_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Rembulan akan menjadi saksi kita malam ini. Bersiaplah!"
      Speaker = "Hecate"
      Event = "HecateBossMiscStart03"
    }
    {
      Id = "Hecate_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah semua sihirmu sudah siap? Kalau begitu, mari bertarung."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart04"
    }
    {
      Id = "Hecate_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hantam aku hingga langit pun tergetar gemetar!"
      Speaker = "Hecate"
      Event = "HecateBossMiscStart05"
    }
    {
      Id = "Hecate_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atur napasmu, dan kuatkan tekadmu, Melinoë."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart06"
    }
    {
      Id = "Hecate_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan menahan diri sedikit pun melawanku di sini, Melinoë."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart07"
    }
    {
      Id = "Hecate_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap kali kau menghadapiku, kau melangkah lebih dekat menuju potensi sejatimu, Penyihir."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart08"
    }
    {
      Id = "Hecate_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang mari kita adu kekuatan, sesama Penyihir."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart09"
    }
    {
      Id = "Hecate_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Haruskah kita buktikan apa kau bisa menaklukkanku lagi, Penyihir?"
      Speaker = "Hecate"
      Event = "HecateBossMiscStart10"
    }
    {
      Id = "Hecate_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin bisa melampauiku, tapi seberapa banyak tenaga yang harus kau korbankan untuk itu?"
      Speaker = "Hecate"
      Event = "HecateBossMiscStart11"
    }
    {
      Id = "Hecate_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Majulah, dan kuharap hasilnya lebih baik daripada pertarungan terakhir kita."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart12"
    }
    {
      Id = "Hecate_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kau siap menerima pelajaran keras lainnya, atau kau sanggup melewLegasiku?"
      Speaker = "Hecate"
      Event = "HecateBossMiscStart13"
    }
    {
      Id = "Hecate_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sampai di sini begitu cepat, meski ketergesaan membuka celah lebih besar untuk berbuat salah."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart14"
    }
    {
      Id = "Hecate_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada jalan keluar dari Erebus kecuali melewatiku."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart15"
    }
    {
      Id = "Hecate_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya kau sudah bersiap matang, jadi mari kita mulai."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart16"
    }
    {
      Id = "Hecate_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita lihat apakah rentetan kemenanganmu ini masih bisa kau pertahankan."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart17"
    }
    {
      Id = "Hecate_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hormatilah aku dengan tidak pernah menurunkan kewaspadaanmu."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart18"
    }
    {
      Id = "Hecate_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah belajar banyak sejak pertama kali kita bertarung, meski selalu ada hal baru untuk dipelajari."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart19"
    }
    {
      Id = "Hecate_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Basa-basi bisa menunggu sampai kita bertemu lagi di Persimpangan Jalan nanti."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart20"
    }
    {
      Id = "HecateField_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Firasatku mengatakan ini takkan memakan waktu lama."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart21"
    }
    {
      Id = "HecateField_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita beri Saudari Selene pertunjukan apik di atas sana."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart22"
    }
    {
      Id = "HecateField_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini malam bulan baru, kesempatan untuk awal yang baru. Tapi pertama-tama...!"
      Speaker = "Hecate"
      Event = "HecateBossMiscStart23"
    }
    {
      Id = "Hecate_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak sekadar sedang diuji di sini; kau tak boleh pernah berhenti belajar."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart24"
    }
    {
      Id = "HecateField_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bulan purnama bersinar terang malam ini. Memberikan kesan dramatis tersendiri pada pertempuran kita, bukan?"
      Speaker = "Hecate"
      Event = "HecateBossMiscStart25"
    }
    {
      Id = "Hecate_0746"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum penyihir seperti kita kerap diremehkan. Namun, aku sangat paham betapa hebatnya kemampuanmu."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart26"
    }
    {
      Id = "HecateField_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih ingat beberapa trik andalanmu saat mengayunkan Descura itu, tapi bagaimana kalau kau ingatkan aku lagi?"
      Speaker = "Hecate"
      Event = "HecateBossMiscStart27"
    }
    {
      Id = "HecateField_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan kebiasaanku membiarkan orang lain menerjangku dengan belati. Tapi demi dirimu serta Lim dan Oros, {#Emph}apa pun itu."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart28"
    }
    {
      Id = "HecateField_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi obor tuaku ini harus beradu melawan milikmu lagi? Aku sungguh menyukai bentrokan semacam ini."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart29"
    }
    {
      Id = "HecateField_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hutan ini akan segera tampak seperti padang rumput jika kau terus mengayun-ayunkan Kapak Batu Bulan tua itu..."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart30"
    }
    {
      Id = "HecateField_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tengkorak Argent, rupa sejati dari kematian... Kurasa ia mulai menyunggingkan senyum tipis di hadapan kita."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart31"
    }
    {
      Id = "HecateField_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jubah Hitam Xinth lagi malam ini? Kalau begitu, aku akan bersiap menahan hantamanmu, dan kusarankan {#Emph}kau {#Prev}juga begitu."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart32"
    }
    {
      Id = "HecateField_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berdua punya Sisi Gelap yang menunggu untuk dibangkitkan. Sekarang saat yang tepat untuk menunjukkan milik{#Emph}ku."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart33"
    }
    {
      Id = "HecateField_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita pastikan malam yang mencekam ini takkan pernah dilupakan oleh mereka yang menyaksikan."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart34"
    }
    {
      Id = "HecateField_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingat betul kau menghindari setiap seranganku pada duel terakhir kita. Coba kita lihat apakah kau bisa mengulanginya."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart35"
    }
    {
      Id = "HecateField_0495"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau bersedia berbaik hati membiarkanku memukulmu sekali atau dua kali malam ini, tak seperti waktu itu..."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart36"
    }
    {
      Id = "HecateField_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau meraih kemenangan secepat yang pernah kulihat saat terakhir kali kita beradu. Apakah itu akan menjadi ritmemu mulai sekarang?"
      Speaker = "Hecate"
      Event = "HecateBossMiscStart37"
    }
    {
      Id = "HecateField_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertarungan terakhir kita praktis berakhir begitu baru saja dimulai. Apakah kau akan menghabisiku secepat itu lagi?"
      Speaker = "Hecate"
      Event = "HecateBossMiscStart38"
    }
    {
      Id = "HecateField_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, Sisi Gelapmu akan diadu dengan milikku malam ini. Aku menanti-nantikan bagaimana hasilnya."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart39"
    }
    {
      Id = "HecateField_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berdua telah mengikat Sumpah pada Malam. Jangan menahan diri sedikit pun."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart40"
    }
    {
      Id = "HecateField_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aspek Senjata aneh yang kau gunakan itu... tunjukkan lebih banyak padaku apa yang sanggup kau capai dengannya."
      Speaker = "Hecate"
      Event = "HecateBossMiscStart41"
    }
    {
      Id = "Hecate_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bertarung dengan tekun dan penuh keganasan. Namun pastinya masih banyak yang harus kau pelajari di balik ambang pintu ini."
      Speaker = "Hecate"
      Event = "HecateBossOutro01"
    }
    {
      Id = "Melinoe_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat menantikannya, Kepala Sekolah. Bagaimana dengan Anda? Tidak bisakah ikut bersamaku?"
      Speaker = "Melinoe"
      Event = "HecateBossOutro01"
    }
    {
      Id = "Hecate_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak; aku tak berani pergi terlalu jauh dari kediaman kita. Teruskan tugasmu sekarang. Aku akan menanti kepulanganmu dengan selamat."
      Speaker = "Hecate"
      Event = "HecateBossOutro01"
    }
    {
      Id = "Melinoe_0176"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, Kepala Sekolah..."
      Speaker = "Melinoe"
      Event = "HecateBossOutro01"
    }
    {
      Id = "HecateField_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arcana sama sekali tak memberimu manfaat malam ini, tapi kau masih bisa mengalahkanku. Aku tak tahu harus memujimu setinggi langit, atau menegurmu karena terlalu banyak pamer! {#Emph}Hah!"
      Speaker = "Hecate"
      Event = "HecateBossOutroNoArcana01"
    }
    {
      Id = "MelinoeField_2031"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sudah bertambah kuat..."
      Speaker = "Melinoe"
      Event = "HecateBossOutroNoArcana01"
    }
    {
      Id = "HecateField_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau sudah berkembang. Dulu, kau takkan pernah bisa menghentikanku jika aku menggunakan Sisi Gelap seperti itu padamu. {#Emph}Hm."
      Speaker = "Hecate"
      Event = "HecateBossOutroAltFight01"
    }
    {
      Id = "MelinoeField_3396"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beliau masih menahan kekuatannya..."
      Speaker = "Melinoe"
      Event = "HecateBossOutroAltFight01"
    }
    {
      Id = "Hecate_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil bertahan menghadapiku, dan untuk {#Emph}itu{#Prev}, kau berhak mendapat sebuah hadiah. Semoga kau belajar banyak darinya, Melinoë."
      Speaker = "Hecate"
      Event = "HecateBossGrantsCodex01"
    }
    {
      Id = "Melinoe_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buku Bayangan..."
      Speaker = "Melinoe"
      Event = "HecateBossGrantsCodex01"
    }
    {
      Id = "HecateField_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bawalah Hewan Akrab bersamamu lain kali, hitung-hitung agar suasana jadi lebih hidup untukku! Kita punya cara untuk menjaga mereka tetap aman, bahkan dalam pertarungan semacam ini."
      Speaker = "Hecate"
      Event = "HecateBossGrantsFamiliarSystem01"
    }
    {
      Id = "MelinoeField_1999"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Keimanan Roh Akrab{#Prev}... ini semestinya bisa bekerja pada Frinos, atau mungkin..."
      Speaker = "Melinoe"
      Event = "HecateBossGrantsFamiliarSystem01"
    }
    {
      Id = "HecateField_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fisikmu sudah berkembang cukup kuat... namun secara spiritual, masih banyak yang harus diasah. Altar Abu; ada mantra yang bisa membuat meditasi malammu di sana menjadi lebih berfaedah."
      Speaker = "Hecate"
      Event = "HecateBossGrantsCardUpgradeSystem01"
    }
    {
      Id = "Melinoe_3449"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Penyucian Abu..."
      Speaker = "Melinoe"
      Event = "HecateBossGrantsCardUpgradeSystem01"
    }
    {
      Id = "HecateField_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membawa setiap Senjata Nokturnal adalah tanggung jawab yang teramat berat. Kau baru mulai memahami hakikatnya; mantra tertentu akan memperdalam pemahamanmu."
      Speaker = "Hecate"
      Event = "HecateBossGrantsWeaponUpgradeSystem01"
    }
    {
      Id = "Melinoe_3448"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aspek-Aspek Malam dan Kegelapan..."
      Speaker = "Melinoe"
      Event = "HecateBossGrantsWeaponUpgradeSystem01"
    }
    {
      Id = "HecateField_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu rahasia lain dari Sumpah Sang Gaib akan kubuka sekarang. Jika kau merasa sudah cukup siap, renungkanlah ini. Lalu mungkin kita akan beradu tanding dalam keadaan yang sama sekali baru..."
      Speaker = "Hecate"
      Event = "HecateBossGrantsShrineUpgrade01"
    }
    {
      Id = "MelinoeField_3474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rahasia Ikrar Rival..."
      Speaker = "Melinoe"
      Event = "HecateBossGrantsShrineUpgrade01"
    }
    {
      Id = "Hecate_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertarungan yang hebat, Melinoë. Lanjutkan, dan semoga cahaya rembulan memandu langkahmu."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro01"
    }
    {
      Id = "Hecate_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga semua musuhmu di depan sana tumbang di hadapanmu semudah ini."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro02"
    }
    {
      Id = "Hecate_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertarungan yang hebat. Tapi aku tak bisa membalut luka-lukamu, begitu pula musuh-musuhmu nanti."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro03"
    }
    {
      Id = "Hecate_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau akan terus bertumbuh, selagi aku terus mengujimu seperti ini."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro04"
    }
    {
      Id = "Hecate_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Unjuk kekuatan yang mengesankan. Jangan menahan diri sedikit pun saat melangkah maju."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro05"
    }
    {
      Id = "Hecate_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lulus ujian ini sekali lagi, meski seberapa jauh kau sanggup melangkah, mari kita lihat nanti."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro06"
    }
    {
      Id = "Hecate_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau layak menerima hasil jarahan ini; semoga ini memperkuat sihirmu."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro07"
    }
    {
      Id = "Hecate_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sampai jumpa di Persimpangan sebentar lagi. Aku butuh mengatur napas di sana..."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro08"
    }
    {
      Id = "Hecate_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh! {#Prev}Kurasa tak ada gunanya menahan satu sama lain di sini lebih lama lagi..."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro09"
    }
    {
      Id = "Hecate_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergilah, Melinoë. Guru terbaik ada di {#Emph}luar sana."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro10"
    }
    {
      Id = "HecateField_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat saat kupikir kau sudah kalah, kau langsung membalikkan keadaan! Pertarungan yang hebat!"
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro11"
    }
    {
      Id = "HecateField_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memanfaatkan sisa-sisa saat terakhirmu dengan sangat baik. Semoga berhasil di bawah sana."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro12"
    }
    {
      Id = "HecateField_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mahir menggunakan Descura, dan aku tahu ikatan di antara kalian begitu kuat. Sekarang, selamat jalan."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro13"
    }
    {
      Id = "HecateField_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemampuanmu yang kian terasah dengan Lim dan Oros membuatmu jadi sosok yang patut ditakuti. Bagus."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro14"
    }
    {
      Id = "HecateField_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan kembali ke bayang-bayang. Percayalah, malammu baru saja dimulai."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro15"
    }
    {
      Id = "HecateField_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita harus mengulanginya lagi di malam yang lain."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro16"
    }
    {
      Id = "HecateField_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah bertambah kuat, meski kita punya keabadian untuk terus mengasah kemampuan kita."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro17"
    }
    {
      Id = "HecateField_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga kau menunjukkan murka yang lebih dahsyat lagi pada musuh-musuh yang menantimu di bawah sana."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro18"
    }
    {
      Id = "HecateField_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertarungan yang bagus, dan semoga para Fates berbaik hati padamu dalam perjalananmu ke bawah."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro19"
    }
    {
      Id = "HecateField_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah cukup menghambatmu malam ini. Pergilah, manfaatkan percobaan ini sebaik-baiknya."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro20"
    }
    {
      Id = "HecateField_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kobaran Api Ygnium menyala terang untukmu... namun penguasaan mutlak adalah pencarian abadi."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro21"
    }
    {
      Id = "HecateField_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengayunkan Zorephet seolah bobotnya yang besar bukanlah beban, melainkan sebuah kekuatan..."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro22"
    }
    {
      Id = "HecateField_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tengkorak Revaal bukanlah pusaka yang mudah dikendalikan... tapi kulihat kalian berdua sudah mulai saling memahami."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro23"
    }
    {
      Id = "HecateField_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lain kali biarkan aku mendaratkan satu atau dua serangan demi harga diriku, Melinoë?"
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro24"
    }
    {
      Id = "HecateField_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama licinnya seperti Arwah. Rasanya seranganku tak mengenaimu sekali pun."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro25"
    }
    {
      Id = "HecateField_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luar biasa, kau berhasil menghindari setiap serangan; baik seranganku maupun serangan para Saudariku."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro26"
    }
    {
      Id = "HecateField_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tiba tanpa secuil pun luka atau goresan, dan pergi begitu saja. Kekuatan dan kelincahan yang sanggup menghentikan Sang Waktu."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro27"
    }
    {
      Id = "HecateField_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau nyaris tak memberiku celah sedikit pun. Jangan perlihatkan belas kasihan seperti itu pula pada musuh-musuh kita."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro28"
    }
    {
      Id = "HecateField_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dibereskan dengan cepat dan tuntas seolah-olah aku sama sekali bukan ancaman bagimu."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro29"
    }
    {
      Id = "HecateField_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat kau sedang tidak ingin diperlambat sama sekali! Pertahankan keganasan itu."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro30"
    }
    {
      Id = "HecateField_0364"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, lanjutkan! Jelas sekali kau sedang terburu-buru, melihat betapa cepatnya kau mengatasi ancaman yang kuberikan!"
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro31"
    }
    {
      Id = "HecateField_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hermes pasti akan sangat kagum melihat betapa cepat dan tuntasnya kau menyelesaikan urusan di sini."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro32"
    }
    {
      Id = "HecateField_0366"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketahuilah bahwa aku takkan sudi menghadapi amukan Xinth demi sembarang orang, Melinoë..."
      Speaker = "Hecate"
      Event = "HecateBossMiscOutro33"
    }
    {
      Id = "Chronos_0972"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, halo, Cucu Perempuan."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "MelinoeField_3872"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0457"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampaknya kau penasaran."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang ingin kau tanyakan."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0460"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang perlu dibicarakan?"
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0459"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang mengganjal pikiranmu?"
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0461"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tampak cemas."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0417"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenangkan dirimu..."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0420"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana perkembangan tugasmu?"
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "HecateField_0423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertanyaan...?"
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "MelinoeField_4305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kepala— Hecate."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "MelinoeField_4303"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hecate..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "MelinoeField_4306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "MelinoeField_4304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hecate."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "MelinoeField_5559"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salah satu mimpi di mana aku harus ikut ujian lagi, ya?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "MelinoeField_5560"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo, Kepala Sekolah khayalan!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "Hecate_0487"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu dia."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.HecateBossGreetingLines"
    }
    {
      Id = "Hecate_0066"
      InheritFrom = "BaseSubtitle"
