    }
    {
      Id = "Icarus_0534"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Augh..."
      Speaker = "Icarus"
      Event = "NPC_Icarus_01.KillStolenVoiceLines"
    }
    {
      Id = "Icarus_0535"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurang pas..."
      Speaker = "Icarus"
      Event = "NPC_Icarus_01.KillStolenVoiceLines"
    }
    {
      Id = "Icarus_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar-benar kau rupanya. Sebelum kau bicara apa-apa, aku tahu aku tak seharusnya ada di sini, tapi aku melihat kapal ini dan tak tahan untuk melihatnya dari dekat. Dan sekarang aku mau cabut! Jadi anggap saja ini tak pernah terjadi, ya?"
      Speaker = "Icarus"
      Event = "IcarusFirstMeeting"
    }
    {
      Id = "MelinoeField_1930"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahan di situ, Icarus! Aku tak akan membiarkanmu kabur terbang begitu saja tanpa mengobrol denganku. Pertama-tama, apa yang kau lakukan di tengah-tengah perang terkutuk ini?"
      Speaker = "Melinoe"
      Event = "IcarusFirstMeeting"
    }
    {
      Id = "Icarus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hal yang sama seperti yang {#Emph}selama ini {#Prev}kulakukan: memperlambat bajingan-bajingan ini. Kalau semua orang sepertiku mau turun tangan sedikit saja, perang ini pasti sudah lama selesai."
      Speaker = "Icarus"
      Event = "IcarusFirstMeeting"
    }
    {
      Id = "MelinoeField_1931"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa jadi begitu. Tapi ini urusan antara dewa dan Titan. Aku tak ingin kau sampai celaka."
      Speaker = "Melinoe"
      Event = "IcarusFirstMeeting"
    }
    {
      Id = "Icarus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Agak terlambat untuk itu, Meli! Lagipula, aku sudah menahanmu terlalu lama, tapi biar kuberikan sesuatu yang sedang kubuat sebelum aku pergi—dan ini semua berfungsi. Sumpah!"
      Speaker = "Icarus"
      Event = "IcarusFirstMeeting"
    }
    {
      Id = "Icarus_0025_D"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lenganmu...! Tak pernah membaik, ya? Aku benar-benar minta maaf, aku tak seharusnya membebanimu waktu itu."
      Speaker = "Icarus"
      Event = "IcarusAboutMelinoe01"
    }
    {
      Id = "MelinoeField_2010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan salahmu. Aku... dulu terlalu percaya diri dengan kemampuanku. Kepala Sekolah selalu bilang tak ada cara untuk mengembalikan keutuhan Arwah, tapi kupikir aku bisa. Terlalu memaksakan diri, dan mendapat pelajaran yang tak akan pernah kulupakan."
      Speaker = "Melinoe"
      Event = "IcarusAboutMelinoe01"
    }
    {
      Id = "Icarus_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasa sangat bersalah... sampai tak sanggup lagi menatap siapa pun di Persimpangan. Kupikir aku tak akan pernah melihatmu lagi. Dan itu mungkin yang terbaik. Aku... punya banyak hal yang harus kuselesaikan sendiri."
      Speaker = "Icarus"
      Event = "IcarusAboutMelinoe01"
    }
    {
      Id = "MelinoeField_2011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan bagaimana hasilnya? Setidaknya kau belajar terbang! Ketakutan terbesarmu, akhirnya berhasil kau taklukkan. Menggunakan sayap ayahmu pula!"
      Speaker = "Melinoe"
      Event = "IcarusAboutMelinoe01"
    }
    {
      Id = "Icarus_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayap ini milikku, Meli. Itu semua adalah bagian dari prosesnya. Harus belajar melakukan segalanya sendiri, sepertimu. Dan sejujurnya, menurutku lenganmu terlihat luar biasa. Nah, ini ambillah."
      Speaker = "Icarus"
      Event = "IcarusAboutMelinoe01"
    }
    {
      Id = "Icarus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah cukup lama aku terbang sekarang! Awalnya, itu mengingatkanku pada teror yang kurasakan saat masih bocah. Saat-saat terakhir itu... entah kenapa, aku ingin mengalaminya lagi, berulang-ulang kali. Tak tahu kenapa."
      Speaker = "Icarus"
      Event = "IcarusAboutFlying01"
    }
    {
      Id = "Melinoe_5790"
      InheritFrom = "BaseNarrative"
      DisplayName = "Icarus, kau masih muda waktu itu dan kau berbuat salah. Untuk apa menyiksa dirimu sendiri selamanya karenanya? Kupikir kau belajar terbang demi membuktikan diri pada ayahmu."
      Speaker = "Melinoe"
      Event = "IcarusAboutFlying01"
    }
    {
      Id = "Icarus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Meli. Aku tak akan pernah bisa membuktikan apa pun padanya. Tapi ada sesuatu yang terjadi saat aku terus mencoba sayapku... a, aku mulai menyukainya! Melihat segalanya dari sudut pandang yang berbeda."
      Speaker = "Icarus"
      Event = "IcarusAboutFlying01"
    }
    {
      Id = "Melinoe_5791"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlihat begitu bebas di atas sana! Dulu aku selalu percaya, jika aku bisa membuatmu utuh kembali, mungkin suatu malam kita bisa belajar terbang bersama. Aku masih ingin tahu rasanya seperti apa."
      Speaker = "Melinoe"
      Event = "IcarusAboutFlying01"
    }
    {
      Id = "Icarus_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak tahu betapa aku juga menginginkan hal itu. Tapi, itu adalah sesuatu yang harus kulakukan sendiri. Aku ingin mengajakmu terbang sekarang, tapi... ya, Arwah dan dewi tak bisa bersatu."
      Speaker = "Icarus"
      Event = "IcarusAboutFlying01"
    }
    {
      Id = "Melinoe_5791_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlihat begitu bebas di atas sana! Dulu aku selalu percaya, jika aku bisa membuatmu utuh kembali, mungkin suatu malam kita bisa terbang bersama..."
      Speaker = "Melinoe"
      Event = "IcarusAboutFlying01_B"
    }
    {
      Id = "MelinoeField_2015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, kau sudah banyak berubah. Kau tampak... jauh lebih hidup. Sesekali kulihat wajahmu saat sedang terbang, dan... ada binar kebahagiaan yang belum pernah kulihat sebelumnya darimu."
      Speaker = "Melinoe"
      Event = "IcarusAboutFlying02"
    }
    {
      Id = "Icarus_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh{#Prev}, yah... terbang itu memang luar biasa, harus kuakui sensasinya tak pernah membosankan... lalu ada dirimu, yang menghadapi legiun Chronos seorang diri. Mengeluarkan semua hasil latihanmu. {#Emph}Keren sekali..."
      Speaker = "Icarus"
      Event = "IcarusAboutFlying02"
    }
    {
      Id = "MelinoeField_2016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak menghadapinya sendirian, Icarus, tapi... senang mendengar soal rasanya terbang! Pasti sangat menggetarkan jiwa."
      Speaker = "Melinoe"
      Event = "IcarusAboutFlying02"
    }
    {
      Id = "Icarus_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang, Meli. Dari dulu kau selalu bisa membaca pikiranku, jadi percuma saja menutup-nutupinya. Kuharap suatu malam nanti kau bisa mencobanya sendiri dan memberi tahu bagaimana rasanya."
      Speaker = "Icarus"
      Event = "IcarusAboutFlying02"
    }
    {
      Id = "Icarus_0033_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang, Meli. Dari dulu kau selalu bisa membaca pikiranku, jadi percuma saja menutup-nutupinya."
      Speaker = "Icarus"
      Event = "IcarusAboutFlying02_B"
    }
    {
      Id = "MelinoeField_2150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau begitu menyukai terbang, mengapa kau terus membantuku? Begitu singgasana ayahku dipulihkan, gerbang Dunia Bawah akan ditutup kembali, dan kau akan dipaksa pulang."
      Speaker = "Melinoe"
      Event = "IcarusAboutFlying03"
    }
    {
      Id = "Icarus_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu. Pasti aku akan merindukan terbang. Tapi, kurasa aku bisa tetap hidup tanpanya jika terpaksa — maksudku {#Emph}eksis {#Prev}tanpanya, kau paham kan. Rencanaku saat ini cuma menikmati segalanya sebaik mungkin selagi bisa. Bagaimanapun, kami bangsa fana dididik untuk percaya bahwa tak ada yang abadi."
      Speaker = "Icarus"
      Event = "IcarusAboutFlying03"
    }
    {
      Id = "Icarus_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa Palu kecil dariku, ya? Itu yang pertama kali kubuat, lho! Setidaknya yang pertama yang hasilnya lumayan. Prosesnya agak lucu, membuat alat untuk membuat barang..."
      Speaker = "Icarus"
      Event = "IcarusAboutKeepsake01"
    }
    {
      Id = "MelinoeField_2158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Icarus, bagaimana bisa kau memberikan ini padaku? Seharusnya kau menyimpannya, sebagai pengingat seberapa jauh kau berkembang sebagai pencipta. Kukira ini salah satu karya mahakarya ayahmu...!"
      Speaker = "Melinoe"
      Event = "IcarusAboutKeepsake01"
    }
    {
      Id = "Icarus_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benda itu jauh lebih berharga jika berada di tanganmu daripada di tanganku. Menciptakan perkakas yang bisa dipakai orang lain untuk meraih puncak kejayaan baru... itulah caraku meraih puncakku sendiri. Kau sangat membantuku di sini, Meli!"
      Speaker = "Icarus"
      Event = "IcarusAboutKeepsake01"
    }
    {
      Id = "Icarus_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Palu tuaku itu benar-benar berguna, ya? Kukira kau bakal menyimpannya di suatu tempat sampai berdebu. Benda itu berhak istirahat setelah semua kerja keras yang kutimpakan padanya!"
      Speaker = "Icarus"
      Event = "IcarusAboutKeepsake02"
    }
    {
      Id = "MelinoeField_4033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, kau {#Emph}tidak {#Prev}ingin aku menggunakannya seperti ini? Kalau niatmu agar benda ini mengumpulkan debu dari sekitar, kurasa permukaan berlapis bulu akan membuatnya jauh lebih efektif."
      Speaker = "Melinoe"
      Event = "IcarusAboutKeepsake02"
    }
    {
      Id = "Icarus_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, bukan begitu! Caramu menggunakannya sudah hebat kok. Kelihatannya mantra di dalamnya malah semakin kuat dari sebelumnya! Aku cuma senang benda itu bisa sedikit berguna."
      Speaker = "Icarus"
      Event = "IcarusAboutKeepsake02"
    }
    {
      Id = "MelinoeField_2014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sendiri yang bilang kau tak seharusnya berada di sini, Icarus. Chronos mungkin membuka paksa gerbang Dunia Bawah, tapi tempatmu tetap di bawah bersama kami. Kembalilah."
      Speaker = "Melinoe"
      Event = "IcarusAboutReturning01"
    }
    {
      Id = "Icarus_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku selalu mengacaukan segalanya, kau tahu itu. Sekali ini saja, aku cuma ingin berguna bagi seseorang! Jadi kumohon... biarkan aku tetap di sini. Biarkan aku menikmati ini!"
      Speaker = "Icarus"
      Event = "IcarusAboutReturning01"
    }
    {
      Id = "Icarus_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para bajingan di kapal-kapal ini memang sudah hilang akal, tapi hantaman mereka keras sekali. A-aku tahu kau hebat dan segalanya, bahkan {#Emph}jauh lebih {#Prev}dari hebat, hanya saja... jika terjadi hal buruk... apa yang akan terjadi padamu nanti?"
      Speaker = "Icarus"
      Event = "IcarusAboutReturning02"
    }
    {
      Id = "MelinoeField_2156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hal pertama yang diajarkan Kepala Sekolah padaku adalah pantang menyerah. Jika kekuatanku mulai habis, aku menggunakannya untuk kembali ke bayang-bayang asalku. Sekarang itu sudah hampir jadi refleks."
      Speaker = "Melinoe"
      Event = "IcarusAboutReturning02"
    }
    {
      Id = "Icarus_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu di Persimpangan Jalan, kau sudah segar bugar di malam berikutnya, bersemangat untuk berangkat lagi? Sayang sekali kau tak bisa kembali-ke-bayang-bayang langsung ke tempat terakhirmu jatuh..."
      Speaker = "Icarus"
      Event = "IcarusAboutReturning02"
    }
    {
      Id = "Icarus_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, apa sebenarnya yang kau {#Emph}lakukan {#Prev}di sini? Kupikir kau terikat pada Dunia Bawah, tapi di sinilah kau, membajak kapal perang dan sebagainya!"
      Speaker = "Icarus"
      Event = "IcarusAboutSurfaceCurse01"
    }
    {
      Id = "MelinoeField_2152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang masih terikat di sana, aku hanya sedikit melonggarkan ikatannya. Walau sekarang tubuhku terasa luar biasa menderita, jadi jika legiun Chronos tak segera menghentikanku, kutukan darahku pasti yang akan melakukannya."
      Speaker = "Melinoe"
      Event = "IcarusAboutSurfaceCurse01"
    }
    {
      Id = "Icarus_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Soalnya kau kelihatan menawan! {#Emph}Ehm{#Prev}, maksudku... kau kelihatan {#Emph}baik-baik saja{#Prev}. Sama sekali tak terpengaruh kutukan apa pun. Mungkin cuma sedikit mabuk laut saja! Ambil... ambil ini saja, ya?"
      Speaker = "Icarus"
      Event = "IcarusAboutSurfaceCurse01"
    }
    {
      Id = "Icarus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah beberapa malam sejak terakhir kali kita bertatap muka seperti ini ya, Meli? Tapi aku yakin kau pasti akan segera muncul... kecuali kalau Chronos akhirnya berhasil menangkapmu atau sesuatu yang mengerikan semacam itu?"
      Speaker = "Icarus"
      Event = "IcarusAboutTimePassing01"
    }
    {
      Id = "MelinoeField_3100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau benar-benar mengkhawatirkanku, terima kasih, Icarus... tapi sebaiknya jangan lakukan itu. Rasa cemas tak ada gunanya bagi kita; jika pikiranmu teralihkan, kau tak akan bisa melawan legiun sang Titan dengan segenap kemampuanmu."
      Speaker = "Melinoe"
      Event = "IcarusAboutTimePassing01"
    }
    {
      Id = "Icarus_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tidak apa-apa, pikiranku memang selalu teralihkan ke mana-mana kok! Kecuali saat aku sedang bekerja, atau di angkasa. Dan secara kebetulan, dua hal itulah yang membuatku sibuk belakangan ini!"
      Speaker = "Icarus"
      Event = "IcarusAboutTimePassing01"
    }
    {
      Id = "MelinoeField_2147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, bagaimana kabar ayahmu? Kau tak tahu betapa senangnya aku menemukan Palu Daedalus di luar sana... Aku tak pernah melihatnya di sekitar sini, jadi tak pernah bisa berterima kasih langsung padanya."
      Speaker = "Melinoe"
      Event = "IcarusAboutDaedalus01"
    }
    {
      Id = "Icarus_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh! {#Prev}Pasti akan kusampaikan salammu kalau nanti kebetulan aku bertemu dengannya lagi, meski sudah lumayan lama tak bersua. Aku senang Palu-palunya bisa berguna bagimu. Mau satu lagi?"
      Speaker = "Icarus"
      Event = "IcarusAboutDaedalus01"
    }
    {
      Id = "Icarus_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemarin malam kau bertanya tentang ayahku... dan sebenarnya, meski mungkin kau sudah tahu, aku juga tak pernah melihatnya lagi. Kurasa dia mungkin sudah pensiun!"
      Speaker = "Icarus"
      Event = "IcarusAboutDaedalus02"
    }
    {
      Id = "MelinoeField_2148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Daedalus, {#Emph}pensiun? {#Prev}Tadi aku baru saja menemukan salah satu Palunya! Dia selalu membantuku sejak semua ini bermula, dia... tunggu... {#Emph}apa...?"
      Speaker = "Melinoe"
      Event = "IcarusAboutDaedalus02"
    }
    {
      Id = "Icarus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meli, aku ini muridnya! Dia sudah menempa sekian lama dan butuh istirahat. Kemampuanku masih jauh di bawahnya, tapi kan memang tak ada orang lain lagi.... Bagaimanapun Palu-palu itu berguna, kan?"
      Speaker = "Icarus"
      Event = "IcarusAboutDaedalus02"
    }
    {
      Id = "MelinoeField_2149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hentikan, kepalaku pusing jadinya. Jadi {#Emph}Palu Daedalus {#Prev}yang kutemukan selama ini berasal dari {#Emph}dirimu? {#Prev}Bukankah seharusnya namanya jadi Palu {#Emph}Icarus{#Prev}?"
      Speaker = "Melinoe"
      Event = "IcarusAboutDaedalus02"
    }
    {
      Id = "Icarus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehm{#Prev}, kami punya reputasi nama yang harus dijaga. Menempelkan namaku pada rancangan ayahku rasanya bukan langkah yang bijak. Kumohon... jangan ceritakan hal ini pada siapa pun, ya?"
      Speaker = "Icarus"
      Event = "IcarusAboutDaedalus02"
    }
    {
      Id = "MelinoeField_2154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membuat sayapmu sendiri, amunisi, dan rupanya Palu Daedalus terbaru itu... kau sudah jadi pengrajin yang hebat!"
      Speaker = "Melinoe"
      Event = "IcarusAboutDaedalus03"
    }
    {
      Id = "Icarus_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Meli. Ayahku sudah menjadi seorang maestro saat seusia diriku, bahkan sebelum aku mati. Aku tak akan pernah bisa melampauinya."
      Speaker = "Icarus"
      Event = "IcarusAboutDaedalus03"
    }
    {
      Id = "MelinoeField_2155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan itu maksudku. Karyamu adalah milikmu sendiri, dan hasilnya bagus! Lebih dari sekadar bagus. Kapan kau akhirnya berani keluar dari bayang-bayang ayahmu?"
      Speaker = "Melinoe"
      Event = "IcarusAboutDaedalus03"
    }
    {
      Id = "Icarus_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertanyaan lucu jika datang darimu! Ayahku mungkin bukan dewa... tapi dia mungkin seniman dan penemu terhebat yang pernah hidup. Dia pasti jadi orang pertama yang bilang bahwa aku tak akan pernah mencapai tingkatannya. Lagipula, aku sudah muak berusaha membuktikan diriku di hadapannya."
      Speaker = "Icarus"
      Event = "IcarusAboutDaedalus03"
    }
    {
      Id = "MelinoeField_3098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau tahu begitu banyak tentang semua Senjata Nokturnal, sampai bisa merancang begitu banyak peningkatan Palu khusus yang sengaja kau tinggalkan untukku? Senjata Malam adalah rahasia yang dijaga sangat ketat dan nyaris mustahil disempurnakan lagi."
      Speaker = "Melinoe"
      Event = "IcarusAboutDaedalus04"
    }
    {
      Id = "Icarus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahku bekerja untuk ayahmu, ingat? Dia yang merancang ruangan-ruangan saling terhubung di Bawah Tanah dan semacamnya? Dia pasti sudah sangat dipercaya... dan tahu banyak sekali rahasia."
      Speaker = "Icarus"
      Event = "IcarusAboutDaedalus04"
    }
    {
      Id = "MelinoeField_3099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan lalu dia membagikan rahasia-rahasia itu kepada muridnya yang konon tidak akan pernah bisa memenuhi ekspektasinya yang setinggi langit?"
      Speaker = "Melinoe"
      Event = "IcarusAboutDaedalus04"
    }
    {
      Id = "Icarus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau menyindir bahwa aku juga berhasil mendapatkan kepercayaan ayahku... tenang saja! Soal Senjata Nokturnal, aku {#Emph}mungkin {#Prev}cuma mengintip catatan dan cetak birunya sedikit..."
      Speaker = "Icarus"
      Event = "IcarusAboutDaedalus04"
    }
    {
      Id = "MelinoeField_4042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru bertemu ayahku belakangan ini di tengah semua kekacauan ini... Kupikir Kepala Sekolah sudah cukup tegas, tapi beliau juga sama saja. Tak mengejutkan mengingat kisah-kisahnya, tapi tetap saja. Mungkin ayahmu terinspirasi dari beliau."
      Speaker = "Melinoe"
      Event = "IcarusAboutDaedalus05"
    }
    {
      Id = "Icarus_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hampir iri padamu, karena belum terlalu lama mengenal ayahmu. Dulu aku pernah bekerja memakai salah satu Palu milik ayahku, lalu merusaknya bak orang tolol, dan menyebutnya eksperimen gagal. {#Emph}Bukan, kaulah eksperimen yang gagal{#Prev}, katanya. Dia selalu mengatakannya dengan begitu tenang."
      Speaker = "Icarus"
      Event = "IcarusAboutDaedalus05"
    }
    {
      Id = "MelinoeField_4043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Icarus, itu kejam sekali. Dan dia jelas tak bersungguh-sungguh. Kau ini muridnya! Karyamu menyandang nama Daedalus."
      Speaker = "Melinoe"
      Event = "IcarusAboutDaedalus05"
    }
    {
      Id = "Icarus_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir ayahku menyayangiku, dengan caranya sendiri, dia hanya lebih pandai menciptakan sesuatu ketimbang merangkai kata. Aku yakin ayahmu berbeda. {#Emph}Dewa orang mati! {#Prev}Pasti berwibawa dan keras kepala, ya?"
      Speaker = "Icarus"
      Event = "IcarusAboutDaedalus05"
    }
    {
      Id = "Icarus_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar orang-orang di Crossroads akhir-akhir ini? Tuan Odysseus akhirnya mulai melancarkan semua rencananya?"
      Speaker = "Icarus"
      Event = "IcarusAboutOdysseus01"
    }
    {
      Id = "MelinoeField_2157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu saja. Jalur yang kulalui ini bisa terbuka berkat beliau. Omong-omong, bukan dia kan yang menyuruhmu melakukan ini? Mengerahkan Arwah bersayap darurat dan peledak terdengar sangat seperti gaya sang Ahli Taktik Ulung..."
      Speaker = "Melinoe"
      Event = "IcarusAboutOdysseus01"
    }
    {
      Id = "Icarus_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bertindak atas kemauanku sendiri. Meski mungkin kita semua sebenarnya bagian dari rencana sang Ahli Taktik Ulung tanpa kita sadari. Beliau selalu bilang kita harus berimprovisasi... mungkin aku baru benar-benar meresapinya sekarang."
      Speaker = "Icarus"
      Event = "IcarusAboutOdysseus01"
    }
    {
      Id = "MelinoeField_3634"
      InheritFrom = "BaseNarrative"
      DisplayName = "Icarus, aku ingin kau pulang. Ke Crossroads. Kalau kau ingin membantu perjuangan kita, kau bisa melakukannya lebih baik jika terus terhubung dengan Odysseus dan para Arwah lainnya."
      Speaker = "Melinoe"
      Event = "IcarusAboutCrossroads01"
    }
    {
      Id = "Icarus_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah semua orang merasa begitu atau tidak, Meli. Aku sudah terbiasa mengurus diriku sendiri di sini, dan aku tidak pandai berada di tengah keramaian. Mungkin karena seumur hidupku tinggal di menara penjara."
      Speaker = "Icarus"
      Event = "IcarusAboutCrossroads01"
    }
    {
      Id = "MelinoeField_3635"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kita jadi bisa lebih sering bertemu? Dan di sana sebenarnya tidak seramai itu, kok. Pikirkan saja dulu kemungkinannya..."
      Speaker = "Melinoe"
      Event = "IcarusAboutCrossroads01"
    }
    {
      Id = "Icarus_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, baiklah, akan kupikirkan. Benar-benar kupikirkan. Tapi kalau aku ke sana lalu sang Penyihir Crossroads mengubahku jadi Arwah kadal air atau semacamnya, itu jadi beban di nuranimu, ya."
      Speaker = "Icarus"
      Event = "IcarusAboutCrossroads01"
    }
    {
      Id = "MelinoeField_3636"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang sekali melihatmu memutuskan untuk kembali! Bagaimana rasanya di Crossroads setelah sekian lama?"
      Speaker = "Melinoe"
      Event = "IcarusAboutCrossroads02"
    }
    {
      Id = "Icarus_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Awalnya agak canggung, tapi kemudian kau datang. Dan menyenangkan sekali bisa bertemu Tuan Odysseus lagi, beliau memberiku beberapa ide jalur penerbangan. Aku tidak tinggal terlalu lama, kan...?"
      Speaker = "Icarus"
      Event = "IcarusAboutCrossroads02"
    }
    {
      Id = "MelinoeField_3637"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama sekali tidak! Yah, kalau kau menyukainya di sana, kuharap kau mau kembali lagi. Dan mungkin mulai menganggapnya sebagai tempat tinggal, bukan sekadar tempat singgah."
      Speaker = "Melinoe"
      Event = "IcarusAboutCrossroads02"
    }
    {
      Id = "Icarus_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namanya saja Crossroads si Persimpangan, Meli, aku tak pernah mengira tempat itu bisa ditinggali! Hei... terima kasih ya sudah mendorongku."
      Speaker = "Icarus"
      Event = "IcarusAboutCrossroads02"
    }
    {
      Id = "Icarus_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, kau... {#Emph}ehm, uh... {#Prev}tumbuh! Sedikit... Maksudku... aku tidak sedang berhalusinasi, kan? Soalnya biasanya aku tak perlu menengadahkan leher setinggi ini untuk melihatmu."
      Speaker = "Icarus"
      Event = "IcarusAboutCirce01"
    }
    {
      Id = "MelinoeField_3095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya sedikit sihir, berkat Circe sang Penyihir Wanita. Peningkatan kekuatan sementara, meski tampaknya menimbulkan efek samping yang cukup mencolok..."
      Speaker = "Melinoe"
      Event = "IcarusAboutCirce01"
    }
    {
      Id = "Icarus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan hal buruk, kok, aku cuma kaget dan langsung menyadarinya...! Dan sekarang aku malah menatapmu... oke, sekarang aku berhenti. Ini untukmu."
      Speaker = "Icarus"
      Event = "IcarusAboutCirce01"
    }
    {
      Id = "Icarus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang terjadi padamu, Meli, kau jadi sangat {#Emph}kecil! {#Prev}Bukannya biasanya kau {#Emph}besar{#Prev}, maksudku, maksudku... kau selalu pas, tapi biasanya kau... lupakan saja ucapanku tadi?"
      Speaker = "Icarus"
      Event = "IcarusAboutCirce02"
    }
    {
      Id = "MelinoeField_3096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak apa, Icarus. Kau pasti menyadari efek sihir Circe sang Penyihir Wanita, yang memberiku salah satu berkah pelindungnya malam ini. Apa efeknya benar-benar semencolok itu?"
      Speaker = "Melinoe"
      Event = "IcarusAboutCirce02"
    }
    {
      Id = "Icarus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tidak! {#Prev}Tidak, sama sekali tidak! {#Emph}Ehm{#Prev}, aku cuma... biasanya peka terhadap hal-hal kecil, maksudku aku menyadari detail — dalam semua ukuran! Bagaimanapun, aku menyukainya. Bukan berarti itu penting, sih. Ini! Biar kau bisa segera lanjut jalan."
      Speaker = "Icarus"
      Event = "IcarusAboutCirce02"
    }
    {
      Id = "Icarus_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam sebelumnya, aku melihat sayap hitam raksasa di cakrawala; sudah pasti {#Emph}bukan {#Prev}Harpy. Berani sumpah itu Eris sialan... tapi, bukankah dia masih di Crossroads, bersamamu?"
      Speaker = "Icarus"
      Event = "IcarusAboutEris01"
    }
    {
      Id = "MelinoeField_2153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku juga sedang tidak di Crossroads, tapi... sayangnya sang Penjelmaan Perselisihan itu memang terus menghalangiku. Jadi dia muncul sekitar waktu yang sama denganku?"
      Speaker = "Melinoe"
      Event = "IcarusAboutEris01"
    }
    {
      Id = "Icarus_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau dipikir-pikir, iya juga! {#Emph}Ah! {#Prev}Kupikir dia ke sini gara-gara sesuatu yang {#Emph}kulakukan{#Prev}! Tak pernah terpikir kalau dia cuma membuntuti{#Emph}mu{#Prev}, seperti biasa."
      Speaker = "Icarus"
      Event = "IcarusAboutEris01"
    }
    {
      Id = "MelinoeField_4031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak boleh membiarkan Eris mengatur-ngaturmu begitu. Aku sempat dengar obrolan kalian di Crossroads. Dia itu cuma banyak omong... terutama di {#Emph}sana{#Prev}, tempat Rail of Adamant miliknya tak bisa berfungsi."
      Speaker = "Melinoe"
      Event = "IcarusAboutEris02"
    }
    {
      Id = "Icarus_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gampang kau bicara begitu, kau ini abadi seperti dia. Kami para Arwah tahu diri untuk tidak melawan dewa-dewi yang tak bisa mati."
      Speaker = "Icarus"
      Event = "IcarusAboutEris02"
    }
    {
      Id = "MelinoeField_4032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak menciut di hadapan{#Emph}ku{#Prev}. Kau bukan pengecut, Icarus. Lalu kenapa membiarkan sang Perselisihan merundungmu?"
      Speaker = "Melinoe"
      Event = "IcarusAboutEris02"
    }
    {
      Id = "Icarus_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir saat ini sudah terlalu banyak konflik. Eris sebenarnya tak menggangguku. Aku cuma tak keberatan membiarkan dia mengira begitu. Lagian dia bukan dewi kebijaksanaan juga, kan?"
      Speaker = "Icarus"
      Event = "IcarusAboutEris02"
    }
    {
      Id = "Icarus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru-baru ini aku melihat semburan api raksasa membubung dari puncak Olympus. Kukira seisi gunung sedang meletus! Tapi pas kuperhatikan lebih dekat, ternyata itu kau! Sedang bertarung dengan seseorang. Lalu seekor elang gila mengejarku sampai kabur."
      Speaker = "Icarus"
      Event = "IcarusAboutPrometheus01"
    }
    {
      Id = "MelinoeField_3091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu Prometheus sang Titan dan peliharaannya. Dia berkhianat melawan para dewa, dan memimpin langsung pengepungan Olympus. Mengaku tahu masa depan, dan berjuang demi umat manusia... menggunakan api yang dia curi dari keluargaku."
      Speaker = "Melinoe"
      Event = "IcarusAboutPrometheus01"
    }
    {
      Id = "Icarus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak tahu dia sudah bebas. Lagipula, apa hubungannya manusia dengan semua perseteruan melawan Chronos ini? Kukira yang dia inginkan hanyalah balas dendam! Mungkin Prometheus juga begitu..."
      Speaker = "Icarus"
      Event = "IcarusAboutPrometheus01"
    }
    {
      Id = "Icarus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf aku terlambat! Tadi sempat berpapasan dengan elang di jalan. Mungkin kalau hatiku masih ada, aku bisa memberinya secuil makan dan kami bisa langsung jadi kawan akrab... rupanya cara itu berhasil untuk Prometheus."
      Speaker = "Icarus"
      Event = "IcarusAboutPrometheus02"
    }
    {
      Id = "MelinoeField_3093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dicintai kawanan burung maupun manusia fana. Padahal tampaknya kau sendiri tidak begitu menyukai Prometheus. Mungkin kasih sayangnya kepada manusia fana tidak selalu berbalas."
      Speaker = "Melinoe"
      Event = "IcarusAboutPrometheus02"
    }
    {
      Id = "Icarus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, maksudku... kami belum pernah bertemu! Sewaktu ragaku masih utuh, kami menyembah dewa-dewi, bukan Titan. Dan Prometheus membuat para dewa murka, jadi... begini, kalau kau tidak menyukainya, itu sudah cukup bagiku."
      Speaker = "Icarus"
      Event = "IcarusAboutPrometheus02"
    }
    {
      Id = "Icarus_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa Arwah di Persimpangan belakangan ini terus membicarakan Prometheus. Sebagian dari mereka sepertinya menyukainya, setidaknya lebih daripada Chronos. Pasti orangnya sangat memikat, ya?"
      Speaker = "Icarus"
      Event = "IcarusAboutPrometheus03"
    }
    {
      Id = "MelinoeField_4048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak akan berkata begitu, tetapi dia sangat larut dalam tujuannya. Rela membiarkan dirinya disiksa demi umat manusia fana... dengan kesadaran penuh bahwa sebagian besar manusia tidak akan pernah sadar atau peduli."
      Speaker = "Melinoe"
      Event = "IcarusAboutPrometheus03"
    }
    {
      Id = "Icarus_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya agak mendramatisir bagiku. Kalau dia tahu segalanya, kenapa dia membiarkan dirinya tertangkap? Para dewa mungkin pada akhirnya akan memberi manusia api juga!"
      Speaker = "Icarus"
      Event = "IcarusAboutPrometheus03"
    }
    {
      Id = "Icarus_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berani bersumpah melihat sang pahlawan Herakles tempo malam...! Menerjang dari satu kapal ke kapal lain, meremukkan para pelaut abadi dengan gadanya! Aku terbang menjauh sejauh mungkin dari {#Emph}dia."
      Speaker = "Icarus"
      Event = "IcarusAboutHeracles01"
    }
    {
      Id = "MelinoeField_4035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penglihatanmu mungkin benar. Olympus menugaskannya memukul mundur legiun Titan beserta armadanya. Kami sesekali pernah bekerja sama, tetapi dia selalu menjaga jarak dariku..."
      Speaker = "Melinoe"
      Event = "IcarusAboutHeracles01"
    }
    {
      Id = "Icarus_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pernah bekerja sama dengan {#Emph}Herakles? Wah{#Prev}, andai saja aku bisa bertemu langsung dengannya suatu saat nanti...! Tapi aku bahkan tidak tahu harus bicara apa. {#Emph}Hei! Aku sama seperti orang-orang lain yang menganggapmu hebat!"
      Speaker = "Icarus"
      Event = "IcarusAboutHeracles01"
    }
    {
      Id = "MelinoeField_4036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat berkesempatan menyebut namamu pada Herakles. Sayangnya dia tidak berminat menemui siapa pun kecuali hendak membunuh mereka demi para dewa, tapi... dia sepertinya tahu tentangmu."
      Speaker = "Melinoe"
      Event = "IcarusAboutHeracles02"
    }
    {
      Id = "Icarus_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa? {#Prev}Bagaimana mungkin dia...? {#Emph}Dialah {#Prev}yang tersohor! Kau yakin dia tidak menyebut Daedalus alih-alih aku?"
      Speaker = "Icarus"
      Event = "IcarusAboutHeracles02"
    }
    {
      Id = "MelinoeField_4037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia menyebut Daedalus juga, karena... rupanya dia menyaksikan saat-saat terakhirmu ketika kau terjatuh. Kurasa, dari ucapannya... dia menyelam ke laut untuk mencari jasadmu. Untuk memakamkanmu."
      Speaker = "Melinoe"
      Event = "IcarusAboutHeracles02"
    }
    {
      Id = "Icarus_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk {#Emph}memakamkan{#Prev}ku, tapi aku... selalu bertanya-tanya bagaimana aku bisa sampai di sini, karena ingatanku waktu itu sangat samar. Tapi aku dimakamkan langsung oleh Herakles yang agung! {#Emph}Luar biasa! {#Prev}Katakan padanya a, aku mengucapkan {#Emph}terima kasih{#Prev}, ya?"
      Speaker = "Icarus"
      Event = "IcarusAboutHeracles02"
    }
    {
      Id = "Icarus_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi bagaimana kabar Herakles yang perkasa akhir-akhir ini? Aku agak heran legiun sang Titan bisa melangkah sejauh ini padahal tahu dia ada di luar sana bertarung membela para dewa."
      Speaker = "Icarus"
      Event = "IcarusAboutHeracles03"
    }
    {
      Id = "MelinoeField_4038"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bagaimana kabar Herakles{#Prev}, itu sulit untuk kukatakan. Belum pernah kulihat prajurit segarang itu, tetapi dia juga sangat tertutup. Saat kubilang kau mengucapkan salam terima kasih, dia cuma mendengus; hanya itu."
      Speaker = "Melinoe"
      Event = "IcarusAboutHeracles03"
    }
    {
      Id = "Icarus_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia mendengus... tentang {#Emph}diriku. {#Prev}Dan dia tahu siapa aku! {#Emph}Ah{#Prev}, terima kasih, Meli, itu kabar yang luar biasa! Aku yakin yang dia butuhkan hanyalah sedikit istirahat, ya kan?"
      Speaker = "Icarus"
      Event = "IcarusAboutHeracles03"
    }
    {
      Id = "Icarus_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada badai dahsyat yang sedang bergolak di puncak Olympus. Tidak bisa didekati sama sekali. Apa yang sebenarnya terjadi di atas sana...?"
      Speaker = "Icarus"
      Event = "IcarusAboutTyphon01"
    }
    {
      Id = "MelinoeField_3087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Badai itu menyembunyikan ancaman yang sesungguhnya. Chronos telah membangkitkan Sang Ayah Segala Monster dan melepaskannya. Pasukan yang kita lawan ini... hanyalah taktik mengulur waktu dan pengalih perhatian."
      Speaker = "Melinoe"
      Event = "IcarusAboutTyphon01"
    }
    {
      Id = "Icarus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu itu {#Emph}Typhon {#Prev}sialan? Ya para dewa... sejak kecil aku selalu berdoa kepada kalian semua dari menaraku demi keselamatan dan nasib baik. Sekarang justru kalian sendirilah yang sebaiknya berdoa..."
      Speaker = "Icarus"
      Event = "IcarusAboutTyphon01"
    }
    {
      Id = "MelinoeField_3088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak; kita akan {#Emph}menghancurkan {#Prev}makhluk itu. Aku memang belum tahu semua yang dibutuhkan untuk melakukannya, tapi doa kemungkinan besar tidak akan diperlukan."
      Speaker = "Melinoe"
      Event = "IcarusAboutTyphon01"
    }
    {
      Id = "Icarus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu aku yang akan berdoa untuk berjaga-jaga! Kurasa tidak ada ruginya. Tolong berhati-hatilah, Meli. Dan sebelum kau pergi... bawalah salah satu dari ini."
      Speaker = "Icarus"
      Event = "IcarusAboutTyphon01"
    }
    {
      Id = "Icarus_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar pergi menghadapi Typhon, ya? Aku sempat melihatnya sekilas! Sedekat yang kuberanikan diri untuk terbang ke arah badai raksasa itu. Dia bisa saja meremukkanmu seperti serangga! Walau kurasa serangga tidak bisa menggunakan sihir untuk melarikan diri..."
      Speaker = "Icarus"
      Event = "IcarusAboutTyphon02"
    }
    {
      Id = "MelinoeField_3089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan serangga punya sayap, mirip sepertimu! Namun benar, aku bisa bersaksi atas ukuran dan kekuatan Typhon. Untungnya, gerakanku lebih cepat... dan seluruh dewa-dewi di Olympus mendukungku."
      Speaker = "Melinoe"
      Event = "IcarusAboutTyphon02"
    }
    {
      Id = "Icarus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kekuatan mereka {#Emph}tidak ada apa-apanya {#Prev}dibandingkan dengan penemuanku di sini...! {#Emph}Emm{#Prev}, a, a, aku bahkan tidak seharusnya bergurau... seperti itu. Menurutmu mereka tidak mendengarnya, kan...? Jangan bilang siapa-siapa kalau aku berkata begitu."
      Speaker = "Icarus"
      Event = "IcarusAboutTyphon02"
    }
    {
      Id = "Icarus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tempo malam kurasa aku melihatmu melesat menuju puncak Olympus... tepat ke tengah badai mengerikan itu. Aku bahkan tidak bisa mendekat sama sekali! Seperti apa rasanya di atas sana?"
      Speaker = "Icarus"
      Event = "IcarusAboutTyphon03"
    }
    {
      Id = "MelinoeField_3090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, rasanya mengerikan... Biasanya aku suka hujan, tapi tidak hujan yang seperti itu. Typhon terpikat menuju Benteng Para Dewa, karena itu adalah pertahanan terakhir sebelum Istana Zeus... yang kemungkinan besar merupakan target sejatinya."
      Speaker = "Melinoe"
      Event = "IcarusAboutTyphon03"
    }
    {
      Id = "Icarus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi para dewa terus menjatuhkannya, tetapi dia terus bangkit kembali, mencoba berulang kali demi meraih hal yang sama? Benar-benar {#Emph}adu tekad! {#Prev}Adu cerdik kurasa akan jauh lebih mudah."
      Speaker = "Icarus"
      Event = "IcarusAboutTyphon03"
    }
    {
      Id = "Icarus_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sesuatu telah terjadi sejak terakhir kali kau kemari... kapal-kapal ini, satu demi satu semuanya {#Emph}tenggelam! {#Prev}Belum pernah kulihat perairan ini begitu tenang. {#Emph}Apakah kau...?"
      Speaker = "Icarus"
      Event = "IcarusAboutChronosBossW01"
    }
    {
      Id = "MelinoeField_2151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah aku berhasil mencapai Chronos di Kediaman ayahku dan membunuhnya? Ya. Dan, apakah dia kemudian merekonstruksi wujudnya kembali, hingga mungkin membatalkan seluruh pencapaianku? Juga, ya."
      Speaker = "Melinoe"
      Event = "IcarusAboutChronosBossW01"
    }
    {
      Id = "Icarus_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu tahu kau pasti bisa menundukkannya, Meli. Yah, seperti yang kau lihat, armada bangkitannya telah bangkit sekali lagi! Namun, kedengarannya kau sudah berhasil menemukan salah satu kelemahannya!"
      Speaker = "Icarus"
      Event = "IcarusAboutChronosBossW01"
    }
    {
      Id = "Icarus_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti pernah melihat Charybdis di luar sana, semacam monster-gurita-pusaran-air-raksasa yang mengerikan itu? Aku pernah melihatnya menelan kapal-kapal seperti {#Emph}ini. {#Prev}Aku sama sekali tak berani terbang dekat-dekat!"
      Speaker = "Icarus"
      Event = "IcarusAboutCharybdis01"
    }
    {
      Id = "MelinoeField_4034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak seberuntung itu untuk memiliki pilihan, dan di beberapa malam, aku tak punya pilihan selain menghadapi Charybdis secara berhadap... kemungkinan itu wajahnya? Bantuanmu akan sangat berharga jika kau memutuskan untuk mengambil risiko."
      Speaker = "Melinoe"
      Event = "IcarusAboutCharybdis01"
    }
    {
      Id = "Icarus_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}jelas {#Prev}tidak. Aku memang pernah bilang akan mengikutimu sampai ke matahari, Meli, tapi kalau Charybdis, tidak dulu. Rasa takutku saat terbang itu satu hal, tapi rasa takutku pada gurita adalah hal yang sama sekali berbeda."
      Speaker = "Icarus"
      Event = "IcarusAboutCharybdis01"
    }
    {
      Id = "Icarus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah itu...? {#Emph}Mustahil. {#Prev}Itu benar-benar Frinos bersamamu, kan? Dulu dia cuma duduk diam di sana dengan bahagia! Atau murung, aku tak pernah bisa membedakannya. Dan sekarang dia ikut berada di tengah-tengah semua ini..."
      Speaker = "Icarus"
      Event = "IcarusAboutFrogFamiliar01"
    }
    {
      Id = "MelinoeField_3097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini memang dirinya yang tiada duanya! Aku juga tak pernah menyangka dia punya bakat sehebat ini, sampai Kepala Sekolah membocorkan lebih banyak rahasianya tentang bekerja sama dengan Hewan Ikatan."
      Speaker = "Melinoe"
      Event = "IcarusAboutFrogFamiliar01"
    }
    {
      Id = "Icarus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira Hewan Akrab itu cuma hewan peliharaan biasa! Kau juga di sini, Frinos? Senang melihatmu lagi, kawan. {#Emph}Jaga Meli baik-baik, ya...?"
      Speaker = "Icarus"
      Event = "IcarusAboutFrogFamiliar01"
    }
    {
      Id = "Icarus_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak mau mengenalkanku pada kawan bersayapmu yang di sebelah sana itu? Kelihatannya seperti burung gagak, meski aku belum pernah melihat yang {#Emph}seperti {#Prev}itu sebelumnya..."
      Speaker = "Icarus"
      Event = "IcarusAboutRavenFamiliar01"
    }
    {
      Id = "MelinoeField_4041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, benar juga, maafkan kelancanganku ya, kalian berdua! Icarus, ini Raki, Hewan Akrab-ku. Raki, ini Icarus, temanku! Kalian berdua sama-sama makhluk bersayap."
      Speaker = "Melinoe"
      Event = "IcarusAboutRavenFamiliar01"
    }
    {
      Id = "Icarus_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah! Senang bertemu denganmu, Raki. Ketahuilah kalau aku bakal mempelajari teknik terbangmu, soalnya teknik terbangku masih selalu butuh penyempurnaan."
      Speaker = "Icarus"
      Event = "IcarusAboutRavenFamiliar01"
    }
    {
      Id = "Icarus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat apa yang mereka perbuat padamu, dasar para... {#Emph}akh! {#Prev}Maaf aku tak sampai di sini lebih cepat, Meli.... Apa kau tak pernah berniat putar balik saja? Maksudku, kalau kau sudah terluka {#Emph}separah {#Prev}ini, buat apa lanjut...."
      Speaker = "Icarus"
      Event = "IcarusLowHealth01"
    }
    {
      Id = "MelinoeField_3094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lukaku tak separah yang kau kira, dan aku tahu batasku, Icarus. Tapi aku hargai kepedulianmu."
      Speaker = "Melinoe"
      Event = "IcarusLowHealth01"
    }
    {
      Id = "Icarus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma — rasanya berat melihatmu menyiksa diri seperti ini. Meski lukamu bakal sembuh besok, yang terpenting adalah saat ini. Sudahlah... mungkin aku punya sesuatu yang bisa membantumu bertahan."
      Speaker = "Icarus"
      Event = "IcarusLowHealth01"
    }
    {
      Id = "Icarus_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau harus lihat betapa banyaknya temuanku yang gagal total tanpa hasil sedikit pun. Aku tahu sebagian lebih bagus dari yang lain, tapi yang {#Emph}ini {#Prev}adalah yang terbaik dari yang terbaik. Kupertaruhkan jaminanku."
      Speaker = "Icarus"
      Event = "IcarusAboutHammers01"
    }
    {
      Id = "MelinoeField_4039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa cukup menguntungkan ya, punya seseorang sepertiku yang bersedia mengujinya untukmu. Soalnya mana mungkin tahu sebagus apa sebelum dicoba di pertarungan sungguhan, kan?"
      Speaker = "Melinoe"
      Event = "IcarusAboutHammers01"
    }
    {
      Id = "Icarus_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Mencibir> {#Prev}Kau bukan mengujinya, Meli! Semua Paluku sudah melewati evaluasi yang {#Emph}sangat {#Prev}ketat demi menyandang nama Daedalus. Tapi kalau kau punya catatan perbaikan, beri tahu aku ya."
      Speaker = "Icarus"
      Event = "IcarusAboutHammers01"
    }
    {
      Id = "Icarus_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah mengerjakan sesuatu sekian lama, dan sengaja tak bilang-bilang sampai ini siap, tapi setelah kuuji lagi baru-baru ini, kurasa ini sudah siap digunakan."
      Speaker = "Icarus"
      Event = "IcarusGrantsReward01"
    }
    {
      Id = "MelinoeField_4040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, menarik sekali. Temuan-temuanmu pasti butuh waktu lumayan lama untuk disiapkan dan dibuat. Yang satu ini fungsinya apa?"
      Speaker = "Melinoe"
      Event = "IcarusGrantsReward01"
    }
    {
      Id = "Icarus_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nanti kau bakal lihat sendiri, tapi ini bikin hampir semuanya jadi lebih baik, mirip seperti... yah, dirimu. {#Prev}Tak perlu dicoba kalau kau memang tak mau!"
      Speaker = "Icarus"
      Event = "IcarusGrantsReward01"
    }
    {
      Id = "Icarus_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu Senjata Nokturnal bisa berubah menjadi berbagai macam wujud, tapi melihatnya jadi seperti {#Emph}ini... {#Prev}kau pasti telah melakukan sesuatu hingga mendapatkan restu mereka, kan?"
      Speaker = "Icarus"
      Event = "IcarusAboutHiddenAspects01"
    }
    {
      Id = "MelinoeField_4030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa begitu? Entah itu, atau Senjata-senjata ini cuma ingin aku terus menggunakannya untuk saat ini, dalam satu Aspek atau lainnya. Ngomong-ngomong, bagaimana Palumu masih bisa berfungsi meski wujud Senjata-senjata itu berubah?"
      Speaker = "Melinoe"
      Event = "IcarusAboutHiddenAspects01"
    }
    {
      Id = "Icarus_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupastikan hal itu bisa terjadi, makanya berhasil! Dan melihat Aspek-aspek berbeda digunakan selalu memberiku segudang ide baru."
      Speaker = "Icarus"
      Event = "IcarusAboutHiddenAspects01"
    }
    {
      Id = "Icarus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebetulan sekali bertemu denganmu di atas sini! Dulu aku tak pernah berani terbang mendekati tempat ini, tapi belakangan Harpy dan pertahanan Otomaton mulai berkurang... dan, yah, ada {#Emph}dirimu. {#Prev}Semuanya lancar sejauh ini?"
      Speaker = "Icarus"
      Event = "IcarusAboutOlympus01"
    }
    {
      Id = "MelinoeField_3092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih lancar dari sebelumnya, berkat dirimu. Jadi bagaimana menurutmu? Apa gunung para dewa ini sesuai dengan segala hal yang kaubayangkan?"
      Speaker = "Melinoe"
      Event = "IcarusAboutOlympus01"
    }
    {
      Id = "Icarus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian besar, iya... mengingat manusia fana baik yang hidup maupun tiada tak pernah ditakdirkan melihat Olimpus dalam segala kemegahannya. Lagipula aku lebih memilih melihatmu, Meli. Ini, sesuatu untuk sisa pendakianmu."
      Speaker = "Icarus"
      Event = "IcarusAboutOlympus01"
    }
    {
      Id = "Icarus_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunung ini memang sudah tak sebadai dulu, tapi apa keluargamu {#Emph}benar-benar {#Prev}akan membiarkan semua Satir dan makhluk-makhluk itu terus menodai rumah mereka? Kelihatannya bukan sifat mereka..."
      Speaker = "Icarus"
      Event = "IcarusAboutOlympus02"
    }
    {
      Id = "MelinoeField_4054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka menuntunku menuju Typhon, Icarus... sebagian sisa-sisa dirinya yang tercerai-berai melampaui waktu. Kami bekerja sama dengan Kakek dalam upaya pembersihan ini, kasarnya begitu."
      Speaker = "Melinoe"
      Event = "IcarusAboutOlympus02"
    }
    {
      Id = "Icarus_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kakek{#Prev}, m-maksudmu si sialan {#Emph}Chronos? {#Prev}Dan, maksudmu Typhon masih {#Emph}ada? {#Prev}Bukannya dia sudah lenyap, maksudku, aku sama sekali tak melihat tanda-tanda keberadaannya. Ini pasti salah satu hal yang di luar nalar manusia fana, kan?"
      Speaker = "Icarus"
      Event = "IcarusAboutOlympus02"
    }
    {
      Id = "MelinoeField_4055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun belum sepenuhnya paham... masih banyak hal yang belum kita ketahui tentang waktu dan cara kerjanya, meski perlahan kami mulai mengerti."
      Speaker = "Melinoe"
      Event = "IcarusAboutOlympus02"
    }
    {
      Id = "Icarus_0436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa tak ada yang rumit soal itu. Waktu terasa lambat saat keadaan memburuk, dan berlalu terlalu cepat saat semuanya menyenangkan. Walau aku sendiri masih belajar cara menghadapinya."
      Speaker = "Icarus"
      Event = "IcarusAboutOlympus02"
    }
    {
      Id = "MelinoeField_4044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi apa kau sempat merasakan angin dan laut saat menggunakan Ramuan Ektoplasma itu? Aku tak yakin berapa lama khasiatnya bertahan, dan ingin kau memanfaatkannya sebaik mungkin."
      Speaker = "Melinoe"
      Event = "IcarusAboutBecomingCloser01"
    }
    {
      Id = "Icarus_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu adalah malam terhebat sepanjang keberadaanku, sungguh. Merasakan terpaan angin dan laut menjadi penutup yang sempurna! Awalnya kukira rasa dingin itu membuatku mati rasa, tapi ternyata cuma efek Ramuannya yang memudar."
      Speaker = "Icarus"
      Event = "IcarusAboutBecomingCloser01"
    }
    {
      Id = "MelinoeField_4045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam itu juga sangat istimewa bagiku. Ternyata nenekku, Demeter, pernah bersama seorang manusia fana... lalu melahirkan ibuku, yang kemudian melahirkanku! Jadi aku bukan dewi sejati, dan aku selalu tertarik dengan garis keturunan fanaku."
      Speaker = "Melinoe"
      Event = "IcarusAboutBecomingCloser01"
    }
    {
      Id = "Icarus_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau adalah dewi sejati, Meli. Jika kau punya sedikit darah manusia fana, itu justru lebih baik. Lagipula, malam itu luar biasa... tapi kini setelah usai, setidaknya aku punya kenangannya!"
      Speaker = "Icarus"
      Event = "IcarusAboutBecomingCloser01"
    }
    {
      Id = "MelinoeField_4046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita bisa mengukir kenangan baru lagi lain kali, mungkin. Maksudku kenangan kita berdua. Karena mengingat Ramuan Ektoplasma bekerja sebaik itu... aku mungkin akan mencari cara meraciknya kembali."
      Speaker = "Melinoe"
      Event = "IcarusAboutBecomingCloser01"
    }
    {
      Id = "Icarus_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Terperangah> {#Prev}Wah, andai jantungku masih berdetak, rasanya pasti sudah meledak! Aku rela memberikan apa pun demi bersamamu lagi... tapi tak seperti kemarin, kali ini aku akan sabar menunggu. Sumpah."
      Speaker = "Icarus"
      Event = "IcarusAboutBecomingCloser01"
    }
    {
      Id = "Icarus_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu adalah malam terhebat sepanjang keberadaanku. Rasanya begitu luar biasa bisa merasa hidup bersamamu, dan kemudian merasakan angin serta laut! Awalnya kukira rasa dingin itu membuatku mati rasa, tapi ternyata cuma efek Ramuannya yang memudar."
      Speaker = "Icarus"
      Event = "IcarusAboutBecomingCloser01_B"
    }
    {
      Id = "MelinoeField_4047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Syukurlah. Aku sempat cemas kalau-kalau aku melukaimu lagi. Hubungan kita... mungkin tak sepenuhnya seperti yang kauinginkan. Tapi ini sangat berarti bagiku, dan hanya ini yang bisa kuberikan."
      Speaker = "Melinoe"
      Event = "IcarusAboutBecomingCloser01_B"
    }
    {
      Id = "Icarus_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini sangat berarti bagiku juga. Dan kau telah memberiku lebih dari yang pernah kuimpikan... jadi bagaimana kalau sebilah Palu bagus ini kujadikan tanda terima kasihku, ya?"
      Speaker = "Icarus"
      Event = "IcarusAboutBecomingCloser01_B"
    }
    {
      Id = "Icarus_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari mana saja {#Emph}kau{#Prev}, Meli? Sudah terlalu banyak malam aku tak melihatmu di sini atau di {#Emph}mana pun. {#Prev}Ada yang tak beres, aku tak tahu apa tapi kurasa Chronos sedang merencanakan sesuatu yang baru. Pasukannya bertingkah {#Emph}sangat {#Prev}aneh...!"
      Speaker = "Icarus"
      Event = "IcarusPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasukannya bertingkah aneh karena Chronos {#Emph}telah membatalkan serangannya! {#Prev}Icarus... perang kita sudah usai dan kita menang! Griya Hades telah dipulihkan! Kau takkan percaya andai kuberitahu caranya, tapi ini {#Emph}sungguhan!"
      Speaker = "Melinoe"
      Event = "IcarusPostTrueEnding01"
    }
    {
      Id = "Icarus_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos sudah menyerah, tunggu, {#Emph}apa...? Nggak mungkin! {#Prev}Tapi kita baru saja melawan pasukannya lagi di {#Emph}sini! {#Prev}Kau serius...?"
      Speaker = "Icarus"
      Event = "IcarusPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapan aku pernah bercanda? Sang Titan Waktu telah {#Emph}berubah. {#Prev}Kami akhirnya berhasil menyadarkannya, tepat di saat kelangsungan hidupnya sendiri dipertaruhkan. Sekarang aku menuju Olympus, memastikan keadaan di sana tetap stabil."
      Speaker = "Melinoe"
      Event = "IcarusPostTrueEnding01"
    }
    {
      Id = "Icarus_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma, aku sampai nggak {#Emph}percaya! {#Prev}Yah, maksudku, tentu saja aku percaya. {#Emph}Heh! {#Prev}Kau berhasil mengalahkannya, {#Emph}akhirnya! {#Prev}Kau beneran mengalahkannya, 'kan? Aku, {#Emph}ehm{#Prev}, aku nggak tahu mau bilang apa... mau ambil salah satu ini?"
      Speaker = "Icarus"
      Event = "IcarusPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4050_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapan aku pernah bercanda? Sang Titan Waktu telah {#Emph}berubah. {#Prev}Kami akhirnya berhasil menyadarkannya, tepat di saat kelangsungan hidupnya sendiri dipertaruhkan."
      Speaker = "Melinoe"
      Event = "IcarusPostTrueEnding01_B"
    }
    {
      Id = "Icarus_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, terakhir kali kita bicara di Persimpangan, aku... nggak bermaksud bikin kau kesal, Meli. Cuma... aku nggak sadar kalau kau masih harus terus bertarung seperti ini."
      Speaker = "Icarus"
      Event = "IcarusPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bertanya apa yang akan kulakukan dengan sisa hidupku, dan itu memicu reaksiku. Aku belum pernah berpikir sejauh itu."
      Speaker = "Melinoe"
      Event = "IcarusPostTrueEnding02"
    }
    {
      Id = "Icarus_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, sepertinya kau memang belum butuh jawaban itu kalau kau masih harus terus ke atas sini. Dan mungkin turun kembali ke Dunia Bawah juga."
      Speaker = "Icarus"
      Event = "IcarusPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rutinitas memang memberi semacam ketenangan. Tapi, aku harus menerima kenyataan bahwa mungkin hanya ini takdir hidupku. Hanya ini keahlianku."
      Speaker = "Melinoe"
      Event = "IcarusPostTrueEnding02"
    }
    {
      Id = "Icarus_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sama sekali nggak perlu menerima hal semacam {#Emph}itu{#Prev}, Meli. Ayahku dulu kerjanya cuma kerja terus. Menganggap itu panggilan hidupnya! Tapi kau nggak seperti dia. Sudahlah... sisa masa depan masih bisa menunggu! Mari kita nikmati malam {#Emph}ini {#Prev}dan lihat bagaimana kelanjutannya nanti, ya?"
      Speaker = "Icarus"
      Event = "IcarusPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru ingat ingin memberitahumu, Icarus, aku akhirnya merasakan terbang! Bersama Selene yang agung dan kuda-kuda rembulannya. Aku mengerti betul daya tariknya, padahal aku bahkan tidak memegang kendali keretanya."
      Speaker = "Melinoe"
      Event = "IcarusAboutFlying04"
    }
    {
      Id = "Icarus_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, kau sampai setinggi {#Emph}itu? {#Prev}Itu {#Emph}luar biasa! {#Prev}Sang Rembulan sendiri yang membawamu mengarungi langit. Aku pernah berpikir seandainya {#Emph}aku {#Prev}bisa terbang sedikit lebih tinggi, aku bisa menyusulnya sendiri, tapi, {#Emph}ehm... {#Prev}aku urungkan niat itu."
      Speaker = "Icarus"
      Event = "IcarusAboutFlying04"
    }
    {
      Id = "Icarus_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berarti masih banyak urusan yang belum kelar, ya? Kalau perang melawan Chronos benar-benar sudah usai, rasanya nggak kelihatan seperti itu melihat kapal-kapal ini. Para Harpy juga kelihatannya nggak makin ramah."
      Speaker = "Icarus"
      Event = "IcarusPostTrueEnding03"
    }
    {
      Id = "MelinoeField_4052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian pastilah para fanatik yang masih percaya Sang Titan Waktu akan bangkit kembali. Namun kami sedang memastikan ancaman dari Chronos dan Typhon takkan pernah terulang. Mengunjungi kembali Olympus adalah bagian dari proses itu."
      Speaker = "Melinoe"
      Event = "IcarusPostTrueEnding03"
    }
    {
      Id = "Icarus_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu... baiklah. Karena kalau maksudmu aku boleh terus terbang, dan aku boleh terus melihat {#Emph}dirimu {#Prev}di {#Emph}sini... {#Prev}itu terdengar menyenangkan buatku."
      Speaker = "Icarus"
      Event = "IcarusPostTrueEnding03"
    }
    {
      Id = "MelinoeField_4053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, benar juga! Kita sempat mengira berakhirnya perang berarti kau harus menanggalkan sayapmu. Tapi, sepertinya perbaikan Dunia Bawah oleh ayahku bakal berlangsung sangat, sangat lama."
      Speaker = "Melinoe"
      Event = "IcarusPostTrueEnding03"
    }
    {
      Id = "Icarus_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa suatu saat nanti aku harus kembali ke tempat yang ditentukan untukku. Tapi untuk sekarang, aku ingin memanfaatkan waktu ini sebaik-baiknya."
      Speaker = "Icarus"
      Event = "IcarusPostTrueEnding03"
    }
    {
      Id = "Icarus_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah agak lama nggak melihatmu di sini! Sibuk di Dunia Bawah, atau sedang santai di pemandian air panas dengan sebotol atau dua botol Ambrosia?"
      Speaker = "Icarus"
      Event = "IcarusAboutUnderworld01"
    }
    {
      Id = "MelinoeField_4059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan mengaku semudah itu. Tapi kurasa kau benar, sudah cukup lama kita tidak saling bertemu di sini. Ada laporan baru?"
      Speaker = "Melinoe"
      Event = "IcarusAboutUnderworld01"
    }
    {
      Id = "Icarus_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mau lapor kalau aku senang melihatmu, walau kurasa itu bukan hal baru. Kakekmu juga {#Emph}sangat jago {#Prev}membangkitkan para pengikutnya yang tewas, kalau itu memang bagian dari rencanamu. Ramai sekali di sini!"
      Speaker = "Icarus"
      Event = "IcarusAboutUnderworld01"
    }
    {
      Id = "Icarus_0481"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku suka rutinitas kita yang sekarang, Meli! Rasanya aku bisa begini selamanya. Kita sudah jadi sangat efisien... bahkan nggak perlu basa-basi lagi."
      Speaker = "Icarus"
      Event = "IcarusAboutSayingLittle01"
    }
    {
      Id = "Icarus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma lagi jalan-jalan sebentar dan berpikir untuk mampir. Senang bertemu denganmu, Meli."
      Speaker = "Icarus"
      Event = "IcarusChat01"
    }
    {
      Id = "Icarus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ombaknya agak ganas malam ini, meski langit di atas cukup cerah. Jaga dirimu baik-baik, ya?"
      Speaker = "Icarus"
      Event = "IcarusChat02"
    }
    {
      Id = "Icarus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku melihat Eris di ujung pesisir sana. Bagaimana kalau kau beri dia sedikit kejutan?"
      Speaker = "Icarus"
      Event = "IcarusChat03"
    }
    {
      Id = "Icarus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku rela melakukan apa saja demi bisa mengobrol lebih lama di sini, tapi aku tahu ini bukan waktu dan tempat yang tepat."
      Speaker = "Icarus"
      Event = "IcarusChat04"
    }
    {
      Id = "Icarus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau hebat sekali, Meli. Aku melihat semuanya dari atas sana! Semangat terus, ya?"
      Speaker = "Icarus"
      Event = "IcarusChat05"
    }
    {
      Id = "Icarus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau harus segera pergi ke tempat lain, aku tahu. Untungnya, aku punya sesuatu yang pas untuk membantumu sampai ke sana."
      Speaker = "Icarus"
      Event = "IcarusChat06"
    }
    {
      Id = "Icarus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu suatu hari nanti kita bakal mengenang semua ini dan merindukannya, nggak?"
      Speaker = "Icarus"
      Event = "IcarusChat07"
    }
    {
      Id = "Icarus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak habis pikir bagaimana kau bisa mengatasi ini tiap malam, tapi aku senang kau baik-baik saja."
      Speaker = "Icarus"
      Event = "IcarusChat08"
    }
    {
      Id = "Icarus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan bertemu denganmu, Meli, meski cuma sebentar. Nggak ada orang lain yang mau menguji coba benda-benda ini untukku!"
      Speaker = "Icarus"
      Event = "IcarusChat09"
    }
    {
      Id = "Icarus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalur aman untuk sekarang! Tapi, setelah melewati titik ini, aku nggak berani jamin."
      Speaker = "Icarus"
      Event = "IcarusChat10"
    }
    {
      Id = "Icarus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku sudah membereskan satu atau dua dari mereka di belakang sana. Lumayan daripada nggak sama sekali, 'kan?"
      Speaker = "Icarus"
      Event = "IcarusChat11"
    }
    {
      Id = "Icarus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru saja mengutak-atik ini. Ambil saja yang mana pun yang kau mau!"
      Speaker = "Icarus"
      Event = "IcarusChat12"
    }
    {
      Id = "Icarus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mana pun yang kau pilih, dijamin bakal memuaskan."
      Speaker = "Icarus"
      Event = "IcarusChat13"
    }
    {
      Id = "Icarus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunungnya sudah nggak jauh dari sini. Mungkin ini bisa membantumu mendaki."
      Speaker = "Icarus"
      Event = "IcarusChat14"
    }
    {
      Id = "Icarus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau nggak punya banyak waktu, jadi ambillah ini. Untuk bekal di jalan."
      Speaker = "Icarus"
      Event = "IcarusChat15"
    }
    {
      Id = "Icarus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih baik-baik saja...! Tadi sempat bikin aku cemas sebentar."
      Speaker = "Icarus"
      Event = "IcarusChat16"
    }
    {
      Id = "Icarus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bakal terbangkan kamu langsung ke istana para dewa sekarang juga, kalau saja aku bisa..."
      Speaker = "Icarus"
      Event = "IcarusChat17"
    }
    {
      Id = "Icarus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Butuh apa pun, bilang saja. Walau untuk sekarang, cuma ini yang kupunya."
      Speaker = "Icarus"
      Event = "IcarusChat18"
    }
    {
      Id = "Icarus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewa-dewa itu pun butuh orang yang bertarung demi mereka, kan...?"
      Speaker = "Icarus"
      Event = "IcarusChat19"
    }
    {
      Id = "Icarus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu sudah lewat separuh jalan, Meli... atau setidaknya sudah dekat, kurasa. Jangan berhenti sekarang!"
      Speaker = "Icarus"
      Event = "IcarusChat20"
    }
    {
      Id = "Icarus_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita harus mengobrol lagi kalau kamu senggang. Santai saja! Waktuku luang selamanya."
      Speaker = "Icarus"
      Event = "IcarusChat21"
    }
    {
      Id = "Icarus_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma segini yang bisa kubantu! Tapi lumayan ada hasilnya, kan? Nih, terimalah."
      Speaker = "Icarus"
      Event = "IcarusChat22"
    }
    {
      Id = "Icarus_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapal ini rasanya mau karam kapan saja, jadi sebaiknya kita jangan berlama-lama..."
      Speaker = "Icarus"
      Event = "IcarusChat23"
    }
    {
      Id = "Icarus_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin ada salah satu dari ini yang berguna buatmu. Cuma ini yang kupunya malam ini."
      Speaker = "Icarus"
      Event = "IcarusChat24"
    }
    {
      Id = "Icarus_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Barang-barang ini memang tak sebanding dengan standar ayahku, tapi kurasa lumayan bagus..."
      Speaker = "Icarus"
      Event = "IcarusChat25"
    }
    {
      Id = "Icarus_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku terus berpikir, rasanya aku tak pernah merasa sehidup ini selain saat bersamamu..."
      Speaker = "Icarus"
      Event = "IcarusChat26"
    }
    {
      Id = "Icarus_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olimpus sudah tak jauh lagi. Aku bakal terbang duluan dan memancing perhatian musuh."
      Speaker = "Icarus"
      Event = "IcarusChat27"
    }
    {
      Id = "Icarus_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak Arwah di luar sana yang percaya padamu dan apa yang sedang kauperjuangkan."
      Speaker = "Icarus"
      Event = "IcarusChat28"
    }
    {
      Id = "Icarus_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh jujur tidak, sayap yang ini bertahannya {#Emph}jauh {#Prev}lebih baik daripada buatan ayahku?"
      Speaker = "Icarus"
      Event = "IcarusChat29"
    }
    {
      Id = "Icarus_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa dibilang, aku tak pernah menyangka akhiratku bakal jadi seperti ini."
      Speaker = "Icarus"
      Event = "IcarusChat30"
    }
    {
      Id = "Icarus_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kamu bisa jaga diri, tapi izinkan aku melihat apa yang bisa kubantu di sini. Kumohon."
      Speaker = "Icarus"
      Event = "IcarusChat31"
    }
    {
      Id = "Icarus_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan, Meli... Kakiku sudah menapak lagi tapi rasanya aku masih melayang...!"
      Speaker = "Icarus"
      Event = "IcarusChat32"
    }
    {
      Id = "Melinoe_3264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu bisa terbang ke mana pun sesukamu sekarang! Tapi, syukurlah kamu tak pergi terlalu jauh sampai tak bisa kukejar. Ini! Mengingat sayapmu yang luar biasa itu, hadiah kecil untukmu."
      Speaker = "Melinoe"
      Event = "IcarusGift01"
    }
    {
      Id = "Icarus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, mentang-mentang aku sering terbang di dekat Olimpus, bukan berarti aku bisa berpesta seolah aku berasal dari sana! Mungkin kalau atas izinmu, boleh juga, kan? Tahu tidak, aku juga punya sesuatu buatmu."
      Speaker = "Icarus"
      Event = "IcarusGift01"
    }
    {
      Id = "Icarus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar terakhir yang kauberikan itu {#Emph}enak {#Prev}banget, tak terbayang bagaimana rasanya waktu aku masih hidup dulu. Tadinya tak berniat minta lagi, tapi... berhubung kamu yang menawarkan!"
      Speaker = "Icarus"
      Event = "IcarusGift02"
    }
    {
      Id = "Melinoe_3266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menawarkannya, jadi terimalah! Mungkin rasanya justru lebih nikmat setelah kamu menjadi Arwah. Dulu kalian bangsa fana harus makan dan minum karena kebutuhan raga. Namun Nektar memuaskan dahaga yang berbeda."
      Speaker = "Melinoe"
      Event = "IcarusGift02"
    }
    {
      Id = "Icarus_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu masih bocah fana yang terkurung di menara, kebutuhanku relatif tercukupi, tapi yang {#Emph}ini? {#Prev}Aku tahu diri untuk tak iri pada para dewa, apalagi melihat musibah yang menimpa mereka belakangan ini... tapi urusan minuman mereka memang jagonya."
      Speaker = "Icarus"
      Event = "IcarusGift03"
    }
    {
      Id = "Melinoe_3499"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa selalu hidup berkelimpahan... sementara hidupmu sendiri begitu singkat dan berat. Pasti masih banyak hal yang ingin kautembus, dan kupikir mungkin ini bisa membantu!"
      Speaker = "Melinoe"
      Event = "IcarusGift03"
    }
    {
      Id = "Icarus_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu sekali, aku selalu ingin mencarikan sebotol Nektar terbaik untukmu... tapi tak pernah kesampaian. Masuk lagi ke daftar hal-hal yang mungkin seharusnya kutangani dengan cara berbeda."
      Speaker = "Icarus"
      Event = "IcarusGift04"
    }
    {
      Id = "Melinoe_3500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kumohon jangan terlalu larut dalam masa lalu. Dulu kamu mengira takkan pernah melihatku lagi, tapi aku ada di sini, sekarang. Aku menghargai saat-saat kebersamaan kita ini."
      Speaker = "Melinoe"
      Event = "IcarusGift04"
    }
    {
      Id = "Icarus_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Takkan pernah kulupakan."
      Speaker = "Icarus"
      Event = "IcarusGift04"
    }
    {
      Id = "Icarus_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyaris tak bisa merasakan botol ini... cuma beratnya saja. Meski kenangan manisku masih ada untuk mengisi kekosongan itu. Lucu ya, aku sudah lupa berapa lama aku mati, tapi masih belum terbiasa sepenuhnya."
      Speaker = "Icarus"
      Event = "IcarusGift05"
    }
    {
      Id = "Melinoe_4529"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin mustahil untuk terbiasa seutuhnya dengan keadaan kita saat ini. Namun, aku heran kamu masih punya rasa nostalgia pada masa mudamu dulu."
      Speaker = "Melinoe"
      Event = "IcarusGift05"
    }
    {
      Id = "Icarus_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kamu {#Prev}sendiri juga begitu! Berapa kali kamu mengenang malam-malam tenangmu sambil mendengarkan gemericik sungai dan suara katak? Terkadang kita melupakan kepedihan, dan terkadang cuma itu yang kita ingat. Tapi momen ini pun akan selalu kuingat."
      Speaker = "Icarus"
      Event = "IcarusGift05"
    }
    {
      Id = "Icarus_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu kecil dulu aku ceroboh sekali. Ayah selalu menyuruhku berhati-hati, tapi aku kan terkurung di menara sialan itu... mau melukai diri sendiri pun tak bisa. Tapi sekarang... aku cuma tak ingin mengacaukan segalanya lagi."
      Speaker = "Icarus"
      Event = "IcarusGift06"
    }
    {
      Id = "Melinoe_4530"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk seseorang yang menghabiskan begitu banyak waktu di atas awan, pikiranmu kadang terlalu terpenjara di dalam kepalamu sendiri. Ini bukan ujian, Icarus. Ini aku. Dan aku senang melihatmu apa adanya."
      Speaker = "Melinoe"
      Event = "IcarusGift06"
    }
    {
      Id = "Icarus_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Meli, lihat diri kita...! Kamu Putri Dunia Bawah yang abadi; aku cuma Arwah murid gagal yang tak becus menuruti satu perintah sederhana dari ayahnya dan mati sebelum waktunya. Yang {#Emph}seperti ini {#Prev}yang kausukai?"
      Speaker = "Icarus"
      Event = "IcarusGift06"
    }
    {
      Id = "Melinoe_4531"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, karena itu bukan dirimu yang sebenarnya. Aku tak pernah mengasihanimu; kenapa kamu justru begitu mengasihani dirimu sendiri? Buang jauh-jauh rasa itu. Namun perasaanmu yang sebenarnya, jangan pernah kausembunyikan dariku."
      Speaker = "Melinoe"
      Event = "IcarusGift06"
    }
    {
      Id = "Icarus_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan kucoba... pasti akan kucoba, bodoh sekali kalau tidak. Jadi, kalau begitu...! Maju terus menghadapi apa pun yang menghadang?"
      Speaker = "Icarus"
      Event = "IcarusGift06"
    }
    {
      Id = "Melinoe_4532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tetap sambil menikmati setiap momennya, tentu saja."
      Speaker = "Melinoe"
      Event = "IcarusGift06"
    }
    {
      Id = "Melinoe_4558"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau kelihatannya menikmati tegukan pertama Ambrosia itu, jadi kuingin kau menyimpan sebotol untukmu sendiri. Untuk saat ada kesempatan yang tepat."
      Speaker = "Melinoe"
      Event = "IcarusGift07"
    }
    {
      Id = "Icarus_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebotol untukku sendiri, untuk saat ada kesempatan yang tepat... {#Emph}wah, apa? {#Prev}Aduh, ayolah, Meli, ini benar-benar berlebihan! Aku tak punya apa pun yang {#Emph}sebagus {#Prev}ini untuk diberikan {#Emph}padamu!"
      Speaker = "Icarus"
      Event = "IcarusGift07"
    }
    {
      Id = "Melinoe_4559"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku rasa tidak begitu! Kau sudah memberiku jauh {#Emph}lebih {#Prev}banyak. Dan maksudku bukan cuma palu-palu yang sibuk kau buat itu."
      Speaker = "Melinoe"
      Event = "IcarusGift07"
    }
    {
      Id = "Icarus_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak melakukan hal yang tak akan dilakukan oleh puluhan Arwah pemujamu dalam sekejap mata, andai mereka masih punya mata."
      Speaker = "Icarus"
      Event = "IcarusGift07"
    }
    {
      Id = "Melinoe_4560"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, kau salah satu Arwah pemujaku?"
      Speaker = "Melinoe"
      Event = "IcarusGift07"
    }
    {
      Id = "Icarus_0248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aduh, sudahlah. Dan, berikan itu padaku."
      Speaker = "Icarus"
      Event = "IcarusGift07"
    }
    {
      Id = "Melinoe_4561"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita coba urusan Ambrosia ini lagi, tapi {#Emph}kali ini{#Prev}, jangan berpura-pura kau cuma sekadar Arwah biasa. Kau lebih dari itu. Dan lebih dari seorang kawan."
      Speaker = "Melinoe"
      Event = "IcarusGift08"
    }
    {
      Id = "Icarus_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Baiklah, tapi... apa kau tidak berpikir kalau ini memang tidak ditakdirkan bersama, ya? Saat kucoba menyentuhmu rasanya nyaris cuma semilir angin, seolah aku bahkan tak ada di sini..."
      Speaker = "Icarus"
      Event = "IcarusGift08"
    }
    {
      Id = "Melinoe_4562"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}memang {#Prev}ada di sini. Aku juga tak ingin terluka lagi, tapi setiap malam aku berangkat seperti ini, aku tak bisa menuntaskan apa yang harus kulakukan tanpa membuka peluang itu... bahkan kepastiannya. Terkadang pengorbanan itu sepadan."
      Speaker = "Melinoe"
      Event = "IcarusGift08"
    }
    {
      Id = "Icarus_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa sakitku sendiri bisa kutahan, siapa peduli? Tapi {#Emph}rasa sakitmu{#Prev}, kurasa aku tak sanggup hidup menanggungnya... {#Emph}eksis {#Prev}menanggungnya, kau tahu maksudku. Tapi... {#Emph}argh! {#Prev}Aku tak percaya aku malah {#Emph}berdebat {#Prev}denganmu, Meli, saat ini aku bahagia melebihi {#Emph}apa pun! {#Prev}Tapi aku {#Emph}takut..."
      Speaker = "Icarus"
      Event = "IcarusGift08"
    }
    {
      Id = "Melinoe_4563"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ketakutan yang bisa kita hadapi bersama."
      Speaker = "Melinoe"
      Event = "IcarusGift08"
    }
    {
      Id = "Melinoe_4564"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau satu Ambrosia lagi, sebagai bahan eksperimen, karena ramuan yang tersohor membawa kehangatan dan kenikmatan ini entah bagaimana malah membawakanmu kesengsaraan."
      Speaker = "Melinoe"
      Event = "IcarusGift09"
    }
    {
      Id = "Icarus_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, luar biasa, baru saja terpikir aku butuh lebih banyak sengsara dan tibalah kita di sini. Kau tahu alasannya, kan? Kita sudah mencoba semua ini sebelumnya, dan tak membuahkan hasil. Kuharap sekali bisa, tapi ya sudahlah."
      Speaker = "Icarus"
      Event = "IcarusGift09"
    }
    {
      Id = "Melinoe_4565"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah lebih berpengalaman sekarang. Terkadang saat segalanya gagal, kau harus mencobanya lagi. Berulang-ulang kali, jika memang itu yang diperlukan."
      Speaker = "Melinoe"
      Event = "IcarusGift09"
    }
    {
      Id = "Icarus_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meli, aku setuju denganmu... asalkan harga untuk mencobanya tak kelewat mahal! Dalam kasusmu, yah... kau punya satu lengan lagi di sana, tentu. Sepasang kaki. Kau rela mempertaruhkan semua itu demi diriku? Cuma demi membuatku {#Emph}utuh?"
      Speaker = "Icarus"
      Event = "IcarusGift09"
    }
    {
      Id = "Melinoe_4566"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, aku tahu aku tak bisa begitu saja mengembalikan tubuhmu secara permanen. Tapi ikatan yang kita miliki... yang selalu kita miliki ini... aku rela mengikutinya ke mana pun bermuara. Aku {#Emph}ingin {#Prev}menjalaninya, jika kau juga mau."
      Speaker = "Melinoe"
      Event = "IcarusGift09"
    }
    {
      Id = "Icarus_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja aku mau. Aku rela mengikutimu menerobos matahari, Meli. Atau ke mana pun tempat yang kauinginkan."
      Speaker = "Icarus"
      Event = "IcarusGift09"
    }
    {
      Id = "Melinoe_4567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, aku punya ide."
      Speaker = "Melinoe"
      Event = "IcarusGift09"
    }
    {
      Id = "Melinoe_4570"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan cemas, ini bukan Ambrosia lagi. Namanya Tegukan Ektoplasma. Tidak seampuh mantra yang pernah kucoba dulu, tapi yang ini manjur, kurasa."
      Speaker = "Melinoe"
      Event = "IcarusGift10"
    }
    {
      Id = "Icarus_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu apa, Meli, tunggu... tegukan ini bisa membuatku {#Emph}utuh? {#Prev}Atau mungkin sebagian, sebelah lengan atau semacamnya, kan?"
      Speaker = "Icarus"
      Event = "IcarusGift10"
    }
    {
      Id = "Melinoe_4571"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini mungkin bisa memulihkan kesadaran ragawimu seolah-olah kau masih hidup dan bernapas. Tapi khasiatnya tidak akan bertahan lama, paling lama semalam. Begitulah komprominya."
      Speaker = "Melinoe"
      Event = "IcarusGift10"
    }
    {
      Id = "Icarus_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti bercanda, jadi... aku bisa menjadi {#Emph}diriku {#Prev}lagi... merasakan dinginnya angin dan cipratan air laut dan semacamnya! Cuma untuk semalam. B-Bisa kau buatkan lagi?"
      Speaker = "Icarus"
      Event = "IcarusGift10"
    }
    {
      Id = "Melinoe_4572"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan terburu-buru dulu. Benda seperti ini bisa membawa efek samping jika kau tak mengonsumsinya perlahan. Berjanjilah kau akan berhati-hati."
      Speaker = "Melinoe"
      Event = "IcarusGift10"
    }
    {
      Id = "Icarus_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bersumpah akan mengonsumsinya perlahan saat menggunakan Tegukan Ektoplasma ini. Aku sudah pernah mengabaikan petunjuk yang sepenuhnya masuk akal hingga celaka setidaknya sekali, dan aku tak berniat mengulanginya lagi."
      Speaker = "Icarus"
      Event = "IcarusGift10"
    }
    {
      Id = "Melinoe_4573"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, gunakanlah ini kapan pun kau rasa tepat, mungkin di suatu malam yang sangat istimewa. Dan anggaplah ini satu-satunya yang ada."
      Speaker = "Melinoe"
      Event = "IcarusGift10"
    }
    {
      Id = "Icarus_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih... terima kasih banyak..."
      Speaker = "Icarus"
      Event = "IcarusGift10"
    }
    {
      Id = "Melinoe_4533"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, apa kau sudah melihat apa yang kami perbuat pada pemandian air panas? Tempat yang bagus untuk meluruhkan sisa-sisa rasa sakit jika kau ingin pergi ke sana?"
      Speaker = "Melinoe"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Icarus_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengarmu? Sekarang juga? Baiklah! Tapi, jangan berharap air panas itu bakal berguna banyak untuk kulitku, ya?"
      Speaker = "Icarus"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Icarus_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Lucu ya, bagaimana hidup ini terkadang benar-benar di luar nalar. Selagi masih hidup dulu, aku tak pernah membayangkan hal {#Emph}apa pun {#Prev}seperti ini."
      Speaker = "Icarus"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Melinoe_4535"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini cuma pemandian air panas, Icarus. Yah, memang disucikan dan diberi sihir pekat, tapi tetap saja. Kau sudah terbang melintasi armada kapal perang yang bangkit... bagaimana bisa ini terasa lebih aneh dari itu?"
      Speaker = "Melinoe"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Icarus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh. {#Prev}Lebih karena aku berada di sini bersamamu. Kau begitu jelita, Meli. Bukannya kau butuh kami para Arwah dan makhluk fana untuk menyadarinya! Afrodit sendiri pasti sudah pernah mengatakannya padamu, kan?"
      Speaker = "Icarus"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Melinoe_4536"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, sudahlah, Afrodit adalah sekutu yang setia. Andai dia iri padaku, kurasa dia tak akan seroyal itu membagikan semua berkah terhebatnya seperti sekarang."
      Speaker = "Melinoe"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Icarus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan itu maksudku sebenarnya. Kami bangsa fana... cenderung memiliki rasa malu tertentu. Tubuh kami bisa begitu rapuh, dan buruk rupa, terkadang... tapi tidak bagi dewa-dewi."
      Speaker = "Icarus"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Melinoe_4537"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak melihat apa yang perlu dimalukan. Aku kenal Arwah seperti dirimu, dan Odisseus... kalian sudah cukup dekat dengan dewa!"
      Speaker = "Melinoe"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Icarus_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah{#Prev}, yah, baik sekali perkataanmu itu. Dan ucapanmu benar soal beban pikiranku dan tempat ini! Aku senang sekali kita berada di sini."
      Speaker = "Icarus"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Icarus_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kuharap kita bisa tinggal lebih lama. Tapi tadi menyenangkan sekali. Terima kasih sudah mengajakku."
      Speaker = "Icarus"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Melinoe_4539"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menyenangkan memang..."
      Speaker = "Melinoe"
      Event = "IcarusBathHouse01"
    }
    {
      Id = "Melinoe_4540"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menikmati waktu santai kita di pemandian air panas kemarin, dan kupikir kau mungkin berminat pergi lagi dalam waktu dekat. Mungkin sekarang?"
      Speaker = "Melinoe"
      Event = "IcarusBathHouse02"
    }
    {
      Id = "Icarus_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Yah, sayap ini sebenarnya butuh perawatan lanjutan, tapi... bicara apa sih aku ini. Itu jelas bisa menunggu. Ayo berangkat?"
      Speaker = "Icarus"
      Event = "IcarusBathHouse02"
    }
    {
      Id = "Melinoe_4541"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau diam saja, Icarus. Apa yang sedang kau pikirkan? Selain perawatan lanjutan untuk sayap luar biasa yang kau buat itu."
      Speaker = "Melinoe"
      Event = "IcarusBathHouse02"
    }
    {
      Id = "Icarus_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh{#Prev}, hanya saja... sebagian besar malam-malamku jauh dari kata menyenangkan. Aku ingin menikmati saat-saat ini lebih lama. Sekaligus memperbaiki sayap sialan ini! Kalau memang {#Emph}begitu {#Prev}luar biasa, sayap ini tidak akan rusak."
      Speaker = "Icarus"
      Event = "IcarusBathHouse02"
    }
    {
      Id = "Melinoe_4542"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir hal-hal yang luar biasa memang sering kali rapuh. Meski kelihatannya sayapmu jauh lebih kokoh daripada yang kau akui! Kau berhasil memecahkan masalah yang membuat sayap Daedalus yang tersohor itu gagal."
      Speaker = "Melinoe"
      Event = "IcarusBathHouse02"
    }
    {
      Id = "Icarus_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kegagalan itu adalah kesalahanku. Sayap yang dibuat ayahku dirangkai dari bulu dan lilin, hanya itu bahan yang ada saat itu. Lilinnya harus tetap dingin, tapi {#Emph}aku {#Prev}malah terbang mendekati terik matahari. Kalau dipikir-pikir lagi, harusnya waktu itu aku terbang malam hari..."
      Speaker = "Icarus"
      Event = "IcarusBathHouse02"
    }
    {
      Id = "Melinoe_4543"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin waktu itu kalian tidak punya kemewahan untuk memilih, mengingat kalian sedang ditawan. Lalu apa yang terjadi? Sayapmu meleleh?"
      Speaker = "Melinoe"
      Event = "IcarusBathHouse02"
    }
    {
      Id = "Icarus_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, begitulah. Rasanya begitu mendebarkan sampai aku memaksanya terlalu jauh. Jadi, aku jatuh. Sayap baru ini menggunakan serat yang mirip tulang burung, jadi tidak mudah patah. Tapi sudahlah, jangan bicarakan masa lalu lagi, ya? Aku jauh lebih menyukai masa kini."
      Speaker = "Icarus"
      Event = "IcarusBathHouse02"
    }
    {
      Id = "Icarus_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}...Fiuh! {#Prev}Orang-orang bilang orang mati beristirahat dalam damai, tapi aku sudah {#Emph}lama sekali {#Prev}tidak beristirahat senikmat itu. Mantap, kan?"
      Speaker = "Icarus"
      Event = "IcarusBathHouse02"
    }
    {
      Id = "Melinoe_4545"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mantap!"
      Speaker = "Melinoe"
      Event = "IcarusBathHouse02"
    }
    {
      Id = "Melinoe_4555"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, jika kau sedang tidak terlalu sibuk, maukah menemaniku ke pemandian air panas sebentar?"
      Speaker = "Melinoe"
      Event = "IcarusBathHouseDecline01"
    }
    {
      Id = "Icarus_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak tahu betapa inginnya aku ke sana, tapi sekarang aku benar-benar tidak bisa... Aku sudah bilang ke Tuan Odysseus bahwa aku harus segera berangkat."
      Speaker = "Icarus"
      Event = "IcarusBathHouseDecline01"
    }
    {
      Id = "Icarus_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang sekali bisa ke pemandian air panas lagi bersamamu. Berangkat sekarang?"
      Speaker = "Icarus"
      Event = "IcarusBathHouseRepeatable01[1]"
    }
    {
      Id = "Icarus_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemandian air panas! Tak banyak tempat di Crossroads yang lebih kusukai selain itu."
      Speaker = "Icarus"
      Event = "IcarusBathHouseRepeatable01[1]"
    }
    {
      Id = "Icarus_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan senang hati aku akan menemanimu ke pemandian air panas, Yang Mulia."
      Speaker = "Icarus"
      Event = "IcarusBathHouseRepeatable01[1]"
    }
    {
      Id = "Icarus_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Berada di sini membuatku merasa seolah tak punya beban sama sekali di dunia."
      Speaker = "Icarus"
      Event = "IcarusBathHouseRepeatable01[3]"
    }
    {
      Id = "Icarus_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Di sini selalu damai, rasanya aku tak ingin pergi, tahu tidak?"
      Speaker = "Icarus"
      Event = "IcarusBathHouseRepeatable01[3]"
    }
    {
      Id = "Icarus_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Malam yang indah, bukan? Cara bulan menyinari segalanya..."
      Speaker = "Icarus"
      Event = "IcarusBathHouseRepeatable01[3]"
    }
    {
      Id = "Icarus_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menyenangkan sekali bisa beristirahat dan mengobrol santai, terima kasih banyak."
      Speaker = "Icarus"
      Event = "IcarusBathHouseRepeatable01[4]"
    }
    {
      Id = "Icarus_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang harus disudahi malam ini, tapi tadi sungguh luar biasa."
      Speaker = "Icarus"
      Event = "IcarusBathHouseRepeatable01[4]"
    }
    {
      Id = "Icarus_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat seperti yang kubutuhkan... dan kita berdua terlihat berseri-seri, aku yakin itu."
      Speaker = "Icarus"
      Event = "IcarusBathHouseRepeatable01[4]"
    }
    {
      Id = "Melinoe_4546"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, jika kau belum harus terbang sekarang, bagaimana kalau kita ke dermaga pemancingan? Di sana suasananya tenang dan sunyi."
      Speaker = "Melinoe"
      Event = "IcarusFishing01"
    }
    {
      Id = "Icarus_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh, kedengarannya seru! Tapi perlu kuingatkan bahwa aku belum pernah belajar memancing, jadi sebagai peringatan awal, aku pasti payah sekali."
      Speaker = "Icarus"
      Event = "IcarusFishing01"
    }
    {
      Id = "Icarus_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Di tempat asalku, ikan adalah sumber makanan utama. Aneh rasanya, a... aku tak pernah benar-benar menganggap mereka sebagai makhluk hidup, sama sepertiku. Yah, memang tidak {#Emph}persis {#Prev}sepertiku, tapi kau paham maksudku. Namanya juga anak-anak! Tahu apa aku dulu."
      Speaker = "Icarus"
      Event = "IcarusFishing01"
    }
    {
      Id = "Melinoe_4547"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua yang dimakan kaum fana adalah makhluk hidup, atau setidaknya pernah hidup. Aku bersyukur tidak membutuhkan makanan... Menurutku gagasan harus memangsa nyawa lain demi menyambung nyawa sendiri itu agak menjijikkan."
      Speaker = "Melinoe"
      Event = "IcarusFishing01"
    }
    {
      Id = "Icarus_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami kaum fana memang terbiasa melakukan hal-hal yang tidak menyenangkan. Itu salah satu perbedaan utama antara kami dan kalian, selain fakta bahwa kami sangat mudah mati. Pilihan apa lagi yang kami punya selain bertahan hidup?"
      Speaker = "Icarus"
      Event = "IcarusFishing01"
    }
    {
      Id = "Melinoe_4548"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin memang tidak ada pilihan lain. Sebagian besar alam berjuang untuk bertahan hidup, mulai dari bunga yang mendambakan secercah cahaya, hingga dirimu, yang sedang bingung mencari cara meminta kuajari memancing!"
      Speaker = "Melinoe"
      Event = "IcarusFishing01"
    }
    {
      Id = "Icarus_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Haha. {#Prev}Yah, setahuku memancing itu harus tenang dan tidak berisik... jadi, bagaimana kalau kau berikan contoh dan aku akan memperhatikannya baik-baik."
      Speaker = "Icarus"
      Event = "IcarusFishing01"
    }
    {
      Id = "Icarus_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, aku benar-benar menikmatinya, bahkan saat hanya duduk diam menunggu. Terima kasih sudah mengajakku."
      Speaker = "Icarus"
      Event = "IcarusFishing01"
    }
    {
      Id = "Melinoe_0768"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama-sama."
      Speaker = "Melinoe"
      Event = "IcarusFishing01"
    }
    {
      Id = "Melinoe_4556"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir mungkin kau mau menemaniku ke dermaga pemancingan lagi, jika kau tidak keberatan?"
      Speaker = "Melinoe"
      Event = "IcarusFishingDecline01"
    }
    {
      Id = "Icarus_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya aku sangat ingin, tapi malam ini aku tidak bisa berlama-lama di sini. Lain kali saja, ya?"
      Speaker = "Icarus"
      Event = "IcarusFishingDecline01"
    }
    {
      Id = "Icarus_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih belum terlalu paham cara memancing, tapi kalau kau bersedia mengajariku..."
      Speaker = "Icarus"
      Event = "IcarusFishingRepeatable01[1]"
    }
    {
      Id = "Icarus_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau punya umpannya, aku punya kesabaran buat berdiri diam."
      Speaker = "Icarus"
      Event = "IcarusFishingRepeatable01[1]"
    }
    {
      Id = "Icarus_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Butuh teman memancing? Akulah Arwah andalanmu. Ayo, serahkan padaku."
      Speaker = "Icarus"
      Event = "IcarusFishingRepeatable01[1]"
    }
    {
      Id = "Icarus_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Waktu yang menyenangkan tadi. Makasih sudah mengajakku, ya."
      Speaker = "Icarus"
      Event = "IcarusFishingRepeatable01[2]"
    }
    {
      Id = "Icarus_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tenang sekali di sana tadi! Asal kau bukan seekor ikan, kurasa."
      Speaker = "Icarus"
      Event = "IcarusFishingRepeatable01[2]"
    }
    {
      Id = "Icarus_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kita pasti sudah menakuti sebagian besar dari mereka. Memangnya itu tujuannya?"
      Speaker = "Icarus"
      Event = "IcarusFishingRepeatable01[2]"
    }
    {
      Id = "Melinoe_4549"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, pernah coba Ambrosia, Icarus? Soalnya kalau belum, sebentar lagi kau akan merasakannya. Tentu saja kalau kau berminat dan sedang ada waktu luang."
      Speaker = "Melinoe"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Icarus_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya, {#Emph}belum{#Prev}, aku belum pernah coba Ambrosia sebelumnya, dan aku {#Emph}tak pernah {#Prev}berminat sampai kau menanyakannya barusan. Kau yakin ini tidak apa-apa...?"
      Speaker = "Icarus"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Icarus_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Arwah-arwah lain memperhatikan kita, Meli. Mereka sangat mengagumimu, dan mungkin berharap aku mati kalau saja aku belum jadi arwah penasaran."
      Speaker = "Icarus"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Melinoe_4550"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, jangan khawatir. Kalau ada arwah yang kelewat iri, satu-satunya perhatian yang bakal mereka dapat hanyalah dari Nemesis. Lagian buat apa mereka peduli? Aku lebih sering melihat {#Emph}mereka {#Prev}ketimbang dirimu."
      Speaker = "Melinoe"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Icarus_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, cuma saja... sewaktu masih fana, banyak dari kami yang mudah cemburu. Terutama saat melihat orang yang kami sayangi bersama orang lain. Susah dijelaskan, tapi kurasa itu semua berakar dari naluri kami yang tahu betapa singkatnya waktu yang kami punya."
      Speaker = "Icarus"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Melinoe_4551"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kalian punya waktu abadi sekarang setelah berada di sini. Dengan catatan Chronos belum merusak segalanya tanpa bisa diperbaiki. Walau kurasa kami para dewa juga bisa merasakan hal semacam itu."
      Speaker = "Melinoe"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Icarus_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Masa, sih? {#Prev}Ayo dong, sebutkan {#Emph}satu {#Prev}hal yang pernah membuatmu iri, Meli. Kau kelihatannya sangat nyaman dengan dirimu sekarang, dan dengan segala yang kau miliki... Aku tak pernah melihatmu menginginkan sesuatu yang bukan milikmu."
      Speaker = "Icarus"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Melinoe_4552"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu kau kurang memperhatikan. Aku iri pada Ibu Guru, salah satunya. Aku takkan pernah bisa menjadi setengah dari penyihir sehebat beliau. Maupun terlihat begitu anggun saat mengenakan topi."
      Speaker = "Melinoe"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Icarus_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, aku tarik kata-kataku! Kau iri pada {#Emph}topi {#Prev}milik sang Penyihir Crossroads. Nah, {#Emph}bisa {#Prev}kita coba minumannya sekarang, kan? Kita masih bisa menyisakan sedikit untuk arwah-arwah yang lain!"
      Speaker = "Icarus"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Icarus_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Wah. Seumur hidupku, aku {#Emph}tak pernah {#Prev}mencicipi yang seperti ini. Maupun setelah mati. Para dewa terbiasa meminum ini setiap saat...?"
      Speaker = "Icarus"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Melinoe_4554"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, setidaknya beberapa dari mereka!"
      Speaker = "Melinoe"
      Event = "IcarusTaverna01"
    }
    {
      Id = "Melinoe_4557"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya sebotol Ambrosia lagi yang bisa kita nikmati berdua di kedai kalau kau mau?"
      Speaker = "Melinoe"
      Event = "IcarusTavernaDecline01"
    }
    {
      Id = "Icarus_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sejujurnya aku mau sekali, tapi... kami dapat laporan tentang armada baru yang muncul di Rift, dan sebaiknya aku menyapa mereka dulu."
      Speaker = "Icarus"
      Event = "IcarusTavernaDecline01"
    }
    {
      Id = "Icarus_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mencicipi Ambrosia lagi, bersama {#Emph}dirimu? {#Prev}Ayo, balapan sampai ke sana."
      Speaker = "Icarus"
      Event = "IcarusTavernaRepeatable01[1]"
    }
    {
      Id = "Icarus_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal menurutmu kedainya tidak terlalu ramai sekarang, tentu saja."
      Speaker = "Icarus"
      Event = "IcarusTavernaRepeatable01[1]"
    }
    {
      Id = "Icarus_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sedang merayakan sesuatu, ya? Tapi ayo berangkat saja meski tidak ada apa-apa!"
      Speaker = "Icarus"
      Event = "IcarusTavernaRepeatable01[1]"
    }
    {
      Id = "Icarus_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Hei, kurasa aku sudah kenal sebagian besar arwah di sini sekarang. Aku suka yang ada di belakang sana itu!"
      Speaker = "Icarus"
      Event = "IcarusTavernaRepeatable01[2]"
    }
    {
      Id = "Icarus_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Minuman ini benar-benar luar biasa, dan entah kenapa rasanya selalu berbeda setiap saat."
      Speaker = "Icarus"
      Event = "IcarusTavernaRepeatable01[2]"
    }
    {
      Id = "Icarus_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Rasanya benar-benar sempurna. Katanya kami para Arwah tak bisa mengecap rasa apa pun!"
      Speaker = "Icarus"
      Event = "IcarusTavernaRepeatable01[2]"
    }
    {
      Id = "Icarus_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang rasanya ditemani. Dan sepertinya suasana hati semua orang sedang bagus, kurang lebih begitu."
      Speaker = "Icarus"
      Event = "IcarusTavernaRepeatable01[3]"
    }
    {
      Id = "Icarus_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya lebih ringan daripada bulu setelah meminum itu. Aku senang kita tadi pergi ke sana!"
      Speaker = "Icarus"
      Event = "IcarusTavernaRepeatable01[3]"
    }
    {
      Id = "Icarus_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menyenangkan bisa melihat semua orang di sana tadi, belum lagi minumannya."
      Speaker = "Icarus"
      Event = "IcarusTavernaRepeatable01[3]"
    }
    {
      Id = "Icarus_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita coba ini di Crossroads saja lain kali, ya? Lebih susah berkonsentrasi di sini dengan adanya kapal-kapal karam dan para awak abadi dan sebagainya."
      Speaker = "Icarus"
      Event = "IcarusFieldGiftDecline01"
    }
    {
      Id = "MelinoeField_3638"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masuk akal juga."
      Speaker = "Melinoe"
      Event = "IcarusFieldGiftDecline01"
    }
    {
      Id = "Melinoe_5950"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, lihat apa yang kutemukan sedang diseduh di kawah kita di sana. Mau mencicipinya bersamaku?"
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat01"
    }
    {
      Id = "Icarus_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tegukan lagi? Yah, terpaksa kuhabiskan sampai tetes terakhir."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat01"
    }
    {
      Id = "Icarus_0374"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kapan pun aku merasa begitu hidup lagi, aku ingin bersamamu."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat01"
    }
    {
      Id = "Melinoe_5661"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh juga...!"
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat01"
    }
    {
      Id = "Melinoe_5952"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu untukmu di sini... yah, untuk kita berdua."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat02"
    }
    {
      Id = "Icarus_0375"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin merasa hidup kembali saat ini juga, dan ditemani olehmu."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat02"
    }
    {
      Id = "Icarus_0376"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau yang terbaik yang pernah ada atau yang bakal ada, Meli."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat02"
    }
    {
      Id = "Melinoe_5662"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau juga lumayan kok."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat02"
    }
    {
      Id = "Melinoe_5951"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini ada Ramuan lagi kalau kau mau... mungkin bahkan sekarang juga."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat03"
    }
    {
      Id = "Icarus_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kan aku tak bisa memikirkan hal lain sejak terakhir kali?"
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat03"
    }
    {
      Id = "Icarus_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kuharap ramuan buatanmu itu bisa bertahan selamanya."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat03"
    }
    {
      Id = "Melinoe_5663"
      InheritFrom = "BaseNarrative"
      DisplayName = "Khasiatnya sudah cukup ampuh."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat03"
    }
    {
      Id = "Melinoe_5953"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat apa yang kuseduh. Kalau kau tidak terlalu sibuk... kita bisa kembali ke tenda?"
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat04"
    }
    {
      Id = "Icarus_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau yakin? Rasanya jantungku sudah mulai berdegup kencang..."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat04"
    }
    {
      Id = "Icarus_0380"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Malam terbaik sepanjang keberadaanku. Sejak terakhir kali itu."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat04"
    }
    {
      Id = "Melinoe_5664"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah, yang benar saja."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat04"
    }
    {
      Id = "Melinoe_5954"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa simpan ini kapan pun kau mau... tapi, kalau kau tidak terlalu sibuk..."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat05"
    }
    {
      Id = "Icarus_0381"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sebenarnya harus segera berangkat... tapi aku juga tidak sebodoh itu untuk menolaknya."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat05"
    }
    {
      Id = "Icarus_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tiap detik yang kuhabiskan bersamamu selalu lebih baik dari sebelumnya."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat05"
    }
    {
      Id = "Melinoe_5665"
      InheritFrom = "BaseNarrative"
      DisplayName = "Syukurlah..."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat05"
    }
    {
      Id = "Melinoe_5955"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir kau mungkin ingin Ramuan Ektoplasma lagi. Mungkin bersamaku."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat06"
    }
    {
      Id = "Icarus_0383"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membaca pikiranku atau menatap langsung ke dalam jiwaku. Entah yang mana."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat06"
    }
    {
      Id = "Icarus_0384"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}...Ehm{#Prev}, ngomong-ngomong... aku suka sekali dekorasi tendamu yang baru."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloserChat06"
    }
    {
      Id = "Melinoe_5666"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus, kan...?"
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloserChat06"
    }
    {
      Id = "Melinoe_5161"
      InheritFrom = "BaseSubtitle"
