      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "Icarus_0114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, aku pergi dulu...!"
      Speaker = "Icarus"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "Icarus_0115"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nanti kuhubungi lagi...!"
      Speaker = "Icarus"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "Icarus_0116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam...!"
      Speaker = "Icarus"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "Icarus_0117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa lagi...!"
      Speaker = "Icarus"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "Icarus_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa..."
      Speaker = "Icarus"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "Icarus_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya aku pergi..."
      Speaker = "Icarus"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "Icarus_0528"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, Meli!"
      Speaker = "Icarus"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "Icarus_0529"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di sana!"
      Speaker = "Icarus"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_2235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dah..."
      Speaker = "Melinoe"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_2237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia pun pergi."
      Speaker = "Melinoe"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_2238"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di luar sana..."
      Speaker = "Melinoe"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_2239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa..."
      Speaker = "Melinoe"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_2240"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Menghela napas>"
      Speaker = "Melinoe"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_2590"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertahankan kerja bagusmu...!"
      Speaker = "Melinoe"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_2236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya..."
      Speaker = "Melinoe"
      Event = "NPC_Icarus_01.ExitVoiceLines"
    }
    {
      Id = "Icarus_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak nyangka bakal ngerasa begini, tapi senang rasanya bisa kembali, Meli! Ah, {#Emph}anu{#Prev}, Yang Mulia. Tempat ini terasa beda, kayaknya... lebih {#Emph}hangat {#Prev}dari yang dulu atau semacamnya, ya?"
      Speaker = "Icarus"
      Event = "IcarusHomeFirstMeeting"
    }
    {
      Id = "Melinoe_4520"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menemukan jalan pulang! Kau selalu disambut dan aman di sini, Icarus. Kupikir sayapmu membuat perjalanan pulang ini cukup cepat dan tanpa hambatan?"
      Speaker = "Melinoe"
      Event = "IcarusHomeFirstMeeting"
    }
    {
      Id = "Icarus_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, terbang melintasi kota Ephyra jelas jauh lebih baik daripada harus bersusah payah jalan kaki. Aku masih harus melapor ke Tuan Odisius, tapi aku bakal berusaha agar nggak terlalu mengasingkan diri di sini."
      Speaker = "Icarus"
      Event = "IcarusHomeFirstMeeting"
    }
    {
      Id = "Melinoe_4521"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tolong pastikan begitu."
      Speaker = "Melinoe"
      Event = "IcarusHomeFirstMeeting"
    }
    {
      Id = "Icarus_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tempat ini banyak banget berubah sejak aku pergi. Kalau kau bilang padaku separuh dari barang-barang ini ada di sini, pasti bakal jauh lebih gampang membujukku untuk kembali."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutCrossroads01"
    }
    {
      Id = "Melinoe_4522"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin tahu apakah kau akan pulang atas kemauanmu sendiri. Dan juga, kejutan! Kau masih ingat caranya menemukan tempat ini?"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutCrossroads01"
    }
    {
      Id = "Icarus_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Susah lupa kalau sudah tahu jalannya. Tapi, soal mencari tempat mendarat yang pas, aku sudah agak kaku. Tadi aku nyaris menabrak kuali!"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutCrossroads01"
    }
    {
      Id = "Melinoe_4523"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan bilang, apa yang terjadi?"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutCrossroads01"
    }
    {
      Id = "Icarus_0168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Malah Tuan Odisius yang kutabrak!"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutCrossroads01"
    }
    {
      Id = "Icarus_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau benar-benar bangun tiap malam di sana, segar bugar seutuhnya? Dan dengan tekad baru untuk menggapai ambisi hidupmu, semacam itu?"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutCrossroads02"
    }
    {
      Id = "Melinoe_4524"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membuatnya terdengar begitu otomatis. Pemulihan fisikku mungkin sudah menjadi kebiasaan sekarang, tapi motivasiku tentu saja tidak. Kau pikir aku tidak pernah merasa patah semangat?"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutCrossroads02"
    }
    {
      Id = "Icarus_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}nggak pernah {#Prev}lihat kau patah semangat. Tapi mungkin kau cuma pintar menyembunyikannya. Apa yang bakal kau lakukan kalau berhasil, heh? Mengejar harapan dan impian lain?"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutCrossroads02"
    }
    {
      Id = "Melinoe_4525"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu bukan hal yang pernah kupikirkan."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutCrossroads02"
    }
    {
      Id = "Icarus_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Paham. Selesaikan yang utama dulu."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutCrossroads02"
    }
    {
      Id = "Icarus_0170_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}nggak pernah {#Prev}lihat kau patah semangat. Tapi mungkin kau cuma pintar menyembunyikannya."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutCrossroads02_B"
    }
    {
      Id = "Melinoe_4870"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bakat yang tak kusadari kumiliki!"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutCrossroads02_B"
    }
    {
      Id = "Icarus_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, kau sudah bangun! Nyaris saja aku melewatkanmu, tadi sudah mau terbang balik ke Tesalia. Semoga istirahatmu cukup. Sepertinya malammu kemarin lumayan seru!"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutCrossroads03"
    }
    {
      Id = "Melinoe_4526"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang {#Emph}cukup {#Prev}produktif, ya. Tapi kalau kau sedang bertugas, aku tak ingin menahanmu. Kita bisa mengobrol lain kali...! Atau kau memang menungguku di sini?"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutCrossroads03"
    }
    {
      Id = "Icarus_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak! {#Prev}Maksudku, senang melihatmu, {#Emph}iya{#Prev}, tapi... aku nggak {#Emph}terlambat. {#Prev}Waktunya bisa kukejar saat terbang nanti, kau tahu sendiri, arus angin dan semacamnya. Jadi... yah, mari kita kembali bertugas masing-masing, heh?"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutCrossroads03"
    }
    {
      Id = "Melinoe_4527"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali bertugas, ya."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutCrossroads03"
    }
    {
      Id = "Icarus_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak pernah hujan seperti {#Emph}ini {#Prev}di atas Rift. Lucu juga, waktu tumbuh dewasa, kadang aku mendengar suara hujan di luar, tapi nggak pernah merasakannya sekalipun."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutRain01"
    }
    {
      Id = "Melinoe_4861"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus pasti bakal bilang kau tak melewatkan banyak hal, meski dia mungkin fana yang paling sering kehujanan sepanjang sejarah. Kalau aku sendiri, sih, cukup menyukainya."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutRain01"
    }
    {
      Id = "Icarus_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga. Malah sempat mencicipinya berkat Ramuan Ektoplasmikmu. Dan bahkan sekarang, aku masih menikmati pemandangan dan suaranya... serta bagaimana hujan membasahi rambutmu."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutRain01"
    }
    {
      Id = "Melinoe_4862"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rambutku pasti terlihat seperti ranting mati, Icarus."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutRain01"
    }
    {
      Id = "Icarus_0460"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak bagiku."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutRain01"
    }
    {
      Id = "Icarus_0461"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah mengira sang dewi perburuan bakal ada {#Emph}di sini {#Prev}di tengah-tengah semua kekacauan ini. Kukira mereka menyibukkannya dengan menembak sasaran dari jauh di Olympus! Suara nyanyiannya merdu."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_4863"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang merdu. Artemis seharusnya memantau kami, tapi dia membantuku menjaga punggungku. Entah bagaimana aku bisa mengenal dewa-dewi lain kalau bukan karenanya."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutArtemisSinging01"
    }
    {
      Id = "Icarus_0462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian bersepupu tapi lebih seperti saudara kandung, ya? Pasti menenangkan punya seseorang seperti itu yang selalu menjagamu."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_4864"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tadi itu nada {#Emph}cemburu?"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutArtemisSinging01"
    }
    {
      Id = "Icarus_0463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lebih ke rasa minder. Tapi sudah hilang, kok!"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutArtemisSinging01"
    }
    {
      Id = "Icarus_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihatmu sehat kembali, Yang Mulia. Entah denganmu, tapi bagiku pertempuran semalam berat sekali! Para awak kapal perang Chronos itu sepertinya tak kenal lelah."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutGrace01"
    }
    {
      Id = "Melinoe_4584"
      InheritFrom = "BaseNarrative"
      DisplayName = "Icarus, kukira sudah kubilang kalau aku bukan {#Emph}Yang Mulia{#Prev}. Aku memang Putri Dunia Bawah sejak lahir, tapi di sini aku melayani Sang Gaib, sama sepertimu."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutGrace01"
    }
    {
      Id = "Icarus_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu, hanya saja aku tak mau diistimewakan di sini. Arwah lain tampaknya selalu sopan padamu. Lagipula, aku {#Emph}suka {#Prev}memanggilmu Yang Mulia! Asal kau tak keberatan."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutGrace01"
    }
    {
      Id = "Melinoe_4585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Asal jangan terlalu sering saja, kalau begitu."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutGrace01"
    }
    {
      Id = "Icarus_0451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baik, Yang— baik."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutGrace01"
    }
    {
      Id = "Icarus_0554"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perkakas di sana itu, benaran untukku? Semuanya kelihatan begitu mengilap. Dari mana kita bisa {#Emph}dapat {#Prev}semua itu?"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutTools01"
    }
    {
      Id = "Melinoe_4868"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anggap saja hadiah dari Persimpangan, Icarus. Kau menempa anugerah Bumi menjadi benda-benda menakjubkan, jadi sudah sepantasnya kau memiliki peralatan terbaik."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutTools01"
    }
    {
      Id = "Icarus_0555"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti akan kucoba, terima kasih banyak. Aku sebenarnya agak terikat dengan perkakas usang yang sudah lama kupakai ini, tapi mereka mungkin memang butuh istirahat."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutTools01"
    }
    {
      Id = "Melinoe_4869"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita semua juga butuh, bukan!"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutTools01"
    }
    {
      Id = "Icarus_0464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kau tahu ke mana Tuan Odysseus pergi? Aku seharusnya melapor malam ini, tapi aku belum melihatnya belakangan ini..."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutOdysseusWandering01"
    }
    {
      Id = "Melinoe_4865"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa dia ada urusan pribadi yang harus diselesaikan. Aku tak yakin kapan dia akan kembali. Apa laporanmu ada hal yang mendesak?"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutOdysseusWandering01"
    }
    {
      Id = "Icarus_0465"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, hanya saja... entahlah. Saat dia tak ada, timbul rasa cemas kalau dia takkan kembali lagi. Dia berjiwa pengelana, dan... bukankah keluarganya ada di tempat lain?"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutOdysseusWandering01"
    }
    {
      Id = "Melinoe_4866"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tergantung keluarga mana yang kaumaksud! Dia tidak terikat pada Persimpangan sama seperti dirimu. Kau selalu boleh kembali selama kau diterima di sini, dan kurasa dia juga akan kembali."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutOdysseusWandering01"
    }
    {
      Id = "Icarus_0466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seperti halnya kau mengunjungi keluargamu dan tetap kembali ke sini..."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutOdysseusWandering01"
    }
    {
      Id = "Melinoe_4867"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutOdysseusWandering01"
    }
    {
      Id = "Icarus_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pria jangkung di dekat permadani besar itu... bukankah itu sang {#Emph}Kematian Tak Terelakkan? {#Prev}Kelihatannya lebih ramah dari yang kubayangkan, melihat betapa akrabnya kalian berdua."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutMoros01"
    }
    {
      Id = "Melinoe_4528"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Moros adalah tamu kita, dan permadani di sampingnya memuat kehendak Tiga Moirae. Keluarganya berada dalam kesulitan yang serupa denganku. Kau mau berkenalan dengannya?"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutMoros01"
    }
    {
      Id = "Icarus_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}jangan{#Prev}, kami, {#Emph}umm{#Prev}... kami pernah bertemu sebelumnya. Meski kurasa dia takkan mengingatku. Malah lebih baik begitu! Aku cuma tak menyangka akan melihatnya lagi... apalagi di sini. Syukurlah dia baik-baik saja!"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutMoros01"
    }
    {
      Id = "Melinoe_0061_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia memang baik-baik saja."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutMoros01"
    }
    {
      Id = "Melinoe_4528_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Moros adalah tamu kita, dan permadani di sampingnya memuat kehendak Tiga Moirae. Kau mau berkenalan dengannya?"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutMoros01_B"
    }
    {
      Id = "Icarus_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kadang memikirkan rasanya menjadi seorang dewa. Pernahkah kau membayangkan bagaimana hidupmu jika terlahir sebagai manusia fana? Kau mungkin bakal berakhir di Elysium."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutMortality01"
    }
    {
      Id = "Melinoe_4858"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di antara para pahlawan terhebat bangsamu? Aku tak begitu yakin. Jika aku terlahir sebagai manusia fana, kurasa... aku akan bekerja keras menekuni sesuatu seumur hidupku. Berusaha melampaui batas kemampuanku dan orang lain."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutMortality01"
    }
    {
      Id = "Icarus_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meli, itu hampir sama suramnya dengan hidupku, padahal aku tak bisa memilih. Sebagian besar orang fana bekerja hanya untuk bertahan hidup... tapi kenikmatan dunialah yang kami cari, bukan kerja kerasnya."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutMortality01"
    }
    {
      Id = "Melinoe_4859"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Namun di sinilah dirimu sebagai sesosok Arwah, berusaha melampaui keahlian ayahmu yang seorang empu perajin, sembari bertarung melawan legiun sang Titan. Hanya untuk bertahan hidup?"
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutMortality01"
    }
    {
      Id = "Icarus_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, kau benar juga, maaf. Tadi itu dorongan khas manusia fana yang suka mengatur hidup orang lain. Kami sendiri jarang menemukan tujuan hidup kami, apalagi orang lain. Aku penasaran kau bakal hebat dalam hal apa..."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutMortality01"
    }
    {
      Id = "Melinoe_5908"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin menjinakkan binatang buas..."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutMortality01"
    }
    {
      Id = "Icarus_0455"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Itu... mengerikan sekali."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutMortality01"
    }
    {
      Id = "Icarus_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lucu rasanya... kami manusia fana menghabiskan hidup mencari satu jiwa yang ingin kami temani sepanjang sisa malam kami; cinta abadi selamanya, tapi... kenyataannya itu mungkin cuma tiga puluh, empat puluh tahun. Pasti rasanya jauh berbeda bagi para dewa."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutRelationships01"
    }
    {
      Id = "Melinoe_4850"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menuntut seluruh cinta dari seseorang... rasanya egois sekali. Nemesis pasti tidak akan setuju. Pemahamanku adalah kita semua punya kapasitas berbeda untuk berbagai jenis cinta. Malah kurasa aku punya cukup banyak cinta untukmu sekarang, Icarus."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutRelationships01"
    }
    {
      Id = "Icarus_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau punya cukup banyak, tunggu maksudmu {#Emph}cinta{#Prev}, untuk{#Emph}ku? {#Prev}Padahal pasti ada orang lain yang kau sukai di sekitar sini, dalam artian jenis-cinta-yang-utama itu. Tapi bagaimana kalau... aku punya semua cinta ini hanya untuk{#Emph}mu{#Prev}, dan tak ada yang lain...?"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutRelationships01"
    }
    {
      Id = "Melinoe_4851"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu aku sangat beruntung, meski kupikir kau juga pasti punya lebih banyak lagi untuk diberikan. Dan kau punya waktu sekeabadian untuk menemukan siapa saja yang pantas menerimanya. Untuk saat ini, kau harus puas denganku saja."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutRelationships01"
    }
    {
      Id = "Icarus_0444"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sudah lebih dari cukup untukku, Meli."
      Speaker = "Icarus"
      Event = "IcarusHomeAboutRelationships01"
    }
    {
      Id = "Melinoe_4852"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin saja."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutRelationships01"
    }
    {
      Id = "Icarus_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "Badai yang menyelimuti puncak Gunung Olimpus sudah mereda...! Kukira akhirnya aku bisa melihat Typhon, tapi {#Emph}ternyata tidak! {#Prev}Apa yang terjadi di sana?"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_4844"
      InheritFrom = "BaseNarrative"
      DisplayName = "Badainya hilang karena Typhon sendiri sudah lenyap. Dia tampaknya semakin murka setiap malamnya. Pilihannya cuma dia yang musnah, atau keluargaku beserta rumah mereka."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutTyphonDeath01"
    }
    {
      Id = "Icarus_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti bercanda! Dia lenyap dalam artian, benar-benar lenyap? Bukan bersembunyi, tertidur, atau semacamnya? {#Emph}Wah! {#Prev}Itu {#Emph}hebat sekali! {#Prev}Tapi kenapa kau di sini? Seharusnya kau sedang berpesta bersama para Olimpus lainnya sekarang!"
      Speaker = "Icarus"
      Event = "IcarusHomeAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_4845"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada beberapa hal yang perlu kuurus."
      Speaker = "Melinoe"
      Event = "IcarusHomeAboutTyphonDeath01"
    }
    {
      Id = "Icarus_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang melawan Chronos, ini benar-benar {#Emph}berakhir{#Prev}, kan? Suasana di tempat ini sudah berbeda, ketegangannya sirna, para Arwah lain sampai jingkrak-jingkrak kegirangan! Kau {#Emph}berhasil{#Prev}...!"
      Speaker = "Icarus"
      Event = "IcarusHomePostTrueEnding01"
    }
    {
      Id = "Melinoe_4846"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja, tapi... masih banyak yang harus dilakukan. Tindakan pencegahan untuk memastikan apa yang terjadi kemarin tak akan pernah terulang lagi."
      Speaker = "Melinoe"
      Event = "IcarusHomePostTrueEnding01"
    }
    {
      Id = "Icarus_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meli, bisakah kau luangkan waktu untuk istirahat? Tugasmu akhirnya selesai! Apa yang akan kau lakukan sekarang, dengan seluruh sisa keabadian yang membentang di depanmu?"
      Speaker = "Icarus"
      Event = "IcarusHomePostTrueEnding01"
    }
    {
      Id = "Melinoe_4847"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah kubilang, masih banyak yang harus kulakukan."
      Speaker = "Melinoe"
      Event = "IcarusHomePostTrueEnding01"
    }
    {
      Id = "Icarus_0424"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan maksudku begitu... maaf."
      Speaker = "Icarus"
      Event = "IcarusHomePostTrueEnding01"
    }
    {
      Id = "Icarus_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal kau tahu, kukira begitu Chronos disingkirkan dan Raja serta Ratu Bawah Tanah kembali, kau harus tinggal bersama mereka di Graha Hades. Menjadi putri sebagaimana takdirmu sejak awal."
      Speaker = "Icarus"
      Event = "IcarusHomePostTrueEnding02"
    }
    {
      Id = "Melinoe_4848"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir aku sudah menjadi seorang putri. Graha ayahku memang sangat megah dan mengagumkan, tapi di {#Emph}sini{#Prev}lah rumahku, bukan di sana. Dan kurasa aku akan cukup sering bertemu orang tua dan kakakku."
      Speaker = "Melinoe"
      Event = "IcarusHomePostTrueEnding02"
    }
    {
      Id = "Icarus_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}benar juga! {#Prev}Bagaimana rasanya bertemu Zagreus? Apakah dia sehebat kisah-kisah bisikan tentang keperkasaannya dan segala macamnya itu?"
      Speaker = "Icarus"
      Event = "IcarusHomePostTrueEnding02"
    }
    {
      Id = "Melinoe_4849"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau kuberi tahu, aku terpaksa harus menghabisimu."
      Speaker = "Melinoe"
      Event = "IcarusHomePostTrueEnding02"
    }
    {
      Id = "Icarus_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah! {#Prev}Baiklah kalau begitu!"
      Speaker = "Icarus"
      Event = "IcarusHomePostTrueEnding02"
    }
    {
      Id = "Icarus_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar para Arwah bilang ada sesuatu yang berubah di Olimpus... bahwa Sang Tiga Takdir sendiri yang memutuskan para dewa akan memerintah dengan lebih santai? Kedengarannya... {#Emph}tidak biasa."
      Speaker = "Icarus"
      Event = "IcarusHomePostEpilogue01"
    }
    {
      Id = "Melinoe_4856"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir kata {#Emph}segera {#Prev}di sana merujuk pada waktu para dewa bukan manusia fana, tapi... apa yang kudengar juga kurang lebih sama. Di fajar era baru ini, manusia fana akan menentukan jalan hidup mereka sendiri."
      Speaker = "Melinoe"
      Event = "IcarusHomePostEpilogue01"
    }
    {
      Id = "Icarus_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suatu era di mana para dewa maupun Takdir tak lagi mendikte setiap detik kehidupan, atau kematian kita. Sulit dibayangkan. Kalau begitu, siapa yang akan kita salahkan saat semuanya berantakan, ya?"
      Speaker = "Icarus"
      Event = "IcarusHomePostEpilogue01"
    }
    {
      Id = "Melinoe_4857"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku yakin kau pasti akan menemukan seseorang untuk disalahkan!"
      Speaker = "Melinoe"
      Event = "IcarusHomePostEpilogue01"
    }
    {
      Id = "Melinoe_4853"
      InheritFrom = "BaseNarrative"
      DisplayName = "Icarus, kapan kau menyadari ayahmu bukanlah sosok yang kau kira? Kedengarannya kau tumbuh dengan selalu ingin memenuhi harapannya terhadapmu, meski di suatu titik kau berhenti melakukannya."
      Speaker = "Melinoe"
      Event = "IcarusHomePostEpilogue02"
    }
    {
      Id = "Icarus_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, mungkin saat aku menemuinya setelah aku mati. Dia tampak {#Emph}begitu {#Prev}kecewa; aku sempat benar-benar mengira dia marah karena aku merusak sayap berharganya itu. Tapi aku tetap bekerja untuknya."
      Speaker = "Icarus"
      Event = "IcarusHomePostEpilogue02"
    }
    {
      Id = "Melinoe_4854"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Begitu rupanya. Kepala Sekolah, dia sudah seperti seorang ibu bagiku, tapi... dia selalu menegaskan bahwa dia bukanlah ibuku. Aku tak pernah benar-benar paham alasannya."
      Speaker = "Melinoe"
      Event = "IcarusHomePostEpilogue02"
    }
    {
      Id = "Icarus_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyayanginya, aku tahu itu. Dan dia telah membuatmu melalui banyak hal, aku tahu itu juga! Kalau seseorang menjadi bagian yang begitu besar dalam hidupmu begitu lama, lama-kelamaan segalanya memang jadi agak rumit, kan?"
      Speaker = "Icarus"
      Event = "IcarusHomePostEpilogue02"
    }
    {
      Id = "Melinoe_4855"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, kurasa begitu..."
      Speaker = "Melinoe"
      Event = "IcarusHomePostEpilogue02"
    }
    {
      Id = "Melinoe_4574"
      InheritFrom = "BaseNarrative"
      DisplayName = "Icarus, penampilanmu... Ramuan Ektoplasma itu. Kau meminumnya, dan berhasil...! Boleh aku... apa tidak apa-apa kalau aku...?"
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Icarus_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku baru saja mau menanyakan hal yang sama padamu. Ini tidak seperti {#Emph}apa pun {#Prev}yang pernah kurasakan sejak aku hidup! Bahkan {#Emph}saat itu pun tidak! {#Prev}Dulu aku menganggap remeh semua ini..."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Melinoe_4576"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya apa yang membuat malam ini begitu istimewa? Kukira kau akan menyimpan Ramuan itu untuk peristiwa langka sekali seumur keabadian."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Icarus_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat berpikir begitu. Dan kemudian aku berpikir seandainya aku bisa {#Emph}menyentuhmu{#Prev}, itu sudah menjadi peristiwa langka bagiku. Lalu aku sadar, aku tak ingin menunggu lagi. Kuminum Ramuannya begitu tahu kau ada di sini. Rasanya tidak buruk!"
      Speaker = "Icarus"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Melinoe_4577"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah bersumpah akan melakukannya perlahan-lahan. Bagaimana kalau aku tak sempat bicara denganmu malam ini? Ramuan itu pasti akan terbuang sia-sia!"
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Icarus_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar, kau benar, hanya saja... kau ada {#Emph}di sini{#Prev}, dan... degup jantungku berpacu kencang. Meli, bolehkah aku... mendekapmu dalam pelukanku?"
      Speaker = "Icarus"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Melinoe_4579"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa..."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Melinoe_4583"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terbanglah bebas dan hiduplah, Icarus."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Melinoe_4578"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku hanya tak ingin melangkah terlalu jauh, seperti yang pernah kita alami sebelumnya. Efek sampingnya bisa makin parah, dan... sepertimu, membayangkannya saja aku tak sanggup. Kurasa sebaiknya kau rasakan dinginnya angin dan cipratan air laut selagi kau masih bisa."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Icarus_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang ingin melakukan itu. Dan aku pun sempat menggenggam tanganmu. Aku rela tinggal di sini selamanya andai bisa, tapi sebaiknya kumanfaatkan ini sebaik-baiknya karena takkan bertahan lama. Jadi pamit dulu, Meli."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Melinoe_4580"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sangat senang jika kau melakukannya. Kau mungkin akan merasakan sensasi aneh, tapi aku akan selembut mungkin. Tolong beri tahu aku jika kau mulai merasa tidak nyaman sedikit pun."
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Melinoe_4581"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Menghela napas> {#Prev}Menyenangkan sekali, detak jantungmu ini. Dan kau masih sangat hangat, tahu. Kalau bukan karena itu, mungkin kukira kau sudah mati! Kau tak bergerak, tak bersuara... kau baik-baik saja?"
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Icarus_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Pasti seperti inilah rasanya berada di Elysium... Meli, aku {#Emph}jauh {#Prev}lebih dari sekadar baik-baik saja, aku—aku hanya menikmati setiap momennya selagi bisa. Bagaimana denganmu? Fakta bahwa kau masih di sini kurasa pertanda baik...?"
      Speaker = "Icarus"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Melinoe_4582"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau boleh menganggapnya begitu. Tapi, {#Emph}astaga{#Prev}, kau mulai mendingin sekarang, dan... rona pucat kulitmu mulai berubah. Khasiat ramuannya mulai memudar. Jika bergegas, kau masih bisa merasakan hembusan angin dingin dan cipratan laut itu!"
      Speaker = "Melinoe"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Icarus_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku jauh lebih suka tinggal bersamamu di sini... tapi aku tak ingin menahanmu, dan aku pasti menyesal jika tak terbang selagi sempat seperti ini. Kau luar biasa, Meli."
      Speaker = "Icarus"
      Event = "IcarusBecomingCloser01"
    }
    {
      Id = "Icarus_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepengamatanku, jumlah kapal perang yang menuju Olympus hampir selalu sama dari malam ke malam. Misi mereka sama sekali tak tampak terganggu."
      Speaker = "Icarus"
      Event = "IcarusWithOdysseus01"
    }
    {
      Id = "Odysseus_0436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tujuan mereka adalah memutus jalur perairan dan memecah konsentrasi Olympus yang serba terbatas. Teruslah ganggu mereka sebisa mungkin, anak muda. Tapi jika para Harpy berkerumun terlalu rapat, mundurlah."
      Speaker = "Odysseus"
      Event = "IcarusWithOdysseus01"
    }
    {
      Id = "Icarus_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siap, laksanakan, Tuan! Kapal-kapal itu tak siap menghadapi penyerang dari langit, dan para Harpy itu belum bisa mengejarku. Baiklah, aku berangkat!"
      Speaker = "Icarus"
      Event = "IcarusWithOdysseus01"
    }
    {
      Id = "Odysseus_0437"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga perburuanmu sukses di luar sana!"
      Speaker = "Odysseus"
      Event = "IcarusWithOdysseus01"
    }
    {
      Id = "Odysseus_0705"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bagaimanapun juga, anak muda, kau sudah berusaha dengan baik. Kita tak selalu tahu ke mana tujuan kita, tapi kau {#Emph}bisa {#Prev}merasakan apakah kau sedang menuju ke arah yang kau inginkan. Dan jangan terlalu terburu-buru sampai ke sana jika memang tak perlu."
      Speaker = "Odysseus"
      Event = "IcarusWithOdysseus02"
    }
    {
      Id = "Icarus_0467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi aku belum sampai ke mana-mana, Tuan. Kupikir andai aku bisa belajar terbang, akhirnya aku bisa pergi ke mana pun sesuka hatiku. Namun makin jauh aku pergi, makin besar rasa ingin pulang! Apa gunanya kalau begitu? Aku masih belum yakin."
      Speaker = "Icarus"
      Event = "IcarusWithOdysseus02"
    }
    {
      Id = "Odysseus_0706"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunanya adalah untuk menemukan tempatmu bernaung. Jika kau tak pernah pergi, kau akan selalu penasaran ada apa lagi di luar sana untukmu. Kau pulang dengan membawa kebijaksanaan dari pengalaman itu."
      Speaker = "Odysseus"
      Event = "IcarusWithOdysseus02"
    }
    {
      Id = "Icarus_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi semakin sering mengembara, semakin bijak pula kita, ya? Padahal aku sedang bicara dengan sang Ahli Taktik Ulung. Rasanya mustahil aku belajar lebih banyak dari terbang kesana-kemari di luar {#Emph}sana {#Prev}dibandingkan belajar langsung dari {#Emph}Anda."
      Speaker = "Icarus"
      Event = "IcarusWithOdysseus02"
    }
    {
      Id = "Odysseus_0707"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar kuambil sayap itu kalau kau tak menginginkannya, nak."
      Speaker = "Odysseus"
      Event = "IcarusWithOdysseus02"
    }
    {
      Id = "Icarus_0469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan harap, Tuan!"
      Speaker = "Icarus"
      Event = "IcarusWithOdysseus02"
    }
    {
      Id = "Icarus_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku cuma, {#Emph}eh{#Prev}, beres-beres sedikit. Tak bermaksud mengganggu, Dewi, {#Emph}umm... {#Prev}Hei! Aku suka sayapmu! Milikku bukan sayap asli. Padahal sebelumnya aku punya sayap yang terbuat dari bulu asli, lebih mirip punyamu... tapi kualitasnya kalah jauh."
      Speaker = "Icarus"
      Event = "IcarusWithEris01"
    }
    {
      Id = "Eris_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana kalau lain kali pas lihat barang-barangku, jangan disentuh sama sekali, paham kan, anak burung? Sekarang enyahlah dari hadapanku dan awas lidahmu jangan sampai keseleo waktu mau terbang naik!"
      Speaker = "Eris"
      Event = "IcarusWithEris01"
    }
    {
      Id = "Icarus_0471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beres! Aku pamit. {#Emph}Sampai jumpa!"
      Speaker = "Icarus"
      Event = "IcarusWithEris01"
    }
    {
      Id = "Eris_0364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dah sana!"
      Speaker = "Eris"
      Event = "IcarusWithEris01"
    }
    {
      Id = "Icarus_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Lalu, aku ingin berterima kasih pada Anda, Nyonya. Karena telah menampung dan mengizinkanku kembali; serta mempercayakan tugas apa pun padaku! Kebanyakan Arwah tak seberuntung itu."
      Speaker = "Icarus"
      Event = "IcarusWithHecate01"
    }
    {
      Id = "Hecate_0877"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, tak perlu merendah begitu, Icarus, sebelum aku berubah pikiran dan mengusirmu. Ini Crossroads, bukan Elysium! Kehidupan Arwah di sini bisa dibilang cukup berat... dan hanya segelintir yang bertahan lama."
      Speaker = "Hecate"
      Event = "IcarusWithHecate01"
    }
    {
      Id = "Icarus_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bersyukur memiliki tugas untuk dikerjakan, dan menjadi bagian dari tempat ini. Walau terkadang sesaat setelah lepas landas, aku takut takkan bisa menemukan jalan pulang..."
      Speaker = "Icarus"
      Event = "IcarusWithHecate01"
    }
    {
      Id = "Hecate_0878"
      InheritFrom = "BaseNarrative"
      DisplayName = "Buang jauh rasa takut itu. Mereka yang membutuhkan atau yang tetap menjaga hubungan baik dengan kami akan selalu disambut dan aman di sini."
      Speaker = "Hecate"
      Event = "IcarusWithHecate01"
    }
    {
      Id = "Icarus_0477"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sangat bersyukur. Dan, aku harus pergi sekarang! Mari, Nyonya!"
      Speaker = "Icarus"
      Event = "IcarusWithHecate01"
    }
    {
      Id = "Icarus_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang bertemu denganmu lagi, Meli. Aku pamit terbang dulu, tapi aku pasti akan memperhatikanmu dari atas sana."
      Speaker = "Icarus"
      Event = "IcarusHomeChat01"
    }
    {
      Id = "Icarus_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau berniat naik ke permukaan malam ini, mungkin kita bisa bertemu, ya?"
      Speaker = "Icarus"
      Event = "IcarusHomeChat02"
    }
    {
      Id = "Icarus_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih banyak pada kalian semua karena telah menyambutku kembali, dan selalu menyenangkan melihat {#Emph}dirimu {#Prev}di sini."
      Speaker = "Icarus"
      Event = "IcarusHomeChat03"
    }
    {
      Id = "Icarus_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saatnya kembali bertempur, kan Meli? Aku akan berangkat duluan dan melihat apa yang bisa kulakukan."
      Speaker = "Icarus"
      Event = "IcarusHomeChat04"
    }
    {
      Id = "Icarus_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya pendaratan dan lepas landasku semakin lihai di sini. Mau lihat?"
      Speaker = "Icarus"
      Event = "IcarusHomeChat05"
    }
    {
      Id = "Icarus_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus mampir untuk mengambil perbekalan tambahan, dan mungkin untuk menyapamu. Sekarang aku berangkat!"
      Speaker = "Icarus"
      Event = "IcarusHomeChat06"
    }
    {
      Id = "Icarus_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pantau terus Paluku di luar sana, ya? Kuharap barang-barang itu ngebantu."
      Speaker = "Icarus"
      Event = "IcarusHomeChat07"
    }
    {
      Id = "Icarus_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu sekarang bukan saatnya ngobrol lama-lama, tapi sekadar bertegur sapa begini saja rasanya melegakan."
      Speaker = "Icarus"
      Event = "IcarusHomeChat08"
    }
    {
      Id = "Icarus_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru saja selesai menambal sayap-sayap ini! Sekarang saatnya mengujinya lagi."
      Speaker = "Icarus"
      Event = "IcarusHomeChat09"
    }
    {
      Id = "Icarus_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lucu juga, rasanya aku mulai gelisah tiap kali sayap-sayap ini dibiarkan menganggur."
      Speaker = "Icarus"
      Event = "IcarusHomeChat10"
    }
    {
      Id = "Icarus_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma mau menyapa sebelum aku berangkat malam ini. Hati-hati di jalan, ya?"
      Speaker = "Icarus"
      Event = "IcarusHomeChat11"
    }
    {
      Id = "Icarus_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu semalam kamu bakal sampai ke sana, dan kurasa kali ini kamu juga bakal tembus sampai ujung."
      Speaker = "Icarus"
      Event = "IcarusHomeChat12"
    }
    {
      Id = "Icarus_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kita bakal ketemu di Celah malam ini, atau kamu cuma berputar di Bawah Tanah?"
      Speaker = "Icarus"
      Event = "IcarusHomeChat13"
    }
    {
      Id = "Icarus_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Laporanku pada Tuan Odiseus sudah selesai, jadi sebaiknya aku segera kembali ke luar sana."
      Speaker = "Icarus"
      Event = "IcarusHomeChat14"
    }
    {
      Id = "Icarus_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita lihat apa aku bisa meliuk menghindari semua ranting di atas sana saat keluar nanti, ya?"
      Speaker = "Icarus"
      Event = "IcarusHomeChat15"
    }
    {
      Id = "Icarus_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan bisa bertemu denganmu di sini, dan mungkin malam ini kita juga ketemu di atas, ya?"
      Speaker = "Icarus"
      Event = "IcarusHomeChat16"
    }
    {
      Id = "Icarus_0483"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya semua berjalan baik-baik saja di sekitar sini. Terutama di dekat air mancur ini."
      Speaker = "Icarus"
      Event = "IcarusHomeChat17"
    }
    {
      Id = "Icarus_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sempat berharap kamu mampir menyapa. Sampai ketemu lagi di luar sana suatu malam nanti, ya?"
      Speaker = "Icarus"
      Event = "IcarusHomeChat18"
    }
    {
      Id = "Icarus_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semalam aku tak melihatmu di Celah, tapi senang bisa bertemu denganmu di sini."
      Speaker = "Icarus"
      Event = "IcarusHomeChat19"
    }
    {
      Id = "Icarus_0486"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar semalam aksimu hebat sekali, kerja bagus, Meli! Mau langsung berangkat lagi, ya?"
      Speaker = "Icarus"
      Event = "IcarusHomeChat20"
    }
    {
      Id = "Icarus_0294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak sempat kuperhatikan tadi."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusGatherReactionVoiceLines"
    }
    {
      Id = "Icarus_0295"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahan lagi?"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusGatherReactionVoiceLines"
    }
    {
      Id = "Icarus_0296"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ambil saja semuanya."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusGatherReactionVoiceLines"
    }
    {
      Id = "Icarus_0297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang berguna?"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusGatherReactionVoiceLines"
    }
    {
      Id = "Icarus_0537"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kulihat itu!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusGatherReactionVoiceLines"
    }
    {
      Id = "Icarus_0290"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nemu sesuatu?"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusGatherReactionVoiceLines"
    }
    {
      Id = "Icarus_0291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dapat yang kamu butuhkan?"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusGatherReactionVoiceLines"
    }
    {
      Id = "Icarus_0292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hasil jarahan dari lapangan!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusGatherReactionVoiceLines"
    }
    {
      Id = "Icarus_0293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar kutangani!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusGatherReactionVoiceLines"
    }
    {
      Id = "Icarus_0516"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Meluncur ke Persimpangan."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusExorcismReactionVoiceLines"
    }
    {
      Id = "Icarus_0517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ketemu yang pintar!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusExorcismReactionVoiceLines"
    }
    {
      Id = "Icarus_0518"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rekrutan baru."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusExorcismReactionVoiceLines"
    }
    {
      Id = "Icarus_0519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi {#Emph}begitu {#Prev}caramu melakukannya."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusExorcismReactionVoiceLines"
    }
    {
      Id = "Icarus_0493"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Meli, apa yang terjadi? Jangan pergi...!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusDeathReactionVoiceLines"
    }
    {
      Id = "Icarus_0494"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia lenyap? Dia lenyap, dia... {#Emph}aargh..."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusDeathReactionVoiceLines"
    }
    {
      Id = "Icarus_0556"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah {#Prev}sialan, Meli, {#Emph}jangan! {#Prev}Kembalilah!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusDeathReactionVoiceLines"
    }
    {
      Id = "Icarus_0557"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang menimpamu tadi, ke mana perginya dirimu?"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.IcarusDeathReactionVoiceLines"
    }
    {
      Id = "Icarus_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kabari aku hasilnya nanti!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0054"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu takkan kecewa."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pilihan bagus."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini, buatmu."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati, ya?"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kok aku bisa tahu, ya...?"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua buatmu."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga bisa membantu."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, mantap."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0526"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beres, siap tempur!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0527"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ide bagus."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0541"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Paham!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0538"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siap laksanakan!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0539"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siap, Nona!"
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0524"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati pakainya."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Icarus"
    }
    {
      Id = "Icarus_0525"
      InheritFrom = "BaseSubtitle"
