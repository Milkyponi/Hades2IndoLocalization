  Texts = [
    {
      Id = "MelinoeField_3857"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gigaros... ini pasti {#Emph}dia...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.GigarosFoundVoiceLines"
    }
    {
      Id = "MelinoeField_5120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan sekadar mimpi... intisarinya nyata..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.GigarosFoundVoiceLines"
    }
    {
      Id = "Zagreus_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Cukup sudah, bakal kutusuk kau."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ChronosCorneredVoiceLines"
    }
    {
      Id = "Chronos_1306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak, tunggu!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosCorneredVoiceLines"
    }
    {
      Id = "MelinoeField_5141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Gasp> {#Prev}A... aku mengingat... semua itu?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.SanctumToBedroomVoiceLines"
    }
    {
      Id = "MelinoeField_5214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hidupku... andai bisa berjalan seperti itu...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.SanctumToBedroomVoiceLines"
    }
    {
      Id = "MelinoeField_5142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dewa-dewi... Zagreus... apa berhasil...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.SanctumToBedroomVoiceLines"
    }
    {
      Id = "MelinoeField_5143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang sedang terjadi di luar sana...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.SanctumToBedroomVoiceLines"
    }
    {
      Id = "Chronos_1377"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lanjutkan kalau begitu..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PromptFamilyRescueVoiceLines"
    }
    {
      Id = "Hades_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Augh...! <Gasp>"
      Speaker = "Hades"
      Event = "GlobalVoiceLines.FamilyEntranceVoiceLines"
    }
    {
      Id = "MelinoeField_3575"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayah! Ibu... Kakak...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamilyEntranceVoiceLines"
    }
    {
      Id = "Persephone_0009"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Gasp> Augh... {#Prev}Hades... aku..."
      Speaker = "Persephone"
      Event = "GlobalVoiceLines.FamilyUnfrozenVoiceLines"
    }
    {
      Id = "MelinoeField_4971"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ibu...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamilyUnfrozenVoiceLines"
    }
    {
      Id = "Zagreus_0112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Gasp>"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.FamilyUnfrozenVoiceLinesZag"
    }
    {
      Id = "Hades_0382"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, tolong lepaskan rantai ini dariku, agar kita bisa segera beres-beres!"
      Speaker = "Hades"
      Event = "GlobalVoiceLines.DeathAreaRestorationVoiceLines"
    }
    {
      Id = "Storyteller_0523"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Maka, sang Putri Kematian tetap tinggal di Kediaman Hades bersama sang Titan Waktu dan yang lainnya, demi membantu memulihkan sebanyak mungkin hal yang belum sirna selamanya."
      Speaker = "Storyteller"
      Event = "GlobalVoiceLines.DeathAreaRestorationVoiceLines"
    }
    {
      Id = "Storyteller_0517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Raja dan Ratu Dunia Bawah yang sah lekas mengatur tugas yang relatif ringan ini, dan Arwah Orang Mati yang masih setia pun menyambut seruan mereka."
      Speaker = "Storyteller"
      Event = "GlobalVoiceLines.DeathAreaRestorationVoiceLines"
    }
    {
      Id = "Storyteller_0524"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mereka bersama sang Titan memungut kembali kepingan-kepingan masa lalu..."
      Speaker = "Storyteller"
      Event = "GlobalVoiceLines.DeathAreaRestorationVoiceLines"
    }
    {
      Id = "Storyteller_0525"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...dan tak lama kemudian, Kediaman itu mulai kembali seperti sedia kala. Namun kemudian, panggilan dari Olympus tiba, dan sang Putri tahu masa tinggalnya telah usai..."
      Speaker = "Storyteller"
      Event = "GlobalVoiceLines.DeathAreaRestorationVoiceLines"
    }
    {
      Id = "MelinoeField_4278"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Sigh> {#Prev}Yah, inilah saatnya..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TimeToGoVoiceLines"
    }
    {
      Id = "Chronos_1335"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah. Aku pergi dulu."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosEndCreditsSendOffVoiceLines"
