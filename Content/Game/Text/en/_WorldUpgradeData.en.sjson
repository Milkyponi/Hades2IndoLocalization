  lang = "en"
  Texts = [
    {
      Id = "Melinoe_0528"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wahai Arwah yang mati, bahan-bahan di kuali, \n {#Emph}Dengarkanlah pintaku, wujudkan yang kucari."
      Speaker = "Melinoe"
      Event = "DefaultMajorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_0530"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Demi sinar rembulan dan debu tulang purba, \n {#Emph}Bangkitkan yang misterius di dalam kuali tembaga."
      Speaker = "Melinoe"
      Event = "DefaultMajorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_0531"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Api dan Bumi, antara surga dan neraka abadi, \n {#Emph}Wujudkan kehendakku; mantramu sempurnai."
      Speaker = "Melinoe"
      Event = "DefaultMajorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kumohon pada kalian, Arwah Bumi dan Malam, \n {#Emph}Enyahkan rasa sakit ini, agar kami dapat berjuang dalam kelam!"
      Speaker = "Melinoe"
      Event = "DefaultMajorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Demi hak kelahiranku, Kegelapan kuberi titah \n {#Emph}Bantu tugasku dan bidik target tanpa goyah."
      Speaker = "Melinoe"
      Event = "DefaultMajorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dengarkan aku, wahai Arwah, atas wewenangku: \n {#Emph}Utamakan dan laksanakan titahku nomor satu."
      Speaker = "Melinoe"
      Event = "DefaultMajorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1081"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Jika Waktu tak bisa dihentikan, biar kita buktikan; \n {#Emph}Jika darahku harus tertumpah, maka jadilah...!"
      Speaker = "Melinoe"
      Event = "DefaultMajorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_0532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Gelapnya Khaos, terangnya Rembulan, tunduklah pada kehendakku!"
      Speaker = "Melinoe"
      Event = "DefaultHubItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_0533"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pohon Kehidupan yang Agung, dengarkanlah isi pikiranku!"
      Speaker = "Melinoe"
      Event = "DefaultHubItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_0534"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Demi cahaya rembulan, mari bersama kita ubah kenyataan!"
      Speaker = "Melinoe"
      Event = "DefaultHubItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bergolaklah, karunia Bumi; kabulkan yang kucari!"
      Speaker = "Melinoe"
      Event = "DefaultHubItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1071"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kemarilah, Arwah yang Telah Mati, ada tugas untuk kalian!"
      Speaker = "Melinoe"
      Event = "DefaultHubItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sebagaimana kehendak Tiga Dewi Takdir, begitu pula jadinya...!"
      Speaker = "Melinoe"
      Event = "DefaultHubItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ibu pertiwi Gaia yang agung, dengarkanlah hasrat hatiku!"
      Speaker = "Melinoe"
      Event = "DefaultHubItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pilihanku telah bulat, jalanku telah pasti!"
      Speaker = "Melinoe"
      Event = "DefaultHubItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Demi darah dan kegelapan, terlaksanalah kehendakku!"
      Speaker = "Melinoe"
      Event = "DefaultHubItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kataskion aski!"
      Speaker = "Melinoe"
      Event = "DefaultMinorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1076_V2"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kataskion aski!"
      Speaker = "Melinoe"
      Event = "DefaultMinorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1076_V3"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kataskion aski!"
      Speaker = "Melinoe"
      Event = "DefaultMinorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1077"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Askion kataski!"
      Speaker = "Melinoe"
      Event = "DefaultMinorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1077_V2"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Askion kataski!"
      Speaker = "Melinoe"
      Event = "DefaultMinorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_2610"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Damname aision!"
      Speaker = "Melinoe"
      Event = "DefaultMinorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_2611"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Damnaski traxon!"
      Speaker = "Melinoe"
      Event = "DefaultMinorItem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1594"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wahai putri-putri Malam, penatap hari esok abadi, \n {#Emph}Bantu aku membalaskan duka keluarga kita ini."
      Speaker = "Melinoe"
      Event = "WorldUpgradeQuestLog.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1596"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Nihil. Mereka tak mendengarkanku."
      Speaker = "Melinoe"
      Event = "WorldUpgradeQuestLog.RevealReactionVoiceLines"
    }
    {
      Id = "Hecate_0476"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada pengaruhnya...?"
      Speaker = "Hecate"
      Event = "WorldUpgradeQuestLog.RevealReactionVoiceLines"
    }
    {
      Id = "Melinoe_1598"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa aku tahu bagaimana cara menjalankan kehendak Para Dewi Takdir..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeMorosUnlock.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_1595"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dengarkan aku, wahai Takdir Kematian, dengar suaraku dari kejauhan, \n {#Emph}Aku memohon kepadamu, di mana pun dirimu berada dalam kegelapan."
      Speaker = "Melinoe"
      Event = "WorldUpgradeMorosUnlock.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1597"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Di mana kau berada, Tuan Moros...?"
      Speaker = "Melinoe"
      Event = "WorldUpgradeMorosUnlock.RevealReactionVoiceLines"
    }
    {
      Id = "Hecate_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terkadang memang begitu jalannya."
      Speaker = "Hecate"
      Event = "WorldUpgradeMorosUnlock.RevealReactionVoiceLines"
    }
    {
      Id = "Melinoe_2823"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mampuslah Chronos... {#Prev}pasti ada caranya..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeTimeStop.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_4740"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Waktu melampaui batasnya, takkan kubiarkan bertahan; \n {#Emph}Dia harus dihentikan sesuai rancangan Dewi Takdir sekalian!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeTimeStop.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_4069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Typhon bukan bagian dari dunia ini..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeStormStop.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_4739"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Amarahmu, Monster, bakal tumpah bak darah yang mengalir; \n {#Emph}Kekuatan hidupmu musnah terlahap banjir!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeStormStop.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1346"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku harus mencari caraku sendiri untuk naik ke permukaan..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeAltRunDoor.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_2575"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kusingkirkan segel yang menjagaku selama ini, \n {#Emph}Kini ku siap menghadapi surga maupun neraka mati!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeAltRunDoor.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_1347"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisakah kutahan kutukan sakitku di permukaan...?"
      Speaker = "Melinoe"
      Event = "WorldUpgradeSurfacePenaltyCure.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_2576"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Darahku terikat takdir, namun bebas mengalir bagai mimpi. \n {#Emph}Bebaskan aku dari alam ini; jadilah kunciku kini!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeSurfacePenaltyCure.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_3071"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berutang kejernihan sebening kristal pada Narsisus..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeNarcissusWaters.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_3072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Di mana jiwa sekuntum bunga nan elok pernah berseri, \n {#Emph}Mengalirlah jernih kembali, wahai air; pulihkan ia seutuhnya lagi."
      Speaker = "Melinoe"
      Event = "WorldUpgradeNarcissusWaters.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_4824"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nona Medea butuh ini entah untuk apa..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeMedeaTears.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_4825"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mendidihlah, Air Mata Nestapa, dan kembalilah ke wujud asalmu."
      Speaker = "Melinoe"
      Event = "WorldUpgradeMedeaTears.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_3505"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dalam Berkah Gunung Olimpus kan kusingkap rahasia, \n {#Emph}Esensi elemen mereka, pembawa kemenanganku nan nyata."
      Speaker = "Melinoe"
      Event = "WorldUpgradeElementalBoons.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5595"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Singkapkanlah dalam Kitab Bayanganku pengetahuan agung yang kucari..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeBoonList.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5597"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Atas kehendak Malam, kan kuhadapi lawan-lawan yang jauh lebih perkasa..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeBossDifficultyT2.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5598"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Atas kehendak Malam, kan kuhadapi musuh-musuhku yang paling beringas..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeBossDifficultyT3.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5599"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Atas kehendak Malam, kan kuhadapi marabahaya paling mengerikan dari segalanya."
      Speaker = "Melinoe"
      Event = "WorldUpgradeBossDifficultyT4.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_0551"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pialang! Selamat datang di Persimpangan."
      Speaker = "Melinoe"
      Event = "WorldUpgradeMarket.PostRevealVoiceLines"
    }
    {
      Id = "Melinoe_0553"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pialang, tokomu makin luas saja!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeGiftsShop.PostRevealVoiceLines"
    }
    {
      Id = "Melinoe_2539"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senjata Nokturnal masih menyembunyikan sesuatu..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeWeaponUpgradeSystem.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_2574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sebagai pembawa Senjata Takdir Sang Malam nan abadi, \n {#Emph}Kucari Aspek-Aspek mereka yang masih tersembunyi."
      Speaker = "Melinoe"
      Event = "WorldUpgradeWeaponUpgradeSystem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_3488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Altar kita bisa disucikan..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeCardUpgradeSystem.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_3073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wahai Altar Abu tempatku bersujud dan berdiri, \n {#Emph}Penuhilah tujuanmu yang kupahami dalam hati."
      Speaker = "Melinoe"
      Event = "WorldUpgradeCardUpgradeSystem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_3444"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lewat pengetahuan Khaos Yang Mahakuasa, aku bisa menembus kehampaan..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeBountyBoard.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_3074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sebagaimana titah Khaos purba yang harus kupatuhi, \n {#Emph}Bangkitlah, monumen Malam; kan kuturuti!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeBountyBoard.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_0529"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wahai esensi Khaos, dengarkanlah suaraku bertutur, \n {#Emph}Dalam potensimu yang luas, pilihanku telah terukir teratur."
      Speaker = "Melinoe"
      Event = "WorldUpgradeBountyBoardRepeat.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_3410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mantra yang diajarkan oleh Ibu Kepala Sekolah kepadaku..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeFamiliarSystem.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_3506"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kepada sekalian sahabat satwaku dekat maupun jauh melintang, \n {#Emph}Mari saling melindungi sejiwa, hingga bekas luka terakhir hilang."
      Speaker = "Melinoe"
      Event = "WorldUpgradeFamiliarSystem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5722"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Frinos pasti bakal suka ini..."
      Speaker = "Melinoe"
      Event = "OnActivateFinishedFunctionArgs.VoiceLines"
    }
    {
      Id = "Melinoe_5600"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Karena para Hewan Pendampingku adalah sumber kekuatan, semoga kita semua bertambah kuat!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeFamiliarUpgradeSystem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Teknik metamorfosis dari Nyonya Sirke..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeFamiliarCostumeSystem.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_5437"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga para Hewan Pendampingku bisa berganti rupa jika mereka memang menghendakinya!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeFamiliarCostumeSystem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_3507"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pusaka Mahakarya Malam, kalian telah menampakkan diri kepadaku; \n {#Emph}Kini kulihat ikatan sejatimu dengan Sang Bumi nan syahdu."
      Speaker = "Melinoe"
      Event = "WorldUpgradeToolUpgradeSystem.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5565"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Petunjuk langsung dari para Takdir..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeChangeNextRunRNG.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_5566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sang Takdir meminta kita menentukan jalan mulai saat ini. \n {#Emph}Maka inilah jalanku; kan kutempuh tanpa ada rasa gentar di hati!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeChangeNextRunRNG.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5601"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sumur Kharon yang lama terlelap, bangkitlah kembali menembus malam!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeWellShops.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5602"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga seluruh altar musafir Dewa Hermes nan gesit muncul kembali!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeSurfaceShops.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5603"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mengalirlah merah kembali, wahai Kolam Pembersihan Tartaros!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeRestoreSellTraitShop.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5604"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Apa pun yang berkilau Emas akan segera ditemukan!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeBreakableValue1.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5605"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kembalilah, Kelelawar Mahatahu, dan dengarkanlah Kota Kematian!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeEphyraZoomOut.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_2783"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana caraku mencari jalan di Mourning Fields..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeFieldsRewardFinder.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_5606"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bangkitlah kembali, dahan-dahan di seantero Mourning Fields!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeFieldsRewardFinder.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_3070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu mengira dirinya tak bisa dihentikan. Kupikir sebaliknya."
      Speaker = "Melinoe"
      Event = "WorldUpgradeTimeSlowChronosFight.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_5607"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Waktu tak bisa dilawan, bahkan oleh dirinya sendiri."
      Speaker = "Melinoe"
      Event = "WorldUpgradeTimeSlowChronosFight.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5608"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Waktuku adalah milikku dan bukan milik siapa pun."
      Speaker = "Melinoe"
      Event = "WorldUpgradePauseChronosFight.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_2822"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Arms of Night menginginkan sesuatu yang lebih dariku..."
      Speaker = "Melinoe"
      Event = "WorldUpgradeUnusedWeaponBonus.OfferedVoiceLines"
    }
    {
      Id = "Melinoe_5609"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Datanglah, Kegelapan, tandai Arms of Night di bawah kuasaku!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeUnusedWeaponBonus.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5610"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Arms of Night, keruklah kekayaan dari perut Bumi!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeUnusedWeaponBonusT2.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5611"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dewa dan Dewi di Olympus, bertarunglah!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeOlympusStatues.IncantationVoiceLines"
    }
    {
      Id = "Melinoe_5612"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pundi-pundi Hades yang tercuri, bangkitlah sekalian!"
      Speaker = "Melinoe"
      Event = "WorldUpgradeChallengeSwitches1.IncantationVoiceLines"
    }
    {
