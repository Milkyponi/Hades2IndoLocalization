{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Echo.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "MelinoeField_4650"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, ini baru...!"
      Speaker = "Melinoe"
      Event = "NPC_Echo_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Echo_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini baru... {#Echo1}ini baru... {#Prev}{#Echo2}ini baru...!"
      Speaker = "Echo"
      Event = "NPC_Echo_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_1198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beristirahatlah dengan tenang."
      Speaker = "Melinoe"
      Event = "NPC_Echo_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_1199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenanglah sekarang."
      Speaker = "Melinoe"
      Event = "NPC_Echo_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_1200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa lagi nanti."
      Speaker = "Melinoe"
      Event = "NPC_Echo_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_1201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pasti bisa, Mel!"
      Speaker = "Melinoe"
      Event = "NPC_Echo_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_1202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kematian bagi Chronos..."
      Speaker = "Melinoe"
      Event = "NPC_Echo_01.InteractVoiceLines"
    }
    {
      Id = "Echo_0081"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengan tenang... {#Echo1}dengan tenang... {#Prev}{#Echo2}dengan tenang..."
      Speaker = "Echo"
      Event = "NPC_Echo_01.InteractVoiceLines"
    }
    {
      Id = "Echo_0082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenanglah sekarang... {#Echo1}sekarang... {#Prev}{#Echo2}sekarang..."
      Speaker = "Echo"
      Event = "NPC_Echo_01.InteractVoiceLines"
    }
    {
      Id = "Echo_0083"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jumpa lagi nanti... {#Echo1}lagi nanti... {#Prev}{#Echo2}lagi nanti..."
      Speaker = "Echo"
      Event = "NPC_Echo_01.InteractVoiceLines"
    }
    {
      Id = "Echo_0084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti bisa, Mel...! {#Echo1}Pasti bisa, Mel...! {#Prev}{#Echo2}Pasti bisa, Mel...!"
      Speaker = "Echo"
      Event = "NPC_Echo_01.InteractVoiceLines"
    }
    {
      Id = "Echo_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagi Chronos... {#Echo1}Chronos... {#Prev}{#Echo2}Chronos..."
      Speaker = "Echo"
      Event = "NPC_Echo_01.InteractVoiceLines"
    }
    {
      Id = "Echo_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak berniat melukaimu. {#Echo1}Melukaimu. {#Prev}{#Echo2}Melukaimu. {#Prev}{#Echo3}Melukaimu."
      Speaker = "Echo"
      Event = "EchoFirstMeeting"
    }
    {
      Id = "MelinoeField_0739"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama denganku. Ada apa denganmu, Arwah? Apa ada yang bisa kulakukan untuk meringankan bebanmu?"
      Speaker = "Melinoe"
      Event = "EchoFirstMeeting"
    }
    {
      Id = "Echo_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meringankan bebanmu? {#Echo1}Bebanmu? {#Prev}{#Echo2}Bebanmu?"
      Speaker = "Echo"
      Event = "EchoFirstMeeting"
    }
    {
      Id = "Echo_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedikit lebih jauh lagi... {#Echo1}lebih jauh lagi... {#Prev}{#Echo2}lebih jauh lagi..."
      Speaker = "Echo"
      Event = "EchoLowHealth01"
    }
    {
      Id = "MelinoeField_1189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas penyemangatnya, Echo. Perjuangan melewati tempat ini begitu berat. Tapi kau sepertinya bisa bertahan, dengan caramu sendiri."
      Speaker = "Melinoe"
      Event = "EchoLowHealth01"
    }
    {
      Id = "Echo_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bertahan, dengan caramu sendiri... {#Echo1}dengan caramu sendiri... {#Prev}{#Echo2}caramu sendiri..."
      Speaker = "Echo"
      Event = "EchoLowHealth01"
    }
    {
      Id = "Echo_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nimfa yang ingin kujumpai...! {#Echo1}Ingin kujumpai...! {#Prev}{#Echo2}Ingin kujumpai...!"
      Speaker = "Echo"
      Event = "EchoLowHealth02"
    }
    {
      Id = "MelinoeField_1191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuakui kondisiku sekarang cukup mengenaskan, Echo. Namun aku tahu jika aku bisa sampai sejauh ini, berkahmu mungkin adalah hal yang kubutuhkan untuk menuntaskan sisa perjalananku."
      Speaker = "Melinoe"
      Event = "EchoLowHealth02"
    }
    {
      Id = "Echo_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "...sisa perjalananku... {#Echo1}menuntaskan sisa perjalananku... {#Prev}{#Echo2}perjalananku..."
      Speaker = "Echo"
      Event = "EchoLowHealth02"
    }
    {
      Id = "Echo_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa namamu, bolehkah kutahu? {#Echo1}Bolehkah kutahu? {#Prev}{#Echo2}Bolehkah kutahu?"
      Speaker = "Echo"
      Event = "EchoAboutEcho01"
    }
    {
      Id = "MelinoeField_0744"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan kau tak berbahaya bagiku, jadi... aku Melinoë. Ada urusan keluarga di Tartarus. Dan kau...? Apa aku mendengar gema?"
      Speaker = "Melinoe"
      Event = "EchoAboutEcho01"
    }
    {
      Id = "Echo_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... Echo! {#Echo1}Echo! {#Prev}{#Echo2}Echo! {#Prev}{#Echo3}Echo!"
      Speaker = "Echo"
      Event = "EchoAboutEcho01"
    }
    {
      Id = "Echo_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah itu kau? {#Echo1}Apakah itu kau? {#Prev}{#Echo2}Apakah itu kau?"
      Speaker = "Echo"
      Event = "EchoAboutHelp01"
    }
    {
      Id = "MelinoeField_1163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, ini aku, Echo. Aku tak tahu kenapa kau terus membantuku, tapi perjalananku masih sangat jauh dan aku butuh semua bantuan yang bisa kudapat untuk melangkah lebih jauh."
      Speaker = "Melinoe"
      Event = "EchoAboutHelp01"
    }
    {
      Id = "Echo_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bantuan melangkah lebih jauh... {#Echo1}lebih jauh... {#Prev}{#Echo2}lebih jauh..."
      Speaker = "Echo"
      Event = "EchoAboutHelp01"
    }
    {
      Id = "Echo_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekumpulan Arwah... {#Echo1}kumpulan Arwah... {#Prev}{#Echo2}kumpulan Arwah..."
      Speaker = "Echo"
      Event = "EchoAboutHelp02"
    }
    {
      Id = "MelinoeField_4642"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka kemari untuk menemuimu, ya? Terima kasih sudah menghibur mereka... membawakan mereka sedikit rasa damai."
      Speaker = "Melinoe"
      Event = "EchoAboutHelp02"
    }
    {
      Id = "Echo_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa damai... {#Echo1}rasa damai... {#Prev}{#Echo2}rasa damai..."
      Speaker = "Echo"
      Event = "EchoAboutHelp02"
    }
    {
      Id = "Echo_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, ini Melinoë! {#Echo1}Ini Melinoë! {#Prev}{#Echo2}Melinoë!"
      Speaker = "Echo"
      Event = "EchoAboutNymphs01"
    }
    {
      Id = "MelinoeField_0750"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini Echo! Echo! Echo! Kau seorang Oread, kan? Meski bicaramu tak seperti Nimfa Gunung pada umumnya... semacam kutukan?"
      Speaker = "Melinoe"
      Event = "EchoAboutNymphs01"
    }
    {
      Id = "Echo_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semacam kutukan... {#Echo1}kutukan... kutukan... {#Prev}{#Echo2}kutukan..."
      Speaker = "Echo"
      Event = "EchoAboutNymphs01"
    }
    {
      Id = "Echo_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kasihan sekali... {#Echo1}kasihan sekali... {#Prev}{#Echo2}kasihan sekali..."
      Speaker = "Echo"
      Event = "EchoAboutHeart01"
    }
    {
      Id = "MelinoeField_1000"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap aku tahu apa yang kaulakukan di tempat seperti ini. Tapi, kau tak bisa bercerita begitu saja, kan? Hatimu pasti hancur berkeping-keping..."
      Speaker = "Melinoe"
      Event = "EchoAboutHeart01"
    }
    {
      Id = "Echo_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti hancur... {#Echo1}patah hati... {#Prev}{#Echo2}patah hati..."
      Speaker = "Echo"
      Event = "EchoAboutHeart01"
    }
    {
      Id = "Echo_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baik-baik saja! {#Echo1}Baik-baik saja! {#Prev}{#Echo2}Baik-baik saja!"
      Speaker = "Echo"
      Event = "EchoAboutBridge01"
    }
    {
      Id = "MelinoeField_1182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak sekali marabahaya di seantero Padang ini. Tapi di atas jembatan ini, aku merasa nyaman. Bahkan damai. Ini berkat kehadiran dan kekuatanmu..."
      Speaker = "Melinoe"
      Event = "EchoAboutBridge01"
    }
    {
      Id = "Echo_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehadiran dan kekuatanmu... {#Echo1}kehadiran dan kekuatan... {#Prev}{#Echo2}kehadiran dan kekuatan..."
      Speaker = "Echo"
      Event = "EchoAboutBridge01"
    }
    {
      Id = "Echo_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemandangan yang menyenangkan... {#Echo1}pemandangan yang menyenangkan... {#Prev}{#Echo2}pemandangan yang menyenangkan...!"
      Speaker = "Echo"
      Event = "EchoAboutCurse01"
    }
    {
      Id = "MelinoeField_1195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu bicaramu tak selalu begini... tanpa kuasa penuh atas suaramu sendiri. Tapi ketabahanmu sungguh luar biasa di balik perubahan ini. Kata-kataku mungkin saja kupinjamkan, tapi niat itu murni milikmu."
      Speaker = "Melinoe"
      Event = "EchoAboutCurse01"
    }
    {
      Id = "Echo_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kata-kataku... tapi niat itu murni milikmu... {#Prev}{#Echo1}kata-kataku... tapi niat itu murni milikmu..."
      Speaker = "Echo"
      Event = "EchoAboutCurse01"
    }
    {
      Id = "Echo_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan menyerah... {#Echo1}jangan menyerah... {#Prev}{#Echo2}jangan menyerah..."
      Speaker = "Echo"
      Event = "EchoAboutCurse02"
    }
    {
      Id = "MelinoeField_4633"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih takjub waktu kamu bicara padaku tempo hari, Echo. Maksudku, dengan kata-kata pilihanmu sendiri! Senang sekali mendengarnya darimu, meski hanya sekejap... mungkin kita sudah menemukan secercah harapan untuk penawarnya."
      Speaker = "Melinoe"
      Event = "EchoAboutCurse02"
    }
    {
      Id = "Echo_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Secercah harapan untuk penawarnya... {#Echo1}untuk penawarnya... {#Prev}{#Echo2}untuk penawarnya..."
      Speaker = "Echo"
      Event = "EchoAboutCurse02"
    }
    {
      Id = "Echo_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu kembali...? {#Echo1}Kamu kembali...? {#Prev}{#Echo2}Kamu kembali...?"
      Speaker = "Echo"
      Event = "EchoAboutCurse03"
    }
    {
      Id = "MelinoeField_4639"
      InheritFrom = "BaseNarrative"
      DisplayName = "Iya... begitu pula dirimu. Jadi tak perlu Ambrosia lagi, dan... semua Arwah di sekitar sini... kamu membantu mereka, kan? Melewati duka nestapa mereka."
      Speaker = "Melinoe"
      Event = "EchoAboutCurse03"
    }
    {
      Id = "Echo_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melewati duka nestapa mereka... {#Echo1}duka nestapa mereka... {#Prev}{#Echo2}duka nestapa mereka..."
      Speaker = "Echo"
      Event = "EchoAboutCurse03"
    }
    {
      Id = "MelinoeField_4640"
      InheritFrom = "BaseNarrative"
      DisplayName = "Syukurlah kalau begitu... banyak Arwah yang tampaknya sangat butuh bantuanmu. Pasti ini tugas yang berat, tapi sangat bermakna."
      Speaker = "Melinoe"
      Event = "EchoAboutCurse03"
    }
    {
      Id = "Echo_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sangat bermakna... {#Echo1}bermakna... {#Prev}{#Echo2}bermakna..."
      Speaker = "Echo"
      Event = "EchoAboutCurse03"
    }
    {
      Id = "Echo_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Batu Cekung milikmu! {#Echo1}Batu Cekung milikmu! {#Prev}{#Echo2}Batu Cekung milikmu!"
      Speaker = "Echo"
      Event = "EchoAboutKeepsake01"
    }
    {
      Id = "MelinoeField_1184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini hadiah yang indah. Pasti berasal dari pegunungan tempat tinggalmu dulu. Pernahkah kamu merindukannya? Rasanya sulit membayangkan kamu lebih betah di sini..."
      Speaker = "Melinoe"
      Event = "EchoAboutKeepsake01"
    }
    {
      Id = "Echo_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membayangkan kamu lebih betah di sini... {#Echo1}betah di sini... {#Prev}{#Echo2}betah di sini..."
      Speaker = "Echo"
      Event = "EchoAboutKeepsake01"
    }
    {
      Id = "Echo_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Susah payah sampai sejauh ini... {#Echo1}sampai sejauh ini... {#Prev}{#Echo2}sampai sejauh ini..."
      Speaker = "Echo"
      Event = "EchoAboutChronos01"
    }
    {
      Id = "MelinoeField_1186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, Echo. Tolong jangan bilang siapa-siapa, tapi... aku datang dari Erebus, menyeberangi pelosok Dunia Bawah. Tujuanku adalah Wangsa Hades... demi membantai si perebut takhta."
      Speaker = "Melinoe"
      Event = "EchoAboutChronos01"
    }
    {
      Id = "Echo_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "...si perebut takhta... {#Echo1}membantai si perebut takhta... {#Prev}{#Echo2}si perebut takhta..."
      Speaker = "Echo"
      Event = "EchoAboutChronos01"
    }
    {
      Id = "MelinoeField_1187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan setelah tahu tujuanku, kamu tetap mendukungku."
      Speaker = "Melinoe"
      Event = "EchoAboutChronos01"
    }
    {
      Id = "Echo_0070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tetap mendukungku... {#Echo1}mendukungku... {#Prev}{#Echo2}mendukungku..."
      Speaker = "Echo"
      Event = "EchoAboutChronos01"
    }
    {
      Id = "Echo_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makin dekat dengan Cerberus... {#Echo1}Cerberus... {#Prev}{#Echo2}Cerberus..."
      Speaker = "Echo"
      Event = "EchoAboutCerberus01"
    }
    {
      Id = "MelinoeField_1180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu mengenalnya? Monster berkepala tiga raksasa di sudut lain Padang ini. Dia tak seharusnya ada di sini, dan itu membuatnya sangat gusar, anjing malang."
      Speaker = "Melinoe"
      Event = "EchoAboutCerberus01"
    }
    {
      Id = "Echo_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gusar anjing malang... {#Echo1}gusar anjing malang... {#Prev}{#Echo2}anjing malang... {#Prev}{#Echo3}anjing malang."
      Speaker = "Echo"
      Event = "EchoAboutCerberus01"
    }
    {
      Id = "Echo_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabarmu? {#Echo1}Bagaimana kabarmu? {#Prev}{#Echo2}Bagaimana kabarmu?"
      Speaker = "Echo"
      Event = "EchoAboutNarcissus01"
    }
    {
      Id = "MelinoeField_1003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, begitulah. Tempat ini jelas sangat berbeda dari Oceanus, kalau kamu pernah ke sana. Satu-satunya wajah ramah di atas sana hanyalah si Narcissus itu..."
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus01"
    }
    {
      Id = "Echo_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanyalah si Narcissus itu... {#Echo1}si Narcissus itu... {#Prev}{#Echo2}si Narcissus itu...!"
      Speaker = "Echo"
      Event = "EchoAboutNarcissus01"
    }
    {
      Id = "MelinoeField_1004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, suaramu... kamu mengenalnya? Astaga, gawat. Mengingat banyaknya pemuja orang itu, dan mendapati dirimu berada di negeri para patah hati ini..."
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus01"
    }
    {
      Id = "Echo_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Patah hati... {#Echo1}patah hati... {#Prev}{#Echo2}patah hati..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus01"
    }
    {
      Id = "Echo_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira dia menyesal... {#Echo1}dia menyesal... {#Prev}{#Echo2}dia menyesal...?"
      Speaker = "Echo"
      Event = "EchoAboutNarcissus02"
    }
    {
      Id = "MelinoeField_1165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia sama sekali tak tahu apa yang menimpamu. Tapi dia masih mengingatmu! Dan dia tak bermaksud melukaimu. Jadi tolong jangan diambil hati. Kurasa dia memang hanya mencintai dirinya sendiri."
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus02"
    }
    {
      Id = "Echo_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya mencintai dirinya sendiri... {#Echo1}hanya mencintai dirinya... {#Prev}{#Echo2}hanya mencintai dirinya sendiri..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus02"
    }
    {
      Id = "Echo_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentang Narcissus...? {#Echo1}Tentang Narcissus... {#Prev}{#Echo2}tentang Narcissus...!"
      Speaker = "Echo"
      Event = "EchoAboutNarcissus03"
    }
    {
      Id = "MelinoeField_1167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak tahu seperti apa dia saat kalian pertama kali bertemu dulu, tapi dia punya kesombongan tertentu yang... mungkin menumpulkan kepekaannya. Tiap kali kami bicara, rasanya seolah-olah aku bahkan tak ada di sana."
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus03"
    }
    {
      Id = "Echo_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan tak ada di sana... {#Echo1}tak ada di sana... {#Prev}{#Echo2}tak ada di sana..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus03"
    }
    {
      Id = "Echo_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin bilang... {#Echo1}ingin bilang... {#Prev}{#Echo2}ingin bilang..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus04"
    }
    {
      Id = "MelinoeField_1171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya bukan apa-apa, tapi... seorang, {#Emph}ehem{#Prev}, pria bijak dengan rasa percaya diri yang kelewat tinggi pernah memberitahuku... {#Emph}Kuharap kau menemukan seseorang yang mencintaimu sebesar aku mencintai diriku sendiri."
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus04"
    }
    {
      Id = "Echo_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mencintai diriku sendiri... {#Echo1}diriku sendiri... {#Prev}{#Echo2}diriku sendiri..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus04"
    }
    {
      Id = "Echo_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang kau di sini! {#Echo1}Senang kau di sini! {#Prev}{#Echo2}Senang kau di sini!"
      Speaker = "Echo"
      Event = "EchoAboutNarcissus05"
    }
    {
      Id = "MelinoeField_1169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat bicara lagi dengan Narcissus. Aku yakin... dia benar-benar menginginkan yang terbaik untukmu. Mana mungkin tidak? Di antara jiwa-jiwa tak terhitung di sini, kau begitu dermawan dan baik hati."
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus05"
    }
    {
      Id = "Echo_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu dermawan dan baik hati... {#Echo1}dan baik hati... {#Prev}{#Echo2}baik hati..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus05"
    }
    {
      Id = "Echo_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sendirian kali ini... {#Echo1}sendirian kali ini... {#Prev}{#Echo2}kali ini..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus06"
    }
    {
      Id = "MelinoeField_1176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana pertemuanmu dengan Narcissus? Syukurlah dia cukup beritikad baik untuk mengunjungimu. Aku tahu itu pasti menyakitkan, tapi... kuharap melihatnya lagi bisa sedikit membantumu."
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus06"
    }
    {
      Id = "Echo_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melihatnya lagi bisa membantuku... {#Echo1}bisa membantuku... {#Prev}{#Echo2}membantuku..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus06"
    }
    {
      Id = "Echo_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus bicara denganmu... {#Echo1}bicara denganmu... {#Prev}{#Echo2}bicara denganmu..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus07"
    }
    {
      Id = "MelinoeField_1696"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil membantu Narcissus keluar dari sebuah masalah. Dan tampaknya kau sendiri sudah merelakannya. Tapi soal {#Emph}dirimu... {#Prev}keadaanmu yang seperti ini... kurasa kau sama sekali tak ingin berubah."
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus07"
    }
    {
      Id = "Echo_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "...sama sekali tak ingin berubah, aku... {#Echo1}tak ingin berubah... {#Prev}{#Echo2}aku tak ingin berubah..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus07"
    }
    {
      Id = "MelinoeField_1697"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita masing-masing terkutuk oleh pengalaman hidup kita. Aku bukan siapa-siapa tanpa pengalamanku. Terima kasih sudah mencerminkan pikiranku dan membagikan perasaanmu, Echo. Tapi, apa kau tak apa-apa tetap tinggal di sini?"
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus07"
    }
    {
      Id = "Echo_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak apa-apa tinggal di sini... {#Echo1}tak apa-apa di sini... {#Prev}{#Echo2}tak apa-apa..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus07"
    }
    {
      Id = "Echo_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada pesan untukku, Mel? {#Echo1}Pesan untukku, Mel? {#Prev}{#Echo2}Pesan untukku, Mel?"
      Speaker = "Echo"
      Event = "EchoAboutNarcissus08"
    }
    {
      Id = "MelinoeField_2875"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, ada! Aku bertemu Narcissus lagi baru-baru ini, dan dia menitipkan salam untukmu. Setahuku, kurasa dia benar-benar berharap kalian berdua masih bisa berteman."
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus08"
    }
    {
      Id = "Echo_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih bisa berteman... {#Echo1}bisa berteman... {#Prev}{#Echo2}berteman..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus08"
    }
    {
      Id = "MelinoeField_2876"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah beranjak dari perasaanmu yang dulu terhadapnya. Tapi, kau tak keberatan kalau dia masih sesekali mampir menemuimu, kan? Itu pun kalau dia bisa melepaskan pandangannya dari bayangannya sendiri..."
      Speaker = "Melinoe"
      Event = "EchoAboutNarcissus08"
    }
    {
      Id = "Echo_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau dia bisa melepaskan pandangannya... {#Echo1}melepaskan pandangannya... {#Prev}{#Echo2}melepaskan pandangannya..."
      Speaker = "Echo"
      Event = "EchoAboutNarcissus08"
    }
    {
      Id = "Echo_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Halo... {#Echo1}sahabatku... {#Prev}{#Echo2}sahabatku... {#Prev}{#Echo3}sahabatku..."
      Speaker = "Echo"
      Event = "EchoAboutFields01"
    }
    {
      Id = "MelinoeField_2872"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir selama ini... Padang Ratapan ini hanyalah tempat untuk jatuh ke dalam keputusasaan yang teramat dalam. Tapi keadaanmu benar-benar semakin membaik di sini?"
      Speaker = "Melinoe"
      Event = "EchoAboutFields01"
    }
    {
      Id = "Echo_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semakin membaik di sini... {#Echo1}membaik di sini... {#Prev}{#Echo2}membaik di sini..."
      Speaker = "Echo"
      Event = "EchoAboutFields01"
    }
    {
      Id = "MelinoeField_2873"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... aku tahu meminta pertolongan itu sulit, tapi... jika ada hal yang bisa kubantu, aku ada di sini untukmu, mengerti?"
      Speaker = "Melinoe"
      Event = "EchoAboutFields01"
    }
    {
      Id = "Echo_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengerti... {#Echo1}aku ada untukmu... {#Prev}{#Echo2}mengerti, aku ada untukmu..."
      Speaker = "Echo"
      Event = "EchoAboutFields01"
    }
    {
      Id = "Echo_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah terlalu lama! {#Echo1}Terlalu lama! {#Prev}{#Echo2}Terlalu lama!"
      Speaker = "Echo"
      Event = "EchoAboutOlympus01"
    }
    {
      Id = "MelinoeField_4624"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar... karena urusanku bukan hanya di kedalaman Tartarus, melainkan juga jauh di atas sana... di puncak Olympos yang sedang dikepung. Rumah sah bagi Paduka Zeus dan Ratu Hera."
      Speaker = "Melinoe"
      Event = "EchoAboutOlympus01"
    }
    {
      Id = "Echo_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zeus dan Ratu Hera... {#Echo1}Ratu Hera... {#Prev}{#Echo2}Ratu Hera..."
      Speaker = "Echo"
      Event = "EchoAboutOlympus01"
    }
    {
      Id = "Echo_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat petang untukmu! {#Echo1}Petang untukmu! {#Prev}{#Echo2}Petang untukmu!"
      Speaker = "Echo"
      Event = "EchoAboutCharon01"
    }
    {
      Id = "MelinoeField_1178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, kau tak pernah terlihat tiap kali Tukang Perahu Charon berada di sekitar sini. Jangan takut, dia itu kawan. Meski, ya, tidak selalu mudah diajak bicara."
      Speaker = "Melinoe"
      Event = "EchoAboutCharon01"
    }
    {
      Id = "Echo_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu mudah diajak bicara... {#Echo1}mudah diajak bicara... {#Prev}{#Echo2}diajak bicara..."
      Speaker = "Echo"
      Event = "EchoAboutCharon01"
    }
    {
      Id = "Echo_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu dia... {#Echo1}itu dia... {#Prev}{#Echo2}itu dia...!"
      Speaker = "Echo"
      Event = "EchoAboutNemesis01"
    }
    {
      Id = "MelinoeField_1193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti bersembunyi waktu Nemesis lewat sini. Putri Nyx yang berambut gelap dan berbadan tegap yang terkadang menerobos Padang ini, tahu kan? Tapi kau tak perlu takut padanya."
      Speaker = "Melinoe"
      Event = "EchoAboutNemesis01"
    }
    {
      Id = "Echo_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "...takut padanya... {#Echo1}tak perlu takut padanya... {#Prev}{#Echo2}jangan takut padanya..."
      Speaker = "Echo"
      Event = "EchoAboutNemesis01"
    }
    {
      Id = "Echo_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berat di luar sana... {#Echo1}berat di luar sana... {#Prev}{#Echo2}berat di luar sana..."
      Speaker = "Echo"
      Event = "EchoGrantsNewTrait01"
    }
    {
      Id = "MelinoeField_4649"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang begitulah. Mau sesering apa pun aku melintasi Padang Ratapan ini, aku harus selalu melawan rasa putus asa. Setidaknya sampai aku tiba di sini, karena kau selalu punya sesuatu yang bagus."
      Speaker = "Melinoe"
      Event = "EchoGrantsNewTrait01"
    }
    {
      Id = "Echo_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Punya sesuatu yang bagus... {#Echo1}sesuatu yang bagus... {#Prev}{#Echo2}sesuatu yang bagus..."
      Speaker = "Echo"
      Event = "EchoGrantsNewTrait01"
    }
    {
      Id = "Echo_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingat tempat ini... {#Echo1}ingat tempat ini... {#Prev}{#Echo2}ingat tempat ini..."
      Speaker = "Echo"
      Event = "EchoAboutHoundFamiliar01"
    }
    {
      Id = "MelinoeField_4644"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana mungkin aku bisa melupakannya? Dan kurasa Hecuba di sini juga mengingatnya. Dia sepertinya mengenalimu."
      Speaker = "Melinoe"
      Event = "EchoAboutHoundFamiliar01"
    }
    {
      Id = "Echo_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengenalimu... {#Echo1}mengenalimu... {#Prev}{#Echo2}mengenalimu..."
      Speaker = "Echo"
      Event = "EchoAboutHoundFamiliar01"
    }
    {
      Id = "Echo_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berhasil...! {#Echo1}Kita berhasil...! {#Prev}{#Echo2}Kita berhasil...!"
      Speaker = "Echo"
      Event = "EchoPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4646"
      InheritFrom = "BaseNarrative"
      DisplayName = "Graha Hades telah dipulihkan! Raja dan Ratu Dunia Bawah takkan membiarkan tempat ini merana seperti sebelumnya...! Seiring waktu, aku yakin segalanya akan jadi lebih baik untuk semua orang di sini."
      Speaker = "Melinoe"
      Event = "EchoPostTrueEnding01"
    }
    {
      Id = "Echo_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih baik untuk semua orang... {#Echo1}untuk semua orang... {#Prev}{#Echo2}untuk semua orang..."
      Speaker = "Echo"
      Event = "EchoPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4647"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar. Tapi untuk saat ini, aku mungkin masih akan terus lewat sini seperti biasa. Aku harus memeriksa Tartarus demi memastikan semuanya baik-baik saja."
      Speaker = "Melinoe"
      Event = "EchoPostTrueEnding01"
    }
    {
      Id = "Echo_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya baik-baik saja... {#Echo1}baik-baik saja... {#Prev}{#Echo2}baik-baik saja..."
      Speaker = "Echo"
      Event = "EchoPostTrueEnding01"
    }
    {
      Id = "Echo_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Narcissus! {#Echo1}Narcissus! {#Prev}{#Echo2}Narcissus!"
      Speaker = "Echo"
      Event = "NarcissusWithEcho01"
    }
    {
      Id = "Narcissus_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh hei, {#Emph}um{#Prev}, Echo dan aku, kami cuma lagi ngobrol-ngobrol santai melepas rindu, kurasa. Udah lama banget! Hampir lupa betapa sukanya aku sama Padang Ratapan ini! Keren banget, kan?"
      Speaker = "Narcissus"
      Event = "NarcissusWithEcho01"
    }
    {
      Id = "Echo_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keren banget, kan? {#Echo1}Keren banget, kan? {#Prev}{#Echo2}Keren banget, kan?"
      Speaker = "Echo"
      Event = "NarcissusWithEcho01"
    }
    {
      Id = "MelinoeField_1173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang melihat kalian berdua di sini! Suasananya terasa jauh berbeda dari biasanya — dalam artian baik! Echo, {#Emph}umm... {#Prev}kuharap semuanya baik-baik saja?"
      Speaker = "Melinoe"
      Event = "NarcissusWithEcho01"
    }
    {
      Id = "Echo_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya baik-baik saja? {#Echo1}Semuanya baik-baik saja! {#Prev}{#Echo2}Semuanya baik-baik saja."
      Speaker = "Echo"
      Event = "NarcissusWithEcho01"
    }
    {
      Id = "Narcissus_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Yah pokoknya, kurasa yang mau kubilang itu, {#Emph}um... {#Prev}a-aku nggak bermaksud bikin kamu berakhir di sini, paham kan? Tapi ya aku tahu kamu emang udah di sini! {#Emph}Ugh! {#Prev}Aku nggak mau kamu membenciku."
      Speaker = "Narcissus"
      Event = "NarcissusWithEcho02"
    }
    {
      Id = "Echo_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak mau membenciku... {#Echo1}membenciku... {#Prev}{#Echo2}benciku..."
      Speaker = "Echo"
      Event = "NarcissusWithEcho02"
    }
    {
      Id = "Narcissus_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi aku {#Emph}nggak {#Prev}benci kamu! Kamu teman ngobrol yang asyik, pendengar yang hebat — dan ini maksudku bukan romantis ya, biar jelas aja — tapi cuma... aduh. Aku memang bodoh... dan aku juga minta maaf, oke?"
      Speaker = "Narcissus"
      Event = "NarcissusWithEcho02"
    }
    {
      Id = "Echo_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oke... {#Echo1}aku juga minta maaf... {#Prev}{#Echo2}oke, aku juga minta maaf."
      Speaker = "Echo"
      Event = "NarcissusWithEcho02"
    }
    {
      Id = "Narcissus_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kamu nggak perlu bilang gitu! Tapi aku senang kamu merasakan hal yang sama. Jadi kayaknya... kita masih bisa berteman, kan?"
      Speaker = "Narcissus"
      Event = "NarcissusWithEcho02"
    }
    {
      Id = "Echo_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita masih bisa berteman...? {#Echo1}Masih bisa berteman...? {#Prev}{#Echo2}Bisa berteman..."
      Speaker = "Echo"
      Event = "NarcissusWithEcho02"
    }
    {
      Id = "Narcissus_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mantap! {#Prev}Ngomong-ngomong, aku suka jembatan ini!"
      Speaker = "Narcissus"
      Event = "NarcissusWithEcho02"
    }
    {
      Id = "Echo_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku suka jembatan ini... {#Echo2}jembatan ini... {#Prev}{#Echo3}jembatan ini."
      Speaker = "Echo"
      Event = "NarcissusWithEcho02"
    }
    {
      Id = "Narcissus_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya kamu sudah betah menetap di sini, {#Emph}ya? {#Prev}Tempat yang lumayan asyik! Sungai Styx pas di sebelah sana, desiran gandum..."
      Speaker = "Narcissus"
      Event = "NarcissusWithEcho03"
    }
    {
      Id = "Echo_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Desiran gandum... {#Echo1}desiran gandum... {#Prev}{#Echo2}desiran gandum..."
      Speaker = "Echo"
      Event = "NarcissusWithEcho03"
    }
    {
      Id = "Narcissus_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Iya{#Prev}, agak mirip waktu kita masih di dunia atas dulu! Pepohonan, bunga-bunga, dan segalanya. Kamu pernah kangen masa-masa itu?"
      Speaker = "Narcissus"
      Event = "NarcissusWithEcho03"
    }
    {
      Id = "Echo_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernah kangen masa-masa itu? {#Echo1}Kangen masa-masa itu? {#Prev}{#Echo2}Kangen masa-masa itu?"
      Speaker = "Echo"
      Event = "NarcissusWithEcho03"
    }
    {
      Id = "Narcissus_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah kalau aku sendiri sih nggak terlalu, kurasa. Maksudku, lihat dong semua ini! Kurasa hidup kita di sini udah cukup enak!"
      Speaker = "Narcissus"
      Event = "NarcissusWithEcho03"
    }
    {
      Id = "Echo_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hidup kita cukup enak! {#Echo1}Cukup enak! {#Prev}{#Echo2}Cukup enak!"
      Speaker = "Echo"
      Event = "NarcissusWithEcho03"
    }
    {
      Id = "Echo_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Halo...! {#Echo1}Halo...! {#Prev}{#Echo2}Halo...!"
      Speaker = "Echo"
      Event = "EchoChat03"
    }
    {
      Id = "Echo_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Echo...! {#Echo1}Echo...! {#Prev}{#Echo2}Echo...!"
      Speaker = "Echo"
      Event = "EchoChat14"
    }
    {
      Id = "Echo_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dekat dengan Tartarus... {#Echo1}dengan Tartarus... {#Prev}{#Echo2}Tartarus..."
      Speaker = "Echo"
      Event = "EchoChat16"
    }
    {
      Id = "Echo_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Merasa luar biasa malam ini! {#Echo1}Luar biasa malam ini! {#Prev}{#Echo2}Luar biasa malam ini!"
      Speaker = "Echo"
      Event = "EchoChat17"
    }
    {
      Id = "Echo_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Echo... {#Echo1}jangan kau putus asa... {#Prev}{#Echo2}Echo... {#Prev}{#Echo3}jangan kau putus asa..."
      Speaker = "Echo"
      Event = "EchoChat18"
    }
    {
      Id = "Echo_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tampak sehat...! {#Echo1}Tampak sehat...! {#Prev}{#Echo2}Tampak sehat...!"
      Speaker = "Echo"
      Event = "EchoChat20"
    }
    {
      Id = "Echo_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma numpang lewat... {#Echo1}numpang lewat... {#Prev}{#Echo2}numpang lewat..."
      Speaker = "Echo"
      Event = "EchoChat22"
    }
    {
      Id = "Echo_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo jalan terus... {#Echo1}jalan terus... {#Prev}{#Echo2}jalan terus..."
      Speaker = "Echo"
      Event = "EchoChat24"
    }
    {
      Id = "Echo_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wajah yang familier... {#Echo1}yang familier... {#Prev}{#Echo2}yang familier..."
      Speaker = "Echo"
      Event = "EchoChat25"
    }
    {
      Id = "Echo_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada kabar apa... {#Echo1}kabar apa... {#Prev}{#Echo2}kabar apa...?"
      Speaker = "Echo"
      Event = "EchoChat26"
    }
    {
      Id = "Echo_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Halo lagi... {#Echo1}halo lagi... {#Prev}{#Echo2}halo lagi...!"
      Speaker = "Echo"
      Event = "EchoChat27"
    }
    {
      Id = "Echo_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari Olympus... {#Echo1}dari Olympus... {#Prev}{#Echo2}dari Olympus...!"
      Speaker = "Echo"
      Event = "EchoChat28"
    }
    {
      Id = "Narcissus_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa ini? Cuma lagi ngobrol santai sama Echo di sini!"
      Speaker = "Narcissus"
      Event = "NarcissusWithEchoChat01"
    }
    {
      Id = "Echo_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Echo di sini... {#Echo1}Echo di sini... {#Prev}{#Echo2}Echo di sini...!"
      Speaker = "Echo"
      Event = "NarcissusWithEchoChat01"
    }
    {
      Id = "Narcissus_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tempat ini lumayan asyik di Padang Duka ini, menurutmu begitu juga kan?"
      Speaker = "Narcissus"
      Event = "NarcissusWithEchoChat02"
    }
    {
      Id = "Echo_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu juga kan? {#Echo1}Begitu juga kan? {#Prev}{#Echo2}Begitu juga kan?"
      Speaker = "Echo"
      Event = "NarcissusWithEchoChat02"
    }
    {
      Id = "Narcissus_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang tak bisa melihat diriku {#Emph}sendiri {#Prev}sekarang, tapi setidaknya aku {#Emph}bisa {#Prev}melihat kalian {#Emph}berdua!"
      Speaker = "Narcissus"
      Event = "NarcissusWithEchoChat03"
    }
    {
      Id = "Echo_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian berdua! {#Echo1}Kalian berdua! {#Prev}{#Echo2}Kalian berdua!"
      Speaker = "Echo"
      Event = "NarcissusWithEchoChat03"
    }
    {
      Id = "Narcissus_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku terlihat menawan, kau terlihat menawan, kita semua terlihat menawan."
      Speaker = "Narcissus"
      Event = "NarcissusWithEchoChat04"
    }
    {
      Id = "Echo_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua terlihat menawan... {#Echo1}semua terlihat menawan... {#Prev}{#Echo2}semua terlihat menawan..."
      Speaker = "Echo"
      Event = "NarcissusWithEchoChat04"
    }
    {
      Id = "Narcissus_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lagi tak bawa hadiah, tapi kurasa Echo punya sesuatu buatmu!"
      Speaker = "Narcissus"
      Event = "NarcissusWithEchoChat05"
    }
    {
      Id = "Echo_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Punya sesuatu buatmu! {#Echo1}Punya sesuatu buatmu! {#Prev}{#Echo2}Punya sesuatu buatmu!"
      Speaker = "Echo"
      Event = "NarcissusWithEchoChat05"
    }
    {
      Id = "Narcissus_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu rupa {#Emph}ku {#Prev}sangat luar biasa. Maksudku, rupamu {#Emph}juga!"
      Speaker = "Narcissus"
      Event = "NarcissusWithEchoChat06"
    }
    {
      Id = "Echo_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rupamu juga! {#Echo1}Rupamu juga! {#Prev}{#Echo2}Rupamu juga!"
      Speaker = "Echo"
      Event = "NarcissusWithEchoChat06"
    }
    {
      Id = "Narcissus_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Hei, apa kita tak bisa sama-sama jadi yang terbaik? Kita berdua adalah yang terbaik!"
      Speaker = "Narcissus"
      Event = "NarcissusWithEchoChat07"
    }
    {
      Id = "Echo_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keduanya terbaik! {#Echo1}Keduanya terbaik! {#Prev}{#Echo2}Keduanya terbaik!"
      Speaker = "Echo"
      Event = "NarcissusWithEchoChat07"
    }
    {
      Id = "Narcissus_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kami baru saja membicarakanmu! Echo, ini teman kita!"
      Speaker = "Narcissus"
      Event = "NarcissusWithEchoChat08"
    }
    {
      Id = "Echo_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini teman kita! {#Echo1}Ini teman kita! {#Prev}{#Echo2}Ini teman kita!"
      Speaker = "Echo"
      Event = "NarcissusWithEchoChat08"
    }
    {
      Id = "MelinoeField_0758"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan di tempat yang penuh dukacita seperti ini, masih ada keindahan... dan kelembutan. Aku belum tahu cara meringankan bebanmu, tapi barangkali ini bisa membantu."
      Speaker = "Melinoe"
      Event = "EchoGift01"
    }
    {
      Id = "Echo_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa membantu... {#Echo1}bisa membantu... {#Prev}{#Echo2}bisa membantu..."
      Speaker = "Echo"
      Event = "EchoGift01"
    }
    {
      Id = "MelinoeField_1196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melihat wajah lembutmu sangat berarti bagiku! Semoga Nektar ini mempermanis waktumu di sini. Lihat betapa luasnya Padang ini! Masih banyak ruang untuk hal lain selain duka."
      Speaker = "Melinoe"
      Event = "EchoGift02"
    }
    {
      Id = "Echo_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selain duka... {#Echo1}selain duka... {#Prev}{#Echo2}selain duka..."
      Speaker = "Echo"
      Event = "EchoGift02"
    }
    {
      Id = "MelinoeField_1197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya Nektar lagi untukmu, Echo, jika kau berkenan! Di tempat asalku, ini hadiah kecil yang kami berikan kepada orang yang kami sayangi. Entah bagaimana denganmu, tapi hanya dengan menyerahkan benda ini, perasaanku jadi sedikit lebih baik."
      Speaker = "Melinoe"
      Event = "EchoGift03"
    }
    {
      Id = "Echo_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedikit lebih baik... {#Echo1}lebih baik... {#Prev}{#Echo2}lebih baik..."
      Speaker = "Echo"
      Event = "EchoGift03"
    }
    {
      Id = "MelinoeField_4625"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir Nektar pun tak cukup untuk menceriakan suasana di sini. Tapi setidaknya kau dikelilingi monumen batu. Kalau kau berasal dari pegunungan, mungkin suasananya terasa seperti di rumah."
      Speaker = "Melinoe"
      Event = "EchoGift04"
    }
    {
      Id = "Echo_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seperti di rumah... {#Echo1}seperti di rumah... {#Prev}{#Echo2}seperti di rumah..."
      Speaker = "Echo"
      Event = "EchoGift04"
    }
    {
      Id = "MelinoeField_4626"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong beri tahu aku entah bagaimana caranya jika ada sesuatu yang bisa kubawakan atau kulakukan untukmu pada suatu malam nanti. Setidaknya di sini tampak aman. Untuk sekarang, kuharap Nektar ini sudah cukup."
      Speaker = "Melinoe"
      Event = "EchoGift05"
    }
    {
      Id = "Echo_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar ini sudah cukup... {#Echo1}sudah cukup... {#Prev}{#Echo2}sudah cukup..."
      Speaker = "Echo"
      Event = "EchoGift05"
    }
    {
      Id = "MelinoeField_4627"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih sudah mengingatkanku betapa banyak hal yang bisa disampaikan hanya dengan sedikit kata, atau bahkan tanpa kata sama sekali. Saat kau menyahut, kata-katanya mungkin milikku, tapi aku tahu apa maksudmu. Dan aku tahu kau juga memahamiku."
      Speaker = "Melinoe"
      Event = "EchoGift06"
    }
    {
      Id = "Echo_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memahamiku juga... {#Echo1}memahamiku juga... {#Prev}{#Echo2}kau memahami..."
      Speaker = "Echo"
      Event = "EchoGift06"
    }
    {
      Id = "MelinoeField_4628"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena kita sudah semakin saling mengenal, Echo, aku ingin memberimu sesuatu yang istimewa jika kau berkenan. Ini Ambrosia, langsung dari puncak tertinggi Gunung Olympus."
      Speaker = "Melinoe"
      Event = "EchoGift07"
    }
    {
      Id = "Echo_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Puncak tertinggi Gunung Olympus... {#Echo1}tertinggi Gunung Olympus... {#Prev}{#Echo2}puncak tertinggi, {#Prev}A... {#Emph}ngh..."
      Speaker = "Echo"
      Event = "EchoGift07"
    }
    {
      Id = "MelinoeField_4629"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Echo! {#Prev}Apa barusan kau...? Kau {#Emph}berbicara! {#Prev}Kau bilang {#Emph}A{#Prev}, dengan kata-katamu sendiri! Aku yakin aku mendengarnya!"
      Speaker = "Melinoe"
      Event = "EchoGift07"
    }
    {
      Id = "Echo_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "...mendengarnya... A... Aku tahu, aku mendengarmu, dan... terima kasih. Ambrosia ini, ini... ini yang membuatku begini, kurasa, tapi a... {#Echo1}tapi a... {#Prev}{#Echo2}tapi a... {#Prev}kurasa ini takkan bertahan lama... {#Echo1}bertahan lama..."
      Speaker = "Echo"
      Event = "EchoGift07"
    }
    {
      Id = "MelinoeField_4630"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu aku akan membawakannya lagi! Echo, ini luar biasa! Aku tahu Ambrosia memang hebat, tapi tak kusangka sehebat ini!"
      Speaker = "Melinoe"
      Event = "EchoGift07"
    }
    {
      Id = "Echo_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak sehebat ini... {#Echo1}tak se-, {#Prev}{#Echo1Italic}guh... {#Prev}ini sulit kujelaskan, tapi... aku tak membutuhkannya lagi... {#Echo1}tak butuh lagi... {#Prev}{#Echo2}tak butuh lagi..."
      Speaker = "Echo"
      Event = "EchoGift07"
    }
    {
      Id = "MelinoeField_4631"
      InheritFrom = "BaseNarrative"
      DisplayName = "Echo, apa yang terjadi...? Ambrosianya. Kau tak membutuhkannya lagi untuk saat ini...? Khasiatnya terlalu kuat..."
      Speaker = "Melinoe"
      Event = "EchoGift07"
    }
    {
      Id = "Echo_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terlalu kuat... {#Echo1}terlalu kuat... {#Prev}{#Echo2}terlalu kuat..."
      Speaker = "Echo"
      Event = "EchoGift07"
    }
    {
      Id = "MelinoeField_4632"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Baiklah. Nanti aku kembali."
      Speaker = "Melinoe"
      Event = "EchoGift07"
    }
    {
      Id = "MelinoeField_4634"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Echo, kita harus mencari tahu ini. Waktu itu pasti Ambrosia yang mengembalikan suaramu, jadi mungkin sekarang akan berhasil lagi. Apa ada pengaruhnya?"
      Speaker = "Melinoe"
      Event = "EchoGift08"
    }
    {
      Id = "Echo_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada pengaruhnya...? {#Echo1}Pengaruhnya... {#Prev}{#Echo2}ada, {#Prev}apakah... A... {#Echo1}A{#Prev}, Melinoë, dengar. {#Echo1}Dengar{#Prev}, aku tinggal di sini bukan karena butuh bantuan... {#Echo1}butuh bantuan... {#Prev}{#Echo2}butuh bantuan..."
      Speaker = "Echo"
      Event = "EchoGift08"
    }
    {
      Id = "MelinoeField_4635"
      InheritFrom = "BaseNarrative"
      DisplayName = "Echo, ini benar-benar kau! Lalu, apa yang kau butuhkan? Aku tak paham. Siapa yang sudi berlarut-larut dalam kesedihan di tempat seperti ini?"
      Speaker = "Melinoe"
      Event = "EchoGift08"
    }
    {
      Id = "Echo_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tempat seperti... di sinilah aku bisa menolong... {#Echo1}bisa menolong... {#Prev}{#Echo2}bisa menolong... {#Prev}yang lain, yang... tak punya teman bicara. Tempat berpaling. Karena aku menyadari... aku bisa mencerminkan perasaan, dan pikiran mereka... {#Echo1}pikiran mereka... {#Prev}{#Echo2}pikiran mereka..."
      Speaker = "Echo"
      Event = "EchoGift08"
    }
    {
      Id = "MelinoeField_4636"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama seperti caramu mencerminkan perasaanku. Tapi, kita harus menemukan cara untuk mengembalikan suaramu. Kita sudah hampir berhasil!"
      Speaker = "Melinoe"
      Event = "EchoGift08"
    }
    {
      Id = "Echo_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hampir berhasil... {#Echo1}hampir... {#Prev}tidak. Tidak, dulu saat aku bisa bicara... seperti ini... {#Echo1}seperti ini... {#Prev}{#Echo2}seperti ini... {#Prev}aku tak bisa mendengar diriku sendiri atau orang lain. Tak seperti sekarang. Jadi kumohon... aku sudah memiliki apa yang kuinginkan, aku berjanji padamu... {#Echo1}berjanji padamu... {#Prev}{#Echo2}berjanji..."
      Speaker = "Echo"
      Event = "EchoGift08"
    }
    {
      Id = "MelinoeField_4637"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Echo... A... aku mengerti. Dan... aku paham."
      Speaker = "Melinoe"
      Event = "EchoGift08"
    }
    {
      Id = "Echo_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku paham... {#Echo1}aku paham... {#Prev}{#Echo2}aku paham..."
      Speaker = "Echo"
      Event = "EchoGift08"
    }
    {
      Id = "MelinoeField_0759"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau memberikan ini padaku? Suatu kehormatan."
      Speaker = "Melinoe"
      Event = "NPC_Echo_01.GiftGivenVoiceLines"
    }
    {
      Id = "Echo_0023"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kehormatan... {#Echo1}kehormatan... {#Prev}{#Echo2}kehormatan..."
      Speaker = "Echo"
      Event = "NPC_Echo_01.GiftGivenVoiceLines"
    }
    {
      Id = "Echo_0005_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ambillah ini... {#Echo1}ambillah ini... {#Prev}{#Echo2}ambillah ini..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.EchoKeepsakeLines"
    }
    {
      Id = "Echo_0012_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Echo... {#Echo1}Echo... {#Prev}{#Echo2}Echo..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.EchoKeepsakeLines"
    }
    {
      Id = "Echo_0015_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Takkan lupa... {#Echo1}takkan lupa... {#Prev}{#Echo2}takkan lupa..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.EchoKeepsakeLines"
    }
    {
      Id = "Echo_0037_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersyukur... {#Echo1}bersyukur... {#Prev}{#Echo2}bersyukur..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.EchoKeepsakeLines"
    }
    {
      Id = "Echo_0038_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekuatan... {#Echo1}kekuatan... {#Prev}{#Echo2}kekuatan..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.EchoKeepsakeLines"
    }
    {
      Id = "Echo_0039_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang terbaik... {#Echo1}yang terbaik... {#Prev}{#Echo2}yang terbaik...!"
      Speaker = "Echo"
      Event = "GlobalVoiceLines.EchoKeepsakeLines"
    }
    {
      Id = "Echo_0042_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati... {#Echo1}hati-hati... {#Prev}{#Echo2}hati-hati..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.EchoKeepsakeLines"
    }
    {
      Id = "Echo_0043_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tetap kuat... {#Echo1}kuat... {#Prev}{#Echo2}kuat..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.EchoKeepsakeLines"
    }
    {
      Id = "Echo_0045_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kawanku... {#Echo1}kawanku... {#Prev}{#Echo2}kawanku..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.EchoKeepsakeLines"
    }
    {
      Id = "Echo_0046_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tolong... {#Echo1}tolong... {#Prev}{#Echo2}tolong..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.EchoKeepsakeLines"
    }
    {
      Id = "Narcissus_0079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, Laurel!"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_1174"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Namaku Melinoë! Lupakan saja..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "Echo_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Melinoë, lupakan saja... {#Echo1}lupakan saja... {#Prev}{#Echo2}lupakan saja..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_2870"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih seperti biasa, Echo. Senang melihat kalian berdua."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "Echo_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senang melihatmu juga... {#Echo1}melihatmu juga... {#Prev}{#Echo2}melihatmu juga...!"
      Speaker = "Echo"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_2856"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang hubungan mereka mulai ada kemajuan..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_4662"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga diri kalian berdua baik-baik."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "Echo_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baik-baik... {#Echo1}baik-baik... {#Prev}{#Echo2}baik-baik..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_0741"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak tahu siapa dirimu, tapi terima kasih..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "Echo_0006"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih... {#Echo1}terima kasih... {#Prev}{#Echo2}terima kasih..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_5351"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, apa kau mau Nektar?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "Echo_0169"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nektar? {#Echo1}Nektar? {#Prev}{#Echo2}Nektar?"
      Speaker = "Echo"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_0740"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini boleh untukku?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "Echo_0005"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Untukku... {#Echo1}untukku... {#Prev}{#Echo2}untukku..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_1001"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tolong jaga dirimu."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "Echo_0026"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga dirimu... {#Echo1}jaga dirimu... {#Prev}{#Echo2}jaga dirimu..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_0745"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buatku? Kau yakin?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "Echo_0009"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yakin... {#Echo1}yakin... {#Prev}{#Echo2}yakin..."
      Speaker = "Echo"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_0748"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, Echo."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "MelinoeField_0751"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan melupakan ini, Echo."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Echo"
    }
    {
      Id = "Echo_0015"
      InheritFrom = "BaseSubtitle"
