    {
      Id = "Storyteller_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cerberus, monster berkepala tiga yang tersohor mengerikan, beristirahat di tempat favoritnya, dan kini memandang sang Putri Kematian dengan tiga ekspresi yang berbeda dari sebelumnya.{#Prev}"
