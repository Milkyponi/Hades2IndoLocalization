  lang = "en"
  Texts = [
    {
      Id = "MelinoeField_5082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak berencana begitu..."
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_1570"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Peluang kita terbuka sangat lebar..."
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_2834"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka... bertarung lumayan hebat."
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_5180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak selalu, tidak..."
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_5221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi tren mode? {#Emph}Hah{#Prev}, tidak..."
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_1567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dalam bayang, aku berbakti!"
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senang sekali bertemu denganmu."
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_1566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga dirimu baik-baik, Ayahanda."
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, Ayahanda!"
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga dirimu, Ibu!"
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5065"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih sudah ada di sini."
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di jalan, Ibu."
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Persephone_0050"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga, putri kecilku."
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Persephone_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya karena perjuanganmu."
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Persephone_0052"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, Putriku..."
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Persephone_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga harus berhati-hati."
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Persephone_0054"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mendesah>"
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Persephone_0055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo, Sayang!"
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Persephone_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya yang lama."
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Persephone_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, terima kasih banyak."
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Persephone_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita memang sangat membutuhkannya."
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Persephone_0059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita akan membutuhkannya."
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0345"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, Putriku."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kegelapan memang paling cocok untukku."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menyusuplah tanpa terlihat."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hrm."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke dalam bayang-bayang, kau akan kembali."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0346"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Habisi dia."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0347"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan tinggalkan jejak."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0348"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lewat renovasi kita, ya."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0349"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan di sini."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, Putriku..."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam..."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita pernah mencobanya sekali."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kematian..."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak akan terjadi di sini."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di sini?"
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah katamu."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam..."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.InteractVoiceLines"
    }
    {
      Id = "Hades_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cuih! {#Prev}Penyiksa lain datang untuk meremukkanku, atau setidaknya mencoba. Dan serapuh ini pula. Apa Sang Raja Titan kehabisan bawahan yang becus?"
      Speaker = "Hades"
      Event = "HadesFirstMeeting"
    }
    {
      Id = "Melinoe_1056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau... apa kau... tuan dari monster ini?"
      Speaker = "Melinoe"
      Event = "HadesFirstMeeting"
    }
    {
      Id = "Hades_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tuan dari monster ini? Ha, haha! {#Prev}Yah, jika aku harus dikenang, masih banyak gelar yang jauh lebih buruk dari itu. Lagipula, {#Emph}monster {#Prev}ini bahkan belum menggeram sedikit pun kepadamu..."
      Speaker = "Hades"
      Event = "HadesFirstMeeting"
    }
    {
      Id = "Melinoe_1057_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Terkesiap> {#Prev}Tuan Hades, kau adalah.... Ayah, aku... Melinoë. Aku putrimu."
      Speaker = "Melinoe"
      Event = "HadesFirstMeeting"
    }
    {
      Id = "Hades_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Putriku. Melinoë? Para Moira yang pemurah...! Kau tak boleh berada di sini. Dia akan menemukanmu. Dia akan menemukanmu, lalu..."
      Speaker = "Hades"
      Event = "HadesFirstMeeting"
    }
    {
      Id = "Melinoe_1058"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Akan kuhabisi dia di tempat. Di mana dia?"
      Speaker = "Melinoe"
      Event = "HadesFirstMeeting"
    }
    {
      Id = "Hades_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia berada di Griya terkutuk milikku! Tempat yang seharusnya kau dan aku diami. Lihat aku, Putriku. Aku sendiri tak sanggup menghadapinya. Menurutmu apa yang akan terjadi nanti?"
      Speaker = "Hades"
      Event = "HadesFirstMeeting"
    }
    {
      Id = "Melinoe_1059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap dia akan meremehkanku. Ayah, biarkan aku membebaskanmu dari belenggu ini!"
      Speaker = "Melinoe"
      Event = "HadesFirstMeeting"
    }
    {
      Id = "Hades_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jangan! {#Prev}Tidak, itu hanya akan mendatangkan kehancuran yang lebih besar. Sekarang, pergilah dari tempat ini. Namun biarkan kupinjamkan kekuatan yang masih tersisa padaku."
      Speaker = "Hades"
      Event = "HadesFirstMeeting"
    }
    {
      Id = "MelinoeField_1689"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Akan kuhabisi dia di tempat. Dia ada di sekitar sini, bukan?"
      Speaker = "Melinoe"
      Event = "HadesFirstMeeting_B"
    }
    {
      Id = "MelinoeField_1688"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Akan kuhabisi dia di tempat. Dan ini bukan yang pertama kalinya."
      Speaker = "Melinoe"
      Event = "HadesFirstMeeting_C"
    }
    {
      Id = "Hades_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bukan yang pertama kalinya{#Prev}, benarkah? Maka kau pasti tahu betapa sia-sianya tindakan itu! Lihat aku, Putriku. Aku sendiri tak berdaya melawannya. Padahal aku juga pernah bertarung dengannya sebelumnya. Pernah {#Emph}menghabisinya {#Prev}dulu!"
      Speaker = "Hades"
      Event = "HadesFirstMeeting_C"
    }
    {
      Id = "MelinoeField_1690"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan aku, Ayah. Tapi tekadku takkan goyah, bahkan olehmu sekalipun. Sekarang biarkan aku membebaskanmu dari belenggu ini!"
      Speaker = "Melinoe"
      Event = "HadesFirstMeeting_C"
    }
    {
      Id = "Hades_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedang apa kau di sini lagi? Sudah kubilang, kau {#Emph}tidak boleh {#Prev}berada di sini!"
      Speaker = "Hades"
      Event = "HadesMeeting02"
    }
    {
      Id = "Melinoe_1061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan sudah kukatakan {#Emph}padamu {#Prev}bahwa aku akan kembali untukmu. Meski prioritasku tetap Chronos. Kau pernah mengalahkannya dulu. Bisakah kau beritahu aku kelemahannya? Apa saja?"
      Speaker = "Melinoe"
      Event = "HadesMeeting02"
    }
    {
      Id = "Hades_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aku {#Prev}mengalahkannya dengan bantuan {#Emph}lima dewa lainnya! {#Prev}Harapan apa yang kau punya seorang diri? Dia tak punya kelemahan, selain keangkuhannya. Dan tampaknya kau pun punya kelemahan yang sama."
      Speaker = "Hades"
      Event = "HadesMeeting02"
    }
    {
      Id = "Melinoe_1062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu sepertinya kami seimbang. Ayah, sudah berapa lama kau dirantai seperti ini? Apakah ada yang bisa kulakukan?"
      Speaker = "Melinoe"
      Event = "HadesMeeting02"
    }
    {
      Id = "Hades_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pikir aku punya kesadaran waktu di tempat seperti ini? Dan sudah kubilang apa yang bisa kau lakukan: {#Emph}Jangan pertaruhkan segalanya. {#Prev}Pergilah sekarang, dan jangan sampai terlihat."
      Speaker = "Hades"
      Event = "HadesMeeting02"
    }
    {
      Id = "Hades_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak tahu bagaimana caramu bertahan melawan sang Titan, jika kau memang benar-benar berhadapan dengannya. Cepatlah, katakan saja ini padaku: Apakah kau selama ini... baik-baik saja?"
      Speaker = "Hades"
      Event = "HadesMeeting03"
    }
    {
      Id = "Melinoe_1063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah aku... baik-baik saja? Seumur hidupku kuhabiskan untuk mempersiapkan momen ini, demi menyeret perampas tahta Griya Hades ke pengadilan. Jadi, aku baru bisa menjawabnya nanti, tergantung bagaimana hasilnya."
      Speaker = "Melinoe"
      Event = "HadesMeeting03"
    }
    {
      Id = "Hades_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maafkan aku... maafkan aku. Beritahu aku nanti jika memang harus. Aku ingin memuluskan pembalasan dendammu jika sanggup. Namun hanya ini yang bisa kulakukan untuk sekarang."
      Speaker = "Hades"
      Event = "HadesMeeting03"
    }
    {
      Id = "MelinoeField_1495"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hatiku pilu melihatmu seperti ini, Ayah. Namun, ini memberiku ketenangan. Dan juga kekuatan. Untunglah ruangan ini tidak dipenuhi oleh Satyr..."
      Speaker = "Melinoe"
      Event = "HadesAboutPain01"
    }
    {
      Id = "Hades_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, mereka cukup punya akal sehat untuk menjaga jarak dariku... atau mungkin dari Cerberus. Yah, jika melihatku dalam keadaan menyedihkan ini bisa membangkitkan murkamu seutuhnya, biarlah begitu."
      Speaker = "Hades"
      Event = "HadesAboutPain01"
    }
    {
      Id = "MelinoeField_1496"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan begitu maksudku; aku tidak merasakan kebencian ataupun dendam. Di bagian lain Tartarus mungkin iya, tapi tidak di sini. Tidak lagi. Aku hanya berharap kehadiranku tidak menambah penderitaanmu."
      Speaker = "Melinoe"
      Event = "HadesAboutPain01"
    }
    {
      Id = "Hades_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak. Satu-satunya penderitaan... adalah fakta bahwa ibumu dan aku, kakakmu, anjing ini, bahwa kami tidak... kami tak bisa ada di sana untuk melihatmu tumbuh dewasa. Setiap kali melihatmu sekarang... rasa hampa yang dulu ada seketika terisi."
      Speaker = "Hades"
      Event = "HadesAboutPain01"
    }
    {
      Id = "Hades_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau tak keberatan meladeni rasa ingin tahu yang tak berguna ini... bagaimana kabar Griyaku? Kakakmu, dialah yang kurang lebih mengurus dekorasinya. Aku sangat ragu sang Titan memiliki selera yang sama dengannya."
      Speaker = "Hades"
      Event = "HadesAboutHouse01"
    }
    {
      Id = "MelinoeField_1573"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kecuali jika Zagreus sangat menyukai hiasan emas dan patung wajah sang Titan yang tersenyum sinis di mana-mana, maka tempat itu sudah jauh berbeda dari yang kau ingat..."
      Speaker = "Melinoe"
      Event = "HadesAboutHouse01"
    }
    {
      Id = "Hades_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Urgghh... {#Prev}kejujuranmu benar-benar persis ibumu, tanpa tedeng aling-aling. Seharusnya kau bilang saja semuanya {#Emph}baik-baik saja! {#Prev}Terkadang, pelipur lara dari sebuah kebohongan adalah satu-satunya hal yang kita punya."
      Speaker = "Hades"
      Event = "HadesAboutHouse01"
    }
    {
      Id = "Hades_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak percaya sampai menanyakan ini, tapi, bagaimana kabar Olympus di tengah semua kekacauan ini? Terperangkap di dalam ruangan ini pun, sudah jelas bagiku bahwa legiun sang Titan sedang berperang di atas sana."
      Speaker = "Hades"
      Event = "HadesAboutSurface01"
    }
    {
      Id = "MelinoeField_1692"
      InheritFrom = "BaseNarrative"
      DisplayName = "Permukaan dipenuhi orang mati, dan bala tentara Chronos mengepung gunung. Keluarga kita berusaha menahan mereka. Aku mencoba memecah kebuntuan demi pihak kita, tapi sejujurnya, keadaan di atas sana sama sekali tidak elok sekarang."
      Speaker = "Melinoe"
      Event = "HadesAboutSurface01"
    }
    {
      Id = "Hades_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sama sekali tidak elok di atas sana... {#Prev}maksudmu kau melihat langsung semua itu dengan matamu sendiri? {#Emph}Bagaimana bisa?"
      Speaker = "Hades"
      Event = "HadesAboutSurface01"
    }
    {
      Id = "MelinoeField_1693"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksud Ayah hak lahir kita. Percayakah Ayah kalau aku menemukan cara untuk bertahan dari iklim permukaan untuk sementara waktu? Cukup lama untuk membawa perubahan di atas sana... atau setidaknya mencoba."
      Speaker = "Melinoe"
      Event = "HadesAboutSurface01"
    }
    {
      Id = "Hades_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mustahil... namun tampaknya, segala kemustahilan ini terus saja terjadi. Jadi kau harus menaklukkan sang Titan, sekaligus menyelamatkan Olympus. Benar-benar tak masuk akal beban seberat itu ditimpakan padamu...."
      Speaker = "Hades"
      Event = "HadesAboutSurface01"
    }
    {
      Id = "Hades_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka kau pernah melihat Olympus dengan matamu sendiri... saudaramu bahkan tak pernah mendapat kesempatan itu. Dan aku sendiri... hidupku ada di sini, dan aku tak punya kenangan akan puncak-puncak gunung."
      Speaker = "Hades"
      Event = "HadesAboutAutomatons01"
    }
    {
      Id = "MelinoeField_2833"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti dulunya pemandangan yang megah. Sekarang tempat itu dikerumuni legiun sang Titan, dan para Automaton penjaga tak berakal yang ingin menghancurkan {#Emph}diriku {#Prev}sama besarnya dengan musuh kita."
      Speaker = "Melinoe"
      Event = "HadesAboutAutomatons01"
    }
    {
      Id = "Hades_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kubilang pada mereka jangan pernah bergantung pada perkakas semacam itu! Pasukan sejati harus digerakkan oleh kejayaan, atau setidaknya rasa takut. Automaton mereka tidak merasakan {#Emph}apa pun! {#Prev}Seberapa hebat mereka bisa bertarung?"
      Speaker = "Hades"
      Event = "HadesAboutAutomatons01"
    }
    {
      Id = "Hades_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kegelapan bergolak dengan cara yang sudah lama sekali tak kurasakan. Ini bukan ulah sang Titan. Pasti ulah sang Penyihir Persimpangan Jalan, atau dirimu sendiri."
      Speaker = "Hades"
      Event = "HadesAboutShrine01"
    }
    {
      Id = "MelinoeField_2009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah: {#Emph}Dalam bayang-bayang aku mengabdi; ke dalam bayang-bayang aku kembali. {#Prev}Demikianlah sumpahku pada Sumpah Kaum Gaib, yang mengabdi pada alam ini, dan menjalankan kehendak sang Malam."
      Speaker = "Melinoe"
      Event = "HadesAboutShrine01"
    }
    {
      Id = "Hades_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengetahuanku tentang Kaum Gaib lebih sedikit dari dugaanmu. Memang seharusnya begitu, agar sang Titan tak bisa mengorek lebih banyak. Kalau begitu, semoga kau menjalankan kehendak sang Malam dengan bijak..."
      Speaker = "Hades"
      Event = "HadesAboutShrine01"
    }
    {
      Id = "Hades_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tengkorak di tanganmu itu, apakah itu... bagaimana bisa kau memilikinya? Dulu benda itu dipercayakan dalam penjagaan ibumu... demi perlindungannya, dan dalam hal tertentu, perlindunganmu."
      Speaker = "Hades"
      Event = "HadesAboutPersephoneAspect01"
    }
    {
      Id = "MelinoeField_2836"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wujud Revaal, Tengkorak Perak milik Ibu, menganggapku cukup layak membawanya... namun Kepala Sekolah Hecate-lah yang pertama kali mengumpulkan Senjata Nokturnal untuk tugasku."
      Speaker = "Melinoe"
      Event = "HadesAboutPersephoneAspect01"
    }
    {
      Id = "Hades_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ditempa oleh Tiga Takdir! Yang begitu suka mempermainkan kita layaknya orang bodoh. Tengkorak itu tak melindungi sang Ratu sebaik yang kuharapkan; tapi mungkin saja tugasnya memang belum selesai."
      Speaker = "Hades"
      Event = "HadesAboutPersephoneAspect01"
    }
    {
      Id = "Hades_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekacauan yang begitu ribut terjadi setelah kunjungan terakhirmu. Kapan tepatnya aku tak tahu pasti. Seluruh pelayan sang Titan yang hina panik luar biasa. Jeritan mereka tak henti-hentinya bergema. Apa yang terjadi?"
      Speaker = "Hades"
      Event = "HadesAboutChronosBossW01"
    }
    {
      Id = "MelinoeField_1493"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin mereka mencemaskan tuan mereka. Atau sibuk mencoba membangkitkannya kembali. Karena aku berhasil membantainya, akhirnya. Dan itu bukan kali terakhirnya."
      Speaker = "Melinoe"
      Event = "HadesAboutChronosBossW01"
    }
    {
      Id = "Hades_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Darah dan kegelapan, {#Emph}hah... ugh! {#Prev}Jadi kau berhasil mewujudkan... sesuatu yang dulu butuh separuh kekuatan Olympus yang terkutuk itu... seorang diri."
      Speaker = "Hades"
      Event = "HadesAboutChronosBossW01"
    }
    {
      Id = "MelinoeField_1494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama sekali bukan seorang diri. Aku mengerahkan kekuatan mereka, jika bukan dukungan mereka; sama seperti Ayah yang memberikan kekuatan Ayah padaku. Ayah, kita bisa menghentikannya. Dan untuk sekarang... kita bisa membunuhnya."
      Speaker = "Melinoe"
      Event = "HadesAboutChronosBossW01"
    }
    {
      Id = "Hades_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia akan menuntut balas dengan dendam yang makin membara. Seluruh rencananya ini digerakkan oleh dorongan yang sama. Kalau begitu, bunuh dia jika memang harus. Setidaknya... kematiannya yang berkali-kali itu bisa membuatnya tetap sibuk."
      Speaker = "Hades"
      Event = "HadesAboutChronosBossW01"
    }
    {
      Id = "MelinoeField_1691"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin mereka mencemaskan tuan mereka. Atau sibuk mencoba membangkitkannya kembali. Karena aku berhasil membantainya sekali lagi. Dan itu bukan kali terakhirnya."
      Speaker = "Melinoe"
      Event = "HadesAboutChronosBossW01_B"
    }
    {
      Id = "Hades_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Darah dan kegelapan, {#Emph}hah! Ugh... {#Prev}Berhasil mencapai hasil seperti itu... yang dulu membutuhkan separuh kekuatan terkutuk seluruh Olympus, seorang diri..."
      Speaker = "Hades"
      Event = "HadesAboutChronosBossW01_B"
    }
    {
      Id = "MelinoeField_1568"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat Chronos menculik keluarga kita dan merebut Rumah, lalu Ayah meminta sang Penyihir Persimpangan Jalan membawaku... entah bagaimana aku mengingatnya, atau memimpikannya. Apakah dia... menuntut Ayah memberitahukan tentang Tiga Takdir?"
      Speaker = "Melinoe"
      Event = "HadesAboutChronosNightmare01"
    }
    {
      Id = "Hades_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana mungkin kau...? Mungkin Tiga Takdir sendiri yang mengizinkanmu melihat secuil penglihatan itu. Ayahku mencari mereka, tapi aku tak membocorkan apa pun. Tak akan bisa sekalipun aku berniat, karena tak ada yang tahu keberadaan ketiga sosok itu, selain {#Emph}mereka sendiri."
      Speaker = "Hades"
      Event = "HadesAboutChronosNightmare01"
    }
    {
      Id = "MelinoeField_1569"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, Ayah tak pernah memberitahu Chronos cara menemukan Tiga Takdir? Lalu bagaimana {#Emph}bisa {#Prev}dia menemukan mereka? Karena dia berhasil menawan mereka. Belum lama ini, mungkin, tapi nyata adanya. Aku yakin sekali."
      Speaker = "Melinoe"
      Event = "HadesAboutChronosNightmare01"
    }
    {
      Id = "Hades_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa?! Tidak... tapi jika ini benar, rencana penaklukan ayahku sudah jauh lebih dekat dengan keberhasilan daripada dugaanku. Jika mereka berdua saja tak mampu menghentikannya... Putriku, peluang apa yang {#Emph}kau {#Prev}miliki...?"
      Speaker = "Hades"
      Event = "HadesAboutChronosNightmare01"
    }
    {
      Id = "Hades_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ayahku... dia mendatangiku belum lama ini. Menuntutku memberitahukan di mana bisa menemukanmu. Kutegaskan bahwa aku tak tahu. Tapi kau makin menarik perhatiannya."
      Speaker = "Hades"
      Event = "HadesAboutUltimateProgress01"
    }
    {
      Id = "MelinoeField_5078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksud Ayah dia menyiksa Ayah, bedebah terkutuk itu. Dia tak perlu repot-repot mencariku; aku sendiri yang akan mendatanginya."
      Speaker = "Melinoe"
      Event = "HadesAboutUltimateProgress01"
    }
    {
      Id = "Hades_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan salah paham... kami hanya berbicara. Walau harus kuakui, hal itu sendiri adalah peristiwa langka. Dia tak pernah tahu harus bagaimana memperlakukan saudara-saudaraku atau diriku... seharusnya dia tak pernah memiliki kami."
      Speaker = "Hades"
      Event = "HadesAboutUltimateProgress01"
    }
    {
      Id = "MelinoeField_5079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah, tolong jangan bicara begitu. Sebenarnya apa yang terjadi di antara kalian semua...? Aku tahu kisah bagaimana kalian menaklukkannya, tapi... tahu sangat sedikit tentang masa kecil Ayah."
      Speaker = "Melinoe"
      Event = "HadesAboutUltimateProgress01"
    }
    {
      Id = "Hades_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kami sering bertengkar. Dia percaya kami akan mewarisi sifatnya. Tak ada satu pun dari kami yang demikian. Dan saat Tiga Takdir memutuskan bahwa sudah tiba waktunya bagi kami untuk berkuasa menggantikannya... dia menentang. Dengan sengit. Tapi kenangan-kenangan lama ini... lebih baik kubiarkan terkubur."
      Speaker = "Hades"
      Event = "HadesAboutUltimateProgress01"
    }
    {
      Id = "MelinoeField_5080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kumohon bertahanlah, Ayah. Aku harus merahasiakan rinciannya, tapi... aku makin dekat dengan sesuatu... cara untuk menghentikan Chronos. Selamanya."
      Speaker = "Melinoe"
      Event = "HadesAboutUltimateProgress02"
    }
    {
      Id = "Hades_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamanya... bahkan saat saudara-saudara dan saudari-saudari angkatku menaklukkannya bersama... kami tahu dia kelak akan kembali... seorang Titan yang abadi. Tapi kami kira... itu akan terjadi sesuai kehendak kami. Betapa bodohnya kami."
      Speaker = "Hades"
      Event = "HadesAboutUltimateProgress02"
    }
    {
      Id = "MelinoeField_5081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa lagi yang bisa Ayah lakukan? Dia tak memberi kalian pilihan. Dan kalian kekurangan sarana untuk membinasakannya sama sekali."
      Speaker = "Melinoe"
      Event = "HadesAboutUltimateProgress02"
    }
    {
      Id = "Hades_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin ada baiknya kami kekurangan sarana itu... kami pasti akan menggunakannya dan terus menggunakannya. Tugasku hanyalah mengadili orang mati, setidaknya dulu... aku tak pernah pantas mengadili orang yang hidup."
      Speaker = "Hades"
      Event = "HadesAboutUltimateProgress02"
    }
    {
      Id = "Hades_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak disangka kau mungkin bisa menghentikan sang Titan selamanya. Di masa mudaku, aku bahkan tak sudi percaya bahwa kami sedarah. Namun kini kusadari... aku telah menua, menjadi hina, dan penuh murka... persis sepertinya."
      Speaker = "Hades"
      Event = "HadesAboutUltimateProgress03"
    }
    {
      Id = "MelinoeField_5063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Ayahanda, amarahkulah yang membawaku sampai ke titik ini! Dan bagaimana mungkin Ayah menyamakan diri dengannya? Lihat apa yang telah diperbuat sang Titan kepada Ayah..."
      Speaker = "Melinoe"
      Event = "HadesAboutUltimateProgress03"
    }
    {
      Id = "Hades_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita yang menimpakan ini pada {#Emph}satu sama lain! {#Prev}Dewa dan Titan... dikutuk untuk hidup abadi, tapi tak pernah belajar dari kesalahan. Lakukan yang harus kaulakukan... tapi jangan menuntut balas atas namaku."
      Speaker = "Hades"
      Event = "HadesAboutUltimateProgress03"
    }
    {
      Id = "Hades_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putriku, jawab pertanyaanku. Bagaimana bisa bala tentara sang Titan terorganisasi begitu rapi hingga mampu mengepung Olimpus, sementara sang Titan sendiri meringkuk di Tartarus ini?"
      Speaker = "Hades"
      Event = "HadesAboutPrometheus01"
    }
    {
      Id = "MelinoeField_2832"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami harus menghadapi Titan lain di sana: Prometheus memimpin penyerangan itu. Aku tak tahu persis bagaimana dia bisa bebas, atau apa yang sebenarnya dia inginkan... selain balas dendam kepada para dewa."
      Speaker = "Melinoe"
      Event = "HadesAboutPrometheus01"
    }
    {
      Id = "Hades_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukankah dendam kepada para dewa sudah lebih dari cukup sebagai alasan? Aku tak sudi ikut campur saat dia diadili... tapi Paman Zeuskmu, yah... dia selalu mengklaim bisa merancang hukuman yang jauh lebih kreatif daripadaku..."
      Speaker = "Hades"
      Event = "HadesAboutPrometheus01"
    }
    {
      Id = "MelinoeField_3101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah, sepertinya situasi di Olimpus jauh lebih genting dari dugaan kita... Chronos membangkitkan kembali Typhon, yang ukurannya sangat, {#Emph}sangat {#Prev}raksasa... dan bertekad bulat menghancurkan Istana Zeus."
      Speaker = "Melinoe"
      Event = "HadesAboutTyphon01"
    }
    {
      Id = "Hades_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cuih! {#Prev}Tindakan gegabah yang sangat mudah ditebak dari sang Titan. Meski mungkin pamanmu Zeus sudah tak selincah dulu saat mereka pertama kali bentrok."
      Speaker = "Hades"
      Event = "HadesAboutTyphon01"
    }
    {
      Id = "MelinoeField_3102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah tampak tak terkejut sama sekali. Bagaimana kalian mengalahkan Typhon dulu? Aku belum pernah melawan monster sebesar itu."
      Speaker = "Melinoe"
      Event = "HadesAboutTyphon01"
    }
    {
      Id = "Hades_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau memang tak seharusnya melawannya, Putriku! Biarkan Zeus membereskan kekacauannya sendiri. Petirnya terbukti cukup ampuh di masa lalu... meski aneh rasanya perwujudan badai dan murka murka seperti itu bisa mempan disetrum."
      Speaker = "Hades"
      Event = "HadesAboutTyphon01"
    }
    {
      Id = "MelinoeField_3103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak akan menelantarkan keluarga kita menghadapi ancaman ini sendirian."
      Speaker = "Melinoe"
      Event = "HadesAboutTyphon01"
    }
    {
      Id = "Hades_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, kau salah tempat. Karena jika kau pikir menumbangkan sang Titan otomatis akan menghentikan Typhon, kau keliru. Monster semacam itu tak bisa dikendalikan. Pergi dan buktikanlah sendiri."
      Speaker = "Hades"
      Event = "HadesAboutTyphon01"
    }
    {
      Id = "MelinoeField_3930"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah tampak tak terkejut sama sekali. Bagaimana kalian mengalahkan Typhon dulu? Caraku sejauh ini belum membuahkan hasil jangka panjang."
      Speaker = "Melinoe"
      Event = "HadesAboutTyphon01_B"
    }
    {
      Id = "Hades_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Caramu? {#Prev}Biarkan Zeus membereskan kekacauannya sendiri. Petirnya terbukti cukup ampuh di masa lalu... meski aneh rasanya perwujudan badai dan murka seperti itu bisa mempan disetrum."
      Speaker = "Hades"
      Event = "HadesAboutTyphon01_B"
    }
    {
      Id = "Hades_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada kabar apa tentang Typhon belakangan ini, Putriku? Zeus dulunya gemar membual tentang bagaimana dia menaklukkan monster itu sendirian. Sekarang kubayangkan butuh upaya yang jauh lebih terpadu."
      Speaker = "Hades"
      Event = "HadesAboutTyphon02"
    }
    {
      Id = "MelinoeField_3104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah, jika Ayah masih mendendam pada Paman Zeus, itu hanya akan menguntungkan para musuh kita. Typhon masih mengancam puncak gunung... dia bisa dipukul mundur, tapi tak akan lama."
      Speaker = "Melinoe"
      Event = "HadesAboutTyphon02"
    }
    {
      Id = "Hades_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami pernah menguburnya di bawah gunung; itu bukan sekadar unjuk kekuatan biasa, karena cara lain terbukti gagal. Yah, kupercayakan saudaraku punya semacam {#Emph}rencana. {#Prev}Dia tak pernah kehabisan akal soal itu."
      Speaker = "Hades"
      Event = "HadesAboutTyphon02"
    }
    {
      Id = "Hades_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Saat kami pertama kali harus menghalau Typhon dulu, kami tak pernah menyangka Penguasa Titan yang telah kami singkirkan itulah dalangnya. Pastinya {#Emph}dia {#Prev}pun tak sebodoh itu sampai percaya monster liar seperti itu mau tunduk pada kehendaknya!"
      Speaker = "Hades"
      Event = "HadesAboutTyphon03"
    }
    {
      Id = "MelinoeField_3105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos mungkin cuma berharap monster itu langsung menyerang Olimpus. Bagaimana bisa dia membangkitkan makhluk sebesar itu tanpa disadari oleh keluarga kita?"
      Speaker = "Melinoe"
      Event = "HadesAboutTyphon03"
    }
    {
      Id = "Hades_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan ditawannya Nyx sendiri oleh sang Penguasa Titan, segala hal yang terjadi di kedalaman Bumi tak bisa diketahui oleh siapa pun. Dan sekarang... meski Typhon dan sang Titan pernah kami tumbangkan sebelumnya... kami tak pernah harus menghadapi keduanya secara bersamaan."
      Speaker = "Hades"
      Event = "HadesAboutTyphon03"
    }
    {
      Id = "Hades_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah agak lama aku tak melihatmu... mungkin kau sibuk menghalau Typhon yang berupaya mendobrak istana gunung saudaraku yang nyaris tak tertembus itu."
      Speaker = "Hades"
      Event = "HadesAboutTyphon04"
    }
    {
      Id = "MelinoeField_3106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penilaian yang sangat akurat tentang perjalananku belakangan ini, ya. Typhon mungkin tampak tak terkalahkan, tapi tak ada makhluk hidup yang suka wajahnya dihantam bertubi-tubi."
      Speaker = "Melinoe"
      Event = "HadesAboutTyphon04"
    }
    {
      Id = "Hades_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Taktik kuno yang terbukti ampuh bagi para pendahulumu di pertempuran terhebat masa muda mereka. Sudah kuduga bakal begitu; pada akhirnya, tak banyak yang berubah seiring berjalannya waktu."
      Speaker = "Hades"
      Event = "HadesAboutTyphon04"
    }
    {
      Id = "Hades_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa lagi selain Prometheus yang berada di bawah kendali Chronos? Aku ingin tahu setiap Titan atau bajingan sejenis yang berani berbalik melawan kita."
      Speaker = "Hades"
      Event = "HadesAboutChronosAllies01"
    }
    {
      Id = "MelinoeField_2835"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selain gerombolan Satir penjarah dan sebangsanya, yang terlintas di benakku antara lain Kiklops Polyphemus... dan putri Nyx, Eris... meski dia mungkin bertindak atas kemauannya sendiri."
      Speaker = "Melinoe"
      Event = "HadesAboutChronosAllies01"
    }
    {
      Id = "Hades_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perpecahan tak akan pernah bisa dikendalikan, Nyx sangat paham soal itu. Mengenai Kiklops itu... dia dan Pamanmu Poseidon punya masa lalu buruk yang mungkin memicu amarahnya. Yah... setidaknya daftar musuh kita belum bertambah terlalu panjang."
      Speaker = "Hades"
      Event = "HadesAboutChronosAllies01"
    }
    {
      Id = "Hades_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putriku, beritahu aku... apa yang terjadi pada Penyihir Persimpangan Jalan, jika kau tahu. Saat segalanya tampak pupus... ibumu dan aku menitipkanmu dalam asuhannya."
      Speaker = "Hades"
      Event = "HadesAboutHecate01"
    }
    {
      Id = "MelinoeField_1497"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan dia merawatku sejak saat itu. Mempersiapkanku. Namun, sebaiknya kita tidak membicarakannya di ruangan ini. Singkatnya, kaum Gaib tetap aman dalam bayang-bayang."
      Speaker = "Melinoe"
      Event = "HadesAboutHecate01"
    }
    {
      Id = "Hades_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah. Dia memang... yah, seperti katamu, sebaiknya kita tak bicara lebih jauh. Tapi jika kau punya kesempatan, sampaikan rasa terima kasihku yang terdalam padanya."
      Speaker = "Hades"
      Event = "HadesAboutHecate01"
    }
    {
      Id = "Hades_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyx sendiri... bahkan dia pun tak berdaya melawan sang Titan. Dua putra Sang Wujud Malam mengabdi di Kediamanku bersamanya... kurasa Chronos menawan mereka juga."
      Speaker = "Hades"
      Event = "HadesAboutNyx01"
    }
    {
      Id = "MelinoeField_2008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, Hypnos bersama {#Emph}kami! {#Prev}Dia tertidur lelap selama ini, mungkin semacam... respons perlindungan diri, karena kami belum menemukan cara membangunkannya. Schelemeus yang gagah berani juga bersama kami!"
      Speaker = "Melinoe"
      Event = "HadesAboutNyx01"
    }
    {
      Id = "Hades_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hypnos, tertidur {#Emph}lagi? {#Prev}Dan aku tak ingat nama yang satunya lagi... Waktu benar-benar menggerogotiku. Terlepas dari itu, jika sang Penyihir masih memimpin kaum Gaib, tekad Sang Malam belumlah padam."
      Speaker = "Hades"
      Event = "HadesAboutNyx01"
    }
    {
      Id = "Hades_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudara-saudaraku membantumu, begitu? Zeus, sudah pasti memimpin dari balik dinding istananya yang aman... Poseidon, bersesumbar seolah kemenangannya sudah di depan mata..."
      Speaker = "Hades"
      Event = "HadesAboutBrothers01"
    }
    {
      Id = "MelinoeField_2007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah, mereka bertarung untuk membela tanah kelahiran mereka... dan mereka bertarung demi {#Emph}Ayah! {#Prev}Ayah benar bahwa tak satu pun dari mereka sudi memperlihatkan kekhawatiran, tapi untuk apa? Rasa takut itu menular."
      Speaker = "Melinoe"
      Event = "HadesAboutBrothers01"
    }
    {
      Id = "Hades_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka berpangku tangan tanpa peduli di alam permukaan terlalu lama...! Tapi jangan dengarkan ocehanku tentang mereka. Seandainya kau mengenal saudaramu sendiri, mungkin kau akan lebih mengerti dorongan di balik celetukan pedas semacam itu..."
      Speaker = "Hades"
      Event = "HadesAboutBrothers01"
    }
    {
      Id = "Hades_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang telah diperbuat Titan keparat itu pada Cerberus, sampai-sampai dia menerobos ke tempat ini dengan begitu beringas, hanya untuk diusir keluar lagi? Butuh sepasukan kecil Satir untuk memukulnya mundur..."
      Speaker = "Hades"
      Event = "HadesAboutCerberus01"
    }
    {
      Id = "MelinoeField_1498"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos mencampakkannya ke Padang Ratapan di atas. Di sana, amarah dan keputusasaan mengerubunginya, membuat akal sehatnya hilang. Jalanku sendiri membentang melintasi tempat dia berdiam."
      Speaker = "Melinoe"
      Event = "HadesAboutCerberus01"
    }
    {
      Id = "Hades_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau terpaksa menghadapinya dalam keadaan menyedihkan seperti itu. Terima kasih, Putriku, karena telah berbelas kasih pada binatang pemurung itu. Dia pernah hidup lebih baik, tapi juga pernah melalui yang lebih buruk. Kau terlalu kecil untuk menjalin ikatan dengannya dulu, tapi mungkin... belum terlambat sekarang."
      Speaker = "Hades"
      Event = "HadesAboutCerberus01"
    }
    {
      Id = "Hades_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cerberus terlihat sangat gelisah, dan aku mulai paham alasannya. Bukan hanya karena terpaksa berkeliaran di Mourning Fields; kemungkinan dia bisa merasakan kebangkitan kembali Typhon."
      Speaker = "Hades"
      Event = "HadesAboutCerberus02"
    }
    {
      Id = "MelinoeField_3316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hampir semua monster yang kuhadapi sepertinya punya garis keturunan dari Typhon. Aku ragu dia punya hubungan dekat dengan sanak saudaranya; bahkan tidak dengan Cerberus sekalipun."
      Speaker = "Melinoe"
      Event = "HadesAboutCerberus02"
    }
    {
      Id = "Hades_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun meragukannya. Sepertinya tak ada satu pun dari kita yang bisa lepas dari pengaruh ayah kita. Namun di sinilah kita semua, masih bertahan."
      Speaker = "Hades"
      Event = "HadesAboutCerberus02"
    }
    {
      Id = "Hades_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebaiknya kau menjaga jarak di sana, atau lebih tepatnya anjing itu yang harus menjaga jarak. Meskipun... Sang Penyihir Crossroads, dia dulu punya seekor anjing pemburu yang sangat mirip dengan yang satu itu..."
      Speaker = "Hades"
      Event = "HadesAboutHoundFamiliar01"
    }
    {
      Id = "MelinoeField_3319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu pasti anjing yang sama. Namanya Hecuba, dan aku yakin dia akan bersikap hormat padamu dan juga Cerberus. Lagi pula, mereka sudah pernah bertemu di Fields..."
      Speaker = "Melinoe"
      Event = "HadesAboutHoundFamiliar01"
    }
    {
      Id = "Hades_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makhluk yang memiliki kesetiaan dan keberanian, kalau begitu. Kombinasi yang sangat langka, entah pada binatang maupun makhluk lainnya. Jaga sikapmu baik-baik di hadapannya, Cerberus."
      Speaker = "Hades"
      Event = "HadesAboutHoundFamiliar01"
    }
    {
      Id = "MelinoeField_1577"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di mana Cerberus, Ayah? Dia biasanya ada di sini. Aku melihatnya di Fields seperti sebelumnya!"
      Speaker = "Melinoe"
      Event = "HadesAboutBouldy01"
    }
    {
      Id = "Hades_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia mengamuk ke sana kemari atas perintahku. Memecah fokus pasukan sang Titan agar kewalahan. Pada akhirnya mereka akan memukulnya mundur, tapi mereka takkan sanggup melukainya."
      Speaker = "Hades"
      Event = "HadesAboutBouldy01"
    }
    {
      Id = "MelinoeField_1578"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi hanya Ayah dan batu besar ini, ya. Kelihatannya batu itu sudah cukup lama tidak didorong menaiki bukit mana pun. Chronos tidak memaksamu melakukannya?"
      Speaker = "Melinoe"
      Event = "HadesAboutBouldy01"
    }
    {
      Id = "Hades_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bakal lebih mudah mendorongnya dibanding arwah Shade biasa. Lagipula, belenggu ini tak bisa dibuka, kecuali atas perintah sang Titan. Namun aku lebih memilih membusuk di sini selamanya daripada harus merangkak menjilat kakinya."
      Speaker = "Hades"
      Event = "HadesAboutBouldy01"
    }
    {
      Id = "MelinoeField_1579"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah bilang batu besar ini dulunya teman seorang raja fana? Aku... merasakan sesuatu darinya. Ternyata ada energi yang begitu melimpah di dalam sebongkah batu biasa."
      Speaker = "Melinoe"
      Event = "HadesAboutBouldy01"
    }
    {
      Id = "Hades_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupegang perkataanmu. Batu besar ini dan aku... hubungan kami tak sedekat pemilik lamanya. Tapi mungkin kau bisa membujuk sesuatu darinya; sang Penyihir rupanya telah mengajarimu segalanya."
      Speaker = "Hades"
      Event = "HadesAboutBouldy01"
    }
    {
      Id = "MelinoeField_1578_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi hanya Ayah dan batu besar ini, ya. Kelihatannya batu itu sudah cukup lama tidak didorong menaiki bukit mana pun. Ayah bilang batu besar ini dulunya teman seorang raja fana? Aku... merasakan sesuatu darinya. Ternyata ada energi yang begitu melimpah di dalam sebongkah batu biasa."
      Speaker = "Melinoe"
      Event = "HadesAboutBouldy01_B"
    }
    {
      Id = "Hades_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah batu besar itu sudah menyingkapkan sesuatu padamu? Entah mengapa aku bertanya, mungkin hanya takhayul tak berdasar dariku saja... tapi kulihat kau sesekali menghampirinya."
      Speaker = "Hades"
      Event = "HadesAboutBouldy02"
    }
    {
      Id = "MelinoeField_4153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah berbicara begitu lembut tentang tahanan yang dulu dikurung di sini, seolah Ayah telah memaafkannya. Dulu kukira hal semacam itu mustahil terjadi di Tartarus. Batu besar ini kini mengingatkanku akan hal sebaliknya."
      Speaker = "Melinoe"
      Event = "HadesAboutBouldy02"
    }
    {
      Id = "Hades_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian besar bajingan yang dulu kami tawan di sini tak punya harapan akan pengampunan atau kebebasan sedikit pun, namun bahkan mereka pun berhasil kabur, meski tak pantas mendapatkannya. Maka biarlah batu besar ini berdiri sebagai saksi bisu atas segala yang telah berlalu, dan yang kelak akan terjadi."
      Speaker = "Hades"
      Event = "HadesAboutBouldy02"
    }
    {
      Id = "Hades_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aroma darah. Kau terluka. Dan kau masih berharap bisa menghadapi sang Titan? Setidaknya kau berada di tempat yang tepat jika kau sampai mati."
      Speaker = "Hades"
      Event = "HadesAboutCharon01"
    }
    {
      Id = "MelinoeField_1571"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan mati di sini apa pun yang terjadi. Mengenai lukaku, mungkin Tuan Charon punya persediaan Life Essence."
      Speaker = "Melinoe"
      Event = "HadesAboutCharon01"
    }
    {
      Id = "Hades_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan sekarang pun, sang Pendayung masih menjajakan dagangannya? Konyol sekali. Seluruh kegiatan operasional kita sudah ditutup paksa! Walaupun... aku harus ingat bahwa dia melayani alam ini, bukan aku."
      Speaker = "Hades"
      Event = "HadesAboutCharon01"
    }
    {
      Id = "Hades_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putriku. Ceritakan sedikit tentang dirimu, karena aku sama sekali tak tahu apa-apa. Misalnya... apa yang suka kau lakukan? Saat kau sedang tidak... mencoba melakukan misi ini."
      Speaker = "Hades"
      Event = "HadesAboutMelinoe01"
    }
    {
      Id = "MelinoeField_1994"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang suka kulakukan? Yah... aku memastikan semua bahan reagenku tertata rapi, jadi saat melatih sihirku, apa yang kubutuhkan selalu berada dalam jangkauan. Dan aku suka... {#Emph}ungh{#Prev}, Ayah, ini terdengar canggung sekali..."
      Speaker = "Melinoe"
      Event = "HadesAboutMelinoe01"
    }
    {
      Id = "Hades_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm. {#Prev}Bukan waktu maupun tempat yang tepat untuk obrolan sepele... tapi barangkali, di lain waktu... kita bisa membicarakan hal-hal seperti itu lebih banyak. Namun ada perhitungan yang harus diselesaikan terlebih dahulu."
      Speaker = "Hades"
      Event = "HadesAboutMelinoe01"
    }
    {
      Id = "Hades_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mewarisi Death Defiance. Bakat alami keluarga. Kakakmu, Zagreus, dia juga bertubuh liat terlepas dari perawakannya. Keras kepala, sejak masih bocah."
      Speaker = "Hades"
      Event = "HadesAboutZagreus01"
    }
    {
      Id = "MelinoeField_1572"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan bicara tentangnya seolah dia sudah tiada! Chronos memang menawannya, juga Ibu, dan yang lainnya. Tapi setelah semua ini selesai... kita akan saling bertemu kembali."
      Speaker = "Melinoe"
      Event = "HadesAboutZagreus01"
    }
    {
      Id = "Hades_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kau bisa begitu yakin? Memberi kepastian sebesar itu atas hal yang tak menentu! Sang Titan... ayahku... dia takkan berhenti. Dia adalah yang paling keras kepala di antara kita semua."
      Speaker = "Hades"
      Event = "HadesAboutZagreus01"
    }
    {
      Id = "Hades_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibumu begitu bangga saat kau lahir ke dunia. Kami... tak pernah mengira akan memiliki anak lagi. Namun kami memutuskan untuk mencobanya sekali lagi."
      Speaker = "Hades"
      Event = "HadesAboutPersephone01"
    }
    {
      Id = "MelinoeField_1574"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kalian berdua telah melakukan hal paling penting yang bisa dilakukan orang tua. Kalian {#Emph}melindungiku{#Prev}. Sedangkan mengenai Ibu, aku tahu senyum cantiknya. Sorot tatapannya padaku di lukisan yang kusimpan."
      Speaker = "Melinoe"
      Event = "HadesAboutPersephone01"
    }
    {
      Id = "Hades_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lukisan itu, berhasil selamat?! Sang Penyihir, dia pasti yang menyelamatkannya... nekat sekali mengambil risiko sebesar itu demi sebuah lukisan. Ketahuilah bahwa pesona ibumu... mustahil diabadikan seutuhnya. Tak peduli sehebat apa pun keahlian sang seniman."
      Speaker = "Hades"
      Event = "HadesAboutPersephone01"
    }
    {
      Id = "MelinoeField_4160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah, aku ingin bertanya soal keponakanmu, Heracles. Dalam perjumpaanku dengannya, dia sempat menyinggung soal kunjungannya menemuimu dan Cerberus di Underworld ini..."
      Speaker = "Melinoe"
      Event = "HadesAboutHeracles01"
    }
    {
      Id = "Hades_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cih{#Prev}, Heracles! Dia membopong Cerberus bulat-bulat sampai ke permukaan, apa dia menceritakan itu padamu? Bukan atas kehendaknya sendiri, katanya, tapi tetap saja! Aku sampai tak percaya pada mataku sendiri saat dia mengangkat anjing itu."
      Speaker = "Hades"
      Event = "HadesAboutHeracles01"
    }
    {
      Id = "MelinoeField_4161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah membiarkannya begitu saja? Apa Cerberus baik-baik saja?"
      Speaker = "Melinoe"
      Event = "HadesAboutHeracles01"
    }
    {
      Id = "Hades_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihatlah dia sekarang, tentu saja dia baik-baik saja. Dan aku membiarkan si berandal kasar itu hanya karena apa yang dilakukannya seharusnya mustahil dilakukan siapa pun! Rupanya kejadian itu masih menjadi kebanggaannya sampai sekarang."
      Speaker = "Hades"
      Event = "HadesAboutHeracles01"
    }
    {
      Id = "MelinoeField_1995"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah melihat apa yang terjadi... apa yang Chronos lakukan pada Ibu, kakakku, dan yang lainnya. Di mana mereka? Di mana dia menyekap mereka?"
      Speaker = "Melinoe"
      Event = "HadesAboutFamily01"
    }
    {
      Id = "Hades_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Informasi yang kuketahui sudah tidak mutakhir lagi. Dia... membuat semua orang membeku seketika, entah bagaimana caranya. Kulihat mereka mematung layaknya batu; tidak benar-benar membatu tapi terbelenggu tak berkutik, di Great Hall House. Dia pasti memindahkan dan menyimpan mereka di tempat lain di dalam sana..."
      Speaker = "Hades"
      Event = "HadesAboutFamily01"
    }
    {
      Id = "MelinoeField_1996"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan saat aku berhasil menaklukkan Chronos pada suatu malam, sebagian besar kediaman tetap disegel, dan aku tak bisa berlama-lama di sana. Bagaimana cara kita membebaskan mereka...?"
      Speaker = "Melinoe"
      Event = "HadesAboutFamily01"
    }
    {
      Id = "Hades_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin jika kau memintanya baik-baik pada sang Titan, dia akan menurut? Putriku, aku tak tahu cara membatalkan perbuatannya, dan tak punya petuah bijak untuk dibagi. Namun {#Emph}ini{#Prev}, bisa kuberikan."
      Speaker = "Hades"
      Event = "HadesAboutFamily01"
    }
    {
      Id = "Hades_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku bisa merasakan berkah dari para kerabat kita; Berkah mereka dilarang di alam ini. Kepekaan itu kini menumpul, karena baru sekarang aku mendeteksi pengaruh Ares di sini..."
      Speaker = "Hades"
      Event = "HadesAboutAres01"
    }
    {
      Id = "MelinoeField_3317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepekaan Ayah terhadap berkah permukaan masih utuh. Aku baru menemui Ares setelah yang lainnya. Sepertinya perang ini telah berbalik arah sampai-sampai dia ikut membantu mengakhirinya."
      Speaker = "Melinoe"
      Event = "HadesAboutAres01"
    }
    {
      Id = "Hades_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitukah yang dia katakan padamu...? Satu-satunya alasan yang terpikir olehku mengapa keponakanku berusaha mengakhiri perang adalah jika itu berarti perang yang jauh lebih besar bisa dikobarkan setelahnya. Kendati demikian, jika dia mengaku berada di pihakmu, dia takkan berbohong secara terang-terangan."
      Speaker = "Hades"
      Event = "HadesAboutAres01"
    }
    {
      Id = "MelinoeField_3317_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepekaan Ayah terhadap berkah permukaan masih utuh. Aku baru menemui Ares setelah yang lainnya."
      Speaker = "Melinoe"
      Event = "HadesAboutAres01_B"
    }
    {
      Id = "Hades_0203_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu-satunya alasan yang terpikir olehku mengapa keponakanku berusaha mengakhiri perang adalah jika itu berarti perang yang jauh lebih besar bisa dikobarkan setelahnya. Kendati demikian, jika dia mengaku berada di pihakmu, dia takkan berbohong secara terang-terangan."
      Speaker = "Hades"
      Event = "HadesAboutAres01_B"
    }
    {
      Id = "Hades_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ruangan ini... dulu pernah menampung seorang tawananku. Raja fana yang berani-beraninya mencoba mencurangi Kematian! Kupaksa bajingan itu mendorong batu besar mendaki jalan itu selamanya. Namun dia tetap memaafkanku."
      Speaker = "Hades"
      Event = "HadesAboutSisyphus01"
    }
    {
      Id = "MelinoeField_1575"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lupakan dia, Ayah. Apa gunanya meratapi manusia fana yang sudah mati sekarang? Chronos ingin Ayah tenggelam dalam rasa bersalah. Jangan biarkan."
      Speaker = "Melinoe"
      Event = "HadesAboutSisyphus01"
    }
    {
      Id = "Hades_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau salah paham. Tawanan itu, dia bernama Raja Sisyphus. Batu besarnya di sana bagaikan sahabat baginya. Dia... meminta sahabatnya itu untuk menemaniku. Sampai ada yang datang menemani, katanya."
      Speaker = "Hades"
      Event = "HadesAboutSisyphus01"
    }
    {
      Id = "MelinoeField_1576"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, aku berterima kasih pada batu besar itu dan sang raja. Chronos pasti tak menyangka mantan tawananmu ternyata menyukaimu."
      Speaker = "Melinoe"
      Event = "HadesAboutSisyphus01"
    }
    {
      Id = "Hades_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, sebagian besar dari mereka tidak menyukaiku. Beberapa memilih bergabung dengan legiun sang Titan dan tetap tinggal di Tartarus. Tentu saja bukan di tempat yang bisa kupandang."
      Speaker = "Hades"
      Event = "HadesAboutSisyphus01"
    }
    {
      Id = "MelinoeField_1575_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lupakan dia, Ayah. Apa gunanya meratapi manusia fana yang sudah mati sekarang?"
      Speaker = "Melinoe"
      Event = "HadesAboutSisyphus01_B"
    }
    {
      Id = "Hades_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibumu menyampaikan salam hangatnya, dan memohon maaf karena tak bisa menemaniku di sini kali ini. Urusan tertentu di kediaman membutuhkan perhatian{#Emph}nya{#Prev}, jika bukan perhatianku."
      Speaker = "Hades"
      Event = "HadesAboutPersephoneAway01"
    }
    {
      Id = "MelinoeField_4164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, dan tolong sampaikan salamku juga pada Ibu. Jadi Ayah berada di {#Emph}sini {#Prev}selagi Ibu mengurus berbagai hal di {#Emph}sana... {#Prev}apa kalian mengundi untuk menentukan siapa mengurus apa?"
      Speaker = "Melinoe"
      Event = "HadesAboutPersephoneAway01"
    }
    {
      Id = "Hades_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengundi adalah caraku berakhir di alam ini, dan itu bukan sesuatu yang ingin kuulangi lagi. Lagipula ini lebih sederhana: Berada di sini adalah cara terbaikku untuk memastikan kelanjutan keberhasilanmu."
      Speaker = "Hades"
      Event = "HadesAboutPersephoneAway01"
    }
    {
      Id = "Hades_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagai... bagaimana bisa kau sudah memiliki berkahku, Putriku? Apakah itu... kau membawa pusaka keluarga kita... Pom Berpermata. Dari mana kau mendapatkannya?"
      Speaker = "Hades"
      Event = "HadesAboutStoryReset01"
    }
    {
      Id = "MelinoeField_5219"
      InheritFrom = "BaseNarrative"
      DisplayName = "A... aku tidak ingat dari mana mendapatkannya, a... bukankah aku selalu membawanya? Ayah... a... bukankah Ayah yang... aku tidak mengerti."
      Speaker = "Melinoe"
      Event = "HadesAboutStoryReset01"
    }
    {
      Id = "Hades_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemungkinan besar sang Penyihir Persimpangan yang mendapatkannya, tapi siapa tahu? Pengaruh ayahku begitu kuat... Waktu mengikis ingatan, barangkali. Namun terimalah... Aku bisa menambah kekuatannya."
      Speaker = "Hades"
      Event = "HadesAboutStoryReset01"
    }
    {
      Id = "Persephone_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, Melinoë, kau kembali! Kami mengira mungkin bisa menemuimu di sini... yah, Hades yang menduganya. Aku sendiri takkan pernah menebaknya."
      Speaker = "Persephone"
      Event = "HadesWithPersephone01"
    }
    {
      Id = "Hades_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibumu dan aku sudah menantikan untuk bertemu denganmu lagi semenjak kau pergi. Bagaimana kabarmu? Apakah urusan di Persimpangan berjalan lancar?"
      Speaker = "Hades"
      Event = "HadesWithPersephone01"
    }
    {
      Id = "MelinoeField_4148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya kurang lebih baik-baik saja, Ayah. Senang melihat Ayah di ruangan ini dalam suasana hati yang jauh lebih baik dari sebelumnya, meski... kenapa kembali ke tempat seperti ini? Kukira Ayah lebih memilih berada di tempat lain mana pun."
      Speaker = "Melinoe"
      Event = "HadesWithPersephone01"
    }
    {
      Id = "Hades_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kediaman sebagian sudah tertata kembali, tapi seluruh Tartarus masih menanggung jejak selera ayahku yang berlebihan. Apa pun petaka yang dia timbulkan pada keluarga kita, membereskan dekorasinya akan memakan waktu lebih lama lagi!"
      Speaker = "Hades"
      Event = "HadesWithPersephone01"
    }
    {
      Id = "MelinoeField_4149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakek pasti akan membereskannya. Selain itu, ini juga membuatku bisa mampir menyapa."
      Speaker = "Melinoe"
      Event = "HadesWithPersephone01"
    }
    {
      Id = "Hades_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu aku akan mengambil bagian kecilku dalam menuntun langkahmu. Asalkan aku masih bisa berguna. Ini, terimalah."
      Speaker = "Hades"
      Event = "HadesWithPersephone01"
    }
    {
      Id = "MelinoeField_5008"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jelaga dari Kediaman..."
      Speaker = "Melinoe"
      Event = "HadesWithPersephone01"
    }
    {
      Id = "MelinoeField_4169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar kalian berdua menghadapi semua ini? Pasti sangat melelahkan, harus menata kembali Kediaman dan Dunia Bawah."
      Speaker = "Melinoe"
      Event = "HadesWithPersephone02"
    }
    {
      Id = "Hades_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, ini agak mendingan daripada dipenjara, mencemaskan hal terburuk menimpa keluarga dan anjingku, serta menyaksikan Dunia Bawah menjadi tak bisa dikenali lagi."
      Speaker = "Hades"
      Event = "HadesWithPersephone02"
    }
    {
      Id = "Persephone_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beda cerita denganku. Dalam kehidupan ini... satu saat aku baru saja menjadi seorang ibu, dan sekarang tidak lagi! Bagaimanapun juga, kau dulunya bayi yang sangat menggemaskan, Melinoë."
      Speaker = "Persephone"
      Event = "HadesWithPersephone02"
    }
    {
      Id = "MelinoeField_4170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian selalu bisa mencoba punya anak lagi, kurasa? Lagipula jumlah kita tak sebanding dengan yang ada di Olympus."
      Speaker = "Melinoe"
      Event = "HadesWithPersephone02"
    }
    {
      Id = "Hades_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Augh! {#Prev}Jangan memancing para Dewi Takdir dengan omongan semacam itu, di mana pun mereka berada. Kau dan kakakmu sudah lebih dari cukup."
      Speaker = "Hades"
      Event = "HadesWithPersephone02"
    }
    {
      Id = "MelinoeField_4154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana perkembangan renovasi Kediaman sejauh ini? Kelihatannya sudah cukup banyak kemajuan bahkan sebelum aku pergi."
      Speaker = "Melinoe"
      Event = "HadesWithPersephone03"
    }
    {
      Id = "Hades_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penampilan luar bisa menipu, seperti yang pasti sudah kau ketahui, Putriku. Pekerjaan awal memang agak cepat. Mengurus rinciannya memakan waktu jauh, jauh lebih lama."
      Speaker = "Hades"
      Event = "HadesWithPersephone03"
    }
    {
      Id = "Persephone_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terutama jika semua rinciannya harus persis sama seperti sebelumnya."
      Speaker = "Persephone"
      Event = "HadesWithPersephone03"
    }
    {
      Id = "Hades_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kenapa kita harus puas dengan yang kurang dari itu? Apa pun yang tak ingin kita ubah harus tetap seperti yang kita kehendaki."
      Speaker = "Hades"
      Event = "HadesWithPersephone03"
    }
    {
      Id = "MelinoeField_4155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya seperti proyek yang sangat besar. Ada yang bisa kubantu?"
      Speaker = "Melinoe"
      Event = "HadesWithPersephone03"
    }
    {
      Id = "Persephone_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebaiknya serahkan saja urusan ini pada kami, Melinoë. Kami senang sekali melihatmu di sini! Ayahmu bisa memberikan berkahnya dan mengalihkan pikirannya sejenak dari segala kekacauan ini! Benar begitu, 'kan, Hades?"
      Speaker = "Persephone"
      Event = "HadesWithPersephone03"
    }
    {
      Id = "Hades_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Menggerutu> {#Prev}Tentukan saja pilihanmu lalu pergilah, Putriku."
      Speaker = "Hades"
      Event = "HadesWithPersephone03"
    }
    {
      Id = "Hades_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Emas, di mana-mana, {#Emph}cih! {#Prev}Pantulan cahayanya terus-menerus menyilaukan mataku. Rekonstruksi ini tidak akan pernah ada habisnya! Merenovasi Griya itu sendiri saja masih {#Emph}jauh {#Prev}dari selesai!"
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutRenovations01"
    }
    {
      Id = "Persephone_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak apa-apa, Hades. Belum lama ini keadaannya jauh lebih buruk dari sekarang, dan kita sudah melewati badai yang lebih dahsyat. Mengapa harus terburu-buru begitu?"
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutRenovations01"
    }
    {
      Id = "Hades_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau bukan demi {#Emph}diriku{#Prev}, setidaknya demi {#Emph}dirimu! {#Prev}Tempat ini seharusnya ditata seperti yang selalu kausekai. Tapi kita terpaksa menoleransi selera ayahku sedikit lebih lama lagi, jika memang harus.... Maafkan aku, Melinoë! {#Emph}Ehem{#Prev}, ini untukmu."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutRenovations01"
    }
    {
      Id = "Hades_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya kau kembali juga, Putriku. Dulu aku sudah terbiasa dengan ketidakhadiranmu, tapi akhir-akhir ini rasanya agak berbeda."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutTimePassing01"
    }
    {
      Id = "Persephone_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksud ayahmu, sekarang setelah kami bisa lebih sering melihatmu, rasanya masih saja kurang. Tapi jangan memaksakan diri berkunjung hanya demi kami! Kami tahu akhir-akhir ini kau ditarik ke sana kemari oleh banyak urusan."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutTimePassing01"
    }
    {
      Id = "MelinoeField_4162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya hanya ada dua urusan besar, tapi ya, benar. Beberapa malam terakhir ini aku lebih sering pergi menuju Olimpus. Apakah kalian berdua bisa tetap saling berkabar dengan yang lainnya selama ini?"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutTimePassing01"
    }
    {
      Id = "Hades_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami tetap menjalin kontak dengan Olimpus, ya. Mereka punya urusan sendiri yang harus diselesaikan sebagaimana kita memiliki urusan kita, tapi... kami sudah sepakat untuk berusaha lebih keras demi menjaga jalur komunikasi yang lebih jelas mulai sekarang."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutTimePassing01"
    }
    {
      Id = "MelinoeField_4156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang sekali bisa melihat Ayah dan Ibu di sini. Apakah para Satir dan semacamnya itu membiarkan kalian berdua dengan tenang?"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutLegions01"
    }
    {
      Id = "Hades_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan kita yang harus melanggar prinsip realitas yang kita pahami selama ini, Putriku. Tampaknya ayahku terpaksa membiarkan para pengikut fanatiknya berkeliaran bebas sedikit lebih lama demi mencegah {#Emph}kesalahpahaman {#Prev}lebih lanjut di antara kita."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutLegions01"
    }
    {
      Id = "Persephone_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kalau ingin jawaban yang lebih langsung, Melinoë, para Satir dan semacamnya itu langsung lari terbirit-birit begitu melihat kami. Sering kali sambil memekik kecil seperti kambing!"
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutLegions01"
    }
    {
      Id = "Hades_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu nasibmu tidak seberuntung itu. Hal paling sedikit yang bisa kulakukan bersama ibumu adalah mempersiapkanmu menghadapi konfrontasi terakhir yang telah menanti."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutLegions01"
    }
    {
      Id = "Hades_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami dengar kau sedang dalam perjalanan ke sini, Putriku. Jadi ibumu memastikan kami berdua tiba tepat waktu untuk menyambutmu."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutGreeting01"
    }
    {
      Id = "Persephone_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tega sekali kau membocorkan seluruh rencanaku, Hades! Kami hanya ingin menyapa, Melinoë. Berhubung untuk saat ini kami belum bisa mengundangmu ke Griya."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutGreeting01"
    }
    {
      Id = "MelinoeField_4159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Halo untuk Ayah dan Ibu. Bagaimana kabar semua orang? Zagreus, dan para abdi Griya lainnya?"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutGreeting01"
    }
    {
      Id = "Hades_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka semua sudah kembali bekerja; dan memang seharusnya begitu, sekarang setelah kita selesai berbasa-basi. Enyahkanlah sisa-sisa ancaman ayahku, selagi kami membersihkan tempat ini dari gaya dekorasinya yang mengerikan itu."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutGreeting01"
    }
    {
      Id = "Persephone_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku meminta ayahmu memprioritaskan renovasi ruangan ini, andai tempat ini memang menjadi tempat kita bertemu dari waktu ke waktu. Dan kau tahu apa katanya?"
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutChamber01"
    }
    {
      Id = "MelinoeField_4973"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehm{#Prev}, apakah kurang lebih seperti {#Emph}Tentu, Ratuku, aku akan segera melaksanakan permintaanmu sekarang juga?{#Prev}"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutChamber01"
    }
    {
      Id = "Hades_0372"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma berkata bahwa kita sebaiknya membiarkan pemugaran ruangan ini jadi yang paling terakhir... sebab aku tidak ingin menghapus ingatan tentang keadaannya saat ini. Meski mungkin tempat ini bakal tetap begini selama {#Emph}berabad-abad {#Prev}jika melihat laju pengerjaannya sekarang."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutChamber01"
    }
    {
      Id = "Persephone_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putri kami, bagian dari Kaum Tak Kasatmata... secara resmi, Hades dan aku bahkan tidak seharusnya {#Emph}tahu {#Prev}tentangmu... di mana kau tinggal... sama sekali tidak boleh tahu apa pun."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutUnseen01"
    }
    {
      Id = "Hades_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perlindungan Dunia Bawah adalah tanggung jawab kita bersama... namun jika dipikir-pikir kembali, Niks, dalam kebijaksanaannya, memang mengambil tindakan pencegahan ekstra tertentu, ya."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutUnseen01"
    }
    {
      Id = "MelinoeField_4457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak tahu seberapa rapat rahasia tentang Kaum Tak Kasatmata terjaga hingga saat ini. Bagaimanapun kami harus keluar dari balik bayang-bayang sekali atau dua kali selama menghadapi semua ini."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutUnseen01"
    }
    {
      Id = "Persephone_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Niks sendiri pasti akan menjadi orang pertama yang mengatakan bahwa memang ada gunanya bagi Dunia Bawah untuk menanamkan rasa takut tertentu pada orang lain. Tapi aku merasa sangat beruntung kami bisa mengenalmu bukan hanya dari kisah bisik-bisik pembalasan dendam, melainkan sebagai dirimu yang seutuhnya, Melinoë."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutUnseen01"
    }
    {
      Id = "Hades_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah Khronos... ayahku... apakah dia bersedia menuruti apa yang kau minta dalam semua ini? Tidak ada perubahan tingkah laku atau gerak-gerik yang mencurigakan dan mendadak?"
      Speaker = "Hades"
      Event = "HadesAboutNeoChronos01"
    }
    {
      Id = "MelinoeField_4165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia tetap menjadi dirinya sendiri... maksudku, jati dirinya yang baru. Sikapnya agak menyesal, dan kuakui dia bahkan tampak antusias untuk meredakan dampak-dampak buruk yang masih tertinggal di sini maupun di atas sana."
      Speaker = "Melinoe"
      Event = "HadesAboutNeoChronos01"
    }
    {
      Id = "Hades_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimanapun juga, kita harus tetap waspada. Meski begitu, ayahku tidak pernah bisa menyembunyikan rasa jijiknya. Jika kau berhasil melenyapkan rasa itu darinya... maka dia benar-benar bukan lagi Titan yang kukenal dulu."
      Speaker = "Hades"
      Event = "HadesAboutNeoChronos01"
    }
    {
      Id = "MelinoeField_4171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar Kakek di Kepulauan Diberkati? Aku senang sekali mendengar Paman Zeus dan Ayah bahkan bisa mencarikan posisi yang cocok untuknya di sana."
      Speaker = "Melinoe"
      Event = "HadesAboutNeoChronos02"
    }
    {
      Id = "Hades_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ayahku, secara mengejutkan, cukup kompeten dalam tugas barunya itu, setidaknya sampai sekarang. Pekerjaannya sendiri tidak terlalu berat, meskipun para penghuni Kepulauan Diberkati bisa sangat banyak menuntut."
      Speaker = "Hades"
      Event = "HadesAboutNeoChronos02"
    }
    {
      Id = "MelinoeField_4172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Kakek bertugas melayani jiwa-jiwa paling terhormat di Elisium, memastikan semua kebutuhan mereka terpenuhi, hal-hal seperti itu?"
      Speaker = "Melinoe"
      Event = "HadesAboutNeoChronos02"
    }
    {
      Id = "Hades_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Secara garis besar, tepat seperti itu. Dia cermat terhadap detail, dan tidak mudah lupa. Kami akan terus mengawasinya untuk memastikan dia tetap bersikap demikian."
      Speaker = "Hades"
      Event = "HadesAboutNeoChronos02"
    }
    {
      Id = "Hades_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian besar orang takut menginjakkan kaki di ruangan ini, tapi belum lama ini sosok yang begitu mirip dengan Niks menerobos masuk ke mari. Memberi hormat dengan gusar lalu melenggang pergi begitu saja! Salah satu putri Niks?"
      Speaker = "Hades"
      Event = "HadesAboutNemesis01"
    }
    {
      Id = "MelinoeField_5028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya seperti Nemesis. Praktisnya dia memang jauh lebih ingin menghabisi Khronos dibanding aku sejak awal. Sekarang dia memburu sisa-sisa jejak keberadaannya, sama sepertiku. Kami memang punya semacam persaingan."
      Speaker = "Melinoe"
      Event = "HadesAboutNemesis01"
    }
    {
      Id = "Hades_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, itu hampir membuatku merasa sedikit kasihan pada sisa-sisa jejak itu. Harus berhadapan dengan Ganjaran atau Pembalasan, atau malah kedua-duanya sekaligus."
      Speaker = "Hades"
      Event = "HadesAboutNemesis01"
    }
    {
      Id = "Hades_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putriku... kami sempat... berniat menanyakan lenganmu suatu waktu, karena... yah, ini sekadar rasa penasaran, dan kau tak harus menjawabnya jika hal itu lebih baik dihindari..."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutBackstory01"
    }
    {
      Id = "MelinoeField_5220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, benar juga! Aku sudah sangat terbiasa dengannya sampai-sampai tak terpikir untuk menceritakannya. Dulu... aku pernah mengalami sedikit kecelakaan, sudah lama sekali. Ternyata kendaliku atas hidup dan mati tidak sekuat yang kukira. Sejak saat itu, ini jadi pengingat yang baik."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutBackstory01"
    }
    {
      Id = "Hades_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun hubunganmu dengan orang mati yang kami rasakan sangatlah kuat. Yah, kita semua punya bekas luka dari pelajaran hidup masing-masing... sebagian besar memang tidak terlalu mencolok atau memikat. Ibu dan Aku mengira itu lebih ke pilihan pribadi."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutBackstory01"
    }
    {
      Id = "Hades_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berkat kaulah Hypnos bisa kembali. Dia tak henti-hentinya meminta maaf atas kelalaian tugasnya. Sekarang dia sedang menghitung jumlah hari dia bolos kerja."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutHypnosWakeUp01"
    }
    {
      Id = "Persephone_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami rasa itu bisa membuatnya tetap sibuk... mengingat kita belum bisa menampung pendatang baru sebanyak dulu."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutHypnosWakeUp01"
    }
    {
      Id = "Hades_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengadilan masih tetap ditutup! Meski begitu, jumlah Arwah yang mengantre giliran kian membengkak, dan kami membutuhkan Hypnos untuk menertibkan serta memberi mereka arahan."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutHypnosWakeUp01"
    }
    {
      Id = "Persephone_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi dia bakal kerepotan membendung mereka semua kalau kita sendiri tidak tahu kapan pengadilan akan dibuka kembali."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutHypnosWakeUp01"
    }
    {
      Id = "Hades_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Augh{#Prev}, tak perlu kita buat putri kita bosan dengan urusan tetek bengek administratif. Intinya, putra Nyx yang hilang itu sekarang sudah ditemukan. Berkurang satu masalah."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutHypnosWakeUp01"
    }
    {
      Id = "Hades_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa Ibumu dan Aku tidak salah dengar kalau kau dan kakakmu bentrok? Di tengah-tengah Elysium dan disaksikan oleh semua orang...?"
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutZagreusFight01"
    }
    {
      Id = "MelinoeField_4376"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan begitu, Ayah, tidak seperti yang Ayah pikirkan! Itu cuma pertandingan ekshibisi; sekadar tantangan persahabatan, tak lebih. Walaupun Zagreus sama sekali tidak menahan diri."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutZagreusFight01"
    }
    {
      Id = "Hades_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keputusan yang cerdik dari anak itu, atau lebih tepatnya darimu. Di tengah segala kemelut di Dunia Bawah, {#Emph}pertandingan ekshibisi{#Prev} semacam itu, meminjam istilahmu, mungkin justru hal yang sangat dibutuhkan para Arwah."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutZagreusFight01"
    }
    {
      Id = "Persephone_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Penyuntik semangat! {#Prev}Kurasa mereka memang menyukai hiburan berdarah semacam itu di sana. Yah, selama Melinoë dan Zagreus tidak keberatan..."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutZagreusFight01"
    }
    {
      Id = "Hades_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berguru pada Penyihir Persimpangan, sedangkan dia berlatih di bawah bimbingan prajurit terhebat sepanjang sejarah perang fana. Siapa yang lebih unggul mungkin masih jadi perdebatan sengit."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutZagreusFight01"
    }
    {
      Id = "Persephone_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bertarung lagi dengan kakakmu? Di kehidupan yang lain, Ibu sempat heran melihat betapa akurnya kalian berdua saat tumbuh bersama. Mungkin karena dia lebih tua..."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutZagreusFight02"
    }
    {
      Id = "MelinoeField_5223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami memang sering bikin masalah, seingatku. Tapi aku tak bisa meminta sosok kakak laki-laki yang lebih baik darinya. Dia menjagaku, bermain denganku... dan sekarang aku berkesempatan menghajarnya!"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutZagreusFight02"
    }
    {
      Id = "Persephone_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah, tak perlu segan-segan padanya. Asalkan itu hanya untuk tontonan! Kurasa perselisihan sungguhan dalam keluarga kita sudah lebih dari cukup untuk beberapa waktu ke depan."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutZagreusFight02"
    }
    {
      Id = "Persephone_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu hampir lupa bilang, Achilles menyampaikan salam dan doa terbaiknya! Katanya dia mengenang kembali latihan tanding yang kau lalui bersama Zagreus... {#Emph}ehm{#Prev}, yang mungkin pernah kau lalui. Dia dan pelayan Graha lainnya sudah membaik belakangan ini."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutAchilles01"
    }
    {
      Id = "MelinoeField_5178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang mendengarnya, dan tolong sampaikan salam hangatku kembali untuknya. Mengenalnya, setidaknya di masa lalu kita yang lain... aku sempat cemas dia akan sangat terpukul atas apa yang terjadi. Maksudku, penyerangan ke Graha."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutAchilles01"
    }
    {
      Id = "Persephone_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa dia memang sangat terpukul, dengan caranya sendiri. Tugasnya adalah melindungi Graha, tapi Chronos terlalu kuat untuknya... untuk kita semua. Mungkin dewa seperti kita, atau pahlawan seperti Achilles, butuh diingatkan oleh dunia agar tetap rendah hati dari waktu ke waktu..."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutAchilles01"
    }
    {
      Id = "Persephone_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau ingat saat kau sering menunggangi Cerberus seolah dia kuda tunggangan setiamu? Setidaknya dia masih bisa banyak bergerak sekarang berkat dirimu."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutCerberus01"
    }
    {
      Id = "MelinoeField_5179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingat, tentu saja! Ibu membantuku naik ke punggungnya agar tidak jatuh. Dia sangat sabar dan lembut mengingat dulu aku sering memperlakukannya dengan kasar. Di tempat aku dibesarkan di Persimpangan, hanya ada binatang-binatang kecil yang menemaniku."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutCerberus01"
    }
    {
      Id = "Persephone_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makin ramai makin baik, kurasa. Kau selalu jadi putri kecil kami saat tumbuh besar, di masa lalu yang lain itu... mungkin kami tidak setegas Hecate padamu."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutCerberus01"
    }
    {
      Id = "Persephone_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tentu sangat mirip dengan putri yang kuingat dari masa lalu kita yang lain, atau yang pernah kita impikan. Tapi perbedaan-perbedaan kecil dirimu dari Melinoë yang itu sungguh memikat. Kau tampak... lebih dewasa. Lebih terkendali."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutAltChildhood01"
    }
    {
      Id = "MelinoeField_5224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... kurasa aku terpaksa tumbuh lebih cepat di Persimpangan daripada di Graha, jadi mungkin itu alasannya. Aku juga tidak mendapat banyak pelatihan di kehidupan yang itu. Tapi kurasa aku tetaplah diriku!"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutAltChildhood01"
    }
    {
      Id = "Persephone_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu selalu bertanya-tanya, sampai sejauh mana kepribadian mendasar kita terbentuk, atau apakah lingkungan dan pola asuh yang justru membentuk kita. Jawabannya mungkin ada di antara keduanya."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutAltChildhood01"
    }
    {
      Id = "Persephone_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sibuk sekali, dan meski begitu keadaannya pasti akan tetap semrawut entah sampai kapan. Pasti memakan waktu lebih dari rentang hidup manusia fana... bahkan beberapa generasi, kurasa."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutUnderworld01"
    }
    {
      Id = "MelinoeField_4458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memulihkan seluruh Dunia Bawah agar berfungsi normal kembali dan memperbaiki semua kerusakan akibat Chronos jelas bukan proses yang singkat. Tapi aku senang bisa membantu mempercepatnya."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutUnderworld01"
    }
    {
      Id = "Persephone_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan apa kami sudah bilang kalau kami sangat menghargai bantuanmu? Ayo, Hades, berikan kata-kata terbaikmu untuknya."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutUnderworld01"
    }
    {
      Id = "Persephone_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalur yang aneh sekali yang kau tempuh melintasi Dunia Bawah. Sekarang kau mungkin sudah menghabiskan lebih banyak waktu di Oceanus atau Padang Ratapan daripada Ibu..."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutUnderworld02"
    }
    {
      Id = "MelinoeField_4470"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalur langsung menuju Tartarus tertutup, jadi sekarang kami bertahan pada jalur yang bisa dilewati. Aku sudah terbiasa dengannya, begitu pula dengan berbagai ketidaknyamanan di sepanjang jalan."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutUnderworld02"
    }
    {
      Id = "Persephone_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita harus terus mengawasi beberapa tempat itu, bukan begitu, Hades? Tak pernah ada kata tenang di sekitar sini."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutUnderworld02"
    }
    {
      Id = "Persephone_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hades takkan mau membicarakannya di depan umum, tapi urusan administratif kita benar-benar menumpuk. Jumlah manusia fana yang binasa sejak kita kehilangan Graha, ditambah lagi dampak dari perang... sungguh mengerikan."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutBacklog01"
    }
    {
      Id = "MelinoeField_4466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua Arwah itu harus diproses, diadili, dan ditempatkan... dan dalam beberapa kasus, harus dicari dulu keberadaannya. Bagaimana cara Ayah dan Ibu menyelesaikan semua itu?"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutBacklog01"
    }
    {
      Id = "Persephone_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita akan menyelesaikannya perlahan-lahan pada waktunya. Seperti Daedalus yang memahat mahakaryanya yang paling rumit sedikit demi sedikit. Dan untuk saat ini, masih banyak tempat kosong di Asphodel bagi Arwah yang butuh tempat tinggal."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutBacklog01"
    }
    {
      Id = "MelinoeField_4468"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu, bukankah Ibu ditunggu di Olympus dalam waktu dekat? Akhir-akhir ini aku sering bepergian ke sana... meski begitu, Ibu pasti punya cara yang jauh lebih efisien daripada caraku."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutOlympus01"
    }
    {
      Id = "Persephone_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Caraku dulu adalah berkat bantuan Hermes, di masa saat seluruh permukaan belum dipenuhi sisa-sisa perang baru-baru ini yang berbahaya. Dan, tidak... untuk sekarang, perjalananku ditunda. Kami semua sepakat menunggu sampai keadaan benar-benar tenang."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutOlympus01"
    }
    {
      Id = "MelinoeField_4469"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi itu mungkin masih sangat lama... terkadang upaya pemulihan ini terasa seolah butuh waktu selamanya."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutOlympus01"
    }
    {
      Id = "Persephone_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita ini para dewi dan dewa; kita harus sabar, atau setidaknya, memang seharusnya begitu. Nenekmu Demeter dan Ibu akan mencari cara lain untuk tetap saling berkabar untuk saat ini."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutOlympus01"
    }
    {
      Id = "Persephone_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau juga mendapatkan berkatku, kau tahu itu, kan, Melinoë? Sayangnya, Ibu tidak bisa memberimu jenis berkat yang lebih nyata saat kita masih beres-beres sisa kekacauan Chronos."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutBlessings01"
    }
    {
      Id = "Hades_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu berkat dariku saja sudah cukup, bukan? Putri kita sudah berulang kali menghadapi dan menaklukkan sang Titan... tidak ada gunanya mengubah sesuatu yang sudah berjalan dengan baik."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutBlessings01"
    }
    {
      Id = "MelinoeField_4163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa melihat Ayah dan Ibu saja sudah cukup memberiku tenaga sampai akhir. Meski aku yakin berkat Ibu akan membuatku jauh lebih kuat. Kuasa atas hidup dan mati, dan sebagainya...!"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutBlessings01"
    }
    {
      Id = "Persephone_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kalau kau menyatakannya {#Emph}seperti {#Prev}itu... kurasa sifatku memang lebih mirip ibuku sendiri daripada yang kusadari."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutBlessings01"
    }
    {
      Id = "Hades_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putriku... ibumu membawa kehidupan ke alam ini yang seharusnya mustahil bersemi, dan kita jauh lebih kaya karenanya."
      Speaker = "Hades"
      Event = "HadesWithPersephoneAboutBlessings01"
    }
    {
      Id = "Persephone_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Delima kecil yang kami berikan padamu itu. Kami hanya memesan sedikit sekali dan hanya menggunakan batu permata terbaik, kami memang berniat memberikannya padamu begitu kau beranjak dewasa..."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutKeepsake01"
    }
    {
      Id = "MelinoeField_4459"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kejutan yang manis! Dan terima kasih. Bukan cuma indah, tapi itu juga membuatku merasa lebih terhubung dengan Ayah dan Ibu."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutKeepsake01"
    }
    {
      Id = "Persephone_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Buah Delima memang konon punya efek seperti itu. Orang bisa makan segenggam bijinya saja dan tak akan pernah mau meninggalkan Dunia Bawah lagi!"
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutKeepsake01"
    }
    {
      Id = "Persephone_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu senang Delima kecil yang kami berikan padamu itu berguna. Buah delima tidak selalu tumbuh di Dunia Bawah ini... dulu saat Ibu baru tiba, tempat ini jauh lebih suram."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutKeepsake02"
    }
    {
      Id = "MelinoeField_5225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Apa yang kulihat di permukaan justru terasa jauh lebih suram daripada di sini. Tapi kurasa aku cuma melihat sedikit bagian yang luluh lantak akibat perang. Apa Ibu pernah merindukan berada di atas sana?"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutKeepsake02"
    }
    {
      Id = "Persephone_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu merindukan beberapa hal di sana sesekali. Tapi Dunia Bawah sudah menjadi rumahku, begitu pula bagi ayahmu. Dan sekarang juga bagi kakakmu dan dirimu... yang ternyata menjadi alasan kuat untuk terus merawatnya!"
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutKeepsake02"
    }
    {
      Id = "Persephone_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tengkorak Revaal... Nyx pernah menawarkannya pada Ibu untuk perlindungan, andai terjadi sesuatu. Tak pernah terpikir oleh Ibu senjata itu akan melindungiku bahkan saat tidak berada dalam genggamanku."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutPersephoneAspect01"
    }
    {
      Id = "MelinoeField_4461"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa Ibu ingin memintanya kembali sekarang? Mungkin tugasku sebagai pembawa Revaal sudah hampir selesai sekarang setelah Ibu kembali."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutPersephoneAspect01"
    }
    {
      Id = "Persephone_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, entah para Moirai sudah menentukannya dari awal atau Ibu yang memutuskannya sekarang, tidak usah, terima kasih. Kalau Tengkorak Perak sudah membawamu {#Emph}sejauh {#Prev}ini, berarti kalian berdua adalah rekan yang serasi."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutPersephoneAspect01"
    }
    {
      Id = "Persephone_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyandang Aspek Revaal milikku, dan menggunakan Delima Permata keluarga kita... Ibu sempat berharap kami bisa membantumu, tapi tidak menyangka akan lewat cara ini!"
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutPersephoneAspect02"
    }
    {
      Id = "MelinoeField_5222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berkat Ayah dan Tengkorak Perak adalah kombinasi yang hebat. Dan aku jadi teringat semua masa yang kita lalui bersama... yah, yang harusnya bisa kita lalui bersama."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutPersephoneAspect02"
    }
    {
      Id = "Persephone_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meskipun masa lalu lain itu hanyalah kemungkinan yang tak terwujud, kenangannya nyata, dan Ibu akan menyimpannya baik-baik... berdampingan dengan kenangan-kenangan baru yang kita ciptakan sejak saat itu."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutPersephoneAspect02"
    }
    {
      Id = "Persephone_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyx tidak selalu menunjukkannya, tapi dia sangat berterima kasih atas semua yang telah kau lakukan, lho. Kau bahkan menggunakan Aspek Xinth miliknya... untung saja gengsinya tidak terlalu tinggi!"
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutNyxAspect01"
    }
    {
      Id = "MelinoeField_5226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sering kali harus mengingatkan diri sendiri bahwa begitu banyak bagian dunia yang kukenal ini ada berkat dirinya... belum lagi Kaum Tak Kasat Mata. Dia luar biasa... tapi pasti sangat sibuk."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutNyxAspect01"
    }
    {
      Id = "Persephone_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, alasan awal ayahmu datang ke sini adalah untuk meringankan sebagian dari beban itu. Dan bayangkan saja... memimpin seluruh Dunia Bawah hanyalah {#Emph}sebagian {#Prev}dari tanggung jawabnya. Terima kasih sudah membantunya."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutNyxAspect01"
    }
    {
      Id = "Persephone_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang Ibu berharap kita bisa menghabiskan lebih banyak waktu bersama, tahu? Tapi kemudian Ibu teringat bagaimana rasanya bagi {#Emph}Ibu {#Prev}saat beranjak dewasa. Pokoknya... jangan lupa kami ada di sini jika kau butuh apa pun."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutDemeter01"
    }
    {
      Id = "MelinoeField_4467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja tidak akan kulupakan. Bagaimana rasanya tinggal bersama Nenek? Dia tampak begitu tegas dan cakap... aku sangat menyukainya."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutDemeter01"
    }
    {
      Id = "Persephone_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu senang mendengarnya. Nenekmu Demeter dan Ibu, kami memang sempat berselisih sesekali, tapi semuanya membaik semenjak Ibu pindah ke sini. Kesimpulan terbesarku dari semua itu adalah anak-anak butuh ruang tersendiri... seberat apa pun rasanya untuk melepaskan mereka."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutDemeter01"
    }
    {
      Id = "MelinoeField_4462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana hubungan Ibu dengan Sang Penyihir Persimpangan, Bu? Dia sangat menghormati Ibu dan Ayah, setidaknya itu yang kutahu."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutHecate01"
    }
    {
      Id = "Persephone_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hekate adalah dayang terbaik yang pernah diharapkan seorang Ratu, terlepas dari sifatnya yang pendiam. Kami tahu dia menjalankan urusannya dalam bayang-bayang, tapi di hadapan kami, dia orang yang sangat bisa diandalkan."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutHecate01"
    }
    {
      Id = "MelinoeField_4463"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu bilang dia dayang Ibu... hal itu sudah tidak berlaku lagi sekarang, bukan?"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutHecate01"
    }
    {
      Id = "Persephone_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu bisa mencari dayang lain. Tapi hanya ada satu Penyihir Persimpangan, dan dari semua yang kami amati, dia membutuhkanmu sama besarnya seperti kau membutuhkannya. Bisa dibilang, kami justru lebih mengandalkannya sekarang dibanding sebelumnya."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutHecate01"
    }
    {
      Id = "Persephone_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga, kau terluka... Melinoë, siapa pun yang melakukan ini padamu, begitu Tartarus pulih sepenuhnya, kita mungkin harus menyediakan tempat khusus untuk mereka."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneLowHealth01"
    }
    {
      Id = "MelinoeField_4460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak apa-apa, Bu... ini semua bagian dari proses akhir-akhir ini. Luka-luka luar ini akan lenyap sepenuhnya besok malam. Mungkin lebih cepat kalau aku beruntung."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneLowHealth01"
    }
    {
      Id = "Persephone_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagian dari proses, ya... menapak tilas langkahmu persis seperti saat kau membebaskan kami dulu. Semuanya terasa begitu aneh..."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneLowHealth01"
    }
    {
      Id = "Hades_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami mendengar tentang kembalinya Tiga Moirai. Seberapa besar peranmu di dalamnya biarlah menjadi rahasiamu, tapi katakan pada kami... apakah mereka dalam suasana hati yang baik, setidaknya?"
      Speaker = "Hades"
      Event = "HadesWithPersephonePostEpilogue01"
    }
    {
      Id = "MelinoeField_4157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya begitu. Klotho, yang berbicara paling banyak, suasana hatinya tampak begitu ceria, sekarang Ayah mengungkitnya! Sampai-sampai aku sulit membayangkan dia dalam suasana hati yang lain..."
      Speaker = "Melinoe"
      Event = "HadesWithPersephonePostEpilogue01"
    }
    {
      Id = "Hades_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu mungkin kita beruntung... karena suasana hati mereka bisa sangat labil. Emosi mereka mungkin bukan satu-satunya penentu hasil tenunan takdir, tapi jelas ada sangkut pautnya."
      Speaker = "Hades"
      Event = "HadesWithPersephonePostEpilogue01"
    }
    {
      Id = "Persephone_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita diberitahu bahwa mereka akan berhenti menenun untuk sementara waktu. Tapi kau sendiri tidak percaya hal itu, kan, Hades...?"
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostEpilogue01"
    }
    {
      Id = "Hades_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, sama sekali tidak. Meski begitu, kalian bebas menarik kesimpulan apa pun yang kalian anggap pantas."
      Speaker = "Hades"
      Event = "HadesWithPersephonePostEpilogue01"
    }
    {
      Id = "Persephone_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë, bagaimana tanggapanmu soal era baru yang diramalkan Tiga Dewi Takdir ini? Kau tahu kau memiliki darah fana di dalam dirimu... mungkin ini demi kebaikan bersama."
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostEpilogue02"
    }
    {
      Id = "MelinoeField_4158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berhasil melewatinya dengan baik walau Tiga Dewi Takdir seakan menyerahkan segalanya pada kita... jadi jika memang begitulah jalannya ke depan, aku menerimanya. Tapi, bagaimana dengan Dunia Bawah, jika pengaruh para dewa kian memudar?"
      Speaker = "Melinoe"
      Event = "HadesWithPersephonePostEpilogue02"
    }
    {
      Id = "Hades_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita akan beradaptasi, seperti yang selalu kita lakukan. Namun kecuali jika {#Emph}era baru {#Prev}ini melenyapkan ciri mutlak kaum fana—bahwa mereka semua pada akhirnya akan binasa—maka kurasa apa yang kita lakukan di sini akan selalu memiliki tujuan yang amat krusial."
      Speaker = "Hades"
      Event = "HadesWithPersephonePostEpilogue02"
    }
    {
      Id = "MelinoeField_4464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah Ayah dan Ibu pernah... punya kesempatan untuk berbicara dengan Penyihir Persimpangan... dengan Hecate, sesekali?"
      Speaker = "Melinoe"
      Event = "HadesWithPersephonePostEpilogue03"
    }
    {
      Id = "Persephone_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengingat tanggung jawabnya, saat ini kami tak seharusnya terlihat menikmati Ambrosia bersama, begitu pula dengan dirimu. Kami memang kerap mendengar kabarnya, tapi kami tetap menghormati privasinya."
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostEpilogue03"
    }
    {
      Id = "MelinoeField_4465"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, begitu ya, baiklah... lagipula, kupikir... itu akan sangat berarti baginya jika bisa mendengar kabar dari kalian sesekali, jika kalian tak keberatan? Beliau berjuang begitu keras demi membebaskan kalian... lebih keras dari siapa pun."
      Speaker = "Melinoe"
      Event = "HadesWithPersephonePostEpilogue03"
    }
    {
      Id = "Persephone_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hahah{#Prev}, baiklah. Kurasa kita bisa mencari cara untuk mengirim pesan sesekali menembus tabir itu, benar kan, Hades? Hecate akan selalu mendapatkan rasa terima kasih kami. Bagaimanapun juga, dialah yang menyelamatkan putri kecil kita."
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostEpilogue03"
    }
    {
      Id = "Persephone_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kami begitu sibuk akhir-akhir ini, Putriku, sampai-sampai kita jarang punya waktu untuk bertemu di sini...!"
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_4471"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak apa-apa, Ibu, tak perlu memaksakan diri sampai repot. Sekadar sapaan singkat sesekali pun sudah cukup."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneAboutSayingLittle01"
    }
    {
      Id = "Persephone_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin butuh waktu cukup lama selagi kita membereskan urusan ini. Tapi mari tetap saling berkabar jika waktu memungkinkan."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneAboutSayingLittle01"
    }
    {
      Id = "Hades_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hentikan kebodohan ini, Putriku. Tak ada yang bisa menghentikannya. Dia adalah keniscayaan itu sendiri."
      Speaker = "Hades"
      Event = "HadesChat01"
    }
    {
      Id = "Hades_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengambil risiko yang terlalu besar dengan menjengukku ke sini."
      Speaker = "Hades"
      Event = "HadesChat02"
    }
    {
      Id = "Hades_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putraku tak pernah mau mendengarkanku; betapa bodohnya aku mengira itu hanya sifat uniknya seorang."
      Speaker = "Hades"
      Event = "HadesChat03"
    }
    {
      Id = "Hades_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatanku kian menipis akhir-akhir ini, tapi yang tersisa ini kuberikan padamu."
      Speaker = "Hades"
      Event = "HadesChat04"
    }
    {
      Id = "Hades_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih sudah menjaga Cerberus, tapi jaga juga dirimu baik-baik."
      Speaker = "Hades"
      Event = "HadesChat05"
    }
    {
      Id = "Hades_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sama keras kepalanya dengan kakakmu, rupanya..."
      Speaker = "Hades"
      Event = "HadesChat06"
    }
    {
      Id = "Hades_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap kali kau kembali... sebagian kekuatanku pun turut pulih."
      Speaker = "Hades"
      Event = "HadesChat07"
    }
    {
      Id = "Hades_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan ambil risiko yang tak perlu dan jangan sampai ketahuan, Putriku."
      Speaker = "Hades"
      Event = "HadesChat08"
    }
    {
      Id = "Hades_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah pernah menundukkan sang Titan sebelumnya; kau tahu persis apa saja yang dibutuhkan."
      Speaker = "Hades"
      Event = "HadesChat09"
    }
    {
      Id = "Hades_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak banyak berguna dalam keadaan seperti ini. Kau tak perlu menyimpang dari jalanmu hanya demi diriku."
      Speaker = "Hades"
      Event = "HadesChat10"
    }
    {
      Id = "Hades_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan menahan diri sedikit pun saat menghadapi sang Titan. Fakta bahwa kalian berkeluarga sama sekali tak berarti baginya."
      Speaker = "Hades"
      Event = "HadesChat11"
    }
    {
      Id = "Hades_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lanjutkan perjalananmu, Putriku. Aku tak butuh bantuan di sini."
      Speaker = "Hades"
      Event = "HadesChat12"
    }
    {
      Id = "Hades_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir Persimpangan telah bersumpah takkan membiarkan bahaya menyentuhmu; pastikan dia menepati janjinya."
      Speaker = "Hades"
      Event = "HadesChat13"
    }
    {
      Id = "Hades_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh aneh bisa menikmati momen yang tenang bersamamu dan Cerberus, di era yang kacau balau seperti ini."
      Speaker = "Hades"
      Event = "HadesChat14"
    }
    {
      Id = "Hades_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami sudah menduga kedatanganmu, tepat sejak anjing itu melompat girang ke sini."
      Speaker = "Hades"
      Event = "HadesChat15"
    }
    {
      Id = "Hades_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergilah, tuntaskan dendammu. Untuk urusan itu, keluarga kita punya persediaan lebih dari cukup."
      Speaker = "Hades"
      Event = "HadesChat16"
    }
    {
      Id = "Hades_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia bukan sekadar Titan biasa. Dia adalah Sang Waktu itu sendiri; dan Waktu takkan pernah bisa dihentikan..."
      Speaker = "Hades"
      Event = "HadesChat18"
    }
    {
      Id = "Hades_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belenggu-belenggu ini menguras keteguhan tekadku; tapi belum seutuhnya."
      Speaker = "Hades"
      Event = "HadesChat19"
    }
    {
      Id = "Hades_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan begini caraku membayangkan putriku menghabiskan malam-malam masa mudanya..."
      Speaker = "Hades"
      Event = "HadesChat20"
    }
    {
      Id = "Hades_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berkat-berkat ini hanyalah hal sepele, tapi jika memang berguna, syukurlah."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat01"
    }
    {
      Id = "Hades_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zagreus menitipkan salamnya. Urusan Dunia Bawah membuatnya sangat sibuk akhir-akhir ini."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat02"
    }
    {
      Id = "Hades_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang dilakukan ayahku terhadap Tartarus adalah aib memalukan yang kelak akan kita perbaiki..."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat03"
    }
    {
      Id = "Hades_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahku mungkin sudah berbeda sekarang, tapi jika ada sisa-sisa dirinya yang lama tertinggal, musnahkan itu."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat06"
    }
    {
      Id = "Hades_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita pastikan bahwa penderitaan seperti yang telah kita lalui takkan pernah terulang kembali."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat07"
    }
    {
      Id = "Hades_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan selalu punya amarah tersisa untuk membalas sisa-sisa diri ayahku yang terdahulu."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat08"
    }
    {
      Id = "Hades_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin menyaksikan kemenanganmu andai aku bisa, tapi ketahuilah jiwaku akan selalu menyertaimu."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat09"
    }
    {
      Id = "Hades_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugasmu kian sering menarikmu ke permukaan, senang bisa melihatmu di sini."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat10"
    }
    {
      Id = "Hades_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cerberus benar-benar tidak bisa diam saat kau mendekat tadi."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat11"
    }
    {
      Id = "Hades_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakakmu menitipkan salam untukmu. Dia pasti sedang berada di suatu tempat dekat permukaan saat ini."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat12"
    }
    {
      Id = "Hades_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cerberus bersikeras bahwa kau akan segera tiba, dan dugaannya terbukti tepat."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat13"
    }
    {
      Id = "Hades_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kegelapan yang begitu menyesakkan di sini... hampir mirip seperti keadaannya dulu."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat14"
    }
    {
      Id = "Hades_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sisa-sisa pasukan ayahku tampak sangat gelisah... semoga saja ini memang perbuatanmu."
      Speaker = "Hades"
      Event = "HadesPostTrueEndingChat15"
    }
    {
      Id = "Persephone_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin keluarga kita makin rekat dan kuat melewati semua ini. Bukankah itu menyenangkan?"
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostTrueEndingChat01"
    }
    {
      Id = "Persephone_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suatu saat nanti, entah siang atau malam, kita harus merapikan ruangan yang satu ini, Hades..."
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostTrueEndingChat02"
    }
    {
      Id = "Persephone_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunjukkan pada bayang-bayang Chronos itu siapa pihak keluarga yang sebenarnya berkuasa di sini."
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostTrueEndingChat03"
    }
    {
      Id = "Hades_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika ada hal lain yang bisa kami lakukan untuk mempermudah perjuanganmu, katakan saja."
      Speaker = "Hades"
      Event = "HadesWithPersephonePostTrueEndingChat04"
    }
    {
      Id = "Hades_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami harap sang Penyihir Persimpangan Jalan dan yang lainnya baik-baik saja belakangan ini?"
      Speaker = "Hades"
      Event = "HadesWithPersephonePostTrueEndingChat05"
    }
    {
      Id = "Hades_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Urusan di Griya tertangani dengan baik. Kami harap kau pun demikian adanya."
      Speaker = "Hades"
      Event = "HadesWithPersephonePostTrueEndingChat06"
    }
    {
      Id = "Hades_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami akan selalu berterima kasih atas apa yang telah kau lakukan, Putriku."
      Speaker = "Hades"
      Event = "HadesWithPersephonePostTrueEndingChat07"
    }
    {
      Id = "Hades_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibumu dan aku sudah menduga kedatanganmu, dan ingin menyampaikan salam hangat kami."
      Speaker = "Hades"
      Event = "HadesWithPersephonePostTrueEndingChat08"
    }
    {
      Id = "Hades_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak yang harus diurus di Griya, tapi sesekali kami perlu melangkah keluar sejenak."
      Speaker = "Hades"
      Event = "HadesWithPersephonePostTrueEndingChat09"
    }
    {
      Id = "Hades_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menyambangimu di sini adalah selingan menyenangkan dari rutinitas kami yang biasa."
      Speaker = "Hades"
      Event = "HadesWithPersephonePostTrueEndingChat10"
    }
    {
      Id = "Hades_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami tidak hanya memuji usahamu, Putriku, tapi juga hasil nyatamu yang begitu konsisten."
      Speaker = "Hades"
      Event = "HadesWithPersephonePostTrueEndingChat11"
    }
    {
      Id = "Persephone_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakakmu menitip pesan agar Ibu menyapa {#Emph}halo {#Prev}untuknya saat bertemu denganmu nanti."
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostTrueEndingChat12"
    }
    {
      Id = "Persephone_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemulihan Griya berjalan cukup lancar, meski Ibu senang bisa mencari udara segar sejenak."
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostTrueEndingChat13"
    }
    {
      Id = "Persephone_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu tahu kau sudah beranjak dewasa sekarang, tapi bagiku kau akan selalu menjadi gadis kecil Ibu."
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostTrueEndingChat14"
    }
    {
      Id = "Persephone_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hades, kurasa ini bukan berkah melainkan kutukan bagi ayahmu..."
      Speaker = "Persephone"
      Event = "HadesWithPersephonePostTrueEndingChat15"
    }
    {
      Id = "MelinoeField_1499"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah, meski kutahu ini belum tentu diperbolehkan, kupikir jika ini bisa memberi sedikit penghiburan, bolehkah kupersembahkan Nektar ini padamu?"
      Speaker = "Melinoe"
      Event = "HadesGiftDecline01"
    }
    {
      Id = "Hades_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Persis seperti kakakmu, sialan... Sayangnya suasana hati atau keadaanku sedang tak pantas untuk barang semacam itu. Jangan cemaskan kenyamananku, fokuskan saja pada target amarahmu."
      Speaker = "Hades"
      Event = "HadesGiftDecline01"
    }
    {
      Id = "MelinoeField_4206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu, Ayah, aku sangat bersyukur kalian kembali hadir dalam hidupku. Banyak hal yang perlu kita bicarakan, tapi kita punya waktu tak terbatas. Untuk saat ini, terimalah hadiah syukuran kecil ini."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift01"
    }
    {
      Id = "Persephone_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}terima kasih {#Prev}banyak, ini {#Emph}sempurna! {#Prev}Persediaan kami di Griya sudah lenyap... jangan-jangan Chronos doyan meminumnya."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneGift01"
    }
    {
      Id = "Hades_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar dari puncak tertinggi... tak kusangka kita dulu sempat melarang zat ini di sini, meski itu jauh sebelum masa hidupmu. Terima kasih, Putriku. Sebagai gantinya, kami punya sesuatu untukmu. Sekadar tanda mata kecil, tapi juga lambang dari keluarga kita."
      Speaker = "Hades"
      Event = "HadesWithPersephoneGift01"
    }
    {
      Id = "Persephone_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Putriku. Ini tentu sangat berguna bagi kami. Malahan, Hades punya rencana khusus untuk menggunakannya."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneGift02"
    }
    {
      Id = "Hades_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau mengizinkannya, Putriku... aku ingin mempersembahkan Nektar ini kepada para Arwah yang membantu pemugaran Bawah Tanah saat ini. Sebagai tanda apresiasi tambahan atas kerja keras mereka. Apakah kau tidak keberatan?"
      Speaker = "Hades"
      Event = "HadesWithPersephoneGift02"
    }
    {
      Id = "MelinoeField_4377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, Ayah, terserah ingin Ayah gunakan untuk apa. Dan menurutku tak ada tujuan yang lebih mulia selain menghadiahi para Arwah yang tetap setia pada kita melewati semua ini."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift02"
    }
    {
      Id = "Persephone_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Botol yang begitu istimewa. Kami menerimanya dengan senang hati! Kau tahu, terkadang kau mengingatkanku pada kakakmu..."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneGift03"
    }
    {
      Id = "Hades_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tradisi persembahan yang kita tiru dari mereka yang di atas... kumohon jangan kau ikuti tradisi kita secara membabi buta. Tradisi semacam itulah yang mungkin turut andil atas banyaknya kesalahan yang menjerumuskan kita ke titik ini."
      Speaker = "Hades"
      Event = "HadesWithPersephoneGift03"
    }
    {
      Id = "MelinoeField_4378"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham kekhawatiran Ayah soal ini, tapi... dari sekian banyak tradisi para dewa, memberikan Nektar kepada mereka yang kita sayangi rasanya tradisi yang cukup baik, menurut penilaianku."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift03"
    }
    {
      Id = "Hades_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Mungkin saja."
      Speaker = "Hades"
      Event = "HadesWithPersephoneGift03"
    }
    {
      Id = "Hades_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti ada banyak orang lain yang bersedia menyambut hadiah seperti ini darimu. Dibesarkan dalam pengasingan di Persimpangan Jalan itu... Aku khawatir hidupmu pasti terasa sangat sepi. Lebih sepi dari yang semestinya."
      Speaker = "Hades"
      Event = "HadesWithPersephoneGift04"
    }
    {
      Id = "Persephone_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesendirian tidak selalu berujung buruk, tapi... sudah pasti itu tidak mudah bagimu."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneGift04"
    }
    {
      Id = "MelinoeField_4379"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah tak perlu mengkhawatirkan hal itu. Tumbuh besar di Persimpangan Jalan memang tidak pernah mudah, tapi... aku tak pernah merasa sendirian. Selalu ada seseorang atau sesuatu tempatku berkeluh kesah... Kadang aku bahkan berbicara ke air mancur yang kami bangun untuk menghormatimu."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift04"
    }
    {
      Id = "Hades_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata-katamu tak cukup meyakinkanku seperti yang kita berdua harapkan. Jika kau tumbuh besar di Rumahku, kau akan dilimpahi banyak perhatian, bukan dipaksa mengeraskan tanganmu dengan kerja keras... terutama untuk anak seusiamu dulu."
      Speaker = "Hades"
      Event = "HadesWithPersephoneGift04"
    }
    {
      Id = "MelinoeField_4380"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah menyesali apa yang harus kulakukan, Ayah. Dan pertemanan apa pun yang kumiliki, sangat kuhargai. Mungkin aku bisa saja tumbuh besar dengan lebih banyak hal, tapi aku punya semua yang kubutuhkan. Selain orang tuaku. Serta kakak dan anjingku."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift04"
    }
    {
      Id = "Persephone_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan sekarang, kau memiliki kami juga."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneGift04"
    }
    {
      Id = "MelinoeField_4381"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terpujilah Takdir."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift04"
    }
    {
      Id = "MelinoeField_4382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu sebagian Nektar ini akan diberikan kepada para Arwah setia kita, tapi aku ingin Ayah dan Ibu menikmatinya berdua saja. Kapan pun waktunya pas, ya... suatu saat nanti."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift05"
    }
    {
      Id = "Hades_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu yang tepat untuk bersenang-senang seperti ini... mungkin setelah pemugaran Bawah Tanah kita selesai, dan kita telah mendata ulang persediaan serta para Arwah dengan benar, baru akhirnya kita bisa menyisihkan waktu untuk beristirahat sejenak."
      Speaker = "Hades"
      Event = "HadesWithPersephoneGift05"
    }
    {
      Id = "Persephone_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, sudahlah, Hades. Kita pasti bisa mengabulkan permintaan Melinoë lebih cepat dari itu. Kau lebih tahu dari siapa pun kalau jerih payah ini takkan pernah ada habisnya, jadi momen beristirahat harus direngkuh begitu ada kesempatan."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneGift05"
    }
    {
      Id = "Hades_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitulah titah Sang Ratu. Terima kasih untuk ini, Putriku. Tapi kau sungguh tak perlu repot-repot memikirkan kami. Kami sudah saling memiliki kembali. Aku sendiri tak menginginkan apa pun lagi."
      Speaker = "Hades"
      Event = "HadesWithPersephoneGift05"
    }
    {
      Id = "MelinoeField_4383"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena kalian sudah menerima Nektar untuk perayaan kecil tadi, aku juga ingin memberikan ini kepada kalian. Untuk saat-saat yang lebih istimewa, mungkin di masa depan, setelah kita nyaris lupa bagaimana rasanya hidup terpisah, dan keadaannya memang menuntut kita untuk bersuka cita."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift06"
    }
    {
      Id = "Persephone_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini... Ambrosia, dan dengan rona yang semurni ini, pastilah langsung dari sumbernya... Putriku, {#Emph}terima kasih...!!"
      Speaker = "Persephone"
      Event = "HadesWithPersephoneGift06"
    }
    {
      Id = "Hades_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ambrosia langsung dari kahyangan itu sendiri... Aku nyaris lupa kelezatannya. Namun aku takkan pernah melupakan bagaimana rasanya hidup terpisah. Dan tak seorang pun dari kita boleh berharap Waktu akan menghapus rasa pedih itu. Mari kita selalu ingat bagaimana kita bisa mencapai titik ini bersama-sama."
      Speaker = "Hades"
      Event = "HadesWithPersephoneGift06"
    }
    {
      Id = "MelinoeField_4384"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat aku masih kecil, Nyonya Hekate pernah mengatakan hal serupa... bahwa kepedihan masa lalu akan selalu membekas, meski kian jarang terasa seiring bertambahnya usia. Kalau begitu, mungkin kita harus merayakan kenangan itu sendiri. Mau sejuta tahun lagi pun, aku tak keberatan."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift06"
    }
    {
      Id = "Persephone_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perayaan sejuta tahun lagi akan memberi kita banyak waktu untuk bersiap-siap, jadi... kenapa tidak, Hades? Ambrosia seperti ini semestinya akan terfermentasi sempurna hingga saat itu tiba."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneGift06"
    }
    {
      Id = "MelinoeField_4385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong beri tahu aku jika aku bisa membantu perencanaan apa pun saat waktunya tiba nanti. Atau jika ada hal lain yang bisa kubantu selagi kalian membereskan Rumah ini kembali."
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift06"
    }
    {
      Id = "Persephone_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamilah yang seharusnya menanyakan hal itu kepadamu. Saat kau lahir, Hades dan aku bersyukur kepada Takdir karena telah dianugerahi anak sepertimu. Namun kami sama sekali tak pernah menyangka..."
      Speaker = "Persephone"
      Event = "HadesWithPersephoneGift06"
    }
    {
      Id = "MelinoeField_4207_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih untuk kalian berdua...!"
      Speaker = "Melinoe"
      Event = "HadesWithPersephoneGift06"
    }
    {
      Id = "Persephone_0028"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Silakan, ambillah."
      Speaker = "Persephone"
      Event = "NPC_Hades_Field_01.GiftGivenVoiceLines"
    }
    {
      Id = "MelinoeField_4207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih banyak atas pemberian ini, Ayah, Ibu."
      Speaker = "Melinoe"
      Event = "NPC_Hades_Field_01.GiftGivenVoiceLines"
    }
    {
      Id = "Hades_0258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sedang tidak berminat untuk ini."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.OnHitVoiceLines"
    }
    {
      Id = "Hades_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mirip sekali dengan kakakmu."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.OnHitVoiceLines"
    }
    {
      Id = "Hades_0260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hentikan ini."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.OnHitVoiceLines"
    }
    {
      Id = "Hades_0261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Putriku?"
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.OnHitVoiceLines"
    }
    {
      Id = "Hades_0046"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, demi darah dan kegelapan..."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.OnHitVoiceLines"
    }
    {
      Id = "Hades_0042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Luapkan amarahmu, jika memang harus."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.OnHitVoiceLines"
    }
    {
      Id = "Hades_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak harus gagal sepertiku."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.OnHitVoiceLines"
    }
    {
      Id = "Hades_0044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tinggalkan aku sendiri."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.OnHitVoiceLines"
    }
    {
      Id = "Hades_0045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tinggalkan aku, kubilang."
      Speaker = "Hades"
      Event = "NPC_Hades_Field_01.OnHitVoiceLines"
    }
    {
      Id = "Hades_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga bayang-bayang menyembunyikanmu."
      Speaker = "Hades"
      Event = "NPC_Hades_02.InteractVoiceLines"
    }
    {
      Id = "Hades_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Saat aku dulu mengalami kesulitan menghadapi putraku... terkadang aku memikirkanmu, Ayah. Tak terbayang olehku jika harus menghadapi lebih banyak anak sekaligus seperti dirimu dulu."
      Speaker = "Hades"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "Chronos_1474"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, yah... Aku pun tak bisa dibilang sukses saat menghadapi kalian semua dulu, kan? Terutama Zeus... tak kusangka aku akan segera melihatnya dan yang lainnya lagi."
      Speaker = "Chronos"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "Hades_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa menjamin bagaimana kau akan disambut. Kenangan bak mimpi yang kita lalui ini sepertinya tak sampai ke Gunung Olympus. Namun Zeus sudah menerima laporan lengkap dariku."
      Speaker = "Hades"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "Chronos_1475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dukungan yang luar biasa meyakinkan! Tapi aku cuma bercanda. Jika Waktu bisa begitu kejam, wajar saja bila anak-anaknya tak jauh berbeda. Tidakkah kau setuju, Cucuku?"
      Speaker = "Chronos"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "MelinoeField_5217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kita punya lebih banyak kesamaan daripada yang mau kita akui. Tapi bagaimanapun juga, Paman Zeus memintamu datang sendirian. Hanya sang Takdir yang tahu apa yang menanti... meskipun masih belum ada tanda-tanda keberadaan mereka, bahkan dengan bantuan Nyx?"
      Speaker = "Melinoe"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "Chronos_1476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nihil. Kulempar mereka ke dalam jurang kehampaan. Andai aku tahu persis tempatnya, mereka pasti sudah tahu jalan kembali. Namun jika hipotesisku tentang kemungkinan-kemungkinan seperti yang kita alami ini benar... kita mungkin bisa menemukan mereka."
      Speaker = "Chronos"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "MelinoeField_5167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti. Dan aku tak sabar untuk menguji hipotesis ini. Mungkin kita semua bisa belajar sesuatu tentang diri kita sendiri."
      Speaker = "Melinoe"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "Chronos_1477"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap demikian! Para Dewa dan Titan mungkin ditakdirkan hidup abadi... tapi kita tak harus terikat pada cara-cara lama."
      Speaker = "Chronos"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "MelinoeField_5168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. {#Emph}Erm{#Prev}, Ayah...? Terima kasih atas semua sambutan hangatmu. Aku senang melihatmu baik-baik saja."
      Speaker = "Melinoe"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "Hades_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan seperti ini jika bukan karenamu, Putriku. Kuyakin kita akan segera bertemu lagi. Dan mungkin kau juga, Ayah."
      Speaker = "Hades"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "Chronos_1478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu pula denganku, Hades. Setidaknya kediaman ini sudah hampir kembali sesuai seleramu. Di luar aula ini, tentu saja, masih banyak yang harus dibenahi."
      Speaker = "Chronos"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "MelinoeField_5169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, begitulah... Ayah, semoga renovasi Dunia Bawah ini berjalan lancar. Mengenai kami, kereta kencana kami sudah tiba."
      Speaker = "Melinoe"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "Chronos_1027"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang benar. Aku sudah siap."
      Speaker = "Chronos"
      Event = "HadesTrueEnding01"
    }
    {
      Id = "Zagreus_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, ini pemandangan yang langka. Kalian berdua ada di ruang santai ini bersama-sama! Ada angin apa kemari, Kakek?"
      Speaker = "Zagreus"
      Event = "HadesHideAndSeek01"
    }
    {
      Id = "Chronos_1413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sedang mencari keberadaan anak perempuan itu, tahu! Sudah kuubek-ubek seluruh penjuru kediaman ini, tapi tak ada tanda-tanda sedikit pun! Dia sudah selincah dirimu dulu, Hades."
      Speaker = "Chronos"
      Event = "HadesHideAndSeek01"
    }
    {
      Id = "Hades_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah itu, atau inderamu yang sudah uzur mulai tumpul. Tadi dia berlari ke arah Koki Kepala, dan masih berdiam diri di sana. Pergilah, sebelum kesabarannya habis."
      Speaker = "Hades"
      Event = "HadesHideAndSeek01"
    }
    {
      Id = "Zagreus_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Erm... {#Prev}maksud Ayah sebenarnya, {#Emph}tidak, kami sama sekali tak tahu ke mana perginya adik perempuan dari putra tercintanya ini! {#Prev}Bisa saja dia ada di mana-mana! Sudah coba periksa ruang administrasi? Ya ampun, aku jadi terdengar seperti Hypnos."
      Speaker = "Zagreus"
      Event = "HadesHideAndSeek01"
    }
    {
      Id = "Chronos_1414"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku menghargai petunjuk itu."
      Speaker = "Chronos"
      Event = "HadesHideAndSeek01"
    }
    {
      Id = "Zagreus_0436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semangat terus usahanya!"
      Speaker = "Zagreus"
      Event = "HadesHideAndSeek01"
    }
    {
      Id = "Chronos_1415"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di mana kau, Nak...?"
      Speaker = "Chronos"
      Event = "HadesHideAndSeek01"
    }
    {
      Id = "MelinoeField_5053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tertawa>"
      Speaker = "Melinoe"
      Event = "HadesHideAndSeek01"
    }
    {
      Id = "Persephone_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenanglah."
      Speaker = "Persephone"
      Event = "NPC_Persephone_01.OnHitVoiceLines"
    }
    {
      Id = "Persephone_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa kau selalu sebersemangat ini?"
      Speaker = "Persephone"
      Event = "NPC_Persephone_01.OnHitVoiceLines"
    }
    {
      Id = "Persephone_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mirip sekali dengan kakakmu."
      Speaker = "Persephone"
      Event = "NPC_Persephone_01.OnHitVoiceLines"
    }
    {
      Id = "Persephone_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo kemarilah."
      Speaker = "Persephone"
      Event = "NPC_Persephone_01.OnHitVoiceLines"
    }
    {
      Id = "Persephone_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putriku yang cantik... kami baru saja membicarakanmu! Tentang seperti apa dirimu saat masih kecil, baik di kehidupan ini maupun kehidupan yang satu lagi. Tumbuh dewasa itu begitu sulit... dan kau harus melaluinya dua kali."
      Speaker = "Persephone"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "MelinoeField_5157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu membuatku merasa amat sangat beruntung. Hecate adalah pengasuh terbaik yang pernah ada. Dan aku sangat bersyukur bisa merasakan hidup bersamamu, Ibu... kehidupan yang dipenuhi begitu banyak kehangatan. Dan sekarang Ibu sudah mengenal sisi lain diriku ini."
      Speaker = "Melinoe"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "Persephone_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan Ibu tak sabar untuk mengenal sisi lain dirimu ini lebih dekat lagi. Dan, Hecate...? Kau yakin ini tidak merepotkanmu... untuk terus menjaganya, sekadar berjaga-jaga?"
      Speaker = "Persephone"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "HecateField_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah bersumpah kepadamu bahwa tiada marabahaya yang akan menyentuh putrimu, Wahai Ratu, dan sumpah itu tetap teguh. Aku akan selalu merawatnya, terlepas dia tinggal bersamaku atau tidak."
      Speaker = "Hecate"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "Persephone_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu sudah diputuskan...! Dan, Melinoë... sekadar memberitahumu... Ibu juga memilih untuk tidak tinggal di rumah saat masih muda dulu!"
      Speaker = "Persephone"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "HecateField_0436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kumohon pertimbangkan lagi hal ini, Melinoë... kau tak mungkin bersungguh-sungguh ingin kembali ke rimba berdebu itu. Rumahmu yang sah ada di sini, dan kau mungkin takkan bisa kembali selama masih bersama kami karena hukum yang jauh lebih kuno dari hukum kita. Mengabdi pada Yang Tak Kasatmata..."
      Speaker = "Hecate"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "MelinoeField_5158"
      InheritFrom = "BaseNarrative"
      DisplayName = "...berarti mengabdi dalam bayang-bayang. Aku sangat memahaminya, Kepala Sekolah, dan aku tak mengambil keputusan ini dengan gegabah, tapi... aku tak bisa meninggalkan Persimpangan. Terutama saat masih banyak hal yang harus kita selesaikan."
      Speaker = "Melinoe"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "Persephone_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bekerja sama dengan Chronos dalam terobosan barunya ini... kau memegang peranan penting dalam mengubah Waktu seperti yang kita kenal, jadi kaulah sosok yang paling tepat untuk menjaga keadaan tetap seperti itu."
      Speaker = "Persephone"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "MelinoeField_5159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memastikan Waktu terus berpihak pada kita sepertinya cara yang bagus untuk memanfaatkan waktuku sendiri! Ini pasti akan menarik, dan perkara ini sangat dekat di hatiku. Mungkin aku memang terlahir untuk ini."
      Speaker = "Melinoe"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "Persephone_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlahir untuk hal yang jauh lebih besar. Tapi kami akan turut mengambil bagian. Cerberus sudah mulai berlarian melintasi Padang Asphodel atas kemauannya sendiri, dan Ayah serta Ibu takkan jauh darinya. Mengenai kakakmu, yah... dia pasti akan selalu muncul!"
      Speaker = "Persephone"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "MelinoeField_5160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua ini butuh penyesuaian besar, ya? Meskipun aku akan segera melihat kalian semua lagi."
      Speaker = "Melinoe"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "Persephone_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah, hahaha! {#Prev}Penyesuaian itu masih ungkapan yang terlalu halus. Sekarang berkelilinglah dulu menyapa yang lain, nanti Ibu antar sebelum kau berangkat. Ibu menyayangimu, gadis kecilku."
      Speaker = "Persephone"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "MelinoeField_5161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku juga menyayangimu, Ibu."
      Speaker = "Melinoe"
      Event = "PersephoneTrueEnding01"
    }
    {
      Id = "Storyteller_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Binatang Neraka yang sempat menebar teror dahsyat di Mourning Fields kini duduk di sana dengan tenang dan penuh harap, bukan menanti sang Putri Bawah Tanah, melainkan sosok lain.{#Prev}"
      Speaker = "Storyteller"
      Event = "CerberusFirstMeeting"
    }
    {
      Id = "Storyteller_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cerberus yang ganas tetap setia menjaga tuannya, setelah berhasil menemukannya di kedalaman ini.{#Prev}"
      Speaker = "Storyteller"
      Event = "CerberusMeeting02"
    }
    {
      Id = "Storyteller_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cerberus berkepala tiga tak mengizinkan siapa pun mendekat, baik kepada dirinya maupun tuannya.{#Prev}"
      Speaker = "Storyteller"
      Event = "CerberusChat01"
    }
    {
      Id = "Storyteller_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Anjing Penjaga Neraka yang mengerikan memamerkan taring-taringnya yang tak terhitung jumlahnya, seolah berkata, menjauhlah.{#Prev}"
      Speaker = "Storyteller"
      Event = "CerberusChat02"
    }
    {
      Id = "Storyteller_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cerberus, anjing penjaga yang ditakuti, menatap sang Putri dengan keenam matanya yang penuh harap.{#Prev}"
