{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _LootData_Poseidon.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "Melinoe_0633"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lambang trisula..."
      Speaker = "Melinoe"
      Event = "PoseidonUpgrade.FirstSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu Poseidon..."
      Speaker = "Melinoe"
      Event = "PoseidonUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1475"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia kembali..."
      Speaker = "Melinoe"
      Event = "PoseidonUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Poseidon_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gabungan kekuatan kita dulu sudah {#Emph}lebih {#Prev}dari cukup untuk menumbangkan Chronos, Keponakan kecilku! Meski itu juga berkat kebijaksanaan saudaraku yang mulia, Zeus, yang menyusun rencana kita! Rencana kita kali ini juga tak kalah hebat, bukan begitu, Saudaraku?!"
      Speaker = "Poseidon"
      Event = "PoseidonWithZeus01"
    }
    {
      Id = "Zeus_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, Poseidon, selalu saja berapi-api. Rencana yang bagus tak semestinya diobral terang-terangan. Untuk saat ini, Melinoë muda? Kami tawarkan kepadamu gabungan kekuatan kami! Tolong bikin repot musuh-musuh kita, ya?"
      Speaker = "Zeus"
      Event = "PoseidonWithZeus01"
    }
    {
      Id = "Poseidon_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu-satunya yang lebih dahsyat dari kekuatan Yang Mulia Zeus, Keponakanku, adalah gabungan kekuatannya denganku! Petir bisa menyambar di atas perairanku jauh lebih cepat daripada saat meluluhlantakkan daratan! Dan sekarang, aku dan saudaraku sang raja agung menganugerahkan kedahsyatan kami kepadamu!"
      Speaker = "Poseidon"
      Event = "PoseidonWithZeus02"
    }
    {
      Id = "Zeus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami {#Emph}meminjamkan {#Prev}kedahsyatan kami kepadamu, Melinoë. Karena keluarga kita saling bekerja sama, memberi dan menerima. Sekarang pergilah dan gunakan kekuatan gabungan kita untuk merebut kembali hak kita!"
      Speaker = "Zeus"
      Event = "PoseidonWithZeus02"
    }
    {
      Id = "Poseidon_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahoi{#Prev}, Keponakan kecilku, aku di sini bersama Ratu Hera yang spektakuler, istri tercantik dari saudaraku yang terhormat, dan segalanya! Sayang sekali aku belum pernah menemukan belahan jiwa sesempurna dirinya! {#Emph}Kau {#Prev}pasti akan merestui kami kalau aku punya, kan, Hera?"
      Speaker = "Poseidon"
      Event = "PoseidonWithHera01"
    }
    {
      Id = "Hera_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, aku pasti akan memberkatimu {#Emph}dan {#Prev}kekasih idamanmu itu siapa pun gerangan orangnya, Poseidon. Barangkali setelah semua ini usai, kau bisa melanjutkan pencarianmu dengan sungguh-sungguh! Tapi sampai saat itu tiba, bersihkan dulu pikiran kotormu itu."
      Speaker = "Hera"
      Event = "PoseidonWithHera01"
    }
    {
      Id = "Poseidon_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau sudah mengenal Apollo yang gilang-gemilang, Keponakanku? Dia begitu tersohor dan dicintai manusia fana sampai-sampai ia terpaksa ikut campur dalam urusan keluarga terbaru kita ini! Tunduk pada desakan kaum fana layaknya busur yang ditarik, {#Emph}hah!"
      Speaker = "Poseidon"
      Event = "PoseidonWithApollo01"
    }
    {
      Id = "Apollo_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Paman, aku tidak selemah itu sampai tunduk pada desakan. Aku cuma tahu masalah ini bakal terlalu berat jika Paman tangani sendirian! Kita bukan sekadar keluarga, kita ini satu tim, kan?"
      Speaker = "Apollo"
      Event = "PoseidonWithApollo01"
    }
    {
      Id = "Poseidon_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, Keponakanku, kau harus tahu kalau Dewi Tetua Demeter dan aku mungkin saling mengejek dan mencela, tapi itu tak pernah bermaksud jahat! Benar begitu, saudari angkatku tersayang?"
      Speaker = "Poseidon"
      Event = "PoseidonWithDemeter01"
    }
    {
      Id = "Demeter_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, Poseidon! Kau tak perlu berbohong pada Melinoë muda seperti itu. Itu memberi kesan yang sangat buruk, dan bisa-bisa membuatnya muak padamu sama sepertiku! Tapi mari bekerja sama untuk sekarang, kenapa tidak?"
      Speaker = "Demeter"
      Event = "PoseidonWithDemeter01"
    }
    {
      Id = "Poseidon_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat pertempuran berkecamuk di mana-mana, hampir tak ada waktu untuk cinta, tak ada tempat bagi keindahan! Namun Aphrodite di sini tak pernah patah arang! Sungguh mengagumkan melihatnya berjuang sekuat tenaga, mengacungkan tombak hiasannya itu!"
      Speaker = "Poseidon"
      Event = "PoseidonWithAphrodite01"
    }
    {
      Id = "Aphrodite_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, Yang Mulia Poseidon, aku senang mendengar bagaimana aku {#Emph}menginspirasimu{#Prev}. Tapi mungkin sebaiknya kau lebih memperhatikan {#Emph}musuh-musuh {#Prev}kita ketimbang mengurusi apa yang kulakukan dengan tombakku {#Emph}ini{#Prev}, agar kita akhirnya bisa membalikkan keadaan!"
      Speaker = "Aphrodite"
      Event = "PoseidonWithAphrodite01"
    }
    {
      Id = "Poseidon_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keponakanku, kita semua harus bekerja tanpa lelah demi membalikkan kehancuran yang diperbuat Chronos! Sebagian bahkan jauh lebih tak kenal lelah dibanding yang lain! Contohnya keponakanku Hephaestus di sini! Kubilang padanya dia boleh bicara sepatah dua patah kata asalkan lanjut menempa setelah ini!"
      Speaker = "Poseidon"
      Event = "PoseidonWithHephaestus01"
    }
    {
      Id = "Hephaestus_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat betapa dermawannya Yang Mulia Poseidon kita ini? {#Emph}Semua orang {#Prev}butuh paman yang baik, setujuku! Beri tahu aku kalau kau berhasil menemukannya. Sekarang... sebaiknya {#Emph}kami {#Prev}di sini kembali menempa urusan kami."
      Speaker = "Hephaestus"
      Event = "PoseidonWithHephaestus01"
    }
    {
      Id = "Poseidon_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah kenal Hestia hampir sejak hari bencana tempat aku dilahirkan! Meski saat keadaan normal kami selalu saling menjauh, dia sudah seperti kakak tertua yang bijak bagiku saat ini, dan aku senang dia ada di sini! Tepat di {#Emph}sini!"
      Speaker = "Poseidon"
      Event = "PoseidonWithHestia01"
    }
    {
      Id = "Hestia_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}harus {#Prev}bersyukur aku ada di sini, dasar bongsor! Kalau tidak, kutinggal kalian semua mengurus kekacauan ini sendirian. Lagi pula, kalian takkan bisa mengubur kembali Chronos tanpa bantuanku! Itu berlaku buatmu juga, si manis."
      Speaker = "Hestia"
      Event = "PoseidonWithHestia01"
    }
    {
      Id = "Poseidon_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia mungkin bukan teman bicara yang paling {#Emph}menyenangkan{#Prev}, tapi masa-masa {#Emph}damai {#Prev}tak selalu bertahan selamanya, dan keponakanku Ares yang baik ini sangat cocok diandalkan untuk urusan {#Emph}itu! {#Prev}Ayo jangan malu-malu, Ares! Sambutlah keponakanku ini!"
      Speaker = "Poseidon"
      Event = "PoseidonWithAres01"
    }
    {
      Id = "Ares_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudariku dan aku sudah saling mengenal, Paman. Kendati dia mungkin belum terlalu terbiasa dengan apa yang bisa kita capai saat menggabungkan pengaruhmu atas amukan samudra dengan apa yang kulakukan."
      Speaker = "Ares"
      Event = "PoseidonWithAres01"
    }
    {
      Id = "Melinoe_0634"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau salah satu saudara ayahku, kan? Kalau begitu, tolonglah dia! {#Emph}Atas nama Hades! Olympus, kuterima pesan ini!"
      Speaker = "Melinoe"
      Event = "PoseidonFirstPickUp"
    }
    {
      Id = "Poseidon_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keponakanku yang telah lama hilang, {#Emph}kau masih hidup! {#Prev}Kami kira kau bernasib sama seperti ayahmu! Dan ibumu, {#Emph}serta {#Prev}kakakmu, {#Emph}ugh! {#Prev}Nah, bagaimana kalau kita balikkan ombak pertempuran ini, dan lancarkan pembalasan dendam yang kejam demi Hades yang malang beserta keluarganya?!"
      Speaker = "Poseidon"
      Event = "PoseidonFirstPickUp"
    }
    {
      Id = "Poseidon_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lho, Keponakanku, kau berdarah-darah di mana-mana! Aku tak bisa mengawasi setiap langkahmu sepanjang waktu, tahu! Kau harus berhati-hati, setidaknya sampai kau mendapatkan sebagian kekuatanku!"
      Speaker = "Poseidon"
      Event = "PoseidonLowHealth01"
    }
    {
      Id = "Poseidon_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, Keponakan kecilku, kau {#Emph}terluka! {#Prev}Tapi rasa sakit membentuk watak yang tangguh, bukan? Dan kau mulai menjelma jadi sosok yang luar biasa dalam semua ini!"
      Speaker = "Poseidon"
      Event = "PoseidonLowHealth02"
    }
    {
      Id = "Poseidon_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luka-lukamu akan membuatmu semakin kuat, Keponakanku! Memang tidak langsung terasa, kondisimu sekarang jelas cukup parah, tapi kau pasti akan {#Emph}berkembang {#Prev}dari pengalaman ini, aku yakin!"
      Speaker = "Poseidon"
      Event = "PoseidonLowHealth03"
    }
    {
      Id = "Poseidon_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, sepertinya kau baru saja terhantam ombak yang ganas, tapi ada kabar baik: {#Emph}aku {#Prev}di sini!"
      Speaker = "Poseidon"
      Event = "PoseidonLowHealth04"
    }
    {
      Id = "Poseidon_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Firasatku mengatakan kau baru saja hendak berangkat untuk petualangan besar nan menentukan berikutnya! Kupikir kau pasti butuh lonjakan kekuatan!"
      Speaker = "Poseidon"
      Event = "PoseidonRunStart01"
    }
    {
      Id = "Poseidon_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjalanan yang panjang dan penuh marabahaya berawal dari satu langkah, Keponakanku! Atau kalau berenang, dimulai dari satu {#Emph}kayuhan! {#Prev}Andai saja berenang jadi pilihan, aku bisa membantumu lebih banyak lagi!"
      Speaker = "Poseidon"
      Event = "PoseidonRunStart02"
    }
    {
      Id = "Poseidon_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau melangkah maju, kupinta kau bertindak layaknya hiu, Keponakanku! Kau pasti tahu hiu, kan? Ikan pemburu yang melesat kencang membelah air, tanpa henti mengejar mangsanya!"
      Speaker = "Poseidon"
      Event = "PoseidonRunStart03"
    }
    {
      Id = "Poseidon_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar aku jadi yang pertama di antara kerabatku malam ini untuk mendoakanmu selamat mengarungi kegelapan! Bukannya perjalanan ini bakal aman, tapi setidaknya itulah niat baikku!"
      Speaker = "Poseidon"
      Event = "PoseidonRunStart04"
    }
    {
      Id = "Poseidon_0375"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau begitu fokus membereskan Dunia Bawah sampai-sampai aku agak ragu mengungkitnya, Keponakanku, {#Emph}tapi! {#Prev}Bantuanmu di permukaan juga akan sangat kami nantikan di sini, kapan pun!"
      Speaker = "Poseidon"
      Event = "PoseidonUnderworldStartStreak01"
    }
    {
      Id = "Poseidon_0376"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah begitu banyak legiun sang Titan yang kau sapu bersih dari muka bumi, Keponakanku! Tapi pasti ada lebih banyak lagi yang berkumpul di Dunia Bawah ayahmu! Berikan mereka {#Emph}berkahku {#Prev}pada suatu malam nanti, kalau kau paham maksudku!"
      Speaker = "Poseidon"
      Event = "PoseidonSurfaceStartStreak01"
    }
    {
      Id = "Poseidon_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu kami jarang sekali berhubungan dengan ayahmu. Jadi saat Hades berhenti berkomunikasi dengan Olympus, kami kira dia kembali ke tabiat lamanya yang tertutup! Rupanya si licik Chronos yang meringkusnya! Tak ada yang bisa kami lakukan saat itu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutHades01"
    }
    {
      Id = "Poseidon_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu Hades dan aku tak selalu akur. Kakak sulungku yang kaku, begitu aku memanggilnya! Tapi itu sudah jadi masa lalu. {#Emph}Ah{#Prev}, betapa aku merindukan wajah cemberutnya yang muram itu, Keponakanku!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutHades02"
    }
    {
      Id = "Poseidon_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku nyaris tak ingat kapan terakhir kali kami mengobrol dengan ayahmu yang muram itu, Keponakanku! Dia memang tak pernah jadi tipe yang suka bergaul! Waktu kami tak lagi mendengar kabar darinya, kami pikir dia cuma lagi kumat {#Emph}ngambeknya{#Prev}, bukannya jatuh ke cengkeraman Chronos!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutHades03"
    }
    {
      Id = "Poseidon_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar kakak tertuaku yang kaku itu, apakah dekorasi ulang rumahnya berjalan lancar? Hades dan aku tak pernah banyak bicara sejak dia pindah ke bawah tanah! Tapi sekarang saatnya bagi kita untuk mengubah semua itu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutHadesReturn01"
    }
    {
      Id = "Poseidon_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami dengar kabar bahwa kau menemukan Hades tua, Keponakanku! Kabar yang {#Emph}paling luar biasa{#Prev}, kukira! Kecuali bagian bahwa dia dirantai di Tartarus, bagian itu sama sekali tak menyenangkan. {#Emph}Kami akan mengeluarkanmu dari sana, Saudaraku!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFindingHades01"
    }
    {
      Id = "Poseidon_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakak tertuaku yang kaku, kau berhasil menemukannya? Masih utuh?! Tadinya aku takut nasib Hades bakal berakhir seperti Chronos waktu kami membabatnya dulu. Tapi Chronos cuma merantainya di Tartarus? Agak kelewat batas juga ya, sebenarnya..."
      Speaker = "Poseidon"
      Event = "PoseidonAboutFindingHades01_B"
    }
    {
      Id = "Poseidon_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti bakal menyukai kakakmu, Keponakan kecilku! Hampir semua orang menyukainya! Dia menghujaniku dengan pujian persis seperti manusia fana. Sedikit canggung, memang, tapi juga {#Emph}sangat menyenangkan{#Prev}!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutZagreus01"
    }
    {
      Id = "Poseidon_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang rasanya kakakmu sudah kembali, Keponakanku! Dulu dia suka keluyuran di Dunia Bawah milik ayahmu, mirip tikus yang lari dari kapal karam! Tapi sekarang kapal itu bakal {#Emph}diperbaiki! Dan {#Prev}itu akan jadi kapal yang megah setelah semuanya beres!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutZagreus02"
    }
    {
      Id = "Poseidon_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau dibesarkan di suatu sudut gelap yang tersembunyi di Dunia Bawah, semacam itulah ya, Keponakanku? Dibesarkan untuk mencari dan menaklukkan perebut takhta ayahmu? {#Emph}Haha{#Prev}, luar biasa sekali!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutMelinoe01"
    }
    {
      Id = "Poseidon_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keponakanku, kau tak perlu jadi penyihir untuk tahu kalau keluargamu sedang dirundung bencana besar saat ini. Malah menurutku, kau sama sekali tak perlu jadi penyihir! Kalau aku jadi kau, aku bakal memilih jalan hidup yang lain!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutMelinoe02"
    }
    {
      Id = "Poseidon_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertama kali aku mendengar bahwa harapan terakhir dan terbaik kita untuk menghentikan Chronos adalah anak kedua Hades dan Sang Ratu, aku sempat bilang: tunggu, {#Emph}siapa? {#Prev}Ternyata mereka punya anak {#Emph}perempuan! {#Prev}Sang Titan pasti menyerang Kediaman ayahmu tepat setelah kau lahir!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutChronos01"
    }
    {
      Id = "Poseidon_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan tua yang licik itu, si Chronos! Aku sudi menyebutnya sebagai ayahku! Kami pernah bertarung habis-habisan dengannya dulu, beberapa waktu silam. Kukira kami sudah menuntaskannya untuk selamanya! {#Emph}Ah{#Prev}, tapi waktu itu kami masih muda dan ceroboh!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutChronos02"
    }
    {
      Id = "Poseidon_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu butuh {#Emph}enam {#Prev}orang di antara kita untuk menumbangkan Titan Chronos! Aku sendiri, ayahmu, Saudaraku Zeus, Hera-nya yang jelita, Demeter, dan juga Hestia! Kami punya senjata-senjata dahsyat untuk tugas itu dan segalanya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutChronos03"
    }
    {
      Id = "Poseidon_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos tua tak pernah punya setetes pun rasa sayang padaku, ataupun anak-anaknya yang lain, Keponakanku. Bayangkan, membenci darah dagingmu sendiri! Dan bukan cuma {#Emph}sebagian{#Prev}, tapi {#Emph}semuanya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutChronos04"
    }
    {
      Id = "Poseidon_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu Chronos yang licik merebut Kediaman ayahmu, dia menghimpun pasukan untuk mengepung kami di sini! Kami tak bisa melihat apa pun di bawah sana di Dunia Bawah, jadi dia benar-benar menyergap kami! Tapi tetap saja, kami berhasil menahannya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutChronos05"
    }
    {
      Id = "Poseidon_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu Chronos menyerang, tentu saja kami langsung membalas! Bencana dahsyat yang belum pernah kaulihat seumur hidupmu! Membelah separuh daratan ini. Membuat seluruh bala tentara Titan terlunta-lunta tak berdaya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutChronos06"
    }
    {
      Id = "Poseidon_0364"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos tua memang pantas menerima setiap ganjaran yang kau timpakan dan bahkan lebih dari itu, Keponakanku! Aku sudah sangat murka padanya setelah semua ulahnya, dan itu {#Emph}sebelum {#Prev}aku menyadari bahwa dia melepaskan Typhon yang mengerikan ke arah kita semua!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutChronosPlan01"
    }
    {
      Id = "Poseidon_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku menyambut baik Ayah Chronos yang sekarang jauh lebih jinak ini, yang tampaknya tak lagi bernafsu melihat rumah kita hancur, aku tetap waspada terhadap bangkotan itu! Tapi, dia memang cukup kooperatif belakangan ini...!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutNeoChronos01"
    }
    {
      Id = "Poseidon_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong kosong apa ini soal Chronos menculik Tiga Dewi Takdir? {#Emph}Mustahil! {#Prev}Pasti muslihat untuk membuat kita lengah! Jangan langsung menelan mentah-mentah semua yang kaudengar, Keponakanku!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFates01"
    }
    {
      Id = "Poseidon_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga kita sedang sedikit tercerai-berai, Keponakanku! Kau sudah mendengar kabar dari kami yang ada di puncak gunung ini, tapi Zeus mengirim beberapa anaknya untuk mengurus masalah di dekat kaki gunung! Mereka pasti baik-baik saja!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFamily01"
    }
    {
      Id = "Poseidon_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu ini berat, tapi sekarang kita semua harus bersatu, Keponakanku! Keluarga yang luar biasa dengan satu tujuan bersama! Menjadi ombak bergemuruh yang akan menyapu bersih masa-masa sulit ini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFamily02"
    }
    {
      Id = "Poseidon_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba tanya ke dewa {#Emph}mana pun{#Prev} di Olympus apakah menurut kami kau sebaiknya ikut mempertahankan tempat ini, atau membawa pertempuran langsung ke Chronos di alam ayahmu, dan kau akan mendapat {#Emph}berbagai macam pandangan! {#Prev}Berbagai pandangan yang {#Emph}sangat beradab{#Prev}, yang sama sekali tak pernah kami perdebatkan {#Emph}sedikit pun!"
      Speaker = "Poseidon"
      Event = "PoseidonDevotionIntro01"
    }
    {
      Id = "Poseidon_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingat waktu aku bilang kita tak pernah bertengkar satu sama lain di Olympus, Keponakan kecilku? Yah, itu mungkin agak sedikit berlebihan dariku. Tapi aku sepihak dengan Hera dalam hal ini! Kami rasa usahamu lebih berguna jika dikerahkan di atas sini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutInFighting01"
    }
    {
      Id = "Poseidon_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil sampai ke permukaan, Keponakan kecilku! Sayang sekali kami belum sempat membersihkan tempat ini sebelum kau tiba! Kami sedang berada di tengah-tengah kekacauan besar!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSurface01"
    }
    {
      Id = "Poseidon_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua yang kaulihat, baik daratan maupun lautan, itu adalah wilayah kekuasaanku, tahu! Asalkan kau tidak mendongak ke arah langit. Itu wilayah pamanmu, Zeus! Tapi, kurasa aku dapat bagian yang {#Emph}jauh lebih bagus{#Prev}!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSurface02"
    }
    {
      Id = "Poseidon_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, bagaimana ceritanya kau bisa hidup dan bernapas di luar sini? Bukankah garis keturunan ayahmu ditakdirkan untuk mendekam di bawah tanah, atau semacamnya? Ah, betapa zaman telah berubah!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSurface03"
    }
    {
      Id = "Poseidon_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau semakin dekat ke puncak bersalju yang kami sebut rumah! Hawa dingin yang menusuk ini adalah bagian dari pertahanan alami kami, persembahan dari Dewi Tetua Demeter! Kami bahkan punya Automaton luar biasa yang menahan musuh-musuh kita. Kau pasti bakal {#Emph}terpukau!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSurface04"
    }
    {
      Id = "Poseidon_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di mana kau sekarang, Keponakanku, di dasar laut?! Atau sangat dekat dengan itu! Pasti jauh lebih gelap daripada tempat yang biasa kautiapi. Dan tekanan airnya yang {#Emph}mengerikan{#Prev}! Jangankan kau, {#Emph}aku {#Prev}saja tak tahan berlama-lama di sana! Jadi bagaimana bisa {#Emph}kau tahan?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutOceanus01"
    }
    {
      Id = "Poseidon_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu tak pernah bilang padaku kalau alamnya punya lorong-lorong berliku tepat di sebelah wilayah kekuasaanku! Semacam {#Emph}saluran pembuangan{#Prev}, begitu? Mengalir langsung ke perairanku? Oh, aku harus menuntut penjelasan pada Hades soal {#Emph}ini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutOceanus02"
    }
    {
      Id = "Poseidon_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Teror bawah air yang kauhadapi itu... Aku cuma ingin kau tahu, itu bukan salahku! Aku tak sudi menampung monster-monster seperti itu di duniaku. Makanya mereka menyelinap ke Dunia Bawah untuk melampiaskan dendam mereka padamu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutOceanus03"
    }
    {
      Id = "Poseidon_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua rintangan menerjang air Oceanus itu pasti membuatmu makin kuat dan {#Emph}lincah{#Prev}, Keponakanku! Nah, itulah manfaat olahraga air! Mana ada cara yang lebih baik untuk menjaga tubuh tetap dalam kondisi {#Emph}sempurna?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutOceanus04"
    }
    {
      Id = "Poseidon_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di belahan Bumi mana kau berada {#Emph}sekarang{#Prev}, Keponakanku? Tempat itu hampir mirip dengan ladang gandum berombak milik Demeter! Siapa sangka Hades tua punya padang rumput yang tumbuh di Dunia Bawah, meski kelihatannya agak suram, setahu penglihatanku!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFields01"
    }
    {
      Id = "Poseidon_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang di lautanku yang luas tak bertepi dan mengerikan, Keponakanku! Sayangnya sekarang sedang dipenuhi para penjajah. Tanganku sedang repot mengurus {#Emph}mereka{#Prev}, kalau kau mau tahu! Tapi coba lihat apakah kau bisa menerobos blokade mereka!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutThessaly01"
    }
    {
      Id = "Poseidon_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat di tempat itu dulu pernah berdiri pasukan raksasa yang berbaris menuju gunung kami, Keponakanku! Jadi langsung saja kubelah tanah tepat di bawah kaki mereka, {#Emph}haha! {#Prev}Jadinya sekarang kita harus menghadapi armada {#Emph}laut {#Prev}raksasa, dan tentu saja akan kita hadapi!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutThessaly02"
    }
    {
      Id = "Poseidon_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil mengarungi perairan di Celah Thessaly! Pengalaman bahari yang bukan untuk orang bernyali ciut, sarat dengan kapal-kapal abadi yang bertekad bulat menghancurkan keluargamu! Semoga pelayaranmu berikutnya di sana jauh lebih mulus!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutThessaly03"
    }
    {
      Id = "Poseidon_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau berlayar melintasi Celah itu lagi nanti, ketahuilah ini: Aku akan berusaha sekuat tenaga memastikan arus air meluncurkanmu dengan perkasa! Walau bagaimana caranya melakukan itu tanpa menguntungkan kapal musuh juga ya...?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutThessaly04"
    }
    {
      Id = "Poseidon_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berjanji akan menutup rapat-rapat Celah Thessaly itu begitu perang kita usai, {#Emph}tapi! {#Prev}Rupanya kita butuh semuanya tetap seperti sedia kala agar sihirmu bisa bekerja. Kedengarannya seperti janji yang terpaksa harus kuingkari!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutThessaly05"
    }
    {
      Id = "Poseidon_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, Keponakanku, kau ada di sini?! Aku ingin turun menyambutmu sendiri, tapi rumah gunung kami sedang dipenuhi penyusup seperti yang mungkin sudah kau lihat! Jadi kami tertahan di puncak... bak sekumpulan kura-kura yang sembunyi di dalam tempurung!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutOlympus01"
    }
    {
      Id = "Poseidon_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melihatnya: Gunung kami perpaduan antara istana megah dan benteng yang tak tertembus! Pasukan yang mereka sebut {#Emph}legiun Chronos {#Prev}takkan pernah bisa menembus dinding-dinding {#Emph}ini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutOlympus02"
    }
    {
      Id = "Poseidon_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olympus, dibedah bak seekor {#Emph}ikan! {#Prev}Dulu ada segala macam Nimfa dan sebangsanya yang selalu kami undang untuk bersenang-senang di sini! Pastinya mereka akan kembali begitu situasinya mereda!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutOlympus03"
    }
    {
      Id = "Poseidon_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Satir yang {#Emph}menyebalkan {#Prev}ini, mengotori gunung kami yang elok! Kami sudah memperkuat pertahanan menghadapi mereka, tapi begitu kami selesai membersihkan semua kekacauan, mereka {#Emph}kembali lagi!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutOlympus04"
    }
    {
      Id = "Poseidon_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski Chronos sudah mulai melunak, pertempuran di Olympus jelas belum berakhir! Namun kami sudah memperkuat pertahanan dan menahan sisa-sisa pasukan Prometheus! Di sini rasanya sudah hampir seperti sebuah {#Emph}ekosistem {#Prev}kecil!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutOlympus05"
    }
    {
      Id = "Poseidon_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana menurutmu tentang benteng kami di puncak gunung ini? Dahulu berdiri megah seputih pualam sebelum Typhon yang jahat mencemarinya dengan segala kotoran dan biang keladinya! Namun bangunannya kokoh dan sejauh ini bertahan teguh!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFortress01"
    }
    {
      Id = "Poseidon_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengenai Automaton luar biasa yang kuceritakan sebelumnya... mestinya kusebutkan juga bahwa saat ini mereka tak bisa membedakan kawan atau lawan! Hephaestus mungkin sedang menangani bagian itu, tapi hingga saat itu tiba, sebaiknya kau jaga jarak jauh-jauh dari mereka!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutAutomatons01"
    }
    {
      Id = "Poseidon_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertahanan Automaton perkasa yang getol diciptakan Hephaestus sangat piawai membunuh apa pun yang bergerak! Jadi jangan masukkan tingkah laku mereka ke dalam hati! Kami tak menyangka kau bakal berhasil sampai ke atas sini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutAutomatons02"
    }
    {
      Id = "Poseidon_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh tak sopan Automaton kami sendiri memperlakukanmu layaknya musuh bebuyutan kita! Sayangnya mereka sama sekali tak paham arti rasa hormat! Terakhir kali kubilang pada mereka {#Emph}jangan berani-berani serang keponakanku{#Prev}, mereka malah menyerang{#Emph}ku!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutAutomatons03"
    }
    {
      Id = "Poseidon_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil melakukannya, Keponakanku?! Hal-hal aneh terjadi sejak malam itu; hal-hal {#Emph}baik{#Prev}, jika kau bukan salah satu musuh kami! Kami rasa kau mungkin telah menghabisi Chronos si tua bangka! Tapi dia langsung bangkit lagi, seingatku!"
      Speaker = "Poseidon"
      Event = "PoseidonUnderworldRunCleared01"
    }
    {
      Id = "Poseidon_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami semua mengandalkanmu, Keponakanku sayang, tapi {#Emph}tetap saja! {#Prev}Aku tak menyangka kau bisa menghadapi Chronos dan menang! Kupikir paling banter kau cuma bisa mengulur waktunya sejenak. Kau pasti sangat kuat, mirip {#Emph}denganku!"
      Speaker = "Poseidon"
      Event = "PoseidonUnderworldRunCleared02"
    }
    {
      Id = "Poseidon_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat pertama kali kita bertemu, aku berjanji akan membalaskan dendam yang mengerikan atas apa yang menimpa keluargamu! Dan kurasa apa yang telah kita perbuat sudah memenuhi janji itu! Peduli amat Chronos tak {#Emph}tewas selamanya? {#Prev}Lagi pula, Hades tua juga sama saja!"
      Speaker = "Poseidon"
      Event = "PoseidonUnderworldRunCleared03"
    }
    {
      Id = "Poseidon_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, terima kasih, Keponakanku! Karena berkat bantuanmu kita berhasil mengalahkan Typhon! Walau kata {#Emph}mengalahkan {#Prev}agak terlalu muluk, karena tampaknya kita cuma memukulnya jatuh. Kemungkinan besar malah membuatnya makin murka. {#Emph}Kemarilah {#Prev}lagi jika kau sempat!"
      Speaker = "Poseidon"
      Event = "PoseidonSurfaceRunCleared01"
    }
    {
      Id = "Poseidon_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang diperlukan untuk menumbangkan Typhon mengerikan itu selamanya?! Dia tak bisa diajak berunding, memulihkan kekuatannya malam demi malam, dan menyudutkan kita layaknya ikan sturgeon di dalam jaring! Tapi tak seperti {#Emph}ikan{#Prev}, kita bisa membalas bertarung tanpa kenal lelah!"
      Speaker = "Poseidon"
      Event = "PoseidonSurfaceRunCleared02"
    }
    {
      Id = "Poseidon_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mulai frustrasi mencoba menumbangkan Chronos, Keponakanku? Aku paham betul rasanya! Tapi kini kau ada di permukaan, tempat Olympus berkuasa mutlak! Setidaknya untuk saat ini!"
      Speaker = "Poseidon"
      Event = "PoseidonSurfaceRunStartPostUnderworldL01"
    }
    {
      Id = "Poseidon_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kini setelah kau memberi Chronos pelajaran yang takkan terlupakan, kau menuju ke arah kami? Pertama, kemenangan di Dunia Bawah, dan berikutnya mungkin di {#Emph}sini!"
      Speaker = "Poseidon"
      Event = "PoseidonSurfaceRunStartPostUnderworldW01"
    }
    {
      Id = "Poseidon_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kembali ke kedalaman yang lebih familier untuk saat ini, kulihat! Yah, jangan berkecil hati... dunia permukaan memang bukan untuk semua orang! Meski orang-orang mati yang bangkit kian {#Emph}berlagak {#Prev}bahwa dunia ini milik mereka!"
      Speaker = "Poseidon"
      Event = "PoseidonUnderworldRunStartPostSurfaceL01"
    }
    {
      Id = "Poseidon_0374"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam demi malam, kemenangan demi kemenangan, {#Emph}haha! {#Prev}Kau membuat semua ini tampak begitu {#Emph}mudah{#Prev}, Keponakanku! Kalau begitu, berlayarlah terus! Dan semoga berkahku membuat segalanya makin mudah!"
      Speaker = "Poseidon"
      Event = "PoseidonWinStreak01"
    }
    {
      Id = "Poseidon_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kiklops Polyphemus menghalangi jalanmu menuju selat yang membelah daratan?! Dasar perusak suasana! Dulu aku pernah mengerjainya agar dia mengira dia anakku, dan sejak itu dia selalu dongkol karenanya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPolyphemus01"
    }
    {
      Id = "Poseidon_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka ada yang {#Emph}berpikir {#Prev}aku memperanakkan berandal monster semacam Polyphemus! Namun tetap saja, dulu aku memperhatikannya. Mana mungkin dia bisa memperhatikan dirinya sendiri cuma dengan satu mata, {#Emph}hahaha!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPolyphemus02"
    }
    {
      Id = "Poseidon_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau bisa melewati Polyphemus sebelumnya, kau pasti bisa melakukannya lagi, bukan begitu, keponakanku? Begitu melewati dermaga, jalannya lurus menyusuri selat menuju Olympus! Perairan berbahaya, memang, tapi aku yakin bisa membantumu mengarunginya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPolyphemus03"
    }
    {
      Id = "Poseidon_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti tak memandang tinggi para Kiklops jika Polyphemus adalah satu-satunya yang pernah kau temui! Dulu mereka sekutu perkasa kami, kau tahu! Sayang sekali dengan apa yang menimpa bangsa mereka!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPolyphemus04"
    }
    {
      Id = "Poseidon_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka dulu aku pernah mengasihani Polyphemus itu, Keponakanku! Seekor Kiklops kehilangan matanya yang berharga akibat ulah seorang pengelana fana biasa? Betapa aku dibuat {#Emph}mendidih {#Prev}karenanya saat itu, berniat menuntut balas yang mustahil dia dapatkan! Tapi {#Emph}begini {#Prev}caranya membalas budiku?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPolyphemus05"
    }
    {
      Id = "Poseidon_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar sudah sampai ke telingaku bahwa kau bertarung melawan Scylla dan para pengikut Siren-nya! Jadi di {#Emph}sana {#Prev}rupanya mereka berakhir! Dulu mereka adalah momok bagi banyak pelaut, sampai aku membereskan {#Emph}mereka!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutScylla01"
    }
    {
      Id = "Poseidon_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku suka mengikuti perkembangan terkini, dan kudengar kau memberi Scylla si mulut besar dan antek-antek Siren-nya pertunjukan tandingan yang luar biasa! Sayang sekali kodrat dewa mereka membuat mereka tak bisa dibunuh! Tapi setidaknya mereka bisa dibuat menanggung malu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutScylla02"
    }
    {
      Id = "Poseidon_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luas pengetahuanku tentang lautan, namun laut tetap {#Emph}saja {#Prev}menyimpan banyak misteri! Contohnya, bagaimana mungkin monster semengerikan Charybdis berasal dari tempat yang begitu menakjubkan? {#Emph}Dan {#Prev}apa yang dilakukannya di {#Emph}Celah Karangku? {#Prev}Selain melahap segala hal sepuasnya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutCharybdis01"
    }
    {
      Id = "Poseidon_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian besar dari kalian dewa-dewi Dunia Bawah sangat kami sambut di Olympus ini, bila kami sedang tak berperang; tapi bukan {#Emph}Eris! {#Prev}Ulah konyolnya merusak terlampau banyak perjamuan! Dan kini dia mengepak-ngepakkan sayap di perbatasan kami, mengejek kami dan memperkeruh {#Emph}suasana!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutEris01"
    }
    {
      Id = "Poseidon_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada banyak hal yang ingin kuketahui, keponakanku, seperti: {#Emph}Bagaimana {#Prev}bisa Prometheus yang licik lepas dari belenggunya? {#Emph}Ah{#Prev}, para Titan ini! Rasanya kita tak pernah bisa memusnahkan mereka selamanya. Tapi setidaknya kita bisa memadamkan api yang mereka curi!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPrometheus01"
    }
    {
      Id = "Poseidon_0371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prometheus si bajingan itu mendapat {#Emph}hukuman {#Prev}yang setimpal darimu semalam, begitu kata Athena! Kami tak berdaya menundukkannya, karena dia licik seperti pasukan yang dipimpinnya! Tapi kini kau berhasil memancingnya keluar!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPrometheus02"
    }
    {
      Id = "Poseidon_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semacam {#Emph}fenomena berbahaya {#Prev}sedang terjadi di puncak ini, Keponakanku! Kami belum berani mendekatinya untuk saat ini... jadi jika kau mendengar yang lain berspekulasi soal asal-usulnya, itu cuma {#Emph}desas-desus {#Prev}tanpa bukti, tak lebih!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSurfaceThreat01"
    }
    {
      Id = "Poseidon_0370"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang lain bilang kita menghadapi {#Emph}Typhon {#Prev}raksasa sebagai ancaman, tapi aku tak melihat hal semacam itu! Tentu saja akhir-akhir ini aku tak bisa melihat apa-apa gara-gara badai dahsyat di atas sini! Walau aku {#Emph}memang {#Prev}mendengar banyak raungan berat yang parau!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSurfaceThreat02"
    }
    {
      Id = "Poseidon_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang kau lakukan hingga menyulut amarah Chronos tua, dia melampiaskannya pada {#Emph}kami! {#Prev}Paling tidak pasukannya di gunung ini berbuat begitu! Namun jangan khawatir, karena aku sudah memanggil bala bantuan! Berkali-kali!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSurfaceHelp01"
    }
    {
      Id = "Poseidon_0380"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudaraku Zeus, dia bilang kau berhasil sampai ke Istana kami, Keponakanku! Dan menghempaskan monster Typhon melolong jatuh ke bumi! Maafkan ketidakhadiranku, terlampau banyak perairan yang harus kulindungi...!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPalace01"
    }
    {
      Id = "Poseidon_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon yang mengerikan meninggalkan bekas di lereng gunung ini, itu sudah pasti! Bahkan Istana kami sampai doyong di bawah bobotnya yang tak terkira! Namun pada akhirnya, Istana kami tetap berdiri! Bukan dia."
      Speaker = "Poseidon"
      Event = "PoseidonAboutPalace02"
    }
    {
      Id = "Poseidon_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lihat sendiri betapa {#Emph}besarnya {#Prev}Typhon mengerikan itu, keponakanku?! Sudah lama sekali sejak terakhir kali kami bertarung hingga menurut hematku dia bertambah besar selama masa itu! Dan juga makin {#Emph}licik! {#Prev}Semua guncangan hebat di sini... berasal dari {#Emph}dia!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutTyphon01"
    }
    {
      Id = "Poseidon_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama halnya dengan si tua Chronos, kami pernah menaklukkan Typhon yang mengerikan itu tempo hari! Paman Agungmu melancarkan pukulan pamungkasnya sendiri, sambaran petir tepat di antara matanya! Dua mata {#Emph}utamanya{#Prev}, setidaknya! Matanya begitu banyak, sih..."
      Speaker = "Poseidon"
      Event = "PoseidonAboutTyphon02"
    }
    {
      Id = "Poseidon_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin bertanya-tanya petuah apa yang bisa kami bagikan perihal menghadapi Typhon terkutuk itu, berhubung kami pernah melawannya dulu. Kalau soal itu, tanyakan saja pada Athena! Atau mungkin Zeus. Peranku dulu cuma sekadar pendukung dalam bentrokan itu, itu saja!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutTyphon03"
    }
    {
      Id = "Poseidon_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guncangan di Olympus akhirnya reda! Salah satu dari sekian banyak manfaat usai Typhon yang mengerikan itu dienyahkan! Rupanya kau masih harus menghadapinya di suatu tempat? Setidaknya arwah halusinasi darinya? Syukurlah bukan {#Emph}aku {#Prev}yang harus meladeninya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutTyphon04"
    }
    {
      Id = "Poseidon_0381"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah bagaimana kau berhasil melakukannya, Keponakanku, Typhon sudah {#Emph}sirna! {#Prev}Tak ada lagi jejaknya yang tersisa di atas sini! Jadi sekarang giliran {#Emph}Chronos{#Prev}, kan? Ayo maju, kita kerahkan semua kekuatan kita padanya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutTyphonDeath01"
    }
    {
      Id = "Poseidon_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya kau sudah bikin repot Typhon jahanam itu tadi malam, Keponakanku! Dia nyaris meremukkanmu bagaikan seekor {#Emph}kerang{#Prev}, bukan? Tapi kau berhasil mengalihkan perhatiannya cukup lama sampai kami bisa memukulnya mundur setelah kau kabur! Atau apa pun yang kau lakukan saat itu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutTyphonL01"
    }
    {
      Id = "Poseidon_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh bernyali besar menghadapi Typhon raksasa itu! Dan amat beruntung bisa lolos, karena kukira dia sudah {#Emph}melumatkanmu {#Prev}sampai rata! Kami akan menahannya selama mungkin, tapi kalau kau tidak terlalu sibuk, kami masih butuh semua bantuan yang ada!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutTyphonL02"
    }
    {
      Id = "Poseidon_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau ke mana {#Emph}kau{#Prev}, Keponakan kecilku?! Menjauh ke arah yang berlawanan dari Typhon yang mengerikan, setidaknya begitulah kelihatannya bagi{#Emph}ku! {#Prev}Yang kalau dipikir-pikir, tampaknya langkah yang cukup masuk akal! Tapi kami jelas butuh bantuanmu di atas sini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutTyphonL03"
    }
    {
      Id = "Poseidon_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakakmu itu, Keponakanku, aku biasa memanggilnya Hades cilik... A, aku rasa panggilan itu cocok untukmu {#Emph}juga! {#Prev}Terlebih karena {#Emph}dia {#Prev}sudah tiada! Mestinya jelas siapa yang kumaksud, kan, Hades cilik?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutLittleHades01"
    }
    {
      Id = "Poseidon_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu hal tentangku, Keponakanku, mataku sangat jeli mengenali amfibi; dan yang bersamamu di sana itu sungguh spesimen yang hebat! Sayang dia tidak suka air asin, tapi memang tiada makhluk yang sempurna!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFrogFamiliar01"
    }
    {
      Id = "Poseidon_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makhluk apa yang bersamamu di sana itu, seekor {#Emph}kucing? {#Prev}Kau mesti tahu satu hal tentang kucing, Keponakanku: Mereka benci air! Padahal makhluk-makhluk {#Emph}bodoh {#Prev}itu butuh air untuk hidup! Tapi mungkin kucing itu lebih pintar, jika dia punya akal sehat untuk mengikutimu menembus {#Emph}neraka!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutCatFamiliar01"
    }
    {
      Id = "Poseidon_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutarik kembali semua perkataan burukku soal kucing! Soalnya kucingmu itu pemancing yang andal. Pengucing {#Emph}ikan? {#Prev}Intinya aku baru tahu makhluk seperti itu bisa menghargai lautan... yang artinya {#Emph}mereka {#Prev}bisa kuhargai {#Emph}juga!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutCatFamiliar02"
    }
    {
      Id = "Poseidon_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui kapak labrys yang kau ayunkan itu luar biasa mantap! Kapak Batu Bulan, kata Hephaestus? Yah, tak ada yang bisa mengalahkan trisula andalanku! Ujung garpu kecil milikku ini sudah mencabut paksa banyak sekali bilah senjata musuh!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutAxe01"
    }
    {
      Id = "Poseidon_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku telah memegang hampir segala jenis senjata di masa kejayaanku, belum pernah kulihat persenjataan seperti yang kau pakai sekarang, dengan daya hancur yang sungguh spektakuler! Kau bakal seimbang melawan Automaton kami dengan benda {#Emph}itu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSuit01"
    }
    {
      Id = "Poseidon_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Air adalah zat yang sungguh memukau, Keponakanku! Mampu membelah gunung-gunung tertinggi jika diberi cukup waktu, tapi manusia fana justru harus meminumnya agar tetap hidup! Kau juga serbabisa seperti itu, bukan?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutWater01"
    }
    {
      Id = "Poseidon_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa di tempatmu sedang turun sedikit hujan? {#Emph}Ah{#Prev}, andai kau bisa melihat si tua Demeter dan Zeus bertengkar soal siapa yang menurunkannya! Aku cuma menonton sambil tertawa, soalnya bagaimanapun juga, itu berarti makin banyak air untukku!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutRain01"
    }
    {
      Id = "Poseidon_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu apa itu bendungan, Keponakanku? Bangunan reyot yang dipakai manusia fana untuk membendung airku! Tapi saat aku murka, {#Emph}bwaah{#Prev}, airku menerjang hancur semuanya! Jadilah seperti air itu, jangan menahan diri, paham?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutDams01"
    }
    {
      Id = "Poseidon_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali kau harus tumbuh besar di antah-berantah, Keponakanku! Kami para dewa butuh kemewahan tertentu. Bahkan ayahmu yang kolot dan kaku itu pun suka permata dan tetek bengeknya! Tapi kau bertahan hidup tanpa kemewahan semacam itu sama sekali!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutLuxuries01"
    }
    {
      Id = "Poseidon_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku penasaran, Keponakanku tersayang, apa kau siap tenggelam? Atau kau siap berenang? {#Emph}Berenanglah{#Prev}, kataku! Berenanglah seolah kelangsungan hidup kita bergantung padanya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSwimming01"
    }
    {
      Id = "Poseidon_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ahoy, Keponakanku si pengguna sihir, inilah aku! Pertarungan kami melawan sang Titan masih seri, jadi santai saja sembari kau menuntaskan tugasmu menyelamatkan kami!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutStalemate01"
    }
    {
      Id = "Poseidon_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sini, Keponakanku, bagaimana kalau kita bertukar? Berkahku yang melimpah ruah ditukar dengan keahlian bertarungmu yang garang! Betapa adilnya pertukaran ini, bukan?!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutTrading01"
    }
    {
      Id = "Poseidon_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami benar-benar {#Emph}tenggelam {#Prev}dalam kepungan pasukan Titan jahanam itu, Keponakanku! Tapi kita ini {#Emph}dewa! {#Prev}Kekuatan kita lebih dari cukup untuk menahan mereka!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutStalemate02"
    }
    {
      Id = "Poseidon_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang tahu kapan badai bakal menghantam tempat ini, Keponakanku! Bahkan badai besar berbahaya seperti ini sekalipun! Kau pasti mengira aku bisa membaca kedatangannya, tapi tebakanmu salah besar!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutStorms01"
    }
    {
      Id = "Poseidon_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap pertempuranmu berjalan lancar di bawah sana? Kalau soal pertempuran kami di sini, wah, lancar jaya laksana mengarungi ombak! Kami nyaris tak butuh bantuanmu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutStalemate03"
    }
    {
      Id = "Poseidon_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa kau pasti begitu haus akan balas dendam, Keponakanku! Aku tahu persis bagaimana rasanya! {#Emph}Dendam! {#Prev}Sedingin dan segelap dasar samudera!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutVengeance01"
    }
    {
      Id = "Poseidon_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di dalam samuderaku, Keponakanku, makin dalam kau menyelam, makin dahsyat tekanannya! Sama seperti dirimu yang kini sudah terjerumus terlalu dalam!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPressure01"
    }
    {
      Id = "Poseidon_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagai dewa, kita {#Emph}semua {#Prev}harus membuat pilihan sulit, Keponakanku. Tadi saja, aku bingung mau menciptakan gempa bumi dahsyat atau tsunami maut! Ujung-ujungnya kulakukan dua-duanya, tapi kau paham maksudku, kan?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutChoices01"
    }
    {
      Id = "Poseidon_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku benci melihat permukaan dunia luluh lantak akibat perang akbar kita, aku siap melakukan apa pun yang diperlukan! Bahkan jika itu berarti sebagian besar kehancuran itu kutimbulkan sendiri!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutDisasters01"
    }
    {
      Id = "Poseidon_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau membawa Joran Pancing di situ! Segala keraguan yang tersisa di benakku tentangmu langsung menguap seketika. Untuk apa lagi kita bertempur, kalau bukan demi hak memancing kapan pun kita mau?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFishing01"
    }
    {
      Id = "Poseidon_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, Keponakanku, Sungai Cocytus yang mengalir melewati hutan apekmu itu adalah tempat memancing yang sungguh istimewa! Kau bakal sangat menolong para penghuni sungai itu jika kau mengangkat mereka dari sana!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFishing02"
    }
    {
      Id = "Poseidon_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau baru saja menangkap sesuatu berkat Joran Pancing itu, aku tahu betul! Aku tidak mengizinkan sembarang {#Emph}orang {#Prev}mengeruk penghuni samuderaku! Tapi mereka seolah-olah malah ingin melompat keluar sendiri demi dirimu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFishing03"
    }
    {
      Id = "Poseidon_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, lekas ambil Berkahku, karena ada kesempatan untuk memakai Joran Pancing andalanmu di dekat sini! Aku bisa merasakan hal semacam itu hingga ke lubuk sukmaku, dan aku akan mengamati upayamu memancing dengan sangat antusias!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFishing04"
    }
    {
      Id = "Poseidon_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, {#Emph}itu {#Prev}baru Joran Pancing yang sungguh rupawan, Keponakanku! Bahan-bahan premium, proporsi anggun, pegangan mantap; sebuah {#Emph}mahakarya! {#Prev}Andai aku sendiri seekor ikan, aku hanya sudi ditangkap oleh joran sehebat itu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFishingUpgrade01"
    }
    {
      Id = "Poseidon_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau hampir menangkap seluruh penghuni perairan di bawah mentari, maupun di bawah bumi! Setidaknya semua yang ada di wilayah yang biasa kau jelajahi! Itu mungkin pencapaian terhebatmu sejauh ini...!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutManyFish01"
    }
    {
      Id = "Poseidon_0372"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menangkap Penjelajah Bintang di puncak gunung kami ini, ya? Ukurannya pun lumayan besar! Oh, aku kenal betul setiap ikan di lautan luas milikku! Begitu pula yang ada di perairan-perairan kecil lainnya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutLegendaryFish01"
    }
    {
      Id = "Poseidon_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menangkap salah satu Chimaerid buruk rupa dari pusaran badai abadi Typhon! Benar-benar monster {#Emph}terkutuk{#Prev}, sama sekali bukan {#Emph}ikan {#Prev}sejati! Tapi anatominya masih cukup mirip ikan, jadi kuterima saja kali ini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutLegendaryFish02"
    }
    {
      Id = "Poseidon_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ikan Tenggorok Badai dan semacamnya di kolam-kolam tergenang di puncak gunung ini, Keponakanku... Aku heran Alat Pancingmu tidak patah saat menariknya, kekuatan mereka sungguh luar biasa ganas!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutRareFish01"
    }
    {
      Id = "Poseidon_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memang punya sedikit keahlian sihir, baguslah! Tapi banyak yang harus kau pelajari tentang seni memancing! Minat yang kau tunjukkan ini langkah awal menuju kemahiran; menangkap beragam jenis penghuni air adalah langkah {#Emph}berikutnya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutFishingQuest01"
    }
    {
      Id = "Poseidon_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fakta bahwa kau meluangkan waktu sebanyak itu demi memancing tidak luput dari perhatian{#Emph}ku{#Prev}, keponakanku! Dan kau menangkap lebih banyak jenis penghuni air daripada yang bisa kuhitung dengan {#Emph}mudah! {#Prev}Kau sudah memiliki anugerah terbaik dariku; kini kau juga mendapatkan rasa hormatku yang terdalam."
      Speaker = "Poseidon"
      Event = "PoseidonAboutFishingQuest02"
    }
    {
      Id = "Poseidon_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah, haha! {#Prev}Kulihat ombaknya sudah pasang! Nah, keponakanku... bagaimana kalau kita menyapu bersih hutan kelammu itu bagaikan air bah dahsyat pemusnah bumi?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutKeepsake01"
    }
    {
      Id = "Poseidon_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kenal betul kilauan memukau Laut Terang Benderang yang kuberikan kepadamu itu, keponakanku! Tidak semua lautanku sejelas dan sebiru itu; kau memegang cuplikan dari yang terbaik!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutKeepsake02"
    }
    {
      Id = "Poseidon_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, inilah kilauan pembiasan tak terbantahkan dari Laut Terang Benderang milikku itu—atau lebih tepatnya, milik{#Emph}mu! {#Prev}Luar biasa sekali ia berkembang selama bepergian bersamamu! Rasa hormatmu pada perairanku tidak luput dari pandanganku di sini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutKeepsake03"
    }
    {
      Id = "Poseidon_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa menahan diri untuk memerhatikan betapa seringnya kau membawa Gelang Awan itu dari saudaraku Zeus! Dia itu dewa yang sangat {#Emph}sibuk{#Prev}, kau paham sendiri, sedangkan aku bisa membantumu kapan pun jika kau memakai Laut Terang Benderang ini sebagai gantinya!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutZeusKeepsake01"
    }
    {
      Id = "Poseidon_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak tahu persis apa yang kau lakukan, Keponakanku, tapi kau telah memanggilku, dan aku telah tiba! Setidaknya secara jiwa, dan tentu saja membawa berkah-berkah yang praktis akan menjamin kemenanganmu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPackageBounty01"
    }
    {
      Id = "Poseidon_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, Keponakan kecilku, kau berlayar ke bawah sana lebih cepat daripada kapal manusia paling ramping sekalipun! Kalau begitu, bagaimana kalau kita sapu bersih sudut lautan kecil ini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutPackageBounty02"
    }
    {
      Id = "Poseidon_0367"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, ada apa dengan malam ini, keponakanku? Musuh-musuh kita tampaknya menggandakan kekuatan mereka! Bahkan kulanggar perkiraan dan kukatakan berlipat {#Emph}tiga kali lipat! {#Prev}Asalkan itu semua gara-gara ritual aneh Dunia Bawahmu itu, menurut kata Artemis kecil kita!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutShrine01"
    }
    {
      Id = "Poseidon_0368"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, sungguh malam yang mengerikan, seolah mimpi buruk terburuk kita berjalan di atas bumi, atau berenang menyeberangi lautan! Musuh-musuh kita begitu mengamuk hebat sampai-sampai ini mustahil perbuatan{#Emph}mu{#Prev}, kecuali kau juga sudah hilang akal sehat seperti mereka?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutShrine02"
    }
    {
      Id = "Poseidon_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari mana saja {#Emph}kau{#Prev}, keponakanku?! Aku hampir lupa kapan terakhir kali aku mengobrol denganmu seperti ini. Mungkin kau sedang istirahat? Dewa seperti kita pun bisa lelah sesekali, dan kau sudah melewati banyak hal! Kita semua juga, bukan?!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutDreamRuns01"
    }
    {
      Id = "Poseidon_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada gunanya menahan diri sedikit pun saat kita sedang berada dalam bahaya genting begini, bukan? Jadi terimalah, sedikit kekuatan murniku yang liar ini pasti cukup untuk {#Emph}menopangmu{#Prev}, kupikir begitu!"
      Speaker = "Poseidon"
      Event = "PoseidonLegendaryPickUp01"
    }
    {
      Id = "Poseidon_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak sekali musuh kita yang dulunya takut pada para dewa, tapi kini malah berbalik melawan! Menurutku unjuk kekuatan mutlak nan dahsyat harus mengingatkan mereka siapa nakhoda kapal sebenarnya di sini, ya 'kan?"
      Speaker = "Poseidon"
      Event = "PoseidonLegendaryPickUp02"
    }
    {
      Id = "Poseidon_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti sudah menemukan semua Berkahku sejauh ini! Tentu saja aku selalu memikirkan yang baru! Dulu aku punya banyak sekali jenis yang berbeda kalau kau mau tahu! Tapi zaman telah berubah, dan Kakanda Zeus bilang kita harus fokus!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutBoons01"
    }
    {
      Id = "Poseidon_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar suka Bintang Laut, ya, Keponakanku? Yah, aku tidak menyalahkanmu, itu 'kan {#Emph}Berkahku sendiri! {#Prev}Memang tidak memberimu apa-apa sekarang, tapi di kemudian hari, itu bisa memberimu lebih banyak, banyak, dan makin banyak lagi! Ayo, {#Emph}ambil saja! {#Prev}Bisa dibilang aku memaksamu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutDoubleRewardBoon01"
    }
    {
      Id = "Poseidon_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin beberapa Berkah baru yang kami tawarkan tidak selalu membuatmu terpesona, tapi kami {#Emph}memang {#Prev}masih punya beberapa anugerah {#Emph}lama {#Prev}yang mirip dengan yang dulu sering didapatkan kakakmu! Nah, ini beberapa di antaranya!"
      Speaker = "Poseidon"
      Event = "PoseidonLegacyBoonIntro01"
    }
    {
      Id = "Poseidon_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos menyerah pada kita, Keponakanku! Kau pasti sudah dengar, kau ikut andil {#Emph}mengalahkannya! {#Prev}Tapi masih ada kekacauan yang harus dibereskan? Aku tidak paham apa yang dia racaukan, tapi kalau kau cuma butuh Berkahku, maka {#Emph}terimalah ini!"
      Speaker = "Poseidon"
      Event = "PoseidonPostTrueEnding01"
    }
    {
      Id = "Poseidon_0383"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maksudnya ini soal harus menghadapi Chronos di zaman yang berbeda? Dan bahkan Typhon {#Emph}juga?! {#Prev}Aku tak mau berpura-pura paham, tapi jika ini harga dari perdamaian, aku akan membayar bagianku tanpa ragu sedikit pun!"
      Speaker = "Poseidon"
      Event = "PoseidonPostTrueEnding02"
    }
    {
      Id = "Poseidon_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zaman kaum fana akan segera tiba? Tidak akan terjadi jika aku membuka beberapa rekahan bumi lagi! {#Emph}Hah! {#Prev}Bumi ini sendiri bisa menelan semua bajingan kecil tak tahu terima kasih itu, jika lautan belum menenggelamkan mereka lebih dulu!"
      Speaker = "Poseidon"
      Event = "PoseidonPostEpilogue01"
    }
    {
      Id = "Poseidon_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kesal sekali saat pertama kali mendengar Tiga Takdir memutuskan untuk merombak nasib kita! Bukankah aku dan saudara-saudaraku telah menguasai alam kami dengan kekuatan dan wibawa? Tapi tak ada gunanya menentang ramalan... meski aku masih berhak mengeluh!"
      Speaker = "Poseidon"
      Event = "PoseidonPostEpilogue02"
    }
    {
      Id = "Poseidon_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat saudaraku yang agung Zeus sudah memberkatimu dengan kekuatannya yang tiada tara! Yah, mungkin tidak benar-benar {#Emph}tiada tara. {#Prev}Nih! Rasakan sebagian kekuatan milik{#Emph}ku{#Prev}, dan kau bisa timbang sendiri mana yang lebih mantap!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutZeus01"
    }
    {
      Id = "Poseidon_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau disenangi oleh Ratu Hera, Keponakan kecilku! Itu memang benar-benar berkahnya! Kehormatan besar bisa mendapatkannya, terutama bagi seseorang yang setahuku belum menikah! Dia tak pernah sudi memberkatiku!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutHera01"
    }
    {
      Id = "Poseidon_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah bertemu Apollo yang cemerlang itu, ya, Keponakanku? Dia hampir sama populernya dengan diriku di kalangan kaum fana! Mungkin di antara sekian banyak bakatnya, dia bisa membantumu mengeluarkan kita dari kekacauan ini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutApollo01"
    }
    {
      Id = "Poseidon_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kau tampak lebih jelita dari biasanya, Keponakanku! Seolah Aphrodite yang memesona itu sendiri telah menganugerahkan karunianya padamu! Dia memang melakukannya, 'kan, si centil itu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutAphrodite01"
    }
    {
      Id = "Poseidon_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}O-ho! {#Prev}Sudah berabad-abad aku tak melihat Hestia tua sebersemangat ini, Keponakanku! Dan sekarang kekuatan apinya jadi milikmu! Bagi siapa pun yang bilang api dan air tak bisa bersatu, aku di sini untuk membuktikan mereka keliru!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutHestia01"
    }
    {
      Id = "Poseidon_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kau mendapatkan anugerah membekukan dari {#Emph}Dewi Tetua Demeter{#Prev}, begitu biasa kupanggil dia! Yang selalu dibalasnya dengan ancaman membekukan seluruh samudera milikku! Lalu aku minta maaf sebesar-besarnya, dan kita anggap selesai!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutDemeter01"
    }
    {
      Id = "Poseidon_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, bahkan dari tempat tinggiku ini, kulihat perakmu berkilau laksana cangkang abalon! Itu ciri khas kepiawaian Hephaestus, bukan? Setidaknya {#Emph}karya tangannya {#Prev}terlihat bagus, {#Emph}hahahah ha-hah!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutHephaestus01"
    }
    {
      Id = "Poseidon_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keponakanku, pernahkah telingamu berdenging? Yah, telingaku sering, dan bukan karena tekanan air laut, melainkan gara-gara mendengar Hephaestus terus-menerus memukul {#Emph}tring-tang, tring-tang, tring-tang! {#Prev}Rasanya sudah cukup untuk membuatku {#Emph}gila!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutHephaestus02"
    }
    {
      Id = "Poseidon_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Waduh{#Prev}, keponakanku, kau tampak dirasuki kecepatan yang luar biasa tak wajar! Kelincahan yang sanggup membuat iri bajingan kecil Hermes, yang seperti biasa, batang hidungnya tak kelihatan di mana pun. Pembawa pesan macam apa {#Emph}dia {#Prev}itu!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutHermes01"
    }
    {
      Id = "Poseidon_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bersinar laksana Sang Rembulan itu sendiri, keponakanku! Bantuan dari Selene, bukan? Dulu kukira kerjaannya cuma memacu kuda-kuda cantiknya di atas ombak samuderaku! Ternyata dia mulai melirik hobi lain!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSelene01"
    }
    {
      Id = "Poseidon_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apollo bilang kau bertemu sepupumu yang suka kelayapan itu, Artemis! Sungguh kemampuan melacak yang hebat, kuakui itu! Dia begitu sering menghilang, kukira dia cuma sedang bermalas-malasan lagi bersama kawan-kawan hewannya di hutan!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutArtemis01"
    }
    {
      Id = "Poseidon_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah—! {#Prev}Begitu jitu kau menghabisi musuh-musuhmu sampai-sampai aku hampir mengiramu sebagai Artemis yang mandiri itu, keponakanku! Entah ke mana perginya bocah nakal {#Emph}itu {#Prev}sekarang!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutArtemis02"
    }
    {
      Id = "Poseidon_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Athena yang bijak memberitahuku bahwa kalian berdua akhirnya bertemu! Seharusnya kita semua berkumpul di sini untuk menyambutmu dengan tangan terbuka, bukannya sekadar basa-basi kaku nan dingin darinya! Bukan panitia penyambut yang ramah, kan?"
      Speaker = "Poseidon"
      Event = "PoseidonAboutAthena01"
    }
    {
      Id = "Poseidon_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya semua orang bersiap siaga di sini saat bala tentara sang Titan menggempur gerbang kita! Tapi Dionysus si pemabuk itu, dia begitu menginginkan {#Emph}kedamaian{#Prev}, namun menolak untuk {#Emph}bertempur {#Prev}demi mewujudkannya! Oh, sudah kutenggelamkan rasa putus asanya itu sendiri andai aku tahu ke mana dia kabur!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutDionysus01"
    }
    {
      Id = "Poseidon_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya kau bertemu si haus perang {#Emph}Ares{#Prev}, keponakanku tersayang! Kadang kupikir {#Emph}dialah{#Prev} biang keladi semua masalah ini dengan segala tabiat perangnya! Tapi kalau bukan karena dia, kita bakal makin kewalahan melawan balik. Jadi kuanggap impaslah!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutAres01"
    }
    {
      Id = "Poseidon_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah itu yang dinamakan berkat dari keponakanku Ares yang sudah kau miliki, atau kau sedang ingin melampiaskan amarah murka yang membabi buta? Jangan lupa, lautan pun bisa sangat bergejolak!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutAres02"
    }
    {
      Id = "Poseidon_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seorang dewi berpostur perkasa kadang menerobos masuk ke kedalaman sana, keponakanku! Temanmu, mungkin? Soalnya dia menghunus Stygius yang mengerikan, pedang pusaka yang sangat berjasa bagi keluarga kita! Tapi tentu saja, tetap bukan tandingan {#Emph}trisula{#Prev} ini!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutNemesis01"
    }
    {
      Id = "Poseidon_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami {#Emph}sangat{#Prev} menghargai bantuanmu, meski ada pihak lain yang ikut turun tangan! Seperti si kekar Heracles, kau melihatnya akhir-akhir ini, kan? Bahkan sampai di puncak gunung bersalju kami ini! Aku lebih menyukaimu, tapi harus kuakui, dia {#Emph}hebat{#Prev} juga!"
      Speaker = "Poseidon"
      Event = "PoseidonAboutHeracles01"
    }
    {
      Id = "Poseidon_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertahanan darat kita sangat perkasa, tapi kita juga menghadapi serangan dari angkasa! Harpy, Drakon, dan {#Emph}banyak lagi!{#Prev} Belum lagi bocah fana bersayap yang mendengung ke sana kemari! Kakanda Zeus hampir menyambarnya dengan petir sebelum kami sadar dia ada di pihak {#Emph}kita!{#Prev}"
      Speaker = "Poseidon"
      Event = "PoseidonAboutIcarus01"
    }
    {
      Id = "Poseidon_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakanda Zeus baru-baru ini berpaling padaku dan berkata, {#Emph}Poseidon? Ada kalanya kau terlalu banyak bicara!{#Prev} Lalu kubalas, {#Emph}Tarik kembali ucapanmu!{#Prev} Dia menjawab, {#Emph}Tidak akan. {#Prev}Maka kubilang, {#Emph}Bagus kalau begitu! Bagaimana kalau aku bicara lebih sedikit mulai dari sekarang?{#Prev}"
      Speaker = "Poseidon"
      Event = "PoseidonAboutSayingLittle01"
    }
    {
      Id = "Poseidon_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keponakanku yang jelita, ini pamanmu! Dan kubawakan kekayaan berlimpah ruah langsung dari dasar samudra!"
      Speaker = "Poseidon"
      Event = "PoseidonChat01"
    }
    {
      Id = "Poseidon_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pembalasan dendam terhebat tak pernah datang dengan mudah, keponakanku! Jadi kuatkan hatimu, dan terimalah {#Emph}ini!{#Prev}"
      Speaker = "Poseidon"
      Event = "PoseidonChat02"
    }
    {
      Id = "Poseidon_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan keparat itu mengira dia sudah menang, tapi kita akan buat dia basah kuyup tenggelam, ya kan, keponakanku?"
      Speaker = "Poseidon"
      Event = "PoseidonChat03"
    }
    {
      Id = "Poseidon_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingatkan Titan tak tahu diuntung itu siapa penguasa Olympus yang sebenarnya, bisa kan, keponakanku?"
      Speaker = "Poseidon"
      Event = "PoseidonChat04"
    }
    {
      Id = "Poseidon_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, kita butuh semua bantuan yang ada. Kita tak bisa pilih-pilih saat ikan di lautan makin menipis!"
      Speaker = "Poseidon"
      Event = "PoseidonChat05"
    }
    {
      Id = "Poseidon_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berutang budi pada kemurahan hati ayahmu. Namun karena dia tiada, utang itu akan kubayar pada{#Emph}mu!{#Prev}"
      Speaker = "Poseidon"
      Event = "PoseidonChat06"
    }
    {
      Id = "Poseidon_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunjukkan pada para Titan itu siapa yang berkuasa di sini, oke? Paham kan maksudku, {#Emph}hahahaha!{#Prev}"
      Speaker = "Poseidon"
      Event = "PoseidonChat07"
    }
    {
      Id = "Poseidon_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lautan takkan ke mana-mana, begitu pula dengan kita, kan, keponakanku?"
      Speaker = "Poseidon"
      Event = "PoseidonChat08"
    }
    {
      Id = "Poseidon_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hoh{#Prev}, keponakan mungilku, paman terhebatmu ada di sini! Siap memastikan aksimu benar-benar meng{#Emph}ombak!{#Prev}"
      Speaker = "Poseidon"
      Event = "PoseidonChat09"
    }
    {
      Id = "Poseidon_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Badai sedang berkecamuk, Keponakanku. Badai dahsyat kali ini, bahkan jauh lebih besar dari yang lalu! Bersiaplah!"
      Speaker = "Poseidon"
      Event = "PoseidonChat10"
    }
    {
      Id = "Poseidon_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menerjanglah ke depan, keponakanku, dan terjang habis semua yang berani menentang kita, lakukanlah!"
      Speaker = "Poseidon"
      Event = "PoseidonChat11"
    }
    {
      Id = "Poseidon_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ombakku bisa menghantam daratan dengan kekuatan dahsyat, apalagi kalau kuberi sedikit dorongan!"
      Speaker = "Poseidon"
      Event = "PoseidonChat12"
    }
    {
      Id = "Poseidon_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sedang di tengah peperangan sengit, Hades kecil, jadi mengobrolnya nanti saja! Sekarang, waktunya bertarung!"
      Speaker = "Poseidon"
      Event = "PoseidonChat13"
    }
    {
      Id = "Poseidon_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Keponakanku, kesabaranku sudah hampir habis saat ini, tapi itu berita bagus untukmu!"
      Speaker = "Poseidon"
      Event = "PoseidonChat14"
    }
    {
      Id = "Poseidon_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sedang berada di permukaanku, bukan? Nah, selamat datang kembali, dan maafkan semua kekacauan ini!"
      Speaker = "Poseidon"
      Event = "PoseidonChat15"
    }
    {
      Id = "Poseidon_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo, Keponakanku, mari kita hancurkan musuh-musuh kita seperti kapal karam dihantam badai!"
      Speaker = "Poseidon"
      Event = "PoseidonChat16"
    }
    {
      Id = "Poseidon_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arus pasang mulai berbalik, bisa kau rasakan, Keponakanku? Tentu saja aku merasakannya, dan kau pasti juga!"
      Speaker = "Poseidon"
      Event = "PoseidonChat17"
    }
    {
      Id = "Poseidon_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Air pasang tertinggi telah tiba kembali, keponakanku! Yang merupakan caraku untuk berkata, {#Emph}ini dia!{#Prev}"
      Speaker = "Poseidon"
      Event = "PoseidonChat18"
    }
    {
      Id = "Poseidon_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan menahan diri kali ini, kau dengar aku di bawah sana, Keponakanku! Sekarang, mari kita {#Emph}guncang{#Prev} segalanya!"
      Speaker = "Poseidon"
      Event = "PoseidonChat19"
    }
    {
      Id = "Poseidon_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan seluruh samudra kini siap tunduk pada setiap perintahmu!"
      Speaker = "Poseidon"
      Event = "PoseidonChat20"
    }
    {
      Id = "Poseidon_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harta karun samudra yang tak terhitung kini milikmu! Yah, setidaknya salah satunya!"
      Speaker = "Poseidon"
      Event = "PoseidonChat21"
    }
    {
      Id = "Poseidon_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Andai saja ayahmu bisa melihatmu sekarang! Untungnya, aku masih bisa melihatmu secara samar!"
      Speaker = "Poseidon"
      Event = "PoseidonChat22"
    }
    {
      Id = "Poseidon_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan bumi dan samudra kini jadi milikmu lagi, itu pun kalau kau sanggup menanggungnya, keponakanku!"
      Speaker = "Poseidon"
      Event = "PoseidonChat23"
    }
    {
      Id = "Poseidon_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan pernah berhenti bertarung demi dirimu! Tidak sampai pertarungan ini usai! Bahkan mungkin setelahnya pun tidak!"
      Speaker = "Poseidon"
      Event = "PoseidonChat24"
    }
    {
      Id = "Poseidon_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau makin mengingatkanku pada si tua bangka Hades yang kaku itu! Dalam artian yang bagus, tentu saja!"
      Speaker = "Poseidon"
      Event = "PoseidonChat25"
    }
    {
      Id = "Poseidon_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu gelombang kedahsyatan luar biasa segera datang meluncur!"
      Speaker = "Poseidon"
      Event = "PoseidonChat26"
    }
    {
      Id = "Poseidon_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bangkitlah, keponakanku! Bagaikan monster laut yang ganas dan buas! Monster yang diberkati oleh{#Emph}ku!{#Prev}"
      Speaker = "Poseidon"
      Event = "PoseidonChat27"
    }
    {
      Id = "Poseidon_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang lebih memuaskan daripada menjatuhkan hukuman mengerikan ke musuh-musuh kita, ya kan, Keponakanku?"
      Speaker = "Poseidon"
      Event = "PoseidonChat28"
    }
    {
      Id = "Poseidon_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak pertempuran akbar telah terjadi di atas samudroku, tapi semuanya tak ada apa-apanya dibanding pertempuran {#Emph}ini!{#Prev}"
      Speaker = "Poseidon"
      Event = "PoseidonChat29"
    }
    {
      Id = "Poseidon_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo, Keponakanku, mari kita hantam musuh-musuh kita laksana ombak raksasa yang menerjang karang!"
      Speaker = "Poseidon"
      Event = "PoseidonChat30"
    }
    {
      Id = "Poseidon_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan manusia fana pun tahu samudra itu begitu melimpah, namun sanggup memuntahkan amukan yang mematikan!"
      Speaker = "Poseidon"
      Event = "PoseidonChat31"
    }
    {
      Id = "Poseidon_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan biarkan tekanan samudra meremukkanmu saat kau menyelam ke kedalaman itu sekali lagi!"
      Speaker = "Poseidon"
      Event = "PoseidonChat32"
    }
    {
      Id = "Poseidon_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian besar daratan dan lautanku jauh lebih rupawan daripada bentangan penuh medan tempur {#Emph}itu!"
      Speaker = "Poseidon"
      Event = "PoseidonChat33"
    }
    {
      Id = "Poseidon_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudoakan pelayaran mulus untukmu, Keponakanku, dan karam kapal yang mengerikan bagi musuh-musuh kita!"
      Speaker = "Poseidon"
      Event = "PoseidonChat34"
    }
    {
      Id = "Poseidon_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak yang harus dibersihkan di alam ayahmu maupun alamku, dan aku punya sesuatu yang {#Emph}sangat pas!"
      Speaker = "Poseidon"
      Event = "PoseidonChat35"
    }
    {
      Id = "Poseidon_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga pelayaran {#Emph}kali ini {#Prev}mengantarmu ke tujuan yang kau dambakan, sama seperti malam sebelumnya!"
      Speaker = "Poseidon"
      Event = "PoseidonChat36"
    }
    {
      Id = "Poseidon_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lautan pun bergetar di malam-malam mengerikan seperti ini, tapi teguhkan hatimu!"
      Speaker = "Poseidon"
      Event = "PoseidonChat37"
    }
    {
      Id = "Poseidon_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekali lagi kau berlayar menuju pesisir kami, jadi terimalah hembusan angin untuk layar kapalmu!"
      Speaker = "Poseidon"
      Event = "PoseidonChat38"
    }
    {
      Id = "Poseidon_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa kupastikan musuh-musuh kita takkan semudah itu lepas dari kail!"
      Speaker = "Poseidon"
      Event = "PoseidonChat39"
    }
    {
      Id = "Poseidon_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hatiku membuncah bangga melihatmu mengarungi perairan bergolak dengan begitu lincah!"
      Speaker = "Poseidon"
      Event = "PoseidonChat40"
    }
    {
      Id = "Poseidon_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak bertanggung jawab atas monster-monster mirip ikan yang harus kau hadapi di bawah sana!"
      Speaker = "Poseidon"
      Event = "PoseidonChat41"
    }
    {
      Id = "Poseidon_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ombak mungkin sedikit bergejolak, tapi kau sudah terbiasa dengan goyangan gelombang, kan, Keponakanku?"
      Speaker = "Poseidon"
      Event = "PoseidonChat42"
    }
    {
      Id = "Poseidon_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau memulai pelayaran penentuanmu sekali lagi, Keponakanku, ketahuilah bahwa aku menyertaimu, dalam wujud {#Emph}Boon!"
      Speaker = "Poseidon"
      Event = "PoseidonChat43"
    }
    {
      Id = "Poseidon_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hantam mata si Typhon itu malam ini demi aku, ya? Hantam di {#Emph}semua {#Prev}mata busuknya!"
      Speaker = "Poseidon"
      Event = "PoseidonChat44"
    }
    {
      Id = "Poseidon_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sudah sering mengarungi perairan ganas berkali-kali! Dan tak pernah terasa makin mudah sama sekali!"
      Speaker = "Poseidon"
      Event = "PoseidonChat45"
    }
    {
      Id = "Poseidon_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, ini aku {#Emph}lagi{#Prev}, Keponakanku yang baik! Meski kurasa kau pasti sudah tahu, soalnya semua kemasan tanpa tanda yang membungkus Boon ini basah kuyup hingga tembus!"
      Speaker = "Poseidon"
      Event = "PoseidonBlindBox01"
    }
    {
      Id = "Poseidon_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kejutan! {#Prev}Kaulah penerima beruntung dari Boon-ku yang maha dahsyat! Yang artinya pasukan Chronos akan mendapat kejutan yang jauh lebih {#Emph}besar... {#Prev}dan jelas bukan kejutan yang {#Emph}menyenangkan!"
      Speaker = "Poseidon"
      Event = "PoseidonBlindBox02"
    }
    {
      Id = "Poseidon_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tukang Perahu Dunia Bawah tua itu masih lolos dari cengkeraman Chronos, ya? Beralih profesi jadi penyelundup bajak laut di masa-masa suram begini, {#Emph}augh!"
      Speaker = "Poseidon"
      Event = "PoseidonLootBought01"
    }
    {
      Id = "Poseidon_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku heran kenapa koin harus berpindah tangan demi berkah dari pamanmu sendiri, meski kalau dipikir-pikir, berkah semacam itu memang tiada tanding harganya!"
      Speaker = "Poseidon"
      Event = "PoseidonLootBought02"
    }
    {
      Id = "Poseidon_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berapa pun Emas yang kau bayarkan seharusnya bersemayam di dasar samudra! Memangnya si Chronos itu pikir dia siapa, menghujani manusia fana dengan logam berkilau?"
      Speaker = "Poseidon"
      Event = "PoseidonLootBought03"
    }
    {
      Id = "Poseidon_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap Tukang Perahumu itu sadar bahwa lancarnya pelayaran di jalur dagangnya bukanlah sebuah kebetulan belaka!"
      Speaker = "Poseidon"
      Event = "PoseidonLootBought04"
    }
    {
      Id = "Poseidon_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, itu baru kapal yang gagah, dengan Tukang Perahu Dunia Bawah di kemudinya! Mungkin aku tak boleh memanggilnya {#Emph}Tukang Perahu Dunia Bawah {#Prev}lagi, karena sekarang dia sudah jadi {#Emph}kapten {#Prev}sejati! Aku harus memastikan arus laut tetap tenang untuknya!"
      Speaker = "Poseidon"
      Event = "PoseidonLootBought05"
    }
    {
      Id = "Poseidon_0366"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tukang Perahu Dunia Bawah itu tak mungkin berlayar ke puncak gunung ini! Kecuali dia merakit perahu yang bisa melayang di udara, wilayahnya tetap di perairanku! Tapi bagaimana bisa dia membawa dagangannya sampai ke mari...?"
      Speaker = "Poseidon"
      Event = "PoseidonLootBought06"
    }
    {
      Id = "Poseidon_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Augh! {#Prev}Kau melukaiku, Keponakanku! Bukan fisikku, tentu saja, melainkan {#Emph}mentalku! {#Prev}Luka yang hanya bisa disembuhkan dengan {#Emph}pembalasan!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection01"
    }
    {
      Id = "Poseidon_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para pelaut tahu betul bahwa lautan bisa menjadi nyonya yang sangat temperamental, dan tahu kenapa begitu, Keponakan kecilku? Karena {#Emph}aku {#Prev}bisa jadi tuan yang {#Emph}sangat pemarah!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection02"
    }
    {
      Id = "Poseidon_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menolak berkahku, Keponakanku? Baiklah, akan kutawarkan pada siapa pun yang lewat terombang-ambing. Mungkin {#Emph}mereka {#Prev}bisa lebih menghargainya!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection03"
    }
    {
      Id = "Poseidon_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saran bersahabat dariku: jika kau berpaling memunggungi lautan, kau akan menyesalinya. Dan samudra yang kumaksud di sini adalah {#Emph}diriku sendiri!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection04"
    }
    {
      Id = "Poseidon_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mulai lagi, kau mengibaskanku begitu saja seperti lumut laut yang menempel di kakimu! Kaupikir aku ini serendahan itu, Keponakanku?!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection05"
    }
    {
      Id = "Poseidon_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}paham{#Prev}, kau {#Emph}tetap {#Prev}menginginkan berkahku, hanya saja sedikit {#Emph}kalah penting {#Prev}dibanding yang baru saja kau {#Emph}ambil! {#Prev}Dan kau menginginkannya setelah sebuah {#Emph}pertarungan {#Prev}yang sangat mendebarkan!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection06"
    }
    {
      Id = "Poseidon_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berenang di perairan berbahaya dengan kelakuan seperti itu, Keponakanku. Jika kau begitu ingin melihat apa yang mengintai di kedalaman ini, {#Emph}baiklah!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection07"
    }
    {
      Id = "Poseidon_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Keponakan kecilku, rasanya kau selalu memilih melawan aku tiap kali ada kesempatan! Memancing amarahku sama sekali tak sepadan dengan harganya!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection08"
    }
    {
      Id = "Poseidon_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan mengambil pilihan itu seandainya jadi dirimu, tapi ya, kalau aku jadi {#Emph}dirimu {#Prev}aku bukan lagi {#Emph}diriku{#Prev}, jadi... {#Emph}augh{#Prev}, kau paham maksudku!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection09"
    }
    {
      Id = "Poseidon_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, berbagai berkah dahsyatku ini masih belum cukup bagus untukmu? Begitukah hal yang ingin kauyakinkan padaku?!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection10"
    }
    {
      Id = "Poseidon_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya, jika dipikir-pikir, Keponakanku, pilihanmu tepat untuk lebih mengalah pada saudaraku Zeus. Tapi aku tetap harus menjaga harga diri!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection11"
    }
    {
      Id = "Poseidon_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mendahulukan wanita, begitu ya maumu, Keponakanku? Aku yakin Ratu Hera sangat senang denganmu, tapi bagiku, jelas tidak!"
      Speaker = "Poseidon"
      Event = "PoseidonRejection12"
    }
    {
      Id = "Poseidon_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan takut, Keponakanku, amarahku langsung surut secepat ia bergejolak. Begitulah emosi! Samudra saja jauh lebih mudah dikendalikan!"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp01"
    }
    {
      Id = "Poseidon_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepertinya tadi aku agak terbawa emosi, tapi sekarang sudah tenang! Tak ada luka berkepanjangan, meski sejujurnya, berkatku ini juga takkan bertahan terlalu lama!"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp02"
    }
    {
      Id = "Poseidon_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, kurasa main-main airnya sudah cukup! Murkaku telah surut kembali ke dalam lautan tempat amarahku bersemayam!"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp03"
    }
    {
      Id = "Poseidon_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Pikiranku tadi begitu dipenuhi rasa dendam sampai-sampai kau kuicipi sedikit. Tenang saja! Hanya musuh kita yang bakal merasakan hidangan utuhnya!"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp04"
    }
    {
      Id = "Poseidon_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan kuanggap ini murni ketidaksengajaan darimu, karena aku tak bisa menyelami alasan lain dari apa yang baru saja terjadi di sini!"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp05"
    }
    {
      Id = "Poseidon_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, {#Emph}begitu {#Prev}caraku menyelesaikan perselisihan! Memanfaatkan makhluk malang mana pun di sekitar untuk menunjukkan rasa ketidaksenanganku!"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp06"
    }
    {
      Id = "Poseidon_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh! {#Prev}Lagi-lagi aku malah melawan saudaraku sendiri, padahal seharusnya kutumpahkan murkaku pada musuh bersama kita, yang sebenarnya masih kerabat kita juga!"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp07"
    }
    {
      Id = "Poseidon_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau baru saja {#Emph}membantai habis {#Prev}semua pecundang itu! Dan begitu saja, amarahku pun ikut surut seketika!"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp08"
    }
    {
      Id = "Poseidon_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Keponakanku, kali ini kulepaskan dengan peringatan saja. Atau entah sudah berapa kali begini! Aku benar-benar lupa..."
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp09"
    }
    {
      Id = "Poseidon_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}O-hoh{#Prev}, ikan kecil ini bisa menggigit balik rupanya! Mungkin aku tak seharusnya menghadiahimu karena kelakuanmu ini! Tapi aku tak bisa menahan diri!"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp10"
    }
    {
      Id = "Poseidon_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Augh{#Prev}, semua sudah kumaafkan, Keponakanku, tak perlu resah! Tadi aku cuma menguji keteguhanmu, dan terbukti, kau masih memilikinya berlimpah-limpah!"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp11"
    }
    {
      Id = "Poseidon_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengapa kita membuang-buang waktu begini padahal ada ikan yang lebih besar untuk ditangkap? Oh benar, gara-gara kau menantangku bertarung! Tapi apakah ini artinya aku kalah...?"
      Speaker = "Poseidon"
      Event = "PoseidonMakeUp12"
    }
    {
      Id = "Melinoe_0505"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah mendengar banyak tentangmu, Paman, tapi kau bukan hanya luar biasa kuat, kau juga sangat dermawan. Aku berterima kasih, dan ingin memberikan ini padamu."
      Speaker = "Melinoe"
      Event = "PoseidonGift01"
    }
    {
      Id = "Poseidon_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, Keponakanku, sungguh {#Emph}perhatian{#Prev}, tapi sama sekali {#Emph}tidak perlu{#Prev}! Namun sekarang {#Emph}aku {#Prev}yang sedang ingin bermurah hati, jadi terimalah! Ini untukmu!"
      Speaker = "Poseidon"
      Event = "PoseidonGift01"
    }
    {
      Id = "Melinoe_0504"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paman Poseidon, sebuah kehormatan bisa mendapatkan berkatmu. Terutama demi semua pertempuran yang masih harus kuhadapi."
      Speaker = "Melinoe"
      Event = "PoseidonGift02"
    }
    {
      Id = "Poseidon_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah{#Prev}, yah, aku jadi penasaran siapa yang mengajarimu tata krama sebaik ini, Keponakanku? Kau seperti seorang putri terhormat, aku kagum!"
      Speaker = "Poseidon"
      Event = "PoseidonGift02"
    }
    {
      Id = "MelinoeField_1764"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedikit bingkisan untuk menenangkan indra, Paman Poseidon! Aku tahu suasananya sedang tidak tepat, tapi bukankah selalu ada alasan untuk merayakannya?"
      Speaker = "Melinoe"
      Event = "PoseidonGift03"
    }
    {
      Id = "Poseidon_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memuji pamanmu, dan pamanmu ini, yah, merasa ini sungguh hebat! Maksudku, {#Emph}aku {#Prev}merasa ini hebat! Bahwa kau masih memikirkan hadiah di saat-saat genting seperti ini!"
      Speaker = "Poseidon"
      Event = "PoseidonGift03"
    }
    {
      Id = "MelinoeField_1765"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang satu ini untukmu, Paman! Semoga guncanganmu melenyapkan semua musuh kita dari daratan, dan lautanmu menelan mereka bulat-bulat, hingga mereka menyesali hari mereka berani menentang kita!"
      Speaker = "Melinoe"
      Event = "PoseidonGift04"
    }
    {
      Id = "Poseidon_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari sekian banyak sesembahan yang kuterima akhir-akhir ini, dan jumlahnya banyak sekali, persembahanmulah yang terbaik dari semuanya, Keponakanku!"
      Speaker = "Poseidon"
      Event = "PoseidonGift04"
    }
    {
      Id = "MelinoeField_3724"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Poseidon! Begitu banyak manusia fana mengenalmu sebagai Sang Pengguncang Bumi, karena daratan maupun lautan sama-sama tunduk pada kehendakmu. Namun aku sangat beruntung bisa mengenalmu sebagai pamanku. Aku takkan melupakan kebaikan serta semangatmu."
      Speaker = "Melinoe"
      Event = "PoseidonGift05"
    }
    {
      Id = "Poseidon_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu menghamburkan Nektarmu untukku, Keponakanku! Bukan berarti aku bisa meminumnya sejauh ini. Mungkin memang begitulah jalannya sesembahan! Kaum fana meninggalkan irisan daging bakar segar, dan hal-hal semacamnya untuk kita...! Tadi aku sedang bicara apa, ya?"
      Speaker = "Poseidon"
      Event = "PoseidonGift05"
    }
    {
      Id = "MelinoeField_3725"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah mendengar kisah tentang saudara-saudara ayahku jauh sebelum kita bertemu, Paman. Dan kau memang sekuat dan seberani yang mereka bicarakan! Namun aku juga merasa kau selalu menjagaku. Terima kasih telah membuatku merasa disambut dan aman."
      Speaker = "Melinoe"
      Event = "PoseidonGift06"
    }
    {
      Id = "Poseidon_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh pelayaran yang luar biasa bagi kita, bukan begitu, Keponakanku? Padahal kau bahkan tidak berada di dekatku! Begitulah rasanya berkeluarga. Mereka selalu bersamamu meski raganya jauh! Ketahuilah bahwa aku juga bersamamu, dan selalu memastikan jalanmu aman terkendali! Setidaknya begitu kau menemukan salah satu Berkatku..."
      Speaker = "Poseidon"
      Event = "PoseidonGift06"
    }
    {
      Id = "MelinoeField_3826"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paman Poseidon tersayang, persembahan Ambrosia yang manis ini untukmu! Ayahku pasti sangat beruntung bisa tumbuh besar bersama saudara yang berhati besar dan penuh perhatian sepertimu. Semoga seluruh lautan dan daratanmu segera merasakan ketenteraman kembali!"
      Speaker = "Melinoe"
      Event = "PoseidonGift07"
    }
    {
      Id = "Poseidon_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau menemukan kemewahan semacam ini di tengah masa-masa penuh prahara, Keponakanku?! Yang kuharapkan darimu hanyalah bertarung dengan beringas, tapi kau telah melakukan jauh lebih banyak! Aku menggerakkan bumi itu sendiri; namun kau berhasil menggerakkan {#Emph}hatiku."
      Speaker = "Poseidon"
      Event = "PoseidonGift07"
    }
    {
      Id = "Melinoe_1735"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, ini tangkapan yang luar biasa."
      Speaker = "Melinoe"
      Event = "PoseidonUpgrade.GiftGivenVoiceLines"
    }
    {
      Id = "Poseidon_0384"
      InheritFrom = "BaseSubtitle"
