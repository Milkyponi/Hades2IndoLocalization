{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _RoomDataN.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "Melinoe_0568"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutukanku... Rasanya... aku baik-baik saja..."
      Speaker = "Melinoe"
      Event = "N_Opening01.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kala sang putri bernasib malang merasakan daya hidupnya memudar di setiap hembusan udara permukaan, satu-satunya jalan hanyalah kembali ke tempat asalnya bernaung."
      Speaker = "Storyteller"
      Event = "Inspect_N_Opening01_01"
    }
    {
      Id = "MelinoeField_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Apa, a-aku... {#Emph}eungh..."
      Speaker = "Melinoe"
      Event = "Inspect_N_Opening01_01"
    }
    {
      Id = "Storyteller_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hanya segelintir jalan masuk menuju Dunia Bawah yang ada, dan salah satunya membentang melintasi Acheron, yang perairan terkutuknya memikul segenap beban kesengsaraan umat manusia."
      Speaker = "Storyteller"
      Event = "Inspect_N_Opening01_02"
    }
    {
      Id = "Melinoe_0858"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau musuh kita bisa lewat sini untuk keluar, aku juga bisa."
      Speaker = "Melinoe"
      Event = "Inspect_N_Opening01_02"
    }
    {
      Id = "Storyteller_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cahaya sang Rembulan kini menjadi satu-satunya penerang di permukaan, tempat orang-orang mati bangkit kembali, dan Olympus kian terhuyung di ambang kehancuran."
      Speaker = "Storyteller"
      Event = "Inspect_N_Opening01_03"
    }
    {
      Id = "Melinoe_0035_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutuk kau, Chronos..."
      Speaker = "Melinoe"
      Event = "Inspect_N_Opening01_03"
    }
    {
      Id = "Storyteller_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kota Ephyra, yang dahulu berdiri megah sebagai bentuk penghormatan khidmat bagi sang Raja dan Ratu Dunia Bawah yang menggetarkan jiwa, kini nyaris tak lagi tegak berdiri."
      Speaker = "Storyteller"
      Event = "Inspect_N_PreHub01_01"
    }
    {
      Id = "MelinoeField_0480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Namun reruntuhan ini tetap menghalangi jalanku."
      Speaker = "Melinoe"
      Event = "Inspect_N_PreHub01_01"
    }
    {
      Id = "MelinoeField_4579"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampaknya orang-orang mati ini enggan beranjak pergi..."
      Speaker = "Melinoe"
      Event = "N_PreHub01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0362"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada celah di dinding..."
      Speaker = "Melinoe"
      Event = "N_PreHub01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0363"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tinggal menyelip lewat sini..."
      Speaker = "Melinoe"
      Event = "N_PreHub01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mulai masuk."
      Speaker = "Melinoe"
      Event = "N_PreHub01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0365"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menuju Ephyra."
      Speaker = "Melinoe"
      Event = "N_PreHub01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_1366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baga-mana... bi-bisa...?"
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1367"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini... ti-tidak... mempan..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4578"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menembus Ephyra seperti sebelumnya..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya periksa sekeliling dulu..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Alun-alun utama..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Alun-alun utama Ephyra..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0367"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang berbeda kali ini..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1371"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali ke alun-alun utama."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1372"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Alun-alun kota."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1373"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Barikade itu terpasang lagi..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1374"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saatnya mendobrak lagi."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0618"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang berubah..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0374"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka berusaha memperlambat langkahku..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0375"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Banyak sekali jalanan yang bercabang..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0518"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hawa udaranya terasa berbeda sekarang..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih ada Pylon di sekitar sini..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0520"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, lanjut ke Pylon berikutnya."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0376"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana arahnya kali ini..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0417"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tinggal beberapa Pylon lagi."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0418"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya sisa beberapa Pylon lagi."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0620"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang tinggal keluar dari sini."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0621"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar kupamit keluar..."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0622"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada jalan lain selain keluar."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0623"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saatnya pergi."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0624"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Urusanku di sini selesai."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0625"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seharusnya sudah bisa keluar."
      Speaker = "Melinoe"
      Event = "N_Hub.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jalur menuju dermaga terkunci rapat oleh kekuatan gaib yang tak mampu digoyahkan oleh tenaga fana maupun dewa."
      Speaker = "Storyteller"
      Event = "Inspect_N_Hub_01"
    }
    {
      Id = "MelinoeField_0481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Segel ini menyerap kekuatan dari para Arwah..."
      Speaker = "Melinoe"
      Event = "Inspect_N_Hub_01"
    }
    {
      Id = "Storyteller_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah barikade menghalangi jalan ke dermaga di seberang alun-alun kota, mengurung para penghuni kota Ephyra di reruntuhan tempat tinggal mereka."
      Speaker = "Storyteller"
      Event = "Inspect_N_Hub_02"
    }
    {
      Id = "Melinoe_1434"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita pasti bisa lewat. Sekalipun harus mengerahkan seluruh Arwah di kota ini."
      Speaker = "Melinoe"
      Event = "Inspect_N_Hub_02"
    }
    {
      Id = "Storyteller_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kota yang nyaris runtuh ini bagaikan labirin jalanan—sebagian masih dibarikade, sebagian lagi terbuka, namun semuanya dicekam kengerian, malam demi malam tanpa akhir."
      Speaker = "Storyteller"
      Event = "Inspect_N_Hub_03"
    }
    {
      Id = "MelinoeField_0482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu banyak manusia fana yang hidup dan mati di tempat seperti ini..."
      Speaker = "Melinoe"
      Event = "Inspect_N_Hub_03"
    }
    {
      Id = "Storyteller_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah patung batu buatan manusia fana yang menyerupai sang penguasa kematian nan muram berdiri di pusat kota, memandangi kehancuran yang terhampar bagai terbungkam dalam kebisuan."
      Speaker = "Storyteller"
      Event = "Inspect_N_Hub_04"
    }
    {
      Id = "Storyteller_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di tengah bau busuk kematian, terbentang sebuah mata air pemulih, dipahat dari sebongkah batu menyerupai rupa sang dewi kesuburan sekaligus ratu sah Dunia Bawah."
      Speaker = "Storyteller"
      Event = "Inspect_N_Hub_05"
    }
    {
      Id = "MelinoeField_0814"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Air mancur ini... Ibu..."
      Speaker = "Melinoe"
      Event = "Inspect_N_Hub_05"
    }
    {
      Id = "Storyteller_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Meninggalkan kota terkutuk di belakangnya, sang Putri Kematian melangkah menuju padang rumput suram, tempat ia merasa tidak sepenuhnya sedang diawasi."
      Speaker = "Storyteller"
      Event = "Inspect_N_PreBoss01_01"
    }
    {
      Id = "MelinoeField_1363"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Polyphemus pasti sudah tahu aku ada di sini..."
      Speaker = "Melinoe"
      Event = "Inspect_N_PreBoss01_01"
    }
    {
      Id = "Storyteller_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jalan setapak sunyi dan berdebu dari nekropolis ini memperlihatkan parahnya pembusukan di dalamnya, namun tetap memberi sedikit penghiburan bagi para Arwah jelata di sekitar yang tak lagi punya tujuan."
      Speaker = "Storyteller"
      Event = "Inspect_N_PreBoss01_02"
    }
    {
      Id = "MelinoeField_1954"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami akan carikan rumah baru untuk kalian."
      Speaker = "Melinoe"
      Event = "Inspect_N_PreBoss01_02"
    }
    {
      Id = "Storyteller_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mengarungi Sungai Acheron, sang Pendayung Dunia Bawah melintasi alam demi alam, menembus perbatasan tersembunyi, tak kasatmata bagaikan bayangan dalam kegelapan."
      Speaker = "Storyteller"
      Event = "Inspect_N_PreBoss01_03"
    }
    {
      Id = "MelinoeField_0484"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Adakah tempat yang tak bisa didayungi oleh Tuan Charon?"
      Speaker = "Melinoe"
      Event = "Inspect_N_PreBoss01_03"
    }
    {
      Id = "Storyteller_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ada pepatah kuno berbunyi: orang bijak takkan pernah menyerang Kiklops yang tertidur dan lebih memilih lewat diam-diam; namun terkadang, pengecualian harus dibuat."
      Speaker = "Storyteller"
      Event = "Inspect_N_Boss01_01"
    }
    {
      Id = "MelinoeField_1955"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya kali ini aku harus membuat pengecualian..."
      Speaker = "Melinoe"
      Event = "Inspect_N_Boss01_01"
    }
    {
      Id = "Storyteller_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jika dulunya ini adalah padang rumput tempat ternak merumput dan berkeliaran, kini nyaris tak ada lagi jejaknya; hanya tersisa lumpur dan puing-puing setengah hangus dari masa yang lebih damai."
      Speaker = "Storyteller"
      Event = "Inspect_N_Boss01_02"
    }
    {
      Id = "MelinoeField_1956"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seharusnya Polyphemus yang merawat tempat ini..."
      Speaker = "Melinoe"
      Event = "Inspect_N_Boss01_02"
    }
    {
      Id = "Storyteller_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Padang beracun bersimbah maut di luar kota Ephyra kini kembali hening, kendati rasa Takut yang kian pekat masih membayangi jiwa-jiwa gelisah yang bersemayam di sana."
      Speaker = "Storyteller"
      Event = "Inspect_N_Boss02_01"
    }
    {
      Id = "MelinoeField_3616"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nyonya Medea benar-benar merombak tempat ini."
      Speaker = "Melinoe"
      Event = "Inspect_N_Boss02_01"
    }
    {
      Id = "Storyteller_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di malam-malam yang mencekam seperti ini, sang Penyihir Bayangan diyakini kerap menghantui padang berbau busuk ini sembari melangsungkan eksperimen kejinya pada jasad orang mati."
      Speaker = "Storyteller"
      Event = "Inspect_N_Boss02_02"
    }
    {
      Id = "MelinoeField_3656"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasanya masih agak mual setelah kejadian tadi..."
      Speaker = "Melinoe"
      Event = "Inspect_N_Boss02_02"
    }
    {
      Id = "Storyteller_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Melewati gubuk kumuh berbau busuk yang diisi perabot serbaproporsi raksasa nan kasar, serta berserakan sisa-sisa jasad segar maupun yang sudah lama membusuk, tercium hembusan angin laut..."
      Speaker = "Storyteller"
      Event = "Inspect_N_PostBoss01_01"
    }
    {
      Id = "MelinoeField_1957"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang paling tercium cuma bau bangkainya..."
      Speaker = "Melinoe"
      Event = "Inspect_N_PostBoss01_01"
    }
    {
      Id = "Storyteller_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hewan ternak malang yang hidup bersama sang Kiklops rakus tampaknya tak menyadari keadaan di sekitar mereka selagi merumput dan berkeliaran, tak benar-benar tersesat; setidaknya, belum untuk saat ini."
      Speaker = "Storyteller"
      Event = "Inspect_N_PostBoss01_02"
    }
    {
      Id = "MelinoeField_1958"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu-satunya yang seharusnya memandu mereka malah tertidur pulas..."
      Speaker = "Melinoe"
      Event = "Inspect_N_PostBoss01_02"
    }
    {
      Id = "MelinoeField_1729"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti di sini tempat tinggal Polyphemus... {#Emph}Huekk..."
      Speaker = "Melinoe"
      Event = "N_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1730"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan berlama-lama di sini..."
      Speaker = "Melinoe"
      Event = "N_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kotornya tempat ini tak pernah berubah..."
      Speaker = "Melinoe"
      Event = "N_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana bisa dia hidup seperti ini?"
      Speaker = "Melinoe"
      Event = "N_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bau{#Prev} itu..."
      Speaker = "Melinoe"
      Event = "N_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_5680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, babi hutan impianku nongol juga...!"
      Speaker = "Melinoe"
      Event = "N_MiniBoss02.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3707"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Babi Hutan Erymanthos..."
      Speaker = "Melinoe"
      Event = "N_MiniBoss02.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3708"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bangkai babi hutan itu lagi."
      Speaker = "Melinoe"
      Event = "N_MiniBoss02.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3710"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak ingat aku, kan?"
      Speaker = "Melinoe"
      Event = "N_MiniBoss02.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3711"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Murni insting dan amarah..."
      Speaker = "Melinoe"
      Event = "N_MiniBoss02.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3709"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau memang tak betah terkapar lama-lama."
      Speaker = "Melinoe"
      Event = "N_MiniBoss02.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0462"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Terlalu banyak pemburu gagal menaklukkan Babi Hutan Erymanthos yang berukuran raksasa dan mengamuk saat ia masih bernapas; bahkan Kematian pun tak mampu menghentikan derap kuku dan gading perkasa miliknya.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_N_MiniBoss02_01"
    }
    {
      Id = "MelinoeField_3660"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi aku berhasil! Untuk saat ini."
      Speaker = "Melinoe"
      Event = "Inspect_N_MiniBoss02_01"
    }
    {
      Id = "Storyteller_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di salah satu sudut kota runtuh yang terlupakan, seorang pencari misteri terkutuk nan menyendiri melangsungkan urusannya di bawah rembulan pucat nan jauh.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_N_Story_01_01"
    }
    {
      Id = "MelinoeField_0483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku belajar satu-dua kutukan dari yang satu ini..."
      Speaker = "Melinoe"
      Event = "Inspect_N_Story_01_01"
    }
  ]
}
