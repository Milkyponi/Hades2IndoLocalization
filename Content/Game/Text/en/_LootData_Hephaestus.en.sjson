{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _LootData_Hephaestus.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "MelinoeField_3035"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktunya perbaikan."
      Speaker = "Melinoe"
      Event = "HephaestusUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_3036"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari bengkel tempa."
      Speaker = "Melinoe"
      Event = "HephaestusUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_3037"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hephaestus..."
      Speaker = "Melinoe"
      Event = "HephaestusUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_0940"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Segel sang pandai besi..."
      Speaker = "Melinoe"
      Event = "HephaestusUpgrade.FirstSpawnVoiceLines"
    }
    {
      Id = "Hephaestus_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu luar biasa tiap kali Paduka Zeus mampir tanpa kabar, lalu mengawasi dari balik pundakku selagi aku menempa! Malah sempat-sempatnya menunjuk di mana paluku harus mendarat. Nah, Yah, mau ke mana lagi selanjutnya?"
      Speaker = "Hephaestus"
      Event = "HephaestusWithZeus01"
    }
    {
      Id = "Zeus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Haruskah kuingatkan, putraku yang baik, bahwa ini sebenarnya bukan bengkel tempa {#Emph}milikmu{#Prev}, melainkan fasilitas yang boleh kita semua gunakan? Dan sekarang aku ingin menggunakannya demi keponakan jauhmu di sana itu! {#Emph}Ehm{#Prev}, coba tunjukkan lagi padaku cara memakai benda ini..."
      Speaker = "Zeus"
      Event = "HephaestusWithZeus01"
    }
    {
      Id = "Hephaestus_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibuku sang Ratu sampai tak percaya kalau kau dan aku akhir-akhir ini sering mengobrol, penyihir kecil. Jadi aku harus membuktikannya langsung di sini, paham kan. Meski sepertinya beliau malah mau bicara sendiri menggantikanku..."
      Speaker = "Hephaestus"
      Event = "HephaestusWithHera01"
    }
    {
      Id = "Hera_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putraku Hephaestus hanya perlu membuktikan bahwa ia bisa memancarkan {#Emph}rasa percaya diri {#Prev}yang layak bagi seorang dewa, ketimbang apa pun yang biasa ia pancarkan itu. Paling tidak ia sudah berguna, bukan?"
      Speaker = "Hera"
      Event = "HephaestusWithHera01"
    }
    {
      Id = "Hephaestus_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir kecil, saat ini aku sedang bersama sang Ratu sendiri! Dan beliau bilang ingin bicara sepatah dua patah kata. Lalu aku bilang {#Emph}baik Ibu, apa pun maumu, silakan saja."
      Speaker = "Hephaestus"
      Event = "HephaestusWithHera02"
    }
    {
      Id = "Hera_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lihat kan, Sayang? Salah satu hal terindah dari memiliki anak kandung adalah melihat betapa patuhnya mereka pada kita! Teruskan, Hephaestus. Sampaikan salam hangat kita padanya."
      Speaker = "Hera"
      Event = "HephaestusWithHera02"
    }
    {
      Id = "Hephaestus_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga yang penuh gengsi! Paman Poseidon di sini ogah pakai zirah lengkap dengan alasan dia terlalu lincah dan terlalu keras kepala, {#Emph}ehm... {#Prev}maksudku berkulit {#Emph}badak{#Prev}. Bukankah begitu, Paman?"
      Speaker = "Hephaestus"
      Event = "HephaestusWithPoseidon01"
    }
    {
      Id = "Poseidon_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Keponakanku, kau tahu betapa aku menghargai hasil karyamu! Meski aku {#Emph}mati-matian {#Prev}ogah mengenakannya sendiri! Masalahnya, cuma {#Emph}pengecut {#Prev}yang pergi bertempur berbalut zirah dari ujung kepala sampai kaki; ya memang pengecut itu jauh lebih tahan dari luka tebasan, tapi {#Emph}tetap saja!"
      Speaker = "Poseidon"
      Event = "HephaestusWithPoseidon01"
    }
    {
      Id = "Hephaestus_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oi{#Prev}, penyihir kecil, tadi aku baru saja mengobrol dengan {#Emph}Apollo {#Prev}soal bagaimana tak semua dari kita dikaruniai rupa menawan, mulut manis, dan sebagainya. Kita harus banting tulang {#Emph}mengasahnya {#Prev}supaya bisa jago! Hal yang mustahil dia bayangkan!"
      Speaker = "Hephaestus"
      Event = "HephaestusWithApollo01"
    }
    {
      Id = "Apollo_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku lebih dari sekadar bisa {#Emph}membayangkannya{#Prev}, Saudaraku. Bagian dari menjadi berbakat adalah membuatnya terlihat gampang. Contohnya kau dan keahlian menempamu! Bagiku rasanya mirip {#Emph}seperti itu{#Prev}, tapi untuk segudang hal {#Emph}lainnya!"
      Speaker = "Apollo"
      Event = "HephaestusWithApollo01"
    }
    {
      Id = "Hephaestus_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nenek buyutmu dan aku biasanya jarang mengobrol. Tapi sekarang kita punya kesamaan, penyihir kecil: {#Emph}kau! {#Prev}Kukira keadaan sudah terkendali dengan baik olehmu, tapi... mana bisa aku mengelabui orang sekaliber Dewi Demeter!"
      Speaker = "Hephaestus"
      Event = "HephaestusWithDemeter01"
    }
    {
      Id = "Demeter_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada satu pun dari kita yang situasinya {#Emph}terkendali dengan baik{#Prev}, Cucuku. Jadi jangan hiraukan perkataan Hephaestus barusan! Manfaatkanlah kekuatan gabungan kami... dan jika Takdir mengizinkan, pulihkanlah kembali kedamaian kita."
      Speaker = "Demeter"
      Event = "HephaestusWithDemeter01"
    }
    {
      Id = "Hephaestus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada gunanya meratapi nasib, penyihir kecil! Apa pun yang terjadi di luar sana, kau harus mencintai apa yang kau kerjakan, sesederhana itu. Tapi jangan dengar dari {#Emph}aku! {#Prev}Pakar aslinya ada di sini!"
      Speaker = "Hephaestus"
      Event = "HephaestusWithAphrodite01"
    }
    {
      Id = "Aphrodite_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, terima kasih banyak, Sayang! Kita masing-masing punya begitu banyak cinta untuk dicurahkan. Dan keindahannya adalah, makin banyak yang kita beri, makin banyak yang kita {#Emph}miliki! {#Prev}Tak disangka hal seindah dan seberharga {#Emph}ini {#Prev}punya persediaan yang tak terbatas!"
      Speaker = "Aphrodite"
      Event = "HephaestusWithAphrodite01"
    }
    {
      Id = "Hephaestus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau aku dibilang begitu lihai memakai palu, lalu kenapa sampai sekarang aku belum bisa membuat setelan zirah yang pantas buat Aphrodite, ya? Setidaknya aku berhasil menyuruhnya membawa tameng. Oi Aphy, kau mau mencobanya atau bagaimana?"
      Speaker = "Hephaestus"
      Event = "HephaestusWithAphrodite02"
    }
    {
      Id = "Aphrodite_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh Hephaestus, perhatian sekali dirimu padaku! Tapi aku tak suka merasa terbebani, dan lebih suka membiarkan pilihanku tetap terbuka ketimbang berkomitmen pada salah satu karya molek ini. Bagaimana kalau kawan kita dari Dunia Bawah ini saja yang mencobanya?"
      Speaker = "Aphrodite"
      Event = "HephaestusWithAphrodite02"
    }
    {
      Id = "Hephaestus_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum fana itu suka berterima kasih pada kita, tapi apa yang seharusnya {#Emph}kita {#Prev}lakukan, kau tahu? Ya, aku melakukan hal yang sama. Mengucap syukur pada Dewi Hestia, tentunya! Karena telah menjaga api bengkelku tetap membara. Beliau bahkan sesekali mengunjungiku!"
      Speaker = "Hephaestus"
      Event = "HephaestusWithHestia01"
    }
    {
      Id = "Hestia_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, itu karena aku memang {#Emph}suka {#Prev}di sini, Nak! Di balik semua suara dentang-denting palu dan semacamnya, suasananya cukup {#Emph}tenang{#Prev}. Dan kau juga teman mengobrol yang asyik. Nah, bagaimana kalau kita tunjukkan pada sepupumu apa yang bisa kita tempa {#Emph}bersama?"
      Speaker = "Hestia"
      Event = "HephaestusWithHestia01"
    }
    {
      Id = "Hephaestus_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa melihat kemiripan keluarga antara Ares dan diriku, kan, penyihir kecil? Mungkin {#Emph}dia {#Prev}dapat tampangnya, tapi {#Emph}aku {#Prev}yang dapat semua karismanya, iya kan, Saudaraku?"
      Speaker = "Hephaestus"
      Event = "HephaestusWithAres01"
    }
    {
      Id = "Ares_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira ada benarnya perangai kita memang tak serupa, Hephaestus. Namun jika harus ada persaingan di antara kita, bagaimana kalau Aphrodite sendiri yang menjadi jurinya? Tentu saja kalau kau berani mengambil kesempatan itu."
      Speaker = "Ares"
      Event = "HephaestusWithAres01"
    }
    {
      Id = "Melinoe_0941"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, dia mau mengukur setelan zirah untukku? {#Emph}Demi Hades! Olympus, kuterima pesan ini!"
      Speaker = "Melinoe"
      Event = "HephaestusFirstPickUp"
    }
    {
      Id = "Hephaestus_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, kau sepupu baruku itu? Kata mereka kau butuh senjata atau semacamnya. {#Emph}Cih{#Prev}, kau sudah punya satu rupanya! Bobrok sekali lagi, dari sini saja sudah kelihatan pengerjaannya {#Emph}seburuk {#Prev}itu. Tapi ya, aku {#Emph}bisa {#Prev}sih menyetelnya ulang..."
      Speaker = "Hephaestus"
      Event = "HephaestusFirstPickUp"
    }
    {
      Id = "Hephaestus_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlihat babak belur seperti sebongkah bijih besi yang habis ditempa! Bertahanlah sebentar saja supaya bisa menghargai hasil karyaku."
      Speaker = "Hephaestus"
      Event = "HephaestusLowHealth01"
    }
    {
      Id = "Hephaestus_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hih{#Prev}, kau berantakan sekali, penyihir kecil. Mungkin ini sudah agak terlambat! Padahal bakal lebih berguna kalau dari tadi."
      Speaker = "Hephaestus"
      Event = "HephaestusLowHealth02"
    }
    {
      Id = "Hephaestus_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau kelihatan mengenaskan sekali sekarang, dan kata-kata itu keluar dari mulut {#Emph}ku! {#Prev}Tapi hey, kau dapat servis senjata gratis sepaket dengan, {#Emph}ehm... {#Prev}celotehan yang tak mengenakkan ini."
      Speaker = "Hephaestus"
      Event = "HephaestusLowHealth03"
    }
    {
      Id = "Hephaestus_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kena hajar beberapa kali di jalan, lalu kenapa? Kau adalah perpanjangan dari senjatamu, penyihir kecil! Dan senjata yang bagus bisa tahan banting."
      Speaker = "Hephaestus"
      Event = "HephaestusLowHealth04"
    }
    {
      Id = "Hephaestus_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadwalku lagi ada yang kosong, jadi kupikir kenapa tidak mengembalikan senjatamu ke kondisi yang lebih bagus dari baru sejak awal perjalanan?"
      Speaker = "Hephaestus"
      Event = "HephaestusRunStart01"
    }
    {
      Id = "Hephaestus_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, aku sengaja mencegatmu sebelum berangkat! Malam ini ada penawaran khusus: servis gratis untuk senjata perak rahasia, kalau kau membawanya?"
      Speaker = "Hephaestus"
      Event = "HephaestusRunStart02"
    }
    {
      Id = "Hephaestus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang cerah untukmu, penyihir kecil! Garapanku memang tak sebentar, tapi kadang {#Emph}aku {#Prev}bisa gesit. Dan kupikir, kenapa aku tidak ikut membantunya dari garis awal saja, {#Emph}ya kan? {#Prev}Tak ada salahnya!"
      Speaker = "Hephaestus"
      Event = "HephaestusRunStart03"
    }
    {
      Id = "Hephaestus_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau pergi ke mana kau, {#Emph}eh? {#Prev}Sebaiknya jangan berangkat menghadapi rintangan yang {#Emph}mustahil {#Prev}tanpa persiapan, jadi kemari! Biar kupasangkan zirah dengan cepat."
      Speaker = "Hephaestus"
      Event = "HephaestusRunStart04"
    }
    {
      Id = "Hephaestus_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau mengabari ayah dan ibumu tentang berita terbaru setelah berkunjung ke mari? Yah, semoga kau meremukkan siapa pun yang menghalangi jalanmu, penyihir kecil! Terutama kalau itu Chronos brengsek lainnya atau apa pun yang sedang kau urus di bawah sana."
      Speaker = "Hephaestus"
      Event = "HephaestusRunStartUnderworld01"
    }
    {
      Id = "Hephaestus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau berkunjung ke tempat kami, atau setidaknya mencoba? Kurasa kau bakal terlibat {#Emph}baku hantam {#Prev}sekali dua kali di jalan, tapi... aku bisa tawarkan paket perlindungan {#Emph}lengkap {#Prev}untuk hal-hal semacam itu!"
      Speaker = "Hephaestus"
      Event = "HephaestusRunStartSurface01"
    }
    {
      Id = "Hephaestus_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihatmu kembali ke puncak, penyihir kecil, soalnya situasi di gunung ini masih agak runyam. Atau memang sengaja kita bikin begitu? Mau bagaimanapun juga, aku sih tak peduli."
      Speaker = "Hephaestus"
      Event = "HephaestusRunStartSurface02"
    }
    {
      Id = "Hephaestus_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, setahuku kau ini semacam penyihir, ya? Lalu buat apa kau butuh {#Emph}aku{#Prev}? Mungkin sihir menterengmu itu tak sehebat yang dibicarakan orang! Karyaku {#Emph}ini{#Prev}, penyihir kecil, selalu bisa diandalkan."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutMelinoe01"
    }
    {
      Id = "Hephaestus_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau bicara langsung dengan ibu dan ayah, tatap muka! Bahkan {#Emph}aku {#Prev}saja jarang bisa begitu. Pasti tegang sekali waktu menemui mereka. Atau mungkin tidak juga, mengingat apa saja yang sudah kau terobos demi sampai ke sana."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutPalace01"
    }
    {
      Id = "Hephaestus_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka tak membiarkanmu masuk lagi ke Istana, {#Emph}ya? {#Prev}Jangan dimasukkan ke hati, itu cuma gengsi sialan keluarga kami! Ibu dan ayah tak sudi menerima tamu sampai semuanya {#Emph}sempurna{#Prev}, tapi... kenyataannya tak pernah ada yang sempurna."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutPalace02"
    }
    {
      Id = "Hephaestus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini masa-masa kelam, penyihir kecil, tapi kita bisa apa? Kuberitahu apa yang bisa {#Emph}aku {#Prev}lakukan: aku bisa duduk di sini berkeringat di depan perapian, menempa persenjataan dan sejenisnya. Di sini panas dan berisik bukan main, tak ada yang berani mengganggu kerjaku. Lumayan, kan!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutForge01"
    }
    {
      Id = "Hephaestus_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Padahal kau sudah bolak-balik ke daerah ini, tapi baru sekali melihat tempat perapianku, kan, penyihir kecil? Memang sengaja dibuat begitu. Tempat ini mirip brankas sialan, terlalu banyak barang berharga. Termasuk diriku! Maaf ya tadi kelewatan bertemunya."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutForge02"
    }
    {
      Id = "Hephaestus_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu atau ayahku menyinggung soal senjata pamungkas kami, ya? Kalau Berkah dariku bunyinya {#Emph}klang{#Prev}, bayangkan suara itu tapi lebih dahsyat sekitar, yah... anggap saja {#Emph}jauh lebih dahsyat. {#Prev}Aku sendiri ogah memakainya, soalnya tempat perapianku bakal ikut meledak {#Emph}kabum!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutLastResort01"
    }
    {
      Id = "Hephaestus_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku suka membuat senjata yang cocok untuk membantai, katakanlah satu, dua, atau paling banyak lima belas sekaligus? Tapi kalau lebih dari itu, hilang sudah keseruannya! Ibu dan Ayah tak mengerti hal itu, mereka cuma ingin membasmi semuanya. Tapi Ares lumayan paham, sih."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutLastResort02"
    }
    {
      Id = "Hephaestus_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa jaga rahasia, penyihir kecil? Senjata pamungkas yang disuruh buat oleh ibu dan ayahku itu sebenarnya takkan pernah bisa dipakai. Raja dan ratu kita memesannya cuma supaya merasa segalanya terkendali. Kuberi mereka rasa puas itu, tapi... cuma itu yang akan kuberikan."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutLastResort03"
    }
    {
      Id = "Hephaestus_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kubocorkan sebuah rahasia, penyihir kecil. Bagian terbaik dari menempa bukanlah senjata dan zirah yang kau hasilkan, melainkan proses menghadirkannya ke dunia. Agak mirip seperti punya anak, kurasa! Bedanya, ini lebih sulit dibuat daripada dirawat."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutCreation01"
    }
    {
      Id = "Hephaestus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak pernah kenal keluargamu, {#Emph}ya? {#Prev}Malah lebih baik begitu kalau menurutku. Walau kau... tak menanyakannya padaku. Mungkin juga tidak akan walau bisa, dan aku juga sadar betul kau kemari mengharapkan jasaku, bukan ocehanku, jadi, {#Emph}ehem{#Prev}... ini."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutFamily01"
    }
    {
      Id = "Hephaestus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu dan ayahku itu, hubungan mereka tak begitu akur. Tapi sesekali dalam waktu yang lama, ada percikan cinta di antara mereka, dan mereka jadi seperti raja dan ratu sejati lagi. Bikin iri seisi dewata! Akhir-akhir ini, sih, mereka kebanyakan panik."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutFamily02"
    }
    {
      Id = "Hephaestus_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang mengalahkan baku hantam jujur untuk menyelesaikan pertengkaran keluarga, {#Emph}bukan? {#Prev}Apalagi sangat produktif mengingat kita bahkan tak bisa saling bunuh, seperti yang bisa dibuktikan sendiri oleh si tua Chronos. {#Emph}Sudahlah! {#Prev}Banyak pekerjaan menantiku!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutChronos01"
    }
    {
      Id = "Hephaestus_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cerdik juga pak tua Chronos merekrut gerombolan arwah penuh dendam untuk melawan kita, ya? Kita yang membuat mereka tewas dalam perang dan semacamnya... kurasa pembalasan ini adil saja. Makin banyak kesempatan buat karyaku unjuk gigi!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutChronos02"
    }
    {
      Id = "Hephaestus_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah bertemu sebagian besar orang-orang di atas sini sekarang. Jadi sekarang kau tahu kenapa aku mengurung diri di tempat tempaan ini. Pekerjaan ini harus diselesaikan, belum lagi rasanya tidak secapek berurusan terus-menerus dengan keluarga."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutOlympians01"
    }
    {
      Id = "Hephaestus_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Woi! {#Prev}Sedang apa kau di sisi {#Emph}sini{#Prev}, kau tersesat? Kukira urusanmu di Dunia Bawah, bukan di sini. Mungkin aku saja yang kurang tahu kabar... kau butuh barang ini atau tidak?"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutSurfaceIntro01"
    }
    {
      Id = "Hephaestus_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kabar terbaru, penyihir kecil, kau sedang menuju puncak tertinggi gunung kita! Tapi jangan harap sambutan hangat saat kau tiba, soalnya kami sedang... agak sibuk sekarang?"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutSurfaceIntro02"
    }
    {
      Id = "Hephaestus_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang di kota indah Ephyra, penyihir kecil! Hal terpenting yang harus kau tahu: apa pun yang terjadi padamu di sana, {#Emph}aku {#Prev}tidak bertanggung jawab. Aku ini menempa senjata, bukan mukjizat..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutSurface01"
    }
    {
      Id = "Hephaestus_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukannya kau mestinya tidak bisa bernapas di atas sini atau semacamnya? Yah, kalau kataku sih, apalagi yang bisa diperbuat selain terus maju! Tak selalu gampang, tapi kita bisa bertahan atau setidaknya berusaha."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutSurface02"
    }
    {
      Id = "Hephaestus_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Woi, kau berhasil sampai ke atas gunung tadi? Kapan-kapan kuberi tur perapian tua ini, cuma masalahnya... tempat ini disegel rapat. Nyaris mustahil ditemukan! Demi keamanan."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutOlympus01"
    }
    {
      Id = "Hephaestus_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ke mana saja kau pergi, penyihir kecil? Comberan Dunia Bawah kalau dilihat-lihat, serba dingin dan basah... kondisi kerja yang ampas sekali, itu sudah jelas."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutOceanus01"
    }
    {
      Id = "Hephaestus_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katanya kau melewati Padang Ratapan dalam perjalananmu ke bawah sana? Syukurlah {#Emph}aku {#Prev}tak pernah melihat tempat seperti itu. Kesengsaraan itu mirip asap, masuk ke matamu dan semacamnya... susah dihilangkan!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutFields01"
    }
    {
      Id = "Hephaestus_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penasaran apa yang diperbuat Chronos pada Tartarus? Dulu itu mahakarya arsitektur luar biasa di bawah ibu dan ayahmu! Tapi Titan itu sama sekali tak punya selera seni. Paling-paling semuanya disulap jadi emas..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutTartarus01"
    }
    {
      Id = "Hephaestus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu, aku sempat membuat semacam kado pindah rumah buat ayah dan ibumu. Maket replika istana Ayah di sini, supaya kalian orang-orang Dunia Bawah bisa mengenang kami! Chronos awas saja kalau sampai mempreteli barang itu..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHouse01"
    }
    {
      Id = "Hephaestus_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Si Titan itu benar-benar bersarang di Graha ayah dan ibumu, ya? Sungguh keterlaluan dan menghina... entah kenapa itu terasa lebih menyebalkan daripada dia mengirim seluruh pasukannya untuk menyerang kami!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHouse02"
    }
    {
      Id = "Hephaestus_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktunya menyusuri gua lagi, {#Emph}ya{#Prev}, penyihir kecil? Menyelam nyaris sampai ke dasar bumi sialan ini! Pasti banyak bebatuan dan logam bagus di sana. Ayahmu menyimpan semua permata berharga itu!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutUnderworld01"
    }
    {
      Id = "Hephaestus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lihat semua kapal Chronos yang bersusah payah berlayar ke arah sini, penyihir kecil? Sebagian besar sudah pernah karam entah berapa kali. Kapal dan awak mayat hidupnya terus kembali menghantui kita! Nah, {#Emph}itu {#Prev}baru namanya pengabdian tanpa batas, {#Emph}ya?{#Prev}"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutThessaly01"
    }
    {
      Id = "Hephaestus_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak tahu apa penyebab semua gemuruh belakangan ini, tapi yang jelas bukan Poseidon, bukan pula perapianku. Kemungkinan besar sesuatu yang buruk! Tapi, aku tak mau ambil pusing sebelum tahu apa itu."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutSurfaceThreat01"
    }
    {
      Id = "Hephaestus_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah lihat ukuran monster keparat yang merayap menaiki lereng gunung kita, penyihir kecil? Untungnya aku belum, tapi... kudengar ukurannya luar biasa raksasa! Typhon itu sendiri! Tanganku nyaris tak bisa stabil bekerja kalau dia berkeliaran di dekat sini!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutTyphon01"
    }
    {
      Id = "Hephaestus_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu... si Typhon sudah hancur atau belum? Aku tak melihat banyak tanda monster, dan mereka biasanya tak bisa sembunyi-sembunyi. Tapi lalu kudengar ayahku bicara soal bagaimana {#Emph}kau {#Prev}menghabisi sisa-sisa mereka di sini. Mungkin yang tersisa kecil-kecil sekali!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutTyphonW01"
    }
    {
      Id = "Hephaestus_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Woi, ke mana perginya monster raksasa di luar sana? Gemuruh di gunung sudah reda semua dan sekarang suara denting tempaanku jadi yang paling berisik. Kau sudah menghabisinya, ya? {#Emph}Aduh{#Prev}, aku bahkan belum sempat melihatnya."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutTyphonDeath01"
    }
    {
      Id = "Hephaestus_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang {#Emph}benar-benar {#Prev}ingin kuketahui adalah, bagaimana caramu meledakkan Typhon tua itu sampai berkeping-keping? Tak banyak hal di sini yang bisa melakukan hal {#Emph}seperti itu{#Prev}, setidaknya tanpa meratakan puncaknya sekalian. Kapan-kapan kau harus menceritakannya padaku."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutTyphonDeath02"
    }
    {
      Id = "Hephaestus_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beredar kabar di atas sini kalau Chronos menculik para Dewi Takdir atau semacamnya? Yah... ketiga dewi itu sudah terlalu sering mengacaukan hidup kita semua, kurasa ini impas saja, kan?"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutFates01"
    }
    {
      Id = "Hephaestus_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Woi{#Prev}, kutarik kembali {#Emph}semua {#Prev}kata-kataku soal senjatamu waktu pertama kali kita bertemu. Demi membela diriku, jarang-jarang aku melihat hasil tempaan yang lebih unggul dari buatanku! Tapi, jangan bilang-bilang ke siapa pun kalau aku pernah bilang begitu..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutWeapons01"
    }
    {
      Id = "Hephaestus_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sampai memeras otak memikirkan senjata-senjata perak mewah milikmu itu, mencoba mereka-reka siapa gerangan yang bisa bikin benda macam itu... atau kapan? Itu Senjata Nokturnal, ya kan? Padahal cuma dimaksudkan buat upaya terakhir! Tapi ya inilah kita sekarang, kurasa."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutWeapons02"
    }
    {
      Id = "Hephaestus_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku orang pertama yang bakal bilang kalau jangan menilai dari tampang, tapi... aku sama sekali tak mengira kau begitu telaten merawat senjata, soalnya punyamu ini kuatnya bukan main! Dan bikin senjata itu {#Emph}berkilau {#Prev}bikin {#Emph}aku {#Prev}ikut berkilau."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutWeapons03"
    }
    {
      Id = "Hephaestus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ngomong-ngomong{#Prev}, dapat dari mana baju zirah perak yang kau pakai itu? Garapannya jauh lebih halus dari perkiraan awalku. Memang tak menutupi banyak bagian badan, tapi kau sepertinya tipe yang suka bebas bergerak ke sana kemari. Selalu ada yang harus dikorbankan!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutSilver01"
    }
    {
      Id = "Hephaestus_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi itu Tongkat Senja, ya? Descura, itulah namanya! Ditempa entah seberapa dalam di perut Bumi di bawah tatapan waspada sang Malam... kurang lebih begitulah."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutStaff01"
    }
    {
      Id = "Hephaestus_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bawa Belati Bersaudari Lim dan Oros, {#Emph}hah? {#Prev}Kelihatannya rapuh, tapi nyaris tak bisa dihancurkan, sumpah! Ringan seperti bulu pula. {#Emph}Ini {#Prev}bakal jadi tontonan asyik!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutDagger01"
    }
    {
      Id = "Hephaestus_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu dulu, itu Ygnium yang kau bawa! Kobaran Api sang Penyihir Persimpangan! Apa ini, murid sudah melampaui gurunya atau bagaimana, atau dia cuma menyuruhmu mengerjakan semua pekerjaan kotornya?"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutTorch01"
    }
    {
      Id = "Hephaestus_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Woi, itu jelas-jelas Zorephet sang Kapak Batu Bulan! Walau aku tak menyangka bakal melihatnya seumur hidup. Sebagian manusia fana memuja labrys, kau tahu kan? Sini! Mari kita beri mereka sesuatu yang layak diyakini."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAxe01"
    }
    {
      Id = "Hephaestus_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak pernah paham kenapa sebagian manusia fana lebih suka kapak bermata satu. Kenapa puas cuma dengan satu bilah? Dua bilah, dua kali lipat keuntungannya, kataku! Tak ada ruginya. Malahan, aku sedang mengembangkan kapak bermata {#Emph}tiga{#Prev}! Masih butuh sedikit waktu pematangan, tapi ya, {#Emph}ehem{#Prev}, abaikan saja..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAxe02"
    }
    {
      Id = "Hephaestus_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, itu namanya Revaal kalau tak salah, tengkorak yang kau bawa itu? Sejujurnya sama sekali bukan gambaran senjataku, malahan berpotensi bikin mimpi buruk, tapi... ya aku orang pertama yang bakal bilang, {#Emph}apapun yang manjur!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutLob01"
    }
    {
      Id = "Hephaestus_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa aku salah lihat, penyihir kecil... atau kau memang sedang memegang Mantel Hitam Xinth terkutuk itu? {#Emph}Mengenakannya{#Prev}, mestinya begitu! Pernah dengar cara merakitnya tapi belum pernah lihat langsung dengan mata kepalaku sendiri! Mari kita lihat apa yang bisa dilakukannya."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutSuit01"
    }
    {
      Id = "Hephaestus_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eh tunggu dulu, itu senjata lain lagi yang kau bawa...? {#Emph}Ahh, benar{#Prev}, Senjata Nokturnal dengan segala trik ganti wujudnya. Pantas saja! Kalian para penyihir memang {#Emph}suka {#Prev}mengubah-ubah wujud segalanya, setahuku."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAspects01"
    }
    {
      Id = "Hephaestus_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berapa banyak senjata sialan yang sudah kau punya sekarang, penyihir kecil? Sudah lama aku lupa semua wujud dan jenisnya, tapi jumlahnya {#Emph}banyak sekali! {#Prev}Banyak banget bahan garapan yang kau berikan padaku di sini!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAspects02"
    }
    {
      Id = "Hephaestus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang apa {#Emph}itu {#Prev}yang kau genggam di tanganmu, coba kulihat! Mungkin Aspek lain dari jenis tertentu, cuma... {#Emph}aduh{#Prev}, belum pernah lihat yang seperti itu sebelumnya. Aku jadi iri beneran ini!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHiddenAspects01"
    }
    {
      Id = "Hephaestus_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, sekarang apa lagi itu yang kau bawa, penyihir kecil? Kalau aku paham sedikit saja soal ilmu tempa senjata, maka benda itu {#Emph}jelas-jelas {#Prev}bukan berasal dari sekitaran sini. Pasti masih salah satu dari Senjata Nokturnal milikmu itu. Ayo, tunjukkan kehebatannya pada kami!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHiddenAspects02"
    }
    {
      Id = "Hephaestus_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau tak bakal menyadarinya, penyihir kecil, tapi malam ini suasana hatiku sedang buruk. Bukan karenamu kok, tenang saja! Untungnya, saat aku marah, hasil kerjaku justru bagus. Karya {#Emph}terbaikku {#Prev}malah, kalau boleh kubilang sendiri..."
      Speaker = "Hephaestus"
      Event = "HephaestusLegendaryPickUp01"
    }
    {
      Id = "Hephaestus_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak bisa kujamin senjata yang layak bagi para dewa bakal cukup buat membantumu menuntaskan semua ini. Tapi aku {#Emph}bisa {#Prev}menjamin kau mendapatkan yang terbaik dari yang terbaik."
      Speaker = "Hephaestus"
      Event = "HephaestusLegendaryPickUp02"
    }
    {
      Id = "Hephaestus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang sudah salah jalan sejak awal, antara aku dan ibuku. Apa kau bisa menyalahkannya? Bayangkan melihat Apollo dan Athena yang rupawan dan sebagainya, lalu berpikir, {#Emph}oi, aku mau bikin yang kayak begitu! {#Prev}Tapi gantinya, {#Emph}heheheh{#Prev}, kau malah bikin aku."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHeraRelationship01"
    }
    {
      Id = "Hephaestus_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah{#Prev}, Aphrodite itu benar-benar kekuatan alam yang luar biasa, ya? Dan dia nyaris jadi satu-satunya alasan yang bisa bikin aku melangkah keluar dari tempat tempaan! Bukan berarti dia keberatan aku kerja terus-terusan. Kita berdua selalu punya saling pengertian, kurasa!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAphroditeRelationship01"
    }
    {
      Id = "Hephaestus_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, kelihatannya Aphrodite sangat menyukai {#Emph}dirimu{#Prev}! Memang dia suka hampir ke semua orang sih, tapi kalau ke kamu rasanya beda. Dia tak bakal mengakuinya, tapi kurasa dia agak kesepian di sini, kau tahu kan? Banyak kenalan, tapi sedikit teman sejati."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAphroditeRelationship02"
    }
    {
      Id = "Hephaestus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehem{#Prev}, mau bilang terima kasih sudah menemani Aphrodite, sudah jadi pendengar yang baik dan semacamnya. Aku? Buatku mengobrol itu kadang lebih melelahkan daripada kerja di tempat tempaan ini... tapi kalau dengan dia beda. Sudahlah! Hal sepele memang, tapi bantuannya luar biasa."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAphroditeRelationship03"
    }
    {
      Id = "Hephaestus_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aphrodite akhir-akhir ini memang getol sekali ikut urusan perang, tapi dia jauh lebih bahagia sekarang setelah puncak pertempuran terberatnya selesai. Dan saat {#Emph}dia {#Prev}bahagia, aku pun ikut bahagia. Jadi terima kasih lagi ya, penyihir kecil."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAphroditeRelationship04"
    }
    {
      Id = "Hephaestus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah sudah berapa banyak sepupu yang kupunya, tapi kau salah satunya lagi, {#Emph}kan? {#Prev}Kau dapat perlakuan istimewa begini semata-mata karena ayah dan ibuku memintanya baik-baik padaku. Tak keberatan kok dengan kerjaan ekstra ini!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutParents01"
    }
    {
      Id = "Hephaestus_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu dan ayahmu dua-duanya baik-baik saja, kan? Urusan Chronos ini pasti berat sekali buat mereka, kalau sifat mereka mirip orang tuaku sih. Walaupun terakhir kuingat mereka berdua sama sekali tak mirip orang tuaku."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHadesAndPersephone01"
    }
    {
      Id = "Hephaestus_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehem{#Prev}, belum pernah ketemu ayahmu, tapi... sudah dengar banyak hal soal dia. Sayang sekali, padahal mungkin aku bakal lebih akur dengan dia dibanding yang lainnya. Suka logam dan batu permata dan semacamnya setahuku, jadi... setidaknya kami punya kesamaan di situ."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHades01"
    }
    {
      Id = "Hephaestus_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selama ini tinggal di bawah perlindungan sang Penyihir Persimpangan tua itu, {#Emph}ya? {#Prev}Belum pernah ketemu langsung dengannya. Dia orangnya menyendiri, jadi aku nyaris tak percaya waktu Apollo bilang dia menghubungi kami membawa kabar penting. Ternyata kabar itu, adalah {#Emph}kamu!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHecate01"
    }
    {
      Id = "Hephaestus_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lihat si Icarus itu terbang ke sana kemari? Awalnya kukira dia semacam burung hantu raksasa, tapi... itu beneran anaknya Daedalus! Kurasa dia merakit sayap terbarunya itu sendiri. Lumayan juga bakatnya!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutIcarus01"
    }
    {
      Id = "Hephaestus_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa waktu lalu, saudaramu sempat minta bantuan ke kami, siapa namanya... {#Emph}Zagreus? {#Prev}Aku tak mau ikutan. Masalah keluarga ini bakal lenyap semalam kalau saja kita semua bisa berhenti mencampuri urusan satu sama lain! Tapi ya merasa tak enak juga sih cuma diam menonton..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutZagreus01"
    }
    {
      Id = "Hephaestus_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan Zagreus rukun-rukun saja? Aku sudah kenal saudaraku seumur hidupku... pasti rasanya aneh kau baru mulai mengenalnya sekarang! Usahakan jangan terlalu banyak bertengkar. {#Emph}Heh{#Prev}, tapi ya lagi-lagi, memang buat itulah saudara ada!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutZagreus02"
    }
    {
      Id = "Hephaestus_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Papasan dengan si buta Polyphemus, begitu kabarnya? Bajingan galak bertubuh besar, isinya cuma daging dan otot. Sebenarnya tenaga orang {#Emph}itu {#Prev}bisa sangat berguna di tempat tempaan tua ini. Ah sudahlah! Kuharap dia tak mencoba mengunyahmu bulat-bulat!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutPolyphemus01"
    }
    {
      Id = "Hephaestus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar sayap malang milik Eris habis dicabuti, penyihir kecil! Sekalian suruh dia menyerahkan Meriam Adamant miliknya, mau kan? Tembakannya lebih cepat dari busur manapun yang pernah kulihat! Menuntut pemeriksaan lebih dekat...!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutErisBossW01"
    }
    {
      Id = "Hephaestus_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kita punya masalah Titan yang sangat dekat dengan rumah! Sialan betul apa yang menimpa Prometheus, tapi ya... kurasa kalau Ayah merantaiku {#Emph}dan {#Prev}menyuruh burung Elang menggerogoti hatiku setiap hari, aku pun bakal murka."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutPrometheus01"
    }
    {
      Id = "Hephaestus_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak mau ikut campur dalam urusan keruh antara Prometheus dan Ayah. Mereka tak bakal menyesap Ambrosia bersama dalam waktu dekat... tapi setidaknya sekarang tak ada lagi yang hatinya dimakan elang."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutPrometheus02"
    }
    {
      Id = "Hephaestus_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Papasan dengan Talos yang perkasa, kan? Pria raksasa yang seluruh tubuhnya terbuat dari perunggu. Berani sumpah dulu dia bakal jadi penemuan terbaikku, tapi... masih ada beberapa kecacatan yang perlu diperbaiki. Tak usah ragu menghajarnya, toh dia memang harus kubongkar lagi nanti..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutTalos01"
    }
    {
      Id = "Hephaestus_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mencoba merancangnya agar Talos bisa mulai belajar setiap kali menghadapi berbagai situasi pertarungan dan semacamnya, tapi... aku belum melihat bukti kalau itu ada hasilnya. Dia tak terlalu menyusahkanmu kan?"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutTalos02"
    }
    {
      Id = "Hephaestus_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melihat semua perseteruan dengan Prometheus ini, jadi mengingatkanku kalau dulu pernah ada seorang gadis yang, setelah melewati keadaan yang teramat kejam, tak sengaja mengutuk kaumnya untuk selama-lamanya. Cerita masa lalu yang panjang sih, tapi... aku selalu berpikir jangan-jangan dia juga mengutuk kita."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutPandora01"
    }
    {
      Id = "Hephaestus_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira ayahku bakal banyak membantu dalam urusan ini! Tuan Zeus, dia paling suka membantu! Terutama membantu dirinya sendiri... banyak taruhannya sekarang, dan kau takkan bisa jadi raja Olympus kalau bersikap malu-malu kucing."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutZeus01"
    }
    {
      Id = "Hephaestus_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, Paman Poseidon sudah turun tangan membantu, ya? {#Emph}Heh! {#Prev}Kukira itu jauh lebih baik ketimbang dia nyelonong tanpa diundang ke bengkelku, basah kuyup, bikin seisi ruangan beruap. {#Emph}Cih. {#Prev}Suka bercanda orang itu!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutPoseidon01"
    }
    {
      Id = "Hephaestus_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Ibunda memberimu berkahnya, begitu {#Emph}saja? {#Prev}Susah payah lho dapat perkenan Ratu Hera. Sementara berkah dariku... kukira agak lebih gampang kau dapatkan..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHera01"
    }
    {
      Id = "Hephaestus_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Si Apollo yang berparas tampan itu menemuimu duluan sebelum aku, {#Emph}ya? {#Prev}Wah, mengejutkan sekali. Dia bisa bantu mengobarkan semangatmu, tapi {#Emph}aku {#Prev}bisa meningkatkan senjatamu. Pilihan yang berat, bukan?"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutApollo01"
    }
    {
      Id = "Hephaestus_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jujur saja, waktu pertama kali kita bertemu, aku sempat bingung menilaimu bagaimana. Bukannya apa-apa, aku cuma kurang percaya dengan kaum penyihir sepertimu. Tapi, kalau kau layak dapat berkah Aphrodite, kau dapat paket lengkap dariku."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAphrodite01"
    }
    {
      Id = "Hephaestus_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat Hestia tua bilang dia menyukaimu, itu sudah lebih dari cukup bagiku. Tempat tempa ini takkan ada gunanya tanpa dia! Dia yang memantik api, aku yang menempa logam, dan {#Emph}kau {#Prev}yang memetik hasilnya."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHestia01"
    }
    {
      Id = "Hephaestus_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku suka lupa kalau kau ini cucunya Demeter! Aku sendiri tak tahan berada di dekatnya. Tak bermaksud menyinggung, sungguh, aku cuma tak bisa kerja apa-apa kalau udaranya kelewat dingin begini."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutDemeter01"
    }
    {
      Id = "Hephaestus_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau berpapasan dengan Artemis, tenang saja, dia sudah dikabari kalau pasokan panah berikutnya sudah meluncur. Cepat sekali dia menghabiskan anak panah, tapi sialan, cara pakainya hemat betul! Rata-rata bidikannya pasti bisa menumbangkan satu setengah nyawa per tembakan."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutArtemis01"
    }
    {
      Id = "Hephaestus_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak tahu menahu aku apa yang sedang dikerjakan Hermes. Ke mana dia? Lebih baik dia berguna sedikit, kalau tidak bakal kutarik lagi sandal {#Emph}dan {#Prev}topinya! Lalu kita lihat seberapa kencang larinya tanpa itu semua!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutHermes01"
    }
    {
      Id = "Hephaestus_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biasanya, si serba-bijak {#Emph}Athena {#Prev}yang bakal pertama menyambutmu dan bersikap ramah, tapi... dia sedang sibuk menguji semua senjata dan baju zirah buatanku. Kabar baiknya, hasil {#Emph}pengujiannya {#Prev}bagus!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAthena01"
    }
    {
      Id = "Hephaestus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kadang mereka mendatangiku dan bertanya, {#Emph}Ares di mana? {#Prev}Seolah-olah aku tahu segalanya cuma gara-gara kami bersaudara! Ini kan {#Emph}perang {#Prev}berdarah! Pasti dia sedang di luar sana bersenang-senang!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAres01"
    }
    {
      Id = "Hephaestus_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, tak habis pikir aku si Ares tua hampir saja melewatkan bagian paling seru dari semua ini! Dia muncul tepat waktu saat melawan Typhon, dan sekarang dia muncul untuk membantumu. {#Emph}Selalu {#Prev}saja mampir ke tempat yang ada keributannya."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAres02"
    }
    {
      Id = "Hephaestus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau belum melihat Dionysus, kan? Paling-paling dia cuma sedang mabuk berat di suatu tempat. Dia tak suka kalau semua orang saling bertikai... siapa juga yang bisa menyalahkannya?"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutDionysus01"
    }
    {
      Id = "Hephaestus_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, masih belum ada tanda-tanda dari Dionysus? Pasti gila-gilaan pesta yang dia datangi kalau sampai sekarang mabuknya belum reda! {#Emph}Yah{#Prev}, ada yang suka kerja dan ada yang tidak. Mau bagaimana lagi?"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutDionysus02"
    }
    {
      Id = "Hephaestus_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah karena perlengkapan perakmu itu atau apa, tapi sempat kukira tadi aku sedang menatap Rembulan... pekerjaanku tak banyak memberiku kesempatan untuk melihat Bulan."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutSelene01"
    }
    {
      Id = "Hephaestus_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paling bangga bisa mengenali hasil karya Daedalus, perajin fana terbaik yang pernah hidup; dan aku {#Emph}telah {#Prev}mengenalinya! Masih tetap sibuk dia hari-hari ini, ya? Aku yakin bahkan karyanya pun masih menyisakan sedikit ruang untuk dipoles di sana-sini."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutDaedalus01"
    }
    {
      Id = "Hephaestus_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, ini bakal jadi karya yang luar biasa, berhubung Daedalus sudah menorehkan jejaknya di situ! Bakal kuberi berkah si tua bangka sibuk yang sudah mati itu kalau bisa, tapi dia susah sekali dicari."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutDaedalus02"
    }
    {
      Id = "Hephaestus_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa menghargai persenjataan dalam bentuk atau ukuran apa pun, tapi... yang berbentuk seperti Kapak Batu Bulan milikmu itu mungkin jadi favoritku kalau aku dipaksa memilih di ujung todongan senjata. Coba perlihatkan apa yang bisa kaulakukan dengan kapak itu, penyihir kecil!"
      Speaker = "Hephaestus"
      Event = "HephaestusPackageBountyIntro01"
    }
    {
      Id = "Hephaestus_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Firasatku terasa janggal, seolah ada sesuatu yang berbeda sedang terjadi, seakan-akan... {#Emph}ah{#Prev}, entahlah! Kekuatan aneh sedang bangkit, penyihir kecil. Jauh lebih aneh dari kekuatan yang berkumpul di sini!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutPackageBounty01"
    }
    {
      Id = "Hephaestus_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, bagaimana bisa kau sampai ke sana secepat itu, penyihir kecil? Mungkin gara-gara trik sihirmu, tapi aku punya sesuatu yang lebih bisa diandalkan di sini untuk jaga-jaga."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutPackageBountyLateStart01"
    }
    {
      Id = "Hephaestus_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu yang sedang terjadi di luar sana, yang lain bilang malam ini benar-benar mengerikan! Tak ada pengaruhnya sih buat bengkelku, tapi... kedengarannya kau bakal menghadapi masalah besar, penyihir kecil."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutShrine01"
    }
    {
      Id = "Hephaestus_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, semua orang tampak gelisah malam ini! Aku sama sekali tak tahu kenapa. Mungkin ada urusan sihir yang cuma kau yang tahu? Soalnya para Automaton buatanku pun bertingkah aneh... maksudku lebih kacau dari biasanya!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutShrine02"
    }
    {
      Id = "Hephaestus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat kau masih menyimpan Pecahan Adamant yang kukirim tempo hari! Cuma rongsokan sisa tempaan saja sebenarnya, tapi... kilaunya bagus, dan lumayan berbobot. Aku bisa menggunakannya untuk melacak lokasimu dengan {#Emph}cepat!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutKeepsake01"
    }
    {
      Id = "Hephaestus_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pecahan Adamant yang kaudapatkan dariku... berguna juga, {#Emph}kan? {#Prev}Sangat murni pula! Tak kusangka kau bakal sesering ini menggunakannya untuk memanggilku, tapi... aku sama sekali tak keberatan."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutKeepsake02"
    }
    {
      Id = "Hephaestus_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum fana itu hidupnya benar-benar berat belakangan ini. Kadang kupikir jumlah mereka sekarang sudah kelewat banyak. Makin banyak orang, makin banyak penderitaan! {#Emph}Yah{#Prev}, begitulah hidup! Kita tak punya pilihan saat dilahirkan, jadi kita cuma lakukan apa yang kita bisa."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutMortals01"
    }
    {
      Id = "Hephaestus_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, soal perkataanku tempo hari, tentang makin banyak manusia berujung makin banyak penderitaan? Aphrodite mengingatkanku kalau ada hal yang lebih berharga dari sekadar itu. Dan mungkin dia benar. Hanya saja, menurutku keburukan memang jauh lebih mudah terlihat..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutMortals02"
    }
    {
      Id = "Hephaestus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau merasakan gempa, kemungkinan besar itu Paman Poseidon yang sedang mengguncang sekitarnya. Walaupun {#Emph}kadang-kadang {#Prev}itu ulahku! Saat Sang Bumi murka melihat keadaan yang kacau begini, aku memberinya saluran yang pas untuk meluapkan amarahnya."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutVolcanoes01"
    }
    {
      Id = "Hephaestus_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menimbun Adamant kita, {#Emph}eh{#Prev}, penyihir kecil? Sempat terpikir mau memintanya kembali, tapi persediaan kita masih cukup untuk sekarang. Dan kuyakin kau bakal memanfaatkannya dengan baik. Barang bagus, bukan?"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAdamant01"
    }
    {
      Id = "Hephaestus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak dewa di atas sini bertingkah seolah mereka terlahir dengan segala bakat di dunia! Mungkin memang begitu buat Apollo dan Athena, tentu saja, dan Artemis, lalu Hermes... Aphrodite juga jelas begitu, tapi, {#Emph}ehem... intinya! {#Prev}Kebanyakan dari kita harus {#Emph}berusaha keras {#Prev}dulu sebelum {#Emph}kita {#Prev}bisa mahir."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutPractice01"
    }
    {
      Id = "Hephaestus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti suka lari ke sana kemari, kan? Kalau aku, di titik ini lebih suka duduk saja. Dan begitulah kenyataannya! Kau takkan menemukan sepasang kaki yang lebih bagus dari ini di mana pun selain milik Aphrodite sendiri! Tapi tetap saja rasanya begini."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutLegs01"
    }
    {
      Id = "Hephaestus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti kaupikir aku punya segalanya di atas sini, kan? Yah, kau tak salah! Tapi anggap saja kau bukan satu-satunya yang harus belajar lewat jalan yang keras, penyihir kecil. Aku harus melakukan apa yang harus kulakukan."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutBackstory01"
    }
    {
      Id = "Hephaestus_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan semua peperangan ini, aku agak cemas bakal dicap cuma sebagai pandai besi pembuat senjata! Aku membuat banyak benda, asal kau tahu! Perhiasan, kursi mewah, bahkan Automaton yang bisa berjalan! Walau belakangan ini isinya cuma senjata, senjata, dan senjata terus..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAutomatons01"
    }
    {
      Id = "Hephaestus_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, maaf soal para Automaton buatanku di atas sini. Kudengar kau berpapasan dengan mereka dan bikin ribut! Sudah kuuji dengan segala cara... tapi bukan untuk situasi khusus semacam ini. Kalau mereka bikin masalah, hancurkan saja jadi rongsokan! Kau malah membantuku kalau begitu."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAutomatons02"
    }
    {
      Id = "Hephaestus_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin mengira aku sudah memperbaiki para Automaton buatanku sekarang... atau kau sudah terbiasa menghancurkan mereka begitu melihatnya. Nah, sekarang kau tahu bagaimana perasaan {#Emph}mereka! {#Prev}Bukannya mereka bisa merasakan sesuatu juga sih."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutAutomatons03"
    }
    {
      Id = "Hephaestus_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos pasti babak belur gara-gara sering bertemu denganmu, {#Emph}ya{#Prev}, penyihir kecil? Tapi dia belum kapok juga tampaknya. Menghajarnya sampai rata memang memuaskan, tapi aku mulai bertanya-tanya apa rencanamu setelah itu..."
      Speaker = "Hephaestus"
      Event = "HephaestusAboutChronosBossW01"
    }
    {
      Id = "Hephaestus_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh, di situ {#Prev}kau rupanya! Kami sempat kehilangan jejakmu! Pasti kau masuk begitu dalam sampai kami tak bisa memantaumu lagi. Yah, tangan dan kakimu masih utuh! Berarti semuanya beres."
      Speaker = "Hephaestus"
      Event = "HephaestusUnderworldRunCleared01"
    }
    {
      Id = "Hephaestus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah kabar kalau baru-baru ini kau berhasil menghajar habis-habisan seorang {#Emph}Titan{#Prev}? Mungkinkah {#Emph}aku {#Prev}juga turut membantu dengan caraku sendiri? Mustahil kan kau menumbangkan Chronos cuma dengan tangan kosong, {#Emph}ya, 'kan? {#Prev}Intinya, {#Emph}kerja bagus{#Prev}, penyihir kecil!"
      Speaker = "Hephaestus"
      Event = "HephaestusUnderworldRunCleared02"
    }
    {
      Id = "Hephaestus_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau benar-benar berhasil melakukannya? Entah apa sebenarnya {#Emph}itu{#Prev}, semua orang di sini punya pendapatnya masing-masing, tapi... kurasa Typhon sudah lenyap dan Chronos agak korslet otaknya, jadi... secara keseluruhan, lumayanlah."
      Speaker = "Hephaestus"
      Event = "HephaestusPostTrueEnding01"
    }
    {
      Id = "Hephaestus_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau harus terus mendaki ke sini, begitu yang kudengar? Hitung-hitung {#Emph}asuransi {#Prev}kalau sewaktu-waktu ada insiden mirip Typhon lainnya... dan kau bersama Chronos serta kita semua yang bakal mengurusnya? Baiklah kalau begitu!"
      Speaker = "Hephaestus"
      Event = "HephaestusPostTrueEnding02"
    }
    {
      Id = "Hephaestus_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Kakek Chronos terus membantu kita! Memang buat membereskan kekacauan yang dia perbuat sendiri sih, tapi tetap saja! Kukira dia sudah bakal kembali seperti dulu sekarang, tapi... mungkin kau menghajarnya cukup keras sampai otaknya permanen korslet. {#Emph}Heh... {#Prev}bisa kau lakukan hal serupa ke ibuku?"
      Speaker = "Hephaestus"
      Event = "HephaestusPostTrueEnding03"
    }
    {
      Id = "Hephaestus_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira aku bisa rehat sejenak begitu semua pertarungan dan tetek bengek itu mereda, tapi boro-boro! Pertarungan harus terus berlanjut, yang kalau dipikir-pikir wajar saja, maksudku, inilah kita! Kita selalu mencari gara-gara!"
      Speaker = "Hephaestus"
      Event = "HephaestusPostTrueEnding04"
    }
    {
      Id = "Hephaestus_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Entah dari mana semua Satir, Harpy, dan sebangsanya itu dapat pasokan barang. Mungkin menjarah mayat-mayat yang kau bereskan malam sebelumnya? Mau bagaimana pun, bagiku kelihatannya seperti rancangan Kiklops zaman purba. Garapannya kokoh!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutSurfaceFoes01"
    }
    {
      Id = "Hephaestus_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua orang di sini heboh meributkan Moirai yang tiba-tiba nongol seenaknya, yang kutanggapi: lantas kenapa? Tak ada yang tahu apa yang mereka perbuat, {#Emph}mereka sendiri {#Prev}apalagi. {#Emph}Hah{#Prev}, mungkin aku cuma iri karena mereka bakal libur kerja..."
      Speaker = "Hephaestus"
      Event = "HephaestusPostEpilogue01"
    }
    {
      Id = "Hephaestus_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah kenapa heboh sekali meributkan Tiga Moirai yang mengoceh soal masa depan yang jauh. Maksudmu dalam rentang, entahlah, sekitar dua puluh generasi manusia fana, hal-hal bakal berubah? {#Emph}Hah{#Prev}, masa iya?!"
      Speaker = "Hephaestus"
      Event = "HephaestusPostEpilogue02"
    }
    {
      Id = "Hephaestus_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu apa yang kupelajari dari semua ini, penyihir kecil? {#Emph}Tak ada waktu terbaik selain sekarang. {#Prev}Apa pun yang terjadi di masa lalu bukan salahku! Walau mungkin jadi urusanku sih! Kalau soal apa yang bakal terjadi di masa depan, {#Emph}hah{#Prev}, kuhadapi nanti saja. Ya sudah, balik kerja lagi!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutTime01"
    }
    {
      Id = "Hephaestus_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat siapa ini, pelanggan terbaikku! Kurasa hubungan kita sudah sampai di tahap kita tak perlu banyak berbasa-basi, dan aku bisa langsung melakukan keahlian terbaikku. Jangan menyerah juga, ya, penyihir kecil!"
      Speaker = "Hephaestus"
      Event = "HephaestusAboutSayingLittle01"
    }
    {
      Id = "Hephaestus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Santai saja, sebentar lagi kau bakal kembali segar bugar."
      Speaker = "Hephaestus"
      Event = "HephaestusChat01"
    }
    {
      Id = "Hephaestus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei penyihir kecil, coba kulihat bongkahan logam yang kau bawa itu."
      Speaker = "Hephaestus"
      Event = "HephaestusChat02"
    }
    {
      Id = "Hephaestus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih hidup, penyihir kecil? Nih, ini bakal bikin kau tetap bernapas."
      Speaker = "Hephaestus"
      Event = "HephaestusChat03"
    }
    {
      Id = "Hephaestus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma menempa seperti biasa, tapi mari menempa sesuatu khusus untukmu sekarang."
      Speaker = "Hephaestus"
      Event = "HephaestusChat04"
    }
    {
      Id = "Hephaestus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutebak kau mau sedikit modifikasi lagi, gampang itu."
      Speaker = "Hephaestus"
      Event = "HephaestusChat05"
    }
    {
      Id = "Hephaestus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gratis seperti biasa, biar kumasukkan ke bon saja, nanti Ayah yang bayar sewaktu-waktu."
      Speaker = "Hephaestus"
      Event = "HephaestusChat06"
    }
    {
      Id = "Hephaestus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, kau bawa sedikit logam yang bisa kutempa sesuka hatiku atau semacamnya?"
      Speaker = "Hephaestus"
      Event = "HephaestusChat07"
    }
    {
      Id = "Hephaestus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiba-tiba saja tanganku gatal ingin menghantam logam padat sebentar."
      Speaker = "Hephaestus"
      Event = "HephaestusChat08"
    }
    {
      Id = "Hephaestus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, barang itu sepertinya sudah waktunya diservis lagi."
      Speaker = "Hephaestus"
      Event = "HephaestusChat09"
    }
    {
      Id = "Hephaestus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pekerjaanmu bahaya sekali, penyihir kecil. Tapi aku bisa memberimu sedikit perlindungan."
      Speaker = "Hephaestus"
      Event = "HephaestusChat10"
    }
    {
      Id = "Hephaestus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabarmu dan sebagainya, aman? Aman, syukurlah kalau begitu, nah ambil ini."
      Speaker = "Hephaestus"
      Event = "HephaestusChat11"
    }
    {
      Id = "Hephaestus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eugh{#Prev}, akhir-akhir ini repot sekali! Tapi jangan cemas. Selalu ada waktu untukmu."
      Speaker = "Hephaestus"
      Event = "HephaestusChat12"
    }
    {
      Id = "Hephaestus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehh{#Prev}, kurasa aku punya racikan pas buat membantumu dalam urusan bantai-membantai-tapi-tak-mati ini, penyihir kecil."
      Speaker = "Hephaestus"
      Event = "HephaestusChat13"
    }
    {
      Id = "Hephaestus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, semakin sering kutempa senjata-senjata itu, semakin banyak seluk-beluk rumit yang kutemukan..."
      Speaker = "Hephaestus"
      Event = "HephaestusChat14"
    }
    {
      Id = "Hephaestus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biasanya jasaku tidak sembarangan kugratiskan, tapi situasi belakangan ini memang tidak biasa."
      Speaker = "Hephaestus"
      Event = "HephaestusChat15"
    }
    {
      Id = "Hephaestus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong-omong, apa yang kau bawa itu, penyihir kecil, sejenis senjata bagus?"
      Speaker = "Hephaestus"
      Event = "HephaestusChat16"
    }
    {
      Id = "Hephaestus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehh{#Prev}, senang bertemu denganmu lagi dan seterusnya, sekarang biarkan aku mulai bekerja."
      Speaker = "Hephaestus"
      Event = "HephaestusChat17"
    }
    {
      Id = "Hephaestus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak banyak yang bisa kubantu kalau kau berkeliaran cuma bawa tongkat jalan begitu, tahu."
      Speaker = "Hephaestus"
      Event = "HephaestusChat18"
    }
    {
      Id = "Hephaestus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehh{#Prev}, tongkat itu lagi... yah, setidaknya mungkin aku bisa mengikis benjolan kayunya."
      Speaker = "Hephaestus"
      Event = "HephaestusChat19"
    }
    {
      Id = "Hephaestus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepasang belati yang elok, penyihir kecil. Tapi mari kita buat mereka benar-benar mematikan."
      Speaker = "Hephaestus"
      Event = "HephaestusChat20"
    }
    {
      Id = "Hephaestus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba angkat bilah berkilau milikmu itu dan kubuat jadi lebih tajam dari sebelumnya."
      Speaker = "Hephaestus"
      Event = "HephaestusChat21"
    }
    {
      Id = "Hephaestus_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, kau bawa senjata favoritku buat main, ya? Tinggal sedikit setel ulang dan kau siap beraksi."
      Speaker = "Hephaestus"
      Event = "HephaestusChat22"
    }
    {
      Id = "Hephaestus_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa butuh sihir kalau kau bisa mengayunkan kapak segarang itu?"
      Speaker = "Hephaestus"
      Event = "HephaestusChat23"
    }
    {
      Id = "Hephaestus_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membawa sepasang tongkat api ke medan laga? Yah, apa pun yang manjur sajalah, penyihir kecil."
      Speaker = "Hephaestus"
      Event = "HephaestusChat24"
    }
    {
      Id = "Hephaestus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehh{#Prev}, rupanya obor bukan cuma buat nerangin jalan, ya! Sini, coba kuperiksa."
      Speaker = "Hephaestus"
      Event = "HephaestusChat25"
    }
    {
      Id = "Hephaestus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak perak bagus yang bisa kuolah dari tengkorakmu itu, jadi sodorkan ke mari!"
      Speaker = "Hephaestus"
      Event = "HephaestusChat26"
    }
    {
      Id = "Hephaestus_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, pilihan senjata yang sungguh mengerikan, penyihir kecil."
      Speaker = "Hephaestus"
      Event = "HephaestusChat27"
    }
    {
      Id = "Hephaestus_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu aku selesai, tolong pukulkan sedikit akal sehat ke para bajingan itu buatku, ya?"
      Speaker = "Hephaestus"
      Event = "HephaestusChat28"
    }
    {
      Id = "Hephaestus_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baju zirah yang bagus, penyihir kecil! Tapi kurasa kita bisa memolesnya sedikit!"
      Speaker = "Hephaestus"
      Event = "HephaestusChat29"
    }
    {
      Id = "Hephaestus_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zirahmu kelihatannya masih bekerja dengan baik, tapi perbaikan sedikit tak ada salahnya."
      Speaker = "Hephaestus"
      Event = "HephaestusChat30"
    }
    {
      Id = "Hephaestus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu kubilang, kerja lembur malam-malam itu bagus untukmu, penyihir kecil."
      Speaker = "Hephaestus"
      Event = "HephaestusChat31"
    }
    {
      Id = "Hephaestus_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bekerja demi keluarga, jadi kau berhak dapat perlindungan keluarga."
      Speaker = "Hephaestus"
      Event = "HephaestusChat32"
    }
    {
      Id = "Hephaestus_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kau sudah dapat sesuatu dari Daedalus? Baguslah, aku bisa mengolahnya."
      Speaker = "Hephaestus"
      Event = "HephaestusChat33"
    }
    {
      Id = "Hephaestus_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo naik, cuacanya cerah! Ya setidaknya itu yang kudengar. Aku sudah lama meringkuk di bengkel tempa."
      Speaker = "Hephaestus"
      Event = "HephaestusChat34"
    }
    {
      Id = "Hephaestus_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf kalau Automaton-ku bikin masalah buatmu selagi kau di sini."
      Speaker = "Hephaestus"
      Event = "HephaestusChat35"
    }
    {
      Id = "Hephaestus_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan aku yang kena hantam di luar sana. Paling tidak, aku bisa memperingan rasa sakitnya untukmu."
      Speaker = "Hephaestus"
      Event = "HephaestusChat36"
    }
    {
      Id = "Hephaestus_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu sibuk di bawah tanah? Tak ada yang lebih memahamimu selain diriku di tempat ini."
      Speaker = "Hephaestus"
      Event = "HephaestusChat37"
    }
    {
      Id = "Hephaestus_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar mengamuk hebat belakangan ini, penyihir kecil! Pertahankan terus, ya."
      Speaker = "Hephaestus"
      Event = "HephaestusChat38"
    }
    {
      Id = "Hephaestus_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana keadaan di Bawah Sana, baik-baik saja? Di sini sih lumayan."
      Speaker = "Hephaestus"
      Event = "HephaestusChat39"
    }
    {
      Id = "Hephaestus_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, {#Emph}itu dia {#Prev}Kapak Batu Bulan kesukaanku! Pergi dan tebas sesuatu jadi dua bagian untukku, penyihir kecil."
      Speaker = "Hephaestus"
      Event = "HephaestusChat40"
    }
    {
      Id = "Hephaestus_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pakai tongkat klasik malam ini? Yang kubuat biasanya tak bisa menembak, tapi... punyamu memberiku inspirasi."
      Speaker = "Hephaestus"
      Event = "HephaestusChat41"
    }
    {
      Id = "Hephaestus_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membawa belati kembar itu lagi! Aku sangat suka yang melengkung itu!"
      Speaker = "Hephaestus"
      Event = "HephaestusChat42"
    }
    {
      Id = "Hephaestus_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak pernah terpikir menjadikan obor sebagai senjata, tapi di tanganmu bisa berfungsi luar biasa!"
      Speaker = "Hephaestus"
      Event = "HephaestusChat43"
    }
    {
      Id = "Hephaestus_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tengkorak itu bukan keahlian utamaku dalam hal persenjataan, tapi aku tahu benda itu sangat mematikan!"
      Speaker = "Hephaestus"
      Event = "HephaestusChat44"
    }
    {
      Id = "Hephaestus_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu suka saat kau mengenakan Jubah Hitam Xinth. Bikin segalanya meledak {#Emph}duar!"
      Speaker = "Hephaestus"
      Event = "HephaestusChat45"
    }
    {
      Id = "Hephaestus_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang mau kau pilih kasih, penyihir kecil, jadi kami kirim Berkah tanpa tanda ini, terima saja apa yang kau dapat. {#Emph}Kejutan!"
      Speaker = "Hephaestus"
      Event = "HephaestusBlindBox01"
    }
    {
      Id = "Hephaestus_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau mengharapkan orang lain? Atau tak mengharapkan siapa pun secara khusus, karena berkah ya tetaplah berkah, benar kan?"
      Speaker = "Hephaestus"
      Event = "HephaestusBlindBox02"
    }
    {
      Id = "Hephaestus_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu kami mengirim Berkah secara rahasia begini, tapi sekarang kami pikir mungkin ada senangnya memberimu kejutan! Siapa yang tak suka kejutan? Selain diriku tentunya."
      Speaker = "Hephaestus"
      Event = "HephaestusBlindBox03"
    }
    {
      Id = "Hephaestus_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Emas yang kau pakai buat bayar ini... {#Emph}hoh{#Prev}, memang kelihatan berkilau, tapi... kelewat {#Emph}lembek {#Prev}untuk ukuran logam! Mana bisa bikin persenjataan layak pakai dengannya, sudah kucoba!"
      Speaker = "Hephaestus"
      Event = "HephaestusLootBought01"
    }
    {
      Id = "Hephaestus_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tukang Perahu di sana itu? Dia salah satu pelanggan terbaikku, tahu! Selalu tepat waktu, tahu cara tutup mulut, murni bisnis, tanpa basa-basi."
      Speaker = "Hephaestus"
      Event = "HephaestusLootBought02"
    }
    {
      Id = "Hephaestus_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biasanya hasil karyaku dihargai selangit, tapi... kau berhak dapat diskon keluarga! Meski si Charon di sana itu tetap memungut biaya jasa, kau paham kan."
      Speaker = "Hephaestus"
      Event = "HephaestusLootBought03"
    }
    {
      Id = "Hephaestus_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terus-terusan menerima kiriman koin emas Chronos itu! Meleburnya, lalu membuang cairannya kembali ke Bumi tempat asalnya... supaya Chronos bisa mencetaknya lagi!"
      Speaker = "Hephaestus"
      Event = "HephaestusLootBought04"
    }
    {
      Id = "Hephaestus_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus membayar demi berkah rasanya agak {#Emph}kampungan! {#Prev}Kebaikan para dewa cuma untuk mereka yang berkantong tebal? {#Emph}Oi! {#Prev}Bahkan kau saja tak {#Emph}punya {#Prev}kantong baju."
      Speaker = "Hephaestus"
      Event = "HephaestusLootBought05"
    }
    {
      Id = "Hephaestus_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa pun yang cari gara-gara denganku bakal digilas rata. Tanpa terkecuali! Bahkan {#Emph}kau {#Prev}sekalipun."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection01"
    }
    {
      Id = "Hephaestus_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau aku tak membela diri, aku bakal terus diejek habis-habisan. Jadi bersiaplah, percikan api akan beterbangan sebentar lagi."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection02"
    }
    {
      Id = "Hephaestus_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh{#Prev}, aku lebih suka menempa logam ini, tapi... tak ada salahnya beralih menempa {#Emph}dirimu {#Prev}sebentar."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection03"
    }
    {
      Id = "Hephaestus_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mendesakku, artinya siap-siap kudesak balik. Dan pukulanku jauh lebih keras daripada yang kau duga..."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection04"
    }
    {
      Id = "Hephaestus_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak akan naik darah... tapi aku juga tak akan diam saja diperlakukan begini. Tuntutan keluarga!"
      Speaker = "Hephaestus"
      Event = "HephaestusRejection05"
    }
    {
      Id = "Hephaestus_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sendiri yang memancingnya, penyihir kecil! Dan yang kumaksud {#Emph}ini{#Prev}, adalah palu kesayanganku ini."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection06"
    }
    {
      Id = "Hephaestus_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh{#Prev}, aku sebenarnya ogah membalas begini, tapi... ini semua sudah jadi bagian dari aturan main, kau pasti paham."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection07"
    }
    {
      Id = "Hephaestus_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak bisa dipungkiri kalau Aphrodite memang pilihan yang lebih sedap dipandang, tapi tetap saja! Ini tak bisa dibiarkan begitu saja."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection08"
    }
    {
      Id = "Hephaestus_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ingin melihat hasil karyaku, hah? Kalau begitu {#Emph}baiklah! {#Prev}Tapi bakal agak sedikit bising, ya."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection09"
    }
    {
      Id = "Hephaestus_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lain kali kalau kutawari perlindungan, penyihir kecil? Ada baiknya langsung kau terima saja."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection10"
    }
    {
      Id = "Hephaestus_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lebih memilih berperang dengan saudaraku ketimbang bersamaku? Memangnya menurutmu dari mana dia dapat semua senjatanya?"
      Speaker = "Hephaestus"
      Event = "HephaestusRejection11"
    }
    {
      Id = "Hephaestus_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga bakal memilih Aphrodite, sih, tapi... dia mengharapkanku membela dirinya, kau paham sendiri, 'kan."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection12"
    }
    {
      Id = "Hephaestus_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahku memang tak terbiasa ada yang berani menentangnya, tapi kita bisa membiasakannya mulai sekarang."
      Speaker = "Hephaestus"
      Event = "HephaestusRejection13"
    }
    {
      Id = "Hephaestus_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin ibuku bakal bangga sekali padaku kalau aku bertindak penuh dendam begini tanpa alasan yang jelas!"
      Speaker = "Hephaestus"
      Event = "HephaestusRejection14"
    }
    {
      Id = "Hephaestus_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lain kali, bikin Ares saja yang marah, jangan aku. Dialah yang selalu cari-cari alasan untuk bertarung!"
      Speaker = "Hephaestus"
      Event = "HephaestusRejection15"
    }
    {
      Id = "Hephaestus_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah, urusan kita sudah beres untuk sekarang, dan waktu istirahat sudah habis. Kembali bekerja!"
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp01"
    }
    {
      Id = "Hephaestus_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itulah yang kusebut dengan {#Emph}menempa rincian sampai tuntas{#Prev}. Lain kali serahkan saja semuanya padaku."
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp02"
    }
    {
      Id = "Hephaestus_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh! {#Prev}Ya sudahlah, anggap saja amarahku sudah reda. Tapi jangan pancing amarahku lagi, kalau tidak, bakal kubuat kau—ah, entahlah."
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp03"
    }
    {
      Id = "Hephaestus_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi itu sudah batas paling dekat bagiku untuk meledak marah. Masih terus kulatih emosiku ini, catat itu!"
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp04"
    }
    {
      Id = "Hephaestus_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang setelah kau melihat beberapa contoh hasil buatanku, mungkin kau ingin punya sendiri?"
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp05"
    }
    {
      Id = "Hephaestus_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hebat juga aksimu tadi! Tapi sepertinya kau butuh sedikit perbaikan tambal-sulam."
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp06"
    }
    {
      Id = "Hephaestus_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh{#Prev}, tak ada gunanya terus marah-marah untuk hal sepele! Lagi pula tadi aku tak semarah itu, sungguh."
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp07"
    }
    {
      Id = "Hephaestus_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sedang melatih cara mengendalikan amarahku. Aku tak boleh gampang meledak seperti beberapa orang lain di sini..."
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp08"
    }
    {
      Id = "Hephaestus_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, kuanggap urusan kita sudah impas! Kita bisa lanjut saling adu mulut di lain waktu."
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp09"
    }
    {
      Id = "Hephaestus_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrm{#Prev}, barusan itu jelas bukan hal paling produktif yang kulakukan seharian ini, tapi {#Emph}eh... ini {#Prev}semestinya bisa menebusnya."
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp10"
    }
    {
      Id = "Hephaestus_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat, penyihir kecil, kau berhasil selamat. Dan inilah hadiah yang kau menangkan."
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp11"
    }
    {
      Id = "Hephaestus_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan terlalu dimasukkan ke hati pertarungan-pertarungan ini, hal semacam ini sudah biasa terjadi di atas sini setiap waktu."
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp12"
    }
    {
      Id = "Hephaestus_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, kuanggap kita sudah impas setelah semua itu. Waktunya kembali bekerja!"
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp13"
    }
    {
      Id = "Hephaestus_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan sampai ada yang tahu, ya, tapi... tadi itu aku sengaja menahan diri. Soalnya aku tak benar-benar marah padamu."
      Speaker = "Hephaestus"
      Event = "HephaestusMakeUp14"
    }
    {
      Id = "Melinoe_0959"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hephaestus! Keahlianmu pasti sangat diminati banyak pihak. Aku sangat berterima kasih, dan begitu pula Senjata Nokturnal ini."
      Speaker = "Melinoe"
      Event = "HephaestusGift01"
    }
    {
      Id = "Hephaestus_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, aku tak bekerja demi uang tip. Tapi ya hubungan kita bukan kesepakatan biasa, dan akhir-akhir ini jarang sekali aku kedatangan klien tetap baru! Jadi, nih, ambil. Anggap saja sebagai barter."
      Speaker = "Hephaestus"
      Event = "HephaestusGift01"
    }
    {
      Id = "Melinoe_0960"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untukmu, Hephaestus yang perkasa! Meski mungkin kau tak sempat menikmati persembahan seperti ini, mengingat kau harus menempa siang dan malam..."
      Speaker = "Melinoe"
      Event = "HephaestusGift02"
    }
    {
      Id = "Hephaestus_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, ini cuma urusan pekerjaan jasa, tak perlu terlalu ramah dan formal begitu. Tapi, niat baikmu boleh juga. Jadi ya, bersulang."
      Speaker = "Hephaestus"
      Event = "HephaestusGift02"
    }
    {
      Id = "MelinoeField_1772"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hephaestus yang agung! Karyamu tiada tandingannya, dan aku juga sangat menghargai keterusteranganmu padaku. Kumohon, terimalah persembahan ini."
      Speaker = "Melinoe"
      Event = "HephaestusGift03"
    }
    {
      Id = "Hephaestus_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap kali dapat persembahan, pasti karena ada yang mau minta tolong sesuatu padaku. Padahal kau sudah dapat pelayanan kelas satu, tapi ya sudahlah, Nektar ini milikmu! Yah, kurasa sekarang sudah jadi milikku, sih."
      Speaker = "Hephaestus"
      Event = "HephaestusGift03"
    }
    {
      Id = "MelinoeField_1773"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hephaestus, kau jauh lebih hebat daripada sekadar kejeniusan karyamu. Aku tak pernah menduga kau akan begitu murah hati padaku, dan aku sangat berterima kasih atas segalanya."
      Speaker = "Melinoe"
      Event = "HephaestusGift04"
    }
    {
      Id = "Hephaestus_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, penyihir kecil, ruangannya yang makin panas, atau kau yang sengaja bikin aku salah tingkah begini, hah? Biarkan saja aku mengurus perapian sialan ini, tak usah dibesar-besarkan."
      Speaker = "Hephaestus"
      Event = "HephaestusGift04"
    }
    {
      Id = "MelinoeField_3728"
      InheritFrom = "BaseNarrative"
      DisplayName = "Persembahan untuk sepupuku yang agung, Tuan Hephaestus, sang pandai besi sejati! Bakat dan cita rasa seni setinggi ini mengalir di keluarga kita, dan sebagian besarnya ada padamu. Kau bahkan sanggup bertahan di tengah panas yang luar biasa ini tanpa mengeluh sedikit pun!"
      Speaker = "Melinoe"
      Event = "HephaestusGift05"
    }
    {
      Id = "Hephaestus_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perapianku ini memang bisa jadi sangat terik dan panas. Kurasa seteguk Nektar bisa mendinginkan badanku! Bukannya aku boleh minum saat bekerja begini, sih, tapi persetan! Tak ada yang lihat, tak ada yang perlu tahu."
      Speaker = "Hephaestus"
      Event = "HephaestusGift05"
    }
    {
      Id = "MelinoeField_3729"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya saja kita bisa berjumpa saat sedang tidak di tengah kecamuk perang, Tuan Hephaestus. Namun setidaknya aku masih diberi kesempatan untuk bertemu denganmu. Dedikasimu pada kriya senimu sungguh sebuah inspirasi! Aku bertekad untuk bisa sehebat dirimu dalam bidangku."
      Speaker = "Melinoe"
      Event = "HephaestusGift06"
    }
    {
      Id = "Hephaestus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, terima kasih banyak! Aku belum begitu mengenalmu, dan aku tak suka buru-buru mengambil kesimpulan sebelum benar-benar yakin, tapi... kelihatannya kau anak yang cukup baik. Jauh lebih baik ketimbang {#Emph}anggota tertentu {#Prev}di keluarga ini, iya, 'kan?"
      Speaker = "Hephaestus"
      Event = "HephaestusGift06"
    }
    {
      Id = "MelinoeField_4299"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengarkan aku, Tuan Hephaestus, persembahan Ambrosia ini untukmu, pandai besi paling giat bekerja di Olympus maupun di bawah sana! Melewati semua yang telah terjadi, kau tetap teguh dan tenang, serta membantuku melakukan hal yang sama."
      Speaker = "Melinoe"
      Event = "HephaestusGift07"
    }
    {
      Id = "Hephaestus_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pikir aku tenang, {#Emph}hah! {#Prev}Jujur saja, penyihir kecil, separuh waktu batinku menjerit-jerit. Aku cuma bisa menghantamkan logam ini ke sana untuk melampiaskan amarah. Separuh waktu lainnya, perasaanku cukup lega, tahu kita punya sekutu sebaik dirimu."
      Speaker = "Hephaestus"
      Event = "HephaestusGift07"
    }
    {
      Id = "MelinoeField_0645"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berutang budi padamu untuk ini, Tuan Hephaestus."
      Speaker = "Melinoe"
      Event = "HephaestusUpgrade.GiftGivenVoiceLines"
    }
    {
      Id = "Hephaestus_0186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo kita {#Emph}ratakan {#Prev}mereka, penyihir kecil!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hephaestus_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ini {#Prev}palu untukmu!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hephaestus_0188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Percikan api bakal berhamburan!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hephaestus_0229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nih{#Prev}, masih hangat dari tungku fompaku!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hephaestus_0230"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini bakal jadi {#Emph}ledakan yang seru!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hephaestus_0231"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat {#Emph}ini{#Prev}, penyihir kecil!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hephaestus_0232"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja, kenapa tidak!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hephaestus_0233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak bisa menolak pesanan!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hephaestus_0234"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayolah, itu benar-benar {#Emph}curang!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1265"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dewa penempa mulai menyerang...!"
      Speaker = "Chronos"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dentangan {#Emph}apa {#Prev}itu barusan?"
      Speaker = "Chronos"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zagreus_0364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Hephaestus...!"
      Speaker = "Zagreus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zagreus_0365"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hephaestus, ayolah!"
      Speaker = "Zagreus"
      Event = "HephaestusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hephaestus_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lebih baik belajar tahan pukulan yang lebih keras dari {#Emph}itu{#Prev}, penyihir kecil."
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Hephaestus_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin aku yang paling kerdil di antara mereka, tapi... taringku masih sanggup menggigit."
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Hephaestus_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di dekatku, penyihir kecil! Kalau tidak, kupilin tubuhmu sampai kusut."
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Hephaestus_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau ada yang tak kusukai, paluku langsung melayang menghantam!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Hephaestus_0202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bukan tipe yang sudi ditindas lagi."
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Hephaestus_0170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah kalau begitu!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Hephaestus_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gampang, bisa kuatur."
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Hephaestus_0172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beres dan {#Emph}tuntas."
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Hephaestus_0173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini dia!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Hephaestus_0174"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan masalah!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Hephaestus_0175"
