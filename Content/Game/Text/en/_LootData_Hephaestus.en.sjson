      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Hephaestus_0164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oi{#Prev}, ini cuma aku!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Hephaestus_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sesuai pesanan!"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Hephaestus_0166"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada apa ini?"
      Speaker = "Hephaestus"
      Event = "HephaestusUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Hephaestus_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat seperti yang kau mau, kan?"
