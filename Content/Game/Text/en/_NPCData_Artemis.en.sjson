      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tadi itu mengerikan..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Melinoe_1095"
      InheritFrom = "BaseSubtitle"
