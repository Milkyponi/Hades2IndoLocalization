      InheritFrom = "BaseSubtitle"
      DisplayName = "Kena."
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.KillingEnemyVoiceLines"
    }
    {
      Id = "Artemis_0072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Padahal itu mangsaku!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.KillStolenVoiceLines"
    }
    {
      Id = "Artemis_0073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Padahal tadi aku yang mau..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.KillStolenVoiceLines"
    }
    {
      Id = "Artemis_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mendahuluiku."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.KillStolenVoiceLines"
    }
    {
      Id = "Artemis_0075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keduluan kau..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.KillStolenVoiceLines"
    }
    {
      Id = "Artemis_0076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu tadi punyaku."
      Speaker = "Artemis"
