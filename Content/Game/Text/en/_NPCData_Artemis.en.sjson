      Speaker = "Artemis"
      Event = "NPC_Artemis_01.KillingEnemyVoiceLines"
    }
    {
      Id = "Melinoe_1245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bidikan hebat!"
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.KillingEnemyVoiceLines"
    }
    {
      Id = "Melinoe_1246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana bisa dia menembak seperti itu...?"
