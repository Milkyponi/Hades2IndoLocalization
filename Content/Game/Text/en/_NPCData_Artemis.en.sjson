    }
    {
      Id = "Melinoe_1257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menyusuplah tanpa terlihat."
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.ExitVoiceLines"
    }
    {
      Id = "Artemis_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saudariku?"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.OnHitVoiceLines"
    }
    {
      Id = "Artemis_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudahlah, hentikan."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.OnHitVoiceLines"
    }
    {
      Id = "Artemis_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada waktu untuk tanding latih."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.OnHitVoiceLines"
    }
    {
      Id = "Artemis_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan lampiaskan kekesalanmu padaku."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.OnHitVoiceLines"
    }
    {
      Id = "Artemis_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Fokus, Saudariku."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.OnHitVoiceLines"
    }
    {
      Id = "Artemis_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mendesah...>"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.OnHitVoiceLines"
    }
    {
      Id = "Artemis_0359"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Simpan saja tenagamu untuk Chronos?"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.OnHitVoiceLines"
    }
    {
      Id = "Artemis_0360"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayolah."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.OnHitVoiceLines"
    }
    {
      Id = "Artemis_0361"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Serius nih?"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.OnHitVoiceLines"
    }
    {
      Id = "Artemis_0362"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hentikan."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3403"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kulihat bayangan tritunggalmu bersama Ratu Phantom."
      Speaker = "Melinoe"
      Event = "NPC_Artemis_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_4108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau memang harus."
      Speaker = "Melinoe"
      Event = "NPC_Artemis_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Artemis_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Untuk perjalananmu."
      Speaker = "Artemis"
      Event = "NPC_Artemis_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Artemis_0112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berkah dariku..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Artemis_0113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Untukmu."
      Speaker = "Artemis"
      Event = "NPC_Artemis_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Artemis_0114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini yang kupunya."
      Speaker = "Artemis"
      Event = "NPC_Artemis_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Artemis_0115"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pilihan ada di tanganmu."
      Speaker = "Artemis"
      Event = "NPC_Artemis_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Artemis_0116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini."
      Speaker = "Artemis"
      Event = "NPC_Artemis_Field_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Artemis_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah terlalu lama, Saudariku. Lihat dirimu, memulai perburuan agungmu! Keadaannya memang tak ideal, tapi kau akhirnya memulai. Ketahuilah keluarga selalu mendukungmu, meski mereka cukup terkejut soal ini."
      Speaker = "Artemis"
      Event = "ArtemisFirstMeeting"
    }
    {
      Id = "Melinoe_1179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini kejutan tak ada habisnya, baik di Olimpus maupun di bawah sini. Senang bertemu denganmu, Artemis. Tapi, aku harus segera pergi. Waktu tak memihak kita, dan segalanya."
      Speaker = "Melinoe"
      Event = "ArtemisFirstMeeting"
    }
    {
      Id = "Artemis_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Waktu{#Prev} itu kakek tua bodoh yang terlalu sibuk mengepung gunung para dewa sampai tak menyadari ancaman yang mengarah kepadanya. Habisi dia."
      Speaker = "Artemis"
      Event = "ArtemisFirstMeeting"
    }
    {
      Id = "Artemis_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, kau kelihatan babak belur {#Emph}parah{#Prev}, Saudariku. Aku tak punya apa-apa untuk mengobati lukamu, tapi aku {#Emph}bisa {#Prev}membantumu membantai bajingan-bajingan yang melakukan ini padamu!"
      Speaker = "Artemis"
      Event = "ArtemisLowHealth01"
    }
    {
      Id = "Artemis_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bahkan nyaris tak sanggup berdiri, Saudariku. Mari hemat napas dan fokus agar bisa melewati sisanya dengan selamat. Setidaknya sejauh yang kita mampu."
      Speaker = "Artemis"
      Event = "ArtemisLowHealth02"
    }
    {
      Id = "Artemis_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf aku tak bisa menahan mereka semua. Aku berusaha membawa perbekalan pemulihan, tapi aku harus bepergian seringan mungkin."
      Speaker = "Artemis"
      Event = "ArtemisLowHealth03"
    }
    {
      Id = "Artemis_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, malam sialan di mana tak ada satu pun yang berjalan lancar. Kita harus bertahan sampai giliran berikutnya! Atau balikkan keadaan malam {#Emph}ini{#Prev} juga."
      Speaker = "Artemis"
      Event = "ArtemisLowHealth04"
    }
    {
      Id = "Artemis_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa adik laki-lakiku sudah membuktikan reputasinya yang gemilang sejauh ini? Setidaknya dia sudah menjalankan perannya. Begitu kuberi tahu tentang {#Emph}dirimu{#Prev}, jelas saja dia langsung kebelet mengumumkannya ke seluruh Olympus."
      Speaker = "Artemis"
      Event = "ArtemisAboutApollo01"
    }
    {
      Id = "Melinoe_1180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apollo sangat baik. Yah, mudah bagiku berkata begitu, aku bukan saudari kembarnya. Omong-omong, apa yang kau katakan padanya?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutApollo01"
    }
    {
      Id = "Artemis_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya kebenaran! Bahwa aku berpapasan dengan Penyihir Crossroads yang tertutup saat memantau musuh kita... dan dia memperkenalkanku pada seorang {#Emph}pembantai Titan {#Prev}rahasia yang sedang dia latih."
      Speaker = "Artemis"
      Event = "ArtemisAboutApollo01"
    }
    {
      Id = "Melinoe_1181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau cuma tidak bilang sudah berapa lama hal itu berlalu. Jadi sekarang mereka benar-benar mengira kerabat yang sudah lama hilang ini akan menemukan Chronos dan membantainya?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutApollo01"
    }
    {
      Id = "Artemis_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, mereka mengira kau tak punya harapan menang! Tapi mereka tak punya banyak pilihan, jadi... mereka akan tetap mendukungmu, apalagi kau ini keluarga. Dan kau tahu {#Emph}aku {#Prev}juga akan selalu mendukungmu."
      Speaker = "Artemis"
      Event = "ArtemisAboutApollo01"
    }
    {
      Id = "Artemis_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, bagaimana bisa kau sudah mendapat berkah Athena sejauh {#Emph}ini? {#Prev}Dia berada di belahan dunia yang sangat berbeda dan terlalu sibuk untuk mengirim pesan lewat Berkah..."
      Speaker = "Artemis"
      Event = "ArtemisAboutAthena01"
    }
    {
      Id = "MelinoeField_4119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya Amulet Gorgon miliknya. Mungkin agak lancang, tapi dengan ini, dia bisa mendadak muncul dan menimpa musuh malang mana pun yang sedang kuhadapi saat itu."
      Speaker = "Melinoe"
      Event = "ArtemisAboutAthena01"
    }
    {
      Id = "Artemis_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, benar juga. Dia {#Emph}memang {#Prev}suka kemunculan yang dramatis, dan mungkin tidak keberatan memamerkan sedikit kekuatannya di sana-sini. Nah, ini ada {#Emph}sedikit petunjuk {#Prev}lain untukmu."
      Speaker = "Artemis"
      Event = "ArtemisAboutAthena01"
    }
    {
      Id = "Artemis_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil mengalahkan Saudari Hecate! Dia sendiri yang memberitahuku, dan berani kukatakan, ada nada bangga di suaranya. Tapi, apa dia masih berniat mengujimu?"
      Speaker = "Artemis"
      Event = "ArtemisAboutHecate01"
    }
    {
      Id = "Melinoe_1192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia selalu bilang aku tak bisa mengalahkan Chronos jika tak bisa mengalahkannya. Karena itulah kami bertarung latih tanding. Kurasa dia mengalah padaku, sekadar untuk mendongkrak rasa percaya diriku."
      Speaker = "Melinoe"
      Event = "ArtemisAboutHecate01"
    }
    {
      Id = "Artemis_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, jelas sekali dia gagal. {#Emph}Mengalah? {#Prev}Kalau ada satu hal yang tak pernah dilakukan Penyihir Crossroads seumur hidupnya, itu adalah mengalah."
      Speaker = "Artemis"
      Event = "ArtemisAboutHecate01"
    }
    {
      Id = "Artemis_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sering mengandalkan cahaya Saudari Selene untuk memanduku saat berburu. Namun ke tempat tujuanmu nanti, dia tak bisa ikut, kan? Begitu pula diriku."
      Speaker = "Artemis"
      Event = "ArtemisAboutSelene01"
    }
    {
      Id = "Melinoe_1184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan Kepala Sekolah Hecate dibutuhkan di Crossroads. Hanya aku yang memiliki wewenang untuk memasuki Kediaman Hades. Itu pun jika aku bisa sampai ke sana."
      Speaker = "Melinoe"
      Event = "ArtemisAboutSelene01"
    }
    {
      Id = "Artemis_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, apa maksudmu {#Emph}jika? {#Prev}Bagiku, ini cuma masalah {#Emph}kapan{#Prev}. Malahan kupikir bakal sangat {#Emph}segera{#Prev}."
      Speaker = "Artemis"
      Event = "ArtemisAboutSelene01"
    }
    {
      Id = "Artemis_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sering mengandalkan cahaya Saudari Selene untuk memanduku saat berburu. Namun ke tempat tujuanmu nanti, dia tak bisa menyusul dengan mudah, kan? Begitu pula diriku."
      Speaker = "Artemis"
      Event = "ArtemisAboutSelene01_B"
    }
    {
      Id = "MelinoeField_2138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari Selene punya caranya sendiri, meski kutahu itu sulit baginya, dan Kepala Sekolah dibutuhkan di Crossroads. Hanya aku yang memiliki wewenang untuk memasuki Kediaman Hades. Namun aku takkan pernah sampai sejauh ini tanpa kalian semua."
      Speaker = "Melinoe"
      Event = "ArtemisAboutSelene01_B"
    }
    {
      Id = "Artemis_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Padahal kita {#Emph}benar-benar {#Prev}butuh rombongan berburu yang kompak untuk yang satu ini! Untungnya, sudah jadi ciri khas kita para Saudari Perak untuk tidak harus selalu berada di tempat yang sama pada waktu yang sama."
      Speaker = "Artemis"
      Event = "ArtemisAboutSelene01_B"
    }
    {
      Id = "Artemis_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hermes akhirnya berhasil menemuimu, ya? Kedengarannya situasi di Olympus benar-benar memburuk. Untunglah aku tidak ada di sana!"
      Speaker = "Artemis"
      Event = "ArtemisAboutHermes01"
    }
    {
      Id = "Melinoe_1185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artemis, bagaimana bisa kau berkata begitu? Itu rumahmu. Aku berniat melihat apakah aku bisa naik ke sana dan mengulurkan bantuan."
      Speaker = "Melinoe"
      Event = "ArtemisAboutHermes01"
    }
    {
      Id = "Artemis_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa itu memungkinkan bagimu, yang lahir di Underworld dan segalanya? Tapi lagi-lagi, kau kan seorang {#Emph}penyihir! {#Prev}Pasti punya ramuan penangkal untuk segalanya!"
      Speaker = "Artemis"
      Event = "ArtemisAboutHermes01"
    }
    {
      Id = "MelinoeField_2141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak melihat Nemesis malam ini, kan? Bukannya dia seharusnya berkeliaran di dekat sini, melainkan menjaga gerbang-gerbang di Crossroads."
      Speaker = "Melinoe"
      Event = "ArtemisAboutNemesis01"
    }
    {
      Id = "Artemis_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak melihatnya, tidak. Tapi aku sempat melacak jejaknya! Jejak kaki itu hanya sedikit lebih sulit dikenali dibanding {#Emph}dirinya{#Prev}. Dia tidak seharusnya berada di luar sini, kan..."
      Speaker = "Artemis"
      Event = "ArtemisAboutNemesis01"
    }
    {
      Id = "MelinoeField_2142"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Memang tidak seharusnya. Dia hanya berusaha membuat dirinya berguna, aku paham. Dan Tiga Takdir tahu kalau aku mungkin butuh bantuan. Tapi, bagaimana kabar kalian berdua?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutNemesis01"
    }
    {
      Id = "Artemis_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami sama-sama butuh ditemani, kami sama-sama butuh kesendirian, ya masalah klise yang itu-itu lagi. Dia sedang frustrasi, yang dampaknya bisa ke mana-mana tergantung malamnya. Sudahlah, dia kan sudah dewasa!"
      Speaker = "Artemis"
      Event = "ArtemisAboutNemesis01"
    }
    {
      Id = "MelinoeField_3371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei Artemis, andai Nemesis dan aku... andai kami menjadi lebih dekat, apa itu tidak masalah? Maksudku, bagimu {#Emph}sendiri. {#Prev}Karena kalau tidak, katakan saja. Lagipula ini mungkin takkan berlanjut ke mana-mana..."
      Speaker = "Melinoe"
      Event = "ArtemisAboutNemesis02"
    }
    {
      Id = "Artemis_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memangnya aku ini siapa, Saudari Hecate? Kau tidak butuh izinku, bukan berarti Nemesis itu milikku—meski aku pernah mempertimbangkan untuk memasang jebakan padanya. Tapi serius, semoga sukses menaklukkan yang satu itu."
      Speaker = "Artemis"
      Event = "ArtemisAboutNemesis02"
    }
    {
      Id = "Artemis_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi bagaimana kabar Nemesis, dia baik-baik saja? Sepertinya dia akhirnya berhasil melangkah lebih jauh dalam upaya keras kepalanya."
      Speaker = "Artemis"
      Event = "ArtemisAboutNemesis03"
    }
    {
      Id = "MelinoeField_4116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, dia baik-baik saja, untuk ukuran dirinya. Kami lebih sering bertemu, dan... rasanya menyenangkan. Menyenangkan sejauh yang bisa dia izinkan."
      Speaker = "Melinoe"
      Event = "ArtemisAboutNemesis03"
    }
    {
      Id = "Artemis_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah kalau begitu! Dia memang tampak melangkah sedikit lebih ringan, tapi tentu saja tidak {#Emph}terlalu {#Prev}ringan. Kapan-kapan kau harus menceritakan padaku bagaimana caramu menembus pertahanannya."
      Speaker = "Artemis"
      Event = "ArtemisAboutNemesis03"
    }
    {
      Id = "Artemis_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, apa benar Moros sendiri mendatangi Crossroads karena kau yang {#Emph}memanggilnya? {#Prev}Maksudku, kau secara harfiah {#Emph}mengundang Sang Petaka...?"
      Speaker = "Artemis"
      Event = "ArtemisAboutMoros01"
    }
    {
      Id = "MelinoeField_2019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya memang bukan tindakan paling bijak jika kau mengatakannya seperti itu. Chronos dulu pernah ditumbangkan oleh ramalan Tiga Takdir. Kurasakan mereka mungkin bersedia untuk turun tangan lagi."
      Speaker = "Melinoe"
      Event = "ArtemisAboutMoros01"
    }
    {
      Id = "Artemis_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan mereka melakukannya dengan mengirimkan perwujudan kemalangan dan konsekuensi tak terduga kepadamu. Yah, jika itu yang disiapkan oleh Takdir, kau bakal butuh {#Emph}ini."
      Speaker = "Artemis"
      Event = "ArtemisAboutMoros01"
    }
    {
      Id = "Artemis_0376"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, apa kau {#Emph}benar-benar {#Prev}paham erangan yang diucapkan Charon, atau itu cuma akting belaka... mirip cara hewan membesarkan tubuh mereka sebagai bentuk pertahanan diri?"
      Speaker = "Artemis"
      Event = "ArtemisAboutCharon01"
    }
    {
      Id = "MelinoeField_3370"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Artemis! {#Prev}Aku memang tak bisa membedah setiap suku katanya, tapi Charon sudah menghabiskan banyak sekali waktu bersama arwah orang mati. Rasanya tak jauh berbeda dari itu. {#Emph}Kau {#Prev}bahkan bisa berkomunikasi dengan {#Emph}binatang!"
      Speaker = "Melinoe"
      Event = "ArtemisAboutCharon01"
    }
    {
      Id = "Artemis_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa begitu, cuma saja... binatang biasanya tidak banyak bicara! Kecuali kucing. Lagipula, si tukang perahu mungkin bisa jadi teman ngobrol yang lebih baik daripada beberapa dewa yang kukenal."
      Speaker = "Artemis"
      Event = "ArtemisAboutCharon01"
    }
    {
      Id = "Artemis_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sungkan menanyakannya, tapi... apa kau kebetulan menemukan jejak Zagreus sewaktu berada di Kediaman ayahmu?"
      Speaker = "Artemis"
      Event = "ArtemisAboutZagreus01"
    }
    {
      Id = "MelinoeField_3369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artemis, rasanya... sulit kukatakan. Kakakku memang tidak ada di sana, tapi... aku merasakan kehadirannya; ikatan batin kami. Dia belum tiada."
      Speaker = "Melinoe"
      Event = "ArtemisAboutZagreus01"
    }
    {
      Id = "Artemis_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa itu sudah cukup melegakan bagiku untuk saat ini. Walaupun jawabannya jauh lebih {#Emph}teka-teki {#Prev}dari yang kuharapkan! Ya sudahlah, di mana pun dia berada... kuharap dia baik-baik saja. Dan tidak sendirian."
      Speaker = "Artemis"
      Event = "ArtemisAboutZagreus01"
    }
    {
      Id = "Artemis_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kabar burung soal Tiga Takdir itu benar, kalau Chronos entah bagaimana berhasil menangkap mereka? Dia tampaknya tak mau lagi menanggung risiko apa pun. Apa Tiga Takdir meramalkan penawanan mereka sendiri...?"
      Speaker = "Artemis"
      Event = "ArtemisAboutFates01"
    }
    {
      Id = "MelinoeField_2139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau sesantai ini menghadapinya? Kalau Tiga Takdir saja tak sanggup menghentikan Chronos, urusan kita jelas takkan mudah! Nasib kita pun kini bergantung pada peruntungan."
      Speaker = "Melinoe"
      Event = "ArtemisAboutFates01"
    }
    {
      Id = "Artemis_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lantas kenapa kalau memang begitu?! Kau tahu sendiri, bahkan {#Emph}aku {#Prev}pun tak selalu mengenai sasaran. Apa yang kulakukan kalau tembakanku meleset? {#Emph}Aku membidik lagi. {#Prev}Makin terampil dirimu, makin sedikit hal yang diserahkan pada keberuntungan."
      Speaker = "Artemis"
      Event = "ArtemisAboutFates01"
    }
    {
      Id = "Artemis_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aneh rasanya, bukan? Dia itu kakek kandung kita sendiri... Chronos, maksudku. Tapi, aku sama sekali tak merasakan ikatan darah dengannya! Aku cuma ingin dia lenyap."
      Speaker = "Artemis"
      Event = "ArtemisAboutChronos01"
    }
    {
      Id = "Melinoe_1191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak peduli siapa dia sebenarnya; dia adalah ancaman. Kita berdua adalah Saudari Rembulan. Kita akan {#Emph}membuatnya {#Prev}lenyap. Demi keselamatan segenap alam."
      Speaker = "Melinoe"
      Event = "ArtemisAboutChronos01"
    }
    {
      Id = "Artemis_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi ini murni urusan tugas, ya? Tetap saja, lucu rasanya saat giliran {#Emph}kita {#Prev}yang harus melunasi dendam generasi terdahulu."
      Speaker = "Artemis"
      Event = "ArtemisAboutChronos01"
    }
    {
      Id = "Artemis_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau berhasil menembus sampai ke Kediaman Hades. Pasti menyenangkan punya takdir kekuasaan atas bagian terdalam Dunia Bawah... kecuali kalau kau Chronos."
      Speaker = "Artemis"
      Event = "ArtemisAboutChronosBossL01"
    }
    {
      Id = "MelinoeField_2136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia jelas sangat murka. Mengayunkan sabit yang tingginya dua kali lipat diriku, dikelilingi para Satir liar pemujanya yang siap mati demi dia. Aku tak heran kalau dulu butuh gabungan kekuatan kedua ayah kita dan dewa-dewa lainnya demi menumbangkannya."
      Speaker = "Melinoe"
      Event = "ArtemisAboutChronosBossL01"
    }
    {
      Id = "Artemis_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada gunanya membandingkan dirimu dengan mereka. Mereka memang penguasa langit dan Dunia Bawah yang agung nan perkasa, tapi mereka melawan Chronos karena terpaksa. Sedangkan kau dilatih {#Emph}khusus untuk tugas ini."
      Speaker = "Artemis"
      Event = "ArtemisAboutChronosBossL01"
    }
    {
      Id = "Artemis_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menemukan Chronos... dan menancapkan taringmu tepat di lehernya. Saudari Hecate sudah menceritakan intinya kepadaku. Bagaimana caramu melakukannya...? Menemukan celah kelemahan yang bisa dimanfaatkan, atau semacamnya?"
      Speaker = "Artemis"
      Event = "ArtemisAboutChronosBossW01"
    }
    {
      Id = "MelinoeField_2137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian besar waktuku cuma dihabiskan untuk terus menghindar. Dia luar biasa kuat, tapi pasti sempat meremehkan kemampuanku menangkal tipu dayanya."
      Speaker = "Melinoe"
      Event = "ArtemisAboutChronosBossW01"
    }
    {
      Id = "Artemis_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi dia takkan selamanya meremehkanmu. Dia pasti punya kelemahan. {#Emph}Orang tua jarang ada yang bijak, dan sering kali rapuh{#Prev}, benar begitu, kan? Dia sudah terluka... lekas habisi nyawanya."
      Speaker = "Artemis"
      Event = "ArtemisAboutChronosBossW01"
    }
    {
      Id = "Artemis_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah makin dekat, kan? Untuk menumbangkan Chronos selamanya. Aku tahu kau tak boleh membocorkan rincian rencanamu bahkan kepadaku, tapi... kau pasti akan memberitahuku kalau tebakanku keliru."
      Speaker = "Artemis"
      Event = "ArtemisAboutChronosBossW02"
    }
    {
      Id = "MelinoeField_4111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, aku pasti akan memberitahumu. Nah, sebenarnya aku enggan menyudahi pertemuan kita secepat ini, tapi ada urusan mendesak yang mesti kuselesaikan."
      Speaker = "Melinoe"
      Event = "ArtemisAboutChronosBossW02"
    }
    {
      Id = "Artemis_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, lekaslah selesaikan. Melangkahlah tanpa suara, dan bidiklah tepat pada sasaran, Saudari."
      Speaker = "Artemis"
      Event = "ArtemisAboutChronosBossW02"
    }
    {
      Id = "Artemis_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sempat melihat Heracles berkeliaran dengan langkah beratnya? Meski biasanya aku tipe yang mudah percaya orang, aku agak ragu soal yang satu itu. Dia sudah lama masuk daftar hitamku. Perilakunya kelewat kasar terhadap satwa."
      Speaker = "Artemis"
      Event = "ArtemisAboutHeracles01"
    }
    {
      Id = "MelinoeField_4110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artemis, kau ini dewi {#Emph}perburuan. {#Prev}Satwa-satwa itu pastinya jauh lebih takut padamu daripada dia."
      Speaker = "Melinoe"
      Event = "ArtemisAboutHeracles01"
    }
    {
      Id = "Artemis_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah, jangan mulai lagi mendebat soal itu, Saudari. Satwa-satwa itu {#Emph}memujaku{#Prev}, kecuali saat ajal mereka tiba. Sedangkan Heracles memburu mereka seenak jidat kapan pun dia mau. Pokoknya hati-hatilah di dekatnya, paham?"
      Speaker = "Artemis"
      Event = "ArtemisAboutHeracles01"
    }
    {
      Id = "Artemis_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah tahu kalau lawan kita sekarang Prometheus? Kemampuannya adalah meramalkan apa pun yang bakal terjadi... kurasa itu yang membuatnya jadi sosok yang sangat sukar ditangkap."
      Speaker = "Artemis"
      Event = "ArtemisAboutPrometheus01"
    }
    {
      Id = "MelinoeField_2449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan Sang Pandangan Masa Depan, bertarung demi Titan Waktu... atau barangkali semata-mata demi membalas dendam pada dewa-dewi yang menghukumnya. Dia mungkin punya alasannya sendiri, tapi dia menghalangi jalanku."
      Speaker = "Melinoe"
      Event = "ArtemisAboutPrometheus01"
    }
    {
      Id = "Artemis_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham betul maksudmu. Walau kalau dia memang benar-benar bisa melihat masa depan, bukankah seharusnya dia memihak kubu pemenang...? Hati-hati menghadapinya, Saudari..."
      Speaker = "Artemis"
      Event = "ArtemisAboutPrometheus01"
    }
    {
      Id = "Artemis_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu kerugian karena aku berada sejauh ini adalah aku tak bisa menghunjamkan anak panah menembus tubuh Prometheus dari jarak sekian. Apollo bilang dia benar-benar bikin susah."
      Speaker = "Artemis"
      Event = "ArtemisAboutPrometheus02"
    }
    {
      Id = "MelinoeField_3365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia memang masalah besar dan ancaman nyata... meski tanpa senjata, dan kelihatannya belum kembali ke kekuatan puncaknya karena masih menanggung luka-luka lama. Namun amarahnya lebih dari cukup untuk menutupi semua itu."
      Speaker = "Melinoe"
      Event = "ArtemisAboutPrometheus02"
    }
    {
      Id = "Artemis_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah, Titan pemarah lainnya. Yah, kalau dia terus-menerus {#Emph}naik pitam{#Prev}, dia pasti bakal bikin blunder. Ini bukan pertama kalinya."
      Speaker = "Artemis"
      Event = "ArtemisAboutPrometheus02"
    }
    {
      Id = "MelinoeField_3366"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak sungguh-sungguh percaya kalau Prometheus bisa melihat masa depan, kan? Dia mungkin cuma punya insting berburu yang teramat tajam sepertimu."
      Speaker = "Melinoe"
      Event = "ArtemisAboutPrometheus03"
    }
    {
      Id = "Artemis_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa katamu? {#Prev}Tak ada seorang pun yang punya insting setajam {#Emph}milikku{#Prev}, Saudari! Tapi aku tak pernah mengklaim tahu {#Emph}secara persis {#Prev}apa yang bakal terjadi. Lagi pula kalaupun aku bisa meramal, kurasa aku bakal merindukan sensasi rasa penasarannya."
      Speaker = "Artemis"
      Event = "ArtemisAboutPrometheus03"
    }
    {
      Id = "Artemis_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kita punya masalah yang jauh lebih gawat di Olympus dari perkiraan semula. Ketakutan terburuk kita menjadi kenyataan, atau apalah itu. Padahal kupikir aku sanggup melacak mangsa sebesar ukuran Typhon..."
      Speaker = "Artemis"
      Event = "ArtemisAboutTyphon01"
    }
    {
      Id = "MelinoeField_3367"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fokusmu sedang melacak Chronos... atau mungkin diriku. Tapi kalau ini bisa sedikit menghiburmu, menemukan Typhon seharusnya teramat mudah sekarang! Menumbangkannya... nah, itu yang sulit."
      Speaker = "Melinoe"
      Event = "ArtemisAboutTyphon01"
    }
    {
      Id = "Artemis_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan kupegang kata-katamu. Ayahku terlalu gengsi untuk memanggilku pulang demi membantu pertahanan kita. Katanya aku masih dibutuhkan di sini. Kalau dia sebegitu ngebetnya ingin menghadapi Typhon sendirian, silakan saja ambil jatahnya."
      Speaker = "Artemis"
      Event = "ArtemisAboutTyphon01"
    }
    {
      Id = "Artemis_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olympus berhasil menumbangkan Typhon...? Kuduga pasti berkat bantuan{#Emph}mu{#Prev}, dan mungkin Saudari Selene juga. Sepertinya keberadaanku di atas sana memang tak terlalu dibutuhkan."
      Speaker = "Artemis"
      Event = "ArtemisAboutTyphon02"
    }
    {
      Id = "MelinoeField_3368"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami cuma berhasil memukul mundur monster itu, tapi kurasa kami belum benar-benar membuatnya jera. Setidaknya belum untuk sekarang. Walau aku punya beberapa siasat..."
      Speaker = "Melinoe"
      Event = "ArtemisAboutTyphon02"
    }
    {
      Id = "Artemis_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau siasatmu melibatkan sebutir {#Emph}anak panah {#Prev}yang menancap di matanya—yang kudengar jumlahnya {#Emph}banyak sekali{#Prev}—kabari saja aku... semoga cahaya rembulan memandu kepulanganmu malam ini."
      Speaker = "Artemis"
      Event = "ArtemisAboutTyphon02"
    }
    {
      Id = "Artemis_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berniat berterima kasih padamu, karena hutan dan pegunungan kami tak lagi terancam hancur diinjak kaki monster atau tentakel-tentakel melata itu. Rasanya benar-benar melegakan."
      Speaker = "Artemis"
      Event = "ArtemisAboutTyphon03"
    }
    {
      Id = "MelinoeField_4114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, sama-sama. Aku juga tak sudi diinjak-injak seperti itu. Kedengarannya Baginda Zeus dan Ratu Hera punya rencana darurat yang untungnya berhasil dihindari."
      Speaker = "Melinoe"
      Event = "ArtemisAboutTyphon03"
    }
    {
      Id = "Artemis_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hutan dan pegunungan kami pasti akan bernasib jauh lebih {#Emph}buruk {#Prev}kalau rencana itu terjadi. Caramu sempat membuat Ayah dan Ibu Tiri agak gentar... kekuatan yang bisa membinasakan kaum abadi dan semacamnya? Tapi ada bagusnya mereka menghormatimu. Begitulah caranya membuat mereka bersikap manis!"
      Speaker = "Artemis"
      Event = "ArtemisAboutTyphon03"
    }
    {
      Id = "MelinoeField_2131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagipula, kenapa Olimpus mengutusmu jauh-jauh ke sini? Kupikir kau sudah kembali sekarang. Kau selalu disambut di Persimpangan, lho!"
      Speaker = "Melinoe"
      Event = "ArtemisAboutMission01"
    }
    {
      Id = "Artemis_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Saudari, dan aku memang harus segera melapor balik. Soal kenapa aku jauh-jauh ke sini, sebagian besar ya untuk memata-mataimu! Olimpus selalu ingin tahu segalanya."
      Speaker = "Artemis"
      Event = "ArtemisAboutMission01"
    }
    {
      Id = "MelinoeField_2132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga mereka begitu. Kau pernah keceplosan di depan mereka? Sekarang ini para dewa lain pasti mulai menaruh curiga padamu dan Hermes."
      Speaker = "Melinoe"
      Event = "ArtemisAboutMission01"
    }
    {
      Id = "Artemis_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tergantung dewa mana yang kau bicarakan, tapi kebanyakan dari mereka cuma menganggap kami masih muda dan suka semaunya sendiri. Padahal cuma kami yang paling bisa diandalkan."
      Speaker = "Artemis"
      Event = "ArtemisAboutMission01"
    }
    {
      Id = "Artemis_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu aku bergabung dengan Para Saudari Perak, kukira tugas kita cuma mengintai dalam bayang-bayang, sesekali memberi laporan... tapi ini benar-benar {#Emph}skenario terburuk {#Prev}yang jadi nyata!"
      Speaker = "Artemis"
      Event = "ArtemisAboutSilverSisters01"
    }
    {
      Id = "MelinoeField_2133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terdengar bersemangat alih-alih cemas. Kau pasti tahu hal ini cepat atau lambat bakal terjadi. Tak mungkin Kepala Sekolah menyatukan kita hanya demi seremonial belaka."
      Speaker = "Melinoe"
      Event = "ArtemisAboutSilverSisters01"
    }
    {
      Id = "Artemis_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, kurasa kau benar. Tetap saja, kita sudah bersama sekian lama menanti waktu yang tepat... sampai-sampai kupikir kita takkan pernah dapat kesempatan untuk menyerang. Namun di sinilah kita sekarang!"
      Speaker = "Artemis"
      Event = "ArtemisAboutSilverSisters01"
    }
    {
      Id = "Artemis_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kau punya teman hewan sekarang! Teman-temanku pasti juga ikut denganku, andai saja mereka tak menolak menginjakkan kaki di Dunia Bawah selagi masih bernapas... kecuali burung-burung ini, yang tampaknya masa bodoh."
      Speaker = "Artemis"
      Event = "ArtemisAboutFamiliars01"
    }
    {
      Id = "MelinoeField_3328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kurasa mereka punya alasan lain di Ephyra? Sahabat macam apa mereka, membiarkanmu berjuang sendirian di sini."
      Speaker = "Melinoe"
      Event = "ArtemisAboutFamiliars01"
    }
    {
      Id = "Artemis_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Mereka mirip dengan kita kok, cuma biasanya lebih pendiam saja. Rawat baik-baik temanmu itu untukku, ya?"
      Speaker = "Artemis"
      Event = "ArtemisAboutFamiliars01"
    }
    {
      Id = "Artemis_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang rasanya bisa berada di Persimpangan tadi. Bidikanku makin mantap, saraf-sarafku tenang kembali. Aku tak pernah bisa merasakan ketenangan sejati di rumah... tapi rasa damai itu bisa ditemukan di hutan."
      Speaker = "Artemis"
      Event = "ArtemisAboutSinging01"
    }
    {
      Id = "MelinoeField_3362"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa di rumah juga tak ada tempat untuk berlatih menyanyi. Apakah sebegitu khawatirnya jika Apollo sampai mendengar? Dia tak mungkin {#Emph}sehebat {#Prev}itu! Dan dia mungkin justru bangga padamu."
      Speaker = "Melinoe"
      Event = "ArtemisAboutSinging01"
    }
    {
      Id = "Artemis_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atau dia malah akan mengejekku habis-habisan... Ujung-ujungnya aku pasti menembakkan panah menembus tubuhnya dan kena masalah besar. Aku belum siap mengambil risiko semacam itu, Saudari."
      Speaker = "Artemis"
      Event = "ArtemisAboutSinging01"
    }
    {
      Id = "MelinoeField_5293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau selalu bisa bernyanyi di rumah, kan? Suaramu setidaknya sudah sehebat Apollo sekarang. Dia pasti senang jika kau mengiringinya di Istana, aku yakin!"
      Speaker = "Melinoe"
      Event = "ArtemisAboutSinging01_B"
    }
    {
      Id = "Artemis_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah mencoba semua Berkah terbaruku sampai saat ini. Ada beberapa lagi yang sedang kupikirkan, walau akhir-akhir ini tak ada yang pas! Kemungkinan besar kau lebih memilih sesuatu yang sudah terbukti ampuh."
      Speaker = "Artemis"
      Event = "ArtemisAboutBoons01"
    }
    {
      Id = "MelinoeField_3329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Darimu, Saudari, apa pun akan kuterima! Sedikit ketepatan ekstra dalam seranganku sering kali menjadi penentu segalanya."
      Speaker = "Melinoe"
      Event = "ArtemisAboutBoons01"
    }
    {
      Id = "Artemis_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku ini bukan cuma soal {#Emph}ketepatan {#Prev}saja, kan? Kami para dewa selalu dicap dengan satu hal lalu selesai. Ayah Zeus dengan petirnya, Paman Poseidon dengan airnya, Apollo dan... {#Emph}rambutnya."
      Speaker = "Artemis"
      Event = "ArtemisAboutBoons01"
    }
    {
      Id = "Melinoe_1186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah begitu jauh dari rumah sekian lama. Tidakkah kau rindu berada di Olimpus? Kalau bukan sekarang, mungkin... dulu sebelum pengepungan sang Titan?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutFamily01"
    }
    {
      Id = "Artemis_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, maksudmu bersama ayah dan ibu tiriku, saudara kembar sempurnaku, dan yang lainnya itu? Hanya karena aku bersedia membantu mereka, bukan berarti aku sudi tinggal bersama mereka lagi."
      Speaker = "Artemis"
      Event = "ArtemisAboutFamily01"
    }
    {
      Id = "Artemis_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, apa pendapatmu tentang keluarga itu? Sebagian besar dari mereka terjebak di puncak gunung, walau... kau sudah tahu seperti apa sifat mereka."
      Speaker = "Artemis"
      Event = "ArtemisAboutFamily02"
    }
    {
      Id = "Melinoe_2340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, mereka tidak seburuk itu kelihatannya! Terutama dengan keadaan seperti sekarang. Tapi kau sama sekali tak tahan dengan mereka..."
      Speaker = "Melinoe"
      Event = "ArtemisAboutFamily02"
    }
    {
      Id = "Artemis_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku takkan bertindak {#Emph}sejauh {#Prev}itu! Walau, ya, mereka memang suka bikin jengkel. Mereka bakal berutang {#Emph}banyak {#Prev}pada kita begitu semua ini selesai."
      Speaker = "Artemis"
      Event = "ArtemisAboutFamily02"
    }
    {
      Id = "Melinoe_1189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi saat kau tidak sedang membantuku dalam kegagalanku yang berulang kali ini, apa lagi yang kau lakukan, Artemis? Ada buruan istimewa yang sedang kau incar?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutMission02"
    }
    {
      Id = "Artemis_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin ada. Olimpus sedang berguncang hebat, karena alasan yang tak diketahui. Saudari Selene memintaku untuk menyelidikinya. Pasti bukan hal yang gawat, kan?"
      Speaker = "Artemis"
      Event = "ArtemisAboutMission02"
    }
    {
      Id = "Artemis_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Orang-orang malang, dibiarkan terlunta-lunta di sini. Padahal mereka bisa bersantai di Elysium, atau setidaknya di Asphodel. Tak heran mereka begitu geram."
      Speaker = "Artemis"
      Event = "ArtemisAboutErebus01"
    }
    {
      Id = "MelinoeField_2134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos mengklaim itu adalah tindakan kemurahan hati—membuka segel gerbang Dunia Bawah, membiarkan orang mati berkeliaran bebas. Ini jelas tidak lebih baik daripada saat ayahku yang memerintah."
      Speaker = "Melinoe"
      Event = "ArtemisAboutErebus01"
    }
    {
      Id = "Artemis_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, setidaknya itu berarti aku bisa menginjakkan kaki di tempat-tempat ini tanpa memicu perselisihan wilayah yang besar! Mengesampingkan fakta bahwa kita memang sudah berada di tengah-tengah perselisihan."
      Speaker = "Artemis"
      Event = "ArtemisAboutErebus01"
    }
    {
      Id = "Artemis_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kacau-balau sekali ulah kita! Tak banyak tempat bersembunyi di sini dibanding di Erebus. Mungkin ini batas perjalananku... Aku ini pemburu, bukan nelayan."
      Speaker = "Artemis"
      Event = "ArtemisAboutOceanus01"
    }
    {
      Id = "MelinoeField_2140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memancing itu salah satu bentuk berburu juga, kan? Bagaimanapun, aku menghargai bantuanmu, dan mengerti jika kau sudah mencapai batas jangkauanmu. Olimpus mungkin sudah menunggumu kembali."
      Speaker = "Melinoe"
      Event = "ArtemisAboutOceanus01"
    }
    {
      Id = "Artemis_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka pasti ingin mendengar kabar dariku! Tentang situasinya, dan tentang {#Emph}dirimu {#Prev}juga. Kau tahu mereka masih menganggapku dan Hermes sebagai mata-mata mereka? Walau, kami memang memberi tahu mereka banyak hal..."
      Speaker = "Artemis"
      Event = "ArtemisAboutOceanus01"
    }
    {
      Id = "Artemis_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil melangkah cukup jauh di permukaan baru-baru ini, kata Saudari Selene. Apakah tempat itu sesuai dengan semua harapan dan impianmu?"
      Speaker = "Artemis"
      Event = "ArtemisAboutSurface01"
    }
    {
      Id = "Melinoe_2339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cenderung sering mengalami mimpi buruk, dan tempat itu benar-benar mewujudkannya. Orang-orang mati dibiarkan terlunta-lunta di sana. Mereka seharusnya aman di Dunia Bawah!"
      Speaker = "Melinoe"
      Event = "ArtemisAboutSurface01"
    }
    {
      Id = "Artemis_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, Chronos rupanya punya pandangan lain soal bagaimana segala sesuatunya harus diatur. Aku tahu tujuan utamamu ada di bawah sana, tapi... terima kasih atas bantuan apa pun yang bisa kau berikan di atas permukaan."
      Speaker = "Artemis"
      Event = "ArtemisAboutSurface01"
    }
    {
      Id = "Artemis_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah sejauh ini berkunjung ke permukaan, ya? Tapi aku sama sekali tak melihat batang hidungmu di sana! Jangan berkecil hati. Di sini hutannya juga lumayan asri, kok!"
      Speaker = "Artemis"
      Event = "ArtemisAboutSurfacePenalty01"
    }
    {
      Id = "MelinoeField_2135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak seharusnya berada di atas sana... nyaris tak bisa bernapas. Tapi mungkin ada sesuatu yang bisa kulakukan. Hermes takkan memintaku pergi kalau itu tidak penting."
      Speaker = "Melinoe"
      Event = "ArtemisAboutSurfacePenalty01"
    }
    {
      Id = "Artemis_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, kurasa begitu. Tadinya mau kutawari kawalan, tapi Olympus menyuruhku untuk tetap bersembunyi. Dan aku takkan repot-repot menyuruhmu agar jangan memforsir diri..."
      Speaker = "Artemis"
      Event = "ArtemisAboutSurfacePenalty01"
    }
    {
      Id = "Artemis_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihatlah dirimu, {#Emph}Saudari!{#Prev} Kakakmu dulu sempat meyakinkan kami semua bahwa dia berniat menerobos jalan ke Olympus. Sekarang tak satu pun dari kami menyangka kau benar-benar sedang melakukannya secara nyata."
      Speaker = "Artemis"
      Event = "ArtemisAboutEphyra01"
    }
    {
      Id = "MelinoeField_2020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah kenal Hermes hampir selama dirimu, dan jumlah permintaannya padaku bisa dihitung jari. Lagipula, aku memang butuh penyegaran suasana."
      Speaker = "Melinoe"
      Event = "ArtemisAboutEphyra01"
    }
    {
      Id = "Artemis_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, lakukanlah! Pas sekali momennya, kau sedang dalam perjalanan mendaki gunung sementara aku justru turun ke Dunia Bawah. Setidaknya jalan kita sempat berpapasan!"
      Speaker = "Artemis"
      Event = "ArtemisAboutEphyra01"
    }
    {
      Id = "MelinoeField_2020_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hermes takkan memintaku pergi kalau itu tidak penting. Lagipula, aku memang butuh penyegaran suasana."
      Speaker = "Melinoe"
      Event = "ArtemisAboutEphyra01_B"
    }
    {
      Id = "Artemis_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Polyphemus si Cyclops raksasa itu... kulihat dia tertidur lelap tempo hari! Lalu {#Emph}kau{#Prev} berhasil menyelinap dan melumpuhkannya, begitu {#Emph}saja!{#Prev} Kalau aku sendiri sih, selalu menjaga jarak searah angin darinya."
      Speaker = "Artemis"
      Event = "ArtemisAboutPolyphemus01"
    }
    {
      Id = "MelinoeField_2145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya ingin tersenyum dan mengangguk saja kali ini, Artemis, tapi urusanku dengan si Cyclops tak melibatkan banyak unsur diam-diam. Yah, setidaknya aku sudah bisa melewatinya sekarang."
      Speaker = "Melinoe"
      Event = "ArtemisAboutPolyphemus01"
    }
    {
      Id = "Artemis_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu bagaimana caramu melintasi Celah di seberang dermaga, kau {#Emph}berenang?{#Prev} Kau memang selalu suka memilih jalan yang sulit. Satu-{#Emph}satunya{#Prev} jalan!"
      Speaker = "Artemis"
      Event = "ArtemisAboutPolyphemus01"
    }
    {
      Id = "Artemis_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti tahu {#Emph}Eris{#Prev} akhir-akhir ini suka berkeliaran di sekitar Olympus? Biasanya satu sambaran petir bagus dari Ayahanda Zeus sudah cukup untuk {#Emph}membereskannya{#Prev}, tapi... beliau sedang sibuk."
      Speaker = "Artemis"
      Event = "ArtemisAboutEris01"
    }
    {
      Id = "MelinoeField_2143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu sambaran petir bagus, atau bagaimana kalau satu bidikan panah jitu? Kita bakal terbebas dari banyak masalah kalau Eris dipanah jatuh dari langit suatu malam."
      Speaker = "Melinoe"
      Event = "ArtemisAboutEris01"
    }
    {
      Id = "Artemis_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku dengan senang hati mau mengajukan diri, hanya saja Ayah merasa segalanya {#Emph}terkendali dengan sangat baik. {#Prev}Katanya aku justru lebih dibutuhkan jauh di luar sini. Tapi kalau aku sampai melihat sayap Sang Perselisihan itu... dia pasti tumbang."
      Speaker = "Artemis"
      Event = "ArtemisAboutEris01"
    }
    {
      Id = "Artemis_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepasang belati milikmu itu berguna dengan baik? Beri tahu aku kalau kau butuh, {#Emph}ehem... arahan... tikaman...?{#Prev}"
      Speaker = "Artemis"
      Event = "ArtemisAboutDagger01"
    }
    {
      Id = "Melinoe_1190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bilah Persaudari ini hampir terasa seperti kehadiranmu di sampingku di setiap pertarungan. Walaupun, jangkauan panahmu jauh lebih jauh daripada lemparanku..."
      Speaker = "Melinoe"
      Event = "ArtemisAboutDagger01"
    }
    {
      Id = "Artemis_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, jangan terlalu merendah, panahanku memang lebih jauh daripada siapa pun! Terutama Apollo. Yah, terus incar saja titik vital mereka, dan kau akan baik-baik saja."
      Speaker = "Artemis"
      Event = "ArtemisAboutDagger01"
    }
    {
      Id = "Artemis_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku mengenali sepasang belati itu! Tadinya tak ingin kubocorkan, tapi... kurasa sekarang kau sudah tahu. Kau harus merawatnya baik-baik!"
      Speaker = "Artemis"
      Event = "ArtemisAboutArtemisAspect01"
    }
    {
      Id = "MelinoeField_2144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan khawatir. Aku merawatnya, sumpah! Jadi, dulunya {#Emph}kau{#Prev} sendiri pemegang Bilah Persaudari ini? Apa kau harus merelakannya demi aku...?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutArtemisAspect01"
    }
    {
      Id = "Artemis_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurelakan karena aku melakukan apa yang memang perlu dilakukan. Hecate suka sekali memberi ujian-ujian kecilnya. Bagaimanapun, aku senang melihat Lim dan Oros tua berada di tangan yang tepat."
      Speaker = "Artemis"
      Event = "ArtemisAboutArtemisAspect01"
    }
    {
      Id = "Artemis_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aneh rasanya... Aku bekerja begitu dekat dengan Saudari Selene, tapi aku tak pernah becus memakai Kutukan-kutukannya. Tidak seperti {#Emph}dirimu."
      Speaker = "Artemis"
      Event = "ArtemisGrantsReward01"
    }
    {
      Id = "MelinoeField_4117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku sangat payah dalam memanah, tidak seperti {#Emph}dirimu. {#Prev}Mungkin ini ulah Nemesis yang memastikan tak ada dari kita yang memiliki segalanya."
      Speaker = "Melinoe"
      Event = "ArtemisGrantsReward01"
    }
    {
      Id = "Artemis_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, sebentar lagi kau akan sedikit {#Emph}lebih dekat{#Prev} ke titik idaman itu. Ini, sedikit sihir Rembulan tambahan atas semua yang telah kau lakukan, dan yang masih berniat kau lakukan. Berjaga-jaga kalau kau membutuhkannya."
      Speaker = "Artemis"
      Event = "ArtemisGrantsReward01"
    }
    {
      Id = "Artemis_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita, Para Saudari Perak, adalah penjaga Senjata Malam. Belati Lim dan Oros melayani kehendak Malam di bawah perintahmu, tapi masih ada rahasia lain di dalamnya."
      Speaker = "Artemis"
      Event = "ArtemisGrantsHiddenAspect01"
    }
    {
      Id = "MelinoeField_3401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau serius? Aku mendengarkan. Apa yang kau ingin kulakukan?"
      Speaker = "Melinoe"
      Event = "ArtemisGrantsHiddenAspect01"
    }
    {
      Id = "Artemis_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di Kolam Perak, panggillah belati itu dengan ini: {#Emph}Kulihat bayang tiga rupamu bersama Sang Ratu Siluman. {#Prev}Kurasa kau sudah siap sekarang. Harusnya berhasil!"
      Speaker = "Artemis"
      Event = "ArtemisGrantsHiddenAspect01"
    }
    {
      Id = "MelinoeField_3402"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kulihat bayang tiga rupamu bersama Sang Ratu Siluman. {#Prev}Sebuah frasa pembangun... terima kasih atas kehormatan ini, Artemis. Rupa milik siapa ini, kau tahu?"
      Speaker = "Melinoe"
      Event = "ArtemisGrantsHiddenAspect01"
    }
    {
      Id = "Artemis_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, bukan siapa-siapa, hanya sesosok dewi bayangan bertiga rupa lainnya, mirip Saudari Hecate tapi dari zaman dan tempat yang berbeda. Sebaiknya tak kubocorkan lagi, nanti kau akan lihat sendiri."
      Speaker = "Artemis"
      Event = "ArtemisGrantsHiddenAspect01"
    }
    {
      Id = "Artemis_0255_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu Bilah Persaudari... kalau begitu, itu pasti Rupa sang Morrigan. Kelihatannya sangat cocok untukmu! Mungkin kita dewi Malam-Rembulan {#Emph}memang{#Prev} ditakdirkan serupa."
      Speaker = "Artemis"
      Event = "ArtemisAboutHiddenAspect01"
    }
    {
      Id = "MelinoeField_3497"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu, kau sendiri tak pernah menggunakan Rupa ini? Dari mana kau bisa tahu frasa pembangun yang kau bagikan itu?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutHiddenAspect01"
    }
    {
      Id = "Artemis_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terlalu banyak tanya, Melinoë, tapi jawabannya tidak. Rupa itu bukan untukku. Mungkin suatu malam nanti, kau juga akan mendapat kesempatan untuk meneruskan pengetahuan rahasia semacam ini!"
      Speaker = "Artemis"
      Event = "ArtemisAboutHiddenAspect01"
    }
    {
      Id = "Artemis_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, dulu aku pernah memberi Zagreus frasa pembangunnya {#Emph}sendiri{#Prev}, untuk Rupa tersembunyi dari busur bernama Coronacht, yang pernah digunakan Ibu Tiri. Dia cukup jago menggunakannya!"
      Speaker = "Artemis"
      Event = "ArtemisAboutHiddenAspect02"
    }
    {
      Id = "MelinoeField_4120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}benarkah? {#Prev}Dan apa lagi yang menurutmu dia lakukan lebih baik dariku, Artemis? Jelas pesonanya lebih memikat, tapi apakah dia bisa lari lebih kencang dariku juga?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutHiddenAspect02"
    }
    {
      Id = "Artemis_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, {#Emph}jauh{#Prev} lebih kencang. {#Emph}Pokoknya{#Prev}, intinya adalah, aku senang bisa melihat kalian berdua tumbuh menjadi kuat, dan telah mengambil bagianku untuk Senjata Neraka maupun Senjata Malam."
      Speaker = "Artemis"
      Event = "ArtemisAboutHiddenAspect02"
    }
    {
      Id = "Artemis_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membawa Tanduk Putih itu untuk berjaga-jaga! Rusa jantan yang merelakannya, memang sudah ajalnya saat itu. Dan aku berjanji padanya akan mengakhirinya dengan cepat. Bayangannya dan aku, kami masih sering bertukar kabar sesekali!"
      Speaker = "Artemis"
      Event = "ArtemisAboutKeepsake01"
    }
    {
      Id = "MelinoeField_2146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artemis, kisah-kisahmu punya kemampuan luar biasa untuk menghangatkan hati sekaligus mengusik pikiran. Siapa tahu suatu saat kau butuh panggilan hidup selain berburu."
      Speaker = "Melinoe"
      Event = "ArtemisAboutKeepsake01"
    }
    {
      Id = "Artemis_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau semua ini gagal, kupikir-pikir {#Emph}bernyanyi {#Prev}dan {#Emph}bermusik? {#Prev}Kalau Apollo bisa, {#Emph}aku {#Prev}juga bisa. Meski kita berdua belum bosan dengan kehidupan pemburu."
      Speaker = "Artemis"
      Event = "ArtemisAboutKeepsake01"
    }
    {
      Id = "Artemis_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihat Tanduk tua itu sangat membantumu. Terus gunakan {#Emph}benda {#Prev}itu dan kau bisa-bisa membangkitkan kembali rusa jantan pemilik aslinya! Atau bahkan menggantikan {#Emph}posisiku {#Prev}dalam berburu."
      Speaker = "Artemis"
      Event = "ArtemisAboutKeepsake02"
    }
    {
      Id = "MelinoeField_4109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku tak mau {#Emph}itu... {#Prev}aku cuma ingin bertekad bulat terus menghujam titik vital musuh-musuhku. Dan entah kenapa Tanduk Putihmu sangat membantu!"
      Speaker = "Melinoe"
      Event = "ArtemisAboutKeepsake02"
    }
    {
      Id = "Artemis_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Entah kenapa? {#Prev}{#Emph}Ikatan kita {#Prev}lah alasannya, dan Tanduk itu perantara kita. Hanya saja jangan kelewat batas. Aku membidik sebagian besar mangsa dari balik bayangan, tapi {#Emph}kau {#Prev}tidak sepemalu itu."
      Speaker = "Artemis"
      Event = "ArtemisAboutKeepsake02"
    }
    {
      Id = "Artemis_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada hawa {#Emph}dingin {#Prev}yang aneh malam ini. Aku hampir saja mandi {#Emph}keringat! {#Prev}Meski musuh-musuh kita juga ikut andil. Kurasa aku tahu apa yang terjadi, Melinoë, tapi sebenarnya ada apa {#Emph}gerangan?"
      Speaker = "Artemis"
      Event = "ArtemisAboutShrine01"
    }
    {
      Id = "MelinoeField_3363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wasiat Sang Malam penyebabnya. Rasa Takut dan Kegelapan menyebar... yang mungkin tampak tak langsung menguntungkan kita, tapi Senjata Nokturnal kian kuat karenanya; begitu pula alam ini."
      Speaker = "Melinoe"
      Event = "ArtemisAboutShrine01"
    }
    {
      Id = "Artemis_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu! {#Emph}Dalam bayangan kita mengabdi; ke dalam bayangan kita kembali. {#Prev}Olimpus mengira Chronos sedang merencanakan sesuatu. Aku sempat ragu, tapi... ingin memastikannya sendiri."
      Speaker = "Artemis"
      Event = "ArtemisAboutShrine01"
    }
    {
      Id = "Artemis_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih kesulitan sampai ke sini dibanding biasanya. Wasiat Sang Malam lagi? Nyx sendiri pasti terkesan dengan semua yang kau lakukan, menebar {#Emph}rasa takut{#Prev}, menciptakan {#Emph}mimpi buruk..."
      Speaker = "Artemis"
      Event = "ArtemisAboutShrine02"
    }
    {
      Id = "MelinoeField_3364"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lewat rasa takut, lahirlah rasa hormat dan kepatuhan. Begitu urusan kita selesai, para calon perampas takhta berikutnya yang mengincar salah satu alam kita mungkin bakal berpikir dua kali."
      Speaker = "Melinoe"
      Event = "ArtemisAboutShrine02"
    }
    {
      Id = "Artemis_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiruan gaya ayahmu barusan lumayan juga, Saudari. Nah, ayo kita buat musuh-musuh kita makin ketakutan, bagaimana?"
      Speaker = "Artemis"
      Event = "ArtemisAboutShrine02"
    }
    {
      Id = "Artemis_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bulan purnama... kekuatan Saudari Selene sedang di puncaknya. Pada malam-malam seperti ini, aku benar-benar merasakan keabadianku. Semoga kekuatan gabungan kita cukup."
      Speaker = "Artemis"
      Event = "ArtemisAboutMoon01"
    }
    {
      Id = "Melinoe_1193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, Artemis. Semuanya baik-baik saja?"
      Speaker = "Melinoe"
      Event = "ArtemisSendOff01"
    }
    {
      Id = "Artemis_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak yang ingin kubicarakan, tapi waktuku sempit, Saudari. Aku dibutuhkan di tempat lain, tapi aku ingin memastikan mengantarmu berangkat."
      Speaker = "Artemis"
      Event = "ArtemisSendOff01"
    }
    {
      Id = "Melinoe_1182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti sudah dengar aku gagal sampai ke sana, Artemis. Mendekat pun tidak."
      Speaker = "Melinoe"
      Event = "ArtemisAboutRetrying01"
    }
    {
      Id = "Artemis_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari, aku menaruh {#Emph}segenap {#Prev}kepercayaan padamu, tapi bahkan {#Emph}aku {#Prev}pun tak menyangka kau bakal menumpas Chronos seketika. Mari kita sedikit realistis, ya?"
      Speaker = "Artemis"
      Event = "ArtemisAboutRetrying01"
    }
    {
      Id = "Melinoe_1055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah ada perkembangan dengan penyelidikanmu?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutProgress01"
    }
    {
      Id = "Artemis_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum sebanyak yang kuharapkan. Ini, biar kuberi kau sedikit dorongan. Siapa tahu kau dapat titik terang walau aku belum."
      Speaker = "Artemis"
      Event = "ArtemisAboutProgress01"
    }
    {
      Id = "Artemis_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah berapa malam kita tak saling bertemu, Saudari? {#Emph}Ugh{#Prev}, kutahu memang begitulah keadaannya. Kau sibuk, aku sibuk, waktu berlalu begitu saja, dan... tibalah kita di sini."
      Speaker = "Artemis"
      Event = "ArtemisAboutTimePassing01"
    }
    {
      Id = "MelinoeField_2450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti kita sudah berulang kali berpapasan, hanya saja tak cukup dekat. Rasanya banyak hal terjadi sejak terakhir kali kita bertemu seperti ini. Dari mana kita harus mulai?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutTimePassing01"
    }
    {
      Id = "Artemis_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh tak usah repot, kita memang jarang bertemu tapi aku terus memantau kabarmu. Olimpus tahu semua sepak terjang terbarumu! Yah, setidaknya yang kau izinkan untuk kuceritakan."
      Speaker = "Artemis"
      Event = "ArtemisAboutTimePassing01"
    }
    {
      Id = "Artemis_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tim yang hebat, bukan? Dan itu {#Emph}tanpa {#Prev}bantuan Saudari Hecate dan Selene menyokong kita. Sayang sekali kita harus sering berpencar hampir sepanjang waktu."
      Speaker = "Artemis"
      Event = "ArtemisAboutTeamwork01"
    }
    {
      Id = "MelinoeField_4092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita memang punya beberapa alam untuk dijaga. Tapi ya, kuakui senang sekali bisa bekerja sama denganmu akhir-akhir ini. Bernyanyi bersamamu. Merasakan persahabatanmu."
      Speaker = "Melinoe"
      Event = "ArtemisAboutTeamwork01"
    }
    {
      Id = "Artemis_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan mulai sentimental padaku, Saudari. Ini murni urusan pekerjaan. Dan meski dunia tempat kita tinggal tampak agak suram, setidaknya urusan pekerjaan berjalan lancar."
      Speaker = "Artemis"
      Event = "ArtemisAboutTeamwork01"
    }
    {
      Id = "Artemis_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, lihat apa yang kugali dari tunggul pohon berlubang tertentu! Di balik lapisan tanah tebal ini ada botol Ambrosia yang kau suruh kusembunyikan, dan kita akan meminumnya sekarang."
      Speaker = "Artemis"
      Event = "ArtemisAboutAmbrosia01"
    }
    {
      Id = "MelinoeField_4105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, {#Emph}sekarang? {#Prev}Kenapa tidak disimpan untuk di Persimpangan saja, di mana kita, contohnya, tidak berlumuran sisa-sisa musuh?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutAmbrosia01"
    }
    {
      Id = "Artemis_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bicara saja sendiri, aku pakai busur, jadi aku {#Emph}bersih! {#Prev}Tapi ya, sekarang juga. Karena kalau kita terus menunggu waktu yang sempurna, kita bakal menunggu selamanya. Yang terpenting, kau sudah menuntaskan tugasmu, dan kita hampir tak sempat merayakannya!"
      Speaker = "Artemis"
      Event = "ArtemisAboutAmbrosia01"
    }
    {
      Id = "MelinoeField_4106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan bulannya {#Emph}memang {#Prev}sedang mati. Alasanmu masuk akal juga, baiklah, mari kita nikmati sedikit. Untuk apa kita bersulang?"
      Speaker = "Melinoe"
      Event = "ArtemisAboutAmbrosia01"
    }
    {
      Id = "Artemis_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk Saudari Perak... jika aku harus mengendap-endap dalam bayangan bersama beberapa dewi lain, aku tak bisa meminta kawanan yang lebih baik dari ini."
      Speaker = "Artemis"
      Event = "ArtemisAboutAmbrosia01"
    }
    {
      Id = "Artemis_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fyuuh! {#Prev}Segar sekali, dan pekerjaan kita pun tak lari ke mana-mana. Kurasa kita harus kembali beraksi?"
      Speaker = "Artemis"
      Event = "ArtemisAboutAmbrosia01"
    }
    {
      Id = "Artemis_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aksinya telah tuntas, atau haruskah kubilang {#Emph}tugas {#Prev}itu akhirnya selesai. Tapi, kau langsung kembali bekerja!"
      Speaker = "Artemis"
      Event = "ArtemisPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, begitulah... anggap saja ini kebiasaan, atau kesempatan untuk memeriksa beberapa hal. Dan terima kasih, Artemis. Aku takkan melupakan kepakan Saudari Perak."
      Speaker = "Melinoe"
      Event = "ArtemisPostTrueEnding01"
    }
    {
      Id = "Artemis_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apollo cuma {#Emph}merasa harus {#Prev}ikut serta, meski aku juga takkan melupakannya dalam waktu dekat. Sudah lama sekali tak merasakan kemenangan seperti itu. Tunggu, kenapa kita {#Emph}masih {#Prev}bertarung?"
      Speaker = "Artemis"
      Event = "ArtemisPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk memusnahkan sisa-sisa ancaman yang kita hadapi hingga tak bersisa, rupanya. Jadi aku masih membutuhkanmu di sisiku seperti sedia kala."
      Speaker = "Melinoe"
      Event = "ArtemisPostTrueEnding01"
    }
    {
      Id = "Artemis_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu kita bisa terus melanjutkan {#Emph}hal ini{#Prev}, dan aku bakal punya sasaran tembak sebanyak yang kumau? Wah, {#Emph}OKE!"
      Speaker = "Artemis"
      Event = "ArtemisPostTrueEnding01"
    }
    {
      Id = "Artemis_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keadaan di rumah ternyata jauh lebih baik dari yang kukira. Masih agak aneh melihat kami membersihkan sisa-sisa pengepungan itu, tapi setidaknya Ayah Zeus akhirnya sudah jauh lebih kalem."
      Speaker = "Artemis"
      Event = "ArtemisPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang mendengarnya, dan aku senang kau bisa melihatnya sendiri ke sana. Jadi, apakah ini artinya kita takkan sering bertemu lagi di sini? Mereka pasti ingin kau pulang."
      Speaker = "Melinoe"
      Event = "ArtemisPostTrueEnding02"
    }
    {
      Id = "Artemis_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, rahasia di antara kita ya, mereka masih ingin aku mengawasimu, wahai penyihir tangguh. Tapi, aku memang harus melapor sesekali, dan aku tak keberatan. Mereka senang melihat {#Emph}aku{#Prev}, dan senang mendengar kabar tentang {#Emph}dirimu{#Prev}, lalu... aku juga bisa menyapa para Nimfa!"
      Speaker = "Artemis"
      Event = "ArtemisPostTrueEnding02"
    }
    {
      Id = "Artemis_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua orang di gunung tak henti-hentinya membicarakan kemunculan Sang Takdir. Ayah bahkan takkan berkuasa kalau bukan karena mereka, jadi beliau pasti benci memikirkan kalau mereka sempat hilang..."
      Speaker = "Artemis"
      Event = "ArtemisPostEpilogue01"
    }
    {
      Id = "MelinoeField_4118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kini Sang Takdir berkata pengaruh para dewa akan sedikit memudar. Aku tak bisa membayangkan Paman Zeus dan yang lainnya bakal senang soal {#Emph}itu."
      Speaker = "Melinoe"
      Event = "ArtemisPostEpilogue01"
    }
    {
      Id = "Artemis_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang tidak, tapi untuk ukuran ramalan besar, itu sebenarnya tak buruk-buruk amat. Lagipula, sepertinya era baru mereka itu masih agak lama, jadi... kita pikirkan saja nanti!"
      Speaker = "Artemis"
      Event = "ArtemisPostEpilogue01"
    }
    {
      Id = "Artemis_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersih dan efisien, persis seperti yang kusuka, Saudari. Tak banyak yang perlu kulaporkan dari sisiku, dan sepertinya semuanya baik-baik saja di sisimu. Ayo kita lanjut bergerak, ya?"
      Speaker = "Artemis"
      Event = "ArtemisAboutSayingLittle01"
    }
    {
      Id = "Artemis_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ambil ini, Saudari, dan pergilah cari mangsamu."
      Speaker = "Artemis"
      Event = "ArtemisChat01"
    }
    {
      Id = "Artemis_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melangkahlah tanpa suara, dan seranglah dengan cepat serta jitu, Saudari."
      Speaker = "Artemis"
      Event = "ArtemisChat02"
    }
    {
      Id = "Artemis_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebetulan sedang lewat area sini lagi, jadi kupikir sebaiknya aku mampir."
      Speaker = "Artemis"
      Event = "ArtemisChat03"
    }
    {
      Id = "Artemis_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga Terang Bulan menuntunmu ke mangsamu, dan menyingkap setiap kelemahannya."
      Speaker = "Artemis"
      Event = "ArtemisChat04"
    }
    {
      Id = "Artemis_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam baru, tugas baru bagi Saudari Perak."
      Speaker = "Artemis"
      Event = "ArtemisChat05"
    }
    {
      Id = "Artemis_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, hutan-hutan ini bukan tempat favoritku..."
      Speaker = "Artemis"
      Event = "ArtemisChat06"
    }
    {
      Id = "Artemis_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa menjelajah lebih dalam ke bawah sana, tapi aku bisa memberimu ini."
      Speaker = "Artemis"
      Event = "ArtemisChat07"
    }
    {
      Id = "Artemis_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemburu yang terampil selalu membawa kantong trik yang penuh ke mana pun ia pergi."
      Speaker = "Artemis"
      Event = "ArtemisChat08"
    }
    {
      Id = "Artemis_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tenangkan dirimu, Saudari. Kau mendapat dukungan penuh dariku, bahkan lebih."
      Speaker = "Artemis"
      Event = "ArtemisChat09"
    }
    {
      Id = "Artemis_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga bidikanmu selalu tepat sasaran. Mirip sepertiku!"
      Speaker = "Artemis"
      Event = "ArtemisChat10"
    }
    {
      Id = "Artemis_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih merasa kau harus mencoba memanah lagi kapan-kapan..."
      Speaker = "Artemis"
      Event = "ArtemisChat11"
    }
    {
      Id = "Artemis_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berburu sendiri-sendiri. Tapi sesekali berpapasan begini seru juga!"
      Speaker = "Artemis"
      Event = "ArtemisChat12"
    }
    {
      Id = "Artemis_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan bekerja sama denganmu, Saudari."
      Speaker = "Artemis"
      Event = "ArtemisChat13"
    }
    {
      Id = "Artemis_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong beri pelajaran pada Titan keparat itu untukku, ya?"
      Speaker = "Artemis"
      Event = "ArtemisChat14"
    }
    {
      Id = "Artemis_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga tiada yang berani menghalangi seorang penyihir dan mangsanya."
      Speaker = "Artemis"
      Event = "ArtemisChat15"
    }
    {
      Id = "Artemis_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang cerah untuk memburu Titan, bukan?"
      Speaker = "Artemis"
      Event = "ArtemisChat16"
    }
    {
      Id = "Artemis_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mencium aroma beberapa musuh yang tertinggal, biar kubereskan setelah ini..."
      Speaker = "Artemis"
      Event = "ArtemisChat17"
    }
    {
      Id = "Artemis_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti menemukan mangsamu. Aku yakin itu."
      Speaker = "Artemis"
      Event = "ArtemisChat18"
    }
    {
      Id = "Artemis_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mangsamu adalah yang paling berbahaya dari semuanya. Aku jadi agak iri!"
      Speaker = "Artemis"
      Event = "ArtemisChat19"
    }
    {
      Id = "Artemis_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini sedikit bekal untuk melengkapi ilmu sihirmu."
      Speaker = "Artemis"
      Event = "ArtemisChat20"
    }
    {
      Id = "Artemis_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku melindungimu dari belakang, Saudari, teruslah maju."
      Speaker = "Artemis"
      Event = "ArtemisChat21"
    }
    {
      Id = "Artemis_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita ini Saudari Perak, dan bidikan kita tak pernah meleset."
      Speaker = "Artemis"
      Event = "ArtemisChat22"
    }
    {
      Id = "Artemis_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita adalah Saudari Perak, dan inilah saatnya kita bersinar."
      Speaker = "Artemis"
      Event = "ArtemisChat23"
    }
    {
      Id = "Artemis_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, menyenangkan rasanya bisa kabur sejenak dari semua hiruk-pikuk itu."
      Speaker = "Artemis"
      Event = "ArtemisChat24"
    }
    {
      Id = "Artemis_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka bisa bertemu denganmu lagi, apalagi di tempat seperti ini!"
      Speaker = "Artemis"
      Event = "ArtemisChat25"
    }
    {
      Id = "Artemis_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kali ini {#Emph}kau {#Prev}yang melacak keberadaanku, asal kau tahu!"
      Speaker = "Artemis"
      Event = "ArtemisChat26"
    }
    {
      Id = "Artemis_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dilahirkan untuk tugas ini, Saudari, dan kau pasti akan berhasil."
      Speaker = "Artemis"
      Event = "ArtemisChat27"
    }
    {
      Id = "Artemis_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jelas jauh lebih baik daripada berada di puncak gunung itu, percayalah."
      Speaker = "Artemis"
      Event = "ArtemisChat28"
    }
    {
      Id = "Artemis_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bulan purnama bersinar lagi. Semoga gabungan kekuatan kita membawamu melangkah jauh."
      Speaker = "Artemis"
      Event = "ArtemisChat29"
    }
    {
      Id = "Artemis_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bulan baru menandai awal yang baru, jadi kuatkan hatimu, Saudariku."
      Speaker = "Artemis"
      Event = "ArtemisChat30"
    }
    {
      Id = "Artemis_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahaya Bulan memudar lagi, tapi kekuatanmu tak boleh goyah."
      Speaker = "Artemis"
      Event = "ArtemisChat31"
    }
    {
      Id = "Artemis_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seiring terangnya Bulan yang kian benderang, potensi kita pun ikut berlipat ganda, Saudariku."
      Speaker = "Artemis"
      Event = "ArtemisChat32"
    }
    {
      Id = "Artemis_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga perburuanmu lancar dalam perjalanan mendaki gunung, Saudariku."
      Speaker = "Artemis"
      Event = "ArtemisChat33"
    }
    {
      Id = "Artemis_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah awas saja kalau tidak mengungkapkan rasa terima kasihnya atas semua yang sudah kau lakukan."
      Speaker = "Artemis"
      Event = "ArtemisChat34"
    }
    {
      Id = "Artemis_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah kau sudah membereskan Typhon, jadi kami tak perlu berurusan dengannya lagi!"
      Speaker = "Artemis"
      Event = "ArtemisChat35"
    }
    {
      Id = "Artemis_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan menyamarkan jejakmu, tapi sebelumnya, terimalah bekal untuk perjalananmu ini."
      Speaker = "Artemis"
      Event = "ArtemisChat36"
    }
    {
      Id = "Artemis_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lain kali sisakan lebih banyak mangsa untukku, ya?"
      Speaker = "Artemis"
      Event = "ArtemisChat37"
    }
    {
      Id = "Artemis_0467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rapi dan efisien, persis seperti yang kusuka, Saudariku."
      Speaker = "Artemis"
      Event = "ArtemisChat39"
    }
    {
      Id = "Artemis_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini, sedikit sihir Bulan tambahan untuk semua usahamu, dan yang masih akan kau lakukan nanti."
      Speaker = "Artemis"
      Event = "ArtemisChat40"
    }
    {
      Id = "Artemis_0320"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Area aman."
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0321"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menemukan sesuatu?"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0322"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mata yang jeli."
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0323"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahan ramuan lagi?"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0324"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Untuk kualinya?"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0325"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku yang lihat duluan, lho."
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0314"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fokus{#Prev}, Saudariku!"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0315"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buka matamu, Saudariku!"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0316"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak sabaran amat?"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0317"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali bertarung!"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0318"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang, {#Emph}serius nih?"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0319"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kucakup punggungmu!"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisGatherReactionVoiceLines"
    }
    {
      Id = "Artemis_0371"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana kalau yang ini?"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisReRollReactionVoiceLines"
    }
    {
      Id = "Artemis_0372"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Coba yang ini kalau begitu."
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisReRollReactionVoiceLines"
    }
    {
      Id = "Artemis_0373"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa aku bisa siapkan yang ini."
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisReRollReactionVoiceLines"
    }
    {
      Id = "Artemis_0374"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, pemilih juga ya."
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisReRollReactionVoiceLines"
    }
    {
      Id = "Artemis_0375"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lebih cocok dengan seleramu?"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisReRollReactionVoiceLines"
    }
    {
      Id = "Artemis_0433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak sopan!"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisSongStoppedReactionVoiceLines"
    }
    {
      Id = "Artemis_0434"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya sudah!"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisSongStoppedReactionVoiceLines"
    }
    {
      Id = "Artemis_0435"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Iya, paham!"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisSongStoppedReactionVoiceLines"
    }
    {
      Id = "Artemis_0436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, baiklah!"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisSongStoppedReactionVoiceLines"
    }
    {
      Id = "Artemis_0437"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke, oke."
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisSongStoppedReactionVoiceLines"
    }
    {
      Id = "Artemis_0438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hajar, si Pembuat Musik!"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisSongStoppedReactionVoiceLines"
    }
    {
      Id = "Artemis_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saudariku, tunggu, jangan pergi dulu!"
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisDeathReactionVoiceLines"
    }
    {
      Id = "Artemis_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lain kali, kita buat mereka membayar mahal..."
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisDeathReactionVoiceLines"
    }
    {
      Id = "Artemis_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maafkan aku, Saudari..."
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisDeathReactionVoiceLines"
    }
    {
      Id = "Artemis_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan... Aku sudah bersumpah untuk melindungimu..."
      Speaker = "Artemis"
      Event = "GlobalVoiceLines.ArtemisDeathReactionVoiceLines"
    }
  ]
}
