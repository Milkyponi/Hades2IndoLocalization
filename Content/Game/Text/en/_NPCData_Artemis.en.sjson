      Event = "NPC_Artemis_01.ExitVoiceLines"
    }
    {
      Id = "Artemis_0308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga cahaya bulan menuntun jalan pulangmu malam ini!"
