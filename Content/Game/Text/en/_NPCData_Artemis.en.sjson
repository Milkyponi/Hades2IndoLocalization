      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0448"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sisakan buatku lain kali."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0447"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku nyaris tak sempat memanah..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0445"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali beraksi, ya?"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0380"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, hai, Melinoë!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0363"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tadi agak kacau, ya..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tadi tidak berjalan mulus."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0365"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maaf soal kekacauan tadi..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, setidaknya kita selamat..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu tidak apa-apa?"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterEndVoiceLines"
    }
    {
      Id = "Artemis_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sial, kamu terluka..."
