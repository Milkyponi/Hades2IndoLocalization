{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Artemis.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "Melinoe_1711"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersama kita bersinar, Saudari."
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_1697"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersama kita bersinar."
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga cahaya bulan memandu langkahmu."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di jalan, Saudari."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Emm{#Prev}, halo?"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersama kita bersinar!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo lagi."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia sudah ditandai."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga sama."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan semoga bidikan kita tepat sasaran."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.InteractVoiceLines"
    }
    {
      Id = "Artemis_0302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Maju{#Prev}, Saudari!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.SingingReactionVoiceLines"
    }
    {
      Id = "Artemis_0303"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nyanyikan{#Prev}!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.SingingReactionVoiceLines"
    }
    {
      Id = "Artemis_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu, dong!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.SingingReactionVoiceLines"
    }
    {
      Id = "Artemis_0305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersama-sama sekarang!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.SingingReactionVoiceLines"
    }
    {
      Id = "Artemis_0306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Melinoë!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.SingingReactionVoiceLines"
    }
    {
      Id = "Artemis_0307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mantap!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.SingingReactionVoiceLines"
    }
    {
      Id = "Artemis_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei Melinoë, aku baru saja selesai melapor ke Saudari Hecate. Tempat ini sudah {#Emph}jauh {#Prev}berubah semenjak terakhir kali kulihat!"
      Speaker = "Artemis"
      Event = "ArtemisHubFirstMeeting01"
    }
    {
      Id = "Melinoe_1187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hai Artemis, selamat datang! Kami memang agak kelabakan mempersiapkan segalanya. Mau kutemani berkeliling? Sudah menyapa Nemesis?"
      Speaker = "Melinoe"
      Event = "ArtemisHubFirstMeeting01"
    }
    {
      Id = "Artemis_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, {#Emph}jangan dulu{#Prev}, aku harus segera pergi. Olimpus membutuhkanku di atas, setidaknya untuk sebentar. Mungkin lain kali, ya?"
      Speaker = "Artemis"
      Event = "ArtemisHubFirstMeeting01"
    }
    {
      Id = "Melinoe_1188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku paham. Sampai jumpa lagi kalau begitu."
      Speaker = "Melinoe"
      Event = "ArtemisHubFirstMeeting01"
    }
    {
      Id = "Artemis_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah, kau ada di sini! Aku agak terlambat kembali, tapi tak tega rasanya pergi sebelum melihatmu siuman dan bisa jalan lagi. Bagaimana kondisimu?"
      Speaker = "Artemis"
      Event = "ArtemisHubAboutChronosBoss01"
    }
    {
      Id = "Melinoe_3598"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengingat sang Titan Waktu nyaris membelahku jadi dua tadi malam dengan sabit dua kali lipat tubuhku yang bisa merobek udara, keadaanku terbilang lumayan. Terima kasih sudah menungguku."
      Speaker = "Melinoe"
      Event = "ArtemisHubAboutChronosBoss01"
    }
    {
      Id = "Artemis_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja! Aku suka apa yang kau buat pada tempat ini. Sekarang sudah mirip kamp perang sungguhan! Ada kedai, pemandian air panas... Sepertinya aku harus lebih sering mampir. Teruslah bersinar tanpaku untuk sekarang!"
      Speaker = "Artemis"
      Event = "ArtemisHubAboutChronosBoss01"
    }
    {
      Id = "Melinoe_3497"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga, teruslah bersinar!"
      Speaker = "Melinoe"
      Event = "ArtemisHubAboutChronosBoss01"
    }
    {
      Id = "Melinoe_4028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, maaf kalau mengganggu. Tak kusangka kau sedang bernyanyi, meski aku sama sekali tak keberatan."
      Speaker = "Melinoe"
      Event = "ArtemisHubSinging01"
    }
    {
      Id = "Artemis_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang tak perlu keberatan! Hei, mumpung kau di sini, bagaimana kalau kita bernyanyi bersama demi masa lalu? Lepaskan bebanmu sejenak. Lagipula beban itu takkan lari ke mana-mana."
      Speaker = "Artemis"
      Event = "ArtemisHubSinging01"
    }
    {
      Id = "Artemis_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melihat raut wajahmu, aku tahu kau pasti sedang memikul beban berat, Melinoë. Tapi jangan lupakan apa yang sudah kita sepakati di sini."
      Speaker = "Artemis"
      Event = "ArtemisHubSinging02"
    }
    {
      Id = "Melinoe_4029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita meninggalkan kekhawatiran kita di gerbang menuju tanah lapang kecil ini, ya... tapi, apa kau tak pernah goyah? Merasa pikiranmu kembali melayang memikirkan masalahmu?"
      Speaker = "Melinoe"
      Event = "ArtemisHubSinging02"
    }
    {
      Id = "Artemis_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Justru itulah tujuan lagu ini! Bukan untuk melenyapkan masalah kita, melainkan agar kita bisa menghadapinya sebaik mungkin."
      Speaker = "Artemis"
      Event = "ArtemisHubSinging02"
    }
    {
      Id = "Melinoe_4030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari Artemis. Ada hal yang teramat sangat penting yang harus kubicarakan denganmu, sekarang juga."
      Speaker = "Melinoe"
      Event = "ArtemisHubSinging03"
    }
    {
      Id = "Artemis_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Usaha yang bagus, Saudari Melinoë, tapi aku takkan goyah semudah itu. Tidak di {#Emph}sini! {#Prev}Sekarang, kau mau ikut bernyanyi atau tidak?"
      Speaker = "Artemis"
      Event = "ArtemisHubSinging03"
    }
    {
      Id = "Artemis_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah mendengar kabar terbaru itu, Saudari, tapi kita akan membahasnya di luar sana saat berburu. Bukan saat kita ada di sini."
      Speaker = "Artemis"
      Event = "ArtemisHubSinging04"
    }
    {
      Id = "Artemis_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa Arwah di seberang sungai sana itu, yang membawa banyak tumpukan perkamen? Dia tak pernah menatap langsung ke arahku tapi terus-terusan melirik, seolah-olah tindakannya itu terselubung saja."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingAboutRecordKeeper01"
    }
    {
      Id = "Melinoe_4941"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, maksudmu pasti Sang Pencatat, yang mungkin saja terpikat oleh nyanyianmu yang merdu. Dan kemungkinan besar sedang mencatat dengan sangat teliti setiap kali kau bernyanyi."
      Speaker = "Melinoe"
      Event = "ArtemisHubSingingAboutRecordKeeper01"
    }
    {
      Id = "Artemis_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah kalau begitu, aku sama sekali tak gampang minder."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingAboutRecordKeeper01"
    }
    {
      Id = "Artemis_0432"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, Pencatat! Lagu ini kupersembahkan untukmu!"
      Speaker = "Artemis"
      Event = "ArtemisHubSingingAboutRecordKeeper01"
    }
    {
      Id = "Artemis_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuakui, Apollo punya andil besar dalam lagu ini. Tapi aku tetap menyukainya... dan ini mengingatkanku saat kita semua bisa mengudara bersama melintasi langit. Mau ikut bernyanyi sebentar?"
      Speaker = "Artemis"
      Event = "ArtemisHubSingingEndTheme01"
    }
    {
      Id = "Nemesis_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Lalu bagaimana kabar Callisto, dia baik-baik saja? Masih berkeliaran riang di hutan sana, atau bagaimana?"
      Speaker = "Nemesis"
      Event = "ArtemisWithNemesis01"
    }
    {
      Id = "Artemis_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, dia baik-baik saja. Banyak Nimfa dan hewan liar yang menemaninya. Dia tahu tugasku ini memakan waktu lama, dan aku tak bisa saling kontak lewat Karunia. Tapi kau sendiri baik-baik saja, kan?"
      Speaker = "Artemis"
      Event = "ArtemisWithNemesis01"
    }
    {
      Id = "Nemesis_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurang lebih begitu. Belakangan ini banyak urusan di sini, meski aku tak bisa mengurus semuanya. Tapi yang penting aku tetap dapat jatah yang adil."
      Speaker = "Nemesis"
      Event = "ArtemisWithNemesis01"
    }
    {
      Id = "Artemis_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sama sekali tak berubah. Sampai jumpa lagi, Nem."
      Speaker = "Artemis"
      Event = "ArtemisWithNemesis01"
    }
    {
      Id = "Nemesis_0436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya. Sampai jumpa lagi."
      Speaker = "Nemesis"
      Event = "ArtemisWithNemesis01"
    }
    {
      Id = "Artemis_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi istirahat sebentar, Saudari. Mau bernyanyi satu atau dua bait bersamaku?"
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable01"
    }
    {
      Id = "Artemis_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar Apollo yang bernyanyi di Olympus, bagianku di sini saja."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable02"
    }
    {
      Id = "Artemis_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita semua punya ritual kecil tersendiri untuk menenangkan pikiran."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable03"
    }
    {
      Id = "Artemis_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu suka tempat ini, dan para Arwah pun kelihatannya tidak keberatan."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable04"
    }
    {
      Id = "Artemis_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang perlu dikhawatirkan, begitu pun dirimu. Setidaknya tidak di sini."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable05"
    }
    {
      Id = "Artemis_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tubuhmu memang sudah pulih. Tapi bagaimana dengan pikiranmu?"
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable06"
    }
    {
      Id = "Artemis_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini lagu kemenangan kita; atau untuk segala macam perayaan, sebenarnya. Mau ikut?"
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable07"
    }
    {
      Id = "Artemis_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat keadaan tak berjalan lancar, kita bernyanyi... meski hanya sebentar."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable08"
    }
    {
      Id = "Artemis_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi malam keadaannya memang buruk, tapi itu semua sudah berlalu."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable09"
    }
    {
      Id = "Artemis_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus segera kembali berburu sebentar lagi, tapi... nanti sajalah."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable10"
    }
    {
      Id = "Artemis_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku mana bisa latihan seperti ini di Olympus, tahu!"
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable11"
    }
    {
      Id = "Artemis_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan terlalu dipikirkan, Saudari, ayo ikut bernyanyi sebentar."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable12"
    }
    {
      Id = "Artemis_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu pakai suara bicara kita yang kaku di sini, Saudari."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable13"
    }
    {
      Id = "Artemis_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasa malu kalau bernyanyi di Olympus, tapi di sini tidak."
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable14"
    }
    {
      Id = "Artemis_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagu ini kupersembahkan untuk seluruh Arwah di luar sana!"
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable15"
    }
    {
      Id = "Artemis_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap malam membawa kemungkinan baru, dan aku akan bernyanyi menyambutnya!"
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable16"
    }
    {
      Id = "Artemis_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah selesai bernyanyinya...? Ya sudah, aku juga selesai mengobrol!"
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable17"
    }
    {
      Id = "Artemis_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apollo tak ada di sini untuk menyanyikan bagian satunya lagi, tapi untung ada dirimu!"
      Speaker = "Artemis"
      Event = "ArtemisHubSingingRepeatable18"
    }
    {
      Id = "Melinoe_1194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebuah kehormatan bisa bekerja sama lebih dekat denganmu, Saudari Artemis. Ini memang tak sebanding dengan berkah ketepatan bidikanmu yang sempurna, tapi aku ingin kau menerimanya."
      Speaker = "Melinoe"
      Event = "ArtemisGift01"
    }
    {
      Id = "Artemis_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pakai tradisi lama sekarang, nih? Baiklah kalau begitu, kuterima persembahanmu, Saudari Melinoë. Dan aku juga punya persembahan balasan untuk{#Emph}mu{#Prev}!"
      Speaker = "Artemis"
      Event = "ArtemisGift01"
    }
    {
      Id = "Artemis_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kan kita punya {#Emph}berlarik-larik {#Prev}minuman ini di Olympus? Dulu sih, setidaknya. Kalau dipikir-pikir... aku sampai hampir lupa seperti apa rasanya..."
      Speaker = "Artemis"
      Event = "ArtemisGift02"
    }
    {
      Id = "Melinoe_1195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga kenangan manis itu kembali bermekaran! Tentu saja, saat kau punya waktu luang nanti."
      Speaker = "Melinoe"
      Event = "ArtemisGift02"
    }
    {
      Id = "Artemis_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada angin apa kau jadi begitu dermawan belakangan ini? Malah bikin aku waswas. Jangan bersikap seolah ini adalah perpisahan...!"
      Speaker = "Artemis"
      Event = "ArtemisGift03"
    }
    {
      Id = "Melinoe_2341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya saja, sisa-sisa jasad musuhku yang berlubang kena panah memberiku momen untuk merenung! Aku selalu mengingatkan diri sendiri agar tak pernah mengabaikan sahabat-sahabat terbaikku."
      Speaker = "Melinoe"
      Event = "ArtemisGift03"
    }
    {
      Id = "Artemis_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mana bisa minum ini saat sedang berburu, kau tahu sendiri, kan! Tapi bisa kusimpan baik-baik di tempat yang aman. Mungkin setelah semua ini selesai, kita bisa minum sebotol berdua dan mengobrol sepuasnya."
      Speaker = "Artemis"
      Event = "ArtemisGift04"
    }
    {
      Id = "Melinoe_2342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atau kalaupun tidak bisa, kita selalu bisa terus bekerja sama membantai roh-roh pendendam dan sebangsanya! Meskipun menyenangkan juga membayangkan kemungkinan itu."
      Speaker = "Melinoe"
      Event = "ArtemisGift04"
    }
    {
      Id = "Artemis_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, terima kasih banyak! Pasokan barang ini di Olympus mulai menipis. Pasti bakal kupamerkan ke yang lain, asalkan kau tak keberatan kebaikanmu kumanfaatkan sedikit."
      Speaker = "Artemis"
      Event = "ArtemisGift05"
    }
    {
      Id = "Melinoe_3502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seingatku tidak ada larangan memanfaatkan kebaikan satu sama lain di piagam Saudari Perak, jadi aman-aman saja! Nikmatilah sesukamu."
      Speaker = "Melinoe"
      Event = "ArtemisGift05"
    }
    {
      Id = "Artemis_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Memang sulit berteman dengan sesama dewi, tapi apa yang kumiliki sudah {#Emph}cukup{#Prev}. Kita bisa menyendiri tanpa merasa kesepian, kan? Kuharap kau paham. Begitulah yang kurasakan."
      Speaker = "Artemis"
      Event = "ArtemisGift06"
    }
    {
      Id = "Melinoe_3503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham, dan merasakan hal yang sama. Saat kita tidak sedang saling menjaga punggung, ada Selene dan Ibu Kepala Asrama yang mengawasi kita. Namun, tetap menyenangkan bisa bertemu langsung denganmu."
      Speaker = "Melinoe"
      Event = "ArtemisGift06"
    }
    {
      Id = "Artemis_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau juga. Sebagian besar keluargaku bisa kuabaikan hampir setiap saat. Tapi kau pengecualian! Kita mungkin bukan saudara kandung, tapi... kau akan selalu menjadi Saudari Melinoë bagiku."
      Speaker = "Artemis"
      Event = "ArtemisGift06"
    }
    {
      Id = "Melinoe_3504"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama halnya denganku, Saudari Artemis."
      Speaker = "Melinoe"
      Event = "ArtemisGift06"
    }
    {
      Id = "MelinoeField_4093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, terpikir untuk membawakanmu barang bagus ini. Sepertinya kemungkinan besar barang ini lebih mudah didapat di sini daripada di tempat asalmu."
      Speaker = "Melinoe"
      Event = "ArtemisGift07"
    }
    {
      Id = "Artemis_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, Ambrosia! Callisto dulu selalu menyukai ini. Mungkin aku akan menemuinya lagi begitu situasinya agak mereda."
      Speaker = "Artemis"
      Event = "ArtemisGift07"
    }
    {
      Id = "MelinoeField_4094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugasmu pasti memisahkanmu darinya... Maaf, aku bahkan tidak memikirkan hal itu sampai barusan. Dia tidak marah padamu, kan?"
      Speaker = "Melinoe"
      Event = "ArtemisGift07"
    }
    {
      Id = "Artemis_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kalau dia sudah berubah jadi beruang biasanya tandanya dia marah, dan akhir-akhir ini dia sering begitu. Jadi baguslah kita sedang rehat sejenak! Itu artinya kemungkinanku dicabik-cabik jadi {#Emph}jauh{#Prev} lebih kecil."
      Speaker = "Artemis"
      Event = "ArtemisGift07"
    }
    {
      Id = "MelinoeField_4095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu untukmu dan mungkin Callisto di sini, jika kau memutuskan untuk memberanikan diri mendekatinya lagi."
      Speaker = "Melinoe"
      Event = "ArtemisGift08"
    }
    {
      Id = "Artemis_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, terima kasih banyak! Aku belum memutuskan apakah mau membaginya dengan teman-teman Nimfa-ku, padahal aku {#Emph}bisa saja{#Prev} menimbun semuanya untuk {#Emph}diriku sendiri...{#Prev}"
      Speaker = "Artemis"
      Event = "ArtemisGift08"
    }
    {
      Id = "MelinoeField_4096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya tak akan lebih enak kalau begitu, jadi lebih baik kau bagi atau setidaknya berikan ke orang yang mau meminumnya. Akhir-akhir ini sedang kurang akur dengan para Nimfa?"
      Speaker = "Melinoe"
      Event = "ArtemisGift08"
    }
    {
      Id = "Artemis_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka tidak suka aku pergi berperang. Seolah-olah aku ini bukan dewi perburuan di mata mereka, yah meski itu juga bagian dari daya tariknya. Tapi, kau dan aku, kita punya tugas yang harus diselesaikan."
      Speaker = "Artemis"
      Event = "ArtemisGift08"
    }
    {
      Id = "MelinoeField_4097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar sekali."
      Speaker = "Melinoe"
      Event = "ArtemisGift08"
    }
    {
      Id = "MelinoeField_4098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang satu ini khusus untukmu, Artemis, jadi jangan pernah berpikir untuk memberikannya ke teman-teman Nimfa-mu. Bahkan ke Callisto sekalipun, tak peduli seberapa mengancam wujud beruangnya."
      Speaker = "Melinoe"
      Event = "ArtemisGift09"
    }
    {
      Id = "Artemis_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oke, oke, kalau kau memaksa! Tapi, harus kuapakan ini? Bawaanku selalu ringkas, dan akhir-akhir ini jarang mampir ke rumah."
      Speaker = "Artemis"
      Event = "ArtemisGift09"
    }
    {
      Id = "MelinoeField_4099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kausembunyikan, di bawah batu, atau di rongga tunggul pohon atau semacamnya? Lalu suatu malam nanti, kita bisa menikmatinya bersama."
      Speaker = "Melinoe"
      Event = "ArtemisGift09"
    }
    {
      Id = "Artemis_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, {#Emph}itu{#Prev} baru rencana mantap, Saudari Melinoë. Tapi kupegang janjimu itu, ya. Bagaimana kalau kita tunggu sampai Bulan Baru... jangan sampai Saudari Selene salah paham."
      Speaker = "Artemis"
      Event = "ArtemisGift09"
    }
    {
      Id = "MelinoeField_4100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hahaha{#Prev}, baiklah."
      Speaker = "Melinoe"
      Event = "ArtemisGift09"
    }
    {
      Id = "MelinoeField_4101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku ingin memberikan satu botol terakhir, dan maksudku {#Emph}terakhir{#Prev} adalah sampai situasi kita akhirnya membaik. Tapi yang {#Emph}satu ini{#Prev} untuk teman-teman Nimfa-mu, {#Emph}bukan{#Prev} untukmu."
      Speaker = "Melinoe"
      Event = "ArtemisGift10"
    }
    {
      Id = "Artemis_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Apakah semua ceritaku tentang Callisto membuatmu tertarik padanya, Melinoë? Karena aku tidak keberatan berbagi, dan aku tahu {#Emph}dia{#Prev} juga begitu."
      Speaker = "Artemis"
      Event = "ArtemisGift10"
    }
    {
      Id = "MelinoeField_4102"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bukan! {#Prev}Maksudku, bukan itu niatku, hanya saja... jika mereka dekat denganmu dan menghiburmu, aku sangat berterima kasih pada mereka. Mereka pasti mencemaskanmu."
      Speaker = "Melinoe"
      Event = "ArtemisGift10"
    }
    {
      Id = "Artemis_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak paham {#Emph}kenapa{#Prev}, padahal aku selalu menyuruh mereka untuk tidak cemas. Tapi sungguh, terima kasih. Akan kuberikan ini di kesempatan berikutnya, kusampaikan salam darimu. Tapi pertama-tama, janjikan satu hal padaku."
      Speaker = "Artemis"
      Event = "ArtemisGift10"
    }
    {
      Id = "MelinoeField_4103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru saja memberimu beberapa botol Ambrosia dan kau masih meminta janji juga? Mau janji apa, memangnya?"
      Speaker = "Melinoe"
      Event = "ArtemisGift10"
    }
    {
      Id = "Artemis_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa bertahan di permukaan untuk sementara waktu, jadi... ikutlah bersama kami ke hutan sesekali. Tidak perlu buru-buru, tunggu sampai semua ini usai. Kurasa kau pasti akan menyukainya."
      Speaker = "Artemis"
      Event = "ArtemisGift10"
    }
    {
      Id = "MelinoeField_4104"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Baiklah. Saat semua ini berakhir, aku berjanji akan menemui teman-teman Nimfa-mu di hutanmu, dan menikmatinya."
      Speaker = "Melinoe"
      Event = "ArtemisGift10"
    }
    {
      Id = "Artemis_0398"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupegang janjimu."
      Speaker = "Artemis"
      Event = "ArtemisGift10"
    }
    {
      Id = "Melinoe_1732"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sungguh? Kau memang yang terbaik."
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.GiftGivenVoiceLines"
    }
    {
      Id = "Artemis_0036"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akhirnya berhasil melacakmu..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0037"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tiba secepat mungkin."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0038"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku melindungimu, Saudari!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Banyak target terdeteksi."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0040"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini takkan memakan waktu lama."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bertahanlah, Saudari!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka takkan sadar apa yang menghantam mereka."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo kita habisi cecunguk-cecunguk ini."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah, pas banget buat latihan menembak!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kusiapkan tembakan perlindungan!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0046"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu dia mereka..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu dia kau..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0048"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Perburuan dimulai..."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ketemu."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0409"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ngapain kamu masih di sini, Saudari?"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_5656"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berhasil memanggil Saudari Artemis...!"
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Melinoe_1238"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku kenal suara itu..."
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Melinoe_1239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Artemis...!"
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Melinoe_1240"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mampus kalian sekarang, cecunguk."
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Melinoe_1241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lepaskan tembakanmu, Saudari!"
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Melinoe_1242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Awas jangan sampai kena aku!"
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Melinoe_1243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu datang tepat waktu."
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Melinoe_1244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar kubuat mereka sibuk untukmu!"
      Speaker = "Melinoe"
      Event = "NPC_Artemis_01.EncounterStartVoiceLines"
    }
    {
      Id = "Artemis_0078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Awas!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.PlayerInjuredReactionVoiceLines"
    }
    {
      Id = "Artemis_0079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.PlayerInjuredReactionVoiceLines"
    }
    {
      Id = "Artemis_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mundur!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.PlayerInjuredReactionVoiceLines"
    }
    {
      Id = "Artemis_0081"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu tidak apa-apa?"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.PlayerInjuredReactionVoiceLines"
    }
    {
      Id = "Artemis_0082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenang, Saudari!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.PlayerInjuredReactionVoiceLines"
    }
    {
      Id = "Artemis_0083"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sialan!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.PlayerInjuredReactionVoiceLines"
    }
    {
      Id = "Artemis_0084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menjauh!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.PlayerInjuredReactionVoiceLines"
    }
    {
      Id = "Artemis_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka bakal bayar mahal untuk itu!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.PlayerInjuredReactionVoiceLines"
    }
    {
      Id = "Artemis_0235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak, bertahanlah...!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.LastStandReactionVoiceLines"
    }
    {
      Id = "Artemis_0236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sialan...!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.LastStandReactionVoiceLines"
    }
    {
      Id = "Artemis_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Melinoë...!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.LastStandReactionVoiceLines"
    }
    {
      Id = "Artemis_0238"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu baik-baik saja?!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.LastStandReactionVoiceLines"
    }
    {
      Id = "Artemis_0239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cari perlindungan...!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.LastStandReactionVoiceLines"
    }
    {
      Id = "Artemis_0240"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mundur...!"
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.LastStandReactionVoiceLines"
    }
    {
      Id = "Artemis_0050"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berkurang satu."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.KillingEnemyVoiceLines"
    }
    {
      Id = "Artemis_0051"
      InheritFrom = "BaseSubtitle"
