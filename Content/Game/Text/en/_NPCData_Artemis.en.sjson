      Event = "NPC_Artemis_01.ExitVoiceLines"
    }
    {
      Id = "Artemis_0311"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tetap tenang di luar sana."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.ExitVoiceLines"
    }
    {
      Id = "Artemis_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Anggap saja aku tak pernah ke sini."
      Speaker = "Artemis"
      Event = "NPC_Artemis_01.ExitVoiceLines"
    }
    {
      Id = "Artemis_0313"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menyusuplah tanpa terlihat."
