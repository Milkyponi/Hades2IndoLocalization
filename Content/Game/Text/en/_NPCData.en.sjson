    {
      Id = "Zeus_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah cukup keterlaluanmu, Typhon!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aku {#Prev}yang kau cari, monster!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih ada sambaran petir lain untukmu, Typhon!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada hadiah istimewa juga untukmu, Typhon!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berani-beraninya kau menampakkan muka lagi, Typhon?!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku masih punya persediaan petir berlimpah, Typhon!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau balas dendam, Typhon? Ayo {#Emph}ambil {#Prev}sendiri!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita lihat kau tahan {#Emph}ini {#Prev}atau tidak, monster terkutuk!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasakan murka Olympus, dasar makhluk keparat!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau memanggilku, binatang buas tak berotak?!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0213"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buka telingamu, akulah yang datang, iblis hina!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sudah tiba, Melinoë! Sekarang minggirlah!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0215"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nona muda, biar aku yang urus sisanya!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seluruh keluarga besar berdiri di belakangmu, nona muda!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Monster itu takkan boleh mendaki sebongkah batu pun lagi!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0218"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semuanya{#Prev}, pinjamkan kekuatan kalian padaku!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bangsa Olympus, kerahkan semua yang kita punya padanya!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0360"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mencariku, Typhon?"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0361"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih ingat sambaran kilat lamaku, Typhon?"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita pernah melakukannya dulu, dan kita akan melakukannya lagi!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0357"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Puncak gunung ini hanya milik para dewa!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0355"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Majulah, sisa-sisa kebusukan monster, aku melihatmu di sana!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0358"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pada akhirnya kami akan menyingkirkanmu untuk selamanya, monster!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0359"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan bayang-bayang kemungkinanmu akan kami musnahkan sampai ke akar!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0362"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Typhon! Takkan kami sisakan sebutir debu pun dari dirimu!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Belum kapok juga kau rupanya, Typhon?!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sepertinya tak pernah belajar dari masa lalu, Typhon!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami akan mengalahkanmu berulang kali tanpa henti, monster!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah lupa dengan kejadian tadi malam, monster?!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau baik-baik saja?!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bertahanlah, Melinoë!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0238"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan menyerah!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Teruslah bertarung!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Zeus_0240"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buat dia tetap sibuk!"
      Speaker = "Zeus"
      Event = "NPC_Zeus_01.TyphonAttackArrivalVoiceLines"
    }
    {
      Id = "Hades_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Nyx?"
      Speaker = "Hades"
      Event = "NyxNightmare01"
    }
    {
      Id = "Hades_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyx? {#Emph}Nyx! Jawab aku! {#Prev}Sialan...."
      Speaker = "Hades"
      Event = "NyxNightmare01"
    }
    {
      Id = "Melinoe_5068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sesuai kehendakmu."
      Speaker = "Melinoe"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku siap melayanimu."
      Speaker = "Melinoe"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam hormatku padamu."
      Speaker = "Melinoe"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5071"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga kau selalu baik-baik saja, Sang Malam."
      Speaker = "Melinoe"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku merasa terhormat, Sang Malam."
      Speaker = "Melinoe"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih atas segalanya."
      Speaker = "Melinoe"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Nyx_0018"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hmm."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Nyx_0019"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hm."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Nyx_0020"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuterima ini."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Nyx_0021"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pula dirimu."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Nyx_0022"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Nyx_0023"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berterima kasih."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Nyx_0024"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama-sama."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.InteractVoiceLines"
    }
    {
      Id = "Nyx_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya?"
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.OnHitVoiceLines"
    }
    {
      Id = "Nyx_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hm?"
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.OnHitVoiceLines"
    }
    {
      Id = "Nyx_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Descura..."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.OnHitVoiceLines"
    }
    {
      Id = "Nyx_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lim dan Oros..."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.OnHitVoiceLines"
    }
    {
      Id = "Nyx_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ygnium..."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.OnHitVoiceLines"
    }
    {
      Id = "Nyx_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Zorephet..."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.OnHitVoiceLines"
    }
    {
      Id = "Nyx_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Revaal..."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.OnHitVoiceLines"
    }
    {
      Id = "Nyx_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Xinth..."
      Speaker = "Nyx"
      Event = "NPC_Nyx_Story_01.OnHitVoiceLines"
    }
    {
      Id = "Nyx_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh tak biasa melihatmu di sini. Leluhur agungku dan diriku punya banyak hal untuk dibicarakan, dan akan melanjutkannya setelah kepergianmu."
      Speaker = "Nyx"
      Event = "NyxInChaos01"
    }
    {
      Id = "MelinoeField_4234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh... maafkan kelancanganku karena telah menyela. Apakah engkau akan segera mengunjungi kami di Persimpangan lagi, wahai Sang Malam?"
      Speaker = "Melinoe"
      Event = "NyxInChaos01"
    }
    {
      Id = "Nyx_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kunjungan sesekali mungkin saja terjadi, terutama setelah Graha Hades dipulihkan sepenuhnya. Meski demikian, harapanku adalah agar anak-anakku bisa mandiri seutuhnya tanpa pengaruh dariku."
      Speaker = "Nyx"
      Event = "NyxInChaos01"
    }
    {
      Id = "MelinoeField_4235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak ibu pasti merasakan hal yang sama."
      Speaker = "Melinoe"
      Event = "NyxInChaos01"
    }
    {
      Id = "Nyx_0044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tidak tahu bagaimana perasaan mereka, aku hanya tahu perasaanku sendiri."
      Speaker = "Nyx"
      Event = "NyxInChaos01"
    }
    {
      Id = "Nyx_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chaos biasanya enggan terlibat dalam urusan Dunia Bawah ataupun alam fana, jadi ini adalah pengecualian. Pada suatu waktu kami menjadi lebih dekat sebagai keluarga, barangkali karena kami belajar dari keluargamu."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutChaos01"
    }
    {
      Id = "MelinoeField_4669"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluargaku rasanya selalu berada di ambang kehancuran. Cobaan ini mungkin telah mempererat ikatan kami, tapi... terkadang aku takut ikatan itu takkan bertahan selamanya."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutChaos01"
    }
    {
      Id = "Nyx_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ikatan yang renggang bisa ditempa kembali. Itulah alasanku berada di sini bersama Chaos, untuk memulainya dari kerabat tertuaku, lalu berlanjut ke bawah... proses yang panjang, namun memang perlu."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutChaos01"
    }
    {
      Id = "MelinoeField_4670"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga membuahkan hasil yang baik."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutChaos01"
    }
    {
      Id = "Nyx_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anakku ada banyak, namun ibumu sang Ratu tidak demikian. Karena itu aku merasa sedih ia tak bisa hadir menyaksikan awal pertumbuhanmu. Meski begitu, aku senang kita mengingat sebuah kemungkinan yang lebih bahagia."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutPersephone01"
    }
    {
      Id = "MelinoeField_5176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami telah kembali ke kehidupan satu sama lain, dan berbagi kenangan indah... tak banyak lagi yang kuharapkan. Ratu Persephone pastilah beruntung mendapat bimbingan dari ibu paling berpengalaman yang pernah ada di dunia!"
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutPersephone01"
    }
    {
      Id = "Nyx_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini masih menjadi proses pembelajaran, walau aku membagikan pengetahuan yang kumiliki. Namun intuisi ibumu dalam hal itu sering kali lebih unggul dariku."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutPersephone01"
    }
    {
      Id = "MelinoeField_4672"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sendiri tak sabar untuk mengenalnya lebih baik. Apakah kalian berdua selalu sedekat ini?"
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutPersephone01"
    }
    {
      Id = "Nyx_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu adalah waktu yang sangat lama. Namun, Ratu Persephone dan aku, kami telah dekat sejak sebelum kelahiran kakakmu, dan terus demikian hingga kini."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutPersephone01"
    }
    {
      Id = "MelinoeField_4673"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih sudah menjaga beliau."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutPersephone01"
    }
    {
      Id = "Nyx_0050"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan selalu melakukannya."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutPersephone01"
    }
    {
      Id = "Nyx_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin tahu, dahulu aku pernah memimpin seluruh Dunia Bawah seorang diri. Tiba suatu masa ketika hal itu melebihi kemampuanku, hingga putri-putriku, Tiga Fates, memilih seseorang untuk membantu mengatur alam ini: Ayahmu."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutHades01"
    }
    {
      Id = "MelinoeField_4677"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu adalah saat beliau berpisah dari saudara-saudara dan saudari angkatnya... yang kelak menjadi kaum Olimpus. Pasti masa-masa yang penuh pergolakan."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutHades01"
    }
    {
      Id = "Nyx_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu adalah masa perubahan. Aku tak menyangka Hades akan langsung mengemban perannya dengan begitu siap, sebab tugas itu teramat berat. Maupun bahwa Persephone akan membawa kehidupan ke tempat ini dengan begitu menyenangkan. Dan kini {#Emph}kau {#Prev}dan kakakmu... alam ini menjadi jauh lebih baik berkat kalian."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutHades01"
    }
    {
      Id = "MelinoeField_4678"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, wahai Nyx."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutHades01"
    }
    {
      Id = "Nyx_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa Aspek Black Coat milikku. Sudah lama sekali sejak terakhir kali aku sendiri menggunakannya. Kini aku menyelesaikan sebagian besar konflik secara tak langsung, tapi terkadang aku teringat akan kekuatan Xinth."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutNyxAspect01"
    }
    {
      Id = "MelinoeField_4674"
      InheritFrom = "BaseNarrative"
      DisplayName = "Merupakan kehormatan mendalam bagiku dipercaya memegang kekuatan itu, wahai Malam. Sebagian besar konflik yang {#Emph}kuhadapi {#Prev}akhir-akhir ini... hanya pendekatan langsung yang tampaknya berhasil."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutNyxAspect01"
    }
    {
      Id = "Nyx_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham hal itu bisa terjadi, atau terlihat seperti itu. Sejauh ini, keenam Nocturnal Arm telah melayani kita dengan baik. Saat aku sendiri tak mampu menjaga alam ini, merekalah yang melakukannya."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutNyxAspect01"
    }
    {
      Id = "Nyx_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sabit itu... pastilah Zorephet dalam Aspek yang diperuntukkan bagi Thanatos-ku. Dia mungkin akan segera menginginkannya kembali."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutThanatosAspect01"
    }
    {
      Id = "MelinoeField_4675"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku belum memikirkan hal itu. Nah, jika waktunya telah tiba bagi Zorephet untuk kembali bersama Thanatos, aku bersyukur atas waktu yang telah kami lewati, dan kini kupercayakan padamu, wahai Malam."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutThanatosAspect01"
    }
    {
      Id = "Nyx_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudku bukan {#Emph}secepat {#Prev}ini. Dunia Bawah belum siap bagi putraku untuk menjalankan tugasnya. Kau tetap menjadi pembawa Moonstone Axe sampai saat itu tiba."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutThanatosAspect01"
    }
    {
      Id = "MelinoeField_4676"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oh... {#Prev}syukurlah."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutThanatosAspect01"
    }
    {
      Id = "Nyx_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baktimu bagi alam ini mungkin tak terlihat, namun tidak luput dari perhatian, wahai Putri Melinoë. Seiring Ketakutan menyebar, demikian pula pengaruh kita."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutShrine01"
    }
    {
      Id = "MelinoeField_4683"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam bayang-bayang aku mengabdi; ke bayang-bayang aku kembali, wahai Malam. Dan terjadilah kehendakmu."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutShrine01"
    }
    {
      Id = "Nyx_0065"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika memang itu kehendakmu sendiri."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutShrine01"
    }
    {
      Id = "Nyx_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wasiat-wasiatku dalam Sumpah telah ditunaikan hingga titik terakhir. Kendati kemahiranmu telah terbukti, tadinya aku ragu apakah kau memiliki kesanggupan itu."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutShrine02"
    }
    {
      Id = "MelinoeField_4684"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun sempat ragu apakah aku sanggup, wahai Malam. Jika keyakinanku tak pernah goyah, maka tak ada lagi yang perlu kubuktikan. Dan tak ada lagi yang perlu kuperjuangkan."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutShrine02"
    }
    {
      Id = "Nyx_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, tampaknya kini kau butuh sesuatu yang baru untuk diperjuangkan. Aku yakin Ketakutan akan selalu bisa disebarkan lebih jauh lagi..."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutShrine02"
    }
    {
      Id = "MelinoeField_4685"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selalu."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutShrine02"
    }
    {
      Id = "Nyx_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini berubah menjadi malam yang begitu menakutkan. Pengaruh alam kekuasaan kita menyebar jauh melampaui Dunia Bawah, ke alam fana, ke surga, dan seterusnya."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutShrine03"
    }
    {
      Id = "MelinoeField_4686"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ke surga dan seterusnya...? Gunung Olimpus terasa seperti puncak dunia... tak kusangka ada sesuatu di balik titik itu."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutShrine03"
    }
    {
      Id = "Nyx_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sendiri sudah pernah ke sana. Melampaui ruang, waktu, dan mimpi; demikian sabda sang Penyihir Crossroads. Menurut penilaianku, kau sudah melangkah teramat jauh."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutShrine03"
    }
    {
      Id = "MelinoeField_4687"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, jika kau memang berkata begitu..."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutShrine03"
    }
    {
      Id = "MelinoeField_4690"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin berterima kasih atas Hadiah dari Tabir, wahai Malam. Mendapatkan gelar sebagai Jawaramu barangkali merupakan kehormatan terbesar dalam hidupku."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutTrophyQuestComplete01"
    }
    {
      Id = "Nyx_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memiliki Hadiah dari Tabir. Kalau begitu, baguslah. Bagaimana caramu mendapatkannya, dan siapa yang menganugerahkan gelar itu?"
      Speaker = "Nyx"
      Event = "NyxInChaosAboutTrophyQuestComplete01"
    }
    {
      Id = "MelinoeField_4691"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... telah menyelesaikan ujian yang kau berikan, yang disampaikan oleh Komandan Schelemeus atas namamu... kecuali..."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutTrophyQuestComplete01"
    }
    {
      Id = "Nyx_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh ya, sang kerangka itu, tentu saja. Dulu aku mengenalnya dengan gelar yang berbeda. Kupercaya dia menjalankan {#Emph}ujian-ujianku{#Prev}, seperti yang kau sebutkan, dengan cakap?"
      Speaker = "Nyx"
      Event = "NyxInChaosAboutTrophyQuestComplete01"
    }
    {
      Id = "MelinoeField_4692"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, kurasa begitu... ya..."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutTrophyQuestComplete01"
    }
    {
      Id = "Nyx_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu bagus, juaraku."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutTrophyQuestComplete01"
    }
    {
      Id = "Nyx_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa anakku yang tinggal di Crossroads-mu... hubungan kami tidak selalu berjalan dengan baik. Dulu kupikir kegagalan ini semata-mata salahku. Namun, aku sering melihat pola ini; semacam kutukan yang dimiliki keluarga kita bersama."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutChildren01"
    }
    {
      Id = "MelinoeField_4693"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membesarkan satu anak saja tampaknya sudah sangat sulit. Aku sendiri pasti bukan anak yang mudah diatur, dengan segala suasana hatiku. Sulit kubayangkan bagaimana caramu menghadapi Nemesis, atau Eris..."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutChildren01"
    }
    {
      Id = "Nyx_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di samping yang lainnya, ya. Aku selalu hadir dalam sebagian besar hidup anak-anakku, namun masing-masing dari mereka tetaplah sebuah misteri. Semoga hubungan Ratu Persephone denganmu tidak serapuh hubunganku dengan begitu banyak anakku."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutChildren01"
    }
    {
      Id = "MelinoeField_4694"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau bisa lebih sering mengunjungi anak-anakmu... memperbaiki keadaan..."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutChildren01"
    }
    {
      Id = "Nyx_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anak-anakku cenderung butuh ruang untuk diri mereka sendiri. Namun seperti yang kupelajari saat bersama Chaos, kita punya keabadian untuk kembali bersua, jika kita menghendakinya."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutChildren01"
    }
    {
      Id = "MelinoeField_4695"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sesuatu yang patut dinantikan."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutChildren01"
    }
    {
      Id = "Nyx_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak anakku yang tinggal dalam kegelapan, namun aku tahu di mana sebagian besar dari mereka berada. Kecuali putri-putriku, Tiga Fates. Sepengetahuanmu, mereka dibuang ke pengasingan?"
      Speaker = "Nyx"
      Event = "NyxInChaosAboutFates01"
    }
    {
      Id = "MelinoeField_4679"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar... Chronos berusaha menyingkirkan mereka, sebagai bagian dari penaklukannya. Kurasa dia cukup menyesalinya sekarang, tapi itu tidak membantu kita menemukan mereka. Apa yang bisa kita lakukan?"
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutFates01"
    }
    {
      Id = "Nyx_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita mencari pertanda. Jika Fated List telah mengungkap ramalan-ramalan kepadamu, maka beberapa jejak dari kekuatan mereka untuk berkomunikasi masih tersisa."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutFates01"
    }
    {
      Id = "MelinoeField_4680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita akan mencari pertanda itu."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutFates01"
    }
    {
      Id = "Nyx_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupercaya kamulah yang patut kuberi terima kasih karena telah membangunkan putraku Hypnos dari tidurnya dan membujuknya untuk kembali. Dia menjalankan tanggung jawabnya dengan cukup baik, sampai pada titik tertentu."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutHypnosWakeUp01"
    }
    {
      Id = "MelinoeField_4688"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mohon maafkan dia, Sang Malam. Dia pasti terlelap ke dalam kondisi seperti itu sebagai bentuk pertahanan diri ketika Titan Chronos menyerang. Aku lega dia baik-baik saja... dengan anggapan bahwa dia memang baik-baik saja?"
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutHypnosWakeUp01"
    }
    {
      Id = "Nyx_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia tetaplah dirinya yang biasa. Saudaranya, Thanatos, senang dia telah kembali, begitu pula saudaramu sendiri. Terima kasih telah menjaganya."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutHypnosWakeUp01"
    }
    {
      Id = "MelinoeField_4689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutHypnosWakeUp01"
    }
    {
      Id = "Nyx_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak menyangka akan melihat putraku Moros di Crossroads-mu, di antara yang lainnya. Hecate bilang dia membawakan Fated List kepadamu sebagai jawaban atas sebuah pemanggilan?"
      Speaker = "Nyx"
      Event = "NyxInChaosAboutMoros01"
    }
    {
      Id = "MelinoeField_4698"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku meminta bantuan Tiga Fates, mengetahui bahwa ramalan mereka pernah menghentikan Chronos sebelumnya. Yang Mulia Moros datang menggantikan mereka, dan telah tinggal bersama kami sejak saat itu. Dia sangat baik hati."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutMoros01"
    }
    {
      Id = "Nyx_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku belum pernah mendengar orang menggambarkannya seperti itu. Namun, kebanyakan orang hanya mengenalnya dari tugasnya. Dia pasti sangat mengkhawatirkan para Fates... rasa sakit karena kehilangan keluarga."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutMoros01"
    }
    {
      Id = "MelinoeField_4699"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia menghadapinya dengan baik, tapi ya, benar."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutMoros01"
    }
    {
      Id = "Nyx_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan putriku Nemesis cukup dekat, kata Hecate. Dia pasti membuat latihanmu begitu berat, karena dia selalu memimpin dengan kekuatan; menahan emosinya tapi tak menahan hal lainnya."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutNemesis01"
    }
    {
      Id = "MelinoeField_4700"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tumbuh bersamanya, aku yakin sekali bahwa beban tugasku akan jatuh ke pundaknya. Ketika hal itu tidak terjadi, hubungan kami sempat renggang, tapi... kurasa kami sudah baik-baik saja sekarang. Aku sangat peduli padanya... jika itu tidak apa-apa bagimu."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutNemesis01"
    }
    {
      Id = "Nyx_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa yang kau pedulikan bukanlah wewenangku untuk menentukan. Tampaknya ikatan kalian justru semakin kuat dari tekanan keadaan yang kalian hadapi. Namun Nemesis akan selalu menantangmu."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutNemesis01"
    }
    {
      Id = "MelinoeField_4701"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku memang tak mengharapkan yang sebaliknya."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutNemesis01"
    }
    {
      Id = "Nyx_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putraku Charon masih setia melayani alam baka tanpa kenal lelah, sejauh yang kulihat. Tak lama lagi, Wangsa Hades akan membutuhkannya kembali."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutCharon01"
    }
    {
      Id = "MelinoeField_4702"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari apa yang bisa kutangkap, kurasa dia akan menyambut hal itu dengan senang hati. Seharusnya dia mengantarkan para arwah, bukan perbekalan medan perang."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutCharon01"
    }
    {
      Id = "Nyx_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia akan melakukan apa yang dibutuhkan oleh alam baka. Kau mengaku memahaminya, kalau begitu? Dia bisa sangat sulit dimengerti oleh sebagian orang."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutCharon01"
    }
    {
      Id = "MelinoeField_4703"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa aku memahaminya!"
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutCharon01"
    }
    {
      Id = "Nyx_0086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nyx: {#Emph}Hm."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutCharon01"
    }
    {
      Id = "Nyx_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar putriku Eris? Aku menyayangkan Hecate harus menghadapinya saat aku tidak ada. Aku tak menyangka si biang Pertikaian itu sudi berdiam di satu tempat."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutEris01"
    }
    {
      Id = "MelinoeField_4696"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, si biang Pertikaian. Meski Eris terkadang menyusahkan, terlepas dari perbedaan kami, kami saling memahami. Berada di dekatnya... terasa seru, jika tidak ada hal lain yang bisa dikatakan."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutEris01"
    }
    {
      Id = "Nyx_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu lebih baik daripada apa yang bisa kukatakan. Namun aku belajar banyak darinya."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutEris01"
    }
    {
      Id = "MelinoeField_4697"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pula aku."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutEris01"
    }
    {
      Id = "Nyx_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memiliki berkah dari Mata Malamku yang setia. Dia bisa diandalkan; sifat yang sangat kujunjung tinggi di atas segalanya. Kalian berdua dekat?"
      Speaker = "Nyx"
      Event = "NyxInChaosAboutSelene01"
    }
    {
      Id = "MelinoeField_4706"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia selalu menjagaku sejak aku masih sangat kecil. Aku bangga bisa memanggilnya Saudari sekarang, dan bisa bekerja sama dengannya secara langsung dalam semua ini."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutSelene01"
    }
    {
      Id = "Nyx_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari apa yang kupahami, sang Rembulan sendiri merasakan hal yang persis sama. Semoga kalian berdua selalu menerangi kekuatan terbaik satu sama lain."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutSelene01"
    }
    {
      Id = "MelinoeField_4707"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pujianmu sangat berharga bagi kami."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutSelene01"
    }
    {
      Id = "Nyx_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan berkah dari dewa perang. Aku belum pernah mengunjunginya atau para Olympian sejak aku berhalangan."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutAres01"
    }
    {
      Id = "MelinoeField_4704"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir mereka tahu kalau Anda punya banyak urusan saat ini, wahai Malam. Apakah Anda dulunya sering pergi ke permukaan?"
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutAres01"
    }
    {
      Id = "Nyx_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengaruhku membentang ke seluruh penjuru alam. Dan aku pernah beberapa kali berinteraksi dengan Tuan Ares dan dewi Athena, serta yang lainnya. Namun itu bukan kebiasaan rutin."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutAres01"
    }
    {
      Id = "MelinoeField_4705"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yakin mereka akan menantikan pertemuan Anda berikutnya."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutAres01"
    }
    {
      Id = "Nyx_0089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebagian dari mereka takut padaku, kurasa, tapi ya."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutAres01"
    }
    {
      Id = "Nyx_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketenaran Sang Tak Kasatmata telah menyebar ke seluruh penjuru alam. Berkat usahamu, kini hampir tak ada lagi yang berani menentang Underworld."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutBadgeProgress01"
    }
    {
      Id = "MelinoeField_4708"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak Arwah setia di setiap wilayah yang berjaga untuk kita, selagi kita melenyapkan sisa-sisa ancaman yang sempat menimbulkan begitu banyak derita. Namun masih banyak yang harus dilakukan."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutBadgeProgress01"
    }
    {
      Id = "Nyx_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu ada hal yang harus dikerjakan, Putri Melinoë. Karena itulah saat-saat seperti ini sangat berharga untuk merenungkan seberapa jauh kemajuan kita, tak peduli seberapa jauh lagi jalan yang harus ditempuh."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutBadgeProgress01"
    }
    {
      Id = "MelinoeField_4709"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, wahai Malam."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutBadgeProgress01"
    }
    {
      Id = "Nyx_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak tanggung jawabku yang menumpuk selama sang Titan menyekapku sementara dalam jeratnya. Oleh karenanya, aku kemungkinan akan tetap tak terlihat untuk beberapa waktu. Sampai masa depan mempertemukan kita kembali, terima kasih sekali lagi, Putri Melinoë. Dan selamat tinggal untukmu."
      Speaker = "Nyx"
      Event = "NyxInChaosAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_4713"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat tinggal, wahai Malam..."
      Speaker = "Melinoe"
      Event = "NyxInChaosAboutSayingLittle01"
    }
    {
      Id = "Nyx_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kulihat kalian semua tampak menjalankan tanggung jawab dengan tekun. Tiap anakku adalah aset berharga bagi Penyihir Persimpangan Jalan selama ketidakhadiranku."
      Speaker = "Nyx"
      Event = "NyxWithNemesis01"
    }
    {
      Id = "Nemesis_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Apa pun titahnya kami turuti, Ibu. Kami sudah melakukan semampu kami."
      Speaker = "Nemesis"
      Event = "NyxWithNemesis01"
    }
    {
      Id = "Nyx_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan Hypnos, dia juga berada di sini selama seluruh cobaan ini berlangsung. Pastikan untuk menaruh rasa hormat yang sepantasnya kepada Hecate. Kalian boleh menetap di sini untuk sementara, selama masih ada yang harus dikerjakan, dan kalian semua terus bekerja sama. Apa bisa dimengerti?"
      Speaker = "Nyx"
      Event = "NyxWithNemesis01"
    }
    {
      Id = "Nemesis_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tentu saja, Ibu. Kami selalu bekerja sama di sini."
      Speaker = "Nemesis"
      Event = "NyxWithNemesis01"
    }
    {
      Id = "Nyx_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentang hal itu, kini aku yakin. Namun aku tak bisa berdiam diri untuk menyaksikannya dengan mataku sendiri, karena alam di bawah sana membutuhkanku. Selamat jalan, dan semoga kegelapan menuntunmu di mana cahaya rembulan tak mampu menjangkaunya."
      Speaker = "Nyx"
      Event = "NyxWithNemesis01"
    }
    {
      Id = "Nemesis_0430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, Ibu..."
      Speaker = "Nemesis"
      Event = "NyxWithNemesis01"
    }
    {
      Id = "Nyx_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hecate, kau telah melakukan semua yang kuharapkan, bahkan lebih. Anak-anakku yang sukar diatur tetap aman di bawah asuhanmu. Dan berkat kebijaksanaan petunjukmu, aku terbebas."
      Speaker = "Nyx"
      Event = "NyxWithHecate01"
    }
    {
      Id = "Hecate_0872"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu bermurah hati, wahai Nyx. Yang terpenting, aku bersyukur kau telah kembali pada kami. Bagaimana dengan anak-anakmu, apakah mereka akan ikut kembali bersamamu?"
      Speaker = "Hecate"
      Event = "NyxWithHecate01"
    }
    {
      Id = "Nyx_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka sudah dewasa, dan urusanku sangat banyak. Jika mereka berkehendak untuk tetap tinggal di Persimpangan Jalan ini, kumohon penuhilah. Kuharap mereka tidak menjadi beban?"
      Speaker = "Nyx"
      Event = "NyxWithHecate01"
    }
    {
      Id = "Hecate_0873"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Oh, tidak, tentu saja tidak."
      Speaker = "Hecate"
      Event = "NyxWithHecate01"
    }
    {
      Id = "Nyx_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus kalau begitu. Aku belum bisa memastikan kapan akan kembali lagi. Selamat tinggal."
      Speaker = "Nyx"
      Event = "NyxWithHecate01"
    }
    {
      Id = "Hecate_0874"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat jalan, wahai Nyx."
      Speaker = "Hecate"
      Event = "NyxWithHecate01"
    }
    {
      Id = "Nyx_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putri-putriku telah kembali pada kita. Mengenal mereka, mereka pasti memberi kesan seolah mereka kembali atas kemauan sendiri. Namun, jika bukan karena usahamu lewat Daftar Takdir, mereka mungkin takkan pernah menemukan jalan pulang."
      Speaker = "Nyx"
      Event = "NyxInChaosPostEpilogue01"
    }
    {
      Id = "MelinoeField_4681"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap nubuat yang terpenuhi menjadi sinyal bagi para Moirae... semacam suar penuntun di tengah kegelapan pengasingan mereka, begitukah?"
      Speaker = "Melinoe"
      Event = "NyxInChaosPostEpilogue01"
    }
    {
      Id = "Nyx_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu pemahaman yang cukup masuk akal. Kau telah memberikan bakti yang luar biasa bagi keluargaku, wahai Putri Melinoë. Besarnya rasa terima kasihku tak dapat terlukiskan dengan kata-kata."
      Speaker = "Nyx"
      Event = "NyxInChaosPostEpilogue01"
    }
    {
      Id = "MelinoeField_4682"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pujianmu sangat berharga bagiku, wahai Malam. Semoga kita semua tidak lagi kehilangan anggota keluarga untuk sementara waktu."
      Speaker = "Melinoe"
      Event = "NyxInChaosPostEpilogue01"
    }
    {
      Id = "Nyx_0063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga demikian jadinya."
      Speaker = "Nyx"
      Event = "NyxInChaosPostEpilogue01"
    }
    {
      Id = "Nyx_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami menyambutmu dalam kesunyian jurang abadi, Putri Melinoë."
      Speaker = "Nyx"
      Event = "NyxInChaosChat01"
    }
    {
      Id = "Nyx_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Griya Hades mulai tumbuh lebih perkasa dari yang pernah ada sebelumnya."
      Speaker = "Nyx"
      Event = "NyxInChaosChat02"
    }
    {
      Id = "Nyx_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chaos telah membayangkan kedatanganmu, dan kini kau berdiri di hadapan kami."
      Speaker = "Nyx"
      Event = "NyxInChaosChat03"
    }
    {
      Id = "Nyx_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kediaman ayahmu terkadang bisa sangat bising, karena itulah aku mencari ketenteraman di kedalaman ini."
      Speaker = "Nyx"
      Event = "NyxInChaosChat04"
    }
    {
      Id = "Nyx_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakakmu baik-baik saja di sana, dan dia sering memikirkan kabarmu."
      Speaker = "Nyx"
      Event = "NyxInChaosChat05"
    }
    {
      Id = "Nyx_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hypnos baru saja menanyakan tentangmu belum lama ini, seolah-olah aku belum pernah memberitahunya."
      Speaker = "Nyx"
      Event = "NyxInChaosChat06"
    }
    {
      Id = "Nyx_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap Eris tidak {#Emph}terlalu {#Prev}merepotkan akhir-akhir ini."
      Speaker = "Nyx"
      Event = "NyxInChaosChat07"
    }
    {
      Id = "Nyx_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum lama ini aku berpapasan dengan Nemesis saat berada di sini, dan kami berdua sempat membicarakanmu."
      Speaker = "Nyx"
      Event = "NyxInChaosChat08"
    }
    {
      Id = "Nyx_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Daftar Takdir tetap berada di bawah asuhanmu, dan kau memiliki Moros untuk mengawasinya."
      Speaker = "Nyx"
      Event = "NyxInChaosChat09"
    }
    {
      Id = "Nyx_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga Senjata Malam terus mewujudkan tekad dan murkamu."
      Speaker = "Nyx"
      Event = "NyxInChaosChat10"
    }
    {
      Id = "Nyx_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chaos dan aku punya ribuan warsa sejarah yang harus dibahas, jadi tolong jangan tunggu aku."
      Speaker = "Nyx"
      Event = "NyxInChaosChat11"
    }
    {
      Id = "Nyx_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini begitu mencekam, dan semua ini berkat dirimu beserta segala Sumpahmu."
      Speaker = "Nyx"
      Event = "NyxInChaosChat12"
    }
    {
      Id = "Nyx_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga berkat dari Selene yang setia menuntun langkahmu jauh melampaui batas ini."
      Speaker = "Nyx"
      Event = "NyxInChaosChat13"
    }
    {
      Id = "Nyx_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ratu Persephone kerap diliputi sukacita karena pada akhirnya kalian berdua telah bersua kembali."
      Speaker = "Nyx"
      Event = "NyxInChaosChat14"
    }
    {
      Id = "Nyx_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di balik kegelapan kita, tersimpan kekuatan. Berusahalah untuk menjadi bernilai, bukan sekadar dikenal."
      Speaker = "Nyx"
      Event = "NyxInChaosChat15"
    }
    {
      Id = "Nyx_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku dan Sang Asal Segala Penciptaan menyambut kedatanganmu di tempat ini sekali lagi."
      Speaker = "Nyx"
      Event = "NyxInChaosChat16"
    }
    {
      Id = "Nyx_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di sini begitu sunyi dan lengang, meski kali ini terasa sedikit lebih hidup dari biasanya."
      Speaker = "Nyx"
      Event = "NyxInChaosChat17"
    }
    {
      Id = "Nyx_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kusampaikan rasa terima kasihku atas sumbangsihmu dalam memulihkan alam kita."
      Speaker = "Nyx"
      Event = "NyxInChaosChat18"
    }
    {
      Id = "Nyx_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anak-anakku yang pernah bertemu atau mengingatmu kini menjadi pribadi yang lebih baik karenamu, wahai Melinoë, sang Putri."
      Speaker = "Nyx"
      Event = "NyxInChaosChat19"
    }
    {
      Id = "Nyx_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehadiranmu di Kediaman Hades diingat dengan amat baik dan cukup sering disebut-sebut."
      Speaker = "Nyx"
      Event = "NyxInChaosChat20"
    }
    {
      Id = "MelinoeField_4710"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin mempersembahkan sesuatu kepadamu, wahai Malam. Karena selalu menyembunyikan Persimpangan tempatku dibesarkan, atas Senjata Malam, dan segala anugerah berlimpah yang telah kau limpahkan."
      Speaker = "Melinoe"
      Event = "NyxGift01"
    }
    {
      Id = "Nyx_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuterima ini darimu, anakku. Dan semoga Senjata Malam bisa terus menemanimu bagaikan semacam kenang-kenangan dariku. Sang Penyihir Persimpangan berkata kau mengayunkannya dengan penuh keahlian dan keanggunan."
      Speaker = "Nyx"
      Event = "NyxGift01"
    }
    {
      Id = "MelinoeField_4711"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia bilang begitu, ya..."
      Speaker = "Melinoe"
      Event = "NyxGift01"
    }
    {
      Id = "MelinoeField_4712"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada hal lain yang ingin kuberikan kepadamu, wahai Malam. Karena telah merawat Saudari Selene, sahabat karibku, beserta anak-anakmu yang luar biasa yang kini telah kukenal."
      Speaker = "Melinoe"
      Event = "NyxGift02"
    }
    {
      Id = "Nyx_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Adat keluargamu bukan adatku, anakku. Aku pun tak pantas menerima rasa terima kasih sebesar itu di saat masih banyak hal yang mesti dituntaskan demi memulihkan alam ini ke kekuatan puncaknya. Terimalah rasa terima kasihku, beserta permohonanku itu."
      Speaker = "Nyx"
      Event = "NyxGift02"
    }
    {
      Id = "Zagreus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Emm... {#Prev}apa rambutku memutih dan wajahku jadi makin rupawan, atau aku baru saja makan sesuatu yang bikin perutku mulas...?"
      Speaker = "Zagreus"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "MelinoeField_3425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pangeran Zagreus, tolong dengarkan suaraku! Apa kau bisa mendengarku? Apa kau bisa {#Emph}mendengarku{#Prev}?"
      Speaker = "Melinoe"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "Zagreus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Pasti gara-gara salah makan tadi. Atau jangan-jangan... {#Emph}wah{#Prev}, ini cuma mimpi...! Hypnos {#Emph}makin {#Prev}nekat saja bikin mimpi begini! Apa itu kau di balik sana, Sobat?"
      Speaker = "Zagreus"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "MelinoeField_3426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, aku... dengar, ya, secara teknis ini memang mimpi. Tapi hanya ini satu-satunya caraku menghubungimu menembus bentangan Waktu! Sekarang, {#Emph}kumohon! {#Prev}Keluarga kita sedang dalam bahaya, dan aku butuh bantuanmu!"
      Speaker = "Melinoe"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "Zagreus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tenang, tenang dulu, jangan buru-buru! Untunglah aku memang agak {#Emph}suka {#Prev}mimpi yang terasa nyata begini. Dan apa maksudmu {#Emph}keluarga kita? {#Prev}Memangnya kau {#Emph}siapa{#Prev}? Mungkin salah satu dari sepupu Ibu yang sekian banyak itu. Tapi warna matanya beda. Belum lagi lambang Ayah di pakaianmu..."
      Speaker = "Zagreus"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "MelinoeField_3427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biarkan aku bicara! Dengar, ini memang bakal sulit kau terima, tapi... aku Melinoë... adikmu. Berasal dari waktu yang lain; masa depan, yang sebenarnya tidak terlalu jauh dari masamu!"
      Speaker = "Melinoe"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "Zagreus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tuh, kan, tebakanku selanjutnya pasti begitu. Jadi, wahai adik-dalam-mimpi-dari-masa-depan? Rasanya sayang sekali kalau aku langsung terbangun sebelum mendengarkan ceritamu, jadi bagaimana situasinya? Apa yang kau inginkan dariku...?"
      Speaker = "Zagreus"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "MelinoeField_3428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin kau mencari kakek kita, Chronos, dan menghancurkannya! Karena kemampuanku di sini sangat terbatas. Dia telah merebut seluruh Kediamanmu...! Mengurung Ayah, Ibu, dirimu, {#Emph}semua orang...! {#Prev}Dan kini dia mengancam Olympus. Semuanya demi membalas dendam atas apa yang dulu dilakukan para dewa."
      Speaker = "Melinoe"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "Zagreus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Oke. Waktu kau bilang {#Emph}apa yang dulu dilakukan para dewa{#Prev}, maksudmu bagian di mana mereka melenyapkan Chronos untuk selamanya, jauh sebelum aku lahir? Atau sebelum {#Emph}kau {#Prev}lahir juga. Tapi di masa depan yang tak-terlalu-jauh itu, dia bangkit lagi, lalu menguasai segalanya seorang diri...?"
      Speaker = "Zagreus"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "MelinoeField_3429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Iya. Percayalah padaku! Waktu itu aku masih sangat kecil saat sang Titan menyerang, dan aku telah berlatih seumur hidupku demi mempersiapkan saat-saat ini! Tapi aku tak bisa menghentikan Chronos sendirian. Maukah kau membantuku?"
      Speaker = "Melinoe"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "Zagreus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa tidak, ya? Berhubung ini cuma mimpi, paling-paling aku langsung lupa begitu terbangun nanti! Lagipula, paras dan suaramu persis seperti bayangan yang diciptakan otakku dalam mimpi. Apa kau bisa {#Emph}membuktikan {#Prev}omonganmu itu?"
      Speaker = "Zagreus"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "MelinoeField_3430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau takkan melupakanku saat bangun nanti, aku berjanji. Mengenai bukti yang kau cari... kau pasti tahu tentang Hecate, pelayan ibu kita! Dia yang melatihku untuk menghadapi ini. Temui dia, dan katakan apa yang kubilang—tapi jangan ke orang lain!"
      Speaker = "Melinoe"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "Zagreus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Emm{#Prev}, Adikku, kurasa Ibu {#Emph}tidak punya {#Prev}pelayan yang seperti itu... tapi anehnya, kau menyebut nama yang sama sekali belum pernah kudengar, dan itu malah jadi bukti yang lebih meyakinkan daripada semua ceritamu tadi. Tunggu, ada apa...?"
      Speaker = "Zagreus"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "MelinoeField_3431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu Chronos! Aku berhasil melumpuhkannya, tapi dia akan kembali... sama seperti yang nantinya akan dia lakukan di masamu. Aku harus pergi... sebelum dia menemukanku di sini, aku harus pergi!"
      Speaker = "Melinoe"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "Zagreus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau baru saja sampai! Dengar... Melinoë, kan? Apa aku bakal bertemu denganmu lagi, atau ini cuma sekali ini saja?"
      Speaker = "Zagreus"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "MelinoeField_3432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menemukanmu melintasi mimpi dan waktu, Kak. Aku akan berusaha sekuat tenaga untuk melakukannya lagi! Sampai saat itu tiba, kumohon, biarkan ini jadi rahasia di antara kita."
      Speaker = "Melinoe"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "Zagreus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Baguslah, memberi tahu Hypnos saja aku tak boleh. Ya sudah, terserah kau! Sampai jumpa di lain hari, Dik. Atau lain malam...?"
      Speaker = "Zagreus"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "MelinoeField_3433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa nanti!"
      Speaker = "Melinoe"
      Event = "ZagreusPastFirstMeeting"
    }
    {
      Id = "Zagreus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat saat aku baru mau merapikan rambutku! Siapa kau, dan apa yang kaulakukan pada bayanganku...? Cuma bercanda. Aku ingat semuanya persis seperti katamu. Terlebih karena kau sudah ada di sini lagi secepat ini. Sampai di mana kita tadi?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "MelinoeField_3437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sedang berusaha meyakinkanmu agar memercayai kata-kataku bahwa aku adikmu dari masa depan, saat Titan Chronos telah merebut Graha Hades. Aku berniat menghentikannya, dan aku butuh bantuanmu."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "Zagreus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya segudang pertanyaan dulu, meski aku tahu waktu kita tampaknya terbatas. Pertama-tama, kenapa harus {#Emph}aku? {#Prev}Walau aku {#Emph}memang {#Prev}Spesialis Keamanan yang ditunjuk di sini, jadi mungkin aku sudah tahu jawabannya."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "MelinoeField_3438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Spesialis Keamanan apanya. Chronos menyergap seisi Graha tanpa persiapan sama sekali! Tapi kau kerabat terdekatku, kau pernah menentang kehendak Para Takdir, dan membunuh para dewa, meski bukan Titan... Lagipula aku tak punya cara untuk menghubungi siapa pun selain dirimu lewat cara ini."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "Zagreus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, hebat sekali! Ikatan persaudaraan kita sudah terasa begitu erat. Pertanyaan berikutnya: Di mana sebenarnya Chronos ini {#Emph}berada{#Prev}, dan apa yang kauingin kulakukan jika dan saat aku menemukannya? Dua pertanyaan sekaligus untukmu."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "MelinoeField_5208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak tahu pasti di mana Chronos berada di masamu, walau aku punya petunjuk: Sisa-sisa jasadnya disebarkan ke ceruk terdalam Tartarus, yang artinya dia kemungkinan sedang memulihkan diri di bawah tempat tinggalmu. Soal apa yang harus dilakukan jika kau berhasil menemukannya... belum ada untuk sekarang. Kita akan bahas itu nanti."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "Zagreus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Emm{#Prev}, tak enak harus mengatakannya padamu, Melinoë, tapi rencanamu ini tidak begitu matang. Terutama untuk sesuatu yang sudah kaupersiapkan seumur hidupmu. Apa aku cuma perlu menunggumu memikirkan rinciannya, atau...?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "MelinoeField_3440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan begitu! Dengar. Kau itu Spesialis Keamanan! Mulailah penyelidikan, tapi harus dirahasiakan rapat-rapat. Apakah ada yang janggal di suatu tempat di Graha, atau di Tartarus? Misalnya, ada aktivitas tak wajar dari para Satir?"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "Zagreus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami memang sempat berurusan dengan masalah Satir, walau tidak di dekat-dekat sini. Tapi aku bisa berkeliling memeriksanya. Bagaimana denganmu...? Tunggu, apa kau sedang ada di {#Emph}kamar tidurku?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "MelinoeField_3441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sisa-sisa kamarmu, ya! Aku hanya bisa menghubungimu seperti ini saat kita berada di tempat yang sama melintasi Waktu. Bagaimanapun juga... aku harus mencari cara agar kau bisa menghancurkan sang Titan di sana sebelum dia memulihkan kekuatan penuhnya. Tapi... sial."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "Zagreus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa, kau harus pergi lagi? Kalau begitu jangan tunda hanya demi aku. Akan kulihat apa yang bisa kulakukan dan kita bicara lagi saat nanti kau menghantui mimpiku. Jaga dirimu, Dik! Kita akan bereskan masalah ini."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "MelinoeField_3442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membuatnya terdengar begitu enteng... selamat tinggal, Kak. Sampai kita bertemu lagi nanti."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02"
    }
    {
      Id = "Zagreus_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hai, Melinoë! Penyelidikanku soal siasat kakek kita sudah dimulai, walau sulit membuat kemajuan berarti tanpa memberi tahu siapa pun apa yang sedang kulakukan. Jangan salah paham, tapi... apa benar cuma ini rencanamu?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "MelinoeField_5046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya. Kurasa aku tak bisa menghentikan Chronos di sini. Olympus sekalipun kewalahan menahan pasukannya. Dan dia terlalu penuh kebencian serta keras kepala untuk berhenti dengan sendirinya."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "Zagreus_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya begitulah keluarga kita. Ayah jelas-jelas tidak menyukai Chronos tapi beliau tak pernah membicarakannya. Apa kau... kebetulan tahu apa yang terjadi di antara mereka sampai-sampai keadaannya seburuk ini?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "MelinoeField_5047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Posisimu lebih memungkinkan untuk menanyakan hal itu pada ayah kita dibanding aku. Chronos adalah tiran, dan anak-anaknya tak sudi menerimanya! Para Takdir sendiri menetapkan bahwa para dewalah yang harus berkuasa! Namun itu tampaknya tidak cukup baginya."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "Zagreus_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi sekarang kau ingin aku menghentikannya untukmu. Maksudku, untuk {#Emph}kita. {#Prev}Pengalamanku mengalahkan anggota keluarga kita sebelumnya campur aduk, tapi... itu tidak {#Emph}selamanya. {#Prev}Dan kau hampir tidak mengatakan apa-apa soal bagaimana caraku melakukannya."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "MelinoeField_5048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar... aku tahu mantra yang disebut Penguraian Waktu. Mantra ini memerlukan beberapa langkah rumit yang akan kujelaskan nanti. Jika berhasil... ini seharusnya bisa mengurainya."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "Zagreus_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mengurainya. {#Prev}Itu agak terlalu samar bagiku, kecuali kalau Chronos ternyata adalah segulung benang. Bisa lebih spesifik?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "MelinoeField_5049"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Meniadakan keberadaannya. {#Prev}Menghancurkan ambisi beserta dirinya. Menghapus semua malapetaka yang dia timbulkan. Diperlukan tiga lapis ikatan keluarga: kau, aku, dan Chronos. Kemudian kita akan menanamkan peniadaan atas wujudnya ke dalam senjata khusus... Aku akan menjelaskannya nanti."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "Zagreus_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Wah luar biasa, kurasa penjelasanmu barusan sudah memperjelas semuanya. Meski kuakui aku tidak suka harus membunuh anggota keluarga hanya karena Ayah tidak tahu cara akur dengan mereka."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "MelinoeField_5050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau malah menyalahkan Ayah dalam semua ini? {#Emph}Ugh{#Prev}, sial... Chronos mulai bangkit kembali. Aku harus pergi. Teruslah mencari tanda-tanda keberadaannya! Dan ingat, ini demi kita semua!"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "Zagreus_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti, dan... kurasa aku mengerti. Kita tak pernah minta dilahirkan ke dalam masalah ini, tapi inilah yang kita hadapi. Kita akan menanganinya sebaik mungkin."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "MelinoeField_5051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar sekali. Terima kasih, Kak. Jaga dirimu baik-baik... dan bersikap baiklah pada Ibu, Ayah, Cerberus, dan semuanya, demi aku."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting02_2"
    }
    {
      Id = "Zagreus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Halo lagi, Dik. Kau memintaku mencari tanda-tanda kalau Chronos sedang menyiapkan kejutan besar, dan... meski tak seberapa... aku {#Emph}memang {#Prev}menemukan mesin di Tartarus yang tampak agak ganjil."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting03"
    }
    {
      Id = "MelinoeField_3443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mesin... maksudmu roda-roda gigi yang memutar ruangan-ruangan yang terus berganti itu. Di masaku, mesin-mesin itu telah menyebar ke seantero Tartarus sejauh mataku memandang. Menurutmu apa maksudnya?"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting03"
    }
    {
      Id = "Zagreus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... biasanya aku tak akan memikirkannya, tapi mungkin saja itu berkaitan dengan yang kaukatakan. Aku sedang melacak ke mana arah jalurnya. Bagaimana denganmu, ada petunjuk soal langkah kita selanjutnya?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting03"
    }
    {
      Id = "MelinoeField_3444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita butuh senjata. Masalahnya, Chronos kebal terhadap Pusaka yang dulu digunakan untuk menaklukkannya. Ditambah lagi, senjata itu harus ada baik di masamu maupun di masaku. Makin erat kaitannya dengan keluarga kita, makin baik. Apa kau terpikir sesuatu yang cocok?"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting03"
    }
    {
      Id = "Zagreus_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tak ada yang langsung terlintas di benakku. Aku punya beberapa senjata manusia fana di kamarku tapi hampir tak pernah bisa diandalkan. Senjata yang ada di masaku dan juga di masamu... dan Pusaka Neraka sama sekali tak bisa dipakai..."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting03"
    }
    {
      Id = "MelinoeField_3445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pikirkanlah baik-baik, tapi kumohon bergegaslah. Cepat atau lambat Chronos akan menyadari apa yang sedang kuupayakan di sini, dan sambungan ini makin melemah setiap malam. Untuk sekarang, sebaiknya aku pergi."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting03"
    }
    {
      Id = "Zagreus_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu sebentar! Bagaimana dengan para pelayan di Griya ini... teman-temanku? Cinta dalam hidupku? Kau bilang Chronos merenggut semuanya. Maksudmu {#Emph}semuanya{#Prev}-semuanya, atau...?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting03"
    }
    {
      Id = "MelinoeField_3446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... tidak juga, {#Emph}err{#Prev}, Hypnos ada bersama kami, tapi dia tertidur lelap. Komandan Schelemeus juga; dia sedang memobilisasi Arwah yang masih setia pada ayah kita. Cerberus yang malang dibuang ke Padang Duka. Tapi yang lainnya..."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting03"
    }
    {
      Id = "Zagreus_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, setidaknya sang {#Emph}Komandan Schelemeus {#Prev}yang hebat berhasil selamat. Tapi Nyx, Achilles, Thanatos, Megaera, Dusa, Orpheus... kakek kita mengurung mereka semua?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting03"
    }
    {
      Id = "MelinoeField_3447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia merantai ayah kita di Tartarus. Setahuku dia menjebak yang lainnya... membekukan mereka dalam Sang Waktu. Tapi kita bisa membebaskan mereka dari cengkeramannya. Aku yakin sekali kita bisa. Sampai jumpa lagi, Kakak! Pikirkan senjata yang bisa kita gunakan untuk meluruskan semua ini."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting03"
    }
    {
      Id = "Zagreus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Gigaros. {#Prev}Tombak milik Ayah. Kau bilang kita butuh senjata yang ada di kedua era kita, punya ikatan dengan keluarga kita, dan belum pernah dipakai membantai Chronos sebelumnya. Tombak itu pasti cocok. Bentuknya besar... dan serangannya menyakitkan."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04"
    }
    {
      Id = "MelinoeField_5103"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Huh... {#Prev}Masuk akal juga. Sayangnya, aku sama sekali tak tahu di mana menemukan Gigaros ini; mungkin Chronos sudah merebutnya. Tapi itu di eraku... sedangkan di era-{#Emph}mu..."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04"
    }
    {
      Id = "Zagreus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Yah{#Prev}, Ayah juga jarang sekali mengizinkanku memakainya, dan tombak itu disegel di kamarnya. Pasti ada senjata lain. Tapi, setidaknya aku menemukan tempat di mana Chronos mungkin sedang menyatukan kembali potongan tubuhnya sedikit demi sedikit!"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04"
    }
    {
      Id = "MelinoeField_3449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Di mana, apa yang terjadi? Bagaimana kau tahu tempat itu tepat?"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04"
    }
    {
      Id = "Zagreus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertama-tama, tempatnya sepertinya persis berada di bawah Griya ini! Tempat yang aneh untuk mengubur pendahulu sendiri, tapi selera Ayah memang {#Emph}bisa {#Prev}sangat khusus soal hukuman. Pokoknya saat aku turun lebih dalam ke Tartarus, aku menemukan sarang Satir yang membawaku ke semacam gua. Untuk saat ini aku belum melangkah lebih jauh."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04"
    }
    {
      Id = "MelinoeField_3450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus. Dan jangan masuk sampai semuanya siap. Tapi mari kita bahas lagi soal tombak ayah kita. Apa ada cara agar kau bisa mendapatkannya?"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04"
    }
    {
      Id = "Zagreus_0489"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja. Ayah menyimpannya di tempat terkunci, tapi tak ada Spesialis Keamanan andal yang bakal gentar begitu saja! Aku memang mempertaruhkan siksaan abadi, tapi Chronos pun tampaknya sudah menyiapkan hal yang sama untukku. Jadi... apa yang harus kulakukan pada Gigaros kalau aku berhasil mendapatkannya?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04"
    }
    {
      Id = "MelinoeField_5104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tinggalkan di sini di kamarmu agar bisa kutemukan. Bisakah kau membujuk ayah kita untuk memberikannya padamu, tanpa membeberkan alasan sebenarnya? Jika kita terlalu banyak mengutak-atik Waktu, Chronos akan mengetahuinya. Aku tak butuh wujud fisiknya, cukup esensinya saja yang dikirimkan melewati gerbang astral-psikis kita."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04"
    }
    {
      Id = "Zagreus_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rincian sepele, Adikku! Aku memang suka tantangan tak masuk akal, lagipula Ayah berutang budi padaku. Jadi kau ini semacam peramal, yang mengumpulkan pusaka kuno, lalu bicara padaku lewat mimpi dan semacamnya? Mungkin ini lebih cocok disebut mimpi buruk, mengingat masa depan kelam yang menanti."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04"
    }
    {
      Id = "MelinoeField_3452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita akan mengubah masa depan itu. Dan aku bukan peramal; aku Penyihir. Kita makin dekat dengan tujuan kita, Kakak. Dapatkan tombak Ayah, sementara aku punya urusan lain yang harus kuselesaikan. Kita akan segera bertemu lagi."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04"
    }
    {
      Id = "Zagreus_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar baik, Adikku! Butuh sedikit usaha, tapi aku berhasil membujuk ayah kita untuk meminjamkan tombak kesayangannya ini sebentar."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "MelinoeField_5105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Bagus sekali! Tapi, di mana senjatanya? Aku tak menemukan jejak senjata semacam itu saat melintasi tempat ini."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "Zagreus_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sudah kusimpan dengan aman, cuma... aku merasa agak ragu untuk menyerahkannya. Atau bagaimanapun caramu mengambilnya lewat apa pun sebutan gerbang astral-psikis itu."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "MelinoeField_5106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zagreus... aku butuh tombak itu. {#Emph}Kita {#Prev}butuh tombak itu. Keraguan apa lagi yang bisa mengganggumu sekarang?"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "Zagreus_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë... kau memintaku membantai anggota keluarga kita sendiri secara permanen, padahal aku belum pernah bertemu dengannya sama sekali. Aku tahu ini penting... tapi bukan berarti aku bersedia melakukannya. Aku bahkan tak tahu apa aku sanggup."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "MelinoeField_5108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu {#Emph}saja {#Prev}kau sanggup! Apa maksudmu kau tak {#Emph}bersedia {#Prev}melakukannya? Kita ini anak-anak dari Raja dan Ratu Underworld! Kita menunaikan apa yang menjadi kewajiban kita! Bukan sekadar menuruti apa yang kita inginkan."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "Zagreus_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ucapanmu persis seperti Ayah. Dulu pernah ada masa di mana aku sama sekali tak bisa berkomunikasi dengannya dan aku sangat berharap dia mati dan lenyap. Aku bersyukur tak pernah punya kemampuan untuk melakukannya... karena bisa saja aku melakukannya saat itu."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "MelinoeField_5109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ucapanku persis seperti Ayah? {#Emph}Bagus! {#Prev}Namun kau mulai lagi, membandingkannya dengan Chronos. Hanya karena mereka berkerabat bukan berarti mereka {#Emph}sama {#Prev}dalam hal apa pun. Situasi ini pun sama sekali tidak mirip dengan apa yang kau alami dulu!"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "Zagreus_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, entahlah! Situasiku dulu juga melibatkan anggota keluarga yang mati-matian berusaha saling bunuh!"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "MelinoeField_5110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berusaha untuk {#Emph}mencegah {#Prev}hal itu! {#Emph}Ugh{#Prev}, sial. Kita bahas ini lagi di malam lain. Aku tak bisa memaksamu bekerja sama denganku, tapi aku {#Emph}bisa {#Prev}menghantui mimpimu!"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "Zagreus_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, untung saja aku gampang terpengaruh ancaman! Obrolan yang menyenangkan. Sampai jumpa di waktu tidur berikutnya, kalau begitu?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "MelinoeField_5209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti! Dan camkan kata-kataku, kita akan {#Emph}memperbaiki {#Prev}situasi ini! Kita tak akan membiarkan keluarga kita hancur berantakan!"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_2"
    }
    {
      Id = "Zagreus_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh hai, Adikku. Kembali lagi untuk menghantui mimpiku? Aku merasa tak enak dengan bagaimana kita berpisah tempo hari, berdebat soal keluarga dan kewajiban kita. Lagipula, Ayah selalu bilang dilarang bertengkar di Griya ini."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "MelinoeField_5112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga merasa tidak enak soal itu, dan... aku tak bisa berhenti memikirkan apa yang kau katakan. Aku tahu kau bersikap jujur padaku tentang kekhawatiranmu. Semua ini pasti terlalu berat untuk dicerna sekaligus."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "Zagreus_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percayalah, aku berusaha mencernanya secepat mungkin. Kita punya kakek jahat yang melancarkan perang habis-habisan melawan sisa keluarga kita! Bagaimanapun caranya... dia harus dihentikan."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "MelinoeField_5113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar sekali. Dan aku telah dilatih untuk menghentikannya, meski sayangnya itu menuntutmu melakukan pekerjaan kotornya. Bagian terburuknya, malah. Aku... bisa mengerti mengapa kau ragu."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "Zagreus_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi apa yang harus kita lakukan? Anggap saja kita lanjut sesuai rencana. Aku memberikan Gigaros padamu, kau melakukan sesuatu padanya, lalu kupakai tombak itu untuk menghancurkan Chronos di era-{#Emph}ku {#Prev}sebelum dia berkuasa di eramu... kalau begitu, semuanya akan baik-baik saja?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "MelinoeField_5114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira begitu, ya! Kita tak bisa menebak secara pasti apa yang akan terjadi di dunia tanpa Sang Waktu, tapi dunia pernah berada dalam kondisi itu sebelumnya... dan itu tak akan lebih buruk daripada membiarkannya menang."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "Zagreus_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kalau Chronos musnah... apa yang akan terjadi padamu? Kau berada di sini karena semua perbuatan yang dia lakukan."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "MelinoeField_5115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan! Seandainya Chronos tak merebut takhta Ayah, kita pasti hidup bersama sebagai keluarga! Dia merampas seorang ayah, seorang ibu, anjing berkepala tiga... dan {#Emph}kau dariku! {#Prev}Dan suatu saat nanti dia akan merampas semua itu dan lebih banyak lagi darimu jika kita tak bertindak."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "Zagreus_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oke! {#Prev}Oke. Hanya saja... ternyata aku punya seorang adik perempuan, dan aku cuma tak ingin kehilangan dirinya karena semua ini."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "MelinoeField_5116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga tak mau kehilanganmu lagi, Zagreus. Aku ingin kau kembali. Kau dan semua yang tersisa."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "Zagreus_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kalau begitu... sebaiknya... kuambilkan tombak Ayah untukmu. Akan kubawa saat kita bertemu lagi nanti. Aku janji."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "MelinoeField_5117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Kak. Tinggalkan Gigaros di kamarmu untukku, dan kita lanjutkan dari sana. Demi kebaikan kita semua."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting04_3"
    }
    {
      Id = "MelinoeField_5121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zagreus, kau berhasil...! Aku menemukan jejak Gigaros di sini, dan ini semestinya cukup untuk langkah berikutnya."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "Zagreus_0462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah. Jadi, sekarang aku tinggal menunggumu menghubungiku lagi, setelah kau menyuntikkan kutukan mimpi buruk temporal pada tombak ayah kita, lalu... aku turun ke sarang busuk Kakek dan menancapkan tombak itu tepat di jantungnya? Kira-kira begitu, kan?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "MelinoeField_5122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun demi tercapainya tujuan kita. Tapi... aku sudah memikirkan hal ini matang-matang, dan... ada alternatif lain yang ingin kuusulkan. Tadi kau bilang kau belum pernah bertemu Chronos sama sekali. Katakanlah kau berhasil menemuinya di sarang busuknya. Bagaimana kemungkinan hasilnya?"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "Zagreus_0463"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hmm, mari kita lihat. Pertama, aku bisa membunuhnya seperti yang kita rencanakan. Kedua, usahaku bisa berujung kegagalan total yang memalukan. Atau ketiga, kita malah langsung akrab, mengobrol seru, lalu jadi sahabat karib?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "MelinoeField_5210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurang lebih pemikiranku juga begitu. Dengarkan dulu, bagaimana kalau... sebelum menyerang, kau coba opsi terakhir itu dulu? Kenali dirinya. Buat dia menyukaimu, jika memungkinkan."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "Zagreus_0464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, apa? Kita bakal mengobrol santai dari hati ke hati antarcucu dan kakek? Mungkin aku bisa mengundangnya ke Griya untuk minum sebotol Ambrosia! Dia sudah lama membusuk sendirian; barangkali dia butuh teman bicara. Kau serius?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "MelinoeField_5124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku serius, tapi... dia sudah membusuk terlalu lama... dan sangat mendendam karena keluarga kita memutuskan hubungan dengannya. Ambisinya kemungkinan besar mustahil diubah, bahkan di masamu. Tapi setidaknya, mungkin kau bisa memanfaatkan pengetahuan itu untuk melawannya."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "Zagreus_0465"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau benar-benar {#Emph}bersungguh-sungguh {#Prev}menyuruhku mengobrol dengannya. Anggap saja kita jadi sahabat karib, lalu bagaimana? Oh... {#Emph}wah. {#Prev}Dia tidak akan merebut Griya. Dia tidak perlu melakukannya! Tapi, Ayah pasti bakal mengamuk sejadi-jadinya kalau sampai melihatnya lagi..."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "MelinoeField_5125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadikan Chronos sebagai tahanan! Sebagai Spesialis Keamanan, itu hakmu. Dia mungkin terlalu angkuh untuk menyerah begitu saja, tapi... tidak ada salahnya mencoba."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "Zagreus_0466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kenapa tidak? Dia belum pernah bertemu {#Emph}denganku{#Prev}, kan? Atau {#Emph}denganmu{#Prev}, kalau dipikir-pikir. Dan dia pasti tidak akan lebih sulit diajak bicara ketimbang Ayah. Aku suka rencana ini, Dik! Setidaknya jauh lebih baik daripada rencana langsung bunuh di tempat."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "MelinoeField_5126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus. Tapi aku butuh kepastian bahwa jika percakapan itu tidak berjalan sesuai harapanmu, kau tidak akan ragu untuk menghunuskan tombak itu menembus tubuhnya."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "Zagreus_0467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, ini jaminanku: Jika aku menemuinya, gagal meluluhkan hatinya, tidak menyukai gelagatnya, dan memastikan dia adalah ancaman bagimu dan kita semua... aku akan membunuhnya. Saat itu juga."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "MelinoeField_5211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku percaya padamu. Seumur hidupku, tugasku hanyalah satu... {#Emph}Kematian bagi Chronos. {#Prev}Tapi itu sebenarnya bukanlah tujuan akhir seutuhnya... melainkan sekadar cara untuk menghentikannya, serta untuk membalas dendam. Jika ada jalan lain untuk memperbaiki segalanya... patut dicoba."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "Zagreus_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setuju. Kalau begitu... sebaiknya aku mengasah kemampuan tombakku untuk berjaga-jaga. Lagipula, makin cepat aku kelelahan, makin cepat pula aku bisa tidur lelap lagi dan menemuimu."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "MelinoeField_5128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersiaplah. Menyiapkan Gigaros mungkin butuh sedikit waktu, dan... aku mungkin akan sulit menghubungimu hingga saat itu tiba. Tapi aku pasti kembali. Sampai jumpa nanti, jaga dirimu baik-baik, Zagreus. Kakakku."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting05"
    }
    {
      Id = "Zagreus_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë! Kau kembali. Kau tak tahu betapa sulitnya aku berusaha tertidur pulas agar bisa menemuimu lagi di sini. Jadi bagaimana beritanya, apa tombaknya sudah siap?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "MelinoeField_5129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Genggamlah Gigaros, dan kita akan segera tahu. Kau harus langsung pergi ke tempat Chronos berdiam. Bicaralah dengannya, tapi jangan sebut-sebut diriku sama sekali, karena aku belum lahir di masamu. Aku mengandalkan keberhasilanmu."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0469"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan rencananya adalah... begitu kutemukan dia... entah kami menjadi sahabat karib, atau kalau tidak, berlakulah sumpah {#Emph}Kematian bagi Chronos {#Prev}seperti katamu. Apakah kau... apa kau benar-benar yakin ada kemungkinan dia bisa berubah pikiran? Bahwa aku tak perlu membunuhnya?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "MelinoeField_5187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengetahui bahwa ada kemungkinan tanpa batas... kurasa jawabannya iya. Tapi aku masih sangat marah padanya, dan takut akan apa yang mungkin terjadi kelak. Dia telah merenggut begitu banyak dariku, dari kita semua, namun... dia juga ingin keluarganya kembali. Entah bagaimana caranya, dia akan menuai apa yang dia tabur. Kita semua juga begitu."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Baiklah. Tapi kita akan membawa kembali keluarga {#Emph}kita{#Prev}, bukan cuma keluarga {#Emph}dia! Fiuh{#Prev}, ini benar-benar berat. Tak disangka tombak Ayah ini punya kekuatan untuk membinasakan Titan yang abadi."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "MelinoeField_5131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tombak ini akan memilikinya sebentar lagi, jadi dekap erat-erat. {#Emph}Semoga Bumi, Malam, dan Kegelapan mendengarku: Berikan kematian sejati bagi sang abadi melalui sumpahku. Pembubaran Sang Waktu!{#Prev}"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Gigaros... terasa panas saat disentuh... tapi rasanya juga jauh lebih ringan dari sebelumnya! Sepertinya aku harus berhati-hati agar tak menusuk orang sembarangan... selain Chronos."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "MelinoeField_3886"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergilah, Zagreus. Aku sudah melakukan semua yang kubisa di sini. Dan kita akan bertemu lagi. Mungkin di waktu yang lain, tapi kita pasti bertemu. Untuk saat ini, selamat tinggal."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Chronos_0967"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa di sana?! Langkahmu tak berderap layaknya kuku satir, dan raut wajahmu sama sekali tak kukenal."
      Speaker = "Chronos"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0471"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti Kakek. Rasanya kita belum pernah berkenalan resmi, namaku Zagreus. Aku mendapat info soal guamu yang sangat mencurigakan ini dan memutuskan untuk melihat-lihat. Sedang apa kau di sini, jika boleh kutahu?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Chronos_0968"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Memulihkan diri! {#Prev}Apa lagi yang bisa kulakukan di tempat terkutuk seperti ini? Jadi kurasa Hades-lah yang patut diberi selamat atas kehadiran cucu baruku ini. Tak pernah terpikir olehku bahwa aku akan hidup cukup lama untuk melihatnya menjadi seorang ayah."
      Speaker = "Chronos"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0472_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, dia ayah yang {#Emph}luar biasa{#Prev}, asal Kakek tahu! Satu-satunya kekecewaanku adalah aku terlahir sebagai anak tunggal. Tapi dia dan ibuku tercinta, Persephone sang Ratu Underworld, benar-benar saling mencintai, jadi... di masa depan nanti, siapa tahu!"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Chronos_0969"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengapa kau menceritakan semua ini padaku? Jawab sekarang juga, sebelum para satirku mencabik-cabikmu sampai hancur! Di mana {#Emph}sebenarnya {#Prev}para satir keparat itu...?"
      Speaker = "Chronos"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakek... kuceritakan semua ini karena kupikir ada baiknya kita berbasa-basi sebentar sebelum aku terpaksa menghabisimu. Jika Kakek berniat membawa kepedihan dan penderitaan bagi Griyaku, sebagai Spesialis Keamanan resmi kami, aku tak bisa membiarkannya."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Chronos_0970"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cih! {#Prev}Apa yang kau tahu soal niatku? Lancang sekali kau bicara padaku soal kepedihan dan penderitaan! Di sinilah aku membusuk selama berabad-abad bahkan sebelum kau menjadi benih di angan-angan ayahmu! Dia dan saudara-saudaranya, para pengkhianat dan perebut takhta!"
      Speaker = "Chronos"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0474"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka anak-anakmu... Ayah dan aku dulu juga sering bertengkar. Dia sempat mengasingkan diri dari Olympus, dari Persephone, dan juga dariku. Itu sama sekali tak ada gunanya baginya. Bagaimana dengan Kakek? Kita baru saja bertemu! Apa Kakek tega menyeretku ke dalam dendam lamamu?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Chronos_1459"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika memang terpaksa, {#Emph}ya{#Prev}, tentu {#Emph}saja! {#Prev}Ayahmu dan saudara-saudaranya pasti sudah meracunimu beserta seluruh generasimu untuk membenciku!"
      Speaker = "Chronos"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa aku bakal bicara padamu kalau memang begitu masalahnya? Begini kesepakatannya: Ikutlah denganku baik-baik ke acara reuni keluarga dadakan... atau terima tusukan tombak ini berkali-kali. Dan kau tak bakal cepat pulih, aku bersumpah. Jadi, mau pilih yang mana?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Chronos_1460"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau, yang mengancamku dengan pemusnahan, belum pernah merasakan dunia tanpa adanya Waktu! Kau pasti akan sangat merindukan pengaruh kekuasaanku! Aku juga tak sudi dipermalukan dan dicemooh di hadapan kerabatku sendiri... apa maumu yang harus kulakukan saat mereka menatapku?!"
      Speaker = "Chronos"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entahlah, mungkin cobalah bersikap layaknya kakekku, daripada menyelinap di bawah Kediaman dalam semacam ruangan terlarang yang mestinya sudah kuketahui? Kau ini Waktu. Kenapa tidak coba kaupikirkan kemungkinannya sedikit?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Chronos_1304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memikirkan {#Emph}apa... {#Prev}kehidupan penuh sukacita di mana Kakek Sang Waktu ada di sana untuk memanjakan anak manja dari putraku yang penuh dengki itu? Hades pasti akan langsung menghunjamkan tombak terkutuk itu menembus tubuhku begitu melihatku kalau kau tidak mencegahnya!"
      Speaker = "Chronos"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak akan, karena kau bakal berada di bawah perlindunganku. Dan juga, tidak, hidupmu takkan melulu penuh sukacita, apalagi kalau kau terus begini. Tapi mungkin masih lebih baik daripada situasi apa pun {#Emph}ini! {#Prev}Sekarang tentukan pilihanmu. Aku tak punya banyak waktu sepanjang hari ataupun malam."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Chronos_1305"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Mencibir> {#Prev}Jadi, masa depan bersama cucu-cucu sepertimu, atau kehampaan abadi... bagaimana mungkin aku bisa memilih...?"
      Speaker = "Chronos"
      Event = "ZagreusPastMeeting06"
    }
    {
      Id = "Zagreus_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, Adik! Aku tahu kau mungkin sudah siap melangkah dengan apa pun rencanamu terhadap Gigaros, tapi... aku belum. Setelah meninggalkannya untukmu, aku... mulai merasa sedikit menyesal."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06_B"
    }
    {
      Id = "MelinoeField_5186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua ini pasti terasa sangat berat untuk dipahami... Aku sudah memikirkannya masak-masak, dan... ada alternatif yang ingin kuusulkan. Kau bilang sebelumnya kau bahkan belum pernah bertemu Chronos. Katakanlah kau berhasil menemukannya di sarang busuknya itu. Lalu apa hasil yang akan terjadi?"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting06_B"
    }
    {
      Id = "MelinoeField_5123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurang lebih begitu pula yang kupikirkan. Dengarkan aku sebentar, bagaimana jika... kalian {#Emph}bisa {#Prev}menjadi sahabat karib, seperti katamu?"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting06_B"
    }
    {
      Id = "MelinoeField_5127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku percaya padamu. Seumur hidupku, aku selalu mengemban tugas ini... {#Emph}Kematian bagi Chronos. {#Prev}Namun itu tak pernah menjadi tujuan akhir... melainkan hanya cara. Jika ada jalan lain yang berhasil untuk kita semua... tak ada salahnya dicoba."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting06_B"
    }
    {
      Id = "MelinoeField_5130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengetahui ada kemungkinan tanpa batas... kupikir memang begitu, ya. Tapi aku masih sangat marah padanya, dan takut akan apa yang mungkin terjadi nanti. Dia sudah merenggut begitu banyak dariku, dari kita semua, namun... dia juga menginginkan keluarganya kembali. Jadi temuilah dia. Dengan satu atau lain cara, dia akan menuai apa yang ditanamnya. Kita semua pun begitu."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting06_B"
    }
    {
      Id = "Zagreus_0472"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, dia itu ayah yang {#Emph}luar biasa{#Prev}, kalau kau memang ingin tahu! Satu-satunya kekecewaanku hanyalah aku ini anak tunggal. Namun dia dan ibuku tercinta, Persephone Sang Ratu Dunia Bawah, benar-benar saling mencintai, jadi... di masa depan nanti, siapa tahu kan!"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting06_B"
    }
    {
      Id = "Zagreus_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu {#Emph}kau{#Prev}, Melinoë? Sosokmu hampir tak kelihatan lagi. Sial..."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting07"
    }
    {
      Id = "MelinoeField_3909"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zagreus, kau bisa mendengarku? {#Emph}Jawab aku! {#Prev}Zagreus!"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting07"
    }
    {
      Id = "Zagreus_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tak tahu apa yang sedang terjadi padamu, tapi aku siap melakukan bagianku begitu kau pun sudah siap."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting07"
    }
    {
      Id = "MelinoeField_3910"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percuma saja. Dia tak bisa mendengarku lagi. Ada mantra yang harus kuselesaikan, dan aku tak boleh berlama-lama di sini."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting07"
    }
    {
      Id = "Zagreus_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah itu...? Itu dia, kurasa. Melinoë? Itu kau? Kau bisa mendengarku?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting08"
    }
    {
      Id = "MelinoeField_3911"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa mendengarmu, tapi apa kau bisa mendengar {#Emph}suaraku? {#Prev}Halo, Zagreus? {#Emph}Halo?"
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting08"
    }
    {
      Id = "Zagreus_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sial. Pasti ada cara yang lebih andal untuk berkomunikasi melintasi mimpi dan sang waktu."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeeting08"
    }
    {
      Id = "MelinoeField_3912"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sia-sia saja. Sebelum mantramu selesai, kurasa aku takkan bisa menghubunginya lagi."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeeting08"
    }
    {
      Id = "Zagreus_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë, kau di mana? Ini aku, kakakmu! Aku cuma... berdiri mematung di sini, rupanya di dalam mimpi, menunggumu muncul... {#Emph}kapan saja?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeetingRepeatable01"
    }
    {
      Id = "MelinoeField_3913"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahan sebentar lagi, Kakak..."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeetingRepeatable01"
    }
    {
      Id = "Zagreus_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau terjadi sesuatu padanya... tapi kalau begitu aku takkan mengalami mimpi ini lagi, kan? Kecuali kalau aku {#Emph}tidak {#Prev}bermimpi. Dan aku cuma berdiri mematung di sini, menatapi cermin..."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeetingRepeatable02"
    }
    {
      Id = "MelinoeField_3914"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia bisa merasakanku tapi aku tak mampu menjangkaunya... kumohon, tunggu sebentar lagi, Zagreus."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeetingRepeatable02"
    }
    {
      Id = "Zagreus_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa aku benar-benar akan melakukan ini? Menghancurkan kakek kami... ini pasti hal yang diinginkan Ayah, dan adik perempuanku ini juga, tapi... {#Emph}eh{#Prev}, ngomong-ngomong dia ke mana ya? Melinoë? Adik?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeetingRepeatable03"
    }
    {
      Id = "MelinoeField_3915"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku di sini, hanya saja... kita sama sekali tak bisa berkomunikasi seperti ini, sampai... aku harus menyambung kembali ikatan kita."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeetingRepeatable03"
    }
    {
      Id = "Zagreus_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm{#Prev}, apa yang harus kulakukan... apa yang membuatnya lama? Apa dia baik-baik saja? {#Emph}Halo...? {#Prev}Apa kau baik-baik saja di luar sana?"
      Speaker = "Zagreus"
      Event = "ZagreusPastMeetingRepeatable04"
    }
    {
      Id = "MelinoeField_3917"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baik-baik saja, hanya saja... aku butuh sedikit waktu lagi! Jangan putus asa, dan... bersiaplah."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeetingRepeatable04"
    }
    {
      Id = "Zagreus_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terus-terusan mengalami mimpi aneh ini... atau mimpi {#Emph}buruk{#Prev}, entahlah. Sudah cukup lama tak mendengar kabar darinya..."
      Speaker = "Zagreus"
      Event = "ZagreusPastMeetingRepeatable05"
    }
    {
      Id = "MelinoeField_3916"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan kembali untukmu, Kakak, aku bersumpah... hanya saja bukan malam ini."
      Speaker = "Melinoe"
      Event = "ZagreusPastMeetingRepeatable05"
    }
    {
      Id = "Melinoe_5059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga dirimu baik-baik, Kakak."
      Speaker = "Melinoe"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih atas segalanya."
      Speaker = "Melinoe"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senang melihatmu!"
      Speaker = "Melinoe"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pangeran Zagreus."
      Speaker = "Melinoe"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_5063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang Mulia."
      Speaker = "Melinoe"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Zagreus_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makasih ya."
      Speaker = "Zagreus"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Zagreus_0092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Boleh juga."
      Speaker = "Zagreus"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Zagreus_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bolehlah!"
      Speaker = "Zagreus"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Zagreus_0094"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita memang butuh bantuan."
      Speaker = "Zagreus"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Zagreus_0096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Putri Melinoë."
      Speaker = "Zagreus"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Zagreus_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan, Yang Mulia {#Emph}Tuan Putri{#Prev}."
      Speaker = "Zagreus"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Zagreus_0089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga."
      Speaker = "Zagreus"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Zagreus_0090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak perlu repot-repot."
      Speaker = "Zagreus"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Zagreus_0095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga!"
      Speaker = "Zagreus"
      Event = "NPC_Zagreus_01.InteractVoiceLines"
    }
    {
      Id = "Zagreus_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir sisanya bisa kita perbaiki sendiri. Terima kasih atas semua bantuanmu. Terutama bagian saat kau membebaskan kami dari penjara waktu dan tetek bengeknya!"
      Speaker = "Zagreus"
      Event = "ZagreusTrueEnding01"
    }
    {
      Id = "MelinoeField_4981"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percayalah, tak ada hal lain yang bisa kukerjakan! Pokoknya, kita harus cari cara agar bisa saling bertemu di luar sana. Dan kita berdua harus tetap mengawasi Chronos selagi menyelesaikan urusan yang tersisa."
      Speaker = "Melinoe"
      Event = "ZagreusTrueEnding01"
    }
    {
      Id = "Zagreus_0488"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti berat melihat wajahnya lagi setelah semua yang dia lakukan... Aku sangat bersyukur kita semua ada di sini, tapi mudah saja bagiku bicara begitu karena aku tak terkurung dalam konflik seumur hidup..."
      Speaker = "Zagreus"
      Event = "ZagreusTrueEnding01"
    }
    {
      Id = "MelinoeField_5155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa mengatasinya. Kau membantuku menyadari bahwa hasil seperti ini memang memungkinkan. Saat kuhadapi Chronos di Kediaman ini... aku mulai merasa bahwa keterasingannya dari keluarga inilah yang menggerogoti jiwanya."
      Speaker = "Melinoe"
      Event = "ZagreusTrueEnding01"
    }
    {
      Id = "Zagreus_0490"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin dia sudah benar-benar dirusak olehnya. Untunglah kerja sama kakak-beradik kita ini cukup solid! Masa lalu dan masa kini, nyata maupun bayangan. Dan sekarang kita bahkan tak butuh sihir-penyihir-waktu-mimpi untuk saling menghubungi!"
      Speaker = "Zagreus"
      Event = "ZagreusTrueEnding01"
    }
    {
      Id = "MelinoeField_5215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa tidak perlu lagi! Rasanya kita sudah melewati suka dan duka bersama, bukan? Bahkan tanpa ingatan akan kehidupan yang benar-benar berbeda dan jauh lebih menyenangkan. Untuk saat ini, aku cuma menginginkan hidup yang lebih tenang."
      Speaker = "Melinoe"
      Event = "ZagreusTrueEnding01"
    }
    {
      Id = "Zagreus_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, kau bukan tipe orang yang gampang berpuas diri. Lagipula aku tahu ini bukan perpisahan, dan kita bakal bertemu lagi... tapi, tetap saja... aku akan merindukanmu, Adik Kecil. Dan tolong pulangkan Hypnos kalau dia tak kunjung bangun sendiri."
      Speaker = "Zagreus"
      Event = "ZagreusTrueEnding01"
    }
    {
      Id = "MelinoeField_4983"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia pasti bangun. Aku juga akan merindukanmu, Kakak. Jaga semuanya baik-baik, ya?"
      Speaker = "Melinoe"
      Event = "ZagreusTrueEnding01"
    }
    {
      Id = "Zagreus_0087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti. Kau juga jaga dirimu baik-baik."
      Speaker = "Zagreus"
      Event = "ZagreusTrueEnding01"
    }
    {
      Id = "MelinoeField_5347"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Paman."
      Speaker = "Melinoe"
      Event = "NPC_Zeus_Story_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_5348"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Raja Zeus."
      Speaker = "Melinoe"
      Event = "NPC_Zeus_Story_01.InteractVoiceLines"
    }
    {
      Id = "Zeus_0310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, terima kasih."
      Speaker = "Zeus"
      Event = "NPC_Zeus_Story_01.InteractVoiceLines"
    }
    {
      Id = "Zeus_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami tak butuh pemandu."
      Speaker = "Zeus"
      Event = "NPC_Zeus_Story_01.InteractVoiceLines"
    }
    {
      Id = "Zeus_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang, Gadis Muda, di kediaman agung keluarga kita! Kami berterima kasih padamu karena telah memastikan monster Typhon itu gagal mencapai kami di sini."
      Speaker = "Zeus"
      Event = "ZeusPalaceFirstMeeting"
    }
    {
      Id = "Hera_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kami sangat menyesal Suamiku meninggalkanmu menghadapi makhluk keji itu sendirian. Sebagian besar dewa-dewi lain masih memperkuat Istana; maafkan ketidaksopanan kami."
      Speaker = "Hera"
      Event = "ZeusPalaceFirstMeeting"
    }
    {
      Id = "MelinoeField_3828"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang perlu dimaafkan, Ratu Hera. Suatu kehormatan bagiku bisa bertemu langsung dengan Anda dan Raja Zeus, serta melihat kemegahan Olympus dengan mata kepalaku sendiri. Ini semua berkat dukungan melimpah dari kalian selama bermalam-malam ini."
      Speaker = "Melinoe"
      Event = "ZeusPalaceFirstMeeting"
    }
    {
      Id = "Zeus_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahlah, Melinoë, lagipula kita punya tujuan yang sama! Dan selama Chronos masih menduduki takhta ayahmu, tujuan itu masih belum tuntas."
      Speaker = "Zeus"
      Event = "ZeusPalaceFirstMeeting"
    }
    {
      Id = "Hera_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mau mengusirnya padahal dia baru saja tiba, Suamiku? Padahal tak banyak hiburan di sini selain petikan kecapi Apollo. Setidaknya musuh-musuh kita akan segera kembali ke gerbang tak lama lagi!"
      Speaker = "Hera"
      Event = "ZeusPalaceFirstMeeting"
    }
    {
      Id = "MelinoeField_3829"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku juga tak bisa berlama-lama. Aku harus berunding dengan Sang Penyihir Simpang Tiga; barangkali beliau punya gagasan untuk menyingkirkan kedua musuh besar kita sekaligus."
      Speaker = "Melinoe"
      Event = "ZeusPalaceFirstMeeting"
    }
    {
      Id = "Zeus_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita pasti akan menemukan caranya, aku tak ragu sedikit pun! Dan hingga saat itu tiba, kita akan lebih siap menyambut serbuan mereka."
      Speaker = "Zeus"
      Event = "ZeusPalaceFirstMeeting"
    }
    {
      Id = "Hera_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergilah, Sayangku. Seperti yang bisa kaulihat sendiri, kami tak terbiasa mengungkapkan rasa terima kasih. Kupikir, selama Ayahmu dan Ratunya belum kembali, tak banyak hal yang patut dirayakan."
      Speaker = "Hera"
      Event = "ZeusPalaceFirstMeeting"
    }
    {
      Id = "MelinoeField_3830"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga segera terwujud."
      Speaker = "Melinoe"
      Event = "ZeusPalaceFirstMeeting"
    }
    {
      Id = "Hera_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang akhirnya bisa berkenalan denganmu, Sayangku! Dan kami sangat menyesal Suamiku membiarkanmu menghadapi makhluk keji itu sendirian. Sebagian besar dewa-dewi lain masih memperkuat Istana; maafkan ketidaksopanan kami."
      Speaker = "Hera"
      Event = "ZeusPalaceFirstMeetingAlt"
    }
    {
      Id = "Zeus_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berhasil menghajar monster terkutuk itu sekali lagi, Gadis Muda, dan ini jelas berkat dirimu! Keberanian luar biasa di tengah bencana, dan Istana kita tetap aman tenteram... serta makin diperkuat, andai Typhon berniat menyerang kita lagi."
      Speaker = "Zeus"
      Event = "ZeusPalaceMeeting02"
    }
    {
      Id = "Hera_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh luar biasa, Sayangku! Jika keadaan memburuk, kami tadinya bersiap memakai langkah terakhir yang dirancang salah satu putra kami. Tapi tebusannya teramat mahal. Jadi, kau telah menyelamatkan kami dalam banyak hal."
      Speaker = "Hera"
      Event = "ZeusPalaceMeeting02"
    }
    {
      Id = "MelinoeField_3840"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suatu kehormatan bisa mengabdi pada keluarga kita, Ratu Hera, dan melihat keajaiban aula ini sekali lagi. Barangkali sebentar lagi kita bisa melenyapkan Typhon untuk selamanya."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeeting02"
    }
    {
      Id = "Zeus_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu apa rencanamu soal itu? Penyelidikan kami sendiri belum menemukan kekuatan yang sanggup menumbangkan Typhon tanpa ikut meratakan seisi gunung ini! Dia bahkan jauh lebih ganas sekarang daripada saat pertama kali menyerang kita dulu."
      Speaker = "Zeus"
      Event = "ZeusPalaceMeeting02"
    }
    {
      Id = "MelinoeField_3841"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah mengumpulkan sampel berguna dari daging Typhon, dan kami sedang meneliti cara memanfaatkannya dalam sihir kami. Namun kami belum punya perkembangan berarti untuk dibagikan..."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeeting02"
    }
    {
      Id = "Hera_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah, sudahlah. Memukul mundur monster itu lebih dari sekali sudah merupakan kemajuan yang sangat berarti! Paduka Suamiku sempat mengira kemenangan pertamamu itu murni cuma keberuntungan belaka."
      Speaker = "Hera"
      Event = "ZeusPalaceMeeting02"
    }
    {
      Id = "Zeus_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksud perkataanku tadi, Istriku sayang, satu kemenangan melawan Typhon belum tentu membuktikan kemenangan serupa bisa diulang! Tapi sekarang kau telah membuktikannya sebaliknya, Melinoë, dan menyulut harapan kami bahwa kita akan segera terbebas dari ancaman busuk ini."
      Speaker = "Zeus"
      Event = "ZeusPalaceMeeting02"
    }
    {
      Id = "MelinoeField_3842"
      InheritFrom = "BaseNarrative"
      DisplayName = "Raja Zeus, Ratu Hera, izinkan aku pamit membawa temuan ini, siapa tahu bisa menuntun pada penemuan baru untuk mewujudkannya. Terima kasih atas bantuan kalian yang tiada henti."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeeting02"
    }
    {
      Id = "Zeus_0281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasa terima kasih kami pun menyertaimu."
      Speaker = "Zeus"
      Event = "ZeusPalaceMeeting02"
    }
    {
      Id = "Hera_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu Paduka Suamiku mencibir saat aku pertama kali mengusulkan bahwa mungkin {#Emph}keponakan penyihir mematikannya {#Prev}ini, yang dibesarkan sejak belia untuk membinasakan Sang Waktu sendiri, bisa berguna melawan kepungan sang Titan! Senang rasanya usulku {#Emph}itu {#Prev}terbukti benar."
      Speaker = "Hera"
      Event = "ZeusPalaceMeeting03"
    }
    {
      Id = "Zeus_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hera sayang, {#Emph}tentu saja {#Prev}kita sudah sepakat soal itu, kalau tidak keponakanku yang baik ini takkan ada di sini sekarang! Namun beri tahu kami, Melinoë, apa kabar soal solusi permanen untuk kemelut kita ini? Typhon sama sekali tak menunjukkan gelagat akan mundur."
      Speaker = "Zeus"
      Event = "ZeusPalaceMeeting03"
    }
    {
      Id = "MelinoeField_3845"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami makin mendekati suatu jalan keluar. Sangat mungkin sarana yang kami pakai untuk menyingkirkan salah satu musuh besar kita juga akan menjadi kunci untuk melenyapkan yang satunya. Walau sarana itu belum sepenuhnya berhasil kami raih saat ini."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeeting03"
    }
    {
      Id = "Hera_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dengar itu, Zeus? Masalah terbesar yang kita hadapi mungkin bisa diselesaikan sekaligus. Kita kan sangat suka menyelesaikan urusan secara efisien."
      Speaker = "Hera"
      Event = "ZeusPalaceMeeting03"
    }
    {
      Id = "Zeus_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tinggal beri tahu kami apa lagi yang mesti dilakukan demi memuluskan hasil ini, Melinoë. Seluruh Olympus siap membantumu kapan pun."
      Speaker = "Zeus"
      Event = "ZeusPalaceMeeting03"
    }
    {
      Id = "MelinoeField_4268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong bertahanlah selama mungkin, karena berkat dan dukungan kalian tak ternilai harganya. Bagaimanapun caranya, aku akan kembali secepat mungkin. Chronos mungkin telah membangkitkan Typhon, tapi kekuatan yang sama itu pula yang bisa melenyapkannya."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeeting03"
    }
    {
      Id = "Hera_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga demikian adanya. Kami ingin menyuruhmu santai saja, Sayang, tapi kita tak tahu sisa waktu yang kita miliki. Kendati begitu, berhati-hatilah dan kami akan menanti kepulanganmu."
      Speaker = "Hera"
      Event = "ZeusPalaceMeeting03"
    }
    {
      Id = "MelinoeField_3847"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong bertahanlah selama mungkin, karena berkat dan dukungan kalian tak ternilai harganya. Aku mungkin akan pergi selama beberapa malam selagi memusatkan perhatian pada Chronos; kekuatannya membangkitkan Typhon, dan kekuatan yang sama itu pula yang bisa menghancurkan {#Emph}dirinya."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeeting03_A"
    }
    {
      Id = "MelinoeField_3846"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk saat ini masih sebatas teori, meski kami yakin kemungkinan besar sarana yang kami gunakan untuk menyingkirkan salah satu musuh besar kita akan menjadi kunci untuk melenyapkan yang satunya. Sayangnya, sarana itu belum berhasil kami wujudkan saat ini."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeeting03_B"
    }
    {
      Id = "Zeus_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon pantang mundur, tapi kita akan memukulnya mundur setiap malam dia berani mengancam kita, jika memang harus begitu!"
      Speaker = "Zeus"
      Event = "ZeusPalaceMeeting04"
    }
    {
      Id = "Hera_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihan lainnya, kita mungkin bisa menghancurkannya bersama dengan gunung ini dan sebagian besar wilayah pedesaan di sekitarnya... walau setelah itu, di mana kita akan tinggal?"
      Speaker = "Hera"
      Event = "ZeusPalaceMeeting04"
    }
    {
      Id = "Zeus_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sama sekali tak perlu memikirkan kemungkinan itu, Hera sayang! Lebih baik jangan diungkit lagi. Melinoë meyakinkan kita bahwa Typhon bisa diurus dengan cara lain."
      Speaker = "Zeus"
      Event = "ZeusPalaceMeeting04"
    }
    {
      Id = "MelinoeField_3850"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bermaksud mengobral janji soal itu, Paduka Paman, walau aku akan mengerahkan segenap dayaku demi memastikan Olympus tetap tegak selagi Typhon binasa... Aku hanya perlu memusatkan perhatian pada Chronos untuk sementara waktu."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeeting04"
    }
    {
      Id = "Hera_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, maaf jika aku terdengar blak-blakan, Sayang, tapi kenapa kau belum berada di Underworld-mu? Sekarang kami bisa bertahan sendiri, kau sudah melihatnya. Tapi kami sendiri tak bisa menjangkau sang Titan."
      Speaker = "Hera"
      Event = "ZeusPalaceMeeting04"
    }
    {
      Id = "Zeus_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lakukan apa yang mesti kau lakukan, Melinoë. Kami akan menunggu kabar keberhasilanmu di Tartarus. Dan kau bisa mengandalkan segenap berkat kami di sepanjang perjalanan!"
      Speaker = "Zeus"
      Event = "ZeusPalaceMeeting04"
    }
    {
      Id = "MelinoeField_3850_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bermaksud mengobral janji soal itu, Paduka Paman, walau aku akan mengerahkan segenap dayaku demi memastikan Olympus tetap tegak selagi Typhon binasa..."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeeting04_B"
    }
    {
      Id = "Zeus_0286_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lakukan apa yang mesti kau lakukan, Melinoë. Kami akan menunggu kabar keberhasilanmu. Dan kau bisa mengandalkan segenap berkat kami di sepanjang perjalanan!"
      Speaker = "Zeus"
      Event = "ZeusPalaceMeeting04_B"
    }
    {
      Id = "Zeus_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, keponakanku yang luar biasa, sungguh hebat! Setahu kami, tak ada secuil pun jejak monster mengerikan itu yang tersisa! Tugas telah {#Emph}tuntas! {#Prev}Typhon sudah {#Emph}mati!"
      Speaker = "Zeus"
      Event = "ZeusPalaceAboutTyphonDeath01"
    }
    {
      Id = "Hera_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Suamiku punya kebiasaan terlalu cepat mengumandangkan kemenangan, jadi aku takkan percaya {#Emph}sepatah kata pun {#Prev}soal ini sampai mendengarnya langsung dari bibirmu; bahkan mungkin tetap tak percaya!"
      Speaker = "Hera"
      Event = "ZeusPalaceAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_3866"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bapak Segala Monster telah binasa... bukan sekadar mati, melainkan dimusnahkan hingga tuntas, menggunakan kekuatan Titan Waktu, dan sedikit bantuan dari tombak kesayangan Ayah, Gigaros."
      Speaker = "Melinoe"
      Event = "ZeusPalaceAboutTyphonDeath01"
    }
    {
      Id = "Zeus_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dengar {#Emph}itu{#Prev}, Hera sayang? Kan sudah {#Emph}kubilang {#Prev}Melinoë muda pasti akan menang demi kepentingan kita! Keluarga kita selalu jaya jika bersatu dengan tujuan yang sama."
      Speaker = "Zeus"
      Event = "ZeusPalaceAboutTyphonDeath01"
    }
    {
      Id = "Hera_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku masih benar-benar syok. Baiklah, Anak Muda, kalau kau {#Emph}sungguh-sungguh {#Prev}telah menumpas ancaman {#Emph}mengerikan {#Prev}itu, bersiaplah menghadapi kami semua yang akan mengaku tak pernah meragukanmu sama sekali. Paduka Suamiku sudah mulai duluan tuh."
      Speaker = "Hera"
      Event = "ZeusPalaceAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_3867"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya Anda sekalian tidak percaya padaku, Ratu Hera, mungkin Typhon-lah yang akan berdiri di sini menggantikanku. Jadi terima kasih semuanya... dan kini kemenangan yang jauh lebih besar sudah di depan mata."
      Speaker = "Melinoe"
      Event = "ZeusPalaceAboutTyphonDeath01"
    }
    {
      Id = "Zeus_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan Chronos... maksudmu berniat menghancurkannya juga dengan cara yang kau terapkan malam ini?"
      Speaker = "Zeus"
      Event = "ZeusPalaceAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_3868"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika memang diperlukan. Kendati kekuatan yang kalian saksikan tadi dikhususkan untuk Typhon semata, dan apa yang kami rencanakan untuk Chronos hanya pantas ditujukan padanya. Mereka yang abadi tak bisa dihancurkan kecuali jika mereka mengancam jalinan takdir yang ditenun oleh Sang Fates."
      Speaker = "Melinoe"
      Event = "ZeusPalaceAboutTyphonDeath01"
    }
    {
      Id = "Hera_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berarti belum ada pesta pora sampai urusan yang satunya beres juga, kan? Tak apa. Pasukan sang Titan bisa jadi makin kalap sekarang, sebuah kemungkinan yang harus kita antisipasi. Kami akan meminjamkan segenap kekuatan yang kami bisa demi serangan pemungkasmu nanti."
      Speaker = "Hera"
      Event = "ZeusPalaceAboutTyphonDeath01"
    }
    {
      Id = "Chronos_1077"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sekarang kau paham kan, Putraku? Walau Typhon yang pernah kau hadapi itu telah tiada, bisa saja ada kemungkinan-kemungkinan lain di mana dia tetap bertahan. Berkurang satu {#Emph}sekarang{#Prev}, tentu saja!"
      Speaker = "Chronos"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "Zeus_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu ada berapa banyak kemungkinan-kemungkinan itu menurutmu, Ayah? Karena kita tak bisa membiarkan Melinoë terus bertarung mencapai puncak gunung kami untuk selama-lamanya..."
      Speaker = "Zeus"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "Hera_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bicara soal itu, selamat datang kembali, Sayang! Kami baru saja mengobrol santai dengan kakekmu. Soalnya kami belum memutuskan mau diapakan dia ini."
      Speaker = "Hera"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "Chronos_1078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, halo, Cucu Perempuanku! Aku sudah meyakinkan sang Raja dan Ratu bahwa kau akan menang lagi, karena kau memang sudah pernah menang sebelumnya! Terima kasih telah membuktikan kebenaran teoriku."
      Speaker = "Chronos"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "MelinoeField_5076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, sama-sama. Baginda Raja Zeus, Ratu Hera... Aku bisa memastikan kemungkinan-kemungkinan wujud Typhon ini memang nyata ada, karena aku baru saja menemukan dan memusnahkan salah satunya berkat bantuan Kakek."
      Speaker = "Melinoe"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "Chronos_1079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon kini semakin menyerupai sekadar Bayangan dari dirinya yang dulu. Kemungkinan dirinya menguasai Olympus kian menipis, dan akan semakin menipis seiring setiap keberhasilanmu. Namun berapa {#Emph}banyak {#Prev}yang dibutuhkan, sayangnya aku tak bisa memperhitungkannya..."
      Speaker = "Chronos"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "Hera_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kenapa tidak? Mungkin jika kami mendesakmu lebih keras, wahai Titan, kau akan terdorong untuk menjawab dengan lebih jujur."
      Speaker = "Hera"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "Chronos_1080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sendiri baru belakangan ini mengetahui tentang kemungkinan-kemungkinan tersebut. Waktu kini mengalir bebas, untuk sebagian besarnya; cucu perempuanku hanya perlu memastikan tidak ada rintangan yang mengkhawatirkan, tentu saja jika ia berkenan."
      Speaker = "Chronos"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "MelinoeField_5077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku akan menuntaskannya, berapa lama pun waktu yang dibutuhkan. Tentu atas izin Yang Mulia berdua, wahai Baginda Raja dan Ratu. Kumohon izinkan Kakek untuk terus membantuku. Sejauh ini dia selalu menepati kata-katanya."
      Speaker = "Melinoe"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "Zeus_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami sudah menyiapkan sesuatu yang pantas untukmu, Ayah. Namun demi alasan keamanan, Istana kami mulai saat ini akan disegel sepenuhnya. Melinoë, mungkin saat ibumu kembali melakukan perjalanan tahunannya ke sini, kau boleh, {#Emph}ehem{#Prev}, berkunjung lagi."
      Speaker = "Zeus"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "Hera_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami benar-benar tuan rumah yang buruk bagimu, Sayang. Kami sama sekali tak bermaksud membiarkan semua ini terjadi! Namun kami sudah berjanji mendukungmu sebelumnya, dan kau akan tetap mendapatkannya selama kau butuhkan. Meski kami berdua terkadang masih sering bertengkar karenanya."
      Speaker = "Hera"
      Event = "ZeusPalacePostTrueEnding01"
    }
    {
      Id = "Zeus_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sudah menyingkirkan Typhon untuk saat ini, tapi bukan untuk selamanya. Jika Chronos menghalangi tujuan akhir kita, maka kami mendesakmu untuk memburu {#Emph}dia {#Prev}berikutnya."
      Speaker = "Zeus"
      Event = "ZeusPalaceMeetingRepeatable01"
    }
    {
      Id = "Hera_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suamiku tidak bermaksud menekanmu, aku yakin itu, Sayang. Jangan sungkan untuk menyerahkan pertahanan gunung ini kepada kami selagi kau mengurus urusan lainnya."
      Speaker = "Hera"
      Event = "ZeusPalaceMeetingRepeatable01"
    }
    {
      Id = "MelinoeField_3853"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang Mulia."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeetingRepeatable01"
    }
    {
      Id = "Zeus_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu lagi kemenangan menjadi milik kita! Kami sangat berterima kasih atas jasamu bagi keluarga kita, Melinoë. Semoga kau bisa mengalahkan Chronos secepat ini pula."
      Speaker = "Zeus"
      Event = "ZeusPalaceMeetingRepeatable02"
    }
    {
      Id = "Hera_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan semoga kita segera menemukan cara untuk mengembalikan monster Typhon itu ke perut bumi tempat asalnya. Tetap kabari kami!"
      Speaker = "Hera"
      Event = "ZeusPalaceMeetingRepeatable02"
    }
    {
      Id = "MelinoeField_3854"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baik, Ratu Hera."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeetingRepeatable02"
    }
    {
      Id = "Hera_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi-lagi kau membuat Typhon itu melolong mundur ke kaki gunung kita, meski kemungkinan besar dia akan kembali. Namun mungkin salah satu malam ini akan menjadi malam terakhirnya."
      Speaker = "Hera"
      Event = "ZeusPalaceMeetingRepeatable03"
    }
    {
      Id = "Zeus_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami menghargai semua bantuanmu, Nona muda, tapi jangan lupakan Chronos! Terutama jika kekalahannya adalah kunci kemenangan mutlak kita."
      Speaker = "Zeus"
      Event = "ZeusPalaceMeetingRepeatable03"
    }
    {
      Id = "MelinoeField_3855"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih semuanya."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeetingRepeatable03"
    }
    {
      Id = "Hera_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu disambut di sini, Sayang, tapi kami {#Emph}tidak akan pernah {#Prev}bisa menyambutmu dalam kondisi terbaik selama ancaman Typhon masih membayangi."
      Speaker = "Hera"
      Event = "ZeusPalaceMeetingRepeatable04"
    }
    {
      Id = "Zeus_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia sudah pergi setidaknya untuk saat ini, tapi dia pasti kembali. Kecuali jika Melinoë berhasil memusnahkannya untuk selamanya, seperti yang ia katakan!"
      Speaker = "Zeus"
      Event = "ZeusPalaceMeetingRepeatable04"
    }
    {
      Id = "MelinoeField_3856"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita semakin dekat."
      Speaker = "Melinoe"
      Event = "ZeusPalaceMeetingRepeatable04"
    }
    {
      Id = "MelinoeField_5349"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang Mulia."
      Speaker = "Melinoe"
      Event = "NPC_Hera_Story_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_5350"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ratu Hera."
      Speaker = "Melinoe"
      Event = "NPC_Hera_Story_01.InteractVoiceLines"
    }
    {
      Id = "Hera_0224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika kau memaksa!"
      Speaker = "Hera"
      Event = "NPC_Hera_Story_01.InteractVoiceLines"
    }
    {
      Id = "Hera_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ganas sekali."
      Speaker = "Hera"
      Event = "NPC_Hera_Story_01.InteractVoiceLines"
    }
    {
      Id = "Hera_0226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana?"
      Speaker = "Hera"
      Event = "NPC_Hera_Story_01.InteractVoiceLines"
    }
    {
      Id = "Hera_0227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Hera"
      Event = "NPC_Hera_Story_01.InteractVoiceLines"
    }
    {
      Id = "Hera_0228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mm-hm."
      Speaker = "Hera"
      Event = "NPC_Hera_Story_01.InteractVoiceLines"
    }
    {
      Id = "Apollo_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil, Mentari Terang! Mau bilang aku sudah menduganya, tapi sejujurnya, aku sempat ragu... terutama setelah melihat wujud Typhon secara langsung."
      Speaker = "Apollo"
      Event = "ApolloPalaceFirstMeeting"
    }
    {
      Id = "MelinoeField_3831"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia memang luar biasa besar, kuakui itu! Senang akhirnya bisa bertemu langsung denganmu seperti ini, Sepupu. Permainan musikmu indah sekali!"
      Speaker = "Melinoe"
      Event = "ApolloPalaceFirstMeeting"
    }
    {
      Id = "Apollo_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, apa pun demi mengalihkan pikiran kita dari kekacauan ini. Setidaknya kau memberi kami sedikit waktu bernapas sehingga aku bisa bermain musik lagi. Tapi Typhon pasti akan kembali lagi, kan...?"
      Speaker = "Apollo"
      Event = "ApolloPalaceFirstMeeting"
    }
    {
      Id = "MelinoeField_3832"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dapat kupastikan demikian. Tapi aku pun akan kembali lagi ke sini. Untuk saat ini, tolong perkuat pertahanan kalian dan bersiaplah menghadapi serangan monster itu berikutnya. Sekarang sebaiknya aku pergi... Guruku sedang menunggu kepulanganku."
      Speaker = "Melinoe"
      Event = "ApolloPalaceFirstMeeting"
    }
    {
      Id = "Apollo_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak bisakah kau menghubunginya lewat Berkah? Akan kuberikan satu untukmu kalau-kalau itu bisa membantu. Dan terima kasih atas segalanya, Sepupu."
      Speaker = "Apollo"
      Event = "ApolloPalaceFirstMeeting"
    }
    {
      Id = "Apollo_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihatmu lagi, Sepupu. Tepat di saat aku mulai takut nyanyianku ini menjadi satu-satunya penghibur malam ini!"
      Speaker = "Apollo"
      Event = "ApolloPalaceMeeting02"
    }
    {
      Id = "MelinoeField_3843"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewa Apollo, senang melihatmu juga. Tolong sampaikan salamku pada yang lain... Aku ingin sekali bertemu, tapi sebaiknya aku segera kembali."
      Speaker = "Melinoe"
      Event = "ApolloPalaceMeeting02"
    }
    {
      Id = "Apollo_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, tenagamu pasti sudah terkuras habis. Yang lain pasti juga ingin bertemu denganmu, terutama nenekmu, tapi mereka tak bisa meninggalkan pos masing-masing. Terimalah permohonan maaf kami, dan biarkan kami membantumu kembali pulang."
      Speaker = "Apollo"
      Event = "ApolloPalaceMeeting02"
    }
    {
      Id = "MelinoeField_3844"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampaikan pada Nyonya Demeter dan yang lainnya bahwa aku mendoakan yang terbaik untuk mereka."
      Speaker = "Melinoe"
      Event = "ApolloPalaceMeeting02"
    }
    {
      Id = "Apollo_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar yakin kita akan segera menyingkirkan Typhon keparat itu untuk selamanya? Itu bakal jadi perubahan yang sangat melegakan."
      Speaker = "Apollo"
      Event = "ApolloPalaceMeeting03"
    }
    {
      Id = "MelinoeField_3848"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kita bisa menyingkirkan Chronos, kita juga pasti bisa menyingkirkan Bapak Segala Monster itu. Dan aku tidak berlatih seumur hidup hanya untuk gagal sekarang."
      Speaker = "Melinoe"
      Event = "ApolloPalaceMeeting03"
    }
    {
      Id = "Apollo_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah! Ingatkan aku untuk tidak pernah membuatmu kesal, mentari. Siap untuk pulang? Senang selalu melihatmu, walau sebaiknya aku lanjut bernyanyi agar semua orang tetap tenang."
      Speaker = "Apollo"
      Event = "ApolloPalaceMeeting03"
    }
    {
      Id = "MelinoeField_3849"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita pasti bisa."
      Speaker = "Melinoe"
      Event = "ApolloPalaceMeeting03"
    }
    {
      Id = "MelinoeField_3851"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyanyianmu sungguh suara yang menyejukkan setelah pendakian malam yang berat, Sepupu. Nyaris membuatku melupakan kemelut yang sedang kita hadapi. Hanya saja, semua cahaya ini, aku belum terbiasa..."
      Speaker = "Melinoe"
      Event = "ApolloPalaceMeeting04"
    }
    {
      Id = "Apollo_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami di sini juga belum terlalu terbiasa mengingat betapa gelapnya beberapa waktu belakangan. Tapi ayo kita pulangkan kau sebelum tenagamu makin terkuras. Sepertinya kau harus segera mengunjungi Chronos."
      Speaker = "Apollo"
      Event = "ApolloPalaceMeeting04"
    }
    {
      Id = "MelinoeField_3852"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Melinoe"
      Event = "ApolloPalaceMeeting04"
    }
    {
      Id = "Apollo_0186_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami di sini juga belum terlalu terbiasa mengingat betapa gelapnya beberapa waktu belakangan. Tapi ayo kita pulangkan kau sebelum tenagamu makin terkuras."
      Speaker = "Apollo"
      Event = "ApolloPalaceMeeting04_B"
    }
    {
      Id = "Apollo_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Monster itu, benar-benar musnah... kau mengalahkannya, selamanya! Bukannya keyakinanku padamu goyah sejak kemenangan pertamamu, hanya saja... aku masih belum sepenuhnya percaya. Jadi, sekarang giliran Chronos, ya?"
      Speaker = "Apollo"
      Event = "ApolloPalaceAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_3869"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang giliran Chronos. Satu hasil memuaskan sering kali memicu hasil baik lainnya. Dan mungkin kalian semua bisa beristirahat sejenak. Aku yakin kalian membutuhkannya."
      Speaker = "Melinoe"
      Event = "ApolloPalaceAboutTyphonDeath01"
    }
    {
      Id = "Apollo_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan Prometheus dan yang lainnya masih bikin onar, kami belum bisa bersantai-santai dulu. Terutama saat musuh utama kita masih berkeliaran di luar sana. Habisi dia, mentari."
      Speaker = "Apollo"
      Event = "ApolloPalaceAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_3870"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Serahkan padaku."
      Speaker = "Melinoe"
      Event = "ApolloPalaceAboutTyphonDeath01"
    }
    {
      Id = "Apollo_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau menurutku sih, kita seharusnya mengadakan pesta perjamuan untuk merayakan namamu, mentari. Tapi Dionysus masih belum kelihatan batang hidungnya, dan tamu baru kita menyita hampir seluruh perhatian. Tak lama lagi kita juga tak akan membiarkan siapa pun masuk dari luar."
      Speaker = "Apollo"
      Event = "ApolloPalacePostTrueEnding01"
    }
    {
      Id = "MelinoeField_3920"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak apa, Sepupu, lagipula aku bukan tipe yang suka berpesta. Dan kita memang harus mencari tempat untuk kakek kita itu. Apa kau tahu apa rencana Paduka Paman Zeus untuknya?"
      Speaker = "Melinoe"
      Event = "ApolloPalacePostTrueEnding01"
    }
    {
      Id = "Apollo_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak tahu persis, tapi dugaanku dia mengirim Chronos kembali ke Underworld, ke hadapan Tuan Hades. Tampaknya mereka sudah mencapai semacam kesepakatan. Jadi, kau benar-benar berpikir kakek kita sudah berubah?"
      Speaker = "Apollo"
      Event = "ApolloPalacePostTrueEnding01"
    }
    {
      Id = "MelinoeField_3921"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir dia punya sudut pandang yang berbeda sekarang, ya. Kalau tentangku, sepertinya aku tak akan bisa kembali lagi dalam waktu dekat. Tempat ini benar-benar tiada bandingnya, dan di setiap kunjungan, kau selalu membuatku merasa disambut hangat. Terima kasih untuk itu dan segalanya."
      Speaker = "Melinoe"
      Event = "ApolloPalacePostTrueEnding01"
    }
    {
      Id = "Apollo_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, ayolah, kamilah yang seharusnya berterima kasih padamu, dan harus kutegaskan, sangat-sangat berterima kasih. Lagian, ini bukan perpisahan selamanya. Aku akan tetap menghubungimu lewat Berkah, ya?"
      Speaker = "Apollo"
      Event = "ApolloPalacePostTrueEnding01"
    }
    {
      Id = "MelinoeField_3922"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah."
      Speaker = "Melinoe"
      Event = "ApolloPalacePostTrueEnding01"
    }
    {
      Id = "Apollo_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siap untuk kembali lagi? Kemarilah, biar kuterangi jalanmu."
      Speaker = "Apollo"
      Event = "ApolloPalacePostZeusChat01"
    }
    {
      Id = "Apollo_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pekerjaan luar biasa seperti biasa, mentari. Kami semua bersyukur kau datang ke sini."
      Speaker = "Apollo"
      Event = "ApolloPalacePostZeusChat02"
    }
    {
      Id = "Apollo_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat ini mungkin kau lebih memilih berada di tempat yang tidak seterang ini."
      Speaker = "Apollo"
      Event = "ApolloPalacePostZeusChat03"
    }
    {
      Id = "Apollo_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya berkat dirimulah aku bisa duduk dan memetik dawai di masa-masa seperti ini."
      Speaker = "Apollo"
      Event = "ApolloPalacePostZeusChat04"
    }
    {
      Id = "Apollo_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kau bisa tinggal lebih lama karena kau baru saja tiba, meski aku tahu sekarang bukan saatnya. Hati-hati di luar sana."
      Speaker = "Apollo"
      Event = "ApolloPalacePostZeusChat05"
    }
    {
      Id = "Apollo_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihatmu, mentari, tapi sebaiknya kau bicara pada Ayah dulu."
      Speaker = "Apollo"
      Event = "ApolloPalacePreZeusChat01"
    }
    {
      Id = "Apollo_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebaiknya jangan biarkan Paduka Pamanmu menunggu. Aku akan tetap di sini."
      Speaker = "Apollo"
      Event = "ApolloPalacePreZeusChat02"
    }
    {
      Id = "Apollo_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku, {#Emph}ehm{#Prev}, rasa Sang Raja dan Ratu ingin bicara denganmu?"
      Speaker = "Apollo"
      Event = "ApolloPalacePreZeusChat03"
    }
    {
      Id = "MelinoeField_4326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senang sekali bertemu denganmu."
      Speaker = "Melinoe"
      Event = "NPC_Demeter_Story_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_4327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, Nyonya Demeter!"
      Speaker = "Melinoe"
      Event = "NPC_Demeter_Story_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_4328"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nenek."
      Speaker = "Melinoe"
      Event = "NPC_Demeter_Story_01.InteractVoiceLines"
    }
    {
      Id = "Demeter_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan kau juga, tentu saja."
      Speaker = "Demeter"
      Event = "NPC_Demeter_Story_01.InteractVoiceLines"
    }
    {
      Id = "Demeter_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nenek."
      Speaker = "Demeter"
      Event = "NPC_Demeter_Story_01.InteractVoiceLines"
    }
    {
      Id = "Demeter_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hm."
      Speaker = "Demeter"
      Event = "NPC_Demeter_Story_01.InteractVoiceLines"
    }
    {
      Id = "Demeter_0208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lakukanlah."
      Speaker = "Demeter"
      Event = "NPC_Demeter_Story_01.InteractVoiceLines"
    }
    {
      Id = "Demeter_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu jalannya."
      Speaker = "Demeter"
      Event = "NPC_Demeter_Story_01.InteractVoiceLines"
    }
    {
      Id = "Demeter_0210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sesuai kehendakmu."
      Speaker = "Demeter"
      Event = "NPC_Demeter_Story_01.InteractVoiceLines"
    }
    {
      Id = "Demeter_0211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah kalau begitu."
      Speaker = "Demeter"
      Event = "NPC_Demeter_Story_01.InteractVoiceLines"
    }
    {
      Id = "Demeter_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kembang puspaku, ini benar-benar {#Emph}kamu! {#Prev}Maafkan aku, aku... kita harus tetap menjaga tata krama di sini, tapi... Aku sangat senang melihatmu langsung berdiri di hadapanku, alih-alih hanya lewat remangnya Berkah."
      Speaker = "Demeter"
      Event = "DemeterPalaceFirstMeeting"
    }
    {
      Id = "MelinoeField_4318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lady Demeter, sebuah kehormatan bagiku. Aku tahu semua orang sedang sibuk menghadapi kepungan ini, dan pasti tidak mudah bagi Anda untuk bisa ke sini sekarang."
      Speaker = "Melinoe"
      Event = "DemeterPalaceFirstMeeting"
    }
    {
      Id = "Demeter_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kau memanggilku Nenek; meski mungkin jangan di sini. Aku sangat kesal karena melewatkanmu saat kau berkunjung sebelumnya, dan tak akan membiarkan hal itu terulang lagi. Namun kau tak bisa tinggal lama, kan...?"
      Speaker = "Demeter"
      Event = "DemeterPalaceFirstMeeting"
    }
    {
      Id = "MelinoeField_4319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayangnya tidak. Sekarang setelah Typhon diatasi untuk sementara, sebaiknya aku segera kembali. Aku sangat bersyukur bisa bertemu dengan Nenek seperti ini! Apakah kita akan bertemu lagi?"
      Speaker = "Melinoe"
      Event = "DemeterPalaceFirstMeeting"
    }
    {
      Id = "Demeter_0198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika Sang Takdir masih punya belas kasihan di hati mereka, tentu saja."
      Speaker = "Demeter"
      Event = "DemeterPalaceFirstMeeting"
    }
    {
      Id = "Demeter_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Badaianya telah reda... monster itu mengacaukan cuaca sampai-sampai Lord Zeus maupun aku tak sanggup menghentikannya secara sempurna. Namun sekarang dia sudah lenyap, dan semua berkat dirimu."
      Speaker = "Demeter"
      Event = "DemeterPalaceAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_4321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua orang patut berterima kasih, Nenek. Typhon takluk oleh gabungan kekuatan para dewa. Aku hanya memusatkan kekuatan dahsyat kita. Sekarang saatnya memanfaatkan keunggulan ini."
      Speaker = "Melinoe"
      Event = "DemeterPalaceAboutTyphonDeath01"
    }
    {
      Id = "Demeter_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan mungkin Chronos pun tak akan sanggup menahan kekuatan yang kau lepaskan tadi. Namun tetaplah berhati-hati, Cucuku. Pastikan kita akan bertemu lagi nanti."
      Speaker = "Demeter"
      Event = "DemeterPalaceAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_4322"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti."
      Speaker = "Melinoe"
      Event = "DemeterPalaceAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_4323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berhasil, Nenek! Nenek sudah berjuang begitu keras demi diriku... demi kita semua. Namun, pasti berat rasanya melihat Chronos lagi."
      Speaker = "Melinoe"
      Event = "DemeterPalacePostTrueEnding01"
    }
    {
      Id = "Demeter_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan meliriknya sekilas saja tak sudi bagiku, Melinoë. Sang Titan itu bakal menemui takdir yang jauh berbeda andai aku yang memutuskannya, tapi... aku bersyukur keadaannya tidak berakhir lebih buruk."
      Speaker = "Demeter"
      Event = "DemeterPalacePostTrueEnding01"
    }
    {
      Id = "MelinoeField_4324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari yang kupahami, ini mungkin perpisahan untuk sementara waktu. Setidaknya secara tatap muka! Aku masih akan menemuimu hampir setiap malam, jika Nenek masih bersedia terus membantuku lewat Berkah."
      Speaker = "Melinoe"
      Event = "DemeterPalacePostTrueEnding01"
    }
    {
      Id = "Demeter_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja. Dan kelak akan tiba saatnya lagi ibumu bakal mengunjungi kami selama separuh tahun. Mungkin nanti kau bisa ikut dengannya, paling tidak sekali setiap beberapa musim."
      Speaker = "Demeter"
      Event = "DemeterPalacePostTrueEnding01"
    }
    {
      Id = "Demeter_0281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, dan ini dia... agar kau tetap hangat."
      Speaker = "Demeter"
      Event = "DemeterPalacePostTrueEnding01"
    }
    {
      Id = "MelinoeField_5019"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nenek, ini untukku? Terima kasih banyak..."
      Speaker = "Melinoe"
      Event = "DemeterPalacePostTrueEnding01"
    }
    {
      Id = "MelinoeField_4325"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan sangat senang jika bisa begitu."
      Speaker = "Melinoe"
      Event = "DemeterPalacePostTrueEnding01_B"
    }
    {
      Id = "Chronos_1419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu dia, akhirnya ketemu juga! Kau bisa saja membuatku terus mencari lebih lama lagi, tempat persembunyian yang kau temukan di balik bayang-bayang itu aman sekali!"
      Speaker = "Chronos"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "MelinoeField_5056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lama sekali Kakek menemukanku! Aku sampai sempat mengira tak akan pernah melihat Kakek lagi!"
      Speaker = "Melinoe"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "Chronos_1420"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Persis sekali dengan apa yang diucapkan ayahmu sewaktu Zagreus pertama kali membawaku ke sini! Nah, apa kita bakal bermain satu putaran lagi?"
      Speaker = "Chronos"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "MelinoeField_5057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Enggak mau... permainan ini terlalu gampang. Ceritakan kisah Kakek yang lain saja! Tentang Zaman Keemasan!"
      Speaker = "Melinoe"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "Chronos_1421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin nanti kalau kau sudah lebih besar, jangan sampai ayahmu murka. Kalau {#Emph}kau {#Prev}yang membangkang padanya, kau hanya kena teguran ringan. Tapi kalau {#Emph}aku {#Prev}yang membangkang, aku bakal dicincang jadi potongan-potongan kecil sekali suap, lalu disebarkan ke seantero Tartarus!"
      Speaker = "Chronos"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "MelinoeField_5058"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Haha, jorok sekali! {#Prev}Yah, kalau Ayah berani melakukan itu, aku tinggal pergi mencari semua potongannya dan menyatukan Kakek kembali!"
      Speaker = "Melinoe"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "Chronos_1422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tutur kata yang manis dan penuh kemurahan hati khas anak-anak. Hanya kaulah satu-satunya orang di sini yang mau mengatakan hal seperti itu, Melinoë."
      Speaker = "Chronos"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "MelinoeField_5059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Tapi, apa yang lain tidak menyukai Kakek?"
      Speaker = "Melinoe"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "Chronos_1423"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, mereka mana pernah bosan denganku, Cucuku tersayang, hanya saja... kami masih punya perbedaan pandangan. Tapi sudahlah, tak perlu kupusingkan dirimu dengan masa lalu. Satu-satunya masa yang penting adalah saat ini. Dan saat ini..."
      Speaker = "Chronos"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "Chronos_1424"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kena kau! {#Prev}Sekarang kau yang jaga!"
      Speaker = "Chronos"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "MelinoeField_5060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Haha! Hei! {#Prev}Curang!"
      Speaker = "Melinoe"
      Event = "MelinoeHideAndSeek01"
    }
    {
      Id = "MelinoeField_5165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebuah kehormatan bagi saya, Tuan."
      Speaker = "Melinoe"
      Event = "NPC_Achilles_01.InteractVoiceLines"
    }
    {
      Id = "Achilles_0006"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kehormatan ini milikku juga."
      Speaker = "Achilles"
      Event = "NPC_Achilles_01.InteractVoiceLines"
    }
    {
      Id = "Achilles_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah mau berangkat? Olympus memang tak suka dibiarkan menunggu lama, aku paham. Kami akan selalu mengingatmu di sini, Nak! Rasanya entah kenapa masih terasa seolah kita baru saja saling jumpa. Sungguh saat-saat yang aneh..."
      Speaker = "Achilles"
      Event = "AchillesTrueEnding01"
    }
    {
      Id = "MelinoeField_5216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang begitu rasanya, Tuan Achilles. Aku sekarang mendapati sekilas momen-momen berharga yang mungkin bisa kuhabiskan bersama Tuan dan para Pelayan Rumah lainnya, andai saja masa lalu berjalan secara berbeda. Bagaimana kabar yang lainnya?"
      Speaker = "Melinoe"
      Event = "AchillesTrueEnding01"
    }
    {
      Id = "Achilles_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya mereka baik-baik saja. Kerabat-kerabatmu pulih paling cepat, namun kurasa kami semua masih merasakan sisa-sisa dampaknya... kami sedang mengejar segala hal yang kami lewatkan, dan membantu sebisa mungkin."
      Speaker = "Achilles"
      Event = "AchillesTrueEnding01"
    }
    {
      Id = "MelinoeField_5231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan merindukan kalian semua. Terkadang semua ini benar-benar terasa bagaikan mimpi! Aku takut nanti bakal melupakannya, seperti halnya orang-orang yang melupakan mimpinya."
      Speaker = "Melinoe"
      Event = "AchillesTrueEnding01"
    }
    {
      Id = "Achilles_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh. {#Prev}Kuyakini kau masih ingat apa yang selalu kukatakan padamu soal rasa takut. Tolong jangan cemas... Aku tahu kita mungkin takkan bertemu untuk sementara waktu, tapi aku akan selalu menanti kapan pun kita bisa berjumpa lagi."
      Speaker = "Achilles"
      Event = "AchillesTrueEnding01"
    }
    {
      Id = "MelinoeField_5164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pun aku."
      Speaker = "Melinoe"
      Event = "AchillesTrueEnding01"
    }
    {
      Id = "Apollo_0199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini untukmu."
      Speaker = "Apollo"
      Event = "GlobalVoiceLines.ApolloSendOffVoiceLines"
    }
    {
      Id = "Apollo_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga ini membantumu pulang ke rumah."
      Speaker = "Apollo"
      Event = "GlobalVoiceLines.ApolloSendOffVoiceLines"
    }
    {
      Id = "Apollo_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hatilah di sana."
      Speaker = "Apollo"
      Event = "GlobalVoiceLines.ApolloSendOffVoiceLines"
    }
    {
      Id = "Apollo_0202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu Berkah untukmu."
      Speaker = "Apollo"
      Event = "GlobalVoiceLines.ApolloSendOffVoiceLines"
    }
    {
      Id = "MelinoeField_3833"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bolehkah aku...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ApolloSendOffVoiceLines"
    }
    {
      Id = "Zeus_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa!"
      Speaker = "Zeus"
      Event = "GlobalVoiceLines.ZeusSendOffVoiceLines"
    }
    {
      Id = "Zeus_0305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai kita bertemu lagi."
      Speaker = "Zeus"
      Event = "GlobalVoiceLines.ZeusSendOffVoiceLines"
    }
    {
      Id = "Zeus_0307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mendapatkan restu kami."
      Speaker = "Zeus"
      Event = "GlobalVoiceLines.ZeusSendOffVoiceLines"
    }
    {
      Id = "Zeus_0308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maju terus!"
      Speaker = "Zeus"
      Event = "GlobalVoiceLines.ZeusSendOffVoiceLines"
    }
    {
      Id = "Zeus_0309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga dirimu baik-baik."
      Speaker = "Zeus"
      Event = "GlobalVoiceLines.ZeusSendOffVoiceLines"
    }
    {
      Id = "Hera_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga perjalananmu lancar!"
      Speaker = "Hera"
      Event = "GlobalVoiceLines.HeraSendOffVoiceLines"
    }
    {
      Id = "Hera_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hatilah."
      Speaker = "Hera"
      Event = "GlobalVoiceLines.HeraSendOffVoiceLines"
    }
    {
      Id = "Hera_0222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat tinggal."
      Speaker = "Hera"
      Event = "GlobalVoiceLines.HeraSendOffVoiceLines"
    }
    {
      Id = "Hera_0223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lekaslah kembali!"
      Speaker = "Hera"
      Event = "GlobalVoiceLines.HeraSendOffVoiceLines"
    }
    {
      Id = "MelinoeField_3410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Belum saatnya... Dalam mimpi, aku akan tetap Tak Kasatmata."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MirrorInitialInspectLines"
    }
    {
      Id = "MelinoeField_3411"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah begitu banyak mimpi di tempat ini... kalau begitu, satu lagi."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamBedUsedLines"
    }
    {
      Id = "MelinoeField_3412"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ke dalam palung bawah sadar, aku menyelam...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamBedUsedLines"
    }
    {
      Id = "MelinoeField_3413"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ke dalam palung bawah sadar, aku menyelam...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamBedUsedLines"
    }
    {
      Id = "MelinoeField_5192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah. {#Emph}Ke dalam palung bawah sadar, aku menyelam...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamBedUsedLines"
    }
    {
      Id = "MelinoeField_5191"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekali lagi. {#Emph}Ke dalam palung bawah sadar, aku menyelam...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamBedUsedLines"
    }
    {
      Id = "MelinoeField_5193"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fyuuh... Ke dalam palung bawah sadar, aku menyelam...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamBedUsedLines"
    }
    {
      Id = "MelinoeField_5042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fyuuh{#Prev}, baiklah... fokus..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamPresentationLines"
    }
    {
      Id = "MelinoeField_3414"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebuah jalinan... langkah pertama..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamPresentationLines"
    }
    {
      Id = "MelinoeField_3415"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang Cerminnya..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamPresentationLines"
    }
    {
      Id = "MelinoeField_3416"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berhasil..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamPresentationLines"
    }
    {
      Id = "MelinoeField_3409"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada sesuatu di samping ranjang...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamPresentationLines"
    }
    {
      Id = "MelinoeField_3417"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Dan sekarang langkah kedua."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MirrorUsedLines"
    }
    {
      Id = "MelinoeField_5196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Malam dan Kegelapan? Bimbinglah aku menuju darah dagingku di luar cengkeraman Sang Waktu!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MirrorUsedLines"
    }
    {
      Id = "MelinoeField_3418"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Malam dan Kegelapan, bimbinglah aku menuju darah dagingku di luar cengkeraman Sang Waktu!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MirrorUsedLines"
    }
    {
      Id = "MelinoeField_3419"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Malam dan Kegelapan, bimbinglah aku menuju darah dagingku di luar cengkeraman Sang Waktu...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MirrorUsedLines"
    }
    {
      Id = "MelinoeField_5194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang. {#Emph}Malam dan Kegelapan, bimbinglah aku menuju darah dagingku di luar cengkeraman Sang Waktu...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MirrorUsedLines"
    }
    {
      Id = "MelinoeField_5195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekali lagi. {#Emph}Malam dan Kegelapan, bimbinglah aku menuju darah dagingku di luar cengkeraman Sang Waktu!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MirrorUsedLines"
    }
    {
      Id = "MelinoeField_3420"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kabut kenangan..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TimeHallPresentationLines"
    }
    {
      Id = "MelinoeField_5205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kepala Sekolah... kau selalu berpesan untuk memercayai naluriku. Baiklah, ini dia..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TimeHallPresentationLines"
    }
    {
      Id = "MelinoeField_5041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenang, aku harus menenangkan diri... jangan sampai membuatnya lebih gugup dariku..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TimeHallPresentationLines"
    }
    {
      Id = "Zagreus_0002"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aargh, {#Prev}tetap rebah di sana, sialan! Sudah kucoba air, minyak, Nektar, Ambrosia, tapi {#Emph}tetap saja tidak mau!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "MelinoeField_3421"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Suara itu, mungkinkah..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0003"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana kalau pakai darah? Belum coba darah... kedengarannya gila sekali, tapi aku sudah kehabisan akal sehat di sini."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0004"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin aku coba minta baik-baik. {#Emph}Rambut? {#Prev}Bisa tolong diam sebentar dan rebah? {#Emph}Kumohon? {#Prev}Ini kan hari yang istimewa."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0005"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tidak mau dengar. Kau mengejekku, ya! {#Emph}Baiklah. {#Prev}Begitu caramu, ya. Main-main begini aku juga bisa, tahu!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0006"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana kalau kubabat habis saja sekalian? Mau seperti itu? Kuambilkan Stygius lagi dan kupangkas bersih kau! Pikirkan baik-baik itu!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0017"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tetaplah... {#Emph}rebah! {#Prev}Jangan... {#Emph}aargh{#Prev}, sial... kukira tadi sudah berhasil. Tadi {#Emph}nyaris {#Prev}bisa! Kau mulai melemah, kan? Mungkinkah?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "MelinoeField_3422"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kakak...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini pasti berhasil... harus berhasil... maksudku, kenapa tidak? Kalau semua yang dia katakan pernah terjadi memang akan terjadi."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maksudku, itu sangat masuk akal, kan? {#Emph}Aargh. {#Prev}Yah, bagaimanapun juga kita akan segera tahu. Asalkan dia muncul."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia agak mirip Ibu, ya... yang artinya... astaga, sial... tidak pernah terpikirkan olehku... aku sangat mirip {#Emph}dia{#Prev}, begitu? Bedanya hanya tanpa janggut? {#Emph}Aargh..."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0026"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini mimpi yang itu... yang artinya... dia pasti sudah dekat... Melinoë? Melinoë... nama yang indah. Melinoë! Kau ada di sana? Tidak ada...?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "MelinoeField_3423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kakak...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo... ayolah, ke mana dia...? Di {#Emph}mana {#Prev}dia? Jangan buat aku menunggu begini, Adikku, ayolah... cepat atau lambat aku ingin bisa tidur nyenyak..."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "MelinoeField_3424"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kakak..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0442"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aneh sekali, aku... kurasa aku merasa agak tegang. Padahal sedang tidur? Harusnya kan tenang dan santai. Tapi yah, kurasa ini lebih mirip mimpi buruk. Nah, itu jauh lebih masuk akal! Aku akan... menunggu di sini dengan tenang..."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0452"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mencibir> {#Prev}Akan menghantui mimpiku, katanya. Kalau begitu, ayo buktikan! Ini sih hampir tidak bisa dibilang dihantui... cuma berdiri mondar-mandir, {#Emph}menunggu {#Prev}untuk dihantui. Paling banter cuma... firasat buruk samar-samar. Jauh dari sensasi mencekam yang kubayangkan..."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0050"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana kalau terjadi sesuatu... pasti terjadi sesuatu... tapi kalau begitu, bagaimana bisa aku masih bermimpi? Kalau memang ini mimpi. Oh, sial, di mana dia... kapan dia datang...?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cermin tua ini benar-benar sangat berguna, harus kuakui... dan aku akan sangat menghargainya jika benda ini bisa berguna lagi sekarang. Atau sekarang? Kapan pun...?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di mana dia... di {#Emph}mana {#Prev}dia... {#Emph}hrm... {#Prev}yah... sejauh ini bukan mimpi yang paling menarik, harus kuakui... walau pada akhirnya dia tak pernah {#Emph}absen {#Prev}datang..."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo...? {#Emph}Halo! {#Prev}Adikku? Ke mana dia pergi... aku bisa merasakannya, tapi..."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, apa itu...? Kurasa itu {#Emph}dia... {#Prev}Melinoë, bisa dengar aku di sana? Katakan sesuatu, ayolah?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akhir-akhir ini mimpi menatap ke Cermin terus... eh tunggu, kurasa itu {#Emph}dia... {#Prev}Melinoë, kau di sana?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu lagi mimpi berulang seperti ini, ya... di {#Emph}mana {#Prev}kau, Adikku? Ayolah, aku tidak mau memandangi bayanganku sendiri di sini sepanjang hari... malam. Kapan pun itu."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastMirrorLines"
    }
    {
      Id = "Zagreus_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, Melinoë! Kuharap ini berhasil..."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastFollowUpLines"
    }
    {
      Id = "Zagreus_0007"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Tunggu, {#Emph}apa...?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastGreetingLines"
    }
    {
      Id = "Zagreus_0018"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Oh...!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.ZagreusPastGreetingLines"
    }
    {
      Id = "Zagreus_0027"
