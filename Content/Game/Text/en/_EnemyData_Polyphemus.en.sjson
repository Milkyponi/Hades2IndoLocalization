    {
      Id = "MelinoeField_3740"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana perginya Nyonya Medea..."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktunya tidur."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat tidur."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan jangan bangun lagi."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpi yang indah."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepar seketika."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar tahu rasa dia."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1723"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan halangi jalanku."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1726"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Makan {#Emph}tuh."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5582"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa-bisanya kau tidur pulas bahkan di sini...?"
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5583"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tukang tidur paling kebo yang pernah kutemui."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_3741"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nyonya Medea sudah pergi..."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1724"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tertidur lelap lagi..."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1725"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidur yang nyenyak, Cyclops..."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1727"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kelelahan total."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1728"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktunya tidur siang."
      Speaker = "Melinoe"
      Event = "Polyphemus.BossKillVoiceLines"
    }
    {
      Id = "Polyphemus_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menakut-nakuti dombaku. Itu pantangan besar di kota ini."
      Speaker = "Polyphemus"
      Event = "PolyphemusFirstMeeting"
    }
    {
      Id = "Melinoe_0490"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku minta maaf atas kelancanganku, Cyclops. Berapa yang harus kubayar atas ketidaknyamanan ini? Aku sanggup membayarnya."
      Speaker = "Melinoe"
      Event = "PolyphemusFirstMeeting"
    }
    {
      Id = "Polyphemus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau pasti bakal bayar. Hukumannya adalah dimakan hidup-hidup. Oleh {#Emph}aku{#Prev}. Maaf ya, bukan aku yang bikin peraturannya."
      Speaker = "Polyphemus"
      Event = "PolyphemusFirstMeeting"
    }
    {
      Id = "Melinoe_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hukuman itu terdengar terlalu berlebihan. Tidak ada gunanya mematuhi hukum yang tak masuk akal."
      Speaker = "Melinoe"
      Event = "PolyphemusFirstMeeting"
    }
    {
      Id = "Polyphemus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah{#Prev}, cuma bercanda! Akulah yang {#Emph}bikin {#Prev}peraturannya. Dan aku bosan sekali kalau cuma makan domba melulu."
      Speaker = "Polyphemus"
      Event = "PolyphemusFirstMeeting"
    }
    {
      Id = "MelinoeField_2448"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, makanlah debu!"
      Speaker = "Melinoe"
      Event = "PolyphemusFirstMeeting"
    }
    {
      Id = "Medea_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih banyak, penyihir! Menanamkan Rasa Takut ke dalam malam membuatku bisa melangsungkan eksperimen tertentu yang biasanya mustahil kulakukan. Meski aku juga terikat kewajiban untuk mengujimu di sini, layaknya Hecate yang Agung di bawah sana."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight01"
    }
    {
      Id = "MelinoeField_3546"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mengujiku{#Prev}! Nyonya Medea, bagaimana dengan Cyclops raksasa yang sudah menghadang jalanku ini? Dia akan mencoba memakan kita berdua!"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight01"
    }
    {
      Id = "Polyphemus_0474"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak juga. {#Prev}Penyihir yang ini bukan seleraku, dan lagipula... kami sudah punya kesepakatan kecil sekarang. Soalnya hidungku agak susah mencium mangsa gara-gara mayat bergelimpangan di mana-mana."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight01"
    }
    {
      Id = "Medea_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lawanmu tetaplah si Cyclops! Tujuanku semata-mata menjalankan kehendak Sang Malam dengan caraku sendiri. Berusahalah sebisamu menganggap aku tak ada di sini, walau sejujurnya, itu mungkin agak sulit..."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight01"
    }
    {
      Id = "MelinoeField_4331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Medea! Kupikir kau seharusnya sedang melakukan penelitian. Dan apa maksudmu dengan {#Emph}mengujiku? {#Prev}Cyclops raksasa yang sudah menghadang jalanku itu akan mencoba memakan kita berdua!"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight01_B"
    }
    {
      Id = "Medea_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau serius, Cyclops? Mayat orang mati {#Emph}tidak boleh {#Prev}dimakan; sarang segala macam penyakit dan sebangsanya!"
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight02"
    }
    {
      Id = "Polyphemus_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kubilang juga apa, daging mereka lumayan enak tahu! Cuma perlu difermentasi dengan pas. Tapi sudahlah, kita bahas itu nanti saja. Ada yang masih {#Emph}hangat {#Prev}tuh di sana."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight02"
    }
    {
      Id = "MelinoeField_3547"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Medea, aku tak percaya kalian berdua bisa akrab begini. Apakah Wasiat Sang Malam mengharuskanmu bersekutu dengan pihak yang menghalangi jalan kita?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight02"
    }
    {
      Id = "Medea_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami cuma punya ketertarikan yang sama, penyihir! Cyclops ini masih berdiri menghadang jalan{#Emph}mu{#Prev}, jadi seranglah dia! Aku di sini untuk membuat malam semakin mengerikan atas permintaanmu sendiri."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight02"
    }
    {
      Id = "Polyphemus_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ke mana perginya penyihir yang tadi, dan semua mayatnya, {#Emph}hah? {#Prev}Padahal aku baru saja mulai menyukai aroma baru di sekitar sini..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight03"
    }
    {
      Id = "MelinoeField_3548"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan kita semua tunduk pada kehendak Sang Malam, Cyclops. Nyonya Medea ditarik ke sini hanya demi alasan itu. Bagiku sendiri, rasanya lebih mudah tanpa harus menghadapi kalian berdua sekaligus."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight03"
    }
    {
      Id = "Polyphemus_0477"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ingin segalanya {#Emph}mudah{#Prev}, lalu buat apa kau kemari? Kau baru saja melewati salah satu kota terkeras yang kutahu, dan situasinya cuma bakal makin kasar."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight03"
    }
    {
      Id = "Polyphemus_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membereskannya, daging segar! Penyihir ini kembali lagi, mayat ada di mana-mana! Rezekiku melimpah. Tapi nasibmu bakal jadi {#Emph}sangat buruk."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight04"
    }
    {
      Id = "MelinoeField_3549"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Medea, bukankah kau seharusnya berpihak padaku di sini daripada berpihak pada{#Emph}nya? {#Prev}Meski begitu, kehendak Sang Malam tak boleh dipertanyakan, dan ini semua bagian dari Sumpah yang kuikrarkan..."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight04"
    }
    {
      Id = "Medea_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam membawa teror, wahai penyihir... rasa takut akan kemustahilan dan ketidaktahuan. Aku hanya menjalankan tanggung jawabku demi tujuan itu, jadi tolong! Hadapilah Tuan Polyphemus di sini, jangan aku."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight04"
    }
    {
      Id = "Polyphemus_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! Tuan Polyphemus. {#Prev}Kayaknya aku suka sebutan itu! Lagian, para bangsawan memang punya nafsu makan yang besar. Sekarang kemarilah dan kubuat kau jadi tumpukan mayat di tanah."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight04"
    }
    {
      Id = "Polyphemus_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan dengan semua mayat tambahan di sini, hidungku selalu bisa mengendus keberadaanmu. Kau berada di wilayahku, dan mulai sekarang panggil aku {#Emph}Tuan Polyphemus{#Prev}."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight05"
    }
    {
      Id = "MelinoeField_3550"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti bercanda. Kau tak berhak atas kedudukan mulia hanya karena kau memintanya! Atau jangan-jangan Nyonya Medea telah meracuni pikiranmu dengan delusi baru?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight05"
    }
    {
      Id = "Medea_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan lihat ke arah{#Emph}ku{#Prev}, penyihir. Aku di sini murni atas kehendak Sang Malam, terikat oleh Sumpah Membisu... meski cukup sulit untuk menepatinya."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight05"
    }
    {
      Id = "Polyphemus_0481"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia nggak mau bicara denganmu, katanya tadi, tapi kau terus saja mendesaknya. Dan tahu apa? Aku juga ogah bicara denganmu."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight05"
    }
    {
      Id = "Polyphemus_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kubilang juga apa, rasanya aneh. Gatal-gatal mungkin, agak perih juga, entahlah. Kau yakin ramuan ini bakal membantuku tidur nyenyak?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight06"
    }
    {
      Id = "Medea_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, bagi manusia fana, ramuan itu memberikan tidur abadi, yang diawali dengan rasa sakit tiada tara. Aku tak menjanjikan apa-apa lagi, dan... kalau dipikir-pikir? Ini mungkin bukan obat yang tepat untukmu..."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight06"
    }
    {
      Id = "Polyphemus_0483"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya ramuan ini nggak terlalu merusak indra penciumanku. Karena kalau iya, aku nggak bakal tahu kalau ada orang lain di sini yang sepertinya butuh {#Emph}obat-obatanmu{#Prev}."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight06"
    }
    {
      Id = "Polyphemus_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Endus, Endus> Hih{#Prev}, hidung sialanku ini mampet total. Kayaknya aku alergi sama sesuatu yang kau bawa itu, penyihir."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight07"
    }
    {
      Id = "Medea_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau kebal terhadap racun yang bahkan bisa merobohkan banteng terkuat sekalipun, Yang Mulia Polyphemus. Mungkinkah kau enggan melawan penyihir yang harus kita hadapi ini?"
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight07"
    }
    {
      Id = "Polyphemus_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Mendengus> {#Prev}Apa, dia ada di {#Emph}sini? Ugh{#Prev}, payah benar indraku kalau sampai tak bisa mencium baunya padahal dia tepat di depanku begini."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight07"
    }
    {
      Id = "Polyphemus_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mendengus> Itu {#Prev}dia..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight07"
    }
    {
      Id = "Polyphemus_0487"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Endus, Endus> {#Prev}Lalu apa yang harus kulakukan di malam-malam begini? Kalau baunya saja tak tercium, aku tak tahu ke mana arah tendanganku harus dilayangkan."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight08"
    }
    {
      Id = "Medea_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang Mulia Polyphemus, saluran hidungmu pasti benar-benar tersumbat parah. Sosok yang kau maksud itu ada tepat di {#Emph}sana! {#Prev}Lain kali, aku harus meracik sesuatu yang bisa kau gunakan."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight08"
    }
    {
      Id = "Polyphemus_0488"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Mendengus> {#Prev}Boleh juga, kedengarannya bagus, tak buruk-buruk amat. Masalahnya kalau makananku tak tercium, santapanku jadi terasa hambar."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight08"
    }
    {
      Id = "Polyphemus_0489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mendengus> Ahh..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight08"
    }
    {
      Id = "Polyphemus_0490"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Tarik napas> Ya{#Prev}, kurasa racikanmu itu manjur juga! Soalnya aku bisa mencium tiap bangkai di ladang seberang sana. Kau hebat juga, penyihir! Apa sebenarnya yang kau {#Emph}berikan {#Prev}padaku tadi?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight09"
    }
    {
      Id = "Medea_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, hanya... ramuan obat herbal usang pemberian bibiku yang kusimpan. Kupikir takkan pernah ada gunanya, tapi... aku tak tega membuangnya begitu saja."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight09"
    }
    {
      Id = "Polyphemus_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, dermawan sekali dirimu, walau sekarang nafsu makanku jadi bangkit untuk melahap camilan. Atau mungkin tidur siang sejenak? Kau mau tinggal di sini lebih lama?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight09"
    }
    {
      Id = "Medea_0204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, tentu {#Emph}saja..."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight09"
    }
    {
      Id = "Medea_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bagaimanapun juga, Yang Mulia Polyphemus, kita seharusnya tidak berbincang seperti ini, karena itu bukan tugasku. Namun jika kau butuh obat atau racun lain, panggil saja aku."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight10"
    }
    {
      Id = "MelinoeField_3663"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Medea, kau bersekongkol dengan Polyphemus bahkan tanpa berlakunya Sumpah yang Tak Kasatmata? Aku sungguh tak habis pikir! Dia itu berulang kali mencoba melahapku!"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight10"
    }
    {
      Id = "Polyphemus_0492"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jaga omonganmu itu, seonggok daging. Sang penyihir baru saja bilang dia tak ingin bicara. Kalau ada yang ingin kau sampaikan di sini, sampaikan langsung pada{#Emph}ku."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight10"
    }
    {
      Id = "Medea_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa mengerikannya kesunyian di pinggiran kota ini! Aku sudah terlalu terbiasa dengan hiruk pikuk kota, serta semerbak bau darah dan pembusukan yang pekat."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight11"
    }
    {
      Id = "MelinoeField_3816"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Medea, apakah Kepala Sekolah tahu apa yang kau lakukan di sini? Beliau sama sekali tidak menyebutkan bahwa kau akan mengujiku."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight11"
    }
    {
      Id = "Medea_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hecate yang Agung tahu segalanya. Namun kini setelah kau menjadi Pengampu Sumpah, konsekuensinya ada di tanganmu. Dan malam ini, kau telah mengikrarkan Ikrar tersebut! Sudah lama aku tak sabar untuk menurutinya..."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight11"
    }
    {
      Id = "Medea_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah aku hanya ditakdirkan menjadi bayang-bayang dalam kegelapan...? Aku tak tahan untuk tidak ikut campur, bukan hanya lewat tindakan, tapi juga kata-kata. Yang Mulia Polyphemus, ajak dia bicara, bisa?"
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight12"
    }
    {
      Id = "Polyphemus_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu, apa pun katamu, penyihir. Biar kulayani dan ku{#Emph}ceramahi {#Prev}seonggok daging yang baunya tercium di sini."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutAltFight12"
    }
    {
      Id = "Polyphemus_0509"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, rasanya {#Emph}menyenangkan {#Prev}ada penyihir ini di sekitar. Biasanya aku malas bicara banyak, aku lebih suka mengandalkan penciuman, pendengaran, dan semacamnya. Jadi kubiarkan saja dia yang mengoceh untuk sementara waktu..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAltFightAboutMedea01"
    }
    {
      Id = "Medea_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bila aku boleh melanggar Sumpah Heningku sejenak, kau terlihat sungguh {#Emph}mengenaskan{#Prev}, wahai penyihir! Lebih condong {#Emph}mati {#Prev}daripada {#Emph}hidup. {#Prev}Dan kini sang Cyclops dan aku harus mendorongmu {#Emph}lebih dekat {#Prev}ke {#Emph}jurang kehancuran."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight13"
    }
    {
      Id = "MelinoeField_3818"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat menemui beberapa kesulitan di Ephyra tadi, tapi terima kasih atas perhatianmu. Aku tahu kehendak Malam menuntutmu untuk tak berbelaskasihan padaku di sini; justru sebaliknya."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight13"
    }
    {
      Id = "Medea_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa kehendak Malam bukanlah kekhawatiran utamamu saat ini... Yang Mulia Polyphemus, lihatlah dia benar-benar {#Emph}meneteskan air liur. {#Prev}Dahsyat sekali aroma darah itu! Terutama darah{#Emph}mu."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight13"
    }
    {
      Id = "Medea_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kolam pemulih terkutuk di sudut-sudut arena itu... Mandragora memang tumbuh subur di tanah berlumur darah, tapi dengan begitu, ia menyaring racun-racunnya keluar. Sungguh {#Emph}beruntung {#Prev}sekali nasibmu."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight14"
    }
    {
      Id = "MelinoeField_3819"
      InheritFrom = "BaseNarrative"
      DisplayName = "Racunmu begitu kuat, langsung membuat sekujur tubuhku terasa membara terbakar, meski ada kolam-kolam pemulih itu di dekat sini."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight14"
    }
    {
      Id = "Medea_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau bagaimana lagi? Aku sudah berusaha maksimal! Bahkan kau akan mendapati bahwa, tak peduli berapa kali pun kau terjangkit, kau takkan pernah kebal... apalagi imun."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight14"
    }
    {
      Id = "Medea_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutukan dan ramuanku biasanya berakibat sangat mematikan. Tapi kau mampu bertahan melawannya! Aku tak tahu harus merasa kagum padamu, atau malah kecewa pada diriku sendiri."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight15"
    }
    {
      Id = "MelinoeField_3931"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira ini adalah ujian atas kemampuan dan perkembanganku! Tapi tampaknya lebih seperti tempat uji coba eksperimen terbarumu."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFight15"
    }
    {
      Id = "Medea_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Haruskah terbatas pada salah satu saja? Hecate yang Agung telah mengajarkan kita untuk selalu menimba ilmu baru. Dengan {#Emph}begitu{#Prev}, kita akan tumbuh sekuat racun yang paling mematikan..."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFight15"
    }
    {
      Id = "Medea_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, kita sudah sampai di sini rupanya, wahai penyihir! Baru beberapa saat lalu kita berbincang akrab di samping kualiku, namun sekarang, malah berujung pada hal {#Emph}ini."
      Speaker = "Medea"
      Event = "PolyphemusAltFightMetMedeaEarlier01"
    }
    {
      Id = "MelinoeField_3932"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau harus menghadapiku di sini karena Sumpah yang kita ambil, Nyonya Medea, tapi Cyclops itu sama sekali tak punya alasan sebagus itu..."
      Speaker = "Melinoe"
      Event = "PolyphemusAltFightMetMedeaEarlier01"
    }
    {
      Id = "Medea_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, pertama, kau telah menerobos wilayahnya tanpa izin, dan kedua, dia sedang kelaparan! Lihat dia, sampai-sampai kehilangan kata-kata. Yang Mulia Polyphemus, kau {#Emph}harus {#Prev}bicara sesuatu!"
      Speaker = "Medea"
      Event = "PolyphemusAltFightMetMedeaEarlier01"
    }
    {
      Id = "Polyphemus_0508"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana kalau kali {#Emph}ini {#Prev}kubiarkan {#Emph}kakiku {#Prev}saja yang berbicara?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAltFightMetMedeaEarlier01"
    }
    {
      Id = "Medea_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah, wahai penyihir! Kau begitu berpegang teguh pada Sumpah. Berhubung pertarunganmu tetaplah melawan Yang Mulia Polyphemus, aku akan lebih banyak bungkam mulai saat ini; meski aku sama sekali tak bermaksud untuk bersikap tidak sopan."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFightBackOn01"
    }
    {
      Id = "MelinoeField_3817"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau berada di sini karena kewajiban tertentu, Nyonya Medea, jadi aku tentu tak menaruh dendam. Setidaknya tidak padamu, tapi kalau pada {#Emph}Yang Mulia Polyphemus{#Prev}, aku tidak begitu yakin."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFightBackOn01"
    }
    {
      Id = "Medea_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, dia merajuk lagi. Kuharap kau paham kalau aku tak bertanggung jawab atas tindakan apa pun yang diambil sang Cyclops... Aku saja nyaris tak bisa bertanggung jawab atas tindak-tanduk{#Emph}ku sendiri."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFightBackOn01"
    }
    {
      Id = "Medea_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, aku {#Emph}cukup {#Prev}menikmati tempat ini! Sekalipun aku gemar bereksperimen di sudut kecilku di kota, kurasa sedikit udara segar di luar ruangan membawa banyak manfaat bagiku."
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFightBackOn02"
    }
    {
      Id = "MelinoeField_3815"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap aku bisa berkata serupa perihal aneka racun, bisa, toksin, dan semacamnya milikmu itu, Nyonya Medea. Bukankah kehendak Malam melarang penggunaan zat-zat tertentu?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutAltFightBackOn02"
    }
    {
      Id = "Medea_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah begitu...? Mungkin aku agak ketinggalan peraturan tata tertib terbaru; tapi kau punya masalah yang jauh lebih besar di sini ketimbang setitik darah busuk. {#Emph}Oh, Cyclops...?"
      Speaker = "Medea"
      Event = "PolyphemusAboutAltFightBackOn02"
    }
    {
      Id = "Polyphemus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak lihat apa aku lagi sibuk di sini? Sejujurnya sih, aku memang buta total. Apa aku mengeluh? Nggak. Aku cuma menggembalakan kawananku."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutFlock01"
    }
    {
      Id = "Melinoe_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "Domba-domba sialanmu itu termasuk binatang paling tegang dan gelisah yang pernah kutemui seumur hidupku."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutFlock01"
    }
    {
      Id = "Polyphemus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Domba larinya kencang. Mengurusnya bukan kerjaan gampang. Dan makin susah lagi kalau ada orang bikin onar di padang rumputku. Jadi aku punya pilihan apa lagi? Selain makan {#Emph}kamu?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutFlock01"
    }
    {
      Id = "Polyphemus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tadinya bisa dapat pertemananku. Sepasang dombaku. Tapi gantinya apa? Kau malah meludahi mataku."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutFriendship01"
    }
    {
      Id = "Melinoe_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak melakukan hal itu. Aku hanya butuh jalan menuju dermaga. Tapi kau terus saja bersikeras menghalangiku."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutFriendship01"
    }
    {
      Id = "Polyphemus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba pakai sandalku sebentar. Apa yang bakal {#Emph}kau {#Prev}lakukan? Kau pasti bilang: {#Emph}Aku nggak suka caramu memperlakukanku. Bakal kumakan kau!"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutFriendship01"
    }
    {
      Id = "Polyphemus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lagi menjaga pola makan. Tiga kali makan besar, itu saja. Nggak nyemil. Tapi kau bikin pantanganku jadi luar biasa susah."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutDiet01"
    }
    {
      Id = "Melinoe_0495"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di tempat asalku, kami berpuasa di bawah bulan sabit muda, serta menanam tetumbuhan dan jamur berkhasiat. Aku bisa membawakannya untukmu lain kali jika kau mau."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutDiet01"
    }
    {
      Id = "Polyphemus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Nggak bisa kusimpan buat nanti. Kau pasti bakal kabur. Semuanya selalu begitu. Oh, {#Emph}aku {#Prev}tahu! Mulai dari kakimu dulu saja!"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutDiet01"
    }
    {
      Id = "Melinoe_0496"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Takkan kubiarkan."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutDiet01"
    }
    {
      Id = "Polyphemus_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa yang bolehin {#Emph}kau {#Prev}manggil-manggil namaku, {#Emph}hah? {#Prev}Aku belum pernah kenalan sama kamu. Kenapa, abis ini mau manggil aku Poly seolah kita ini konco akrab?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutName01"
    }
    {
      Id = "MelinoeField_2858"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa kau tak punya banyak {#Emph}konco akrab {#Prev}melihat caramu yang selalu berusaha memangsa apa pun yang bergerak. Kendati begitu, kita masih bisa berteman! Lupakan urusan coba-coba memakanku itu?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutName01"
    }
    {
      Id = "Polyphemus_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak mau! {#Prev}Sudah punya semua kawan yang kubutuhkan. Domba di belakang sana, mayat-mayat busuk di dalam tanah sini. Tapi kau tahu apa yang {#Emph}benar-benar {#Prev}kubutuhkan? {#Emph}Ya{#Prev}, kurasa kau sudah tahu."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutName01"
    }
    {
      Id = "Polyphemus_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tinggal di sini ada enak dan nggak enaknya. Akhir-akhir ini misalnya, aku jarang dapat ketenangan, padahal tidurku pulas macam batu. Entahlah, mungkin aku harus pindah..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutMoving01"
    }
    {
      Id = "MelinoeField_3164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mendukung penuh keputusan itu. Bukankah kau memang lebih terbiasa hidup di pulau? Kehidupan kota ini, bahkan di pinggirannya sekalipun... temponya terlalu terburu-buru."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutMoving01"
    }
    {
      Id = "Polyphemus_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu apa yang {#Emph}kau {#Prev}inginkan dariku. Walau begitu, kangen juga sama kehidupan pulau begitu kau sebut tadi. Masih ada tamu tak diundang sesekali, tapi nggak seramai sekarang."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutMoving01"
    }
    {
      Id = "Polyphemus_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma kepingin dibiarkan sendirian. Pindah ke pedesaan, hidup tenang jadi gembala dan semacamnya. Eh, malah kau seret aku keluar dari masa pensiun."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutPast01"
    }
    {
      Id = "MelinoeField_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak berniat begitu. Aku hendak menuju dermaga. Kau sendiri yang memilih untuk berusaha menghentikanku, padahal kau bisa saja menggembalakan domba-dombamu."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutPast01"
    }
    {
      Id = "Polyphemus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, pasti bakal ku{#Emph}urus {#Prev}mereka. Tapi sebelum itu, aku harus mengurus orang macam {#Emph}kau {#Prev}dulu. Sama persis seperti zaman baheula dulu."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutPast01"
    }
    {
      Id = "Polyphemus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Helaan napas> {#Prev}Begini ya, aku cuma gembala rendahan yang mau hidup tenang. Tapi aku mesti melindungi milikku sendiri, kau paham kan. Lagian, aku butuh makan."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutWar01"
    }
    {
      Id = "MelinoeField_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sebut ini berusaha hidup tenang?! Mungkin seharusnya kau jangan mencampuri upayaku untuk mengakhiri perang yang berkecamuk di sekeliling kita!"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutWar01"
    }
    {
      Id = "Polyphemus_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Orang mati nggak pernah menggangguku. Orang hidup yang selalu jadi biang repot. Untung saja rasa yang {#Emph}hidup {#Prev}jauh lebih enak daripada yang {#Emph}mati."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutWar01"
    }
    {
      Id = "Polyphemus_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal kau tahu, aku selalu bisa dengar langkah ributmu menerobos kota dari padang rumput yang tenang dan damai ini. Bahkan sebelum domba-dombaku kaget ketakutan."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutBoulders01"
    }
    {
      Id = "MelinoeField_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, sudah kuduga hujan batu besar di belakang sana mendarat di dekatku bukan karena kebetulan belaka. Pendengaranmu sangat tajam, dan bidikanmu lumayan akurat."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutBoulders01"
    }
    {
      Id = "Polyphemus_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, makasih. Dan seleramu juga {#Emph}sangat nikmat{#Prev}, aku yakin itu. Sekarang diam di situ, biar bisa kulatih lagi {#Emph}bidikan lumayan akurat{#Prev}ku ini."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutBoulders01"
    }
    {
      Id = "MelinoeField_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap kali pun kau selalu tahu aku ada di sini, tak peduli betapa halusnya langkah kakiku atau apa pun upayaku menutupi aroma tubuhku. Indramu luar biasa peka."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutBlindness01"
    }
    {
      Id = "Polyphemus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya begitulah, kalau kau kehilangan sebelah matamu... kau harus belajar mengimbanginya. Dari dulu penglihatanku memang nggak bagus-bagus amat. Nggak pernah bisa nebak seberapa jauh jarak suatu benda."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutBlindness01"
    }
    {
      Id = "MelinoeField_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti luar biasa sulit melaluinya, bagaimanapun juga. Dan sekarang kau memanfaatkan kemampuan tinggi ini untuk menggembalakan kawanannmu..."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutBlindness01"
    }
    {
      Id = "Polyphemus_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kemampuan tinggi{#Prev}, suka aku dengarnya. Dengar ya, dunia ini tempat yang amat jelek. Bedanya kau dan aku cuma satu: aku nggak perlu melihatnya lagi. Sekarang, diam di tempat atau coba lari... terserah, aku nggak peduli."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutBlindness01"
    }
    {
      Id = "MelinoeField_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau begitu menyayangi domba-dombammu, mengapa terus menempatkan mereka dalam bahaya? Belum lagi kau memakannya pula. Biarkan mereka pergi dari sini, sekarang juga."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutSheep01"
    }
    {
      Id = "Polyphemus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Permisi? Aku nggak pernah minta wejangan penggembalaan darimu, lagipula... domba-domba ini nggak punya tempat lain buat dituju. Dan kitalah {#Emph}hiburan makan malamnya."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutSheep01"
    }
    {
      Id = "Polyphemus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu siapa yang pernah merendahkanku seperti ini? Bukan Siapa-siapa. Bukan Siapa-siapa yang mengambil dombaku. Mengambil mataku."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutNobody01"
    }
    {
      Id = "MelinoeField_2447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, yah, terkadang kita tidak punya siapa pun untuk disalahkan selain diri kita sendiri."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutNobody01"
    }
    {
      Id = "Polyphemus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan Siapa-siapa bakal membayarnya suatu hari nanti. Tapi kau bakal bayar sekarang juga. {#Emph}Heh. {#Prev}Secara kiasan, maksudku! Aku takkan mengambil uangmu. Cuma bakal memakanmu... tulang belulang beserta semuanya."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutNobody01"
    }
    {
      Id = "MelinoeField_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi kau bilang Bukan Siapa-siapa yang mengambil matamu, begitu pula dombamu. Lalu bagaimana kau bisa kehilangan semuanya?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutNobody02"
    }
    {
      Id = "Polyphemus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan Siapa-siapa memainkan trik kotor padaku, begitulah. Sekelompok pelaut mengira mereka bisa kabur membawa dombaku, jadi kumakan saja dua orang dari mereka. Para pelaut itu, maksudnya! Tapi Bukan Siapa-siapa menyerangku saat aku lengah. Lalu dia kabur..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutNobody02"
    }
    {
      Id = "MelinoeField_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau terus memburu dendam pada si Bukan Siapa-siapa ini sejak saat itu?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutNobody02"
    }
    {
      Id = "Polyphemus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, bukan aku secara langsung! Suatu hari nanti, seseorang bakal menghabisi Bukan Siapa-siapa atas apa yang dia lakukan. Tapi, aku bakal menghabisi {#Emph}dirimu {#Prev}di sini sekarang juga."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutNobody02"
    }
    {
      Id = "Polyphemus_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pantas saja kau dan Bukan Siapa-siapa berteman. Dia dan para tikusnya adalah satu-satunya yang pernah lolos dariku, selain kau. Si pecundang tak berguna itu yang menyuruhmu ke sini?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutNobody03"
    }
    {
      Id = "MelinoeField_1949"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namanya Odysseus! Dia pahlawan dan ahli taktik yang hebat, meski kau tak perlu repot-repot memikirkan cara membunuhnya, karena dia sudah lama mati. Bukan lagi urusanmu."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutNobody03"
    }
    {
      Id = "Polyphemus_0514"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak peduli mau dia sudah mati, aku tetap bakal memakannya. Dan tak peduli apa panggilannya. Dia bakal selalu jadi Bukan Siapa-siapa bagiku. Sekarang bagaimana kalau kukirimi dia pesan?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutNobody03"
    }
    {
      Id = "Polyphemus_0520"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan Siapa-siapa sedang tak bersamamu kali ini, kan? Jago kabur juga bocah itu. Kupikir itu terakhir kalinya aku melihatnya, ternyata itu terakhir kalinya aku {#Emph}mencium baunya{#Prev}, dan mungkin sekarang aku juga sudah {#Emph}mendengar {#Prev}suaranya untuk yang terakhir kali."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutNobody04"
    }
    {
      Id = "MelinoeField_4359"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa Odysseus tak berencana membiasakan diri untuk berkunjung ke sini, tidak. Yang berarti kau takkan pernah mendengar apa yang sebenarnya terjadi saat dia pertama kali lolos darimu. Kisahnya sungguh luar biasa!"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutNobody04"
    }
    {
      Id = "Polyphemus_0521"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku tak peduli. Bukan Siapa-siapa itu cuma pengecut licik... siapa juga yang sudi dengar cerita tentang orang semacam dia?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutNobody04"
    }
    {
      Id = "Polyphemus_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Endus, Endus> {#Prev}Aku tak pernah lupa bau mangsa, tahu. Dan kau membawa sesuatu yang terasa familier dari masa lalu. Aku tahu Tulang itu. {#Emph}Bukan Siapa-siapa {#Prev}yang memilikinya sebelum dirimu."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutNobodyKeepsake01"
    }
    {
      Id = "MelinoeField_1948"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu pasti Tulang Jari ini... jika benda ini pernah membawa nasib buruk bagimu di masa lalu, mungkin kau tahu apa yang akan terjadi selanjutnya."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutNobodyKeepsake01"
    }
    {
      Id = "Polyphemus_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan Siapa-siapa itu {#Emph}temanmu{#Prev}, begitu yang kau ingin kupercaya? Kalau begitu pertama-tama aku bakal meremukkan tulang-tulang {#Emph}milikmu{#Prev}, lalu kumakan semuanya. Dan Tulang Jari itu juga sekalian."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutNobodyKeepsake01"
    }
    {
      Id = "Polyphemus_0515"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei bongkahan daging, baunya seperti kau membawa Tulang Jari itu lagi. Bukan Siapa-siapa benar-benar memberikannya padamu, ya?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutOdysseusQuest01"
    }
    {
      Id = "MelinoeField_4356"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tanyakan sendiri padanya, Cyclops. Bukan Siapa-siapa ingin berbicara denganmu. {#Emph}Dengarkan suaraku, Odysseus; orang yang kau cari ada di sini!"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutOdysseusQuest01"
    }
    {
      Id = "Polyphemus_0516"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bukan Siapa-siapa... {#Prev}baumu sama sekali tak terendus tapi itu memang suaramu. Kenapa tidak mendekat {#Emph}sedikit {#Prev}supaya aku bisa mendengarmu lebih jelas?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutOdysseusQuest01"
    }
    {
      Id = "Odysseus_0571"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya kau takkan bisa melahapku dalam wujudku yang sekarang, Cyclops, karena aku sudah lama tiada. Hanya sekadar proyeksi Arwah belaka, tapi aku memang ingin berbincang sedikit!"
      Speaker = "Odysseus"
      Event = "PolyphemusAboutOdysseusQuest01"
    }
    {
      Id = "Polyphemus_0517"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kau benar-benar {#Emph}sudah {#Prev}mati rupanya. Selalu kukira akulah yang bakal membunuhmu sendiri. Tapi kau berhasil tertawa di akhir lagi."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutOdysseusQuest01"
    }
    {
      Id = "Odysseus_0572"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan kemari untuk menertawakanmu, melainkan mengajukan pertanyaan. Dulu saat kau mengurungku dan anak buahku, membantai beberapa dari kami, kau akhirnya malah {#Emph}kehilangan {#Prev}satu matamu selagi kami melarikan diri... apakah itu sepadan?"
      Speaker = "Odysseus"
      Event = "PolyphemusAboutOdysseusQuest01"
    }
    {
      Id = "Polyphemus_0518"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tak ingat sebagian besar santapanku. Kurasa itu wajar. Tapi aku ingat awak kapalmu... daging yang liat, matang terpanggang matahari dan semacamnya. Tapi sepadan dengan mataku? {#Emph}Nggak{#Prev}, itu bukan pertukaran yang bagus."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutOdysseusQuest01"
    }
    {
      Id = "Odysseus_0573"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu pula bagiku, ataupun mereka. Yah {#Emph}sudahlah! {#Prev}Tampaknya kita sama-sama saling meninggalkan luka yang pahit dan abadi. Walau lukaku murni bersifat psikologis. Kuserahkan kau pada sang Putri sekarang, bajingan pembunuh."
      Speaker = "Odysseus"
      Event = "PolyphemusAboutOdysseusQuest01"
    }
    {
      Id = "Polyphemus_0519"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergi sana, kawan. Lagian aku juga tak pernah sudi melihatmu lagi."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutOdysseusQuest01"
    }
    {
      Id = "MelinoeField_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau keras kepala sekali untuk ukuran gembala yang cinta damai. Apa Poseidon pernah berbuat sesuatu yang menyinggungmu di masa lalu? Apakah {#Emph}itu {#Prev}penyebab semua ini?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutPoseidon01"
    }
    {
      Id = "Polyphemus_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku tak merasa {#Emph}tersinggung... {#Prev}aku cuma {#Emph}membalas dendam. {#Prev}Dan kau tak boleh lagi mengajukan pertanyaan... kau bakal {#Emph}dimakan."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutPoseidon01"
    }
    {
      Id = "MelinoeField_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini hal terakhir yang akan kubahas soal Poseidon, sumpah. Dia itu pamanku, kau tahu. Sekadar untuk meluruskan... aku minta maaf jika dia benar-benar membuatmu percaya bahwa kau adalah putranya."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutPoseidon02"
    }
    {
      Id = "Polyphemus_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, yah, aku cuma suka melebih-lebihkan kemiripan keluarga untuk jaga-jaga. Walau aku lega dia bukan ayahku juga. Kalau bukan begitu, aku bakal memakan sepupuku sendiri, dan itu bakal aneh banget rasanya."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutPoseidon02"
    }
    {
      Id = "Polyphemus_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, sebenarnya apa masalahmu dengan Chronos? Dia cuma ingin mengubah beberapa hal, lantas kenapa? Hidup di atas sini berat. Bisa dibuat lebih gampang."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutChronos01"
    }
    {
      Id = "MelinoeField_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak akan pernah. {#Emph}Kota {#Prev}di belakang sana, seperti yang kau sebutkan, dulunya pasti dipenuhi manusia yang hidup damai. Sekarang tempat itu menjadi nekropolis yang membusuk. Semua berkat sang Titan."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutChronos01"
    }
    {
      Id = "Polyphemus_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Domba-dombaku, mereka senang bisa tetap hidup. Tak ada keluhan. Tapi makhluk seperti dirimu? Kalian punya terlalu banyak cita-cita mulia. Lebih baik ku{#Emph}makan {#Prev}saja kau, biar urusan beres."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutChronos01"
    }
    {
      Id = "MelinoeField_2829"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi apa sebenarnya yang ditawarkan Chronos kepadamu untuk upaya sia-sia menghalangi jalanku ini?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutChronos02"
    }
    {
      Id = "Polyphemus_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa itu bukan urusanmu, bongkahan daging. {#Emph}Kau {#Prev}yang menerobos wilayahku, bikin onar di kotaku. Sudah jadi tugasku menjaga semuanya tetap rapi dan teratur."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutChronos02"
    }
    {
      Id = "MelinoeField_2830"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ephyra {#Emph}bukan {#Prev}kotamu. Kecuali itu memang kesepakatanmu dengan sang Titan, meski kota itu bukan miliknya untuk diberikan seenaknya. Bagaimanapun juga, siap menerima bayaran malam ini?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutChronos02"
    }
    {
      Id = "Polyphemus_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, kau sama sekali nggak tahu apa-apa soal {#Emph}kesepakatanku{#Prev}. Pertama, bayaranku selalu di muka. Tapi dengan kau di sini... aku dapat sedikit {#Emph}bonus{#Prev}."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutChronos02"
    }
    {
      Id = "Polyphemus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada hawa {#Emph}busuk{#Prev} malam ini. Dan ini bukan cuma soal {#Emph}kau{#Prev} atau bau dari kota. Pasti ulah penyihir usil itu. Kau berkawan sama dia?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutMedea01"
    }
    {
      Id = "MelinoeField_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau tahu tentang Nyonya Medea, kau pasti tahu dia bukan orang yang patut kau cari masalah dengannya. Dia takkan ragu mengutuk musuh-musuhku; termasuk dirimu."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutMedea01"
    }
    {
      Id = "Polyphemus_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu barusan ancaman? Kayaknya iya. Jangan coba-coba ngomong begitu, bukan di kota ini. {#Emph}Sobatmu{#Prev} itu tahu diri untuk tetap di tempat yang baunya nggak tercium olehku, nggak seperti {#Emph}kau{#Prev}."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutMedea01"
    }
    {
      Id = "MelinoeField_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau selalu menahan {#Emph}langkahku{#Prev}, tapi Heracles yang perkasa itu bebas mengamuk di kota sesuka hatinya tanpa harus berurusan denganmu? Setidaknya begitulah katanya."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutHeracles01"
    }
    {
      Id = "Polyphemus_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu namanya {#Emph}standar ganda{#Prev}, domba kecil. Nggak perlu mataku utuh buat tahu kalau badannya jauh lebih gede dari kau. Kau cuma bisa bikin aku tidur siang sebentar; nah dia, bisa bikin aku pingsan seminggu penuh. Nggak, makasih deh."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutHeracles01"
    }
    {
      Id = "Polyphemus_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hafal baumu tapi sama sekali nggak tahu tampangmu kayak apa. Paling-paling badanmu kayak tongkat gembala yang lagi kugigit ini. Nggak ada dagingnya sama sekali."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutMelinoe01"
    }
    {
      Id = "MelinoeField_3159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin jika kau tahu wujudku, kau takkan lancang memperlakukanku seperti hewan ternak. Rambutku pucat bagai gandum; aku berbalut kuma-kuma dan perak; dan aku memegang Senjata Nokturnal, yang ditempa di kedalaman Chaos."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutMelinoe01"
    }
    {
      Id = "Polyphemus_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mmm{#Prev}, gandum dan kuma-kuma! Tambah susu domba sedikit, sejumput garam laut, sedikit {#Emph}ini{#Prev}, sedikit {#Emph}itu{#Prev}? Lalu panggang sebentar di atas bara api... bakal jadi roti yang luar biasa lezat."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutMelinoe01"
    }
    {
      Id = "MelinoeField_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana nasib para Cyclops lainnya? Kaummu pernah membantu para dewa melawan para Titan, menempa senjata perang dan sejenisnya. Namun {#Emph}kau{#Prev} malah berbalik membelakangi mereka..."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutCyclopes01"
    }
    {
      Id = "Polyphemus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, kau pikir kami semua saling kontak cuma gara-gara kami paling banter punya satu mata? Apa yang mereka perbuat dan apa yang terjadi ke mereka, bukan urusanku. Apalagi pas perutku lagi {#Emph}lapar{#Prev}..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutCyclopes01"
    }
    {
      Id = "Polyphemus_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bilang kau ini semacam {#Emph}dewi abadi dari Dunia Bawah{#Prev}? Mendingan kau tetap di kandangmu {#Emph}sendiri{#Prev} sana."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutUnderworld01"
    }
    {
      Id = "MelinoeField_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ke sini untuk mengunjungi kerabatku. Kau saja yang selalu menghalangi jalanku. Seolah-olah kekerasan lebih cocok untukmu ketimbang menjadi gembala."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutUnderworld01"
    }
    {
      Id = "Polyphemus_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, pintar mikir juga ya buat sekerat daging! Cuma gara-gara aku pensiun bukan berarti aku nggak boleh mancing nafsu makan lagi, ya kan?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutUnderworld01"
    }
    {
      Id = "Polyphemus_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Mendengus> {#Prev}Baumu busuk kayak mayat. Tapi kau bukan dari kota ini. Kau dari tempat yang jauh lebih dalam. Mendingan kau tetap di balik pagarmu sendiri sana."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutUnderworld01B"
    }
    {
      Id = "MelinoeField_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau yang bertanggung jawab atas dinding pelindung gaib di gerbang kota itu? Segel itu jelas-jelas buatan Chronos, dan kau tampaknya adalah penjaga cadangan kalau-kalau dinding itu jebol."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutEphyra01"
    }
    {
      Id = "Polyphemus_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh benda {#Emph}itu{#Prev}, ya. Dari awal aku tahu nggak bakal tahan lama. Tapi mereka terus saja memperbaikinya! Kayak ada orang di luar sana yang nggak sudi kau ke sini..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutEphyra01"
    }
    {
      Id = "Polyphemus_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dermaga di belakang sana kubikin pakai tangan kosong. Aku kenal beberapa orang, mereka mencatat setiap perahu dayung dan kapal trireme di lautan. Kami tahu ke mana tujuanmu."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutDocks01"
    }
    {
      Id = "MelinoeField_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu kenapa kalau kau tahu? Kau cuma kacung Chronos yang lain. Para dewa akan menghukummu jika semua ini berakhir."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutDocks01"
    }
    {
      Id = "Polyphemus_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehh{#Prev}, tahu apa kau soal itu? Mereka cuma peduli sama kaum mereka sendiri! Aku cuma bahan tertawaan buat mereka. Apa aku bahan tertawaan... buat {#Emph}kau{#Prev} juga?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutDocks01"
    }
    {
      Id = "Polyphemus_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengendap-endap di lumbung tuaku tempo hari pas aku lagi keluar. Bisa saja kau rampok tempat itu tapi ternyata nggak. Cuma numpang minum dari sumurku terus pergi begitu saja."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutBarn01"
    }
    {
      Id = "MelinoeField_1929"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bukan pencuri. Lagipula, tempat tinggalmu kotor sekali! Harusnya kau bersihkan saja tempat itu daripada melawanku. Beritahu aku jika kau butuh bantuan, karena aku akan segera lewat sini lagi."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutBarn01"
    }
    {
      Id = "Polyphemus_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak{#Prev}, makasih. Kalau tempat itu rapi, aku nggak bakal bisa nemu jalan pakai hidungku. Dan satu lagi, {#Emph}tutup mulutmu! {#Prev}Bukan urusanmu mau ngatur gimana caraku hidup!"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutBarn01"
    }
    {
      Id = "Polyphemus_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau pergi ke mana sih sebenarnya? Nggak bakal ada kapal yang berlayar dari dermaga sana yang sudi bawa orang kayak {#Emph}kau{#Prev}. Lagian kalau dipikir-pikir... akhir-akhir ini nggak ada kapal sama sekali."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutThessaly01"
    }
    {
      Id = "MelinoeField_1947"
      InheritFrom = "BaseNarrative"
      DisplayName = "Armada abadi Chronos masih berada di perairan Rift. Tampaknya saat satu kapal karam, kapal lain akan bangkit dari kedalaman untuk menggantikannya, berawakkan pelaut yang tewas tenggelam..."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutThessaly01"
    }
    {
      Id = "Polyphemus_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti bercanda. Orang mati sekarang bisa berlayar? Kupikir mereka nggak ada gunanya selain buat dimakan. Mungkin aku mesti ngajarin mereka buat ngerjain tugas rumah tanggaku..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutThessaly01"
    }
    {
      Id = "Polyphemus_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terus gimana keadaan di seberang sana? Katanya di sana lagi turun salju. Kedengarannya kayak tempat tinggal yang busuk banget."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutOlympus01"
    }
    {
      Id = "MelinoeField_2831"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu Gunung Olympus? Para dewa sendiri sangat menyukainya, sampai-sampai berjuang mati-matian mempertahankannya dari Titan yang kau dukung itu. Tapi, ya... memang agak dingin."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutOlympus01"
    }
    {
      Id = "Polyphemus_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, aku nggak bakal betah di tempat kayak gitu. Aku suka hawa yang sama kayak dagingku, enak dan panas mengepul. Ya meski bisa juga sih kumakan mentah-mentah. Nggak boleh terlalu pilih-pilih, kan."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutOlympus01"
    }
    {
      Id = "Polyphemus_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Orang mati... kadang mereka ngomong, atau setidaknya berusaha. Nggak ada kerjaan lain juga di sekitar sini. Tahu apa yang mereka omongin? Awalnya aku nggak paham, tapi kedengarannya mirip banget sama... {#Emph}Prometheus{#Prev}."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutPrometheus01"
    }
    {
      Id = "MelinoeField_3165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Titan Tahu Sebelum Terjadi, dan salah satu sekutumu, kalau-kalau kalian belum pernah bertemu; karena rupanya kalian melayani majikan yang sama. Apa yang dikatakan arwah-arwah malang itu tentang sosok sepertinya?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutPrometheus01"
    }
    {
      Id = "Polyphemus_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebanyakan cuma erangan dan rintihan. Mungkin mereka juga lapar kayak aku! Soalnya kalau beneran Prometheus kabur bawa api para dewa kayak yang kudengar... dia pasti jago masak."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutPrometheus01"
    }
    {
      Id = "MelinoeField_3166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuingat saat pertama kali kita bertemu, kau tampak begitu {#Emph}raksasa... {#Prev}jauh lebih besar dari hampir semua musuh yang pernah kuhadapi. Tapi sekarang, kau hampir bukan tandinganku."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutTyphon01"
    }
    {
      Id = "Polyphemus_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aw{#Prev}, makasih lho. Dan kuingat saat pertama kali {#Emph}kita{#Prev} bertemu, jadwal tidurku benar-benar berantakan! Tapi sekarang sudah baikan. Dan badanku masih montok! Tadi kau bilang apa, {#Emph}raksasa{#Prev} ya?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutTyphon01"
    }
    {
      Id = "MelinoeField_3167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu semua soal sudut pandang, begitulah yang kupelajari. Contohnya, kau tampak kerdil jika dibandingkan dengan Ayah Segala Monster, Typhon. Dialah yang benar-benar raksasa."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutTyphon01"
    }
    {
      Id = "Polyphemus_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terpaksa aku percaya omonganmu. Lagian, seberapa besar sih dia? Paling banter cuma cukup buat tiga porsi makan kalau kutebak. Udah lama banget aku nggak makan daging monster..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutTyphon01"
    }
    {
      Id = "Polyphemus_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lucu juga. Papasan terus sama kamu berkali-kali begini? Malah bikin tidurku nyenyak banget, nggak pernah seenak ini selama bertahun-tahun."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutInsomnia01"
    }
    {
      Id = "MelinoeField_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitukah? Sebenarnya bakal jauh lebih mudah bagiku untuk membuatmu pingsan kalau kau tidak melawan."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutInsomnia01"
    }
    {
      Id = "Polyphemus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Halah{#Prev}, justru baku hantamnya itu yang bikin manjur. Kalau nggak ngeluarin semua tenaga, aku nggak bakal bisa tidur nyenyak dan lelap setelahnya. Nggak dapet kesempatan makan enak juga."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutInsomnia01"
    }
    {
      Id = "MelinoeField_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal kau tahu, kalau kau memang susah tidur, pasti ada cara yang lebih baik daripada dipukuli habis-habisan olehku berulang kali."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutInsomnia02"
    }
    {
      Id = "Polyphemus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Udah kucoba macem-macem. Tidur pas perut kenyang, tidur pas perut kosong. Nggak ada yang mempan. Tapi yang ini? Ini manjur banget buat sekarang..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutInsomnia02"
    }
    {
      Id = "Polyphemus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Endus> {#Prev}Aku nyium bau {#Emph}darah. {#Prev}Padahal aku baru aja mau nyiapin mangsa berikutnya... tapi panitia penyambut di kota pasti udah ngebumbui kamu duluan."
      Speaker = "Polyphemus"
      Event = "PolyphemusLowHealth01"
    }
    {
      Id = "MelinoeField_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Panitia penyambut{#Prev}, sebutanmu itu, adalah budak-budak Chronos... dan mereka akan menanggung akibat atas kelancangan mereka. Kau rela berpihak pada {#Emph}mereka?"
      Speaker = "Melinoe"
      Event = "PolyphemusLowHealth01"
    }
    {
      Id = "Polyphemus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal kamu tahu ya, dulu aku agak risih makan sesuatu yang melotot balik ke arahku, atau ngelawan pas kuajak omong. Tapi sekarang masalah itu udah nggak ada lagi."
      Speaker = "Polyphemus"
      Event = "PolyphemusLowHealth01"
    }
    {
      Id = "Polyphemus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh, {#Prev}kelihatan banget panitia penyambut di kota udah bikin kamu babak belur. Bikin dagingmu empuk {#Emph}banget. {#Prev}Makin enak buat {#Emph}aku."
      Speaker = "Polyphemus"
      Event = "PolyphemusLowHealth02"
    }
    {
      Id = "MelinoeField_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kota itu dipenuhi oleh arwah tak berjasad. Aku bisa membantai mereka, tapi mereka akan bangkit kembali; sangat merepotkan. Sama persis sepertimu."
      Speaker = "Melinoe"
      Event = "PolyphemusLowHealth02"
    }
    {
      Id = "Polyphemus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Heh, jangan nyolot dulu. Ini padang rumput {#Emph}punyaku{#Prev}, bukan punyamu. Dan semua domba kecil di sini tunduknya ke {#Emph}aku."
      Speaker = "Polyphemus"
      Event = "PolyphemusLowHealth02"
    }
    {
      Id = "Polyphemus_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah! {#Prev}Pas kukira berhasil nangkep kamu kemarin, kamu malah lolos. Nggak nyangka bakal dapet kesempatan lagi."
      Speaker = "Polyphemus"
      Event = "PolyphemusLostAgainstHim01"
    }
    {
      Id = "MelinoeField_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau akan segera mendapatkan banyak {#Emph}kesempatan {#Prev}lagi. Tapi kau akan gagal setiap saat, aku bersumpah."
      Speaker = "Melinoe"
      Event = "PolyphemusLostAgainstHim01"
    }
    {
      Id = "Polyphemus_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana kalau kamu sumpahin {#Emph}daging di tulangmu {#Prev}aja buat aku. Meskipun firasatku bilang kamu nggak punya banyak daging buat disajikan."
      Speaker = "Polyphemus"
      Event = "PolyphemusLostAgainstHim01"
    }
    {
      Id = "Polyphemus_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak suka main-main sama makananku. Makin nggak suka lagi kalau makananku yang main-main sama {#Emph}aku. {#Prev}Aku udah tahu trik ngilangmu itu."
      Speaker = "Polyphemus"
      Event = "PolyphemusLostAgainstHim02"
    }
    {
      Id = "MelinoeField_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku adalah dewi Underworld yang tak bisa mati; bayang-bayang akan selalu membawaku pergi sebelum tanganmu menjangkauku. Namun kau tetap ingin bertarung melawanku tanpa henti?"
      Speaker = "Melinoe"
      Event = "PolyphemusLostAgainstHim02"
    }
    {
      Id = "Polyphemus_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, jelas! Semua orang pasti bakal teledor sesekali. Kamu juga. Dan pas kamu lengah... kita bakal lihat seberapa {#Emph}abadi {#Prev}sebenarnya dirimu."
      Speaker = "Polyphemus"
      Event = "PolyphemusLostAgainstHim02"
    }
    {
      Id = "Polyphemus_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemarin kamu hampir aja ngalahin aku, tapi belum cukup. Mau beresin urusan sekarang? Bukan kamu doang yang pernah nyoba. Tapi buktinya aku masih di sini, dan nggak ada orang lain lagi di sekitar sini, kan?"
      Speaker = "Polyphemus"
      Event = "PolyphemusBarelyLostAgainstHim01"
    }
    {
      Id = "MelinoeField_1946"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membereskan urusan {#Emph}apa? {#Prev}Kau bukan sasaranku. Sebenarnya aku lebih suka menyelinap melewatimu dan lanjut jalan, andai saja indra penciuman dan pendengaranmu sialan itu tidak terlalu tajam."
      Speaker = "Melinoe"
      Event = "PolyphemusBarelyLostAgainstHim01"
    }
    {
      Id = "Polyphemus_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, terima kasih. Dan kamu tahu kan gimana caraku ngejaga ketajamannya? Kalau dikasih anugerah kayak gini, ya harus dimanfaatin sebaik-baiknya."
      Speaker = "Polyphemus"
      Event = "PolyphemusBarelyLostAgainstHim01"
    }
    {
      Id = "Polyphemus_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}hei! {#Prev}Aku mau bilang makasih. Hantamanmu kemarin bener-bener mantap, tahu nggak?"
      Speaker = "Polyphemus"
      Event = "PolyphemusWonAgainstHim01"
    }
    {
      Id = "Melinoe_0938"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau kembali. Dan kau berterima kasih karena aku menaklukkanmu sebelumnya? Kupikir kau tipe monster yang pendendam."
      Speaker = "Melinoe"
      Event = "PolyphemusWonAgainstHim01"
    }
    {
      Id = "Polyphemus_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Emang dendam sih, tapi masalahnya... udah entah berapa lama aku nggak pernah tidur nyenyak. Pas kamu bikin aku pingsan kemarin, pas bangun badanku seger banget! Dan laper parah juga, sih."
      Speaker = "Polyphemus"
      Event = "PolyphemusWonAgainstHim01"
    }
    {
      Id = "Polyphemus_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cih! {#Prev}Jangan coba-coba menyelinap lewat situ. Apa, kamu kira bakal mergokin aku lagi tidur siang di sini? Nggak bakal."
      Speaker = "Polyphemus"
      Event = "PolyphemusWonAgainstHim02"
    }
    {
      Id = "Melinoe_0939"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa saja. Kalau kau terus menghalangi jalanku, kau akan kuhajar habis-habisan lagi, dan kau akan tertidur lelap dalam sekejap. Itu yang kau mau?"
      Speaker = "Melinoe"
      Event = "PolyphemusWonAgainstHim02"
    }
    {
      Id = "Polyphemus_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah! Dilema besar nih! Aku emang selalu ngantuk, betul. Tapi aku juga selalu laper. Kayaknya ini situasi yang {#Emph}nggak bakal bikin aku rugi."
      Speaker = "Polyphemus"
      Event = "PolyphemusWonAgainstHim02"
    }
    {
      Id = "Polyphemus_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kalau ada yang nggak beres, dan ini emang nggak beres. Lagi mau ngapain kamu, {#Emph}daging empuk? {#Prev}Selain ketangkep lagi sama aku kayak tiap kali kamu nyoba nyelinap lewat sini."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutPackagedBounties01"
    }
    {
      Id = "MelinoeField_3160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku tidak sedang menyelinap; malahan kali ini tujuanku adalah {#Emph}dirimu{#Prev}, Cyclops. Sang Asal Mula Segala Keberadaan penasaran apakah aku mampu menumbangkanmu."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutPackagedBounties01"
    }
    {
      Id = "Polyphemus_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Asal Mula Segala Keberadaan...? {#Prev}Maksudmu, kamu dapet tugas buat ngehabisin aku, {#Emph}gitu? {#Prev}Yah, bukan kamu yang pertama nyoba. Sekarang biar kutunjukkin {#Emph}langsung {#Prev}apa yang terjadi sama sisanya."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutPackagedBounties01"
    }
    {
      Id = "Polyphemus_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh hei! Asal Mula Segala Keberadaan tadi nitip pesen, katanya kamu kurang jago. Dan seluruh kesepakatannya batal. Sekarang giliranku buat makan kamu."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutPackagedBounties02"
    }
    {
      Id = "MelinoeField_3161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sangat sulit bagiku untuk percaya kalau Primordial Chaos mau repot-repot menghubungi {#Emph}dirimu {#Prev}soal urusan begini. Jauh lebih masuk akal jika ini adalah bagian dari Ujian saat ini."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutPackagedBounties02"
    }
    {
      Id = "Polyphemus_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau ini semua bagian dari semacam {#Emph}Ujian{#Prev}, berarti aku jurinya. Dan dengan ini kunyatakan kamu jadi {#Emph}menu makan malam. {#Prev}Kecuali kalau {#Emph}kamu {#Prev}atau sobatmu {#Emph}Primordial Chaos {#Prev}itu mau ngelakuin sesuatu buat nyegah aku."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutPackagedBounties02"
    }
    {
      Id = "Polyphemus_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bulu kudukku merinding semua, dan bukan gara-gara {#Emph}kamu. {#Prev}Atau mungkin iya, tapi... rasanya kayak ada {#Emph}tanda sasaran {#Prev}di badanku. Udah lama banget nggak ngerasain firasat begini."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutShrine01"
    }
    {
      Id = "MelinoeField_3162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan diambil hati, Cyclops. Wasiat Sang Malam menuntut kekalahanmu. Kau tak perlu memusingkan cara kerjanya, jadi bagaimana kalau kita langsung bertarung saja."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutShrine01"
    }
    {
      Id = "Polyphemus_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wasiat {#Emph}apaan? {#Prev}Gua kaga ngarti sepatah kata pun bacotan lu di awal tadi, tapi begitu lu bilang {#Emph}tarung aja!{#Prev}, gua langsung gas!"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutShrine01"
    }
    {
      Id = "Polyphemus_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi lu bisa ngutak-ngatik keadaan pas malam hari? Firasat usus gua ditambah omong kosong lu barusan, ketahuan banget lu lagi ngerencanain hal busuk. Lu semacam {#Emph}penyihir{#Prev}, ya?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutShrine02"
    }
    {
      Id = "MelinoeField_3163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan cuma Nyonya Medea yang mempraktikkan ilmu sihir di sini. Karena kau akhirnya mulai menyadari kekuatan kami yang sebenarnya, ketahuilah bahwa kau melanggar kehendak Sang Malam sendiri dengan menghalangi jalanku."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutShrine02"
    }
    {
      Id = "Polyphemus_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuh kan, mulai lagi lu pake bahasa berbelit-belit. Tapi ya sudahlah, gua kaga nolak hidangan mewah ataupun daging alot! Mungkin lu dua-duanya."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutShrine02"
    }
    {
      Id = "MelinoeField_3163_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena kau akhirnya mulai menyadari kekuatan kami yang sebenarnya, ketahuilah bahwa kau melanggar kehendak Sang Malam sendiri dengan menghalangi jalanku."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutShrine02_B"
    }
    {
      Id = "MelinoeField_4123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa baktimu untuk Titan Chronos sudah usai, Kiklops! Perangnya melawan Olympus sudah berakhir jika kau belum mendengarnya. Aku tak menaruh dendam padamu. Pergilah dari sini!"
      Speaker = "Melinoe"
      Event = "PolyphemusPostTrueEnding01"
    }
    {
      Id = "Polyphemus_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pantesan aja gua mikir kok kaga gajian-gajian. Gua kira hasil gembala gua kaga becus."
      Speaker = "Polyphemus"
      Event = "PolyphemusPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos mengupahmu untuk {#Emph}menggembala domba? {#Prev}Kukira kau seharusnya menjaga gerbang kota."
      Speaker = "Melinoe"
      Event = "PolyphemusPostTrueEnding01"
    }
    {
      Id = "Polyphemus_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lu tau apa sih soal ginian. Emang lu kira gua bakal ninggalin kawanan domba gua gitu aja, setelah semua yang kita lewatin? Lagian gua selalu bisa nyari makan lewat jalan lain."
      Speaker = "Polyphemus"
      Event = "PolyphemusPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat kau memutuskan untuk tidak menuruti saran terbaikku, demi kebaikan kawananmu sendiri—yang dombanya sering kau mangsa itu. Mau sampai berapa lama lagi kau berencana menghalangiku ke Retakan?"
      Speaker = "Melinoe"
      Event = "PolyphemusPostTrueEnding02"
    }
    {
      Id = "Polyphemus_0495"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kayaknya bakal lama dah. Kawanan domba udah ada, lumbung udah dapet, tidur belakangan ini makin nyenyak... masa disuruh minggat? Nyari tempat tinggal baru? Kemas-kemas barang, bongkar lagi, ogah banget dah gua."
      Speaker = "Polyphemus"
      Event = "PolyphemusPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa beruntungnya dirimu bisa membuat hidup senyaman itu, yang kebetulan persis merintangi jalanku."
      Speaker = "Melinoe"
      Event = "PolyphemusPostTrueEnding02"
    }
    {
      Id = "Polyphemus_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah{#Prev}, itu mah bonus namanya: itung-itung gua dapet jatah olahraga tiap malam."
      Speaker = "Polyphemus"
      Event = "PolyphemusPostTrueEnding02"
    }
    {
      Id = "Polyphemus_0522"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa lu bilang perang apalah itu udah kelar, {#Emph}hah? {#Prev}Kondisi kotanya masih sama aja tuh. Setau gua orang mati kudu di bawah tanah, kaga keliaran di jalanan gini."
      Speaker = "Polyphemus"
      Event = "PolyphemusPostTrueEnding03"
    }
    {
      Id = "MelinoeField_4360"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang melawan Chronos memang sudah berakhir, hanya saja... masih ada beberapa sisa urusan yang sedang dibereskan, dan Dunia Bawah mengalami kerusakan yang cukup parah hingga belum pulih sepenuhnya."
      Speaker = "Melinoe"
      Event = "PolyphemusPostTrueEnding03"
    }
    {
      Id = "Polyphemus_0523"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Yah{#Prev}, sayang banget dah. Mau gua suruh lu turun ke bawah bantuin mereka, ntar jam tidur gua malah keganggu, padahal belakangan lagi enak-enaknya. Udahlah sini maju, bentar lagi jadwalnya gua tidur nih."
      Speaker = "Polyphemus"
      Event = "PolyphemusPostTrueEnding03"
    }
    {
      Id = "MelinoeField_4361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setelah sekian malam kita bertarung, kau bahkan tidak tahu namaku, kan, Kiklops? Bagimu aku tetap tak lebih dari sekadar sepotong daging."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutMeat01"
    }
    {
      Id = "Polyphemus_0524"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lah, lu sendiri yang ngomong, bukan gua. Lagian, bukan {#Emph}gua {#Prev}juga yang grasak-grusuk ke mari nakutin domba-domba gua... ya walau kadang-kadang gua begitu juga sih, tapi tetep aja."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutMeat01"
    }
    {
      Id = "Polyphemus_0528"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tumben kaga nongol-nongol! Bagus dah lu balik. Lama kaga ada lu beneran ngerusak jam tidur gua tau kaga."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutSleep01"
    }
    {
      Id = "MelinoeField_4364"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi sempat kupikir kau benar-benar senang melihatku kembali. Tapi ternyata kau cuma ingin kubuat pingsan lagi."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutSleep01"
    }
    {
      Id = "Polyphemus_0529"
      InheritFrom = "BaseNarrative"
      DisplayName = "Iye bener. Kalo kaga ya lu diem aja di situ biar gampang gua santap. Tapi kayaknya lu kaga sudi, jadi bikin gua pingsan aja deh. Gua mah gampang dipuasin."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutSleep01"
    }
    {
      Id = "MelinoeField_4362"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keadaan ini tidak akan berlangsung selamanya, kau tahu kan, Kiklops. Suatu saat nanti, Kota Ephyra akan dibangun kembali. Jalanannya akan dipadati makhluk fana, dermaganya diramaikan para pelaut... bukannya seperti ini."
      Speaker = "Melinoe"
      Event = "PolyphemusPostEpilogue01"
    }
    {
      Id = "Polyphemus_0525"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lu apaan sih, peramal ya? Kalo mereka mau bangun kotanya lagi, ya bagus lah. Makin banyak daging buat gua kapan aja! Tapi buat sekarang, lu aja udah cukup."
      Speaker = "Polyphemus"
      Event = "PolyphemusPostEpilogue01"
    }
    {
      Id = "Polyphemus_0544"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oi, ke mana aja lu? Domba-domba gua mulai gelisah nih dua malam belakangan. Kayaknya mereka udah kebiasa lu ada di sekitaran sini."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutTimePassing01"
    }
    {
      Id = "MelinoeField_5276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perhatian sekali mereka, meski sebenarnya aku punya urusan lain yang harus diselesaikan, kalau tidak tentu aku sudah menjenguk mereka. Bisakah kau mengatur agar aku hanya bertemu {#Emph}mereka{#Prev}, tanpa {#Emph}dirimu?"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutTimePassing01"
    }
    {
      Id = "Polyphemus_0545"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kaga bisa. {#Prev}Gua ama domba-domba gua itu ibaratnya {#Emph}paket lengkap. {#Prev}Paket tawaran yang gua yakin kaga bakal lu lewatin lama-lama."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutTimePassing01"
    }
    {
      Id = "Polyphemus_0546"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya nongol juga! Udah lama banget sejak terakhir gua coba makan lu, sampe domba-domba ngira lu nelantarin kita sendirian di sini. Lu ke mana aja sih sebenernya?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutDreamRuns01"
    }
    {
      Id = "MelinoeField_5277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percayakah kau jika kukatakan bahwa aku sedang menyelami mimpiku jauh ke dalam? Mengingat kau sering sekali tertidur pulas, kau pasti paham serba-serbi tentang mimpi saat ini."
      Speaker = "Melinoe"
      Event = "PolyphemusAboutDreamRuns01"
    }
    {
      Id = "Polyphemus_0547"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah, {#Emph}iye juga. {#Prev}Walau mimpi gua jaman sekarang simpel-simpel aja sih. Makan enak, tidur siang nyenyak, begituan lah. Kalo dipikir-pikir, gua lagi ngejalanin mimpi terindah gua sekarang, kan ya?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutDreamRuns01"
    }
    {
      Id = "Polyphemus_0526"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gua rasa kalo kebanyakan ngoceh, tidur gua jadi kaga nyenyak. Mending kita sudahi bacotannya terus langsung gulat aja. Tapi kaga enak juga kalo kaga sopan, jadi... lu ada kata-kata terakhir kaga, sepotong daging?"
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_4363"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tentu saja, kata-kata terakhirku adalah: Kau takkan pernah memakanku, dan kau takkan pernah bisa menghentikanku, tapi silakan terus mencoba, dan terima kasih banyak atas semua Wolnya!"
      Speaker = "Melinoe"
      Event = "PolyphemusAboutSayingLittle01"
    }
    {
      Id = "Polyphemus_0527"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bentar dulu... jadi lu orangnya yang {#Emph}nyolongin {#Prev}semua Wol gua selama ini? {#Emph}Wah{#Prev}, ngelunjak {#Emph}banget {#Prev}lu ya..."
      Speaker = "Polyphemus"
      Event = "PolyphemusAboutSayingLittle01"
    }
    {
      Id = "Polyphemus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngelunjak {#Emph}lagi{#Prev}, domba kecil. Lu tau kan abis ini diapain."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart01"
    }
    {
      Id = "Polyphemus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Mendengus> {#Prev}Bau apaan nih busuk amat... oh gua tau apaan. Itu bau {#Emph}lu."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart02"
    }
    {
      Id = "Polyphemus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaga ada yang boleh nerobos domba gua. Kaga boleh nerobos gua juga."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart03"
    }
    {
      Id = "Polyphemus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suatu malam nanti... bakal kutangkap kau. Dan bakal kulahap kau bulat-bulat."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart04"
    }
    {
      Id = "Polyphemus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Agak kepagian buat jam makan malamku, tapi ya sudahlah! Aku bisa fleksibel."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart05"
    }
    {
      Id = "Polyphemus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fuih! {#Prev}Kau tahu baumu kecium dari jarak bermil-mil?"
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart06"
    }
    {
      Id = "Polyphemus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memang nggak tahu apa yang baik buatmu, ya?"
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart07"
    }
    {
      Id = "Polyphemus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau mau dihajar lagi, nggak masalah buatku. Oh, persediaanku masih banyak."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart08"
    }
    {
      Id = "Polyphemus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biasanya aku nggak suka makan mentah-mentah. Tapi ya, aku suka coba hal baru."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart09"
    }
    {
      Id = "Polyphemus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ssst! {#Prev}Kayaknya aku dengar sesuatu. Kau dengar juga, 'kan? Lonceng makan malam..."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart10"
    }
    {
      Id = "Polyphemus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat tuh. Sudah masuk jam makan malam ternyata..."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart11"
    }
    {
      Id = "Polyphemus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menggembala domba seharian begini benar-benar bikin nafsu makanku memuncak..."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart12"
    }
    {
      Id = "Polyphemus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang kembali ke kawanan, domba kecil. Sini, mendekatlah..."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart13"
    }
    {
      Id = "Polyphemus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidurku sudah cukup pulas, tapi makanku masih kurang kenyang..."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart14"
    }
    {
      Id = "Polyphemus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ingin pergi ke dermaga itu, aku ingin memakanmu. Begitulah kenyataannya."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart15"
    }
    {
      Id = "Polyphemus_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan lupa awasi runtuhan batu di kota ini."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart16"
    }
    {
      Id = "Polyphemus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini dia mangsa yang bakal jadi {#Emph}daging empuk{#Prev}, segar dari luar kota..."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart17"
    }
    {
      Id = "Polyphemus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku benar-benar harus benahi tembok yang terus kau terobos itu..."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart18"
    }
    {
      Id = "Polyphemus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau balik lagi minta digembala, ya, domba kecil?"
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart19"
    }
    {
      Id = "Polyphemus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak ada yang boleh masuk kota ini, nggak ada yang boleh keluar; itulah aturannya."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart20"
    }
    {
      Id = "Polyphemus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui kehebatanmu. Akhir-akhir ini aku tidur nyenyak bagai bayi di sini."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart21"
    }
    {
      Id = "Polyphemus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sehabis seharian berat menggembala domba, aku nggak keberatan dibuat pingsan sekarang."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart22"
    }
    {
      Id = "Polyphemus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biarpun aku gagal memakanmu, setidaknya sebentar lagi aku bisa tidur pulas di sini."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart23"
    }
    {
      Id = "Polyphemus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kayaknya sudah hampir jam tidurku. Tapi sebelumnya, peregangan otot dulu sedikit..."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart24"
    }
    {
      Id = "Polyphemus_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakal kutendang kau sampai ke Bulan sekarang juga kalau saja aku bisa melihat bendanya."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart25"
    }
    {
      Id = "Polyphemus_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau memang mau diinjak-injak lagi, aku siap meladeni."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart26"
    }
    {
      Id = "Polyphemus_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bakal bernasib sama kayak domba-dombaku kalau terus-terusan berulah begini."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart27"
    }
    {
      Id = "Polyphemus_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, tunggu saja sampai kedua tanganku ini mencengkeram {#Emph}dirimu."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart28"
    }
    {
      Id = "Polyphemus_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Agak kepagian buat jam makanku, tapi lagipula, aku memang nggak boleh makan terlalu larut."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart29"
    }
    {
      Id = "Polyphemus_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lancang menginjak wilayahku, kau harus bayar harganya, sesederhana itu aturannya."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart30"
    }
    {
      Id = "Polyphemus_0530"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terakhir kali kau memukulku sampai pingsan secepat itu, aku jadi dapat tidur paling nyenyak setelah sekian lama!"
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart31"
    }
    {
      Id = "Polyphemus_0531"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terakhir kali aku bahkan nggak sempat mencicip secuil pun dagingmu, tapi kau nggak bakal bisa lolos selamanya..."
      Speaker = "Polyphemus"
      Event = "PolyphemusMiscStart32"
    }
    {
      Id = "Medea_0603"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menggunakan Aspek Revaal favoritku! Sang Kiklops benar-benar tamat riwayatnya sekarang."
      Speaker = "Medea"
      Event = "MedeaMiscStart01"
    }
    {
      Id = "Medea_0604"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aspek dari Dewi Hel... Akan sangat kunikmati menyaksikan kekuatannya secara langsung."
      Speaker = "Medea"
      Event = "MedeaMiscStart02"
    }
    {
      Id = "Medea_0605"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bulan purnama bersinar begitu terang dan menyilaukan mataku... pada malam seperti ini, aku iri padamu, Tuan Polifemus."
      Speaker = "Medea"
      Event = "MedeaMiscStart03"
    }
    {
      Id = "Medea_0606"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tadi sedang asyik meracik ramuan baru, tapi aku rela meninggalkan {#Emph}apa pun {#Prev}demi {#Emph}hal ini."
      Speaker = "Medea"
      Event = "MedeaMiscStart04"
    }
    {
      Id = "Medea_0607"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aroma di tempat ini sungguh khas luar biasa, antara bau mayat membusuk dan kawanan domba sang penggembala..."
      Speaker = "Medea"
      Event = "MedeaMiscStart05"
    }
    {
      Id = "Medea_0370"
      InheritFrom = "BaseNarrative"
      DisplayName = "Racun-racunku memang diracik untuk bangsa fana, tapi terbukti ampuh juga pada para dewi."
      Speaker = "Medea"
      Event = "MedeaMiscStart06"
    }
    {
      Id = "Medea_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita bercengkerama lagi dengan maut, wahai penyihir."
      Speaker = "Medea"
      Event = "MedeaMiscStart07"
    }
    {
      Id = "Medea_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemarilah, tunjukkan pada kami pemahamanmu tentang ilmu nekromansi."
      Speaker = "Medea"
      Event = "MedeaMiscStart08"
    }
    {
      Id = "Medea_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hecate Agung memintaku menguji kesanggupanmu, kalau kau tidak keberatan?"
      Speaker = "Medea"
      Event = "MedeaMiscStart09"
    }
    {
      Id = "Medea_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak akan ragu menumpahkan sedikit darahmu di sini, wahai penyihir."
      Speaker = "Medea"
      Event = "MedeaMiscStart10"
    }
    {
      Id = "Medea_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setelah sekian lama berkutat dengan risetku, ini jadi selingan yang sangat menyegarkan."
      Speaker = "Medea"
      Event = "MedeaMiscStart11"
    }
    {
      Id = "Medea_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa jadi aku {#Emph}sudah {#Prev}mengutukmu, wahai penyihir! Coba kita lihat apakah kau sanggup mematahkan mantranya."
      Speaker = "Medea"
      Event = "MedeaMiscStart12"
    }
    {
      Id = "Medea_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hati-hati, jangan sampai kugorok leher lembutmu itu layaknya bayi yang merengek."
      Speaker = "Medea"
      Event = "MedeaMiscStart13"
    }
    {
      Id = "Medea_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengorbanan harus ditunaikan pada malam-malam seperti ini. Darahmu atau darahku rasanya sudah lebih dari cukup."
      Speaker = "Medea"
      Event = "MedeaMiscStart14"
    }
    {
      Id = "Medea_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena darah sebentar lagi akan tertumpah, tenang saja, tak akan ada setetes pun yang terbuang sia-sia."
      Speaker = "Medea"
      Event = "MedeaMiscStart15"
    }
    {
      Id = "Medea_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketahuilah bahwa usiamu yang masih muda bukan alasan bagiku untuk berbelas kasih, wahai penyihir."
      Speaker = "Medea"
      Event = "MedeaMiscStart16"
    }
    {
      Id = "Medea_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Majulah, wahai penyihir! Balaskan dendammu sekarang atas apa yang telah kami perbuat padamu waktu itu..."
      Speaker = "Medea"
      Event = "MedeaMiscStart17"
    }
    {
      Id = "Medea_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupenuhi panggilan dari kehendak Sang Malam. Sejujurnya, aku malah sangat bersemangat melayaninya."
      Speaker = "Medea"
      Event = "MedeaMiscStart18"
    }
    {
      Id = "Medea_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau melafalkan Sumpah Persaingan, jadi seperti yang sering dikatakan kaum fana: {#Emph}Kau sendiri yang memintanya."
      Speaker = "Medea"
      Event = "MedeaMiscStart19"
    }
    {
      Id = "Medea_0364"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sihirku sanggup membunuh hampir segalanya dalam sekejap, tapi tidak dengan {#Emph}dirimu. {#Prev}Meski begitu, rasanya mungkin akan sangat menyiksa."
      Speaker = "Medea"
      Event = "MedeaMiscStart20"
    }
    {
      Id = "Medea_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau begitu kebal terhadap kutukanku, wahai penyihir...?"
      Speaker = "Medea"
      Event = "MedeaMiscStart21"
    }
    {
      Id = "Medea_0366"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Baiklah, Tuan Polifemus. Mungkin kita bisa mengobrol lagi di malam yang lain."
      Speaker = "Medea"
      Event = "MedeaMiscStart22"
    }
    {
      Id = "Medea_0367"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau memanggil kehendak Sang Malam, sebaiknya jangan gentar."
      Speaker = "Medea"
      Event = "MedeaMiscStart23"
    }
    {
      Id = "Polyphemus_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...lembut... banget..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...itu... {#Emph}hmhm... {#Prev}geli..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...domba... dombaku..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0088"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...capek... banget..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}ngh... heh..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...masih... tidur... nih..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...jangan... sekarang... Ayah..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0189"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...bentar lagi... bangun..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...jangan ke mana-mana ya... dombaku..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0443"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...bentar lagi bangun... semenit lagi..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0444"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}ah... {#Prev}enaknya..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0440"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...tiga domba... empat domba... lima..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0441"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...tujuh domba... delapan domba... sembilan..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "Polyphemus_0442"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...sepuluh domba... {#Emph}nghh... {#Prev}satu domba... dua..."
      Speaker = "Polyphemus"
      Event = "PolyphemusCorpse.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_5579"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Entah kenapa aku malah memimpikan {#Emph}dirimu...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "MelinoeField_5580"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan cuma kau yang butuh tidur nyenyak!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0510"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Dengar ya, aku cuma makan {#Emph}beberapa ekor {#Prev}kok di sana-sini..."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mendengus> Ah..."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0337"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ternyata {#Emph}kau..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0338"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku di sini...!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0339"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Penyihir..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0340"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ah, ya."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0341"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kiklops."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0344"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atas kehendak Malam."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0345"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita semua sudah berkumpul."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0346"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam, kalian berdua."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0347"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa kita mulai...?"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0348"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam yang sungguh luar biasa..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0343"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuanku."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0342"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Polifemos."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0349"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulan sedang purnama..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Medea_0350"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulan baru..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "MelinoeField_0529"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Polifemos!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "MelinoeField_0530"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Polifemos..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Melinoe_1451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau dengar itu, kan..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Melinoe_1452"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nyenyak tidur siangmu?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, ini dia."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mendengus> Hrm."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti bercanda."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hai!"
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang benar saja."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bukan domba."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada apa lagi sekarang?"
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau lagi."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau {#Emph}lagi?"
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus sekali."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada orang di sana..."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kudengar kau sudah kembali..."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa? {#Emph}Ooh..."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berhenti di situ."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
    }
    {
      Id = "Polyphemus_0193"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku {#Emph}melihat{#Prev}mu."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.PolyphemusGreetingLines"
