{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _RoomDataO.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "MelinoeField_1815"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti ini kapal yang paling dekat..."
      Speaker = "Melinoe"
      Event = "BaseO.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1816"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kupakai saja yang ini."
      Speaker = "Melinoe"
      Event = "BaseO.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1735"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapal yang sengaja ditenggelamkan..."
      Speaker = "Melinoe"
      Event = "ObstacleData[691287].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1736"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapal ini masih jauh dari kata layak berlayar..."
      Speaker = "Melinoe"
      Event = "ObstacleData[691287].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1737"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih terhubung ke armada utama..."
      Speaker = "Melinoe"
      Event = "ObstacleData[691287].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1738"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gerbang Arwahnya masih utuh."
      Speaker = "Melinoe"
      Event = "ObstacleData[691287].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1808"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada Gerbang Arwah di sini..."
      Speaker = "Melinoe"
      Event = "ObstacleData[691310].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di pinggiran kota terhampar dermaga darurat, tempat sebuah kapal dapat membelah terusan daratan, menuju gunung para dewa."
      Speaker = "Storyteller"
      Event = "Inspect_O_Intro_01"
    }
    {
      Id = "MelinoeField_1836"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya aku butuh tumpangan."
      Speaker = "Melinoe"
      Event = "Inspect_O_Intro_01"
    }
    {
      Id = "Storyteller_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ketika bala tentara Chronos berbaris menuju Olimpus, Poseidon yang perkasa membelah daratan. Dan kini, para dewa pun harus berhadapan dengan armada laut..."
      Speaker = "Storyteller"
      Event = "Inspect_O_Intro_02"
    }
    {
      Id = "MelinoeField_1837"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan sebuah kesalahan; ini sebuah kesempatan."
      Speaker = "Melinoe"
      Event = "Inspect_O_Intro_02"
    }
    {
      Id = "Melinoe_0804"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pelabuhan..."
      Speaker = "Melinoe"
      Event = "O_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_0805"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dermaga..."
      Speaker = "Melinoe"
      Event = "O_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4580"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang maju ke Ngarai..."
      Speaker = "Melinoe"
      Event = "O_Intro.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah kapal hitam, yang terpekat dari segalanya, mengacaukan armada tak berujung yang mengepung Olimpus; namun tak ada yang berani berhadapan lama-lama dengannya, ataupun dengan kapten mengerikan dari awak berhantunya."
      Speaker = "Storyteller"
      Event = "Inspect_O_Shop01_01"
    }
    {
      Id = "MelinoeField_1841"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Charon berhasil menahan musuh-musuh kita..."
      Speaker = "Melinoe"
      Event = "Inspect_O_Shop01_01"
    }
    {
      Id = "Storyteller_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kini, pesisir jauh tempat bertakhtanya gunung para dewa yang megah tiba-tiba terasa begitu dekat. Dan Kapal Induk Hitam telah bersiap mengantarkan sang Putri ke sana."
      Speaker = "Storyteller"
      Event = "Inspect_O_PreBoss01_01"
    }
    {
      Id = "MelinoeField_1842"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pesisirnya tepat di depan mata..."
      Speaker = "Melinoe"
      Event = "Inspect_O_PreBoss01_01"
    }
    {
      Id = "Storyteller_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Saat sang Kapal Induk Hitam berlayar mendekati pantai, sang Putri Kematian tahu betul bahwa Perselisihan apa pun yang ia hadapi malam ini... akan bertambah jauh lebih runyam."
      Speaker = "Storyteller"
      Event = "Inspect_O_PreBoss01_02"
    }
    {
      Id = "MelinoeField_1843"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, aku {#Emph}sangat siap menyambutnya."
      Speaker = "Melinoe"
      Event = "Inspect_O_PreBoss01_02"
    }
    {
      Id = "Storyteller_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Merasakan kembali pijakan Bumi yang kukuh di bawah kakinya memulihkan tekad tak berbatas sang Putri Dunia Bawah, seraya tujuannya akhirnya kian mendekat."
      Speaker = "Storyteller"
      Event = "Inspect_O_Boss01_01"
    }
    {
      Id = "MelinoeField_1844"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gunung Olimpus... ada di depan sana..."
      Speaker = "Melinoe"
      Event = "Inspect_O_Boss01_01"
    }
    {
      Id = "Storyteller_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang perwujudan Perselisihan telah sirna, namun pengaruhnya tetap membekas, tatkala Bumi dan Samudra sama-sama terjerumus dalam konflik dahsyat yang ingin terus ia kobarkan selamanya."
      Speaker = "Storyteller"
      Event = "Inspect_O_Boss01_02"
    }
    {
      Id = "MelinoeField_1845"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Eris pasti sedang girang-girangnya..."
      Speaker = "Melinoe"
      Event = "Inspect_O_Boss01_02"
    }
    {
      Id = "Storyteller_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Rahasia tersembunyi dari senjata purba milik sang perwujudan Perselisihan yang liar ternyata tak cukup tak terduga untuk meruntuhkan kewaspadaan sang Putri Dunia Bawah."
      Speaker = "Storyteller"
      Event = "Inspect_O_Boss02_01"
    }
    {
      Id = "MelinoeField_3617"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga pemilik Bedil berikutnya bisa lebih bertanggung jawab."
      Speaker = "Melinoe"
      Event = "Inspect_O_Boss02_01"
    }
    {
      Id = "Storyteller_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Pesisir busuk yang seharusnya tak pernah ada mencemari batas Ngarai, di mana Gunung Olimpus yang agung menjulang megah di seberangnya, dirundung teror oleh Perselisihan dan Ketakutan secara bergantian malam ini."
      Speaker = "Storyteller"
      Event = "Inspect_O_Boss02_02"
    }
    {
      Id = "MelinoeField_3657"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pantai yang satunya tadi lumayan lebih indah..."
      Speaker = "Melinoe"
      Event = "Inspect_O_Boss02_02"
    }
    {
      Id = "Storyteller_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah celah melintasi bebatuan berselimut salju menuju ke kaki gunung paling suci milik para dewa: Olimpus, yang kini menjulang mustahil menembus angkasa di atas."
      Speaker = "Storyteller"
      Event = "Inspect_O_PostBoss01_01"
    }
    {
      Id = "MelinoeField_2524"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pendakian yang lumayan..."
      Speaker = "Melinoe"
      Event = "Inspect_O_PostBoss01_01"
    }
    {
      Id = "MelinoeField_2451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jalur menuju Olimpus..."
      Speaker = "Melinoe"
      Event = "O_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2452"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kaki gunung..."
      Speaker = "Melinoe"
      Event = "O_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2453"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makin dingin..."
      Speaker = "Melinoe"
      Event = "O_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2454"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini dia..."
      Speaker = "Melinoe"
      Event = "O_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Monster bernama Charybdis menjadi akhir petaka bagi banyak kapal yang lengah, dan dalam kengerian purbanya, kini ia mencemari ngarai berair laut yang mengoyak daratan."
      Speaker = "Storyteller"
      Event = "Inspect_O_MiniBoss01_01"
    }
    {
      Id = "MelinoeField_1839"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah berapa banyak kapal yang jadi korban monster itu?"
      Speaker = "Melinoe"
      Event = "Inspect_O_MiniBoss01_01"
    }
    {
      Id = "Storyteller_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kekejian bernama Charybdis memicu pusaran air di tengah lautan, tempat di mana kapal paling lincah sekalipun mustahil dapat meloloskan diri."
      Speaker = "Storyteller"
      Event = "Inspect_O_MiniBoss01_02"
    }
    {
      Id = "MelinoeField_1840"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sebaiknya aku pergi sekarang."
      Speaker = "Melinoe"
      Event = "Inspect_O_MiniBoss01_02"
    }
    {
      Id = "Storyteller_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Salah satu kapal hantu yang lebih ramping dan kokoh dalam armada sang Tuan Titan kini telah kehilangan seluruh perompak yang menjadi awaknya; namun dalam kegelisahan arwah mereka, mereka masih bisa bangkit kembali."
      Speaker = "Storyteller"
      Event = "Inspect_O_MiniBoss02_01"
    }
    {
      Id = "MelinoeField_3261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, akan kutenggelamkan mereka lagi."
      Speaker = "Melinoe"
      Event = "Inspect_O_MiniBoss02_01"
    }
    {
      Id = "Storyteller_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebelum daratan terbelah, manusia fana biasa berkumpul dalam perlombaan akbar demi kejayaan para dewa; namun kini, para dewa itu sendiri justru tampak berebut sisa-sisa remah yang tersisa."
      Speaker = "Storyteller"
      Event = "Inspect_O_Devotion_01"
    }
    {
      Id = "MelinoeField_3249"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupikir masih ada cukup bagian untuk kita semua."
      Speaker = "Melinoe"
      Event = "Inspect_O_Devotion_01"
    }
    {
      Id = "Storyteller_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah celah rimba terlindung yang terkoyak dari jantung daratan, entah bagaimana masih memancarkan sisa masa-masa damai dan asri yang telah lama terkubur di masa lampau."
      Speaker = "Storyteller"
      Event = "Inspect_O_Reprieve01_01"
    }
    {
      Id = "MelinoeField_1838"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Zaman berganti."
      Speaker = "Melinoe"
      Event = "Inspect_O_Reprieve01_01"
    }
    {
      Id = "MelinoeField_1878"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebuah pulau... siapa...?"
      Speaker = "Melinoe"
      Event = "O_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1879"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pulaunya Circe..."
      Speaker = "Melinoe"
      Event = "O_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1881"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu tempat ini..."
      Speaker = "Melinoe"
      Event = "O_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1882"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akhirnya daratan yang kokoh..."
      Speaker = "Melinoe"
      Event = "O_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1880"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pulau Aiaia..."
      Speaker = "Melinoe"
      Event = "O_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1884"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam, babi-babi kecil."
      Speaker = "Melinoe"
      Event = "ObstacleData[744056].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1886"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian yang sopan, ya."
      Speaker = "Melinoe"
      Event = "ObstacleData[744056].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1883"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, babi-babi gemas."
      Speaker = "Melinoe"
      Event = "ObstacleData[744056].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1885"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenang saja, kawan-kawan mungil."
      Speaker = "Melinoe"
      Event = "ObstacleData[744056].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tataplah pulau kuno tempat seorang penyihir agung mengasah ilmunya, di tengah flora dan fauna yang menyambutnya sebagai bagian dari diri mereka sendiri."
      Speaker = "Storyteller"
      Event = "Inspect_O_Story01_01"
    }
    {
      Id = "MelinoeField_1846"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terasa begitu aman dan damai di sini..."
      Speaker = "Melinoe"
      Event = "Inspect_O_Story01_01"
    }
    {
      Id = "Storyteller_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aroma manis bercampur tajam yang menguar dari kuali sang penyihir ulung Circe menyiratkan betapa tinggi keahliannya, baik sebagai praktisi seni kuno, maupun juru masak."
      Speaker = "Storyteller"
      Event = "Inspect_O_Story01_02"
    }
    {
      Id = "MelinoeField_1847"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bisa bernapas lega di sini..."
      Speaker = "Melinoe"
      Event = "Inspect_O_Story01_02"
    }
  ]
}
