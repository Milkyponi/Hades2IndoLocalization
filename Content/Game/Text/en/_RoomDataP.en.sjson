  lang = "en"
  Texts = [
    {
      Id = "Storyteller_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Keagungan Gunung Olympus terbaring separuh terkubur di bawah selimut tebal salju, menyamarkan luka dan cela dari pengepungan yang berkepanjangan."
      Speaker = "Storyteller"
      Event = "Inspect_P_Intro_01"
    }
    {
      Id = "Melinoe_1113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Indah sekali..."
      Speaker = "Melinoe"
      Event = "Inspect_P_Intro_01"
    }
    {
      Id = "Storyteller_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Gunung itu sendiri mengerang dan bergemuruh di bawah telapak kaki sang Putri, bebatuan di sana bergeser tak ubahnya alam baka milik ayahnya."
      Speaker = "Storyteller"
      Event = "Inspect_P_Intro_02"
    }
    {
      Id = "Melinoe_1114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau dipikir-pikir, tempat ini mengingatkanku pada rumah."
      Speaker = "Melinoe"
      Event = "Inspect_P_Intro_02"
    }
    {
      Id = "MelinoeField_2455"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gunung Olympus..."
      Speaker = "Melinoe"
      Event = "P_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2456"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sudah sampai..."
      Speaker = "Melinoe"
      Event = "P_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2457"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berhasil sampai sejauh ini..."
      Speaker = "Melinoe"
      Event = "P_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dingin sekali di atas sini..."
      Speaker = "Melinoe"
      Event = "P_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1464"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akhirnya..."
      Speaker = "Melinoe"
      Event = "P_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang tinggal memanjat..."
      Speaker = "Melinoe"
      Event = "P_Intro.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ketinggian semacam ini bukanlah tempat bagi sang Pendayung Alam Baka; kendati begitu, barang dagangannya anehnya dapat ditemukan di sini, barangkali dibawa oleh sekutu-sekutu yang tak kasat mata."
      Speaker = "Storyteller"
      Event = "Inspect_P_Shop01_01"
    }
    {
      Id = "MelinoeField_2828"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sekutu yang sungguh sangat kuhargai."
      Speaker = "Melinoe"
      Event = "Inspect_P_Shop01_01"
    }
    {
      Id = "MelinoeField_2513"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya di sini tenang..."
      Speaker = "Melinoe"
      Event = "P_PreBoss01.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Puncak megah Gunung Olympus seharusnya terlihat sangat jelas dari sini, andai saja dinding badai yang amat gelap dan mengerikan itu tidak menyelubunginya."
      Speaker = "Storyteller"
      Event = "Inspect_P_PreBoss01_01"
    }
    {
      Id = "MelinoeField_2526"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Badai sedang berkecamuk..."
      Speaker = "Melinoe"
      Event = "Inspect_P_PreBoss01_01"
    }
    {
      Id = "MelinoeField_5589"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa kau sudah meramal aku bakal melihatmu di mimpiku?"
      Speaker = "Melinoe"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_5590"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terkadang kata-katamu lebih meyakinkan daripada yang berani kuakui!"
      Speaker = "Melinoe"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_5591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau takkan pernah bisa mengintip ke dalam mimpiku, Titan!"
      Speaker = "Melinoe"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu dia..."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0487"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Apa kubilang?"
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia ada di sini."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0371"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Si penyihir."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat dugaannya."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0365"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Persis seperti katanya..."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lalu?"
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0372"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukannya aku baru saja melihatmu?"
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0373"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita bertemu lagi."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0374"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia terluka tampaknya..."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berhenti di situ."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0054"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan bergerak."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ternyata kau."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah kuduga."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuh, kan!"
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini dia mangsa kita."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa bicara sebentar?"
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para dewa..."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Firasatku benar."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0496"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita bertemu lagi."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0492"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah kuduga kau bakal muncul."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0493"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah {#Prev}ya..."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0494"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah bisa ditebak..."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0495"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana pendakianmu?"
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0497"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih belum puas juga?"
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Agen Perubahan..."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat siapa ini."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rutinitas malam kita."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0490"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua hadir dan lengkap."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kubilang juga apa, kawan berotot."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau lihat sendiri, kan?"
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat ke sana, kawan."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Prometheus_0491"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sapa dia, Heracles."
      Speaker = "Prometheus"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0367"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tukang pamer."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kulihat kok."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Heracles_0103_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak."
      Speaker = "Heracles"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2514"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Prometheus."
      Speaker = "Melinoe"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2515"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Titan."
      Speaker = "Melinoe"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2516"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kaget?"
      Speaker = "Melinoe"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tebak siapa."
      Speaker = "Melinoe"
      Event = "P_Boss01.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tak ada lagi jejak Sang Titan Peramal masa depan maupun Rajawali rekannya, selain sehelai bulu yang tertinggal; seakan memprovokasi sang Putri untuk mendaki lebih tinggi lagi."
      Speaker = "Storyteller"
      Event = "Inspect_P_Boss01_01"
    }
    {
      Id = "MelinoeField_2826"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Asal jangan ada Rajawali lagi, kumohon..."
      Speaker = "Melinoe"
      Event = "Inspect_P_Boss01_01"
    }
    {
      Id = "Storyteller_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bahkan panas membara yang membubung dari perapian pusat gunung tak mampu sepenuhnya mengusir dingin yang menyelimuti udara di sini; badai yang tengah bergolak, bukan buatan para dewa, melainkan sesuatu yang lain."
      Speaker = "Storyteller"
      Event = "Inspect_P_Boss01_02"
    }
    {
      Id = "MelinoeField_2825"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sesuatu yang {#Emph}bersahabat?"
      Speaker = "Melinoe"
      Event = "Inspect_P_Boss01_02"
    }
    {
      Id = "Storyteller_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tampaknya sang Titan berpandangan tajam yang menentang Raja Olimpus dan salah satu putra terkuat sekaligus paling ditakuti sang Raja kini bertarung bahu-membahu di pihak yang sama..."
      Speaker = "Storyteller"
      Event = "Inspect_P_Boss01_03"
    }
    {
      Id = "MelinoeField_3618"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kelihatannya memang begitu."
      Speaker = "Melinoe"
      Event = "Inspect_P_Boss01_03"
    }
    {
      Id = "Storyteller_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Puncak-puncak suci ini seharusnya hanya diperuntukkan bagi para dewa, atau setidaknya para pemuja mereka; bukan untuk mantan sekutu dan musuh bebuyutan mereka, yang bersekongkol menentang kekuasaan ilahi."
      Speaker = "Storyteller"
      Event = "Inspect_P_Boss01_04"
    }
    {
      Id = "MelinoeField_3658"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang sedang mereka rencanakan...?"
      Speaker = "Melinoe"
      Event = "Inspect_P_Boss01_04"
    }
    {
      Id = "Storyteller_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di balik kobaran api di ketinggian Gunung Olimpus, terbentang jalur sunyi menuju puncak, tempat berdirinya benteng yang lebih perkasa daripada para dewa maupun Titan terkuat sekalipun."
      Speaker = "Storyteller"
      Event = "Inspect_P_PostBoss01_01"
    }
    {
      Id = "MelinoeField_3250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan di baliknya, ada Istana Zeus..."
      Speaker = "Melinoe"
      Event = "Inspect_P_PostBoss01_01"
    }
    {
      Id = "MelinoeField_2512"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Puncaknya tepat di depan..."
      Speaker = "Melinoe"
      Event = "P_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2683"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampaknya para Automaton bukan temanku..."
      Speaker = "Melinoe"
      Event = "P_Combat03.CombatResolvedVoiceLines"
    }
    {
      Id = "Storyteller_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Pertempuran Olympus berada di ujung tanduk, tatkala para pelindung mekanis gunung itu dan bala tentara sang Titan terus bertumbukan, mengguncang langit itu sendiri."
      Speaker = "Storyteller"
      Event = "Inspect_P_Combat03_01"
    }
    {
      Id = "MelinoeField_2824"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seluruh dunia gemetar..."
      Speaker = "Melinoe"
      Event = "Inspect_P_Combat03_01"
    }
    {
      Id = "Storyteller_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah celah ceruk yang terbebas dari sengitnya kemelut di puncak Olympus yang terkepung mengundang sang Putri Dunia Bawah untuk menghela sisa-sisa napasnya sejenak."
      Speaker = "Storyteller"
      Event = "Inspect_P_Reprieve01_01"
    }
    {
      Id = "MelinoeField_2529"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak bisa istirahat di sini, jangan berlama-lama..."
      Speaker = "Melinoe"
      Event = "Inspect_P_Reprieve01_01"
    }
    {
      Id = "MelinoeField_5654"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak terbayang apa yang dimimpikan oleh Dionisius..."
      Speaker = "Melinoe"
      Event = "P_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2510"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang sedang terjadi di sini...?"
      Speaker = "Melinoe"
      Event = "P_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2511"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih saja berpesta..."
      Speaker = "Melinoe"
      Event = "P_Story01.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sisa-sisa kegembiraan di atas gunung para dewa yang luluh lantak oleh perang tampaknya terpusat di sini, tempat Dionisius, sang dewa anggur, menjamu rombongan pesuka pesta yang paling ia sayangi."
      Speaker = "Storyteller"
      Event = "Inspect_P_Story01_01"
    }
    {
      Id = "MelinoeField_2525"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya para Satir itu tidak mencoba membantaiku..."
      Speaker = "Melinoe"
      Event = "Inspect_P_Story01_01"
    }
    {
      Id = "Storyteller_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di antara sekian banyak kemampuan pertahanan milik Talos yang mengerikan, sang Automaton Olympus terkuat yang ditempa langsung oleh tangan agung Hefaistos sendiri, terdapat kekuatan untuk memperbaiki dirinya sendiri secara perlahan..."
      Speaker = "Storyteller"
      Event = "Inspect_P_MiniBoss_01"
    }
    {
      Id = "MelinoeField_2528"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti Talos akan mengingat kesalahpahaman ini lain kali..."
      Speaker = "Melinoe"
      Event = "Inspect_P_MiniBoss_01"
    }
    {
      Id = "Storyteller_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Gunung yang menjulang tinggi tak mudah untuk dikepung; maka sang Titan Waktu yang cerdik mencari binatang-binatang bersayap yang mudah terpikat bujuk rayunya, dan sanggup menimpakan kekacauan dari angkasa."
      Speaker = "Storyteller"
      Event = "Inspect_P_MiniBoss02_01"
    }
    {
      Id = "MelinoeField_2827"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya mereka sudah merasa kerasan di sini..."
      Speaker = "Melinoe"
      Event = "Inspect_P_MiniBoss02_01"
    }
  ]
}
