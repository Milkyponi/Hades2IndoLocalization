    }
    {
      Id = "MelinoeField_5540"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpi ini rasanya agak terlalu nyata..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5541"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpiku sampai sedetail ini..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5542"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpi dan kenyataan ternyata bisa semirip ini..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5543"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpi kali ini tentang membungkam Scylla terlebih dahulu..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5544"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lagu-lagu Scylla masih terngiang-ngiang di kepalaku..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5545"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memulai dari jurang penderitaan, rupanya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5546"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenapa aku selalu memulainya dari sini, ya...?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5547"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seandainya saja aku bisa mencapai Tartarus semudah ini..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5548"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya kita akan membereskan Chronos terlebih dahulu."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5549"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tempat yang pas untuk memulai penjelajahan mimpi..."
