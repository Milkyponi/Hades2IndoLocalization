    }
    {
      Id = "Melinoe_1337"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari dermaga aku bisa mencari kapal untuk menyeberangi celah itu..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_1338"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seharusnya aku bisa mencapai Olimpus dari sana."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada jalan memutar... harus menerobos kota ini..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0357"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...Susuri Sungai Akheron, lewati nekropolis..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0360"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampak begitu damai dari kejauhan..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0361"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dermaganya tidak begitu terlihat dari sini..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0358"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kengerian apa yang mengintai di dalam Ephyra malam ini..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0359"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam biasa lainnya di kota..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_1739"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapal-kapal perang bangkit dari kedalaman... semuanya menuju ke Olympus."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_1740"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di balik celah ini, gunung para dewa..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_1741"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya perjalanan laut malam yang singkat... apa yang perlu ditakutkan?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_1742"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terlalu jauh untuk berenang... tapi kapal-kapal di luar sana sangat cepat..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu satu kapal karam, yang lain bangkit dari kedalaman..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sungguh armada yang aneh dan mengerikan milik Chronos..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2714"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tarik napas dalam-dalam, Mel..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2715"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah sejauh ini, tapi... pendakian sesungguhnya baru saja dimulai."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2716"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluarga mungkin terlalu angkuh untuk meminta tolong, tapi sekarang mereka sedang membutuhkan bantuan."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2717"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersama-sama, kita semua bisa menang."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya perlu berjalan dari sini sampai ke... tempat setinggi itu di atas sana..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pantas saja bangsa fana mempersembahkan kurban untuk para dewa di sini..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benteng alami... tak ada jalan mudah untuk naik, apalagi di tengah kepungan ini."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2484"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tahu aku ada di sini, kan, Prometheus...?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2485"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenapa keluargaku harus tinggal di tempat-tempat yang paling merepotkan..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Fokuslah pada setiap langkah berikutnya... dan capailah puncaknya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_3357"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Di luar sana, apakah itu...? Ada sesuatu di balik awan-awan itu.... Oh, para dewa..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2932"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sama sekali tak kelihatan apa pun di luar sana..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2933"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Unsur-unsur alam itu sendiri, berbalik melawan para dewa..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2953"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Ada sesuatu di luar sana..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2934"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Typhon mendatangkan badai ini ke hadapan para dewa..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2935"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sang Ayah Segala Monster, Sang Pembawa Badai..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2936"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kau akan tahu kalau aku sama keras kepalanya denganmu, Typhon..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_2937"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kau tak bisa bersembunyi dariku di luar sana, monster..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_5018"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hermes mungkin sudah menyebarkan kabarnya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_3463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Terkesiap> {#Prev}Itu..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_3466"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Itu... Sang Surya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_3465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Fajar menyingsing..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_3464"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Indah sekali..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_3467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Fajar..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di seberang sana terbentang wilayah Paman Poseidon..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jalan buntu yang tak terhitung... hanya satu jalan tembus..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua logam itu menahan lautan itu sendiri..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setiap ruangan di sini menuntun ke ruangan yang lebih dalam..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kira-kira teror apa lagi yang mengintai di dalam lautan..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0140"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mahakarya tiada tara dari Sang Maestro Daedalus..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak kusangka jalur ini lebih aman daripada melewati Elysium..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0842"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu banyak kehidupan fana yang berakhir tanpa terpuaskan..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0843"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Lintasi Padang, lewati jembatan, carilah jalan turun di sana..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0844"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cinta yang hilang... impian yang pupus... penyesalan..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0845"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ketiadaan harapan... kegagalan... keputusasaan..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0846"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan menyerah... jangan menyerah..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0847"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, Mel... tunggu apa lagi..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0848"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Perasaan mengerikan ini... cuma tipuan pikiran..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_0849"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan berakhir seperti semua jiwa malang di sini..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_1285"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aula Tartarus yang selalu bergeser..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_1286"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua... permesinan ini. Untuk apa...?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_1287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah Chronos yang membangun semua ini...?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_1288"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti dengan cara inilah ruangan-ruangan itu mengatur ulang jalurnya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_1289"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chronos dan roda-roda perubahannya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_1290"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sungguh kebisingan jahanam di sekitar sini..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_0865"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Enyahlah Chronos. Aku yang akan memastikannya. Tak ada yang lebih siap dariku."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_0866"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di balik kabut Erebus mestinya ada jalan ke bawah."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_0867"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terlalu berisiko lewat Elysium. Dan terlalu berisiko untuk tetap tinggal."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_0868"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah. Sudah waktunya."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_0869"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimanapun caranya, aku akan menembus semua kegelapan itu."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_4301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya ada segelintir tempat seperti ini, tempat dua alam bertemu..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_4298"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chronos menduduki takhta ayahku jauh di bawah sana... Typhon mengancam Olympus jauh di atas sana."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_4299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana pun arah yang kupilih, aku pasti bisa menang... tapi ke mana fokusku selanjutnya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_4300"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tiap kali aku menuju Olympus, aku menentang Takdir itu sendiri..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_0870"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke bawah, jalan menuju Tartarus. Ke atas, jalan menuju Olympus."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_1321"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulan sedang purnama..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_5444"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulan begitu benderang..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_1327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulannya indah sekali..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_1323"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulan mulai menyusut..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_1328"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekuatan Bulan tinggal separuh..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_1324"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulan menyusut..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_1322"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulan baru..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_1325"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulan mulai membesar..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_1329"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Mata Malam..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "Melinoe_1326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulan membesar..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookVoiceLines"
    }
    {
      Id = "MelinoeField_5227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa Chronos benar-benar ingin tempat seperti ini dihancurkan...?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookLeaveVoiceLines"
    }
    {
      Id = "MelinoeField_5228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku memang sudah bilang pada Zagreus kalau menyiapkan Gigaros mungkin butuh sedikit waktu..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookLeaveVoiceLines"
    }
    {
      Id = "MelinoeField_5229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertama kita bereskan urusan di sini, baru Chronos terakhir..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookLeaveVoiceLines"
    }
    {
      Id = "MelinoeField_5230"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Zagreus... andai saja kau bisa melihat ini sendiri..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.OverlookLeaveVoiceLines"
    }
    {
      Id = "Storyteller_0450"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Demikianlah Hades, penguasa orang mati yang ditakuti, dipulihkan ke takhta haknya berdampingan dengan Ratu Persephone yang anggun memukau."
      Speaker = "Storyteller"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Storyteller_0451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Serangan ke Olympus akhirnya terhenti, dan sejak saat itu, para dewa memerintah dunia kita dengan perhatian yang baru."
      Speaker = "Storyteller"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Storyteller_0452"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sedangkan sang Putri Kematian, Melinoë, ia tetap terus berhubungan dengan seluruh keluarganya dari kenyamanan bayang-bayang gelap yang telah lama menjadi rumahnya."
      Speaker = "Storyteller"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Storyteller_0453"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dan ia bersama Para Saudari Perak terus menjaga seluruh alam semesta dalam rahasia untuk selama-lamanya."
      Speaker = "Storyteller"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2932"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lukisan tua yang belum selesai ini... jangan buang muka. Jangan lupakan semua yang telah direnggut sang Titan darimu."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_3989"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan menemukan mereka. Dan akan ada banyak hal untuk dibicarakan. Untuk saat ini, biarkan rasa rindu itu menyemangatimu."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_3988"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa kau makin termotivasi mencari keluargamu? Atau hanya makin putus asa...?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2936"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka semua tampak begitu bahagia bersama, bukan? Tanpa menyadari ancaman sang Titan..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chronos mengancam kau takkan pernah melihat keluargamu lagi, si keparat itu. Tapi kau sudah melihatnya, dan akan melihatnya lagi."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2935"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapan-kapan kau harus bertanya pada Kepala Sekolah bagaimana beliau bisa membawa ini keluar dari Griya."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2938"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayah... beliau begitu bahagia waktu itu, tapi sekarang...? Jangan biarkan sang Titan mematahkan semangatnya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2939"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kakak... kau sama sekali tak mengingatnya, tapi... kau merindukannya. Entah bagaimana, kau merasakannya."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2940"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ibu... setidaknya rambutmu mirip dengannya. Beliau tampak begitu berbeda dari Kepala Sekolah, ya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2943"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak mengingat mereka selain dari lukisan ini dan mimpi-mimpimu. Namun kau tetap berjuang demi mereka..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5779"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chronos... apa ini yang dia inginkan? Keluarganya kembali? Cara yang aneh untuk menunjukkannya."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5780"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekuatan untuk menghabisi anggota keluargamu sendiri... ini pasti bukan satu-satunya jalan."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2934"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenangan akan semua yang telah hilang... bahkan sekarang ini mengobarkan hasratmu akan pembalasan dendam."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2937"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Titan menguasai keluargamu, atau lebih buruk lagi... apa yang telah dia lakukan pada mereka?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2933"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayah... Ibu... Kakak... kumohon selamatlah. Kumohon..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2941"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semua yang hilang darimu adalah jati dirimu{#Prev}, seperti kata Kepala Sekolah..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_2942"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluarga ini... hilang darimu sejak kau lahir. Mereka berhak menuntut balas, begitu pula dirimu."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_1607"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pembalasan demi keluargaku."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_0347"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pembalasan demi ayahku."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5715"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ibu dan Ayah... kita akan segera bertemu lagi."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5714"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Betapa bahagianya kita semua tampak di sana... dan pada saat itu, kita memang sungguh bahagia..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5717"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam, semuanya... jaga diri baik-baik, ya?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5719"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga renovasi Dunia Bawah berjalan lancar..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5179"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluargamu... kalian mungkin tidak tinggal di bawah atap yang sama, tapi kalian tetap bersama."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenangan akan pertemuan kembali kalian, terabadikan di atas kanvas dengan begitu indahnya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5181"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Entah bagaimana caranya mereka bisa menyuruh Cerberus duduk diam cukup lama demi lukisan ini..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5182"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau takkan melupakan mereka, {#Emph}selamanya... {#Prev}dan dengan {#Emph}ini{#Prev}, mungkin Dora juga takkan melupakan mereka."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Griya Hades begitu megah... tapi menyenangkan juga punya ruangan sendiri."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lukisan tua itu tersimpan aman. Kenangan itu takkan ke mana-mana."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gaun yang begitu indah mereka buatkan untukku... meski tak selembut sutra Arachne."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5189"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan segera bertemu mereka lagi. Mungkin malam ini."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kakak... dia begitu berbeda, tapi... rasanya seperti ada bagian dirimu yang hilang sampai akhirnya kalian bertemu."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ibu... Ayah... Kakak... Cerberus... dan dirimu."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5716"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu kita masih sangat panjang..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_5718"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga diri kalian baik-baik... sampai kita bertemu lagi."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.UsedFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_3990"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa beberapa malam lagi, semuanya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.CoveredFamilyPortraitVoiceLines"
    }
    {
      Id = "Melinoe_3991"
