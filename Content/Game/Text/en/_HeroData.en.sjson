      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5551"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa para dewa lain sudah terbiasa memulainya dari sini..."
      Speaker = "Melinoe"
