    }
    {
      Id = "MelinoeField_5496"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Rupanya bukan."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5497"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan, aku salah."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5498"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Atau bukan!"
