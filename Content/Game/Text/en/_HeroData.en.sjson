    }
    {
      Id = "MelinoeField_0212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Akhirnya."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamPostBossExitVoiceLines"
    }
    {
      Id = "MelinoeField_5627"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Baiklah, saatnya bangun."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "MelinoeField_5628"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Waktunya bangun."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "MelinoeField_5629"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sepertinya sudah waktunya."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "MelinoeField_5630"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sebaiknya aku bangun."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "MelinoeField_5631"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku harus segera bangun."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "MelinoeField_5632"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sebentar lagi aku bangun..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "MelinoeField_5633"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Hypnos, bawa aku kembali."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "MelinoeField_5634"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Hypnos, apa sudah selesai?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "MelinoeField_5635"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Hypnos, apa kita sudah selesai?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "MelinoeField_5636"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Hypnos, tolong bangunkan aku?"
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "Melinoe_0010_V3"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Saatnya bangun."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamRunClearedVoiceLines"
    }
    {
      Id = "Melinoe_2284"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat waktu."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.ReceivedSupplyDropVoiceLines"
    }
    {
      Id = "Melinoe_2285"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kondisi sempurna."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.ReceivedSupplyDropVoiceLines"
    }
    {
      Id = "Melinoe_2286"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sesuai janji."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.ReceivedSupplyDropVoiceLines"
    }
    {
      Id = "Melinoe_2287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semuanya lengkap."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.ReceivedSupplyDropVoiceLines"
    }
    {
      Id = "Melinoe_5307"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Enak sekali..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Melinoe_5308"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bisa berendam semalaman di sini..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Melinoe_5309"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Membiarkan semua beban pikiran sirna..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Melinoe_5310"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sangat butuh ini..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Melinoe_5311"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}...Fiuh{#Prev}, melelahkan sekali belakangan ini..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Melinoe_5312"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Malam ini lebih hangat dari biasanya..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Melinoe_5313"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Damai sekali di sini..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Melinoe_5314"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Benar-benar yang kubutuhkan..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Melinoe_5315"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}...Fiuh{#Prev}, ini sungguh nikmat..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Melinoe_5316"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Selalu menenangkan..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Melinoe_5317"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}<Sigh> {#Prev}Nyaman sekali di sini..."
      Speaker = "Melinoe"
      Event = "BathHouseIntroTextLines"
    }
    {
      Id = "Storyteller_0481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Maka dengan demikian Melinoë, sang Putri Gaib Dunia Bawah, mencegah segala kemungkinan Sang Waktu dapat berbalik secara kejam melawan para dewa lagi..."
      Speaker = "Storyteller"
      Event = "Outro_PostTrueEnding01.VoiceLines"
    }
    {
      Id = "Storyteller_0482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Setidaknya satu kemungkinan, dari sekian banyak kemungkinan yang ada. Sebab Waktu mengalir layaknya sungai, dan arusnya kerap berbelok ke arah yang tak terduga."
      Speaker = "Storyteller"
      Event = "Outro_PostTrueEnding01.VoiceLines"
    }
    {
      Id = "Storyteller_0483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sang Putri sama sekali tak melihat Rumah Hades yang sebenarnya lagi; setidaknya tidak di malam ini. Namun tempat itu masih luluh lantak akibat ulah sang Titan, jadi ia tidak melewatkan banyak hal."
      Speaker = "Storyteller"
      Event = "Outro_PostTrueEnding01.VoiceLines"
    }
    {
      Id = "Storyteller_0484"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sang Putri sama sekali tak kembali ke Istana Zeus; setidaknya tidak di malam ini. Dan ia pun tak terlalu keberatan, sebab udara dan cahaya di atas sana memang tak begitu cocok dengan seleranya."
      Speaker = "Storyteller"
      Event = "Outro_PostTrueEnding01_B.VoiceLines"
    }
    {
      Id = "Storyteller_0485"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sekali lagi sang Putri Dunia Bawah yang perkasa memastikan waktu mengalir bebas ke depan; dan dengan melakukan itu, ia menumpas sisa-sisa keji dari musuhnya."
      Speaker = "Storyteller"
      Event = "Outro_PostTrueEnding02.VoiceLines"
    }
    {
      Id = "Storyteller_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tugas itu sendiri sungguh menguras tenaga, harus menyeberang ke kemungkinan-kemungkinan lain di luar realitas tunggal yang kita ketahui. Maka sang Putri pun kini siap untuk tidur siang."
      Speaker = "Storyteller"
      Event = "Outro_PostTrueEnding02.VoiceLines"
    }
    {
      Id = "Storyteller_0487"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wujud semu dari Typhon yang mengerikan telah dihancurkan, namun agaknya tiada yang mengetahuinya, selain sang Putri Kematian dan kakeknya, Sang Waktu. Serta kau, dan aku, dan siapa pun yang mendengarkan kisahku ini, kurasa..."
      Speaker = "Storyteller"
      Event = "Outro_PostTrueEnding_Surface01.VoiceLines"
    }
    {
      Id = "Storyteller_0488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Satu-satunya Waktu yang kita alami adalah saat ini. Kita berutang budi kepada sang Putri Kematian, berkat segala usahanya yang tak kenal lelah, seperti apa yang terjadi pada malam ini."
      Speaker = "Storyteller"
      Event = "Outro_PostTrueEnding03.VoiceLines"
    }
    {
      Id = "Storyteller_0528"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sedikit kisah yang diceritakan tentang Hades, terutama saat dia terbelenggu rantai, di Tartarus... seorang tawanan Sang Waktu, bukan lagi penguasa Underworld."
      Speaker = "Storyteller"
      Event = "Outro_StoryReset01.VoiceLines"
    }
    {
      Id = "Storyteller_0530"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Satu-satunya penyelamat baginya, dan bagi kita semua, adalah sang Putri Kematian yang perkasa. Dia akhirnya menghadapi kedua musuh besarnya..."
      Speaker = "Storyteller"
      Event = "Outro_StoryReset01.VoiceLines"
    }
    {
      Id = "Storyteller_0531"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...Chronos yang penuh muslihat, sang Titan Waktu; dan Typhon yang raksasa, Ayah Segala Monster — dihadapi, namun belum ada satu pun yang ditundukkan. Setidaknya belum."
      Speaker = "Storyteller"
      Event = "Outro_StoryReset01.VoiceLines"
    }
    {
      Id = "Storyteller_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tentu saja sejak saat itu sang Putri Underworld membinasakan Chronos yang terkutuk itu sehabis-habisnya, memulihkan kedamaian di mana pun ia sirna, lalu hidup bahagia selamanya?"
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd13.VoiceLines"
    }
    {
      Id = "Storyteller_0183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sang Putri yang penuh dendam dan sang Titan yang keji bertarung tiada henti. Hingga akhirnya sang Titan, saat sang Putri berada dalam cengkeramannya, memanfaatkan kesempatan itu untuk berpidato... dan saat itulah sang Putri menebas nyawanya."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Titan.VoiceLines"
    }
    {
      Id = "Storyteller_0226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dan apa gerangan yang ditemukan sang Putri di dalam ruangan sederhana di bekas Kediaman ayahnya itu? Hanyalah gulungan dinding yang menggoda, atau meja permainan yang sudah lama tak terjamah? Yah... pada akhirnya kita akan mengetahuinya..."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Mystery.VoiceLines"
    }
    {
      Id = "Storyteller_0227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tepat saat sang Putri melangkah pergi dengan angkuh, sesuatu mulai bergerak pelan di belakangnya... apakah itu sang Titan Chronos, dengan sabit di tangannya?! Demi para dewa, Melinoë, awas!"
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Horror.VoiceLines"
    }
    {
      Id = "Storyteller_0228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Satu kemenangan lagi, namun, lawan seperti Waktu terbukti benar-benar keras kepala. Andai aku sendiri adalah Sang Waktu, wah, aku tinggal memutar balik jam matahari, jika memang bisa, agar malam ini tak pernah terjadi."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Adversary.VoiceLines"
    }
    {
      Id = "Storyteller_0229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Setelah menuntaskan perseteruan berdarah keluarganya, kini nyaris tiada yang bisa dilakukan sang Putri, selain menyudahi malam ini; dan di malam berikutnya, kembali melanjutkan dendam berdarah yang berkobar lagi."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Feud.VoiceLines"
    }
    {
      Id = "Storyteller_0231"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kini kembali ke rumahnya yang telah lama ditinggalkan, Melinoë yang tangguh menemukan terlalu banyak hal yang memancing rasa penasaran; penyebab utama kematian bagi kucing, dan dia menyukai kucing, jadi dia memilih untuk berhati-hati dan menahan diri."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Home.VoiceLines"
    }
    {
      Id = "Storyteller_0232"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Apa yang akan terjadi pada kita jika Waktu benar-benar dapat dihentikan... dihancurkan sepenuhnya? Terus terang, memikirkannya saja sudah membuat risi, jadi sebaiknya kita tak usah memusingkan hal-hal seperti itu."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Unpleasant.VoiceLines"
    }
    {
      Id = "Storyteller_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Maka dari itu, kelicikan Chronos tak pernah terdengar lagi, dan Melinoë muda beserta seluruh rekannya hidup bahagia selamanya. {#Prev}Ataukah benarkah demikian...?"
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Chronos.VoiceLines"
    }
    {
      Id = "Storyteller_0466"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Waktu itu sendiri adalah musuh setiap manusia fana; bahkan musuh bagi beberapa makhluk abadi pula. Jadi marilah kita bersyukur bahwa sang Putri Kematian telah mencekiknya sekali lagi."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Immortals.VoiceLines"
    }
    {
      Id = "Storyteller_0320"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Malam berganti malam, satu lagi monster bergelombang raksasa bertekuk lutut; dan bagi sang Putri Kematian, kemenangan semacam ini patut dinikmati. Namun hanya untuk sejenak."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Typhon02.VoiceLines"
    }
    {
      Id = "Storyteller_0321"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Usai pertarungan sengit melawan biang segala monster, sang Putri Kematian masih tegak berdiri, sementara sang monster terkulai tak berdaya. Namun karena hari kian larut, sang Putri yang mengantuk merasa sudah saatnya ia beristirahat malam ini."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Typhon03.VoiceLines"
    }
    {
      Id = "Storyteller_0322"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dunia ini dipenuhi monster, besar maupun kecil. Dan sebagian besarnya bukanlah tak bisa dihentikan, terbukti oleh Putri Kematian kita yang berwatak kelam, yang karenanya memutuskan untuk rehat sejenak."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Typhon04.VoiceLines"
    }
    {
      Id = "Storyteller_0323"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sangatlah wajar untuk bertanya-tanya, kini setelah Putri Underworld kita berhasil menahan murka mengerikan dari Ayah Segala Monster, apa berikutnya? Jadi silakan, teruslah bertanya-tanya."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Typhon05.VoiceLines"
    }
    {
      Id = "Storyteller_0324"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Banyak hal yang dibutuhkan untuk menundukkan sang leluhur angkuh nan murka dari segala kebuasan di dunia ini: keberanian, kekuatan, ketangkasan, latihan seumur hidup dari seorang penyihir hebat; bahkan mungkin secuil Takdir. Setidaknya malam ini, sang Putri memiliki segalanya."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Typhon06.VoiceLines"
    }
    {
      Id = "Storyteller_0325"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Di balik tebing curam yang terkepung itu, sang Putri Kematian menemukan segala kemegahan yang tersohor dari Gunung Olympus... dan dia turut menikmatinya, termasuk perjalanan kilat kembali ke kediamannya yang lebih bersahaja."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Typhon07.VoiceLines"
    }
    {
      Id = "Storyteller_0326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Di atas gunung para dewa, panca indra manusia fana pastilah akan kewalahan; jadi jika kau kini tak mampu melihat, mendengar, mencium, menyentuh, atau mengecapnya, itu tentulah yang terbaik."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Typhon08.VoiceLines"
    }
    {
      Id = "Storyteller_0327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Jika seseorang berasal dari Underworld, bertarung di ketinggian yang luar biasa amatlah tidak dianjurkan. Pasti ada pendekatan lain yang lebih membumi."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Typhon09.VoiceLines"
    }
    {
      Id = "Storyteller_0328"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Butuh waktu nyaris semalaman bagi sang Putri Kematian yang gigih untuk memanjat ke puncak tertinggi Olympus. Namun seperti yang sering terjadi, perjalanan pulangnya berlalu dalam sekejap mata."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Typhon10.VoiceLines"
    }
    {
      Id = "Storyteller_0284"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Puncak Olympus tampak begitu dekat, namun... sekeras apa pun usahanya, sang Putri penjelajah permukaan tak dapat memanjat lebih dekat lagi untuk saat ini. Walau tak ada salahnya untuk mencoba."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Olympus01.VoiceLines"
    }
    {
      Id = "Storyteller_0251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Begitu penyihir tangguh Melinoë berhasil mengatasi semua musuh yang menghadang antara dirinya dan puncak Olympus, suatu peristiwa yang luar biasa pun terjadi! Namun semua yang hadir di sana telah bersumpah untuk tutup mulut."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Foes.VoiceLines"
    }
    {
      Id = "Storyteller_0252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Puncak Olympus adalah tempat yang sakral sekaligus berbahaya. Maka sang Putri Underworld, yang tak terbiasa dengan medan setinggi itu, memutuskan untuk menempuh etape terakhir perjalanannya dengan sangat, sangat perlahan..."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Precarious.VoiceLines"
    }
    {
      Id = "Storyteller_0253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pemandangan yang begitu tak terbayangkan menanti sang Putri penjelajah permukaan saat dia mendaki ketinggian Gunung Olympus, sehingga bagi akal dan indra fana kita, yah... pemandangan itu sungguh tak terlukiskan dengan kata-kata."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Unimaginable.VoiceLines"
    }
    {
      Id = "Storyteller_0254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dari puncak Olympus, Melinoë sang penyihir pembantai Titan memandang dunia yang diklaim oleh para dewa; dan dia memutuskan bahwa dunia berharga tempat kita bernaung bersama ini sudah sempurna, apa adanya."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Summit.VoiceLines"
    }
    {
      Id = "Storyteller_0463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Setelah menaklukkan kekejian bernama Typhon itu untuk kesekian kalinya, sang Putri Kematian melangkah mundur sejenak untuk berpesta pora bersama Dionysus yang riang gembira, namun ia sama sekali tak mengingat kejadian itu."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Dionysus.VoiceLines"
    }
    {
      Id = "Storyteller_0464"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Konon katanya Ayah Segala Monster memiliki sulur tubuh meliuk-liuk dan mata mengintai yang tak terhitung jumlahnya; jadi jika sang Putri Kematian memenggal beberapa di antaranya malam ini, mungkin itu bukanlah perkara besar."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Countless.VoiceLines"
    }
    {
      Id = "Storyteller_0465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sekali lagi sang Putri penentang Takdir menantang marabahaya di gunung para dewa, dan berdiri penuh keangkuhan di puncaknya yang tertinggi; namun kemudian saat itu berlalu, \n {#Emph}dan dia pun menyudahi malam ini."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Dangers.VoiceLines"
    }
    {
      Id = "Storyteller_0467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Putri Melinoë yang secepat kilat menumpas musuh besarnya malam ini begitu gesit, hingga Waktu itu sendiri seolah berpihak kepadanya. Namun mungkinkah hal itu terjadi, benarkah demikian?"
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Frightful.VoiceLines"
    }
    {
      Id = "Storyteller_0255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ketika Melinoë sang pembawa obor mendaki gunung para dewa, dia tersadar bahwa hatinya tertinggal di Crossroads, tempat yang disebutnya rumah; dan oleh karenanya ia memutuskan untuk kembali dan mengambilnya."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Heart.VoiceLines"
    }
    {
      Id = "Storyteller_0256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Melinoë sang pengelana malam kini telah menjelajah teramat jauh, menuntaskan tujuannya semampu yang ia bisa. Anehnya, perjalanan pulangnya benar-benar tidak memakan waktu sama sekali."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Goal.VoiceLines"
    }
    {
      Id = "Storyteller_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Melinoë, sang penjaga Underworld, tempatnya bukanlah di ketinggian permukaan sana, melainkan di bawah. Maka setelah membereskan urusan keluarga malam ini, dia lenyap sebelum fajar menyingsing."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Guardian.VoiceLines"
    }
    {
      Id = "Storyteller_0258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Maka dari itu, di bawah pengawasan Mata Malam, Melinoë yang tak kasatmata mencapai puncak tertinggi Gunung Olympus, tempat pesta pora terjadi sedemikian rupa hingga rentetan peristiwa berikutnya malam ini masih agak kabur."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Night.VoiceLines"
    }
    {
      Id = "Storyteller_0286"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Begitu dahsyatnya bentrokan yang kemudian berkecamuk di puncak Olympus hingga aku tak sanggup menemukan kata-kata untuk mengungkapkannya. Walau aku berniat merangkainya... sesegera mungkin."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Olympus02.VoiceLines"
    }
    {
      Id = "Storyteller_0287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bayangkan jika kau mengetahui segala hal yang akan terjadi, persis seperti yang dapat dilakukan Titan Penglihatan Masa Depan yang perkasa. Di antara sekian banyak manfaat yang patut dipertanyakan itu, kau takkan perlu mendengarkanku menceritakan apa yang terjadi selanjutnya."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Foresight01.VoiceLines"
    }
    {
      Id = "Storyteller_0292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Di baliknya terbentang Istana Zeus, benteng para dewa, dalam segala keagungannya yang menakjubkan. Namun, tempat itu sedang direnovasi saat ini... jadi membayangkan aula-aula megah nan mewah itu cukuplah untuk sementara waktu."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Palace01.VoiceLines"
    }
    {
      Id = "Storyteller_0088"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Begitu banyaknya cobaan berat yang dihadapi Melinoë yang perkasa hingga orang nyaris tak sanggup memahaminya; namun di suatu malam nanti, kita pasti akan memahaminya."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd01b.VoiceLines"
    }
    {
      Id = "Storyteller_0094"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dari bayangan sang penyihir tiada tanding Melinoë bangkit, dan ke dalam bayangan pula ia kembali, untuk saat ini. Kita akan melanjutkan kisahnya di lain waktu."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd07.VoiceLines"
    }
    {
      Id = "Storyteller_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Seseorang tentu boleh membayangkan bahwa kisah ini memiliki akhir yang sangat mendebarkan; meski kusayangkan untuk saat ini, kita telah kehabisan Waktu."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd10.VoiceLines"
    }
    {
      Id = "Storyteller_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Lalu apa yang terjadi pada Melinoë sang ahli sihir, kau bertanya? Hal ini pastilah akan kuceritakan padamu, andai aku bisa. Sungguh disayangkan, untuk saat ini, aku tak sanggup."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd04.VoiceLines"
    }
    {
      Id = "Storyteller_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dari segala pencapaian hebat yang diraih manusia fana maupun para dewa, sang Putri pembawa mimpi buruk mungkin akan mencapai yang paling agung dari semuanya. Hanya saja, aku belum bisa menceritakannya kepadamu sekarang..."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd06.VoiceLines"
    }
    {
      Id = "Storyteller_0095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Begitu tiada tandingnya kisah sang Putri Underworld hingga, wah, aku bahkan tak mampu merangkai kata-katanya. Meski demikian, demi para dewa, pada akhirnya pasti akan kutemukan!"
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd08.VoiceLines"
    }
    {
      Id = "Storyteller_0096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Murka yang membara dari Melinoë sang penyihir bertempaan api sedemikian hebatnya, sehingga menggambarkan bagaimana ia menghadapi mangsa yang tersisa justru akan sangat mengurangi daya tarik kisah ini..."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd09.VoiceLines"
    }
    {
      Id = "Storyteller_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dengan kemenangan di depan mata, sang Putri Kematian yang tersohor itu meraih ambisi hidupnya, dan hidup bahagia sejak saat itu untuk selama-lamanya... setidaknya begitulah yang kupilih untuk kupercayai?"
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd12.VoiceLines"
    }
    {
      Id = "Storyteller_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sejak saat itu, segala jerih payah dan kerja keras yang dicurahkan oleh Melinoë yang tekun berbuah menjadi ganjaran yang setimpal; kehidupan penuh kesenangan dan kemewahan, mungkin saja! Karena apalah arti hidup jika tidak sepenuhnya adil?"
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd14.VoiceLines"
    }
    {
      Id = "Storyteller_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tentu saja akhir yang menyenangkan dari suatu kisah sedang menanti, bukan? Barangkali sang Putri diundang ke pesta dansa kerajaan, dan di sana ia bertemu dengan pujaan hatinya, sembari berdansa diiringi alunan lagu yang merdu..."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd15.VoiceLines"
    }
    {
      Id = "Storyteller_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dan setelah semua hal itu, sang Putri Kematian beserta segenap dewa-dewi di atas permukaan maupun di bawah sana mengesampingkan perselisihan mereka, lalu hidup tenteram sejak saat itu."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Gods.VoiceLines"
    }
    {
      Id = "Storyteller_0162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Demikianlah Melinoë yang muda dan bersemangat menemukan cinta sejatinya: olahraga yang dikenal sebagai lempar cakram. Dan walau ia tak memenangkan kejuaraan, ia berhasil memenangkan hati kita."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Love.VoiceLines"
    }
    {
      Id = "Storyteller_0164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dengan pasukan musuhnya luluh lantak di bawah kaki apinya, Putri Melinoë memutuskan untuk kembali ke tempat asalnya, karena ia selalu bisa memporak-porandakan mereka lebih parah lagi di malam yang lain."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Fiery.VoiceLines"
    }
    {
      Id = "Storyteller_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Baru setelah semua itu berlalu, Melinoë yang biasanya begitu rajin tersadar bahwa ada sesuatu yang tertinggal di rumah. Kuncinya ketinggalan! Maka dia berbalik ke arah kegelapan dan berkata..."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Forgot.VoiceLines"
    }
    {
      Id = "Storyteller_0180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Begitu nyata mimpi buruk yang menyiksa sang Putri Kematian hingga ia teramat terkejut mendapati bahwa itu semua hanyalah mimpi! Semata mimpi belaka, yang mana ia akan segera terbangun dari sana sebentar lagi..."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Dream.VoiceLines"
    }
    {
      Id = "Storyteller_0181"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sang Putri Kegelapan selalu merasakan ikatan yang kuat dengan orang mati, namun tak pernah benar-benar tahu alasannya. Hingga akhirnya ia menyadari bahwa dirinya sendiri telah mati, dan memang telah tiada, selama ini..."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Dead.VoiceLines"
    }
    {
      Id = "Storyteller_0182"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Maka usai menuntaskan hasrat hatinya, sang Putri merasakan sukacita yang begitu meluap hingga ia menari-nari riang. Dan begitu menularnya perayaan ini sampai-sampai kawan maupun lawannya lekas ikut serta."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Dance.VoiceLines"
    }
    {
      Id = "Storyteller_0184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dan semenjak saat itu, para penghuni dunia atas dan Bawah Tanah berikhtiar hidup dalam damai dan tenteram, menyadari bahwa hanya dengan bersatulah mereka dapat menjadikan dunia tempat yang lebih baik."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Peace.VoiceLines"
    }
    {
      Id = "Storyteller_0185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Itulah kabar terakhir yang pernah kita dengar tentang sang Putri. Kisahnya memang terlupakan, itu benar. Namun andai bukan karena pengorbanan besarnya, tak seorang pun dari kita akan ada di sini sekarang, bukan?"
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Forgotten.VoiceLines"
    }
    {
      Id = "Storyteller_0186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Begitu jauh di luar nalar rentetan peristiwa yang terjadi selanjutnya, hingga menuangkannya ke dalam kata-kata adalah kebodohan yang bahkan tak layak untuk dicoba."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Reasoning.VoiceLines"
    }
    {
      Id = "Storyteller_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Peristiwa-peristiwa berikutnya diselimuti ketidakpastian; tema kisahnya sama kelabunya dengan latar tempatnya. Apakah sang Putri benar-benar menemukan apa yang ia cari masih terus diperdebatkan hingga kini."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Ambiguity.VoiceLines"
    }
    {
      Id = "Storyteller_0230"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bayangkanlah kini sebuah kisah dengan cakupan yang begitu megah, hingga kesimpulan dari seluruh perkara ini tak kunjung ditemukan. Karena setiap kali sang pahlawan wanita menaklukkan rintangan besar, rintangan lain yang sedikit berbeda telah menanti."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Epic.VoiceLines"
    }
    {
      Id = "Storyteller_0288"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Apa yang disimpan oleh masa depan? Hanya sang Tiga Takdir dan mungkin Prometeus sang Titan Pandangan Masa Depan yang tahu pasti. Sayangnya, mereka semua sedang agak berhalangan saat ini."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Future01.VoiceLines"
    }
    {
      Id = "Storyteller_0293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Masa depan memang tak pasti, namun satu hal yang pasti adalah: Waktu terus berderap maju, kerap kali lebih cepat dari dugaan siapa pun, hingga kita mendapati diri kita di mana pun Takdir menghendaki... yang mana dalam kasus sang Putri Kematian, persis di tempat ini..."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Future02.VoiceLines"
    }
    {
      Id = "Storyteller_0289"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Usai menuntaskan pencapaian yang sungguh monumental, sang Putri Kematian yang senantiasa rendah hati memohon dengan hormat agar tak ada bualan maupun kisah berlebihan mengenai hasil akhirnya; sekadar pengakuan singkat belaka, seperti ini."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Modesty.VoiceLines"
    }
    {
      Id = "Storyteller_0290"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Lagi-lagi Putri Melinoë keluar sebagai pemenang dalam konfrontasi puncaknya, dan lagi-lagi, aku takkan menceritakan apa yang terjadi selanjutnya; sebab aku terikat Sumpah untuk tak bertutur lagi."
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_Oath.VoiceLines"
    }
    {
      Id = "Storyteller_0291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Barangkali setelah titik ini Tiga Takdir mendadak muncul dan berujar, {#Prev}Kerja bagus, Melinoë! Namun biar kami yang mengurus semuanya sekarang. {#Emph}Lalu mereka benar-benar melakukannya. Betapa membahagiakannya akhir cerita semacam itu!"
      Speaker = "Storyteller"
      Event = "Outro_EarlyEnd_DeusExMachina.VoiceLines"
    }
    {
      Id = "Storyteller_0500"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Begitu banyak kemungkinan berbeda di mana sang Putri Kematian menang ataupun gagal... dan ini hanyalah salah satunya. Tentu saja, tiada dua kemungkinan yang benar-benar serupa; tak pernah terjadi sebelumnya, dan takkan pernah terulang kembali..."
      Speaker = "Storyteller"
      Event = "Outro_PostTrueEnding_Loop01.VoiceLines"
    }
  ]
}
