    }
    {
      Id = "MelinoeField_5552"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Olympus baru permulaannya, rupanya..."
      Speaker = "Melinoe"
      Event = "HeroData.HeroVoiceLines.DreamBiomeStartVoiceLines"
    }
    {
      Id = "MelinoeField_5553"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memulai dari tempat setinggi ini...?"
