    }
    {
      Id = "Heracles_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau butuh teman ngobrol, nasibmu bakal lebih mujur sama si Tukang Perahu itu."
      Speaker = "Heracles"
      Event = "HeraclesMiscChat01"
    }
    {
      Id = "Heracles_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Simpan saja bicaramu untuk orang yang peduli, Saudari."
      Speaker = "Heracles"
      Event = "HeraclesMiscChat05"
    }
    {
      Id = "Heracles_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa tampangku kelihatan seperti orang yang mau diajak ngobrol?"
      Speaker = "Heracles"
      Event = "HeraclesMiscChat07"
    }
    {
      Id = "Heracles_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Urgh. {#Prev}Gara-gara kau hitungan koin sialanku jadi buyar."
      Speaker = "Heracles"
      Event = "HeraclesMiscChat08"
    }
    {
      Id = "Heracles_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rupanya si Tukang Perahu itu sama sekali tidak bisa diajak tawar-menawar."
      Speaker = "Heracles"
      Event = "HeraclesMiscChat09"
    }
    {
      Id = "Heracles_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan sapaan saja tidak ada darinya untuk pelanggan tetap seperti kita."
      Speaker = "Heracles"
      Event = "HeraclesMiscChat10"
    }
    {
      Id = "Heracles_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau rupanya. Mau masuk atau pergi sekalian, terserah."
      Speaker = "Heracles"
      Event = "HeraclesHotSpringsChat01"
    }
    {
      Id = "Heracles_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan takut, saudari. Di sini kita sedang beristirahat, bukan bekerja."
      Speaker = "Heracles"
      Event = "HeraclesHotSpringsChat02"
    }
    {
      Id = "Heracles_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu saling bunuh untuk saat ini, saudari..."
      Speaker = "Heracles"
      Event = "HeraclesHotSpringsChat03"
    }
    {
      Id = "Heracles_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah berapa lama sejak air ini terakhir kali disucikan...?"
      Speaker = "Heracles"
      Event = "HeraclesHotSpringsChat04"
    }
    {
      Id = "Heracles_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat dewa anggur, kau kedatangan tamu lain..."
      Speaker = "Heracles"
      Event = "HeraclesHotSpringsChat05"
    }
    {
      Id = "Heracles_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sentuh aku lagi, Satir, dan demi para dewa akan kubuat kau... {#Emph}urgh..."
      Speaker = "Heracles"
      Event = "HeraclesHotSpringsChat06"
    }
    {
      Id = "Heracles_0152"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para dewa pun punya harga tersendiri."
