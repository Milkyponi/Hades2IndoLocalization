{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Heracles.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "MelinoeField_0718"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga para dewa mengawasi kita."
      Speaker = "Melinoe"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_0717"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tetaplah kuat, Putra Zeus."
      Speaker = "Melinoe"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Penyihir..."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hm."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hm."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mm."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0425"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa?"
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0424"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak akan."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0426"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak perlu."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu jalanku."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0428"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan bawa-bawa aku."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menuju apa?"
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan panggil aku begitu lagi."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.InteractVoiceLines"
    }
    {
      Id = "Heracles_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bala bantuannya? Hah, lelucon bagus. Nasihat ramah dariku, {#Emph}saudari: {#Prev}Jangan halangi jalanku, atau kau bakal celaka. Sekarang enyah, dan beri tahu siapa pun yang mengirimmu bahwa aku bekerja sendiri."
      Speaker = "Heracles"
      Event = "HeraclesFirstMeeting"
    }
    {
      Id = "MelinoeField_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ancamanmu sudah kucatat baik-baik, Putra Zeus. Aku hendak menuju dermaga, tapi kudengar kota ini disegel rapat."
      Speaker = "Melinoe"
      Event = "HeraclesFirstMeeting"
    }
    {
      Id = "Heracles_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu kau paham seharusnya kau balik badan. Kota ini sudah {#Emph}mati{#Prev}, dan takkan membiarkan yang hidup lewat."
      Speaker = "Heracles"
      Event = "HeraclesFirstMeeting"
    }
    {
      Id = "MelinoeField_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku Putri Hades; mereka yang mati harus tunduk padaku. Mungkin mereka cuma butuh sedikit dorongan."
      Speaker = "Melinoe"
      Event = "HeraclesFirstMeeting"
    }
    {
      Id = "Heracles_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba saja sesukamu. Tapi ingat, kau sudah kuperingatkan."
      Speaker = "Heracles"
      Event = "HeraclesFirstMeeting"
    }
    {
      Id = "Heracles_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau. Segalanya bakal berantakan sebentar lagi, dan aku tak butuh bantuan ataupun saksi mata, saudari."
      Speaker = "Heracles"
      Event = "HeraclesCombat01"
    }
    {
      Id = "MelinoeField_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma numpang lewat. Dan aku takkan pergi dari sini sampai para pengkhianat Wangsa Hades terkapar hancur di kaki kita."
      Speaker = "Melinoe"
      Event = "HeraclesCombat01"
    }
    {
      Id = "Heracles_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Baguslah kalau begitu. Kita ambil bagian masing-masing. Walau bagian terbesar jelas milikku."
      Speaker = "Heracles"
      Event = "HeraclesCombat01"
    }
    {
      Id = "Heracles_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahan, saudari. Ingat, jangan ungkit soal yang tadi, atau tanggung akibatnya. Kita bisa lanjut membantai bersama lalu pergi ke urusan masing-masing."
      Speaker = "Heracles"
      Event = "HeraclesPreEncounterAboutAltFight01"
    }
    {
      Id = "MelinoeField_3762"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan mungkin kita bisa bertemu lagi saat aku menuju puncak, kalau situasinya memungkinkan. Bukankah menyenangkan?"
      Speaker = "Melinoe"
      Event = "HeraclesPreEncounterAboutAltFight01"
    }
    {
      Id = "Heracles_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jelas sekali. Berarti kita sepaham. Sekarang, mari kita mulai pertumpahan darah ini."
      Speaker = "Heracles"
      Event = "HeraclesPreEncounterAboutAltFight01"
    }
    {
      Id = "Heracles_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira tadi dewi perburuan yang mengendap-endap di jalanan ini. Coba kita lihat apa kau bisa menghabisi sasaran selihai dia."
      Speaker = "Heracles"
      Event = "HeraclesPreEncounterAboutArtemis01"
    }
    {
      Id = "Heracles_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukannya kapak itu kebesaran untukmu, saudari? Tapi kuapresiasi usahamu. Kita lihat saja apa kau bisa mengayunkannya dengan benar."
      Speaker = "Heracles"
      Event = "HeraclesPreEncounterAboutAxe01"
    }
    {
      Id = "Heracles_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memegang sabit yang mirip sekali dengan kepunyaan Sang Maut sendiri. Di sini, kitalah yang harus menggantikan perannya."
      Speaker = "Heracles"
      Event = "HeraclesPreEncounterAboutThanatosAspect01"
    }
    {
      Id = "Heracles_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jarang-jarang aku iri pada senjata orang lain, tapi yang kau punya itu sungguh mahakarya. Tunjukkan padaku apa yang bisa diperbuatnya."
      Speaker = "Heracles"
      Event = "HeraclesPreEncounterAboutNergalAspect01"
    }
    {
      Id = "Heracles_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kabar kemenanganmu, tapi aku tahu ini belum selesai. Selalu ada yang harus dibereskan. Ayo, bergerak."
      Speaker = "Heracles"
      Event = "HeraclesPreEncounterAboutTrueEnding01"
    }
    {
      Id = "Heracles_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat siapa yang akhirnya menampakkan batang hidungnya lagi. Kalau kau mau cari koin tambahan, aku punya tawaran pas buatmu."
      Speaker = "Heracles"
      Event = "HeraclesPreEncounterAboutTimePassing01"
    }
    {
      Id = "Heracles_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sedang bekerja di sini, saudari. Kalau mau ikut bantu, silakan, tapi jangan menghalangi jalanku."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart01"
    }
    {
      Id = "Heracles_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukannya aku tak mau {#Emph}mengobrol{#Prev}, tapi aku sedang bertugas. Lebih baik segera mulai bekerja."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart03"
    }
    {
      Id = "Heracles_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya kau haus darah. Kemarilah dan puaskan dahagamu."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart04"
    }
    {
      Id = "Heracles_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan cuma berdiri di situ, saudari; ada perang yang harus kita kobarkan di sini."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart05"
    }
    {
      Id = "Heracles_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nikmatilah keheningan ini, saudari. Sebentar lagi kita bakal kedatangan tamu."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart06"
    }
    {
      Id = "Heracles_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau mau istirahat dari pembantaian ini, mundur saja. Mundur yang {#Emph}jauh{#Prev}."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart07"
    }
    {
      Id = "Heracles_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa pasti ingin kita menyajikan pertunjukan megah lainnya, ya?"
      Speaker = "Heracles"
      Event = "HeraclesMiscStart08"
    }
    {
      Id = "Heracles_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngapain juga aku bicara denganmu, saudari? Simpan saja napasmu, aku pun demikian."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart10"
    }
    {
      Id = "Heracles_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kita saling mengenal, kau pasti akan menyesalinya seumur hidup. Selalu begitu ujungnya."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart11"
    }
    {
      Id = "Heracles_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kusarankan untuk selalu menjaga jarak dariku, penyihir."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart13"
    }
    {
      Id = "Heracles_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian para dewa-dewi keparat semuanya sama saja..."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart14"
    }
    {
      Id = "Heracles_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Urus urusanmu sendiri, saudari. Aku sedang bertugas."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart16"
    }
    {
      Id = "Heracles_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapal ini bakal kembali ke dasar laut, ada atau tidak adanya dirimu di sini."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart17"
    }
    {
      Id = "Heracles_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ombak ganas di depan, saudari. Kalau sampai tercebur, aku tak sudi menyelam untuk menarikmu keluar."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart18"
    }
    {
      Id = "Heracles_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada penumpang gelap lain di kapal. Padahal kupikir cuma aku seorang."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart19"
    }
    {
      Id = "Heracles_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lautan sudah menelan awak kapal ini sekali, dan kini lautan akan menelan mereka lagi."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart20"
    }
    {
      Id = "Heracles_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapal ini berantakan sekali, tapi biar kubersihkan dulu geladaknya, kalau kau mau minggir."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart21"
    }
    {
      Id = "Heracles_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebetulan sekali, aku sendiri memang baru mau menuju ke gunung para dewa."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart22"
    }
    {
      Id = "Heracles_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya ingin kuhancurkan kapal ini jadi serpihan kayu, tapi nanti kita terpaksa harus berenang."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart23"
    }
    {
      Id = "Heracles_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuklaim kapal ini atas nama para dewa, walau kau ini salah satu dari mereka, bukan?"
      Speaker = "Heracles"
      Event = "HeraclesMiscStart24"
    }
    {
      Id = "Heracles_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ruang gerak di sini sempit, jadi sebaiknya menjauhlah dari pentunganku."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart25"
    }
    {
      Id = "Heracles_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kegelapan perairan ini mendatangkan ketenangan tersendiri, bukan begitu, saudari?"
      Speaker = "Heracles"
      Event = "HeraclesMiscStart26"
    }
    {
      Id = "Heracles_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergilah ke tempat lain. Pertahanan gunung sialan ini sudah terlalu tipis."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart27"
    }
    {
      Id = "Heracles_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa butuh semua bantuan yang bisa dikerahkan, itulah kenapa kita berdua ada di sini."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart28"
    }
    {
      Id = "Heracles_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah. Aku mulai merasa kesepian harus memikul semua beban pekerjaan ini sendirian..."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart29"
    }
    {
      Id = "Heracles_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kusarankan kau menyingkir sebelum ikut dipukul mundur dari gunung ini seperti yang lainnya."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart30"
    }
    {
      Id = "Heracles_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini semua orang ingin menguasai Olympus, ya. Tapi gunung ini tak semudah itu direbut."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart32"
    }
    {
      Id = "Heracles_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebaiknya perhatikan langkahmu di tengah es dan salju ini. Jangan sampai kau terpeleset."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart34"
    }
    {
      Id = "Heracles_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa lagi yang lebih agung daripada meremukkan para Satyr ke tanah yang membeku?"
      Speaker = "Heracles"
      Event = "HeraclesMiscStart35"
    }
    {
      Id = "Heracles_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yang sampai duluan di sini, saudari. Cari sendiri Harpy dan mangsa lain untuk kau bantai."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart36"
    }
    {
      Id = "Heracles_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini cuma pemanasan untuk apa yang akan terjadi nanti malam, bukan begitu, saudari?"
      Speaker = "Heracles"
      Event = "HeraclesMiscStart37"
    }
    {
      Id = "Heracles_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan menahan seranganku kalau kau sampai menghalangi jalanku di sini, tapi di puncak nanti? Jangan harap."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart38"
    }
    {
      Id = "Heracles_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebentar lagi kau harus menghadapi diriku dan si Pencuri Api lagi, tapi mari kita teruskan sandiwara ini untuk sekarang."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart39"
    }
    {
      Id = "Heracles_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan mulai membantai apa pun yang bergerak, selain dirimu dan hewan peliharaanmu."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart40"
    }
    {
      Id = "Heracles_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pujian hanya untuk pembantai paling efisien; siapa yang bekerja, dia yang dapat upah koinnya."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart41"
    }
    {
      Id = "Heracles_0638"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah terlalu lama sejak terakhir kali kita membantai semua yang bergerak di sekitar tempat ini."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart42"
    }
    {
      Id = "Heracles_0639"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selagi kau menelusuri katakombe ayahmu, semua kejayaan ini kunikmati sendiri."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart43"
    }
    {
      Id = "Heracles_0641"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita mulai terbiasa melenyapkan nyawa dari apa pun yang bergerak."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart44"
    }
    {
      Id = "Heracles_0643"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terluka dan berdarah, jadi sebaiknya mundur saja dan biarkan semua kejayaan ini jadi milikku."
      Speaker = "Heracles"
      Event = "HeraclesMiscStart45"
    }
    {
      Id = "Heracles_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau masih hidup. Berkat kebaikanku memang, tapi... baru kali ini kulihat ada yang berani melawan sampah-sampah yang menguasai kota terkutuk ini."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutEphyra01"
    }
    {
      Id = "MelinoeField_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tujuanku adalah membasmi kekotoran ini hingga ke akarnya. Dia bersemayam jauh di kedalaman Bawah Tanah, meski ada urusan yang harus kuselesaikan di Olympus terlebih dahulu."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutEphyra01"
    }
    {
      Id = "Heracles_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebetulan sekali! Aku baru saja kembali dari sana belum lama ini. Jadi para dewa sedang menyusun semua bidak mereka.... Jaga dirimu baik-baik, Saudariku."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutEphyra01"
    }
    {
      Id = "Heracles_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu siapa kalian sebenarnya. Dasar para penyihir sialan. Satu kata asing saja... satu gestur jari mengancam diarahkan padaku... akan kuremas kau sampai remuk."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutWitches01"
    }
    {
      Id = "MelinoeField_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu sama sekali tidak perlu... meski aku penasaran bagaimana kau bisa membenci kami, para {#Emph}penyihir sialan {#Prev}ini? Sudah berapa banyak yang kau temui?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutWitches01"
    }
    {
      Id = "Heracles_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dua pertanyaan, terlalu banyak. Semakin banyak yang kau tahu, semakin lihai kau memanipulasi. Sekarang, pergilah."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutWitches01"
    }
    {
      Id = "MelinoeField_3765"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan, apa yang kau lakukan di tengah Celah Thessaly ini? Bagaimana caramu bisa sampai kemari? Walau kuakui, kau pasti perenang yang luar biasa tangguh."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutThessaly01"
    }
    {
      Id = "Heracles_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena kau menyinggungnya, aku memang mahir dalam berbagai macam olah fisik. Berenang, melompat, menghajar monster dengan gada."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutThessaly01"
    }
    {
      Id = "MelinoeField_3766"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi ini bagian dari rute patrolimu? Membayangkan perjalananku bisa saja jauh lebih penuh sesak oleh musuh jika bukan karenamu."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutThessaly01"
    }
    {
      Id = "Heracles_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak hal akan berbeda jika bukan karenaku. Meski kau salah satu dari segelintir orang yang akhir-akhir ini mau mengakuinya. Selamat berlayar, Saudariku."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutThessaly01"
    }
    {
      Id = "MelinoeField_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olympus sangat beruntung memiliki kekuatan dan baktimu, Putra Zeus."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutOlympus01"
    }
    {
      Id = "Heracles_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang melayani para dewa. Melayani mereka sekian lama, tugas mustahil demi tugas mustahil. Mereka memberiku ketenaran, kejayaan... {#Emph}segalanya. {#Prev}Mereka tak pernah puas memeras tenagaku."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutOlympus01"
    }
    {
      Id = "MelinoeField_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi {#Emph}kau {#Prev}sendiri sudah muak dengan {#Emph}mereka. {#Prev}Lalu... apa yang kau lakukan di sini?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutOlympus01"
    }
    {
      Id = "Heracles_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, riwayat kerjaku bisa membuktikan bahwa aku pun tak pernah puas dengan {#Emph}mereka{#Prev}. Ada tugas yang kuterima, aku selesaikan."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutOlympus01"
    }
    {
      Id = "Heracles_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang di gunung leluhurmu, Saudariku. Persis seperti impianmu? Dulu aku pun sangat mendambakan berada di sini. Tapi masa-masa itu sudah lewat."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutOlympus02"
    }
    {
      Id = "MelinoeField_3767"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun kau masih membela tempat ini. Kau bicara seolah sudah kehilangan tujuan, tapi aku pernah melihatmu bertarung."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutOlympus02"
    }
    {
      Id = "Heracles_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tujuan. {#Prev}Para dewa menuntut hal yang mustahil dariku sebelum aku diizinkan bergabung ke sini, hanya untuk disuruh membela kehormatan mereka lagi. Kau akan menemukan tujuanmu {#Emph}sendiri{#Prev}, tak lama lagi."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutOlympus02"
    }
    {
      Id = "Heracles_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau mendapat restunya, rupanya. Semudah itu, dia memberimu kekuatannya. Pengakuannya..."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutHera01"
    }
    {
      Id = "MelinoeField_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu Hera? Tentu saja; kita semua berada di kubu yang sama. Lebih dari itu, kita ini keluarga."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutHera01"
    }
    {
      Id = "Heracles_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Keluarga. {#Prev}Pantas saja Yang Mulia Ratu menaungi seluruh konsep tersebut. Pernikahan, kelahiran, dan tetek bengeknya. Semua itu kutukan, berkedok kebaikan."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutHera01"
    }
    {
      Id = "Heracles_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bertarung dari jarak dekat sekaligus jarak jauh. Kelihatannya tidak efisien. Pilih salah satu dan kuasai sepenuhnya. Tak usah banyak gaya."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutArtemis01"
    }
    {
      Id = "MelinoeField_3991"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seseorang bisa mahir di kedua bidang itu. Dewi Artemis mungkin lebih menyukai busurnya, tapi dia sama kejamnya denganmu dalam jarak dekat, percayalah padaku."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutArtemis01"
    }
    {
      Id = "Heracles_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernah sekali aku menangkap salah satu hewan hutan peliharaannya dan menerima ganjarannya secara langsung, jadi kau tak perlu meyakinkanku. Ya sudahlah. Kalau kau merasa sehebat dirinya, terserah padamu."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutArtemis01"
    }
    {
      Id = "Heracles_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar anjingmu itu jika dia masih berada di bawah tanah? Aku mulai menyukainya, jika bicara soal monster buas."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutCerberus01"
    }
    {
      Id = "MelinoeField_4020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu Cerberus? Aku tidak mengenalnya saat tumbuh dewasa tapi akhir-akhir ini cukup sering bertemu dengannya. Dia sangat aktif, dan keadaannya amat baik. Aku tak percaya dia tidak memenggal kepalamu kala itu..."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutCerberus01"
    }
    {
      Id = "Heracles_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, dia sudah mencoba. Memakai ketiga moncongnya sekaligus. Dan badannya {#Emph}berat {#Prev}sekali. Saat nanti kau mendaki Olympus lagi, bersyukurlah pada sang Takdir karena kau tidak perlu menggotong sang Anjing Neraka."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutCerberus01"
    }
    {
      Id = "Heracles_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti merasa cukup nyaman di atas sini. Negeri ini sudah hampir semuram tempat asalmu."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutUnderworld01"
    }
    {
      Id = "MelinoeField_4012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kau bisa tahu seluruh Dunia Bawah seperti apa? Tempat ini sangatlah berbeda. Mampirlah kapan-kapan dan lihat sendiri."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutUnderworld01"
    }
    {
      Id = "Heracles_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah kapok ke sana. Tanyakan saja pada ayahmu kapan terakhir kali aku berkunjung. Itu pun kalau kau bisa bertemu dengannya atau anjingnya lagi."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutUnderworld01"
    }
    {
      Id = "MelinoeField_4013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar pernah ke Dunia Bawah sebelumnya... dan menyeret anjing keluargaku sampai ke permukaan, dengan izin ayahku?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutUnderworld02"
    }
    {
      Id = "Heracles_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu tak menyangka aku sanggup melakukannya. Lagi-lagi salah satu dewa yang meragukan kata-kataku. Tapi jangan cemas, anjing itu kulepaskan kembali. Beruntung baginya, dia bukan seekor kucing."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutUnderworld02"
    }
    {
      Id = "MelinoeField_4014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sulit dipercaya. Lalu mengapa Olympus tidak mengutusmu untuk memburu Chronos kalau kau memang punya pengalaman semacam itu?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutUnderworld02"
    }
    {
      Id = "Heracles_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka hanya fokus bertahan. Mungkin mereka tak yakin aku sanggup melakukannya. Dan bisa jadi mereka tak memercayaiku. Entah apa lagi alasannya."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutUnderworld02"
    }
    {
      Id = "Heracles_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau memang putri Hades yang sesungguhnya, itu berarti kita sepupu, bukan? Walau mengenal ayahku, kau pasti punya banyak sekali sepupu..."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutFamily01"
    }
    {
      Id = "MelinoeField_3989"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru saja bertemu beberapa dari mereka di antara para dewa Olympus sendiri. Tapi aku tumbuh besar hampir sepenuhnya dalam kesendirian."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutFamily01"
    }
    {
      Id = "Heracles_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersyukurlah pada sang Takdir untuk itu. Semakin sedikit kerabat berarti semakin sedikit beban kewajiban... semakin sedikit perang yang menyeretmu tanpa campur tanganmu sendiri, selain karena terlahir ke dunia..."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutFamily01"
    }
    {
      Id = "Heracles_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ke mana pun aku pergi, orang mati mengenalku; menjengkelkan sekali. Dulu aku bisa membantai musuh tanpa menarik perhatian."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutFame01"
    }
    {
      Id = "MelinoeField_3997"
      InheritFrom = "BaseNarrative"
      DisplayName = "Konsekuensi dari ketenaran. Para Arwah di tempat asalku sangat mengagumimu! Kami bahkan mungkin punya gulungan dinding yang menggambarkan petualanganmu."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutFame01"
    }
    {
      Id = "Heracles_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka sama sekali tak tahu apa-apa tentangku, cuma tahu kebohongan dan separuh kebenaran. Aku tak butuh sekte pengikut tanpa akal."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutFame01"
    }
    {
      Id = "MelinoeField_3993"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pernah melihat Nyonya Medea di sekitar sini? Rambut hitam panjang dan busana serba gelap. Dia mungkin bisa bantu menipiskan kerumunan ini. Tak bisa dipungkiri kita kalah jumlah."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutMedea01"
    }
    {
      Id = "Heracles_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah berutang budi padanya saat aku sedang... tidak dalam kondisi terbaikku. Aku takkan meminta bantuan lagi pada penyihir. Kalian mengambil lebih banyak daripada yang kalian beri."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutMedea01"
    }
    {
      Id = "MelinoeField_3994"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memangnya apa yang pernah para penyihir lakukan padamu? Kedengarannya dia pernah membantumu, tapi kau masih membicarakannya dengan begitu sinis."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutMedea01"
    }
    {
      Id = "Heracles_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu apa saja yang sanggup kalian lakukan. Aku menghormati kekuatan gunung berapi yang meletus, bukan berarti aku mau berada di dekatnya."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutMedea01"
    }
    {
      Id = "MelinoeField_4009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam semua perjalanan bolak-balikmu dari Gunung Olimpus, apa kau pernah melihat seorang pemuda bersayap melayang di atas perairan, menjatuhkan bahan peledak untuk mengacaukan armada sang Titan?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutIcarus01"
    }
    {
      Id = "Heracles_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putra dari sang perajin Daedalus. Sayap itu bukan sayap sungguhan, dan dia sudah jadi Arwah sekarang. Dia dan ayahnya, dua-duanya. Ada apa dengannya?"
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutIcarus01"
    }
    {
      Id = "MelinoeField_4010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, hanya saja... rupanya dia sangat mengagumimu. Dia rela memberikan apa pun demi bisa bertemu denganmu suatu saat nanti. Kupikir mungkin aku bisa memfasilitasi perkenalan kalian."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutIcarus01"
    }
    {
      Id = "Heracles_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak tertarik dengan pengagum. Apalagi yang mayat tenggelamnya harus kugeletakkan dan kukubur sendiri. Dia lebih baik hanya mengagumi sosok bayanganku saja."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutIcarus01"
    }
    {
      Id = "MelinoeField_4011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Icarus, putra Daedalus yang kita bicarakan itu, dia sangat terharu saat tahu kau mungkin telah membantu mengurus upacara pemakaman terakhirnya. Dia menitipkan salam untukmu... kurasa dia sebenarnya ingin bicara lebih banyak."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutIcarus02"
    }
    {
      Id = "Heracles_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Urrgh. {#Prev}Bisakah kau jangan menggangguku dengan segala sentimentalitasnya itu."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutIcarus02"
    }
    {
      Id = "Heracles_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabarnya Sang Tiga Takdir sendiri telah lenyap. Sayang sekali. Padahal aku selalu menginginkan tugas itu untuk diriku sendiri. Bukan berarti mereka bisa dibunuh, sih."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutFates01"
    }
    {
      Id = "MelinoeField_3771"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu ingin membunuh Sang Tiga Takdir... hanya karena mereka menentukan kau bakal jadi pahlawan hebat dengan kekuatan luar biasa yang pencapaiannya menginspirasi banyak orang?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutFates01"
    }
    {
      Id = "Heracles_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang jelas kalau bukan karena mereka, aku takkan ada di sini. Yah, sekarang mereka tahu rasanya... dipermainkan ke sana kemari tanpa punya hak bersuara. Persetan dengan Sang Takdir! Keadilanlah satu-satunya yang kita butuhkan."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutFates01"
    }
    {
      Id = "Heracles_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil lolos sebelumnya. Tapi Cyclops itu pasti sudah mencium baumu. Kuat juga dia, yang satu itu."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutPolyphemus01"
    }
    {
      Id = "MelinoeField_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pujian yang luar biasa. Padahal {#Emph}kau {#Prev}pasti jauh lebih kuat! Pernah terpikir untuk mengujinya secara langsung? Itu bisa menghemat banyak tenagaku."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutPolyphemus01"
    }
    {
      Id = "Heracles_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia bukan tipeku. Lagipula, dia keturunan para dewa, persis sepertimu dan aku. Tak elok rasanya kalau kita semua saling bertarung setiap saat, bukan?"
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutPolyphemus01"
    }
    {
      Id = "Heracles_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah-ayah kita benar-benar mengacaukan segalanya untuk kita, ya, saudari. Terlahir dari dewa-dewa terkuat, tapi hidup seperti orang buangan... seperti binatang sialan."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutFathers01"
    }
    {
      Id = "MelinoeField_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos-lah yang mengacaukan segalanya. Andaikan dia tetap mati, kita pasti hidup damai. Dan berkumpul bersama ayah kita, tak diragukan lagi."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutFathers01"
    }
    {
      Id = "Heracles_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau pernah {#Emph}bertemu {#Prev}ayah-ayah kita? Tentu, kita sedang berada di tengah-tengah perang tanpa akhir, tapi setidaknya kita berada jauh dari {#Emph}mereka."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutFathers01"
    }
    {
      Id = "MelinoeField_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sepertinya kenal baik dengan sang Tukang Perahu. Pernah bekerja sama sebelumnya?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutCharon01"
    }
    {
      Id = "Heracles_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pernah punya urusan berkunjung ke alammu di masa lalu. Sang Tukang Perahu adalah pemasokku. Dan rupanya pemasokmu juga... memborong habis semua dagangannya."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutCharon01"
    }
    {
      Id = "MelinoeField_0485"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku memang tidak terlalu hemat belakangan ini..."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutCharon01"
    }
    {
      Id = "Heracles_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nasihat ramah: waspadalah terhadap babi hutan besar yang tak sepenuhnya mati, berkeliaran mengendus di gang-gang Ephyra. Babi itu datang mencariku."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutBoar01"
    }
    {
      Id = "MelinoeField_3992"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau diburu oleh babi hutan, bukan sebaliknya? Apa aku tidak salah dengar?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutBoar01"
    }
    {
      Id = "Heracles_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami... punya masalah di masa lalu saat babi itu masih lebih... bernyawa. Inilah akibatnya kalau tidak menuntaskan pekerjaan saat punya kesempatan."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutBoar01"
    }
    {
      Id = "MelinoeField_3768"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau pernah berpapasan dengan Titan Prometheus saat berada di Olimpus baru-baru ini? Tampaknya dia yang memimpin pasukan penyerbu yang mengepung kediaman keluargamu."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutPrometheus01"
    }
    {
      Id = "Heracles_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah begitu? Lucu sekali. Bukankah dia seharusnya sedang dirantai di suatu gunung di tempat lain, dicabik-cabik burung pemangsa?"
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutPrometheus01"
    }
    {
      Id = "MelinoeField_3769"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau tidak tahu dia sudah bebas? Seharusnya kau memburu {#Emph}dia{#Prev}, bukan kroco-kroco ini. Siapa yang menentukan targetmu?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutPrometheus01"
    }
    {
      Id = "Heracles_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perintahku datang langsung dari sang Raja dan Ratu. Kalau kau punya keluhan tentang caraku menjalankan tugas, mengeluh saja langsung pada mereka."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutPrometheus01"
    }
    {
      Id = "MelinoeField_4016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak percaya menanyakan ini, tapi apa kau tertarik menghadiri perjamuan eksklusif bersama Tuan Dionisos dan rekan-rekan terdekatnya? Ada banyak minuman, pemandian air hangat yang cukup luas..."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutDionysus01"
    }
    {
      Id = "Heracles_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maksudmu, {#Emph}ada pemandian air hangat yang cukup luas? {#Prev}Yang pernah dia bicarakan hanyalah minuman keras. Di mana lokasinya, dan kapan?"
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutDionysus01"
    }
    {
      Id = "MelinoeField_4017"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di mana {#Prev}lokasinya agak sulit kujelaskan, tapi di salah satu ruangan dalam gunung. Dan soal {#Emph}kapan{#Prev}, kurasa sedang berlangsung sekarang tanpa akhir yang jelas."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutDionysus01"
    }
    {
      Id = "Heracles_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tawaranmu menarik sekali, penyihir. Pesta yang sudah molor entah berapa lama sampai para dewa pun bingung, dan kau sendiri tak tahu jalan ke sana. Bakal kupertimbangkan baik-baik."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutDionysus01"
    }
    {
      Id = "Heracles_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah berhasil mencapai puncak gunung? Kalau belum, tak ada hal menyenangkan yang menunggumu di sana. Setidaknya begitu yang kudengar."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTyphon01"
    }
    {
      Id = "MelinoeField_3770"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu, Typhon? Heran juga para dewa Olympus tak menyuruhmu menghadapi {#Emph}dia{#Prev}, malah menyuruhmu menghajar kroco-kroco yang jauh dari bahaya sesungguhnya."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutTyphon01"
    }
    {
      Id = "Heracles_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa Olympus tak sudi ada setengah dewa yang merebut kejayaan mereka. Aku cuma kebagian kerja kasar, bukan tugas penting. Bersyukurlah pada para Moirai karena {#Emph}kau {#Prev}kebagian keduanya."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTyphon01"
    }
    {
      Id = "Heracles_0634"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana rasanya... berhadapan dengan monster di puncak sana? Aku belum pernah melawan yang sebesar itu. Setidaknya untuk saat ini."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTyphon02"
    }
    {
      Id = "MelinoeField_4021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun belum pernah melawan makhluk sebesar Typhon. Ukurannya yang masif memang jadi kelemahannya dalam beberapa hal, tapi menghadapi {#Emph}dia{#Prev}, badai dahsyat, dan anak-pinaknya sekaligus bisa sangat merepotkan."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutTyphon02"
    }
    {
      Id = "Heracles_0635"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka Hydra berkepala banyak yang dulu kubantai itu cuma salah satu keturunannya. Tapi kelak di masa depan, pasti bakal ada monster yang jauh lebih mengerikan untuk dihadapi..."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTyphon02"
    }
    {
      Id = "Heracles_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada lagi yang perlu diselesaikan di sini... tapi urusan ini tak pernah tuntas. Omong-omong, soal yang tadi, jangan dimasukkan ke hati."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutAltFight01"
    }
    {
      Id = "MelinoeField_3763"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, sama sekali tidak. Dulu aku selalu penasaran bagaimana rasanya dihantam sekuat tenaga oleh pemukulmu, dan sekarang rasa penasaran itu sudah sirna."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutAltFight01"
    }
    {
      Id = "Heracles_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun tak suka meninggalkan keraguan. Dan kalau kau butuh pengingat tentang rasa hantaman pemukulku, kau tahu di mana bisa mencariku."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutAltFight01"
    }
    {
      Id = "Heracles_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak seperti dugaanku. Kau bisa tutup mulut soal aku. Bahkan entah bagaimana bisa mengalahkan Prometheus setelah aku ikut campur. Mengapa dan bagaimana caranya?"
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutAltFightWin01"
    }
    {
      Id = "MelinoeField_3777"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya alasan dan caraku sendiri. Kenapa aku harus membeberkannya padamu? Kau sendiri tak pernah berniat untuk terbuka padaku."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutAltFightWin01"
    }
    {
      Id = "Heracles_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kalau kubilang {#Emph}baik-baik{#Prev}, tapi caraku itu juga tak mempan padaku sendiri. Terserahmulah. Bukan berarti aku bisa memaksamu buka mulut."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutAltFightWin01"
    }
    {
      Id = "Heracles_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terakhir kali kita terlibat bentrokan seperti ini, setelah debu mereda, kau langsung raib. Kabur, bagai pencuri di malam hari."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutReturning01"
    }
    {
      Id = "MelinoeField_3764"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus segera pergi. Kukira kau tak bakal kesulitan membereskannya, mengingat kau selalu bekerja sendirian."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutReturning01"
    }
    {
      Id = "Heracles_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang benar. Tapi aku tak suka ada petarung yang mendadak lenyap begitu saja. Tetaplah di tempat yang bisa kulihat, atau jangan halangi jalanku."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutReturning01"
    }
    {
      Id = "MelinoeField_4959"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan cuma kau yang memikul beban ekspektasi setinggi langit, Heracles. Aku ini Putri Underworld. Ayah dan ibuku ditawan oleh Chronos, dan aku dibesarkan hanya untuk membunuhnya. Berulang kali ditegaskan bahwa itu mutlak kulakukan, meski nyaris mustahil."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutExpectations01"
    }
    {
      Id = "Heracles_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak minta diceritakan riwayat hidupmu, tapi bolehlah. Para Moirai punya rencana besar untukmu. Pasti berat sekali tekanannya andai takdirmu belum digariskan sejak awal."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutExpectations01"
    }
    {
      Id = "MelinoeField_4960"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu bagaimana dengan rentetan kemenanganmu? Kau harus berjuang mati-matian demi setiap pencapaianmu. Apa tak ada satu pun dari itu yang sudah ditakdirkan?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutExpectations01"
    }
    {
      Id = "Heracles_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tak pernah tahu apa yang sudah ditakdirkan atau belum, dan kita tak bisa gegabah berspekulasi. Tapi beban apa pun yang kau pikul, sedikit pun tak meringankan bebanku."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutExpectations01"
    }
    {
      Id = "MelinoeField_4961"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bebanmu tak terasa lebih ringan meski tahu kau tak sendirian?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutExpectations01"
    }
    {
      Id = "Heracles_0280"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang dari dulu selalu begitu."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutExpectations01"
    }
    {
      Id = "MelinoeField_4962"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dikenal sebagai pejuang yang nyaris sempurna, Heracles, tapi kau sendiri tak tampak terlalu memusingkan gelar itu. Kau bertarung dengan buas, mengandalkan kekuatan kasar alih-alih keanggunan jurus. Kau cuma mau hasil."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutPerfection01"
    }
    {
      Id = "Heracles_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang benar. Lantas kenapa? Kesempurnaan {#Emph}itu sendiri {#Prev}adalah hasil. Dan kenapa kau tak berhenti mengutak-atik pikiranku, penyihir? Berada di dalam kepalaku sama tidak kuharapkannya dengan berada di hadapanku."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutPerfection01"
    }
    {
      Id = "MelinoeField_4963"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma ingin memahami perkataanmu... karena aku tak ingin berakhir sepertimu, diselimuti penyesalan di balik segala kejayaanmu. Kebesaranmu hanya terbuang sia-sia di matamu {#Emph}sendiri{#Prev}."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutPerfection01"
    }
    {
      Id = "Heracles_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak usah khawatir, Saudari. Kau takkan pernah berakhir sepertiku. Karena kau takkan pernah {#Emph}bisa {#Prev}sepertiku. Tak ada yang pernah bisa, dan takkan pernah ada."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutPerfection01"
    }
    {
      Id = "Heracles_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Darahmu merah mengalir. Kau bukan dewi sepenuhnya. Kita benar-benar menikmati yang terbaik dari dua dunia."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutBlood01"
    }
    {
      Id = "MelinoeField_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibumu seorang manusia fana, kan? Ibuku pun setengah fana. Kematian mengalir dalam darah kita. Tapi kau berbeda..."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutBlood01"
    }
    {
      Id = "Heracles_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Berbeda. {#Prev}Bukan dewa, bukan manusia fana, bukan pula Arwah. Benar katamu; kematian itu sendiri mengalir dalam darahku. Semua orang fana terlahir untuk mati. Sedangkan aku, terlahir juga untuk membunuh."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutBlood01"
    }
    {
      Id = "Heracles_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, bukankah ini Taring Singa milikku yang dulu. Aku punya cadangan lebih dari cukup, dan kulihat kau butuh sedikit kebuasan taring itu."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutKeepsake01"
    }
    {
      Id = "MelinoeField_3990"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatannya jelas sangat berguna, tapi kenapa kau berikan padaku? Semakin kuat diriku, semakin besar peluangku merebut kejayaanmu."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutKeepsake01"
    }
    {
      Id = "Heracles_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sederhana saja, Saudari: Aku sudah tak menginginkannya lagi. Baik Taring itu maupun kejayaan. Rebut saja pekerjaanku kalau kau mau; selalu ada mangsa lain yang menanti."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutKeepsake01"
    }
    {
      Id = "Heracles_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Taring Singa itu masih memberikan hasil yang memuaskan? Kekuatan dahsyat yang memudar seiring waktu... persis seperti takdir menjadi seorang manusia fana."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutKeepsake02"
    }
    {
      Id = "MelinoeField_4015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Merasakan raga yang perlahan digerogoti kerapuhan... untungnya, Taringmu memulihkan seluruh kekuatannya setiap malam."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutKeepsake02"
    }
    {
      Id = "Heracles_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak seperti singa tempat taring itu berasal. Katanya ia jatuh langsung dari bulan, percaya tidak pada omong kosong itu? Tapi dia memang binatang yang luar biasa..."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutKeepsake02"
    }
    {
      Id = "Heracles_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Trik-trik sihir itu... kau meminjam kekuatan tersebut. Bagaimana bisa kau mempercayainya saat kekuatan sejati hanya berasal dari dirimu sendiri?"
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutMagick01"
    }
    {
      Id = "MelinoeField_3998"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sihir dan kekuatan fisik mentah tidak saling bertentangan; keduanya pada akhirnya berasal dari dalam diri, hanya dilatih dengan cara berbeda."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutMagick01"
    }
    {
      Id = "Heracles_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa tidak begitu, Saudari. Kau menariknya dari bulan, bumi, dan... entah apa lagi. Tapi di dunia ini, kau tak bisa mengandalkan siapa pun selain dirimu sendiri."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutMagick01"
    }
    {
      Id = "Heracles_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakatmu dalam menggunakan senjata lebih hebat dari dugaan orang. Dulu aku pernah bertekad menguasai segala persenjataan di kolong langit, tapi pada akhirnya... aku memilih gada sederhana ini."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutWeapons01"
    }
    {
      Id = "MelinoeField_3985"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku adalah pembawa Senjata Malam dalam segala ragam Aspeknya; aku takkan pernah puas hanya dengan satu. Tidakkah kau takut telah menjadi terlalu berpuas diri?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutWeapons01"
    }
    {
      Id = "Heracles_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak. Telusuri jalan ini cukup lama, dan kau akan menyadari bahwa senjata apa pun bisa menuntaskan tugas. Pada titik itu, pilihan tak lagi berarti. Walau aku masih membawa semua senjata lain ini hanya untuk pamer."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutWeapons01"
    }
    {
      Id = "Heracles_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa seorang penyihir sampai belajar mengayunkan senjata semacam itu? Kau punya mantra-mantra licikmu, tapi malah mengotori tanganmu dengan darah."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutAxe01"
    }
    {
      Id = "MelinoeField_3986"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku perlu membangun ketahanan fisik sekaligus menghindari ketergantungan berlebih pada sihir, yang bisa sangat menguras tenaga."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutAxe01"
    }
    {
      Id = "Heracles_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sihir bisa menguras tenaga fisik. {#Prev}Kau memang aneh, Saudari. Tapi setidaknya seleramu soal senjata lumayan bagus."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutAxe01"
    }
    {
      Id = "Heracles_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari mana kau dapatkan sabitmu itu, Saudari? Kau tak tampak seperti petani, yah meski Thanatos juga tidak begitu."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutThanatosAspect01"
    }
    {
      Id = "MelinoeField_3987"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maukah kau percaya jika kukatakan ibunya mengizinkanku meminjamnya untuk sementara waktu?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutThanatosAspect01"
    }
    {
      Id = "Heracles_0103_C"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutThanatosAspect01"
    }
    {
      Id = "Heracles_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gada batumu itu... {#Emph}itu {#Prev}baru instrumen pembunuh yang layak. Ingin rasanya kurebut dari genggamanmu, tapi sepertinya senjata itu terikat padamu."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutNergalAspect01"
    }
    {
      Id = "MelinoeField_3988"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tindakan bijak untuk menahan diri, karena Gada Singa Batu tunduk padaku. Tidak seluwes gadamu sendiri... kayu zaitun, bukan?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutNergalAspect01"
    }
    {
      Id = "Heracles_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luar biasa sekali pengalamanmu, ya? Memahami gada sebaik kau mengenali pepohonan. Lagipula aku tetap lebih suka punyaku dibanding punyamu."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutNergalAspect01"
    }
    {
      Id = "Heracles_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak memikirkanmu selama kau pergi. Kalaupun memikirkanmu, kukira kau sudah menyerah."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTimePassing01"
    }
    {
      Id = "MelinoeField_3995"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak tahu harus merespons apa selain bahwa akhir-akhir ini aku juga tak terlalu memikirkanmu. Apa ada orang yang {#Emph}memang {#Prev}rutin kau pikirkan?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutTimePassing01"
    }
    {
      Id = "Heracles_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kebanyakan memikirkan jasad-jasad yang telah kuhancurkan di bawah gada dan pijakan kakiku. Kau dipersilakan bergabung dengan mereka, kapan saja."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTimePassing01"
    }
    {
      Id = "MelinoeField_3996"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak, terima kasih, aku baik-baik saja."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutTimePassing01"
    }
    {
      Id = "Heracles_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata mereka perang akhirnya mendekati akhir. Pasti ada yang lupa memberi tahu mereka yang kita bantai ini."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTrueEnding01"
    }
    {
      Id = "MelinoeField_4005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimanapun juga kita tetap membutuhkan mereka di sini untuk saat ini. Apakah Olimpus sudah memberitahumu tentang rincian fase rencana kita berikutnya?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutTrueEnding01"
    }
    {
      Id = "Heracles_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuintisarinya saja: Kita terus bertarung. Tak ada yang berubah. Tak pernah berubah sebelumnya, jadi... kenapa sekarang harus?"
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTrueEnding01"
    }
    {
      Id = "MelinoeField_4006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maksudmu? Banyak hal yang telah berubah! Olimpus tak lagi dalam bahaya. Wangsa Hades telah dipulihkan."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutTrueEnding01"
    }
    {
      Id = "Heracles_0280_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali seperti sedia kala."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTrueEnding01"
    }
    {
      Id = "MelinoeField_4022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang akan kaulakukan jika semua ini telah usai, Tuan? Atau lebih tepatnya, apa yang ingin kaulakukan?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutTrueEnding02"
    }
    {
      Id = "Heracles_0636"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kenapa bertanya? Aku cenderung tak terlalu memikirkan keinginan, selain hawa nafsu liar dan mendesak yang mungkin kurasakan."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTrueEnding02"
    }
    {
      Id = "MelinoeField_4023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya ingin mendengar sudut pandang lain, itu saja. Sepanjang hidupku, ada kewajiban pada keluarga yang harus kutuntaskan. Aku tak yakin harus berbuat apa sekarang setelah aku..."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutTrueEnding02"
    }
    {
      Id = "Heracles_0637"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akulah orang terakhir yang pantas kau dengar sudut pandangnya, Saudari. Kejarlah mimpimu selagi masih punya. Sekarang pergilah."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutTrueEnding02"
    }
    {
      Id = "MelinoeField_4007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Titan Prometheus tampak cukup puas akhir-akhir ini. Menurutmu kenapa bisa begitu?"
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutEpilogue01"
    }
    {
      Id = "Heracles_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mana kutahu, dan apa peduliku? Mengingat kita tak membicarakannya di sini, atau di mana pun."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutEpilogue01"
    }
    {
      Id = "MelinoeField_4008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu mari bicarakan tentang dirimu. Sudahkah kau mendapatkan apa yang kaucari? Dengan ramalan Para Moirai bahwa era manusia fana akan segera tiba."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutEpilogue01"
    }
    {
      Id = "Heracles_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ini cuma separuh dewa, kalau kau lupa. Aku tak pernah mendapatkan apa yang kuinginkan. Tapi saat waktu untuk perubahan itu akhirnya tiba, aku akan menyambutnya. Semoga era berikutnya tak lagi membutuhkan dewa atau manusia sepertiku."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutEpilogue01"
    }
    {
      Id = "Heracles_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setelah kupikir-pikir lagi, harus kuakui aku sempat meremehkan pencapaianmu, Saudari. Tugasmu memang berat."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutEpilogue02"
    }
    {
      Id = "MelinoeField_4019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa saja lebih buruk. Bagaimanapun, aku didukung oleh kekuatan Heracles yang perkasa di sisiku, setidaknya untuk sebagian besar waktu. Namun terima kasih; pujian itu sangat berarti jika datang darimu."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutEpilogue02"
    }
    {
      Id = "Heracles_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu sungkan. Untuk saat ini, sepertinya kita bisa terus menjalankan keahlian kita tanpa beban tuntutan melakukan hal mustahil. Bagiku itu sudah cukup."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutEpilogue02"
    }
    {
      Id = "Heracles_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlalu banyak omong, tahu tidak, penyihir? Tinggalkan basa-basi, dan kita bisa membantai lebih banyak lagi."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_4018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak yakin basa-basi mana yang kau maksud, tapi jika kau ingin lebih sedikit bicara lagi, itu jelas hakmu."
      Speaker = "Melinoe"
      Event = "HeraclesFieldAboutSayingLittle01"
    }
    {
      Id = "Heracles_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bicara bukanlah keahlianku. Dan seperti yang mungkin sudah kau duga, aku tipe orang yang lebih fokus pada kekuatanku."
      Speaker = "Heracles"
      Event = "HeraclesFieldAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putra Zeus yang agung, kupersembahkan hadiah Nektar ini, agar bisa membasahi dahagamu selagi berjerih lelah demi para dewa. Mereka pasti bersyukur atas kekuatanmu."
      Speaker = "Melinoe"
      Event = "HeraclesGift01"
    }
    {
      Id = "Heracles_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh. {#Prev}Lumayan, jadi aku tak perlu mencari sebotol lagi saat nanti harus membuktikan kesetiaanku. Ini, imbalan atas repot-repotmu."
      Speaker = "Heracles"
      Event = "HeraclesGift01"
    }
    {
      Id = "Heracles_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yakin kau tak mau memberiku setengah botol saja? Mengingat aku cuma setengah dewa... Aku mewarisi kekuatan mereka tapi jarang mencicipi kemewahan mereka."
      Speaker = "Heracles"
      Event = "HeraclesGift02"
    }
    {
      Id = "MelinoeField_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi pula, tiada gunanya kemewahan berlebih. Tapi sesekali sedikit mencicipi tak ada salahnya! Semoga ini bisa menenangkan jiwamu bila saatnya tiba."
      Speaker = "Melinoe"
      Event = "HeraclesGift02"
    }
    {
      Id = "Heracles_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar menganggapku bodoh, percaya aku bakal sudi meminum {#Emph}ini? {#Prev}Kau bisa saja menyihir isinya dengan berbagai cara, untuk membuatku gila, atau lebih buruk lagi..."
      Speaker = "Heracles"
      Event = "HeraclesGift03"
    }
    {
      Id = "MelinoeField_3772"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bersumpah demi nama ayahku bahwa aku tak melakukan hal semacam itu. Dan pastilah sudah basi jika aku melakukannya. Kau ingin melihatku meminumnya lebih dulu?"
      Speaker = "Melinoe"
      Event = "HeraclesGift03"
    }
    {
      Id = "Heracles_0289"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak usah. Aku bisa membuangnya sendiri."
      Speaker = "Heracles"
      Event = "HeraclesGift03"
    }
    {
      Id = "Heracles_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dukunganku, ditukar dengan minuman? Tidak. Kau membuang-buang sumber daya dan waktumu; waktuku juga. Kau akan dapat bagian jarahan jika kau membunuh musuhmu, tapi tidak lebih dari itu."
      Speaker = "Heracles"
      Event = "HeraclesGift04"
    }
    {
      Id = "MelinoeField_3773"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengerti. Walau begitu, kita berdua berjuang demi keluarga yang sama, dan aku melihat langsung jerih payahmu memukul mundur musuh-musuh mereka. Dan aku berterima kasih."
      Speaker = "Melinoe"
      Event = "HeraclesGift04"
    }
    {
      Id = "Heracles_0170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mencibir>"
      Speaker = "Heracles"
      Event = "HeraclesGift04"
    }
    {
      Id = "Heracles_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa gunung itu tak pernah sudi memberiku barang ini sendiri. Akibatnya aku jadi muak, apalagi setelah... lomba minum tertentu melawan dewa anggur. Tapi itu sudah lama sekali."
      Speaker = "Heracles"
      Event = "HeraclesGift05"
    }
    {
      Id = "MelinoeField_3774"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mencoba mengalahkan Tuan Dionysus dalam adu minum? Bahkan dengan segala ketahananmu, setahuku itu terdengar seperti tindakan yang sangat berbahaya."
      Speaker = "Melinoe"
      Event = "HeraclesGift05"
    }
    {
      Id = "Heracles_0292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang."
      Speaker = "Heracles"
      Event = "HeraclesGift05"
    }
    {
      Id = "MelinoeField_3775"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bilang para dewa tak pernah berbagi Nektar denganmu; nah, sekarang aku membaginya kepadamu. Mungkin seleramu terhadapnya bisa kembali."
      Speaker = "Melinoe"
      Event = "HeraclesGift06"
    }
    {
      Id = "Heracles_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hentikan ini, penyihir. Sudah kubilang aku tak sudi, dan saat ini aku tak punya rencana membuat persembahan apa pun sendiri. Kesabaranku terhadap {#Emph}dirimu {#Prev}pun mulai menipis."
      Speaker = "Heracles"
      Event = "HeraclesGift06"
    }
    {
      Id = "MelinoeField_3776"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesabaranmu saja sudah cukup, Tuan. Kulihat betapa kerasnya kau berjuang, tanpa mengharapkan balasan apa pun. Atas segala yang telah kauberikan untuk Olympus, semoga kau tak pernah menyerahkan jiwamu."
      Speaker = "Melinoe"
      Event = "HeraclesGift06"
    }
    {
      Id = "Heracles_0294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Itu pun kalau aku masih memilikinya."
      Speaker = "Heracles"
      Event = "HeraclesGift06"
    }
    {
      Id = "MelinoeField_3778"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bilang aku tak seperti dugaanmu; kau pun tidak seperti yang kubayangkan, Tuan. Kudengar kisah-kisah kehebatanmu, dan sungguh belum pernah kulihat petarung segarang dirimu. Tapi aku tahu ada hal berharga lain dalam dirimu. Terimalah ini! Untuk seseorang yang memiliki keilahian sepertimu, hadiah ilahi."
      Speaker = "Melinoe"
      Event = "HeraclesGift07"
    }
    {
      Id = "Heracles_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ambrosia... kau menganggapku dewa sepertimu. Aku ini setengah manusia; barang begini bukan untukku, dan kau menodai tujuannya hanya dengan mempersembahkannya. Apa maumu dariku?"
      Speaker = "Heracles"
      Event = "HeraclesGift07"
    }
    {
      Id = "MelinoeField_3779"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin kau menerima kenyataan bahwa ada dewa dan dewi yang menjunjung tinggi dirimu. Jika ketidaksempurnaan berarti tak pantas berstatus dewa, maka tak seorang pun dari kita yang layak disebut ilahi."
      Speaker = "Melinoe"
      Event = "HeraclesGift07"
    }
    {
      Id = "Heracles_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bicaramu ada benarnya juga, Saudari. Yah, jika dan ketika seluruh keluarga akhirnya menerima sudut pandangmu itu, mari kita nikmati botol ini bersama-sama. Kusimpan saja dulu untuk sekarang."
      Speaker = "Heracles"
      Event = "HeraclesGift07"
    }
    {
      Id = "Melinoe_0055_C"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai saat itu tiba."
      Speaker = "Melinoe"
      Event = "HeraclesGift07"
    }
    {
      Id = "MelinoeField_4942"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku membawa garam pemurni ini, Tuan. Silakan jika kau mau menggunakannya, terutama kalau kau bersedia membantu menjaga perbatasan..."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouse01"
    }
    {
      Id = "Heracles_0162_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Baiklah."
      Speaker = "Heracles"
      Event = "HeraclesBathHouse01"
    }
    {
      Id = "Heracles_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jaga jarak dariku, penyihir. Gadaku selalu siap di tangan. Para Satir dan Nimfa pun sudah kuperingatkan."
      Speaker = "Heracles"
      Event = "HeraclesBathHouse01"
    }
    {
      Id = "MelinoeField_4948"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku tak berniat bergeser dari tempat ini, kecuali saat harus pergi dengan enggan nanti. Seharusnya aku tak bersantai begini, tapi aku kedinginan dan lelah."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouse01"
    }
    {
      Id = "Heracles_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedinginan dan lelah... sekarang omongan kita baru sejalan. Bagaimana kau bisa tahu tempat seperti ini? Para dewa lain saja bahkan tak tahu."
      Speaker = "Heracles"
      Event = "HeraclesBathHouse01"
    }
    {
      Id = "MelinoeField_4949"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami punya pemandian air panas yang mirip di tempat asalku. Yah... suasananya sangat berbeda, dan biasanya jauh lebih sedikit yang datang kemari."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouse01"
    }
    {
      Id = "Heracles_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan itu maksudku. Mengapa kau ada di {#Emph}sini? {#Prev}Kau tak kelihatan seperti tipe yang suka... {#Emph}mabuk-mabukan dan berpesta."
      Speaker = "Heracles"
      Event = "HeraclesBathHouse01"
    }
    {
      Id = "MelinoeField_4950"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sendiri juga begitu. Meski kau memang pernah menyinggung soal lomba minum melawan Tuan Dionysus suatu kali. Aku tak tahu mengapa beliau mengizinkanku masuk. Tapi aku suka mampir kemari."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouse01"
    }
    {
      Id = "Heracles_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm. {#Prev}Berendam bersama para Satir sesekali, bukannya membantai mereka. Apa pun demi memecah rutinitas...."
      Speaker = "Heracles"
      Event = "HeraclesBathHouse01"
    }
    {
      Id = "MelinoeField_4951"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah...! Rasanya menyegarkan sekaligus membuat canggung. Sampai jumpa, Tuan."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouse01"
    }
    {
      Id = "MelinoeField_4952"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berniat berendam sebentar begitu kolam ini selesai disucikan, kalau Tuan juga ingin bergabung."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouse02"
    }
    {
      Id = "Heracles_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ya."
      Speaker = "Heracles"
      Event = "HeraclesBathHouse02"
    }
    {
      Id = "Heracles_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dionysus memahami sesuatu yang luput dari dewa-dewa lain. Kau tahu apa itu, Saudari?"
      Speaker = "Heracles"
      Event = "HeraclesBathHouse02"
    }
    {
      Id = "MelinoeField_4955"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu bukan perkara sepele seperti berfoya-foya mabuk kepayang, kan?"
      Speaker = "Melinoe"
      Event = "HeraclesBathHouse02"
    }
    {
      Id = "Heracles_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia paham bahwa kesempurnaan itu mustahil diraih. Sisanya terus memburunya, menuntutnya dari satu sama lain, sesumbar telah memilikinya. Semuanya sandiwara belaka."
      Speaker = "Heracles"
      Event = "HeraclesBathHouse02"
    }
    {
      Id = "MelinoeField_4956"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau salah satu kesatria terhebat sepanjang masa. Aku tak percaya kau tak pernah mengejar kesempurnaan. Aku pun mengejarnya... aku tak pernah merasa cukup hebat, tapi itu tak pernah menghentikanku."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouse02"
    }
    {
      Id = "Heracles_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah bilang tak pernah mengejarnya. Maksudku, perburuan itu sia-sia belaka... menuju tujuan yang mustahil digapai. Semua itu hanya karena orang lain menuntutnya darimu."
      Speaker = "Heracles"
      Event = "HeraclesBathHouse02"
    }
    {
      Id = "MelinoeField_4957"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau juga tampaknya bukan tipe orang yang terlalu memikirkan anggapan orang lain. Kecuali mungkin terhadap Ratu dan Raja gunung ini."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouse02"
    }
    {
      Id = "Heracles_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa pula aku sampai bicara padamu? Hanya Atlas seorang yang paham rasanya... memikul beban seisi dunia."
      Speaker = "Heracles"
      Event = "HeraclesBathHouse02"
    }
    {
      Id = "MelinoeField_4958"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, obrolan tadi cukup menyenangkan. Jaga diri, Tuan."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouse02"
    }
    {
      Id = "MelinoeField_4953"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya tempatnya cukup luas..."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouseRepeatable01[1]"
    }
    {
      Id = "MelinoeField_4954"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan kusucikan dulu air ini..."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouseRepeatable01[1]"
    }
    {
      Id = "MelinoeField_4945"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lanjutkan saja urusan kalian, jangan pedulikan aku..."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouseRepeatable01[1]"
    }
    {
      Id = "MelinoeField_4944"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekadar berendam sebentar..."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouseRepeatable01[1]"
    }
    {
      Id = "Heracles_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Apa yang sedang kau lihat?"
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[2]"
    }
    {
      Id = "Heracles_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sedang berusaha memulihkan diri di sini..."
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[2]"
    }
    {
      Id = "Heracles_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Apa tampangku kelihatan ingin mengobrol?"
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[2]"
    }
    {
      Id = "Heracles_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Pegal-pegal sialan ini memang bandel, tapi bakal hilang sendiri..."
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[2]"
    }
    {
      Id = "Heracles_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jangan mendekat ke mari, Penyihir."
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[2]"
    }
    {
      Id = "Heracles_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Setidaknya air keparat ini akhirnya disucikan lagi."
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[2]"
    }
    {
      Id = "MelinoeField_5354"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Cuma melihat airnya, tak lebih..."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouseRepeatable01[3]"
    }
    {
      Id = "MelinoeField_5355"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Begitu pula aku. Masih ada pendakian yang tersisa..."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouseRepeatable01[3]"
    }
    {
      Id = "MelinoeField_5356"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sedang tak ingin mengobrol juga."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouseRepeatable01[3]"
    }
    {
      Id = "MelinoeField_5357"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Pegal-pegal selalu begitu."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouseRepeatable01[3]"
    }
    {
      Id = "MelinoeField_5358"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Oh, aku akan tetap di sini."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouseRepeatable01[3]"
    }
    {
      Id = "MelinoeField_5359"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Garam Mandi ini luar biasa khasiatnya."
      Speaker = "Melinoe"
      Event = "HeraclesBathHouseRepeatable01[3]"
    }
    {
      Id = "Heracles_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak pernah melihatku, aku tak pernah melihatmu. Enyahlah."
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[4]"
    }
    {
      Id = "Heracles_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pikir kau mengenalku, Saudari. Nyatanya tidak."
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[4]"
    }
    {
      Id = "Heracles_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang hendak kau katakan padaku, batalkan saja."
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[4]"
    }
    {
      Id = "Heracles_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak pernah melihatku."
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[4]"
    }
    {
      Id = "Heracles_0579"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang berurusan denganmu."
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[4]"
    }
    {
      Id = "Heracles_0581"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sampai jumpa lagi."
      Speaker = "Heracles"
      Event = "HeraclesBathHouseRepeatable01[4]"
    }
    {
      Id = "MelinoeField_0642"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama sekali bukan masalah, terima kasih."
      Speaker = "Melinoe"
      Event = "NPC_Heracles_01.GiftGivenVoiceLines"
    }
    {
      Id = "MelinoeField_5660"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan di dalam tidurku pun masih membanting tulang..."
      Speaker = "Melinoe"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "MelinoeField_5661"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tiada istirahat bagi Heracles, bahkan di alam mimpi sekalipun..."
      Speaker = "Melinoe"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Melinoe_1096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam sejahtera, Tuan."
      Speaker = "Melinoe"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Melinoe_1097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam."
      Speaker = "Melinoe"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau rupanya."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau lagi."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau datang tepat waktu..."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0046"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau datang tepat waktu."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0048"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tugas kita tak pernah ada habisnya."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jalan kita selalu bersilangan, ya."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0050"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali berburu kejayaan, heh?"
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang penyihir kembali..."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0052"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari mana asalmu?"
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cuma kau saja, ya?"
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa saja itu kau tadi."
      Speaker = "Heracles"
      Event = "NPC_Heracles_01.EntranceVoiceLines"
    }
    {
      Id = "Heracles_0433"
