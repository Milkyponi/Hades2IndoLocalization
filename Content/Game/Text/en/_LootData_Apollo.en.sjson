{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _LootData_Apollo.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "Melinoe_0168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu dia..."
      Speaker = "Melinoe"
      Event = "ApolloUpgrade.FirstSpawnVoiceLines"
    }
    {
      Id = "Melinoe_0229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia di sini..."
      Speaker = "Melinoe"
      Event = "ApolloUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1470"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepupu..."
      Speaker = "Melinoe"
      Event = "ApolloUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apollo..."
      Speaker = "Melinoe"
      Event = "ApolloUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_3124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apollo...!"
      Speaker = "Melinoe"
      Event = "ApolloUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Apollo_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehm{#Prev}, salam, Sepupuku yang terhormat! Aku di sini bersama sosok pembawa guntur dan kilat, Sang Raja Olympus yang murah hati, Paman Agungmu sekaligus ayahandaku yang termasyhur, Zeus!"
      Speaker = "Apollo"
      Event = "ApolloWithZeus01"
    }
    {
      Id = "Zeus_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}haha{#Prev}, keponakanku dan aku sudah jauh melampaui formalitas semacam itu, Putraku! Namun mumpung dia menemani kita, bagaimana kalau kita tunjukkan padanya cara memasukkan {#Emph}cahaya {#Prev}ke dalam {#Emph}kilat?"
      Speaker = "Zeus"
      Event = "ApolloWithZeus01"
    }
    {
      Id = "Apollo_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau menungguku, Mentari, tapi ibu tiri tiriku yang {#Emph}mulia{#Prev}, sang Ratu, ingin bicara sepatah dua kata! Sekarang juga... jadi sebaiknya aku menyingkir dulu, ya?"
      Speaker = "Apollo"
      Event = "ApolloWithHera01"
    }
    {
      Id = "Hera_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lihat sendiri, Sayang? Masih ada yang menunjukkan rasa hormat sepantasnya kepada Ratu mereka di Olympus ini. Jangan berusaha mencari cinta dari rakyatmu; buatlah mereka sedikit takut padamu."
      Speaker = "Hera"
      Event = "ApolloWithHera01"
    }
    {
      Id = "Apollo_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepupu, paman kita dan aku baru saja berdebat tentang apa yang harus dilakukan pada manusia fana yang telah berpaling dari kita... Menurutku wabah setahun penuh sudah cukup impas! Tapi, Yang Mulia Poseidon di sini merasa lebih penting untuk {#Emph}beraksi besar-besaran..."
      Speaker = "Apollo"
      Event = "ApolloWithPoseidon01"
    }
    {
      Id = "Poseidon_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa kau {#Emph}tidak {#Prev}beraksi besar-besaran kalau ada kesempatan, keponakanku yang lembut? Akan kuguncang bumi ini begitu dahsyat sampai menelan semua manusia fana menyebalkan itu, dan melemparkan mereka tepat ke pelukan sepupumu yang jelita di sana!"
      Speaker = "Poseidon"
      Event = "ApolloWithPoseidon01"
    }
    {
      Id = "Apollo_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami semua di sini ingin kau berhasil, Sepupu, terutama Yang Mulia Demeter... Aku teringat kalau kau ini cucunya. {#Emph}Ehm{#Prev}, tunggu, beliau ingin bicara sendiri denganmu!"
      Speaker = "Apollo"
      Event = "ApolloWithDemeter01"
    }
    {
      Id = "Demeter_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas jasa bicaramu, Apollo. Jika aku membutuhkannya lagi, akan kuberi tahu. Untuk saat ini, cucuku membutuhkan kemampuan kita, bukan kata-kata manis."
      Speaker = "Demeter"
      Event = "ApolloWithDemeter01"
    }
    {
      Id = "Apollo_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku, {#Emph}ehm{#Prev}, lupa mau bicara apa, Sepupu, soalnya Aphrodite di sini tampaknya tak paham arti {#Emph}obrolan empat mata. {#Prev}Bunda Dewi, apa kau mau ikut bergabung?"
      Speaker = "Apollo"
      Event = "ApolloWithAphrodite01"
    }
    {
      Id = "Aphrodite_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, Apollo tersayang, {#Emph}tentu saja{#Prev}, aku {#Emph}selalu {#Prev}tertarik ikut obrolanmu, {#Emph}terutama {#Prev}yang empat mata! Dan apa ada yang bisa menyalahkanku? Bagaimanapun juga, cinta dan hangatnya mentari itu ditakdirkan bersama!"
      Speaker = "Aphrodite"
      Event = "ApolloWithAphrodite01"
    }
    {
      Id = "Apollo_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, Sepupu, satu kesamaanmu dengan Hephaestus adalah kalian berdua jarang terpapar sinar matahari! Aku sering mencoba membujuknya keluar dari gua, dan meski biasanya gagal, tidak untuk kali {#Emph}ini!"
      Speaker = "Apollo"
      Event = "ApolloWithHephaestus01"
    }
    {
      Id = "Hephaestus_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahlah, Sobat, sebelum si penyihir kecil sadar dengan tipu muslihatmu! Sekarang buat dirimu berguna di sini, sebelum kuhantamkan palu ini tepat ke tempat yang {#Emph}tak pernah {#Prev}terpapar sinar mentarimu!"
      Speaker = "Hephaestus"
      Event = "ApolloWithHephaestus01"
    }
    {
      Id = "Apollo_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hestia yang Agung telah bergabung bersama kita, Sepupu! Baru kembali dari perjalanannya keliling dunia, untuk meminjamkan kebijaksanaannya di saat kita membutuhkan. Di mana api perapiannya menyala, di situ pula kau 'kan temukan cahayaku. Dan bersama-sama, kita bisa, {#Emph}oh—!"
      Speaker = "Apollo"
      Event = "ApolloWithHestia01"
    }
    {
      Id = "Hestia_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, diamlah, Anak Emas, kita tak ada waktu untuk basa-basi megah begini! Daripada begitu, bagaimana kalau kita tunjukkan pada sepupu kecilmu di sana cara menerangi malam? Tak pantas membiarkannya berkeliaran dalam gelap!"
      Speaker = "Hestia"
      Event = "ApolloWithHestia01"
    }
    {
      Id = "Apollo_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ares dan aku baru saja mengobrol soal bagaimana kita bisa begitu akur saat berada di pihak yang sama dalam perang. Jadi, Saudaraku, apakah ini semua hanya siasat rumit untuk mendekatkan kita?"
      Speaker = "Apollo"
      Event = "ApolloWithAres01"
    }
    {
      Id = "Ares_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir ini hanya karena perang sejati memunculkan sisi terbaik dari kita semua; bahkan pada dirimu, Apollo, dan juga padaku. Kerasnya konflik menempa ikatan yang tak terpatahkan! Dan melahirkan berkah yang luar biasa."
      Speaker = "Ares"
      Event = "ApolloWithAres01"
    }
    {
      Id = "Melinoe_0630"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya sebuah mantra, ini hanya mantra biasa. Sepuluh kata... {#Emph}Atas nama Hades! Olympus, kuterima pesan ini!"
      Speaker = "Melinoe"
      Event = "ApolloFirstPickUp"
    }
    {
      Id = "Apollo_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salam dari Olympus dan senang bertemu denganmu, Mentari! Dengar, kami tak bisa menjangkau sang Titan, tapi jika kau benar-benar berniat menghentikannya, setidaknya aku bisa menerangi jalanmu ke bawah sana."
      Speaker = "Apollo"
      Event = "ApolloFirstPickUp"
    }
    {
      Id = "Apollo_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tampak agak kurang sehat, Mentari. Seharusnya aku ini dewa penyembuhan, tapi bahkan aku pun tak bisa banyak membantumu dalam kondisimu yang sekarang. Namun biar kulihat apa yang bisa kulakukan."
      Speaker = "Apollo"
      Event = "ApolloLowHealth01"
    }
    {
      Id = "Apollo_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, kau tampak payah, Sepupu. Entah kau terlalu memaksakan diri, atau musuhmu berhasil mendaratkan terlalu banyak serangan. Mungkin dua-duanya. Berhati-hatilah, ya?"
      Speaker = "Apollo"
      Event = "ApolloLowHealth02"
    }
    {
      Id = "Apollo_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa dibilang aku ini tabib, Mentari, dan menurut pendapat profesionalisku, tanda-tanda vitalmu sedang tidak prima saat ini. Meski begitu, mungkin kita masih bisa mengembalikan kebugaranmu..."
      Speaker = "Apollo"
      Event = "ApolloLowHealth03"
    }
    {
      Id = "Apollo_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, sepertinya aku datang terlambat, padahal kau pasti butuh bantuanku sebelum dihajar habis-habisan seperti itu. Bertahanlah, oke?"
      Speaker = "Apollo"
      Event = "ApolloLowHealth04"
    }
    {
      Id = "Apollo_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru mau beraksi malam ini, ya, Mentari? Entah bagaimana denganmu, tapi aku punya firasat bagus tentang apa yang akan terjadi!"
      Speaker = "Apollo"
      Event = "ApolloRunStart01"
    }
    {
      Id = "Apollo_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam masih panjang, dan aku sudah menemukanmu. Jangan-jangan bakat melacak saudariku mulai menular padaku, ya?"
      Speaker = "Apollo"
      Event = "ApolloRunStart02"
    }
    {
      Id = "Apollo_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebelum kau melesat ke medan laga demi meraih kejayaan sekali lagi, silakan, terimalah ini! Dan semoga berkah ini membantumu di setiap langkahmu malam ini."
      Speaker = "Apollo"
      Event = "ApolloRunStart03"
    }
    {
      Id = "Apollo_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir kau butuh sedikit persiapan ekstra ini sebelum berangkat berjuang lagi dengan sungguh-sungguh, Sepupu! Sedikit kepastian tambahan agar kau bisa sampai ke ujung perjalanan."
      Speaker = "Apollo"
      Event = "ApolloRunStart04"
    }
    {
      Id = "Apollo_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Manfaatkan waktumu sebaik-baiknya, Mentari. Sang Titan mengira dia telah menyudutkan kami, tapi situasi di sini masih terkendali! Kami hanya sedang terjebak dalam jalan buntu, itu saja."
      Speaker = "Apollo"
      Event = "ApolloAboutTitanWar01"
    }
    {
      Id = "Apollo_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aargh{#Prev}, perang terkutuk ini. Menyisakan sedikit sekali waktu untuk musik atau puisi atau kesenangan hidup lainnya. Yah, meski begitu, setidaknya ini membuat keluarga kita makin dekat!"
      Speaker = "Apollo"
      Event = "ApolloAboutTitanWar02"
    }
    {
      Id = "Apollo_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos sedang merencanakan sesuatu, tapi Athena pun tak tahu apa itu. Serangannya ke Olympus selalu gagal, meski berhasil membuat kami terus sibuk. Apa langkah dia selanjutnya...?"
      Speaker = "Apollo"
      Event = "ApolloAboutChronos01"
    }
    {
      Id = "Apollo_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak disangka kita akan berperang melawan kakek kita sendiri. Bukannya kita harus mengakuinya juga, sih. Dia adalah aib bagi garis keturunan kita; Titan yang penuh kebencian, bukan dewa. Bukan keluarga."
      Speaker = "Apollo"
      Event = "ApolloAboutChronos02"
    }
    {
      Id = "Apollo_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadinya kuharap si tua Chronos dan antek-anteknya sudah sadar dan melihat cahaya sekarang, tapi sayang sekali. Terpaksa kita harus terus menyorotkannya ke wajah mereka untuk sementara waktu."
      Speaker = "Apollo"
      Event = "ApolloAboutChronos03"
    }
    {
      Id = "Apollo_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil memberi hantaman telak ke pasukan sang Titan, tapi mereka mulai berkumpul lagi. Tetap saja, kemenangan seperti ini pasti mengguncang mereka sampai ke intinya. Ayo kita pukul mundur mereka!"
      Speaker = "Apollo"
      Event = "ApolloAboutChronosBossW01"
    }
    {
      Id = "Apollo_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata mereka kau berhasil menghabisi Chronos, benarkah begitu, Mentari? Setidaknya tadi malam, tapi ya begitulah para Titan abadi! Tak pernah bisa tumbang lama-lama. Meski konon kau punya rencana khusus untuk itu, kata saudariku..."
      Speaker = "Apollo"
      Event = "ApolloAboutChronosBossW02"
    }
    {
      Id = "Apollo_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernahkah kau membayangkan betapa luar biasa raksasanya Typhon, sang Ayah Para Monster, sebenarnya? Yah, kau hanya perlu berkunjung ke sini dan kau akan tahu sendiri! Sampai saat itu tiba, {#Emph}ehm{#Prev}, kita... harus terus menahannya!"
      Speaker = "Apollo"
      Event = "ApolloAboutTyphon01"
    }
    {
      Id = "Apollo_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menilai dari semua raungan penuh dendamnya, Typhon pasti membenci ayahku hampir sebesar kebencian Chronos. Tapi apa mereka benar-benar bekerja sama? Monster seperti itu mustahil mau menerima perintah dari seorang Titan, atau siapa pun."
      Speaker = "Apollo"
      Event = "ApolloAboutTyphon02"
    }
    {
      Id = "Apollo_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih belum sepenuhnya percaya kau {#Emph}berhasil membekuknya{#Prev}, Mentari! Typhon seharusnya butuh gabungan kekuatan seluruh keluarga kita, dan secara tak langsung memang begitu, hanya saja... kami semua sibuk menahan serbuan pasukannya. Dia benar-benar menguras habis tenaga kita."
      Speaker = "Apollo"
      Event = "ApolloAboutTyphonW01"
    }
    {
      Id = "Apollo_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika Typhon terus kembali, lama-lama mungkin tak ada lagi gunung yang tersisa untuk didaki di sini. Aku tahu ayahku dan Ratu Hera punya rencana darurat jika situasi kian memburuk, tapi aku lebih optimis dengan rencana apa pun yang sedang kau siapkan..."
      Speaker = "Apollo"
      Event = "ApolloAboutTyphonW02"
    }
    {
      Id = "Apollo_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita seharusnya bisa menahan Typhon sedikit lebih lama, terutama sekarang setelah kau menunjukkan cara {#Emph}beresnya{#Prev}, Mentari. Kau berniat memburu Chronos sekarang, kan? Yah, menyingkirkan {#Emph}dia {#Prev}jelas akan sangat membantu."
      Speaker = "Apollo"
      Event = "ApolloAboutTyphonW03"
    }
    {
      Id = "Apollo_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau bukan tipe yang suka mengeluh, tapi pasti tak mudah bagimu berada di Istana ini tepat saat Fajar menyingsing... kemungkinan cahayanya jauh lebih terang dari yang biasa kau lihat. Kami pun hampir tak terbiasa lagi akibat badai-badai Typhon."
      Speaker = "Apollo"
      Event = "ApolloAboutPalace01"
    }
    {
      Id = "Apollo_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos pasti mengira tak ada yang bisa menghentikannya jika ia melepaskan Typhon, tapi dugaannya salah besar. Ayo kerahkan segalanya yang kita punya dan selesaikan ini, Mentari."
      Speaker = "Apollo"
      Event = "ApolloAboutTyphonDeath01"
    }
    {
      Id = "Apollo_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi sekarang kita berusaha mencegah {#Emph}kemungkinan {#Prev}Typhon bisa menguasai tempat ini? Dan pasukan Titan entah bagaimana menjadi bagian dari rencana baru ini. Yah, kalau kau ikut, {#Emph}aku {#Prev}juga ikut. Ini bakal bikin malam-malamku sedikit lebih seru!"
      Speaker = "Apollo"
      Event = "ApolloAboutTyphonDeath02"
    }
    {
      Id = "Apollo_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berlatih di bawah bimbingan Hecate, sang Penyihir Persimpangan Jalan? Beliau sangat dihormati di sini, meski tentu saja kami sudah lama tak bertemu dengannya. Akhir-akhir ini aku sering mencela para Titan, tapi ini mengingatkanku bahwa tak semuanya jahat."
      Speaker = "Apollo"
      Event = "ApolloAboutHecate01"
    }
    {
      Id = "Apollo_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudariku Artemis juga pernah berlatih bersama Hecate, lho! Berlatih tentang {#Emph}apa{#Prev}, aku sama sekali tak tahu. Aku masih ingat bagaimana mereka melolong di malam hari seperti sekawanan serigala, {#Emph}heh{#Prev}. Sejujurnya agak bikin merinding!"
      Speaker = "Apollo"
      Event = "ApolloAboutSilverSisters01"
    }
    {
      Id = "Apollo_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah begitu dekat dengan ayahmu, tapi kurasa kau juga sama. Beliau selalu tampak suram di mataku, meski beliau tampaknya sangat peduli pada keluarganya sendiri. Keadilan akan berpihak padanya kelak."
      Speaker = "Apollo"
      Event = "ApolloAboutHades01"
    }
    {
      Id = "Apollo_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira keadaan tak bisa lebih genting lagi dari ini, tapi jika sang Tiga Takdir benar-benar lenyap, maka... ramalan mereka tentang masa depan mungkin takkan terwujud. Mereka meramalkan takhta abadi keluarga kita atas dunia ini... bagaimana jika mereka salah?"
      Speaker = "Apollo"
      Event = "ApolloAboutFates01"
    }
    {
      Id = "Apollo_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan jika kau berhasil menyadarkan Chronos, sang Tiga Takdir masih saja hilang. Dan kita diminta percaya bahwa dia tak tahu di mana mereka berada? Mustahil ini yang mereka inginkan atau ramalkan..."
      Speaker = "Apollo"
      Event = "ApolloAboutFates02"
    }
    {
      Id = "Apollo_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami akan terus bertahan di puncak gunung ini, selama kau juga terus bertahan... di mana pun kau berada saat ini! Jaga dirimu baik-baik, ya?"
      Speaker = "Apollo"
      Event = "ApolloAboutOlympus01"
    }
    {
      Id = "Apollo_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, kau sudah berada tepat di Olympus sekarang, Mentari! Begitu dekat dengan kami, meski aku sadar betul yang terburuk menantimu di depan sana. Untungnya, aku punya yang terbaik untukmu di sini!"
      Speaker = "Apollo"
      Event = "ApolloAboutOlympus02"
    }
    {
      Id = "Apollo_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak percaya kita membiarkan para Satir itu menyerbu lereng gunung kita... serahkan pada Dionysus untuk mencoba berteman dengan mereka, tapi aku tak seberuntung itu, percayalah."
      Speaker = "Apollo"
      Event = "ApolloAboutOlympus03"
    }
    {
      Id = "Apollo_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dunia kita pernah melewati masa-masa yang lebih buruk dari {#Emph}ini{#Prev}, Sepupu! Setidaknya begitu kata mereka, aku sendiri belum pernah melihat yang seburuk ini. Namun tetap saja, ini bukan hal yang tak bisa kita atasi, kan?"
      Speaker = "Apollo"
      Event = "ApolloAboutHardTimes01"
    }
    {
      Id = "Apollo_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat Artemis pertama kali menceritakan kisahmu, kukira itu cuma salah satu leluconnya. Menghadapi sang Titan sendirian, {#Emph}yang benar saja{#Prev}. Tapi hal itu {#Emph}memang {#Prev}terdengar seperti sesuatu yang akan dicoba oleh anak Hades yang penuh dendam..."
      Speaker = "Apollo"
      Event = "ApolloAboutMelinoe01"
    }
    {
      Id = "Apollo_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau bisa memilih racunmu sendiri antara memburu Chronos di Dunia Bawah, atau datang menyelamatkan kami di sini! Sejujurnya sempat ada perdebatan tentang mana ide yang lebih cemerlang. Tapi, kau pasti tahu apa yang kau lakukan lebih baik daripada kami."
      Speaker = "Apollo"
      Event = "ApolloAboutRouteChoice01"
    }
    {
      Id = "Apollo_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau seorang penyihir, ya? Keahlian yang menarik. Kata-kata pembuat sihirmu memiliki irama dan kekuatan tersendiri. Puisi pun hampir sama persis! Bedanya, sihir puisi hanya memikat hati."
      Speaker = "Apollo"
      Event = "ApolloAboutWitchcraft01"
    }
    {
      Id = "Apollo_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Orang sering bilang tak ada yang baru di bawah matahari, tapi aku belum pernah melihat senjata seperti yang kau genggam itu! Persenjataan Malam yang legendaris, kata Hephaestus. Benda yang luar biasa!"
      Speaker = "Apollo"
      Event = "ApolloAboutHiddenAspects01"
    }
    {
      Id = "Apollo_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para manusia fana memandang kita untuk mencari bimbingan dan inspirasi. Mereka pasti {#Emph}ngeri {#Prev}melihat apa yang terjadi akhir-akhir ini! Separuh dari mereka tampaknya menentang kita sekarang. Semoga separuh {#Emph}lainnya {#Prev}yang tersisa begitu semua ini berakhir."
      Speaker = "Apollo"
      Event = "ApolloAboutMortals01"
    }
    {
      Id = "Apollo_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk kaum yang begitu penakut, manusia fana sungguh suka saling membantai! Pernah ada perang di antara mereka dulu yang bahkan membuat kami para dewa saling bermusuhan. Aku mencoba menyelesaikannya dengan wabah dan panah, tapi {#Emph}tidak! {#Prev}Ayah ingin membiarkannya berjalan sampai tuntas."
      Speaker = "Apollo"
      Event = "ApolloAboutMortals02"
    }
    {
      Id = "Apollo_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini aku diingatkan kembali betapa rapuhnya manusia fana... Aku tak pernah lagi membiarkan diriku terikat dengan mereka. Mereka bisa sangat mirip dengan kita, bahkan indah rupawan, tapi menyaksikan mereka mati sungguh menyayat hati. Kematian mereka bahkan bukan akhir segalanya, tapi lagak mereka seperti kiamat saja!"
      Speaker = "Apollo"
      Event = "ApolloAboutMortals03"
    }
    {
      Id = "Apollo_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu ingin melihat Kediaman Hades, meski ayah dan ibumu punya pengawal kerajaan yang {#Emph}mungkin {#Prev}pernah kukirim ke alam mereka sebelum waktunya. Bakal canggung sekali kalau kita berpapasan di sana..."
      Speaker = "Apollo"
      Event = "ApolloAboutHouse01"
    }
    {
      Id = "Apollo_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak suka terseret ke dalam perseteruan remeh keluarga kita, apalagi dengan generasi tua yang tampaknya tak punya kerjaan lain yang lebih baik. Tapi kau dan aku tak bisa tinggal diam begitu saja, kan?"
      Speaker = "Apollo"
      Event = "ApolloAboutFamily01"
    }
    {
      Id = "Apollo_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pantas saja Chronos membenci kita, bukan? Harus diakui kita punya beberapa kepribadian yang menyebalkan di sini, tapi terlepas dari semua keanehan kita, kita adalah keluarga; dan kita saling mendukung. Hal yang takkan pernah dipahami oleh para Titan."
      Speaker = "Apollo"
      Event = "ApolloAboutFamily02"
    }
    {
      Id = "Apollo_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Agak malu mengakui bahwa aku adalah dewa ramalan, di samping segala hal lainnya. Aku seharusnya melihat prahara Titan ini datang! Tapi aku luput... dan si tua Chronos berhasil mengejutkan kita."
      Speaker = "Apollo"
      Event = "ApolloAboutProphecy01"
    }
    {
      Id = "Apollo_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagai dewa ramalan, aku yakin kita akan berhasil. Bagaimana tepatnya, aku tak bisa memastikan. Ya begitulah ramalan! Hal yang menyebalkan dan bikin frustrasi hampir setiap saat."
      Speaker = "Apollo"
      Event = "ApolloAboutProphecy02"
    }
    {
      Id = "Apollo_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahaya seperti apa yang bisa kuberikan padamu hari ini? Aku punya cahaya tajam, cahaya lembut, cahaya menyilaukan, cahaya terakhir yang dilihat manusia fana... sebut saja maumu!"
      Speaker = "Apollo"
      Event = "ApolloAboutLight01"
    }
    {
      Id = "Apollo_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pernah berpikir apa sebenarnya cahaya itu, Sepupu? Tak bisa digenggam, tak ada bobotnya sama sekali, namun ada di sekeliling kita! Misteri yang nyata... Aku menunggu para manusia fana mencari tahu jawabannya!"
      Speaker = "Apollo"
      Event = "ApolloAboutLight02"
    }
    {
      Id = "Apollo_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lebih menyukai malam hari, kan, Mentari? Sudah terbiasa dengan kegelapan. Kalau aku, tipe yang suka terangnya siang bolong, tapi ya sudahlah, selera orang kan beda-beda."
      Speaker = "Apollo"
      Event = "ApolloAboutLight03"
    }
    {
      Id = "Apollo_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah bagaimana caramu bertahan selama ini tanpa secuil pun cahaya di bawah sana. Dunia yang berbeda, kurasa, tapi terkadang hal-hal baik terjadi saat dunia-dunia itu saling bersinggungan."
      Speaker = "Apollo"
      Event = "ApolloAboutLight04"
    }
    {
      Id = "Apollo_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau lahir dan dibesarkan di sebuah rimbun terpencil di bawah sana? Tanpa kemewahan, tanpa pemuja fana... begitu banyak kenikmatan hidup yang harus kau kejar begitu masalah buruk ini selesai."
      Speaker = "Apollo"
      Event = "ApolloAboutCrossroads01"
    }
    {
      Id = "Apollo_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira apa yang bisa dilakukan untuk bersenang-senang di Erebus sana, saat seseorang sedang tidak berlatih keras untuk membasmi Titan keji dan sejenisnya. Pasti ada sesuatu..."
      Speaker = "Apollo"
      Event = "ApolloAboutErebus01"
    }
    {
      Id = "Apollo_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di antah berantah mana kau sekarang, mentariku? Rasanya seperti kau berada di dasar laut. Di mana pun itu, tempatnya gelap gulita, dan seperti yang kau tahu, aku selalu punya obat untuk itu."
      Speaker = "Apollo"
      Event = "ApolloAboutOceanus01"
    }
    {
      Id = "Apollo_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sedang berada di Padang Ratapan. Aku penasaran apakah Hyacinth tumbuh di sana... bunga dari seorang pangeran lembut yang telah lama tiada. Begitu Dunia Bawah terbuka kembali, mungkin aku bisa pergi mencarinya."
      Speaker = "Apollo"
      Event = "ApolloAboutFields01"
    }
    {
      Id = "Apollo_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi langit, kau berhasil mencapai {#Emph}permukaan{#Prev}, kan, mentariku? Kupikir garis keturunanmu membuatmu tak bisa hidup di atas sini...?"
      Speaker = "Apollo"
      Event = "ApolloAboutSurface01"
    }
    {
      Id = "Apollo_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Permukaan dulu jauh lebih menyenangkan. Tapi semenjak pengepungan itu, Paman Poseidon habis-habisan membalas dengan gempa dan bencana dahsyat. Mengaduk-aduk daratan seolah itu mangkuk adonannya."
      Speaker = "Apollo"
      Event = "ApolloAboutSurface02"
    }
    {
      Id = "Apollo_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepupu, bukankah kau sedang menuju Olympus terakhir kali kuperiksa? Pasti sempat dihadang oleh para kroco Titan itu. Yah, jangan menyerah! Walau kurasa kau takkan ada di sana andai kau menyerah."
      Speaker = "Apollo"
      Event = "ApolloAboutSurface03"
    }
    {
      Id = "Apollo_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana perjalananmu kemari, mentariku? Andai saja kami bisa membawamu terbang dengan cara yang lebih berkelas dewa, tapi langit sama berbahayanya dengan lautan... kurasa kau juga sudah menyadarinya."
      Speaker = "Apollo"
      Event = "ApolloAboutThessaly01"
    }
    {
      Id = "Apollo_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti sedang berada di kota Ephyra di sebelah barat, markas pergerakan musuh kita... dengan gerbang Dunia Bawah yang terbuka lebar, Chronos bisa mengisi kembali pasukannya lebih cepat daripada kita membantai mereka."
      Speaker = "Apollo"
      Event = "ApolloAboutEphyra01"
    }
    {
      Id = "Apollo_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Emm{#Prev}, situasi gawat mulai terjadi di sini. Sebuah retakan raksasa menganga di kaki gunung, dan ada sesuatu di dalamnya... sesuatu yang amat besar. Dan benda itu {#Emph}bernapas... {#Prev}kira-kira dia ramah tidak, ya...?"
      Speaker = "Apollo"
      Event = "ApolloAboutSurfaceThreat01"
    }
    {
      Id = "Apollo_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku suka menjadi dewa banyak hal. Ada cahaya, puisi, musik, penyembuhan... begitu banyak kegemaran, dan seluruh waktu di dunia ini. Kenapa harus puas hanya dengan menempa besi atau semacamnya?"
      Speaker = "Apollo"
      Event = "ApolloAboutPassions01"
    }
    {
      Id = "Apollo_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artemis bilang kau cukup berbakat dalam bermusik! Bakat turun-temurun, bahkan orang tuamu pun punya telinga yang peka untuk nada, mengingat Orpheus adalah musisi istana mereka. Dia murid terbaik yang pernah kuajari!"
      Speaker = "Apollo"
      Event = "ApolloAboutMusic01"
    }
    {
      Id = "Apollo_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, mentariku... bagaimana kalau kita sudahi basa-basinya dan kuberi kau sesuatu yang luar biasa berkilau kali ini. Coba lihat ini!"
      Speaker = "Apollo"
      Event = "ApolloLegendaryPickUp01"
    }
    {
      Id = "Apollo_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak ada satu dewa pembalasan dendam pun di Olympus, karena kita semua terkadang membagi tanggung jawab itu bersama-sama. Majulah, rebut kembali apa yang menjadi hakmu."
      Speaker = "Apollo"
      Event = "ApolloLegendaryPickUp02"
    }
    {
      Id = "Apollo_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahku Zeus sudah menghubungimu, ya? Menghadiahkan {#Emph}berkah-Nya{#Prev}, maksudku! Minatnya memang condong ke banyak hal. Tapi begitu kekuasaan kami diancam, atau bahkan dihina, tak ada yang membalas lebih sengit darinya."
      Speaker = "Apollo"
      Event = "ApolloAboutZeus01"
    }
    {
      Id = "Apollo_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di balik pembawaan Paman Poseidon yang ramah, tersimpan keganasan yang kupelajari untuk kuhindari baik-baik. Jika dia telah menyokongmu dengan kekuatan samudranya, kau berada di pihak yang untung. Manfaatkanlah sebaik-baiknya!"
      Speaker = "Apollo"
      Event = "ApolloAboutPoseidon01"
    }
    {
      Id = "Apollo_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saran dariku soal Lady Aphrodite yang terhormat? Jangan sampai teralihkan. Dia memang bicara soal cinta dan keindahan, tapi dia sama sekali tak asing dengan pertikaian. Mungkin kekuatanku bisa mengimbangi kuasanya."
      Speaker = "Apollo"
      Event = "ApolloAboutAphrodite01"
    }
    {
      Id = "Apollo_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kau sudah bertemu ibu tiriku, ya? Aku cukup beruntung merasa dicintai, tapi Hera, yah, aku bukan anak emasnya. Selama tak ada yang membuatnya percaya bahwa kau adalah anak Zeus, kau akan baik-baik saja."
      Speaker = "Apollo"
      Event = "ApolloAboutHera01"
    }
    {
      Id = "Apollo_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kau berhasil membuat Hestia tua keluar dari sarangnya! Biasanya dia sama sekali tak mau berurusan dengan kami, tapi urusan Chronos ini benar-benar membuatnya naik darah. Baguslah kalau begitu!"
      Speaker = "Apollo"
      Event = "ApolloAboutHestia01"
    }
    {
      Id = "Apollo_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat Artemis pertama kali menceritakan tentangmu, aku langsung teringat pada Demeter. Dia tak bisa hadir untuk ibumu saat Chronos menyerang, tapi aku tahu dia akan melakukan segalanya demi membantumu."
      Speaker = "Apollo"
      Event = "ApolloAboutDemeter01"
    }
    {
      Id = "Apollo_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hephaestus sedang bekerja keras demi pertahanan kita, jadi aku senang kau sudah mendengar kabar darinya. Jangan salah paham dengan sikapnya yang ketus! Dia jarang keluar, apalagi akhir-akhir ini."
      Speaker = "Apollo"
      Event = "ApolloAboutHephaestus01"
    }
    {
      Id = "Apollo_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rahasia di antara kita saja ya, aku belum pernah melihat Ares sebahagia belakangan ini. Dan aku mungkin bisa menebak alasannya. Perang yang sedang kita kobarkan ini... benar-benar mahakarya baginya."
      Speaker = "Apollo"
      Event = "ApolloAboutAres01"
    }
    {
      Id = "Apollo_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya saudara tiriku Ares akhirnya menampakkan batang hidungnya. Aku sempat ragu apakah dia akan muncul! Yah, walau mungkin dulu dia juga meragukan hal yang sama tentangku..."
      Speaker = "Apollo"
      Event = "ApolloAboutAres02"
    }
    {
      Id = "Apollo_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sampai di sana lebih cepat dari dugaan, yang berarti kau mungkin mendapat sedikit dorongan dari Hermes! Dia memang gesit, tapi aku tak pernah bisa mendapat jawaban langsung darinya tentang apa pun..."
      Speaker = "Apollo"
      Event = "ApolloAboutHermes01"
    }
    {
      Id = "Apollo_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang kupikir Hermes pasti masih berkeliaran di Dunia Bawah seperti dulu, karena akhir-akhir ini aku sama sekali tak bisa menemukannya di mana pun. Dia juga sangat tertutup padaku! Dasar pembawa pesan."
      Speaker = "Apollo"
      Event = "ApolloAboutHermes02"
    }
    {
      Id = "Apollo_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa mengandalkan sebagian besar dari kami, tapi aku tak bisa menjamin Dionysus; bahkan aku tak tahu dia di mana! Aku suka pesta pora sama seperti yang lain di saat yang tepat, tapi dewa anggur itu menganggap saat yang tepat adalah {#Emph}setiap {#Prev}saat."
      Speaker = "Apollo"
      Event = "ApolloAboutDionysus01"
    }
    {
      Id = "Apollo_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih belum ada tanda-tanda dari Dionysus. Aku pasti cemas andai itu bukan dia, tapi dia memang selalu bersikap begini. Terkadang aku {#Emph}tak habis pikir {#Prev}kita ini bersaudara. Aku ingin sedikit keteraturan di sini, sementara dia maunya kebalikannya."
      Speaker = "Apollo"
      Event = "ApolloAboutDionysus02"
    }
    {
      Id = "Apollo_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlihat semakin memesona, Sepupu. Berselimutkan cahaya rembulan... kau bekerja sama dengan Selene, kan? Padahal kukira dia terlalu sibuk berderap melintasi langit untuk membantu kita..."
      Speaker = "Apollo"
      Event = "ApolloAboutSelene01"
    }
    {
      Id = "Apollo_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terik siang hari {#Emph}bisa {#Prev}sedikit menyengat, jadi beruntunglah Bulan menawarkan alternatif yang begitu menyejukkan. Kilau Selene mungkin lebih sesuai dengan seleramu, itu pun kalau kau bisa melihatnya dari sana..."
      Speaker = "Apollo"
      Event = "ApolloAboutSelene02"
    }
    {
      Id = "Apollo_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika Artemis bersikap ketus atau tak sopan padamu, kumohon jangan dimasukkan ke hati. Dia memang begitu pada semua orang. Selalu menjadi penyendiri, dan kami tak pernah tahu di mana dia berada saat kami membutuhkannya."
      Speaker = "Apollo"
      Event = "ApolloAboutArtemis02"
    }
    {
      Id = "Apollo_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari tiriku Athena mengenal kakakmu dengan sangat baik, dan dia menyampaikan salam hangatnya. Dia sedang sibuk mengurus pertahanan kita, memimpin pasukan garis depan dan segalanya! Dia menyesal tak bisa membantumu secara langsung saat ini."
      Speaker = "Apollo"
      Event = "ApolloAboutAthena01"
    }
    {
      Id = "Apollo_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kiklops buta Polyphemus menghalangi jalanmu, begitu ya? Tak tahu seberapa mempan cahayaku melawan makhluk seperti {#Emph}dia{#Prev}, tapi mungkin aku bisa membantumu tiba di sana tanpa kurang satu apa pun."
      Speaker = "Apollo"
      Event = "ApolloAboutPolyphemus01"
    }
    {
      Id = "Apollo_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami telah mengonfirmasi bahwa si {#Emph}Eris {#Prev}itu terlihat berkeliaran. Dia berasal dari alammu, bukan alam kami, jadi mungkin kau lebih tahu alasan kenapa dia muncul tanpa diundang! Yah, walau memang begitulah gayanya. Seseorang harus segera mengusirnya dari sini..."
      Speaker = "Apollo"
      Event = "ApolloAboutEris01"
    }
    {
      Id = "Apollo_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prometheus sendiri yang memimpin serangan melawan kita... salah satu dari sedikit sekutu kita di antara kaum Titan, kini menjadi musuh bebuyutan. Semua karena perlakuan kita padanya! Atau karena... dia tahu pihak mana yang akan keluar sebagai pemenang pada akhirnya..."
      Speaker = "Apollo"
      Event = "ApolloAboutPrometheus01"
    }
    {
      Id = "Apollo_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka kita membiarkan Prometheus melanjutkan serangannya seperti ini. Kerja sama yang luar biasa kita jalin, semuanya demi kau bisa mereka ulang jalur yang kau tempuh ke Typhon, lalu menghadapi sisa-sisa monster itu di puncak seperti sebelumnya...?"
      Speaker = "Apollo"
      Event = "ApolloAboutPrometheus02"
    }
    {
      Id = "Apollo_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika Prometheus benar-benar punya penglihatan masa depan bahwa semuanya akan terjadi seperti ini... mengapa menghadang jalanmu dan bertarung begitu sengit, hanya untuk dikalahkan lagi dan lagi...? Kecuali fajar era baru memang takkan pernah terbit dengan cara lain..."
      Speaker = "Apollo"
      Event = "ApolloAboutPrometheus03"
    }
    {
      Id = "Apollo_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah apa alasannya, tapi ada sesuatu tentang malam ini yang membuatku teringat kembali saat pertama kali kau menghubungiku di hutan itu. Yah, entah ada kekuatan aneh yang bermain atau hanya imajinasiku saja, kan?"
      Speaker = "Apollo"
      Event = "ApolloAboutPackageBounty01"
    }
    {
      Id = "Apollo_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau persis di luar gerbang Ephyra, kan? Kota itu sudah tak bisa diselamatkan; aku tahu mereka dulu memuja ayah dan ibumu di sana, tapi tetap saja... jika terserah padaku, aku akan menyapu bersih tempat itu dan memulai dari awal."
      Speaker = "Apollo"
      Event = "ApolloAboutPackageBounty02"
    }
    {
      Id = "Apollo_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang sangat aneh malam ini. Bukankah kita sudah pernah melewati malam yang persis seperti ini, sampai ke detail terkecilnya? Mungkin sihirmu sedang bekerja... asalkan itu bukan ulah Chronos."
      Speaker = "Apollo"
      Event = "ApolloAboutPackageBounty03"
    }
    {
      Id = "Apollo_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, bagaimana persisnya kau bisa sampai ke sana, Mentari? Terakhir kucek kau sedang melintasi tempat yang sama sekali berbeda! Tapi firasatku menyuruhku untuk mengecek {#Emph}lagi{#Prev}, dan benar saja..."
      Speaker = "Apollo"
      Event = "ApolloAboutPackagedBountyLateStart01"
    }
    {
      Id = "Apollo_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini tampaknya akan begitu gelap dan menyesakkan... bahkan jika aku bisa menerangi semua musuh yang menyergapmu, aku tak yakin kau sudi melihat mereka. Berhati-hatilah di luar sana..."
      Speaker = "Apollo"
      Event = "ApolloAboutShrine01"
    }
    {
      Id = "Apollo_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat pertama kali menghubungimu berpuluh-puluh malam lalu, kupikir, {#Emph}hei, sepupu baru! Aku suka itu! {#Prev}Namun sejujurnya aku tak pernah menyangka kau akan membawa perubahan sebesar ini. Kuharap aku sudah melakukan bagianku untuk mewujudkannya."
      Speaker = "Apollo"
      Event = "ApolloAboutRelationship01"
    }
    {
      Id = "Apollo_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aphrodite tampak sangat bersemangat untukmu... dia selalu punya cara untuk mengetahui kehidupan pribadi setiap orang, tapi jika dia memberkati hubunganmu, kau beruntung. Beberapa hubunganku dulu jelas sangat membutuhkannya..."
      Speaker = "Apollo"
      Event = "ApolloAboutRelationship02"
    }
    {
      Id = "Apollo_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tongkat mewah apa yang kau bawa itu, dengan ular melingkar di ujungnya? Aneh sekali, ini... mengingatkanku pada suatu penglihatan yang pernah kualami... tentang mahakarya yang tak bisa mencelakai siapa pun..."
      Speaker = "Apollo"
      Event = "ApolloAboutMomusAspect01"
    }
    {
      Id = "Apollo_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat, Mentari? Kapan pun kau berangkat membawa Foton Harmonis yang kau dapat dariku, aku takkan jauh di belakangmu. Dan kau akan mendapatkan rasa hangat yang nyaman sebagai bonusnya!"
      Speaker = "Apollo"
      Event = "ApolloAboutKeepsake01"
    }
    {
      Id = "Apollo_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Foton yang kuberikan padamu sudah sangat sering dimanfaatkan dengan baik, bukan? Aku tahu kau tak selalu butuh cahaya dalam kegelapan seperti kebanyakan orang lain, jadi aku senang itu bisa membantu."
      Speaker = "Apollo"
      Event = "ApolloAboutKeepsake02"
    }
    {
      Id = "Apollo_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau agak lebih mudah terlihat dengan obor kembar di tangan... meski milikmu tampaknya tak memancarkan jenis cahaya yang lazim! Sungguh, semakin banyak yang kuketahui tentangmu, semakin banyak pula pertanyaanku!"
      Speaker = "Apollo"
      Event = "ApolloAboutTorch01"
    }
    {
      Id = "Apollo_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa menahan diri untuk memperhatikan bahwa tak ada {#Emph}busur {#Prev}di gudang senjatamu! Artemis dan aku, kami berpikir untuk apa mengotori tangan kami jika kami bisa menyelesaikan urusan buruk dari jauh... meski sihirmu mungkin sudah mencukupi!"
      Speaker = "Apollo"
      Event = "ApolloAboutBows01"
    }
    {
      Id = "Apollo_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa ada begitu banyak tipu daya di dunia ini, Sepupu? Percayalah, terkadang kita butuh dewa kebenaran di sekitar sini. Senang melakukannya dan kuharap ini bisa menular."
      Speaker = "Apollo"
      Event = "ApolloPostGift01"
    }
    {
      Id = "Apollo_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kau tak keberatan kupanggil Mentari! Aku bersungguh-sungguh mengatakannya. Aku tahu kau berasal dari bawah bumi, tapi ada kecemerlangan dalam dirimu. Warisan pihak ibumu, kurasa."
      Speaker = "Apollo"
      Event = "ApolloPostGift02"
    }
    {
      Id = "Apollo_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada orang yang istimewa dalam hidupmu? Putri sepertimu pasti punya banyak pelamar dari segala penjuru. Aku sendiri punya banyak pengalaman, meski aku bukan tipe yang suka menikah, lagi pula, kurasa Hera takkan mengizinkannya..."
      Speaker = "Apollo"
      Event = "ApolloPostGift03"
    }
    {
      Id = "Apollo_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari semua Berkah yang kami tawarkan, kau telah memberi kami anugerah luar biasa sebagai imbalannya. Olympus memiliki sekutu yang kuat... yah, setidaknya kau dan Herakles! Tapi kau punya percikan semangat yang tak dimiliki orang lain."
      Speaker = "Apollo"
      Event = "ApolloPostGift05"
    }
    {
      Id = "Apollo_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya melihat sekilas, tapi caramu menghadapi kawanan itu benar-benar seindah puisi yang bergerak. Bakat memang mengalir di keluarga kita! Hanya saja beberapa dari kita kebetulan mendapat bagian yang lebih besar."
      Speaker = "Apollo"
      Event = "ApolloAboutTalent01"
    }
    {
      Id = "Apollo_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, Mentari, sekarang tinggal kita berdua lagi, setelah kau membantai setiap... apa persisnya sebutan untuk makhluk-makhluk itu? Ah, sudahlah, terimalah ini!"
      Speaker = "Apollo"
      Event = "ApolloAboutFoes01"
    }
    {
      Id = "Apollo_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat dirimu, melangkah angkuh melewati Dunia Bawah seolah tempat itu milikmu sendiri! Tapi mungkin memang begitu? Tak yakin bagaimana garis suksesi berjalan di bawah sana."
      Speaker = "Apollo"
      Event = "ApolloUnderworldRunCleared01"
    }
    {
      Id = "Apollo_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam tempo hari, kami kehilangan kontak denganmu di tingkat terdalam Dunia Bawah. Namun tak lama kemudian, musuh-musuh kita kocar-kacir, setidaknya untuk sementara. Itu ulahmu, kan? Kerja bagus!"
      Speaker = "Apollo"
      Event = "ApolloUnderworldRunCleared02"
    }
    {
      Id = "Apollo_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menemukan jejak berbahaya Chronos, sekarang giliran jejak Typhon berikutnya? Senang rasanya tak ada tanda-tanda nyata dari mereka dari tempat {#Emph}kami {#Prev}berada... selain pasukan mereka yang tercerai-berai dan kehancuran yang mereka timbulkan, tapi itu bisa dibereskan!"
      Speaker = "Apollo"
      Event = "ApolloUnderworldRunCleared03"
    }
    {
      Id = "Apollo_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rumit sekali menentukan siapa pemilik apa di atas sini. Kau tahu Helios sang Matahari? Dia kembali melintasi langit dengan kereta perangnya seolah tak ada yang berubah, tapi dia akan tersesat tanpa cahaya {#Emph}milikku! {#Prev}{#Emph}Hih{#Prev}, para Titan. Mau bagaimana lagi?"
      Speaker = "Apollo"
      Event = "ApolloAboutHelios01"
    }
    {
      Id = "Apollo_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, aku sangat senang kau akhirnya bertemu dengan saudaramu! Kalau aku, aku punya {#Emph}lebih {#Prev}dari cukup saudara, tapi jika kau tumbuh sebagai anak tunggal, kau mungkin membutuhkannya. Dan tak ada kata terlambat untuk menebus waktu yang hilang."
      Speaker = "Apollo"
      Event = "ApolloAboutZagreus01"
    }
    {
      Id = "Apollo_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebuah kehormatan dan kebahagiaan bisa menemanimu ke Persimpangan Jalan di atas kereta perak Selene, Sepupu. Balada yang kubawakan bersama Artemis... itu lagu pertama yang kami ciptakan bersama. Kami tak selalu akur, tapi kau menginspirasi kami."
      Speaker = "Apollo"
      Event = "ApolloPostTrueEnding01"
    }
    {
      Id = "Apollo_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kagum ayah kita berdua bisa mencapai kesepakatan tentang Chronos, dan {#Emph}sama sekali {#Prev}tak menyangka mereka akan mengirimnya ke Kepulauan Para Terberkati! Tempat terbaik di seluruh Dunia Bawah, setidaknya begitulah kabarnya. Semoga dia bisa menjaganya tetap begitu!"
      Speaker = "Apollo"
      Event = "ApolloPostTrueEnding02"
    }
    {
      Id = "Apollo_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagu yang kuciptakan bersama Artemis, kami menamainya {#Emph}Waktu Milik Kita. {#Prev}Kami menciptakannya saat harapan kami untuk mengalahkan Chronos mulai memudar, tapi bakat ramalanku mengatakan bahwa kami harus bertahan..."
      Speaker = "Apollo"
      Event = "ApolloPostTrueEnding03"
    }
    {
      Id = "Apollo_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meskipun ayah dan ibumu sudah kembali, kau tak bisa begitu saja melenggang ke dasar Dunia Bawah, kan? Menemukan sisa-sisa Chronos berarti mereka ulang kondisi saat kau menghadapinya dulu, semacam itu...?"
      Speaker = "Apollo"
      Event = "ApolloAboutUnderworld01"
    }
    {
      Id = "Apollo_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Moirai telah kembali, ketiganya, Mentari! Sangat melegakan bisa merasakan ramalan mereka lagi. Mereka bahkan sekarang meramalkan terbitnya fajar era baru yang berbeda. Masih banyak waktu untuk bersiap... tapi mari kita manfaatkan sebaik-baiknya, ya?"
      Speaker = "Apollo"
      Event = "ApolloPostEpilogue01"
    }
    {
      Id = "Apollo_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita tunjukkan pertunjukan memukau yang takkan mudah mereka lupakan."
      Speaker = "Apollo"
      Event = "ApolloChat01"
    }
    {
      Id = "Apollo_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya butuh sekejap saja dan kau akan bersinar terang benderang, lihat saja nanti."
      Speaker = "Apollo"
      Event = "ApolloChat02"
    }
    {
      Id = "Apollo_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih suka kita menyelesaikan semua ini di bawah terang siang hari, tapi apa pun yang berhasil bolehlah!"
      Speaker = "Apollo"
      Event = "ApolloChat03"
    }
    {
      Id = "Apollo_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hari-hari yang lebih cerah menanti di depan, kita hanya perlu melewati masa-masa sulit ini."
      Speaker = "Apollo"
      Event = "ApolloChat04"
    }
    {
      Id = "Apollo_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa lagi yang bisa kita lakukan selain mencoba membuat hari-hari kelam ini sedikit lebih cerah, Sepupu?"
      Speaker = "Apollo"
      Event = "ApolloChat05"
    }
    {
      Id = "Apollo_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti bakal menyuguhkan pertunjukan yang memukau malam ini, Sepupu."
      Speaker = "Apollo"
      Event = "ApolloChat06"
    }
    {
      Id = "Apollo_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedamaian pada akhirnya akan kembali lagi, tapi untuk saat ini, ada reputasi yang harus kita jaga."
      Speaker = "Apollo"
      Event = "ApolloChat07"
    }
    {
      Id = "Apollo_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari kami semua di Olympus, kami sangat berterima kasih atas dukunganmu yang tiada henti."
      Speaker = "Apollo"
      Event = "ApolloChat08"
    }
    {
      Id = "Apollo_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti ada sesuatu yang bisa kulakukan untuk sedikit menceriakan malammu di sana, bukan?"
      Speaker = "Apollo"
      Event = "ApolloChat09"
    }
    {
      Id = "Apollo_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Majulah, Mentari, dan semoga cahayaku membimbingmu menuju tempat yang kau tuju."
      Speaker = "Apollo"
      Event = "ApolloChat10"
    }
    {
      Id = "Apollo_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak bisa menikmati indahnya bermandikan mentari di luar? Nah, ini hal terbaik berikutnya!"
      Speaker = "Apollo"
      Event = "ApolloChat11"
    }
    {
      Id = "Apollo_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah cukup bersinar tanpa cahayaku, tapi terimalah sedikit ini, sekadar berjaga-jaga."
      Speaker = "Apollo"
      Event = "ApolloChat12"
    }
    {
      Id = "Apollo_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku lebih suka mempersembahkan puisi dan musik, untuk saat ini hanya inilah yang bisa kuberikan."
      Speaker = "Apollo"
      Event = "ApolloChat13"
    }
    {
      Id = "Apollo_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di mana ada cahaya, di situ ada harapan, Mentari. Jadi bersiaplah menerima keduanya!"
      Speaker = "Apollo"
      Event = "ApolloChat14"
    }
    {
      Id = "Apollo_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, malam ini pasti akan menjadi malam yang luar biasa, firasatku sudah bisa merasakannya!"
      Speaker = "Apollo"
      Event = "ApolloChat15"
    }
    {
      Id = "Apollo_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh-musuhmu bahkan takkan sempat menyentuhmu begitu kita menyilaukan mereka sedikit."
      Speaker = "Apollo"
      Event = "ApolloChat16"
    }
    {
      Id = "Apollo_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa saja mengutuk musuh kita dengan wabah, tapi kurasa kau saja sudah lebih dari cukup."
      Speaker = "Apollo"
      Event = "ApolloChat17"
    }
    {
      Id = "Apollo_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melangkahlah hati-hati di bawah sana, dan ingatlah, kami bersamamu sepanjang jalan."
      Speaker = "Apollo"
      Event = "ApolloChat18"
    }
    {
      Id = "Apollo_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingat, jangan melangkah ke dalam kegelapan tanpa seberkas cahaya."
      Speaker = "Apollo"
      Event = "ApolloChat19"
    }
    {
      Id = "Apollo_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, aku cukup menikmati lagu dan tarian yang satu ini."
      Speaker = "Apollo"
      Event = "ApolloChat20"
    }
    {
      Id = "Apollo_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahayaku biasanya tak bisa menembus kedalaman Dunia Bawah, tapi kau bisa mengubah semua itu!"
      Speaker = "Apollo"
      Event = "ApolloChat21"
    }
    {
      Id = "Apollo_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berjuang bersama sampai akhir, Mentari! Entah kapan tepatnya waktu {#Emph}itu {#Prev}akan tiba, ya kan?"
      Speaker = "Apollo"
      Event = "ApolloChat22"
    }
    {
      Id = "Apollo_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak suka terseret dalam urusan keluarga, tapi aku jelas tak bisa cuma berpangku tangan untuk yang {#Emph}satu ini{#Prev}."
      Speaker = "Apollo"
      Event = "ApolloChat23"
    }
    {
      Id = "Apollo_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagai dewa ramalan, aku sangat yakin kita pasti akan berhasil."
      Speaker = "Apollo"
      Event = "ApolloChat24"
    }
    {
      Id = "Apollo_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakat memang mengalir dalam keluarga kita! Hanya saja sebagian dari kita kebagian porsi yang lebih besar."
      Speaker = "Apollo"
      Event = "ApolloChat25"
    }
    {
      Id = "Apollo_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihatlah dirimu, melenggang gagah di Dunia Bawah seolah tempat itu milikmu sendiri!"
      Speaker = "Apollo"
      Event = "ApolloChat26"
    }
    {
      Id = "Apollo_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah bagaimana caramu bertahan selama ini tanpa secercah pun sinar di bawah sana."
      Speaker = "Apollo"
      Event = "ApolloChat27"
    }
    {
      Id = "Apollo_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahaya seperti apa yang bisa kuberikan untukmu hari ini?"
      Speaker = "Apollo"
      Event = "ApolloChat28"
    }
    {
      Id = "Apollo_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah bagaimana denganmu, tapi perasaanku enak soal bagaimana semua ini akan berjalan!"
      Speaker = "Apollo"
      Event = "ApolloChat29"
    }
    {
      Id = "Apollo_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau jadi jauh lebih mudah terlihat saat memegang obor kembar itu!"
      Speaker = "Apollo"
      Event = "ApolloChat30"
    }
    {
      Id = "Apollo_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini tampaknya bakal menjadi malam yang begitu kelam dan menyesakkan..."
      Speaker = "Apollo"
      Event = "ApolloChat31"
    }
    {
      Id = "Apollo_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebelum kau melesat maju menuju pertempuran dan kejayaan sekali lagi, kumohon, izinkan aku membantumu!"
      Speaker = "Apollo"
      Event = "ApolloChat32"
    }
    {
      Id = "Apollo_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga berkat ini mendatangkan manfaat di setiap langkahmu malam ini."
      Speaker = "Apollo"
      Event = "ApolloChat33"
    }
    {
      Id = "Apollo_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari semua Berkah yang telah kami berikan, balasan yang kau berikan pada kami sungguh karunia yang luar biasa."
      Speaker = "Apollo"
      Event = "ApolloChat34"
    }
    {
      Id = "Apollo_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang menjadi dewa pelindung banyak hal... begitu banyak minat, dan waktu luang yang tak terbatas!"
      Speaker = "Apollo"
      Event = "ApolloChat35"
    }
    {
      Id = "Apollo_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau sudah tahu Berkah ini milikku, lagipula bagaimana mungkin cahayaku bisa dibendung, bahkan di dalam bungkusan tebal sekalipun? Pasti bungkusan itu setidaknya bersinar {#Emph}sedikit{#Prev}, ya kan?"
      Speaker = "Apollo"
      Event = "ApolloBlindBox01"
    }
    {
      Id = "Apollo_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biasanya cahayaku memudahkanku mencari siapa yang butuh berkah atau butuh dihajar, tapi kau sepertinya selalu berada di dalam bayang-bayang! Untunglah, Charon tampaknya tahu cara menghubungimu!"
      Speaker = "Apollo"
      Event = "ApolloBlindBox02"
    }
    {
      Id = "Apollo_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beruntung sekali si Tukang Perahu Dunia Bawah masih setia menjalankan bisnisnya bahkan di masa suram seperti ini! Kuharap harganya setidaknya jadi lebih bersahabat? Atau, jangan-jangan malah makin mahal..."
      Speaker = "Apollo"
      Event = "ApolloLootBought01"
    }
    {
      Id = "Apollo_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami harus menjangkaumu lewat cara apa pun yang memungkinkan, dan Charon sangat senang hati membantu. Memang agak aneh orangnya, tapi bukankah kita semua juga begitu?"
      Speaker = "Apollo"
      Event = "ApolloLootBought02"
    }
    {
      Id = "Apollo_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tukang Perahu itu sepertinya gemar mengoleksi koin, ya? Yah, begitu kita selesai membereskan Chronos tua bangka itu, semua Mahkota Emas miliknya bakal jadi barang koleksi yang luar biasa langka!"
      Speaker = "Apollo"
      Event = "ApolloLootBought03"
    }
    {
      Id = "Apollo_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami mulai bekerja sama dengan Charon sewaktu mencari cara untuk mengangkut arwah manusia fana ke alam ayahmu. Pastinya jauh lebih menyenangkan membawakan pesan dari kami!"
      Speaker = "Apollo"
      Event = "ApolloLootBought04"
    }
    {
      Id = "Apollo_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau melukaiku, Sepupu. Setelah semua yang kita lalui bersama, kau mencampakkanku begitu saja?"
      Speaker = "Apollo"
      Event = "ApolloRejection01"
    }
    {
      Id = "Apollo_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Augh! {#Prev}Sekarang sebenarnya bukan saat yang tepat untuk bertengkar sepele, tapi sayangnya kau tak memberiku pilihan..."
      Speaker = "Apollo"
      Event = "ApolloRejection02"
    }
    {
      Id = "Apollo_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan pilihan pertamamu?! Mungkin kau belum pernah dengar, jadi biar kuperjelas: Kemurahan hatiku ini ada batasnya."
      Speaker = "Apollo"
      Event = "ApolloRejection03"
    }
    {
      Id = "Apollo_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelemahanku tak banyak, tapi harga diriku adalah salah satunya. Kau menusuk tepat di bagian yang paling menyakitkan, jadi sekarang giliranku membalasmu."
      Speaker = "Apollo"
      Event = "ApolloRejection04"
    }
    {
      Id = "Apollo_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa karena perkataan atau perbuatanku? Atau mungkin kau meremehkan kekuatanku. Bahkan saat kekuatan itu berbalik menyerangmu seperti ini?"
      Speaker = "Apollo"
      Event = "ApolloRejection05"
    }
    {
      Id = "Apollo_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah repot-repot menawarkan kekuatanku, dan kau menolaknya? Tak ada dewa yang punya harga diri yang sudi membiarkan hal itu."
      Speaker = "Apollo"
      Event = "ApolloRejection06"
    }
    {
      Id = "Apollo_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, mentari kecil, kenapa harus mencampakkanku? Kau harusnya tahu, kalau perasaanku tersakiti, urusannya tak pernah berhenti di situ saja."
      Speaker = "Apollo"
      Event = "ApolloRejection07"
    }
    {
      Id = "Apollo_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya reputasi yang harus dijaga. Aku tak bisa membiarkanmu mengabaikanku begitu saja layaknya rakyat jelata menyedihkan yang cuma bermodalkan doa!"
      Speaker = "Apollo"
      Event = "ApolloRejection08"
    }
    {
      Id = "Apollo_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin suatu hari nanti kita semua bisa menyelesaikan perbedaan kita dengan lebih bijak. Tapi kita ini para dewa, dan kita ini keluarga, sialan!"
      Speaker = "Apollo"
      Event = "ApolloRejection09"
    }
    {
      Id = "Apollo_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di balik kepribadianku yang ceria ini, aku punya sisi pendendam, Sepupu. Meski kutahu tindakan nyata berbicara lebih lantang daripada sekadar kata-kata."
      Speaker = "Apollo"
      Event = "ApolloRejection10"
    }
    {
      Id = "Apollo_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, sudahlah, cukup. Mari satukan lagi kekuatan kita ke arah yang sama, lalu lanjutkan perjalanan."
      Speaker = "Apollo"
      Event = "ApolloMakeUp01"
    }
    {
      Id = "Apollo_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suasananya sempat agak runyam, ya? Bagaimana kalau kita berdua fokus kembali pada tugas kita."
      Speaker = "Apollo"
      Event = "ApolloMakeUp02"
    }
    {
      Id = "Apollo_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong maafkan amarah sesaatku tadi, ya? Hanya sedikit emosi buruk. Memang sudah bawaan keluarga."
      Speaker = "Apollo"
      Event = "ApolloMakeUp03"
    }
    {
      Id = "Apollo_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma luapan amarah sesaat, kok! Untuk sekumpulan makhluk abadi, kami para dewa memang gampang tersinggung."
      Speaker = "Apollo"
      Event = "ApolloMakeUp04"
    }
    {
      Id = "Apollo_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau cuma mengerjaiku tadi, kan? Biasanya aku bisa menerima lelucon dengan santai, tapi belakangan ini kita semua memang agak tegang."
      Speaker = "Apollo"
      Event = "ApolloMakeUp05"
    }
    {
      Id = "Apollo_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada gunanya memendam amarah. Kita ini dewa! Kita mengendalikan segalanya kecuali emosi kita sendiri, benar, kan?"
      Speaker = "Apollo"
      Event = "ApolloMakeUp06"
    }
    {
      Id = "Apollo_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hubungan akan makin kokoh berkat kesulitan. Jadi hubungan kita pasti baru saja bertambah erat sedikit!"
      Speaker = "Apollo"
      Event = "ApolloMakeUp07"
    }
    {
      Id = "Apollo_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehm{#Prev}, maaf soal tadi, mentari kecil. Kalau amarahku sedang berkobar, sebaiknya jangan berada di dekat-dekat situ."
      Speaker = "Apollo"
      Event = "ApolloMakeUp08"
    }
    {
      Id = "Apollo_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, tamat sudah riwayat mereka! Semoga berkah dariku ini membantumu lebih baik daripada mereka. Kau layak mendapatkannya!"
      Speaker = "Apollo"
      Event = "ApolloMakeUp09"
    }
    {
      Id = "Apollo_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat dikuasai rasa kesal, tapi pertunjukan menghibur barusan langsung menyadarkanku!"
      Speaker = "Apollo"
      Event = "ApolloMakeUp10"
    }
    {
      Id = "Melinoe_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepupu Apollo! Aku sangat bersyukur atas kehangatan, kebaikan hati, dan bantuanmu! Kumohon, terimalah hadiah ini!"
      Speaker = "Melinoe"
      Event = "ApolloGift01"
    }
    {
      Id = "Apollo_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Persembahan, untukku? Kejutan yang sungguh menyenangkan, dan aku jarang mendapatkannya belakangan ini. Tahu tidak, aku juga punya sesuatu untukmu!"
      Speaker = "Apollo"
      Event = "ApolloGift01"
    }
    {
      Id = "Melinoe_0503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir, apakah kilau cemerlang botol ini berasal dari sang dewa cahaya itu sendiri? Kalau begitu, mungkin sebaiknya dikembalikan kepadanya, sekarang juga!"
      Speaker = "Melinoe"
      Event = "ApolloGift02"
    }
    {
      Id = "Apollo_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hadiah yang sungguh penuh perhatian! Baik sekali dirimu memikirkanku di saat-saat seperti ini. Padahal tak perlu repot-repot segala!"
      Speaker = "Apollo"
      Event = "ApolloGift02"
    }
    {
      Id = "MelinoeField_1759"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apollo yang cemerlang, bakatmu yang melimpah pastilah membuat iri seisi negeri, dan aku merasa terhormat kau sudi membaginya denganku. Ini, untukmu!"
      Speaker = "Melinoe"
      Event = "ApolloGift03"
    }
    {
      Id = "Apollo_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah, sungguh kau tak perlu repot begini. Pujian seperti itu sama sekali tak perlu, sungguh! Walau tentu saja kuterima dengan senang hati!"
      Speaker = "Apollo"
      Event = "ApolloGift03"
    }
    {
      Id = "MelinoeField_1760"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata orang Nektar ini bersinar seterang mentari, Sepupu. Semoga khasiatnya sesuai dengan perkataan itu, apalagi sekarang sudah jadi milikmu! Aku sungguh beruntung bisa bersahabat denganmu."
      Speaker = "Melinoe"
      Event = "ApolloGift04"
    }
    {
      Id = "Apollo_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau baik sekali. Kau tak harus memberiku {#Emph}ini! {#Prev}Aku tak pernah tahu para dewa Bawah Tanah begitu sopan santun. Kau bahkan tahu adat istiadat kami lebih baik daripada {#Emph}kami {#Prev}sendiri!"
      Speaker = "Apollo"
      Event = "ApolloGift04"
    }
    {
      Id = "MelinoeField_1761"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepupuku yang agung! Kaulah yang pertama kali mengulurkan tangan kepadaku dari antara semua penghuni Olympus. Aku bisa melangkah sejauh ini berkat dirimu, dan apa pun yang terjadi nanti, aku takkan pernah melupakan kebaikanmu."
      Speaker = "Melinoe"
      Event = "ApolloGift05"
    }
    {
      Id = "Apollo_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, justru aku yang senang! Akhir-akhir ini tak semuanya cerah di Olympus. Tapi saat mendengar kabarmu, aku merasa segalanya akan baik-baik saja. Entah bagaimana bisa begitu, tapi aku sangat bersyukur kita bisa bertemu."
      Speaker = "Apollo"
      Event = "ApolloGift05"
    }
    {
      Id = "MelinoeField_1762"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepupuku tercinta, persediaan Nektarmu pasti tak pernah habis. Tapi kutahu dalamnya ketulusanlah yang membedakan satu botol dengan yang lainnya. Jadi terimalah yang satu ini; rasanya pasti istimewa."
      Speaker = "Melinoe"
      Event = "ApolloGift06"
    }
    {
      Id = "Apollo_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ini dewa Olympus; aku sudah terbiasa dengan penjilat dan orang bermuka dua. Semua orang menginginkan berkah dari kami, kan? Dan aku bisa tersenyum dan mengangguk lebih lihai dari siapa pun, bahkan dari Ayah sekalipun. Tapi bersamamu... andai saja kita punya lebih banyak kesempatan untuk berbincang ketimbang sekadar saling bertukar basa-basi..."
      Speaker = "Apollo"
      Event = "ApolloGift06"
    }
    {
      Id = "MelinoeField_3827"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Apollo, sepupuku, sahabatku! Ambrosia ini mengingatkanku pada momen saat pertama kali melihat istana ayahmu dan mendengarkan senandung indahmu. Terima kasih telah membuatku melihat dunia dari sudut pandang yang baru, dan karena selalu percaya padaku."
      Speaker = "Melinoe"
      Event = "ApolloGift07"
    }
    {
      Id = "Apollo_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percaya padamu adalah hal yang sangat mudah, Nona Melinoë, bahkan tanpa Ambrosia yang bermandikan pendar rembulan dari Persimpangan Jalan ini sekalipun. Aku merasa sangat diberkati bisa bertemu denganmu, dan saudariku menemukanmu di saat yang tepat. Kau adalah anugerah terbesar bagi keluarga kita setelah sekian lama."
      Speaker = "Apollo"
      Event = "ApolloGift07"
    }
    {
      Id = "Melinoe_1734"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih untuk ini, Sepupu!"
      Speaker = "Melinoe"
      Event = "ApolloUpgrade.GiftGivenVoiceLines"
    }
    {
      Id = "Apollo_0145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita akan bersinar begitu terang sampai menyilaukan!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Apollo_0146"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada tempat bersembunyi dari cahaya {#Emph}ini{#Prev}!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Apollo_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saatnya pertunjukan yang memukau!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Apollo_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cahaya mentari!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Apollo_0218"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Musik merdu di telingaku!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Apollo_0219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, {#Emph}sekarang {#Prev}kau mau bantuanku?"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Apollo_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, kurasa boleh juga!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Apollo_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mulai berani kurang ajar, ya!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Artemis_0464"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, adik kecil!"
      Speaker = "Artemis"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Artemis_0465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apollo?!"
      Speaker = "Artemis"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terlalu silau cahaya terkutuk ini..."
      Speaker = "Chronos"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cahaya {#Emph}mentari?!{#Prev}"
      Speaker = "Chronos"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zagreus_0360"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu Apollo...!"
      Speaker = "Zagreus"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zagreus_0361"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hai, Apollo...!"
      Speaker = "Zagreus"
      Event = "ApolloUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Apollo_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cari gara-gara denganku, padamlah cahayamu, manis."
      Speaker = "Apollo"
      Event = "ApolloUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Apollo_0140"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Perlu kuingatkan, aku tak selalu sebaik kelihatannya."
      Speaker = "Apollo"
      Event = "ApolloUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Apollo_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya jangan menguji batas hubungan kita terlalu jauh."
      Speaker = "Apollo"
      Event = "ApolloUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Apollo_0142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarahanku tak kalah membara dibanding yang lain, Sepupu."
      Speaker = "Apollo"
      Event = "ApolloUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Apollo_0143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak semua dari kita kaum Olympus bisa jadi yang terbaik; karena itu sudah jadi tugasku."
      Speaker = "Apollo"
      Event = "ApolloUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Apollo_0144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak memberiku pilihan selain sedikit unjuk kekuatan."
      Speaker = "Apollo"
      Event = "ApolloUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Apollo_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Apollo_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Apollo_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasakan itu!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Apollo_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beres!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Apollo_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Khusus untukmu!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Apollo_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Apollo_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Apollo_0138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Luar biasa!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Apollo_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo, mentari kecil!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Apollo_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo, Sepupu!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Apollo_0121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tebak siapa, manis?"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Apollo_0122"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam dari Olympus!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Apollo_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siap melayanimu!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Apollo_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kejutan, kejutan!"
      Speaker = "Apollo"
      Event = "ApolloUpgrade.BlindBoxOpenedVoiceLines"
    }
  ]
}
