      Event = "BaseChaos.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Dari ketiadaan terlahirlah segenap ciptaan, terang, kegelapan, dan dunia itu sendiri; namun seluruh ketiadaan itu tetap berdiam, tersimpan rapat di tempat yang tak tersentuh siapa pun, terkecuali mereka yang diundang kemari."
      Speaker = "Storyteller"
      Event = "Inspect_Chaos_01_01"
    }
    {
      Id = "MelinoeField_0823"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya kita tidak bersuara keras-keras...!"
      Speaker = "Melinoe"
      Event = "Inspect_Chaos_01_01"
    }
    {
      Id = "Storyteller_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di dalam keheningan palung jurang tanpa batas, tersimpan kemungkinan yang tiada hingga; unsur-unsur pembangun yang tak kasat mata dan tak berujung dari segala hal yang pernah terwujud, dan segala hal yang kelak akan tercipta."
      Speaker = "Storyteller"
      Event = "Inspect_Chaos_02_01"
    }
    {
      Id = "MelinoeField_0824"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar-benar luar biasa banyaknya..."
      Speaker = "Melinoe"
      Event = "Inspect_Chaos_02_01"
    }
    {
      Id = "Storyteller_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang pelopor penciptaan yang purba dan penuh misteri masih tetap bertahan, mengamati dari kedalaman jurang hitam pekat yang tak tertembus, jerih lelah tiada akhir dari mereka yang hidup maupun yang telah mati."
      Speaker = "Storyteller"
      Event = "Inspect_Chaos_03_01"
    }
