{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Hermes.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "Hermes_0408"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terlalu lambat!"
      Speaker = "Hermes"
      Event = "NPC_Hermes_01.OnHitVoiceLines"
    }
    {
      Id = "Hermes_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo dong, M..."
      Speaker = "Hermes"
      Event = "NPC_Hermes_01.OnHitVoiceLines"
    }
    {
      Id = "Hermes_0144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan."
      Speaker = "Hermes"
      Event = "NPC_Hermes_01.OnHitVoiceLines"
    }
    {
      Id = "Hermes_0409"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak kena!"
      Speaker = "Hermes"
      Event = "NPC_Hermes_01.OnHitVoiceLines"
    }
    {
      Id = "Hermes_0145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mm-mm."
      Speaker = "Hermes"
      Event = "NPC_Hermes_01.OnHitVoiceLines"
    }
    {
      Id = "Hermes_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana kabarnya, aman? Aku aman kok. Yah, hampir! Dan senang lihat tugasmu sudah jalan, tapi ada perubahan rencana, meski ini agak mendadak: Mau mampir main ke Olimpus dalam waktu dekat?"
      Speaker = "Hermes"
      Event = "HermesFirstPickUp"
    }
    {
      Id = "MelinoeField_2003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Hermes, tunggu sebentar, apa maksudmu {#Emph}Olimpus? {#Prev}Tugasku adalah menghentikan Kronos di Dunia Bawah. Bernapas dengan udara permukaan saja aku nyaris tak sanggup, apalagi mendaki sampai puncak gunung!"
      Speaker = "Melinoe"
      Event = "HermesFirstPickUp"
    }
    {
      Id = "Hermes_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, M! Kamu kan punya caramu sendiri! Kakek tua itu sedang merencanakan sesuatu yang gawat, lebih parah dari serangan biasanya, jadi coba pertimbangkan dulu ya. Aku nggak bakal minta kalau ini masalah sepele, kan? Nah, sekarang aku harus cabut, dan kamu juga. Nanti kuhubungi lewat Berkah!"
      Speaker = "Hermes"
      Event = "HermesFirstPickUp"
    }
    {
      Id = "Hermes_0073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa lagi!"
      Speaker = "Hermes"
      Event = "HermesFirstPickUp"
    }
    {
      Id = "MelinoeField_2004"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di jalan!"
      Speaker = "Melinoe"
      Event = "HermesFirstPickUp"
    }
    {
      Id = "Hermes_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kamu beneran berhasil sampai ke sini, keren banget! Sayangnya ada yang nggak keren sama sekali, yaitu Typhon, kamu mungkin sudah ketemu dia kan? Monster raksasa segede gunung itu beserta seluruh anak buahnya?"
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphon01"
    }
    {
      Id = "MelinoeField_2967"
      InheritFrom = "BaseNarrative"
      DisplayName = "Badai ini, wabah... hama ini. Jadi semua ini gara-gara ulah Typhon? Bagaimana dia bisa sampai ke sini? Bagaimana cara kita menghentikannya?"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutTyphon01"
    }
    {
      Id = "Hermes_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak ada jawaban gampang buatmu, M, yang jelas Kakek tua itu yang mendatangkan dia kemari, semuanya bagian dari rencananya. Yang lain masih bisa bertahan sebentar di Istana Ayah, tapi mereka butuh bantuanmu. Sebaiknya aku segera melapor ke Hec!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphon01"
    }
    {
      Id = "Hermes_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga diri baik-baik!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphon01"
    }
    {
      Id = "MelinoeField_2968"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga..."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutTyphon01"
    }
    {
      Id = "Hermes_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasa bersalah banget sama kamu soal ini, M. Seharusnya aku cari tahu apa yang direncanakan Kakek tua itu, tapi lariku kurang cepat. Sekarang kamu malah harus berhadapan langsung dengan Typhon!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphon02"
    }
    {
      Id = "MelinoeField_3174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Hermes, kita bisa membahas semua hal yang seharusnya bisa berbeda ini nanti setelah semuanya selesai. Tapi untuk saat ini, urusan di depan mata jauh lebih mendesak daripada masa lalu."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutTyphon02"
    }
    {
      Id = "Hermes_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu. Kamu benar. Cuma saja aku mulai sadar kalau semua ini memang yang ingin dicapai Kakek: pertama menculik Tiga Dewi Takdir biar mereka nggak bisa mengutak-atik {#Emph}dia{#Prev}, lalu membangunkan Typhon biar dia bisa mengacak-acak {#Emph}kita...! {#Prev}Lalu merebut kekuasaan atas segalanya."
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphon02"
    }
    {
      Id = "MelinoeField_3175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memang tak tahu semua rinciannya, tapi kau sudah lama menduga bahwa Kronos merencanakan sesuatu yang besar. Seandainya kau tak bertindak cepat saat itu, aku tak akan ada di sini sekarang. Kita tak akan punya kesempatan ini."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutTyphon02"
    }
    {
      Id = "Hermes_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih suka kepastian daripada sekadar kesempatan, M! Tapi ya sudahlah, kamu benar. Kita lakukan yang terbaik dengan apa yang kita punya."
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphon02"
    }
    {
      Id = "Hermes_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphon02"
    }
    {
      Id = "MelinoeField_3032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai nanti."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutTyphon02"
    }
    {
      Id = "Hermes_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu sudah menghajar Typhon sampai bonyok, tapi dia masih murka banget. Nggak ada yang bisa kamu atau Hec lakukan biar dia pergi selamanya?"
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphon03"
    }
    {
      Id = "MelinoeField_4214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau maksudmu {#Emph}membuatnya pergi selamanya {#Prev}adalah membuat seluruh kilasan hidupnya berputar di depan banyak matanya sebelum akhirnya dia dimusnahkan seutuhnya, ya, itu sedang kami usahakan. Tapi butuh sedikit waktu."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutTyphon03"
    }
    {
      Id = "Hermes_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh mantap! Segala sesuatu nggak bisa selesai secepat kilat kalau memang butuh waktu. Ya sudah, jangan sampai aku mengganggu risetmu, sampai ketemu lagi nanti, M!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphon03"
    }
    {
      Id = "MelinoeField_3031"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati!"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutTyphon03"
    }
    {
      Id = "Hermes_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eh {#Emph}tunggu{#Prev}, Typhon itu sudah lenyap belum sih? Soalnya dari tadi nggak ada tanda-tanda keberadaannya, tapi sekarang Kakek punya kantung-kantung waktu kecil begini, dan begitu kita masuk ke dalam, rasanya seolah Typhon nggak pernah pergi!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_4220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurang lebih begitu cara memahaminya, tapi... bagaimana bisa kau sampai {#Emph}ke sini? {#Prev}Aku tak tahu kalau Kakek mengirim yang lain kemari juga. Apa kau bahkan tahu jalan pulangnya?"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutTyphonDeath01"
    }
    {
      Id = "Hermes_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal lariku cukup cepat, aku pasti bisa balik! Kakek juga meninggalkan sarana bagi yang lain untuk mengeluarkan kita, dan kami mengawasinya lekat-lekat. Sebaiknya aku keliling memantau dulu!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_4221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di luar sana!"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutTyphonDeath01"
    }
    {
      Id = "Hermes_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak usah terlalu cemas soal Istana Ayah di atas sana, M! Typhon tua itu memang besar dan perkasa, tapi dia nggak bisa menghancurkan apa yang nggak bisa dia lihat! Yah, setidaknya nggak semudah kalau dia {#Emph}bisa {#Prev}melihatnya langsung."
      Speaker = "Hermes"
      Event = "HermesFieldAboutPalace01"
    }
    {
      Id = "MelinoeField_3178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu sama sekali tidak menenangkan. Jadi Tuan Paman Zeus dan yang lainnya menyembunyikan singgasana kekuasaan mereka, membiarkan Typhon melampiaskan amarahnya pada benteng ini?"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutPalace01"
    }
    {
      Id = "Hermes_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yap, kurang lebih begitu! Menurut mereka, kalau kita memang harus menghadapi Typhon—dan memang harus—tempat inilah lokasi yang paling pas! Lagipula, lumayan jauh lho kalau jatuh dari puncak. Cara turun yang {#Emph}sangat kilat{#Prev}, ingat itu!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutPalace01"
    }
    {
      Id = "Hermes_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, gimana menurutmu tentang Istana Ayah? Akhirnya bisa melihat kemegahannya dengan mata kepalamu sendiri kan, M! Prestasi luar biasa mengingat kamu sebenarnya sama sekali nggak boleh naik ke sini."
      Speaker = "Hermes"
      Event = "HermesFieldAboutPalace02"
    }
    {
      Id = "MelinoeField_4216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Istana Zeus tak seperti tempat mana pun yang pernah kulihat... sangat indah, tapi begitu menyilaukan. Aku tak tahu bagaimana kalian semua bisa tinggal di sana. Tapi kurasa kalian juga merasakan hal yang sama tentang tempat asalku."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutPalace02"
    }
    {
      Id = "Hermes_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku pribadi lumayan suka kegelapan, tapi waktuku yang kuhabiskan di Dunia Bawah lebih banyak ketimbang gabungan semua orang di atas sini! Kalau soal Istana, setidaknya tempat itu menjaga kita tetap aman di tengah semua kekacauan ini!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutPalace02"
    }
    {
      Id = "MelinoeField_4217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita jaga agar tetap begitu."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutPalace02"
    }
    {
      Id = "Hermes_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali Istana Ayah ditutup untuk sementara, penjagaan diperketat, begitulah kira-kira. Kau tidak keberatan, kan? Tak ada gunanya juga berlama-lama di sana kalau menurutku."
      Speaker = "Hermes"
      Event = "HermesFieldAboutPalace03"
    }
    {
      Id = "MelinoeField_4218"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tidak, jujur di antara kita berdua, aku sama sekali tak keberatan. Aku masih bisa berkomunikasi dengan Raja dan Ratu serta yang lainnya lewat Berkah, dan ini artinya aku bisa pulang lebih cepat di malam yang baik."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutPalace03"
    }
    {
      Id = "Hermes_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, tepat seperti itulah caraku memandangnya! Makin cepat kau lewati monster raksasa yang kemungkinan mengintai di balik gerbang besar di belakang sana, makin cepat kau bisa beristirahat untuk yang {#Emph}berikutnya!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutPalace03"
    }
    {
      Id = "MelinoeField_4219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, ayo jalan."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutPalace03"
    }
    {
      Id = "MelinoeField_4224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana keadaanmu dan Charon belakangan ini, sekarang setelah Dunia Bawah tak lagi berada di bawah kekuasaan Titan?"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutCharon01"
    }
    {
      Id = "Hermes_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, luar biasa! Maksudnya ya tidak banyak yang berubah. Dia belum bisa kembali mengantar Arwah orang mati sampai Dunia Bawah pulih dan beroperasi normal seperti sediakala."
      Speaker = "Hermes"
      Event = "HermesFieldAboutCharon01"
    }
    {
      Id = "MelinoeField_4225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir itu bakal memakan waktu agak lama. Ayah sangat teliti memeriksa segala hal yang berubah, dan tak mau terburu-buru membuka kembali sebelum semuanya siap."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutCharon01"
    }
    {
      Id = "Hermes_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fokusku langsung buyar setelah kata {#Emph}tak mau terburu-buru{#Prev}, sejujurnya, M. Asalkan ayahmu tahu ada tangan-tangan yang siap membantu kapan pun dia butuh."
      Speaker = "Hermes"
      Event = "HermesFieldAboutCharon01"
    }
    {
      Id = "MelinoeField_4226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa kuingatkan dia kalau perlu!"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutCharon01"
    }
    {
      Id = "Hermes_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, M, aku tak mau menahanmu lebih lama sekarang setelah kau sampai di sini, bagaimanapun kau punya urusan penting. Cuma memastikan kau tiba dengan selamat tanpa kurang suatu apa!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutBusiness01"
    }
    {
      Id = "MelinoeField_3179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih utuh, Tuan Hermes, tapi kita lihat saja berapa lama hal {#Emph}itu {#Prev}bertahan. Walau siapa tahu? Mungkin saja Typhon bakal menggepengkanku, alih-alih mencabik-cabikku hingga berkeping-keping."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutBusiness01"
    }
    {
      Id = "Hermes_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, suram sekali itu. Meski kau tahu apa lagi yang tak kalah suram? {#Emph}Seluruh {#Prev}situasi yang sedang kita hadapi ini. Maksudku, {#Emph}lihat {#Prev}tempat ini! Jadi bagaimana kalau kita berdua segera angkat kaki dari sini?"
      Speaker = "Hermes"
      Event = "HermesFieldAboutBusiness01"
    }
    {
      Id = "Hermes_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mestinya sudah menerima semua yang kau pesan dari altar khususkupengiriman kilat, gratis ongkir! Sekarang giliran bagian tersulitnya. Merasa siap untuk itu, M?"
      Speaker = "Hermes"
      Event = "HermesFieldAboutSurfaceShop01"
    }
    {
      Id = "MelinoeField_3176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pasti kurang siap andai bukan karenamu. Terima kasih sudah menemuiku di sini. Apakah Olympus tahu kau melakukan ini?"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutSurfaceShop01"
    }
    {
      Id = "Hermes_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka tahu aku sedang keluar mengantar perbekalan! Lagipula kita semua berada di kubu yang sama, bukan? Tak perlu membebani mereka dengan detail-detail kecil saat tangan mereka sendiri sudah penuh kerepotan."
      Speaker = "Hermes"
      Event = "HermesFieldAboutSurfaceShop01"
    }
    {
      Id = "Hermes_0183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku cabut dulu!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutSurfaceShop01"
    }
    {
      Id = "MelinoeField_3030"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa!"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutSurfaceShop01"
    }
    {
      Id = "Hermes_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga aku bisa mengandalkanmu di sini, M, bukan cuma soal Typhon, tapi juga altar-altar khususkul Kau sudah menyumbangkan banyak koin untuk tujuan mulia, jadi {#Emph}terima kasih banyak!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutSupport01"
    }
    {
      Id = "MelinoeField_4209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tujuan apa itu, kalau boleh tahu? Tuan Charon selama ini berusaha menghancurkan semua koin yang bisa ia raup... kau tidak sedang berlomba melakukan hal yang sama, kan?"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutSupport01"
    }
    {
      Id = "Hermes_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anggap saja sedikit persaingan sehat antar rekan seprofesi. Dia mulai duluan dan sempat unggul untuk saat ini, tapi berkat bantuanmu, aku mulai bisa mengejarnya!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutSupport01"
    }
    {
      Id = "MelinoeField_4210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pasti bisa! Tapi dia juga begitu."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutSupport01"
    }
    {
      Id = "Hermes_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Koinmu tidak banyak-banyak amat rupanya, M. Sebenarnya ingin kutraktir, hanya saja rekan seprofesiku itu, dia sangat ketat soal larangan membagi-bagikan koin sembarangan."
      Speaker = "Hermes"
      Event = "HermesFieldAboutGold01"
    }
    {
      Id = "MelinoeField_4222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tidak apa-apa. Seharusnya aku memang sanggup menghadapi murka Typhon dengan atau tanpa barang-barang dagangan yang sangat menggoda ini."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutGold01"
    }
    {
      Id = "Hermes_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, {#Emph}itu {#Prev}baru sikap kesatria! Mungkin agak sedikit kepedean sih, tapi ya memang kau sendiri sudah menumbangkan monster beberapa kali!"
      Speaker = "Hermes"
      Event = "HermesFieldAboutGold01"
    }
    {
      Id = "MelinoeField_4223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan sekarang saatnya untuk menumbangkan yang berikutnya."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutGold01"
    }
    {
      Id = "Hermes_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadwalku mulai padat lagi, M, jadi kemungkinan besar obrolan-obrolan singkat kita ini harus dibuat lebih kilat dan ringkas."
      Speaker = "Hermes"
      Event = "HermesFieldAboutLittleToSay01"
    }
    {
      Id = "MelinoeField_4227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, Tuan Hermes. Aku tidak mengharapkanmu menyisihkan waktu dari kesibukanmu hanya demi diriku. Lakukan apa yang harus kau lakukan."
      Speaker = "Melinoe"
      Event = "HermesFieldAboutLittleToSay01"
    }
    {
      Id = "Hermes_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu kulakukan, tapi aku cuma mau bilang terima kasih lagi, karena sudah sudi datang sejauh ini bukan hanya malam ini, tapi juga sejak pertama kali kuminta dulu sekali. Sampai ketemu saat kau mampir lagi, ya? Sebentar saja, tapi tak apalah."
      Speaker = "Hermes"
      Event = "HermesFieldAboutLittleToSay01"
    }
    {
      Id = "MelinoeField_4228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa!"
      Speaker = "Melinoe"
      Event = "HermesFieldAboutLittleToSay01"
    }
    {
      Id = "Hermes_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang bisa kukatakan? Senang sekali bisa bekerja sama denganmu, Hec. Selalu begitu. Terima kasih sudah menerimaku ke dalam lingkaran kalian, dan aku akan terus mengabarimu. Kujamin seratus persen!"
      Speaker = "Hermes"
      Event = "HermesWithHecate01"
    }
    {
      Id = "Hecate_0875"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau mendapatkan rasa terima kasihku, Hermes. Andai bukan karenamu, kita pasti sudah kecolongan total, dan keadaannya bakal jauh lebih buruk. Apakah kau akan berkunjung lebih sering mulai sekarang?"
      Speaker = "Hecate"
      Event = "HermesWithHecate01"
    }
    {
      Id = "Hermes_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kayaknya belum bisa untuk sekarang, Ayah tak ingin aku keluyuran melulu, keluarga besar punya banyak sekali pesan yang ingin dikirimkan. Tapi aku akan tetap menjaga kontak denganmu dan M, beres?"
      Speaker = "Hermes"
      Event = "HermesWithHecate01"
    }
    {
      Id = "Hecate_0876"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja. Kalau begitu cepatlah kembali."
      Speaker = "Hecate"
      Event = "HermesWithHecate01"
    }
    {
      Id = "MelinoeField_4211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hermes, mumpung kita berdua ada di sini, ini ada hadiah kecil untukmu, kalau kau tidak keberatan! Semoga Ambrosia ini membuat langkahmu selalu seringan mungkin!"
      Speaker = "Melinoe"
      Event = "HermesFieldGiftDecline01"
    }
    {
      Id = "Hermes_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih banyak atas niat baikmu, M, tapi aku tidak bisa menerimanya. Kurang pantas kalau aku muncul membawa sebotol Ambrosia saat ini, tak peduli seberapa inginnya {#Emph}aku {#Prev}atau {#Emph}siapa pun {#Prev}mencicipinya. Tapi ya, bersulang!"
      Speaker = "Hermes"
      Event = "HermesFieldGiftDecline01"
    }
    {
      Id = "Hermes_0070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fyuuh! {#Prev}Hei, M! Aku kembali!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_2000"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau kembali!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei hei!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, M!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0234"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini barang-barang yang tersedia."
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang menarik perhatianmu?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0232"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau tambah pasokan?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau yang mana?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0230"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Butuh sesuatu?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0231"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Boleh kucatat pesananmu?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_2966"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hermes, kau di sini!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_3027"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Hermes!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_3028"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Hermes."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_3029"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hermes!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_2001"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Hermes...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini semuanya! Aku serahkan sisanya padamu, M."
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0191"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasokan perbekalan terakhir, semoga ini membantumu, M!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini yang kubawakan untukmu kali ini!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0193"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak bisa lama-lama mengobrol, tapi senang bertemu denganmu, M!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti ada {#Emph}sesuatu {#Prev}yang bisa kau pakai di sini!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tonjok mata Typhon untukku, ya?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya itu yang kupunya, semoga cahaya rembulan membimbingmu, M!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0197"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Stok kita menipis, tapi masih ada sisa barang untukmu!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sana, ingatkan Typhon agar jangan macam-macam dengan para dewa!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan biarkan si tua Typhon menunggu, habisi dia, M!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, lekas bereskan si raksasa di atas sana, ya!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0329"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, aku harus segera pergi!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0333"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senang berpapasan denganmu!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0334"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya lekas lanjut lagi!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus, waktumu pas, aku tak akan menghalangi jalanmu!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cepat, M, kau tak bisa memecahkan rekor waktu tercepatmu kalau melambat!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, lihat dirimu, kaya raya sekali!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0300"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, lihat tumpukan Koin Emas yang kau punya itu!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak perlu membiarkan semua Emas itu membebanimu!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau takkan butuh semua Emas itu!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0303"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dionysus beneran melunasi utangnya padamu...?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampaknya Bayar Iuran tadi menguras habis kantongmu!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harusnya cukup buat beli apa pun yang kau butuhkan!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gimana kalau belanja sedikit sebelum bertarung?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lagi bokek ya, M?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah ludes koin hasil kerja kerasmu, M?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini pasti salah satu kantung waktu buatan Kakek!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua keuntungan langsung kuberikan pada rekan kerjaku!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0311"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini hasil jarahan terbaru, silakan pilih sesukamu!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita pulihkan lagi kondisi prima bertarungmu!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0313"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Typhon sudah lama menunggak pembalasan, kan?"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0314"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Santai saja di sini, M, atau mau langsung tancap gas juga boleh!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0315"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak bisa lama-lama di sini, M, tapi silakan pilih!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0316"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pasti sanggup menumbangkan Typhon itu lagi!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0317"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Borong semua yang kau bisa, lalu lanjutkan langkahmu!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0318"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan Typhon pertamamu, kan! Pastikan saja ini bukan yang terakhir bagimu."
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Numpang lewat!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini dia!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hai M! Dadah M!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai ketemu lagi!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa dulu!"
