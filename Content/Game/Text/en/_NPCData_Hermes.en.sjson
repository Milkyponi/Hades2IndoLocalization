    }
    {
      Id = "Hermes_0353"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, aku cabut!"
      Speaker = "Hermes"
      Event = "GlobalVoiceLines.HermesFirstSpawnVoiceLines"
    }
    {
      Id = "Hermes_0354"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, M!"
      Speaker = "Hermes"
