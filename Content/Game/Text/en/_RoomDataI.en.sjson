{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _RoomDataI.en.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "en"
  Texts = [
    {
      Id = "Storyteller_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di ceruk bumi terdalam, tempat Yang Mulia Hades yang muram dahulu bertakhta, kini meliuk-liuk bangunan megah milik sang Titan Chronos, yang menjadikan bekas makamnya ini sebagai istananya."
      Speaker = "Storyteller"
      Event = "Inspect_I_Intro_01"
    }
    {
      Id = "Melinoe_1116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak kusangka tempat ini adalah Tartarus..."
      Speaker = "Melinoe"
      Event = "Inspect_I_Intro_01"
    }
    {
      Id = "Storyteller_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bagian dalam yang tersingkap dari bilik-bilik Bawah Tanah yang termasyhur saling bertautan itu kini berupa tumpukan roda bergigi emas; siklus tiada henti yang berputar hanya atas kehendak sang Titan."
      Speaker = "Storyteller"
      Event = "Inspect_I_Intro_02"
    }
    {
      Id = "MelinoeField_1430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hampir mustahil berkonsentrasi di tengah kebisingan ini..."
      Speaker = "Melinoe"
      Event = "Inspect_I_Intro_02"
    }
    {
      Id = "MelinoeField_4586"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Belum ada renovasi di sini..."
      Speaker = "Melinoe"
      Event = "I_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1461"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hampir sampai..."
      Speaker = "Melinoe"
      Event = "I_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1462"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah tidak jauh lagi..."
      Speaker = "Melinoe"
      Event = "I_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1279"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedalaman paling dasar..."
      Speaker = "Melinoe"
      Event = "I_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1280"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lantai dasar..."
      Speaker = "Melinoe"
      Event = "I_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chronos menunggu..."
      Speaker = "Melinoe"
      Event = "I_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1282"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akses pemeliharaan..."
      Speaker = "Melinoe"
      Event = "I_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1283"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pintu masuk pelayan..."
      Speaker = "Melinoe"
      Event = "I_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1284"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku berhasil masuk."
      Speaker = "Melinoe"
      Event = "I_Intro.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kediaman Hades yang megah kini tinggal kenangan yang memudar, sebab di tempatnya berpijak, sebuah istana baru telah bangkit; berwujud mengerikan menyerupai rupa sang Titan Penguasa Waktu sang penakluk dunia."
      Speaker = "Storyteller"
      Event = "Inspect_I_PreBoss01_01"
    }
    {
      Id = "MelinoeField_1435"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mengerikan sekali..."
      Speaker = "Melinoe"
      Event = "Inspect_I_PreBoss01_01"
    }
    {
      Id = "Storyteller_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di Tartarus yang tak terduga dalamnya ini, Chronos, pendahulu para dewa yang kejam, memimpin pasukan pembelotnya, bermanuver melawan Olympus selagi mencengkeram Dunia Bawah dalam kuasanya."
      Speaker = "Storyteller"
      Event = "Inspect_I_PreBoss01_02"
    }
    {
      Id = "MelinoeField_1436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Olympus takkan bisa menyentuhnya di sini..."
      Speaker = "Melinoe"
      Event = "Inspect_I_PreBoss01_02"
    }
    {
      Id = "Storyteller_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Benteng curian milik sang Titan tiran tampak mengundang, untuk saat ini tanpa pertahanan dan terbuka lebar; entah karena pasukannya telah tercerai-berai, atau karena ia sudah terlampau yakin akan kemenangannya."
      Speaker = "Storyteller"
      Event = "Inspect_I_PreBoss01_03"
    }
    {
      Id = "MelinoeField_1437"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atau mungkin dua-duanya."
      Speaker = "Melinoe"
      Event = "Inspect_I_PreBoss01_03"
    }
    {
      Id = "Storyteller_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di tengah gemuruh penyerbuan sang Putri ke benteng musuh abadinya, Tukang Perahu Charon dengan berani membelah air sungai yang bergolak, membawa bermacam-macam barang selundupan."
      Speaker = "Storyteller"
      Event = "Inspect_I_PreBoss01_04"
    }
    {
      Id = "MelinoeField_1434"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia jauh lebih lihai menyelinap dibanding aku..."
      Speaker = "Melinoe"
      Event = "Inspect_I_PreBoss01_04"
    }
    {
      Id = "Storyteller_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kediaman Hades sekali lagi berdiri tegak dan megah, dengan ukiran rupa yang semestinya pada pintunya yang berat. Namun sang Putri Kematian punya pintu masuk lain dalam rencananya."
      Speaker = "Storyteller"
      Event = "Inspect_I_PreBoss02_01"
    }
    {
      Id = "MelinoeField_4266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saatnya menyelam sebentar..."
      Speaker = "Melinoe"
      Event = "Inspect_I_PreBoss02_01"
    }
    {
      Id = "Storyteller_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sungai Styx di sini kembali mengalir merah, sama seperti di masa-masa lampau, terus mengalir ke jantung Dunia Bawah; meski di seantero Tartarus, kilau emas sang Titan masih berpendar."
      Speaker = "Storyteller"
      Event = "Inspect_I_PreBoss02_02"
    }
    {
      Id = "MelinoeField_4267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Takkan berkilau selamanya."
      Speaker = "Melinoe"
      Event = "Inspect_I_PreBoss02_02"
    }
    {
      Id = "Storyteller_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aula megah bekas Kediaman Hades yang porak-poranda kini terdiam sunyi mencekam. Menyadari sang Titan abadi akan kembali, sang Putri kegelapan mencari sebuah benda yang mungkin menjadi kunci bagi kebuntuannya."
      Speaker = "Storyteller"
      Event = "Inspect_I_Boss01_01"
    }
    {
      Id = "MelinoeField_1438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harusnya benda itu masih ada di kamar sang Pangeran..."
      Speaker = "Melinoe"
      Event = "Inspect_I_Boss01_01"
    }
    {
      Id = "Storyteller_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hanya terkalahkan untuk sementara, si licik Chronos mustahil dihancurkan begitu saja; namun dalam setiap kemenangan singkat melawannya, Melinoë yang tangguh memulihkan secuil hal yang ia kira telah sirna."
      Speaker = "Storyteller"
      Event = "Inspect_I_Boss01_02"
    }
    {
      Id = "MelinoeField_1439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku masih ingat sekilas bayangan tentang tempat ini..."
      Speaker = "Melinoe"
      Event = "Inspect_I_Boss01_02"
    }
    {
      Id = "Storyteller_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bahkan para dewa abadi pun tak mampu sepenuhnya menahan hempasan kekuatan Waktu yang tak kenal ampun; namun pada malam ini, sang Putri Kematian tampaknya berhasil melakukan hal mustahil itu."
      Speaker = "Storyteller"
      Event = "Inspect_I_Boss01_03"
    }
    {
      Id = "MelinoeField_3615"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa aku sudah mulai paham sedikit soal Waktu..."
      Speaker = "Melinoe"
      Event = "Inspect_I_Boss01_03"
    }
    {
      Id = "Storyteller_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Putri Kematian kini tak hanya bertempur hingga ke ujung Bumi, namun hingga ke ujung Waktu; sebuah pencapaian luar biasa bagi sosok yang masih begitu belia."
      Speaker = "Storyteller"
      Event = "Inspect_I_Boss01_04"
    }
    {
      Id = "MelinoeField_3655"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, begitulah..."
      Speaker = "Melinoe"
      Event = "Inspect_I_Boss01_04"
    }
    {
      Id = "Storyteller_0527"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Untuk sesaat, Waktu terdiam kaku... terhantam oleh tombak bertuah Gigaros, dan kini rentan sementara terhadap langkah pamungkas yang telah direncanakan oleh sang Putri Kematian."
      Speaker = "Storyteller"
      Event = "Inspect_I_Boss01TrueEnding_01"
    }
    {
      Id = "MelinoeField_3881"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...kini giliran Zagreus untuk menjalankan perannya."
      Speaker = "Melinoe"
      Event = "Inspect_I_Boss01TrueEnding_01"
    }
    {
      Id = "Storyteller_0520"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah penglihatan tentang Kediaman Hades yang dikuasai Sang Titan Waktu... satu kemungkinan yang bisa saja terjadi, andai sang Putri tak baru saja memusnahkannya."
      Speaker = "Storyteller"
      Event = "Inspect_I_Boss01_05"
    }
    {
      Id = "MelinoeField_5023"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bisa terbiasa dengan ini."
      Speaker = "Melinoe"
      Event = "Inspect_I_Boss01_05"
    }
    {
      Id = "MelinoeField_3553"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Anubis yang agung, anugerahkan padaku dan Descura kekuatan palung neraka."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3554"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga sang Morrigan menajamkan Lim dan Oros untuk membunuh."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3555"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Supay yang perkasa, kobarkan api Ygnium lebih membara lagi."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3556"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga Nergal memberi wujud Zorephet ini kekuatan yang jauh lebih dahsyat."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3557"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga dewi kegelapan Hel membangkitkan kekuatan tak terhingga di dalam Revaal."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3558"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Shiva yang agung, berikan pada Xinth segenap daya penghancurmu."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3876"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Cih! {#Prev}Di mana dia?!"
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Terengah> {#Prev}Fiuh..."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Terengah> {#Prev}...Aku pulang..."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Batuk> {#Prev}Chronos...!"
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Batuk>"
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Batuk>"
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Batuk> {#Prev}Wah... berhasil..."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Batuk> Fiuuh... {#Prev}luar biasa..."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4197"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Batuk> {#Prev}Oh, halo...!"
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Batuk> {#Prev}...segar sekali..."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_5574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sudah terlalu lama menghantui mimpiku..."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_5575"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan lagi menderita mimpi buruk karenamu..."
      Speaker = "Melinoe"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_1517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dia {#Prev}sekarang adalah tamuku."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0984"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mencari seseorang?"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tamu, pada jam segini?"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita bertemu lagi, cucuku."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_1048"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau lagi..."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0983"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang telah kau perbuat...?"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0982"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau {#Emph}berani {#Prev}kembali?"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ahh. {#Prev}Selamat datang, cucuku."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo lagi, cucuku."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo, cucuku."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0189"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang kembali."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0191"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau masih saja bersikeras."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, akhirnya."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0193"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mendekatlah..."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rupanya ada tamu."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jauh-jauh datang lagi ke mari..."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0015"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Putri Hades telah kembali!"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0017"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang di Rumahku."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0018"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau menyia-nyiakan sisa waktumu yang sangat berharga itu."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0030"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan berani-berani menguji kesabaranku di sini."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0799"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali lagi rupanya."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0800"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan tidak terlambat sedetik pun."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0801"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya, kau cukup tepat waktu."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0802"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cucuku tercinta."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0980"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan {#Emph}lagi..."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0981"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sialan..."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0804"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sangat mudah ditebak."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0805"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, wah..."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0979"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pengawal?! {#Prev}...Dasar para pengecut."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0798"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau terlihat agak kurang sehat."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_1207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau terlambat."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_1208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktumu sudah hampir habis..."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_1209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau kelihatan agak kehabisan napas..."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_1210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tampak terburu-buru sekali..."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_1211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada Waktu tersisa bagimu..."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_1212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenapa lama sekali?"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0803"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah kembali dari permukaan?"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0946"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, gaun yang sungguh elok."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0947"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Serba hitam persis seperti ayahmu."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0948"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah, kau bawa baju ganti!"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0949"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya kau berpakaian pantas untuk acara ini."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0806"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih pakai gaun itu?"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0807"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Suteramu masih utuh?"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0808"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sutera itu bisa bertahan selama ini?"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0809"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Suteramu telah melindungimu dengan baik."
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah Waktunya lagi, ya?"
      Speaker = "Chronos"
      Event = "I_Boss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_5380"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saatnya pulang..."
      Speaker = "Melinoe"
      Event = "ObstacleData[713431].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_5379"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenangan indah tentang Rumah yang sebenarnya..."
      Speaker = "Melinoe"
      Event = "ObstacleData[713431].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah tempat perlindungan tersembunyi yang telah lama terlupakan di Tartarus memberi sang Putri Kematian sedikit kelegaan... sama seperti yang pernah dirasakan kakaknya sendiri di masa lampau."
      Speaker = "Storyteller"
      Event = "Inspect_I_Reprieve01_01"
    }
    {
      Id = "MelinoeField_1433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Air di sini entah bagaimana masih mengalir cukup jernih..."
      Speaker = "Melinoe"
      Event = "Inspect_I_Reprieve01_01"
    }
    {
      Id = "Storyteller_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Para Satir dan hama piaraan mereka pernah berkeliaran di bagian atas Dunia Bawah, sibuk menyiapkan ritual nista demi menyambut kembalinya sang Penguasa Titan."
      Speaker = "Storyteller"
      Event = "Inspect_I_MiniBoss_01_01"
    }
    {
      Id = "MelinoeField_1663"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para Satir itu lebih pantas berada di sini daripada yang mereka kira."
      Speaker = "Melinoe"
      Event = "Inspect_I_MiniBoss_01_01"
    }
    {
      Id = "Storyteller_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Emas murni yang berkilau: logam yang dijauhi oleh Raja Dunia Bawah sejati bukan cuma karena sifatnya yang lunak, melainkan karena disukai sang ayah Titan-nya. Pengingat nyata akan zaman yang telah lampau."
      Speaker = "Storyteller"
      Event = "Inspect_I_MiniBoss_02_01"
    }
    {
      Id = "MelinoeField_1664"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang berkilau, tapi terus kenapa?"
      Speaker = "Melinoe"
      Event = "Inspect_I_MiniBoss_02_01"
    }
    {
      Id = "Storyteller_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Raja Dunia Bawah yang dulunya begitu ditakuti kini tampak tak ubahnya jiwa-jiwa malang dan terlaknat yang dulu terbelenggu menggantikannya, sebelum Titan Chronos yang licik membebaskan mereka."
      Speaker = "Storyteller"
      Event = "Inspect_I_Story01_01"
    }
    {
      Id = "MelinoeField_1431"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak termaafkan..."
      Speaker = "Melinoe"
      Event = "Inspect_I_Story01_01"
    }
    {
      Id = "Storyteller_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Terbelenggu rapat oleh rantai adamantit terkeras, sang mantan Tuan dan Penguasa Kematian kini menjadi tahanan di dalam alam yang telah ditakdirkan para Moirai menjadi hak miliknya."
      Speaker = "Storyteller"
      Event = "Inspect_I_Story01_02"
    }
    {
      Id = "MelinoeField_1432"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maafkan aku, Ayah..."
      Speaker = "Melinoe"
      Event = "Inspect_I_Story01_02"
    }
    {
      Id = "MelinoeField_4144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ibu! Ayah!"
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ibu. Ayah."
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4146"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluarga!"
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4147"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluarga."
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3318"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenang, gadis pintar."
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak mungkin... Cerberus...!"
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "Melinoe_1160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cerberus!"
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayah...!"
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1520"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayah...?"
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1521"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Emm... {#Prev}salam, Ayah..."
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1522"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, Ayah..."
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1523"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini aku..."
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1524"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini... aku..."
      Speaker = "Melinoe"
      Event = "I_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3407"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berantakan sekali..."
      Speaker = "Melinoe"
      Event = "ObstacleData[742074].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kamar mendiang Pangeran Dunia Bawah yang menghilang ini teronggok dalam kekacauan abadi; tersentuh oleh berlalunya Sang Waktu, tetapi tak pernah diusik selain itu, karena siapa pula yang berani?"
      Speaker = "Storyteller"
      Event = "Inspect_I_PostBoss01_01"
    }
    {
      Id = "MelinoeField_3859"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Persis seperti dugaan kita..."
      Speaker = "Melinoe"
      Event = "Inspect_I_PostBoss01_01"
    }
    {
      Id = "Storyteller_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cermin Malam kuno, perantara kekuatan purba yang gelap dari masa sebelum Sang Waktu berkuasa, teronggok terlupakan di antara seabrek barang milik sang Pangeran Dunia Bawah yang tertawan."
      Speaker = "Storyteller"
      Event = "Inspect_I_PostBoss01_02"
    }
    {
      Id = "MelinoeField_3860"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya cermin biasa, tak lebih..."
      Speaker = "Melinoe"
      Event = "Inspect_I_PostBoss01_02"
    }
    {
      Id = "MelinoeField_5040"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bertahanlah, Kepala Sekolah..."
      Speaker = "Melinoe"
      Event = "I_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamar sang Pangeran... Cermin itu..."
      Speaker = "Melinoe"
      Event = "I_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih sama persis..."
      Speaker = "Melinoe"
      Event = "I_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3406"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, Kak..."
      Speaker = "Melinoe"
      Event = "I_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3408"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu sebentar, Kak..."
      Speaker = "Melinoe"
      Event = "I_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_1412"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah digeledah di sana..."
      Speaker = "Chronos"
      Event = "ObstacleData[812338].DistanceTrigger.VoiceLines"
    }
    {
      Id = "Chronos_1410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia mustahil ada di sana..."
      Speaker = "Chronos"
      Event = "ObstacleData[811664].DistanceTrigger.VoiceLines"
    }
    {
      Id = "Chronos_1416"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pialang."
      Speaker = "Chronos"
      Event = "ObstacleData[816416].DistanceTrigger.VoiceLines"
    }
    {
      Id = "MelinoeField_5052"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tertawa>"
      Speaker = "Melinoe"
      Event = "ObstacleData[816416].DistanceTrigger.VoiceLines"
    }
    {
      Id = "MelinoeField_3577"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ratu Persephone! Pangeran Zagreus! Kembalilah pada kami!"
      Speaker = "Melinoe"
      Event = "OnUsedFunctionArgs.VoiceLines"
    }
    {
      Id = "Persephone_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë...! Kau... kau sudah tumbuh sebesar ini? Tapi tentu saja... begitulah kenyataannya. Aku... {#Emph}oh{#Prev}, hatiku..."
      Speaker = "Persephone"
      Event = "TrueEnding02"
    }
    {
      Id = "Zagreus_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah... hahah{#Prev}, Melinoë, ini benar-benar kau...! Wajahmu persis seperti pantulan di cermin mimpi buruk tempo hari... bertahun-tahun silam, bahkan sebelum si kecil dirimu dilahirkan. Apa kita berhasil...? {#Emph}Augh{#Prev}, tubuhku gemetar..."
      Speaker = "Zagreus"
      Event = "TrueEnding02"
    }
    {
      Id = "Chronos_1470"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka akan pulih, beri mereka waktu... dan beri aku {#Emph}kematian! {#Prev}Ayo lemparkan aku ke kehampaan terkutuk itu, sekarang juga! {#Emph}Kau{#Prev}, Anakku, atau si penyihir itu, atau {#Emph}kau{#Prev}, Cucuku, siapa pun di antara kalian! Karena aku sudah {#Emph}lelah {#Prev}dengan semua ini! Kalian mendambakan dunia tanpa diriku — ambillah, dunia itu {#Emph}milik kalian!"
      Speaker = "Chronos"
      Event = "TrueEnding02"
    }
    {
      Id = "Zagreus_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakek, jangan...! Bagaimana bisa Kakek bicara begitu setelah semua yang kita lalui bersama? Aku sudah bersumpah Kakek berada dalam lindunganku, dan... astaga para dewa... apa yang terjadi dengan tempat ini?"
      Speaker = "Zagreus"
      Event = "TrueEnding02"
    }
    {
      Id = "Chronos_1471"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}merebut {#Prev}tempat ini, itu kenyataannya, Zagreus. Dan aku {#Emph}menghancurkannya! {#Prev}Kau tak perlu membelaku lagi. Kau tak pernah mengenal diriku yang sebenarnya. Itu hanyalah sebuah... {#Emph}kemungkinan{#Prev}, tak lebih dari itu. Dan kau, Melinoë... tak kusangka aku... membuatmu menanggung semua ini. Lampiaskanlah dendammu."
      Speaker = "Chronos"
      Event = "TrueEnding02"
    }
    {
      Id = "MelinoeField_5190"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tidak. Keluarga kita sudah cukup menderita untuk sekarang. Siapa lagi yang mengingat apa yang terjadi? Ingatan yang begitu nyata, sejelas kenangan terindah yang kalian dekap, tapi berasal dari kehidupan lain yang mungkin saja kita jalani...! Ibu, apa Ibu ingat?"
      Speaker = "Melinoe"
      Event = "TrueEnding02"
    }
    {
      Id = "Persephone_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "A... aku ingat. Dulu kau... punya rasa ingin tahu yang tak ada habisnya saat masih kecil, dan... terkadang sampai membuatku kewalahan, jadi... Zagreus, dan Chronos, mereka... sering membantu merawatmu."
      Speaker = "Persephone"
      Event = "TrueEnding02"
    }
    {
      Id = "Hades_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku pun mulai mengingatnya sekarang. Bahwa Ayah tinggal bersama kita, setelah Zagreus menemukannya dan menerimanya kembali. Namun selama ini... aku hanyalah seorang tawanan. Tawanan {#Emph}miliknya{#Prev}, {#Emph}di sini{#Prev}, di masa kita saat ini..."
      Speaker = "Hades"
      Event = "TrueEnding02"
    }
    {
      Id = "HecateField_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ratu Persephone, Paduka Hades, {#Emph}jangan {#Prev}percaya {#Emph}kebohongan {#Prev}yang melintas di benak kalian! Bahkan putra dan putri kalian pun tampaknya terpengaruh. Kalian {#Emph}semua {#Prev}telah terhasut oleh sihir sang Titan!"
      Speaker = "Hecate"
      Event = "TrueEnding02"
    }
    {
      Id = "MelinoeField_5151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Guru, itu tidak benar! Apa Guru tidak mengerti? Penghancuran Waktu... inilah wujud yang kuhadirkan. Guru selalu berkata bahwa tugas ini milikku, begitu pula cara yang kuambil. Inilah jalan yang kupilih."
      Speaker = "Melinoe"
      Event = "TrueEnding02"
    }
    {
      Id = "HecateField_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu kau gagal! {#Emph}Kematian bagi Chronos {#Prev}adalah tugasnya, namun {#Emph}di sanalah {#Prev}dia berdiri! Melinoë... apa gerangan yang mendorongmu mengambil langkah semacam itu?"
      Speaker = "Hecate"
      Event = "TrueEnding02"
    }
    {
      Id = "MelinoeField_5152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ajaran Guru sendiri! Untuk berpikir dengan kepalaku sendiri, bukan hanya... patuh menuruti perintah! Tapi jika Guru masih percaya bahwa menghabisi Chronos akan melenyapkan semua masalah kita... lantas tunggu apa lagi?"
      Speaker = "Melinoe"
      Event = "TrueEnding02"
    }
    {
      Id = "HecateField_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku takkan pernah memaafkan apa yang telah diperbuat Titan ini... terhadap dunia ini, keluargamu, dirimu, ataupun diriku."
      Speaker = "Hecate"
      Event = "TrueEnding02"
    }
    {
      Id = "Persephone_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hecate sayang... dayang setiaku. Siapa yang menuntut maaf darimu? Belum pernah kudengar kepedihan sebesar ini darimu. Hal terakhir yang kuingat dari kehidupan ini... tepat sebelum Chronos menyerang, tugasmu adalah melindungi putri kami bagaimanapun caranya... dan kau berhasil melakukannya...! Kau telah berhasil melindunginya!"
      Speaker = "Persephone"
      Event = "TrueEnding02"
    }
    {
      Id = "Hades_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Di saat genting kami, kaulah satu-satunya yang bisa kami andalkan, Penyihir Simpang Jalan yang mulia. Untuk itu dan segalanya, terima kasih kami haturkan kepadamu. Untuk selamanya."
      Speaker = "Hades"
      Event = "TrueEnding02"
    }
    {
      Id = "HecateField_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Hamba hanya menjalankan amanat yang diemban, wahai Raja dan Ratu. Dan hamba tetap, seperti sediakala, setia mengabdi pada kalian.... Baiklah kalau begitu, Melinoë... apa rencana kita sekarang...?"
      Speaker = "Hecate"
      Event = "TrueEnding02"
    }
    {
      Id = "MelinoeField_5153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang...? Banyak sekali hal yang harus diselesaikan... menata kembali Griya ini, salah satunya! Ibu... Ayah... kalian sudah melihat apa yang mungkin terwujud. Mari kita beri Chronos satu kesempatan untuk membuktikan kegunaannya, dimulai dari upaya pemulihan ini. Maukah kalian mengabulkan permintaanku?"
      Speaker = "Melinoe"
      Event = "TrueEnding02"
    }
    {
      Id = "Persephone_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kukabulkan! Urusan kita belum selesai, Chronos. Kata orang, Waktu menyembuhkan segala luka. Buktikanlah kata-kata itu."
      Speaker = "Persephone"
      Event = "TrueEnding02"
    }
    {
      Id = "Hades_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kukabulkan. Namun hanya satu kesempatan ini. Atas kemurahan hati sang Putri Dunia Bawah."
      Speaker = "Hades"
      Event = "TrueEnding02"
    }
    {
      Id = "Chronos_1472"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kalian mau... memberiku kesempatan seperti itu? Namun aku tak bisa mengubah apa yang telah terjadi... tak bisa membatalkan keputusan-keputusan tak berampun yang telah kuambil."
      Speaker = "Chronos"
      Event = "TrueEnding02"
    }
    {
      Id = "MelinoeField_5154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau adalah Sang Waktu. Kami tak menuntutmu untuk berputar kembali ke masa lalu. Kami menuntutmu untuk terus melangkah maju."
      Speaker = "Melinoe"
      Event = "TrueEnding02"
    }
    {
      Id = "Chronos_1527"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melangkah maju... hanya itulah yang pernah kupahami seumur hidupku. Kalau begitu, aku akan meluangkan waktu... demi Griya ini... dan segalanya."
      Speaker = "Chronos"
      Event = "TrueEnding02"
    }
    {
      Id = "Hades_0404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Putriku, kumohon..."
      Speaker = "Hades"
      Event = "ObstacleData[772631].DistanceTriggers.VoiceLines"
    }
    {
      Id = "HecateField_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu apa lagi...?"
      Speaker = "Hecate"
      Event = "ObstacleData[560377].DistanceTriggers.VoiceLines"
