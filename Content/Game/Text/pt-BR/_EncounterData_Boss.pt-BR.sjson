    }
    {
      Id = "Typhon_0012"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#TyphonFormat}LAAAKNNNAAAT... KAAAUUU..."
      Speaker = "Typhon"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_4173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Inilah saatnya... tinggal buat dia melemah."
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_3187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama sekali tak bisa merasakan hawa kehidupannya..."
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_3189"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cuma musuh biasa, dia cuma musuh biasa..."
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_3331"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berani-beraninya kau menyembunyikan hawa kehidupanmu dari{#Emph}ku?!"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_3332"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebanyak apa pun nyawamu, akan kukuras sampai {#Emph}habis!"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_3333"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menyembunyikan hawa kehidupanmu? {#Emph}Pengecut!"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_3334"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar kulihat berapa sisa nyawamu saat kau terbujur {#Emph}kaku!"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_3002"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak takut padamu!"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_3003"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kaulah yang akan takut pada{#Emph}ku!"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_5352"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau seharusnya {#Emph}tak pernah ada!"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_5353"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan selalu {#Emph}dihancurkan!"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_5596"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau aku bisa mengatasi mimpi burukku, kenapa {#Emph}kau tidak?"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
      Id = "MelinoeField_5597"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau cuma sekadar mimpi buruk di sini!"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.FightStartVoiceLines"
    }
    {
