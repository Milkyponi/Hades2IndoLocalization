  lang = "pt-BR"
  Texts = [
    {
      Id = "MelinoeField_0917"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Emm... {#Prev}halo?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0918"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan! Duduk! Diam!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0919"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berkepala tiga... kau..."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cerberus, itukah dirimu?!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan menolongmu, kawan! Apa pun yang terjadi!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang diselimuti magma... Sumpah Persaingan yang menyebabkan semua ini?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah dia sudah pergi...?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan, ternyata belum. Tenanglah, Cerberus! Kita akan membereskan ini..."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4571"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau suka bisa berkeliaran bebas di sini, kan?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu kau tidak suka dimandikan, tapi sudah waktunya!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0920"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak akan menyingkir, kan?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0921"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memangnya menurutmu apa yang sedang kau jaga, {#Emph}hm?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0926"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sangat waspada, kuakui itu."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0927"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang penjaga gerbang neraka..."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0923"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Awas..."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_5569"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo, piaraan rumah ganas khayalan!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_5570"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seharusnya aku memimpikan saat-saat yang lebih indah bersamamu...!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, kawan! Waktunya bermain lagi untukmu sekarang?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4568"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo lagi, Cerberus! Bisa kita mulai?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4569"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hai kawan! Mari lakukan giliran kita."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4570"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Energimu banyak sekali untuk ukuran anjing tua!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0922"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maafkan aku, tapi aku harus lewat."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0924"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak takut padamu..."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0925"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan lampiaskan kesedihanmu padaku!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa ini cuma waktu bermain bagimu, kawan?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, kawan! Kita lakukan ini {#Emph}persis {#Prev}seperti sebelumnya!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Habis main lumpur lagi ya, kawan?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3536"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan mendinginkanmu secepat mungkin di sini, kawan..."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3537"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya magma itu sudah hilang untuk saat ini..."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan segera merasa baikan, Cerberus, aku bersumpah!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya dia membentuk cangkang..."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kupecahkan cangkangmu itu!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hecuba, kenalkan ini Cerberus!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tidak takut anjing kan, Toula?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0928"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan segera merasa baikan lagi, Cerberus."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0929"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau kotor belepotan lagi."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0930"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Habis berguling-guling di Miasma, ya?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0931"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chronos pasti mengusirnya lagi."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0932"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan melukaimu, Cerberus."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0933"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cerberus, ini aku! Kau tidak ingat?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktunya dibersihkan lagi, ya?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu kau marah! Percayalah, aku juga!"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau masih belum mengenaliku, anak pintar?"
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1115"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia bergerak murni berdasarkan naluri sekarang..."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku harus menenangkannya..."
      Speaker = "Melinoe"
      Event = "BossInfestedCerberus01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3004"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Typhon!"
      Speaker = "Melinoe"
      Event = "BossTyphonHead01.PreFightVoiceLines"
    }
