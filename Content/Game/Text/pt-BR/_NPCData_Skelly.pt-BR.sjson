      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Skelly_0694"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lima kali... berturut-turut...?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Skelly_0695"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku... lupa... hitungannya..."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Skelly_0407"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Woi, ayolah kawan-kawan!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0408"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cuma segitu kemampuan kalian, wahai Arwah?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0409"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak mempan."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lemah!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0352"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kira-kira muka gue mirip tiang garukan kucing apa?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0353"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hatsyi!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0354"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hatsyi..."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tongkat itu mantap juga bobotnya!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0218"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yakin itu bukan tongkat jalan buat lansia?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0546"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tongkatmu itu benar-benar kamu poles habis-habisan, ya!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasanya kayak disengat lebah..."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0506"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayatan yang belum pernah kurasakan sebelumnya!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tebasan itu menusuk sampai ke tulang!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0178"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tebasan yang mantap!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0179"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekuatan yang luar biasa!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buset {#Emph}dah!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0550"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, nah {#Emph}itu {#Prev}dia baru mantap!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0181"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh{#Prev}, panasnya membakar!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0182"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, panas membara itu tadi!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0548"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Panasnya bukan main!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tadi aku hampir bergeser!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Boleh juga Tengkorak milikmu itu!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0552"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tengkorak yang hampir sekeren punyaku!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0424"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh, {#Prev}rahangku!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0425"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pukulan {#Prev}yang hebat!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0426"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kena telak aku tadi!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benda {#Emph}apaan {#Prev}itu tadi?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0428"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Duaaar{#Prev}, begitu dong!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "K-kau dengar suara berdenging itu...?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu baru namanya {#Emph}panas membara!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0554"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau benar-benar {#Emph}meremukkanku {#Prev}di sini!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0746"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bakal tetap di sini!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0747"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tidak akan bergeser!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0166"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Murid-murid, perhatikan dan pelajari!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Perhatikan baik-baik, murid-muridku!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian semua lihat teknik itu?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0169"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, beri pelajaran para Arwah di belakang sana!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0018"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lagi!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0019"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lagi, sialan!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kerahkan seluruh tenagamu!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0054"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau ini penyihir atau bukan, sih?!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hantaman yang mantap."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat di tempat ulu hatiku dulunya berada!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat kena tulang belakang!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat di tulang rusuk!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekali lagi!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan menyerah!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ambil langkah berikutnya, Bocah."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnHitVoiceLines"
    }
    {
      Id = "Skelly_0023"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku telah kembali."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bangkit lagi."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0286"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan pernah terima kekalahan!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0288"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada kabar apa?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Banyak hal yang telah kulihat..."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0529"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku di sini, aku di {#Emph}sini{#Prev}, ada apa nih?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0530"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, tunggu, aku kembali, cuma istirahat sebentar!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0531"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Uh {#Prev}hei, mau coba barang itu?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0537"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin kau ingin berlatih sedikit?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0538"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa yang berani mengacungkan Senjata Nokturnal?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0539"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, hei, kalian semua masih berdiri di situ..."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0540"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semadi suciku telah tuntas!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0718"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ooh{#Prev}, kau harus coba yang itu ke {#Emph}aku!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0719"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sini, hajar {#Emph}aku {#Prev}pakai itu!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0720"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa aku baru mendengar seseorang mengganti Senjata Nokturnal?!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0721"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Istirahat di tempat, para muridku!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0722"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke, aku ketinggalan apa nih?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0723"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gimana kabar semuanya?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0724"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian semua masih di sini, {#Emph}ya?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0725"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, {#Emph}itu {#Prev}tadi menarik juga."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa yang memanggilku?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0533"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa yang memanggilku? Oh, {#Emph}kau {#Prev}lagi!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0534"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa yang memanggilku? Ya, sudah kuduga."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0535"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku di sini!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0536"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku di sini! Dan kau di sebelah sana."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnSpawnVoiceLines"
    }
    {
      Id = "Skelly_0022"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat, 'kan?"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnRespawnVoiceLines"
    }
    {
      Id = "Skelly_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita lanjutkan."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnRespawnVoiceLines"
    }
    {
      Id = "Skelly_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita selalu bisa bangkit lagi."
