{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Skelly.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_1708"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kematian bagi Chronos, Komandan."
      Speaker = "Melinoe"
      Event = "NPC_Skelly_01.InteractVoiceLines"
    }
    {
      Id = "Skelly_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.InteractVoiceLines"
    }
    {
      Id = "Skelly_0156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam, anak muda."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.InteractVoiceLines"
    }
    {
      Id = "Skelly_0158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali untukmu."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.InteractVoiceLines"
    }
    {
      Id = "Skelly_0160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harus begitu!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.InteractVoiceLines"
    }
    {
      Id = "Skelly_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Serius nih."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.InteractVoiceLines"
    }
    {
      Id = "Skelly_0162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cahaya rembulan, ya."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.InteractVoiceLines"
    }
    {
      Id = "Skelly_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Habisi dia, bocah."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.InteractVoiceLines"
    }
    {
      Id = "Skelly_0164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, bunuh dia!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3273"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tugasnya selesai...!"
      Speaker = "Melinoe"
      Event = "NPC_Skelly_01.TrophyUnlockedVoiceLines"
    }
    {
      Id = "Skelly_0309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan sekarang... untuk Sang Jawara Malam, {#Emph}inilah hadiahnya..."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.TrophyUnlockedVoiceLines"
    }
    {
      Id = "Melinoe_3274"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh..."
      Speaker = "Melinoe"
      Event = "NPC_Skelly_01.TrophyUnlockedVoiceLines"
    }
    {
      Id = "Skelly_0314"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang, anak muda: Palingkan matamu, jangan sampai kau terpana oleh {#Emph}kemegahan {#Prev}di sebelah sini!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.TrophyUnlockedVoiceLines"
    }
    {
      Id = "Skelly_0319"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atas pencapaianmu yang {#Emph}luar biasa{#Prev}, terimalah Hadiah paling {#Emph}luar biasa{#Prev} dari segalanya!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.TrophyUnlockedVoiceLines"
    }
    {
      Id = "Skelly_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu pertempuran kalah. Tapi ini {#Emph}perang{#Prev}, anak muda, dan masih banyak pertempuran yang menanti! Pertanyaannya sekarang, apakah kau siap untuk {#Emph}menang? {#Prev}Aku agak ragu, jadi coba {#DialogLegendaryFormat}beri aku {#Prev}{#EmphLegendary}dua puluh pukulan!"
      Speaker = "Skelly"
      Event = "SkellyFirstMeeting"
    }
    {
      Id = "Melinoe_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan Schelemeus. Anda yakin tidak apa-apa kalau saya memukul Anda dua puluh kali di depan semua murid Anda?"
      Speaker = "Melinoe"
      Event = "SkellyFirstMeeting"
    }
    {
      Id = "Skelly_0452"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Yakin banget. {#Prev}Sekarang serang aku dengan segenap kekuatanmu!"
      Speaker = "Skelly"
      Event = "SkellyFirstMeeting"
    }
    {
      Id = "Melinoe_0019_V3"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siap laksanakan!"
      Speaker = "Melinoe"
      Event = "SkellyFirstMeeting"
    }
    {
      Id = "Skelly_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh halo, anak muda, aku cuma lagi santai-santai di sini... lagipula ilmu apa lagi yang bisa kubagikan pada orang yang menaklukkan sang {#DialogLegendaryFormat}Titan Waktu {#Prev}seperti membalikkan telapak tangan?"
      Speaker = "Skelly"
      Event = "SkellyAboutEarlyRunClear01"
    }
    {
      Id = "Melinoe_4159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, saya hanya ingin berterima kasih. Kalau bukan berkat semua ajaran Anda di masa lalu, saya tidak akan menang."
      Speaker = "Melinoe"
      Event = "SkellyAboutEarlyRunClear01"
    }
    {
      Id = "Skelly_0471"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah, tentu! Aku hampir lupa ajaranku di masa lalu! Sebagai gantinya, kuucapkan selamat karena berhasil meraih hal yang sebelumnya kutaruhkan mustahil di depan para muridku di sini..."
      Speaker = "Skelly"
      Event = "SkellyAboutEarlyRunClear01"
    }
    {
      Id = "Melinoe_4160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, Anda {#Emph}bertaruh...?"
      Speaker = "Melinoe"
      Event = "SkellyAboutEarlyRunClear01"
    }
    {
      Id = "Skelly_0472"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nggak kok!"
      Speaker = "Skelly"
      Event = "SkellyAboutEarlyRunClear01"
    }
    {
      Id = "Skelly_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalanmu penuh rintangan, anak muda. Ketahuilah bahwa aku {#Emph}selalu {#Prev}ada di sini agar kau bisa melampiaskan {#Emph}semua {#Prev}kemarahan dan rasa frustrasimu, sekaligus untuk berlatih."
      Speaker = "Skelly"
      Event = "SkellyAboutTask01"
    }
    {
      Id = "Melinoe_0072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Guru terbaik ada di luar sana..."
      Speaker = "Melinoe"
      Event = "SkellyAboutTask01"
    }
    {
      Id = "Skelly_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukannya mau menyindir kalau kau itu {#DialogLegendaryFormat}pemalas{#Prev}, tapi aku tak bisa menahan diri untuk melihat sudah beberapa malam berlalu sejak terakhir kali kau menghabisiku, anak muda."
      Speaker = "Skelly"
      Event = "SkellyAboutBeatings01"
    }
    {
      Id = "Melinoe_4052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir latihanku di sini sudah kurang lebih selesai, Komandan. Semua Senjata Nokturnal sudah kukuasai dan kupahami dengan baik. Apakah saya harus terus menghancurkan Anda menjadi abu?"
      Speaker = "Melinoe"
      Event = "SkellyAboutBeatings01"
    }
    {
      Id = "Skelly_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, pilihannya {#Emph}memang {#Prev}tersurat padamu, tentu saja, tapi jangan sampai kau lupa: Selalu ada hal baru untuk dipelajari, dan cuma ada satu cara untuk mempelajarinya!"
      Speaker = "Skelly"
      Event = "SkellyAboutBeatings01"
    }
    {
      Id = "Melinoe_4053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengan memukuli Anda berkali-kali."
      Speaker = "Melinoe"
      Event = "SkellyAboutBeatings01"
    }
    {
      Id = "Skelly_0443"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan sesering mungkin, sekarang {#Emph}ayolah!"
      Speaker = "Skelly"
      Event = "SkellyAboutBeatings01"
    }
    {
      Id = "Skelly_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kadang seseorang harus menahan emosinya, dan di lain waktu, tahu kapan harus melampiaskannya. Dan saat kau ingin melampiaskannya, atau menguji salah satu dari {#DialogLegendaryFormat}Senjata Nokturnal {#Prev}itu, ketahuilah kalau aku ada di sini."
      Speaker = "Skelly"
      Event = "SkellyAboutEmotions01"
    }
    {
      Id = "Melinoe_0075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarahan ini hanya untuk Chronos, Tuan."
      Speaker = "Melinoe"
      Event = "SkellyAboutEmotions01"
    }
    {
      Id = "Skelly_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat betapa sabarnya murid-muridku, mempelajari setiap gerak-gerikmu! Jika sewaktu-waktu kau berniat memamerkan kebolehanmu pada mereka, atau sekadar ingin melepas penat, jangan ragu untuk {#DialogLegendaryFormat}menghajarku habis-habisan{#Prev}."
      Speaker = "Skelly"
      Event = "SkellyAboutTraining01"
    }
    {
      Id = "Melinoe_2256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Menghajar habis-habisan{#Prev}, Tuan...?"
      Speaker = "Melinoe"
      Event = "SkellyAboutTraining01"
    }
    {
      Id = "Skelly_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingatlah bahwa kau berlatih dengan lawan tak bersenjata di sini, anak muda. Di luar sana, para kerangka itu bisa {#Emph}bergerak{#Prev}... dan mereka bakal mencabik-cabikmu begitu ada celah! Kau takkan belajar mengatasi tekanan macam itu hanya dengan sparring melawanku."
      Speaker = "Skelly"
      Event = "SkellyAboutTraining02"
    }
    {
      Id = "Melinoe_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mengerti."
      Speaker = "Melinoe"
      Event = "SkellyAboutTraining02"
    }
    {
      Id = "Skelly_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah mulai terbiasa sama tongkat jalanmu itu? Ada barang lain yang mungkin lebih kau sukai di {#DialogLegendaryFormat}Kubangan {#Prev}di belakang sana, kalau kau punya cukup {#DialogLegendaryFormat}Perak{#Prev}. Yang penting jangan lupa uji coba semuanya ke aku, ya!"
      Speaker = "Skelly"
      Event = "SkellyAboutStaff01"
    }
    {
      Id = "Melinoe_2257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan bicara buruk soal Descura, Tuan."
      Speaker = "Melinoe"
      Event = "SkellyAboutStaff01"
    }
    {
      Id = "Skelly_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semangat amat mau langsung turun ke medan perang dan menghajar musuh pakai cara lama, anak muda! Kalau begitu, kau tak perlu berhenti demi menyapaku. {#DialogLegendaryFormat}Berangkat saja sana!"
      Speaker = "Skelly"
      Event = "SkellyAboutChatting01"
    }
    {
      Id = "Melinoe_3803"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya tidak sopan bergegas melewati Crossroads ini tanpa menyapa sepatah kata pun. Lagipula, Anda pasti punya wejangan berharga untuk disampaikan."
      Speaker = "Melinoe"
      Event = "SkellyAboutChatting01"
    }
    {
      Id = "Skelly_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jelas punya, dan wejangannya begini: Kalau kau lihat ada tanda di atas kepalaku atau siapa pun yang seolah berteriak {#Emph}kemarilah, ajak aku ngobrol{#Prev}, ingat ini... tak usah diajak bicara kalau kau lagi malas basa-basi, oke?"
      Speaker = "Skelly"
      Event = "SkellyAboutChatting01"
    }
    {
      Id = "Melinoe_3804"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Abaikan saja siapa pun yang sedang tidak ingin kuajak bicara, begitu maksudnya."
      Speaker = "Melinoe"
      Event = "SkellyAboutChatting01"
    }
    {
      Id = "Skelly_0395"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali, memangnya mereka siapa!"
      Speaker = "Skelly"
      Event = "SkellyAboutChatting01"
    }
    {
      Id = "Melinoe_4161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu penasaran tentang satu hal, Komandan. Ke mana Anda pergi saat sedang tidak berada di sini? Maksudku, terkadang Anda baru muncul setelah aku berganti Senjata Nokturnal..."
      Speaker = "Melinoe"
      Event = "SkellyAboutDying01"
    }
    {
      Id = "Skelly_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan urusan siapa-siapa selain urusanku sendiri, anak muda! Bukankah kita semua butuh waktu menyendiri? Tempat di mana kita bisa menenangkan pikiran dan merenung sejenak?"
      Speaker = "Skelly"
      Event = "SkellyAboutDying01"
    }
    {
      Id = "Melinoe_4162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, Tuan... maafkan aku karena lancang bertanya. Kita adalah Kaum Tak Kasatmata; kita berdiam dalam kesenyapan dan menjaga rahasia kita."
      Speaker = "Melinoe"
      Event = "SkellyAboutDying01"
    }
    {
      Id = "Skelly_0474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan kita tidak kepo mencampuri urusan pribadi sesama rekan."
      Speaker = "Skelly"
      Event = "SkellyAboutDying01"
    }
    {
      Id = "Skelly_0619"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba ingat-ingat kembali ke awal mula semua ini, anak muda. Menurut perkiraanmu sendiri, sudah berapa kali kau menghabisiku?"
      Speaker = "Skelly"
      Event = "SkellyAboutDying02"
    }
    {
      Id = "Melinoe_4982"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entahlah... Aku ingat jelas ada sembilan belas kali, tapi pasti aslinya bisa jauh lebih banyak dari itu. Memangnya kenapa?"
      Speaker = "Melinoe"
      Event = "SkellyAboutDying02"
    }
    {
      Id = "Skelly_0620"
      InheritFrom = "BaseNarrative"
      DisplayName = "Soalnya aku sedang mengejar target tertentu, itu alasannya. Kalau kau menghabisiku sampai batas jumlah tertentu... anggap saja ini bakal bagus buat karier militirku."
      Speaker = "Skelly"
      Event = "SkellyAboutDying02"
    }
    {
      Id = "Melinoe_4983"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan saja berapa kali Anda harus kubunuh."
      Speaker = "Melinoe"
      Event = "SkellyAboutDying02"
    }
    {
      Id = "Skelly_0621"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maunya sih begitu, tapi aku tidak bisa mengatakannya. Pokoknya bantai saja aku sesekali, oke?"
      Speaker = "Skelly"
      Event = "SkellyAboutDying02"
    }
    {
      Id = "Skelly_0622"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, kau berhasil mencapainya, Sobat! Tahu tidak sudah berapa kali kau membunuhku sekarang? Coba tebak angka yang {#Emph}besar."
      Speaker = "Skelly"
      Event = "SkellyAboutDying03"
    }
    {
      Id = "Melinoe_4984"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau maksud Anda sejak {#Emph}paling {#Prev}awal, pasti sudah setidaknya seribu kali sejak aku masih kecil. Aku sudah menebas Anda sejak tanganku bahkan hampir tak kuat menggenggam pedang..."
      Speaker = "Melinoe"
      Event = "SkellyAboutDying03"
    }
    {
      Id = "Skelly_0623"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudku baru-baru ini saja, sih, yang mendekati tiga puluh lima kali, tapi aku suka antusiasmemu itu, anak muda!"
      Speaker = "Skelly"
      Event = "SkellyAboutDying03"
    }
    {
      Id = "Melinoe_4985"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anda bilang kalau mencapai ambang batas kematian tertentu, itu bakal berguna bagi dinas militer Anda?"
      Speaker = "Melinoe"
      Event = "SkellyAboutDying03"
    }
    {
      Id = "Skelly_0624"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Iya, sekarang aku dapat diskon khusus!"
      Speaker = "Skelly"
      Event = "SkellyAboutDying03"
    }
    {
      Id = "Melinoe_4986"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Diskon untuk apa?"
      Speaker = "Melinoe"
      Event = "SkellyAboutDying03"
    }
    {
      Id = "Skelly_0625"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Itu rahasia militer."
      Speaker = "Skelly"
      Event = "SkellyAboutDying03"
    }
    {
      Id = "Skelly_0633"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti merasa sudah cukup hebat sekarang, anak muda. Senjata Nokturnal? Punya semua. Monster, Titan? Lewat. Tapi menurutku, kau masih kekurangan satu hal."
      Speaker = "Skelly"
      Event = "SkellyAboutPrestige01"
    }
    {
      Id = "Melinoe_4993"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu... apa kekuranganku menurut perkiraan Anda, Komandan? Anda mungkin lebih memahami titik kelemahanku daripada aku sendiri."
      Speaker = "Melinoe"
      Event = "SkellyAboutPrestige01"
    }
    {
      Id = "Skelly_0634"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang kurang darimu adalah kesetiaan dan rasa hormat seumur hidup—atau lebih tepatnya semati hidup—dari para muridku di sini. Di depanmu mereka memang bisa tersenyum ramah, tapi di belakangmu? Entahlah..."
      Speaker = "Skelly"
      Event = "SkellyAboutPrestige01"
    }
    {
      Id = "Melinoe_4994"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Jika mereka bersikap mencemooh, mungkin mereka memang tidak pantas berada di barisan kita."
      Speaker = "Melinoe"
      Event = "SkellyAboutPrestige01"
    }
    {
      Id = "Skelly_0635"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, {#Emph}tunggu dulu! {#Prev}Maksudku, mungkin sebaiknya kau membelanjakan lebih banyak {#DialogLegendaryFormat}Kudos {#Prev}untuk tempat ini. Lewat Bayangan cerewet di sana itu, lho! Itu pasti bakal bikin semua orang tunduk dan menghormatimu!"
      Speaker = "Skelly"
      Event = "SkellyAboutPrestige01"
    }
    {
      Id = "Melinoe_4995"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Membelanjakan Kudos lebih banyak, baiklah..."
      Speaker = "Melinoe"
      Event = "SkellyAboutPrestige01"
    }
    {
      Id = "Skelly_0636"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil, Sobat! Para muridku sangat terkesan, bukan cuma karena kehebatan bertarungmu, tapi juga berkat semua {#DialogLegendaryFormat}Kudos {#Prev}yang telah kau kucurkan, yang benar-benar membuat Crossroads ini jauh lebih semarak."
      Speaker = "Skelly"
      Event = "SkellyAboutPrestige02"
    }
    {
      Id = "Melinoe_4996"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang rasanya bisa mendapat kesempatan ini. Godaan untuk terus fokus pada pembenahan di sekitar kuali memang besar, padahal area latihan ini juga membutuhkan perhatian."
      Speaker = "Melinoe"
      Event = "SkellyAboutPrestige02"
    }
    {
      Id = "Skelly_0637"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harus bikin kesan pertama yang bagus buat para rekrutan baru, dong!"
      Speaker = "Skelly"
      Event = "SkellyAboutPrestige02"
    }
    {
      Id = "Skelly_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang berubah dari {#DialogLegendaryFormat}Altar{#Prev}-mu akhir-akhir ini, dan kau makin sering bolak-balik ke sana, anak muda! Jangan-jangan kau membangkitkan kekuatan baru di sana, ya?"
      Speaker = "Skelly"
      Event = "SkellyAboutCardUpgradeSystem01"
    }
    {
      Id = "Melinoe_3364"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah menyucikan Debu Abu dan memahami potensi dari Arcana, Komandan. Butuh sedikit Debu Bulan, dan banyak fokus... atau mungkin malah sebaliknya."
      Speaker = "Melinoe"
      Event = "SkellyAboutCardUpgradeSystem01"
    }
    {
      Id = "Skelly_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#DialogLegendaryFormat}Debu Rembulan? {#Prev}Kayaknya si {#DialogLegendaryFormat}Makelar {#Prev}tua itu udah mulai ngejual barang begituan, meski aku {#Emph}pernah {#Prev}denger penyihir sepertimu bisa meraciknya sendiri. Mendingan kau mulai nyetok banyak-banyak!"
      Speaker = "Skelly"
      Event = "SkellyAboutCardUpgradeSystem01"
    }
    {
      Id = "Melinoe_3365"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya memang harus begitu..."
      Speaker = "Melinoe"
      Event = "SkellyAboutCardUpgradeSystem01"
    }
    {
      Id = "Skelly_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti ada sesuatu yang terjadi sama {#DialogLegendaryFormat}Genangan Perak {#Prev}di sana, aku bisa merasakannya, Nak! Ulahmu, atau mungkin campur tangan para Moirai sendiri?"
      Speaker = "Skelly"
      Event = "SkellyAboutAspects01"
    }
    {
      Id = "Melinoe_2529"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil menyingkap Aspek dari Senjata Nokturnal di Kolam itu. Bukan wujud aslinya, memang... melainkan wujud lain, yang punya kekuatannya tersendiri."
      Speaker = "Melinoe"
      Event = "SkellyAboutAspects01"
    }
    {
      Id = "Skelly_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah, {#DialogLegendaryFormat}Senjata Nokturnal{#Prev}! Saudaramu dulu juga pakai senjata tandingannya, dan itu juga bisa berubah jadi bentuk lain. Yah, kalau kau butuh tempat buat nguji kekuatan barumu, aku siap di sini."
      Speaker = "Skelly"
      Event = "SkellyAboutAspects01"
    }
    {
      Id = "Melinoe_2530"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mengerti, Komandan."
      Speaker = "Melinoe"
      Event = "SkellyAboutAspects01"
    }
    {
      Id = "Skelly_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap {#DialogLegendaryFormat}Gigi {#Prev}berkah yang kuberikan padamu itu sangat berharga? Walau, berhubung kau sudah balik lagi ke sini, mungkin belum cukup berharga ya..."
      Speaker = "Skelly"
      Event = "SkellyAboutKeepsake01"
    }
    {
      Id = "Melinoe_2586"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pasti takkan bisa melangkah sejauh ini tanpa Kenang-kenanganmu, Komandan. Tapi, kenapa namanya {#Emph}Gigi yang Lebih Beruntung{#Prev}? Apa ada gigi lain selain ini?"
      Speaker = "Melinoe"
      Event = "SkellyAboutKeepsake01"
    }
    {
      Id = "Skelly_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu tidak! Ini artefak yang beneran tiada duanya, didapat dari jerih payah perjalananku. Artefak yang bakal bikin kau bertahan hidup layaknya pelaut di kapal yang lagi karam."
      Speaker = "Skelly"
      Event = "SkellyAboutKeepsake01"
    }
    {
      Id = "Melinoe_2587"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Penggambaran yang sangat gamblang..."
      Speaker = "Melinoe"
      Event = "SkellyAboutKeepsake01"
    }
    {
      Id = "Melinoe_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan... pasti ada sesuatu yang bisa kau ceritakan tentang saudaraku. Semakin kuat ikatanku dengannya, semakin besar peluang kita. Kau mengenalnya, bukan?"
      Speaker = "Melinoe"
      Event = "SkellyAboutZagreus01"
    }
    {
      Id = "Skelly_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kenal saudaramu, ya. Anak baik, hampir di setiap saat. Dia pasti nggak mau kau terlalu kepikiran soal dia. Yang dia inginkan... lebih dari apa pun, kurasa... adalah agar kau... {#DialogLegendaryFormat}memukulku{#Prev}. Sekeras mungkin, berulang kali dan sesering mungkin, dan {#Emph}itu {#Prev}juga yang kuinginkan darimu!"
      Speaker = "Skelly"
      Event = "SkellyAboutZagreus01"
    }
    {
      Id = "Melinoe_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ungh{#Prev}, baiklah kalau begitu."
      Speaker = "Melinoe"
      Event = "SkellyAboutZagreus01"
    }
    {
      Id = "Melinoe_4171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudaraku pasti luar biasa kuat, sampai-sampai terkadang bisa mengimbangi ayah saat mereka berlatih tanding. Apa ada jurus andalannya yang bisa kau ajarkan padaku?"
      Speaker = "Melinoe"
      Event = "SkellyAboutZagreus02"
    }
    {
      Id = "Skelly_0487"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja {#Emph}tidak ada! {#Prev}Murid-muridku masing-masing harus menempuh jalan mereka sendiri. Tetaplah lalui jalanmu, dan barangkali kau {#Emph}juga {#Prev}akan jadi cukup kuat untuk menghajar papamu."
      Speaker = "Skelly"
      Event = "SkellyAboutZagreus02"
    }
    {
      Id = "Melinoe_4172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Komandan! Ayahku sedang dirantai di Tartarus!"
      Speaker = "Melinoe"
      Event = "SkellyAboutZagreus02"
    }
    {
      Id = "Skelly_0488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu harusnya lebih gampang, dong!"
      Speaker = "Skelly"
      Event = "SkellyAboutZagreus02"
    }
    {
      Id = "Melinoe_4946"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Komandan, kita tak punya alasan untuk bertarung!"
      Speaker = "Melinoe"
      Event = "SkellyAboutZagreus02"
    }
    {
      Id = "Skelly_0582"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin {#Emph}belum!"
      Speaker = "Skelly"
      Event = "SkellyAboutZagreus02"
    }
    {
      Id = "Skelly_0749"
      InheritFrom = "BaseNarrative"
      DisplayName = "Murid-muridku di sini bilang kau baru saja bentrok dengan tak lain dan tak bukan sang {#DialogLegendaryFormat}Pangeran Underworld {#Prev}sendiri, dan kau bertarung seganas iblis, yang kutanggapi dengan, {#Emph}ah yang bener aja."
      Speaker = "Skelly"
      Event = "SkellyAboutZagreusFight01"
    }
    {
      Id = "Melinoe_5673"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu benar, Tuan! Aku mendapati diriku berada di semacam arena pertandingan yang tampak seperti Elysium. Di sana Zagreus dan aku bertarung habis-habisan demi memikat hati para penonton!"
      Speaker = "Melinoe"
      Event = "SkellyAboutZagreusFight01"
    }
    {
      Id = "Skelly_0750"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, rasanya itu sia-sia banget menurutku, Nak, mengingat aku yang melatih kalian berdua! Kalian itu {#Emph}seimbang! {#Prev}Nggak ada gunanya juga dibanding-bandingkan!"
      Speaker = "Skelly"
      Event = "SkellyAboutZagreusFight01"
    }
    {
      Id = "Melinoe_5674"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Komandan, kami sama sekali tak serupa."
      Speaker = "Melinoe"
      Event = "SkellyAboutZagreusFight01"
    }
    {
      Id = "Skelly_0751"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Persis seperti itulah yang bakal dia katakan."
      Speaker = "Skelly"
      Event = "SkellyAboutZagreusFight01"
    }
    {
      Id = "Melinoe_4156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru saja melihat ayahku, Komandan... terbelenggu rantai di Tartarus terdalam, menjadi tawanan Sang Waktu. Namun setelah semua yang ia lalui... dia bahkan tak mengingat namamu!"
      Speaker = "Melinoe"
      Event = "SkellyAboutHades01"
    }
    {
      Id = "Skelly_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa, {#Emph}uh{#Prev}, betapa buruknya hal itu, Nak! Papamu dan aku itu dulu akrab banget, nggak ada duanya. Barangkali dia cuma lupa karena semua beban berat yang lagi dialaminya."
      Speaker = "Skelly"
      Event = "SkellyAboutHades01"
    }
    {
      Id = "Melinoe_4157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sulit percaya dia bisa melupakan salah satu penasihat paling tepercaya begitu saja. Pasti ada cara untuk membantunya mengingat."
      Speaker = "Melinoe"
      Event = "SkellyAboutHades01"
    }
    {
      Id = "Skelly_0469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Jangan! {#Prev}Kau harus biarkan ingatannya pulih dengan sendirinya."
      Speaker = "Skelly"
      Event = "SkellyAboutHades01"
    }
    {
      Id = "Melinoe_4158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mungkin benar..."
      Speaker = "Melinoe"
      Event = "SkellyAboutHades01"
    }
    {
      Id = "Melinoe_4169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau pernah merindukannya, Komandan? Masa-masa baktimu untuk Wangsa Hades. Melatih saudaraku. Menempati posisi kehormatan tinggi di sana."
      Speaker = "Melinoe"
      Event = "SkellyAboutHouse01"
    }
    {
      Id = "Skelly_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, masa-masa itu sungguh luar biasa, sudah pasti. Tapi, aku takkan layak menduduki jabatanku kalau kerjanya merengek soal masa lalu seperti {#DialogLegendaryFormat}bayi kecil{#Prev}. Aku ini orang yang fokus ke masa kini!"
      Speaker = "Skelly"
      Event = "SkellyAboutHouse01"
    }
    {
      Id = "Melinoe_4170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi semua yang pernah kau miliki kini telah tiada. Para abdi Wangsa lainnya... setidaknya kau pasti punya rasa cemas terhadap {#Emph}mereka{#Prev}, kan?"
      Speaker = "Melinoe"
      Event = "SkellyAboutHouse01"
    }
    {
      Id = "Skelly_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayolah, mereka itu {#Emph}dewa! {#Prev}Palingan mereka juga baik-baik aja!"
      Speaker = "Skelly"
      Event = "SkellyAboutHouse01"
    }
    {
      Id = "Melinoe_4173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, aku selalu penasaran dengan semua tanda jasa yang kau kenakan itu... mana yang pertama kali kau dapatkan? Mana yang paling bermakna?"
      Speaker = "Melinoe"
      Event = "SkellyAboutPast01"
    }
    {
      Id = "Skelly_0489"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, maksudmu medali-medali kecil ini? Yang satu ini sudah kupunya sejak, {#Emph}um{#Prev}, {#DialogLegendaryFormat}Pengepungan Ilium{#Prev}! Sudah banyak orang yang kutusuk tombak demi medali yang {#Emph}itu{#Prev}! Kalau yang lainnya didapat dari berbagai pertempuran di seantero negeri."
      Speaker = "Skelly"
      Event = "SkellyAboutPast01"
    }
    {
      Id = "Melinoe_4174"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kampanye militer macam apa?"
      Speaker = "Melinoe"
      Event = "SkellyAboutPast01"
    }
    {
      Id = "Skelly_0490"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menjelajah seantero negeri, kubilang juga apa!"
      Speaker = "Skelly"
      Event = "SkellyAboutPast01"
    }
    {
      Id = "Skelly_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa kau menatapku dengan wajah cemas begitu, Anak Muda? Barangkali sedang mencari wejangan bijak dariku?"
      Speaker = "Skelly"
      Event = "SkellyAboutPast02"
    }
    {
      Id = "Melinoe_4178"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Hanya saja, bahkan sampai sekarang pun, aku tahu sangat sedikit soal masa lalumu. Harus kuakui, Komandan... terkadang aku merasa kau menyembunyikan sesuatu dariku."
      Speaker = "Melinoe"
      Event = "SkellyAboutPast02"
    }
    {
      Id = "Skelly_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa?! Mana ada. Dengar, tugasku di sini untuk mematangkan kecakapan tempurmu, bukan mengoceh soal masa lalu! Tapi ya sudahlah. Apa yang sebenarnya ingin kauketahui?"
      Speaker = "Skelly"
      Event = "SkellyAboutPast02"
    }
    {
      Id = "Melinoe_4179"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku ingin tahu siapa dirimu yang sesungguhnya."
      Speaker = "Melinoe"
      Event = "SkellyAboutPast02"
    }
    {
      Id = "Skelly_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Wah, kalau itu sih ogah kuberi tahu."
      Speaker = "Skelly"
      Event = "SkellyAboutPast02"
    }
    {
      Id = "Melinoe_4180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Baiklah kalau begitu."
      Speaker = "Melinoe"
      Event = "SkellyAboutPast02"
    }
    {
      Id = "Skelly_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, dengar ya, aku tahu kemarin kita sempat sedikit bersitegang, dan aku tak mau hubungan kita jadi canggung di sini, jadi biar kubicarakan secara gamblang."
      Speaker = "Skelly"
      Event = "SkellyAboutPast03"
    }
    {
      Id = "Melinoe_4181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Komandan. Perhatianku sepenuhnya tertuju padamu."
      Speaker = "Melinoe"
      Event = "SkellyAboutPast03"
    }
    {
      Id = "Skelly_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masalahnya begini, Bocah, dan ini bisa membuatku kena masalah besar: Bukannya aku cuma tidak mau, tapi aku bahkan {#Emph}tidak boleh {#Prev}memberitahumu apa yang ingin kaukolek."
      Speaker = "Skelly"
      Event = "SkellyAboutPast03"
    }
    {
      Id = "Melinoe_4182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kurasa kau juga tak bisa memberitahuku alasannya. Apa ada orang yang memaksamu untuk merahasiakannya dariku?"
      Speaker = "Melinoe"
      Event = "SkellyAboutPast03"
    }
    {
      Id = "Skelly_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, percaya saja padaku kali ini, ya? Kau punya peran yang harus dijalankan, begitu pula aku."
      Speaker = "Skelly"
      Event = "SkellyAboutPast03"
    }
    {
      Id = "Melinoe_4183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Urusan ini belum selesai."
      Speaker = "Melinoe"
      Event = "SkellyAboutPast03"
    }
    {
      Id = "Melinoe_4997"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, jika aku harus memercayaimu seperti biasanya, aku perlu kepastian bahwa kau tak menyembunyikan apa pun dariku. Jika kau takut akan ada ganjaran, aku bersumpah akan menjamin dan melindungimu."
      Speaker = "Melinoe"
      Event = "SkellyAboutPast04"
    }
    {
      Id = "Skelly_0638"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketakutanku, Anak Muda, jika aku membeberkan apa yang kauinginkan, kau takkan pernah lagi memandangku dengan cara yang sama! Dan itu mungkin berakibat buruk bagi kita berdua."
      Speaker = "Skelly"
      Event = "SkellyAboutPast04"
    }
    {
      Id = "Melinoe_4998"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih memilih memandangmu dengan tahu bahwa kau jujur padaku. Dan dari pihakku, aku takkan mengkhianati rahasiamu."
      Speaker = "Melinoe"
      Event = "SkellyAboutPast04"
    }
    {
      Id = "Skelly_0639"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Hhh, baiklah... Aku ini sebenarnya bukan sekadar Komandan seperti yang kaukira, {#Emph}bukan main! {#Prev}Dulu aku jauh {#Emph}lebih hebat {#Prev}dari itu... {#Emph}Raja Schelememnon{#Prev}, begitulah dulu aku dipanggil! Tapi aku bahkan jauh lebih dari {#Emph}itu juga! {#Prev}Karena ayahmu sendiri yang memilihku langsung menjadi salah satu dari {#DialogLegendaryFormat}Tiga Hakim Kematian{#Prev}!"
      Speaker = "Skelly"
      Event = "SkellyAboutPast04"
    }
    {
      Id = "Melinoe_4999"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, itu... itu luar biasa! Jadi... setelah Underworld runtuh, kau bersembunyi di sini?"
      Speaker = "Melinoe"
      Event = "SkellyAboutPast04"
    }
    {
      Id = "Skelly_0640"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku, {#Emph}eh, heheh. {#Prev}Ya, tepat sekali. Dan musuh-musuh kita, mereka terus memburuku sejak saat itu! Tak boleh ada yang tahu keberadaanku! Ayahmu, saudaramu... {#Emph}siapa pun tak boleh tahu."
      Speaker = "Skelly"
      Event = "SkellyAboutPast04"
    }
    {
      Id = "Melinoe_5000"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa ayah atau saudaraku tak boleh tahu? Tentu mereka ingin mendengar kalau kau selamat!"
      Speaker = "Melinoe"
      Event = "SkellyAboutPast04"
    }
    {
      Id = "Skelly_0641"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jangan! {#Prev}Serahkan urusan komunikasi rahasia ini kepadaku."
      Speaker = "Skelly"
      Event = "SkellyAboutPast04"
    }
    {
      Id = "Melinoe_5001"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kukira selama ini ayahku mengadili semuanya seorang diri."
      Speaker = "Melinoe"
      Event = "SkellyAboutPast04"
    }
    {
      Id = "Skelly_0642"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, dia memang mengurus sebagian besarnya."
      Speaker = "Skelly"
      Event = "SkellyAboutPast04"
    }
    {
      Id = "Melinoe_2924"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lihat, Komandan? Tuan Charon datang mengunjungi kita! Akhirnya jalur pasokan kita aman, dan serangan balasan kita bisa dimulai."
      Speaker = "Melinoe"
      Event = "SkellyAboutCharon01"
    }
    {
      Id = "Skelly_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eh, {#Emph}ya! {#Prev}Sudah lama sekali sejak Tuan Charon yang baik terakhir menyambangi kita. Sebaiknya kita semua menjaga sikap di dekatnya! Tapi, {#Emph}ngomong-ngomong... {#Prev}dari mana kau dapat omongan soal jalur pasokan itu?"
      Speaker = "Skelly"
      Event = "SkellyAboutCharon01"
    }
    {
      Id = "Melinoe_2925"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lho, beliau sendiri yang mengatakannya padaku, Tuan! Lewat caranya sendiri."
      Speaker = "Melinoe"
      Event = "SkellyAboutCharon01"
    }
    {
      Id = "Skelly_0245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh..."
      Speaker = "Skelly"
      Event = "SkellyAboutCharon01"
    }
    {
      Id = "Skelly_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, Anak Muda? Boleh kutanyakan sesuatu terkait Tuan Charon yang baik, kalau kau tak keberatan. Kelihatannya kau sangat paham maksudnya! Apa dia, {#Emph}eh{#Prev}, sempat membicarakan sesuatu baru-baru ini tentang {#Emph}aku...?"
      Speaker = "Skelly"
      Event = "SkellyAboutCharon02"
    }
    {
      Id = "Melinoe_2926"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, aku... maaf, tapi tidak. Namun kupastikan aku akan memujimu di depannya! Jasamu sangat berharga, dan Tuan Charon harus tahu itu."
      Speaker = "Melinoe"
      Event = "SkellyAboutCharon02"
    }
    {
      Id = "Skelly_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jangan! {#Prev}Maksudku, {#Emph}um, jangan{#Prev}, pokoknya... jangan lakukan hal semacam itu! Kau tak perlu membebani sang Pengemudi Perahu dengan hal-hal sepele, apalagi di masa-masa genting begini...! Jangan ganggu dia, oke?"
      Speaker = "Skelly"
      Event = "SkellyAboutCharon02"
    }
    {
      Id = "Melinoe_2927"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Erm{#Prev}, baiklah kalau begitu!"
      Speaker = "Melinoe"
      Event = "SkellyAboutCharon02"
    }
    {
      Id = "Melinoe_4991"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, kebetulan kau sempat melihat Nemesis melangkah menuju gerbang keluar belakangan ini?"
      Speaker = "Melinoe"
      Event = "SkellyAboutNemesis01"
    }
    {
      Id = "Skelly_0631"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kagak! Kepalaku lurus menatap ke arah yang berlawanan. Tak melihat siapa pun di sini selain dirimu."
      Speaker = "Skelly"
      Event = "SkellyAboutNemesis01"
    }
    {
      Id = "Melinoe_4992"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu setidaknya kau pasti mendengar derap langkahnya yang berat. Dia kan tidak terkenal dengan kehati-hatiannya."
      Speaker = "Melinoe"
      Event = "SkellyAboutNemesis01"
    }
    {
      Id = "Skelly_0632"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak bisa bilang dia begitu, tapi aku sendiri juga belum pernah."
      Speaker = "Skelly"
      Event = "SkellyAboutNemesis01"
    }
    {
      Id = "Melinoe_2996"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan. Kau pernah menempati posisi terhormat di Kediaman ayahku, jadi kau pasti kenal Cerberus, kan? Rasanya aku melihatnya di Mourning Fields, sekujur tubuhnya berlumuran Miasma dari kepala sampai cakar. Apakah dari dulu dia memang gampang mengamuk tak terkendali begitu?"
      Speaker = "Melinoe"
      Event = "SkellyAboutCerberus01"
    }
    {
      Id = "Skelly_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tidak, dia kebanyakan cuma duduk santai. Kami berteman sejak lama, cuma ya... aku sengaja menjaga jarak secara taktis, berhubung dia itu mirip {#Emph}anjing{#Prev}, dan aku agak mirip {#Emph}tulang. {#Prev}Jadi sekarang dia bikin masalah buatmu, ya?"
      Speaker = "Skelly"
      Event = "SkellyAboutCerberus01"
    }
    {
      Id = "Melinoe_2795"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan salahnya. Chronos pasti mengusirnya dari Kediaman dan membuangnya ke sana. Tapi kalau aku bisa menembus semua kotoran pekat itu, aku yakin bisa menenangkannya."
      Speaker = "Melinoe"
      Event = "SkellyAboutCerberus01"
    }
    {
      Id = "Skelly_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Asal kau tahu saja, dia dari dulu nggak pernah suka mandi..."
      Speaker = "Skelly"
      Event = "SkellyAboutCerberus01"
    }
    {
      Id = "Melinoe_2995"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, kau pernah menempati posisi terhormat di Kediaman ayahku. Jadi, kau pasti kenal Cerberus, kan? Aku melihatnya di Mourning Fields, sekujur tubuhnya berlumuran Miasma dari kepala sampai cakar. Apakah dari dulu dia memang gampang mengamuk tak terkendali begitu?"
      Speaker = "Melinoe"
      Event = "SkellyAboutCerberus01B"
    }
    {
      Id = "Melinoe_2997"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan salahnya. Chronos pasti mengusirnya dari Kediaman dan membuangnya begitu saja. Aku berhasil menembus kotoran pekat itu dan menenangkannya. Tapi mungkin dia bakal butuh disucikan lagi sebentar lagi."
      Speaker = "Melinoe"
      Event = "SkellyAboutCerberus01B"
    }
    {
      Id = "Skelly_0626"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi bagaimana kelanjutan anjing raksasa itu? Masih berulah di Mourning Fields? Paling-paling dia cuma {#Emph}bosan."
      Speaker = "Skelly"
      Event = "SkellyAboutCerberus02"
    }
    {
      Id = "Melinoe_4987"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil membebaskannya dari apa pun yang merasukinya di sana, meskipun kutukan itu sepertinya terus kembali."
      Speaker = "Melinoe"
      Event = "SkellyAboutCerberus02"
    }
    {
      Id = "Skelly_0627"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga. Dia itu dulunya {#DialogLegendaryFormat}Penjaga Gerbang{#Prev} yang ditakuti! Apa, kau pikir dia bakal membiarkanmu lewat sekali saja, lalu nggak bakal mencoba menghadangmu lagi?"
      Speaker = "Skelly"
      Event = "SkellyAboutCerberus02"
    }
    {
      Id = "Melinoe_4988"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sempat berharap begitu, ya."
      Speaker = "Melinoe"
      Event = "SkellyAboutCerberus02"
    }
    {
      Id = "Skelly_0628"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, sayang sekali."
      Speaker = "Skelly"
      Event = "SkellyAboutCerberus02"
    }
    {
      Id = "Skelly_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, omong-omong, tadinya aku mau bilang {#Emph}kerja bagus{#Prev}, atas keberhasilanmu mencapai sasaran dan sebagainya! Kau benar-benar berhasil, kan...? Sudah memberi {#DialogLegendaryFormat}Chronos {#Prev}pelajaran berharga?"
      Speaker = "Skelly"
      Event = "SkellyAboutChronosBossW01"
    }
    {
      Id = "Melinoe_2920"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil mengalahkannya, ya, Komandan. Tapi, sasaran utamaku masih jauh dari kata selesai."
      Speaker = "Melinoe"
      Event = "SkellyAboutChronosBossW01"
    }
    {
      Id = "Skelly_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah, ya sudahlah{#Prev}, begitulah yang namanya sasaran! Begitu satu selesai, muncul lagi yang lain... tapi kau bakal {#Emph}terus {#Prev}menghabisi mereka semua!"
      Speaker = "Skelly"
      Event = "SkellyAboutChronosBossW01"
    }
    {
      Id = "Melinoe_2921"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mohon pamit dulu."
      Speaker = "Melinoe"
      Event = "SkellyAboutChronosBossW01"
    }
    {
      Id = "Skelly_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar sudah sampai ke telingaku kalau semalam, kau berhasil mencapai apa yang ingin kau lakukan, anak muda! Selamat besar-besaran untuk itu, semua muridku dan aku sendiri salut atas kerja kerasmu yang luar biasa."
      Speaker = "Skelly"
      Event = "SkellyAboutChronosBossW02"
    }
    {
      Id = "Melinoe_3371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Komandan! Walau begitu, ini adalah langkah menuju kemenangan yang takkan pernah bisa kucapai tanpa latihan dan bimbingan dari Guru, Odysseus, serta dirimu sendiri."
      Speaker = "Melinoe"
      Event = "SkellyAboutChronosBossW02"
    }
    {
      Id = "Skelly_0370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan dia bahkan tahu cara menghargai jasa orang lain!"
      Speaker = "Skelly"
      Event = "SkellyAboutChronosBossW02"
    }
    {
      Id = "Skelly_0543"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau sudah menghajar Chronos telak-telak beberapa kali sekarang! Coba ingatkan Bayang-bayang ini dan aku apa yang bakal terjadi selanjutnya: Bagaimana caramu membunuh sesuatu yang terus bangkit kembali?"
      Speaker = "Skelly"
      Event = "SkellyAboutChronosBossW03"
    }
    {
      Id = "Melinoe_4353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, meskipun sangat menggoda untuk membagikan semua kemajuan terbaruku, kita berdua tahu aku tak boleh membocorkan rincian tugasku. Bahkan kepadamu sekalipun."
      Speaker = "Melinoe"
      Event = "SkellyAboutChronosBossW03"
    }
    {
      Id = "Skelly_0544"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bahkan kepadaku sekalipun. {#Prev}Tapi paling tidak bisakah kau bilang, saudaramu itu, apa dia bakal baik-baik saja? Cuma kepikiran nasib anak itu saja, kok..."
      Speaker = "Skelly"
      Event = "SkellyAboutChronosBossW03"
    }
    {
      Id = "Melinoe_4354"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Usaha yang bagus, Tuan."
      Speaker = "Melinoe"
      Event = "SkellyAboutChronosBossW03"
    }
    {
      Id = "Skelly_0629"
      InheritFrom = "BaseNarrative"
      DisplayName = "Laporan murid-muridku bilang kau sudah sampai di tujuan tapi agak gelagapan di saat-saat terakhir. Wah, berat juga ya. Sudah berhasil melangkah {#Emph}sejauh {#Prev}itu cuma untuk terlempar {#Emph}kembali {#Prev}ke sini lagi..."
      Speaker = "Skelly"
      Event = "SkellyAboutChronosBossL01"
    }
    {
      Id = "Melinoe_4989"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, ini bukan jenis kata penyemangat yang berguna untuk saat ini. Aku sudah berhasil menyudutkan Chronos, tapi dia membalikkan keadaan. Dan sekarang aku sudah kehilangan unsur kejutan!"
      Speaker = "Melinoe"
      Event = "SkellyAboutChronosBossL01"
    }
    {
      Id = "Skelly_0630"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ooh, {#Emph}iya sih{#Prev}, gawat juga itu. Dengar, aku sebenarnya benci mengatakan ini, tapi kalau aku jadi dirimu mungkin aku bakal {#DialogLegendaryFormat}gantung senjata{#Prev}. Menyia-nyiakan kesempatan emas begitu?"
      Speaker = "Skelly"
      Event = "SkellyAboutChronosBossL01"
    }
    {
      Id = "Melinoe_4990"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Komandan...!"
      Speaker = "Melinoe"
      Event = "SkellyAboutChronosBossL01"
    }
    {
      Id = "Melinoe_3807"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, bagaimana pandangan umum di sini mengenai Prometheus? Jika beberapa manusia fana memujanya, mungkin kau dan murid-muridmu merasa bimbang karena sekarang dia menentang kita."
      Speaker = "Melinoe"
      Event = "SkellyAboutPrometheus01"
    }
    {
      Id = "Skelly_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan yang membawa api, akal pikiran, santapan lezat, kesenian dan segala macamnya untuk umat manusia fana... lalu harus menanggung murka para dewa demi semua itu. Nggak sudi sama orang itu! Hajar saja sekalian!"
      Speaker = "Skelly"
      Event = "SkellyAboutPrometheus01"
    }
    {
      Id = "Melinoe_3808"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, kau tak menyukainya padahal dia sudah berbuat begitu banyak untuk kalian? Yah, bangsa fana memang terkadang sulit dipuaskan..."
      Speaker = "Melinoe"
      Event = "SkellyAboutPrometheus01"
    }
    {
      Id = "Skelly_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba pikir, apa dia bersikap baik padamu, atau malah mencoba membunuhmu? Peduli amat kalau dulu dia pernah memanjakan kita! Memangnya belakangan ini dia ada berbuat sesuatu buat kita, nggak kan."
      Speaker = "Skelly"
      Event = "SkellyAboutPrometheus01"
    }
    {
      Id = "Melinoe_3809"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia {#Emph}memang {#Prev}mencoba membunuhku..."
      Speaker = "Melinoe"
      Event = "SkellyAboutPrometheus01"
    }
    {
      Id = "Skelly_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa tolong beri tahu semua Bayang-bayang ini kalau {#Emph}tidak{#Prev}, si {#DialogLegendaryFormat}Bapak Segala Monster {#Prev}{#Emph}belum {#Prev}bangkit lagi? Soalnya mereka terlalu termakan desas-desus konyol ini, sampai-sampai nggak percaya waktu {#Emph}aku {#Prev}yang bilang!"
      Speaker = "Skelly"
      Event = "SkellyAboutTyphon01"
    }
    {
      Id = "Melinoe_4059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, masalahnya begini... Aku baru saja berhadapan langsung dengan Typhon tadi malam. Saat Chronos menyusun siasat dari Dunia Bawah, monster raksasa itu sedang menyerang Olympus."
      Speaker = "Melinoe"
      Event = "SkellyAboutTyphon01"
    }
    {
      Id = "Skelly_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh! A-aku, {#Emph}eh{#Prev}, aku... {#Emph}tahu {#Prev}semua itu kok, cuma ya... aku tadi mengetes saja apa murid-muridku punya nyali untuk mempertahankan apa yang mereka yakini! Dan mereka berhasil. Kerja bagus, semuanya!"
      Speaker = "Skelly"
      Event = "SkellyAboutTyphon01"
    }
    {
      Id = "Melinoe_4060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi kau tahu soal kembalinya Typhon?"
      Speaker = "Melinoe"
      Event = "SkellyAboutTyphon01"
    }
    {
      Id = "Skelly_0456"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Iya! Tentu saja..."
      Speaker = "Skelly"
      Event = "SkellyAboutTyphon01"
    }
    {
      Id = "Skelly_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, {#Emph}uh{#Prev}, maukah kau bersaksi di hadapan murid-muridku bahwa aku telah mengajarkan banyak hal padamu soal bertarung melawan {#DialogLegendaryFormat}Typhon{#Prev}? Belakangan ini mereka agak susah diatur, dan, {#Emph}uh{#Prev}, anggap saja membantuku!"
      Speaker = "Skelly"
      Event = "SkellyAboutTyphon02"
    }
    {
      Id = "Melinoe_4061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi Komandan, kau sama sekali belum memberitahuku apa pun tentangnya... {#Emph}ah{#Prev}, aku paham. Kau hanya ingin menguji apakah aku sudi berbohong hanya karena diminta!"
      Speaker = "Melinoe"
      Event = "SkellyAboutTyphon02"
    }
    {
      Id = "Skelly_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Um, {#Emph}iya! {#Prev}Ya, benar sekali. Dan aku memintanya baik-baik nih, ay—ayolah, Bocah, maukah kau bantu aku sekali ini saja...?"
      Speaker = "Skelly"
      Event = "SkellyAboutTyphon02"
    }
    {
      Id = "Melinoe_4062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak akan mempermalukan kita berdua."
      Speaker = "Melinoe"
      Event = "SkellyAboutTyphon02"
    }
    {
      Id = "Skelly_0459"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...Sialan."
      Speaker = "Skelly"
      Event = "SkellyAboutTyphon02"
    }
    {
      Id = "Melinoe_4228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, bagaimana caraku menaklukkan musuh yang hawa kehidupannya sama sekali tak terdeteksi? Typhon si Pembawa Badai menyembunyikan kekuatannya dariku... tapi pasti ada batasnya."
      Speaker = "Melinoe"
      Event = "SkellyAboutTyphon03"
    }
    {
      Id = "Skelly_0541"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal kau tahu ya, Bocah, kebanyakan dari kami tak bisa merasakan hawa kehidupan orang lain sehebat dirimu. Kami cuma saling pukul sampai ada yang mati terkapar! Mungkin ada tandanya, seperti {#DialogLegendaryFormat}luka sayat {#Prev}dan {#DialogLegendaryFormat}memar {#Prev}atau semacamnya?"
      Speaker = "Skelly"
      Event = "SkellyAboutTyphon03"
    }
    {
      Id = "Melinoe_4229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia bukannya tak bisa dilukai. Para dewa pernah menundukkannya dulu hanya dengan kekuatan murni..."
      Speaker = "Melinoe"
      Event = "SkellyAboutTyphon03"
    }
    {
      Id = "Skelly_0542"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hajar saja dia habis-habisan! Selalu berhasil buat musuh-musuh {#Emph}lainnya!"
      Speaker = "Skelly"
      Event = "SkellyAboutTyphon03"
    }
    {
      Id = "Skelly_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba luruskan taruhan kecil ini, Bocah. Para Arwah ini mengeklaim bahwa {#Emph}kaulah {#Prev}yang menumbangkan sang {#DialogLegendaryFormat}Bapak Segala Monster{#Prev}! Tapi aku, sebagai sosok yang paling waras, cuma bisa bilang, {#Emph}ah yang benaaar saja."
      Speaker = "Skelly"
      Event = "SkellyAboutTyphonW01"
    }
    {
      Id = "Melinoe_4063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekalahan Typhon baru-baru ini jelas bukan hasil jerih payahku seorang, Komandan. Olympus ada di pihak kita, dan masih banyak lagi!"
      Speaker = "Melinoe"
      Event = "SkellyAboutTyphonW01"
    }
    {
      Id = "Skelly_0461"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh! Benar kan, {#Emph}um{#Prev}, ya, itu yang kubilang tadi: Secara teknis, bukan cuma {#Emph}dia {#Prev}seorang. Dengar itu, murid-murid?! Dia dibantu banyak {#DialogLegendaryFormat}Boon {#Prev}hebat dan entah apa lagi!"
      Speaker = "Skelly"
      Event = "SkellyAboutTyphonW01"
    }
    {
      Id = "Melinoe_4064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, kau memenangkan taruhannya?"
      Speaker = "Melinoe"
      Event = "SkellyAboutTyphonW01"
    }
    {
      Id = "Skelly_0462"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jelas dong!"
      Speaker = "Skelly"
      Event = "SkellyAboutTyphonW01"
    }
    {
      Id = "Skelly_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah berkali-kali menjatuhkan {#DialogLegendaryFormat}Typhon {#Prev}dari singgasananya! Mungkin benar kata pepatah, {#Emph}makin besar ukuran mereka... makin keras debum jatuhnya."
      Speaker = "Skelly"
      Event = "SkellyAboutTyphonW02"
    }
    {
      Id = "Melinoe_4165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah memikirkannya seperti itu sebelumnya, Komandan, tapi kau benar! Kiklops Polyphemus juga tumbang dengan amat keras."
      Speaker = "Melinoe"
      Event = "SkellyAboutTyphonW02"
    }
    {
      Id = "Skelly_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja karena ukurannya, paham kan!"
      Speaker = "Skelly"
      Event = "SkellyAboutTyphonW02"
    }
    {
      Id = "Melinoe_4065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana moral di antara seluruh muridmu akhir-akhir ini, Komandan? Prometheus dan Typhon menghadirkan ancaman besar yang bisa mengguncang tekad terkuat sekalipun."
      Speaker = "Melinoe"
      Event = "SkellyAboutCatastrophe01"
    }
    {
      Id = "Skelly_0463"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Alah, {#Prev}mereka {#Emph}baik-baik saja! {#Prev}Lihat saja mereka, seberani yang bisa kau bayangkan. Bencana apa pun yang bakal menimpa, bagi kami di sini ini cuma malam biasa!"
      Speaker = "Skelly"
      Event = "SkellyAboutCatastrophe01"
    }
    {
      Id = "Melinoe_4066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berusaha {#Emph}mencegah {#Prev}bencana, bukan menjadikannya hal lumrah. Tapi ya, tolong beri tahu aku jika ada perubahan. Kami butuh kalian semua dalam kondisi terbaik."
      Speaker = "Melinoe"
      Event = "SkellyAboutCatastrophe01"
    }
    {
      Id = "Skelly_0464"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengar itu, kalian para pemalas? Tunjukkan yang terbaik, atau {#Emph}tanggung akibatnya!"
      Speaker = "Skelly"
      Event = "SkellyAboutCatastrophe01"
    }
    {
      Id = "Skelly_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan beban berat tengah menindihmu, Bocah. Memang tak seberat yang dipikul Atlas tua itu, tapi tetap saja!"
      Speaker = "Skelly"
      Event = "SkellyAboutRouteChoice01"
    }
    {
      Id = "Melinoe_1580"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa saranmu untuk langkahku selanjutnya, Komandan: memburu musuh kita di Underworld, atau pergi menolong Olympus?"
      Speaker = "Melinoe"
      Event = "SkellyAboutRouteChoice01"
    }
    {
      Id = "Skelly_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukannya mau maruk ya, {#Emph}tapi{#Prev}... menurutku pergilah ke mana pun kau bisa mendapatkan barang yang paling kau butuhkan, sekarang {#Emph}juga! {#Prev}Kita punya persediaan di bawah sini yang tak ada di atas sana, dan seterusnya, kan?"
      Speaker = "Skelly"
      Event = "SkellyAboutRouteChoice01"
    }
    {
      Id = "Melinoe_1581"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kukira begitu..."
      Speaker = "Melinoe"
      Event = "SkellyAboutRouteChoice01"
    }
    {
      Id = "Skelly_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memang berani menerobos gerbang yang tadinya disegel itu, tapi ayolah, {#Emph}sobat! {#Prev}Kalian kaum Underworld tak cocok hidup di permukaan! Kecuali mungkin ada {#DialogLegendaryFormat}Mantra {#Prev}yang bisa membantu..."
      Speaker = "Skelly"
      Event = "SkellyAboutSurface01"
    }
    {
      Id = "Melinoe_3366"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa memang ada, Komandan, hanya saja... itu memerlukan bahan-bahan yang cuma bisa ditemukan di {#Emph}sana... {#Prev}tapi, bagaimana caraku mengumpulkannya sebelum mantranya selesai?"
      Speaker = "Melinoe"
      Event = "SkellyAboutSurface01"
    }
    {
      Id = "Skelly_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau bisa {#DialogLegendaryFormat}lari kencang sambil mengambilnya{#Prev}, entahlah. Memangnya kenapa kalau tak bisa berlama-lama, ambil saja apa yang kau butuhkan lalu segera cabut dari sana!"
      Speaker = "Skelly"
      Event = "SkellyAboutSurface01"
    }
    {
      Id = "Melinoe_3367"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan cara yang ideal, tapi..."
      Speaker = "Melinoe"
      Event = "SkellyAboutSurface01"
    }
    {
      Id = "Skelly_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bertahan di permukaan jauh lebih lama dari sebelumnya. Bagaimana rasanya, seru tidak?"
      Speaker = "Skelly"
      Event = "SkellyAboutSurface02"
    }
    {
      Id = "Melinoe_1578"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang berkecamuk di atas sana. Para penghuni Olympus mengirim Heracles sendiri untuk membendung kehancuran. Arwah orang-orang mati berkeliaran di mana-mana. Jadi... sama sekali {#Emph}tidak {#Prev}seru."
      Speaker = "Melinoe"
      Event = "SkellyAboutSurface02"
    }
    {
      Id = "Skelly_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah orang mati! Kedengarannya makin banyak murid yang bisa kita rekrut. {#Emph}Hei{#Prev}, tolong {#DialogLegendaryFormat}tabrak dan kumpulkan mereka{#Prev}, ya?"
      Speaker = "Skelly"
      Event = "SkellyAboutSurface02"
    }
    {
      Id = "Melinoe_1579"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baik, Tuan."
      Speaker = "Melinoe"
      Event = "SkellyAboutSurface02"
    }
    {
      Id = "Skelly_0495"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar perjalananmu baru-baru ini ke permukaan nggak bertahan lama ya, Bocah. Hidup di atas sana itu keras, dan bakal selalu begitu! Nggak kayak Underworld-mu yang serba nyaman."
      Speaker = "Skelly"
      Event = "SkellyAboutSurface03"
    }
    {
      Id = "Melinoe_4177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih belum terbiasa. Semuanya terasa berlipat ganda... setiap kali aku gagal menghindar dari musuh, rasa sakitnya jauh lebih menyiksa."
      Speaker = "Melinoe"
      Event = "SkellyAboutSurface03"
    }
    {
      Id = "Skelly_0496"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, jalanmu jelas nggak bakal gampang."
      Speaker = "Skelly"
      Event = "SkellyAboutSurface03"
    }
    {
      Id = "Skelly_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau merambah sampai ke dasar laut. Aku juga pernah ke kedalaman sana, Bocah! Tapi cuma sekali, waktu dulu banget, dan itu pun sebentar doang!"
      Speaker = "Skelly"
      Event = "SkellyAboutOceanus01"
    }
    {
      Id = "Melinoe_1044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja...! Kau kan pelaut tersohor di masa hidupmu yang fana! Tapi, kau akhirnya meregang nyawa di bawah perairan yang pernah kauselami itu?"
      Speaker = "Melinoe"
      Event = "SkellyAboutOceanus01"
    }
    {
      Id = "Skelly_0078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak dong! Akhir hidupku jauh lebih gemilang dari itu."
      Speaker = "Skelly"
      Event = "SkellyAboutOceanus01"
    }
    {
      Id = "Skelly_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana kabarmu baru-baru ini menghadapi para Lurker dan Ular Laut di kedalaman air sana? Tahu soal mereka dan bertarung langsung melawan mereka itu dua hal yang amat berbeda."
      Speaker = "Skelly"
      Event = "SkellyAboutOceanus02"
    }
    {
      Id = "Melinoe_2531"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka jauh lebih kuat daripada Jiwa Tersesat yang berkeliaran di sekitar sini. Dan mereka sama sekali tak kenal takut, langsung menyerang tanpa ragu sedikit pun."
      Speaker = "Melinoe"
      Event = "SkellyAboutOceanus02"
    }
    {
      Id = "Skelly_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Intinya mereka itu cuma ikan yang bisa jalan, Bocah. Nggak banyak bacot, tapi kalau menusukmu pakai trisula sih jago banget! Jangan sampai kena serang mereka."
      Speaker = "Skelly"
      Event = "SkellyAboutOceanus02"
    }
    {
      Id = "Melinoe_2532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak akan kubiarkan."
      Speaker = "Melinoe"
      Event = "SkellyAboutOceanus02"
    }
    {
      Id = "Skelly_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana perjalanan lautmu di permukaan baru-baru ini, Bocah? Aku masih ingat betul bentangan air tanpa batas di sana. Betapa biru dan tenangnya lautan itu!"
      Speaker = "Skelly"
      Event = "SkellyAboutThessaly01"
    }
    {
      Id = "Melinoe_1045"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tenang? {#Prev}Pengalamanku sama sekali tidak seperti itu."
      Speaker = "Melinoe"
      Event = "SkellyAboutThessaly01"
    }
    {
      Id = "Skelly_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lautnya tenang kok, sialan..."
      Speaker = "Skelly"
      Event = "SkellyAboutThessaly01"
    }
    {
      Id = "Skelly_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku dan murid-muridku memberi hormat padamu karena kau berhasil mendaki gunung raksasa itu, Bocah! Waktu kami masih bernapas dulu, kami cuma bisa memimpikan puncak-puncak suci itu..."
      Speaker = "Skelly"
      Event = "SkellyAboutOlympus01"
    }
    {
      Id = "Melinoe_3805"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menghargai dukungannya, Komandan, tapi daki masih panjang. Pasukan Chronos berkumpul dalam jumlah besar di sana... dan pertahanan gunung itu tak bisa membedakan kawan atau lawan."
      Speaker = "Melinoe"
      Event = "SkellyAboutOlympus01"
    }
    {
      Id = "Skelly_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti bercanda! Keajaiban mekanis buatan para dewa sendiri mengarahkan senjata mematikan mereka padamu, {#Emph}Melinoë? {#Prev}Padahal kau bela-belain ke sana buat menolong mereka?"
      Speaker = "Skelly"
      Event = "SkellyAboutOlympus01"
    }
    {
      Id = "Melinoe_3806"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Secara garis besar, ya."
      Speaker = "Melinoe"
      Event = "SkellyAboutOlympus01"
    }
    {
      Id = "Skelly_0398"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Yah{#Prev}, sayang sekali."
      Speaker = "Skelly"
      Event = "SkellyAboutOlympus01"
    }
    {
      Id = "Melinoe_1046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kotak penyimpanan tua ini... jadi, ini pusaka peninggalan keluargaku."
      Speaker = "Melinoe"
      Event = "SkellyAboutGiftRack01"
    }
    {
      Id = "Skelly_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali, setidaknya sejauh yang bisa kuingat. Tataplah kotak itu dan ketahuilah beban yang kaupikul tak perlu kauhadapi sendirian. Ditambah lagi, kotak itu bakal menyimpan semua {#DialogLegendaryFormat}Kenang-kenanganmu {#Prev}dalam satu tempat yang praktis!"
      Speaker = "Skelly"
      Event = "SkellyAboutGiftRack01"
    }
    {
      Id = "Melinoe_1047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, ini simbol tradisi saling memberi hadiah di Olympus. Sebuah tradisi yang kini jatuh ke pundak kita."
      Speaker = "Melinoe"
      Event = "SkellyAboutGiftRack01"
    }
    {
      Id = "Skelly_0084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yoik."
      Speaker = "Skelly"
      Event = "SkellyAboutGiftRack01"
    }
    {
      Id = "Skelly_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mulai mengisi penuh kotak penyimpanan {#DialogLegendaryFormat}Kenang-kenangan {#Prev}itu, Bocah. Kerja bagus, tapi aku harus mengingatkanmu jangan mengoleksi cuma demi sekadar pamer koleksi..."
      Speaker = "Skelly"
      Event = "SkellyAboutGiftRack02"
    }
    {
      Id = "Melinoe_1048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memberi adalah imbalan tanpa wujud itu sendiri. Nektar akan basi jika dipersembahkan dengan niat yang tak tulus."
      Speaker = "Melinoe"
      Event = "SkellyAboutGiftRack02"
    }
    {
      Id = "Skelly_0086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak bakal kubiarkan ada niat tak tulus di area latihanku."
      Speaker = "Skelly"
      Event = "SkellyAboutGiftRack02"
    }
    {
      Id = "Skelly_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang aneh dengan Senjata Malam milikmu... semacam {#Emph}aura {#Prev}tertentu yang menyelimuti salah satunya. {#DialogLegendaryFormat}Rasa Haus Kuburan{#Prev}..."
      Speaker = "Skelly"
      Event = "SkellyAboutUnusedWeaponBonus01"
    }
    {
      Id = "Melinoe_2490"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebuah mantra yang terbilang sederhana. Kuduga memang ada hubungan yang lebih dalam antara senjata Malam dan orang mati. Tak heran kau juga bisa melihatnya."
      Speaker = "Melinoe"
      Event = "SkellyAboutUnusedWeaponBonus01"
    }
    {
      Id = "Skelly_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah... bukan berarti aku butuh mata di belakang tengkorakku! Tapi aku bisa merasakannya sampai ke tulang-tulangku! Kalau mau dapat lebih banyak {#DialogLegendaryFormat}Tulang{#Prev}, {#DialogLegendaryFormat}pakai saja senjata yang punya Rasa Haus itu{#Prev}!"
      Speaker = "Skelly"
      Event = "SkellyAboutUnusedWeaponBonus01"
    }
    {
      Id = "Melinoe_2491"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kugunakan kapan pun memungkinkan."
      Speaker = "Melinoe"
      Event = "SkellyAboutUnusedWeaponBonus01"
    }
    {
      Id = "Skelly_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luar biasa aksimu dengan {#DialogLegendaryFormat}Sabak Kedamaian {#Prev}itu, Bocah! Barisan kami mulai dipenuhi Arwah-arwah yang mungkin bakal menemukan tujuan agung dalam kekekalan abadi mereka!"
      Speaker = "Skelly"
      Event = "SkellyAboutExorcismBook01"
    }
    {
      Id = "Melinoe_2495"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehidupan mereka, betapapun keadaannya saat ini, hanya akan membaik begitu ayahku kembali ke takhta yang menjadi haknya."
      Speaker = "Melinoe"
      Event = "SkellyAboutExorcismBook01"
    }
    {
      Id = "Skelly_0184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, itu sih nggak perlu diragukan lagi! Tapi pertama-tama, kita bertarung dulu!"
      Speaker = "Skelly"
      Event = "SkellyAboutExorcismBook01"
    }
    {
      Id = "Skelly_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Murid-muridku sempat dibuat jantungan pas {#DialogLegendaryFormat}Batu Hitam Pekat {#Prev}itu tiba-tiba menyala. Kau tahu benda apa itu, kan?"
      Speaker = "Skelly"
      Event = "SkellyAboutBountyBoard01"
    }
    {
      Id = "Melinoe_2818"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pecahan kegelapan murni dari kedalaman Chaos... dalam beragam sisinya yang tak terhitung, ada hasil akhir yang tak terhingga. Barangkali tak satu pun di antaranya yang telah ditakdirkan oleh para Fates."
      Speaker = "Melinoe"
      Event = "SkellyAboutBountyBoard01"
    }
    {
      Id = "Skelly_0090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ehh{#Prev}, yoik."
      Speaker = "Skelly"
      Event = "SkellyAboutBountyBoard01"
    }
    {
      Id = "Skelly_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami semua melihatmu lenyap ke dalam {#DialogLegendaryFormat}Batu Hitam Pekat{#Prev} itu. Cara jitu lain untuk langsung beraksi menyergap musuh, memanfaatkan unsur kejutan! {#Emph}Keren abis!"
      Speaker = "Skelly"
      Event = "SkellyAboutBounties01"
    }
    {
      Id = "Melinoe_2928"
      InheritFrom = "BaseNarrative"
      DisplayName = "Batu itu sudah ada di sini sejak dulu. Fungsinya jauh melampaui sekadar monumen persembahan untuk Sang Malam, dan asal-usulnya bahkan jauh lebih purba. Tapi tak pernah terpikir olehku untuk menjadikannya senjata dalam persenjataan kita..."
      Speaker = "Melinoe"
      Event = "SkellyAboutBounties01"
    }
    {
      Id = "Skelly_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, bukan berarti kau bisa menghantamkan batu itu ke kepalaku, tapi {#Emph}betul sekali!"
      Speaker = "Skelly"
      Event = "SkellyAboutBounties01"
    }
    {
      Id = "Skelly_0465"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bolak-balik lenyap ke dalam {#DialogLegendaryFormat}Batu Hitam Pekat{#Prev} itu terus, Sobat. Aku dan murid-muridku sampai berpikir, pasti ada hal seru di dalam sana!"
      Speaker = "Skelly"
      Event = "SkellyAboutBountyBoard02"
    }
    {
      Id = "Melinoe_4154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah Komandan, di seberang sana bukanlah perjamuan santai. Tiap kali aku memakai Batu itu, rasanya hampir seperti malam-malam biasa lainnya, hanya saja... sebaiknya aku tak mengatakannya."
      Speaker = "Melinoe"
      Event = "SkellyAboutBountyBoard02"
    }
    {
      Id = "Skelly_0466"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, ayolah kenapa tidak? Bukan berarti bakal ada yang membocorkannya, maksudku, masa kau belum memercayai kami?"
      Speaker = "Skelly"
      Event = "SkellyAboutBountyBoard02"
    }
    {
      Id = "Melinoe_4155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Batu itu yang akan mengungkap rahasianya sendiri, bukan aku."
      Speaker = "Melinoe"
      Event = "SkellyAboutBountyBoard02"
    }
    {
      Id = "Skelly_0467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang benar saja?"
      Speaker = "Skelly"
      Event = "SkellyAboutBountyBoard02"
    }
    {
      Id = "Skelly_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Matamu tidak salah lihat! Di dekat gerbang keluar sana kau bakal menemukan benda bernama {#DialogLegendaryFormat}Sumpah Gaib{#Prev}, kalau tidak salah sebutannya begitu. Jangan tanya dari mana asalnya... tanyakan saja seberapa {#Emph}tangguh {#Prev}dirimu sebenarnya!"
      Speaker = "Skelly"
      Event = "SkellyAboutShrine01"
    }
    {
      Id = "Melinoe_2813"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhak menatap Sumpah itu... Wasiat Sang Malam. Namun apakah aku berani mengucapkan ikrarnya? Dan dengan begitu menebarkan Rasa Takut yang dibawa kegelapan...?"
      Speaker = "Melinoe"
      Event = "SkellyAboutShrine01"
    }
    {
      Id = "Skelly_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, kau ini kenapa, {#Emph}takut? {#Prev}Senjata Nokturnal kepunyaanmu itu pasti bakal suka hal-hal bertema {#DialogLegendaryFormat}Rasa Takut {#Prev}dan {#DialogLegendaryFormat}Wasiat {#Prev}seperti itu. Menurutku coba saja! Memang apa hal terburuk yang bisa terjadi?"
      Speaker = "Skelly"
      Event = "SkellyAboutShrine01"
    }
    {
      Id = "Melinoe_2814"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seluruh umat fana dikutuk dalam siksaan dan keputusasaan abadi...?"
      Speaker = "Melinoe"
      Event = "SkellyAboutShrine01"
    }
    {
      Id = "Skelly_0233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti bakal {#Emph}baik-baik saja!"
      Speaker = "Skelly"
      Event = "SkellyAboutShrine01"
    }
    {
      Id = "Skelly_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana urusan siksaan abadinya, sekarang setelah kau punya urusan {#DialogLegendaryFormat}Sumpah {#Prev}di sana itu? {#DialogLegendaryFormat}Senjata Nokturnal {#Prev}milikmu pasti lagi {#Emph}senang-senangnya!"
      Speaker = "Skelly"
      Event = "SkellyAboutShrine02"
    }
    {
      Id = "Melinoe_2815"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senjata Sang Malam... kurasa mereka bereaksi terhadap Sumpah itu. Menjadi kian kuat seiring Wasiatnya dituntaskan. Menenggak Mimpi Buruk yang terlahir dari ketakutan manusia fana akan kegelapan."
      Speaker = "Melinoe"
      Event = "SkellyAboutShrine02"
    }
    {
      Id = "Skelly_0235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, {#Emph}itu {#Prev}dia yang ingin kudengar!"
      Speaker = "Skelly"
      Event = "SkellyAboutShrine02"
    }
    {
      Id = "Melinoe_2816"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan dengan segala kebijaksanaanmu, Komandan... bagaimana bisa kau tahu banyak tentang Sumpah Gaib? Sejauh pengetahuanku, keberadaannya mendahului kekuasaan ayahku di Underworld."
      Speaker = "Melinoe"
      Event = "SkellyAboutShrine03"
    }
    {
      Id = "Skelly_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh ya, papamu mengambil pendekatan yang beda. Dia dulu serba Perjanjian Hukuman! Dia bahkan pernah memberikannya ke saudaramu waktu hubungan mereka lagi renggang-renggangnya. Tapi bocah itu malah nekat menjalaninya, dan suasananya jadi {#Emph}benar-benar {#Prev}memanas!"
      Speaker = "Skelly"
      Event = "SkellyAboutShrine03"
    }
    {
      Id = "Melinoe_2817"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau belum menjawab pertanyaanku."
      Speaker = "Melinoe"
      Event = "SkellyAboutShrine03"
    }
    {
      Id = "Skelly_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan aku tidak akan menjawabnya! Karena aku sendiri sudah mengucap Ikrar tertentu."
      Speaker = "Skelly"
      Event = "SkellyAboutShrine03"
    }
    {
      Id = "Skelly_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami sempat mengkhawatirkan hal terburuk di malam yang mencekam seperti itu. Tidak gampang beraksi di luar sana kalau {#DialogLegendaryFormat}Sumpah Gaib {#Prev}lagi beraksi!"
      Speaker = "Skelly"
      Event = "SkellyAboutShrine04"
    }
    {
      Id = "Melinoe_4175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ikrar-ikrar itu memang mempersulit tugasku; namun mereka membuatku bertambah kuat, sedikit demi sedikit. Apa kau menyarankan agar aku mengendurkannya?"
      Speaker = "Melinoe"
      Event = "SkellyAboutShrine04"
    }
    {
      Id = "Skelly_0492"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudku, kalau memang terasa terlalu berat kau sebaiknya menurunkannya lagi, tak ada yang bakal menghakimi di sini! Lebih baik kau {#Emph}mengendurkan {#Prev}daripada {#Emph}menyerah."
      Speaker = "Skelly"
      Event = "SkellyAboutShrine04"
    }
    {
      Id = "Melinoe_4176"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dua-duanya bukan pilihan terbaik."
      Speaker = "Melinoe"
      Event = "SkellyAboutShrine04"
    }
    {
      Id = "Skelly_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti merasa sudah cukup hebat sekarang, kan, bolak-balik menghajar Chronos atau siapa pun itu lagi dan lagi! Tapi apa kau sudah mengerahkan kemampuan terbaikmu sepenuhnya? Atau cuma mau yang {#DialogLegendaryFormat}gampang-gampang saja{#Prev}?"
      Speaker = "Skelly"
      Event = "SkellyAboutNotUsingShrine01"
    }
    {
      Id = "Melinoe_4163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hampir tak ada yang menganggap tugas menaklukkan Titan Waktu itu gampang, Komandan. Tapi aku paham maksudmu. Sumpah Gaib memanggil..."
      Speaker = "Melinoe"
      Event = "SkellyAboutNotUsingShrine01"
    }
    {
      Id = "Skelly_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo dong, {#Emph}pakai saja{#Prev}, aku dan murid-muridku praktis menantangmu! {#Emph}Kau {#Prev}bisa memperkuat {#DialogLegendaryFormat}Senjata Nokturnal-mu{#Prev}, dan {#Emph}kami {#Prev}bisa melihat kehebatannya! {#Emph}Sama-sama untung!"
      Speaker = "Skelly"
      Event = "SkellyAboutNotUsingShrine01"
    }
    {
      Id = "Melinoe_4164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kecuali jika aku gagal."
      Speaker = "Melinoe"
      Event = "SkellyAboutNotUsingShrine01"
    }
    {
      Id = "Skelly_0477"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kau gagal? {#Prev}Ayolah."
      Speaker = "Skelly"
      Event = "SkellyAboutNotUsingShrine01"
    }
    {
      Id = "Skelly_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dupa dan asap dari {#DialogLegendaryFormat}Altar Abu{#Prev} di sebelah sana telah membakar semangat para Arwah di sekitar sini! Termasuk aku juga."
      Speaker = "Skelly"
      Event = "SkellyAboutAltar01"
    }
    {
      Id = "Melinoe_2588"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang mendengarnya, Komandan. Kunjungan singkat ke Altar di tiap malam pun membantuku merasa lebih siap."
      Speaker = "Melinoe"
      Event = "SkellyAboutAltar01"
    }
    {
      Id = "Skelly_0192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Teruskan apa yang kau lakukan di sana!"
      Speaker = "Skelly"
      Event = "SkellyAboutAltar01"
    }
    {
      Id = "Skelly_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjuanganmu takkan pernah sia-sia, Sobat! Kau bukan manusia fana biasa; di tiap malam yang berlalu, pengetahuan dan kekuatanmu makin bertambah! Apalagi kalau kau menyalakan {#DialogLegendaryFormat}Mode Dewa{#Prev}, takkan ada yang bisa menghentikanmu!"
      Speaker = "Skelly"
      Event = "SkellyAboutGodMode01"
    }
    {
      Id = "Melinoe_2922"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap status kedewaan saja sudah cukup, Komandan. Namun, hal terakhir yang kau sebutkan... {#Emph}umm{#Prev}, apa sebenarnya maksud perkataanmu?"
      Speaker = "Melinoe"
      Event = "SkellyAboutGodMode01"
    }
    {
      Id = "Skelly_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#DialogLegendaryFormat}Mode Dewa{#Prev}? Ya, itu semacam {#Emph}mode{#Prev}, begitulah. Yang bisa kau {#Emph}nyalakan! {#Prev}Atau kau matikan, sesuka hatimu! Intinya cuma pilihan opsional saja, jadi pakai sesukamu!"
      Speaker = "Skelly"
      Event = "SkellyAboutGodMode01"
    }
    {
      Id = "Melinoe_2923"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya sekadar pilihan..."
      Speaker = "Melinoe"
      Event = "SkellyAboutGodMode01"
    }
    {
      Id = "Skelly_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah punya {#DialogLegendaryFormat}Satwa Akrab{#Prev} sekarang! Ya, murid-muridmu adalah murid-muridku juga, anak muda. Mereka akan dilatih dan dirawat di sini selama kau pergi, dan mereka juga boleh menghajarku kalau mau!"
      Speaker = "Skelly"
      Event = "SkellyAboutFamiliars01"
    }
    {
      Id = "Melinoe_3552_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siap, Komandan."
      Speaker = "Melinoe"
      Event = "SkellyAboutFamiliars01"
    }
    {
      Id = "Skelly_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Murid-muridku sangat menghargai semua perbaikan di tempat latihan ini, anak muda! Sebentar lagi kita bakal punya perkemahan perang yang layak di sini!"
      Speaker = "Skelly"
      Event = "SkellyAboutCosmetics01"
    }
    {
      Id = "Melinoe_3810"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang bisa kita lakukan demi mendongkrak moral sangatlah sepadan. Ada perbaikan lain yang ingin kau lihat?"
      Speaker = "Melinoe"
      Event = "SkellyAboutCosmetics01"
    }
    {
      Id = "Skelly_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah ya, seperti yang kau tahu, kebutuhanku sederhana saja! Cuma butuh gebukan mantap di kepala sesekali, itu saja."
      Speaker = "Skelly"
      Event = "SkellyAboutCosmetics01"
    }
    {
      Id = "Melinoe_3811"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beri tahu saja kalau ada hal lain."
      Speaker = "Melinoe"
      Event = "SkellyAboutCosmetics01"
    }
    {
      Id = "Skelly_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, akhirnya merasakan sengatan mematikan dari {#DialogLegendaryFormat}Belati Kembar{#Prev}! Mungkin inilah bilah {#Emph}tertajam {#Prev}yang pernah {#Emph}menyayatku!"
      Speaker = "Skelly"
      Event = "SkellyAboutDagger01"
    }
    {
      Id = "Melinoe_2492"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Suatu kehormatan bisa menggunakannya."
      Speaker = "Melinoe"
      Event = "SkellyAboutDagger01"
    }
    {
      Id = "Skelly_0503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau sudah membangkitkan kekuatan baru di Belatimu itu. Sudah kuduga benda itu bisa mengeluarkan trik hebat semacam itu! Senjata-senjata lama kakakmu dulu juga cara kerjanya mirip begitu!"
      Speaker = "Skelly"
      Event = "SkellyAboutHiddenDaggerAspect01"
    }
    {
      Id = "Melinoe_4273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senjata Neraka juga punya Aspek tersembunyi... tapi milik siapa ya, aku penasaran. Mungkin salah satunya milikmu, Komandan! Para Takdir menganugerahkan senjata mereka kepada para pahlawan, juga dewa-dewi..."
      Speaker = "Melinoe"
      Event = "SkellyAboutHiddenDaggerAspect01"
    }
    {
      Id = "Skelly_0504"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hati-hati bicaranya, anak muda! Rahasia Senjata Pusaka tidak boleh diobral sembarangan keras-keras..."
      Speaker = "Skelly"
      Event = "SkellyAboutHiddenDaggerAspect01"
    }
    {
      Id = "Melinoe_4274"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja. Maafkan aku."
      Speaker = "Melinoe"
      Event = "SkellyAboutHiddenDaggerAspect01"
    }
    {
      Id = "Skelly_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan dahsyat dari {#DialogLegendaryFormat}Kapak Batu Bulan {#Prev}kini milikmu! Tak banyak hal di luar sana yang tak bisa ditebasnya sampai putus, termasuk {#Emph}diriku!"
      Speaker = "Skelly"
      Event = "SkellyAboutAxe01"
    }
    {
      Id = "Melinoe_2493"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senjata ini lumayan berbobot."
      Speaker = "Melinoe"
      Event = "SkellyAboutAxe01"
    }
    {
      Id = "Skelly_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#DialogLegendaryFormat}Api Bayangan{#Prev}, anak muda! Kau persis seperti sang nyonya besar sendiri saat memegang benda itu. Semoga apinya selalu menerangi jalanmu, dan membakar siapa pun yang tak kau sukai."
      Speaker = "Skelly"
      Event = "SkellyAboutTorch01"
    }
    {
      Id = "Melinoe_2494"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan bertarung layaknya Kepala Sekolah sendiri."
      Speaker = "Melinoe"
      Event = "SkellyAboutTorch01"
    }
    {
      Id = "Skelly_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hormat setinggi-tingginya untuk pembawa {#DialogLegendaryFormat}Tengkorak Perak{#Prev}! Coba saja tengkorak kepalaku sendiri diperkuat dengan perak seperti itu dan bisa meledak sehebat itu!"
      Speaker = "Skelly"
      Event = "SkellyAboutLob01"
    }
    {
      Id = "Melinoe_3812"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu tengkorak hebat layak menghargai tengkorak lainnya."
      Speaker = "Melinoe"
      Event = "SkellyAboutLob01"
    }
    {
      Id = "Skelly_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi {#Emph}ini {#Prev}yang namanya {#DialogLegendaryFormat}Mantel Hitam{#Prev}! Persenjataan yang belum pernah dilihat dunia sebelumnya! Mungkin karena benda itu bisa meninju atau meledakkan siapa saja yang cukup bodoh untuk menghalangi jalanmu!"
      Speaker = "Skelly"
      Event = "SkellyAboutSuit01"
    }
    {
      Id = "Melinoe_3813"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasanya pas sekali, seolah memang diciptakan untukku..."
      Speaker = "Melinoe"
      Event = "SkellyAboutSuit01"
    }
    {
      Id = "Skelly_0616"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melihat polanya dengan jelas sekarang, kan? Enam Senjata Nokturnal, empat Aspek di tiap senjata, dan dua jalan keluar dari sini..."
      Speaker = "Skelly"
      Event = "SkellyAboutPatterns01"
    }
    {
      Id = "Melinoe_4980"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pola memang ada di mana-mana, tapi... yang kau maksud barusan, tak bisa kubilang aku pernah menyadarinya. Memangnya apa maknanya?"
      Speaker = "Melinoe"
      Event = "SkellyAboutPatterns01"
    }
    {
      Id = "Skelly_0617"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa {#Emph}maknanya? Pff{#Prev}, ayolah, kupikir itu sudah cukup jelas sekarang. Kau benar-benar butuh aku mengejanya satu per satu?"
      Speaker = "Skelly"
      Event = "SkellyAboutPatterns01"
    }
    {
      Id = "Melinoe_4981"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku bisa memikirkannya sendiri."
      Speaker = "Melinoe"
      Event = "SkellyAboutPatterns01"
    }
    {
      Id = "Skelly_0618"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, itu baru anak pintar!"
      Speaker = "Skelly"
      Event = "SkellyAboutPatterns01"
    }
    {
      Id = "Skelly_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Segudang pencapaianmu sejauh ini belum ada apa-apanya dibanding apa yang bisa kau dapatkan sekarang, anak muda! {#DialogLegendaryFormat}Kejayaan abadi {#Prev}bisa jadi milikmu, asal kau membuktikan kelayakanmu!"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuest01"
    }
    {
      Id = "Melinoe_3269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Corak pada kain tirai itu... Hadiah Rahasia Selubung, yang hanya dianugerahkan kepada pelayan Malam paling setia...! Komandan, kenapa benda itu ada di sini? Arwah sama sekali tak boleh melihatnya!"
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuest01"
    }
    {
      Id = "Skelly_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, anggap saja peraturannya baru saja berubah! {#Emph}Hadiah-hadiah {#Prev}itu, seperti yang kau sebutkan, bisa kau raih... asalkan kau mampu melakukan hal-hal yang diminta oleh {#DialogLegendaryFormat}Sumpah Gaib{#Prev}! Yang mana, seperti dugaanmu, jelas bukan perkara gampang."
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuest01"
    }
    {
      Id = "Melinoe_3270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin ini cuma ujian keserakahan dan keangkuhan semata... terlalu memaksakan diri dengan Sumpah itu bisa membahayakan tugasku."
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuest01"
    }
    {
      Id = "Skelly_0305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ayolah{#Prev}, jangan seperti {#Emph}anak cengeng!"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuest01"
    }
    {
      Id = "Skelly_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau mau meraih Hadiah Selubung di sana? Atau menyia-nyiakan kesempatanmu untuk mendapatkan secuil {#DialogLegendaryFormat}kejayaan abadi {#Prev}itu?"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuest02"
    }
    {
      Id = "Melinoe_3271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kejayaan abadi... jika hal itu memang pantas bagi mereka yang berhasil mencapai pencapaian luar biasa, biarlah begitu. Tapi mengejar kejayaan demi kejayaan itu sendiri? Rasanya itu keliru... setidaknya, itu bukan cara kita."
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuest02"
    }
    {
      Id = "Skelly_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi cara kita kan bisa {#Emph}berubah{#Prev}, setuju tidak? Kita tak boleh terbelenggu oleh cara-cara kuno! Bukannya aku mau memaksamu, bocah, cuma... kupikir kau pantas mendapatkan apa yang jadi hakmu, itu saja."
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuest02"
    }
    {
      Id = "Melinoe_3272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Akan kupikirkan nanti."
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuest02"
    }
    {
      Id = "Skelly_0358_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tinggal separuh jalan lagi menuju kemenangan, Bocah! Tapi demi mendapatkan Hadiah Terselubung, kau harus menaklukkan Dunia Bawah {#Emph}dan {#Prev}alam permukaan di malam penuh {#DialogLegendaryFormat}Rasa Takut{#Prev}, satu demi satu. Kau sanggup?"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuestProgress01_A"
    }
    {
      Id = "Melinoe_3362"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi kejayaan Dunia Bawah dan kekuasaan abadi Sang Malam, aku akan kerahkan segenap kemampuanku. Apakah itu membuatku layak menerima Hadiah Terselubung, entahlah."
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuestProgress01_A"
    }
    {
      Id = "Skelly_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ayolah{#Prev}, jangan lesu begitu, {#Emph}dong! {#Prev}Dunia Bawah sudah beres, sekarang tinggal taklukkan permukaan, dan Hadiahnya bakal jadi {#Emph}milikmu! {#Prev}Paling tidak hadiah pertamanya. Ayo, lakukan!"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuestProgress01_A"
    }
    {
      Id = "Melinoe_3363"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah...!"
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuestProgress01_A"
    }
    {
      Id = "Skelly_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tinggal separuh jalan lagi menuju kemenangan, Sobat! Tapi demi mendapatkan Hadiah Terselubung, kau harus menaklukkan Dunia Bawah {#Emph}dan {#Prev}alam permukaan di malam penuh {#DialogLegendaryFormat}Rasa Takut{#Prev}, satu demi satu. Kau sanggup?"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuestProgress01_B"
    }
    {
      Id = "Skelly_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ayolah{#Prev}, jangan lesu begitu, {#Emph}dong! {#Prev}Permukaan sudah beres, sekarang tinggal taklukkan Dunia Bawah, dan Hadiahnya bakal jadi {#Emph}milikmu! {#Prev}Paling tidak hadiah pertamanya. Ayo, hajar!"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuestProgress01_B"
    }
    {
      Id = "Skelly_0372"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#DialogLegendaryFormat}Hadiah Terselubung {#Prev}kedua sudah {#Emph}nyaris {#Prev}bisa digapai! Tinggal maju sedikit dan menyentuhnya, t-tapi yaa s-siapkah kau mengikat {#DialogLegendaryFormat}Sumpah {#Prev}dan mengambil rute sebaliknya?"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuestProgress02_A"
    }
    {
      Id = "Melinoe_3485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukannya ingin membuatmu penasaran, Komandan, tapi kita lihat saja nanti."
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuestProgress02_A"
    }
    {
      Id = "Skelly_0373"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan menunggu di sini sambil menahan napas—kalau aku punya napas!"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuestProgress02_A"
    }
    {
      Id = "Skelly_0374"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#DialogLegendaryFormat}Hadiah Terselubung {#Prev}yang terakhir dan paling megah sudah di depan mata! Kalau kau bisa menuntaskan {#Emph}salah satu {#Prev}dari dua rute di bawah Sumpah, sisanya pasti cuma jalan-jalan santai di taman!"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuestProgress03_A"
    }
    {
      Id = "Melinoe_3486"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berasumsi kalau jalan-jalan di {#Emph}taman {#Prev}yang kau sebut itu pastilah pengalaman yang sangat menyiksa."
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuestProgress03_A"
    }
    {
      Id = "Skelly_0375"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di beberapa sudut kota? {#Emph}Ohh{#Prev}, jelas sekali."
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuestProgress03_A"
    }
    {
      Id = "Melinoe_3288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka Hadiah Terselubung itu berupa patung-patung ini... Kupikir hadiahnya adalah Selubung itu sendiri... kain tirai yang ditenun dengan benang terbaik Takdir. Lagipula, ke mana kain-kain itu pergi?"
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuest03"
    }
    {
      Id = "Skelly_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kain itu? Kami, {#Emph}eerr{#Prev}, kami kembalikan ke dalam kegelapan asalnya. Itu cuma bungkus paket, tahu? Kau dapat {#DialogLegendaryFormat}barang aslinya{#Prev}, sumpah!"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuest03"
    }
    {
      Id = "Melinoe_3289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih sulit percaya Sang Malam memberiku penghormatan dengan pajangan yang begitu mencolok. Meski begitu, mungkin Hadiah ini bukan semata untuk{#Emph}ku{#Prev}, melainkan demi mengobarkan semangat mereka yang mengabdi pada perjuangan kita..."
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuest03"
    }
    {
      Id = "Skelly_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, kalau dipikir-pikir, para Arwah {#Emph}memang {#Prev}suka melongo menatapinya saat kau sedang pergi. Kau tetap bisa menginspirasi mereka meski tidak ada di sini! Kalau itu bukan {#DialogLegendaryFormat}kejayaan abadi{#Prev}... lantas apa coba?"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuest03"
    }
    {
      Id = "Melinoe_3290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah-arwah ini terinspirasi hanya karena aku repot-repot memikul Sumpah Yang Tak Kasatmata demi keuntungan pribadi?"
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuest03"
    }
    {
      Id = "Skelly_0324_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Iya lah! {#Prev}Mereka gampang terhibur! Tidak sepertimu, tampaknya. Baru tahu aku kalau Kampiun Sang Malam kerjanya banyak tanya terus! Kau mau patungnya atau tidak, nih?"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuest03"
    }
    {
      Id = "Melinoe_3291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...A... aku mau!"
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuest03"
    }
    {
      Id = "Skelly_0325"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bagus! {#Prev}Soalnya tidak bisa dikembalikan lagi karena sudah telanjur kau buka."
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuest03"
    }
    {
      Id = "Melinoe_3292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Apa?"
      Speaker = "Melinoe"
      Event = "SkellyAboutTrophyQuest03"
    }
    {
      Id = "Skelly_0326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa!"
      Speaker = "Skelly"
      Event = "SkellyAboutTrophyQuest03"
    }
    {
      Id = "Melinoe_3275"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Komandan, apa itu maksudnya... {#Emph}diriku?"
      Speaker = "Melinoe"
      Event = "TrophyQuestComplete01"
    }
    {
      Id = "Skelly_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itulah {#DialogLegendaryFormat}Kampiun Sang Malam {#Prev}yang telah diramalkan Takdir! Sosok yang menebar {#DialogLegendaryFormat}Rasa Takut {#Prev}ke sanubari para penentang alam ini, dan sejenisnya lah! Kulihat kau sampai kehilangan kata-kata saking agungnya rupa itu! Dan ini baru yang pertama, lho!"
      Speaker = "Skelly"
      Event = "TrophyQuestComplete01"
    }
    {
      Id = "Melinoe_3276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitulah. Dan apakah Hadiah lainnya juga se-, {#Emph}ehem... {#Prev}detail ini? Lagipula, aku tidak yakin sanggup menanggung kejayaan dua kali apalagi tiga kali lipatnya, padahal tugasku saat ini saja sudah cukup berat..."
      Speaker = "Melinoe"
      Event = "TrophyQuestComplete01"
    }
    {
      Id = "Skelly_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, jadi {#DialogLegendaryFormat}Rasa Takut {#Prev}mulai merasukimu, ya. Jangan menyerah padanya, Sobat! Sebaliknya, pasrahlah pada {#DialogLegendaryFormat}Rasa Ingin Tahu {#Prev}akan Hadiah-hadiah agung lainnya! Pikirkan {#Emph}martabatmu! {#Prev}Sekarang kau mau jadi penakut yang mudah menyerah, atau {#DialogLegendaryFormat}Kampiun Sang Malam{#Prev}, pilih yang mana?"
      Speaker = "Skelly"
      Event = "TrophyQuestComplete01"
    }
    {
      Id = "Melinoe_3277"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Haruskah kuputuskan saat ini juga?"
      Speaker = "Melinoe"
      Event = "TrophyQuestComplete01"
    }
    {
      Id = "Skelly_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nggak kok{#Prev}, pakai saja waktu sebanyak yang kau butuhkan."
      Speaker = "Skelly"
      Event = "TrophyQuestComplete01"
    }
    {
      Id = "Melinoe_3280"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Komandan, a... aku agak kehabisan kata-kata, kurasa! Kendati demikian, aku benar-benar tersanjung."
      Speaker = "Melinoe"
      Event = "TrophyQuestComplete02"
    }
    {
      Id = "Skelly_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau {#Emph}harus {#Prev}merasa begitu! Kau tahu seberapa repotnya aku—maksudku para {#Emph}Moirai {#Prev}demi menyusun semua ini? Tapi {#DialogLegendaryFormat}Kampiun Sang Malam {#Prev}hanya berhak mendapat yang terbaik... yaitu yang {#Emph}terakhir{#Prev}, yang belum kau lihat itu!"
      Speaker = "Skelly"
      Event = "TrophyQuestComplete02"
    }
    {
      Id = "Melinoe_3281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pikiranku gamang membayangkan ada pahatan yang lebih berlebihan dari patung-patung ini. Patung itu tertutup selubung Sang Malam... apa yang melarangku sekadar mengintipnya? Tampaknya {#Emph}kau {#Prev}sendiri sudah melihatnya."
      Speaker = "Melinoe"
      Event = "TrophyQuestComplete02"
    }
    {
      Id = "Skelly_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepertinya {#Emph}kau {#Prev}mungkin bukan {#DialogLegendaryFormat}Kampiun Sang Malam {#Prev}sejati kalau sampai mengusulkan taktik licik semacam itu! Mau dapat kehormatan tertinggi, ya harus {#Emph}punya {#Prev}kehormatan. Artinya dilarang mengintip! Nah, sekarang kau mau pakai {#DialogLegendaryFormat}Sumpah {#Prev}itu lagi, atau tidak?"
      Speaker = "Skelly"
      Event = "TrophyQuestComplete02"
    }
    {
      Id = "Melinoe_3282"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Entahlah. Semua ini masih terasa agak kurang bijak bagiku. Meski aku menghargai doronganmu dan terilhami oleh kata-kata dukunganmu, mungkin aku tidak boleh terburu-buru mengaitkan harga diriku dengan menimbun barang-barang duniawi."
      Speaker = "Melinoe"
      Event = "TrophyQuestComplete02"
    }
    {
      Id = "Skelly_0317"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ayolah{#Prev}, Sobat, jangan {#Emph}bicara {#Prev}begitu!"
      Speaker = "Skelly"
      Event = "TrophyQuestComplete02"
    }
    {
      Id = "Melinoe_3285"
      InheritFrom = "BaseNarrative"
      DisplayName = "A... aku sangat tersanjung, Komandan. Karena telah mengabdi pada alam ini, dan dianugerahi patung yang begitu... provokatif. Kupikir seni adalah sarana mengekspresikan keindahan; tak pernah kusadari seni bisa memantik begitu banyak... perasaan yang rumit."
      Speaker = "Melinoe"
      Event = "TrophyQuestComplete03"
    }
    {
      Id = "Skelly_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perasaanku campur aduk begitu mikirin betapa susahnya bawa barang-barang itu ke mari tanpa ketahuan sama kau! Tapi ya sudahlah, {#DialogLegendaryFormat}selamat, ya{#Prev}. Harusnya kita bikin pesta penghormatan atau apa kek, tapi... {#Emph}yah{#Prev}, jangan sampai ada yang tahu soal ini. Jadi, ini bakal jadi rahasia kita berdua."
      Speaker = "Skelly"
      Event = "TrophyQuestComplete03"
    }
    {
      Id = "Melinoe_3286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, ini artinya aku sungguh Sang Juara Malam? Dan kejayaan abadi milikku?"
      Speaker = "Melinoe"
      Event = "TrophyQuestComplete03"
    }
    {
      Id = "Skelly_0321"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yoi, percaya deh."
      Speaker = "Skelly"
      Event = "TrophyQuestComplete03"
    }
    {
      Id = "Melinoe_3287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Oke."
      Speaker = "Melinoe"
      Event = "TrophyQuestComplete03"
    }
    {
      Id = "Skelly_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua {#DialogLegendaryFormat}Senjata Nokturnal{#Prev} milikmu itu punya jurus yang beda-beda! Jangan pusing mikirin mana yang paling kuat; pilihlah mana yang paling cocok di hatimu."
      Speaker = "Skelly"
      Event = "SkellyHintWeapons01"
    }
    {
      Id = "Melinoe_4054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan bagaimana kalau semuanya cocok di hatiku? Sayup-sayup terdengar, tapi tetap saja."
      Speaker = "Melinoe"
      Event = "SkellyHintWeapons01"
    }
    {
      Id = "Skelly_0451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu pilih yang ngasih Tulang ekstra!"
      Speaker = "Skelly"
      Event = "SkellyHintWeapons01"
    }
    {
      Id = "Skelly_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waspadalah tiap kali kau lihat orang bebal yang diselimuti semacam {#DialogLegendaryFormat}pelindung kuning{#Prev}! Sebelum kau bisa menembus zirah perlindungan mereka, mereka bisa balas menghajarmu!"
      Speaker = "Skelly"
      Event = "SkellyHintArmor01"
    }
    {
      Id = "Melinoe_4167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah bisa membuat musuh berzirah bergeming sedikit pun dari seranganku."
      Speaker = "Melinoe"
      Event = "SkellyHintArmor01"
    }
    {
      Id = "Skelly_0483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu wajar banget, semua orang juga ngalamin."
      Speaker = "Skelly"
      Event = "SkellyHintArmor01"
    }
    {
      Id = "Skelly_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pastikan kau sikat semua {#DialogLegendaryFormat}Abu{#Prev} yang bisa kau temukan di luar sana, Bocah. Nanti kau bisa balurkan ke Altarmu buat buka {#DialogLegendaryFormat}Kartu-Kartu{#Prev} keren itu! Kau bakal makin kekar dalam sekejap."
      Speaker = "Skelly"
      Event = "SkellyHintMetaCardPoints01"
    }
    {
      Id = "Melinoe_4166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Arcana menyingkap potensi terbesarku... dari Abu masa lalu, tercipta kemungkinan bagi masa depan."
      Speaker = "Melinoe"
      Event = "SkellyHintMetaCardPoints01"
    }
    {
      Id = "Skelly_0481_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemungkinan buat ngehajar orang-orang bebal lebih keras dari sebelumnya!"
      Speaker = "Skelly"
      Event = "SkellyHintMetaCardPoints01"
    }
    {
      Id = "Skelly_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua latihanmu bakal sia-sia kalau nggak dipakai dalam pertarungan. Misalnya aku lagi ngejar kau pakai gada dan kau pengin bikin aku mematung. Coba pasang {#DialogLegendaryFormat}Lingkaran Pengikat{#Prev} di sebelah sini!"
      Speaker = "Skelly"
      Event = "SkellyHintCast01"
    }
    {
      Id = "Skelly_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan lupa pakai jurus {#DialogLegendaryFormat}Cast{#Prev}-mu itu. Bisa bikin orang-orang bebal langsung terhenti di tempat! Dan kalau kau kasih mereka versi {#DialogLegendaryFormat}Omega{#Prev}... {#Emph}buak!"
      Speaker = "Skelly"
      Event = "SkellyHintCast02"
    }
    {
      Id = "Melinoe_4168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lingkaran Pengikat jelas memiliki banyak kegunaan..."
      Speaker = "Melinoe"
      Event = "SkellyHintCast02"
    }
    {
      Id = "Skelly_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seni yang ingin kau kuasai ini memang menguras tenaga. Tapi tenang saja, kekuatan sihirmu bakal balik lagi begitu kau sampai di area berikutnya. Jadi {#Emph}pakai saja{#Prev}, nggak ada gunanya disimpan-simpan!"
      Speaker = "Skelly"
      Event = "SkellyHintMana01"
    }
    {
      Id = "Skelly_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa orang bebal yang kau temui di luar sana lumayan alot! Tapi jurus {#DialogLegendaryFormat}Gerakan Omega{#Prev} andalanmu pasti bisa membabat mereka semudah memotong mentega hangat. {#Emph}Pertarungan terasa hambar? {#Prev}{#DialogLegendaryItalicFormat}Tekan dan tahan sebentar."
      Speaker = "Skelly"
      Event = "SkellyHintDamage01"
    }
    {
      Id = "Melinoe_4055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sihir harus digunakan secara hemat, hanya saat dibutuhkan."
      Speaker = "Melinoe"
      Event = "SkellyHintDamage01"
    }
    {
      Id = "Skelly_0445"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan kau {#Emph}butuh{#Prev} menang!"
      Speaker = "Skelly"
      Event = "SkellyHintDamage01"
    }
    {
      Id = "Skelly_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar Selene yang Agung menganugerahimu salah satu {#DialogLegendaryFormat}Kutukan{#Prev} miliknya. Efeknya luar biasa, tapi kau harus menguras banyak sihir dulu buat mengisinya! {#Emph}Yah{#Prev}, mirip seperti mengisi daya kristal!"
      Speaker = "Skelly"
      Event = "SkellyHintSpellDrop01"
    }
    {
      Id = "Melinoe_3359"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, kupikir sebagian besar pengalamanmu ada di jalur bela diri. Tapi kau juga paham seluk-beluk sihir?"
      Speaker = "Melinoe"
      Event = "SkellyHintSpellDrop01"
    }
    {
      Id = "Skelly_0342"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, tentu saja."
      Speaker = "Skelly"
      Event = "SkellyHintSpellDrop01"
    }
    {
      Id = "Skelly_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menjadi penghuni Underworld yang terlindung bayangan punya keistimewaan tersendiri, Anak Muda! Contohnya, bagaimana {#DialogLegendaryFormat}saat kau Melesat, tak ada satu pun yang bisa menyentuhmu{#Prev}!"
      Speaker = "Skelly"
      Event = "SkellyHintDash01"
    }
    {
      Id = "Melinoe_3357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami adalah Kaum Tak Kasat Mata... menyatu dengan kegelapan dan arwah kematian. Aku bisa menghindar dari apa pun, ya. Tapi hanya sesaat, dan sekalipun begitu... aku tak bisa menang hanya dengan terus menghindar sepanjang malam."
      Speaker = "Melinoe"
      Event = "SkellyHintDash01"
    }
    {
      Id = "Skelly_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Yah{#Prev}, aku sih bakal ngelakuin itu terus-menerus kalau jadi kau! Lihat {#DialogLegendaryFormat}jejak kecil{#Prev} saat kau Melesat? Begitu jejaknya memudar, kau siap melesat {#Emph}lagi!"
      Speaker = "Skelly"
      Event = "SkellyHintDash01"
    }
    {
      Id = "Melinoe_3358"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bayangan itu mengikuti..."
      Speaker = "Melinoe"
      Event = "SkellyHintDash01"
    }
    {
      Id = "Skelly_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau makin lincah saja, Anak Muda. Lincah banget! Andai saja aku juga bisa {#DialogLegendaryFormat}melesat{#Prev} begitu cepat sampai-sampai {#DialogLegendaryFormat}tak tersentuh{#Prev}, atau lari sekencang... serigala betina, atau apalah itu? Coba beri aku beberapa putaran!"
      Speaker = "Skelly"
      Event = "SkellyHintSprint01"
    }
    {
      Id = "Skelly_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tempat ini selalu butuh murid-murid baru. Kalau kau lihat Arwah orang mati luntang-lantung di luar sana, ingat latihanmu dan {#DialogLegendaryFormat}tabrak langsung mereka{#Prev}! Mereka pasti bakal sadar dan menurut."
      Speaker = "Skelly"
      Event = "SkellyHintShadeMercs01"
    }
    {
      Id = "Melinoe_1577"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan sekadar menurut, Tuan. Mereka siap bergabung dalam perjuangan kita. Sekarang mereka tahu pasti siapa aku, dan apa tujuan perjuangan kita di sini."
      Speaker = "Melinoe"
      Event = "SkellyHintShadeMercs01"
    }
    {
      Id = "Skelly_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga kau terus menabrak banyak dari mereka."
      Speaker = "Skelly"
      Event = "SkellyHintShadeMercs01"
    }
    {
      Id = "Skelly_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa-masaku berlarian merampas barang orang mungkin sudah berakhir, tapi punyamu baru saja dimulai, Bocah! Buka matamu lebar-lebar untuk mencari barang yang berguna di luar sana, dan pastikan bawa {#DialogLegendaryFormat}Perkakas{#Prev} yang paling pas buat tugasmu."
      Speaker = "Skelly"
      Event = "SkellyHintResources01"
    }
    {
      Id = "Melinoe_2254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau dulu biasa berlarian dan... merampas barang orang?"
      Speaker = "Melinoe"
      Event = "SkellyHintResources01"
    }
    {
      Id = "Skelly_0364"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa denganmu, Anak Muda? Wajahmu tampak cemas begitu, barangkali luasnya pengalamanku ini bisa meringankannya. Ayolah, tumpahkan saja!"
      Speaker = "Skelly"
      Event = "SkellyHintResources02"
    }
    {
      Id = "Melinoe_3368"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, Komandan... aku hanya sedang memikirkan semua bahan reaksi yang masih kubutuhkan. Sebagian tumbuh di wilayah yang berbeda, atau membutuhkan perkakas yang berlainan... banyak sekali yang harus kuingat."
      Speaker = "Melinoe"
      Event = "SkellyHintResources02"
    }
    {
      Id = "Skelly_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau nggak perlu mengingat semuanya di kepalamu! {#DialogLegendaryFormat}Tas Ungu {#Prev}yang kau pakai buat bawa segala macam barang itu... entah bagaimana caranya... bukannya semua catatanmu juga ada di situ? Jadi kalau kau lupa di mana harus mencari sesuatu, periksa {#Emph}saja di sana! {#Prev}Malah, kenapa nggak kau cek sekarang juga?"
      Speaker = "Skelly"
      Event = "SkellyHintResources02"
    }
    {
      Id = "Melinoe_3369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku memang punya catatan tentang semuanya di situ..."
      Speaker = "Melinoe"
      Event = "SkellyHintResources02"
    }
    {
      Id = "Skelly_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hubunganmu dengan alam gaib ini artinya kau pasti punya firasat tentang apa yang menanti di setiap belokan. Seperti melihat jendela ke masa depan di setiap ambang pintu! Kau mungkin belum tahu arti semua simbol-simbol kecil itu, tapi kau bakal paham pada akhirnya."
      Speaker = "Skelly"
      Event = "SkellyHintRoomRewards01"
    }
    {
      Id = "Melinoe_4056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jendela ke masa depan... dan di persimpangan jalan, aku tinggal memilih mana yang terlihat paling menjanjikan."
      Speaker = "Melinoe"
      Event = "SkellyHintRoomRewards01"
    }
    {
      Id = "Skelly_0447"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jelas aku juga bakal melakukan hal yang sama kalau jadi dirimu."
      Speaker = "Skelly"
      Event = "SkellyHintRoomRewards01"
    }
    {
      Id = "Skelly_0376"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan pengalaman, seseorang bakal punya bakat untuk hal-hal tertentu, dan salah satu bakat {#Emph}milikku {#Prev}adalah mendeteksi {#DialogLegendaryFormat}Bones{#Prev}, berbagai bentuk dan ukuran serta dalam jumlah beragam, dan anak muda: Kau punya {#Emph}banyak banget."
      Speaker = "Skelly"
      Event = "SkellyHintBones01"
    }
    {
      Id = "Melinoe_3480"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berada di alam orang mati, Komandan. Tulang-belulang sama sekali tidak sulit ditemukan, terutama sedekat ini dengan permukaan. Meskipun... mungkin sang Pialang punya kegunaan yang lebih baik untuk itu."
      Speaker = "Melinoe"
      Event = "SkellyHintBones01"
    }
    {
      Id = "Skelly_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu persis yang mau {#Emph}kukatakan! {#Prev}Tentu, mungkin kau bisa pakai beberapa untuk rapalan mantra di sana-sini, tapi si {#DialogLegendaryFormat}Broker {#Prev}tua itu bakal doyan banget melahapnya."
      Speaker = "Skelly"
      Event = "SkellyHintBones01"
    }
    {
      Id = "Melinoe_3481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi aku suka menimbunnya..."
      Speaker = "Melinoe"
      Event = "SkellyHintBones01"
    }
    {
      Id = "Skelly_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihlah dengan bijak, anak muda, sebelum kau berangkat tiap malam! Ada kartu {#DialogLegendaryFormat}Arcana {#Prev}milikmu di Altar, pilihan {#DialogLegendaryFormat}Nocturnal Arms{#Prev}, {#DialogLegendaryFormat}Keepsake{#Prev}, {#DialogLegendaryFormat}Animal Familiar{#Prev}... maksudku, {#Emph}astaga..."
      Speaker = "Skelly"
      Event = "SkellyHintChoices01"
    }
    {
      Id = "Melinoe_3370"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak juga yang harus dipikirkan kalau kau jabarkan seperti itu, Komandan. Tapi tujuanku selalu jelas: {#Emph}Temukan sang Titan, bantai sang Titan. Bebaskan keluargaku, bebaskan Olympus."
      Speaker = "Melinoe"
      Event = "SkellyHintChoices01"
    }
    {
      Id = "Skelly_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, barusan itu sudah mencakup empat hal yang berbeda sama sekali..."
      Speaker = "Skelly"
      Event = "SkellyHintChoices01"
    }
    {
      Id = "Skelly_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, jangan patah arang cuma gara-gara kau kena gebuk, paham? Di antara {#DialogLegendaryFormat}Altar {#Prev}dan {#DialogLegendaryFormat}Kubangan Perak {#Prev}di belakang sana, kau bakal makin lama makin tangguh, sampai {#Emph}kaulah {#Prev}yang bakal balik menggebuki mereka semua!"
      Speaker = "Skelly"
      Event = "SkellyHintDying01"
    }
    {
      Id = "Melinoe_2255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maksudmu Kolam Perak, Pak."
      Speaker = "Melinoe"
      Event = "SkellyHintDying01"
    }
    {
      Id = "Skelly_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau sudah mencapai batas {#DialogLegendaryFormat}Grasp {#Prev}kartu Arcana-mu, ya? Wajar kok, semua orang juga begitu! Kau cuma butuh lebih banyak {#DialogLegendaryFormat}Psyche{#Prev}, dan kau bakal segera bisa menampung lebih banyak Kartu-kartu itu!"
      Speaker = "Skelly"
      Event = "SkellyHintGrasp01"
    }
    {
      Id = "Melinoe_3355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hubunganku dengan orang mati, hubunganku dengan masa lalu... dan Altar adalah perantaranya! Komandan, apa kau sendiri bisa memanfaatkan kekuatan Arcana?"
      Speaker = "Melinoe"
      Event = "SkellyHintGrasp01"
    }
    {
      Id = "Skelly_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, dulu sih aku lumayan jago menggambar, tapi {#Emph}yah{#Prev}, mungkin nggak sebagus gambar-gambar di Kartu-kartu itu."
      Speaker = "Skelly"
      Event = "SkellyHintGrasp01"
    }
    {
      Id = "Melinoe_3356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau menggambar {#Emph}lukisan{#Prev}, Pak...?"
      Speaker = "Melinoe"
      Event = "SkellyHintGrasp01"
    }
    {
      Id = "Skelly_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa, anak muda, merasa buntu? Maksudku, langkahmu {#Emph}memang {#Prev}terhambat, tapi secara spiritual kau sedang membuat kemajuan!"
      Speaker = "Skelly"
      Event = "SkellyHintProgress01"
    }
    {
      Id = "Melinoe_4057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kemajuan macam apa itu, Komandan...? Aku masih sangat jauh dari tujuanku untuk menumbangkan sang Titan. Aku harus melangkah lebih jauh lagi."
      Speaker = "Melinoe"
      Event = "SkellyHintProgress01"
    }
    {
      Id = "Skelly_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau cuma perlu lebih sering {#DialogLegendaryFormat}Dash {#Prev}alih-alih menerima begitu banyak pukulan, dan kumpulkan lebih banyak Kartu {#DialogLegendaryFormat}Arcana{#Prev}, itu bakal bikin kau jauh lebih tangguh! Setiap malam juga jalannya bakal berbeda sedikit, kok."
      Speaker = "Skelly"
      Event = "SkellyHintProgress01"
    }
    {
      Id = "Melinoe_4058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga malam ini berjalan sedikit lebih baik."
      Speaker = "Melinoe"
      Event = "SkellyHintProgress01"
    }
    {
      Id = "Skelly_0583"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, {#Emph}terkutuklah {#Prev}tulang-belulang tua yang rapuh ini, sampai-sampai tak mampu lagi menerima sebanyak mungkin hajaran darimu seperti dulu! Dulu aku tahan banting sekali, tapi akhir-akhir ini? Entahlah."
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest01"
    }
    {
      Id = "Melinoe_4947"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, ada apa denganmu? Kukira kau sangat ingin ditebas senjata apa pun yang kumiliki, semakin ganas semakin bagus. Apa aku harus menahan diri?"
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest01"
    }
    {
      Id = "Skelly_0584"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jangan pernah! {#Prev}Aku cuma ingin menyerap lebih banyak siksaan sebelum remuk berkeping-keping dan harus menyusun diriku kembali. Kau sekarang jauh lebih kuat, tapi aku {#Emph}tidak! {#Prev}Rasanya sungguh tidak adil! Tapi {#Emph}ada {#Prev}sesuatu yang bisa kau lakukan..."
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest01"
    }
    {
      Id = "Melinoe_4948"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa ini? Mantra untuk memperkuat {#Emph}kepadatan tulang?"
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest01"
    }
    {
      Id = "Skelly_0585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pikirkan saja dulu baik-baik, oke?"
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest01"
    }
    {
      Id = "Melinoe_4949"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, Peningkatan Kepadatan Tulang yang kau ajarkan padaku... itu mantra yang berbiaya sangat tinggi. Kau yakin sudah siap? Jika kita melanjutkannya, efeknya tidak akan bisa dibatalkan."
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest02"
    }
    {
      Id = "Skelly_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anak muda, aku sudah {#Emph}terlahir {#Prev}siap. Coba tempatkan dirimu di posisiku: Bukankah kau juga ingin bisa menerima hajaran yang luar biasa dahsyat?"
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest02"
    }
    {
      Id = "Melinoe_4950"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih memilih menghindari hajaran sama sekali, tapi aku paham daya tariknya dari sudut pandangmu. Tulangmu akan menjadi jauh lebih tahan banting... asalkan hancur berkeping-keping bukanlah bagian terbaik bagimu."
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest02"
    }
    {
      Id = "Skelly_0587"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama sekali bukan, tahu! Soalnya pas aku remuk berkeping-keping, aku lagi nggak dipukuli, padahal kenikmatan sejatinya ada di {#Emph}situ{#Prev}, biar kutegaskan padamu. {#Prev}Jadi, kau mau merapalkan mantra ini atau nggak?"
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest02"
    }
    {
      Id = "Melinoe_4951"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sedang kupelajari..."
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest02"
    }
    {
      Id = "Skelly_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah, hahaha, dasar bodoh! {#Prev}Sekarang aku sudah benar-benar {#DialogLegendaryFormat}abadi{#Prev}, dan {#Emph}sebentar lagi? {#Prev}Sebentar lagi, kalian semua bakal membayar mahal atas semua gunjingan di belakangku... pembalasan dendam akhirnya bakal jadi {#Emph}milikku!"
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest03"
    }
    {
      Id = "Melinoe_4955"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, apa maksudnya semua ini? Kau tidak seperti dirimu yang biasa! Aku cuma merapalkan Peningkatan Kepadatan Tulang!"
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest03"
    }
    {
      Id = "Skelly_0590"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau terjebak langsung ke dalam perangkap tulang jariku. Karena sekarang mustahil {#Emph}aku {#Prev}bisa dihabisi! Coba saja kalau berani, dan lihat apa yang terjadi!"
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest03"
    }
    {
      Id = "Skelly_0591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah, hahahahahaha!"
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest03"
    }
    {
      Id = "Skelly_0596"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kuharap kau sudah memetik pelajaranmu, Bocah! Kau kira aku sudah jadi jauh lebih kuat daripada musuh mana pun yang pernah kau hadapi, hanya untuk mendapati bahwa mantra {#DialogLegendaryFormat}Penguatan Kepadatan Tulang {#Prev}itu tak banyak berefek..."
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest04"
    }
    {
      Id = "Melinoe_4959"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, kupikir terjadi hal terburuk saat kau bertingkah seolah, yah, mabuk kepayang oleh kekuatan barumu. Belum pernah kulihat sisi dirimu yang seperti itu sebelumnya."
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest04"
    }
    {
      Id = "Skelly_0597"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau takkan melihat sisi itu dariku {#Emph}lagi! {#Prev}Asalkan kau tak membiasakan diri merapal mantra yang kau dapat dari orang asing!"
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest04"
    }
    {
      Id = "Melinoe_4960"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau bukan orang asing. Kau sekutu tepercaya! Benar, kan...?"
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest04"
    }
    {
      Id = "Skelly_0598"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, {#Emph}jelas{#Prev}, tapi... sudahlah lupakan saja, oke? Pukul saja aku seperti biasa, aku bahkan tak peduli."
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest04"
    }
    {
      Id = "Melinoe_4961"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah..."
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest04"
    }
    {
      Id = "Melinoe_4962"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lega rasanya kau bukan musuh pendendam yang memperdayaku untuk merapal mantra pemicu kekuatan aslinya yang mengerikan, Komandan, tapi... apa kau merasa ada bedanya setelah Penguatan Kepadatan Tulang itu, atau tidak?"
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest05"
    }
    {
      Id = "Skelly_0599"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, asal kau tahu, aku {#Emph}memang {#Prev}merasa sedikit lebih tangguh dari sebelumnya, Bocah, jadi terima kasih! Kupikir memang hanya segitu yang bisa dilakukan mantramu, tapi aku sempat mengerjaimu, kan?"
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest05"
    }
    {
      Id = "Melinoe_4963"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa begitu, tapi... kau malah membuatku menyadari kalau aku bakal sangat sedih jika suatu malam kau tak kembali. Kau bukan sekadar Komandan kami... kau temanku."
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest05"
    }
    {
      Id = "Skelly_0600"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, kau bersungguh-sungguh, Bocah? Karena sejujurnya, terkadang yang kulakukan hanyalah {#Emph}berdiri {#Prev}di sini. Bahkan bukan cuma {#Emph}terkadang!"
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest05"
    }
    {
      Id = "Melinoe_4964"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja aku bersungguh-sungguh, Tuan."
      Speaker = "Melinoe"
      Event = "SkellyAboutHealthQuest05"
    }
    {
      Id = "Skelly_0601"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh{#Prev}, jangan begitu, {#Emph}lah..."
      Speaker = "Skelly"
      Event = "SkellyAboutHealthQuest05"
    }
    {
      Id = "Melinoe_4977"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berusaha tak memikirkan apa yang bakal terjadi jika dan saat semua ini akhirnya selesai, Komandan. Aku tahu semestinya aku fokus penuh pada tugas, tapi... selagi kita mendekati akhir yang potensial, aku tak bisa berhenti memikirkan masa depan."
      Speaker = "Melinoe"
      Event = "SkellyAboutUltimateProgress01"
    }
    {
      Id = "Skelly_0614"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu {#Emph}hentikan! {#Prev}Berapa kali harus kubilang, {#EmphLegendary}jangan pernah memikirkan masa depan{#Prev}, Bocah. Takkan ada hal baik yang keluar dari {#Emph}itu. {#Prev}Hanya saat ini dan di sini yang terpenting!"
      Speaker = "Skelly"
      Event = "SkellyAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_4978"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh-sungguh bilang bahwa orang tak boleh berencana? Tapi kau seorang {#Emph}Komandan... {#Prev}antisipasi dan strategi itu bagian terpenting dalam kepemimpinan tempur...!"
      Speaker = "Melinoe"
      Event = "SkellyAboutUltimateProgress01"
    }
    {
      Id = "Skelly_0615"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau selalu berbuat baik sekarang {#Emph}juga{#Prev}, kau bakal selalu baik-baik saja nanti, kuncinya cuma itu! Sekarang berhentilah cemas."
      Speaker = "Skelly"
      Event = "SkellyAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_4979"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ehm... {#Prev}Baiklah."
      Speaker = "Melinoe"
      Event = "SkellyAboutUltimateProgress01"
    }
    {
      Id = "Skelly_0644"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kisah-kisah membahana tentang pencapaian hebatmu sudah sampai duluan kemari, Anak muda! Dan aku di sini hendak melimpahkan pujian yang lebih banyak lagi: Kerja bagus waktu mengurus segala urusan Chronos itu."
      Speaker = "Skelly"
      Event = "SkellyPostTrueEnding01"
    }
    {
      Id = "Melinoe_5002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih banyak, Komandan, tapi... apa yang masih kaulakukan di sini? Kukira kau bakal kembali ke pos kehormatanmu di Griya, tapi akhirnya aku harus pergi."
      Speaker = "Melinoe"
      Event = "SkellyPostTrueEnding01"
    }
    {
      Id = "Skelly_0645"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, urusanmu kan belum sepenuhnya beres, {#Emph}iya, kan? {#Prev}Kulihat kau terus memandangi gerbang keluar, bertanya-tanya apa yang bakal terjadi sekarang. Jadi selama {#Emph}kau {#Prev}berada di sini... aku juga!"
      Speaker = "Skelly"
      Event = "SkellyPostTrueEnding01"
    }
    {
      Id = "Melinoe_5003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau bersumpah setia pada kami... padaku."
      Speaker = "Melinoe"
      Event = "SkellyPostTrueEnding01"
    }
    {
      Id = "Skelly_0646"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, aku takkan pergi ke mana-mana."
      Speaker = "Skelly"
      Event = "SkellyPostTrueEnding01"
    }
    {
      Id = "Melinoe_5760"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin menyampaikan... aku mengalami hal tak biasa di Griya Hades. Tak kudengar ada yang menyebut namamu di sana, terlepas dari status terhormatmu. Hanya ada kerangka yang berjaga di luar... {#Emph}Schele... Schelae... {#Prev}mungkin mirip-mirip seperti itu?"
      Speaker = "Melinoe"
      Event = "SkellyPostTrueEnding02"
    }
    {
      Id = "Skelly_0756"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa?! {#Prev}Bocah. Kau pikir kami para kerangka ini semuanya sama? Itu sudah {#Emph}kelewatan{#Prev}, Sobat! Ayolah, kukira kau... {#Emph}Bwuh! {#Prev}Tak habis pikir!"
      Speaker = "Skelly"
      Event = "SkellyPostTrueEnding02"
    }
    {
      Id = "Melinoe_5761"
      InheritFrom = "BaseNarrative"
      DisplayName = "A-apa, a... aku tak bermaksud menyiratkan begitu... {#Emph}eugh{#Prev}, maafkan aku."
      Speaker = "Melinoe"
      Event = "SkellyPostTrueEnding02"
    }
    {
      Id = "Skelly_0757"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Cih. {#Prev}Maksudku, sumpah deh..."
      Speaker = "Skelly"
      Event = "SkellyPostTrueEnding02"
    }
    {
      Id = "Melinoe_5675"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, apa kata semua muridmu tentang kembalinya Tiga Takdir? Kurasa kau sudah mendengarnya."
      Speaker = "Melinoe"
      Event = "SkellyPostEpilogue01"
    }
    {
      Id = "Skelly_0752"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, ya, aku sudah dengar... {#DialogLegendaryItalicFormat}Takdir, Syakdir {#Prev}begitulah kata mereka, kalau kau penasaran."
      Speaker = "Skelly"
      Event = "SkellyPostEpilogue01"
    }
    {
      Id = "Melinoe_5676"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Takdir, Syakdir{#Prev}, apa maksudnya {#Emph}itu? {#Prev}Kesan pertamanya terdengar agak kurang ajar."
      Speaker = "Melinoe"
      Event = "SkellyPostEpilogue01"
    }
    {
      Id = "Skelly_0753"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kurang ajar? {#Prev}Oh, {#Emph}jauh {#Prev}sekali aku dari niat {#Emph}itu! {#Prev}Aku hanya bilang {#DialogLegendaryItalicFormat}Takdir, Syakdir {#Prev}dan memintamu merenungkan bobot dari kata-kataku."
      Speaker = "Skelly"
      Event = "SkellyPostEpilogue01"
    }
    {
      Id = "Melinoe_5677"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak peduli bahwa zaman baru mungkin bakal tiba... bahwa kekuasaan para dewa mungkin berakhir."
      Speaker = "Melinoe"
      Event = "SkellyPostEpilogue01"
    }
    {
      Id = "Skelly_0754"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bocah, aku baru percaya kalau itu sudah kejadian. Mungkin kita semua sudah mati saat waktu itu tiba."
      Speaker = "Skelly"
      Event = "SkellyPostEpilogue01"
    }
    {
      Id = "Melinoe_5678"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku abadi dan kalian semua memang {#Emph}sudah {#Prev}mati!"
      Speaker = "Melinoe"
      Event = "SkellyPostEpilogue01"
    }
    {
      Id = "Skelly_0755"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku cuma bilang, jangan terlalu banyak berharap."
      Speaker = "Skelly"
      Event = "SkellyPostEpilogue01"
    }
    {
      Id = "Melinoe_4975"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang tadi kau bicarakan soal masa tugasmu, Komandan?"
      Speaker = "Melinoe"
      Event = "SkellyAboutTenure01"
    }
    {
      Id = "Skelly_0612"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Bukan apa-apa. Cuma bilang kalau posisiku sekarang sudah permanen. Soalnya beberapa muridku, terutama yang baru-baru, sempat tanya-tanya soal syarat pengabdianku..."
      Speaker = "Skelly"
      Event = "SkellyAboutTenure01"
    }
    {
      Id = "Melinoe_4976"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak boleh ada pembangkangan terhadap Komandan, kalian dengar itu, para Arwah?"
      Speaker = "Melinoe"
      Event = "SkellyAboutTenure01"
    }
    {
      Id = "Skelly_0613"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Eh, hehehe. {#Prev}Kalian dengar sendiri, kan barusan?!"
      Speaker = "Skelly"
      Event = "SkellyAboutTenure01"
    }
    {
      Id = "Skelly_0760"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lihat barang yang baru kita dapat itu? Namanya {#DialogLegendaryFormat}Selimut Mimpi{#Prev}! Hangat, lembut, bahannya kelas atas... begitu kau berbaring, {#Emph}booom{#Prev}, langsung teler seketika. Yah, setidaknya begitu katanya."
      Speaker = "Skelly"
      Event = "SkellyAboutDreamRuns01"
    }
    {
      Id = "Melinoe_5817"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak pernah terpikir olehku tempat latihan kita bisa jadi tempat bersantai... meski begitu, kupikir pikiran yang tenang dan mantap memang sama pentingnya dengan kesiapan fisik."
      Speaker = "Melinoe"
      Event = "SkellyAboutDreamRuns01"
    }
    {
      Id = "Skelly_0761"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali! Jadi kalau mau tidur siang sejenak, gas saja, kau pantas mendapatkannya! Aku dan murid-muridku merasa terhormat untuk berjaga. Lagian kerjaan kami memang cuma berdiri di sini!"
      Speaker = "Skelly"
      Event = "SkellyAboutDreamRuns01"
    }
    {
      Id = "Melinoe_5818"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan aku sangat menghargai kalian semua."
      Speaker = "Melinoe"
      Event = "SkellyAboutDreamRuns01"
    }
    {
      Id = "Skelly_0762"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi gimana sensasi {#DialogLegendaryFormat}Selimut Mimpi {#Prev}itu, sesuai namanya atau tidak? {#Emph}Ah{#Prev}, andai saja letaknya tidak kelewat jauh dari jangkauanku. Dikira aku ini Tantalus apa, hah?"
      Speaker = "Skelly"
      Event = "SkellyAboutDreamRuns02"
    }
    {
      Id = "Melinoe_5819"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benda itu lebih dari sekadar selimut mewah; itu adalah gerbang menuju alam mimpi, dari Dewa Hypnos sendiri. Kau mau mencobanya? Aku bisa coba menyeretmu ke sana, atau minta Nemesis membopongmu?"
      Speaker = "Melinoe"
      Event = "SkellyAboutDreamRuns02"
    }
    {
      Id = "Skelly_0763"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}haha{#Prev}, aku takkan tergoda hal semacam itu, anak muda! Aku takkan pernah meninggalkan pos jagaku dalam kondisi apa pun! Tapi kalau aku jadi kau, aku pasti sudah langsung mendengkur pulas di sana sekarang."
      Speaker = "Skelly"
      Event = "SkellyAboutDreamRuns02"
    }
    {
      Id = "Melinoe_5820"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beri tahu aku jika kau berubah pikiran..."
      Speaker = "Melinoe"
      Event = "SkellyAboutDreamRuns02"
    }
    {
      Id = "Skelly_0647"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kita berhasil, bocah! Atau paling tidak, {#Emph}aku {#Prev}yang berhasil. Seluruh pengalaman ini... memberiku banyak bahan untuk direnungkan."
      Speaker = "Skelly"
      Event = "SkellyAboutSayingLittle01"
    }
    {
      Id = "Melinoe_5004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paling tidak sekarang kau punya waktu untuk merenungkannya, Komandan. Beri tahu aku kalau dapat pencerahan, ya?"
      Speaker = "Melinoe"
      Event = "SkellyAboutSayingLittle01"
    }
    {
      Id = "Skelly_0648"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti. Tapi mungkin aku tak bakal banyak omong, maksudku, aku {#Emph}capek banget! {#Prev}Bukan capek dihajar {#Emph}olehmu{#Prev}, tentunya, kalau yang {#Emph}itu {#Prev}sih mana pernah bikin kapok."
      Speaker = "Skelly"
      Event = "SkellyAboutSayingLittle01"
    }
    {
      Id = "Melinoe_5005"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekali lagi terima kasih, Komandan."
      Speaker = "Melinoe"
      Event = "SkellyAboutSayingLittle01"
    }
    {
      Id = "Skelly_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau bisa beri sedikit demonstrasi pada murid-muridku, heh?"
      Speaker = "Skelly"
      Event = "SkellyChat01"
    }
    {
      Id = "Skelly_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurangi diskusi, perbanyak sensasi babak belur di sini, bocah!"
      Speaker = "Skelly"
      Event = "SkellyChat02"
    }
    {
      Id = "Skelly_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemarilah, anak muda, ayo kita lihat pukulan terbaikmu sekarang juga."
      Speaker = "Skelly"
      Event = "SkellyChat03"
    }
    {
      Id = "Skelly_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak usah bicara, fokus saja, dan pukuli aku bertubi-tubi!"
      Speaker = "Skelly"
      Event = "SkellyChat04"
    }
    {
      Id = "Skelly_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sabar, anak muda! Kau bakal... kemungkinan besar bisa melewati semua ini."
      Speaker = "Skelly"
      Event = "SkellyChat05"
    }
    {
      Id = "Skelly_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebetulan datang untuk berlatih denganku? Atau cuma sekadar lewat?"
      Speaker = "Skelly"
      Event = "SkellyChat06"
    }
    {
      Id = "Skelly_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurangi basa-basi, perbanyak baku hantam, kalau kau tak keberatan?"
      Speaker = "Skelly"
      Event = "SkellyChat07"
    }
    {
      Id = "Skelly_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kau punya sedikit luka buat dihadiahkan padaku?"
      Speaker = "Skelly"
      Event = "SkellyChat08"
    }
    {
      Id = "Skelly_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo hajar aku, anak muda, biar aku tidak merasa sedih."
      Speaker = "Skelly"
      Event = "SkellyChat09"
    }
    {
      Id = "Skelly_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahan dulu pertanyaanmu dan {#Emph}serang{#Prev}, anak muda!"
      Speaker = "Skelly"
      Event = "SkellyChat10"
    }
    {
      Id = "Skelly_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak usah banyak ngobrol yang tidak perlu, tapi kau boleh memukulku sesukamu!"
      Speaker = "Skelly"
      Event = "SkellyChat11"
    }
    {
      Id = "Skelly_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa tidak ada urusan lain yang lebih penting untuk kau lakukan?"
      Speaker = "Skelly"
      Event = "SkellyChat12"
    }
    {
      Id = "Skelly_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap percobaanmu hanyalah satu langkah di jalan takdirmu. Begitu pula memukuli diriku."
      Speaker = "Skelly"
      Event = "SkellyChat13"
    }
    {
      Id = "Skelly_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fokuslah pada jalanmu, atau mungkin gebuki aku sedikit dulu sebelumnya."
      Speaker = "Skelly"
      Event = "SkellyChat14"
    }
    {
      Id = "Skelly_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua muridku percaya padamu dan semacamnya."
      Speaker = "Skelly"
      Event = "SkellyChat15"
    }
    {
      Id = "Skelly_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Majulah, anak muda, dan kami akan setia berjaga di sini sampai kau kembali."
      Speaker = "Skelly"
      Event = "SkellyChat16"
    }
    {
      Id = "Skelly_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tulang-tulang tua ini lebih kokoh dari kelihatannya, buktikan saja sendiri."
      Speaker = "Skelly"
      Event = "SkellyChat17"
    }
    {
      Id = "Skelly_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakal ada banyak waktu buat obrolan santai saat kemenangan sudah di tangan kita!"
      Speaker = "Skelly"
      Event = "SkellyChat18"
    }
    {
      Id = "Skelly_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bicaralah lewat {#Emph}senjatamu{#Prev}, anak muda, bukan lewat kata-kata!"
      Speaker = "Skelly"
      Event = "SkellyChat19"
    }
    {
      Id = "Skelly_0659"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang kurang beres? Sini, luapkan saja semuanya padaku!"
      Speaker = "Skelly"
      Event = "SkellyChat20"
    }
    {
      Id = "Skelly_0649"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan ajak aku bicara, Anak Muda, langsung tebas saja aku!"
      Speaker = "Skelly"
      Event = "SkellyChat21"
    }
    {
      Id = "Skelly_0650"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo, ingatkan aku sehebat apa Senjata Nokturnal itu!"
      Speaker = "Skelly"
      Event = "SkellyChat22"
    }
    {
      Id = "Skelly_0651"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang namanya latihan berlebihan, Bocah!"
      Speaker = "Skelly"
      Event = "SkellyChat23"
    }
    {
      Id = "Skelly_0652"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarkan jurus terbaikmu, atau jurus terburukmu, aku sama sekali tak peduli!"
      Speaker = "Skelly"
      Event = "SkellyChat24"
    }
    {
      Id = "Skelly_0653"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hantam aku dengan cepat dan tepat, atau terserah sesuka hatimu saja."
      Speaker = "Skelly"
      Event = "SkellyChat25"
    }
    {
      Id = "Skelly_0654"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurangi bacot, perbanyak gebuk, Bocah, hajar aku di sini!"
      Speaker = "Skelly"
      Event = "SkellyChat26"
    }
    {
      Id = "Skelly_0655"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo berikan serangan terbaikmu! Sekali saja, ya?"
      Speaker = "Skelly"
      Event = "SkellyChat27"
    }
    {
      Id = "Skelly_0656"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong jangan pergi dulu tanpa setidaknya satu tebasan latihan, ya?"
      Speaker = "Skelly"
      Event = "SkellyChat28"
    }
    {
      Id = "Skelly_0657"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir murid-muridku sudah saatnya diberi sedikit demonstrasi!"
      Speaker = "Skelly"
      Event = "SkellyChat29"
    }
    {
      Id = "Skelly_0658"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunjukkan pada murid-muridku puncak teknik terhebatmu!"
      Speaker = "Skelly"
      Event = "SkellyChat30"
    }
    {
      Id = "Skelly_0660"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan dipendam sendiri perasaanmu itu, tumpahkan saja semuanya padaku!"
      Speaker = "Skelly"
      Event = "SkellyChat31"
    }
    {
      Id = "Skelly_0661"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lama sekali sejak terakhir kali kau menumbangkanku, Anak Muda..."
      Speaker = "Skelly"
      Event = "SkellyChat32"
    }
    {
      Id = "Skelly_0662"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir malam-malam begini aku sudah saatnya dihajar babak belur."
      Speaker = "Skelly"
      Event = "SkellyChat33"
    }
    {
      Id = "Skelly_0663"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunjukkan pada kami kekuatan tak tertandingi dari Sang Jawara Malam!"
      Speaker = "Skelly"
      Event = "SkellyChat34"
    }
    {
      Id = "Skelly_0664"
      InheritFrom = "BaseNarrative"
      DisplayName = "Awas saja kalau kau berani menahan diri, takkan pernah kumaafkan!"
      Speaker = "Skelly"
      Event = "SkellyChat35"
    }
    {
      Id = "Skelly_0665"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurangi mengobrol, perbanyak... mencabik-cabik, entahlah!"
      Speaker = "Skelly"
      Event = "SkellyChat36"
    }
    {
      Id = "Skelly_0666"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang mau kau sampaikan padaku? Biarkan Senjata Nokturnal itu yang bicara."
      Speaker = "Skelly"
      Event = "SkellyChat37"
    }
    {
      Id = "Skelly_0667"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh juga nih kalau dihantam sampai remuk sekarang."
      Speaker = "Skelly"
      Event = "SkellyChat38"
    }
    {
      Id = "Skelly_0668"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lagi ngidam berat pengin kena tebas dan sayat lagi di sini."
      Speaker = "Skelly"
      Event = "SkellyChat39"
    }
    {
      Id = "Skelly_0669"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak apa yang kedengarannya asyik? Dibakar atau diledakkan sampai berkeping-keping..."
      Speaker = "Skelly"
      Event = "SkellyChat40"
    }
    {
      Id = "Melinoe_1050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, meski kita berkewajiban menjaga tradisi lama tetap hidup, nikmatilah Nektar ini tanpa terbebani oleh makna penting di baliknya."
      Speaker = "Melinoe"
      Event = "SkellyGift01"
    }
    {
      Id = "Skelly_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat menghargai persembahan sekaligus kebaikan hatimu. Dan dengan ini aku akan menjalankan tugasku: {#Emph}Lihatlah! {#Prev}Benda paling beruntung milikku kini sudah resmi jadi milikmu!"
      Speaker = "Skelly"
      Event = "SkellyGift01"
    }
    {
      Id = "Skelly_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kenangan masa lalu, Anak Muda... kakakmu dulu juga sering memanjakanku seperti ini. Demi dia dan juga dirimu, kuterima ini. Sekarang, terimalah {#Emph}rasa terima kasihku{#Prev}: {#Emph}Hei, makasih ya!"
      Speaker = "Skelly"
      Event = "SkellyGift02"
    }
    {
      Id = "Melinoe_1051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama-sama, Komandan! Dan {#Emph}hei, terima kasih kembali{#Prev} padamu, atas wawasanmu yang tiada tanding dan kehadiranmu yang selalu setia."
      Speaker = "Melinoe"
      Event = "SkellyGift02"
    }
    {
      Id = "Skelly_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat berterima kasih atas kemurahan hatimu. Andaikan saja ada hal lain yang bisa kuberikan sebagai balasannya selain kebijaksanaan dari pengalamanku yang luar biasa luas ini..."
      Speaker = "Skelly"
      Event = "SkellyGift03"
    }
    {
      Id = "Melinoe_1052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kumohon, Tuan, itu sudah lebih dari cukup. Murid-muridmu dan aku sungguh beruntung bisa berguru padamu."
      Speaker = "Melinoe"
      Event = "SkellyGift03"
    }
    {
      Id = "Skelly_0371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak boleh terbuai kemewahan seperti ini! Murid-muridku mengandalkan bimbinganku yang jernih dan perhatian penuhku. Tapi begini saja, ini bakal kusimpan buat nanti pas jam istirahatku, oke?"
      Speaker = "Skelly"
      Event = "SkellyGift04"
    }
    {
      Id = "Melinoe_3484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang kau sebut kemewahan ini... tentu tak ada apa-apanya dibanding kemewahan di Kediaman ayahku. Namun kau tak pernah menginginkan apa pun. Selain sesekali dihajar satu dua kali."
      Speaker = "Melinoe"
      Event = "SkellyGift04"
    }
    {
      Id = "Skelly_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah tak terhitung berapa kali aku dijamu minuman dan camilan paling lezat, tapi belum pernah dari murid yang begitu disiplin dan terhormat sepertimu! Kalian para pemalas dengar {#Emph}itu, tidak?! {#Prev}Bawa persembahan lagi ke sini, ayo!"
      Speaker = "Skelly"
      Event = "SkellyGift05"
    }
    {
      Id = "Melinoe_3372"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar itu terserah kau gunakan untuk apa, Tuan! Semoga bisa meringankan beban tanggung jawab yang kau pikul demi para Arwah dan yang lainnya yang mengandalkan keahlian serta pengetahuanmu."
      Speaker = "Melinoe"
      Event = "SkellyGift05"
    }
    {
      Id = "Skelly_0390"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, bakal kuberi mereka keahlian dan pengetahuan."
      Speaker = "Skelly"
      Event = "SkellyGift05"
    }
    {
      Id = "Skelly_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, Bocah... aku harus jujur padamu. Aku punya masalah soal minum-meminum. Semuanya langsung tembus lewat celah tulangku! Aku cuma tak ingin kau membuang-buangnya, padahal kau bisa memberikannya ke orang lain di luar sana."
      Speaker = "Skelly"
      Event = "SkellyGift06"
    }
    {
      Id = "Melinoe_3551"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, terima kasih atas kejujuranmu padaku... Aku sedih memikirkan bahwa semua Nektar itu malah membuatmu tak nyaman. Kau tahu kau tak harus meminumnya, kan? Itu bisa jadi barang koleksi... pengingat akan teman-temanmu, dan kasih sayang yang mereka miliki untukmu."
      Speaker = "Melinoe"
      Event = "SkellyGift06"
    }
    {
      Id = "Skelly_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kasih sayang pekok, dengar ya, bakal kusimpan untuk yang {#Emph}keenam {#Prev}kalinya ini saja... tapi jangan coba-coba memberiku lagi, paham?"
      Speaker = "Skelly"
      Event = "SkellyGift06"
    }
    {
      Id = "Melinoe_3552"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siap, Komandan."
      Speaker = "Melinoe"
      Event = "SkellyGift06"
    }
    {
      Id = "Melinoe_4965"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau tak lagi menginginkan Nektar saat ini, tapi bagaimana jika kutawari Ambrosia, Komandan? Bahkan ini bukan sekadar pengandaian, jadi terimalah!"
      Speaker = "Melinoe"
      Event = "SkellyGift07"
    }
    {
      Id = "Skelly_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, ini hadiah yang luar biasa rupawan, sampai-sampai aku kehabisan kata-kata. Sudah lama sekali aku tidak menerima {#DialogLegendaryFormat}Pujian {#Prev}seperti ini sejak kakakmu sendiri memberiku hadiah serupa {#Emph}tempo hari..."
      Speaker = "Skelly"
      Event = "SkellyGift07"
    }
    {
      Id = "Melinoe_4966"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Seperti apa situasinya saat itu? Meski ini bukan sekadar hadiah, melainkan tanda persahabatan kita yang telah terjalin lama."
      Speaker = "Melinoe"
      Event = "SkellyGift07"
    }
    {
      Id = "Skelly_0603"
      InheritFrom = "BaseNarrative"
      DisplayName = "Situasinya waktu itu si bocah berulang kali menjadikanku sasaran latihan pukul, jadi Ambrosia itu sebagai gantiruginya."
      Speaker = "Skelly"
      Event = "SkellyGift07"
    }
    {
      Id = "Melinoe_4967"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu rupanya..."
      Speaker = "Melinoe"
      Event = "SkellyGift07"
    }
    {
      Id = "Melinoe_4968"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah menjadi sasaran latihanku jauh lebih sering daripada yang bisa kuingat, Komandan. Jadi aku ingin kau menerima Ambrosia ini sebagai tanda rasa terima kasihku. Takkan ada orang lain yang rela melakukannya!"
      Speaker = "Melinoe"
      Event = "SkellyGift08"
    }
    {
      Id = "Skelly_0604"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jelas sekali {#Prev}tak bakal ada yang rela! Aku sudah menggeluti profesi ini lebih lama dari siapa pun, dan kau tak pernah melihatku menggerakkan {#Emph}otot {#Prev}sedikit pun, kan?"
      Speaker = "Skelly"
      Event = "SkellyGift08"
    }
    {
      Id = "Melinoe_4969"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, sejauh yang kulihat kau memang {#Emph}tidak punya {#Prev}otot, Komandan. Tapi aku tahu kau telah lama melayani keluargaku dengan terhormat, dan kesetiaan semacam itu pantang disia-siakan."
      Speaker = "Melinoe"
      Event = "SkellyGift08"
    }
    {
      Id = "Skelly_0605"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar kuberi tahu, Nak, tak semua orang berpikir seperti {#Emph}dirimu{#Prev}. Banyak orang di luar sana, mereka membayarmu untuk sebuah pekerjaan, lalu selesai begitu saja. Tak ada {#Emph}kesetiaan{#Prev}, tak ada prospek jangka panjang, ataupun stabilitas..."
      Speaker = "Skelly"
      Event = "SkellyGift08"
    }
    {
      Id = "Melinoe_4970"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya sekadar pekerjaan tentara bayaran."
      Speaker = "Melinoe"
      Event = "SkellyGift08"
    }
    {
      Id = "Skelly_0606"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali."
      Speaker = "Skelly"
      Event = "SkellyGift08"
    }
    {
      Id = "Melinoe_4971"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepada Komandan Schelemeus yang terhormat, pelindung garis keturunan Hades, wali Dunia Bawah yang ditunjuk oleh Takdir: Semoga Ambrosia ini selamanya menjamin pengabdianmu, selama kau bersedia memberikannya!"
      Speaker = "Melinoe"
      Event = "SkellyGift09"
    }
    {
      Id = "Skelly_0607"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei tunggu, barusan kau memberiku {#DialogLegendaryFormat}status pegawai tetap {#Prev}atas nama keluarga, Nak? Apa kau memang {#Emph}bisa {#Prev}melakukan itu, dan lagipula... {#Emph}kenapa?{#Prev}"
      Speaker = "Skelly"
      Event = "SkellyGift09"
    }
    {
      Id = "Melinoe_4972"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku Putri Dunia Bawah; itu sepenuhnya hakku. Dan soal alasannya, sudah kubilang tadi bahwa aku tak pernah menyia-nyiakan kesetiaan. Aku ingin kau tahu bahwa aku bersungguh-sungguh."
      Speaker = "Melinoe"
      Event = "SkellyGift09"
    }
    {
      Id = "Skelly_0608"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, aku memang tak mengira kau bakal menggantikanku dengan yang lain, tapi... ini sangat berarti bagiku. Aku tahu aku membantumu belajar memukul dengan sangat keras, Nak... tapi tak kusangka pukulanmu kali ini bakal telak menusuk sanubari..."
      Speaker = "Skelly"
      Event = "SkellyGift09"
    }
    {
      Id = "Melinoe_4973"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih untuk segalanya, Komandan."
      Speaker = "Melinoe"
      Event = "SkellyGift09"
    }
    {
      Id = "Skelly_0609"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya melakukan apa yang kubayar untuk itu."
      Speaker = "Skelly"
      Event = "SkellyGift09"
    }
    {
      Id = "Melinoe_4974"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau dibayar untuk ini?"
      Speaker = "Melinoe"
      Event = "SkellyGift09"
    }
    {
      Id = "Skelly_0610"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...Nggak juga, sih."
      Speaker = "Skelly"
      Event = "SkellyGift09"
    }
    {
      Id = "Melinoe_3361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, apakah kau bersedia menemaniku ke Mata Air suatu saat nanti? Kita bisa mengistirahatkan tulang-tulang kita yang lelah sejenak."
      Speaker = "Melinoe"
      Event = "SkellyBathHouseDecline01"
    }
    {
      Id = "Skelly_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memangnya kau mau apa, menggendongku ke sana? Kehadiranku dibutuhkan {#Emph}di sini{#Prev}, anak muda, karena Arwah-arwah ini masih butuh kedisiplinan! Mungkin di era lain, saat hal-hal yang kita sayangi tak lagi dipertaruhkan..."
      Speaker = "Skelly"
      Event = "SkellyBathHouseDecline01"
    }
    {
      Id = "Melinoe_3360"
      InheritFrom = "BaseNarrative"
      DisplayName = "Komandan, kami sudah memperbaiki dermaga pemancingan! Bersediakah kau bergabung denganku di sana, mengingat segala pengalaman baharimu?"
      Speaker = "Melinoe"
      Event = "SkellyFishingDecline01"
    }
    {
      Id = "Skelly_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa-masaku bersama para ikan sudah lama berlalu, anak muda. Lagipula, tempatku ada di sini... tepat di titik ini. Tapi, terima kasih tawarannya!"
      Speaker = "Skelly"
      Event = "SkellyFishingDecline01"
    }
    {
      Id = "Melinoe_1053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebuah kehormatan bagiku, Komandan."
      Speaker = "Melinoe"
      Event = "NPC_Skelly_01.GiftGivenVoiceLines"
    }
    {
      Id = "Skelly_0172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lumayanlah..."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Skelly_0021"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan kembali..."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Melinoe_0076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maafkan aku, Komandan..."
      Speaker = "Melinoe"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Skelly_0593"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh{#Prev}, sialan!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Melinoe_4956"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Komandan...? {#Emph}Komandan!{#Prev}"
      Speaker = "Melinoe"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Melinoe_5704"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Komandan, kumohon, kembalilah..."
      Speaker = "Melinoe"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Melinoe_4957"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dewa-dewi, dia lenyap..."
      Speaker = "Melinoe"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Skelly_0020"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Serangan yang fatal..."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Skelly_0061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "A-aku... harus... pergi..."
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Skelly_0062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terkutuklah tulang-tulang tua ini!"
      Speaker = "Skelly"
      Event = "NPC_Skelly_01.OnDeathVoiceLines"
    }
    {
      Id = "Skelly_0064"
