      Event = "Prometheus.MemoryAttackOutroVoiceLines"
    }
    {
      Id = "Prometheus_0427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang {#Emph}bertarunglah!"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackOutroVoiceLines"
    }
    {
      Id = "Prometheus_0254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Urusan kita belum selesai!"
