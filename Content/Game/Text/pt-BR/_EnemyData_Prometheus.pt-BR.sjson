    }
    {
      Id = "Prometheus_0189"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keparat {#Emph}kau."
      Speaker = "Prometheus"
      Event = "Prometheus.LastStandReactionVoiceLines"
    }
    {
      Id = "Prometheus_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekuatanmu mulai pudar."
      Speaker = "Prometheus"
      Event = "Prometheus.LastStandReactionVoiceLines"
    }
    {
      Id = "Prometheus_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mampu menahan semua itu..."
      Speaker = "Prometheus"
      Event = "Prometheus.LastStandReactionVoiceLines"
    }
    {
      Id = "Prometheus_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apalah arti hidup tanpa rasa sakit?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menderitalah seperti aku dulu."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, menderitalah."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Putar balik."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembalilah."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembalilah ke neraka."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0174"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tinggalkan tempat ini."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0175"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau paham sekarang?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0176"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan menahan diri."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kuhanguskan dirimu jadi abu."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0393"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak siap menghadapi apa yang menantimu di puncak!"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0394"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarilah, tunjukkan padaku seberapa jauh penglihatan masa depanmu itu!"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0395"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau hanya perlu menghindari tiga gelombang api, tapi di {#Emph}mana?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0396"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pilihlah jalurmu dengan bijak, Sang Agen Perubahan! Jangan sampai kau terbakar."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0397"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tahu ke mana aku akan menyerang, tapi apakah itu cukup?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0399"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salah satu langkah saja, dan akan kupanggang kau sampai hangus."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0401"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah jalur atas, atau jalur tengah, mungkin...?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti jalur bawah dulu, lalu disusul yang atas?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0403"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lebih baik diam di jalur tengah? Atau, mungkin jalur bawah...?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0400"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah gerakanku mulai terlalu mudah kau tebak, Agen Perubahan?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0398"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu mudahnya kau mengantisipasi kobaran apiku sekarang..."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0179"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian para dewa..."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang perlu kusembunyikan dari sosok sepertimu?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian semua para dewa, ingatan kalian {#Emph}jauh {#Prev}terlalu pendek."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0406"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cobalah cari polanya jika mau; tapi itu tak ada gunanya."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0407"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu apa yang akan menimpamu di sini; bagaimana denganmu?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0408"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ingat baik-baik apa yang akan kau saksikan..."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0409"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisakah kau memprediksi apa yang akan terjadi semudah diriku?"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apiku takkan mengampunimu atau dewa {#Emph}mana pun...!"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0411"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Api ini tak pernah menjadi milik kalian, tapi rasakan ini! {#Emph}Ambillah!"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0412"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu nasib apa yang menantimu kelak, Agen Perubahan... tapi sebelum itu..."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0413"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian para dewa punya banyak dosa untuk dipertanggungjawabkan, namun tak ada yang mampu memaksanya..."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0414"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita lihat apakah kau sanggup menghindari kobaran api ini lagi!"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0415"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tubuhku pernah dicabik-cabik di puncak gunung yang membeku; luka {#Emph}ini {#Prev}bukan {#Emph}apa-apa."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Heracles_0381"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau terbakar. Aku tidak."
      Speaker = "Heracles"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Heracles_0382"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang apa, penyihir?"
      Speaker = "Heracles"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Heracles_0383"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini mungkin bakal sakit."
      Speaker = "Heracles"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Heracles_0384"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bakar penyihir itu!"
      Speaker = "Heracles"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Heracles_0385"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berhenti mengoceh dan {#Emph}tembak!"
      Speaker = "Heracles"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Heracles_0386"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, kabur dia."
      Speaker = "Heracles"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "MelinoeField_2859"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali ke sini!"
      Speaker = "Melinoe"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "MelinoeField_2861"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rencananya mulai terungkap..."
      Speaker = "Melinoe"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "MelinoeField_2862"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Penglihatan tentang kobaran api..."
      Speaker = "Melinoe"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "MelinoeField_2863"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti selalu ada polanya..."
      Speaker = "Melinoe"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "MelinoeField_2864"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gelombang kobaran api..."
      Speaker = "Melinoe"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "MelinoeField_2860"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, gawat..."
      Speaker = "Melinoe"
      Event = "Prometheus.MemoryAttackIntroVoiceLines"
    }
    {
      Id = "Prometheus_0421"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita lanjutkan."
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackOutroVoiceLines"
    }
    {
      Id = "Prometheus_0423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang apa yang kau lihat?!"
      Speaker = "Prometheus"
      Event = "Prometheus.MemoryAttackOutroVoiceLines"
    }
    {
      Id = "Prometheus_0426"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cukup!"
