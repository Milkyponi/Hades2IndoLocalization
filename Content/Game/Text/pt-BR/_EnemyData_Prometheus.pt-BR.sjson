      Speaker = "Prometheus"
      Event = "Prometheus.LowHealthVoiceLines"
    }
    {
      Id = "Prometheus_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kena aku..."
      Speaker = "Prometheus"
      Event = "Prometheus.LowHealthVoiceLines"
    }
    {
      Id = "Prometheus_0210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, ya."
      Speaker = "Prometheus"
      Event = "Prometheus.LowHealthVoiceLines"
    }
    {
      Id = "Prometheus_0211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cuma segitu?"
      Speaker = "Prometheus"
      Event = "Prometheus.LowHealthVoiceLines"
    }
    {
      Id = "Prometheus_0212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan harap."
      Speaker = "Prometheus"
      Event = "Prometheus.LowHealthVoiceLines"
    }
    {
      Id = "Prometheus_0239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berani sekali kau."
      Speaker = "Prometheus"
      Event = "Prometheus.LowHealthVoiceLines"
    }
    {
      Id = "Prometheus_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan kubalas karena itu."
      Speaker = "Prometheus"
      Event = "Prometheus.LowHealthVoiceLines"
    }
    {
      Id = "Prometheus_0240"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bakal menyesalinya!"
      Speaker = "Prometheus"
      Event = "Prometheus.LowHealthVoiceLines"
    }
    {
      Id = "Prometheus_0213"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bakal menyesalinya..."
      Speaker = "Prometheus"
      Event = "Prometheus.LowHealthVoiceLines"
