      Event = "Prometheus.CriticalHealthVoiceLines"
    }
    {
      Id = "Prometheus_0216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heh."
      Speaker = "Prometheus"
      Event = "Prometheus.CriticalHealthVoiceLines"
    }
    {
      Id = "Prometheus_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa..."
      Speaker = "Prometheus"
      Event = "Prometheus.CriticalHealthVoiceLines"
    }
    {
      Id = "Prometheus_0218"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana...?"
      Speaker = "Prometheus"
      Event = "Prometheus.CriticalHealthVoiceLines"
    }
    {
      Id = "Prometheus_0219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harusnya aku..."
      Speaker = "Prometheus"
      Event = "Prometheus.CriticalHealthVoiceLines"
    }
    {
      Id = "Prometheus_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau baru saja..."
      Speaker = "Prometheus"
      Event = "Prometheus.CriticalHealthVoiceLines"
    }
    {
      Id = "Prometheus_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi aku..."
      Speaker = "Prometheus"
      Event = "Prometheus.CriticalHealthVoiceLines"
    }
    {
      Id = "Prometheus_0262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini... tak mengubah... apa pun..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heh... heheheheh... ungh..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0264"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harusnya sudah... kuduga..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0265"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku pernah menderita... lebih parah... {#Emph}urgh..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini... pun... akan... berlalu..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua... sesuai... rencana..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dasar dewa-dewi... kubenci... kalian semua..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak adakah yang bisa... kuperbuat...?"
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0461"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemurkaan yang hebat... pertahankan itu..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku terlampaui... tapi tak pernah terkalahkan..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0464"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian para dewa... masih harus... banyak belajar..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi inilah masa depanku, rupanya..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0466"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak bisa menghancurkanku; itu aku tahu pasti."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekuatan Hades... sialan..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hal yang jauh lebih buruk... menanti... di atas sana..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0470"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak akan pernah... tunduk padamu..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0472"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa yang sudi... bertarung untukmu...?"
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0446"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu... cepat... {#Emph}urgh..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0447"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya dalam sekejap... mata..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0448"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak bisa... mengimbanginya..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0462"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Luka-lukaku... akan sembuh kembali..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0449"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau... terlalu cepat..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tahu... apa yang menanti... di depan..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan bersama Herakles, aku... {#Emph}urgh..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0460"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak bisa menghentikanmu... tapi aku tetap bertarung..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku melakukan... apa yang harus... kulakukan..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu... ini bakal terjadi... namun..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "Prometheus_0473"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beri monster itu... hajaran... setimpal..."
      Speaker = "Prometheus"
      Event = "Prometheus.DefeatedVoiceLines"
    }
    {
      Id = "MelinoeField_2518"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Dia sudah pergi."
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_2519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa dia sudah tahu bakal kalah...?"
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_2520"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sana obati lukamu."
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_2521"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah kuduga."
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_2522"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cukup sudah terawangan masa depannya."
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5594"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin kita bisa saja bertemu sebagai sekutu, bukan musuh..."
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5595"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Membiarkanku mengalahkanmu bahkan di dalam mimpiku..."
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_3742"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka bersekongkol..."
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka tangguh juga..."
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah berapa lama mereka bersekongkol...?"
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, kalian berdua...!"
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_2523"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa nanti!"
      Speaker = "Melinoe"
      Event = "Prometheus.BossKillVoiceLines"
    }
    {
      Id = "Prometheus_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, ini dia gangguan tak terduga dalam rencana tuanku! Aku tahu siapa dirimu, putri Hades yang terlantar, dan aku tahu kau pun tahu siapa diriku. Aku sudah mendapatkan firasat akan momen ini."
      Speaker = "Prometheus"
      Event = "PrometheusFirstMeeting"
    }
    {
      Id = "MelinoeField_2381"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Prometheus, rupanya. Firasatmu pasti datang tiada henti. Aku tak pernah dengar kau sudah bebas, atau bahwa Chronos adalah tuan yang kau layani. Jadi, ini bentuk solidaritas sesama Titan?"
      Speaker = "Melinoe"
      Event = "PrometheusFirstMeeting"
    }
    {
      Id = "Prometheus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakanlah ini perubahan hati. Dulu aku pengecut dan bodoh; pernah berpihak pada para dewa melawan kaumku sendiri. Namun tak lagi. Ini adalah usahaku menebus dosa."
      Speaker = "Prometheus"
      Event = "PrometheusFirstMeeting"
    }
    {
      Id = "MelinoeField_2382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, dengan memimpin penyerbuan gegabah ini? Aku tak pernah menganggapmu pengecut, tapi kau jelas masih saja bodoh."
      Speaker = "Melinoe"
      Event = "PrometheusFirstMeeting"
    }
    {
      Id = "Prometheus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau benar; namun setidaknya aku akan menjadi si bodoh yang menang. Karena aku telah melihat bahwa kau sama sekali tak punya peluang."
      Speaker = "Prometheus"
      Event = "PrometheusFirstMeeting"
    }
    {
      Id = "Prometheus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu apa yang menanti di depan sana, namun tetap saja kembali. Tentu saja aku tahu kau bakal datang, hanya saja aku tak paham alasannya. Karena kau tak mau memberitahuku..."
      Speaker = "Prometheus"
      Event = "PrometheusWonAgainstHim01"
    }
    {
      Id = "MelinoeField_2384"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Teka-teki omong kosongmu lebih membahayakan kesehatanku ketimbang dirimu, atau Elang peliharaan sialanmu itu."
      Speaker = "Melinoe"
      Event = "PrometheusWonAgainstHim01"
    }
    {
      Id = "Prometheus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ancaman yang kau hadapi berada di luar batas pemahamanmu; itulah satu-satunya alasan kau masih bertahan. Ketidaktahuanmu adalah sebuah {#Emph}anugerah! {#Prev}Sama seperti api yang kubagikan pada umat manusia, dan sekarang padamu."
      Speaker = "Prometheus"
      Event = "PrometheusWonAgainstHim01"
    }
    {
      Id = "Prometheus_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kemampuanmu dan bisa memprediksi setiap gerakanmu, namun... terkadang pikiranku sendiri menyesatkanku. Memprediksi kemungkinan-kemungkinan yang ternyata tak terjadi... berujung pada terlalu banyak kekeliruan."
      Speaker = "Prometheus"
      Event = "PrometheusWonAgainstHim02"
    }
    {
      Id = "MelinoeField_2553"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekeliruan seperti membeberkan hal ini padaku, atau berada di sini sejak awal. Apa kau tak memetik pelajaran dari masa pemenjaraanmu yang lalu?"
      Speaker = "Melinoe"
      Event = "PrometheusWonAgainstHim02"
    }
    {
      Id = "Prometheus_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dibelenggu berarti dirampas dari kesempatan untuk belajar. Bentuk siksaan yang kejam tersendiri, namun ada satu hal yang kupelajari, ya: aku tak bisa dihancurkan."
      Speaker = "Prometheus"
      Event = "PrometheusWonAgainstHim02"
    }
    {
      Id = "Prometheus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau berpikir bisa melewatiku, asalkan kau terus mencoba, mencoba, dan mencoba. Kenyataannya memang kau bakal berhasil! Mungkin bukan malam ini, tapi itu keniscayaan yang tak terhindarkan."
      Speaker = "Prometheus"
      Event = "PrometheusLostAgainstHim01"
    }
    {
      Id = "MelinoeField_2385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya kau menyisakan sedikit rasa penasaranku. Andaikan aku tahu setiap takdir akhir seperti Titan Peramal yang termasyhur, mungkin aku juga bakal berubah jadi bajingan pembelot yang getir."
      Speaker = "Melinoe"
      Event = "PrometheusLostAgainstHim01"
    }
    {
      Id = "Prometheus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu apa kau tentang penderitaanku?! Kau, yang meronta sia-sia melawan Sang Waktu itu sendiri? Keberanian melimpah yang lahir dari kecongkakan. Majulah kalau begitu, Sang Agen Perubahan, dan tunjukkan padaku apa yang sudah kutahu sanggup kau lakukan!"
      Speaker = "Prometheus"
      Event = "PrometheusLostAgainstHim01"
    }
    {
      Id = "Prometheus_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penglihatan Aetos luar biasa tajam, tentu saja. Dia sudah melihatmu sejak kau pertama kali menginjakkan kaki di kaki gunung. Menghambat langkahmu, mungkin, tapi tetap saja... aku tahu kau bakal tiba di sini sekarang."
      Speaker = "Prometheus"
      Event = "PrometheusLostAgainstHim02"
    }
    {
      Id = "MelinoeField_2722"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh? Lalu bagaimana akhir dari pertarungan kita {#Emph}kali ini{#Prev}, karena kau tahu segalanya? Sama persis seperti yang kemarin?"
      Speaker = "Melinoe"
      Event = "PrometheusLostAgainstHim02"
    }
    {
      Id = "Prometheus_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau tahu, hasilnya pasti bakal jauh berbeda dari apa yang sebentar lagi terjadi. Tapi kurasa setidaknya aku bisa memberimu sedikit petunjuk..."
      Speaker = "Prometheus"
      Event = "PrometheusLostAgainstHim02"
    }
    {
      Id = "MelinoeField_3551"
      InheritFrom = "BaseNarrative"
      DisplayName = "Heracles! Sedang apa kau, bersekongkol dengan musuh kita?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight01"
    }
    {
      Id = "Heracles_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh {#Emph}kita? {#Prev}{#Emph}Heh. {#Prev}Tebakanmu tepat lagi, Prometheus. Lalu bagaimana sekarang? Dia akhirnya memergoki kita basah-basahan."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight01"
    }
    {
      Id = "Prometheus_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita bertarung, Sobat Besar; setidaknya perlambat dia. Dia tak boleh membocorkan ke siapa pun bahwa kau ada di sini. Dampak buruknya bagi keluarganya bakal terlalu dahsyat jika dia sampai mengatakannya."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight01"
    }
    {
      Id = "MelinoeField_3552"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kalian {#Emph}berdua {#Prev}pengkhianat. Dan kalian berharap aku tidak melapor ke Tuan Zeus dan yang lainnya? Heracles, dia itu {#Emph}ayahmu! {#Prev}Bisa-bisanya kau berbalik melawannya?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight01"
    }
    {
      Id = "Heracles_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukankah kita semua begitu? Lagipula, sang Titan Peramal di sini sudah tahu aku bakal melakukannya, dan siapa aku sampai berani mendebat takdir? Sekarang biarkan aku dan gadaku ini memastikan kau melupakan apa yang baru saja kau lihat."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight01"
    }
    {
      Id = "Heracles_0214_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Titan Peramal di sini sudah tahu aku bakal melakukannya, dan siapa aku sampai berani mendebat takdir? Sekarang biarkan aku dan gadaku ini memastikan kau melupakan apa yang baru saja kau lihat."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight01"
    }
    {
      Id = "MelinoeField_3999"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heracles! {#Prev}Sedang apa kau, bersekongkol dengan {#Emph}dia? {#Prev}Tugasmu seharusnya menjaga gunung ini seperti sebelumnya!"
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight01_B"
    }
    {
      Id = "Heracles_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bersekongkol! Heh. {#Prev}Tebakanmu tepat lagi, Prometheus. Lalu bagaimana sekarang? Dia akhirnya memergoki kita basah-basahan."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight01_B"
    }
    {
      Id = "Prometheus_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita bertarung, Sobat Besar; setidaknya perlambat dia. Dia tak boleh membocorkan ke siapa pun bahwa kau ada di sini. Keluarganya sama sekali belum siap menerima kenyataan ini, setidaknya tidak sekarang, ataupun dalam waktu dekat."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight01_B"
    }
    {
      Id = "MelinoeField_4000"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entahlah, ini kedengarannya sangat mirip pengkhianatan. Dan kalian berharap aku tidak melapor ke Tuan Zeus dan yang lainnya? Heracles, dia itu {#Emph}ayahmu! {#Prev}Dari sekian banyak dewa, kau bahkan tega berbalik melawan {#Emph}dia?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight01_B"
    }
    {
      Id = "Prometheus_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pembawa Perubahan! Tentu saja aku sudah meramalkan kekalahanku sendiri. Mengenai apakah kau sanggup menghentikan Heracles {#Emph}dan {#Prev}aku sekaligus, kau akan menyadari bahwa jalan menuju hasil itu jauh lebih sedikit."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight02"
    }
    {
      Id = "Heracles_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perlukah kau membeberkan hal-hal seperti itu pada penyihir ini, Pencuri Api? Biarkan dia merasakannya sendiri dengan cara yang menyakitkan."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight02"
    }
    {
      Id = "Prometheus_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah tahu kau bakal bicara begitu, Kawan. Dan tentu saja kau benar; kita di sini bukan untuk berbincang-bincang santai. {#Emph}Begitu pula dia."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight02"
    }
    {
      Id = "Prometheus_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika memang ada sisi buruk dari memiliki kekuatan dahsyat Heracles di pihak kita, itu pasti rasa terlalu percaya diri. Bagaimana mungkin kita bisa kalah, begitulah teoriku. Yah... ternyata ada banyak caranya."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight03"
    }
    {
      Id = "Heracles_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya kau beri tahu aku cara-cara itu sebelumnya, Pencuri Api. Karena aku tidak terbiasa kalah. Untung saja tidak ada yang menonton kita berkat kepulan asap dan abu tebal ini..."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight03"
    }
    {
      Id = "MelinoeField_3750"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kalian berdua ingin meneruskan obrolan manis ini, aku sama sekali tak berniat menyela. Tapi kurasa kalian tetap akan memaksaku bertarung."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight03"
    }
    {
      Id = "Prometheus_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pada akhirnya memang itulah tujuan kita ada di sini, jadi {#Emph}ya. {#Prev}Ke mana pun kau melangkah, Perubahan akan selalu mengekor. Dan Perubahan takkan pernah hadir tanpa pertikaian."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight03"
    }
    {
      Id = "MelinoeField_3751"
      InheritFrom = "BaseNarrative"
      DisplayName = "Heracles! Apa pembelaanmu atas semua ini? Apakah {#Emph}kau {#Prev}yang membebaskan Prometheus dari belenggunya?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight04"
    }
    {
      Id = "Heracles_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau takkan dapat jawaban apa pun dariku, Saudari; cuma sakit kepala yang membelah tempurung. Lebih baik kau tuntut kebenaran dari Titan di sampingku ini, dia dengan senang hati mau bicara."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight04"
    }
    {
      Id = "Prometheus_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebenaran hanya menjadi kebenaran jika dipercayai. Dan apa pun yang kuberi tahu pada lawan kita ini, dia takkan memercayaiku; setidaknya tidak sepenuhnya... jadi memberi sakit kepala yang membelah tempurung memang pilihan yang lebih baik untuk saat ini."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight04"
    }
    {
      Id = "MelinoeField_3752"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada tanda-tanda kehadiran teman besarmu. Tampaknya kau harus menghadapiku seorang diri, berhubung aku mengabaikan {#Emph}burungmu {#Prev}itu."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight05"
    }
    {
      Id = "Prometheus_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Teman besarku{#Prev}, sebagaimana kau menjulukinya, tunduk pada kekuatan yang lebih tinggi, dan aku tahu kau pun paham kekuatan apa itu. Jika kau ingin menghadapi kami berdua lagi... kau tahu persis caranya."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight05"
    }
    {
      Id = "MelinoeField_3928"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kenapa juga aku mau melewati cobaan {#Emph}itu {#Prev}lagi? Melawanmu sendirian saja sudah cukup merepotkan, apalagi harus menghindari gada yang ukurannya dua kali lipat tubuhku."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight05"
    }
    {
      Id = "Prometheus_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu ingin menyenangkan orang lain! Melakukan apa pun yang ditugaskan kepadamu. Itulah alasan kau berada di sini. Dan itulah alasan Heracles akan berada di sini lagi tak lama dari sekarang."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight05"
    }
    {
      Id = "MelinoeField_3929"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aetos memilikimu seutuhnya lagi! Konon Heracles pernah membantai sekawanan penuh burung buas nan rakus... pasti burungmu sekarang merasa agak waswas."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight05_2"
    }
    {
      Id = "Prometheus_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa cemas palsumu itu tak ada artinya bagiku. Kalian para dewa punya satu tujuan bersama, hanya untuk menegakkan kembali dominasi kalian. Kami pun punya tujuan bersama! Tapi tujuan kami sangatlah berbeda dari kalian."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight05_2"
    }
    {
      Id = "Prometheus_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lihat kan, Sobat Besar? Dia tidak membiarkanmu menunggu terlalu lama. Meski aku tahu betapa kau membenci tugas-tugasmu didekte oleh para dewa atau dewi."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight06"
    }
    {
      Id = "Heracles_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mulai semakin terbiasa dengan hal itu. Membuatku tak perlu pusing mengambil keputusan sulit; aku cukup mengambil keputusan mudah, seperti tulang mana yang harus kupatahkan terlebih dahulu."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight06"
    }
    {
      Id = "Prometheus_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku menanti-nanti untuk melihat apa yang kau pilih; meski tentu saja, aku sudah mengetahuinya..."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight06"
    }
    {
      Id = "MelinoeField_3753"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada beberapa hal yang perlu kita bicarakan, Prometheus! Jadi bagaimana kalau kau suruh teman besarmu itu menyingkir dulu? Rasanya sangat tidak sopan kalau dia menguping pembicaraan pribadi kita."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight07"
    }
    {
      Id = "Prometheus_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau takkan memercayai ini untuk beberapa saat, Pembawa Perubahan, tapi Heracles {#Emph}bisa {#Prev}dipercaya... tentu saja bukan dalam situasimu sekarang, tapi tetap saja."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight07"
    }
    {
      Id = "Heracles_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku nyaris tak peduli dengan ocehanmu, Saudari. Kau ingin aku menyingkir, paksa saja kalau bisa. Sekarang di sini, atau lewat cara apa pun yang kau pakai sampai membuatku muncul."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight07"
    }
    {
      Id = "MelinoeField_3754"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, karena kalian berdua sudah ada di sini, aku cuma ingin kalian tahu satu hal: Tak satu pun dari kalian yang sekuat kelihatannya."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight07"
    }
    {
      Id = "Prometheus_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau meremehkan gabungan kekuatan kami, meski anggapanmu itu takkan bertahan lama. Mari kita buktikan padanya, Heracles!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight07"
    }
    {
      Id = "Prometheus_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh aku bicara, Herakles? Tak ada gunanya berbasa-basi dengannya begini. Kita bisa langsung menyerang tanpa aba-aba."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight08"
    }
    {
      Id = "Heracles_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berbasa-basi di sini cuma gara-gara {#Emph}kau{#Prev}. Tak perlu menceramahiku soal untungnya menyerang tanpa aba-aba."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight08"
    }
    {
      Id = "Prometheus_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu sudah beres! Kita sepakat untuk membuatnya terus menebak-nebak. Meski pada akhirnya kita bakal balik ke kebiasaan lama, dengan aku yang lebih banyak bicara mulai sekarang."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight08"
    }
    {
      Id = "MelinoeField_3755"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kau{#Prev}, Herakles! Saat kita bertemu di tempat lain seolah tak terjadi apa-apa, tapi kau malah melawanku di sini? Kukira kau kesatria agung, rupanya cuma jago sandiwara!"
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFight09"
    }
    {
      Id = "Heracles_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita semua cuma bersandiwara di sepanjang hidup yang terkutuk ini, Saudari. Dan jangan berani-berani menyapaku lagi di sini; ini pertarungan si Pencuri Api. Di sini aku cuma pemeran pendukung."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFight09"
    }
    {
      Id = "Prometheus_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan bukankah ini panggung yang pantas bagi kita untuk pentas di hadapan para dewa? Termasuk siapa pun dewa-dewi kegelapan yang kau panggil itu, yang memaksa Herakles yang penurut ini mematuhi panggilan mereka. Mari kita beri apa yang mereka inginkan!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFight09"
    }
    {
      Id = "Heracles_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau aku yang memimpin sebentar di sini, Pencuri Api? Kadang-kadang bicaramu itu suka keterlaluan banyaknya."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles01"
    }
    {
      Id = "Prometheus_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingin rasanya kubilang kukira kau takkan pernah meminta, sobat besar, tapi kita berdua tahu kebenarannya. Aku tak melihat kalian berdua bakal bicara lama-lama."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAltFightHeracles01"
    }
    {
      Id = "Heracles_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah begitu lama sejak terakhir kali aku kalah bertarung, sampai-sampai aku lupa rasanya. Rasa malu... amarah... darah yang mendidih di dalam nadiku."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles02"
    }
    {
      Id = "MelinoeField_3756"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan mungkin tak membuatmu merasa lebih baik mengetahui Prometheus di sana yakin sekali kalau kau bakal kalah."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFightHeracles02"
    }
    {
      Id = "Heracles_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak. Tapi ada hal lain yang juga terjadi: Aku mendapati diriku rindu bertarung lagi. Meremukkan musuh-musuhku berkeping-keping. Aku masih bisa menahan sisi terburuknya, tapi kukira semuanya sudah hilang..."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles02"
    }
    {
      Id = "MelinoeField_3757"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat pertama kali kita bertemu, kau bilang kau bekerja sendiri, Tuan Herakles. Tapi di sinilah kau bekerja sama dengan Titan ini, bahkan kurasa dengan Elang itu juga. Jadi, satu lagi kebohonganmu, ya?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFightHeracles03"
    }
    {
      Id = "Heracles_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa bilang aku sedang bekerja, Saudari? Asal kau tahu, ini caraku bersenang-senang. Pekerjaan dan minatku memang kebetulan sejalan."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles03"
    }
    {
      Id = "MelinoeField_3758"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ingin aku percaya kau ada di sini karena kemauanmu sendiri, dan bukan karena kehendak Malam yang menuntutnya? Aku tahu kehadiranmu di sini bukan cuma kebetulan belaka."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFightHeracles03"
    }
    {
      Id = "Heracles_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Percayalah {#Prev}apa pun sesukamur. Sekarang, {#Emph}aku {#Prev}percaya sudah waktunya menghunjamkan gada ini ke tengkorakmu; bukan demi urusan kerjaan, tapi demi {#Emph}kesenangan{#Prev}."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles03"
    }
    {
      Id = "Heracles_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di luar sana gelap, Saudari. Tapi kau selalu bisa menemukan jalanmu, mengendap-endap seperti {#Emph}kucing{#Prev}. Tahu apa yang kulakukan pada kucing?"
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles04"
    }
    {
      Id = "MelinoeField_3759"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rupanya kau mengubah mereka jadi jubah bulu yang modis! Yah, kau takkan bisa melakukan itu {#Emph}padaku{#Prev}. Lagipula bagaimana caranya? Aku terlalu kecil."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFightHeracles04"
    }
    {
      Id = "Heracles_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlalu {#Emph}cerdik{#Prev}. Bagaimana kalau kau terus saja mengoceh, sementara gadaku ini yang bicara mewakiliku{#Prev}?"
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles04"
    }
    {
      Id = "Heracles_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang kau lakukan sampai membuatku muncul, malam ini usahamu pasti luar biasa keras, Saudari. Monster-monster di luar sana ramai sekali..."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles05"
    }
    {
      Id = "MelinoeField_3760"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah itu nada ketakutan dalam suara Herakles yang perkasa? Padahal harusnya aku yang takut, karena harus menghadapi dirimu dan Prometheus sekaligus begini. Dia tahu pertarungan ini bakal berakhir {#Emph}mengerikan{#Prev}."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFightHeracles05"
    }
    {
      Id = "Heracles_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memangnya pernah tidak berakhir begitu? Tapi ini belum ada apa-apanya. Kalau mau tahu rasa takut yang sesungguhnya, cobalah berlatih di bawah bimbingan Kentaur Chiron barang sebentar..."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles05"
    }
    {
      Id = "Heracles_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku tak pernah kalah. Rasanya mungkin mirip seperti si Pencuri Api ini, tahu hasil dari setiap pertempuran. Sekarang tidak lagi..."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles06"
    }
    {
      Id = "MelinoeField_3761"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pastinya sedikit kejutan yang tak terduga ini membantu membuat segalanya jadi lebih hidup dan menghibur bagimu sekarang."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAltFightHeracles06"
    }
    {
      Id = "Heracles_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak. Dulu aku tak pernah kalah, tapi aku juga tak pernah suka kejutan. Jadi, secara keseluruhan, akhir-akhir ini karierku berjalan kurang mulus..."
      Speaker = "Heracles"
      Event = "PrometheusAboutAltFightHeracles06"
    }
    {
      Id = "Prometheus_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu lukamu bakal separah ini, meski mungkin kau sendiri tak menyadarinya. Tentu saja tak ada yang tak bisa disembuhkan oleh sedikit {#Emph}waktu{#Prev}."
      Speaker = "Prometheus"
      Event = "PrometheusLowHealth01"
    }
    {
      Id = "MelinoeField_2733"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas perhatianmu, tapi sebaiknya urus lukamu {#Emph}sendiri{#Prev}. Perban-perban itu... kau sedang tidak dalam kondisi prima. Walau mungkin ini artinya pertarungan kita bakal lebih adil."
      Speaker = "Melinoe"
      Event = "PrometheusLowHealth01"
    }
    {
      Id = "Prometheus_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luka-lukaku ini sudah lama tak lagi menjadi penghalang bagiku. Aku sengaja membiarkannya tak sembuh total, agar aku selalu ingat apa yang sedang kuperjuangkan. Dan Aetos di sini juga menyukainya."
      Speaker = "Prometheus"
      Event = "PrometheusLowHealth01"
    }
    {
      Id = "Prometheus_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasukanku hampir menghentikanmu tapi mereka belum cukup berhasil. Namun bahkan sekarang pun kau kalah jumlah melawan Aetos dan diriku."
      Speaker = "Prometheus"
      Event = "PrometheusLowHealth02"
    }
    {
      Id = "MelinoeField_2883"
      InheritFrom = "BaseNarrative"
      DisplayName = "Peluang untuk membalaskan dendam pada Elang pembuat masalahmu itu, atau bahkan dirimu sendiri, membantuku untuk terus maju. Bisa kita mulai?"
      Speaker = "Melinoe"
      Event = "PrometheusLowHealth02"
    }
    {
      Id = "Prometheus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya. Aku tak boleh membuatmu menunggu. Karena aku tahu siapa yang bakal membalaskan dendamnya di sini, dan aku tak sabar melihat {#Emph}kau {#Prev}mengetahuinya sendiri."
      Speaker = "Prometheus"
      Event = "PrometheusLowHealth02"
    }
    {
      Id = "Prometheus_0128_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasukanku hampir menghentikanmu tapi mereka belum cukup berhasil. Sekarang giliran kau melawan Aetos dan diriku."
      Speaker = "Prometheus"
      Event = "PrometheusLowHealth02_B"
    }
    {
      Id = "Prometheus_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau berharap melampauiku dalam kondisi semenyedihkan itu? Mungkin jika aku dirantai dan hatiku digerogoti separuh, pertarungan ini bakal jadi lebih seimbang."
      Speaker = "Prometheus"
      Event = "PrometheusLowHealth03"
    }
    {
      Id = "MelinoeField_2884"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak merasa kau mencari kompetisi olahraga yang adil di sini, Prometheus. Sekarang mari kita tuntaskan ini."
      Speaker = "Melinoe"
      Event = "PrometheusLowHealth03"
    }
    {
      Id = "Prometheus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kompetisi olahraga! Pasti ada sensasi tersendiri saat tak mengetahui hasil pertempuran sebelum terjadi. Bahkan untuk hasil yang sudah sejelas ini."
      Speaker = "Prometheus"
      Event = "PrometheusLowHealth03"
    }
    {
      Id = "Prometheus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cepat sekali kau tiba malam ini! Menentang hukum alam demi mencapai tujuanmu... menjalin persekutuan dengan makhluk-makhluk yang sama sekali tak peduli padamu."
      Speaker = "Prometheus"
      Event = "PrometheusPackagedBounties01"
    }
    {
      Id = "MelinoeField_2890"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang mengambil jalan pintas, tapi tuduhanmu selebihnya itu salah besar. Aku kenal sosok yang kau maksud, dan mereka sama sekali tak seperti dugaanmu."
      Speaker = "Melinoe"
      Event = "PrometheusPackagedBounties01"
    }
    {
      Id = "Prometheus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitukah...? Bukankah {#Emph}Chaos {#Prev}yang membawamu begitu dekat dengan tujuanmu, namun takkan membiarkanmu melangkah lebih jauh... bahkan jika kau menang di sini sekalipun? Aku tahu ke mana ujung semua ini; mari kita tuntaskan!"
      Speaker = "Prometheus"
      Event = "PrometheusPackagedBounties01"
    }
    {
      Id = "Prometheus_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekacauan macam apa yang ditimbulkan oleh kehendak Chaos, hingga eksistensi kita berujung di titik ini, saling bermusuhan tanpa henti?"
      Speaker = "Prometheus"
      Event = "PrometheusAboutRandomBounty01"
    }
    {
      Id = "MelinoeField_3979"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bebas menyerah kapan saja, Titan. Aku yakin Chaos bakal menganggapnya sangat lucu kalau kau menyerah sekarang."
      Speaker = "Melinoe"
      Event = "PrometheusAboutRandomBounty01"
    }
    {
      Id = "Prometheus_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu pula dirimu, kurasa. Tapi hasil seperti itu mustahil terjadi, kau bisa pegang kata-kataku. Namun, barangkali kita masih bisa memberi sedikit hiburan bagi Chaos bagaimanapun caranya."
      Speaker = "Prometheus"
      Event = "PrometheusAboutRandomBounty01"
    }
    {
      Id = "Prometheus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian para dewa memaksa seluruh umat manusia memuja kalian, dan demi apa? Membantai mereka semau kalian tak membawa keuntungan apa pun. Biarkan mereka tenang!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutMortals01"
    }
    {
      Id = "MelinoeField_2724"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti bakal kusampaikan permintaanmu itu pada Yang Mulia Pamanku, Zeus, asalkan kau mau minggir dan membiarkanku lewat untuk menemuinya."
      Speaker = "Melinoe"
      Event = "PrometheusAboutMortals01"
    }
    {
      Id = "Prometheus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang Mulia Pamanmu merantaiku di puncak gunung selama berabad-abad, agar Aetos di sampingku ini bisa berpesta mematuk dagingku sepanjang waktu itu. Aetos pada akhirnya tersadar dan melunak, tapi Zeus...? Mustahil baginya."
      Speaker = "Prometheus"
      Event = "PrometheusAboutMortals01"
    }
    {
      Id = "MelinoeField_2725"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa kau begitu peduli pada manusia fana? Hidup mereka singkat, raga mereka rapuh. Hanya dalam kematianlah banyak dari mereka akhirnya mulai berpikir jernih."
      Speaker = "Melinoe"
      Event = "PrometheusAboutMortals02"
    }
    {
      Id = "Prometheus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap perajin ulung pasti menyayangi mahakaryanya. Manusia! Makhluk malang yang diciptakan serupa dengan dewa, namun dipaksa menjadi kaum bawahan, agar mereka tak pernah sanggup mencapai apa yang kini kurencanakan bersama tuanku."
      Speaker = "Prometheus"
      Event = "PrometheusAboutMortals02"
    }
    {
      Id = "MelinoeField_2726"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu, {#Emph}kau {#Prev}yang membentuk manusia fana? Lalu mencuri api dari gunung ini demi {#Emph}mereka? {#Prev}Konyol sekali."
      Speaker = "Melinoe"
      Event = "PrometheusAboutMortals02"
    }
    {
      Id = "Prometheus_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebenaran terkadang sulit untuk ditelan. Manusia hidup hanya untuk menderita; berhubung aku bertanggung jawab atas nasib itu, aku bertekad mengangkat sebagian penderitaan dari pundak mereka. Dan membagikannya rata kepada kalian semua."
      Speaker = "Prometheus"
      Event = "PrometheusAboutMortals02"
    }
    {
      Id = "Prometheus_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa semestinya belajar sesuatu dari manusia fana. Di balik segala kekurangan mereka, ada kegigihan mengagumkan untuk terus menggenggam harapan; kualitas luhur yang kerap kali hilang dari kita yang abadi ini."
      Speaker = "Prometheus"
      Event = "PrometheusAboutMortals03"
    }
    {
      Id = "MelinoeField_2737"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harapan cuma obat penenang bagi yang naif. Begitu banyak manusia berharap takkan pernah mati; ilusi yang lahir dari ketakutan semata."
      Speaker = "Melinoe"
      Event = "PrometheusAboutMortals03"
    }
    {
      Id = "Prometheus_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali! Manusia menjalani hidup yang singkat nan perih. Namun meski begitu, mereka tetap berjuang menggapai sesuatu yang jauh melampaui batas kemampuan mereka. Aku bertarung demi {#Emph}mereka! {#Prev}Sedangkan kalian para dewa hanya bertarung demi {#Emph}diri kalian sendiri."
      Speaker = "Prometheus"
      Event = "PrometheusAboutMortals03"
    }
    {
      Id = "MelinoeField_3972"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya manusia fana yang amat kau cintai tak membalas perasaanmu, Prometheus. Terlepas dari segala hal yang kau klaim telah kaulakukan, mereka tetap tak memujamu."
      Speaker = "Melinoe"
      Event = "PrometheusAboutWorship01"
    }
    {
      Id = "Prometheus_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan mereka takkan pernah memujaku, aku tahu betul. Paling-paling kisahku hanya dijadikan dongeng peringatan, tak lebih dari itu. Beruntung, aku tak butuh pengakuan; biarkan mereka menyimpan Nektar dan Ambrosia itu untuk {#Emph}kalian."
      Speaker = "Prometheus"
      Event = "PrometheusAboutWorship01"
    }
    {
      Id = "Prometheus_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melawanlah semaumu, namun era para dewa pasti berakhir! {#Emph}Sang Waktu {#Prev}yang akan memastikannya. Dan setelah itu, Zaman Keemasan pencerahan bakal terbit, di mana pengaruh kalian para dewa takkan lagi berkuasa."
      Speaker = "Prometheus"
      Event = "PrometheusAboutGoldenAge01"
    }
    {
      Id = "MelinoeField_2735"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika entah bagaimana aku sempat membuatmu mengira aku tertarik dengan ocehan kiamat dan ramalan palsumu itu, kutegaskan, aku sama sekali tak peduli."
      Speaker = "Melinoe"
      Event = "PrometheusAboutGoldenAge01"
    }
    {
      Id = "Prometheus_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sikap acuhmu itulah alasan mutlak mengapa kalian tak lagi pantas berkuasa. Aku tahu kalian takkan sudi melepaskan gunung ini; kalau begitu, runtuhlah bersamanya!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutGoldenAge01"
    }
    {
      Id = "Prometheus_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rencana tuanku tentu saja butuh waktu. Tujuanku di sini bukan untuk menghentikanmu selamanya, melainkan hanya memperlambat langkahmu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutPlans01"
    }
    {
      Id = "MelinoeField_2723"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kecuali jika kau memang hobi membocorkan informasi penting kepada musuhmu, aku berasumsi kau melontarkan omong kosong ini cuma untuk mengecohku. Bagaimanapun juga, tujuanku tetap tak berubah."
      Speaker = "Melinoe"
      Event = "PrometheusAboutPlans01"
    }
    {
      Id = "Prometheus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, kepala batu memang salah satu watak bawaan keluargamu. Kalau begitu, mari kita jalankan rencana masing-masing; ada kemungkinan rencanaku di sini bakal sukses luar biasa."
      Speaker = "Prometheus"
      Event = "PrometheusAboutPlans01"
    }
    {
      Id = "MelinoeField_2728"
      InheritFrom = "BaseNarrative"
      DisplayName = "Buat apa repot-repot mengajakku bicara setiap malam, Titan? Kalau kau sudah tahu apa yang bakal kuucapkan. Betapa menjemukannya hidupmu itu."
      Speaker = "Melinoe"
      Event = "PrometheusAboutForesight01"
    }
    {
      Id = "Prometheus_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu jauh lebih buruk dari ini! Namun soal ucapanmu tadi, aku takkan sudi mengutuk siapa pun dengan kutukan penglihatan masa depan... kecuali mungkin untuk musuh terburukku. Dan kau belum sampai ke tahap itu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutForesight01"
    }
    {
      Id = "MelinoeField_2729"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, ya? Berarti aku harus berusaha lebih keras lagi demi meraih predikat itu. Dan kalau aku sudah bertekad, aku biasanya selalu berhasil."
      Speaker = "Melinoe"
      Event = "PrometheusAboutForesight01"
    }
    {
      Id = "Prometheus_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham betul. Namun aku juga tahu bahwa kesombongan, salah satu ciri khas kaummu, biasanya mengawali kejatuhan. Kelak kau bakal melihat sendiri ke mana rasa percaya dirimu itu membawamu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutForesight01"
    }
    {
      Id = "Prometheus_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak hal yang ingin kautanyakan padaku... Aku takkan menjawabnya, belum saatnya. Pertama-tama, kata-kata itu harus meluncur dulu dari bibirmu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutForesight02"
    }
    {
      Id = "MelinoeField_2730"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau aku hemat suaraku saja? Kau takkan tahu apa yang akan kuucapkan kalau aku tak pernah mengatakannya."
      Speaker = "Melinoe"
      Event = "PrometheusAboutForesight02"
    }
    {
      Id = "Prometheus_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun hatimu—meski mata dan telingamu membantah—mengatakan bahwa aku bukanlah pembohong seperti dugaan pikiranmu. Kendati demikian, kita tetap berdiri berseberangan."
      Speaker = "Prometheus"
      Event = "PrometheusAboutForesight02"
    }
    {
      Id = "Prometheus_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertanyaan yang hendak kau lontarkan itu cuma ejekan basa-basi untuk mengalihkan topik penting yang tengah mengusik benakmu. Ayo, bicaralah! Aku tak bisa menanggapi jika kau terus menahan diri."
      Speaker = "Prometheus"
      Event = "PrometheusAboutForesight03"
    }
    {
      Id = "MelinoeField_2738"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak. Kau tak punya kuasa atas diriku ataupun masa depanku. Dan jangan khawatir, aku {#Emph}takkan {#Prev}pernah menahan diri."
      Speaker = "Melinoe"
      Event = "PrometheusAboutForesight03"
    }
    {
      Id = "Prometheus_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga kau bakal bereaksi seperti ini, tapi tak ada cara lain untuk membuka topik tersebut. Betapa seringnya aku justru menciptakan takdir yang berusaha kukuasai dan kucegah..."
      Speaker = "Prometheus"
      Event = "PrometheusAboutForesight03"
    }
    {
      Id = "MelinoeField_2739"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jawab satu pertanyaanku ini, Titan. Jika kau tahu segala hal yang bakal terjadi di masa depan, mengapa kau mengambil pilihan yang berujung pada siksaan mengerikan itu? Mengapa membiarkan dirimu tertangkap?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutForesight04"
    }
    {
      Id = "Prometheus_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihan kita bisa bergema menembus waktu, melahirkan takdir dengan konsekuensi yang jauh lebih besar. Jika bukan karena kurungan itu, aku takkan berdiri di sini saat ini; di tempat yang semestinya kutempati."
      Speaker = "Prometheus"
      Event = "PrometheusAboutForesight04"
    }
    {
      Id = "MelinoeField_2740"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menderita sedemikian rupa hanya agar bisa kupukuli lagi malam ini? Kau cuma penipu... mengarang omong kosong yang tak bisa dibuktikan demi terdengar benar dan bijak."
      Speaker = "Melinoe"
      Event = "PrometheusAboutForesight04"
    }
    {
      Id = "Prometheus_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari sekian banyak dewa, kau semestinya paham sedikit tentang pengorbanan... tapi untuk sekarang, setidaknya, itu tak penting. Tak ada yang perlu kubuktikan padamu, tak ada rahasia yang sudi kubagi; hanya amarahku."
      Speaker = "Prometheus"
      Event = "PrometheusAboutForesight04"
    }
    {
      Id = "MelinoeField_2880"
      InheritFrom = "BaseNarrative"
      DisplayName = "Antara kau berbohong soal penglihatan masa depanmu itu, atau kau sengaja mengalah. Siapa sih yang tidak mau dihajar habis-habisan oleh seorang penyihir sesekali?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutForesight05"
    }
    {
      Id = "Prometheus_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perbedaan antara kau dan aku adalah kau cuma bisa menduga dan berteori, sementara aku tahu pasti. Namun, ada kebenaran-kebenaran yang tak bisa kubagi kepadamu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutForesight05"
    }
    {
      Id = "MelinoeField_2881"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak apa-apa, aku juga tak mengira kau akan membaginya. Aku bisa mengubah masa depan dengan tindakanku sendiri, peduli amat aku tahu masa depan itu atau tidak."
      Speaker = "Melinoe"
      Event = "PrometheusAboutForesight05"
    }
    {
      Id = "Prometheus_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengarkan nasihatku, Agen Perubahan: Semakin banyak yang kau tahu soal masa depan, semakin kecil kemungkinanmu membentuknya sesuai kehendakmu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutForesight05"
    }
    {
      Id = "Prometheus_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu apa yang hendak kau ucapkan, Agen Perubahan, dan aku memperingatkanmu: {#Emph}Jangan katakan. {#Prev}Jika sampai kau ucapkan pikiranmu itu, akibatnya takkan menguntungkan bagi kita berdua."
      Speaker = "Prometheus"
      Event = "PrometheusAboutFuture01"
    }
    {
      Id = "MelinoeField_2727"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah... demi berjaga-jaga. Tapi maafkan aku jika sedikit ragu bahwa kita baru saja mengubah jalannya sejarah cuma dengan cara begini."
      Speaker = "Melinoe"
      Event = "PrometheusAboutFuture01"
    }
    {
      Id = "Prometheus_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau masih belum paham. Kita ini ibarat tanah liat, semuanya tanpa terkecuali. Bisa dibentuk dan dibentuk ulang. Satu bencana petaka berhasil kita hindari; tapi tak ada cara mencegah petaka berikutnya."
      Speaker = "Prometheus"
      Event = "PrometheusAboutFuture01"
    }
    {
      Id = "Prometheus_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau yang mencapku sebagai penjahat: Apa kau sudi tahu {#Emph}kenapa {#Prev}kubebaskan api dari gunung ini demi umat fana?"
      Speaker = "Prometheus"
      Event = "PrometheusAboutFire01"
    }
    {
      Id = "MelinoeField_2882"
      InheritFrom = "BaseNarrative"
      DisplayName = "Firasat masa depanku yang makin tajam mengisyaratkan bahwa kau bakal tetap menceritakannya, peduli amat aku mau dengar atau tidak."
      Speaker = "Melinoe"
      Event = "PrometheusAboutFire01"
    }
    {
      Id = "Prometheus_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kuberi kaum fana santapan... daging yang semestinya mereka korbankan untuk kalian... mereka butuh api saat itu, bahkan lebih. Tapi {#Emph}kalian menimbun semuanya sendiri! {#Prev}Maka kuselamatkan mereka; dan aku takkan ragu melakukannya lagi."
      Speaker = "Prometheus"
      Event = "PrometheusAboutFire01"
    }
    {
      Id = "Prometheus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah... {#Prev}jadi malam ini api pinjamanku akan beradu dengan apimu sendiri. Ini bisa jadi tontonan yang cukup menghibur seandainya aku belum tahu bagaimana akhir pertarungan ini..."
      Speaker = "Prometheus"
      Event = "PrometheusAboutTorch01"
    }
    {
      Id = "MelinoeField_2891"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ke sini bukan untuk menghiburmu, Titan. Api curianmu itu tak membuatmu kebal."
      Speaker = "Melinoe"
      Event = "PrometheusAboutTorch01"
    }
    {
      Id = "Prometheus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja tidak. Dan kurasa Ygnium—karena aku tahu betul senjata-senjata yang kau bawa—bakal terasa cukup menyengat. Tapi aku pernah merasakan yang jauh lebih pedih."
      Speaker = "Prometheus"
      Event = "PrometheusAboutTorch01"
    }
    {
      Id = "MelinoeField_2886"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan padaku, Titan: Apa kau ingat seorang wanita fana bernama Dora? Arwahnya bereaksi aneh saat kusebut namamu, tapi dia tak bisa mengingat apa yang telah kau perbuat."
      Speaker = "Melinoe"
      Event = "PrometheusAboutDora01"
    }
    {
      Id = "Prometheus_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih baik biarkan saja, Agen Perubahan. Ingatan terpendam Arwah tua itu lebih banyak urusannya dengan para dewa dan tipu daya mereka, bukan karena apa pun yang kulakukan."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDora01"
    }
    {
      Id = "MelinoeField_2887"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jelaskan! Beritahu aku apa yang terjadi padanya. Kau terus-terusan menyalahkan segalanya pada para dewa, seolah semua ini murni tanggung jawab mereka."
      Speaker = "Melinoe"
      Event = "PrometheusAboutDora01"
    }
    {
      Id = "Prometheus_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, sebaliknya, aku memikul tanggung jawab atas umat fana. Namun untuk segala kegagalan, kebobrokan, dan kehancuran mereka, aku tak patut disalahkan. Begitu pula {#Emph}Dora. {#Prev}Sampaikan padanya aku berkata begitu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDora01"
    }
    {
      Id = "Prometheus_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Temanmu, Dora... dia belum mengingatku, belum untuk saat ini. Tapi kelak dia akan ingat! Dan saat itu tiba, dia akan ingat kenapa dulu dia memilih melupakanku... dan melupakan begitu banyak hal lainnya."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDora02"
    }
    {
      Id = "MelinoeField_2888"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bilang dia tak patut disalahkan atas kegagalan umat fana, seolah sejak awal dia mampu menanggung beban seberat itu. Apa yang sebenarnya terjadi? Bagaimana kau bisa mengenalnya?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutDora02"
    }
    {
      Id = "Prometheus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sosok itu dihantui oleh masa lalunya, seperti yang bisa kau lihat sendiri. Tapi, bukan hakku menceritakan lebih dari yang sudah kukatakan, jangan sampai dia mengingat terlalu banyak dalam waktu terlalu cepat. {#Emph}Semua akan tiba pada waktunya{#Prev}, begitu kata tuanku."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDora02"
    }
    {
      Id = "MelinoeField_3951"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}benar-benar {#Prev}mengenal Dora, kan? Dia dan salah satu saudaramu... mereka {#Emph}menikah? {#Prev}Dan entah bagaimana itu berujung pada dirinya yang melepaskan segala jenis siluman ke dunia fana?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutDora03"
    }
    {
      Id = "Prometheus_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurang lebih begitulah salah satu versinya... jadi dia akhirnya ingat? Barangkali dengan penyesalan mendalam. Setelah sekian lama, kaum fana masih tak bisa menentukan apakah harus menyalahkan diri sendiri atau para dewa atas kemalangan mereka..."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDora03"
    }
    {
      Id = "MelinoeField_3952"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, jadi mereka cuma boleh menyalahkan {#Emph}dewa? {#Prev}Lepas tangan atas keadaan mereka yang menyedihkan itu? Dora saja takkan bersikap begitu, padahal dia salah satu makhluk paling santai tak acuh yang kukenal. Dalam arti yang luar biasa!"
      Speaker = "Melinoe"
      Event = "PrometheusAboutDora03"
    }
    {
      Id = "Prometheus_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Temanmu Dora mengingat sebagian peristiwanya, tapi bukan berarti dia {#Emph}memahami {#Prev}semua itu. Tindakannya telah mengadu domba umat fana melawan diri mereka sendiri untuk selamanya!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutDora03"
    }
    {
      Id = "MelinoeField_3953"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu apa yang terjadi pada suami Dora? Saudaramu itu, sejauh yang dia ingat. Dia mencampakkannya setelah petaka itu terjadi?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutDora04"
    }
    {
      Id = "Prometheus_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih tepatnya, temanmu Dora akhirnya menyadari watak asli saudaraku yang pelupa dan ceroboh itu. Pernikahan mereka bertahan sama singkatnya seperti kebanyakan pernikahan lainnya."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDora04"
    }
    {
      Id = "MelinoeField_3954"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sementara kau cuma berpangku tangan tanpa berbuat apa-apa; tapi sekarang merasa bersalah lalu memutuskan memikul misi mulia ini? Mungkin demi mendapat sedikit pengampunan yang tak pernah kaudapatkan darinya."
      Speaker = "Melinoe"
      Event = "PrometheusAboutDora04"
    }
    {
      Id = "Prometheus_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata-katamu tajam, tapi sebagian besar ada benarnya. Dora kini ingat apa yang telah diperbuat keluargamu padanya. Jika dia sanggup memaafkan kalian semua atas hal itu... berarti jiwanya jauh lebih tangguh daripada aku."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDora04"
    }
    {
      Id = "Prometheus_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihatlah kita, Agen Perubahan! Siluman-siluman yang tak sengaja dilepaskan temanmu Dora... {#Emph}segala malapetaka {#Prev}yang bisa menimpa umat fana... hampir semuanya kini merundung para dewa juga."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDora05"
    }
    {
      Id = "MelinoeField_3955"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hidup memang penuh rintangan. Aku sudah sangat akrab dengan banyak siluman ini, dan mereka memang merepotkan; tapi kekuatan mereka ada batasnya, dan mereka bisa dipukul mundur."
      Speaker = "Melinoe"
      Event = "PrometheusAboutDora05"
    }
    {
      Id = "Prometheus_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja... tapi kaum fana cenderung mengalami kesulitan yang jauh lebih berat daripadamu. Tidakkah kau lihat? Selama mereka menderita, kita semua pun akan ikut menderita."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDora05"
    }
    {
      Id = "MelinoeField_2731"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin Chronos yang kausebut tuan itu ingin kau gagal... agar menderita lebih dari yang sudah-sudah. Dia berniat membalas dendam pada para dewa karena telah menggulingkannya dulu. Saat kau masih jadi sekutu mereka!"
      Speaker = "Melinoe"
      Event = "PrometheusAboutChronos01"
    }
    {
      Id = "Prometheus_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak mengharapkan pengampunan tuanku, tidak pula menganggap dia setia. Persekutuan terlahir dari tujuan yang sama, mungkin juga cita-cita; sedangkan para dewa dan aku memiliki tujuan yang bertolak belakang."
      Speaker = "Prometheus"
      Event = "PrometheusAboutChronos01"
    }
    {
      Id = "MelinoeField_2732"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya karena mereka menghukummu atas kejahatan yang sadar kau lakukan? Memangnya apa lagi yang bisa mereka lakukan setelah kau menipu mereka, dan mencuri milik mereka?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutChronos01"
    }
    {
      Id = "Prometheus_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak mencuri {#Emph}apa pun! {#Prev}Api itu menyebar; membakar apa saja yang menghalangi jalannya. Para dewa berusaha mengurungnya, tapi aku membebaskannya. Sekarang, akhirnya kita semua bebas. Dan masih membara."
      Speaker = "Prometheus"
      Event = "PrometheusAboutChronos01"
    }
    {
      Id = "Prometheus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanyalah seorang Titan, dan tanpa senjata. Namun, andai kau berhasil melewatiku... Aku tahu kau sadar betul bahwa kau bukan tandingan apa yang menunggumu di sana."
      Speaker = "Prometheus"
      Event = "PrometheusAboutTyphon01"
    }
    {
      Id = "MelinoeField_2969"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin pengetahuanmu tak seluas yang kau kira. Dan sekarang kau berniat menyebutku congkak atau semacamnya, begitu?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutTyphon01"
    }
    {
      Id = "Prometheus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadinya memang mau begitu; tapi berhubung kau sudah meramalkan hasil itu, hal itu takkan terjadi. Nah, jika kau benar-benar merasa sanggup menghadapi monster mengerikan itu... mari kita lihat apa kau sanggup menghadapi {#Emph}aku."
      Speaker = "Prometheus"
      Event = "PrometheusAboutTyphon01"
    }
    {
      Id = "Prometheus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Monster Typhon takkan berhenti semudah itu, kau tahu. Dia sudah membuat keluargamu terdesak, meringkuk ketakutan di istana Paman Yang Muliamu. Tepat di mana kami menginginkan mereka berada."
      Speaker = "Prometheus"
      Event = "PrometheusAboutTyphon02"
    }
    {
      Id = "MelinoeField_2970"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengalih perhatian yang bagus yang bisa kumanfaatkan... tepat setelah kau disingkirkan dari jalanku, bersama burungmu itu."
      Speaker = "Melinoe"
      Event = "PrometheusAboutTyphon02"
    }
    {
      Id = "Prometheus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membeberkan rencanamu padaku! Sekarang kita benar-benar mulai saling mengenal. Aku hampir merasa iba dengan apa yang akan segera terjadi."
      Speaker = "Prometheus"
      Event = "PrometheusAboutTyphon02"
    }
    {
      Id = "Prometheus_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dengar itu? Typhon bahkan sedang memanjat sisi gelap gunung ini sekarang. Mengesankan sekali kau bisa menghempaskannya sebelumnya... tapi dia takkan beristirahat sampai Istana Zeus rata dengan tanah."
      Speaker = "Prometheus"
      Event = "PrometheusAboutTyphon03"
    }
    {
      Id = "MelinoeField_3781"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia akan dimusnahkan. Kau juga bersamanya jika memang harus begitu. Kalau dia benar-benar tak terhentikan, kau takkan repot-repot menghalangi jalanku mendaki. Kau hanya sedang mengulur waktu untuknya."
      Speaker = "Melinoe"
      Event = "PrometheusAboutTyphon03"
    }
    {
      Id = "Prometheus_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang benar. Rasanya aneh memikirkan bahwa waktu bisa menjadi komoditas yang terbatas, bahkan bagi makhluk abadi seperti kita. Tapi cukup basa-basinya untuk saat ini."
      Speaker = "Prometheus"
      Event = "PrometheusAboutTyphon03"
    }
    {
      Id = "Prometheus_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin butuh gabungan seluruh kerabat dewata-mu, tapi mereka mampu menahan amarah monster Typhon, terlepas dari segala kecerobohan yang kau perbuat. Namun kini kau malah bergegas kembali ke sini."
      Speaker = "Prometheus"
      Event = "PrometheusAboutTyphonL01"
    }
    {
      Id = "MelinoeField_3782"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham ini pasti rumit bagimu, sebagai seseorang yang kesetiaannya cuma tertuju pada seekor Elang, tapi aku takkan membiarkan makhluk itu menghancurkan semua yang telah dibangun keluargaku."
      Speaker = "Melinoe"
      Event = "PrometheusAboutTyphonL01"
    }
    {
      Id = "Prometheus_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya kau memilih kesetiaanmu dengan lebih bijak, bukannya membiarkannya ditentukan oleh garis keturunan semata. Kalau begitu, {#Emph}ayo maju! {#Prev}Ada puncak gunung dan keluarga yang harus kau lindungi."
      Speaker = "Prometheus"
      Event = "PrometheusAboutTyphonL01"
    }
    {
      Id = "Prometheus_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zeus Yang Agung {#Prev}tidak merantai dan menyiksaku hanya karena tuduhan kejahatan mencuri api dari gunung ini. Bukan; dia menginginkan informasi tertentu... mengenai keruntuhannya kelak."
      Speaker = "Prometheus"
      Event = "PrometheusAboutZeus01"
    }
    {
      Id = "MelinoeField_2736"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau mengancam Raja Olimpus dengan ramalan-ramalan palsu dan dia melampiaskannya padamu. Mungkin bukan momen paling membanggakan bagi Paman Yang Mulia, tapi masih bisa dimaklumi. Apa yang kau katakan padanya?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutZeus01"
    }
    {
      Id = "Prometheus_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}tidak {#Prev}mengatakan apa-apa padanya! Hanya memberitahunya bahwa masanya akan tiba. Takdir pasti yang kian mendekat setiap malam berlalu. {#Emph}Kau {#Prev}hanyalah kerikil kecil dalam rencana ini, tak lebih."
      Speaker = "Prometheus"
      Event = "PrometheusAboutZeus01"
    }
    {
      Id = "Prometheus_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari seluruh kerabatmu di gunung terkutuk ini, Dewi Athena adalah lawan yang paling berharga. Legiun tuanku pasti sangat merepotkannya, sampai-sampai dia sudi meminjamkan sebagian kekuatannya padamu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAthena01"
    }
    {
      Id = "MelinoeField_3780"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyebutnya lawan, tapi kau selalu menghindari konfrontasi langsung dengannya, cuma melempar prajurit-prajurit rendahanmu ke hadapannya. Kau tahu kau bakal kalah melawannya dalam pertarungan yang adil."
      Speaker = "Melinoe"
      Event = "PrometheusAboutAthena01"
    }
    {
      Id = "Prometheus_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang. Aku tak punya pelatihan tempurnya, juga keilahiannya. Namun terlepas dari kebijaksanaannya yang diagung-agungkan itu, dia—seperti semua kerabatmu—memiliki apa yang oleh manusia fana disebut sebagai {#Emph}titik lemah yang fatal. {#Prev}Dan aku tahu bahwa kau tahu apa itu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutAthena01"
    }
    {
      Id = "MelinoeField_2893"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa—salah satu dari mereka—mengulurkan tawaran damai, Prometheus! Yang Mulia Dionysus ingin kau menjadi tamu kehormatan di perayaan terbarunya, jika kau sudi menerimanya. Mengingat bakat penglihatan masa depanmu, kau pasti tahu aku bersungguh-sungguh."
      Speaker = "Melinoe"
      Event = "PrometheusAboutDionysus01"
    }
    {
      Id = "Prometheus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penglihatanku hanya bekerja jika ada kemungkinan suatu peristiwa terjadi. Tipu muslihat apa pun yang sedang kau rencanakan, kau harus berusaha jauh lebih keras dari {#Emph}itu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDionysus01"
    }
    {
      Id = "MelinoeField_2894"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan tuanmu itu berbeda; bisakah kau menerima kenyataan bahwa para dewa pun tidak semuanya memiliki pemikiran yang sama? Dionysus tak ingin terlibat dalam perseteruanmu!"
      Speaker = "Melinoe"
      Event = "PrometheusAboutDionysus01"
    }
    {
      Id = "Prometheus_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dionysus hanya ingin menenggelamkan sisa-sisa isi kepalanya yang rumit, dan terus memburu kenikmatan daging. Lebih mirip binatang buas ketimbang dewa, sama sekali tak punya kendali diri."
      Speaker = "Prometheus"
      Event = "PrometheusAboutDionysus01"
    }
    {
      Id = "MelinoeField_2895"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang Mulia Dionysus amat kecewa karena kau menolak undangannya ke perjamuan itu! Apa benar-benar tak ada kemungkinan di masa depan di mana kau mengubah pikiranmu?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutDionysus02"
    }
    {
      Id = "Prometheus_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tidak ada! {#Prev}Hatiku sudah dicabik-cabik selama ribuan tahun oleh Aetos yang baik di sini; aku takkan membiarkan dewa anggur itu merusaknya lebih parah lagi!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutDionysus02"
    }
    {
      Id = "Prometheus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengenali aura para dewa, tapi kau memiliki sesuatu yang lain. Sesuatu yang jauh lebih purba... tanda dari Chaos. Kekuatan tertua dan paling acuh tak acuh di segenap alam semesta, sampai terdorong untuk bertindak!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutChaos01"
    }
    {
      Id = "MelinoeField_2889"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan Chaos pun tak sudi melihat Chronos berkuasa. Lantas apa maknanya bagimu tentang keputusanmu {#Emph}sendiri {#Prev}untuk berpihak padanya?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutChaos01"
    }
    {
      Id = "Prometheus_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu menunjukkan bahwa semua makhluk bisa berbuat salah, dimulai dari Chaos sendiri. Kita {#Emph}semua {#Prev}hanyalah ketidaksengajaan yang hina, paham? Namun kita tetap berjuang menuju kesempurnaan, yang selamanya takkan pernah tergapai."
      Speaker = "Prometheus"
      Event = "PrometheusAboutChaos01"
    }
    {
      Id = "Prometheus_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bekerja sama dengan para penyihir wanita demi meraih keunggulan... tapi trik semacam itu takkan ada gunanya melawanku. Ukuran fisik lawan sama sekali tak berpengaruh."
      Speaker = "Prometheus"
      Event = "PrometheusAboutCirce01"
    }
    {
      Id = "MelinoeField_2892"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa-bisanya mengenali sihir Nyonya Circe, tapi meremehkan kedahsyatannya. Penglihatan masa depanmu jelas-jelas punya batas, Titan."
      Speaker = "Melinoe"
      Event = "PrometheusAboutCirce01"
    }
    {
      Id = "Prometheus_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang benar. Tapi mantra-mantramu pun memiliki batasannya {#Emph}sendiri. {#Prev}Akan lebih bijak jika kau tidak terlalu bergantung pada sihir-sihir itu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutCirce01"
    }
    {
      Id = "Prometheus_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa depan adalah serangkaian titik-titik takdir yang pasti. Bahkan tuanku pun tidak percaya hal ini nyata, tapi aku telah melihat banyak kemungkinan. Satu-satunya pertanyaan adalah... manakah tujuan akhir kita?"
      Speaker = "Prometheus"
      Event = "PrometheusAboutFates01"
    }
    {
      Id = "MelinoeField_2734"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terus menjejali kepalaku dengan omong kosong ini. Tiga Takdir saja tak sepenuhnya tahu apa yang tersimpan di masa depan, karena mereka masih terus menenun."
      Speaker = "Melinoe"
      Event = "PrometheusAboutFates01"
    }
    {
      Id = "Prometheus_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka {#Emph}memang {#Prev}selalu menenun, ya. Aku tahu kau sadar betul bahwa sekarang mereka tak lagi menenun. Namun detik demi detik, masa depan tetap terus bergulir. Mari kita sendiri yang membentuknya!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutFates01"
    }
    {
      Id = "Prometheus_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira di mana mereka berada sekarang, Agen Perubahan? Maksudku para Takdir Morai. Mereka yang sejak awal mengadu domba para Titan dan dewa satu sama lain, di masa lalu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutFates02"
    }
    {
      Id = "MelinoeField_3964"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di mana pun mereka berada, berdoalah mereka tak mendengarmu menjelek-jelekkan mereka. Tapi kenapa tanya padaku? Kaulah yang tahu segalanya, termasuk apakah mereka bakal ditemukan atau tidak."
      Speaker = "Melinoe"
      Event = "PrometheusAboutFates02"
    }
    {
      Id = "Prometheus_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja aku tahu. Aku hanya memicumu untuk memikirkan kemungkinan itu, beserta peranmu dalam skenario mereka; dan kurasa, dalam rencanaku juga."
      Speaker = "Prometheus"
      Event = "PrometheusAboutFates02"
    }
    {
      Id = "Prometheus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau punya saudara laki-laki yang bahkan tak pernah kau kenal. Aku punya yang sombong, yang linglung, dan yang menyedihkan karena menanggung beban dunia di pundaknya. Menurutmu, saudaramu {#Emph}itu {#Prev}paling mirip dengan siapa?"
      Speaker = "Prometheus"
      Event = "PrometheusAboutBrothers01"
    }
    {
      Id = "MelinoeField_2885"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pantas saja kau benci keluargaku; kau sendiri benci keluargamu. Bisa kita lanjut saling bunuh sekarang? Waktuku malam ini tak banyak."
      Speaker = "Melinoe"
      Event = "PrometheusAboutBrothers01"
    }
    {
      Id = "Prometheus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku dan saudara-saudaraku juga sering bertengkar. Kukira aku sudah melewati masa itu; menjadi lebih beradab. Tapi nyatanya tidak."
      Speaker = "Prometheus"
      Event = "PrometheusAboutBrothers01"
    }
    {
      Id = "Prometheus_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau punya rekan unggasmu sendiri. Gagak pucat nan kurus kering, bentang sayap pas-pasan, tak punya naluri murni untuk berburu dan membunuh seperti Aetos di sini. Namun tetap saja, burung yang setia."
      Speaker = "Prometheus"
      Event = "PrometheusAboutRavenFamiliar01"
    }
    {
      Id = "MelinoeField_3982"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan Raki tak pernah sekalipun berusaha merobek hatiku keluar. Masih banyak cara yang jauh lebih baik untuk menjalin ikatan dengan hewan, tapi kau pasti sudah paham sekarang."
      Speaker = "Melinoe"
      Event = "PrometheusAboutRavenFamiliar01"
    }
    {
      Id = "Prometheus_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku tak punya pilihan untuk bernegosiasi dengan Aetos saat pertama kali kami bertemu. Namun sekarang dia mendengarkanku, biasanya... meski saat mengintai mangsanya, dia bisa menjadi {#Emph}sangat {#Prev}terobsesi."
      Speaker = "Prometheus"
      Event = "PrometheusAboutRavenFamiliar01"
    }
    {
      Id = "Prometheus_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa artefak milik seseorang yang kukenal, aku bisa merasakannya. Dari mana kau mendapatkannya...? {#Emph}Ah{#Prev}, tak perlu dijawab; pasti sekadar tradisi saling memberi hadiah khas Olympus, tak lebih."
      Speaker = "Prometheus"
      Event = "PrometheusAboutHeraclesKeepsake01"
    }
    {
      Id = "MelinoeField_3980"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tradisi memberi hadiah? {#Prev}Maksudmu Taring Singa dari Heracles ini. Kenapa, apa kau berharap putra Zeus itu bakal memberikan piala hasil susah payahnya kepada sosok sepertimu?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutHeraclesKeepsake01"
    }
    {
      Id = "Prometheus_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa sama keras kepala dan beringasnya dengan binatang tempat gigi itu dicabut. Namun kau tetap saja tak layak memilikinya."
      Speaker = "Prometheus"
      Event = "PrometheusAboutHeraclesKeepsake01"
    }
    {
      Id = "MelinoeField_3981"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu Taring Singa dari sahabatmu, Heracles. Kenapa, apa kau berharap putra Zeus itu bakal memberikan piala hasil susah payahnya ke {#Emph}dirimu {#Prev}saja?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutHeraclesKeepsake01_B"
    }
    {
      Id = "Prometheus_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sibuk di tempat lain rupanya... di Dunia Bawah milikmu itu, tak diragukan lagi. Atau jangan-jangan kau mulai kesulitan untuk mencapai titik ini?"
      Speaker = "Prometheus"
      Event = "PrometheusAboutUnderworld01"
    }
    {
      Id = "MelinoeField_3974"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau 'kan Titan Penglihatan Masa Depan, kenapa bukan kau saja yang memberitahuku? Ini kesempatan untuk membuktikan bahwa anugerahmu ini bukan sekadar omong kosong belaka."
      Speaker = "Melinoe"
      Event = "PrometheusAboutUnderworld01"
    }
    {
      Id = "Prometheus_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah tahu kau bakal bicara begitu; agar aku bisa memanfaatkan momen {#Emph}ini {#Prev}untuk menegaskan bahwa {#Emph}meramal masa depan bukan berarti membaca pikiran."
      Speaker = "Prometheus"
      Event = "PrometheusAboutUnderworld01"
    }
    {
      Id = "Prometheus_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang berubah dari dirimu sejak terakhir kali kau ke sini. Aku tahu apa itu... dan apa yang bakal terjadi saat kau akhirnya menggunakannya, mungkin malam ini juga."
      Speaker = "Prometheus"
      Event = "PrometheusAboutUltimateProgress01"
    }
    {
      Id = "MelinoeField_3956"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti bermaksud menyebut mantra {#Emph}Disintegrasi Monster{#Prev}. Ya, aku punya hadiah khusus untuk Typhon di sini. Beruntunglah kau karena aku tak mengujinya terlebih dahulu padamu."
      Speaker = "Melinoe"
      Event = "PrometheusAboutUltimateProgress01"
    }
    {
      Id = "Prometheus_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahan ancamanmu! Aku tahu kau tak bakal menggunakan kekuatan itu terhadapku; andai para dewa dan Titan bisa saling bunuh layaknya manusia fana, sejarah kita bakal berlangsung {#Emph}jauh, jauh lebih singkat."
      Speaker = "Prometheus"
      Event = "PrometheusAboutUltimateProgress01"
    }
    {
      Id = "Prometheus_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuanku tak menyadari apa yang akan terjadi padanya begitu semua ini berakhir; kalau kau sendiri bagaimana? Sungguh keji, berusaha mencuri keabadian seseorang."
      Speaker = "Prometheus"
      Event = "PrometheusAboutUltimateProgress02"
    }
    {
      Id = "MelinoeField_3983"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lengkap sudah celotehan tak masuk akal ini. Seorang {#Emph}pencuri{#Prev}, menceramahiku soal {#Emph}mencuri! {#Prev}Chronos telah merebut keluargaku, dan lebih dari itu... dialah yang seharusnya sadar apa yang bakal menimpanya."
      Speaker = "Melinoe"
      Event = "PrometheusAboutUltimateProgress02"
    }
    {
      Id = "Prometheus_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakekmu... kau mewarisi sebagian darah purbanya, serta obsesinya terhadap keniscayaan. Kalau begitu, rebutlah apa yang kau inginkan! Namun hanya satu akhir yang menantimu jika terus meniti jalan ini."
      Speaker = "Prometheus"
      Event = "PrometheusAboutUltimateProgress02"
    }
    {
      Id = "Prometheus_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus, Agen Perubahan... monster Typhon sudah dimusnahkan dan tuanku jelas tak bertingkah seperti biasanya; atau lebih tepatnya, sekarang dia kembali menjadi {#Emph}dirinya yang dulu. {#Prev}Banyak yang bilang mereka tahu kau bisa melakukannya, tapi hanya {#Emph}aku {#Prev}yang benar-benar mengetahuinya. Namun kau dan aku sama-sama tahu bahwa urusan kita belum selesai."
      Speaker = "Prometheus"
      Event = "PrometheusPostTrueEnding01"
    }
    {
      Id = "MelinoeField_3957"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos sudah menyerah, tapi kau masih di sini, memberikan perintah pada sisa-sisa pasukannya. Mau mengambil alih kendali dengan tangan {#Emph}pencurimu {#Prev}sendiri, hah?"
      Speaker = "Melinoe"
      Event = "PrometheusPostTrueEnding01"
    }
    {
      Id = "Prometheus_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keputusan itu sudah kuambil sejak lama, saat aku menyerahkan diriku pada rantai pamanmu. Dan ya, aku masih menentangmu. Karena apa yang kau cari di balik gerbang sana, hanya bisa kau rengkuh lewat kobaran api pertempuran!"
      Speaker = "Prometheus"
      Event = "PrometheusPostTrueEnding01"
    }
    {
      Id = "MelinoeField_3958"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa dengan berat hati {#Emph}mengizinkan {#Prev}perilakumu ini, Titan? Merusak gunung mereka... penyerangan tanpa henti terhadap pertahanan mereka... dan bertarung melawanku?"
      Speaker = "Melinoe"
      Event = "PrometheusPostTrueEnding02"
    }
    {
      Id = "Prometheus_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuanku, atau mungkin {#Emph}mantan {#Prev}tuanku sebagaimana mestinya kusebut sekarang, ingin menebus sejumlah kekeliruan masa lalu, seperti yang sudah kau ketahui. Aku hanya menjalankan peran dalam rencana ini."
      Speaker = "Prometheus"
      Event = "PrometheusPostTrueEnding02"
    }
    {
      Id = "MelinoeField_3959"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau bersiap bertarung selamanya melawanku, begitu? Agar kakekku diampuni dari dosa-dosa masa lalunya, dan masa depan para dewa terjamin?"
      Speaker = "Melinoe"
      Event = "PrometheusPostTrueEnding02"
    }
    {
      Id = "Prometheus_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku siap bertarung selamanya demi apa yang kuyakini; dan agar {#Emph}waktu dapat mengalir bebas ke depan{#Prev}, jika memang itu pengorbanan yang diperlukan."
      Speaker = "Prometheus"
      Event = "PrometheusPostTrueEnding02"
    }
    {
      Id = "MelinoeField_3961"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang sudah usai, Titan! Hentikan sandiwara ini. Kau masih menyebut Chronos sebagai tuanmu, dan tampak tak lebih ramah kepada para dewa, meski kau kini melakukan ini demi mereka, bukan cuma demi dirimu sendiri."
      Speaker = "Melinoe"
      Event = "PrometheusPostTrueEnding03"
    }
    {
      Id = "Prometheus_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan aku sama-sama tahu bahwa kondisi pendakianmu harus menyerupai jalurmu sebelumnya, jika kau berniat untuk berhasil. Dan kuakui, hasil yang kuinginkan takkan terwujud selain lewat cara ini. Karena itulah kita berada di sini."
      Speaker = "Prometheus"
      Event = "PrometheusPostTrueEnding03"
    }
    {
      Id = "MelinoeField_3962"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hasil yang kau inginkan itu melibatkan aku yang menghajarmu berulang kali? Mungkin yang sebenarnya kau inginkan {#Emph}hanyalah {#Prev}dihajar sampai babak belur, berkedok lagak sok jadi juru selamat."
      Speaker = "Melinoe"
      Event = "PrometheusPostTrueEnding03"
    }
    {
      Id = "Prometheus_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "Daya tahanku terhadap rasa sakit luar biasa tingginya. Namun terhadap ejekan semacam itu, agak kurang. Ingat, kita {#Emph}berdua {#Prev}sama-sama bisa saling menghajar di sini."
      Speaker = "Prometheus"
      Event = "PrometheusPostTrueEnding03"
    }
    {
      Id = "Prometheus_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat tuanku mengizinkanmu melintasi perbatasan di luar alam ini untuk menghadapi monster Typhon seperti sebelumnya, hasil dari pertarungan {#Emph}itu{#Prev}, aku tak bisa meramalkannya... bagaimana hasil yang terakhir kali?"
      Speaker = "Prometheus"
      Event = "PrometheusAboutPostTyphon01"
    }
    {
      Id = "MelinoeField_3960"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kubiarkan saja jadi santapan imajinasimu. Pasti terasa hal baru bagimu saat tak mengetahui hasil dari peristiwa semacam itu."
      Speaker = "Melinoe"
      Event = "PrometheusAboutPostTyphon01"
    }
    {
      Id = "Prometheus_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, memang begitu. Ya sudah, jangan beri tahu aku jika kau mau; aku {#Emph}jauh {#Prev}lebih tertarik pada hasil akhirnya daripada berliku-liku langkah yang mesti kita tempuh di sepanjang jalan."
      Speaker = "Prometheus"
      Event = "PrometheusAboutPostTyphon01"
    }
    {
      Id = "Prometheus_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuanku menyiratkan bahwa pencapaianmu kian menumpuk dari malam ke malam. Dia menunggu di seberang sana, andai kau menang lagi."
      Speaker = "Prometheus"
      Event = "PrometheusAboutPostTyphon02"
    }
    {
      Id = "MelinoeField_3963"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertama kau, lalu Typhon, selalu sama seperti biasa. Meski begitu, aku senang mengetahui aku memenuhi ekspektasi Kakek. Memang selalu butuh menyenangkan lebih banyak anggota keluarga."
      Speaker = "Melinoe"
      Event = "PrometheusAboutPostTyphon02"
    }
    {
      Id = "Prometheus_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak iri padamu soal itu. Namun demikian, selama jalan kita masih saling terkait, aku akan tetap di sini; tak perlu repot-repot memberitahuku sebelumnya."
      Speaker = "Prometheus"
      Event = "PrometheusAboutPostTyphon02"
    }
    {
      Id = "Prometheus_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua selesai...! Akhirnya selesai juga, hanya saja... aku perlu mendengarmu mengatakannya sendiri dulu. Untuk memastikan apa yang telah kuramalkan. Sekarang, kumohon..."
      Speaker = "Prometheus"
      Event = "PrometheusAboutEpilogue01"
    }
    {
      Id = "MelinoeField_3965"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin harus bicara sedikit lebih spesifik, tapi... kuanggap maksudmu adalah aku telah menemukan Sang Fates? Atau mereka yang menemukanku, tapi sama saja intinya. Kukira kau tak terlalu peduli pada mereka."
      Speaker = "Melinoe"
      Event = "PrometheusAboutEpilogue01"
    }
    {
      Id = "Prometheus_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku peduli pada sabda mereka... apa yang mereka putuskan untuk dunia kita ini. Apa yang didorong oleh pengasingan mereka? Mereka tak akan mengulangi kesalahan yang sama lagi."
      Speaker = "Prometheus"
      Event = "PrometheusAboutEpilogue01"
    }
    {
      Id = "MelinoeField_3966"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka sudah muak dengan pertikaian kita; itu bisa kupahami. Jadi mereka menetapkan datangnya era baru di mana para dewa tampaknya tak lagi berkuasa penuh. Masa ketika beban kita berkurang, agar amarah kita bisa mereda."
      Speaker = "Melinoe"
      Event = "PrometheusAboutEpilogue01"
    }
    {
      Id = "Prometheus_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Datangnya zaman keemasan... mungkin bukan seperti yang dibayangkan tuanku, tapi biarlah. Segala jerih payah ini, akhirnya usai... dan sampai saat itu tiba... kurasa kita harus bertarung."
      Speaker = "Prometheus"
      Event = "PrometheusAboutEpilogue01"
    }
    {
      Id = "MelinoeField_3967"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau benar-benar melihat semua ini akan terjadi? Tiga Fates dan nubuat mereka tentang era baru. Kalau begitu, kenapa kau berjuang begitu keras untuk menghentikanku? Bagaimana jika kau yang menang waktu itu?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutEpilogue02"
    }
    {
      Id = "Prometheus_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu usahaku untuk mencegah kalian semua akan sia-sia; tapi bagaimanapun juga, aku terpaksa melakukannya. Sederhananya, aku tak melihat ada jalan lain."
      Speaker = "Prometheus"
      Event = "PrometheusAboutEpilogue02"
    }
    {
      Id = "MelinoeField_3968"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sebenarnya bisa bertarung di pihak yang sama. Pastinya itu akan lebih cepat mengantarkan hasil yang kauinginkan daripada mengirim Aetos mengejarku."
      Speaker = "Melinoe"
      Event = "PrometheusAboutEpilogue02"
    }
    {
      Id = "Prometheus_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Teori yang masuk akal, tapi semuanya tak akan pernah berjalan seperti yang kauharapkan. Bagimu, ini tak pernah menyangkut nasib umat fana."
      Speaker = "Prometheus"
      Event = "PrometheusAboutEpilogue02"
    }
    {
      Id = "MelinoeField_3969"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau benar, memang bukan. Aku punya masalahku sendiri yang harus diselesaikan sebelum mencoba membebaskan kaum fana dari masalah mereka."
      Speaker = "Melinoe"
      Event = "PrometheusAboutEpilogue02"
    }
    {
      Id = "Prometheus_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun kini kau telah menuntaskan keduanya. Tak usah cemas; kaum mati mungkin memujamu, tapi kaum yang hidup sama sekali tak peduli. Kendati demikian, kita tetap melakukan apa yang harus dilakukan."
      Speaker = "Prometheus"
      Event = "PrometheusAboutEpilogue02"
    }
    {
      Id = "MelinoeField_3970"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana dengan rekanmu, Heracles? Kurasa dia juga terlibat dalam rencanamu selama ini. Berpura-pura menentang para dewa sembari tetap melayani mereka."
      Speaker = "Melinoe"
      Event = "PrometheusAboutEpilogue03"
    }
    {
      Id = "Prometheus_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak akan berhasil mengorek jawaban dariku melebihi apa yang bisa kaudapat darinya. Kau sudah melihat orangnya; dia punya alasannya sendiri."
      Speaker = "Prometheus"
      Event = "PrometheusAboutEpilogue03"
    }
    {
      Id = "MelinoeField_3971"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maka dari itu kalian bersekutu? Kalian pasti akrab karena sama-sama muak pada gunung ini dan segala kepentingannya. Apa dia yang membebaskanmu?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutEpilogue03"
    }
    {
      Id = "Prometheus_0364"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tak ada jawaban dariku{#Prev}, kubilang tadi. Terutama bila menyangkut {#Emph}dia. {#Prev}Tapi setidaknya sekarang kau tahu ada keturunan keluargamu yang terbuat dari bahan yang lebih tangguh."
      Speaker = "Prometheus"
      Event = "PrometheusAboutEpilogue03"
    }
    {
      Id = "MelinoeField_3973"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengingat kau tahu segalanya tentang era mendatang... ada detail menarik yang bisa kaubagikan tentang apa yang akan terjadi nanti?"
      Speaker = "Melinoe"
      Event = "PrometheusAboutEpilogue04"
    }
    {
      Id = "Prometheus_0366"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dunia akan menjadi tempat yang amat berbeda, dengan cara yang mustahil kaubayangkan. Di sisi lain, tak ada yang berubah sama sekali; bahkan mengalami kemunduran. Kita semua akan dilupakan, lalu diingat kembali, dan dilupakan lagi. Terus, menerus, dan berulang kali..."
      Speaker = "Prometheus"
      Event = "PrometheusAboutEpilogue04"
    }
    {
      Id = "Prometheus_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asap menyesakkan di malam yang begitu pekat ini... mengisiku kembali dengan kekuatan purba yang kukira telah sirna. Pengingat yang bagus bahwa aku masih hidup...!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutShrine01"
    }
    {
      Id = "MelinoeField_3978"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang mendengar titik balik positif dalam keberadaanmu ini, Titan. Malam yang mencekam tentu bisa menanamkan kewaspadaan tinggi, serta tekad untuk bertahan hidup."
      Speaker = "Melinoe"
      Event = "PrometheusAboutShrine01"
    }
    {
      Id = "Prometheus_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bicara seolah-olah kaulah penyebabnya; mustahil. Atau sangat tidak mungkin harusnya kukatakan, tapi sekali lagi... {#Emph}akh{#Prev}, dasar kalian dewa-dewi kegelapan. Mari, kita lihat apakah malam ini milikmu atau milikku!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutShrine01"
    }
    {
      Id = "Prometheus_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau datang khusus untukku malam ini, bukan? Tugas biadab tertentu, barangkali, dari dewa-dewi kegelapan yang jauh lebih purba dan agung. Nah, aku di sini."
      Speaker = "Prometheus"
      Event = "PrometheusAboutShrineBounty01"
    }
    {
      Id = "MelinoeField_3975"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan bagaimana mungkin kau tahu? Aku sama sekali tak mengatakan hal semacam itu, Titan. Dan tak akan pernah."
      Speaker = "Melinoe"
      Event = "PrometheusAboutShrineBounty01"
    }
    {
      Id = "Prometheus_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan malam ini, tapi nanti. Kau akan lupa bahwa kita pernah membicarakan ini sebelumnya dan kau akan menceritakan lebih banyak padaku. Untuk sekarang, majulah dan lawan aku demi kejayaan bangsamu."
      Speaker = "Prometheus"
      Event = "PrometheusAboutShrineBounty01"
    }
    {
      Id = "MelinoeField_3976"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bukan sasaranku, Titan. Jadi bagaimana kalau kita selesaikan ini dengan cepat? Jangan sampai kau menghalangi kehendak Malam."
      Speaker = "Melinoe"
      Event = "PrometheusAboutShrineBounty02"
    }
    {
      Id = "Prometheus_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehendak Malam, ya... menuntut pengorbanan Typhon. Apa itu yang kauincar, mendaki gunung ini berulang-ulang?"
      Speaker = "Prometheus"
      Event = "PrometheusAboutShrineBounty02"
    }
    {
      Id = "MelinoeField_3977"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak melulu hanya pengorbanan Typhon. Semua musuh Underworld akan menerima hukumannya. Bahkan {#Emph}kau{#Prev}, jika kau berani terus begini."
      Speaker = "Melinoe"
      Event = "PrometheusAboutShrineBounty02"
    }
    {
      Id = "Prometheus_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah tak asing lagi dengan hukuman para dewa. Hukuman itu tak menciutkanku dulu, begitu pula sekarang, atau selamanya!"
      Speaker = "Prometheus"
      Event = "PrometheusAboutShrineBounty02"
    }
    {
      Id = "Prometheus_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya kita mungkin akan terkurung dalam pergulatan ini untuk beberapa waktu; tentu saja, itulah konsekuensi dari apa yang telah kauperbuat."
      Speaker = "Prometheus"
      Event = "PrometheusAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_3984"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mendapatkan keluargaku kembali. Jika itu berarti harus dimarahi sesekali oleh{#Emph}mu{#Prev}, sama sekali bukan masalah."
      Speaker = "Melinoe"
      Event = "PrometheusAboutSayingLittle01"
    }
    {
      Id = "Prometheus_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan itu maksudku. Nyatanya, mengetahui pertemuan ini mungkin akan menjadi rutinitas, barangkali lebih baik kita menjaga percakapan tetap singkat. Sebaiknya aku tak banyak bicara mulai sekarang."
      Speaker = "Prometheus"
      Event = "PrometheusAboutSayingLittle01"
    }
    {
      Id = "Prometheus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memang tak bisa mati, tapi bisa dipukul mundur. Dan kau bisa terbakar, serta memang akan kubakar."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart01"
    }
    {
      Id = "Prometheus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu akhir dari setiap bentrokan kita; namun entah bagaimana kau masih saja mengejutkanku."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart02"
    }
    {
      Id = "Prometheus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatanku seutuhnya takkan pernah kembali lagi, tapi ini sudah lebih dari cukup."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart03"
    }
    {
      Id = "Prometheus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aetos di sini masih mendambakan rasa hati segar, dan siapa kita berani menolak keinginannya?"
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart04"
    }
    {
      Id = "Prometheus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Agen Perubahan kembali, dan jalannya sejarah takkan pernah sama lagi."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart05"
    }
    {
      Id = "Prometheus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cepat atau lambat, era para dewa pasti berakhir, tak peduli seberapa ganasnya kau bertarung."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart06"
    }
    {
      Id = "Prometheus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih agak sakit hati atas apa yang diperbuat para dewa kepadaku, atas segala tuduhan kejahatanku."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart07"
    }
    {
      Id = "Prometheus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian para dewa mencari pemuja dalam segala kesombongan kalian; kami para Titan hanya menuntut apa yang menjadi hak kami."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart08"
    }
    {
      Id = "Prometheus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bertahan saat hatiku dicabik dan dimakan selama berabad-abad; pertarungan melawanmu ini bukan apa-apa."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart09"
    }
    {
      Id = "Prometheus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karunia api telah kuberikan kepada umat fana; dan kupastikan menyisakan sedikit untukmu."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart10"
    }
    {
      Id = "Prometheus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau paham sekarang? Setiap detik aku menahanmu, rencana Sang Waktu semakin mendekati kenyataan."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart11"
    }
    {
      Id = "Prometheus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kau akan menghancurkanku lagi di sini, hanya aku yang tahu dan terserah padamu untuk membuktikannya."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart12"
    }
    {
      Id = "Prometheus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah melihat semua trikmu; semua batas kemampuanmu! Dan kau sedang tidak dalam kondisi terbaikmu."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart13"
    }
    {
      Id = "Prometheus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan aku yang akan meruntuhkan gunung ini; tapi kau juga bukan orang yang akan menyelamatkannya."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart14"
    }
    {
      Id = "Prometheus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau belum melihat apa pun tentang dunia ini, namun tetap membelanya; aku telah melihat semuanya, dan akan membumihanguskannya."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart15"
    }
    {
      Id = "Prometheus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak berutang apa pun pada keluargamu, namun kau korbankan segalanya demi mereka. Benar-benar dungu, kalian semua."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart16"
    }
    {
      Id = "Prometheus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan tiba saatnya pertikaian kita berakhir; tapi jangan terlalu berharap banyak."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart17"
    }
    {
      Id = "Prometheus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang dilakukan para dewa dan Titan satu sama lain takkan pernah termaafkan... hanya terlupakan."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart18"
    }
    {
      Id = "Prometheus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Api ini mengalir dalam tubuhku, membakarku dari dalam... akan kutunjukkan padamu bagaimana rasanya."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart19"
    }
    {
      Id = "Prometheus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika menurut Olympus aku sudah bersalah atas dosa-dosa yang tak terampuni, maka hal ini tak lagi berarti."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart20"
    }
    {
      Id = "Prometheus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada lagi rantai yang mampu membelengguku; aku bersumpah dan aku tahu pasti itu kenyataannya."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart21"
    }
    {
      Id = "Prometheus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti sudah punya sedikit firasat masa depan sekarang, bukan? Kau tahu bagaimana ini akan berakhir."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart22"
    }
    {
      Id = "Prometheus_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa menuntut pengabdianmu dan kau menurutinya; namun aku berkewajiban melawan."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart23"
    }
    {
      Id = "Prometheus_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan repot memberitahumu apa yang bakal terjadi... karena kau takkan pernah memercayainya."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart24"
    }
    {
      Id = "Prometheus_0481"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak butuh senjata untuk memukulmu mundur... kecuali kau memperhitungkan kobaran api ini."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart25"
    }
    {
      Id = "Prometheus_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membiarkan Heracles yang baik hati menunggu dengan sabar untuk kembali mengayunkan gada besarnya."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart26"
    }
    {
      Id = "Prometheus_0483"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamilah amarah Olympus di sini, bukan dirimu; dan kami takkan pernah melepaskan pertarungan ini."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart27"
    }
    {
      Id = "Prometheus_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Heracles terikat untuk mengabdi pada dewa, begitu pula dirimu. Namun {#Emph}inilah {#Prev}hasilnya."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart28"
    }
    {
      Id = "Prometheus_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak bisa menghancurkan kami, Agen Perubahan; tapi mungkin kau bisa menerobos melewati kami lagi."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart29"
    }
    {
      Id = "Prometheus_0539"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah mendapat firasat tentang momen ini."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart30"
    }
    {
      Id = "Prometheus_0540"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu ke mana arah dari semua ini. Mari kita selesaikan!"
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart31"
    }
    {
      Id = "Prometheus_0541"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hampir menyesali apa yang akan terjadi selanjutnya."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart32"
    }
    {
      Id = "Prometheus_0542"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo, mari kita buktikan apakah malam ini milikmu atau milikku!"
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart33"
    }
    {
      Id = "Prometheus_0543"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin sebaiknya kita bicara singkat saja."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart34"
    }
    {
      Id = "Prometheus_0544"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perubahan takkan pernah terwujud tanpa adanya konflik."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart35"
    }
    {
      Id = "Prometheus_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya kini aku harus membayar dosa lagi kepada para dewa, meski mereka takkan pernah bisa membelengguku lagi."
      Speaker = "Prometheus"
      Event = "PrometheusMiscStart36"
    }
    {
      Id = "Heracles_0640"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam demi malam kau terus saja muncul, Saudari. Kau menikmati semua ini?"
      Speaker = "Heracles"
      Event = "HeraclesFightMiscStart01"
    }
    {
      Id = "Heracles_0690"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sampai ke sini cukup cepat malam ini, ya, Penyihir. Ada dewa kegelapan yang membantumu mendaki?"
      Speaker = "Heracles"
      Event = "HeraclesFightMiscStart02"
    }
    {
      Id = "Heracles_0691"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah sejauh ini saja. Ada hal aneh yang sedang terjadi... tapi aku tak peduli soal itu sekarang."
      Speaker = "Heracles"
      Event = "HeraclesFightMiscStart03"
    }
    {
      Id = "Heracles_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah kita bertarung berdampingan atau saling beradu, itu tak masalah; yang penting adalah pertarungannya."
      Speaker = "Heracles"
      Event = "HeraclesFightMiscStart04"
    }
    {
      Id = "Heracles_0642"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebentar lagi bakal ada lebih dari cukup pembantaian untuk kita berdua di sini."
      Speaker = "Heracles"
      Event = "HeraclesFightMiscStart05"
    }
    {
      Id = "Heracles_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pulanglah, Penyihir. Kau bukan tandingan gada milikku."
      Speaker = "Heracles"
      Event = "HeraclesFightMiscStart06"
    }
    {
      Id = "Heracles_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak kedinginan di atas sini, Saudari? Atau pertempuran menghangatkanmu seperti halnya diriku?"
      Speaker = "Heracles"
      Event = "HeraclesFightMiscStart07"
    }
    {
      Id = "Heracles_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sadar tidak kalau bernapas makin sulit di atas sini, Saudari? Nyaris seperti gunung ini terkutuk."
      Speaker = "Heracles"
      Event = "HeraclesFightMiscStart08"
    }
    {
      Id = "Heracles_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Teruslah biarkan Olympus mempermainkanmu, dan kelak kau akan berakhir persis sepertiku."
      Speaker = "Heracles"
      Event = "HeraclesFightMiscStart09"
    }
    {
      Id = "Heracles_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ini pertanda baik atau buruk, aku belum memutuskannya."
      Speaker = "Heracles"
      Event = "HeraclesFightMiscStart10"
    }
    {
      Id = "Prometheus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Urgh... {#Prev}Aku tahu ini akan terjadi. Namun aku tak kuasa mencegahnya, kau paham? Aku hanya bisa... menjalankan peranku..."
      Speaker = "Prometheus"
      Event = "PrometheusBossOutro01"
    }
    {
      Id = "MelinoeField_2383"
      InheritFrom = "BaseNarrative"
      DisplayName = "Diam. Simpan keluh kesahmu untuk tuanmu, Chronos."
      Speaker = "Melinoe"
      Event = "PrometheusBossOutro01"
    }
    {
      Id = "Prometheus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan keluh kesahku yang ingin kusimpan... sang Agen Perubahan..."
      Speaker = "Prometheus"
      Event = "PrometheusBossOutro01"
    }
    {
      Id = "Prometheus_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku telah menuntaskan tugasku di sini, sama sepertimu... karena ini memang ditakdirkan terjadi."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat01"
    }
    {
      Id = "Prometheus_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Terkutuklah luka-luka lama ini... Aku pernah jauh lebih kuat dari ini...!"
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat02"
    }
    {
      Id = "Prometheus_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tahu ini akan jadi pergulatan berat... tapi aku selalu berpegang pada kemungkinan bahwa ramalanku bisa saja salah..."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat03"
    }
    {
      Id = "Prometheus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku telah kalah. Namun kau takkan sanggup terus mengejarku, dan kekuatanku pasti akan pulih."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat04"
    }
    {
      Id = "Prometheus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kemurkaan Olympus yang kesohor itu... sungguh tak mudah dihentikan, kau paham?"
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat05"
    }
    {
      Id = "Prometheus_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aetos dan aku telah melakukan apa yang mesti dilakukan. Sekarang giliranmu melakukan hal serupa."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat06"
    }
    {
      Id = "Prometheus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jika penderitaan hari ini membawa esok yang lebih baik, biarlah begitu adanya."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat07"
    }
    {
      Id = "Prometheus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku telah melihat tipu muslihatmu dalam ramalanku, namun tetap tak berdaya mencegahnya, apa pun yang telah kucoba."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat08"
    }
    {
      Id = "Prometheus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Heh! {#Prev}Dibandingkan apa yang telah kutanggung sebelumnya, ini sama sekali bukan apa-apa."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat09"
    }
    {
      Id = "Prometheus_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bahkan seandainya kau bisa melihat apa yang kuramalkan, kau toh takkan memercayainya."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat10"
    }
    {
      Id = "Prometheus_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kalian para dewa tak pernah memaafkan; lantas mengapa aku harus, jika aku bisa memilih bertarung?"
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat11"
    }
    {
      Id = "Prometheus_0452_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kekuatan yang sanggup menumbangkan Heracles dan diriku... Aku tak bisa meramalkan jalan untuk menghentikannya sekarang."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat12"
    }
    {
      Id = "Prometheus_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sudah sering meramalkan kekalahanku sebelumnya... setiap kekalahan itu, tepatnya..."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat13"
    }
    {
      Id = "Prometheus_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau mengalahkanku lagi... namun seluruh lukaku akan pulih. Selalu begitu..."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat14"
    }
    {
      Id = "Prometheus_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kekuatanku telah berulang kali mengecewakanku... namun ia selalu kembali..."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat15"
    }
    {
      Id = "Prometheus_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kobaran api yang sanggup kau tahan itu... barangkali memang tak pernah ditujukan untukmu..."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat16"
    }
    {
      Id = "Prometheus_0459_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Penglihatan masa depanku atas momen ini... rasanya seolah... kita pernah melalui semua ini sebelumnya..."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat17"
    }
    {
      Id = "Prometheus_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sekarang apakah kau mulai memahami... apa yang kulakukan di setiap langkah ini...?"
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat18"
    }
    {
      Id = "Prometheus_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tahu aku tak bisa menghentikanmu... sebaliknya, kau... memang harus menang..."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat19"
    }
    {
      Id = "Prometheus_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Andai bukan karena pertarungan ini... kau takkan pernah menemukan secuil pun sisa peninggalan Typhon..."
      Speaker = "Prometheus"
      Event = "PrometheusBossMiscDefeat20"
    }
    {
      Id = "Prometheus_0095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Legiun Tuan Titan, {#Emph}serang!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bala bantuan, {#Emph}sekarang!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sambutlah legiun tuanku!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasukanku telah berkumpul kembali!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Legiun, berkumpul padaku!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0249"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Legiun, bentuk formasi!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0250_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Legiun sang Penguasa Titan!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasukan penyerbu, mendekat!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lawanmu bukan cuma aku."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0440"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cepat, Legiun: Habisi dia {#Emph}sekarang!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0441"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang, Legiun! {#Emph}Turunlah!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0442"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sudah terkepung!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0443"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Legiun, bantuan tembakan!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0444"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Legiun, tembak!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0445"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Legiun sang Penguasa Titan, {#Emph}masuklah!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tidak bertarung sendirian!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusSpawnWaveLines"
    }
    {
      Id = "Prometheus_0065"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siap...?"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cukup!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat ini..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan menderita."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mundur...!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersiaplah...!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0518"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasakan yang ini..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0520"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Untukmu..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0521"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau lihat ini...?"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0522"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu rupanya..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terkutuklah kalian para dewa!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atas perbuatan kalian!"
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.PrometheusPreAttackLines"
    }
    {
      Id = "Prometheus_0087"
      InheritFrom = "BaseSubtitle"
