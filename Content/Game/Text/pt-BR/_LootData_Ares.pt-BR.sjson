{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _LootData_Ares.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "MelinoeField_2915"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Segel sang kesatria..."
      Speaker = "Melinoe"
      Event = "AresUpgrade.FirstSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_2918"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang dewa perang..."
      Speaker = "Melinoe"
      Event = "AresUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_2919"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hadir demi pertumpahan darah..."
      Speaker = "Melinoe"
      Event = "AresUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_2920"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dewa Ares..."
      Speaker = "Melinoe"
      Event = "AresUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Ares_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan aku, saudaraku, tapi Paduka Ayahanda dan aku sedang berada di tengah-tengah perdebatan yang menurutku tak boleh ditunda... mengenai apa yang kupelajari saat mengunjungi negeri-negeri nun jauh di sana."
      Speaker = "Ares"
      Event = "AresWithZeus01"
    }
    {
      Id = "Zeus_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tenangkan dirimu soal itu, Ares! Lebih baik kita tuntaskan dulu masalah di depan mata sebelum mengkhawatirkan kekacauan di pelosok dunia! Kita akan urus {#Emph}mereka {#Prev}pada waktunya."
      Speaker = "Zeus"
      Event = "AresWithZeus01"
    }
    {
      Id = "Ares_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah ingin membebani ibundaku sang Ratu, mahkotanya begitu berat; namun beliau bersikeras hadir di sini, mungkin berpikir bantuanku saja takkan memadai. Apakah benar begitu, Ibu?"
      Speaker = "Ares"
      Event = "AresWithHera01"
    }
    {
      Id = "Hera_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Simpan saja rasa cemasmu itu, Ares, dan saat berada di depan umum, jangan panggil aku {#Emph}Ibu. {#Prev}Jika perkara sopan santun dasar saja tak bisa kupercayakan padamu, atas dasar apa aku harus mempercayai keampuhan {#Emph}berkahmu?"
      Speaker = "Hera"
      Event = "AresWithHera01"
    }
    {
      Id = "Ares_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paman kita, Poseidon, cenderung memberi petuah lebih banyak dibanding kerabat yang lain, mungkin meyakini bahwa banyaknya nasihat berbanding lurus dengan mutunya. Lantas ke mana haluan kita sekarang, Paman?"
      Speaker = "Ares"
      Event = "AresWithPoseidon01"
    }
    {
      Id = "Poseidon_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Haluan kita saat ini harusnya lurus ke arah musuh, tempat di mana kita bisa meremukkan mereka bagai badai melumat kapal! {#Emph}Ah{#Prev}, tapi aku merasa membara dan siap bertempur! Kalau dipikir-pikir, aku selalu begini tiap keponakanku yang baik ini, Ares, ada di dekatku!"
      Speaker = "Poseidon"
      Event = "AresWithPoseidon01"
    }
    {
      Id = "Ares_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kagum betapa dewi musim kita yang agung ini begitu menjiwai perang kita. Semakin kita jadikan ini urusan pribadi, semakin sengit kita bertarung! Bukankah begitu, Nyonya Demeter tercinta?"
      Speaker = "Ares"
      Event = "AresWithDemeter01"
    }
    {
      Id = "Demeter_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan aku yang menjadikannya urusan pribadi, Ares. Kelak jika anak dan cucumu sendiri direnggut darimu, mungkin barulah kau akan paham. Namun untuk saat ini... kau hanya perlu menurut."
      Speaker = "Demeter"
      Event = "AresWithDemeter01"
    }
    {
      Id = "Ares_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudara tiriku, Paduka Apollo, mengaku ialah yang pertama di antara keluarga kita yang menghubungimu, saudaraku. Barangkali andai {#Emph}aku {#Prev}yang lebih dulu, semua ini sudah tuntas sejak tadi..."
      Speaker = "Ares"
      Event = "AresWithApollo01"
    }
    {
      Id = "Apollo_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Ares, kau kan tak pernah suka menyudahi konflik. Mungkin itu sebabnya kau terlambat sekali muncul di perang ini! Tapi kau melihat betapa serunya kami bersenang-senang dan rasanya kau {#Emph}harus {#Prev}ikut campur."
      Speaker = "Apollo"
      Event = "AresWithApollo01"
    }
    {
      Id = "Ares_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cinta dan benci, saudaraku! Emosi yang paling dahsyat, sekaligus akar dari segala peperangan. Maka dari itu, Aphrodite yang memikat menaruh minat pada kegemaranku, begitu pula aku pada miliknya."
      Speaker = "Ares"
      Event = "AresWithAphrodite01"
    }
    {
      Id = "Aphrodite_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesenanganmu adalah gairahku, Dewa Ares! Apa yang bisa mendorong seseorang menyerahkan diri seutuhnya pada rasa? Aku ingin tahu {#Emph}setiap {#Prev}alasan di baliknya."
      Speaker = "Aphrodite"
      Event = "AresWithAphrodite01"
    }
    {
      Id = "Ares_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru saja berbincang dengan Aphrodite yang jelita tentang betapa banyak hal yang ia pelajari soal perang selama berbagai konflik yang telah kita lalui. Sedikit sekali yang mau mengakui bahwa ada keindahan di balik pertumpahan darah."
      Speaker = "Ares"
      Event = "AresWithAphrodite02"
    }
    {
      Id = "Aphrodite_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, sudah pasti {#Emph}ya{#Prev}, Tuanku! Kilauan senjata dan kereta perang, barisan prajurit yang siap menyongsong maut, serta segala kejayaannya! Lagipula, takkan ada keindahan tanpa adanya keburukan rupa!"
      Speaker = "Aphrodite"
      Event = "AresWithAphrodite02"
    }
    {
      Id = "Ares_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hephaestus yang ulet dan diriku adalah satu-satunya putra sah dari Raja dan Ratu Gunung Olympus. Aku selalu bilang padanya, kita harus memanfaatkan kesempatan ini dan unjuk gigi!"
      Speaker = "Ares"
      Event = "AresWithHephaestus01"
    }
    {
      Id = "Hephaestus_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau tanggung jawab lebih banyak, Ares? Ambil saja sana! Selain itu aku tak tahu apa maumu, dan aku tak sudi ikut campur, terlepas dari urusan Aphrodite. Aku sudah punya bengkel tempa, punya istri... itu sudah cukup."
      Speaker = "Hephaestus"
      Event = "AresWithHephaestus01"
    }
    {
      Id = "Ares_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang melihat Nyonya Hestia tercinta memanfaatkan kemampuannya lebih jauh lagi. Wah, kebetulan sekali beliau ada di sini! Dari dulu aku tahu kau punya bakat untuk menghancurkan, Dewi, mengingat api begitu mendominasi dalam peperangan!"
      Speaker = "Ares"
      Event = "AresWithHestia01"
    }
    {
      Id = "Hestia_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu sisi diriku yang jarang ingin kuperlihatkan, meski kau tampak begitu senang melihatnya, Ares. Menurutku kita takkan bisa mengendalikan kekuatan kita jika tak mampu mengendalikan diri sendiri."
      Speaker = "Hestia"
      Event = "AresWithHestia01"
    }
    {
      Id = "MelinoeField_2916"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira yang satu ini takkan pernah menampakkan batang hidungnya. {#Emph}Atas nama Hades! Olympus, kuterima pesan ini!"
      Speaker = "Melinoe"
      Event = "AresFirstPickUp"
    }
    {
      Id = "Ares_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, sesama penikmat kematian! Menghadapi Typhon yang mengerikan dengan begitu membara. Kerabatku bersikeras agar aku turun tangan mengatasi kekerasan yang kian tak terkendali ini, dan aku ingin menyaksikan kehebatanmu, jadi {#Emph}terimalah... {#Prev}bantuan pertama dari sekian banyak persembahan demi perjuangan ini."
      Speaker = "Ares"
      Event = "AresFirstPickUp"
    }
    {
      Id = "Ares_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Darahmu mengalir merah pekat persis seperti kakakmu, dan kau sudah kehilangan cukup banyak untuk malam ini. Andaikan saja aku bisa menjangkaumu lebih cepat, agar bisa menyaksikannya lebih banyak dengan mataku sendiri."
      Speaker = "Ares"
      Event = "AresLowHealth01"
    }
    {
      Id = "Ares_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luka yang begitu parah kau derita, saudaraku! Dalam perang, tentu saja, tiada yang bisa lolos tanpa cela. Semoga kau menimpakan penderitaan yang {#Emph}jauh {#Prev}lebih dahsyat pada siapa pun yang berani mencelakai kita."
      Speaker = "Ares"
      Event = "AresLowHealth02"
    }
    {
      Id = "Ares_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak sekali nyawa melayang malam ini; meski aku sendiri enggan memakai istilah itu. Nyawa yang terenggut tak pernah benar-benar {#Emph}hilang{#Prev}, melainkan {#Emph}dikorbankan... {#Prev}demi kebaikan alam ayahandamu."
      Speaker = "Ares"
      Event = "AresLowHealth03"
    }
    {
      Id = "Ares_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menanggung luka-luka yang bahkan sanggup membuat manusia fana terkuat sekalipun binasa; namun kau terus bertempur seolah kau tak terluka sedikit pun! Barangkali kau malah menikmati sensasinya?"
      Speaker = "Ares"
      Event = "AresLowHealth04"
    }
    {
      Id = "Ares_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar burung sampai pada kami bahwa kau telah menumbangkan sang Titan Waktu semalam, dan kami dibuat amat terpukau; namun aku penasaran apakah ia sempat merasakan sekaratnya rasa sakit sebelum ajal menjemput. Barangkali pada akhirnya ia bisa jera lewat cara itu."
      Speaker = "Ares"
      Event = "AresUnderworldRunCleared01"
    }
    {
      Id = "Ares_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bahkan belum lahir ketika para ayahanda kita pertama kali membantai Titan Chronos... dan aku pun tak sempat melihatnya kau buat bertekuk lutut semalam. Namun imajinasiku cukup tajam untuk membayangkan hal-hal semacam itu."
      Speaker = "Ares"
      Event = "AresUnderworldRunCleared02"
    }
    {
      Id = "Ares_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir aku akan menemukanmu di sana malam ini. Selagi Titan Chronos limbung akibat kekalahan barunya, pasukannya di permukaan pasti sedang goyah, dan jauh lebih rentan untuk diserang."
      Speaker = "Ares"
      Event = "AresUnderworldRunCleared03"
    }
    {
      Id = "Ares_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam perang, kita harus sulit ditebak. Titan Chronos kemungkinan besar mengira kau akan menyerangnya lagi, sementara kau justru mengalihkan upaya ke gunung kami ini. Muslihat yang cerdik."
      Speaker = "Ares"
      Event = "AresUnderworldRunCleared04"
    }
    {
      Id = "Ares_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memukul mundur Sang Bapa Segala Monster adalah pencapaian luar biasa, saudaraku. Namun perang belum usai! Yang berarti kemenangan yang jauh lebih agung telah menanti; mungkin diselingi beberapa kekalahan memalukan sesekali."
      Speaker = "Ares"
      Event = "AresSurfaceRunCleared01"
    }
    {
      Id = "Ares_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Monster yang luar biasa mengerikan, Typhon itu... lamban, raksasa, keras kepala saat memanjat menuju puncak tertinggi kami; terdorong oleh dendam, amarah...! Dari sudut pandang tertentu, aku mengaguminya. Meski begitu, aku bersyukur kau ada di sana untuk memupuskan harapannya."
      Speaker = "Ares"
      Event = "AresSurfaceRunCleared02"
    }
    {
      Id = "Ares_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cukup menyukai perang yang memiliki pasang surut tertentu... saat keunggulan diraih dengan susah payah, namun begitu mudah terlepas! Untuk sekarang, saudaraku, keunggulan itu milikmu. Pertahankanlah baik-baik."
      Speaker = "Ares"
      Event = "AresLegendaryPickUp01"
    }
    {
      Id = "Ares_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam perang, pemenang adalah siapa pun yang terkuat atau yang paling kejam di antara semuanya. Kendati demikian, aku pun punya sedikit pengaruh, dan menganugerahimu kuasa itu {#Emph}sekarang."
      Speaker = "Ares"
      Event = "AresLegendaryPickUp02"
    }
    {
      Id = "Ares_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau memulai perjuangan malam ini, aku ingin mendampingimu sejak awal, agar kau bisa bertarung dan membantai musuh-musuhmu tanpa sedikit pun belas kasihan."
      Speaker = "Ares"
      Event = "AresRunStart01"
    }
    {
      Id = "Ares_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan potensi kekerasan yang begitu pekat dari keberadaanmu saat ini. Maka sebentar lagi, pembantaian akan dimulai. Kau hanya perlu memilih sarana untuk menuntaskannya."
      Speaker = "Ares"
      Event = "AresRunStart02"
    }
    {
      Id = "Ares_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Upaya terbarumu untuk menghentikan Typhon mungkin tak berjalan sesuai keinginanmu, namun kita masih bisa memanfaatkan pengalihan yang kauciptakan demi keuntungan kita. Sekarang gilirannya Titan Chronos, bukan?"
      Speaker = "Ares"
      Event = "AresRunStart03"
    }
    {
      Id = "Ares_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa gemburnya tanah yang kaupijak, dan kurasa bukan karena air hujan. Nah, jika kau ingin menelusuri lanskap-lanskap yang terkoyak perang di dekat maupun jauh, biarkan aku menjadi pemandumu."
      Speaker = "Ares"
      Event = "AresRunStartSurface01"
    }
    {
      Id = "Ares_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih cukup jauh jarak yang harus kautempuh sebelum tiba di medan perang lereng gunung kami; namun jangan khawatir, pertempuran di sepanjang jalan pasti akan sengit!"
      Speaker = "Ares"
      Event = "AresRunStartSurface02"
    }
    {
      Id = "Ares_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar Tiga Fates ditawan di luar kehendak mereka? Aku seharusnya lebih mengkhawatirkan mereka, kecuali... mungkin ini pertanda bahwa perang itu sendiri yang akhirnya menjadi penentu tunggal hasilnya...!"
      Speaker = "Ares"
      Event = "AresAboutFates01"
    }
    {
      Id = "Ares_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Ayah Zeus adalah sosok yang paling berpengalaman dalam perang, telah bertempur dan menaklukkan musuh berkali-kali. Namun beliau kerap lebih memercayai nasihat Athena ketimbang nasihatku, bahkan saat saudariku itu kewalahan mempertahankan gunung ini. Setidaknya kaumengerti bahwa kita seharusnya {#Emph}menyerang."
      Speaker = "Ares"
      Event = "AresAboutZeus01"
    }
    {
      Id = "Ares_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berkat ayahku memang sangat luar biasa kuat. Kekuatan untuk menumbangkan Typhon sekalipun! Kendati begitu, keadaan yang kita hadapi ini menuntut sesuatu yang lebih dahsyat lagi, dan aku siap memberikannya padamu."
      Speaker = "Ares"
      Event = "AresAboutZeus02"
    }
    {
      Id = "Ares_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedahsyatan petir Paduka Zeus telah menjadi milikmu; lalu untuk apa kau memerlukan kekuatanku yang tampak begitu remeh jika dibandingkan? Meski mungkin perbedaannya kini tak lagi sebesar dulu..."
      Speaker = "Ares"
      Event = "AresAboutZeus03"
    }
    {
      Id = "Ares_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibuku tercinta, Sang Ratu, berhati-hati agar tak menganakemaskan anggota keluarga mana pun, bahkan anak-anak kandungnya sendiri... Aku suka mengira bahwa kecenderunganku untuk bersikap objektif berasal darinya."
      Speaker = "Ares"
      Event = "AresAboutHera01"
    }
    {
      Id = "Ares_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibuku, Ratu Hera, memandang perang sebagai sesuatu yang amat menjijikkan, dan sering kali berusaha menjauhkan diri darinya. Namun tidak untuk yang satu ini! Aku hampir lupa kapan terakhir kali kami bersama selama ini."
      Speaker = "Ares"
      Event = "AresAboutHera02"
    }
    {
      Id = "Ares_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paman kita Poseidon menampakkan raut penuh percaya diri, namun kurasa yang kerap terlihat di keningnya itu adalah keringat dingin, bukan air laut. Perang memang bisa mengguncang jiwa siapa pun."
      Speaker = "Ares"
      Event = "AresAboutPoseidon01"
    }
    {
      Id = "Ares_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudara tiriku Apollo memberimu berkahnya, ya? Di saat aku tekun mengejar satu panggilan jiwaku, ia malah mengejar aneka angan-angan, berbakat dalam banyak hal, namun bisa dibilang tak menguasai satu pun."
      Speaker = "Ares"
      Event = "AresAboutApollo01"
    }
    {
      Id = "Ares_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi Demeter terkenal karena kemampuannya menyuburkan hasil panen... kendati demikian, ia bisa semudah itu menyebarkan bencana kelaparan ke seluruh negeri. Kekuatan semacam itu adalah pelengkap ideal bagi kekuatanku."
      Speaker = "Ares"
      Event = "AresAboutDemeter01"
    }
    {
      Id = "Ares_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, aku takkan sudi menawarkan berkahku begitu saja jika bukan karena Aphrodite yang rupawan, yang kulihat telah melimpahkan anugerahnya kepadamu sekali lagi. Kau melihat keindahan dalam karyaku, dan itu semua berkat dirinya."
      Speaker = "Ares"
      Event = "AresAboutAphrodite01"
    }
    {
      Id = "Ares_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudaraku yang malang, Hephaestus, terpaksa menjalani hidup dengan bersimbah peluh di bengkel tempa... menciptakan senjata dan zirah yang mengecap kejayaan yang takkan pernah bisa ia rasakan sendiri. Setidaknya ia berguna bagi{#Emph}mu{#Prev}, saudaraku."
      Speaker = "Ares"
      Event = "AresAboutHephaestus01"
    }
    {
      Id = "Ares_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menggugah Hestia yang enggan itu untuk ikut bertarung! Sungguh disayangkan apinya selama ini lebih banyak digunakan sekadar untuk menghangatkan rumah fana. Aku {#Emph}sangat {#Prev}ingin melihatnya mengerahkan api itu hingga potensi terbesarnya!"
      Speaker = "Ares"
      Event = "AresAboutHestia01"
    }
    {
      Id = "Ares_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi perburuan menurut sifat alaminya memang jarang menampakkan diri; aku sudah sering membujuk Artemis untuk mengerahkan bakatnya di medan perang, bukan sekadar di hutan belantara. Namun ia keras kepala, seperti yang mungkin sudah kautahu."
      Speaker = "Ares"
      Event = "AresAboutArtemis01"
    }
    {
      Id = "Ares_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang yang dilancarkan dengan sukses menuntut komunikasi yang tangkas, dan untuk urusan itu kita masih bergantung pada Hermes yang berkaki gesit. Sudah sewajarnya ia mencapaimu lebih dulu; kuharap dengan membawa berkah, bukan sekadar kabar burung."
      Speaker = "Ares"
      Event = "AresAboutHermes01"
    }
    {
      Id = "Ares_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pada malam-malam seperti ini, satu-satunya penerangan yang bisa ditemukan berasal dari Selene di atas kereta perangnya yang bersinar di angkasa. Cahayanya menyelimutimu, saudaraku; demikian pula kekuatan tersembunyinya, bukan?"
      Speaker = "Ares"
      Event = "AresAboutSelene01"
    }
    {
      Id = "Ares_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudariku tercinta Athena memikul beban yang begitu berat, melampaui zirah tebal yang kaulihat itu. Ia bukan hanya mengatur pertahanan kita, tetapi juga harus bertanggung jawab atas kegagalannya. Kupercaya kebijaksanaannya akan menuntunnya melewatinya."
      Speaker = "Ares"
      Event = "AresAboutAthena01"
    }
    {
      Id = "Ares_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kakek kita menghendaki perang, maka siapalah aku berani menolaknya? Ironi dari persoalan ini pun sama sekali tak luput dari pandanganku; aku hanya merasa kita {#Emph}semua {#Prev}bisa mendapatkan apa yang kita inginkan."
      Speaker = "Ares"
      Event = "AresAboutChronos01"
    }
    {
      Id = "Ares_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebelum sang Titan menguasai Dunia Bawah, putri dewi Nyx kerap menghukum mereka yang meraup lebih dari haknya. Namanya Nemesis, dan aku mengaguminya... barangkali belakangan ini ia sedang menuntut balas atas nama keluarganya."
      Speaker = "Ares"
      Event = "AresAboutNemesis01"
    }
    {
      Id = "Ares_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah bertemu jawara ibuku yang bernama Heracles, yang tersohor di kalangan kaum fana berkat keahlian tempurnya yang perkasa. Pentungannya mungkin telah merenggut lebih banyak nyawa ketimbang dirimu! Walau tentu, ia memulai lebih dulu darimu."
      Speaker = "Ares"
      Event = "AresAboutHeracles01"
    }
    {
      Id = "Ares_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang penyihir Medea membantumu, bukan? Wabah dan racun yang membuatnya terkenal keji dalam beberapa hal memang mereduksi kemungkinan perang; namun hal itu membuahkan hasil, jadi kita harus tetap berpikiran terbuka."
      Speaker = "Ares"
      Event = "AresAboutMedea01"
    }
    {
      Id = "Ares_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berutang budi besar pada ayahmu, karena semakin banyak pekerjaan yang kuselesaikan, semakin banyak pula pekerjaan yang harus ia urus. Kuharap dari sudut pandangnya, ia menghargai kerja sama kita? Rasanya tak lagi sama tanpanya sejak saat itu."
      Speaker = "Ares"
      Event = "AresAboutHades01"
    }
    {
      Id = "Ares_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengenal dewi Nyx, saudaraku, dan belajar darinya mengenai alammu beserta segala adat istiadatnya. Ia dan kerabat terdekatmu sangatlah akrab. Jika kini perang diperlukan untuk merebut mereka kembali, itu justru jauh lebih baik."
      Speaker = "Ares"
      Event = "AresAboutNyx01"
    }
    {
      Id = "Ares_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi Nyx telah kembali ke Dunia Bawah, saudaraku! Kendati aku sempat merasa murung membayangkan perang kita akan segera usai, aku amat senang kehadiran sang Perwujudan Malam kembali terasa semakin kuat, sebagaimana mestinya."
      Speaker = "Ares"
      Event = "AresAboutNyx02"
    }
    {
      Id = "Ares_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sangat mengingatkanku pada saudaramu. Ia pembawa maut yang ulung, terlahir dari tempaan neraka terdalam! Walau mungkin kalian berdua takkan akur, sama halnya seperti aku dan saudara-saudariku yang kerap bertengkar kecil."
      Speaker = "Ares"
      Event = "AresAboutZagreus01"
    }
    {
      Id = "Ares_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah saudaramu Zagreus baik-baik saja? Kupercaya kalian berdua akan sangat akrab, karena kalian memiliki banyak kesamaan: kebrutalan, ketiadaan belas kasihan...! Betapa kuharap aku punya saudara semacam itu di sini..."
      Speaker = "Ares"
      Event = "AresAboutZagreus02"
    }
    {
      Id = "Ares_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar dewi Eris memburumu tanpa henti setiap malam kau mendekat. Sejujurnya ini menempatkanku dalam dilema, karena Sang Perselisihan telah memberi manfaat pada karyaku jauh lebih banyak daripada siapa pun. Namun aku tahu ia tak bisa dikendalikan."
      Speaker = "Ares"
      Event = "AresAboutEris01"
    }
    {
      Id = "Ares_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi Eris sangat tidak disukai di atas sini, dan kuduga begitu pula di tempat tinggalmu. Namun aku menaruh simpati tertentu padanya, dikucilkan sebagaimana adanya dia. Kita tak bisa mengubah kodrat kita; kita para dewa abadi, kita bahkan tak bisa dihancurkan, tampaknya."
      Speaker = "Ares"
      Event = "AresAboutEris02"
    }
    {
      Id = "Ares_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada semacam ikatan batin antara kau dan sang perwujudan Perselisihan? Kukira hanya perseteruan sengit dan tak lebih. Namun rupanya kau memandang Eris sama seperti diriku. Kita semua adalah kekuatan alam, bukan?"
      Speaker = "Ares"
      Event = "AresAboutEris03"
    }
    {
      Id = "Ares_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah jelas Titan Prometheus bukanlah sosok yang asing dalam mengobarkan perang. Ia tahu betul, sebagai contoh, betapa rapuhnya sebagian besar persekutuan. Menurutmu, apakah ia memihak para ayah kita di masa lalu hanya demi mempelajari kelemahan mereka dengan lebih baik?"
      Speaker = "Ares"
      Event = "AresAboutPrometheus01"
    }
    {
      Id = "Ares_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir Prometheus hanyalah seorang pasifis murni, melihat betapa pasrahnya ia menerima takdir saat tertangkap menentang kehendak Baginda Ayahku. Rupanya kini ia menemukan kembali semangat tempurnya, ya? Memang terkadang butuh rasa sakit dan penderitaan untuk menyadari siapa diri kita sebenarnya."
      Speaker = "Ares"
      Event = "AresAboutPrometheus02"
    }
    {
      Id = "Ares_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau dan Prometheus akan terus melanjutkan perselisihan kalian? Ia punya alasan rumit tersendiri, yang diterima dengan berat hati oleh keluargaku. Bagiku, melihatnya bertarung saja sudah cukup memuaskan."
      Speaker = "Ares"
      Event = "AresAboutPrometheus03"
    }
    {
      Id = "Ares_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon yang kolosal itu ternyata ancaman yang jauh lebih dahsyat dari yang kubayangkan, Saudaraku! Betapa irinya diriku dahulu saat mendengar kisah para tetua memukul mundur Sang Ayah Para Monster... namun kini, kita semua menyaksikan langsung amarah liarnya!"
      Speaker = "Ares"
      Event = "AresAboutTyphon01"
    }
    {
      Id = "Ares_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku jelas takkan menyebut pertempuran terakhir kita melawan Typhon sebagai kemenangan, namun kita akhirnya mampu memukulnya mundur setelah kau terpaksa mundur. Tapi kini sepertinya ia telah melanjutkan pendakian lambatnya..."
      Speaker = "Ares"
      Event = "AresAboutTyphonL01"
    }
    {
      Id = "Ares_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Ayah Para Monster, tewas! Nyaris tak kupercaya saat mendengarnya, namun Baginda Ayah dan Ibunda tercinta menegaskan hal itu benar adanya. Tampaknya kau memiliki kekuatan yang {#Emph}jauh {#Prev}lebih mengerikan {#Emph}bahkan {#Prev}daripada musuh kita yang telah binasa itu."
      Speaker = "Ares"
      Event = "AresAboutTyphonDeath01"
    }
    {
      Id = "Ares_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menyesal tak sempat menyampaikan salam kepadamu saat kau berada di sini, Saudaraku. Namun kebutuhan untuk membinasakan para penyusup harus diutamakan. Kuyakin kita masih bisa bertemu pada waktunya nanti?"
      Speaker = "Ares"
      Event = "AresAboutPalace01"
    }
    {
      Id = "Ares_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lama sejak terakhir kali kusaksikan peristiwa di bawah bumi, bukan berarti Berkah semata memberiku pandangan yang luas. Sebagian tempat-tempat gelap yang kau luluhlantakkan itu, nyaris tak bisa kulihat sama sekali."
      Speaker = "Ares"
      Event = "AresAboutUnderworld01"
    }
    {
      Id = "Ares_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapan ayahmu akan memulihkan gerbang Underworld? Mungkin alamnya belum siap menampung begitu banyak penghuni baru sekaligus. Baiklah kalau begitu, semua akan tiba pada waktunya."
      Speaker = "Ares"
      Event = "AresAboutUnderworld02"
    }
    {
      Id = "Ares_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa sakit dan kematian menyimpan begitu banyak misteri, Saudaraku. Setiap Satyr, setiap Harpy yang kau renggut nyawanya, pengorbanan mereka memberi kita pelajaran berharga. Dan kau telah belajar dengan begitu lahap; semoga studi kita ini terus berlanjut hingga jauh ke masa depan."
      Speaker = "Ares"
      Event = "AresAboutSacrifice01"
    }
    {
      Id = "Ares_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Teror yang begitu pekat merasuki udara malam ini. Rasanya hampir seperti Dewi Nyx sendiri yang menyentuh sanubari semua penentang kita, begitu membara gairah mereka. Kupikir pertempuran ini bakal berlangsung sengit!"
      Speaker = "Ares"
      Event = "AresAboutShrine01"
    }
    {
      Id = "Ares_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kau merasakan ketakutan tertentu yang menggantung di udara malam ini, Saudaraku? Kutebak iya; barangkali kaulah sumbernya... bukan sekadar dewi Underworld, melainkan dewi dari mimpi buruk itu sendiri."
      Speaker = "Ares"
      Event = "AresAboutShrine02"
    }
    {
      Id = "Ares_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada gejolak berbeda di udara malam ini... kau merasakannya juga, bukan? Pertanda akan adanya kemungkinan besar dan purba. Mari kita wujudkan itu melalui kekuatan murni."
      Speaker = "Ares"
      Event = "AresAboutPackageBounty01"
    }
    {
      Id = "Ares_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuakui bahkan kita para dewa pun bisa tunduk pada kekuatan di luar pengetahuan atau kendali kita. Aku merasakan pengaruh semacam itu sekarang... memperhebat perang akbar kita ini. Memacu kita untuk bertindak."
      Speaker = "Ares"
      Event = "AresAboutPackageBounty02"
    }
    {
      Id = "Ares_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan apa yang sekonyong-konyong membawamu sejauh ini? Mungkin ada dewa-dewa Underworld yang bahkan tak terdeteksi oleh kami; persekutuan yang tak perlu kami ketahui."
      Speaker = "Ares"
      Event = "AresAboutRandomBounties01"
    }
    {
      Id = "Ares_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gagang Pedang yang kau bawa itu dulunya milik seorang prajurit yang menumpahkan banyak darah sebelum darahnya sendiri tertumpah. Bentuknya biasa saja, namun telah ditempa begitu banyak pertempuran hingga aku merasakan ikatan batin; mungkin kau juga merasakannya."
      Speaker = "Ares"
      Event = "AresAboutKeepsake01"
    }
    {
      Id = "Ares_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kini Gagang Pedang yang kuberikan padamu telah menyaksikan begitu banyak pertumpahan darah di bawah genggamanmu, hingga kupikir pemilik aslinya pasti bangga! Setidaknya {#Emph}aku {#Prev}jelas sangat bangga, baik dalam berkontribusi {#Emph}maupun {#Prev}menyaksikannya."
      Speaker = "Ares"
      Event = "AresAboutKeepsake02"
    }
    {
      Id = "Ares_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasakan kau memiliki pusaka dari Sang Kematian Mutlak itu sendiri! Aku sudah beberapa kali berpapasan dengan Lord Moros, karena bidang keahlianku sering kali membutuhkan campur tangannya. Ini pasti masa yang sangat mendebarkan baginya!"
      Speaker = "Ares"
      Event = "AresAboutMorosKeepsake01"
    }
    {
      Id = "Ares_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru saja kembali dari perjalananku, karena tugas-tugasku tak pernah usai. Aku senang melihat keadaan di sini terkendali dengan baik; jauh lebih baik dibanding saat kutinggalkan, dalam banyak hal. Kurasa sebagian besar berkat jasamu?"
      Speaker = "Ares"
      Event = "AresAboutTravels01"
    }
    {
      Id = "Ares_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, awalnya aku enggan terlibat dalam urusan ini. Sebuah perang harus berjalan sesuai takdir alaminya; aku kerap menggerakkan roda peperangan, ya, lalu mengamatinya tanpa memihak. Namun yang satu ini, telah menjadi semacam pengecualian."
      Speaker = "Ares"
      Event = "AresAboutWar01"
    }
    {
      Id = "Ares_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang bisa menjadi hal yang begitu rumit. Aku bisa memicunya, ya, namun tak lama kemudian ia bernyawa sendiri; mungkin mirip seperti membesarkan seorang anak! Dan anak yang sedang kita hadapi ini sudah agak liar, harus kuakui."
      Speaker = "Ares"
      Event = "AresAboutWar02"
    }
    {
      Id = "Ares_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini jelas bukan pertama kalinya keluarga kita terseret ke dalam peperangan. Namun belum pernah kulihat situasi yang menyeret begitu banyak dari kita! Aku masih sedikit tersentuh memikirkannya..."
      Speaker = "Ares"
      Event = "AresAboutWar03"
    }
    {
      Id = "Ares_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengenali senjata-senjata yang kau gunakan itu; Nyx yang agung menceritakannya langsung padaku! Dahagaku akan pengetahuan semacam itu tak pernah terpuaskan, sama halnya seperti Nocturnal Arms yang takkan pernah terpuaskan selama alammu masih tertindas."
      Speaker = "Ares"
      Event = "AresAboutWeapons01"
    }
    {
      Id = "Ares_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengenal saudaraku Hephaestus, ia pasti bisa menyebutkan nama setiap senjata gelapmu itu satu per satu! Namun aku mengenali wujud dan tujuannya, serta ingin melihat seberapa besar kehancuran yang sanggup mereka ciptakan."
      Speaker = "Ares"
      Event = "AresAboutWeapons02"
    }
    {
      Id = "Ares_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, itu baru senjata yang luar biasa! Gada Singa Batu memiliki masa lalu yang berdarah dan legendaris, dan kau akan memperluas warisannya. Aku tak pernah tahu itu adalah salah satu bentuk Nocturnal Arms..."
      Speaker = "Ares"
      Event = "AresAboutNergalAspect01"
    }
    {
      Id = "Ares_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ukiran pada senjatamua mengingatkanku pada Dewi Nyx. Aku tahu ia mengawasi penempaan Nocturnal Arms, tapi apakah ia sendiri pernah menggunakannya...?"
      Speaker = "Ares"
      Event = "AresAboutNyxAspect01"
    }
    {
      Id = "Ares_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengenali sabit berhias yang kau bawa itu; benda itu seharusnya berada di tangan Sang Maut sendiri! Meski di tanganmu, ya cukup pantaslah. Mengira bahwa Thanatos sekalipun bisa disergap oleh sang Titan tanpa sempat bersiap."
      Speaker = "Ares"
      Event = "AresAboutThanatosAspect01"
    }
    {
      Id = "Ares_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, betapa kota Ephyra begitu berbau bangkai dan kematian! Aku praktis bisa menghirup aroma busuknya dari sini. Kini hanya derita dan kenestapaan yang tersisa, kurasa semuanya sudah jauh di luar pertolongan."
      Speaker = "Ares"
      Event = "AresAboutEphyra01"
    }
    {
      Id = "Ares_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini kewajibanku mengharuskanku pergi ke luar negeri, karena hanya sedikit yang bisa kulakukan dari puncak gunung kita yang cukup terisolasi ini. Namun sekarang ada begitu banyak yang harus diurus di rumah sendiri!"
      Speaker = "Ares"
      Event = "AresAboutOlympus01"
    }
    {
      Id = "Ares_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makin banyak perang hebat belakangan ini terjadi di lautan, Saudaraku. Kau dalam beberapa hal memimpin garda depan evolusi seni peperangan ini!"
      Speaker = "Ares"
      Event = "AresAboutThessaly01"
    }
    {
      Id = "Ares_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku putra sulung Raja dan Ratu kita, pengaruhku tak lebih besar dari yang lain. Kita semua menyumbangkan nasihat, namun siapa yang didengar, siapa yang tahu? Aku kerap diingatkan bahwa, dalam perang, diplomasi bisa memegang peranan krusial."
      Speaker = "Ares"
      Event = "AresAboutFamily01"
    }
    {
      Id = "Ares_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah membantai setidaknya seribu Satyr sejauh ini dalam perjuanganmu; sebuah pasukan utuh, kau musnahkan seorang diri! Dan itu hanyalah {#Emph}sebagian kecil {#Prev}dari kemusnahan total yang telah kau ciptakan!"
      Speaker = "Ares"
      Event = "AresAboutSatyrs01"
    }
    {
      Id = "Ares_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perdebatan kami soal berkah siapa yang kau pilih lebih dulu? Sebuah sandiwara berdarah yang memikat dan liar! Perang yang kami kobarkan di dalam keluarga untuk menyelesaikan perselisihan. Sudah menjadi semacam tradisi!"
      Speaker = "Ares"
      Event = "AresAboutDevotionTest01"
    }
    {
      Id = "Ares_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sangatlah wajar merasakan campur aduk perasaan atas hasil akhir dari sebuah perang! Terlebih saat ditolak dari sebuah resolusi kekerasan untuk mengakhiri kemelut kita... meski dari yang kupahami, pertumpahan darah masih akan terus berlanjut."
      Speaker = "Ares"
      Event = "AresPostTrueEnding01"
    }
    {
      Id = "Ares_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang terbaru ini takkan mudah disaingi; harus kuakui sebagian alasannya karena kita para dewa berada di pusatnya. Namun kuyakin perang lain akan melampauinya suatu saat nanti! Selalu ada yang berikutnya."
      Speaker = "Ares"
      Event = "AresPostTrueEnding02"
    }
    {
      Id = "Ares_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita harus terus berperang melawan Titan Chronos namun di {#Emph}waktu {#Prev}yang berbeda? Atau situasi yang berbeda, maksudku... seolah kau belum berhasil menang sebelumnya. Pertarungan tanpa akhir... {#Emph}oh{#Prev}, Saudaraku."
      Speaker = "Ares"
      Event = "AresPostTrueEndingAboutChronos01"
    }
    {
      Id = "Ares_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu, berapa banyak Chronos gadungan yang sedang kita hadapi ini? Membayangkan kita akan membinasakan mereka semua, satu demi satu. Namun tiada dua pertempuran yang serupa!"
      Speaker = "Ares"
      Event = "AresPostTrueEndingAboutChronos02"
    }
    {
      Id = "Ares_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar entah bagaimana kau masih mampu berhadapan dengan Ayah Segala Monster di sini! Kalau begitu jiwanya yang penuh murka masih berdiam di ceruk waktu yang gelap. Betapa inginnya aku menyaksikan wujudnya di sana!"
      Speaker = "Ares"
      Event = "AresPostTrueEndingAboutTyphon01"
    }
    {
      Id = "Ares_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Moirae akhirnya ditemukan? Dan mereka berniat rehat sejenak dari segala manipulasi pusaka mereka? Aku tak sepenuhnya percaya, tapi... perang akan jauh lebih mendebarkan jika para pemenangnya tak pernah ditentukan sejak awal."
      Speaker = "Ares"
      Event = "AresPostEpilogue01"
    }
    {
      Id = "Ares_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiada yang menandingi kenikmatan menyaksikan pembantaian musuh sendiri, tidakkah kau setuju?"
      Speaker = "Ares"
      Event = "AresChat01"
    }
    {
      Id = "Ares_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di mana pun darah tertumpah, kau bisa yakin bahwa aku setidaknya tertarik, jika tak ikut campur tangan."
      Speaker = "Ares"
      Event = "AresChat02"
    }
    {
      Id = "Ares_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fana semuanya pasti mati; aku hanya berharap mereka menjemputnya dengan cara yang pantas."
      Speaker = "Ares"
      Event = "AresChat03"
    }
    {
      Id = "Ares_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada konflik-konflik tertentu yang hanya bisa diselesaikan dengan kekerasan; tak perlu menahan gejolak itu."
      Speaker = "Ares"
      Event = "AresChat04"
    }
    {
      Id = "Ares_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di mana pun ada gelombang kematian, aku selalu mencarinya, dan akhir-akhir ini, di sanalah dirimu berada."
      Speaker = "Ares"
      Event = "AresChat05"
    }
    {
      Id = "Ares_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehidupan menyebar bagai wabah di seluruh dunia ini, namun ada cara-cara tertentu untuk menjaga alirannya tetap terkendali."
      Speaker = "Ares"
      Event = "AresChat06"
    }
    {
      Id = "Ares_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiada satu pun perang yang abadi, namun tiada satu pun perang yang akan jadi yang terakhir."
      Speaker = "Ares"
      Event = "AresChat07"
    }
    {
      Id = "Ares_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa ringannya musuh-musuhmu menyerahkan diri mereka untuk dibantai, berulang-ulang kali bermandikan darah."
      Speaker = "Ares"
      Event = "AresChat08"
    }
    {
      Id = "Ares_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa sakit dan penderitaan cenderung mereda, jadi biarlah ini menjadi pengingat bagi semua yang terlibat."
      Speaker = "Ares"
      Event = "AresChat09"
    }
    {
      Id = "Ares_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertumpahan darah sering kali bisa dihindari, namun aku tak pernah ingin melewatkan kesempatan semacam itu."
      Speaker = "Ares"
      Event = "AresChat10"
    }
    {
      Id = "Ares_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zaman yang sungguh luar biasa kita tinggali ini, manakala orang mati pun masih bisa merasakan kepenuhan dari perang."
      Speaker = "Ares"
      Event = "AresChat11"
    }
    {
      Id = "Ares_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita nikmati saat-saat ini selagi abu kehancuran mulai mengendap."
      Speaker = "Ares"
      Event = "AresChat12"
    }
    {
      Id = "Ares_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah orang mati menghantui setiap medan pertempuran, bukan? Barangkali kau bahkan bisa melihat mereka di sana."
      Speaker = "Ares"
      Event = "AresChat13"
    }
    {
      Id = "Ares_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang berakar dalam hakikat kita sendiri, maka janganlah ditolak, melainkan dekaplah."
      Speaker = "Ares"
      Event = "AresChat14"
    }
    {
      Id = "Ares_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekerasan tak selalu mengakhiri konflik, namun bisa meredakannya hingga mendidih tenang untuk sementara waktu."
      Speaker = "Ares"
      Event = "AresChat15"
    }
    {
      Id = "Ares_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap pertempuranmu adalah pemandangan yang memikat untuk disaksikan, wahai kerabat dari neraka."
      Speaker = "Ares"
      Event = "AresChat16"
    }
    {
      Id = "Ares_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak perang lenyap ditelan waktu, namun perang yang satu ini barangkali tak akan lekas dilupakan."
      Speaker = "Ares"
      Event = "AresChat17"
    }
    {
      Id = "Ares_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang yang berkobar di permukaan, dan di bawah sana... kita telah melampaui diri kita sendiri, kerabatku."
      Speaker = "Ares"
      Event = "AresChat18"
    }
    {
      Id = "Ares_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Janganlah kita meneruskan pertumpahan darah ini semata-mata demi pembalasan dendam; ada banyak alasan lain yang sama agungnya."
      Speaker = "Ares"
      Event = "AresChat19"
    }
    {
      Id = "Ares_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian orang menganggap karyaku mengerikan! Kau telah menyaksikannya secara langsung, dan mengetahui kebenarannya."
      Speaker = "Ares"
      Event = "AresChat20"
    }
    {
      Id = "Ares_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak pertempuran yang harus diperjuangkan! Terkadang bisa terasa amat membebani, aku paham itu."
      Speaker = "Ares"
      Event = "AresChat21"
    }
    {
      Id = "Ares_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemenangan dalam perang terasa manis getir; namun akhir dari segala hal memang jarang menjadi bagian terbaiknya."
      Speaker = "Ares"
      Event = "AresChat22"
    }
    {
      Id = "Ares_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin tampak tiada hasil yang sempurna dalam karyaku, walau barangkali kelak kau akan memandangnya seperti diriku."
      Speaker = "Ares"
      Event = "AresChat23"
    }
    {
      Id = "Ares_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku mengagumi efisiensimu, luangkanlah sejenak waktu untuk meresapi ketenangan setelah badai mereda."
      Speaker = "Ares"
      Event = "AresChat24"
    }
    {
      Id = "Ares_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap malam memberi kita peluang baru untuk melangsungkan pembantaian lewat cara-cara yang sepenuhnya baru."
      Speaker = "Ares"
      Event = "AresChat25"
    }
    {
      Id = "Ares_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk konflik-konflik terbesar, aku selalu bersedia mempersembahkan jasaku, dan menghasilkan penyelesaian yang memuaskan nalar."
      Speaker = "Ares"
      Event = "AresChat26"
    }
    {
      Id = "Ares_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita semua memiliki hasrat untuk bertarung, bukankah begitu? Aku hanya ingin kita lebih jujur pada diri kita sendiri."
      Speaker = "Ares"
      Event = "AresChat27"
    }
    {
      Id = "Ares_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertempuranmu malam ini baru saja bermula, dan aku tak ingin melewatkan satu pun pembantaian."
      Speaker = "Ares"
      Event = "AresChat28"
    }
    {
      Id = "Ares_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika memang darah harus tertumpah malam ini, marilah kita pastikan setiap tetesnya berharga."
      Speaker = "Ares"
      Event = "AresChat29"
    }
    {
      Id = "Ares_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana lagi cara kita menegakkan kekuasaan atas dunia ini, jika bukan melalui kekerasan?"
      Speaker = "Ares"
      Event = "AresChat30"
    }
    {
      Id = "Ares_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekerasan tak selalu mutlak diperlukan, namun sering kali berhasil."
      Speaker = "Ares"
      Event = "AresChat31"
    }
    {
      Id = "Ares_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa pun yang bilang bahwa kekerasan tak pernah menyelesaikan apa pun, kemungkinan besar tak pernah mencobanya sama sekali!"
      Speaker = "Ares"
      Event = "AresChat32"
    }
    {
      Id = "Ares_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga kau membantai semua penentangmu dengan efisiensi atau kekejaman sesuka hatimu."
      Speaker = "Ares"
      Event = "AresChat33"
    }
    {
      Id = "Ares_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bumi mereguk rakus darah yang kau tumpahkan, dan aku ingin melihatmu memuaskan dahaganya."
      Speaker = "Ares"
      Event = "AresChat34"
    }
    {
      Id = "Ares_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak musuh di alam ayahmu tak berdaging dan berdarah, tapi mereka pun cukuplah."
      Speaker = "Ares"
      Event = "AresChat35"
    }
    {
      Id = "Ares_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membayangkan perang bisa berkobar bahkan di bawah bumi; betapa masa-masa yang menggairahkan!"
      Speaker = "Ares"
      Event = "AresChat36"
    }
    {
      Id = "Ares_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berniat merintis jalan berdarah lagi menuju puncak gunung kami? Kalau begitu, aku ingin sekali menyaksikannya!"
      Speaker = "Ares"
      Event = "AresChat37"
    }
    {
      Id = "Ares_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sisa-sisa legiun Sang Titan memiliki dahaga perang yang kurasa patut dihormati."
      Speaker = "Ares"
      Event = "AresChat38"
    }
    {
      Id = "Ares_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang bukan untuk mereka yang lemah dan berhati ciut, tapi kulihat kau punya selera sejati untuk itu."
      Speaker = "Ares"
      Event = "AresChat39"
    }
    {
      Id = "Ares_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat menantikan metode apa yang kau gunakan untuk membantai musuh-musuhmu setiap malam!"
      Speaker = "Ares"
      Event = "AresChat40"
    }
    {
      Id = "Ares_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kita butuh semacam seruan perang malam ini, Saudaraku. Apakah {#Emph}bantai mereka semua {#Prev}sudah cukup?"
      Speaker = "Ares"
      Event = "AresChat41"
    }
    {
      Id = "Ares_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah! {#Prev}Tampaknya pesan ini berhasil terkirim dalam kerahasiaan mutlak! Kita semestinya lebih sering mengambil tindakan pencegahan seperti ini, meski mungkin akan menghambat kemampuanmu menyusun rencana."
      Speaker = "Ares"
      Event = "AresBlindBox01"
    }
    {
      Id = "Ares_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu terkejut mendapati diriku begini. Keluarga kita sering mengambil pendekatan yang lebih lugas, tapi aku tak keberatan mengintai dalam bayang-bayang; aku malah cukup menikmatinya."
      Speaker = "Ares"
      Event = "AresBlindBox02"
    }
    {
      Id = "Ares_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam perang, seseorang harus bersiap menghadapi {#Emph}segala {#Prev}kemungkinan. Bisa saja tadi kerabatmu yang lain yang mengulurkan Berkah mereka, tapi aku bergegas mengambil tindakan tegas menggantikan mereka."
      Speaker = "Ares"
      Event = "AresBlindBox03"
    }
    {
      Id = "Ares_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berkah kami sulit untuk ditolak, bukan? Bahkan tanpa tahu berkah apa yang akan kau dapatkan, apalagi milik siapa, kau selalu bersedia membayar harga sang Tukang Perahu."
      Speaker = "Ares"
      Event = "AresBlindBox04"
    }
    {
      Id = "Ares_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tukang perahu sungai itu mungkin tak lagi mengantar jiwa-jiwa ke Dunia Bawah, namun ia menjadi sangat berharga bagi upaya perang yang tengah berlangsung. Ia cukup lihai menggunakan dayungnya itu!"
      Speaker = "Ares"
      Event = "AresLootBought01"
    }
    {
      Id = "Ares_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada saat-saat di mana aku sendiri yang membayar ongkos sang tukang perahu, saking banyaknya jiwa yang kukirim sekaligus ke Dunia Bawah! Masa-masa yang indah."
      Speaker = "Ares"
      Event = "AresLootBought02"
    }
    {
      Id = "Ares_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang takkan bisa bertahan jika jalur pasokan terputus terlalu lama; maka aku sangat berterima kasih pada Tukang Perahumu, karena aku takkan bisa menghubungimu sekarang jika bukan berkat dirinya."
      Speaker = "Ares"
      Event = "AresLootBought03"
    }
    {
      Id = "Ares_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Emas adalah logam yang memikat, bukan? Kaum fana kerap bertarung dan membunuh demi benda itu. Hanya Batu Permata paling langka dari wilayah kekuasaan ayahmu yang lebih memikat hati mereka!"
      Speaker = "Ares"
      Event = "AresLootBought04"
    }
    {
      Id = "Ares_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sadar apa artinya ini, bukan, Saudaraku? Aku yakin aku bahkan tak perlu mengucapkannya."
      Speaker = "Ares"
      Event = "AresRejection01"
    }
    {
      Id = "Ares_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perang sengit terkadang dilancarkan demi hal yang lebih sepele; benar-benar bukan masalah besar sama sekali."
      Speaker = "Ares"
      Event = "AresRejection02"
    }
    {
      Id = "Ares_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin ini murni kesalahpahaman belaka, meski aku cenderung menduga adanya niat jahat."
      Speaker = "Ares"
      Event = "AresRejection03"
    }
    {
      Id = "Ares_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kerabatku yang lain terkadang juga mengabaikanku, dan lihatlah ke mana {#Emph}hal itu {#Prev}membawa mereka."
      Speaker = "Ares"
      Event = "AresRejection04"
    }
    {
      Id = "Ares_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau benar-benar ingin berperang denganku, kau akan dapati aku dengan senang hati menyambutnya."
      Speaker = "Ares"
      Event = "AresRejection05"
    }
    {
      Id = "Ares_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sungguh bersimpati padamu, Saudaraku; tak ada jalan lain selain memilih kubu, lalu menanggung akibatnya."
      Speaker = "Ares"
      Event = "AresRejection06"
    }
    {
      Id = "Ares_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bohong jika kubilang tak ada kenikmatan dalam melakukan apa yang kini harus kulakukan, Saudaraku."
      Speaker = "Ares"
      Event = "AresRejection07"
    }
    {
      Id = "Ares_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak mendendam atas keputusanmu; aku justru sangat berterima kasih, karena itu artinya aku bisa melakukan {#Emph}ini{#Prev}."
      Speaker = "Ares"
      Event = "AresRejection08"
    }
    {
      Id = "Ares_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudaraku tersayang pernah dipilih menggantikanku sebelumnya, dan aku pun tak menyukainya saat itu."
      Speaker = "Ares"
      Event = "AresRejection09"
    }
    {
      Id = "Ares_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun akan memilih hal yang serupa jika berada di posisimu, namun aku tetap punya harga diri."
      Speaker = "Ares"
      Event = "AresRejection10"
    }
    {
      Id = "Ares_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihan bijak berpihak pada Aphrodite, meski untuk saat ini kau telah menjadikan {#Emph}aku {#Prev}sebagai musuhmu."
      Speaker = "Ares"
      Event = "AresRejection11"
    }
    {
      Id = "Ares_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin sebuah pilihan yang penuh perhitungan. Namun bukan berarti bebas dari konsekuensi berdarah."
      Speaker = "Ares"
      Event = "AresRejection12"
    }
    {
      Id = "Ares_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertunjukan luar biasa yang pantas bagi garis keturunan kita! Kau layak diberi ganjaran atas semua itu."
      Speaker = "Ares"
      Event = "AresMakeUp01"
    }
    {
      Id = "Ares_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang aku suka menguntungkan pihak yang kalah, untuk memberi mereka harapan palsu."
      Speaker = "Ares"
      Event = "AresMakeUp02"
    }
    {
      Id = "Ares_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu, apakah musuh-musuh tololmu sempat mengira mereka telah berhasil menyudutkanmu?"
      Speaker = "Ares"
      Event = "AresMakeUp03"
    }
    {
      Id = "Ares_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Unjuk permusuhan sesekali hanyalah cara kita menegaskan keberadaan diri, Saudaraku."
      Speaker = "Ares"
      Event = "AresMakeUp04"
    }
    {
      Id = "Ares_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak pertempuran yang harus diperjuangkan, namun terkadang aku tak kuasa menahan diri..."
      Speaker = "Ares"
      Event = "AresMakeUp05"
    }
    {
      Id = "Ares_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, tapi itu barusan sungguh luar biasa, walau mungkin yang terbaik malam ini belum tiba."
      Speaker = "Ares"
      Event = "AresMakeUp06"
    }
    {
      Id = "Ares_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah memuaskan hasratku akan pembalasan dendam, atau setidaknya dahagaku akan darah. Untuk saat ini."
      Speaker = "Ares"
      Event = "AresMakeUp07"
    }
    {
      Id = "Ares_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan tak ada yang selamat dari bentrokan itu, selain dirimu. Hasil yang sungguh memuaskan."
      Speaker = "Ares"
      Event = "AresMakeUp08"
    }
    {
      Id = "Ares_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagi pemenang pertempuran, sebuah ganjaran. Dan aku sendiri pun disuguhi tontonan yang amat memukau."
      Speaker = "Ares"
      Event = "AresMakeUp09"
    }
    {
      Id = "Ares_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugasku terkadang menuntutku untuk berseberangan dengan kerabatku sendiri. Kau paham betul soal itu, bukan?"
      Speaker = "Ares"
      Event = "AresMakeUp10"
    }
    {
      Id = "Ares_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini hanyalah pertempuran kecil yang tak berarti, namun demikian, sungguh sangat menyenangkan."
      Speaker = "Ares"
      Event = "AresMakeUp11"
    }
    {
      Id = "Ares_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh-musuhmu mengira mereka punya peluang; optimisme semacam itu tak henti-hentinya membuatku terpikat."
      Speaker = "Ares"
      Event = "AresMakeUp12"
    }
    {
      Id = "MelinoeField_2962"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Ares, aku tahu para prajurit fana kerap memberi persembahan kepadamu sebelum bertarung hidup dan mati. Aku pun ingin menunjukkan rasa hormatku. Tiada ampun bagi musuh kita!"
      Speaker = "Melinoe"
      Event = "AresGift01"
    }
    {
      Id = "Ares_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan menerima penghormatan seperti ini tanpa memberi balasan, terlebih dari seseorang yang memahami panggilanku. Senjata hidup sepertimu sudah sepatutnya memiliki {#Emph}ini."
      Speaker = "Ares"
      Event = "AresGift01"
    }
    {
      Id = "MelinoeField_2964"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan kuasaku untuk menentukan berapa banyak pertempuran yang tersisa bagiku; namun mengetahui aku mendapat dukunganmu amatlah berarti, Tuanku. Semoga kita dapat segera menuntaskan segala tujuan kita."
      Speaker = "Melinoe"
      Event = "AresGift02"
    }
    {
      Id = "Ares_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar semacam ini biasanya ditahan hingga kemenangan tiba. Meski dalam banyak hal, kurasa kita sudah menang! Setidaknya bagiku; dan untuk itu, aku akan meluangkan waktu sejenak untuk menikmatinya baik-baik."
      Speaker = "Ares"
      Event = "AresGift02"
    }
    {
      Id = "MelinoeField_2965"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiada perang yang abadi, namun kita akan selalu menjadi keluarga, bukan begitu, Tuanku? Ini hanyalah sekadar pengingat sederhana bahwa ada hal lain yang menyatukan kita selain sensasi pertempuran."
      Speaker = "Melinoe"
      Event = "AresGift03"
    }
    {
      Id = "Ares_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah memberiku anugerah yang jauh lebih berharga daripada Nektar murni ini sekalipun, yang tentu saja sangat kuhargai. Namun pembantaian yang telah kau perbuat sejauh ini... sungguh tiada tandingannya."
      Speaker = "Ares"
      Event = "AresGift03"
    }
    {
      Id = "MelinoeField_3378"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan ada saat-saat di mana gelora pertempuran seolah melahap habis jiwaku; perasaan yang dulu sempat kucoba tekan. Namun kini kusadari hal itu menuntun pada kemenangan... dan juga dirimu, {#Emph}Tuanku."
      Speaker = "Melinoe"
      Event = "AresGift04"
    }
    {
      Id = "Ares_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu kupikir tak ada seorang pun di keluarga kita yang memiliki kegemaran serupa denganku. Dalam hal ini, aku sungguh senang telah keliru besar. Kapan pun hasrat untuk menebar maut merasukimu, ketahuilah bahwa aku akan selalu ada di sana."
      Speaker = "Ares"
      Event = "AresGift04"
    }
    {
      Id = "MelinoeField_3669"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak tahu apa yang harus kuharapkan darimu sebelum kita bersua, Tuan Ares... namun kurasa kau memiliki kejujuran lugas yang tidak dimiliki orang lain. Terima kasih karena selalu berterus terang padaku."
      Speaker = "Melinoe"
      Event = "AresGift05"
    }
    {
      Id = "Ares_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, aku jarang menerima persembahan semacam ini karena pembawaanku. Banyak yang begitu {#Emph}mudah {#Prev}goyah oleh kejujuran dan luapan gairah; namun tampaknya tidak bagimu, saudaraku."
      Speaker = "Ares"
      Event = "AresGift05"
    }
    {
      Id = "MelinoeField_3670"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bertanya-tanya, Tuan Ares, ketika kaum fana di pihak yang berseteru sama-sama berdoa kepadamu demi kemenangan, bagaimana caramu memilih siapa yang diberkahi? Kuyakini persembahan ini tak serumit itu."
      Speaker = "Melinoe"
      Event = "AresGift06"
    }
    {
      Id = "Ares_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemberian semacam itu kusambut baik hingga batas tertentu. Kaum fana percaya mereka bisa merebut kemurahanku, padahal tekad bertarung mereka sendirilah yang paling menentukan seberapa cepat ajal menjemput. Kuhargai ketertarikanmu pada rincian-rincian kecil semacam ini!"
      Speaker = "Ares"
      Event = "AresGift06"
    }
    {
      Id = "MelinoeField_3671"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi semua kejayaan kita di masa lalu maupun yang akan datang, Tuan Ares! Namun Ambrosia ini bukan sekadar untuk itu... Aku tahu kau pun belajar dari kepedihan rasa kalah dan kehancuran. Dalam hal ini khususnya, kurasa kita amat serupa."
      Speaker = "Melinoe"
      Event = "AresGift07"
    }
    {
      Id = "Ares_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun merasakan hal yang sama, saudaraku yang lahir dari neraka. Keluarga kita cenderung terlalu terpaku pada kemenangan; mereka enggan menatap kegagalan dan kekalahan tanpa gentar, padahal di sanalah pemahaman yang lebih dalam bersemayam. Dalam hal ini dan banyak hal lainnya, kau adalah perkecualian yang menyenangkan."
      Speaker = "Ares"
      Event = "AresGift07"
    }
    {
      Id = "MelinoeField_2963"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pemberian ini kuterima darimu, Tuanku."
      Speaker = "Melinoe"
      Event = "AresUpgrade.GiftGivenVoiceLines"
    }
    {
      Id = "Ares_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semuanya akan menderita!"
      Speaker = "Ares"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Ares_0112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kobarkan {#Emph}perang!"
      Speaker = "Ares"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Ares_0113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekerasan dan kehancuran!"
      Speaker = "Ares"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Ares_0204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita tumpahkan {#Emph}darah!"
      Speaker = "Ares"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Ares_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sungguh benar-benar {#Emph}bejat!"
      Speaker = "Ares"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Ares_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak punyakah kau rasa {#Emph}sopan santun?!"
      Speaker = "Ares"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Ares_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cemooh aku jika kau {#Emph}berani!"
      Speaker = "Ares"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "ErisField_0477"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa barusan itu {#Emph}Ares?!"
      Speaker = "Eris"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "ErisField_0478"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ares{#Prev}, itukah {#Emph}dirimu?!"
      Speaker = "Eris"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang dewa perang yang bengis..."
      Speaker = "Chronos"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kutunjukkan pada Ares itu perang yang sesungguhnya..."
      Speaker = "Chronos"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zagreus_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ares, ini {#Emph}aku!"
      Speaker = "Zagreus"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zagreus_0369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ayolah{#Prev}, Ares...!"
      Speaker = "Zagreus"
      Event = "AresUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Ares_0096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau berada di pihakku atau melawanku, saudaraku; tiada jalan tengah."
      Speaker = "Ares"
      Event = "AresUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Ares_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pasti mengira perang kecil ini akan berjalan sesuai kehendak{#Emph}mu{#Prev}."
      Speaker = "Ares"
      Event = "AresUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Ares_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah kodratku untuk tak kenal belas kasih, apa aku belum menjelaskannya?"
      Speaker = "Ares"
      Event = "AresUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Ares_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
