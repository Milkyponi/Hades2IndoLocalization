{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Odysseus.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_1707"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kematian bagi Chronos, Tuan."
      Speaker = "Melinoe"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam juga!"
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0215"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam hangat!"
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam hangat, Dewi."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pasti akan menghabisinya nanti."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia akan dapat balasannya."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, andai saja begitu."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0218"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga sama."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0317"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga bayang-bayang melindungimu."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pula dirimu."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan semoga kau menang."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita pasti temukan jalan keluar."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepakat soal itu."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita pasti lalui ini bersama."
      Speaker = "Odysseus"
      Event = "NPC_Odysseus_01.InteractVoiceLines"
    }
    {
      Id = "Odysseus_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan padaku kau sudah membunuh bajingan itu? Menghujamkan tongkatmu ke tengkorak celakanya, menancapkan belati ke perutnya? {#Emph}Eh{#Prev}, bukan berarti dia bakal mati gara-gara itu; tapi kalau manusia fana sih pasti tewas!"
      Speaker = "Odysseus"
      Event = "OdysseusFirstMeeting"
    }
    {
      Id = "Melinoe_0016_C"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos sang Titan Waktu sudah binasa, Odysseus. Kepalanya ada di tanganku sekarang! Setidaknya... andai saja memang begitu."
      Speaker = "Melinoe"
      Event = "OdysseusFirstMeeting"
    }
    {
      Id = "Odysseus_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, kurasa lain kali kau pasti bisa menghabisinya."
      Speaker = "Odysseus"
      Event = "OdysseusFirstMeeting"
    }
    {
      Id = "Odysseus_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir hebat kita di sana tahu betul perjalananmu masih mendaki gunung yang teramat terjal, Dewi. Pernah dengar soal gunung-gunung di permukaan? Bebatuan raksasa yang menjulang tinggi?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutMountains01"
    }
    {
      Id = "Melinoe_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu seperti Gunung Olimpus, atau Gunung Othrys? Tentu saja aku pernah dengar! Ketinggiannya menembus langit. Aku hanya bisa membayangkannya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutMountains01"
    }
    {
      Id = "Odysseus_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau menatap ke puncak dari dasarnya, kau pasti yakin itu mustahil didaki, {#Emph}tapi! {#Prev}Jika kau hanya berfokus pada langkah berikutnya... kau pasti akan tiba di puncaknya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMountains01"
    }
    {
      Id = "Melinoe_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai ke puncak..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutMountains01"
    }
    {
      Id = "Odysseus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bajingan-bajingan berduri yang kau hadapi itu... jumlah mereka makin bertambah di setiap laporan yang kuterima. Kalau kau punya saran agar kami bisa mempersiapkanmu lebih baik lagi..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutErebus01"
    }
    {
      Id = "Melinoe_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan kusampaikan pendapatku bila perlu, Odysseus. Untuk saat ini, aku masih menimbangnya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutErebus01"
    }
    {
      Id = "Odysseus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, lebih baik memang tidak asal bicara tanpa persiapan. Aku paham betul rasanya. Tapi tolong kabari perkembangannya, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutErebus01"
    }
    {
      Id = "Melinoe_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Melinoe"
      Event = "OdysseusAboutErebus01"
    }
    {
      Id = "Odysseus_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau menemui masalah gawat di luar sana, datanglah bicara padaku. Kemungkinan besar aku sudah pernah melihatnya, melawannya, atau meloloskan diri darinya, jadi aku bisa memberi sedikit masukan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutAdvice01"
    }
    {
      Id = "Melinoe_0450"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti."
      Speaker = "Melinoe"
      Event = "OdysseusAboutAdvice01"
    }
    {
      Id = "Odysseus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau harus waspada terhadap siapa pun yang kau temui di sana, paham? Kalau ada yang masih hidup dan cari gara-gara denganmu, kau tahu di mana bagian tubuhnya yang paling sakit untuk dipukul."
      Speaker = "Odysseus"
      Event = "OdysseusMeeting05"
    }
    {
      Id = "Melinoe_0451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja aku tahu."
      Speaker = "Melinoe"
      Event = "OdysseusMeeting05"
    }
    {
      Id = "Melinoe_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah lama mengenal Kepala Sekolah, bukan? Di mana kalian pertama kali bertemu, aku selalu ingin menanyakannya?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutHecate01"
    }
    {
      Id = "Odysseus_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh{#Prev}, begini. Yang bisa kukatakan adalah bahwa saat itu aku... sendirian. Di pengujung satu kehidupan, dan di awal kehidupan yang lain. Tersesat. Lalu beliau muncul di hadapanku dengan segala keagungannya, dan... menunjukkan jalan yang tak pernah kulihat sebelumnya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutHecate01"
    }
    {
      Id = "Melinoe_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terdengar sangat puitis dan kiasan. Waktu itu kau sudah mati?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutHecate01"
    }
    {
      Id = "Odysseus_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang sudah. Beliau bilang bisa memberiku kehidupan baru. Beliau butuh seorang taktisi yang paham seluk-beluk permukaan. Kupikir, siapa aku berani-beraninya menolak seorang dewi? Aku pun mengikutinya. Dan itu sudah berlangsung cukup lama sekarang."
      Speaker = "Odysseus"
      Event = "OdysseusAboutHecate01"
    }
    {
      Id = "Melinoe_0458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti sudah sangat lama."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHecate01"
    }
    {
      Id = "Odysseus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir hebat itu mengujimu habis-habisan di luar sana, ya? Dari dulu kupikir gaya mengajarnya cukup intens. Beliau menaruh harapan besar padamu, tapi wajar saja jika potensimu memang sebesar itu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutLosingToHecate01"
    }
    {
      Id = "Melinoe_2185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu dia pasti kecewa dengan hasilku, meski dia pintar menyembunyikannya. Sama sepertimu, Odysseus."
      Speaker = "Melinoe"
      Event = "OdysseusAboutLosingToHecate01"
    }
    {
      Id = "Odysseus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, aku tahu betapa mengecewakannya memetakan arah perjalanan, tapi akhirnya malah tersesat. Kita jarang bisa sampai ke tempat tujuan lewat jalan tercepat."
      Speaker = "Odysseus"
      Event = "OdysseusAboutLosingToHecate01"
    }
    {
      Id = "Melinoe_2186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang terpenting kita bisa sampai ke sana pada akhirnya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutLosingToHecate01"
    }
    {
      Id = "Odysseus_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan Dewi Artemis benar-benar kekuatan tempur yang hebat di luar sana, setidaknya menurut kabar burung. Dan kalian bernyanyi bersama dengan sangat merdu pula...! Jadi Olympus mengirimnya untuk memantau kita, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutArtemis01"
    }
    {
      Id = "Melinoe_4102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa begitu, ya. Tapi aku percaya sepenuhnya padanya kalau itu yang kau khawatirkan. Dia hanya memberi tahu Olympus hal-hal yang perlu mereka tahu agar mereka tetap tenang soal kerja sama kita."
      Speaker = "Melinoe"
      Event = "OdysseusAboutArtemis01"
    }
    {
      Id = "Odysseus_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia memang orang yang cukup berhati-hati, bukan? Yah, kalau menurutku, aku senang kau punya sekutu... sekaligus seorang kawan pada dirinya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutArtemis01"
    }
    {
      Id = "Melinoe_4103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu juga denganku."
      Speaker = "Melinoe"
      Event = "OdysseusAboutArtemis01"
    }
    {
      Id = "Melinoe_3333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, ke mana Hecuba dan Gale pergi? Aku ingin bertanya pada Guru, tapi dia tidak suka kalau aku terlalu mencemaskan Hewan Mistisnya. {#Emph}Mereka baik-baik saja, Melinoë."
      Speaker = "Melinoe"
      Event = "OdysseusAboutFamiliars01"
    }
    {
      Id = "Odysseus_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, mereka mungkin {#Emph}memang {#Prev}baik-baik saja! Masing-masing pergi menjalankan ekspedisi pengintaian kecil atas perintahku, tentu saja di bawah naungan penyihir agung kita. Sang anjing ke satu arah, sang cerpelai ke arah lainnya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutFamiliars01"
    }
    {
      Id = "Melinoe_3334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ekspedisi pengintaian kecil itu sepertinya selalu memakan waktu cukup lama. Kalau begitu, aku harus terus mengawasi sekitar barangkali melihat mereka."
      Speaker = "Melinoe"
      Event = "OdysseusAboutFamiliars01"
    }
    {
      Id = "Odysseus_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana pun mereka pergi, mereka pasti senang melihat wajah yang bersahabat."
      Speaker = "Odysseus"
      Event = "OdysseusAboutFamiliars01"
    }
    {
      Id = "Odysseus_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar burung mengatakan Eris terlihat di kedalaman sepanjang jalurmu... informasi yang kemungkinan bisa kau gunakan {#Emph}sebelum {#Prev}dia mempersulit perjalananmu. Mohon maaf, Dewi..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutErisCurse01"
    }
    {
      Id = "Melinoe_3096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia mencoba menghentikanku, atau setidaknya memperlambat langkahku. Dan... dia tahu terlalu banyak tentang rencana kita. Apa yang harus kita lakukan? Anak-anak Nyx seharusnya berada di pihak {#Emph}kita."
      Speaker = "Melinoe"
      Event = "OdysseusAboutErisCurse01"
    }
    {
      Id = "Odysseus_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia bahkan tidak tahu {#Emph}separuh {#Prev}dari apa yang telah kita rencanakan. Lagi pula, dia hanya bertindak karena bosan, tidak lebih. Berpapasanlah dengannya beberapa kali lagi, dia pasti akan segera muak lalu pergi sendiri."
      Speaker = "Odysseus"
      Event = "OdysseusAboutErisCurse01"
    }
    {
      Id = "Melinoe_3097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu menurut pertimbangan Sang Ahli Taktik Hebat...?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutErisCurse01"
    }
    {
      Id = "Odysseus_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar begitu, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusAboutErisCurse01"
    }
    {
      Id = "Melinoe_3335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau pernah memergoki Eris mengintip rencana kita atau semacamnya? Kita harus lebih berhati-hati lagi di dekatnya..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutEris01"
    }
    {
      Id = "Odysseus_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia kebanyakan hanya berdiam di sudut kecilnya, Dewi, tapi aku selalu mengawasinya untuk berjaga-jaga. Selama dia berusaha merusak upaya kita di luar jarak pendengaran..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutEris01"
    }
    {
      Id = "Melinoe_3336"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maksudmu, kita bisa membuat rencana untuk mengantisipasinya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutEris01"
    }
    {
      Id = "Odysseus_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali."
      Speaker = "Odysseus"
      Event = "OdysseusAboutEris01"
    }
    {
      Id = "Odysseus_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus, kau sudah kembali. Menurut laporan, Eris terbang menuju Celah Thessaly untuk mencegat armada kapal. Tapi kurasa dia menuju ke sana bukan untuk membantu. Setidaknya, bukan membantu{#Emph}mu{#Prev}."
      Speaker = "Odysseus"
      Event = "OdysseusAboutErisBoss01"
    }
    {
      Id = "Melinoe_3311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Laporan-laporan ini tidak banyak berguna bagiku setelah semuanya terjadi. Tapi setidaknya aku bisa memastikan laporannya akurat. Sungguh konyol bahwa kita tidak bisa menyingkirkannya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutErisBoss01"
    }
    {
      Id = "Odysseus_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita hanya bisa memanfaatkan apa yang kita miliki. Aku minta maaf karena kami tidak bisa memperingatkanmu sebelumnya kali ini. Kami akan terus menyelidiki motif dan kaki tangannya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutErisBoss01"
    }
    {
      Id = "Melinoe_3312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tidak yakin dia punya salah satu dari keduanya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutErisBoss01"
    }
    {
      Id = "Odysseus_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris membuat masalah lagi untukmu di permukaan, ya... padahal sudah begitu dekat dengan tujuanmu. Yah, kalau ini bisa sedikit menenangkanmu, kita memahami cara kerja senjatanya lebih baik daripada dia sendiri. Dia pasti sering kehabisan amunisi..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutErisBossTactics01"
    }
    {
      Id = "Melinoe_4213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia memang begitu. Kadang mekanismenya macet, lalu dia teralihkan saat mencoba memperbaikinya. Aku harus memanfaatkan kesempatan itu untuk menyerang. Lagipula tidak banyak tempat untuk berlindung di sana."
      Speaker = "Melinoe"
      Event = "OdysseusAboutErisBossTactics01"
    }
    {
      Id = "Odysseus_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia berusaha mengintimidasi dirimu. Dengan Senapan Adamant, dia jauh lebih berbahaya dari kejauhan. Mungkin kau bisa mengepungnya dari samping atau mengakali pergerakannya..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutErisBossTactics01"
    }
    {
      Id = "Melinoe_4214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Boleh juga dicoba."
      Speaker = "Melinoe"
      Event = "OdysseusAboutErisBossTactics01"
    }
    {
      Id = "Odysseus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suasana hati Nemesis sedang sangat buruk akhir-akhir ini. Ada sesuatu yang perlu kuketahui?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutNemesis01"
    }
    {
      Id = "Melinoe_2212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadinya aku ingin menanyakan hal yang sama padamu. Dia menginginkan tugasku, tapi itu bukan hal baru. Meski begitu, dia semakin sering berselisih dengan Guru belakangan ini..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutNemesis01"
    }
    {
      Id = "Odysseus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, sayang sekali harus begini. Secara pribadi, aku lebih memilih Pembalasan Ilahi berpihak pada kita ketimbang melawan kita. Kurasa kau tidak bisa begitu saja berdamai dengannya, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutNemesis01"
    }
    {
      Id = "Melinoe_2213"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku meragukannya..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutNemesis01"
    }
    {
      Id = "Odysseus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, bagaimana kabar Nemesis di luar sana? Menyelesaikan urusan dengan tangannya sendiri yang sangat cakap itu. Dia tidak membuat {#Emph}terlalu {#Prev}banyak masalah untukmu, kan?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutNemesis02"
    }
    {
      Id = "Melinoe_2214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau sudah tahu? Dan Guru pasti tahu juga. Nemesis ya tetaplah Nemesis! Dia merasakan sendiri bahwa tugas kita tidak sesederhana kelihatannya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutNemesis02"
    }
    {
      Id = "Odysseus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, tak perlu bicara lebih banyak lagi! Tapi, jika dia menjadi terlalu berniat menghalangi hasilmu ketimbang meraih hasilnya sendiri, kami akan turun tangan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutNemesis02"
    }
    {
      Id = "Melinoe_2215"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak akan sampai ke tahap itu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutNemesis02"
    }
    {
      Id = "Odysseus_0622"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepi sekali sekarang... awalnya aku tak sadar apa yang berubah, sampai teringat kalau Hypnos sudah pergi. Padahal aku sudah begitu terbiasa mendengar suaranya di latar belakang..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutHypnosWakeUp01"
    }
    {
      Id = "Melinoe_5244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, kau {#Emph}merindukan {#Prev}dengkuran tiada hentinya? Di antara semua orang di Persimpangan, jarakmu paling dekat dengannya, jadi kukira kaulah yang paling senang dia akhirnya pulang."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHypnosWakeUp01"
    }
    {
      Id = "Odysseus_0623"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang demi {#Emph}dia{#Prev}, tentu saja, dan perubahan suasananya pun bukan hal {#Emph}buruk{#Prev}, tapi... bahkan ketika keadaan membaik, tetap saja butuh penyesuaian."
      Speaker = "Odysseus"
      Event = "OdysseusAboutHypnosWakeUp01"
    }
    {
      Id = "Melinoe_5245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku juga akan merindukannya, sedikit banyak..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHypnosWakeUp01"
    }
    {
      Id = "Melinoe_2218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan Komandan Schelemeus sama-sama pelaut ulung yang tersohor, bukan? Apakah kalian pernah bertemu saat masih hidup fana dulu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutSkelly01"
    }
    {
      Id = "Odysseus_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, sebutan {#Emph}pelaut ulung {#Prev}terlalu sepele untuknya, Dewi! Kabarnya sepak terjangnya bahkan menyaingi milikku! Sayang sekali aku tak pernah punya kesempatan menyaksikan sendiri kehebatannya. {#Emph}Ah{#Prev}, pasti luar biasa sekali!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutSkelly01"
    }
    {
      Id = "Melinoe_2219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami beruntung memiliki kalian berdua."
      Speaker = "Melinoe"
      Event = "OdysseusAboutSkelly01"
    }
    {
      Id = "Melinoe_2209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus, apa kau pernah melihat Hypnos bergeser sedikit saja dalam tidurnya? Aku tahu dia sudah melewati banyak hal, tapi tetap saja..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHypnos01"
    }
    {
      Id = "Odysseus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepertinya belum pernah! Sudah seperti itu sejak malam saat penyihir agung membawanya kemari. Soal dengkurannya, lama-lama aku terbiasa juga..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutHypnos01"
    }
    {
      Id = "Melinoe_2210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira dia akan bangun, tidak? Tak ada satu pun mantra yang kami coba yang membuahkan hasil."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHypnos01"
    }
    {
      Id = "Odysseus_0152"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia adalah Sang Tidur itu sendiri, bukan?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutHypnos01"
    }
    {
      Id = "Odysseus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Sang {#Emph}Malapetaka {#Prev}datang menumpang sebentar bersama kita? Terakhir kali—dan satu-satunya—aku bersinggungan dengannya, semuanya berakhir {#Emph}kurang {#Prev}mengenakkan, jadi... aku jaga jarak saja, jika tak keberatan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMoros01"
    }
    {
      Id = "Melinoe_2211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua anak Nyx diterima di Persimpangan ini. Meski kurasa Tuan Moros juga ingin menjaga jarak {#Emph}darimu{#Prev}."
      Speaker = "Melinoe"
      Event = "OdysseusAboutMoros01"
    }
    {
      Id = "Odysseus_0154"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sama sekali tak keberatan!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutMoros01"
    }
    {
      Id = "Odysseus_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutebak {#Emph}kau{#Prev} alasan Ikaros kembali kemari. Dari dulu dia kelihatan seperti bocah yang baik! Waktu itu aku memilih diam, tapi sebenarnya kecewa saat dia pergi."
      Speaker = "Odysseus"
      Event = "OdysseusAboutIcarus01"
    }
    {
      Id = "Melinoe_4508"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu keputusannya sendiri. Kurasa dia juga selalu menghargai pengalamanmu. Dia tak sempat mencicipi petualangan sepertimu saat masih hidup dulu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutIcarus01"
    }
    {
      Id = "Odysseus_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa pula yang sempat, Dewi? Meski jelas dia menimba banyak ilmu selama mengembara. Bahkan sampai dapat {#Emph}sayap {#Prev}sebagai buktinya! Kira-kira dia punya sepasang cadangan tidak, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutIcarus01"
    }
    {
      Id = "Melinoe_4509"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, entahlah..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutIcarus01"
    }
    {
      Id = "Odysseus_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah kita tak banyak di garis depan Olympus sana, hanya segelintir jiwa pemberani. Katanya kau bertemu langsung dengan Nona Athena, bagaimana keadaannya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutAthena01"
    }
    {
      Id = "Melinoe_4185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengingat dia menahan gelombang besar pasukan Titan seorang diri, dia tampak luar biasa tenang."
      Speaker = "Melinoe"
      Event = "OdysseusAboutAthena01"
    }
    {
      Id = "Odysseus_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadinya aku ingin titip ucapan terima kasih atas pertolongannya yang berkali-kali menyelamatkan nyawaku, tapi... lebih baik tutup mulut saja."
      Speaker = "Odysseus"
      Event = "OdysseusAboutAthena01"
    }
    {
      Id = "Melinoe_4186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau yakin aku tak perlu menyampaikan apa pun?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutAthena01"
    }
    {
      Id = "Odysseus_0395"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yakin."
      Speaker = "Odysseus"
      Event = "OdysseusAboutAthena01"
    }
    {
      Id = "Melinoe_3313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam pelayaran belum lama ini, aku bertemu Circe sang Penyihir di pulau kecilnya, tampaknya aman dari segala kekacauan di lautan. Bukankah kalian berdua saling mengenal cukup dekat?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutCirce01"
    }
    {
      Id = "Odysseus_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam hidup maupun mati kita hanya bisa berusaha saling mengenal, Dewi... Walau aku mengenal Circe... ya sedikit, setidaknya; hanya kenalan biasa, memangnya kenapa?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutCirce01"
    }
    {
      Id = "Melinoe_3314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, barangkali kau ingin menyampaikan sesuatu padanya saat kami bertemu lagi nanti, karena dia mungkin akan membantuku melintasi Celah Thessaly."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCirce01"
    }
    {
      Id = "Odysseus_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, tak perlu menyampaikan apa pun padanya. Lebih baik kau fokus saja pada tugas yang ada."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCirce01"
    }
    {
      Id = "Melinoe_3315"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCirce01"
    }
    {
      Id = "Melinoe_3330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus, sebenarnya apa yang terjadi antara kau dan Circe? Dia menyinggung tentangmu, tak berkata apa-apa secara khusus, hanya saja... aku merasakan kepedihan. Di sana, {#Emph}maupun {#Prev}di sini."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCirce02"
    }
    {
      Id = "Odysseus_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan sepenuhnya pedih, Dewi. Saat aku masih hidup utuh, pulang dari medan perang, aku menemukan Circe dan pulaunya, lalu... aku tinggal di sana sekitar satu tahun. Dia menampungku dan anak buahku, lalu kami menjadi dekat. Aku belajar banyak darinya, kemudian... kami pergi."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCirce02"
    }
    {
      Id = "Melinoe_3331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pelayaran pulangmu. Kau singgah selama setahun penuh, lalu berlayar lagi dan tak pernah melihatnya lagi..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCirce02"
    }
    {
      Id = "Odysseus_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, betul, sampai aku melihatnya lagi di sini. Hanya saja... itu masa lalu, bagi kami berdua, kurasa. Tak semua hubungan semacam itu harus bertahan abadi selamanya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCirce02"
    }
    {
      Id = "Melinoe_3332"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mengerti, kurasa..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCirce02"
    }
    {
      Id = "Odysseus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami mendapat banyak laporan bahwa bala tentara Chronos sedang berkumpul di permukaan sana, dan belum mengendus pergerakanmu. Setidaknya kau tak perlu berhadapan dengan {#Emph}mereka{#Prev}, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronos01"
    }
    {
      Id = "Melinoe_2172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalurku menyusuri Underworld memang penuh bahaya tersendiri, tapi ya, cukup melegakan mengetahui pasukan pengkhianat itu masih belum menyadari keberadaanku."
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronos01"
    }
    {
      Id = "Odysseus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada jalur turun lain yang lebih tersembunyi. Lagipula kawan-kawan berduri di hutan itu setidaknya juga tidak menyukai Chronos."
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronos01"
    }
    {
      Id = "Melinoe_2173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan melewati mereka."
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronos01"
    }
    {
      Id = "Odysseus_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tampak seperti baru melihat hantu, kalau boleh aku meminjam ungkapan kuno bangsa manusia, Dewi. Begitulah yang biasa kami katakan pada seseorang yang tampak risau. Semuanya baik-baik saja?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronosAnomaly01"
    }
    {
      Id = "Melinoe_3304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa dibilang begitu; aku melihat Chronos di luar sana. Kukira dia berhasil menangkapku, tapi aku berhasil membebaskan diri dari mantranya. Itu terjadi di Oceanus, meski aku juga sempat memergokinya mengintai di dekat jalur keluar dari Erebus."
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronosAnomaly01"
    }
    {
      Id = "Odysseus_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sial... laporan kami sama sekali tak menyebutkan hal semacam itu, tapi ya... beberapa Shade mata-mata kita memang belum kembali. Kami menduga Chronos akan berdiam diri di kedalaman terdalam. Kau pasti sudah membuat cukup banyak keributan hingga menarik perhatiannya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronosAnomaly01"
    }
    {
      Id = "Melinoe_3305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergerakanku memang sulit untuk tidak mencolok. Apa benar-benar tak ada jalan lain?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronosAnomaly01"
    }
    {
      Id = "Odysseus_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa-rasanya tidak ada. Kita mengandalkan anggapannya bahwa kau tak berarti bagi rencana-rencananya. Mengenai rencana kita sendiri, aku akan membahasnya dengan penyihir bijak kita. Berhati-hatilah, dan terima kasih atas laporannya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronosAnomaly01"
    }
    {
      Id = "Melinoe_3306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama-sama."
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronosAnomaly01"
    }
    {
      Id = "Odysseus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru mendapat laporan yang sangat meresahkan, ada penampakan di jalur pinggiran Erebus. Apa mata-mata kita di luar sana melihat hal yang sebenarnya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronos02"
    }
    {
      Id = "Melinoe_2216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika yang mereka lihat adalah Chronos, maka benar. Setidaknya sekarang aku tahu seperti apa rupanya; tapi sebaliknya, dia juga mengenali {#Emph}diriku{#Prev}. Menurutmu mengapa dia melepaskanku? Apa persembunyian kita sudah terbongkar?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronos02"
    }
    {
      Id = "Odysseus_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang bisa masuk ke Crossroads tanpa izin kita, atau bahkan tahu kita ada di sini... termasuk dirinya. Jadi dia mengendus-endus di sekitar? Biarkan saja. Dia menyia-nyiakan waktunya {#Emph}sendiri{#Prev}, sementara {#Emph}kau{#Prev} kian mendekati sasaranmu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronos02"
    }
    {
      Id = "Melinoe_2217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa dia bahkan sanggup menyia-nyiakan waktu...?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronos02"
    }
    {
      Id = "Odysseus_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil mengalahkannya, bukan? Membunuh bajingan itu, setidaknya... untuk satu malam. Laporan pertama yang kudengar nyaris tak kupercaya, tapi setelah laporan ketiga atau keempat, aku baru yakin. {#Emph}Bagus sekali{#Prev}, Dewi!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronosBossW01"
    }
    {
      Id = "Melinoe_2967"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan heran jika laporan kita saat ini sudah menyatakan bahwa dia telah kembali. Tapi aku sudah mendapatkan apa yang kubutuhkan untuk saat ini. Dan sedikit pembalasan, kurasa."
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronosBossW01"
    }
    {
      Id = "Odysseus_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, dan kurasa dia pasti sangat mendidih karenanya, tapi... meski kita belum mencapai tujuan akhir... kurasa kita memang butuh ini. {#Emph}Kau{#Prev} butuh kemenangan ini. Lanjut ke fase berikutnya, kalau begitu?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronosBossW01"
    }
    {
      Id = "Melinoe_2968"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronosBossW01"
    }
    {
      Id = "Odysseus_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menemukannya, Dewi... raut wajahmu menjelaskan segalanya, begitu pula laporanku. Kurasa kau sudah memberinya sesuatu untuk terus dia ingat, meski pertempuran itu tak berakhir sesuai harapanmu..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronosBossL01"
    }
    {
      Id = "Melinoe_3094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos berada tepat di tempat yang kita duga... tapi aku tak bisa mengantisipasi setiap tekniknya. Dan kemampuanku menahan sihirnya masih sangat terbatas."
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronosBossL01"
    }
    {
      Id = "Odysseus_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, untungnya bagimu, orang tua sering kali lambat belajar. Jika kau menghadapinya beberapa kali lagi seperti itu, kau akan segera mengenali setiap trik yang dia punya. Namun... tetaplah sangat berhati-hati di luar sana, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronosBossL01"
    }
    {
      Id = "Melinoe_3095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baik..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronosBossL01"
    }
    {
      Id = "Odysseus_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Shade kita terbukti tak mampu mendekati Rumah Hades, jadi mereka tak punya laporan tentang bagaimana sang Titan bertarung. Sayangnya kau harus menghadapinya seorang diri untuk urusan itu, Dewi..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronosBossTactics01"
    }
    {
      Id = "Melinoe_4211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku bisa memberikan laporannya sendiri kepadamu. Dia tampak cukup renta, tapi gerakannya cepat. Jangkauan sabitnya sangat luas, dan dia bisa membekukanku kapan saja, meski tak bertahan lama. Dan pasukannya selalu hadir untuk memastikan aku kalah jumlah."
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronosBossTactics01"
    }
    {
      Id = "Odysseus_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Membekukanmu... {#Prev}artinya dia berusaha menghentikanmu menggunakan {#Emph}waktu{#Prev}, tapi tak bisa menahanmu lama-lama. Tepat seperti dugaan penyihir bijak kita, bukan? Itu berarti kuasanya atas dirimu terbatas; {#Emph}kaulah{#Prev} yang tak bisa dihentikan, bukan {#Emph}dia."
      Speaker = "Odysseus"
      Event = "OdysseusAboutChronosBossTactics01"
    }
    {
      Id = "Melinoe_4212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sendiri belum merasakan hal seperti itu sampai sekarang."
      Speaker = "Melinoe"
      Event = "OdysseusAboutChronosBossTactics01"
    }
    {
      Id = "Odysseus_0384"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau harus berhadapan dengan {#Emph}Typhon{#Prev} di puncak gunung itu, Dewi...? Para Shade kita bilang ukurannya hampir sebesar gunung itu sendiri... tolong katakan padaku kalau mereka cuma melebih-lebihkan?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphon01"
    }
    {
      Id = "Melinoe_4109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kalau dibayangkan... menurut perkiraanku, ukurannya setidaknya seratus kali lebih besar dari Polyphemus. Meski aku belum sempat mengukur kekuatannya dengan tepat."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphon01"
    }
    {
      Id = "Odysseus_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa kau akan segera mengukurnya nanti. Bukankah itu yang biasa kau lakukan pada setiap musuh yang kau hadapi sejauh ini? Para Shade dan penyihir bijak kita menganggap tindakan gegabah untuk menghadapi ancaman sebesar itu sendirian, tapi... kau tak berencana untuk mundur, kan?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphon01"
    }
    {
      Id = "Melinoe_4110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphon01"
    }
    {
      Id = "Odysseus_0386"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphon01"
    }
    {
      Id = "Melinoe_4230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kalau dibayangkan... menurut perkiraanku, ukurannya lebih dari seratus kali lebih besar dari seorang Kiklops. Meski aku belum sempat mengukur kekuatannya dengan tepat."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphon01_B"
    }
    {
      Id = "Odysseus_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir bijak kita sangat mengkhawatirkan konfrontasimu dengan Typhon. Kurasa kau tak pernah dilatih untuk menghadapi lawan sebesar {#Emph}itu{#Prev}."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphonL01"
    }
    {
      Id = "Melinoe_4111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku baru saja berlatih tadi malam. Typhon luar biasa kuat, dan cukup besar untuk menutupi cahaya Bulan, tapi terbukti {#Emph}bukan{#Prev} berarti tak bisa dikalahkan. Konon Dewa Zeus pernah menundukkannya dulu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonL01"
    }
    {
      Id = "Odysseus_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Konon{#Prev} orang bilang banyak hal, Dewi; aku jauh lebih tertarik pada penuturanmu {#Emph}sendiri{#Prev}. Jika firasatmu mengatakan monster itu bisa dihentikan, kata-katamu sudah lebih dari cukup bagiku. Meski tentu saja... aku juga ingin melihat sedikit {#Emph}buktinya{#Prev}."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphonL01"
    }
    {
      Id = "Melinoe_4112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonL01"
    }
    {
      Id = "Odysseus_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menumbangkan monster sebesar gunung itu, Dewi...! Bohong kalau kukatakan aku tak ragu kau {#Emph}bisa{#Prev}, tapi... ya ragu sedikit saja, sumpah. Jadi, bagaimana caramu mengakali kecerdikannya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphonW01"
    }
    {
      Id = "Melinoe_4113"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mengakali{#Prev}? Yang kulakukan cuma terus menghantamnya sekuat tenaga. Beruntung Dewa Zeus juga menyambarnya bertubi-tubi dengan petir. Pada akhirnya itu berhasil, dan Typhon pun tumbang."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonW01"
    }
    {
      Id = "Odysseus_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah! Kehebatan bertarungmu mungkin tak tertandingi, tapi bakatmu dalam mengarang cerita masih... agak {#Emph}kurang{#Prev}. Lain kali kalau kau mengalahkan Bapak Segala Monster, buatlah ceritanya jadi jauh lebih membakar semangat, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphonW01"
    }
    {
      Id = "Melinoe_4114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Tak janji."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonW01"
    }
    {
      Id = "Odysseus_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi tibalah kau di sana! Sendirian, di puncak gunung yang basah kuyup oleh hujan... saat dari kegelapan terdengar raungan yang begitu memekakkan telinga hingga mengguncang Olympus sampai ke akar-akarnya. Dan bersamanya muncullah Typhon sendiri, dengan dendam yang jauh lebih membara dari sebelumnya...! Lalu bagaimana, Dewi?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphonW02"
    }
    {
      Id = "Melinoe_4115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami bertarung. Aku menang. Ah, sial... aku kan disuruh mendramatisir cerita. {#Emph}Ehm{#Prev}, dia terus berusaha meremukkanku dengan {#Emph}dagunya... {#Prev}tapi aku berkelit, lalu memanjat hingga ke puncak kepalanya, dan menancapkan Sepasang Belati Lim dan Oros tepat ke {#Emph}otaknya!"
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonW02"
    }
    {
      Id = "Odysseus_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oho{#Prev}, bagian akhirnya cukup mengerikan juga, aku {#Emph}suka{#Prev}! Satu-satunya kritik dariku, kalau boleh... sudah terlalu banyak kisah tentang monster raksasa yang berakhir seperti itu. {#Emph}Ehm{#Prev}, bagaimana kalau... dia menelanmu bulat-bulat? Lalu kau membelah isi perutnya dari dalam untuk keluar?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphonW02"
    }
    {
      Id = "Melinoe_4116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku baru saja mau menceritakan bagian itu!"
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonW02"
    }
    {
      Id = "Odysseus_0592"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana perasaanmu saat ini, Dewi...? Naluri pertamaku tentu ingin {#Emph}merayakan{#Prev} kematian Typhon, tapi... aku tak pernah bisa melupakan orang pertama yang kubunuh. Bagaimana cahaya perlahan sirna dari matanya..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_5050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon mendambakan kehancuran, dan itulah yang dia dapatkan. Aku tak akan bersuka cita atas hasil akhirnya, tapi tak akan meratapinya juga. Terlebih saat masih banyak hal yang harus diselesaikan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonDeath01"
    }
    {
      Id = "Odysseus_0593"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sikapmu sudah sangat tepat. Kau akan punya banyak waktu untuk mengenang setiap pilihan dan konsekuensinya setelah semua ini selesai, tapi untuk saat ini... jalan terbaik adalah terus maju dan menuntaskan apa yang sudah kaumulai."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_5051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonDeath01"
    }
    {
      Id = "Odysseus_0588"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tujuanmu sudah di depan mata, Dewi, aku bisa tahu hanya dari betapa tegangnya sang penyihir akhir-akhir ini... bukannya mau ikut campur, tapi apakah kau sudah paham apa lagi yang perlu dilakukan?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_5048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir begitu. Sebenarnya aku ingin menceritakan semuanya padamu, tapi kau tahu sendiri bagaimana Kepala Sekolah kalau menyangkut hal-hal semacam ini. Singkat kata, fase terakhir rencana kami sedang berjalan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutUltimateProgress01"
    }
    {
      Id = "Odysseus_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya itu yang perlu kudengar. Fase ini adalah urusanmu dan dia. Untuk bagianku, tampaknya kau sudah bisa mencapai tempat yang kau tuju dengan cukup konsisten."
      Speaker = "Odysseus"
      Event = "OdysseusAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_5049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar. Terima kasih sudah memetakan jalanku."
      Speaker = "Melinoe"
      Event = "OdysseusAboutUltimateProgress01"
    }
    {
      Id = "Odysseus_0590"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama-sama."
      Speaker = "Odysseus"
      Event = "OdysseusAboutUltimateProgress01"
    }
    {
      Id = "Odysseus_0594"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak melihat sang penyihir belakangan ini, kan, Dewi? Kau pasti memberitahuku kalau ada hal yang mencurigakan, kan...?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutHecateKidnapped01"
    }
    {
      Id = "Melinoe_5052"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada yang perlu dikhawatirkan sama sekali."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHecateKidnapped01"
    }
    {
      Id = "Odysseus_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana keadaan belakangan ini di dasar samudra? Segala macam keburukan bersemayam di sana, {#Emph}itu{#Prev} sudah jelas dari berbagai laporan. Kutaruh taruhan kau pasti sudah melihat banyak hal gila."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla01"
    }
    {
      Id = "Melinoe_2181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti menang telak dalam taruhan itu. Yang paling menjengkelkan dari semuanya pastilah monster betina laut bernama Scylla itu, beserta teman-teman Siren-nya. Penampilan panggung mereka konyol sekali..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla01"
    }
    {
      Id = "Odysseus_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, Scylla masih ada? Bersama para Siren pula, {#Emph}hah! {#Prev}Ajaib sekali kau bisa kembali hidup-hidup. Tolong beri tahu aku kalau kau sama sekali tak mendengarkan sepatah kata pun dari lagu mereka?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla01"
    }
    {
      Id = "Melinoe_2182"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, telingaku kenyang mendengarnya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla01"
    }
    {
      Id = "Odysseus_0174"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ungh..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla01"
    }
    {
      Id = "Odysseus_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku pernah begitu tergila-gila ingin mendengar nyanyian Siren... Aku nyaris tak mampu menahan godaan mereka; ya tentu saja, saat itu aku... cuma manusia fana biasa. Mungkin kau tak sebegitu mempan terhadap pesona mereka."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla02"
    }
    {
      Id = "Melinoe_2183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja. Lagipula aku tak paham di mana letak menariknya. Meski begitu, sepertinya para Siren akan jauh lebih baik tanpa Scylla. Dia agak terlalu sok mengatur..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla02"
    }
    {
      Id = "Odysseus_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, dia itu memang pembawa petaka. Dia menyambar setengah lusin awak kapalku seolah punya deretan gigi terpisah untuk tiap pemuda malang itu. Kami tak punya pilihan selain berdoa pada para dewa, lalu terus berlayar. Sampaikan salamku padanya!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla02"
    }
    {
      Id = "Melinoe_2184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya, apakah para dewa menjawab doamu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla02"
    }
    {
      Id = "Odysseus_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ehm{#Prev}, yah sebagian besarnya!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla02"
    }
    {
      Id = "Melinoe_2202_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini aku lebih sering melihatmu melamun sendirian di sini, Odysseus. Kau sedang memikirkan keluargamu, ya? Suatu kenangan masa lalu yang membekas kuat."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla03"
    }
    {
      Id = "Odysseus_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, Dewi, kau mungkin bisa membaca isi hati sebagian besar Arwah di sini, tapi empatimu padaku agak... meleset. Penelope, Telemachus, dan aku... hubungan kami masih baik-baik saja, tapi... bagaimana cara mengatakannya tanpa terdengar berhati dingin, ya..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla03"
    }
    {
      Id = "Melinoe_2203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan saja apa yang kau pikirkan padaku. Aku yakin kau sama sekali tidak berhati dingin."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla03"
    }
    {
      Id = "Odysseus_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Pikiranku melayang bukan ke urusan keluarga, tapi... ke lagu keparat para Siren itu. Aku nyaris tak sempat mendengarnya sekali pun saat berlayar melintasi perairan mereka. Saat itu aku {#Emph}sangat{#Prev} ingin menceburkan diri ke laut, hanya demi bisa mendengarnya lebih jelas..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla03"
    }
    {
      Id = "Melinoe_2204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagu para Siren? Kau bercanda kalau ingin aku percaya celotehan cerewet Scylla adalah sumber kegalauan sang Taktisi Ulung belakangan ini?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla03"
    }
    {
      Id = "Odysseus_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahlah, jangan mencelaku begitu, aku benar-benar serius kali ini. Kau tidak bersamaku di permukaan sana kala itu, jadi kau takkan mengerti..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla03"
    }
    {
      Id = "Melinoe_2205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampaknya tidak..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla03"
    }
    {
      Id = "Melinoe_2206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat terakhir kali kita berbincang di kedai, aku tak bermaksud mencela selera musikmu. Aku hanya tak menyangka Scylla bisa dianggap serius oleh siapa pun... apalagi olehmu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla04"
    }
    {
      Id = "Odysseus_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, jangan dipikirkan. Musik Siren memang {#Emph}perlu pembiasaan... {#Prev}terbiasa oleh semua orang yang berlayar di dekat mereka saat aku masih bernyawa. Tapi, apa menurutmu itu cuma {#Emph}ocehan tak ada habisnya{#Prev}?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla04"
    }
    {
      Id = "Melinoe_2207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, mungkin penilaianku agak terlalu keras, hanya saja... aku sulit memisahkan rasa muakku pada si penampil dari kualitas karyanya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla04"
    }
    {
      Id = "Odysseus_0199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti lagunya sangat terngiang-ngiang di kepala, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutScylla04"
    }
    {
      Id = "Melinoe_2208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScylla04"
    }
    {
      Id = "Melinoe_5248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau tahu kalau Scylla dan Charybdis sekarang bekerja sama?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutScyllaAltFight01"
    }
    {
      Id = "Odysseus_0626"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu saja bisa dibilang begitu. Kenapa kau bertanya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutScyllaAltFight01"
    }
    {
      Id = "Melinoe_5249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat melihat penampilan terbaru mereka. Benar-benar sebuah tontonan luar biasa, paling tidak begitu. Harusnya kau memperingatkanku sebelumnya kalau mereka berdua tampil serempak!"
      Speaker = "Melinoe"
      Event = "OdysseusAboutScyllaAltFight01"
    }
    {
      Id = "Odysseus_0627"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi, maafkan aku, tapi kukira sudah jadi rahasia umum kalau Scylla dan Charybdis berkolaborasi... itu sama sekali bukan hal baru."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScyllaAltFight01"
    }
    {
      Id = "Melinoe_5250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin aku cuma ketinggalan berita."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScyllaAltFight01"
    }
    {
      Id = "Odysseus_0628"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasanya mustahil kau bisa melewatkannya..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScyllaAltFight01"
    }
    {
      Id = "Melinoe_5246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Scylla sempat menyinggung soal calon sponsor di antara penonton salah satu pertunjukannya, Odysseus. Apa kau tahu siapa orang itu? Kukira mungkin Chronos, tapi rasanya mustahil dia mendengarkan musiknya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScyllaSponsor01"
    }
    {
      Id = "Odysseus_0624"
      InheritFrom = "BaseNarrative"
      DisplayName = "Calon sponsor... itu belum muncul dalam laporan kita, tapi akan kuperiksa lagi dan kuberi tahu jika ada kabar. Mungkin cuma pelaut tua yang telinganya terngiang-ngiang dan tak bisa melupakannya. Kau tahu apa isi kesepakatan sponsor ini?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutScyllaSponsor01"
    }
    {
      Id = "Melinoe_5247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin mengadakan lebih banyak pertunjukan malamnya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScyllaSponsor01"
    }
    {
      Id = "Odysseus_0625"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pamornya sedang naik daun rupanya..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScyllaSponsor01"
    }
    {
      Id = "Odysseus_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Siren terbukti menjadi rintangan yang cukup merepotkan, ya. Para Bayangan kita telah membaur ke dalam kerumunan penonton di sekitar mereka, dan punya beberapa pengamatan untuk disampaikan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScyllaTactics01"
    }
    {
      Id = "Melinoe_4209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Soal apa? Kegagalanku yang berulang kali untuk mengalahkan rombongan musik gila, terlepas dari pelatihan intensif seumur hidupku dalam sihir maupun bela diri?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutScyllaTactics01"
    }
    {
      Id = "Odysseus_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu menyalahkan diri sendiri, Dewi. Melawan Scylla and the Sirens, kau menghadapi tiga musuh sekaligus. Pemain perkusi mereka memang terpaku di tempat, tapi menjadi ancaman yang nyata. Para Bayangan menyarankan untuk membereskan yang satu itu terlebih dahulu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScyllaTactics01"
    }
    {
      Id = "Melinoe_4210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kucoba."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScyllaTactics01"
    }
    {
      Id = "Odysseus_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musik itu... aku bisa mengenalinya di mana pun! Bahkan tanpa liriknya. Dan kukira hanya akulah satu-satunya pengagum lagu-lagu Siren di seluruh Persimpangan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScyllaSong01"
    }
    {
      Id = "Melinoe_4187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... hanya ingin melihat apa Pembuat Musik kita tahu lagu itu. Mungkin lagu itu tidak pantas diizinkan di sini. Apalagi jika lagu itu punya kekuatan jahat untuk memikat hati para pria."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScyllaSong01"
    }
    {
      Id = "Odysseus_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, kurasa kita yang sudah mati tak lagi mempan dipikat. Walau begitu, sebaiknya kudengarkan sekali lagi, sekadar memastikan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutScyllaSong01"
    }
    {
      Id = "Melinoe_4188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beri tahu aku jika lagu itu mulai mengalihkan perhatian."
      Speaker = "Melinoe"
      Event = "OdysseusAboutScyllaSong01"
    }
    {
      Id = "Odysseus_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedikit peringatan, Dewi, terkait rintangan yang mungkin kau hadapi saat akhirnya mencapai ujung Padang Ratapan. Laporan menyebutkan makhluk itu semacam monster neraka... yang berukuran raksasa. Para Bayangan kita terpaksa menjaga jarak sangat jauh darinya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCerberus01"
    }
    {
      Id = "Melinoe_3324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tahu ada jalan masuk berpenjaga menuju Tartarus di sekitar titik itu... binatang buas inilah alasan kenapa terowongan itu tetap terjaga ketat. Apa kita punya rinciannya?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutCerberus01"
    }
    {
      Id = "Odysseus_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Konon ia memiliki beberapa moncong penyembur api, yang celakanya cocok dengan ciri-ciri hewan peliharaan ayahmu. Namun, jika memang begitu keadaannya... semoga saja ia membiarkanmu lewat begitu saja!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutCerberus01"
    }
    {
      Id = "Melinoe_3325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maksudmu, Cerberus sendiri yang menjaga pintu masuk ke Tartarus? Kenapa dia mau menuruti perintah Chronos? Mustahil."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCerberus01"
    }
    {
      Id = "Odysseus_0256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Laporannya belum pasti, tapi kupikir kau harus mengetahuinya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCerberus01"
    }
    {
      Id = "Melinoe_3326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa mengonfirmasi laporan dari para Bayangan kita. Dan menambahkan bahwa monster neraka itu memang benar Cerberus, hewan peliharaan ayahku... bertindak murni atas naluri dan amarah yang membabi buta."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCerberus01_B"
    }
    {
      Id = "Odysseus_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, sudah kuduga. Karena mereka bilang monster itu memiliki beberapa moncong penyembur api. Kurasa dia tak mengenalimu setelah sekian lama, lalu... membiarkanmu lewat...?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutCerberus01_B"
    }
    {
      Id = "Melinoe_3327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia sama sekali tak melakukan keduanya. Aku harus menolongnya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCerberus01_B"
    }
    {
      Id = "Odysseus_0535"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Bayangan kita telah menganalisis pertarunganmu melawan Cerberus. Dia lebih rentan diserang dari belakang, meskipun jika kau harus mendekat, jangan berlama-lama di sana."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCerberusBossTactics01"
    }
    {
      Id = "Melinoe_5460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masuk akal, tenaganya memang luar biasa besar... bukan musuh tercepat yang pernah kuhadapi, tapi rasanya aku tak bisa melawannya secara langsung dari depan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCerberusBossTactics01"
    }
    {
      Id = "Odysseus_0536"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, jangan terlalu jauh darinya juga, karena saat itulah dia akan mencoba menyemburkan apinya. Dia pasti punya kelemahan yang bisa dimanfaatkan; dia bertarung bukan dengan strategi."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCerberusBossTactics01"
    }
    {
      Id = "Melinoe_5461"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia jelas bukan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCerberusBossTactics01"
    }
    {
      Id = "Odysseus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melihat kerabatmu di Olympus membantumu, sempat terlintas di benakku untuk meminta tolong agar kau beri tahu mereka bahwa aku di pihakmu, hanya saja... tidak semuanya menyukaiku."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPoseidon01"
    }
    {
      Id = "Melinoe_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa? {#Prev}Tapi kau Sang Taktisi Agung, Odysseus! Bahkan para dewa pun terkesima dengan siasat cerdikmu di masa kejayaanmu dulu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPoseidon01"
    }
    {
      Id = "Odysseus_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nona Athena dan beberapa dewa lain memang menyukaiku, itu benar. Tapi pamanmu, Poseidon, yah... kurasa aku membuatnya murka. Mungkin dia sudah melupakannya setelah sekian lama, tapi itu risiko yang enggan kuambil. Jadi {#Emph}ehem{#Prev}, jangan sebut-sebut tentang diriku ke mereka, bisa kan?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutPoseidon01"
    }
    {
      Id = "Melinoe_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku paham."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPoseidon01"
    }
    {
      Id = "Odysseus_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, ada sedikit rintangan baru dalam rencana kita. Kita berhasil memverifikasi beberapa rincian yang disampaikan Tuan Hermes kepadamu, tentang apa yang... sedang bergejolak di permukaan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutHermes01"
    }
    {
      Id = "Melinoe_2223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong beri tahu apa saja yang kau tahu... dan apakah menurutmu bijak jika aku menyimpang dari tujuanku demi mengatasi apa pun yang terjadi di atas sana."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHermes01"
    }
    {
      Id = "Odysseus_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasukan Chronos berkumpul untuk berlayar menuju Olympus melalui kanal yang membelah daratan. Kau punya posisi strategis untuk mengacaukan barisan musuh dari dalam. Bantulah Olympus, dan peluangmu melawan Chronos mungkin akan meningkat."
      Speaker = "Odysseus"
      Event = "OdysseusAboutHermes01"
    }
    {
      Id = "Melinoe_2224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalur berpenangkal menuju ke atas seharusnya menjatuhkanku tepat di jantung garnisun garis depan musuh. Kedengarannya sangat nekat..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHermes01"
    }
    {
      Id = "Odysseus_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebut saja risiko yang terukur."
      Speaker = "Odysseus"
      Event = "OdysseusAboutHermes01"
    }
    {
      Id = "Melinoe_2189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapan laporan terakhir terlihatnya Root-Stalker di dalam hutan?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutTreant01"
    }
    {
      Id = "Odysseus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, pertanyaan seperti itulah yang kuharapkan dari seseorang yang baru saja melihat Root-Stalker di dalam hutan belum lama ini. Jadi masih ada yang membusuk di Erebus, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTreant01"
    }
    {
      Id = "Melinoe_2190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayangnya, iya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTreant01"
    }
    {
      Id = "Odysseus_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa gerangan sumber kesialanmu, sampai-sampai kau kembali dengan wajah cemberut begitu? Para Wailer, atau Casket, barangkali? Oh... seekor {#Emph}Shadow-Spiller{#Prev}."
      Speaker = "Odysseus"
      Event = "OdysseusAboutFogEmitter01"
    }
    {
      Id = "Melinoe_2187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, Shadow-Spiller. Aku kehilangan arah saat melawannya. Nyaris tak bisa melihat apa pun saat mereka ada di sekitar! Harusnya aku bisa lebih kuat dari ini..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutFogEmitter01"
    }
    {
      Id = "Odysseus_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah cukup kuat. Mereka hanya menguji keteguhan nyalimu. Musuh seperti itu harus dihadapi langsung tanpa ragu. Siap untuk mencoba lagi?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutFogEmitter01"
    }
    {
      Id = "Melinoe_2188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku siap."
      Speaker = "Melinoe"
      Event = "OdysseusAboutFogEmitter01"
    }
    {
      Id = "Odysseus_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar laporan kau melangkah mulus menembus Oceanus, tapi tampaknya kabar itu sudah basi. Apa yang membawamu kembali, Dewi?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutWaterUnitMiniboss01"
    }
    {
      Id = "Melinoe_2191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seekor Ular Laut, jika kau memang harus tahu. Yang ukurannya luar biasa besar berhasil memperdayaku. Kau pernah menghadapinya dalam pelayaranmu saat masih fana?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutWaterUnitMiniboss01"
    }
    {
      Id = "Odysseus_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernah, tentu saja. Tapi tidak sendirian! Bahkan bersama para awak kapalku yang semuanya veteran berpengalaman, kami nyaris tak mampu melacak bajingan licin itu melesat keluar dari air. {#Emph}Ehem{#Prev}, sama sekali tidak menenangkan hati, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutWaterUnitMiniboss01"
    }
    {
      Id = "Melinoe_2192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak juga."
      Speaker = "Melinoe"
      Event = "OdysseusAboutWaterUnitMiniboss01"
    }
    {
      Id = "Odysseus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi, laporan terbaru menyebutkan kau berhadapan dengan Raja Hama! Peduli amat kau abadi atau tidak, aku lega kau bisa kembali utuh tanpa kurang suatu apa..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutVerminMiniboss01"
    }
    {
      Id = "Melinoe_2193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak mungkin. Aku memang melawan hewan pengerat yang luar biasa buas, tapi ukurannya sangat kecil! Kukira Raja Hama itu bertubuh raksasa."
      Speaker = "Melinoe"
      Event = "OdysseusAboutVerminMiniboss01"
    }
    {
      Id = "Odysseus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya bualan belaka. Murka Raja Hama berbanding terbalik dengan perawakannya. Dan perawakannya, sejauh yang kupahami, memang sangat kecil..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutVerminMiniboss01"
    }
    {
      Id = "Melinoe_2194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Brr...{#Prev}"
      Speaker = "Melinoe"
      Event = "OdysseusAboutVerminMiniboss01"
    }
    {
      Id = "Odysseus_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedang musim bertelur dan bergerombol bagi Hellifish di Oceanus, seperti yang mungkin sudah kaulihat. Jika kau berpapasan dengan mereka, saranku jangan buang waktu mengurusi yang kecil-kecil, tapi habisi yang {#Emph}paling besar{#Prev}."
      Speaker = "Odysseus"
      Event = "OdysseusAboutOctofish01"
    }
    {
      Id = "Melinoe_4191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih memilih untuk tidak berurusan dengan mereka semua beserta sengatannya. Berapa lama biasanya musim bergerombol ini berlangsung?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutOctofish01"
    }
    {
      Id = "Odysseus_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, menyebutnya {#Emph}musim {#Prev}agak kurang tepat, karena musim yang sekarang ini sudah dimulai sejak aku masih bocah ingusan. Kabar baiknya, kau akan terbiasa dengan sengatannya setelah beberapa lama!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutOctofish01"
    }
    {
      Id = "Melinoe_4192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Luar biasa sekali."
      Speaker = "Melinoe"
      Event = "OdysseusAboutOctofish01"
    }
    {
      Id = "Odysseus_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menemukan Sarang Phantom di Padang Ratapan, ya? Kalau Shades milikku di sana masih bisa dipercaya. Bajingan pengisap darah... maksudku para {#Emph}Phantom{#Prev}, bukan para Shades."
      Speaker = "Odysseus"
      Event = "OdysseusAboutVampire01"
    }
    {
      Id = "Melinoe_3347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukankah makhluk seperti itu biasanya berkeliaran di permukaan demi mencari mangsa yang {#Emph}hidup{#Prev}? Mereka pasti kelaparan di Underworld."
      Speaker = "Melinoe"
      Event = "OdysseusAboutVampire01"
    }
    {
      Id = "Odysseus_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih baik {#Emph}begitu {#Prev}daripada hangus terbakar fajar yang menyingsing, setidaknya begitulah pikiran mereka. Nah, kau tahu apa yang mereka incar saat kalian bertemu lagi nanti."
      Speaker = "Odysseus"
      Event = "OdysseusAboutVampire01"
    }
    {
      Id = "Melinoe_3348"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka takkan mendapatkannya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutVampire01"
    }
    {
      Id = "Odysseus_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa kau pastikan kabar penampakan Ratu Lamia di Padang Ratapan, Dewi? Tadinya aku mau mengingatkanmu untuk waspada terhadap tanda-tanda rayapan di sekitarmu, hanya saja kurasa aku sudah terlambat..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutLamia01"
    }
    {
      Id = "Melinoe_3346"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pasti telah memancingnya keluar dari sarangnya, ya. Entah itu, atau aku yang menerobos masuk ke dalamnya, tapi bagaimanapun juga, sihirnya terbukti terlalu kuat untuk kuhadapi tadi malam..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutLamia01"
    }
    {
      Id = "Odysseus_0287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terlalu berat bahkan untuk {#Emph}Anda? {#Prev}Mustahil."
      Speaker = "Odysseus"
      Event = "OdysseusAboutLamia01"
    }
    {
      Id = "Odysseus_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka mengirim sang {#Emph}Verminancer {#Prev}untuk memburu Anda, Dewi? Kami tak tahu gelar lain bagi Satir itu, ataupun satir lain sebesar dirinya. Dia salah satu imam agung sang Raja Titan!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutRatCatcher01"
    }
    {
      Id = "Melinoe_3349"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, sang Raja Titan akan segera kehilangan {#Emph}satu {#Prev}imam agungnya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutRatCatcher01"
    }
    {
      Id = "Odysseus_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekalipun Anda mengalahkannya, laporan kami menyebutkan dia tak bisa {#Emph}benar-benar {#Prev}mati. Hadiah dari Chronos, sebagai imbalan atas ritual yang membangkitkannya kembali..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutRatCatcher01"
    }
    {
      Id = "Melinoe_3350"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Paling tidak, aku bisa menguji kebenaran laporan itu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutRatCatcher01"
    }
    {
      Id = "Melinoe_3351"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan laporan yang ingin kusampaikan, tapi sepertinya aku tahu apa yang Chronos lakukan dengan semua Emas berlebih miliknya... Aku dihajar habis-habisan semalam oleh sekarung besar koin."
      Speaker = "Melinoe"
      Event = "OdysseusAboutGoldElemental01"
    }
    {
      Id = "Odysseus_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti sang {#Emph}Goldwrath{#Prev}! Kupikir jika Anda adalah Chronos, dan punya persediaan logam berkilau tanpa batas... wajar saja jika dipakai untuk riset nista itu. {#Emph}Ah{#Prev}, tapi Anda sudah begitu dekat..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutGoldElemental01"
    }
    {
      Id = "Melinoe_3352"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang begitu..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutGoldElemental01"
    }
    {
      Id = "Odysseus_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum ada tanda-tanda Chronos di permukaan. Mengapa harus ambil risiko jika para Satir haus darah bisa menjadi mata dan telinganya? Pasukannya jauh lebih terorganisasi dari dugaan awal kita."
      Speaker = "Odysseus"
      Event = "OdysseusAboutSatyrCrossbow01"
    }
    {
      Id = "Melinoe_3320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru saja berpapasan sial dengan salah satu Satir itu. Bersenjata lengkap, terlatih... dan Chronos punya seisi legiun penuh."
      Speaker = "Melinoe"
      Event = "OdysseusAboutSatyrCrossbow01"
    }
    {
      Id = "Odysseus_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrm{#Prev}, inilah perang yang mereka dambakan sejak para dewa mengubur Chronos. Janji akan kembalinya sang Titan; keabadian dan kekayaan tanpa batas..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutSatyrCrossbow01"
    }
    {
      Id = "Melinoe_3321"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Bohong belaka."
      Speaker = "Melinoe"
      Event = "OdysseusAboutSatyrCrossbow01"
    }
    {
      Id = "Odysseus_0299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemungkinan besar, ya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutSatyrCrossbow01"
    }
    {
      Id = "Melinoe_3316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, sesekali kisah-kisah yang kuceritakan tentang monster laut Charybdis terdengar nyaris tak masuk akal. Namun setelah menghadapi makhluk terkutuk itu sendiri, kurasa ceritamu masih terlalu meremehkannya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCharybdis01"
    }
    {
      Id = "Odysseus_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, berhadapan dengan Charybdis? {#Emph}Ah{#Prev}, Dewi. Saya mendengar laporan tentang semacam pusaran air di Celah Poseidon dan kini kekhawatiran saya terbukti. Paling tidak monster itu tak langsung menelan Anda bulat-bulat...!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutCharybdis01"
    }
    {
      Id = "Melinoe_4199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada saran praktis untuk menghadapinya?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutCharybdis01"
    }
    {
      Id = "Odysseus_0411"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hindari dia sebisa mungkin?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutCharybdis01"
    }
    {
      Id = "Odysseus_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saya bisa menawarkan cara yang lebih cerdas untuk melewati Charybdis dalam pelayaran Anda saat terakhir kali kita membicarakannya. Saya sadar berlayar memutar mungkin mustahil..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCharybdis02"
    }
    {
      Id = "Melinoe_4200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, memang mustahil. Awalnya kupikir ancaman terbesarnya adalah tertelan ke dalam mulut menganga itu... namun ternyata lengkukan tentakelnya yang mengamuk jauh lebih merepotkan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCharybdis02"
    }
    {
      Id = "Odysseus_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu waspadalah terhadap {#Emph}tentakel-tentakel itu{#Prev}. Mungkin Anda bisa memisahkannya satu per satu, manfaatkan ruang apa pun yang ada untuk terus bergerak. Hajar lengannya cukup keras dan dia pasti akan mundur."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCharybdis02"
    }
    {
      Id = "Melinoe_4201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa kupahami."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCharybdis02"
    }
    {
      Id = "Odysseus_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian pelaut tenggelam yang Anda hadapi di atas sana saat melintasi Celah Poseidon mungkin dulunya orang-orang yang saya kenal... meski mustahil bagi saya untuk mengenali mereka sekarang."
      Speaker = "Odysseus"
      Event = "OdysseusAboutZombieCaptain01"
    }
    {
      Id = "Melinoe_4193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paling tidak ada satu yang tampak memegang komando atas yang lain, jika dilihat dari pakaian dan persenjataannya yang lebih mentereng. Aku melawannya semalam di kapal besarnya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutZombieCaptain01"
    }
    {
      Id = "Odysseus_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemungkinan besar sang Yargonaut, jika laporannya cocok. Dulu ada kelompok petualang bernama serupa yang mungkin menjadi asalnya. Namun mereka berasal dari era sebelum zaman saya. Mungkin dia masih berusaha mengulang masa kejayaannya..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutZombieCaptain01"
    }
    {
      Id = "Melinoe_4194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan menghalangi jalanku."
      Speaker = "Melinoe"
      Event = "OdysseusAboutZombieCaptain01"
    }
    {
      Id = "Melinoe_4195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernahkah kau menghadapi Dracon di masa fanamu dulu, Odysseus? Jenis yang terbang dengan sayap mirip kelelawar, tapi berukuran raksasa. Mereka jadi masalah besar di Olympus belakangan ini."
      Speaker = "Melinoe"
      Event = "OdysseusAboutDragonMiniBoss01"
    }
    {
      Id = "Odysseus_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kampung halaman saya bergunung-gunung, meski sebagian besar bebas dari binatang buas terbang. Namun dari pengalaman saya, mereka semua punya satu kesamaan: Rentan dijatuhkan dari angkasa dengan panah."
      Speaker = "Odysseus"
      Event = "OdysseusAboutDragonMiniBoss01"
    }
    {
      Id = "Melinoe_4196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa kulihat logikanya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutDragonMiniBoss01"
    }
    {
      Id = "Melinoe_3610"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu Talos, sang pelindung agung Olympus? Salah satu ciptaan Hephaestus yang paling cerdik, mahakarya yang bisa berjalan... namun sama sekali tak bisa membedakan kawan atau lawan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTalos01"
    }
    {
      Id = "Odysseus_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurangnya akal sehat yang mengecewakan itu konon disengaja. Olympus mengerahkan Talos di tempat yang {#Emph}tak boleh diinjak siapa pun{#Prev}, dan akhir-akhir ini, gunung mereka sendirilah tempatnya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTalos01"
    }
    {
      Id = "Melinoe_3611"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang kupikir Olympus tak punya rencana pertahanan yang matang. Bukankah Nona Athena sendiri yang seharusnya bertanggung jawab?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutTalos01"
    }
    {
      Id = "Odysseus_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya begitu, ya. Anda tahu sendiri keluarga Anda, Dewi! Dalam urusan penting, semuanya ingin ikut campur."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTalos01"
    }
    {
      Id = "Melinoe_3612"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi kepentingan mereka sendiri, kuharap biaya perbaikan Talos tidak mahal."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTalos01"
    }
    {
      Id = "Odysseus_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Monster keji macam apa lagi yang dihadapi para Olympian belakangan ini? Seolah pasukan sang Titan belum cukup merepotkan, kini keturunan Typhon pula..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphonMiniboss01"
    }
    {
      Id = "Melinoe_4197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... bayangkan kengerian dalam segala bentuk dan ukuran, perpaduan otot, mata, dan {#Emph}gigi{#Prev}. Mereka merayap naik dari bawah tanah... beberapa bahkan seolah merembes dari dinding! Yang menghajarku semalam luar biasa besar."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonMiniboss01"
    }
    {
      Id = "Odysseus_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kurasa anak-anak Typhon jauh lebih banyak daripada anak-anak Tuan Pamanmu, Zeus, dan semuanya sangat manja dan bejat. Keluarga yang berseteru! Penyebab hampir semua perang besar yang pernah kukenal."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTyphonMiniboss01"
    }
    {
      Id = "Melinoe_4198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak pernah memandangnya dari sudut itu..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonMiniboss01"
    }
    {
      Id = "Melinoe_4197_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... bayangkan kengerian dalam berbagai bentuk dan ukuran, masing-masing perpaduan dari otot, mata, dan {#Emph}gigi. {#Prev}Mereka merayap naik dari bawah tanah... beberapa bahkan seperti merembes keluar dari dinding!"
      Speaker = "Melinoe"
      Event = "OdysseusAboutTyphonMiniboss01_B"
    }
    {
      Id = "Odysseus_0537"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mendapat laporan bahwa seekor babi hutan abadi berukuran raksasa dan sangat murka berhasil masuk ke Ephyra, yang seharusnya mustahil saat seluruh kota telah ditutup. Kau sudah melihatnya, kan?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutBoarMiniboss01"
    }
    {
      Id = "Melinoe_5462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu memang Babi Hutan Erymanthus. Entah kenapa makhluk itu tidak tampak terlalu janggal di dalam kota orang mati. Lebih baik dia terkurung di sana untuk sementara daripada mengamuk melintasi daratan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutBoarMiniboss01"
    }
    {
      Id = "Odysseus_0538"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makhluk itu seharusnya berada di bawah bumi tempat ia akhirnya bisa tenang, tapi untuk sekarang, ia sangat gelisah dan kemungkinan besar akan terus begitu. Berhati-hatilah dengan taring dan kuku-kukunya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutBoarMiniboss01"
    }
    {
      Id = "Melinoe_5463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, aku sangat berhati-hati."
      Speaker = "Melinoe"
      Event = "OdysseusAboutBoarMiniboss01"
    }
    {
      Id = "Odysseus_0539"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah pembunuh yang kau temui di hutan itu... seorang Pembantai Utama dari Ephyra, dan salah satu abdi Chronos yang paling bengis. Mereka berusaha menghentikanmu dengan lebih agresif."
      Speaker = "Odysseus"
      Event = "OdysseusAboutAssassinMiniboss01"
    }
    {
      Id = "Melinoe_5464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita pastikan bajingan itu dilempar ke Tartarus sebelum semua ini berakhir. Ada penampakan lain di Erebus yang patut dikhawatirkan?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutAssassinMiniboss01"
    }
    {
      Id = "Odysseus_0540"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum ada yang pasti, meski kami terus mengawasi. Untungnya kita punya Nemesis untuk bantu mengawasi keadaan, bukan begitu?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutAssassinMiniboss01"
    }
    {
      Id = "Melinoe_5465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selama dia masih ada di sekitar..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutAssassinMiniboss01"
    }
    {
      Id = "Odysseus_0541"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang membuatmu kembali sampai tampak begitu tertekan, Dewi? Kami dengar kau berhasil mencapai puncak, tapi laporan setelahnya simpang siur... atau, sulit dipercaya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutSurfaceThreat01"
    }
    {
      Id = "Melinoe_5079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semacam wabah mengerikan menjangkiti puncak... penuh monster menjijikkan. Mustahil mereka abdi Chronos, tapi... mereka pasti bagian dari siasatnya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutSurfaceThreat01"
    }
    {
      Id = "Odysseus_0542"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, sebaiknya kita tidak berspekulasi sebelum mengumpulkan semua fakta yang diperlukan. Kau sudah melawan monster-monster itu dan berhasil kembali. Keluargamu pasti tahu lebih banyak, asalkan mereka... masih bisa menghubungimu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutSurfaceThreat01"
    }
    {
      Id = "Melinoe_5080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku harus memastikannya sendiri."
      Speaker = "Melinoe"
      Event = "OdysseusAboutSurfaceThreat01"
    }
    {
      Id = "Odysseus_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar menggunakan labrys itu, Dewi? Atau, maaf, apa yang kau sebut Kapak Moonstone. Bukannya lancang, tapi bukankah itu... agak berlebihan? Bahkan Ajax sekalipun takkan mampu mengayunkan benda seperti itu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutAxe01"
    }
    {
      Id = "Melinoe_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukankah kau sendiri yang mengajariku untuk berimprovisasi, Odysseus? Aku akan menggunakan cara apa pun yang kumiliki. Siapa itu Ajax?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutAxe01"
    }
    {
      Id = "Odysseus_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa {#Emph}Ajax? {#Prev}Cuma orang paling kekar yang pernah kutemui seumur hidupku, {#Emph}siapa lagi kalau bukan Ajax{#Prev}. Tapi aku lupa diri, dia kan tidak memiliki kekuatan Hades yang mengalir di tubuhnya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutAxe01"
    }
    {
      Id = "Odysseus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika hamba boleh lancang, Dewi? Kalian para penyihir sangat bergantung pada sihir jika bertarung dari jarak jauh. Pernah terpikir untuk menggunakan busur panah lagi? Aku bisa memberimu beberapa petunjuk..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutBows01"
    }
    {
      Id = "Melinoe_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tidak usah membahas busur panah, Odysseus. Aku masih memulihkan diri dari terakhir kali kau memberiku 'petunjuk' tentang itu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutBows01"
    }
    {
      Id = "Odysseus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah, baiklah. Kita semua punya kelebihan dan kelemahan masing-masing. Hanya satu kelemahan dalam kasusmu, mungkin."
      Speaker = "Odysseus"
      Event = "OdysseusAboutBows01"
    }
    {
      Id = "Melinoe_0481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu tidak dihitung."
      Speaker = "Melinoe"
      Event = "OdysseusAboutBows01"
    }
    {
      Id = "Odysseus_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana peta buatan kami membantumu sejauh ini? Kau sudah sampai di Oceanus, tentu saja, meski jalur di depan semakin mirip labirin berdasarkan semua informasi yang kami dapatkan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutBiomeMap01"
    }
    {
      Id = "Melinoe_4089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya ada begitu banyak jalan di Underworld sebanyak bintang di langit malam... namun petamu menunjukkan arah dengan tepat. Kepekaan arahmu pasti luar biasa tajam."
      Speaker = "Melinoe"
      Event = "OdysseusAboutBiomeMap01"
    }
    {
      Id = "Odysseus_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh, {#Prev}entahlah, tapi jika peta kita bisa menutupi kekuranganku sendiri, syukurlah. Tapi, hati-hatilah saat kau mencapai Padang Ratapan. Peta mana pun takkan berguna bagimu di {#Emph}sana{#Prev}."
      Speaker = "Odysseus"
      Event = "OdysseusAboutBiomeMap01"
    }
    {
      Id = "Melinoe_4090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana dengan kelopak emas itu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutBiomeMap01"
    }
    {
      Id = "Odysseus_0356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Perhatikan baik-baik kelopak-kelopak itu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutBiomeMap01"
    }
    {
      Id = "Odysseus_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami sudah berhenti mencari rute yang bagus melewati Elysium, karena itulah jalurmu menuju Tartarus agak tak biasa. Koridor administrasi lama itu masih tetap terbengkalai?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutBiomeMap02"
    }
    {
      Id = "Melinoe_4091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar-benar kosong, sampai terasa cukup damai. Mengantarkanku tepat ke sektor pemeliharaan, persis seperti yang kau petakan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutBiomeMap02"
    }
    {
      Id = "Odysseus_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, para Arwah kita yang paling berhak mendapat pujian atas pencapaian {#Emph}itu{#Prev}, meski aku akan menerima {#Emph}sedikit {#Prev}jika kau memaksa. Tugasmu sudah cukup berat, kami tak ingin kau tersesat di tengah jalan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutBiomeMap02"
    }
    {
      Id = "Melinoe_4092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sepakat sekali."
      Speaker = "Melinoe"
      Event = "OdysseusAboutBiomeMap02"
    }
    {
      Id = "Odysseus_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalurmu turun ke Underworld mungkin terlihat agak memutar, tapi menghindari wilayah-wilayah utama adalah peluang terbaikmu untuk mengecoh Chronos sampai kau bisa menghadapinya sesuai kehendak{#Emph}mu{#Prev}."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTask01"
    }
    {
      Id = "Melinoe_4088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah lama menghafal jalur itu di luar kepala; jalur lurus langsung ke Tartarus terdengar terlalu muluk untuk jadi kenyataan. Aku bersyukur rute alternatif ini memang ada."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTask01"
    }
    {
      Id = "Odysseus_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan {#Emph}aku {#Prev}bersyukur wilayah ayahmu memang sangat luas, sehingga kita bisa memetakan jalur di sepanjang perbatasannya sampai ke tempat tujuanmu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTask01"
    }
    {
      Id = "Odysseus_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir hebat di sana bilang kau berhasil menaklukkannya dalam pertarungan sungguhan. Mengesankan sekali! Kau berhasil melangkah lebih jauh?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutOceanus01"
    }
    {
      Id = "Melinoe_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar. Turun sampai ke bilik-bilik dekat dasar laut. Musik aneh bergema di seluruh penjuru tempat itu. Aku tidak siap menghadapinya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutOceanus01"
    }
    {
      Id = "Odysseus_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musik aneh, {#Emph}ya... {#Prev}mengingatkanku pada suatu waktu ketika... {#Emph}ah{#Prev}, kusimpan saja ceritanya untuk lain kali! Beban pikiranmu sedang banyak, aku tahu itu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutOceanus01"
    }
    {
      Id = "Odysseus_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kau berhasil mencapai Padang Ratapan, bagus! Tartarus tidak jauh lagi di baliknya... tepat di bawahnya, malah, tapi pintu masuknya agak jauh jika berjalan kaki dari titik jatuh pertamamu..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutFields01"
    }
    {
      Id = "Melinoe_3318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Agak jauh berjalan kaki, penuh dengan Daemon pelahap jiwa dan monster-monster pembenci kehidupan lainnya. Terlalu kuat untuk dipenjara sehingga mereka bebas berkeliaran di sana, semacam itu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutFields01"
    }
    {
      Id = "Odysseus_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami para fana sangat menyukai Padang itu, Dewi! Tempat untuk melepaskan diri dari kesengsaraan — atau tenggelam di dalamnya. Tempat yang sempurna bagi Daemon, yang hanya {#Emph}sebagian {#Prev}dari mereka akan membiarkanmu lewat begitu saja."
      Speaker = "Odysseus"
      Event = "OdysseusAboutFields01"
    }
    {
      Id = "Melinoe_3319"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang begitulah yang kualami."
      Speaker = "Melinoe"
      Event = "OdysseusAboutFields01"
    }
    {
      Id = "Odysseus_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar usahamu menyadarkan Cerberus kembali membuahkan hasil... setidaknya untuk sementara waktu, Dewi. Dia melompat kabur ke Tartarus, hanya untuk dibuang kembali ke Padang itu?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTartarus01"
    }
    {
      Id = "Melinoe_3328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitulah kesimpulanku, ya. Di Tartarus, dia mencari tuannya... ayahku. Yang kebetulan kupapasi, terbelenggu dalam rantai! Chronos menyiksa mereka... mengejek mereka."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTartarus01"
    }
    {
      Id = "Odysseus_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos memanfaatkan {#Emph}mereka {#Prev}untuk memancing {#Emph}dirimu. {#Prev}Menanamkan emosi dalam dirimu yang memaksamu bertindak ceroboh tanpa perhitungan. Ingat, perang dimenangkan dan dikalahkan dalam hati dan pikiran."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTartarus01"
    }
    {
      Id = "Melinoe_3329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukankah kau sendiri bertindak berdasarkan emosi di masa-masa hidupmu sebagai manusia fana?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutTartarus01"
    }
    {
      Id = "Odysseus_0438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan lihat saja kekacauan yang kualami sekarang!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTartarus01"
    }
    {
      Id = "Melinoe_2225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengapa tidak mengirim Nemesis ke permukaan sebagai gantiku? Sekalipun aku membatalkan mantra pelindung yang menyegel jalurnya, aku tidak yakin bisa bertahan lama di atas sana."
      Speaker = "Melinoe"
      Event = "OdysseusAboutSurface01"
    }
    {
      Id = "Odysseus_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masalah di Olympus tidaklah begitu pribadi bagi Nemesis jika dibandingkan denganmu; lagipula akhir-akhir ini dia tidak terlalu mau mendengarkan saran siapa pun."
      Speaker = "Odysseus"
      Event = "OdysseusAboutSurface01"
    }
    {
      Id = "Melinoe_2226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak, kurasa memang tidak."
      Speaker = "Melinoe"
      Event = "OdysseusAboutSurface01"
    }
    {
      Id = "Odysseus_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang penyihir yang baik itu selalu menduga kau akan pergi ke alam fana. Begitu kau siap dan keadaannya memang menuntut demikian. Kerja bagus."
      Speaker = "Odysseus"
      Event = "OdysseusAboutSurface02"
    }
    {
      Id = "Melinoe_2227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beliau memasang mantra pelindung di jalan menuju ke sana, sampai tiba saatnya aku memiliki sarana untuk melewatinya. Tapi iklim di permukaan adalah persoalan lain..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutSurface02"
    }
    {
      Id = "Odysseus_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hak waris garis keturunan Bawah Tanahmu menghalangi jalan? Tampaknya itu kutukan sekaligus berkah. Yah, jika ilmu sihirmu bisa membawamu sejauh ini, tentulah itu bisa membantumu mengatasi... kesulitan ini."
      Speaker = "Odysseus"
      Event = "OdysseusAboutSurface02"
    }
    {
      Id = "Melinoe_2228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itulah rencananya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutSurface02"
    }
    {
      Id = "Odysseus_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana rasanya berlayar melintasi Celah Thessaly, Dewi? Terkadang aku merindukan hari-hari dan malam-malamku di laut dulu. Mungkin karena aku sudah lupa betapa sengsaranya waktu itu..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutThessaly01"
    }
    {
      Id = "Melinoe_3307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku bisa mengingatkanmu sekarang. Chronos mengerahkan armada kapal besar yang ditarik dari kedalaman terdalam, lengkap dengan para awak kapal yang tenggelam. Aku terpaksa membajak kapal apa pun yang bisa kuambil."
      Speaker = "Melinoe"
      Event = "OdysseusAboutThessaly01"
    }
    {
      Id = "Odysseus_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengalaman bahari yang sesungguhnya kalau begitu! Penuh dengan {#Emph}bahaya, misteri...! Ah{#Prev}, aku merasa sedikit iri pada para awak yang tenggelam itu! Setelah mati, kupikir hari-hariku berlayar sudah berakhir."
      Speaker = "Odysseus"
      Event = "OdysseusAboutThessaly01"
    }
    {
      Id = "Melinoe_3308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, Chronos mungkin butuh lebih banyak pelaut setelah apa yang kulakukan pada mereka."
      Speaker = "Melinoe"
      Event = "OdysseusAboutThessaly01"
    }
    {
      Id = "Odysseus_0241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa tolong rekomendasikan aku padanya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutThessaly01"
    }
    {
      Id = "Odysseus_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini mungkin bukan kesempatan terbaik untuk memberitahumu, tapi kami punya alasan untuk percaya bahwa kekacauan yang membara di Olympus jauh lebih parah daripada yang terlihat. Bahkan para dewa pun tidak sepenuhnya menyadarinya. Sayangnya, kita pun tidak..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutOlympus01"
    }
    {
      Id = "Melinoe_3608"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasukan Chronos menyerang tanpa henti, sementara para dewa dan pertahanan mereka menahan mereka... jadi ini tipu muslihat untuk sesuatu yang jauh lebih dramatis yang sedang dipersiapkan sang Titan?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutOlympus01"
    }
    {
      Id = "Odysseus_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat seperti dugaanku. Tapi jangan takut, Dewi! Aku pernah bertempur bersama seorang pejuang hebat yang berkata {#Emph}rasa takut hanya untuk yang lemah{#Prev}. Menurutku pribadi rasa takut adalah untuk yang masih hidup, tapi seperti hal baik lainnya, tidak sehat jika berlebihan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutOlympus01"
    }
    {
      Id = "Melinoe_3609"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasa takut itu untuk musuh-musuh kita."
      Speaker = "Melinoe"
      Event = "OdysseusAboutOlympus01"
    }
    {
      Id = "Odysseus_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali."
      Speaker = "Odysseus"
      Event = "OdysseusAboutOlympus01"
    }
    {
      Id = "Odysseus_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana permukaan, masih hangat dan ramah seperti dugaanku? Kau patut diacungi jempol karena sudah menjejakkan kaki di atas sana."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemus01"
    }
    {
      Id = "Melinoe_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengerikan sekali. Kota Ephyra luluh lantak sepenuhnya. Dan, ada Kiklops buta yang memastikan tidak ada seorang pun yang bisa keluar."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPolyphemus01"
    }
    {
      Id = "Odysseus_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, semuanya terdengar sangat tidak mengenakkan. Kiklops buta itu pasti Polyphemus. Aku dan para awakku pernah mengalami perseteruan buruk dengannya. Dia masih gemar memakan orang?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemus01"
    }
    {
      Id = "Melinoe_0061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPolyphemus01"
    }
    {
      Id = "Odysseus_0032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemus01"
    }
    {
      Id = "Melinoe_3337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh lamamu Polyphemus ingin aku menyampaikan pesan atas namanya kepadamu. Walau, kalau dipikir-pikir, aku tidak yakin apa yang sebenarnya ingin dia sampaikan. Mungkin hanya... menendangmu sekuat tenaga?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPolyphemus02"
    }
    {
      Id = "Odysseus_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh{#Prev}, benar-benar terdengar seperti Kiklops yang kukenal dulu. Aku dan para awakku, kami sempat menjadi tawanannya untuk beberapa saat... sekaligus persediaan makanannya. Aku berhasil menemukan cara untuk meloloskan kami dari sana, tapi caranya sangat mengerikan..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemus02"
    }
    {
      Id = "Melinoe_3338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia memanggilmu Tak Siapa-Siapa. Bagaimana dia bisa mengenalmu dengan nama itu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPolyphemus02"
    }
    {
      Id = "Odysseus_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tak Siapa-Siapa {#Prev}yang membutakan {#Emph}matanya{#Prev}, Dewi... Aku memberinya nama yang takkan masuk akal saat dia berteriak meminta tolong pada kawan-kawannya. Kami harus mencobanya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemus02"
    }
    {
      Id = "Melinoe_3339"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia punya {#Emph}kawan?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPolyphemus02"
    }
    {
      Id = "Odysseus_0276"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin sekarang sudah tidak lagi."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemus02"
    }
    {
      Id = "Odysseus_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, bagaimana kabar si tua Polyphemus? Gerakannya agak melambat dibanding saat masih muda, mungkin...? Dulu aku nyaris bukan tandingannya, tapi aku kan cuma manusia fana, sedangkan kau... {#Emph}kau."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemus03"
    }
    {
      Id = "Melinoe_3340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia sangat menjaga wilayahnya, meski tampaknya jauh lebih peduli soal tidur dan nafsu makan ketimbang urusan lainnya. Jadi, kau benar-benar membutakannya dulu...?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPolyphemus03"
    }
    {
      Id = "Odysseus_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar... dan aku hanya berharap dia punya {#Emph}mata lain {#Prev}agar aku bisa melakukannya {#Emph}dua kali{#Prev}. Karena jelas-jelas {#Emph}dia {#Prev}sama sekali tidak menyesali perbuatannya, dan... seperti yang bisa kau lihat {#Emph}jelas{#Prev}, aku pun begitu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemus03"
    }
    {
      Id = "Melinoe_3341"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Akan kubalas dia untukmu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPolyphemus03"
    }
    {
      Id = "Odysseus_0279"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemus03"
    }
    {
      Id = "Odysseus_0531"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kiklop itu merepotkanmu, ya? Pasti dia sudah terbiasa mengatasi keterbatasan penglihatannya dan memanfaatkan indra lain untuk melacakmu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemusBossTactics01"
    }
    {
      Id = "Melinoe_5457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pukulannya luar biasa keras, dan tak hanya bisa mencium bauku entah bagaimana caranya, tapi kurasa dia bahkan bisa merasakan setiap langkah kakiku. Bagaimana caramu mengalahkannya waktu itu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPolyphemusBossTactics01"
    }
    {
      Id = "Odysseus_0532"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menyerangnya saat dia tertidur lelap. Bukan pertarungan yang terhormat, tapi situasinya pun tidak adil, Nemesis sendiri pasti setuju. Kalau untukmu, serang dia dengan tusukan cepat dan jangan memaksakan diri, kuras staminanya!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutPolyphemusBossTactics01"
    }
    {
      Id = "Melinoe_5458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia memang terlihat cepat lelah."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPolyphemusBossTactics01"
    }
    {
      Id = "Odysseus_0533"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah hafal trik-trik penyihir hebat itu sekarang, kan? Atau dia masih menyimpan beberapa trik agar ujianmu lebih mengejutkan?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutHecateBossTactics01"
    }
    {
      Id = "Melinoe_5459"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jurus Pembelah Tiganya sulit dihadapi... bayangan cermin yang tak bisa disentuh tapi bisa menghajarku sesuka hati. Ditambah lagi Para Saudarinya yang Mati membuatnya kebal sepenuhnya..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHecateBossTactics01"
    }
    {
      Id = "Odysseus_0534"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, beri pelajaran pada para pengikut penyihir itu begitu mereka muncul, walau jangan bilang-bilang aku yang menyuruhmu. Kau pasti bisa membacanya. Dia ingin kau berhasil."
      Speaker = "Odysseus"
      Event = "OdysseusAboutHecateBossTactics01"
    }
    {
      Id = "Melinoe_2220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berpapasan dengan Heracles yang perkasa di permukaan. Tak salah lagi itu dia! Padahal kupikir dia sudah mati. Kelihatannya dia masih sangat hidup, setidaknya dari luar. Dan masih melayani para dewa..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHeracles01"
    }
    {
      Id = "Odysseus_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heracles {#Prev}yang agung... orang itu rumit. Sebagian {#Emph}manusia{#Prev}, sebagian {#Emph}dewa... {#Prev}mungkin sebagian monster juga. Aturan kematian tak sepenuhnya berlaku untuknya. Apa maunya? Dia membuat masalah denganmu?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutHeracles01"
    }
    {
      Id = "Melinoe_2221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia sangat ketus. Menyuruhku untuk menyingkir dari jalannya. Sepertinya dia punya tugas sendiri. Mungkin Olympus tak mengandalkanku untuk berhasil..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHeracles01"
    }
    {
      Id = "Odysseus_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh, {#Prev}jangan diambil hati. Kerabatmu ada yang bijak, ada pula yang kejam. Mereka mungkin tak ingin mempertaruhkan segalanya pada satu orang saja. Dan... berhati-hatilah di dekat Heracles, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutHeracles01"
    }
    {
      Id = "Melinoe_2222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutHeracles01"
    }
    {
      Id = "Odysseus_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prometheus menentang kita... kalau yang {#Emph}itu {#Prev}benar-benar menyakitkan, Dewi. Di antara kami bangsa manusia fana, dia sangat populer. Bahkan dicintai! Memberi kami anugerah api. Nyaris menjadikan kami seperti sekarang."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheus01"
    }
    {
      Id = "Melinoe_3606"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan dengan begitu, dia melanggar kehendak Olympus. Konon dia memiliki kemampuan melihat masa depan... seharusnya dia bisa memperkirakan konsekuensi dari pembangkangannya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheus01"
    }
    {
      Id = "Odysseus_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang membuatmu berpikir dia tidak tahu? Justru itulah alasan kami begitu mengaguminya. Dia tahu harga yang harus dibayar demi kami, dan membayarnya dengan sukarela, atau... begitulah yang kupilih untuk kupercayai. Tapi itu semua sudah berlalu. Jika sekarang dia bersekutu dengan Chronos, dia telah tersesat."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheus01"
    }
    {
      Id = "Melinoe_3607"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia melakukan keduanya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheus01"
    }
    {
      Id = "Odysseus_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin bertanya lebih banyak padamu tentang Prometheus. Menurut perkiraanmu sendiri, apakah dia benar-benar gila...? Dan, jika dia menentang seluruh keluargamu, lalu siapa yang membebaskannya sejak awal...?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheus02"
    }
    {
      Id = "Melinoe_4104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak tahu pasti soal keduanya. Bicaranya terkadang penuh teka-teki, tapi dia tidak terdengar seperti orang yang hilang akal. Dugaan kuatku adalah pasukan Chronos membebaskannya dengan imbalan kepatuhan, tapi..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheus02"
    }
    {
      Id = "Odysseus_0380"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Tapi dia bukan preman bayaran murahan, kan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheus02"
    }
    {
      Id = "Melinoe_4105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan, kurasa tidak."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheus02"
    }
    {
      Id = "Melinoe_4106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengenal bangsa manusia fana lebih baik daripada siapa pun di sini. Prometheus mengklaim bahwa para dewa itu kejam, dan dia berjuang bukan untuk Sang Tuan Titan, melainkan untuk umat manusia. Bagaimana pandanganmu tentang semua itu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheus03"
    }
    {
      Id = "Odysseus_0381"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, aku kenal manusia fana yang menganggap para dewa bisa bersikap dingin. Sebagian dari mereka bahkan menentang para dewa sampai mati. Yang lainnya paham bahwa para dewa adalah... segalanya, sungguh. Kita hanya punya dunia ini, yang lebih indah daripada sekadar cela di dalamnya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheus03"
    }
    {
      Id = "Melinoe_4107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bicara terlalu abstrak. Aku ingin tahu pendapat pribadimu soal ini, Odysseus. Apakah para dewa bersalah? Apakah kita yang mengundang petaka ini pada diri kita sendiri...?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheus03"
    }
    {
      Id = "Odysseus_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pendapat pribadiku adalah para dewa dan manusia fana sama-sama kaum yang {#Emph}rumit{#Prev}; dan kau tak boleh meragukan dirimu sendiri, jangan sampai kau goyah. Jika kurasa kau atau penyihir hebat itu berada di pihak yang salah, aku pasti akan mengatakannya langsung padamu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheus03"
    }
    {
      Id = "Melinoe_4108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bersumpah atas hal itu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheus03"
    }
    {
      Id = "Odysseus_0383"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheus03"
    }
    {
      Id = "Odysseus_0620"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prometheus masih bersikukuh dengan tindakannya, ya? Para Arwah kita masih melihatnya di gunung itu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheus04"
    }
    {
      Id = "Melinoe_5228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, dia ada di sana, memimpin sisa-sisa legiun sang Titan... legiun Kakek. Semua bagian dari syarat yang memungkinkanku menghadapi kemungkinan Typhon yang tersisa."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheus04"
    }
    {
      Id = "Odysseus_0621"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak mungkin dia bisa meramalkan semua ini sedari awal... kan?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheus04"
    }
    {
      Id = "Melinoe_5229"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku masih belum tahu..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheus04"
    }
    {
      Id = "Melinoe_5223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus, aku butuh saran dan kerahasiaanmu tentang suatu hal. Prometheus punya sekutu yang kukira memihak keluargaku. Aku menghadapi mereka berdua di dekat puncak gunung, di tempat asapnya tebal. Tapi, aku tak boleh membeberkan siapa..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheusAltFight01"
    }
    {
      Id = "Odysseus_0614"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm{#Prev}, laporan yang cukup berbobot, dan aku punya dugaan kuat siapa yang kau maksud. Para dewa pasti tahu, setidaknya Tuan Hermes, atau... menurutmu mereka sama sekali tak menyadarinya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheusAltFight01"
    }
    {
      Id = "Melinoe_5224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa mereka tak sadar, meski mungkin Hermes tahu dan sengaja menyembunyikannya. Prometheus bilang aku tak akan memberi tahu siapa pun karena bahaya yang bisa ditimbulkannya. Menurutmu dia bicara jujur?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheusAltFight01"
    }
    {
      Id = "Odysseus_0615"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak akan berani bertaruh sebaliknya. Sebaiknya kita anggap itu kenyataan untuk saat ini, kecuali jika menurutmu sekutu ini menimbulkan ancaman langsung bagi keluargamu. Apakah kau bisa menyelidikinya lebih lanjut?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheusAltFight01"
    }
    {
      Id = "Melinoe_5225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa bisa..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheusAltFight01"
    }
    {
      Id = "Odysseus_0616"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terus kabari aku."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheusAltFight01"
    }
    {
      Id = "Odysseus_0617"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar apa yang kau bawa, jika ada, tentang masalah Prometheus yang kau sebutkan sebelumnya? Kami belum menerima laporan yang cocok dengan perkataanmu... yang kuanggap sebagai pertanda baik."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheusAltFight02"
    }
    {
      Id = "Melinoe_5226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemungkinan besar kehadiranku sendirilah yang memancing sekutu tersembunyi itu keluar dari asap dan bayang-bayang. Mereka berdua pasti saling bertukar informasi... baik tentang Chronos maupun para dewa."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheusAltFight02"
    }
    {
      Id = "Odysseus_0618"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, menanam informan di pihak lawan adalah salah satu trik tertua di medan laga. Kau masih belum berencana membongkar siapa sekutu ini?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheusAltFight02"
    }
    {
      Id = "Melinoe_5227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak sampai aku yakin itu benar-benar diperlukan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPrometheusAltFight02"
    }
    {
      Id = "Odysseus_0619"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sependapat soal itu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPrometheusAltFight02"
    }
    {
      Id = "Odysseus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi, aku baru saja memikirkan perjalananmu, membawamu ke bawah permukaan tanah dan ke atasnya, kurasa sampai ke ujung dunia! Bukan sekadar {#Emph}perjalanan biasa... {#Prev}pasti ada kata yang lebih pas untuk itu..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTravel01"
    }
    {
      Id = "Melinoe_2195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa, apakah {#Emph}tugas {#Prev}kurang terdengar megah? Mungkin {#Emph}mandat? {#Prev}Atau {#Emph}arungan samudra? Penjelajahan {#Prev}rasanya sama sekali tidak pas..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTravel01"
    }
    {
      Id = "Odysseus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, terlalu ceria, dan {#Emph}arungan samudra {#Prev}lebih ke istilah pelayaran.... {#Emph}Erm{#Prev}, nanti kita pikirkan kata yang tepat."
      Speaker = "Odysseus"
      Event = "OdysseusAboutTravel01"
    }
    {
      Id = "Melinoe_2196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...ekspedisi... pengelanaan..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTravel01"
    }
    {
      Id = "Melinoe_2174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kau mengatasinya dulu, Odysseus? Saat hasil dari perang besar bertumpu padamu, lalu pelayaran laut yang berbahaya, semuanya hanya dengan satu nyawa... atau setidaknya itulah yang kau yakini saat itu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPressure01"
    }
    {
      Id = "Odysseus_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pastinya, urusan hanya-punya-satu-nyawa itu menanamkan tekad bertahan hidup dalam diriku. Sebagian besar manusia fana berpegang teguh pada hidup, tapi aku lebih andal dari kebanyakan orang dalam menepis keraguan. Dan saat semua rencanaku berantakan, aku berimprovisasi...!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutPressure01"
    }
    {
      Id = "Melinoe_2175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rencanamu {#Emph}pernah {#Prev}berantakan? Bagaimana kau bisa tidak putus asa? Menepis semua keraguanmu saat menghadapi kegagalan?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutPressure01"
    }
    {
      Id = "Odysseus_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu karena aku selalu menikmati proses mencari jalan keluar. Tak peduli masalah apa pun yang kuhadapi. Menganggap kesulitanku bagai labirin yang harus disusuri, teka-teki yang harus dipecahkan..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPressure01"
    }
    {
      Id = "Melinoe_2176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun terkadang ada jalan buntu; hasil akhir yang memang mustahil untuk dicapai..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPressure01"
    }
    {
      Id = "Odysseus_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak juga, Dewi. Setidaknya menurut pendapatku."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPressure01"
    }
    {
      Id = "Odysseus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tadi bertanya bagaimana caraku mengatasinya... tekanan untuk selalu menang melewati apa yang, jika dikenang kembali, adalah... sekian banyak skenario yang {#Emph}sangat mendebarkan{#Prev}, sembari memikul beban ekspektasi orang banyak sekaligus ekspektasiku sendiri."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPressure02"
    }
    {
      Id = "Melinoe_2177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bilang kau selalu percaya selalu ada solusi, hasil baik yang bisa ditemukan dan diraih... Aku terus memikirkan hal itu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPressure02"
    }
    {
      Id = "Odysseus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah. Tapi terpikir olehku ada hal lain: Cinta yang mendorongku melangkah, Dewi. Perang besar yang membuatku berhak menempati Elysium... sebenarnya aku sangat tidak ingin pergi. Aku ingin tetap di rumah bersama istri dan putraku yang baru lahir."
      Speaker = "Odysseus"
      Event = "OdysseusAboutPressure02"
    }
    {
      Id = "Melinoe_2178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak punya pilihan selain bertempur. Jadi kau berpegang teguh pada harapan bahwa suatu hari nanti kau akan melihat keluargamu lagi..."
      Speaker = "Melinoe"
      Event = "OdysseusAboutPressure02"
    }
    {
      Id = "Odysseus_0142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terdengar tidak asing, kan?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutPressure02"
    }
    {
      Id = "Odysseus_0596"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menemukan jalan menuju kemenangan dan membawa kita ke sana. Rencana tak akan ada gunanya jika tak menyisakan ruang untuk berimprovisasi! Tentu saja rencana kita sekarang juga memiliki fase {#Emph}lain {#Prev}sebagai akibatnya..."
      Speaker = "Odysseus"
      Event = "OdysseusPostTrueEnding01"
    }
    {
      Id = "Melinoe_5738"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membereskan kekacauan yang ditinggalkan Chronos... kita semua mengira aku akan memusnahkannya. Tapi, aku menemukan jalan lain... jalan yang kupikir akan membuat keluargaku lebih sejahtera pada akhirnya, jika bukan seluruh dunia."
      Speaker = "Melinoe"
      Event = "OdysseusPostTrueEnding01"
    }
    {
      Id = "Odysseus_0597"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sungguh memahaminya, Dewi, dan aku percaya pilihanmu sangat bijak. Mengenai apa yang akan terjadi selanjutnya, segalanya sudah siap agar kau bisa melangkah maju kapan pun kau siap."
      Speaker = "Odysseus"
      Event = "OdysseusPostTrueEnding01"
    }
    {
      Id = "Melinoe_5739"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menghapus kemungkinan nyata bahwa kita bisa saja gagal... memastikan {#Emph}waktu mengalir maju tanpa rintangan{#Prev}, seperti yang Chronos katakan. Aku tak begitu tahu apa yang harus kuhadapi, tapi perubahan yang kita perjuangkan ini tak akan terjadi dalam semalam. Bagaimana menurutmu?"
      Speaker = "Melinoe"
      Event = "OdysseusPostTrueEnding01"
    }
    {
      Id = "Odysseus_0598"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Yah{#Prev}, pendapat pribadiku sih, tak ada salahnya untuk {#Emph}mencoba! {#Prev}Sejauh kau punya urusan lain yang harus diselesaikan, anggap saja ini kesempatan untuk menuntaskannya. Dan, kami akan selalu menanti kepulanganmu."
      Speaker = "Odysseus"
      Event = "OdysseusPostTrueEnding01"
    }
    {
      Id = "Melinoe_5055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, mari kita coba."
      Speaker = "Melinoe"
      Event = "OdysseusPostTrueEnding01"
    }
    {
      Id = "Odysseus_0599"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya berjalan sesuai harapan di fase baru tugasmu sejauh ini, Dewi? Yah, mungkin memperluas arti kata {#Emph}harapan{#Prev}, mengingat ini... medan yang benar-benar baru bagi kita semua."
      Speaker = "Odysseus"
      Event = "OdysseusPostTrueEnding02"
    }
    {
      Id = "Melinoe_5111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini tugas yang tidak biasa, memastikan sang waktu mengalir bebas. Kalau dilakukan dengan benar, semuanya akan tampak seperti sedia kala. Dan andaikan tidak pun... belum tentu segalanya bakal berantakan."
      Speaker = "Melinoe"
      Event = "OdysseusPostTrueEnding02"
    }
    {
      Id = "Odysseus_0600"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kalau begitu terdengar lebih familier dari dugaanku. Hidup dengan segala ketidakpastiannya! Pokoknya, kami terus mengawasi Chronos dan memastikan rute perjalananmu tetap aman."
      Speaker = "Odysseus"
      Event = "OdysseusPostTrueEnding02"
    }
    {
      Id = "Melinoe_5112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kumanfaatkan sebaik-baiknya. Terima kasih."
      Speaker = "Melinoe"
      Event = "OdysseusPostTrueEnding02"
    }
    {
      Id = "Odysseus_0601"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kediaman ayahmu sudah mulai kembali tertata rapi. Dulu aku selalu ingin berkunjung jika sempat, sekadar menyapa satu atau dua kawan seperjuangan dari masa perang."
      Speaker = "Odysseus"
      Event = "OdysseusPostTrueEndingAboutHouse01"
    }
    {
      Id = "Melinoe_5213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga ingin berkunjung ke sana lagi, tapi entah kapan kita punya kesempatan itu selama status kita masih Tak Terlihat. Secara resmi, mereka bahkan tidak boleh tahu kalau kita ada di sini."
      Speaker = "Melinoe"
      Event = "OdysseusPostTrueEndingAboutHouse01"
    }
    {
      Id = "Odysseus_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu, tapi itu tidak menghilangkan rasa penasaranku! Bagaimanapun juga, yang penting para abdi Raja dan Ratu baik-baik saja. Barangkali kelak jalan kita akan bersilangan, siapa tahu."
      Speaker = "Odysseus"
      Event = "OdysseusPostTrueEndingAboutHouse01"
    }
    {
      Id = "Melinoe_5214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Takdir?"
      Speaker = "Melinoe"
      Event = "OdysseusPostTrueEndingAboutHouse01"
    }
    {
      Id = "Odysseus_0603"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atau Prometheus, ya."
      Speaker = "Odysseus"
      Event = "OdysseusPostTrueEndingAboutHouse01"
    }
    {
      Id = "Odysseus_0604"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah Typhon benar-benar masih ada di puncak sana? {#Emph}Hm{#Prev}, tak ada jejak dirinya di laporan kita, tapi kalau Chronos... {#Emph}ehm{#Prev}, kakekmu maksudku... kalau dia menggunakan semacam sihir waktu untuk memindahkanmu..."
      Speaker = "Odysseus"
      Event = "OdysseusPostTrueEndingAboutTyphon01"
    }
    {
      Id = "Melinoe_5215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang benar. Dan akhirnya aku harus berhadapan lagi dengan Typhon seperti sebelumnya. Tampaknya ini adalah kemungkinan-kemungkinan dalam aliran waktu di mana aku belum menang... sampai akhirnya aku menang."
      Speaker = "Melinoe"
      Event = "OdysseusPostTrueEndingAboutTyphon01"
    }
    {
      Id = "Odysseus_0605"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak habis pikir bagaimana itu bisa terjadi. Maksudmu, ada banyak versi dirimu di luar sana, sebagian gagal, sebagian menang, semuanya terjadi bersamaan? Masuk akal saja tidak... tapi ya sudahlah, apalah dayaku mempertanyakan rencana-rencana yang di luar nalar?"
      Speaker = "Odysseus"
      Event = "OdysseusPostTrueEndingAboutTyphon01"
    }
    {
      Id = "Melinoe_5216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang penting berhasil, bukan?"
      Speaker = "Melinoe"
      Event = "OdysseusPostTrueEndingAboutTyphon01"
    }
    {
      Id = "Melinoe_5217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kau sudah dengar soal Sang Takdir? Sepertinya semua orang sudah tahu, kukira kau salah satu yang pertama mendengar. Meski kalau dipikir-pikir lagi, aku jarang sekali mendengarmu membicarakan mereka..."
      Speaker = "Melinoe"
      Event = "OdysseusPostEpilogue01"
    }
    {
      Id = "Odysseus_0608"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Itu karena di lubuk hatiku yang terdalam, aku selalu merasa kitalah yang menentukan pilihan sendiri. Memang sudut pandang yang kontroversial saat kita punya bukti kuat bahwa mereka bertigalah yang kerap menentukan bagi kita, tapi... firasatku berkata demikian kali ini."
      Speaker = "Odysseus"
      Event = "OdysseusPostEpilogue01"
    }
    {
      Id = "Melinoe_5218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, kau tidak percaya dengan apa yang mereka lakukan? Ramalan mereka, datangnya era baru... tak satu pun?"
      Speaker = "Melinoe"
      Event = "OdysseusPostEpilogue01"
    }
    {
      Id = "Odysseus_0609"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak akan melangkah sejauh {#Emph}itu{#Prev}, tapi... aku {#Emph}memilih{#Prev} untuk percaya pada mereka yang kukenal dan kupercaya, termasuk anggota keluargamu. Kalau itu membuatku tampak bodoh, ya sudahlah."
      Speaker = "Odysseus"
      Event = "OdysseusPostEpilogue01"
    }
    {
      Id = "Melinoe_5219"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ya sudahlah? {#Prev}Terdengar seperti pasrah pada takdir bagiku."
      Speaker = "Melinoe"
      Event = "OdysseusPostEpilogue01"
    }
    {
      Id = "Odysseus_0610"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oh{#Prev}, kau tahu maksudku!"
      Speaker = "Odysseus"
      Event = "OdysseusPostEpilogue01"
    }
    {
      Id = "Melinoe_5220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Era baru yang diramalkan Sang Takdir ini, ketika mereka akan {#Emph}menyerahkannya kepada bangsa fana{#Prev}, yang kupikir maksudnya adalah keputusan-keputusan besar... apa kata para Arwah kita soal itu?"
      Speaker = "Melinoe"
      Event = "OdysseusPostEpilogue02"
    }
    {
      Id = "Odysseus_0611"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar beragam pendapat, meski secara garis besar mereka menyambutnya antusias. Dasar makhluk-makhluk tak tahu terima kasih, ya? Kita hanya ada di sini berkat kemurahan hati para dewa."
      Speaker = "Odysseus"
      Event = "OdysseusPostEpilogue02"
    }
    {
      Id = "Melinoe_5221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak selalu karena kemurahan hati, kurasa. Banyak dari para Arwah ini menemui ajal lebih cepat akibat ulah para dewa. Mereka tak mau lagi disetir seenaknya."
      Speaker = "Melinoe"
      Event = "OdysseusPostEpilogue02"
    }
    {
      Id = "Odysseus_0612"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan selalu ada seseorang atau sesuatu yang menyetir orang-orang semacam itu. Entah itu dewa atau bukan, tak banyak bedanya. Para dewa memang punya suasana hati yang tak menentu, aku tahu. Tapi aku takkan bisa melangkah sejauh ini tanpa mereka. Itulah alasanku berada di sini."
      Speaker = "Odysseus"
      Event = "OdysseusPostEpilogue02"
    }
    {
      Id = "Melinoe_5222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senang mendengarmu berkata begitu."
      Speaker = "Melinoe"
      Event = "OdysseusPostEpilogue02"
    }
    {
      Id = "Odysseus_0613"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak sekadar bicara, aku berani bersumpah."
      Speaker = "Odysseus"
      Event = "OdysseusPostEpilogue02"
    }
    {
      Id = "Melinoe_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya ingin bilang, aku menghargai petuahmu, Odysseus. Kau sudah seperti kakak bagiku. Atau paman? Salah satunya, lah. Kau pasti lebih tahu dibanding aku."
      Speaker = "Melinoe"
      Event = "OdysseusBackstory01"
    }
    {
      Id = "Odysseus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, kau tak perlu memberitahuku rasanya hidup tanpa sanak keluarga di dekatmu. Sebagian besar masa hidup fanaku kuhabiskan jauh dari rumah. Ada perang yang harus dihadapi, lalu sedikit teralihkan setelahnya."
      Speaker = "Odysseus"
      Event = "OdysseusBackstory01"
    }
    {
      Id = "Melinoe_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Teralihkan? {#Prev}Kepala Sekolah bilang kau menghabiskan waktu bertahun-tahun di lautan. Bahkan sebagian di antaranya ditemani para dewi."
      Speaker = "Melinoe"
      Event = "OdysseusBackstory01"
    }
    {
      Id = "Odysseus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, begitulah. Saat akhirnya aku pulang, aku nyaris tak mengenali putraku, dan istriku... kami menghabiskan sisa hidup fana kami bersama, dan itu sudah cukup. Kurasa mereka hidup tenteram di suatu tempat di bawah sana."
      Speaker = "Odysseus"
      Event = "OdysseusBackstory01"
    }
    {
      Id = "Melinoe_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau belum pernah menemui mereka? Apa yang terjadi?"
      Speaker = "Melinoe"
      Event = "OdysseusBackstory01"
    }
    {
      Id = "Odysseus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penelope dan aku merenggang seiring berjalannya waktu. Biasa terjadi pada kaum fana, kadang-kadang. Dan itu terjadi pada kaum Arwah juga. Soal putraku Telemachus, dia sudah bisa berdiri di atas kakinya sendiri. Begitulah hidup. Atau begitulah mati, pada akhirnya."
      Speaker = "Odysseus"
      Event = "OdysseusBackstory01"
    }
    {
      Id = "Melinoe_0455"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu, ya..."
      Speaker = "Melinoe"
      Event = "OdysseusBackstory01"
    }
    {
      Id = "Odysseus_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekadar peringatan, aku sedang merasa amat menyedihkan saat ini, Dewi. Dulu kukira hidupku sudah lengkap! Tapi semua perjalananmu menyadarkanku bahwa ada {#Emph}banyak hal{#Prev} yang belum sempat kuutarakan. Terlalu banyak."
      Speaker = "Odysseus"
      Event = "OdysseusLooseEndsQuest01"
    }
    {
      Id = "Melinoe_4219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Apa hubungannya perjalananku dengan hal itu? Dan hentikan rasa menyedihkanmu itu sekarang juga... atau beri tahu aku cara menghentikannya."
      Speaker = "Melinoe"
      Event = "OdysseusLooseEndsQuest01"
    }
    {
      Id = "Odysseus_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh{#Prev}, kau sudah bertemu Scylla dan para Siren, Polifemos si Kiklops, Circe si Penyihir... bagaimana pun juga, masing-masing dari mereka meninggalkan bekas mendalam padaku; belum lagi istri dan putraku, di mana pun mereka berada sekarang. Kurasa... aku harus pergi..."
      Speaker = "Odysseus"
      Event = "OdysseusLooseEndsQuest01"
    }
    {
      Id = "Melinoe_4220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergi ke {#Emph}mana? {#Prev}Odysseus, kau tak bisa pergi sekarang, kami membutuhkanmu di sini! Pasti ada sesuatu yang bisa kita lakukan."
      Speaker = "Melinoe"
      Event = "OdysseusLooseEndsQuest01"
    }
    {
      Id = "Odysseus_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh. {#Prev}Mungkin memang ada, tapi a—aku tak ingin membebanimu. Tanggunganmu saat ini sudah kelewat banyak."
      Speaker = "Odysseus"
      Event = "OdysseusLooseEndsQuest01"
    }
    {
      Id = "Melinoe_4221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ceritakan lebih banyak padaku."
      Speaker = "Melinoe"
      Event = "OdysseusLooseEndsQuest01"
    }
    {
      Id = "Odysseus_0433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin... lain kali saja..."
      Speaker = "Odysseus"
      Event = "OdysseusLooseEndsQuest01"
    }
    {
      Id = "Odysseus_0563"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan aku, aku... mulai membiarkan kesedihanku meluap. Momen-momen lemah ini jadi semakin sering muncul dari yang ingin kuakui. Aku sudah memikirkan apa yang harus dilakukan... sebuah {#Emph}rencana."
      Speaker = "Odysseus"
      Event = "OdysseusLooseEndsQuest02"
    }
    {
      Id = "Melinoe_5101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rencana apa? Kau sempat menyinggung Scylla, Polifemos, Circe... Aku cukup sering bertemu mereka, jadi aku bisa bicara atas namamu jika kau mau?"
      Speaker = "Melinoe"
      Event = "OdysseusLooseEndsQuest02"
    }
    {
      Id = "Odysseus_0564"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, aku tak akan memintamu melakukan hal {#Emph}itu. {#Prev}Namun, ikatanmu dengan Tulang Jemariku cukup kuat, mungkin aku bisa menyampaikan pesan kepada mereka sendiri. Cukup bawa Kenang-kenanganku ke sana dan serahkan sisanya padaku?"
      Speaker = "Odysseus"
      Event = "OdysseusLooseEndsQuest02"
    }
    {
      Id = "Melinoe_5102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Proyeksi roh... Aku mungkin bisa mempertahankannya sebentar. Kau bermaksud mengonfrontasi kenalan-kenalan lamamu?"
      Speaker = "Melinoe"
      Event = "OdysseusLooseEndsQuest02"
    }
    {
      Id = "Odysseus_0565"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk saat ini, hanya itu saja, Dewi. Asalkan membantuku begini tak akan mengalihkanmu dari tujuan utamamu."
      Speaker = "Odysseus"
      Event = "OdysseusLooseEndsQuest02"
    }
    {
      Id = "Melinoe_5103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja tidak. Kita akan tuntaskan ini bersama."
      Speaker = "Melinoe"
      Event = "OdysseusLooseEndsQuest02"
    }
    {
      Id = "Odysseus_0581"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bersyukur kau mengizinkanku mengunjungi beberapa mantan rekanku, Dewi. Memang tak mengubah apa pun, tapi... rasanya aku telah menuntaskan beberapa perkara yang tertunda. Soal apa yang akan terjadi selanjutnya... aku mungkin akan pergi sebentar..."
      Speaker = "Odysseus"
      Event = "OdysseusLooseEndsQuestComplete01"
    }
    {
      Id = "Melinoe_5104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Urusan di sini sudah cukup terkendali. Gunakan waktu sebanyak yang kau butuhkan, dan kau akan selalu disambut kapan pun kau kembali. Boleh tahu ke mana kau akan pergi?"
      Speaker = "Melinoe"
      Event = "OdysseusLooseEndsQuestComplete01"
    }
    {
      Id = "Odysseus_0582"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Mencari keluarga fanaku... istri dan putraku. Aku pernah melakukannya dulu. Semoga kali {#Emph}ini {#Prev}tak memakan waktu selama itu."
      Speaker = "Odysseus"
      Event = "OdysseusLooseEndsQuestComplete01"
    }
    {
      Id = "Melinoe_5105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti tidak. Kau pasti sudah memetakan setiap lorong di Dunia Bawah sekarang! Tapi apa yang akan kau lakukan setelahnya?"
      Speaker = "Melinoe"
      Event = "OdysseusLooseEndsQuestComplete01"
    }
    {
      Id = "Odysseus_0583"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan kupikirkan di jalan. Sementara itu, aku sudah menugaskan beberapa Arwah kita untuk mengawasi keadaan, dan sudah berpamitan secara pribadi pada penyihir kita yang baik itu. Jaga dirimu baik-baik selama aku tiada."
      Speaker = "Odysseus"
      Event = "OdysseusLooseEndsQuestComplete01"
    }
    {
      Id = "Melinoe_5106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga perjalananmu selamat, Odysseus..."
      Speaker = "Melinoe"
      Event = "OdysseusLooseEndsQuestComplete01"
    }
    {
      Id = "Melinoe_5108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami merindukanmu di sini, dan aku sangat senang kau sudah kembali! Bagaimana perjalananmu? Kau berhasil menemukan keluargamu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutReturn01"
    }
    {
      Id = "Odysseus_0585"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, Dewi, aku berhasil menemukan mereka. Mengikuti beberapa petunjuk di Elisium, berpapasan dengan beberapa mantan rekan seperjuangan, dan akhirnya sampai di sana. Penelope dan Telemakhos... {#Emph}erm{#Prev}, yah, mereka langsung mengenaliku."
      Speaker = "Odysseus"
      Event = "OdysseusAboutReturn01"
    }
    {
      Id = "Melinoe_5109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah mereka baik-baik saja? Maaf, aku tidak bermaksud mengorek rincian ini darimu, hanya saja... ini kisah terbarumu!"
      Speaker = "Melinoe"
      Event = "OdysseusAboutReturn01"
    }
    {
      Id = "Odysseus_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, apa yang perlu diceritakan? Rasanya... yah, menenangkan. Kurasa waktu yang kami lalui secara terpisah agak menyembuhkan luka lama. Mereka memintaku berkunjung lagi di kemudian hari."
      Speaker = "Odysseus"
      Event = "OdysseusAboutReturn01"
    }
    {
      Id = "Melinoe_5110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa kau memang harus melakukannya. Aku senang semuanya berjalan lancar."
      Speaker = "Melinoe"
      Event = "OdysseusAboutReturn01"
    }
    {
      Id = "Odysseus_0587"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenyataannya bisa saja jauh lebih buruk dari itu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutReturn01"
    }
    {
      Id = "Odysseus_0543"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bolehkah aku menceritakan sesuatu secara rahasia, Dewi? Sepanjang hidup fanaku, aku tak pernah ingin bergantung pada siapa pun. Tapi, aku selalu mendapat bantuan... dari para pejuang hebat, pelaut, bahkan dewa! Namun... tetap saja, meminta bantuan untuk urusan pribadi itu terasa sangat sulit."
      Speaker = "Odysseus"
      Event = "OdysseusAboutAssistance01"
    }
    {
      Id = "Melinoe_5081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham betul perasaan itu. Rasa seperti menunjukkan kelemahan... ketidakmampuan untuk melakukan sesuatu sendiri. Kita berusaha mandiri dan tak ingin menimpakan masalah kita pada kawan-kawan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutAssistance01"
    }
    {
      Id = "Odysseus_0544"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, kita tahu itu {#Emph}bukanlah {#Prev}kelemahan, tapi... kita harus sedikit melawan insting kita sendiri di situ, bukan? Namun intinya, yang ingin kukatakan adalah, {#Emph}terima kasih. {#Prev}Atas bantuan yang telah kauberikan padaku. Kau tak perlu sampai bersusah payah begitu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutAssistance01"
    }
    {
      Id = "Melinoe_5082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja. Kita sudah berjuang sejauh ini bersama-sama."
      Speaker = "Melinoe"
      Event = "OdysseusAboutAssistance01"
    }
    {
      Id = "Odysseus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, terkadang aku rindu sensasi guyuran hujan. Lalu kuingat bertahun-tahun di laut, basah kuyup sampai ke tulang, dan bersyukur kepada para dewa karena hal menyebalkan itu tak bisa lagi mengenaku seperti dulu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutRain01"
    }
    {
      Id = "Melinoe_2179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hujan membawa kehidupan, sekaligus kematian... terutama kematian pada malam ini. Jiwa-Jiwa Tersesat di luar sana tampaknya sama bencinya denganmu terhadap hujan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutRain01"
    }
    {
      Id = "Odysseus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, rasanya hujan itu seolah melunakkan mereka, kan? Membuat mereka matang untuk dipanen. Pergilah tebas beberapa untukku, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutRain01"
    }
    {
      Id = "Melinoe_2180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa aku memang akan melakukannya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutRain01"
    }
    {
      Id = "Odysseus_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah Tulang Jemari tua itu berguna, Dewi? Kelihatannya mungkin agak usang, tapi... benda itu memberiku keberuntungan berkali-kali, baik dalam permainan judi maupun saat nyawaku di ujung tanduk."
      Speaker = "Odysseus"
      Event = "OdysseusAboutKeepsake01"
    }
    {
      Id = "Melinoe_4189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus, jika benda itu sangat berharga bagimu sepanjang hidupmu, mengapa sekarang kauberikan padaku? Tak peduli seberapa bergunanya benda itu sekarang—yang mana sangat berguna!"
      Speaker = "Melinoe"
      Event = "OdysseusAboutKeepsake01"
    }
    {
      Id = "Odysseus_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, tak ada yang membuatku lebih senang selain melihatmu berhasil. Jika sedikit kenang-kenangan dari masa laluku bisa bermanfaat, itu milikmu. Lagipula, aku dapat sebotol Nektar sebagai gantinya!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutKeepsake01"
    }
    {
      Id = "Melinoe_4190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu bukan dimaksudkan sebagai barter."
      Speaker = "Melinoe"
      Event = "OdysseusAboutKeepsake01"
    }
    {
      Id = "Odysseus_0402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Simpan saja Tulang terkutuk itu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutKeepsake01"
    }
    {
      Id = "Odysseus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lihat kiriman terbaru dari Charon, Dewi? Barang di tepi sungai itu semuanya milikmu. Kami juga terus mengawasi sungainya, memastikan ini bukan kiriman yang terakhir."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMailbox01"
    }
    {
      Id = "Melinoe_2335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Charon mengambil risiko besar dengan membantuku secara langsung begini. Apakah kita bisa memberi imbalan yang pantas untuknya?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutMailbox01"
    }
    {
      Id = "Odysseus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa, dengan Emas yang baru-baru ini kita kumpulkan. Dia benar-benar berniat melebur setiap keping koin Chronos yang berhasil kita dapatkan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMailbox01"
    }
    {
      Id = "Melinoe_2336"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah kalau begitu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutMailbox01"
    }
    {
      Id = "Odysseus_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti pelanggan terbaik Charon. Rasanya dia menikmati kunjungan rutinnya ke Underworld, dengan caranya sendiri. Setidaknya sekarang sebagian besar isinya kargo barang, bukan sekadar Arwah orang baru mati yang linglung dan mengeluh melulu..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMailbox02"
    }
    {
      Id = "Melinoe_4217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kau menerima kematianmu dengan terhormat saat waktumu tiba dulu, Odysseus? Kau terlihat seperti orang yang akan mencengkeram kehidupan sekuat tenaga."
      Speaker = "Melinoe"
      Event = "OdysseusAboutMailbox02"
    }
    {
      Id = "Odysseus_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, umurku sudah sangat tua saat itu. Tetap saja aku tak begitu menyukai keadaannya, yah memangnya siapa yang suka! Tapi, aku senang akhirnya mendapat kesempatan bertemu Sang Tukang Perahu yang tersohor itu, dan berlayar menuju Underworld dengan cara yang {#Emph}semestinya{#Prev}."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMailbox02"
    }
    {
      Id = "Melinoe_4218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pernah bilang kalau kau sempat bolak-balik ke Underworld saat masih hidup. Tuan Charon tidak mengantarmu waktu itu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutMailbox02"
    }
    {
      Id = "Odysseus_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja tidak! Yah, mungkin itu kisah untuk malam yang lain."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMailbox02"
    }
    {
      Id = "Odysseus_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebun kecilmu di sana sedikit menceriakan tempat tua ini, Dewi! Di masa-masa sulit, kesenangan sederhana semacam itu sering kali jadi hal pertama yang memudar. Justru saat hal itu paling dibutuhkan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutGarden01"
    }
    {
      Id = "Melinoe_3309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, aku senang mendengarnya, Sang Ahli Taktik. Meski begitu, aku tak menyangka sepetak bunga saja bisa meninggalkan kesan begitu mendalam bagi orang sepertimu."
      Speaker = "Melinoe"
      Event = "OdysseusAboutGarden01"
    }
    {
      Id = "Odysseus_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, kerjaku {#Emph}hanya {#Prev}memperhatikan hal-hal kecil. Kemenangan datang kepada mereka yang hatinya siap menyambutnya. Maksudku, lihatlah kita, semangat adalah satu-satunya hal yang kita punya; dan sekarang, ada bunga!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutGarden01"
    }
    {
      Id = "Melinoe_3310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bantu aku ikut mengawasinya, ya?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutGarden01"
    }
    {
      Id = "Odysseus_0267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Odysseus"
      Event = "OdysseusAboutGarden01"
    }
    {
      Id = "Odysseus_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingat, kita punya beberapa proyek untuk memperluas Crossroads ini yang butuh restumu saat kau sempat nanti, Dewi. Terserah pilihanmu, sama sekali tidak mendesak, kok."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCrossroads01"
    }
    {
      Id = "Melinoe_4222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pada akhirnya air di pemandian air panas dan dermaga pemancingan perlu dimurnikan, belum lagi area kedai taverna. Menurutmu mana yang harus diprioritaskan?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutCrossroads01"
    }
    {
      Id = "Odysseus_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kau tahu sendiri para Arwah suka berkumpul di taverna, jadi kurasa sebaiknya mulai dari sana... atau mana pun yang paling mudah bagimu!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutCrossroads01"
    }
    {
      Id = "Melinoe_4223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kupertimbangkan nanti."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCrossroads01"
    }
    {
      Id = "Odysseus_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Proyek pembaruan yang dulu sering kita bicarakan itu? Aku masih terus memikirkannya, Crossroads ini dipenuhi oleh berbagai kesenangan duniawi...!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutCosmetics01"
    }
    {
      Id = "Melinoe_3800"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga masih memikirkannya, dan baru-baru ini sudah mengambil beberapa langkah awal. Kesejahteraan setiap Arwah di tempat ini sangat penting bagi tujuan kita."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCosmetics01"
    }
    {
      Id = "Odysseus_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi, sepertinya urusan kita sekarang jauh lebih mendesak. Apa kau berniat berhenti melawan Chronos hanya demi mempercantik lingkungan di sini?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutCosmetics01"
    }
    {
      Id = "Melinoe_3801"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak sepenuhnya begitu. Aku sudah memikirkan seorang perwakilan."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCosmetics01"
    }
    {
      Id = "Odysseus_0185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menarik..."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCosmetics01"
    }
    {
      Id = "Odysseus_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau merekrut Arwah yang mencurigakan itu untuk proyek pembaruan! Awal yang serba seadanya tetaplah sebuah awal, aku... senang melihatnya mulai berjalan!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutCosmetics02"
    }
    {
      Id = "Melinoe_3802"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga kau akan berkata begitu! Ini memberi Dora pekerjaan yang berguna. Dan artinya proyek ini takkan berakhir jadi angan-angan belaka."
      Speaker = "Melinoe"
      Event = "OdysseusAboutCosmetics02"
    }
    {
      Id = "Odysseus_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rencana yang mantap, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusAboutCosmetics02"
    }
    {
      Id = "Odysseus_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meja baru ini {#Emph}luar biasa! {#Prev}Ruangannya sangat luas untuk peta seluruh wilayah yang sedang kita pantau, ada kompartemen samping untuk laporan baru kita, dan hasil akhirnya sangat elegan...!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTable01"
    }
    {
      Id = "Melinoe_4215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus, entah kenapa aku tak menyangka kau bisa seantusias ini hanya karena sebuah perabot. Terlebih perabot yang memang benar-benar kau butuhkan untuk menjalankan tugasmu di sini."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTable01"
    }
    {
      Id = "Odysseus_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, tuduhan yang cukup berani... datang dari seseorang yang tampaknya mencintai pekerjaannya {#Emph}setidaknya {#Prev}sama besarnya denganku. Atau mungkin kau memang belum pernah punya {#Emph}meja {#Prev}yang layak atas namamu sendiri?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTable01"
    }
    {
      Id = "Melinoe_4216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau dipikir-pikir, aku memang jarang memakai meja."
      Speaker = "Melinoe"
      Event = "OdysseusAboutTable01"
    }
    {
      Id = "Odysseus_0426"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rugi sekali kau!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutTable01"
    }
    {
      Id = "Odysseus_0525"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tempat ini jadi jauh lebih hidup semenjak Sang Pembuat Musik ada di sini! Pilihan rekruitmen yang bagus, Dewi. Dari dulu aku memang menyukai balada perang yang membakar semangat, tapi variasi lagu lain juga sangat menyenangkan."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMusicPlayer01"
    }
    {
      Id = "Melinoe_4224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga Sang Pembuat Musik akan cepat populer di sini. Ada permintaan lagu tertentu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutMusicPlayer01"
    }
    {
      Id = "Odysseus_0526"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau pasti tak mau tahu; lebih baik {#Emph}kau {#Prev}saja yang mengambil keputusan sulit itu!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutMusicPlayer01"
    }
    {
      Id = "Melinoe_4225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan hidup bersama segala konsekuensinya, ya."
      Speaker = "Melinoe"
      Event = "OdysseusAboutMusicPlayer01"
    }
    {
      Id = "Odysseus_0527"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pencatat Rekor kita di sana itu dulunya pernah bekerja di Ruang Administrasi yang dijaga ketat di kediaman ayahmu, kalau Dewi percaya. Pasti pengalamannya luar biasa!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutGameStats01"
    }
    {
      Id = "Melinoe_4226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahku pasti sangat menghargai pemikiran analitis seperti miliknya. Mungkin setelah semua ini usai, Sang Pencatat Rekor bisa kembali bekerja di Kediaman ayahku."
      Speaker = "Melinoe"
      Event = "OdysseusAboutGameStats01"
    }
    {
      Id = "Odysseus_0528"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat melontarkan ide itu sendiri, tapi entah kenapa Sang Pencatat Rekor malah menciut ketakutan, lalu menolak bicara denganku lagi! Agak aneh juga, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusAboutGameStats01"
    }
    {
      Id = "Melinoe_4227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin dia sudah melewati banyak hal berat."
      Speaker = "Melinoe"
      Event = "OdysseusAboutGameStats01"
    }
    {
      Id = "Odysseus_0529"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah berpenampilan tua yang bergabung dengan kita membawa berbagai pernak-pernik itu... semacam peramal atau orang bijak, ya? Pekerjaan yang tak lazim, menjadi seorang pencatat sejarah."
      Speaker = "Odysseus"
      Event = "OdysseusAboutRunHistory01"
    }
    {
      Id = "Melinoe_5455"
      InheritFrom = "BaseNarrative"
      DisplayName = "Orang Bijak yang renta itu mengingat setiap malam sejak semua ini bermula. Setiap kemenangan dan kekalahan, kini siap untuk kutinjau kembali."
      Speaker = "Melinoe"
      Event = "OdysseusAboutRunHistory01"
    }
    {
      Id = "Odysseus_0530"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eugh... {#Prev}aku tak sudi melihat kembali hidup{#Emph}ku {#Prev}dengan cara seperti itu. Tapi, selera orang kan beda-beda! Dan kurasa itu cara yang bagus untuk belajar dari kesalahan jika kau punya nyali untuk menghadapinya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutRunHistory01"
    }
    {
      Id = "Melinoe_5456"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, aku punya nyali."
      Speaker = "Melinoe"
      Event = "OdysseusAboutRunHistory01"
    }
    {
      Id = "Odysseus_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi sudah berjuang setidaknya selama lima puluh malam. Belum adakah kesempatan untuk memberi dirimu sedikit rehat? Kau terlalu memforsir diri, itu saja."
      Speaker = "Odysseus"
      Event = "OdysseusAboutRunProgress01"
    }
    {
      Id = "Melinoe_4202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat rehat di sela-sela waktu, terima kasih. Di pemandian air panas, kebun, kedai minum... bahkan sekadar berbincang seperti ini! Bukan berarti aku terus memforsir diri di setiap waktu terjagaku."
      Speaker = "Melinoe"
      Event = "OdysseusAboutRunProgress01"
    }
    {
      Id = "Odysseus_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar juga, kita takkan pernah bisa memforsir diri sekeras mungkin selama yang kita inginkan. Tapi, Dewi sudah melangkah sangat jauh, dan kalau-kalau Dewi tidak mencatatnya, akulah yang menghitungnya!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutRunProgress01"
    }
    {
      Id = "Melinoe_4203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah. Dan aku akan melangkah lebih jauh lagi."
      Speaker = "Melinoe"
      Event = "OdysseusAboutRunProgress01"
    }
    {
      Id = "Odysseus_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini kira-kira malam keseratusmu, Dewi... setidaknya sudah beberapa bulan purnama dalam hitungan fana. Terasa lama, tapi sekaligus sekejap mata. Begitulah liciknya ulah Chronos!"
      Speaker = "Odysseus"
      Event = "OdysseusAboutRunProgress02"
    }
    {
      Id = "Melinoe_4204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir kau benar, setelah kau sebutkan barusan! Berlalunya waktu selalu terasa aneh bagiku, terlebih lagi sejak semua ini dimulai. Apakah kau merasakan hal serupa di masa fanamu?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutRunProgress02"
    }
    {
      Id = "Odysseus_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, Dewi takkan bisa membayangkannya. Pasti terasa jauh lebih aneh lagi bagi para dewa... begitu banyak waktu bisa berlalu dalam sekejap mata! Yang terbaik yang bisa kita lakukan adalah memanfaatkannya dengan bijak."
      Speaker = "Odysseus"
      Event = "OdysseusAboutRunProgress02"
    }
    {
      Id = "Odysseus_0710"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurut hitungan kami, Dewi sudah menang lebih dari lima puluh malam sekarang. Aku hanya ingin meluangkan waktu sejenak untuk merayakan pencapaian itu bersamamu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutRunProgress03"
    }
    {
      Id = "Melinoe_5447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah sudah selama itu? Waktu memang bekerja dengan cara yang aneh."
      Speaker = "Melinoe"
      Event = "OdysseusAboutRunProgress03"
    }
    {
      Id = "Odysseus_0711"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, kurasa kita semua sepakat soal itu sekarang."
      Speaker = "Odysseus"
      Event = "OdysseusAboutRunProgress03"
    }
    {
      Id = "Odysseus_0712"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lima ratus malam sejak semua ini dimulai, Dewi. Yah, kurang lebih begitu. Bagi kaum fana... itu waktu yang cukup lama. Mungkin bahkan bagi dirimu juga."
      Speaker = "Odysseus"
      Event = "OdysseusAboutRunProgress04"
    }
    {
      Id = "Melinoe_5448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhenti menghitungnya di titik tertentu, dan melepaskan kepekaan masuk akal tentang berlalunya waktu. Kapan kira-kira kita harus menyudahi semua ini?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutRunProgress04"
    }
    {
      Id = "Odysseus_0713"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapan pun Dewi menghendakinya, tak sedetik pun lebih cepat dari itu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutRunProgress04"
    }
    {
      Id = "Odysseus_0651"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya situasi belakangan ini sudah Dewi kendalikan dengan sangat baik. Beri tahu saja jika butuh sesuatu, meski kurasa malam-malam saat Dewi membutuhkan Psyche atau Abu dan semacamnya sudah berlalu."
      Speaker = "Odysseus"
      Event = "OdysseusAboutNoMoreStuff01"
    }
    {
      Id = "Melinoe_5446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus, aku lebih membutuhkan kehadiranmu di sini daripada pasokan sumber dayamu, meski bantuan itu sering kali sangat berguna juga. Mari kita pertahankan ini, ya?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutNoMoreStuff01"
    }
    {
      Id = "Odysseus_0652"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedengarannya seperti rencana yang sangat masuk akal bagiku."
      Speaker = "Odysseus"
      Event = "OdysseusAboutNoMoreStuff01"
    }
    {
      Id = "Odysseus_0606"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang bisa kubantu akhir-akhir ini, Dewi? Sungguh melegakan, saat pekerjaan kita akhirnya kurang lebih selesai. Sebenarnya, pekerjaannya sendiri takkan pernah ada habisnya, tapi setidaknya sebagian beban pikiran sudah hilang untuk saat ini."
      Speaker = "Odysseus"
      Event = "OdysseusAboutLittleToSay01"
    }
    {
      Id = "Melinoe_5466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beban pikiran yang kita ciptakan sendiri selalu ada! Tapi kau benar, belakangan ini tekanannya tidak terlalu berat. Soal bantuanmu... mari kita terus berbincang setiap kali kita di sini!"
      Speaker = "Melinoe"
      Event = "OdysseusAboutLittleToSay01"
    }
    {
      Id = "Odysseus_0607"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja. Mengobrol kebetulan adalah salah satu keahlian lamaku."
      Speaker = "Odysseus"
      Event = "OdysseusAboutLittleToSay01"
    }
    {
      Id = "Odysseus_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemarilah, Dewi! Aku baru saja mendongeng pada para Arwah ini tentang pertama kalinya aku menginjakkan kaki di Underworld. Saat aku masih hidup dan bernapas, kalau Dewi percaya! Dan begitulah caraku berhasil keluar."
      Speaker = "Odysseus"
      Event = "OdysseusBackstory02"
    }
    {
      Id = "Melinoe_2197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Odysseus, tak ada yang bisa lolos dari sini saat ayahku berkuasa. Apa para Arwah ini benar-benar semudah itu dibodohi?"
      Speaker = "Melinoe"
      Event = "OdysseusBackstory02"
    }
    {
      Id = "Odysseus_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku {#Emph}serius setengah mati! {#Prev}Kisah-kisahku ini tidak... seberlebihan kelihatannya, kok! Tapi sekarang, gerbang neraka terbuka lebar, bukan...?"
      Speaker = "Odysseus"
      Event = "OdysseusBackstory02"
    }
    {
      Id = "Melinoe_2198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita akan menyegelnya rapat-rapat."
      Speaker = "Melinoe"
      Event = "OdysseusBackstory02"
    }
    {
      Id = "Melinoe_2197_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Odysseus. Apa para Arwah ini benar-benar semudah itu dibodohi?"
      Speaker = "Melinoe"
      Event = "OdysseusBackstory02_B"
    }
    {
      Id = "Melinoe_5243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak akan lama lagi!"
      Speaker = "Melinoe"
      Event = "OdysseusBackstory02_B"
    }
    {
      Id = "Odysseus_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Salam, Dewi, aku, {#Emph}ahm... {#Prev}tidak menyadari kedatanganmu. Rasanya ingin menyalahkan faktor usia yang makin menua, tapi aku tak punya alasan semacam itu dalam wujud begini."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMood01"
    }
    {
      Id = "Melinoe_2199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bermaksud mengejutkanmu. Bagaimana suasana di sekitar sini, semuanya baik-baik saja?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutMood01"
    }
    {
      Id = "Odysseus_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suasana dan semuanya cukup baik. Barisan kita kian bertambah dengan para Arwah yang tergerak oleh kabar bahwa Sang Putri Underworld telah kembali, dengan dendam membara di benaknya."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMood01"
    }
    {
      Id = "Melinoe_2200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang lebih membakar semangat massa selain sumpah pembalasan dendam. Tapi, bagaimana denganmu sendiri?"
      Speaker = "Melinoe"
      Event = "OdysseusAboutMood01"
    }
    {
      Id = "Odysseus_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya aman terkendali bagiku; terutama setelah istirahat sejenak di sini. Jaga dirimu, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusAboutMood01"
    }
    {
      Id = "Melinoe_2201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga."
      Speaker = "Melinoe"
      Event = "OdysseusAboutMood01"
    }
    {
      Id = "Melinoe_2118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus, apa kau melihat Hecate di sekitar sini?"
      Speaker = "Melinoe"
      Event = "OdysseusHideAndSeek01"
    }
    {
      Id = "Odysseus_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm{#Prev}, belum lama ini tidak lihat, Dewi kecil. Tapi, kupikir topi runcingnya itu bakal langsung ketahuan!"
      Speaker = "Odysseus"
      Event = "OdysseusHideAndSeek01"
    }
    {
      Id = "Melinoe_2119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan mencarinya! Terima kasih!"
      Speaker = "Melinoe"
      Event = "OdysseusHideAndSeek01"
    }
    {
      Id = "Odysseus_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beliau pasti ada di sekitar sini, Dewi kecil!"
      Speaker = "Odysseus"
      Event = "OdysseusHideAndSeek01"
    }
    {
      Id = "Odysseus_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini memang tak seberapa, tapi para Arwah kita di luar sana, mereka... mengumpulkan beberapa {#Emph}bahan {#Prev}yang kami rasa bisa berguna untukmu. Ini! Setidaknya cuma ini yang bisa kami perbuat."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsMetaCardPoints01"
    }
    {
      Id = "Melinoe_4093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Abu Orang Mati... Odysseus, apa ini...? Para Arwah merelakan sisa-sisa jasad fana mereka sendiri. Semuanya demi perjuangan kita."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsMetaCardPoints01"
    }
    {
      Id = "Odysseus_0360"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan siapa yang bisa menyalahkan mereka?"
      Speaker = "Odysseus"
      Event = "OdysseusGrantsMetaCardPoints01"
    }
    {
      Id = "Odysseus_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu saat aku masih fana, perunggu adalah logam paling berharga yang kukenal, begitu cepatnya ia bisa merenggut nyawa seseorang. Tapi aku mulai paham kenapa kau begitu menghargai perak! Ayo. Ambillah! Para Arwah dan aku, kami sangat bersikeras memintamu menerimanya."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsOreFSilver01"
    }
    {
      Id = "Melinoe_4094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Perak semurni ini tak mudah didapat, bahkan dengan peralatan yang tepat sekalipun. Aku akan memanfaatkannya sebaik mungkin, demi kita semua."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsOreFSilver01"
    }
    {
      Id = "Odysseus_0362"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya itu yang kami harapkan."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsOreFSilver01"
    }
    {
      Id = "Odysseus_0641"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami berhasil mengumpulkan beberapa bahan dari permukaan dan mengira kau mungkin bisa memanfaatkannya, Dewi. Siapa pun pemilik Perunggu ini dulunya, mereka sudah lama tiada."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsOreNBronze01"
    }
    {
      Id = "Melinoe_5236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini logam serbaguna, terima kasih. Senjata Nokturnal yang kugunakan tampaknya mendambakannya, begitu pula perak dan yang lainnya."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsOreNBronze01"
    }
    {
      Id = "Odysseus_0642"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Asalkan senjata itu tidak mendambakan kami para Arwah!"
      Speaker = "Odysseus"
      Event = "OdysseusGrantsOreNBronze01"
    }
    {
      Id = "Odysseus_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sedang berburu bahan-bahan untuk kuali itu, kan, Dewi? Ini, mungkin kau bisa memakainya. Kudengar ini bukan sekadar bunga biasa."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsPlantFMoly01"
    }
    {
      Id = "Melinoe_4095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bunga Moly segar...! Akarnya masih hitam sempurna. Beberapa mantra yang sedang kupikirkan akan sangat terbantu dengan ini. Dari mana kau tahu?"
      Speaker = "Melinoe"
      Event = "OdysseusGrantsPlantFMoly01"
    }
    {
      Id = "Odysseus_0364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oh{#Prev}, aku punya caraku sendiri."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsPlantFMoly01"
    }
    {
      Id = "Odysseus_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan lajumu yang sekarang, kau akan segera melampaui penyihir hebat itu, Dewi! Setidaknya begitulah kata beberapa Arwah kita, dan argumen mereka cukup meyakinkan. Ini! Lambang keyakinan mereka."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsMemPointsCommon01"
    }
    {
      Id = "Melinoe_4096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka rela melepaskan sebagian Psyche mereka, demi membantu tugas yang takkan pernah bisa kuselesaikan sendirian..."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsMemPointsCommon01"
    }
    {
      Id = "Odysseus_0366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Untungnya, kau memang tidak harus melakukannya sendirian!"
      Speaker = "Odysseus"
      Event = "OdysseusGrantsMemPointsCommon01"
    }
    {
      Id = "Odysseus_0643"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat kau sedang mengurus Hypnos di sana. Dulu sewaktu aku mencoba meredam dengkurannya, kutemukan {#Emph}benda-benda ini {#Prev}terselip di lipatan... itu selimut atau jubah, ya...?"
      Speaker = "Odysseus"
      Event = "OdysseusGrantsPlantIPoppySeed01"
    }
    {
      Id = "Melinoe_5237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini benih bunga Poppy penidur! Aku mungkin sangat membutuhkannya jika ingin dia terbangun. Terima kasih! Dan kurasa, itu jubah?"
      Speaker = "Melinoe"
      Event = "OdysseusGrantsPlantIPoppySeed01"
    }
    {
      Id = "Odysseus_0644"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, kelihatannya sangat nyaman..."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsPlantIPoppySeed01"
    }
    {
      Id = "Odysseus_0367"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sedikit bingkisan untukmu, Dewi. Hadiah berupa sisa kerangka mungkin dipandang buruk di tanah asalku dulu, tapi ya... kau punya rasa hormat yang lebih besar pada orang mati dibanding manusia fana pada umumnya."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsMetaCurrency01"
    }
    {
      Id = "Melinoe_4097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bones ini jumlahnya lebih banyak daripada yang bisa kuhitung kilat, atau kucari sendiri. Kalau begitu, akan kuserahkan ke Pialang Malang!"
      Speaker = "Melinoe"
      Event = "OdysseusGrantsMetaCurrency01"
    }
    {
      Id = "Odysseus_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan dapatkan kesepakatan yang adil sebagai gantinya."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsMetaCurrency01"
    }
    {
      Id = "Odysseus_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bukan tipe yang terlalu merisaukan apa yang telah disiapkan Tiga Fates untuk kita, Dewi, tapi... aku punya secarik Kain yang kami yakini merupakan buah karya mereka. Dan sekarang ini milikmu."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsMetaFabric01"
    }
    {
      Id = "Melinoe_4098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fate Fabric! Jarang ada cara yang lebih baik untuk memastikan kuali menyalurkan efek sihir dengan sempurna. Aku tentu bisa memanfaatkannya jika kau berbaik hati memberikannya."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsMetaFabric01"
    }
    {
      Id = "Odysseus_0370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, aku tidak {#Emph}baik hati{#Prev}, aku cuma... tidak suka kalah."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsMetaFabric01"
    }
    {
      Id = "Odysseus_0371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang indah, bukan? Malam di mana kita bisa melihat sekilas Sang Bulan di tengah lajunya melintasi angkasa. Dia bahkan meninggalkan sesuatu untukmu di sini."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsCardUpgradePoints01"
    }
    {
      Id = "Melinoe_4099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Moon Dust. Kau tak tahu betapa aku sangat membutuhkannya dalam meditasiku belakangan ini...! Meskipun sebenarnya kau selalu tahu, kan?"
      Speaker = "Melinoe"
      Event = "OdysseusGrantsCardUpgradePoints01"
    }
    {
      Id = "Odysseus_0372"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Paling tidak ada satu."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsCardUpgradePoints01"
    }
    {
      Id = "Odysseus_0637"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu dulu biasa menjaga gudang penyimpanan Batu Permata, tapi akhir-akhir ini barang itu makin langka. Sekarang karena Makelar kita mencarinya, aku ingin kau mengambil ini."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGemStones01"
    }
    {
      Id = "Melinoe_5234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi bukankah ini milikmu? Tunggu, kau pasti akan bilang ini milik alam baka, jadi sebaiknya kuambil saja."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsGemStones01"
    }
    {
      Id = "Odysseus_0638"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali tebakanmu!"
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGemStones01"
    }
    {
      Id = "Odysseus_0639"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Arwah yang baru-baru ini kau rekrut di Tartarus menyiapkan bingkisan kecil, tapi... tampaknya terlalu gugup untuk menyerahkannya sendiri. Ini! Batu Permata dari dasar terdalam."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGemStones02"
    }
    {
      Id = "Melinoe_5235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka baik sekali! Tolong sampaikan rasa terima kasihku, dan beri tahu mereka tak perlu takut lagi sekarang setelah berada di sini."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsGemStones02"
    }
    {
      Id = "Odysseus_0640"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kusampaikan, tapi aku tak jamin mereka akan percaya."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGemStones02"
    }
    {
      Id = "Odysseus_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu untukmu, Dewi. Barangkali kebun kecil kita di sana butuh sedikit tambahan tanaman hijau... atau kalau kau bingung mau menanam apa berikutnya."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsSeedMystery01"
    }
    {
      Id = "Melinoe_4100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Odysseus! Tapi, apa ini? Aku selalu berusaha menata benih apa pun yang kutemukan dengan rapi."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsSeedMystery01"
    }
    {
      Id = "Odysseus_0374"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benih Misterius! Sedikit kejutan."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsSeedMystery01"
    }
    {
      Id = "Odysseus_0649"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku belum pernah melihat kebun kecil tumbuh sesubur milik kita di sana. Hasilnya nyaris tanpa usaha keras! Tapi lalu aku teringat siapa ibumu dan jadi paham. Ini, agar kebunnya tetap mekar berseri."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsSeedMystery02"
    }
    {
      Id = "Melinoe_5240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih! Kurasa fakta bahwa ibuku dewi kesuburan mungkin jadi alasan kenapa aku berbakat merawat tanaman. Atau mungkin karena nenekku dewi musim."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsSeedMystery02"
    }
    {
      Id = "Odysseus_0650"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sombong sekali. Kau sebaiknya jadi petani saja kalau urusan sihir-menyihir ini tidak membuahkan hasil!"
      Speaker = "Odysseus"
      Event = "OdysseusGrantsSeedMystery02"
    }
    {
      Id = "Melinoe_5241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan rencana yang buruk."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsSeedMystery02"
    }
    {
      Id = "Odysseus_0375"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Arwah kita melaporkan hal-hal baik tentang Hewan Familiar-mu, tahu. Tidak semua makhluk semacam itu bisa akur dengan arwah orang mati, jadi... ini sedikit tanda apresiasi!"
      Speaker = "Odysseus"
      Event = "OdysseusGrantsFamiliarPoints01"
    }
    {
      Id = "Melinoe_4101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudapan Penyihir, dimasak hingga sempurna. Kepala Sekolah pasti membuat sendiri kelompok racikan ini... apa beliau tahu kau memberikan ini padaku?"
      Speaker = "Melinoe"
      Event = "OdysseusGrantsFamiliarPoints01"
    }
    {
      Id = "Odysseus_0376"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima saja hadiah sialan ini, Dewi, para Arwah bersikeras memberikannya!"
      Speaker = "Odysseus"
      Event = "OdysseusGrantsFamiliarPoints01"
    }
    {
      Id = "Odysseus_0635"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu lagi untuk Hewan Familiar-mu, Dewi. Argos di sini, dia pasti akan menyukainya semasa kami masih fana dulu, kurasa! Jangan tanya dari mana kudapat, ambil saja."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsFamiliarPoints02"
    }
    {
      Id = "Melinoe_5233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Butuh seluruh tekadku untuk menuruti perkataanmu, Odysseus, karena Kudapan Penyihir tidak mudah didapat. Atas nama Hewan Familiar-ku, terima kasih!"
      Speaker = "Melinoe"
      Event = "OdysseusGrantsFamiliarPoints02"
    }
    {
      Id = "Odysseus_0636"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama-sama, mereka juga sangat diterima di sini."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsFamiliarPoints02"
    }
    {
      Id = "Odysseus_0629"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya persembahan untukmu, Dewi! Atas nama semua Arwah yang tinggal di sini, kami merasa terhormat melayanimu dan siap melakukan apa pun demi meraih kemenangan! Tolong bagikan rampasan ini kepada siapa pun yang kau rasa pantas menerimanya."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGiftPoints01"
    }
    {
      Id = "Melinoe_5230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedikit Nektar, terima kasih! Aku merasa seperti salah satu dewa Olympus sekarang. Kau benar-benar tidak keberatan kalau kubagikan botol-botol ini ke yang lain?"
      Speaker = "Melinoe"
      Event = "OdysseusGrantsGiftPoints01"
    }
    {
      Id = "Odysseus_0630"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku dan para Arwah hanya akan keberatan kalau kau menimbunnya sendiri."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGiftPoints01"
    }
    {
      Id = "Odysseus_0631"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang ini atas nama para Arwah yang baru-baru ini kau undang ke Persimpangan, Dewi. Barisan kita makin bersemangat berkat rekrutan baru ini, dan tampaknya mereka cukup dermawan! Ini."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGiftPoints02"
    }
    {
      Id = "Melinoe_5231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Botol-botol Nektar, terima kasih... untuk kalian semua! Aku penasaran dari mana mereka menemukannya, tapi aku terpikir beberapa kenalan yang mungkin akan menyukainya."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsGiftPoints02"
    }
    {
      Id = "Odysseus_0632"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, kami sudah menduga kau akan memanfaatkannya dengan baik."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGiftPoints02"
    }
    {
      Id = "Odysseus_0633"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah lama menyimpan sesuatu yang ingin kuberikan padamu. Sebotol Ambrosia ini pernah kudapatkan dari seorang dewi, jadi... sudah sepantasnya kuberikan pada dewi lainnya. Kurasa rasanya akan jauh lebih nikmat bersamamu. Ini, anggap saja aku memaksa."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsSuperGiftPoints01"
    }
    {
      Id = "Melinoe_5232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus, apa kau yakin aku boleh menerimanya? Mungkin kita semua bisa menikmatinya bersama di kedai pada kesempatan yang tepat nanti."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsSuperGiftPoints01"
    }
    {
      Id = "Odysseus_0634"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu ide yang bagus sekali."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsSuperGiftPoints01"
    }
    {
      Id = "Odysseus_0645"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihat pemandian air panas di belakang sana sudah pulih. Saat kau ingin menggunakannya lagi nanti, ini... seharusnya bisa menjaga airnya tetap murni."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGiftPointsRare01"
    }
    {
      Id = "Melinoe_5238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Garam Mandi, terima kasih banyak untuk ini. Aku tahu banyak hal sedang terjadi, tapi kita semua harus mengunjungi pemandian itu kapan-kapan."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsGiftPointsRare01"
    }
    {
      Id = "Odysseus_0646"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sama sekali tak keberatan."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGiftPointsRare01"
    }
    {
      Id = "Odysseus_0647"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau ingin berlatih menggunakan Joran Pancing itu, sekarang setidaknya kita punya dermaga yang kokoh untuk memancing. Ini, aku punya beberapa Umpan cadangan kalau-kalau kau menginginkannya."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGiftPointsEpic01"
    }
    {
      Id = "Melinoe_5239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, aku memang suka mendatangi dermaga pemancingan! Baik untuk berlatih melempar joran, maupun mencari tempat yang tenang untuk mengobrol."
      Speaker = "Melinoe"
      Event = "OdysseusGrantsGiftPointsEpic01"
    }
    {
      Id = "Odysseus_0648"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beri pelajaran pada bajingan-bajingan penghuni sungai itu demi aku."
      Speaker = "Odysseus"
      Event = "OdysseusGrantsGiftPointsEpic01"
    }
    {
      Id = "Hecate_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Taktisi membawa kabar buruk dengan nada optimis. Baiklah. Lalu bagaimana kabar dari orang-orang di kepulauan, jika memang masih ada yang selamat?"
      Speaker = "Hecate"
      Event = "OdysseusWithHecate01"
    }
    {
      Id = "Odysseus_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurut orang-orang kepercayaanku, sayangnya mereka semua telah berikrar setia pada Chronos. Manusia fana... mereka kerap menginginkan apa pun yang tak mereka miliki. Dalam hal ini, Zaman Keemasan lainnya. Lebih tepatnya, {#Emph}janji{#Prev} akan hal itu."
      Speaker = "Odysseus"
      Event = "OdysseusWithHecate01"
    }
    {
      Id = "Hecate_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan janji, melainkan sebuah {#Emph}dusta{#Prev} yang memicu pengkhianatan mereka. Kalau begitu, mereka akan binasa... oleh murka para dewa."
      Speaker = "Hecate"
      Event = "OdysseusWithHecate01"
    }
    {
      Id = "Odysseus_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kelak jiwa-jiwa malang itu akan memburu kita dengan dendam yang kian membara. Aku pernah menyaksikan perang tanpa akhir sebelumnya, Nyonya. Begitu pula Anda sekalian para dewa. Bagaimana cara kita menghentikan ini?"
      Speaker = "Odysseus"
      Event = "OdysseusWithHecate01"
    }
    {
      Id = "Hecate_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kita{#Prev} tak bisa. Namun, {#Emph}Melinoë{#Prev}? Tentu saja {#Emph}kau{#Prev} bisa, bukan?"
      Speaker = "Hecate"
      Event = "OdysseusWithHecate01"
    }
    {
      Id = "Melinoe_0459"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bisa dan pasti akan melakukannya."
      Speaker = "Melinoe"
      Event = "OdysseusWithHecate01"
    }
    {
      Id = "Odysseus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dan, {#Emph}ehm{#Prev}, sekian laporanku kali ini, Nyonya. Jika ada pertanyaan, jangan ragu untuk memanggilku kapan saja."
      Speaker = "Odysseus"
      Event = "OdysseusWithHecate02"
    }
    {
      Id = "Hecate_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti, Odysseus. Meski begitu, ada satu hal lagi yang ingin kubicarakan denganmu, dan sebaiknya secara empat mata..."
      Speaker = "Hecate"
      Event = "OdysseusWithHecate02"
    }
    {
      Id = "Odysseus_0150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja, Nyonya."
      Speaker = "Odysseus"
      Event = "OdysseusWithHecate02"
    }
    {
      Id = "Odysseus_0708"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Singkatnya, pembangunan kembali terus berjalan, meski tak secepat itu, dan kerusakan di permukaan sudah terkendali. Luka-luka yang perlahan akan sembuh. Kita lihat saja bekas luka apa yang tersisa nanti."
      Speaker = "Odysseus"
      Event = "OdysseusWithHecate03"
    }
    {
      Id = "Hecate_0881"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari Selene membuat penilaian serupa. Kalau begitu... apa rencanamu selanjutnya, Odysseus? Kau bisa mengunjungi permukaan selagi Dunia Bawah masih porak-poranda."
      Speaker = "Hecate"
      Event = "OdysseusWithHecate03"
    }
    {
      Id = "Odysseus_0709"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku mungkin akan berkelana sebentar, Nyonya, tapi... atas izin Anda, untuk saat ini aku ingin tetap menjadikan Crossroads sebagai markas operasiku. Kurasa kerja sama kita di sini berjalan sangat baik, bukan?"
      Speaker = "Odysseus"
      Event = "OdysseusWithHecate03"
    }
    {
      Id = "Hecate_0882"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa dibilang, tentu saja demikian."
      Speaker = "Hecate"
      Event = "OdysseusWithHecate03"
    }
    {
      Id = "Odysseus_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maksudku, kemungkinannya selalu ada. Waspada tanpa henti itu nyaris mustahil. Musuh selalu memanfaatkan kelengahan semacam itu... Pernahkah kuceritakan padamu tentang siasat kuda kayu kuno itu?"
      Speaker = "Odysseus"
      Event = "OdysseusWithNemesis01"
    }
    {
      Id = "Nemesis_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siasat kuda kayu kuno, ya, ya. Reputasimu sebagai Sang Taktisi Hebat tentu tidak cuma bergantung pada satu kisah ini saja, kan?"
      Speaker = "Nemesis"
      Event = "OdysseusWithNemesis01"
    }
    {
      Id = "Odysseus_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, tapi kisah klasik harus terus diceritakan ulang! Namun, jika kau lebih suka yang lain, aku masih punya segudang kisah tipu muslihat dan keberanian. Ambil contoh Gua Cyclops!"
      Speaker = "Odysseus"
      Event = "OdysseusWithNemesis01"
    }
    {
      Id = "Nemesis_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan Gua Cyclops lagi..."
      Speaker = "Nemesis"
      Event = "OdysseusWithNemesis01"
    }
    {
      Id = "Odysseus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hati-hati dan perhatikan langkahmu di luar sana, paham?"
      Speaker = "Odysseus"
      Event = "OdysseusChat01"
    }
    {
      Id = "Odysseus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siap mencoba peruntungan sekali lagi, Dewi?"
      Speaker = "Odysseus"
      Event = "OdysseusChat02"
    }
    {
      Id = "Odysseus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau aku jadi Chronos, aku pasti ketakutan setengah mati melihatmu."
      Speaker = "Odysseus"
      Event = "OdysseusChat03"
    }
    {
      Id = "Odysseus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua urusan di sini terkendali dengan baik."
      Speaker = "Odysseus"
      Event = "OdysseusChat04"
    }
    {
      Id = "Odysseus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuatkan hatimu, Dewi. Dan jangan beri ampun kepada musuhmu, mengerti?"
      Speaker = "Odysseus"
      Event = "OdysseusChat05"
    }
    {
      Id = "Odysseus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kiranya sinar rembulan menuntunmu, seperti kata kalian para penyihir."
      Speaker = "Odysseus"
      Event = "OdysseusChat06"
    }
    {
      Id = "Odysseus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekacauan yang cukup pelik yang kita hadapi ini, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusChat07"
    }
    {
      Id = "Odysseus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu situasinya tampak mengerikan, tapi tabahkan hatimu. Kita akan lalui ini bersama."
      Speaker = "Odysseus"
      Event = "OdysseusChat08"
    }
    {
      Id = "Odysseus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada kemajuan dalam memenggal kepala Chronos?"
      Speaker = "Odysseus"
      Event = "OdysseusChat09"
    }
    {
      Id = "Odysseus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pastikan kau menghantam telak kelemahan mereka untukku, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusChat10"
    }
    {
      Id = "Odysseus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kondisi di sini cukup aman. Sampai jumpa lagi saat kau kembali."
      Speaker = "Odysseus"
      Event = "OdysseusChat11"
    }
    {
      Id = "Odysseus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mati Chronos dan segala tetek bengeknya, kan?"
      Speaker = "Odysseus"
      Event = "OdysseusChat12"
    }
    {
      Id = "Odysseus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mohon maaf, Dewi, aku harus segera mengirimkan surat-menyurat ini ke permukaan."
      Speaker = "Odysseus"
      Event = "OdysseusChat13"
    }
    {
      Id = "Odysseus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasokan perbekalan baru tiba saat kau sedang pergi tadi."
      Speaker = "Odysseus"
      Event = "OdysseusChat14"
    }
    {
      Id = "Odysseus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan pedulikan aku, Dewi, aku hanya sedang sibuk merancang beberapa siasat terbaru kita."
      Speaker = "Odysseus"
      Event = "OdysseusChat15"
    }
    {
      Id = "Odysseus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita punya banyak simpatisan di permukaan maupun di bawah sini yang masih setia kepada ayahmu."
      Speaker = "Odysseus"
      Event = "OdysseusChat16"
    }
    {
      Id = "Odysseus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergilah ke sana dan bantai beberapa pengkhianat celaka itu untukku, ya, Dewi?"
      Speaker = "Odysseus"
      Event = "OdysseusChat17"
    }
    {
      Id = "Odysseus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekali lagi kau sudi hadir dan menyapaku di sini, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusChat18"
    }
    {
      Id = "Odysseus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh{#Prev}, andai saja kita bisa berbincang lebih lama, tapi ada urusan yang harus kuselesaikan."
      Speaker = "Odysseus"
      Event = "OdysseusChat19"
    }
    {
      Id = "Odysseus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Dewi Mimpi Buruk berdiri di hadapanku dalam segala kemegahannya..."
      Speaker = "Odysseus"
      Event = "OdysseusChat20"
    }
    {
      Id = "Odysseus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau butuh apa pun, kau tahu ke mana mencariku, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusChat21"
    }
    {
      Id = "Odysseus_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kembalilah dengan selamat, atau aku sendiri yang terpaksa keluar ke sana untuk menyeretmu pulang."
      Speaker = "Odysseus"
      Event = "OdysseusChat22"
    }
    {
      Id = "Odysseus_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pembalasanmu akan terlaksana, Dewi. Aku yakin sekali akan hal itu."
      Speaker = "Odysseus"
      Event = "OdysseusChat23"
    }
    {
      Id = "Odysseus_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita pasti bisa keluar dari kemelut ini, percayalah padaku, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusChat24"
    }
    {
      Id = "Odysseus_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga sihir dan perakmu selalu melindungimu dengan baik."
      Speaker = "Odysseus"
      Event = "OdysseusChat25"
    }
    {
      Id = "Odysseus_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang tahu apa yang disiapkan para Takdir untuk kita, bukan?"
      Speaker = "Odysseus"
      Event = "OdysseusChat26"
    }
    {
      Id = "Odysseus_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan berada di dekatmu, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusChat27"
    }
    {
      Id = "Odysseus_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melewati masa-masa sulit seperti ini membuat ikatan kita kian erat."
      Speaker = "Odysseus"
      Event = "OdysseusChat28"
    }
    {
      Id = "Odysseus_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir baik itu sangat bangga padamu, kau tahu itu, 'kan?"
      Speaker = "Odysseus"
      Event = "OdysseusChat29"
    }
    {
      Id = "Odysseus_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah-arwah kita akan terus mengabari perkembanganmu."
      Speaker = "Odysseus"
      Event = "OdysseusChat30"
    }
    {
      Id = "Odysseus_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang lebih menyedihkan dibanding terpisah dari keluarga, benar begitu...?"
      Speaker = "Odysseus"
      Event = "OdysseusChat31"
    }
    {
      Id = "Odysseus_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami akan mendukungmu di setiap langkah, berapa malam pun yang dibutuhkan, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusChat32"
    }
    {
      Id = "Odysseus_0714"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lebih tahu dari siapa pun bahwa tidak semua malam berjalan sesuai rencana kita. Semoga malam berikutnya lebih baik."
      Speaker = "Odysseus"
      Event = "OdysseusChat33"
    }
    {
      Id = "Odysseus_0715"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami terus mengawasi kakekmu untuk berjaga-jaga, tapi keadaannya baik-baik saja."
      Speaker = "Odysseus"
      Event = "OdysseusChat34"
    }
    {
      Id = "Odysseus_0716"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemulihan Dunia Bawah bakal memakan waktu cukup lama, bukan?"
      Speaker = "Odysseus"
      Event = "OdysseusChat35"
    }
    {
      Id = "Odysseus_0717"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir baik itu mungkin pengajar terbaik di dunia, tapi kau sendiri murid yang luar biasa."
      Speaker = "Odysseus"
      Event = "OdysseusChat36"
    }
    {
      Id = "Odysseus_0718"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita punya Arwah mata-mata yang mengawasi segala hal dari Olympus sampai Tartarus."
      Speaker = "Odysseus"
      Event = "OdysseusChat37"
    }
    {
      Id = "Odysseus_0719"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami dengar kau berhasil mencapai puncak Olympus, dan meraih hasil yang kau harapkan."
      Speaker = "Odysseus"
      Event = "OdysseusChat38"
    }
    {
      Id = "Odysseus_0720"
      InheritFrom = "BaseNarrative"
      DisplayName = "Laporan menyebutkan kau sudah sampai ke kedalaman Tartarus, dan pasti sudah membereskan urusan di bawah sana."
      Speaker = "Odysseus"
      Event = "OdysseusChat39"
    }
    {
      Id = "Odysseus_0721"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada kalanya kau semakin mengingatkanku pada sang penyihir baik."
      Speaker = "Odysseus"
      Event = "OdysseusChat40"
    }
    {
      Id = "Odysseus_0722"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjalanan yang luar biasa bagi kita. Selama kita terus melangkah dengan ritme yang tepat."
      Speaker = "Odysseus"
      Event = "OdysseusChat41"
    }
    {
      Id = "Odysseus_0723"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluargaku kabarnya baik-baik saja. Aku sempat punya kesempatan mengunjungi mereka lagi."
      Speaker = "Odysseus"
      Event = "OdysseusChat42"
    }
    {
      Id = "Odysseus_0724"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihat kau dan Nemesis bisa akur."
      Speaker = "Odysseus"
      Event = "OdysseusChat43"
    }
    {
      Id = "Odysseus_0725"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaget juga Eris masih betah di sini, tapi yah, sepertinya dia menyukaimu, bukan?"
      Speaker = "Odysseus"
      Event = "OdysseusChat44"
    }
    {
      Id = "Odysseus_0726"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih sudah mampir, meski kau tampak tak sabar ingin segera kembali ke luar sana."
      Speaker = "Odysseus"
      Event = "OdysseusChat45"
    }
    {
      Id = "Odysseus_0727"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kali ini kau berkunjung ke Dunia Bawah untuk selingan?"
      Speaker = "Odysseus"
      Event = "OdysseusChat46"
    }
    {
      Id = "Odysseus_0728"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah agak lama kau tidak mengunjungi permukaan, kalau kau berminat."
      Speaker = "Odysseus"
      Event = "OdysseusChat47"
    }
    {
      Id = "Odysseus_0729"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kebetulan aku menemukan beberapa Benih Misteri ini kalau kau mau!"
      Speaker = "Odysseus"
      Event = "OdysseusChat48"
    }
    {
      Id = "Odysseus_0730"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami dapat hadiah Batu Permata dari para Arwah yang baru saja bergabung, jadi ini untukmu."
      Speaker = "Odysseus"
      Event = "OdysseusChat49"
    }
    {
      Id = "Odysseus_0477"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan aku pun butuh istirahat sesekali, begitu juga {#Emph}kau!!"
      Speaker = "Odysseus"
      Event = "OdysseusTavernaChat01"
    }
    {
      Id = "Odysseus_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya minum-minum santai sebentar di sini bersama kawan-kawan Arwah kita."
      Speaker = "Odysseus"
      Event = "OdysseusTavernaChat02"
    }
    {
      Id = "Odysseus_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ternyata aku bisa menerima laporan dari kedai ini, Dewi!"
      Speaker = "Odysseus"
      Event = "OdysseusTavernaChat03"
    }
    {
      Id = "Odysseus_0480"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cukup ramai juga untuk kumpulan mayat tanpa nyawa, bukan?"
      Speaker = "Odysseus"
      Event = "OdysseusTavernaChat04"
    }
    {
      Id = "Odysseus_0481"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian lihat itu, kawan-kawan? Kubilang juga apa, dia pasti bakal muncul!"
      Speaker = "Odysseus"
      Event = "OdysseusTavernaChat05"
    }
    {
      Id = "Odysseus_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Santai dulu di sini, Dewi! Kau pantas beristirahat."
      Speaker = "Odysseus"
      Event = "OdysseusTavernaChat06"
    }
    {
      Id = "Moros_0631"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Odysseus dan aku baru saja saling bertukar kisah tentang mara bahaya mematikan lagi."
      Speaker = "Moros"
      Event = "OdysseusWithMorosTavernaChat01"
    }
    {
      Id = "Odysseus_0737"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan ternyata kita punya banyak sekali kisah untuk dibagikan!"
      Speaker = "Odysseus"
      Event = "OdysseusWithMorosTavernaChat01"
    }
    {
      Id = "Moros_0632"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah bosan mendengar kisah pelayaranmu, Tuan Odysseus."
      Speaker = "Moros"
      Event = "OdysseusWithMorosTavernaChat02"
    }
    {
      Id = "Odysseus_0738"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun tak pernah bosan menceritakannya persis seperti kejadian aslinya!"
      Speaker = "Odysseus"
      Event = "OdysseusWithMorosTavernaChat02"
    }
    {
      Id = "Moros_0633"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada manusia fana yang lolos dari maut sesering Tuan Odysseus di sini!"
      Speaker = "Moros"
      Event = "OdysseusWithMorosTavernaChat03"
    }
    {
      Id = "Odysseus_0739"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian semua dengar itu, kan?"
      Speaker = "Odysseus"
      Event = "OdysseusWithMorosTavernaChat03"
    }
    {
      Id = "Moros_0634"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh ironis aku bisa menyusul Tuan Odysseus justru di tempat seperti ini."
      Speaker = "Moros"
      Event = "OdysseusWithMorosTavernaChat04"
    }
    {
      Id = "Odysseus_0740"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, lebih baik di sini daripada di tempat lain yang terpikirkan olehku!"
      Speaker = "Odysseus"
      Event = "OdysseusWithMorosTavernaChat04"
    }
    {
      Id = "Moros_0635"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Putri, semoga kau secerdik dan setangguh Tuan Odysseus di sini."
      Speaker = "Moros"
      Event = "OdysseusWithMorosTavernaChat05"
    }
    {
      Id = "Odysseus_0741"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia memang tangguh, sangat tangguh."
      Speaker = "Odysseus"
      Event = "OdysseusWithMorosTavernaChat05"
    }
    {
      Id = "Moros_0636"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh luar biasa seseorang bisa meninggalkan raga fananya dengan begitu banyak kisah untuk diceritakan!"
      Speaker = "Moros"
      Event = "OdysseusWithMorosTavernaChat06"
    }
    {
      Id = "Odysseus_0742"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau bagaimana lagi, masa-masa itu memang sangat mendebarkan!"
      Speaker = "Odysseus"
      Event = "OdysseusWithMorosTavernaChat06"
    }
    {
      Id = "Odysseus_0731"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Laporan lengkapku sudah kuserahkan, Nyonya. Beri tahu aku jika ada pertanyaan atau sanggahan."
      Speaker = "Odysseus"
      Event = "OdysseusWithHecateChat01"
    }
    {
      Id = "Hecate_0883"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Untuk saat ini belum ada."
      Speaker = "Hecate"
      Event = "OdysseusWithHecateChat01"
    }
    {
      Id = "Odysseus_0732"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Beri tahu aku jika kinerjaku ada yang kurang belakangan ini, Nyonya."
      Speaker = "Odysseus"
      Event = "OdysseusWithHecateChat02"
    }
    {
      Id = "Hecate_0884"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan langsung kuberi tahu jika memang terjadi hal demikian."
      Speaker = "Hecate"
      Event = "OdysseusWithHecateChat02"
    }
    {
      Id = "Odysseus_0733"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tak perlu membebani dirimu dengan hal itu, Nyonya. Semuanya sudah kami kendalikan dengan baik."
      Speaker = "Odysseus"
      Event = "OdysseusWithHecateChat03"
    }
    {
      Id = "Hecate_0886"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu akan jadi perubahan yang sangat melegakan."
      Speaker = "Hecate"
      Event = "OdysseusWithHecateChat03"
    }
    {
      Id = "Odysseus_0734"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sudah mencatat semua yang kita bahas sebagai rujukan nanti, Nyonya. Sampai jumpa di evaluasi berikutnya."
      Speaker = "Odysseus"
      Event = "OdysseusWithHecateChat04"
    }
    {
      Id = "Hecate_0887"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kunantikan saat itu."
      Speaker = "Hecate"
      Event = "OdysseusWithHecateChat04"
    }
    {
      Id = "Odysseus_0735"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jika ada hal lain yang bisa kulakukan untukmu, Nyonya, jangan sungkan untuk memintanya."
      Speaker = "Odysseus"
      Event = "OdysseusWithHecateChat05"
    }
    {
      Id = "Hecate_0888"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sudah sangat tahu apa yang kuinginkan."
      Speaker = "Hecate"
      Event = "OdysseusWithHecateChat05"
    }
    {
      Id = "Odysseus_0736"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku akan selalu siap mengabdi padamu, Nyonya. Setidaknya sampai kau mengusirku atau aku memutuskan untuk berkelana lagi."
      Speaker = "Odysseus"
      Event = "OdysseusWithHecateChat06"
    }
    {
      Id = "Hecate_0889"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Banyak sekali kemungkinannya..."
      Speaker = "Hecate"
      Event = "OdysseusWithHecateChat06"
    }
    {
      Id = "Melinoe_0471"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, Odysseus? Ada sesuatu yang ingin kuberikan padamu. Karena kau selalu siap siaga menjaga tempat ini!"
      Speaker = "Melinoe"
      Event = "OdysseusGift01"
    }
    {
      Id = "Odysseus_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi, kehadiranmu saja sudah lebih dari cukup bagiku. Tapi, jika kau memang sedang ingin memberi, sudikah kau menerima hadiah kecil dariku sebagai gantinya?"
      Speaker = "Odysseus"
      Event = "OdysseusGift01"
    }
    {
      Id = "Odysseus_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat berterima kasih, Dewi, dan aku berniat meneguk habis ini di kedai minum pada kesempatan pertama."
      Speaker = "Odysseus"
      Event = "OdysseusGift02"
    }
    {
      Id = "Melinoe_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu terburu-buru! Yang penting kau bisa menikmatinya saat kesempatan itu tiba!"
      Speaker = "Melinoe"
      Event = "OdysseusGift02"
    }
    {
      Id = "Odysseus_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat ini! Mana mungkin aku bisa menolaknya? Sepertinya kau sudah menemukan kelemahanku, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusGift03"
    }
    {
      Id = "Melinoe_0474"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Taktisi Agung tak punya kelemahan, aku yakin itu! Meski sekarang dia punya sebotol Nektar tambahan."
      Speaker = "Melinoe"
      Event = "OdysseusGift03"
    }
    {
      Id = "Odysseus_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harusnya akulah yang menghormati-{#Emph}mu{#Prev}, Dewi. Niatku ingin menyimpannya untuk merayakan kemenangan kita nanti, tapi bagus juga dijadikan cadangan saat keadaan darurat, kau pasti paham."
      Speaker = "Odysseus"
      Event = "OdysseusGift04"
    }
    {
      Id = "Melinoe_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat paham! Dan kau sudah menghormatiku lewat persahabatanmu, Odysseus... juga pengetahuanmu tentang cara menghabisi musuh dengan cepat!"
      Speaker = "Melinoe"
      Event = "OdysseusGift04"
    }
    {
      Id = "Odysseus_0769"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harusnya akulah yang menghormati-{#Emph}mu{#Prev}, Dewi. Niatku ingin menyimpannya, tapi bagus juga dijadikan cadangan saat keadaan darurat, kau pasti paham."
      Speaker = "Odysseus"
      Event = "OdysseusGift04_B"
    }
    {
      Id = "Odysseus_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku {#Emph}paham {#Prev}maksudmu, Dewi! Kalau kau terus-menerus memanfaatkan kelemahanku terhadap barang ini, aku mungkin bakal belajar mengubahnya jadi kekuatan. Rencana yang bagus!"
      Speaker = "Odysseus"
      Event = "OdysseusGift05"
    }
    {
      Id = "Melinoe_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau bagaimana lagi? Aku belajar dari yang terbaik. Semoga kau tumbuh makin kuat dan tangguh."
      Speaker = "Melinoe"
      Event = "OdysseusGift05"
    }
    {
      Id = "Odysseus_0653"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal kau tahu, aku sudah mengarungi berbagai penjuru dunia semasa masih fana, berjumpa dengan manusia-manusia hebat dan para dewa yang jauh lebih agung, tapi... tak pernah terbayangkan aku akan berakhir di sini, dan menerima hadiah seindah ini dari sosok sepertimu."
      Speaker = "Odysseus"
      Event = "OdysseusGift06"
    }
    {
      Id = "Melinoe_0477"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata orang jalan hidup itu penuh liku tak terduga, dan tampaknya kematian pun begitu, Odysseus. Apa pun yang disiapkan Sang Takdir, kuharap kau akan selalu ada di dekatku untuk memberikan saran."
      Speaker = "Melinoe"
      Event = "OdysseusGift06"
    }
    {
      Id = "Odysseus_0654"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku memang suka berpetualang, tapi... kurasa kau akan selalu tahu di mana mencariku. Bersulang untuk Nektar ini... mestinya cukup untuk menemaniku melewati masa-masa sulit kelak."
      Speaker = "Odysseus"
      Event = "OdysseusGift06"
    }
    {
      Id = "Melinoe_5083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, bagaimana kalau kita mampir ke kedai jika kau tidak sedang terlalu sibuk sekarang? Ambrosia yang satu ini butuh segera dibuka!"
      Speaker = "Melinoe"
      Event = "OdysseusGift07"
    }
    {
      Id = "Odysseus_0545"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti butuh sekali dibuka, tapi, berat untuk kukatakan, saat ini ada terlalu banyak laporan yang menanti verifikasiku. Banyak hal yang sedang terjadi. Jadi... mungkin lain kali?"
      Speaker = "Odysseus"
      Event = "OdysseusGift07"
    }
    {
      Id = "Melinoe_5084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau botolnya kau simpan saja dulu? Kata {#Emph}lain kali {#Prev}bisa kapan pun sesukamu. Para Arwah informanmu bahkan boleh ikut serta!"
      Speaker = "Melinoe"
      Event = "OdysseusGift07"
    }
    {
      Id = "Odysseus_0546"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah{#Prev}, ide menarik! Tapi kemungkinan aku takkan pernah mendengar kabar dari mereka lagi. Meskipun itu {#Emph}juga {#Prev}berarti aku bisa lebih sering berkunjung ke kedai..."
      Speaker = "Odysseus"
      Event = "OdysseusGift07"
    }
    {
      Id = "Melinoe_5085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebuah rencana mulai terbentuk...!"
      Speaker = "Melinoe"
      Event = "OdysseusGift07"
    }
    {
      Id = "Melinoe_5092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana menurutmu jika malam ini kita luangkan untuk membangun kesetiaan lagi di kedai? Aku menikmati percakapan kita di sana."
      Speaker = "Melinoe"
      Event = "OdysseusGift08"
    }
    {
      Id = "Odysseus_0553"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}inginnya {#Prev}mengiyakan dan langsung berangkat, tapi aku {#Emph}harus {#Prev}mengatakan, sebentar lagi ada kabar dari seorang informan, jadi aku harus tetap di sini... Niatku juga... ingin sedikit mengurangi kunjungan ke kedai."
      Speaker = "Odysseus"
      Event = "OdysseusGift08"
    }
    {
      Id = "Melinoe_5093"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Maafkan aku. Aku sama sekali tak bermaksud untuk terus-menerus mengalihkanmu dari tanggung jawabmu."
      Speaker = "Melinoe"
      Event = "OdysseusGift08"
    }
    {
      Id = "Odysseus_0554"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan salahmu sama sekali, hanya saja... aku kenal tipe orang yang menghabiskan siang dan malam mereka dengan berpesta pora hingga hilang akal sehat. Aku bersumpah takkan pernah bersikap seboros dan selengah itu. Harus selalu ada {#Emph}sebagian {#Prev}hasratku yang kubiarkan tak terpuaskan."
      Speaker = "Odysseus"
      Event = "OdysseusGift08"
    }
    {
      Id = "Melinoe_5094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham perasaan itu. Mendambakan sesuatu adalah kekuatan pendorong. Tapi, bagaimana kalau botol ini kita berikan saja kepada informanmu? Sebagai imbalan atas tugas yang diselesaikan dengan baik."
      Speaker = "Melinoe"
      Event = "OdysseusGift08"
    }
    {
      Id = "Odysseus_0555"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihan taktis yang luar biasa. Akan kubilang ini hadiah langsung dari sang Putri Underworld sendiri!"
      Speaker = "Odysseus"
      Event = "OdysseusGift08"
    }
    {
      Id = "Melinoe_5095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku lebih suka jika itu dianggap dari kita berdua."
      Speaker = "Melinoe"
      Event = "OdysseusGift08"
    }
    {
      Id = "Odysseus_0556"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah. {#Prev}Baiklah kalau begitu."
      Speaker = "Odysseus"
      Event = "OdysseusGift08"
    }
    {
      Id = "Melinoe_3342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau tak terlalu larut dalam tumpukan laporanmu sekarang, bagaimana kalau kita manfaatkan sebotol Ambrosia ini sebagaimana mestinya?"
      Speaker = "Melinoe"
      Event = "OdysseusTaverna01"
    }
    {
      Id = "Odysseus_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang {#Emph}sedang {#Prev}larut dalam laporanku, Dewi! Fokus pada hal yang paling penting... sampai jumpa di kedai."
      Speaker = "Odysseus"
      Event = "OdysseusTaverna01"
    }
    {
      Id = "Odysseus_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dulu kami kaum fana punya sesuatu yang disebut {#Emph}anggur{#Prev}, sejenis minuman pekat yang terbuat dari perasan {#Emph}buah anggur{#Prev}. Terkadang kami sesumbar rasanya seenak Ambrosia, tapi... kenyataannya jelas jauh dari itu."
      Speaker = "Odysseus"
      Event = "OdysseusTaverna01"
    }
    {
      Id = "Melinoe_3343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sering bercerita tentang begitu banyaknya penderitaan semasa hidup fanamu, namun selalu tersirat rasa rindu di sana... kau merindukan masa-masa itu, kan?"
      Speaker = "Melinoe"
      Event = "OdysseusTaverna01"
    }
    {
      Id = "Odysseus_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Momen dan perasaan semacam itu terkadang memang muncul. Aku tahu jauh lebih banyak {#Emph}sekarang {#Prev}dibanding saat itu, dan... terkadang aku rindu rasanya... saat tidak banyak tahu. Atau kehangatan persaudaraan saat berlayar bersama krunku."
      Speaker = "Odysseus"
      Event = "OdysseusTaverna01"
    }
    {
      Id = "Melinoe_3344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi banyak dari krumu yang ada bersamamu di sini sekarang, bukan? Bahkan Arwah anjing tuamu juga ada. Bagaimana bisa kau merindukan mereka jika mereka masih ada di sekitarmu?"
      Speaker = "Melinoe"
      Event = "OdysseusTaverna01"
    }
    {
      Id = "Odysseus_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami hanyalah Arwah, Dewi, dan... tidak semuanya seutuh diriku. Lagipula, kau tetap bisa merindukan masa lalumu bersama orang-orang yang masih bersamamu sekarang! Ingat tidak waktu kau bermain petak umpet dengan penyihir baik kita, saat kau masih sangat kecil?"
      Speaker = "Odysseus"
      Event = "OdysseusTaverna01"
    }
    {
      Id = "Melinoe_3345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir kami tidak sedang bermain; beliau mengajariku cara memburu mangsa yang tak terlihat. Tapi, aku {#Emph}paham {#Prev}maksudmu."
      Speaker = "Melinoe"
      Event = "OdysseusTaverna01"
    }
    {
      Id = "Odysseus_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, poin awalku sebenarnya cuma mau bilang kalau Ambrosia ini {#Emph}benar-benar {#Prev}luar biasa! Mari kita pastikan jangan sampai setetes pun terbuang sia-sia."
      Speaker = "Odysseus"
      Event = "OdysseusTaverna01"
    }
    {
      Id = "Odysseus_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak menyangka betapa aku sangat membutuhkan ini. Benar kata orang, Ambrosia terasa jauh lebih nikmat saat ditemani rekan yang menyenangkan."
      Speaker = "Odysseus"
      Event = "OdysseusTaverna01"
    }
    {
      Id = "Melinoe_5086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana perkembangan laporan malam ini, atau lebih tepatnya, apa kau ada waktu luang untuk istirahat sejenak di kedai?"
      Speaker = "Melinoe"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Odysseus_0547"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir aku bisa menemanimu untuk hal semacam itu, berhubung kau sendiri yang menawarkannya, Dewi. Kau siap sekarang?"
      Speaker = "Odysseus"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Odysseus_0548"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku pernah bertarung berdampingan bersama banyak Arwah ini, kau tahu. Setia semasa hidup dan kini tetap setia dalam kematian... menurutmu dari mana datangnya hal itu? Kesetiaan, maksudku."
      Speaker = "Odysseus"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Melinoe_5087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari memiliki rasa tujuan atau sebuah perjuangan. Dan juga, keinginan mendasar akan kestabilan dan kebenaran. Kesetiaan adalah konsistensi."
      Speaker = "Melinoe"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Odysseus_0549"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setuju dengan semua itu, tapi bagiku ini jauh lebih sederhana! Kesetiaan datang dari tiap individu. Itu seperti salah satu bentuk cinta; ada yang memberikannya, ada yang menerimanya, terkadang berbalas, terkadang tidak."
      Speaker = "Odysseus"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Melinoe_5088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah selalu mengajariku untuk tidak pernah menuntut kesetiaan. {#Emph}Kesetiaan akan terkikis jika tak dilandasi kepercayaan{#Prev}, begitu kata beliau. Apakah rekan-rekan Arwahmu mengikutimu karena kesetiaan atau murni kewajiban?"
      Speaker = "Melinoe"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Odysseus_0550"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm! {#Prev}Campuran dari keduanya. Sang penyihir baik memang benar bahwa jenis kesetiaan terbaik adalah yang diberikan secara tulus. Kurasa {#Emph}dirimulah {#Prev}yang membangkitkan kesetiaan semacam {#Emph}itu{#Prev}, Dewi; kalian berdua. Kalau bukan karena itu, aku takkan bertahan di sini selama ini."
      Speaker = "Odysseus"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Melinoe_5089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos pasti bisa memanfaatkan seseorang dengan keahlian dan pengalamanmu. Dengan segala janjinya tentang Zaman Keemasan baru, dia pasti punya banyak pengikut setia."
      Speaker = "Melinoe"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Odysseus_0551"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pernah mencoba melayani tiran sebelumnya; bukan untukku. Nah, bagaimana kalau kita pupuk kesetiaan itu {#Emph}sekarang juga? {#Prev}Mari ajak para Bayangan ini minum satu ronde bersama kita."
      Speaker = "Odysseus"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Odysseus_0552"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kita menyelesaikan begitu banyak hal di waktu yang seharusnya jadi istirahat? Bagaimanapun, para Bayangan sangat berterima kasih! Begitu juga denganku."
      Speaker = "Odysseus"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Melinoe_5091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita harus melakukannya lagi lain kali!"
      Speaker = "Melinoe"
      Event = "OdysseusTaverna02"
    }
    {
      Id = "Odysseus_0676"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kita bisa mampir sebentar, sekadar menengok para Bayangan."
      Speaker = "Odysseus"
      Event = "OdysseusTavernaRepeatable01[1]"
    }
    {
      Id = "Odysseus_0679"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh juga, bagaimana kalau kita bagi Ambrosia ini dengan para Bayangan?"
      Speaker = "Odysseus"
      Event = "OdysseusTavernaRepeatable01[1]"
    }
    {
      Id = "Odysseus_0682"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah saatnya berkunjung lagi, ya. Dan jauh lebih menyenangkan bersamamu!"
      Speaker = "Odysseus"
      Event = "OdysseusTavernaRepeatable01[1]"
    }
    {
      Id = "Odysseus_0677"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Demi kemenanganmu yang terus berlanjut, Dewi! Perjalanan kita sudah cukup jauh, bukan?"
      Speaker = "Odysseus"
      Event = "OdysseusTavernaRepeatable01[2]"
    }
    {
      Id = "Odysseus_0680"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Senang rasanya masih bisa berkumpul dengan begitu banyak mantan rekan seperjuangan dan awak kapalku dulu."
      Speaker = "Odysseus"
      Event = "OdysseusTavernaRepeatable01[2]"
    }
    {
      Id = "Odysseus_0683"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Mari bersulang untuk sang penyihir baik, yang tanpanya semua ini takkan pernah terwujud!"
      Speaker = "Odysseus"
      Event = "OdysseusTavernaRepeatable01[2]"
    }
    {
      Id = "Odysseus_0678"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah! Semangat para Bayangan sedang membara, aku bisa melihatnya sendiri."
      Speaker = "Odysseus"
      Event = "OdysseusTavernaRepeatable01[3]"
    }
    {
      Id = "Odysseus_0681"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah kenapa kedai minum ini selalu membuatku bernostalgia. Senang kita sempat mampir."
      Speaker = "Odysseus"
      Event = "OdysseusTavernaRepeatable01[3]"
    }
    {
      Id = "Odysseus_0684"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah! {#Prev}Malam panjang masih menanti, jadi sedikit keceriaan ekstra tadi sangat membantu."
      Speaker = "Odysseus"
      Event = "OdysseusTavernaRepeatable01[3]"
    }
    {
      Id = "Odysseus_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh{#Prev}, aku tak menyangka betapa butuhnya aku akan hal itu! Bersulang, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusTavernaRepeatable01[3]"
    }
    {
      Id = "Melinoe_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya Umpan Ganda ini, Odysseus, dan aku jelas tak bisa memakainya sendirian. Kau tahu aturannya!"
      Speaker = "Melinoe"
      Event = "OdysseusFishing01"
    }
    {
      Id = "Odysseus_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Memancing! {#Prev}Kelemahan terbesarku, Dewi! Perairan dan diriku tak selalu akur, tapi mungkin kali ini nasibku bakal lebih baik. Lagipula, aku sudah lama menunda cuti singkat. Ayo berangkat!"
      Speaker = "Odysseus"
      Event = "OdysseusFishing01"
    }
    {
      Id = "Odysseus_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku memancing murni demi bertahan hidup. Bumi sering kali pelit dengan hasil panennya, sementara laut memberikan banyak hal bagi kami kaum fana, jika kami tahu ke mana harus mencari."
      Speaker = "Odysseus"
      Event = "OdysseusFishing01"
    }
    {
      Id = "Melinoe_3322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa perbedaan terbesar bagimu sejak masa-masa itu? Tak perlu makan demi bertahan hidup? Tak perlu melihat tubuh fanamu perlahan renta seiring bertambahnya usia?"
      Speaker = "Melinoe"
      Event = "OdysseusFishing01"
    }
    {
      Id = "Odysseus_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh{#Prev}, ya ampun! Kau sudah tahu beberapa poin itu seandainya kita diminta menyusun daftar, tapi... perbedaan terbesar, jika harus memilih, adalah... aku akhirnya bebas."
      Speaker = "Odysseus"
      Event = "OdysseusFishing01"
    }
    {
      Id = "Melinoe_3323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bebas? Namun saat masih fana, bukankah kau seorang raja? Pejuang perkasa, pemimpin para prajurit... sekaligus seorang suami, dan seorang ayah! Di sini kau juga mendapat tempat kehormatan, hanya saja... kita berdiam dalam bayang-bayang. Perbuatan kita takkan pernah diceritakan."
      Speaker = "Melinoe"
      Event = "OdysseusFishing01"
    }
    {
      Id = "Odysseus_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kita lihat saja nanti soal bagian terakhir itu, tapi selebihnya! Mungkin hasrat berkelanaku sudah terlampiaskan semua selagi aku masih hidup dan bernapas. Ya, sebagian besarnya!"
      Speaker = "Odysseus"
      Event = "OdysseusFishing01"
    }
    {
      Id = "Odysseus_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku benar-benar menikmati acara kita tadi, meski aku masih sangat membenci ikan."
      Speaker = "Odysseus"
      Event = "OdysseusFishing01"
    }
    {
      Id = "Melinoe_5096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, bagaimana kalau kita mampir ke dermaga pemancingan lagi? Sudah agak lama, dan berdiri dengan sabar jauh lebih bersahaja daripada menyesap Ambrosia, kan?"
      Speaker = "Melinoe"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Odysseus_0557"
      InheritFrom = "BaseNarrative"
      DisplayName = "Alasan yang sangat meyakinkan, Dewi! Dan, aku memang harus lebih sering menghadapi rasa {#Emph}tak nyaman-ku {#Prev}terhadap air. Pergilah duluan, aku akan segera menyusul."
      Speaker = "Odysseus"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Odysseus_0558"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ngomong-ngomong, ada sesuatu yang harus kusampaikan. Waktu-waktu yang kita habiskan bersama ini, yang sejujurnya sangat kunikmati, aku... tak ingin para Bayangan lain salah paham."
      Speaker = "Odysseus"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Melinoe_5097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan salah paham seperti apa itu? {#Emph}Oh{#Prev}, maksudmu prasangka manusia fana mereka. Pria dan dewi bersama-sama hanya berarti satu hal. Dan berakhir dengan satu cara."
      Speaker = "Melinoe"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Odysseus_0559"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, tepat sekali, tapi itu prasangka yang berakar dari kejadian yang benar-benar pernah terjadi... termasuk padaku. Dan meski para Bayangan kita {#Emph}setia{#Prev}, mereka {#Emph}memang {#Prev}suka bergosip, kita berdua tahu itu."
      Speaker = "Odysseus"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Melinoe_5098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir juga begitu. Justru seharusnya mereka membicarakan Kepala Sekolah dan dirimu, bukan kita."
      Speaker = "Melinoe"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Odysseus_0560"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa? {#Prev}Oh ayolah, Dewi, sang penyihir baik dan diriku... kami ini ibarat... ah sial, pasti ada perumpamaan yang {#Emph}pas{#Prev}..."
      Speaker = "Odysseus"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Melinoe_5099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bermaksud lancang, hanya saja... yah, aku bisa memikirkan banyak alasan mengapa Kepala Sekolah menumbuhkan kesetiaan pada seseorang sepertimu. Begitu pula dirimu padanya."
      Speaker = "Melinoe"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Odysseus_0561"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, kau ini sama saja dengan para Bayangan yang suka bergosip itu, bedanya aku tak bisa {#Emph}mengusirmu {#Prev}karena kelakuanmu ini. Nah, bagaimana kalau kita serok beberapa ekor ikan dari air ini, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Odysseus_0562"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Ah. {#Prev}Senang rasanya bisa mengobrol santai sejenak alih-alih harus memberi saran taktis sepanjang waktu, jadi terima kasih untuk itu, Dewi. Tapi, jangan beri tahu sang penyihir baik atau siapa pun tentang apa yang baru saja kau katakan padaku, ya...?"
      Speaker = "Odysseus"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Melinoe_5100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak akan, tenang saja..."
      Speaker = "Melinoe"
      Event = "OdysseusFishing02"
    }
    {
      Id = "Odysseus_0670"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja! Aku sudah lama merencanakan balas dendamku pada ikan-ikan itu..."
      Speaker = "Odysseus"
      Event = "OdysseusFishingRepeatable01[1]"
    }
    {
      Id = "Odysseus_0672"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi, aku hampir selalu siap untuk mengibarkan perang melawan ikan."
      Speaker = "Odysseus"
      Event = "OdysseusFishingRepeatable01[1]"
    }
    {
      Id = "Odysseus_0674"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo, mari kita lihat apa ikan-ikan itu bisa mengelabui taktik kita."
      Speaker = "Odysseus"
      Event = "OdysseusFishingRepeatable01[1]"
    }
    {
      Id = "Odysseus_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membaca pikiranku, Dewi. Mari kita berangkat!"
      Speaker = "Odysseus"
      Event = "OdysseusFishingRepeatable01[1]"
    }
    {
      Id = "Odysseus_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau butuh rekan memancing, Arwah ini siap sedia, Dewi. Bisa kita mulai?"
      Speaker = "Odysseus"
      Event = "OdysseusFishingRepeatable01[1]"
    }
    {
      Id = "Odysseus_0671"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Tak ada yang bisa menguji mentalku sekuat kunjungan ke dermaga."
      Speaker = "Odysseus"
      Event = "OdysseusFishingRepeatable01[2]"
    }
    {
      Id = "Odysseus_0673"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berhasil mengakali mereka tadi, kan? Atau justru kita yang diakali...?"
      Speaker = "Odysseus"
      Event = "OdysseusFishingRepeatable01[2]"
    }
    {
      Id = "Odysseus_0675"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya sungai itu akan selamanya menjadi medan pertempuranku..."
      Speaker = "Odysseus"
      Event = "OdysseusFishingRepeatable01[2]"
    }
    {
      Id = "Melinoe_0462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru berpikir tak ada yang bisa menjernihkan pikiran selain berendam air panas yang menyegarkan. Mau menemaniku?"
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Odysseus_0655"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku sangat suka berendam santai, meski sudah mati sekalipun, lagipula mana mungkin aku menolak ajakan seorang dewi... jadi, tentu saja!"
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Odysseus_0656"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu adatmu dan adatku agak berbeda, tapi pandanganku akan tetap teralihkan ke arah lain, jika kau tidak keberatan."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Melinoe_0464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah manusia fana sering {#Emph}mandi{#Prev}, Odysseus?"
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Odysseus_0657"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}ehem{#Prev}, yah... mungkin sesekali, saat ada kesempatan. Tapi, jarang sekali pria dan wanita mandi bersamaan. Melakukan hal itu bisa dianggap... tidak pantas."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Melinoe_0465"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu rupanya. Kami para dewa tidak mengenal rasa malu seperti itu. Apa aku membuatmu tidak nyaman?"
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Odysseus_0658"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku? Tidak, tidak, tentu saja tidak! Sebenarnya aku pernah mandi bersama dewi sebelumnya, hanya saja... sudah cukup lama sejak terakhir kali."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Melinoe_5242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tidak apa-apa, kau pasti akan segera terbiasa lagi. Kau hanya perlu berusaha melepaskan semua bebanmu."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Odysseus_0659"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya mudah, karena bebanku banyak sekali! Nyatanya sebanyak apa pun yang kulepaskan, selalu saja ada yang tersisa. Tapi berada di sini memang cukup membantu."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Melinoe_0466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah... asalkan ini nyaman bagimu."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Odysseus_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah! Entah bagaimana denganmu, tapi aku benar-benar merasa rileks sekarang!"
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse01"
    }
    {
      Id = "Melinoe_0463"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kupikir ini saat yang tepat untuk merebus diri di pemandian air panas. Mau ikut sebentar?"
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse02"
    }
    {
      Id = "Odysseus_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergi ke pemandian, bersamamu, sekarang juga? {#Emph}Hah! {#Prev}Tentu saja! Suatu kehormatan bisa menemanimu, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse02"
    }
    {
      Id = "Melinoe_0467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah bertemu banyak dewi bahkan saat masih fana, bukan...?"
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse02"
    }
    {
      Id = "Odysseus_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam hal ini aku memang sangat beruntung. Dewi Athena sering kali mengawasiku. Aku takkan pernah selamat dari perang tanpa bantuannya. Lalu, dalam perjalananku pulang, ada Calypso... dan Circe..."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse02"
    }
    {
      Id = "Melinoe_3217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Circe dulu belajar di bawah bimbingan Kepala Sekolah, selalu berkutat dengan kristal-kristalnya. Dan Calypso... dia seorang Nimfa, kan? Kurasa dia dewi tingkat rendah."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse02"
    }
    {
      Id = "Odysseus_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama sekali tidak rendah, dengan segala hormat. Para dewi itu, mereka... memikatku dengan caranya masing-masing. Nyaris membuatku lupa diri. Lupa pada keluargaku."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse02"
    }
    {
      Id = "Melinoe_0469"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau tidak lupa. Kau berhasil menempuh perjalanan pulang. Bahkan aku pun tahu kisah itu."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse02"
    }
    {
      Id = "Odysseus_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu hanya sebuah kisah, Dewi. Bagaimanapun, hidup ini penuh liku-liku yang rumit. Percayalah padaku."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse02"
    }
    {
      Id = "Odysseus_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu waktu yang luar biasa dan sangat kubutuhkan. Sungguh berterima kasih atas undangannya."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse02"
    }
    {
      Id = "Melinoe_5449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini aku berusaha lebih rileks dan ingin mengajakmu ke pemandian air panas, barangkali kau punya tujuan yang sama."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Odysseus_0753"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kalau bicara soal tujuan, mana mungkin aku menolak. Lagipula keadaan memang {#Emph}sedang {#Prev}lebih tenang. Silakan duluan."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Melinoe_5450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang harus kulakukan sekarang, Odysseus...? Tugasku sudah selesai. Kurasa aku bisa terus melakukannya selamanya... fase baru yang sedang kita jalani ini."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Odysseus_0754"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itukah yang ingin kau lakukan, Dewi? Menurutku kau sudah berhak menuruti kata hatimu untuk sementara waktu."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Melinoe_5451"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak tahu apa yang kuinginkan... hanya terus maju tanpa henti, kurasa. Tapi melambat sejenak seperti ini terasa menyenangkan."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Odysseus_0755"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga bukan tipe yang bisa diam berpangku tangan, tapi lihatlah diriku sekarang. Sulit untuk mengetahui kapan tujuan hidup baru akan datang. Aku baru saja menemukan tujuanku saat bertemu penyihir yang baik itu. Kau mungkin sedang mencari sesuatu yang baru. Kau pasti akan menemukannya."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Melinoe_5452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kau bisa seyakin itu? Jika aku tetap berada di jalan yang sama, aku hanya akan terus mendatangi bagian Dunia Bawah dan permukaan yang sama berulang kali."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Odysseus_0756"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau akan menemukan lebih banyak hal di sepanjang jalan, aku sama sekali tak meragukan hal itu. Kau adalah dewi abadi; tak ada alasan bagimu untuk terburu-buru."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Melinoe_5453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewa Hermes takkan pernah memaafkanku jika mendengar ini, tapi... mungkin aku memang perlu melambat sejenak."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Odysseus_0758"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, waktu yang menyenangkan tadi, meski mengobrol denganmu biasanya memang begitu. Mari kita temukan ritme yang pas untuk kita, ya?"
      Speaker = "Odysseus"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Melinoe_5454"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terdengar seperti target yang patut dicapai."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouse03"
    }
    {
      Id = "Melinoe_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Odysseus, bagaimana kalau melepas penat dari segala rencana taktis ini dengan berkunjung ke pemandian air panas?"
      Speaker = "Melinoe"
      Event = "OdysseusBathHouseDecline01"
    }
    {
      Id = "Odysseus_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehm, {#Prev}aku sangat menghargai tawarannya, Dewi, hanya saja... kurasa Kepala Sekolahmu lebih suka jika aku tetap di sini. Kau paham, kan?"
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseDecline01"
    }
    {
      Id = "Melinoe_0461"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin lain kali saja."
      Speaker = "Melinoe"
      Event = "OdysseusBathHouseDecline01"
    }
    {
      Id = "Odysseus_0661"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rencana bagus! Air panas memang ampuh menjernihkan pikiranku."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseRepeatable01[1]"
    }
    {
      Id = "Odysseus_0664"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru saja aku berpikir bahwa aku butuh berendam."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseRepeatable01[1]"
    }
    {
      Id = "Odysseus_0667"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, air panas sangat kubutuhkan saat ini!"
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseRepeatable01[1]"
    }
    {
      Id = "Odysseus_0662"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kita benar-benar punya kemewahan tersendiri di sini, bukan?"
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseRepeatable01[3]"
    }
    {
      Id = "Odysseus_0665"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Semasa masih fana dulu, mandi seperti ini sangatlah langka, kalau boleh jujur."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseRepeatable01[3]"
    }
    {
      Id = "Odysseus_0668"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Menyenangkan rasanya, sekadar duduk merenung di sini sejenak."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseRepeatable01[3]"
    }
    {
      Id = "Odysseus_0663"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus sekali. Sekarang waktunya memeriksa tumpukan laporan yang menumpuk ini!"
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseRepeatable01[4]"
    }
    {
      Id = "Odysseus_0666"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya segar sekali setelah berendam tadi. Terima kasih banyak, Dewi."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseRepeatable01[4]"
    }
    {
      Id = "Odysseus_0669"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang bisa menandingi pemandian air panas untuk mendatangkan rasa damai."
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseRepeatable01[4]"
    }
    {
      Id = "Odysseus_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang lebih memicu strategi baru selain mandi air panas. Kapan-kapan kita lakukan ini lagi!"
      Speaker = "Odysseus"
      Event = "OdysseusBathHouseRepeatable01[4]"
    }
    {
      Id = "Melinoe_1156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Odysseus sedang cuti..."
      Speaker = "Melinoe"
      Event = "NPC_Odysseus_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_2412"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Odysseus sedang keluar memeriksa laporan..."
      Speaker = "Melinoe"
      Event = "NPC_Odysseus_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_2413"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Odysseus pasti sedang dibutuhkan di tempat lain..."
      Speaker = "Melinoe"
      Event = "NPC_Odysseus_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_1157"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Odysseus sedang bertugas, ya?"
      Speaker = "Melinoe"
      Event = "NPC_Odysseus_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_2899"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tulang Jemari andalanmu? Terima kasih!"
      Speaker = "Melinoe"
      Event = "NPC_Odysseus_01.GiftGivenVoiceLines"
    }
    {
      Id = "Odysseus_0566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Scylla dan para Siren..."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusSongReactionVoiceLines"
    }
    {
      Id = "Odysseus_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sialan..."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusSongReactionVoiceLines"
    }
    {
      Id = "Odysseus_0439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita bertarung demi {#Emph}kemenangan!"
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusPreDamageVoiceLines"
    }
    {
      Id = "Odysseus_0440"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lakukan apa pun yang diperlukan."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusPreDamageVoiceLines"
    }
    {
      Id = "Odysseus_0441"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita seimbangkan peluangnya."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusPreDamageVoiceLines"
    }
    {
      Id = "Odysseus_0442"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bertarunglah demi bertahan hidup!"
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusPreDamageVoiceLines"
    }
    {
      Id = "Odysseus_0443"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Raih kemenangan!"
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusPreDamageVoiceLines"
    }
    {
      Id = "Odysseus_0444"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita {#Emph}tidak boleh {#Prev}ragu!"
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusPreDamageVoiceLines"
    }
    {
      Id = "Odysseus_0445"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo lagi, Scylla!"
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusPreDamageVoiceLines"
    }
    {
      Id = "Odysseus_0446"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih ingat aku, Cyclops?"
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusPreDamageVoiceLines"
    }
    {
      Id = "Odysseus_0447"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Habisi dia{#Prev}, Dewi!"
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusPreDamageVoiceLines"
    }
    {
      Id = "Odysseus_0448"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pasti bisa, {#Emph}maju!"
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.OdysseusPreDamageVoiceLines"
    }
  ]
}
