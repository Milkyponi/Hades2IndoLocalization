    }
    {
      Id = "MelinoeField_1194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senang sekali melihatmu di sini...!"
      Speaker = "Melinoe"
      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Echo! Lihat, aku membawa Kenang-kenangan darimu. Batu Cekungmu!"
