{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _EncounterData_Story.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_0036"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ibu Guru..."
      Speaker = "Melinoe"
      Event = "UnthreadedEvents.VoiceLines"
    }
    {
      Id = "Hecate_0549"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maksudku begini, Arachne... Aku sama sekali tak berniat cuci tangan atas apa yang telah kuperbuat. Dan meski perbuatanku tak bisa ditarik kembali, ketahuilah bahwa keselamatanmu di hutan ini terjamin."
      Speaker = "Hecate"
      Event = "HecateWithArachne01"
    }
    {
      Id = "Arachne_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat menghargai kejujuranmu, sang Titaness. Namun, jika keselamatanku sekarang yang kau khawatirkan... kau bisa memulainya dengan angkat kaki dari sini. Dengan segala hormat."
      Speaker = "Arachne"
      Event = "HecateWithArachne01"
    }
    {
      Id = "Hecate_0550"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah kalau begitu. Aku takkan mengganggu kediamanmu lagi; selamat malam."
      Speaker = "Hecate"
      Event = "HecateWithArachne01"
    }
    {
      Id = "Arachne_0299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, kawan!"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0300"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa..."
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dah untuk sekarang!"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cepat kembali, ya...!"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0303"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di luar sana!"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mampir lagi, ya?"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bakal tetap di sini, oke?"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau benar-benar kelihatan luar biasa!"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi keberhasilanmu!"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia sudah pergi..."
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sendirian lagi... {#Emph}ha ha ha..."
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau {#Emph}pasti {#Prev}bisa!"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pasti sanggup!"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati...!"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0466"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya ampun."
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat tinggal...!"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Arachne_0310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Hela napas>"
      Speaker = "Arachne"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_1764"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Teruslah menenun."
      Speaker = "Melinoe"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_1765"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai kita bertemu lagi."
      Speaker = "Melinoe"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_1766"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Teruslah memintal benang."
      Speaker = "Melinoe"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_1767"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga dirimu baik-baik, ya?"
      Speaker = "Melinoe"
      Event = "Story_Arachne_01.ExitVoiceLines"
    }
    {
      Id = "Melinoe_1092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Arachne!"
      Speaker = "Melinoe"
      Event = "Story_Arachne_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_1093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hai, Arachne."
      Speaker = "Melinoe"
      Event = "Story_Arachne_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_1406"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Busana indah karya Arachne..."
      Speaker = "Melinoe"
      Event = "Story_Arachne_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_1319"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lanjutkanlah, Cucuku, dan aku akan menunggu di kediaman House of Hades."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_1327"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Teruslah bertarung, Cucuku, dan sampai jumpa di Tartarus!"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_1328"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita musnahkan seluruh sisa-sisa diriku yang dulu begitu menjijikkan."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_1322"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mampuslah Chronos, Cucuku!"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_1323"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mampuslah Chronos, Cucuku! Tapi hanya untuk sosok Chronos yang lain itu."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_1320"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Majulah! Aku tahu kau pasti akan menang sekali lagi!"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_1321"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tadi malam mungkin tidak berjalan mulus, tapi selalu ada hari {#Emph}ini!"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_1324"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika kau sudah memegang kekuatan Zeus, ini pertanda bagus!"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_1325"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekuatan putraku yang perkasa, Poseidon, sudah ada di genggamanmu!"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_1326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bahkan masih memegang restu ayahmu hingga kini...!"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0621"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bocah pembuat onar keparat, {#Emph}lagi-lagi kau?"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0622"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jalanmu masih sangat panjang, Cucuku..."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0623"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan menunggumu di sana, Nak!"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0624"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jalan yang begitu berat membentang di hadapanmu, Bocah."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0625"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sama sekali tak belajar dari kesalahan, Cucuku...?"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0626"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar-benar anak yang suka mencampuri urusan orang si Hades itu."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0627"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seharusnya kau bisa bersikap jauh lebih sopan dari ini."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0628"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pembangkangan yang begitu keras kepala dari seorang cucuku."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0629"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sama sekali tak suka dengan keras kepalamu itu, Nak."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0630"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam ini takkan berjalan semulus yang kau bayangkan."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0924"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dasar anak keras kepala yang tak bisa diatur..."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0926"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga perjalananmu menuju Tartarus menyenangkan, Nak."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0925"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau menikmati rutinitas malam ini?"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0929"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam demi malam kau terus bersikap seperti ini?"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0927"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memutuskan untuk memberi napas pada Typhon yang malang?"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0928"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana Olympus bisa menahan gempuran Typhon jika kau ada di sini?"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0930"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tongkatmu itu bukan tandingan sabit milikku."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0931"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Datang untuk membunuhku dengan pisau-pisau itu?"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0932"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Obor-obormu itu membuat keberadaanmu begitu mudah terdeteksi."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0933"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapakmu itu tampak sangat kikuk bagiku."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0934"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau keluyuran ke mana-mana membawa tengkorak peledak itu?"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0935"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tampak konyol dengan persenjataan aneh mutakhir itu."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0936"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya kau membawa senjata yang layak untuk pertarungan kita."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0937"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau menghinaku dengan segala kelancangan tiap malam ini."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0938"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, hadapi aku lagi, lihat apakah aku peduli!"
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Chronos_0939"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam ini takkan ada bedanya dengan malam-malam kemarin."
      Speaker = "Chronos"
      Event = "Story_Chronos_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nemesis..."
      Speaker = "Melinoe"
      Event = "UnthreadedEvents.VoiceLines"
    }
    {
      Id = "NemesisField_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tatap aku kalau aku sedang bicara padamu, kutu busuk. Oh, benar juga. Kau kan tak bisa. Pasti muak sekali terus-menerus menatap dirimu sendiri sekarang."
      Speaker = "Nemesis"
      Event = "NemesisWithNarcissus01"
    }
    {
      Id = "Narcissus_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu-satunya hal yang membuatku muak, {#Emph}Lupa-Namamu{#Prev}, adalah langkah kakimu yang berisik mengusik ketenanganku! Kalau tak punya hal baik untuk diucapkan, kenapa kau tak {#Emph}pergi saja?"
      Speaker = "Narcissus"
      Event = "NemesisWithNarcissus01"
    }
    {
      Id = "NemesisField_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih saja sok angkuh setelah sekian lama. Andaikan kau belajar menunjukkan rasa hormat, mungkin kau takkan terjebak selamanya ditemani seorang badut dungu. Nikmatilah pemandanganmu itu sepuasnya."
      Speaker = "Nemesis"
      Event = "NemesisWithNarcissus01"
    }
    {
      Id = "MelinoeField_0035"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nemesis?"
      Speaker = "Melinoe"
      Event = "UnthreadedEvents.VoiceLines"
    }
    {
      Id = "NemesisField_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Katakan sekali lagi kalau aku sedang {#Emph}jual mahal{#Prev}, dan demi apa pun, akan kupetiki anggota tubuhmu satu per satu seperti kelopak {#Emph}bunga mungil yang rapuh. {#Prev}Bagaimana menurutmu?"
      Speaker = "Nemesis"
      Event = "NemesisWithNarcissus02"
    }
    {
      Id = "Narcissus_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya {#Emph}buruk{#Prev}, jelas begitu! Tapi juga terdengar seperti omongan orang yang sok jual mahal. Jadi entahlah! Nah, sekarang kenapa kau tidak... {#Emph}ceritakan lebih banyak tentang dirimu?"
      Speaker = "Narcissus"
      Event = "NemesisWithNarcissus02"
    }
    {
      Id = "NemesisField_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, kau mau aku {#Emph}tinggal{#Prev}. Pasti ada yang merasukimu, jelas sekali. Ya sudah, tugasku di sini sudah selesai. Kalau mau cari aman, jangan coba-coba patahkan hati siapa pun lagi."
      Speaker = "Nemesis"
      Event = "NemesisWithNarcissus02"
    }
    {
      Id = "Narcissus_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh {#Emph}jelas{#Prev}. Dia naksir berat padamu, kawan. Itu {#Emph}sangat amat {#Prev}kentara!"
      Speaker = "Narcissus"
      Event = "NemesisWithNarcissus02"
    }
    {
      Id = "Narcissus_0188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ngomong-ngomong soal itu..."
      Speaker = "Narcissus"
      Event = "NemesisWithNarcissus02"
    }
    {
      Id = "MelinoeField_5646"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rupanya aku memang tak bisa membayangkan Narcissus melakukan hal lain..."
      Speaker = "Melinoe"
      Event = "Story_Narcissus_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa-apaan ini semua?"
      Speaker = "Melinoe"
      Event = "Story_Narcissus_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang menarik perhatianmu?"
      Speaker = "Melinoe"
      Event = "Story_Narcissus_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Anggap saja aku tak ada."
      Speaker = "Melinoe"
      Event = "Story_Narcissus_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cuma numpang lewat..."
      Speaker = "Melinoe"
      Event = "Story_Narcissus_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0737"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada orang di sana...?"
      Speaker = "Melinoe"
      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Echo_0002"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada orang di sana? {#Echo1}Ada orang di sana? {#Prev}{#Echo2}Ada orang di sana?"
      Speaker = "Echo"
      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0738"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak bermaksud jahat."
      Speaker = "Melinoe"
      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0743"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini cuma aku. Boleh kutahu siapa namamu?"
      Speaker = "Melinoe"
      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0746"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Echo, itukah dirimu?"
      Speaker = "Melinoe"
      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0749"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, ini Melinoë!"
      Speaker = "Melinoe"
      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0999"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia masih di sini, kasihan sekali..."
      Speaker = "Melinoe"
      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1181"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana kabarmu, Echo? Kabarku baik-baik saja!"
