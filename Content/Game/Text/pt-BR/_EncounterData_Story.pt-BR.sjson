      DisplayName = "Ada apa sih sama {#Emph}dia?"
      Speaker = "Dionysus"
      Event = "Story_Dionysus_01.ExitVoiceLines"
    }
    {
      Id = "Dionysus_0219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fiuh! {#Prev}Ngomong-ngomong, ada yang butuh minum lagi nggak nih?"
      Speaker = "Dionysus"
      Event = "Story_Dionysus_01.ExitVoiceLines"
    }
    {
      Id = "Dionysus_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang mau nambah satu ronde lagi?"
      Speaker = "Dionysus"
      Event = "Story_Dionysus_01.ExitVoiceLines"
    }
    {
      Id = "Dionysus_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa yang mau isi ulang, bilang aja!"
      Speaker = "Dionysus"
      Event = "Story_Dionysus_01.ExitVoiceLines"
    }
    {
      Id = "Dionysus_0222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ngomong-ngomong, {#Prev}tadi kita lagi ngomongin apa ya, ingetin dong?"
      Speaker = "Dionysus"
      Event = "Story_Dionysus_01.ExitVoiceLines"
    }
    {
      Id = "Dionysus_0223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayolah, pada santai dikit dong, kalian kenapa sih?"
      Speaker = "Dionysus"
      Event = "Story_Dionysus_01.ExitVoiceLines"
    }
    {
      Id = "Dionysus_0224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, semuanya aman kan, udah dapat yang dibutuhin?"
      Speaker = "Dionysus"
      Event = "Story_Dionysus_01.ExitVoiceLines"
    }
    {
      Id = "Dionysus_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mumpung aku lagi di sini, ada yang mau apa-apa lagi?"
      Speaker = "Dionysus"
      Event = "Story_Dionysus_01.ExitVoiceLines"
    }
    {
      Id = "Dionysus_0226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei kamu yang di kolam, aku {#Emph}lihat {#Prev}itu lho ya!"
      Speaker = "Dionysus"
      Event = "Story_Dionysus_01.ExitVoiceLines"
    }
    {
      Id = "Dionysus_0210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau selalu dipersilakan balik ke sini kapan pun!"
      Speaker = "Dionysus"
      Event = "Story_Dionysus_01.ExitVoiceLines"
    }
    {
      Id = "HecateField_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersiaplah menderita atas semua yang telah kauperbuat, bajingan! Atau haruskah kutahan tanganku hanya karena kau membuat kesalahan dengan melonggarkan cengkeramanmu padaku?"
      Speaker = "Hecate"
      Event = "TrueEnding01"
    }
    {
      Id = "Chronos_1520"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Semua... pikiran baru ini... di dalam benakku...! Apakah semua ini ulah{#Emph}mu{#Prev}, penyihir? Aku... tak ingat apa pun tentangmu, namun.... Siapa {#Emph}sebenarnya dirimu{#Prev}...?"
      Speaker = "Chronos"
      Event = "TrueEnding01"
    }
    {
      Id = "MelinoeField_5144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos...! Kepala Sekolah, {#Emph}tunggu! {#Prev}Aku bisa... kurasa aku bisa menjelaskannya."
      Speaker = "Melinoe"
      Event = "TrueEnding01"
    }
    {
      Id = "HecateField_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë! Di mana kita? Sedetik yang lalu kuketahui musuh kita menyerbu Erebus, lalu tahu-tahu dia sudah bersujud di kakiku! Bagaimana mungkin? Apa yang telah kaulakukan...?"
      Speaker = "Hecate"
      Event = "TrueEnding01"
    }
    {
      Id = "MelinoeField_5188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah, Anda... Anda tak ingat... karena Anda tak berada di sana bersamaku. Tapi bagaimana denganmu, Chronos! Siapakah aku bagimu sekarang...?"
      Speaker = "Melinoe"
      Event = "TrueEnding01"
    }
    {
      Id = "Chronos_1465"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau adalah... cucuku... Melinoë... yang kukenal baik dari kehidupan ini, maupun kehidupan lain yang sama sekali berbeda... yang kini kusadari... hanyalah mimpi belaka. Sebuah {#Emph}khayalan! {#Prev}Jadi kalau begitu... yang tersisa dariku hanyalah... {#Emph}ini?"
      Speaker = "Chronos"
      Event = "TrueEnding01"
    }
    {
      Id = "MelinoeField_5189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua yang kaulihat ini adalah akibat perbuatanmu sendiri! Mengenai kehidupan lain itu... seberapa banyak yang kauingat?"
      Speaker = "Melinoe"
      Event = "TrueEnding01"
    }
    {
      Id = "Chronos_1466"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Masa mudamu, di Griya ini, bersamaku. Betapa senangnya dirimu bermain petak umpet saat kau masih gadis cilik! Betapa kau dan Zagreus suka bertengkar, tapi atas dasar kasih sayang... bukan seperti pertarungan kita malam ini. Aku tak menyadari pernah ada masa lalu {#Emph}lain {#Prev}yang kita bagi bersama... masa lalu yang {#Emph}jauh lebih baik{#Prev}."
      Speaker = "Chronos"
      Event = "TrueEnding01"
    }
    {
      Id = "HecateField_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa lalu yang lebih baik...? {#Emph}Omong kosong! {#Prev}Tak satu pun dari itu pernah terjadi! Tak ada yang {#Emph}berubah! {#Prev}Kau seharusnya sudah {#Emph}musnah{#Prev}, Titan...! Bukan malah dibanjiri ingatan palsu!"
      Speaker = "Hecate"
      Event = "TrueEnding01"
    }
    {
      Id = "MelinoeField_5147"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Semua kenangan yang muncul di benaknya... aku juga mengingatnya. Kehidupan yang bisa saja kujalani... andai sang Titan tak pernah menyerang."
      Speaker = "Melinoe"
      Event = "TrueEnding01"
    }
    {
      Id = "Chronos_1467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun aku {#Emph}telah menyerang! {#Prev}Selamanya dibenci dan dicampakkan! Selesaikan apa yang telah kauputuskan, Cucuku! Karena aku tak sudi hidup di dunia seperti ini, bersama kalian semua, seperti {#Emph}ini! {#Prev}Tidak sedetik pun lagi...!"
      Speaker = "Chronos"
      Event = "TrueEnding01"
    }
    {
      Id = "HecateField_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Diam! {#Prev}Melinoë, sadarlah. Apa pun yang telah kaulakukan, bajingan ini sudah tamat, dan takkan bisa menggunakan trik lamanya lagi! {#Emph}Habisi dia!"
      Speaker = "Hecate"
      Event = "TrueEnding01"
    }
    {
      Id = "MelinoeField_5148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, kumohon, biarkan aku membuktikannya pada Anda...! Chronos! Kakek. Dengarkan aku: Tenangkan dirimu. Gunakan sisa kekuatan yang kaumiliki, dan bebaskan keluarga kita dari cengkeramanmu!"
      Speaker = "Melinoe"
      Event = "TrueEnding01"
    }
    {
      Id = "Chronos_1468"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Gasp> {#Prev}Keluarga kita...? Mereka... astaga, mereka masih terbelenggu! Aku membelenggu mereka... selama ini. Apa yang telah kuperbuat...?"
      Speaker = "Chronos"
      Event = "TrueEnding01"
    }
    {
      Id = "Hades_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluargaku...! Di mana kita...? Apakah ini... {#Emph}Griya{#Prev}ku? Ayah...! Apa maksud dari semua ini?!"
      Speaker = "Hades"
      Event = "TrueEnding01"
    }
    {
      Id = "Chronos_1469"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, Hades... barangkali sang Putri bisa menjelaskannya. Mengenai sang Ratu, sang Pangeran, dan yang lainnya... Melinoë, mereka hanya perlu mendengar suaramu. Dan aku menanti penghakiman mereka, serta penghakimanmu sendiri."
      Speaker = "Chronos"
      Event = "TrueEnding01"
    }
    {
      Id = "Selene_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jika aku boleh memotong sebentar, kita telah tiba di tujuan awal kita, semuanya. Olympus tak jauh dari sini."
      Speaker = "Selene"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "Chronos_1028"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sangat menghargai tumpangan di kereta kencanamu yang berkilau, Wahai Sang Rembulan; namun kini tiba saatnya bagiku untuk pergi. Barangkali percakapanku dengan Hades telah mempersiapkanku untuk menghadapi putra-putraku yang lain..."
      Speaker = "Chronos"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "MelinoeField_5172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami telah memberitahu Paman Zeus tentang apa yang terjadi, dan memberikan saran kami, meski beliau pasti punya banyak pertanyaan untukmu. Dan beliau mestinya sudah menunggumu sekarang. Ingatlah kesempatan yang telah diberikan kepadamu, Kakek."
      Speaker = "Melinoe"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "Chronos_1479_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu tak bisa lupa, dan tak boleh terlambat. Semoga Zeus setidaknya mengizinkanku membantumu mulai dari sekarang, menyadari ada kemungkinan nyata semua ini bisa berakhir jauh lebih buruk."
      Speaker = "Chronos"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "MelinoeField_5218_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Membayangkan bahwa seluruh aliran Waktu telah retak karena apa yang terjadi..."
      Speaker = "Melinoe"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "Chronos_1528"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih suka menganggapnya sebagai momen penemuan jati diri bagiku! Terlepas dari usiaku yang telah lanjut, tampaknya masih banyak yang belum kuketahui tentang diriku sendiri. Tapi sekali lagi... siapa juga yang benar-benar tahu? Nah, selamat tinggal. Dan terima kasih, Cucuku."
      Speaker = "Chronos"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "MelinoeField_3907"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Apollo! Dan Nona Artemis!"
      Speaker = "Melinoe"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "Apollo_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang sungguh indah, Nona Selene! Dan {#Emph}Anda {#Prev}pasti Sang Penyihir Crossroads yang terhormat! Anda benar-benar telah melatih sepupuku dengan sangat baik, sampai-sampai bisa membawa Chronos ke puncak kediaman kami dalam keadaan utuh!"
      Speaker = "Apollo"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "Artemis_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Apollo, untuk sekali ini tebakanku meleset, tak usah menyombong begitu. Melinoë, tadinya aku bertaruh kau bakal mencincang sang Titan jadi berkeping-keping ketimbang membawanya ke mari."
      Speaker = "Artemis"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "MelinoeField_3908"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu ini sulit dipercaya, tapi dia ke sini atas kemauannya sendiri. Dan Paduka Zeus ingin bicara berdua saja dengannya. Tunggu, apa itu artinya... kalian diusir keluar dari {#Emph}rumah {#Prev}kalian sendiri?"
      Speaker = "Melinoe"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "Apollo_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kami menyebutnya Istana, tapi, {#Emph}ehem... {#Prev}bukan begitu! Bukan, kami ditugaskan untuk mengawal kalian ke Crossroads sebagai lambang persatuan keluarga kita, dan kami datang membawa hadiah. Bisa kita berangkat sekarang?"
      Speaker = "Apollo"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "Selene_0381"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita berangkat."
      Speaker = "Selene"
      Event = "TrueEndingFinale01"
    }
    {
      Id = "Artemis_0384"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo jalan."
      Speaker = "Artemis"
      Event = "TrueEndingFinale01"
    }
  ]
}
