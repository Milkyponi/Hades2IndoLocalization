      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Echo, dia menyesal! Maksudku, Narcissus. Kurasa dia menyesal."
      Speaker = "Melinoe"
      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1166"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Echo? Hei, soal Narcissus..."
      Speaker = "Melinoe"
      Event = "Story_Echo_01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Echo, syukurlah, itu kau! Ada sesuatu yang ingin kusampaikan."
