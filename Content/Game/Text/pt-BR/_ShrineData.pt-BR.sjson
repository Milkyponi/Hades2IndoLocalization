    {
      Id = "Melinoe_2862"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dalam bayangan aku mengabdi; kepada bayangan aku kembali.{Prev}"
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2565"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beranikah diriku...?"
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2566"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada hal berharga tanpa perjuangan..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_0975"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kehendak Sang Malam."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_0976"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang Sang Malam inginkan dariku?"
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_0977"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa kehendak dari Sang Malam?"
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2856"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin harus mengambil Ikrar baru..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2858"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sumpah itu memanggilku..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2859"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sumpah itu melambai ke arahku..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2860"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wasiat lain menanti."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2861"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada hawa Rasa Takut di udara..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2864"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sumpah ini..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2865"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasa takut yang wajar pada kegelapan..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2866"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beranikah aku mengucap ikrar itu?"
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2867"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wasiat Sang Malam."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2868"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan palingkan pandanganmu..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_1342"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika aku harus mengabdi pada Sang Malam, aku ingin tahu kehendak-Nya..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_3081"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sembunyikan kami, wahai Sang Malam..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_1344"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bisa memperdalam hubunganku dengan Sang Malam..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Skelly_0250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sumpah Mereka yang Tak Kasatmata!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Skelly_0251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Patuhi baik-baik Sumpah itu!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Skelly_0253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau berani bersumpah?"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.OpenVoiceLines"
    }
    {
      Id = "Melinoe_2889"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya agak berhati-hati di sini."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2890"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wasiat Sang Malam bisa menunggu..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2891"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak perlu bertindak gegabah..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2892"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin di malam yang lain..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin keputusan bijak."
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak bakal kusalahin sedikit pun."
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Persetan dengan Sumpah!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ikrar itu bisa nunggu!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2875"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam dan Kegelapan, bimbinglah aku..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2876"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selubung Kegelapan kian meluas..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2877"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam, lindungilah aku..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2878"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi kehendak Sang Malam."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2879"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasa Takut yang kian mencekam..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2880"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi Yang Tak Kasat Mata."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2881"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sumpahku telah terpatri."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2882"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam ini bakal seru."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2883"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semuanya patut merasa ketakutan..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2884"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasa takut menghantui yang hidup maupun yang mati... "
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasa Takut merebak!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takut banget...!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar-benar mengerikan..."
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar aku yang jadi saksimu!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan bilang aku nggak ngingetin, ya!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nyali lu gede juga, Bocah."
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berani banget di hadapan Rasa Takut!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gua gemetaran di sini nih!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Iih, {#Prev}ngeri {#Emph}banget!"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demikianlah yang kau sumpahkan."
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Udah kelar sama barang itu?"
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Skelly_0150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hati-hati{#Prev}, anak muda."
      Speaker = "Skelly"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2885"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Entahlah, aku ragu soal ini..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2886"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebenarnya untuk siapa aku pamer begini...?"
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2887"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, aku ngeri juga..."
      Speaker = "Melinoe"
      Event = "ScreenData.Shrine.ChangeMadeCloseVoiceLines"
    }
    {
      Id = "Melinoe_2888"
