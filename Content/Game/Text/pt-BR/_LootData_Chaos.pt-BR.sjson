{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _LootData_Chaos.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "MelinoeField_0975"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam...?"
      Speaker = "Melinoe"
      Event = "TrialUpgrade.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_0976"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih telah memanggilku."
      Speaker = "Melinoe"
      Event = "TrialUpgrade.InteractVoiceLines"
    }
    {
      Id = "Chaos_0164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan bagimu pula."
      Speaker = "Chaos"
      Event = "TrialUpgrade.InteractVoiceLines"
    }
    {
      Id = "Chaos_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lanjutkan."
      Speaker = "Chaos"
      Event = "TrialUpgrade.InteractVoiceLines"
    }
    {
      Id = "Chaos_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada cahaya yang mencapaiku di sini."
      Speaker = "Chaos"
      Event = "TrialUpgrade.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_4783"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wawasan Neraka Absolut... {#Prev}Batu Gulita..."
      Speaker = "Melinoe"
      Event = "TrialUpgrade.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_3646"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ehm{#Prev}, untuk sekarang kusebut saja {#Emph}Embrio{#Prev}..."
      Speaker = "Melinoe"
      Event = "TrialUpgrade.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_0763"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berkat macam apa ini, di tempat yang seperti ini? Baiklah, {#Emph}atas nama Hades! Olympus... {#Prev}apakah kalian di sana...?"
      Speaker = "Melinoe"
      Event = "ChaosFirstPickUp"
    }
    {
      Id = "Chaos_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olympus tak bisa mendengarmu, Keturunan Hades. Namun aku bisa. Dan aku punya tawaran untukmu: Bantulah mengatasi kebimbanganku, dan kau akan diuntungkan. Tanggapanmu?"
      Speaker = "Chaos"
      Event = "ChaosFirstPickUp"
    }
    {
      Id = "MelinoeField_0764"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chaos Yang Mahakuasa...! Suatu kehormatan bagiku bisa bertemu denganmu. K-kebimbangan macam apa yang bisa menggelisahkan Asal Mula Segala Keberadaan...? Dan, bagaimana aku bisa terlibat?"
      Speaker = "Melinoe"
      Event = "ChaosFirstPickUp"
    }
    {
      Id = "Chaos_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu yang akan menjawabnya. Namun untuk saat ini, kusimpulkan bahwa tanggapanmu, pada intinya, adalah bersedia. Maka dari itu, semoga kesepakatan baru kita ini terbukti sangat menarik. Terimalah tandaku, lalu pergilah; dan nanti aku akan membuka jurang kehampaan ini untukmu lagi."
      Speaker = "Chaos"
      Event = "ChaosFirstPickUp"
    }
    {
      Id = "Chaos_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah menderita dalam perjalananmu untuk mencapaiku. Barangkali aku harus mengganjar perjuanganmu; atau mempercepat kegagalanmu yang tak terhindarkan. Kau sendirilah yang harus memutuskan."
      Speaker = "Chaos"
      Event = "ChaosLowHealth01"
    }
    {
      Id = "Chaos_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menciptakan kehidupan, yang kemudian melahirkan kematian; jadi aku bisa merasakan betapa dekatnya dirimu dengan keadaan yang terakhir itu. Sekalipun kedewaanmu membuatmu takkan pernah benar-benar mati, hal itu pasti amat tidak menyenangkan."
      Speaker = "Chaos"
      Event = "ChaosLowHealth02"
    }
    {
      Id = "Chaos_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luka-lukamu saat ini tak luput dari pengamatanku. Mungkin tindakan yang kurang bijak bagimu untuk mengunjungiku di ruang ini saat kau berada dalam kondisi seperti itu. Meski aku pun pernah berbuat kekhilafan sebelumnya."
      Speaker = "Chaos"
      Event = "ChaosLowHealth03"
    }
    {
      Id = "Chaos_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham bahwa cedera fisik, seperti yang kau derita sekarang, tak berarti banyak bagi kalian para dewa. Meski demikian, bahkan para dewa pun hanya mampu menahan derita sampai batas tertentu. Oleh karena itu, berhati-hatilah."
      Speaker = "Chaos"
      Event = "ChaosLowHealth04"
    }
    {
      Id = "Chaos_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau memulai perjuangan malammu, kau mungkin berada dalam kesiapan terbaik untuk menerima tandaku dan mengatasi efek sampingnya yang tak menyenangkan. Setelahnya, kau akan punya lebih banyak kesempatan untuk menguji batas kemungkinan yang diciptakannya."
      Speaker = "Chaos"
      Event = "ChaosRunStart01"
    }
    {
      Id = "Chaos_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu berkelana jauh untuk menemukanku, Keturunan Hades. Karena aku ada di mana-mana, terutama di tempat kegelapan memadat menjadi ketiadaan fana. Barangkali kita akan berjumpa lagi saat kau sudah lebih dekat dengan tujuanmu."
      Speaker = "Chaos"
      Event = "ChaosRunStart02"
    }
    {
      Id = "Chaos_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru saja ada sebuah momen ketika Sang Waktu sempat terhenti sejenak, dan hanya aku yang menyadarinya. Kuyakini hal itu bertepatan dengan konfrontasimu melawan Chronos. Kini kau kembali kepadaku, mencoba mengulangi hasil yang sama. Menarik."
      Speaker = "Chaos"
      Event = "ChaosUnderworldRunCleared01"
    }
    {
      Id = "Chaos_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru-baru ini kau memasuki kediaman ayahmu di kedalaman Dunia Bawah, namun tak menetap di sana. Setidaknya, apakah kau menemukan apa yang kau cari? Tak usah dijawab; aku sedang menimbang-nimbang segala kemungkinan kebenarannya."
      Speaker = "Chaos"
      Event = "ChaosUnderworldRunCleared02"
    }
    {
      Id = "Chaos_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat tak dapat mendeteksi keberadaanmu selama beberapa saat, namun kemudian bumi itu sendiri berguncang seolah ada wujud berukuran luar biasa besar jatuh dari ketinggian yang amat dahsyat. Itu pasti makhluk yang kau sebut Typhon. Kaulah yang menjatuhkannya? Tak usah dijawab."
      Speaker = "Chaos"
      Event = "ChaosUnderworldSurfaceCleared01"
    }
    {
      Id = "Chaos_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu betul apa yang baru saja kau capai, terlepas dari perbedaan ukuran dan kekuatan Typhon yang amat mencolok. Sungguh menarik bagaimana makhluk terkecil kerap kali terbukti lebih unggul; apakah konsep kekuatanku keliru?"
      Speaker = "Chaos"
      Event = "ChaosUnderworldSurfaceCleared02"
    }
    {
      Id = "Chaos_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kuciptakan kehidupan, aku sempat ragu: Akankah ini mendatangkan lebih banyak masalah daripada menyelesaikannya? Aku penasaran ingin melihatnya. Maka dari itu, eksperimenku terus bergulir; hasilnya, masih belum pasti."
      Speaker = "Chaos"
      Event = "ChaosAboutLife01"
    }
    {
      Id = "MelinoeField_0765"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chaos Yang Mahakuasa... dengan eksperimenmu yang cakupannya seluas itu, apa yang bisa dicapai oleh seorang insan saja? Kebimbangan yang kau sebutkan saat pertama kali kita berjumpa... apa yang kau inginkan dariku?"
      Speaker = "Melinoe"
      Event = "ChaosAboutLife01"
    }
    {
      Id = "Chaos_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keturunan Hades, perlu kuperjelas bahwa aku tak menyukai omong kosong. Jangan ajukan pertanyaan kepadaku. Jawab hanya jika dipancing, atau saat benar-benar mutlak diperlukan. Namun di atas segalanya, berbuatlah sesukamu."
      Speaker = "Chaos"
      Event = "ChaosAboutLife01"
    }
    {
      Id = "Chaos_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pernah membuat kesepakatan serupa dengan Keturunan Hades yang lain. Dia adalah subjek yang menarik. Jeda waktu sejak pertemuan terakhir kami kini semakin panjang. Apakah kau tahu keadaannya? Jawablah."
      Speaker = "Chaos"
      Event = "ChaosAboutZagreus01"
    }
    {
      Id = "MelinoeField_0766"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu kakakku Zagreus. Chronos menangkapnya, bersama orang tuaku dan rekan-rekan terdekat mereka. Mereka berada di bagian terdalam Dunia Bawah, tujuan tempatku menuju sekarang."
      Speaker = "Melinoe"
      Event = "ChaosAboutZagreus01"
    }
    {
      Id = "Chaos_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu rupanya. Sang Waktu tampaknya menjadi biang keladi dari banyak masalah belakangan ini. Mengenai kakakmu, menurutku dia cukup menghibur. Sungguh menarik bagaimana keturunan bisa sangat berbeda satu sama lain."
      Speaker = "Chaos"
      Event = "ChaosAboutZagreus01"
    }
    {
      Id = "Chaos_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kakakmu telah kembali. Barangkali dia akan datang mengunjungiku lagi seperti dahulu kala. Tanda apa pun yang tidak ia pilih, boleh kau ambil dariku sebagai gantinya."
      Speaker = "Chaos"
      Event = "ChaosPostTrueEndingAboutZagreus01"
    }
    {
      Id = "Chaos_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi memanfaatkan kesepakatan kita sebaik-baiknya, kuperintahkan kau untuk mengaktifkan artefak tertentu di tempat tinggalmu. Di balik bidang-bidang hitam pekat batu tegak ini, tersimpan berbagai kemungkinan untuk dijelajahi. Aku akan mengungkap cara melihat semuanya, namun sebelumnya..."
      Speaker = "Chaos"
      Event = "ChaosGrantsBountyBoard01"
    }
    {
      Id = "Chaos_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan kau belum mengaktifkan batu tegak yang hitam pekat itu seperti yang kuminta sebelumnya. Kau boleh meluangkan waktu selama yang kau mau. Eksperimen kita akan tetap berlangsung bagaimanapun juga."
      Speaker = "Chaos"
      Event = "ChaosAboutBountyBoardUnlock01"
    }
    {
      Id = "Chaos_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah memulihkan batu tegak di tempat tinggalmu, dan kini dapat melihat berbagai kemungkinan di dalamnya. Jika kau membantuku menguji kemampuanku dalam menentukan takdir layaknya para Moirai itu sendiri, aku akan memberi ganjaran yang sepadan."
      Speaker = "Chaos"
      Event = "ChaosAboutBountyBoard01"
    }
    {
      Id = "Chaos_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah memperkirakan akan berbicara denganmu seperti ini saat kau menjelajahi berbagai kemungkinan di dalam batu tegak itu. Mungkin kau memandangnya sebagai serangkaian tugas penting yang harus diselesaikan; namun semuanya hanyalah bagian dari eksperimen kita."
      Speaker = "Chaos"
      Event = "ChaosAboutBounties01"
    }
    {
      Id = "Chaos_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Barangkali aku tak seharusnya ikut campur secara aktif dalam Ujian rancanganku sendiri, karena aku bisa mencemari hasilnya secara sepihak. Namun kuyakini dengan cara ini, segalanya akan jauh lebih menarik bagi kita berdua."
      Speaker = "Chaos"
      Event = "ChaosAboutBounties02"
    }
    {
      Id = "Chaos_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua Ujian yang kurancang berawal tepat seperti yang direncanakan; namun sejak saat itu, bahkan aku pun tak bisa memengaruhi hasilnya sepenuhnya. Sebagai contoh, aku tak menyangka akan menemukan {#Emph}dirimu {#Prev}di sini, Keturunan Hades."
      Speaker = "Chaos"
      Event = "ChaosAboutBounties03"
    }
    {
      Id = "Chaos_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah menyelesaikan beberapa Ujian yang kubentangkan di hadapanmu, Keturunan Hades. Aku berniat menyampaikan rasa terima kasihku, hanya saja kurasa Debu Bintang milikku akan jauh lebih berguna bagimu."
      Speaker = "Chaos"
      Event = "ChaosAboutBounties04"
    }
    {
      Id = "Chaos_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penggunaanmu atas batu tegak hitam pekat itu memungkinkanku untuk sesaat muncul dari jurang kehampaanku, dan Aku berterima kasih untuk itu. Aku bisa mengamati dengan lebih jelas, baik hasil dari Ujianmu, maupun segala hal lainnya."
      Speaker = "Chaos"
      Event = "ChaosAboutBountyChaosIntro01"
    }
    {
      Id = "Chaos_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang, Keturunan Hades, di jenis eksperimen yang paling Kusukai. Di sini, nyaris tak ada yang dikendalikan; kemungkinannya menjadi begitu banyak, sehingga untuk menimbang semuanya akan membutuhkan waktu."
      Speaker = "Chaos"
      Event = "ChaosAboutRandomBounties01"
    }
    {
      Id = "Chaos_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau akrab dengan apa yang kaukenal sebagai tiga alam: kahyangan, permukaan, dan Dunia Bawah. Namun Aku tahu ada alam keempat, tempat kau berada saat ini. Dan Kemungkinan merangkul sisanya."
      Speaker = "Chaos"
      Event = "ChaosAboutRandomBounties02"
    }
    {
      Id = "Chaos_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak harus mengikuti Ujian-Ujian yang Kurancang, ataupun memberikan begitu banyak hasil menarik untuk diamati. Namun kau tetap memutuskan melakukannya atas kehendakmu sendiri. Oleh karenanya, perkenalan kita bukanlah suatu kekeliruan."
      Speaker = "Chaos"
      Event = "ChaosAboutBountyProgress01"
    }
    {
      Id = "Chaos_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tindakan penciptaan tidaklah selalu murni tanpa cela. Sisanya kaukenal sebagai Debu Bintang, yang masih menyimpan sebagian kekuatan atas kesadaran. Anggaplah itu sebagai pendorong untuk memandang batu tegak itu dan menjalani Ujian-Ujian yang kaulihat di sana."
      Speaker = "Chaos"
      Event = "ChaosAboutStarDust01"
    }
    {
      Id = "Chaos_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasakan pengaruh dewi Nyx yang kian berkembang; seakan putri-Ku baru saja menjerumuskan dunia ke dalam kegelapan yang lebih pekat. Namun bukan dia yang melakukan ini; Aku yakin itu perbuatanmu."
      Speaker = "Chaos"
      Event = "ChaosAboutShrine01"
    }
    {
      Id = "Chaos_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengenali pusaka-pusaka yang kaubawa itu. Saudara-saudara senjata tersebut yang berasal dari neraka meneguk dalam-dalam darah para Titan dan tumbuh makin kuat, sementara yang ini? Para pelayan Dunia Bawah tempaan Takdir yang bertumbuh dari Mimpi Buruk murni itu sendiri."
      Speaker = "Chaos"
      Event = "ChaosAboutWeapons01"
    }
    {
      Id = "Chaos_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa Embrio yang Kuberikan padamu. Itu menciptakan kesan seolah-olah bagian dari diriku bersamamu, bahkan saat kau tak berada di ruang ini. Kau boleh terus menggunakannya, atau tidak."
      Speaker = "Chaos"
      Event = "ChaosAboutKeepsake01"
    }
    {
      Id = "Chaos_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasakan Embrio milik-Ku yang kaubawa telah bertumbuh sampai taraf tertentu. Ia belum akan beranjak dewasa untuk waktu yang cukup lama; namun kau telah memeliharanya, dan sebagai imbalannya ia telah memberikan sedikit bantuan. Aku bertanya-tanya, apakah kau sudah memberinya nama...?"
      Speaker = "Chaos"
      Event = "ChaosAboutKeepsake02"
    }
    {
      Id = "Chaos_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau masih menyukai Embrio milik-Ku itu, dan Aku ingin melihatmu melangkah lebih jauh lagi bersamanya. Sudikah kau mempertimbangkan rincian dari pikiranku ini? Jawablah."
      Speaker = "Chaos"
      Event = "ChaosAboutKeepsakeQuest01"
    }
    {
      Id = "MelinoeField_3645"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bila ada yang bisa kulakukan untuk Anda, Chaos Yang Mahakuasa, Anda hanya perlu memintanya. Ke mana aku harus membawa Embrio ini?"
      Speaker = "Melinoe"
      Event = "ChaosAboutKeepsakeQuest01"
    }
    {
      Id = "Chaos_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bawalah itu dari awal perjalananmu hingga ke akhir. Jangan menukarnya di tengah jalan, capailah tujuanmu dengan benda itu tetap bersamamu; di Dunia Bawah ataupun di permukaan, Kami tak peduli. Ini semata-mata demi menghibur sang Embrio dan Aku, serta mungkin dirimu."
      Speaker = "Chaos"
      Event = "ChaosAboutKeepsakeQuest01"
    }
    {
      Id = "Chaos_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Embrio milik-Ku yang kaubawa itu: Aku ingin melihatmu melangkah lebih jauh lagi bersamanya. Sudikah kau mempertimbangkan rincian dari pikiranku ini? Jawablah."
      Speaker = "Chaos"
      Event = "ChaosAboutKeepsakeQuest01_B"
    }
    {
      Id = "Chaos_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah berkelana jauh sembari membawa Embrio yang Kuberikan padamu, yang merupakan pemandangan menarik untuk diamati, dan selaras dengan rancangan Tiga Takdir. Namun apakah mereka yang mendorong tindakanmu, ataukah dirimu, atau Aku? Hiburan lain untuk direnungkan. Maka dari itu, terima kasih."
      Speaker = "Chaos"
      Event = "ChaosAboutKeepsakeQuest02"
    }
    {
      Id = "Chaos_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau kembali ke bayang-bayang, Aku sempat merasakan kehadiranmu di jurang kehampaan tak bertepi. Jadi Aku telah melihat bahwa pelayan Tiga Takdir itu menemukanmu di tempat tersembunyi tersebut. Dia menyampaikan sebuah rahasia padamu, bukan? Jawablah."
      Speaker = "Chaos"
      Event = "ChaosAboutSurface01"
    }
    {
      Id = "MelinoeField_0767_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksud Anda Moros. Rahasianya adalah tentang permukaan... tentang bagaimana aku bisa bertahan hidup di atas sana. Aku tahu ini menentang rancangan Tiga Takdir, tapi Olympus membutuhkanku."
      Speaker = "Melinoe"
      Event = "ChaosAboutSurface01"
    }
    {
      Id = "Chaos_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu rupanya. Seperti yang mungkin kauketahui, Aku tak berminat melihat Tiga Takdir memegang kendali berlebihan. Barangkali kau bisa menemukan katalis di sini untuk mantra itu. Peduli amat mereka suka atau tidak."
      Speaker = "Chaos"
      Event = "ChaosAboutSurface01"
    }
    {
      Id = "Chaos_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belakangan ini Aku mendapati diriku nyaris tak bisa mendeteksi keberadaanmu sama sekali, dan menyimpulkan bahwa kau pasti telah menyelesaikan mantra terlarangmu itu. Dengan demikian permukaan kini terbentang bebas bagimu. Barangkali suatu saat nanti Aku akan memintamu menggambarkannya pada-Ku."
      Speaker = "Chaos"
      Event = "ChaosAboutSurface02"
    }
    {
      Id = "Chaos_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemampuanmu melampaui batasan-batasan yang ditaruh Tiga Takdir padamu terbukti mengilhamiku. Setelah menimbangnya, Aku menemukan cara untuk memanggilmu bahkan dari permukaan dunia ini. Tempat itu tampak cukup menarik bagi-Ku."
      Speaker = "Chaos"
      Event = "ChaosAboutSurfaceAppearance01"
    }
    {
      Id = "Chaos_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin Aku harus mengulanginya dari awal lagi: Itulah yang Kupikirkan saat mengamati segala hal yang telah terjadi di permukaan dunia ini. Pada akhirnya Kukira Aku akan melakukannya, walau untuk saat ini, Aku membiarkan keturunan-Ku terus beranak pinak dan berinteraksi sesuka hati mereka."
      Speaker = "Chaos"
      Event = "ChaosAboutSurfaceAppearance02"
    }
    {
      Id = "Chaos_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah menjelajahi permukaan dunia ini, tempat pengaruh-Ku terbilang terbatas. Aku merasa terhibur saat mempertimbangkan berbagai kemungkinannya, meski Aku memang menduga kau akan kembali."
      Speaker = "Chaos"
      Event = "ChaosAboutPostSurface01"
    }
    {
      Id = "Chaos_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham bahwa memasuki gerbang menuju ranah-Ku bukanlah sensasi yang menyenangkan, dan tandaku secara alami mendatangkan hasil yang beragam. Maka Aku bertanya-tanya mengapa kau kerap bertualang ke sini; barangkali kau hanya ingin memandang-Ku seperti ini."
      Speaker = "Chaos"
      Event = "ChaosAboutChaosGates01"
    }
    {
      Id = "Chaos_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebuah Percikan Ixion membawamu pada-Ku... bara dari api yang membara abadi di Dunia Bawah. Cahayanya menyingkap gerbang menuju jurang kehampaanku, dan meredakan efek samping yang lazim timbul saat memasukinya. Kusarankan kau terus menggunakannya."
      Speaker = "Chaos"
      Event = "ChaosAboutChaosGateItem01"
    }
    {
      Id = "Chaos_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa orang yang berusaha menjawab panggilan-Ku ternyata kekurangan keteguhan batin untuk menyelami jurang ini. Maka Aku tak pernah lagi memanggil manusia fana, dan jarang memanggil siapa pun. Karena para Titan dan dewa bisa bermuka dua, Aku tahu itu. Aku meminta agar kau tidak mengkhianati kepercayaanku."
      Speaker = "Chaos"
      Event = "ChaosAboutTrust01"
    }
    {
      Id = "Chaos_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tanggung jawab ini sebagian berada di pundak-Ku atas segala yang telah terjadi. Aku berupaya menciptakan dunia ini dengan kadar perhatian tertentu. Aku memeliharanya; berpegang teguh pada prinsip-prinsip tertentu, sebagaimana layaknya seorang ibu dan ayah, karena Aku menciptakan {#Emph}mereka{#Prev} juga. Namun dunia ini tak lagi muda. Ia kini bertahan hanya atas kehendaknya sendiri."
      Speaker = "Chaos"
      Event = "ChaosAboutCreation01"
    }
    {
      Id = "Chaos_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dahulu ada Kegelapan di seluruh penjuru Dunia Bawah, namun kini... Chronos berupaya merombak ranah itu agar sesuai dengan seleranya. Kendati demikian, akan selalu ada Kegelapan di ruang ini. Dan Aku telah membuatnya tampak olehmu."
      Speaker = "Chaos"
      Event = "ChaosGrantsDarkness01"
    }
    {
      Id = "Chaos_0047_ALT"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan selalu ada Kegelapan di ruang ini. Dan Aku telah membuatnya tampak olehmu."
      Speaker = "Chaos"
      Event = "ChaosGrantsDarkness01_B"
    }
    {
      Id = "Chaos_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa Olympus mengirimkan berkah dan pesan mereka untukmu, dengan kesadaran terbatas tentang keadaan dan keberadaanmu. Begitu pula halnya dengan-Ku, selagi kau berada di sini."
      Speaker = "Chaos"
      Event = "ChaosAboutOlympians01"
    }
    {
      Id = "Chaos_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa Olympus kerap membicarakan tentang keluarga, namun Aku tak sepenuhnya paham apa maksud mereka. Semua makhluk memiliki asal-usul yang sama, namun tak dianggap sebagai keluarga. Chronos, misalnya: Apakah dia keluarga, atau bukan? Aku tak akan memintamu menjawabnya."
      Speaker = "Chaos"
      Event = "ChaosAboutFamily01"
    }
    {
      Id = "Chaos_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu, tentu saja, tidak selalu ada. Chronos menyediakan sarana untuk mengukur laju pertumbuhan dan perubahan segala sesuatu, ataupun ketiadaannya. Dia amat berguna karena hakikat alaminya itu. Namun Waktu juga bisa menjadi sumber petaka, Aku tahu betul itu."
      Speaker = "Chaos"
      Event = "ChaosAboutChronos01"
    }
    {
      Id = "Chaos_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku percaya bahwa Diriku adalah entitas yang tak memihak, Keturunan Hades. Namun demikian, bahkan Diriku pun bisa terpancing, sebagaimana yang akan segera disadari oleh Chronos. Eksperimen kita berkaitan dengan takdirnya; jika dia yakin bisa mengubah takdirnya, maka kita pun bisa."
      Speaker = "Chaos"
      Event = "ChaosAboutChronos02"
    }
    {
      Id = "Chaos_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan menuntut pertanggungjawaban Chronos atas apa yang telah terjadi. Namun Aku sendiri bukannya tanpa cela. Sebab Aku khawatir telah memperkeruh keadaan yang ada saat ini. Kita lihat saja apakah kekeliruan semacam itu bisa diperbaiki."
      Speaker = "Chaos"
      Event = "ChaosAboutChronos03"
    }
    {
      Id = "Chaos_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tenunan Tiga Takdir konon mengikat manusia fana maupun makhluk abadi tanpa pandang bulu. Jalur dan akhir dari seluruh kehidupan, semuanya telah ditentukan sebelumnya. Maka dari itu, rasa memiliki pilihan hanyalah ilusi semata. Apakah kau memercayai ini, Keturunan Hades? Jawablah."
      Speaker = "Chaos"
      Event = "ChaosAboutChronosNightmare01"
    }
    {
      Id = "MelinoeField_1209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir Tiga Takdir menentukan banyak hal tentang hidup kita... kapan dan di mana kita lahir, misalnya, dan dari siapa. Tapi kurasa mereka tak mengatur setiap rinciannya. Dan, aku tahu saat ini mereka sama sekali tidak menenun... karena Chronos menawan mereka."
      Speaker = "Melinoe"
      Event = "ChaosAboutChronosNightmare01"
    }
    {
      Id = "Chaos_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu rupanya. Sebagian besar, Aku sepakat dengan penilaianmu. Akulah alasan Chronos menawan mereka sekarang. Dia bertanya pada-Ku di mana menemukan mereka, dan Aku memutuskan memberitahunya; guna membuktikan bahwa pilihan semacam itu bisa diambil tanpa pengaruh mereka. Sekarang, apakah kau memahami dilema-Ku? Jawablah..."
      Speaker = "Chaos"
      Event = "ChaosAboutChronosNightmare01"
    }
    {
      Id = "MelinoeField_1210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga, tidak. Yang Mahakuasa Chaos, Kau telah diperdaya! Chronos ingin menemukan sang Tri Takdir demi keuntungannya sendiri. Merekalah salah satu kekuatan di dunia ini yang cukup perkasa untuk menghentikannya."
      Speaker = "Melinoe"
      Event = "ChaosAboutChronosNightmare01"
    }
    {
      Id = "Chaos_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun mereka ternyata tak sekuat kelihatannya. Kendati demikian, kurasa dugaanmu tepat. Chronos mengisyaratkan bahwa niatnya tulus. Aku tak terbiasa dengan tipu muslihat, sehingga teperdaya. Dan hal ini masih sangat membuatku masygul."
      Speaker = "Chaos"
      Event = "ChaosAboutChronosNightmare01"
    }
    {
      Id = "MelinoeField_1209_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir sang Tri Takdir menentukan banyak hal dalam hidup kita... kapan dan di mana kita lahir, misalnya, dan dari siapa. Namun kurasa mereka tak mengatur setiap rinciannya. Lagipula, kutahu saat ini mereka sama sekali tidak sedang menenun..."
      Speaker = "Melinoe"
      Event = "ChaosAboutChronosNightmare01_B"
    }
    {
      Id = "MelinoeField_4565"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga, Yang Mahakuasa Chaos, Kau telah diperdaya. Chronos kini memang sudah berbeda, tapi dulu berniat menemukan sang Tri Takdir demi kepentingannya sendiri, sebagai salah satu kekuatan di dunia ini yang cukup perkasa untuk menghentikannya..."
      Speaker = "Melinoe"
      Event = "ChaosAboutChronosNightmare01_B"
    }
    {
      Id = "Chaos_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bila dipikir-pikir lagi, seharusnya tak kubiarkan Chronos berbicara denganku, namun tutur katanya amat meyakinkan. Aku masih belum paham seutuhnya cara kalian berkomunikasi; apa yang kalian ucapkan tak selalu mencerminkan apa yang kalian maksud, dan niat kalian kerap terselubung rapat. Oleh karenanya, kini aku mengamati lebih saksama."
      Speaker = "Chaos"
      Event = "ChaosAboutChronosNightmare02"
    }
    {
      Id = "Chaos_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum lama ini Titan Chronos memanggilku, memberikan segudang dalih mengapa dilemaku ini ada. Aku tak menyimak setiap detilnya, namun menangkap gelagat yang berbeda dibanding saat terakhir kali kami bersua, yang berujung pada lenyapnya sang Tri Takdir. Haruskah kutolak permintaan maafnya tempo hari? Jawab."
      Speaker = "Chaos"
      Event = "ChaosAboutFates01"
    }
    {
      Id = "MelinoeField_4004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang Mahakuasa Chaos, apakah permintaan maafnya tulus atau tidak bukanlah hakku untuk menilainya. Namun kurasa perubahan yang Kau rasakan pada Kakek memang menyeluruh. Tak bisakah kalian bekerja sama sekarang untuk mencoba mencari sang Tri Takdir?"
      Speaker = "Melinoe"
      Event = "ChaosAboutFates01"
    }
    {
      Id = "Chaos_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan Chronos juga mengajukan diri melampaui apa yang kuminta. Aku memahami jawabanmu, namun aku tak berniat membahasnya lebih lanjut. Entah sang Tri Takdir bakal ditemukan, entah tidak."
      Speaker = "Chaos"
      Event = "ChaosAboutFates01"
    }
    {
      Id = "Chaos_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Tri Takdir akhirnya telah kembali, dan itu bagus; dengan demikian bantuanmu atas dilemaku telah usai. Namun mengenai apakah kau yang menemukan {#Emph}mereka {#Prev}atau {#Emph}mereka {#Prev}yang memutuskan untuk pulang, masih belum gamblang. Kini mereka justru melahirkan jauh lebih banyak teka-teki dibanding diriku."
      Speaker = "Chaos"
      Event = "ChaosPostEpilogue01"
    }
    {
      Id = "Chaos_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat tertarik pada kendali. Dahulu akulah pemilik tunggalnya, hingga sang Tri Takdir merenggut sebagian dariku; lantas mereka sirna, usai Titan Chronos bangkit kembali. Kini mereka telah pulang. Pilihan siapa yang sesungguhnya terlaksana...? Pilihan semua orang. Pilihan tak seorang pun."
      Speaker = "Chaos"
      Event = "ChaosPostEpilogue02"
    }
    {
      Id = "Chaos_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada semacam gemuruh yang kurasakan di relung kedalaman... kau telah tiba di tujuanmu, bukan? Berhadapan langsung dengan Chronos, dan keluar sebagai pemenang. Kendati demikian, pengaruhnya masih berakar. Namun mungkin sang Titan bakal menanggalkan kendalinya lewat bujukan yang lebih keras."
      Speaker = "Chaos"
      Event = "ChaosAboutChronosFight01"
    }
    {
      Id = "Chaos_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memahami bahwa sosok yang kau sebut Typhon memicu petaka besar bagi kaum Olympus, dan kini juga bagimu. Aku tak pernah menduga ia dan Chronos bakal bersekutu; mungkin karena itulah aku gagal mengendus bangkitnya kembali Typhon."
      Speaker = "Chaos"
      Event = "ChaosAboutTyphon01"
    }
    {
      Id = "Chaos_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sosok yang kau kenal sebagai Typhon adalah hasil dari eksperimen purbaku tempo dulu. Aku ingin segenap ciptaanku mengejutkan dan berlipat ganda, namun mungkin tidak sampai separah itu. Dan kini aku tak kuasa melenyapkannya kembali."
      Speaker = "Chaos"
      Event = "ChaosAboutTyphon02"
    }
    {
      Id = "Chaos_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cukup menarik bagiku bahwa sosok yang kau sebut Typhon begitu mendewakan kehancuran di atas segalanya. Barangkali aku mencipta lebih dari yang seharusnya, dan kini daya penyeimbang tersebut menyeruak timbul. Karena sejatinya, ciptaan membenahi dirinya sendiri."
      Speaker = "Chaos"
      Event = "ChaosAboutTyphon03"
    }
    {
      Id = "Chaos_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau bertanya-tanya apakah aku bertanggung jawab atas Typhon, sebab akulah yang mencipta muasal ia dilahirkan. Aku pun merenungkan hal serupa, dan kesimpulanku adalah: tanggung jawabku atas Typhon setara dengan tanggung jawab Chronos atas dirimu."
      Speaker = "Chaos"
      Event = "ChaosAboutTyphon04"
    }
    {
      Id = "Chaos_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum lama ini aku tak lagi merasakan keberadaan sosok yang kau sebut Typhon, hal yang ganjil mengingat perawakannya yang luar biasa raksasa. Aku bertanya-tanya apakah ini pertanda ada gangguan pada inderaku, ataukah memang Typhon sudah tiada di sana. Bagaimana menurutmu? Jawab."
      Speaker = "Chaos"
      Event = "ChaosAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_4003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bapa Segala Monster telah binasa, Yang Mahakuasa Chaos. Itu adalah tindakan yang kuambil tanpa bersenang hati, namun ancaman terhadap keluargaku sungguh nyata dan merajalela. Dia tak memberi kami pilihan lain."
      Speaker = "Melinoe"
      Event = "ChaosAboutTyphonDeath01"
    }
    {
      Id = "Chaos_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa saja memilih kehancuran Olympus; kendati demikian, aku mengerti mengapa kau tak menempuhnya. Daya untuk memusnahkan ciptaan semegah itu... Aku penasaran ingin mempelajarinya sendiri. Walau mungkin aku takkan sehemat itu dalam mempergunakannya."
      Speaker = "Chaos"
      Event = "ChaosAboutTyphonDeath01"
    }
    {
      Id = "Chaos_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan yang kau kenal sebagai Prometheus menganugerahkan api suci Olympus kepada kaum fana, suatu momen memikat yang tak sepenuhnya kuantisipasi. Bagaimana kiranya api itu kelak dipergunakan, apalagi di tangan yang begitu beragam?"
      Speaker = "Chaos"
      Event = "ChaosAboutPrometheus01"
    }
    {
      Id = "Chaos_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah sesungguhnya perbedaan mendasar antara Titan dan dewa? Sulit bagiku membedakan keduanya. Namun perbedaan tersebut pastilah amat kentara, hingga mampu memantik perang abadi yang tak berkesudahan."
      Speaker = "Chaos"
      Event = "ChaosAboutTitans01"
    }
    {
      Id = "Chaos_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rancangan sang Tri Takdir bagi kita mungkin saling bertaut. Karena kita sama-sama mencari darah daging terdekat kita. Aku telah kehilangan kontak dengan benih dan putriku, Nyx, yang bersemayam di kediaman ayahmu. Pengaruhnya masih tertinggal, namun ketiadaannya teramat kurasakan..."
      Speaker = "Chaos"
      Event = "ChaosAboutNyx01"
    }
    {
      Id = "Chaos_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bila Chronos menyekap dewi Nyx di kediaman ayahmu, bersama anggota keluarganya dan keluargamu yang lain, maka aku ingin hal itu disudahi. Mungkin ia bersedia membebaskan mereka jika kau mengerahkan kekerasan yang setimpal."
      Speaker = "Chaos"
      Event = "ChaosAboutNyx02"
    }
    {
      Id = "Chaos_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat ini, aku masih bercengkerama dengan dewi Nyx. Berkah tanda kuasaku tetap milikmu seperti biasa, namun kumohon tinggalkan kami berdua setelah ini; meski begitu, gunakanlah waktumu sesukamu, sebab kami sanggup menanti."
      Speaker = "Chaos"
      Event = "ChaosWithNyx01"
    }
    {
      Id = "Chaos_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurang lebih ada kehampaan yang tak lazim bagiku usai dewi Nyx direnggut untuk sementara waktu. Kini setelah ia kembali, kehampaan itu nyaris sirna seutuhnya; terkhusus kala ia berada di sisiku."
      Speaker = "Chaos"
      Event = "ChaosWithNyx02"
    }
    {
      Id = "Chaos_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum lama ini putri Nyx melangkah ke ranah kekuasaanku. Begitu mirip rupanya hingga mulanya kukira ia adalah sang dewi ibunya, sebab banyak entitas tampak serupa bagiku. Akan kuizinkan ia bertandang kemari."
      Speaker = "Chaos"
      Event = "ChaosAboutNemesis01"
    }
    {
      Id = "Chaos_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putri Nyx yang menyerupai dewi ibunya itu turut membantu menuntaskan dilemaku, persis sepertimu. Ia sangat patuh, namun sebagian keturunan lainnya tidaklah demikian. Mungkin dulu seharusnya kupastikan semuanya tunduk menurut; tapi tentu takkan semenarik ini jadinya."
      Speaker = "Chaos"
      Event = "ChaosAboutNemesis02"
    }
    {
      Id = "Chaos_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salah satu keturunan dewi Nyx, yang bergelar sang Perselisihan... Cukup menarik bagiku bagaimana Nyx melahirkan sosok semacam itu, tapi yah, kita semua tentu pernah berbuat khilaf. Kuakui segala yang kutitahkan pun dapat dipandang semrawut pula."
      Speaker = "Chaos"
      Event = "ChaosAboutEris01"
    }
    {
      Id = "Chaos_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berasal dari suatu ranah yang bukan permukaan dunia maupun Bawah Tanah, melainkan di antaranya. Pengurus ranah tersebut kerap kulihat sesekali sejak dahulu kala, dan ia mengabdi pada dewi Nyx; kau begitu mengingatkanku pada sosoknya."
      Speaker = "Chaos"
      Event = "ChaosAboutHecate01"
    }
    {
      Id = "Chaos_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan pernah tahu bagaimana rasanya bersua dengan sang pencipta diri, namun kau mungkin mengetahuinya, atau barangkali sudah mengalaminya. Ayahmu tak lagi berada di istananya, tempat di mana kusadari banyak hal telah jungkir balik. Namun ia tak jauh dari sana. Mungkin aku bersedia membantumu melacak keberadaannya."
      Speaker = "Chaos"
      Event = "ChaosAboutHades01"
    }
    {
      Id = "Chaos_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyandang restu dari sang Raja Olimpus itu sendiri. Kukira tadinya ia bakal terlampau sibuk hingga mustahil mengulurkan bantuan secara langsung, kendati ia jelas memiliki kepentingan pribadi yang teramat besar atas kemenanganmu..."
      Speaker = "Chaos"
      Event = "ChaosAboutZeus01"
    }
    {
      Id = "Chaos_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengenal sosok yang bergelar Ratu Hera dari Olympus. Ia sendiri pun memiliki kuasa tersendiri atas penciptaan. Kaum fana memujanya, mengemis belas kasihnya kala mereka mengikat janji dan melahirkan keturunan ke dunia. Ia pasti amat menikmati limpahan perhatian itu."
      Speaker = "Chaos"
      Event = "ChaosAboutHera01"
    }
    {
      Id = "Chaos_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah dikunjungi oleh Penguasa Poseidon. Perairan luas yang didaku sebagai miliknya, sejatinya merupakan salah satu ciptaan awalku, dan kurasa hasilnya terwujud cukup elok. Aku bertanya-tanya apakah ia memahami sedalam apa daya kuasa yang tersembunyi di dalamnya."
      Speaker = "Chaos"
      Event = "ChaosAboutPoseidon01"
    }
    {
      Id = "Chaos_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putra keemasan Zeus telah melimpahkan restunya padamu, kulihat. Apollo tak melulu sudi melibatkan diri dalam kemelut keluargamu. Barangkali kemelut kali ini tak memberinya banyak pilihan lain."
      Speaker = "Chaos"
      Event = "ChaosAboutApollo01"
    }
    {
      Id = "Chaos_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan dewi Hestia pun turut meminjamkan kekuatannya kepadamu. Biasanya ia cukup puas hanya dengan meniup percik api kecil penghangat perapian di gubuk fana. Namun kini bara api tersebut mengancam bakal menjalar melampaui kendalinya sendiri."
      Speaker = "Chaos"
      Event = "ChaosAboutHestia01"
    }
    {
      Id = "Chaos_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Restu Hephaestus kini menyelimutimu. Sang dewa tempa merakit senjata dan zirah yang pantas untuk kancah peperangan, sementara akulah yang mencipta bahan-bahan mentah yang ia gunakan demi keahliannya. Tiada mahakarya yang murni milik diri sendiri, Keturunan Hades."
      Speaker = "Chaos"
      Event = "ChaosAboutHephaestus01"
    }
    {
      Id = "Chaos_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah masih tersisa tempat untuk keindahan dan hal-hal yang dihasratkan di dunia semacam ini? Sang dewi Aphrodite pasti menganggap demikian, dan kalian kini bekerja sama sebagai sekutu. Aku yakin ini tujuan yang berharga; lagipula, dunia ini tercipta dari hasrat tertentu."
      Speaker = "Chaos"
      Event = "ChaosAboutAphrodite01"
    }
    {
      Id = "Chaos_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang dewi Demeter siap berperang, dan meminjamkan murka kekuatannya kepadamu. Ibu dari ibumu punya pengalaman bertarung melawan para Titan... pendahulunya. Kalian semua kini telah beranak pinak begitu banyak hingga hampir tak ada lagi kesamaan yang tersisa."
      Speaker = "Chaos"
      Event = "ChaosAboutDemeter01"
    }
    {
      Id = "Chaos_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa Berkah dari Ares yang keji, yang sering kali lebih memujaku daripada kerabatnya sendiri; sebab tanpa penciptaan, takkan ada kehancuran, begitu katanya. Dan kuyakini ia memang sepenuhnya benar."
      Speaker = "Chaos"
      Event = "ChaosAboutAres01"
    }
    {
      Id = "Chaos_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sadar dewi perburuan akhir-akhir ini menjalankan keahliannya di perbatasan antardimensi. Artemis tak selalu seberani itu; namun tak heran jika dia tertarik semakin jauh ke dalam kegelapan. Kalian tampaknya saling mengenal dengan baik."
      Speaker = "Chaos"
      Event = "ChaosAboutArtemis01"
    }
    {
      Id = "Chaos_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita punya waktu selamanya untuk melakukan eksperimen ini. Aku belum yakin apakah hasilnya akan datang lebih cepat berkat bantuan kegesitan Hermes kepadamu. Itu adalah sudut pandang lain yang patut dijelajahi."
      Speaker = "Chaos"
      Event = "ChaosAboutHermes01"
    }
    {
      Id = "Chaos_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selene melintasi angkasa, namun perhatiannya ia arahkan kepadamu. Mungkin ia bertanya-tanya, {#Emph}apalah arti Sang Rembulan tanpa Kehadiran Malam? {#Prev}Namun kuduga ia sanggup bertahan tanpa keberadaan Nyx."
      Speaker = "Chaos"
      Event = "ChaosAboutSelene01"
    }
    {
      Id = "Chaos_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat salah mengira dirimu sebagai dewi Nyx sejenak, karena ia dulu memiliki rupa yang mirip denganmu. Bukan soal perawakan maupun bentuk tubuhmu; melainkan artefak yang mengelilingimu itu. Tak ada alasan bagimu untuk memilikinya andai Nyx tak mengizinkannya."
      Speaker = "Chaos"
      Event = "ChaosAboutNyxAspect01"
    }
    {
      Id = "Chaos_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di ruang hampa ini, ada suatu spesimen hidup yang boleh kau ambil. Aku tak peduli padanya, sebab masih ada yang lain dari jenisnya. Dulu kuberikan mereka kemampuan memperbanyak diri, dan menemukan tujuan dari tindakan itu."
      Speaker = "Chaos"
      Event = "ChaosAboutFishing01"
    }
    {
      Id = "Chaos_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam satu hal, kita adalah makhluk yang terus berubah. Partikel-partikel pembentuk kita mati dan terlahir kembali. Dari pengamatanku terhadap sanak saudaramu beserta adat istiadat mereka yang ganjil, aku mencoba mengekstrapolasi suatu wujud yang lebih cocok bagi mereka; dan mungkin juga bagimu."
      Speaker = "Chaos"
      Event = "ChaosAboutForm01"
    }
    {
      Id = "Chaos_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan gejolak di bumi yang belum pernah kurasakan sebelumnya; lebih ke arah getarannya daripada intensitasnya. Sesuatu telah terjadi di kediaman ayahmu, dan Chronos menyingkir pergi. Mengapa dia mengambil tindakan semacam itu? Jawablah."
      Speaker = "Chaos"
      Event = "ChaosPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4001"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan segala hormat, Chaos Yang Mahakuasa... Chronos telah mengalami perubahan sikap yang drastis. Aku menemukan saudaraku, Zagreus, yang membantuku mewujudkannya. Kakek kami menyerah dalam perangnya melawan Olympus, dan kini berusaha menebus kesalahannya."
      Speaker = "Melinoe"
      Event = "ChaosPostTrueEnding01"
    }
    {
      Id = "Chaos_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebuah perubahan yang menarik. Ketiadaan rincian penjelasan ini menimbulkan banyak pertanyaan, yang akan kujelajahi. Hasil akhir yang kau tuju telah tercapai, namun kau tampaknya masih mengejarnya bahkan hingga kini. Maka dari itu, tandaku tetap tersedia untukmu."
      Speaker = "Chaos"
      Event = "ChaosPostTrueEnding01"
    }
    {
      Id = "Chaos_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya satu pertanyaan lanjutan mengenai apa yang terjadi di Kediaman ayahmu. Chronos menyerah dalam perangnya, katamu, namun kau terus bertempur seperti sebelumnya. Mengapa begitu? Jawablah."
      Speaker = "Chaos"
      Event = "ChaosPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chaos Yang Mahakuasa, Chronos bisa menjelaskannya jauh lebih baik daripadaku, namun Waktu bagaikan sungai yang berupaya mengalir deras dengan bebas. Namun arusnya bisa tersumbat dan berbelok arah secara membawa malapetaka. Intinya, aku terpaksa menelusuri kembali beberapa langkahku demi mencegah hal itu."
      Speaker = "Melinoe"
      Event = "ChaosPostTrueEnding02"
    }
    {
      Id = "Chaos_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagai entitas yang bersemayam dalam segala kemungkinan, aku memahaminya. Mencegah kemungkinan tak terhingga, betapapun kecil kemungkinannya, tentu membutuhkan waktu. Namun Chronos pasti menyadari betul hal itu. Aku akan menantikan hasil akhir dari ikhtiar barumu ini."
      Speaker = "Chaos"
      Event = "ChaosPostTrueEnding02"
    }
    {
      Id = "Chaos_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terus melanjutkan perjalananmu ke Olympus meski makhluk yang kausebut Typhon sudah tiada; sebab masih ada pertempuran yang harus dihadapi, selagi menapak tilas langkah-langkah yang pernah kauambil. Apakah ini yang ditemukan Chronos mengenai Sang Waktu...?"
      Speaker = "Chaos"
      Event = "ChaosPostTrueEndingSurface01"
    }
    {
      Id = "Chaos_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan jejak samar dari makhluk yang kausebut Typhon itu sekali lagi, lalu lenyap begitu saja. Barangkali riak arus yang terpancar dari sungai yang kausebut Sang Waktu, dan kau menemukan cara untuk menghentikannya. Berkurang satu kemungkinan, namun masih ada begitu banyak lainnya."
      Speaker = "Chaos"
      Event = "ChaosPostTrueEndingRunCleared01"
    }
    {
      Id = "Chaos_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mencapai kediaman ayahmu lalu menghilang, tak lagi dapat terdeteksi olehku. Ini ulah Chronos, bukan? Suatu pemindahan ke ranah kemungkinan lain, yang kau coba tutup rapat-rapat dari dalam ke luar..."
      Speaker = "Chaos"
      Event = "ChaosPostTrueEndingAboutUnderworld01"
    }
    {
      Id = "Chaos_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertemuanmu dengan sang Titan Chronos memicu serangkaian panjang peristiwa, berujung pada pembebasan sang dewi Nyx. Itu adalah hasil akhir yang memang kuinginkan, maka demi putriku ini, kuhaturkan rasa terima kasihku kepadamu."
      Speaker = "Chaos"
      Event = "ChaosPostTrueEndingAboutNyx01"
    }
    {
      Id = "Chaos_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kini kurasakan perbedaan di kedalaman Dunia Bawah, namun lingkungannya sendiri sebagian besar tetap sama. Mereka yang menentangmu masih tetap menentangmu, sehingga kau kini dapat menelusuri kembali beberapa langkahmu. Ini pastilah akan membuahkan hasil akhir yang berbeda."
      Speaker = "Chaos"
      Event = "ChaosPostTrueEndingAboutUnderworld02"
    }
    {
      Id = "Chaos_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keturunan Hades, aku tak lagi berhasrat untuk berkomunikasi sesering dan sepanjang ini denganmu. Mulai sekarang, kurasa aku akan menggunakan lebih sedikit kata-kata padamu."
      Speaker = "Chaos"
      Event = "ChaosAboutSayingLittle01"
    }
    {
      Id = "Chaos_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang kelak terjadi, aku penasaran untuk menyaksikannya."
      Speaker = "Chaos"
      Event = "ChaosChat01"
    }
    {
      Id = "Chaos_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memiliki sebuah tawaran yang harus terus kaupegang teguh, wahai Keturunan Hades."
      Speaker = "Chaos"
      Event = "ChaosChat02"
    }
    {
      Id = "Chaos_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita lanjutkan eksperimen kita, jika kau bersedia menentukan pilihanmu."
      Speaker = "Chaos"
      Event = "ChaosChat03"
    }
    {
      Id = "Chaos_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tandaku akan membawa manfaat, begitu rasa tidak nyaman di awal ini mereda."
      Speaker = "Chaos"
      Event = "ChaosChat04"
    }
    {
      Id = "Chaos_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Keturunan Hades telah kembali, dan ada pilihan yang harus dibuat."
      Speaker = "Chaos"
      Event = "ChaosChat05"
    }
    {
      Id = "Chaos_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apalah arti hidup, selain rentetan komplikasi yang tak terduga?"
      Speaker = "Chaos"
      Event = "ChaosChat06"
    }
    {
      Id = "Chaos_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana aku harus membentuk ulang eksistensimu kali ini, Keturunan Hades?"
      Speaker = "Chaos"
      Event = "ChaosChat07"
    }
    {
      Id = "Chaos_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hasil dari eksperimen kita belum sepenuhnya konklusif hingga saat ini..."
      Speaker = "Chaos"
      Event = "ChaosChat08"
    }
    {
      Id = "Chaos_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dunia ini terlahir dari dorongan impulsif, bukan dari rencana yang dipertimbangkan matang-matang."
      Speaker = "Chaos"
      Event = "ChaosChat09"
    }
    {
      Id = "Chaos_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak punya kesabaran untuk berdiskusi, Keturunan Hades, jadi kau cukup memilih saja."
      Speaker = "Chaos"
      Event = "ChaosChat10"
    }
    {
      Id = "Chaos_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kumpulkan pikiranmu selagi kau berada di sini, namun jangan berdiam terlalu lama."
      Speaker = "Chaos"
      Event = "ChaosChat11"
    }
    {
      Id = "Chaos_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cukup menggelitik bagiku mendapati diriku kembali terseret ke dalam urusan para dewa."
      Speaker = "Chaos"
      Event = "ChaosChat12"
    }
    {
      Id = "Chaos_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau boleh mencari ketenangan di tengah kegelapan dan keheningan di sini."
      Speaker = "Chaos"
      Event = "ChaosChat13"
    }
    {
      Id = "Chaos_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiada keputusan yang tidak mengubah jalan hidup, Keturunan Hades."
      Speaker = "Chaos"
      Event = "ChaosChat14"
    }
    {
      Id = "Chaos_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenyataan adalah apa yang kita bentuk, wahai Keturunan Hades; atau setidaknya, apa yang kubentuk."
      Speaker = "Chaos"
      Event = "ChaosChat15"
    }
    {
      Id = "Chaos_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi kemudahanmu, telah kupangkas kemungkinan tak terhingga menjadi tiga saja."
      Speaker = "Chaos"
      Event = "ChaosChat16"
    }
    {
      Id = "Chaos_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Takdir memiliki kehendak mereka sendiri, sebagaimana kita memiliki kehendak kita, benarkah begitu?"
      Speaker = "Chaos"
      Event = "ChaosChat17"
    }
    {
      Id = "Chaos_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kesepakatan kita masih menarik minatmu, Keturunan Hades?"
      Speaker = "Chaos"
      Event = "ChaosChat18"
    }
    {
      Id = "Chaos_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lakukan sesukamu dengan tanda dariku; mata-mataku akan terus mengawasi."
      Speaker = "Chaos"
      Event = "ChaosChat19"
    }
    {
      Id = "Chaos_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak kemungkinan berbeda untuk dijelajahi, tanpa urutan tertentu..."
      Speaker = "Chaos"
      Event = "ChaosChat20"
    }
    {
      Id = "Chaos_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kau percaya para Takdir yang merencanakan hasil ini, ataukah aku?"
      Speaker = "Chaos"
      Event = "ChaosChat21"
    }
    {
      Id = "Chaos_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui bahwa kehidupan telah menjadi perkara yang agak rumit..."
      Speaker = "Chaos"
      Event = "ChaosChat22"
    }
    {
      Id = "Chaos_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Izinkan aku membuat perjalananmu yang akan datang menjadi lebih menarik sejak awal."
      Speaker = "Chaos"
      Event = "ChaosChat23"
    }
    {
      Id = "Chaos_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin para Takdir sendiri telah menduga kita akan bertemu secepat ini."
      Speaker = "Chaos"
      Event = "ChaosChat24"
    }
    {
      Id = "Chaos_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada begitu banyak kemungkinan tanpa batas, namun aku hanya menawarkan tiga, masing-masing satu untuk tiap Takdir."
      Speaker = "Chaos"
      Event = "ChaosChat25"
    }
    {
      Id = "Chaos_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena kau telah datang kepadaku, aku akan menciptakan perubahan sementara di dalam dirimu."
      Speaker = "Chaos"
      Event = "ChaosChat26"
    }
    {
      Id = "Chaos_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan para Takdir yang menentukan bahwa kau akan kembali kepadaku; melainkan kau atau aku."
      Speaker = "Chaos"
      Event = "ChaosChat27"
    }
    {
      Id = "Chaos_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tindakanmu masih menjadi sumber hiburan bagiku, Keturunan Hades."
      Speaker = "Chaos"
      Event = "ChaosChat28"
    }
    {
      Id = "Chaos_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kunjunganmu yang kerap ke alam ini mengisyaratkan bahwa tandaku pada umumnya memberimu manfaat."
      Speaker = "Chaos"
      Event = "ChaosChat29"
    }
    {
      Id = "Chaos_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bila kau berdiam di sini terlalu lama, kau akan lebur ke dalam dimensi ini; jadi kusarankan kau bergegas pergi."
      Speaker = "Chaos"
      Event = "ChaosChat30"
    }
    {
      Id = "Chaos_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bantulah eksperimenku, dan petiklah keuntungannya."
      Speaker = "Chaos"
      Event = "ChaosChat31"
    }
    {
      Id = "Chaos_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu tampaknya menjadi biang keladi dari banyak masalah belakangan ini."
      Speaker = "Chaos"
      Event = "ChaosChat32"
    }
    {
      Id = "Chaos_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu melangkah terlalu jauh untuk menemukanku, Keturunan Hades."
      Speaker = "Chaos"
      Event = "ChaosChat33"
    }
    {
      Id = "Chaos_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita memiliki keabadian untuk menjalankan eksperimen kita."
      Speaker = "Chaos"
      Event = "ChaosChat34"
    }
    {
      Id = "Chaos_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tindakan penciptaan tidak selalu berlangsung murni tanpa cela."
      Speaker = "Chaos"
      Event = "ChaosChat35"
    }
    {
      Id = "Chaos_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh menarik bagaimana makhluk-makhluk terkecil kerap membuktikan diri mereka lebih unggul."
      Speaker = "Chaos"
      Event = "ChaosChat36"
    }
    {
      Id = "Chaos_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau cukup menghibur, Keturunan Hades, melampaui dugaan awalku."
      Speaker = "Chaos"
      Event = "ChaosChat37"
    }
    {
      Id = "Chaos_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang, Keturunan Hades, dalam jenis eksperimen yang paling kusukai."
      Speaker = "Chaos"
      Event = "ChaosChat38"
    }
    {
      Id = "Chaos_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menantikan bagaimana hasil dari upaya barumu ini."
      Speaker = "Chaos"
      Event = "ChaosChat39"
    }
    {
      Id = "Chaos_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian tanggung jawab atas segala yang telah terjadi berada di pundakku."
      Speaker = "Chaos"
      Event = "ChaosChat40"
    }
    {
      Id = "Chaos_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tanggapi hanya jika diminta, atau ketika benar-benar mutlak diperlukan."
      Speaker = "Chaos"
      Event = "ChaosChat41"
    }
    {
      Id = "MelinoeField_0768"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bila Anda mengizinkan, Chaos Yang Mahakuasa, aku ingin mempersembahkan Nektar ini, seturut tradisi keluargaku antarkerabat dan sahabat. Semua ini mustahil terwujud jika bukan karena Anda..."
      Speaker = "Melinoe"
      Event = "ChaosGift01"
    }
    {
      Id = "Chaos_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu kukabulkan keinginanmu itu, beserta kebebasan untuk memberiku hadiah lebih lanjut sesukamu. Sebab aku tidak asing dengan tradisimu ini, dan aku bersedia membalasnya."
      Speaker = "Chaos"
      Event = "ChaosGift01"
    }
    {
      Id = "MelinoeField_0770"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chaos Yang Mahakuasa, aku ingin memanfaatkan kebebasanku itu dengan memberikan ini kepada Anda. Kendati kurasa Anda sendiri pasti mampu menciptakannya..."
      Speaker = "Melinoe"
      Event = "ChaosGift02"
    }
    {
      Id = "Chaos_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar yang kaupersembahkan ini adalah zat yang cukup menarik. Ketika kuciptakan jalinan kenyataan, aku tahu bagaimana ia bisa dipergunakan; namun aku tidak serta-merta mengantisipasi segala kemungkinan hasilnya, termasuk yang satu ini."
      Speaker = "Chaos"
      Event = "ChaosGift02"
    }
    {
      Id = "MelinoeField_0771"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham kemanisan semacam Nektar ini tak boleh dianggap remeh, Chaos Yang Mahakuasa. Terimalah, ini untuk Anda! Ciptaan seindah ini hanya bisa terwujud berkat Anda."
      Speaker = "Melinoe"
      Event = "ChaosGift03"
    }
    {
      Id = "Chaos_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gerak-gerik semacam itu tak diperlukan dalam kesepakatan di antara kita. Bila ini sekadar permohonan, langsung saja katakan maksudmu. Kendati untuk saat ini aku tak merasakan adanya motif tersembunyi..."
      Speaker = "Chaos"
      Event = "ChaosGift03"
    }
    {
      Id = "MelinoeField_0772"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anda tentu bisa merasakan motifku memberikan ini. Terkadang kita hanya terdorong oleh naluri untuk menyampaikan kekaguman. Mengetahui betapa pentingnya kehendak pribadi bagi Anda, tentu Anda memahaminya."
      Speaker = "Melinoe"
      Event = "ChaosGift04"
    }
    {
      Id = "Chaos_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa Olympus sering menuntut upeti dari para pemujanya, bukan? Mungkin itu tradisi mereka, tapi bukan tradisiku. Aku hanya meminta agar kau menghormati kesepakatan kita untuk selamanya. Namun aku pun tak akan menolak persembahanmu."
      Speaker = "Chaos"
      Event = "ChaosGift04"
    }
    {
      Id = "MelinoeField_1774"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh melegakan mengetahui bahwa Asal Mula Segala Keberadaan ternyata juga memendam rasa ingin tahu tanpa batas. Bersulang untuk selalu menemukan keajaiban bahkan dalam hal paling sederhana!"
      Speaker = "Melinoe"
      Event = "ChaosGift05"
    }
    {
      Id = "Chaos_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zat-zat seperti Nektar ini... tidakkah menarik bagaimana mereka bisa diciptakan, namun tak bisa ditiadakan? Segala hal, pada hakikatnya, adalah dirinya sendiri. Oleh karena itu persembahanmu bagiku sungguh unik dengan caranya sendiri. Dan Aku berterima kasih untuk itu."
      Speaker = "Chaos"
      Event = "ChaosGift05"
    }
    {
      Id = "MelinoeField_1775"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh perjalanan yang ganjil bagi ciptaan-Mu, Chaos Yang Mahakuasa! Botol khusus ini, misalnya... tercipta setelah kurun waktu tak terhitung, hanya untuk menemukan jalannya kembali pada-{#Emph}Mu. {#Prev}Entah takdir atau bukan."
      Speaker = "Melinoe"
      Event = "ChaosGift06"
    }
    {
      Id = "Chaos_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih menyimpan sebagian Nektar yang dulu pernah diberikan saudaramu, saat ia sedang menghadapi dilema tertentu miliknya. Kurasa Aku akan menyimpan persembahan ini berdekatan dengannya. Kau mengikuti jejak langkahnya, namun tampaknya memilih jalanmu sendiri."
      Speaker = "Chaos"
      Event = "ChaosGift06"
    }
    {
      Id = "MelinoeField_3642"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chaos Yang Mahakuasa, terimalah hidangan terbaik yang paling tersohor dari keluargaku. Aku tahu ini sama sekali tak bernilai bagi-Mu; namun bagi kami, ini adalah lambang dari ikatan yang kami jalin bersama."
      Speaker = "Melinoe"
      Event = "ChaosGift07"
    }
    {
      Id = "Chaos_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak terkesan oleh Ambrosia yang kau tawarkan ini, namun mengerti bahwa zat ini dianggap berharga dan relatif langka. Aku bertanya-tanya mengapa kau memberikannya sekarang, dan ingin tahu; maka, jawablah."
      Speaker = "Chaos"
      Event = "ChaosGift07"
    }
    {
      Id = "MelinoeField_3643"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya Engkau menyukai kejujuran yang apa adanya, Chaos Yang Mahakuasa, dan kejujurannya adalah bahwa aku sangat mengagumi-Mu. Perhatian dan bantuan-Mu teramat berarti lebih dari yang bisa kuungkapkan. Keluargaku memberi Ambrosia saat kata-kata semata tak lagi mencukupi."
      Speaker = "Melinoe"
      Event = "ChaosGift07"
    }
    {
      Id = "Chaos_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata-katamu yang serba kurang itu justru memberi dampak lebih besar daripada hadiahmu; kendati demikian Aku akan menerima semuanya. Kau sungguh menghibur, Keturunan Hades, lebih dari perkiraan awal-Ku."
      Speaker = "Chaos"
      Event = "ChaosGift07"
    }
    {
      Id = "MelinoeField_3644"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ehm... {#Prev}bersulang?"
      Speaker = "Melinoe"
      Event = "ChaosGift07"
    }
    {
      Id = "MelinoeField_0769"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa pun ini... sungguh luar biasa, benar-benar mengagumkan."
      Speaker = "Melinoe"
      Event = "TrialUpgrade.GiftGivenVoiceLines"
    }
    {
      Id = "Chaos_0252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setelah Ujian sesederhana itu, tentu kau bersedia mencoba yang lain?"
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku telah mengamati semua yang Ku-inginkan untuk saat ini."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0122"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sisi realitas yang ini kini tampak lebih jelas bagi-Ku."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maka kau telah membuktikan bahwa kemungkinan ini memang ada."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua ini sebelumnya hanyalah sebatas kemungkinan."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berterima kasih, meski sekian saja untuk saat ini."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Eksperimen khusus ini membuahkan keberhasilan."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebuah kilasan pikiran, berubah menjadi kemungkinan nyata."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Batas-batas dari apa yang memungkinkan terus meluas."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini adalah sebuah peluang yang kuyakini sangat berharga untuk diambil."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku cukup terhibur oleh usahamu."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ujian ini selesai; Aku perintahkan kau kembali ke tempat asalmu."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku telah mengamati hasil dari Ujian ini dengan minat yang mendalam."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak boleh melangkah lebih jauh; itu semua bagian dari Ujian."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku puas dengan hasil Ujian ini, dan Aku perintahkan kau kembali."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau telah menuntaskan apa yang dituntut Ujian ini darimu."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tidak serta-merta mengira kau akan berhasil melewati Ujian ini."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu Ujian lagi berhasil diselesaikan, Keturunan Hades."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau lulus; namun sekarang kembalilah ke dalam bayangan, Keturunan Hades."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga Debu Bintang milik-Ku menjadi imbalan yang pantas atas baktimu."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Meski kau gagal dalam upaya ini, Aku merasa terhibur."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku memahami bahwa realitas bisa menjadi sangat berat untuk dipikul."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak setiap kemungkinan akan terwujud."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hasil ini hanyalah satu dari sekian banyak kemungkinan."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tidak sempat mengamati sebanyak yang Ku-inginkan."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hasil yang belum meyakinkan dalam eksperimen kita."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hasil yang sudah terduga tetap saja bisa mengecewakan."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku yakin kemungkinan bagimu untuk berhasil itu ada."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kegagalan semacam ini memang kemungkinan yang sangat besar terjadi."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0140"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Variasi kecil dalam tindakanmu yang berujung pada hal ini."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0153"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampaknya tandaku membawa dampak yang tak diinginkan."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0154"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini semua bagian dari eksperimen kita."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupikir ini bukanlah hasil yang kau inginkan."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maka tandaku pun terhapus, untuk saat ini."
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0157"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kehidupan selalu berpotensi melakukan kebodohan, bukan begitu?"
      Speaker = "Chaos"
      Event = "TrialUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Chaos_0059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarilah, Keturunan Hades..."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.ChaosSecretUnlockedVoiceLines"
    }
    {
      Id = "Chaos_0064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau kupanggil..."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.ChaosSecretUnlockedVoiceLines"
    }
    {
      Id = "Chaos_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masuklah ke dalam jurang tanpa dasar..."
      Speaker = "Chaos"
      Event = "GlobalVoiceLines.ChaosSecretUnlockedVoiceLines"
    }
    {
      Id = "Chaos_0060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jalan menuju diriku telah terbuka..."
