      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Belum... selesai!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0264"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah... {#Prev}tidak."
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0265"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Belum... saatnya...!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku tetap di sini saja, terima kasih...!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Boleh juga...!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke, itu tadi sakit..."
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Nggak asik, Adikku."
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Nggak bakal!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Hentikan itu!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0273"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sudahi itu!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Belum... mati...!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0274"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}Augh{#Prev}, sial..."
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0275"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Gawat..."
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0276"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}Augh{#Prev}, tamatlah sudah..."
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0277"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}Rngh{#Prev}, kesempatan terakhir..."
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0278"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}Ngh{#Prev}, belum... selesai..."
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0279"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Masih... bisa... bertarung!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0280"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Jangan... harap... ya!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kita... belum... selesai!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0282"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Darah dan... {#Emph}augh...!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0283"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Ja... jangan... menyerah...!"
      Speaker = "Zagreus"
      Event = "Zagreus.PhaseEndedVoiceLines"
    }
    {
      Id = "Zagreus_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu cuma... keberuntungan... pemula..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0341"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku... cabut... dulu..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0342"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau... lumayan... juga..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0343"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lain kali... tanding... lagi, ya..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0344"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai... jumpa... lagi..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0345"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita... tenggelam... lagi..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0346"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku... tenggelam... lagi..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0347"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak usah... menungguku..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0349"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hebat... juga... Dik..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0350"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak bisa... berlama-lama... di sini..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0351"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau... berhasil... mengalahkanku..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0413"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang ketinggalan... di rumah..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0415"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pemberhentian berikutnya... Tartarus..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0416"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, pelan-pelan sama jubahku..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0417"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Risiko... pekerjaan..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "Zagreus_0414"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tangan-tangan jahil ini... lagi..."
      Speaker = "Zagreus"
      Event = "Zagreus.DefeatedVoiceLines"
    }
    {
      Id = "MelinoeField_4242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertarungan yang hebat, Kakak."
      Speaker = "Melinoe"
      Event = "Zagreus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_4243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa ini artinya akulah sang Juara...?"
      Speaker = "Melinoe"
      Event = "Zagreus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_4992"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukalahkan kau, Kak..."
      Speaker = "Melinoe"
      Event = "Zagreus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5604"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan di dalam mimpiku pun kita masih suka berdebat..."
      Speaker = "Melinoe"
      Event = "Zagreus.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5603"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku memenangkan duel mimpi ini, Kak..."
      Speaker = "Melinoe"
      Event = "Zagreus.BossKillVoiceLines"
    }
    {
      Id = "Zagreus_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, canggung juga, ya. Melinoë, ngapain kau di sini? Aku tadi lagi menikmati sorak-sorai penonton. Mereka nggak pernah bosan melihat sang Juara Elysium tumbang."
      Speaker = "Zagreus"
      Event = "ZagreusBossFirstMeeting"
    }
    {
      Id = "MelinoeField_4237"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Emm{#Prev}, halo Zagreus! Wah, ini Elysium, tapi aku juga tidak tahu kenapa bisa di sini. Terakhir kuingat, aku mengambil semacam perkamen membara dari tokonya Charon..."
      Speaker = "Melinoe"
      Event = "ZagreusBossFirstMeeting"
    }
    {
      Id = "Zagreus_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya para dewa... kau beneran menerima Kontrak Neraka. Sudah baca semua syarat dan ketentuannya, dan masih merasa itu ide bagus?"
      Speaker = "Zagreus"
      Event = "ZagreusBossFirstMeeting"
    }
    {
      Id = "MelinoeField_4238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... tidak bisa dibilang membaca semua cetakan kecilnya, maksudku, tulisannya banyak sekali, dan... bisakah kau merangkum apa saja yang kusetujui?"
      Speaker = "Melinoe"
      Event = "ZagreusBossFirstMeeting"
    }
    {
      Id = "Zagreus_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertama, jalan-jalan gratis ke Elysium...! Dan kedua, laga ekshibisi melawan Juaranya yang sekarang. Walau dalam hal ini ekshibisi berarti duel maut, sih. Sudah siap?"
      Speaker = "Zagreus"
      Event = "ZagreusBossFirstMeeting"
    }
    {
      Id = "Zagreus_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo kita beri para Arwah ini tontonan seru!"
      Speaker = "Zagreus"
      Event = "ZagreusBossFirstMeeting"
    }
    {
      Id = "MelinoeField_4239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau kau memaksa!"
      Speaker = "Melinoe"
      Event = "ZagreusBossFirstMeeting"
    }
    {
      Id = "Zagreus_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sambutlah Tuan Putri Dunia Bawah, semuanya!"
      Speaker = "Zagreus"
      Event = "ZagreusBossFirstMeeting"
    }
    {
      Id = "Zagreus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seingatku, kemarin aku menang telak atasmu, Dik. Jadi agak kaget juga kau masih berani menampakkan diri lagi di arena seketat ini."
      Speaker = "Zagreus"
      Event = "ZagreusBossLostAgainstHim01"
    }
    {
      Id = "MelinoeField_4612"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah terbiasa dengan sedikit kegagalan sesekali. Bagaimana denganmu? Kau terjebak dalam Sang Waktu. Itu pasti berdampak buruk bagi ketajaman fisik dan mentalmu."
      Speaker = "Melinoe"
      Event = "ZagreusBossLostAgainstHim01"
    }
    {
      Id = "Zagreus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entahlah, rasanya aku masih sehebat dulu! Tapi bagaimana kalau {#Emph}kau sendiri {#Prev}yang menilai {#Emph}ketajaman fisik dan mentalku {#Prev}sebentar lagi?"
      Speaker = "Zagreus"
      Event = "ZagreusBossLostAgainstHim01"
    }
    {
      Id = "MelinoeField_4613"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selincah dan sekuat yang kudengar, walau jauh lebih cerewet. Kau tidak menganggap ini serius, ya?"
      Speaker = "Melinoe"
      Event = "ZagreusBossLostAgainstHim02"
    }
    {
      Id = "Zagreus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tega sekali kau, Dik! Tapi mungkin sifatmu yang terlalu serius itu yang justru menahan potensimu, pernah terpikir soal itu?"
      Speaker = "Zagreus"
      Event = "ZagreusBossLostAgainstHim02"
    }
    {
      Id = "Zagreus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernah ada satu titik dalam karierku sebagai Spesialis Keamanan di mana kemenanganku sampai tak terhitung banyaknya! Jadi... terima kasih untuk yang kemarin, sudah mengingatkanku rasanya kalah!"
      Speaker = "Zagreus"
      Event = "ZagreusBossWonAgainstHim01"
    }
    {
      Id = "MelinoeField_4614"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama-sama. Dan kekalahanku sendiri belakangan ini juga makin berkurang. Meski aku tak tahu bagaimana nasib kita kelak... apakah memang harus selalu ada yang kalah di sini?"
      Speaker = "Melinoe"
      Event = "ZagreusBossWonAgainstHim01"
    }
    {
      Id = "Zagreus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Arwah takkan pernah mentoleransi hasil yang lain. Baiklah, mari kita jadikan ini duel menang-kalah yang tak terlupakan!"
      Speaker = "Zagreus"
      Event = "ZagreusBossWonAgainstHim01"
    }
    {
      Id = "MelinoeField_4615"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu itu kau kalah lagi dariku, Kakak! Merasa bisa membalasku kali ini, atau gelar Jawara Elysium harus diserahkan kepadaku?"
      Speaker = "Melinoe"
      Event = "ZagreusBossWonAgainstHim02"
    }
    {
      Id = "Zagreus_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku bisa membalasmu, dan gelar itu {#Emph}tidak {#Prev}bisa dipindahtangankan, enak saja. Kau tak tahu betapa repotnya merebut gelar itu dari si orang angkuh sebelumku!"
      Speaker = "Zagreus"
      Event = "ZagreusBossWonAgainstHim02"
    }
    {
      Id = "MelinoeField_4539"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau kembali menjadi Spesialis Keamanan! Pasti lebih gampang kabur dari Dunia Bawah saat gerbangnya masih terbuka lebar."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutSecurity01"
    }
    {
      Id = "Zagreus_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenyataannya, memang iya! Terutama di bagian akhir saat aku dulu harus melewati Cerberus dan hal-hal yang lebih buruk. Untuk sekarang, ini lebih ke patroli daripada kabur."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSecurity01"
    }
    {
      Id = "MelinoeField_4540"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyebut ini {#Emph}patroli? {#Prev}Kita bertarung hampir sampai mati, semua cuma demi hiburan para Arwah yang haus darah ini."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutSecurity01"
    }
    {
      Id = "Zagreus_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tenang, Adikku sayang, para Arwah di Elysium adalah penduduk kita yang paling berharga dan berpengaruh! Jika menumpahkan sedikit darah bisa memuaskan mereka, rasanya itu pengorbanan yang sepadan."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSecurity01"
    }
    {
      Id = "Zagreus_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, di mana persisnya {#Emph}letak {#Prev}Persimpangan Jalan tempat asalmu itu? Rasanya, sebagai Spesialis Keamanan, aku sudah berhak tahu sejak dulu."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutCrossroads01"
    }
    {
      Id = "MelinoeField_4603"
      InheritFrom = "BaseNarrative"
      DisplayName = "Persimpangan Jalan berada di Erebus, tapi sekadar tahu hal itu takkan membantumu menemukannya. Ibu dan Ayah belum memberitahumu?"
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutCrossroads01"
    }
    {
      Id = "Zagreus_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum. Mereka mungkin khawatir kalau aku ke sana, aku bakal betah dan tak mau pulang, melihat {#Emph}kau {#Prev}sangat menyukainya. Atau, mereka cuma berusaha merahasiakannya. Ya sudahlah! Kita kan bisa saling bertemu di {#Emph}sini."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutCrossroads01"
    }
    {
      Id = "Zagreus_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih belum terbiasa dengan beratnya Gigaros... Dulu aku punya begitu banyak pilihan Senjata, tahu! Tapi sekarang sepertinya semuanya sudah dijarah."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutGigaros01"
    }
    {
      Id = "MelinoeField_4604"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya aku cukup akrab dengan beberapa pemegang barunya. Pedang Dunia Bawah ada di tangan terampil Nemesis, sedangkan Bedil Adamant ada di... tangan Eris."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutGigaros01"
    }
    {
      Id = "Zagreus_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Padahal aku kangen senjata-senjata itu! Tapi aku sempat memakai Aspek mereka cukup lama, jadi mungkin memang sudah semestinya begini. Kuharap mereka dirawat dengan baik, jauh lebih baik daripada tombak tua {#Emph}ini."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutGigaros01"
    }
    {
      Id = "MelinoeField_4605"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong bagaimana kau bisa mendapatkan Gigaros? Kau belum pernah cerita. Ayah benar-benar memberikannya begitu saja sebagai hadiah?"
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutGigaros02"
    }
    {
      Id = "Zagreus_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku membujuknya seperti saranmu! {#Emph}Ayah, jika aku harus disegani dalam peranku sebagai Spesialis Keamanan, aku harus mengemban otoritas Wangsa Hades! {#Prev}Lagipula, ada banyak kenangan buruk yang melekat pada benda ini baginya."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutGigaros02"
    }
    {
      Id = "MelinoeField_4606"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari pertarungan melawan{#Emph}mu...? {#Prev}Saat aku tumbuh besar, Kepala Penyihir Hecate menceritakan segalanya tentang caramu bertarung melawannya."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutGigaros02"
    }
    {
      Id = "Zagreus_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beliau memang orang yang sangat berhati-hati, pasti pernah melayani Ibu secara rahasia di masa lalu. Kalau beliau yang mengajarimu semua sihir dan tetek bengek itu, pengetahuannya pasti {#Emph}luar biasa!"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutGigaros02"
    }
    {
      Id = "Zagreus_0486"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku kenal putra Nyx sekaligus jelmaan Kematian pemilik sabit yang tampak seram itu. Kau juga kenal, kurang lebih! Bagaimana kalau kuserahkan saja sabit itu padanya, daripada aku dicincang?"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutThanatosAspect01"
    }
    {
      Id = "MelinoeField_5175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas tawarannya yang murah hati, tapi aku membutuhkannya sekarang. Lagipula, Nyx tahu di mana mencariku jika putranya menginginkannya kembali. Ngomong-ngomong, bagaimana kabarmu dan Thanatos belakangan ini?"
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutThanatosAspect01"
    }
    {
      Id = "Zagreus_0487"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kami baik-baik saja. Jauh lebih baik sekarang setelah kami tidak membeku dalam waktu lagi, begitu juga Megaera. Mereka merindukanmu! Meg titip salam, sedangkan Than bilang {#Emph}sampaikan pada sang Putri bahwa ia berutang budi padanya."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutThanatosAspect01"
    }
    {
      Id = "MelinoeField_4547"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Katakan padanya aku sangat berterima kasih atas sabit ini!"
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutThanatosAspect01"
    }
    {
      Id = "Zagreus_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau bisa begitu saja... pergi ke permukaan, lalu mendaki sampai ke Olympus tanpa mati? Aku dulu tak pernah bisa melangkah sejauh itu."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSurfacePenalty01"
    }
    {
      Id = "MelinoeField_4607"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini berkat mantra rumit bernama {#Emph}Pelepas Ikatan Takdir{#Prev}. Tanpa itu, aku juga takkan bisa melangkah jauh. Kau pasti sangat ingin melihat Olympus dengan mata kepalamu sendiri... Aku penasaran apakah..."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutSurfacePenalty01"
    }
    {
      Id = "Zagreus_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, tak perlu menentang Takdir demi diriku, Adikku! Aku lebih suka membiarkannya seperti ini. Mungkin begitu Dunia Bawah beroperasi kembali, keinginanku untuk melihat gunung itu dengan segala keagungannya akan muncul, tapi... untuk sekarang, kemegahan Elysium sudah lebih dari cukup!"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSurfacePenalty01"
    }
    {
      Id = "Zagreus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kenal kilauan itu... kau membawa Kartu Panggilanku! Jadi, apakah Olympus masih royal membagikan Berkah dan semacamnya sekarang setelah situasinya agak mereda?"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutKeepsake01"
    }
    {
      Id = "MelinoeField_4608"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kurasa para kerabat kita sangat berhasrat memastikan semuanya tetap seperti ini. Rasanya agak aneh mengingat keadaannya masih cukup kacau... meski mungkin tak separah sebelumnya."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutKeepsake01"
    }
    {
      Id = "Zagreus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melihat hal-hal tetap seperti yang kita kenal untuk sementara waktu terdengar seperti perubahan yang menyenangkan, kalau dipikir-pikir. Hei, duel brutal ini bisa jadi bagian dari rutinitas {#Emph}kita!"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutKeepsake01"
    }
    {
      Id = "Zagreus_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang terjadi padamu, salah satu mantramu jadi senjata makan tuan atau bagaimana? Terakhir kali kuingat tubuhmu sekecil ini, mungkin itu cuma bunga tidurku saja."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutCirce01"
    }
    {
      Id = "MelinoeField_4990"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini ulah Penyihir Circe, dan asal kau tahu, ini memang disengaja! Kau takkan bisa mengejekku lagi setelah melihat betapa lincahnya diriku."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutCirce01"
    }
    {
      Id = "Zagreus_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari awal aku tak berniat mengejekmu kok, meski kurasa para Arwah di sekitar sini pasti senang mendengar sedikit adu mulut sebelum acara utamanya. Majulah, wahai {#Emph}Adik Kecil!"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutCirce01"
    }
    {
      Id = "Zagreus_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Adikku, kau... {#Emph}um... {#Prev}begini, kau membuatku merasa agak minder dengan tinggi badanku. Bagaimana caramu bisa setinggi itu, atau yang lebih penting, bagaimana caraku bisa begitu juga?"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutCirce02"
    }
    {
      Id = "MelinoeField_4989"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kau harus mengunjungi Penyihir Circe di pulau terpencilnya, jadi mungkin perjalanannya agak jauh. Tapi efeknya hanya sementara, kok."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutCirce02"
    }
    {
      Id = "Zagreus_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan suaramu pun ikut berubah! Yah, setidaknya lega rasanya tahu bahwa rasa maluku ini cuma bersifat sementara. Mari kita lihat kehebatanmu, {#Emph}Adik Kecil."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutCirce02"
    }
    {
      Id = "MelinoeField_5173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana pemulihan para Pelayan Rumah, apa semua sudah bangkit kembali sekarang? Aku punya kenangan indah bersama mereka... sekilas bayangan di sepanjang masa kecil dan pertumbuhanku."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutHouse01"
    }
    {
      Id = "Zagreus_0483"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka juga membicarakan hal-hal manis serupa, tiap kali mereka tidak sedang bingung dengan apa yang terjadi. Tapi ya, semua sudah bangkit berdiri, terima kasih... kecuali Dusa yang memang tidak punya kaki."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutHouse01"
    }
    {
      Id = "MelinoeField_5174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang mendengarnya, selain bagian kebingungan itu. Kau secara resmi tidak seharusnya membicarakan apa yang terjadi, bukan? Tapi tolong sampaikan salamku pada Dusa dan yang lainnya."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutHouse01"
    }
    {
      Id = "Zagreus_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beres. Dan resmi atau tidak, reputasimu sekarang mulai mengerikan, lho! Musisi istana penyebar rumor kita, Orpheus, sangat menikmati kisah tentang Melinoë yang kelam. Sepertinya kau akan memamerkan kehebatan daimonikmu di sini!"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutHouse01"
    }
    {
      Id = "MelinoeField_4548"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar Ibu dan Ayah, serta Nyx? Semua ini pasti penyesuaian yang cukup berat bagi mereka."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutParents01"
    }
    {
      Id = "Zagreus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, mereka baik-baik saja. Dari yang kudengar, kau sendiri juga cukup sering bertemu Ibu dan Ayah. Mereka mengawasi keadaan di Tartarus, kemungkinan sebagian tujuannya untuk melihat {#Emph}dirimu."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutParents01"
    }
    {
      Id = "MelinoeField_4549"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atau sekadar ingin berduaan saja, kurasa. Sementara tugasmu saat ini ada di Elysium, menghibur semua Arwah ini?"
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutParents01"
    }
    {
      Id = "Zagreus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih suka menganggapnya {#Emph}menginspirasi {#Prev}alih-alih {#Emph}menghibur{#Prev}, tapi kalau kau harus bertanya setegas itu, maka... ya. Menjaga Arwah Underworld tetap bahagia adalah prioritas tertinggi kita! Selain mencegah mereka kabur, tentu saja."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutParents01"
    }
    {
      Id = "Zagreus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, bagaimana suasana di Crossroads? Kau punya teman, teman-tapi-mesra, atau semacamnya? Cerita dong."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutRelationships01"
    }
    {
      Id = "MelinoeField_4611"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kurasa begitu, ya. Ada yang begitu, ada yang begini. Di sana damai. Dan aku bisa melihat Bulan serta bintang-bintang di balik naungan pepohonan... bahkan hujan turun sesekali."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutRelationships01"
    }
    {
      Id = "Zagreus_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm{#Prev}, kehujanan. Mungkin suatu saat nanti aku bisa menantang cuaca buruk itu dan berkunjung, bertemu teman-temanmu atau teman-tapi-mesramu itu. Waktu kita abadi! Kecuali kalau kita berhasil saling bunuh di sini duluan."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutRelationships01"
    }
    {
      Id = "Zagreus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hypnos baru-baru ini kembali ke kita! Kau tak tahu betapa bersyukurnya dia bisa kembali. Praktis melompat langsung ke dekapanku, meski mungkin itu gara-gara ketakutan luar biasa."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutHypnosWakeUp01"
    }
    {
      Id = "MelinoeField_4544"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak yakin apa dia sadar bahwa Kediaman Hades sempat lumpuh hampir sepanjang waktu tidurnya. Dia pergi sebelum aku sempat menjelaskan. Apa kau tahu kalau dia mengingat masa lalu lain yang kita lihat...?"
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutHypnosWakeUp01"
    }
    {
      Id = "Zagreus_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa begitu? Pikirannya masih agak kacau dari semua kejadian... mungkin sedikit tegang karena bangun kesiangan. Dia masih suka saat aku kembali ke Kediaman dalam kekalahan, menghitung semua kematianku. Jadi kalau kau mau membantunya sekali lagi, ini kesempatanmu!"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutHypnosWakeUp01"
    }
    {
      Id = "MelinoeField_5292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia memang pergi agak terburu-buru, ya. Aku jarang bertemu orang yang begitu berdedikasi pada pekerjaannya. Apa dia bisa mengatasinya dengan baik setelah kembali?"
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutHypnosWakeUp01_B"
    }
    {
      Id = "Zagreus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukankah kau sempat bilang kalau Schelemeus tertentu tinggal bersamamu, di mana pun perkemahan penyihir rahasiamu itu berada? Bagaimana kabarnya?"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSkelly01"
    }
    {
      Id = "MelinoeField_4545"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia seteguh biasanya, mengajari Arwah-arwah setia tata cara kami. Dia juga bertindak sebagai rekan latihan. Walau, kusadari aku tidak seharusnya membicarakan tentangnya..."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutSkelly01"
    }
    {
      Id = "Zagreus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Uh-huh. {#Prev}Dia pasti cuma berdiri memanjakan hasrat menyimpangnya untuk dibantai berbagai senjata sakti. Yang... kini kusadari mulai menular ke {#Emph}diriku..."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSkelly01"
    }
    {
      Id = "Storyteller_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Putri Orang Mati kembali berhadapan dengan kakaknya yang keras kepala, Zagreus, yang telah melupakan sebagian kemampuan tempur terbaiknya saat terperangkap dalam cengkeraman sang Titan Waktu."
      Speaker = "Storyteller"
      Event = "ZagreusBossAboutHomer01"
    }
    {
      Id = "Zagreus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, ini {#Emph}kau{#Prev}, orang tua! Aku sempat bertanya-tanya kau berakhir di mana. Meninggalkanku demi adik tersayangku, begitu?"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutHomer01"
    }
    {
      Id = "MelinoeField_4550"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, {#Emph}apa? {#Prev}Homer selalu bersamaku selama ini. Dari mana kalian saling kenal? Apa yang kulewatkan...?"
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutHomer01"
    }
    {
      Id = "Zagreus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bahkan tak tahu harus mulai menjawab dari mana sekarang. {#Emph}Homer{#Prev}, katamu? Seharusnya sudah kutebak namanya bakal sekonyol itu. Baiklah, ayo kita beri dia kisah {#Emph}lain {#Prev}untuk diceritakan!"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutHomer01"
    }
    {
      Id = "Zagreus_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Peringatan adil, Adikku, aku merasa sangat lincah sekarang. Kau pasti melakukan sesuatu pada Cermin Malam. Benda itu selalu membuatku merasa lebih tangguh, tapi yang {#Emph}ini {#Prev}luar biasa beda."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutShrine01"
    }
    {
      Id = "MelinoeField_4991"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan dari Cermin itu, kurasa, tapi bisa kupastikan ini berhubungan dengan Malam. Kau lawan yang menakutkan, Zagreus... dipenuhi kekuatan gelap dari Nyx sendiri."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutShrine01"
    }
    {
      Id = "Zagreus_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau melakukan ini {#Emph}entah bagaimana caranya. {#Prev}Ya sudahlah! Suatu hari atau malam nanti aku harus menyalakan Pakta Hukuman lama Ayah, dan membuat {#Emph}kau {#Prev}sangat kuat, lalu kita lihat bagaimana rasanya bagi {#Emph}dirimu!"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutShrine01"
    }
    {
      Id = "MelinoeField_4617"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada satu Arwah yang kutemukan di Mourning Fields yang kurasa sebelumnya tinggal di Elysium. Kedengarannya kalian berdua mungkin pernah bertemu."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutSupportiveShade01"
    }
    {
      Id = "Zagreus_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sangat mungkin, aku sudah bertemu banyak Arwah, baik dari Elysium maupun bukan. Bisa lebih spesifik? Nama, watak, pakaian?"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSupportiveShade01"
    }
    {
      Id = "MelinoeField_4618"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nama, tak diketahui; watak, cukup suportif; pakaian, serbamerah. Dari yang kutangkap, Arwah ini sering menonton banyak pertarunganmu di sini."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutSupportiveShade01"
    }
    {
      Id = "Zagreus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, kurasa aku tahu siapa yang kau maksud! Kau sedang membicarakan penggemar beratku. Sampaikan salamku padanya, ya?"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSupportiveShade01"
    }
    {
      Id = "MelinoeField_4619"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja, tapi sebelumnya...!"
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutSupportiveShade01"
    }
    {
      Id = "Zagreus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penggemar beratku ada di antara penonton lagi! Terima kasih sudah bilang kalau aku kembali melakukan yang terbaik... mempertahankan gelar Juara Elysium demi tontonan semata."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSupportiveShade02"
    }
    {
      Id = "MelinoeField_4620"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang membuatmu berpikir satu Arwah itu adalah penggemar beratmu? Bisa jadi itu aku dan aku cuma tidak menunjukkannya."
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutSupportiveShade02"
    }
    {
      Id = "Zagreus_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, mana mungkin penggemar beratku mencoba membantaiku di depan kerumunan penonton ini? Hanya daimon mengerikan yang lahir dari mimpi buruk yang sanggup melakukan hal sekejam itu!"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSupportiveShade02"
    }
    {
      Id = "MelinoeField_4541"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akankah aku melihatmu lagi di luar batas-batas arena pertarungan yang ramai ini? Kita seharusnya berbagi Ambrosia, bukan saling mencoba bunuh demi tontonan olahraga."
      Speaker = "Melinoe"
      Event = "ZagreusBossGrantsBondForged01"
    }
    {
      Id = "Zagreus_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang tahu selain para Moirai, dan dari kabar yang kudengar baru-baru ini, mungkin mereka pun tidak tahu! Soal Ambrosia, kau sudah dapat Kenang-kenangan dariku, jadi tak perlu repot-repot!"
      Speaker = "Zagreus"
      Event = "ZagreusBossGrantsBondForged01"
    }
    {
      Id = "MelinoeField_4542"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa? {#Prev}Nektar dan Ambrosia bukan cuma buat barter! Dari semua orang, kau mestinya paling paham pentingnya menjalin ikatan erat dengan kerabat, kawan, dan orang-orang tercinta."
      Speaker = "Melinoe"
      Event = "ZagreusBossGrantsBondForged01"
    }
    {
      Id = "Zagreus_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, tapi... kita kan sudah melalui banyak hal bersama sampai saat ini! Dan aku sudah mengenalmu bahkan sebelum kau lahir. Tapi kalau mau diresmikan, boleh saja!"
      Speaker = "Zagreus"
      Event = "ZagreusBossGrantsBondForged01"
    }
    {
      Id = "MelinoeField_4543"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baguslah kalau begitu! Sekarang, bertarung sampai mati?"
      Speaker = "Melinoe"
      Event = "ZagreusBossGrantsBondForged01"
    }
    {
      Id = "Zagreus_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai mati! Atau nyaris mati, terserahlah!"
      Speaker = "Zagreus"
      Event = "ZagreusBossGrantsBondForged01"
    }
    {
      Id = "Zagreus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, aku mulai khawatir para Arwah di sini mengira kita benar-benar akur, bukannya kau ini pembawa pembalasan dendam Dunia Bawah yang mengerikan seperti yang digembar-gemborkan."
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_4616"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau aku memelototimu seperti ini, lalu menuntut kepalamu, atau bahkan jiwamu...?"
      Speaker = "Melinoe"
      Event = "ZagreusBossAboutSayingLittle01"
    }
    {
      Id = "Zagreus_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh juga, dan kita selalu bisa bikin obrolan ramah ini tetap singkat dan padat. Sekarang hadapi aku, saudari jurig!"
      Speaker = "Zagreus"
      Event = "ZagreusBossAboutSayingLittle01"
    }
    {
      Id = "Zagreus_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Adik Kecil, ayo kita suguhkan tontonan tak terlupakan untuk para Arwah Elysium ini!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart01"
    }
    {
      Id = "Zagreus_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketahuilah, kalau kau {#Emph}sampai {#Prev}mengalahkanku, itu cuma karena aku sengaja mengalah, oke?"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart02"
    }
    {
      Id = "Zagreus_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku senang melihatmu, upaya kaburku kali ini tadinya {#Emph}berjalan lancar {#Prev}sebelum kau muncul..."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart03"
    }
    {
      Id = "Zagreus_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita memang mirip, tampaknya kau juga suka menerima Kontrak tanpa membacanya dulu."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart04"
    }
    {
      Id = "Zagreus_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sihirmu melawan tombakku. Tombak Ayah, maksudku. Ah, kau tahu sendirilah."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart05"
    }
    {
      Id = "Zagreus_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapan-kapan kita harus mengobrol santai tanpa kekerasan begini, tapi untuk sekarang?"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart06"
    }
    {
      Id = "Zagreus_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah bertarung menembus Elysium berkali-kali, pantang bagiku mundur sekarang."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart07"
    }
    {
      Id = "Zagreus_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalan kita bersilangan lagi, Saudari! Dan senjata kita pun sebentar lagi saling beradu."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart08"
    }
    {
      Id = "Zagreus_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setahuku kakak beradik memang sering ribut seperti ini."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart09"
    }
    {
      Id = "Zagreus_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan menahan diri melawanku sekarang. Para penonton bakal kecewa!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart10"
    }
    {
      Id = "Zagreus_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersyukurlah kau tidak bertarung melawan Sang Juara terdahulu."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart11"
    }
    {
      Id = "Zagreus_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana, para Arwah? Kelihatannya kita kedatangan laga ekshibisi istimewa!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart12"
    }
    {
      Id = "Zagreus_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa sih kau selalu muncul pas di momen kejayaanku?"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart13"
    }
    {
      Id = "Zagreus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei Melinoë, kelihatannya kau segar bugar! Yah walau mungkin tidak bakal lama, maaf ya..."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart14"
    }
    {
      Id = "Zagreus_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melawanmu jauh lebih parah daripada melawan Ayah! Jangan bilang-bilang dia kalau aku ngomong begini."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart15"
    }
    {
      Id = "Zagreus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo maju, Saudari, aku bisa begini seharian. Semalaman? Kapan pun lah!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart16"
    }
    {
      Id = "Zagreus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo tunjukkan padaku apa saja yang sudah diajarkan si Schelemeus terhormat itu padamu."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart17"
    }
    {
      Id = "Zagreus_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu jadi selingan yang menyenangkan dari rutinitasku, Saudari! Ya, hampir selalu."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart18"
    }
    {
      Id = "Zagreus_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan, Saudari! Apalagi kalau aku tidak kalah."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart19"
    }
    {
      Id = "Zagreus_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pantang bagiku mengecewakan para Arwah yang sudah menanti-nanti ini, Saudari!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart20"
    }
    {
      Id = "Zagreus_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, berkah Karunia-mu jauh lebih banyak daripada punyaku sekarang..."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart21"
    }
    {
      Id = "Zagreus_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, kutukan mengerikan apa lagi yang kau siapkan kali ini?"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart22"
    }
    {
      Id = "Zagreus_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tongkat itu memang jangkauannya jauh, tapi tombakku ini punya ujung runcing yang berbahaya."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart25"
    }
    {
      Id = "Zagreus_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh, {#Prev}aku suka sepasang bilahmu itu! Tapi sisakan anggota tubuhku utuh ya."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart26"
    }
    {
      Id = "Zagreus_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Obor-obor itu. {#Emph}Hah. {#Prev}Kau tahu kan kalau aku ini tahan api?"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart27"
    }
    {
      Id = "Zagreus_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal tahu saja, kau bukan orang pertama yang melintasi tempat ini membawa kapak raksasa."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart28"
    }
    {
      Id = "Zagreus_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku agak risih melihat tengkorakmu menatapku seperti itu sekarang."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart29"
    }
    {
      Id = "Zagreus_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau pakai benda {#Emph}itu {#Prev}lagi. Baiklah kalau begitu, tembak sesukamu."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart30"
    }
    {
      Id = "Zagreus_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Thanatos cepat atau lambat pasti bakal minta sabitnya kembali, lho!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart31"
    }
    {
      Id = "Zagreus_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang sekali kau berkunjung lagi, Melinoë! Sekarang, duel sampai mati!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart32"
    }
    {
      Id = "Zagreus_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurang lebih, memang persis seperti inilah bayanganku rasanya punya saudara kandung."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart33"
    }
    {
      Id = "Zagreus_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemari mau membalas kekalahanmu yang kemarin? Sayang sekali, aku cuma menerima bayaran Obol."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart34"
    }
    {
      Id = "Zagreus_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah tahu kok kau tak gampang menyerah, jadi tak perlu repot-repot membuktikannya padaku!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart35"
    }
    {
      Id = "Zagreus_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi begini rupanya perasaan Ayah saat memukul mundurku berulang kali dulu."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart36"
    }
    {
      Id = "Zagreus_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil mengalahkan kakek tua bangka kita, masa mengalahkanku saja tidak bisa?"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart37"
    }
    {
      Id = "Zagreus_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tubuh dan egoku sudah sangat terbiasa dengan kekalahan, jadi ayo, maju sini!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart38"
    }
    {
      Id = "Zagreus_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersyukurlah jurus bertarungku belakangan ini tidak sehebat dan sekeren dulu."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart39"
    }
    {
      Id = "Zagreus_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang sudah biasa kalah berulang kali, tapi kalau terus-terusan begini ya agak keterlaluan juga."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart40"
    }
    {
      Id = "Zagreus_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti bakal kubalas kekalahan ini suatu saat nanti. Mungkin sekarang juga!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart41"
    }
    {
      Id = "Zagreus_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terjebak di penjara temporal sekian lama sama sekali tidak membantu kemampuan bertarungku..."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscStart42"
    }
    {
      Id = "Zagreus_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Ugh! {#Prev}Kau benar-benar tidak menahan diri barusan. Sialan..."
      Speaker = "Zagreus"
      Event = "ZagreusBossOutro01"
    }
    {
      Id = "MelinoeField_4241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zagreus, kau tidak apa-apa? Aku tidak yakin tadi itu cuma sekadar sandiwara atau sungguhan."
      Speaker = "Melinoe"
      Event = "ZagreusBossOutro01"
    }
    {
      Id = "Zagreus_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kutebak kau memutuskan untuk bertarung {#Emph}sungguhan{#Prev}. Pokoknya, kalau ada yang tanya, aku cuma mengalah pada adik perempuanku! Nah, kalau kau tak keberatan, aku mau pamit dulu, sepertinya aku, {#Emph}ehem{#Prev}, kehilangan cukup banyak darah..."
      Speaker = "Zagreus"
      Event = "ZagreusBossOutro01"
    }
    {
      Id = "Zagreus_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aaargh... {#Prev}selamat, Melinoë, karena aku resmi menilaimu {#Emph}Kuat Bukan Main{#Prev}. Jauh melampaui level {#Emph}Lumayan Kuat {#Prev}menurut standarku."
      Speaker = "Zagreus"
      Event = "ZagreusBossGrantsKeepsakeOutro01"
    }
    {
      Id = "MelinoeField_4551"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Kak, aku berusaha semampuku. Apa biasanya kau dapat hadiah kalau menang di tempat ini?"
      Speaker = "Melinoe"
      Event = "ZagreusBossGrantsKeepsakeOutro01"
    }
    {
      Id = "Zagreus_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Biasanya cuma Kegelapan, tapi... aku punya sesuatu untukmu. Dari dulu aku selalu ingin memberikan ini ke seseorang..."
      Speaker = "Zagreus"
      Event = "ZagreusBossGrantsKeepsakeOutro01"
    }
    {
      Id = "MelinoeField_4552"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semacam Kenang-kenangan? {#Emph}Terima kasih banyak!"
      Speaker = "Melinoe"
      Event = "ZagreusBossGrantsKeepsakeOutro01"
    }
    {
      Id = "Zagreus_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh... {#Prev}Aku tidak... bawa hadiah lain... untuk kemenanganmu kali ini..."
      Speaker = "Zagreus"
      Event = "ZagreusBossOutro03"
    }
    {
      Id = "MelinoeField_4553"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak apa-apa. Lagipula aku masih memegang Kontrak sebagai keuntungan tambahan. Barang gratis dari Toko Charon jelas bukan hal remeh!"
      Speaker = "Melinoe"
      Event = "ZagreusBossOutro03"
    }
    {
      Id = "Zagreus_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Syukurlah... kalau kau... merasa begitu, aku... sebaiknya segera kembali..."
      Speaker = "Zagreus"
      Event = "ZagreusBossOutro03"
    }
    {
      Id = "Zagreus_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aaargh...! {#Prev}Baiklah, baiklah, ronde ini kau yang menang... dan sebaiknya aku pergi!"
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscDefeat01"
    }
    {
      Id = "Zagreus_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Guh...! {#Prev}Yah, kurasa sudah waktunya aku pamit undur diri secara dramatis... {#Emph}heh..."
      Speaker = "Zagreus"
      Event = "ZagreusBossMiscDefeat02"
    }
    {
      Id = "Zagreus_0331"
      InheritFrom = "BaseNarrative"
