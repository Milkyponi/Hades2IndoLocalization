{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Moros.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_1879"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam sejahtera, Tuan Moros."
      Speaker = "Melinoe"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "Moros_0198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam hangat, Tuan Putri."
      Speaker = "Moros"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "Moros_0199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga begitu juga bagimu!"
      Speaker = "Moros"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "Moros_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitulah yang ditakdirkan."
      Speaker = "Moros"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "Moros_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demikianlah suratan takdirnya."
      Speaker = "Moros"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "Moros_0203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga Sang Malam melindungimu."
      Speaker = "Moros"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "Moros_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan semoga Sang Malam melindungi kita."
      Speaker = "Moros"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "Moros_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Moros"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "Moros_0090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi keberhasilanmu."
      Speaker = "Moros"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "Moros_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menuju kemenangan."
      Speaker = "Moros"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "Moros_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Melangkahlah dengan waspada."
      Speaker = "Moros"
      Event = "NPC_Moros_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_4072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hawa ini... halo...? Tuan Moros, itukah dirimu...? {#Emph}<Terkesiap>"
      Speaker = "Melinoe"
      Event = "NPC_Moros_01.EntranceVoiceLines"
    }
    {
      Id = "Moros_1001"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, baik, kita sudah {#Emph}sampai{#Prev}, kita sudah sampai..."
      Speaker = "Moros"
      Event = "NPC_Moros_01.EntranceVoiceLines"
    }
    {
      Id = "Moros_0404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maafkan aku, Tuan Putri..."
      Speaker = "Moros"
      Event = "NPC_Moros_01.EntranceVoiceLines"
    }
    {
      Id = "Moros_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akhirnya kutemukan juga dirimu."
      Speaker = "Moros"
      Event = "NPC_Moros_01.EntranceVoiceLines"
    }
    {
      Id = "Moros_0578"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutemukan dirimu."
      Speaker = "Moros"
      Event = "NPC_Moros_01.EntranceVoiceLines"
    }
    {
      Id = "Moros_0579"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau menemukanku."
      Speaker = "Moros"
      Event = "NPC_Moros_01.EntranceVoiceLines"
    }
    {
      Id = "Moros_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupenuhi lagi panggilanmu."
      Speaker = "Moros"
      Event = "NPC_Moros_01.EntranceVoiceLines"
    }
    {
      Id = "Moros_0296"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu sebentar...!"
      Speaker = "Moros"
      Event = "NPC_Moros_01.EntranceVoiceLines"
    }
    {
      Id = "Moros_0384"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maafkan ketidaksopananku kali ini."
      Speaker = "Moros"
      Event = "NPC_Moros_01.EntranceVoiceLines"
    }
    {
      Id = "Moros_0364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maaf, bagaimana?"
      Speaker = "Moros"
      Event = "NPC_Moros_01.EntranceVoiceLines"
    }
    {
      Id = "Moros_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putri Underworld: Sayang sekali aku harus menghubungimu pada saat-saat seperti ini. Bukan kebiasaanku untuk campur tangan di ambang kebinasaan, tugasku hanyalah mengamati."
      Speaker = "Moros"
      Event = "MorosGrantsQuestLog"
    }
    {
      Id = "Melinoe_1582"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ambang kebinasaan.... {#Prev}Kau Tuan Moros, utusan Tiga Takdir! Jadi saudarimu akhirnya mendengarku!"
      Speaker = "Melinoe"
      Event = "MorosGrantsQuestLog"
    }
    {
      Id = "Moros_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka menduga aku akan menemukanmu, karena ada sesuatu yang hendak mereka berikan kepadamu. Ke mana pun tujuanmu nanti, carilah benda itu begitu kau tiba. Aku tak yakin apakah kita akan bertemu lagi; selamat jalan."
      Speaker = "Moros"
      Event = "MorosGrantsQuestLog"
    }
    {
      Id = "Moros_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Suatu kehormatan bagiku..."
      Speaker = "Moros"
      Event = "MorosGrantsQuestLog"
    }
    {
      Id = "Melinoe_1583"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu...!"
      Speaker = "Melinoe"
      Event = "MorosGrantsQuestLog"
    }
    {
      Id = "Moros_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekali lagi jalan kita saling berpapasan. Kenapa kau memanggilku, Tuan Putri? Apakah kau tidak menerima pusaka yang kubawakan dari Para Takdir?"
      Speaker = "Moros"
      Event = "MorosSecondAppearance"
    }
    {
      Id = "MelinoeField_1694"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Moros...! Aku menerima Daftar Takdir itu, dan memanggilmu kembali sesuai titahnya. Seluruh keturunan Nyx disambut hangat di tempat tinggalku. Bisakah kita berbincang lebih lanjut di sana...? Banyak hal yang ingin kutanyakan."
      Speaker = "Melinoe"
      Event = "MorosSecondAppearance"
    }
    {
      Id = "Moros_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak yakin bisa menjawab semuanya, karena pencarian kebenaranku sendiri belakangan ini tidak berjalan mulus. Namun aku takkan menolak undangan ramahmu. Silakan tunjukkan jalannya."
      Speaker = "Moros"
      Event = "MorosSecondAppearance"
    }
    {
      Id = "Melinoe_1588"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, ikuti aku."
      Speaker = "Melinoe"
      Event = "MorosSecondAppearance"
    }
    {
      Id = "Moros_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah."
      Speaker = "Moros"
      Event = "MorosSecondAppearance"
    }
    {
      Id = "Moros_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau bertualang ke permukaan. Padahal tahu betul Para Takdir telah menetapkan sejak lama bahwa mereka dari garis keturunanmu takkan bisa bertahan di sana, dan akan selalu dipaksa kembali ke Underworld."
      Speaker = "Moros"
      Event = "MorosGrantsSurfacePenaltyCure01"
    }
    {
      Id = "MelinoeField_0812"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutukan mereka... terasa nyata sekali. Aku tak pernah berniat tinggal lama. Hanya cukup lama untuk membantu keluargaku. Namun tampaknya para saudarimu bersikeras melarangku melakukannya."
      Speaker = "Melinoe"
      Event = "MorosGrantsSurfacePenaltyCure01"
    }
    {
      Id = "Moros_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... kurasa mereka tak ada di sekitar sini sekarang, bukan? Kebetulan, dulu aku pernah mendapati suatu mantra yang sebenarnya terlarang untuk kulihat. Namun kini kupikir mantra itu memang ditakdirkan untukmu."
      Speaker = "Moros"
      Event = "MorosGrantsSurfacePenaltyCure01"
    }
    {
      Id = "MelinoeField_0813"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mengurai Ikatan Takdir..."
      Speaker = "Melinoe"
      Event = "MorosGrantsSurfacePenaltyCure01"
    }
    {
      Id = "Moros_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menahan takdir kematianmu selama yang kubisa, Tuan Putri. Tapi itu tak mencukupi. Maafkan aku... Sematan Terukir yang kuberikan padamu ada batas kekuatannya, tampaknya."
      Speaker = "Moros"
      Event = "MorosPostRunAboutMorosKeepsake01"
    }
    {
      Id = "MelinoeField_4026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku melangkah lebih jauh daripada jika tanpanya, Yang Mulia Moros. Jadi aku sangat berterima kasih padamu dan atas kekuatan yang kauanugerahkan ini. Aku tahu seharusnya aku bisa memanfaatkannya lebih baik."
      Speaker = "Melinoe"
      Event = "MorosPostRunAboutMorosKeepsake01"
    }
    {
      Id = "Moros_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun tahu itu. Barangkali alasanku berada di sini adalah agar kau bisa mencapai tujuanmu dengan Sematan ini. Atau menyadari bahwa kau sesungguhnya tak membutuhkannya. Sekarang, mari kita berdua kembali..."
      Speaker = "Moros"
      Event = "MorosPostRunAboutMorosKeepsake01"
    }
    {
      Id = "Melinoe_0055_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai nanti."
      Speaker = "Melinoe"
      Event = "MorosPostRunAboutMorosKeepsake01"
    }
    {
      Id = "Moros_0486"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sematan Terukir membantumu bertahan dari musuh-musuhmu bahkan lebih lama dari dugaanku. Ikatanmu dengannya begitu kuat... yang berarti, ikatan {#Emph}kita{#Prev}. Tapi itu tetap belum cukup."
      Speaker = "Moros"
      Event = "MorosPostRunAboutMorosKeepsake02"
    }
    {
      Id = "MelinoeField_4027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir akulah yang seharusnya merasa kesal saat ini, Yang Mulia Moros. Ini jelas-jelas bukan salah Sematan itu."
      Speaker = "Melinoe"
      Event = "MorosPostRunAboutMorosKeepsake02"
    }
    {
      Id = "Moros_0487"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, bagaimanapun juga. Bolehkah aku setidaknya mengantarmu kembali ke Persimpangan? Aku tahu perjalanan pulang bisa terasa begitu mendadak, tapi aku bisa meredakannya sedikit."
      Speaker = "Moros"
      Event = "MorosPostRunAboutMorosKeepsake02"
    }
    {
      Id = "MelinoeField_4028"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja. Silakan duluan."
      Speaker = "Melinoe"
      Event = "MorosPostRunAboutMorosKeepsake02"
    }
    {
      Id = "Moros_0488"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tadi menghunus apa yang pastinya adalah Kobaran Ygnium, tapi dalam wujud yang belum pernah kukenal. Aku merasakan mereka... memanggilku. Karena itulah aku ada di sini."
      Speaker = "Moros"
      Event = "MorosPostRunAboutMorosAspect01"
    }
    {
      Id = "MelinoeField_4029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang Mulia Moros, kau merasakan Aspek dari Senjata Malam yang menyandang namamu. Sang Kobaran sudah mengenalimu, tapi... kurasa aku belum boleh memberikannya padamu saat ini."
      Speaker = "Melinoe"
      Event = "MorosPostRunAboutMorosAspect01"
    }
    {
      Id = "Moros_0489"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku tak menginginkannya... Aku belum pernah harus bertarung dengan cara seperti itu. Bahkan jarang sekali memakai belati jarumku, puji Takdir. Tapi mungkin ketika semua ini usai, kau bisa mengajariku cara menggunakannya. Sampai jumpa di Persimpangan, Tuan Putri."
      Speaker = "Moros"
      Event = "MorosPostRunAboutMorosAspect01"
    }
    {
      Id = "MelinoeField_1919_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa di Persimpangan!"
      Speaker = "Melinoe"
      Event = "MorosPostRunAboutMorosAspect01"
    }
    {
      Id = "Moros_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan kedatanganku yang begitu mendadak. Akalku... melarangku muncul di hadapanmu tanpa alasan yang kuat, tapi hatiku menuntut sebaliknya. Apakah ini... bukan waktu yang tepat?"
      Speaker = "Moros"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "MelinoeField_3730_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, seperti biasa, Yang Mulia Moros, aku... baru saja berada di tengah-tengah upaya meloloskan diri dari maut. Mengapa kau ada di sini? {#Emph}<Mencibir> {#Prev}Penampilanku pasti tampak kacau sekali..."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "Moros_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, kau tampak... yah, aku benar-benar kehabisan kata-kata... Seharusnya aku melatih apa yang hendak kukatakan dengan lebih saksama."
      Speaker = "Moros"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "MelinoeField_3731"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu segugup itu di dekatku, ataupun seformal itu. Dan senang melihatmu di sini juga, di salah satu dari sekian banyak momen kegagalanku yang menyedihkan. Omong-omong, berapa lama kita bisa diam di sini? Rasanya damai sekali..."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "Moros_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita bisa tinggal selama... aku tak tahu persisnya. Sejenak, yang bagi orang lain hanya akan tampak seperti sekejap mata, jadi... aku berniat menemuimu di sini lagi, andai saja... kau berniat menemuiku...?"
      Speaker = "Moros"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "MelinoeField_3734"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat tinggal..."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "MelinoeField_3824"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kalau begitu, kita tetap di sini."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "Moros_0156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya."
      Speaker = "Moros"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "MelinoeField_3732"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suatu sanjungan yang teramat tinggi bahwa kau berperasaan seperti itu, Yang Mulia Moros. Tapi... setelah mendengarkan hatiku sekali lagi... bukanlah keinginanku untuk mempertaruhkan atau mengubah apa yang sudah kita miliki. Aku tahu kau pasti kecewa, tapi kuharap kau bisa mengerti."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "Moros_0408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, sama sekali tak kecewa, Tuan Putri. Dan aku sangat mengerti. Maafkan aku, sekali lagi, atas luapan perasaan ini... Aku tak ingin berpura-pura tak pernah menanyakannya, tapi... mungkinkah kita tetap bisa menjalin hubungan sebagai teman dekat?"
      Speaker = "Moros"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "MelinoeField_3733"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika terjadi hal selain itu, aku takkan pernah memaafkan diriku sendiri, ataupun dirimu."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "Moros_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Kalau begitu, semoga kau pulih secepat biasanya, dan aku akan segera menemuimu di seberang sana. Sampai jumpa untuk saat ini."
      Speaker = "Moros"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "MelinoeField_3735"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kebetulan tak ada sangkut pautnya dengan ini, Yang Mulia Moros. Hampir setiap malam aku berpapasan dengan maut, tapi tidak denganmu. Aku memang {#Emph}menginginkan {#Prev}ini, ya."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "MelinoeField_3736"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Yang Mulia Moros, a-apakah kau yakin ini hanya akan terasa sekejap saja saat kita kembali nanti? Karena..."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "Moros_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pegang kata-kataku. Mengenai persepsi waktumu sendiri, hal {#Emph}itu {#Prev}tak bisa kuubah. Jadi, sebesar apa pun keinginanku untuk tetap di sini bersamamu selamanya... kita sebaiknya segera kembali."
      Speaker = "Moros"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "MelinoeField_3823"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja... tapi hatiku berkata kita bisa tinggal sedikit lebih lama. Dan akalku tak punya alasan masuk akal yang menyangkalnya."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "Moros_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengenai hal itu, kau pun takkan mendengar bantahan apa pun dariku."
      Speaker = "Moros"
      Event = "MorosBecomingCloser01"
    }
    {
      Id = "MelinoeField_3822"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, seperti biasa, Yang Mulia Moros... Aku baru saja hendak beristirahat setelah satu malam lagi yang penuh pertempuran sengit. Jadi, apa yang membawamu ke sini? {#Emph}<Mencibir> {#Prev}Penampilanku pasti tampak kacau sekali..."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloser01_B"
    }
    {
      Id = "Moros_0585"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau memanggilku?"
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp01"
    }
    {
      Id = "MelinoeField_5310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat malam, Yang Mulia Moros. Senang kau bisa datang."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp01"
    }
    {
      Id = "Moros_0540"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Meskipun aku sangat ingin kau berhasil setiap malam, aku tak sabar untuk melihatmu lagi."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp01"
    }
    {
      Id = "MelinoeField_5311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun merasakan hal yang sama. Sampai jumpa di Persimpangan."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp01"
    }
    {
      Id = "Moros_0582"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maaf mengganggu."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp02"
    }
    {
      Id = "MelinoeField_5312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rupanya kau di sini, Moros. Senang melihatmu."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp02"
    }
    {
      Id = "Moros_0542"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sudah begitu terbiasa merasa sendirian di tempat ini... tapi berada di sini bersamamu...?"
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp02"
    }
    {
      Id = "MelinoeField_5313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya menyenangkan. Meski sebaiknya kita segera kembali."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp02"
    }
    {
      Id = "Moros_0581"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kumohon jangan kembali dulu untuk saat ini."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp03"
    }
    {
      Id = "MelinoeField_5314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tiba tepat waktu, Tuan Moros. Baguslah."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp03"
    }
    {
      Id = "Moros_0544"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Di sini nyaman, ya? Damai dan tenang. Dan bersamamu, rasanya jauh lebih baik."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp03"
    }
    {
      Id = "MelinoeField_5315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang sangat nyaman. Kurasa kita bisa tinggal sedikit lebih lama?"
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp03"
    }
    {
      Id = "Moros_0556"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bayang-bayang ini begitu pekat."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp04"
    }
    {
      Id = "MelinoeField_5316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hai, Moros. Kurasa kita berduaan lagi."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp04"
    }
    {
      Id = "Moros_0546"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tahu kau tak ingin berakhir di tempat seperti ini, tapi kita bisa menjadikannya milik kita."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp04"
    }
    {
      Id = "MelinoeField_5317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa tempat ini sudah menjadi milik kita."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp04"
    }
    {
      Id = "Moros_0553"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bahkan di sini pun ada cahaya bulan."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp05"
    }
    {
      Id = "MelinoeField_5318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil datang, Tuan Moros. Dan selalu tepat waktu."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp05"
    }
    {
      Id = "Moros_0548"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jika kau tidak terburu-buru untuk kembali, maukah kau tetap di sini bersamaku?"
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp05"
    }
    {
      Id = "MelinoeField_5319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan senang hati."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp05"
    }
    {
      Id = "Moros_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maaf mengganggu."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp06"
    }
    {
      Id = "MelinoeField_5320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Halo, Moros. Aku selalu mengenang saat terakhir kali kita berada di sini."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp06"
    }
    {
      Id = "Moros_0550"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dulu aku tak merasakan apa-apa saat berada di sini. Tapi sekarang, bersamamu... rasanya jauh lebih bermakna."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChatFollowUp06"
    }
    {
      Id = "MelinoeField_5321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku selalu menantikan saat menjemput Takdir Kematianku di malam-malam seperti ini."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChatFollowUp06"
    }
    {
      Id = "Moros_1002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat siapa ini, kita kedatangan tamu, nona-nona! Siapa sangka? Kau berhasil menemukan kami, Manis! Kau berhak dapat, entahlah, tiga pertanyaan? Kita ada bertiga, jadi tiga pertanyaan, terdengar adil, kan?"
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "MelinoeField_4073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian... kalian adalah para Dewi Takdir, kalian... b... benar-benar ada di sini! Apa kalian selamat, apa kalian menderita luka? Saudara kalian, Tuan Moros, mencemaskan kalian ke mana-mana, dan bukan cuma dia!"
      Speaker = "Melinoe"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1003"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa kalian selamat, apa kalian menderita luka? Wah! {#Prev}Bagaimana menurut kalian, nona-nona, kita hitung itu {#Emph}satu {#Prev}pertanyaan atau {#Emph}dua? {#Prev}Kukira lebih baik kita beri keringanan, dia kelihatannya gadis yang baik. {#Emph}Hitung satu saja, ya?"
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1004_C"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh ya, gadis yang baik, kau benar, hitung satu saja! {#Emph}Beres!"
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1006"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Beres! {#Prev}Kami {#Emph}baik-baik saja{#Prev}, Manis, setidaknya {#Emph}sekarang! {#Prev}Kakekmu memang sempat menangkap kami, ya, kami agak kesal, kau tahu sendiri, kan? Soalnya kami sudah terus {#Emph}menenun{#Prev}, dan {#Emph}menenun{#Prev}, dan {#Emph}menenun{#Prev}, jadi kami pikir: Kapan lagi ada waktu terbaik untuk rehat santai?"
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "MelinoeField_4074"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Rehat santai... {#Prev}tidakkah seharusnya kalian memberi kabar pada Tuan Moros, atau kepada yang lain? Dia sangat khawatir!"
      Speaker = "Melinoe"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu pertanyaan ke-{#Emph}dua! {#Prev}Kami {#Emph}sudah {#Prev}memberi kabar, makanya {#Emph}kau {#Prev}bisa sampai di sini! Moros itu {#Emph}benar-benar {#Prev}anak yang manis. Kami pikir dia butuh sedikit waktu menyendiri... Nah, pertanyaan terakhir!"
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "MelinoeField_4075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertanyaan terakhir, aku... apa yang akan kalian lakukan sekarang, setelah Chronos sepertinya bukan lagi ancaman? Bagaimana cara kita mencegah hal seperti ini terulang kembali?"
      Speaker = "Melinoe"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kalau {#Emph}itu {#Prev}aku hitung sebagai {#Emph}dua {#Prev}pertanyaan, jadi aku cuma bakal jawab yang pertama, atau mungkin yang kedua ya, aku jadi bingung sendiri, intinya begini: {#Emph}Kami tak akan melakukan apa-apa...! {#Prev}Liburan ini menyenangkan sekali."
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "MelinoeField_4076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak akan melakukan apa-apa, dan aku tak boleh bertanya lagi, jadi... mungkin kalian ingin menjelaskannya..."
      Speaker = "Melinoe"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, siapa yang tahu apa yang bakal terjadi, kau atau aku? Dengar ya, kalian semua para dewa, kalian sendiri yang tercebur dalam masalah ini. Aku tahu, {#Emph}aku tahu{#Prev}, kalian pikir ini semua gara-gara kami, yah, kami {#Emph}tidak suka {#Prev}diberi beban semacam itu! Lagipula kalian bisa bertahan sendiri dengan baik, jadi..."
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1012_C"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, kalian sudah berjuang dengan baik, {#Emph}haha! {#Prev}Jadi kami bakal membiarkan kalian {#Emph}meneruskannya!"
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami bakal membiarkan kalian meneruskannya. Dan setelah kalian merasa puas hidup tanpa kami untuk sementara waktu, kalian bakal menyerahkannya kepada manusia fana. Persis seperti {#Emph}kami {#Prev}yang menyerahkannya kepada {#Emph}kalian!"
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "MelinoeField_4077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menyerahkan {#Emph}apa {#Prev}kepada manusia fana... maksudku... aku tak tahu bagaimana harus menanggapinya tanpa mengajukan pertanyaan lain."
      Speaker = "Melinoe"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1015"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tak apa-apa{#Prev}, Manis! Anggap saja begini, {#Emph}yah... {#Prev}kalian para dewa bisa mengurus urusan kalian {#Emph}sendiri {#Prev}untuk sementara, lalu manusia fana bisa mengurus urusan {#Emph}mereka! {#Prev}Ini akan menjadi zaman yang sama sekali baru! Sudah lama sekali sejak terakhir kali ada zaman {#Emph}seperti itu."
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "MelinoeField_4078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kalian pensiun... kalian bertiga. Tidak ada tenunan lagi... kami harus terus berjuang sendiri, apa pun yang akan terjadi."
      Speaker = "Melinoe"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, {#Emph}ayolah{#Prev}, jangan dibuat seolah ini masalah besar! Lagipula kau juga tidak akan berbuat beda. Tapi sebenarnya kau {#Emph}bisa! {#Prev}Coba tanyakan saja pada gurumu sesekali. Dia itu {#Emph}benar-benar {#Prev}punya pengaruh besar dan main belakang di balik layar, asal tahu saja!"
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1017_C"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh {#Prev}jelas, Bu Guru {#Emph}pasti {#Prev}sudah banyak main belakang untuk mengatur semuanya, {#Emph}huhuh!"
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "MelinoeField_4079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu Kepala Sekolah. Jadi kau bilang... entahlah apa maksudmu, tapi nanti akan kutanyakan. Seperti yang kau tahu betul, aku takkan bisa melakukan semua ini tanpa beliau."
      Speaker = "Melinoe"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1018_C"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Guuuhhhhh, ngghhh..."
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_1019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ohh, {#Emph}ya{#Prev}, kami tahu. Pokoknya, Manis, kami akan melepaskanmu sekarang, karena masih ada urusan lain! Tapi {#Emph}bukan {#Prev}menenun! {#Emph}Tidak dalam waktu dekat ini{#Prev}, seperti kata orang-orang, {#Emph}heh. {#Prev}Senang akhirnya bisa berjumpa denganmu. {#Emph}Daaah!"
      Speaker = "Moros"
      Event = "FatesEpilogue01"
    }
    {
      Id = "MelinoeField_4080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Emm{#Prev}, sampai jumpa...! Dan, terima kasih semuanya!"
      Speaker = "Melinoe"
      Event = "FatesEpilogue01"
    }
    {
      Id = "Moros_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Putri! Kita belum sempat berkenalan secara resmi. Aku adalah Pembawa Berita Buruk Resmi. Penyihir Persimpangan telah menjelaskan situasinya kepadaku, dan... berbaik hati mengizinkanku tinggal di sini untuk sementara."
      Speaker = "Moros"
      Event = "MorosFirstMeeting"
    }
    {
      Id = "Moros_0703"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Putri, kita belum berkenalan secara resmi. Aku dipanggil Moros, Malapetaka, atau Sang Pembawa Berita Buruk resmi. Sang Penyihir Persimpangan telah menerangkan situasinya kepadaku, dan berbaik hati mengundangku untuk tinggal di sini untuk sementara."
      Speaker = "Moros"
      Event = "MorosFirstMeeting"
    }
    {
      Id = "Melinoe_1589"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dipersilakan di sini dan aman, Tuan Moros. Kalau begitu, kau sudah tahu tentang tugasku."
      Speaker = "Melinoe"
      Event = "MorosFirstMeeting"
    }
    {
      Id = "Moros_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menumpas perebut takhta Wangsa Hades terdengar lebih dari sekadar tugas. Aku turut berduka beban ini harus kau pikul, dan jauh lebih cepat dari yang diperkirakan."
      Speaker = "Moros"
      Event = "MorosFirstMeeting"
    }
    {
      Id = "Melinoe_0872"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak apa. Aku memang terlahir untuk ini."
      Speaker = "Melinoe"
      Event = "MorosFirstMeeting"
    }
    {
      Id = "Moros_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau baik-baik saja, Tuan Putri? Aku baru menyadari kalau setiap kali kau kembali, kemungkinan besar itu karena nasib malang. Hal yang dulu mungkin bisa kuantisasi dengan mudah, tapi sekarang tidak lagi..."
      Speaker = "Moros"
      Event = "MorosAboutReturning01"
    }
    {
      Id = "Melinoe_2057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baik-baik saja, Tuan Moros, terima kasih sudah bertanya. Aku sudah cukup terbiasa dengan hasil semacam itu sampai saat ini. Menarik rasanya mengetahui para Moirae tidak lagi memaksakan jalannya... bahwa semuanya berada dalam kendaliku. Dan sepenuhnya kesalahanku."
      Speaker = "Melinoe"
      Event = "MorosAboutReturning01"
    }
    {
      Id = "Moros_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... kini setelah kau menyinggungnya, aku tidak bisa sepenuhnya yakin para Moirae sudah tak punya pengaruh sama sekali. Betapa menjengkelkannya, tak mengetahui apakah tindakan kita telah ditakdirkan atau tidak..."
      Speaker = "Moros"
      Event = "MorosAboutReturning01"
    }
    {
      Id = "Melinoe_2058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berusaha untuk tidak terlalu memikirkannya."
      Speaker = "Melinoe"
      Event = "MorosAboutReturning01"
    }
    {
      Id = "Melinoe_1803"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti tahu apa yang akan kutanyakan, Tuan Moros... apalagi setelah aku berjanji akan mengajukan banyak pertanyaan. Kau bilang kau sedang menjalani pencarian yang sia-sia. Sebenarnya apa yang kau cari?"
      Speaker = "Melinoe"
      Event = "MorosAboutSearch01"
    }
    {
      Id = "Moros_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh! Yah, para Moirae memang suka menyuruhku mengambil ini dan itu sesekali. Pencarianku dalam beberapa hal serupa dengan itu. Meskipun, aku mulai berpikir mereka sengaja memperdayaiku..."
      Speaker = "Moros"
      Event = "MorosAboutSearch01"
    }
    {
      Id = "Melinoe_1804"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka mengutusmu untuk mencari sesuatu yang mustahil ditemukan... dan kau tidak bisa memberitahuku apa itu, bukan."
      Speaker = "Melinoe"
      Event = "MorosAboutSearch01"
    }
    {
      Id = "Moros_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir mereka hanya ingin menyingkirkanku dari jalan mereka. Meskipun begitu, aku sebaiknya tidak berspekulasi, atau membicarakan hal ini lebih jauh lagi... mohon maaf."
      Speaker = "Moros"
      Event = "MorosAboutSearch01"
    }
    {
      Id = "Melinoe_1959"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku paham..."
      Speaker = "Melinoe"
      Event = "MorosAboutSearch01"
    }
    {
      Id = "Melinoe_2055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kita pertama kali bertemu, kau sedang mencari para Moirae. Namun kau malah menemukan {#Emph}diriku {#Prev}di antara bayang-bayang. Aku bisa menavigasi jalan kembali ke Persimpangan lewat jalur itu... tapi kau bisa pergi lebih jauh lagi?"
      Speaker = "Melinoe"
      Event = "MorosAboutSearch02"
    }
    {
      Id = "Moros_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, aku bisa. Aku berasal dari sudut terdalam Underworld, tempat di mana cahaya sama sekali tidak ada. Jurang purba tempat semua ciptaan bermula beberapa waktu yang lalu."
      Speaker = "Moros"
      Event = "MorosAboutSearch02"
    }
    {
      Id = "Melinoe_2056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa andai pun seseorang tahu para Moirae bersemayam di tempat seperti itu, mereka mungkin masih sulit untuk ditemukan..."
      Speaker = "Melinoe"
      Event = "MorosAboutSearch02"
    }
    {
      Id = "Moros_0144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sulit, meski bukan mustahil, seperti yang kita tahu sekarang..."
      Speaker = "Moros"
      Event = "MorosAboutSearch02"
    }
    {
      Id = "Melinoe_0873"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang ingin kutanyakan padamu, Tuan Moros, meski kurasa aku sudah tahu jawabannya. Apakah perang melawan Chronos dan Olympus mengalami perkembangan baru?"
      Speaker = "Melinoe"
      Event = "MorosAboutTask01"
    }
    {
      Id = "Moros_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan aku tak bisa menjawabmu, Tuan Putri. Aku terikat sumpah untuk tidak pernah membicarakan hal-hal yang berkaitan dengan tenunan para Moirae. Jika kau tahu lebih banyak saat ini, itu bisa memengaruhi jalan takdirmu secara keliru."
      Speaker = "Moros"
      Event = "MorosAboutTask01"
    }
    {
      Id = "Melinoe_0874"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu...? Pengetahuan adalah persiapan. Tampaknya ini jelas demi keuntungan kita jika aku tahu sebanyak mungkin tentang apa yang akan kuhadapi."
      Speaker = "Melinoe"
      Event = "MorosAboutTask01"
    }
    {
      Id = "Moros_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja. Meski begitu, aku tak bisa melanggar sumpahku. Namun aku yakin, kau akan mengetahui kebenarannya saat waktunya telah tepat."
      Speaker = "Moros"
      Event = "MorosAboutTask01"
    }
    {
      Id = "Melinoe_0875"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan menunggunya."
      Speaker = "Melinoe"
      Event = "MorosAboutTask01"
    }
    {
      Id = "Moros_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh aku bertanya, Tuan Putri? Daftar Nubuat Kecil yang Ditakdirkan itu... sudahkah kau memanfaatkannya?"
      Speaker = "Moros"
      Event = "MorosAboutQuestLog01"
    }
    {
      Id = "Melinoe_1805"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah. Terima kasih telah membawakannya untukku. Kalau begitu, para Moirae sudah tahu apa yang akan terjadi dalam semua ini? Semua yang akan kulakukan?"
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog01"
    }
    {
      Id = "Moros_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, ya dan tidak. Daftar Takdir itu hanya memuat sesedikit mungkin tentang masa depanmu seperlunya saja. Aku sendiri sempat memegangnya sejenak, dan hanya melihat satu nubuat di sana... bahwa aku akan menyerahkannya kepadamu."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog01"
    }
    {
      Id = "Melinoe_0877"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, itu nubuat yang sudah tergenapi."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog01"
    }
    {
      Id = "Moros_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Daftar Takdir itu terus terungkap, jadi terima kasih. Walau para Moirae sering membiarkan peristiwa mengalir alami, ada kalanya mereka menginginkan kepastian ekstra. Dan rela memberikan imbalan yang sepadan."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog02"
    }
    {
      Id = "Melinoe_0878"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah melihat sejumlah nubuat yang terdaftar telah menjadi kenyataan. Lalu yang lainnya diramalkan sebagai gantinya. Sihir magick dalam gulungan itu, sungguh di luar apa pun yang pernah kupelajari..."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog02"
    }
    {
      Id = "Moros_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti punya keraguan; para Dewi Takdir memang cukup terkenal dengan selera ironi mereka. Namun, apa pun hasilnya, aku bersyukur atas kesediaanmu mengungkap rencana mereka. Taruhannya adalah keluarga kita."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog02"
    }
    {
      Id = "Melinoe_0879"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluarga kita, dan lebih dari itu..."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog02"
    }
    {
      Id = "Melinoe_2059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengaku merasa agak canggung karena Daftar Takdir terpampang di sana untuk kaulihat dan dilihat semua orang. Beberapa hal yang tertulis di dalamnya agak pribadi."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog03"
    }
    {
      Id = "Moros_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika ini bisa menenangkanmu, ramalan itu hanya tampak kepadamu. Kami hanya melihat apa yang memang diperuntukkan bagi kami. Meski begitu, saat kau memenuhi sebuah ramalan... aku biasanya bisa merasakannya. Seperti sebuah pencerahan yang tiba-tiba."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog03"
    }
    {
      Id = "Melinoe_2060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tahu jalan hidup kita saling bertaut sampai batas tertentu... yah, semoga pencerahan tiba-tiba yang terhubung dengan tindakanku tidak {#Emph}terlalu {#Prev}memalukan."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog03"
    }
    {
      Id = "Moros_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku yakin itu tidak akan terjadi."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog03"
    }
    {
      Id = "Melinoe_2061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, beberapa ramalan Takdir ini cukup berbobot. Aku bergidik membayangkan apa yang mungkin ada di daftar ramalan {#Emph}besar{#Prev}..."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog04"
    }
    {
      Id = "Moros_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap ini tidak membuatmu merasa baktimu selama ini sia-sia, karena tentu saja jasamu sangat bernilai. Namun, ramalan yang tertera di sana memang tergolong kecil, dalam skala tatanan semesta yang agung."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog04"
    }
    {
      Id = "Melinoe_2062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Skala tatanan semesta yang agung... maksudmu seluruh keberadaan, masa lalu yang tak terselami, masa depan yang tak tersingkap... keagungan semacam itu maksudmu?"
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog04"
    }
    {
      Id = "Moros_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya. Para Dewi Takdir mengatur hal-hal terkecil hingga pola-pola paling agung. Jadi jangan salah paham dengan konsep ramalan kecil. Riak kecil bisa menjelma jadi gelombang dahsyat."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog04"
    }
    {
      Id = "Melinoe_2063"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang kau terdengar seperti Poseidon."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog04"
    }
    {
      Id = "Moros_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu pernah menjadi pemegang Daftar Takdir, kau tahu. Hadiah {#Emph}pindahan Rumah{#Prev}, kata saudari-saudariku. Namun Hades menyimpannya... sampai saudaramu membongkarnya dari arsip, dan mulai menggunakannya sendiri."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog05"
    }
    {
      Id = "Melinoe_2067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu Zagreus mencari ibu kami... mungkin Daftar Takdir membantunya berhasil. Kalau dipikir-pikir, aku bahkan tidak akan lahir jika dia tidak melakukannya. Tunggu... lalu bagaimana Daftar itu bisa berakhir di tanganmu setelahnya?"
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog05"
    }
    {
      Id = "Moros_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu belum lama berselang. Para Dewi Takdir mengutusku untuk mengambil kembali Daftar itu dari Rumah ayahmu. Chronos sedang pergi, kata mereka. Dan mereka benar; karena saat aku kembali, mereka sudah tiada."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog05"
    }
    {
      Id = "Melinoe_2068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saat itulah dia menangkap mereka..."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog05"
    }
    {
      Id = "Melinoe_4750"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa malam saat berada di permukaan, aku teringat bahwa aku menentang kehendak para Dewi Takdir hanya dengan berada di sana. Namun Daftar Takdir memiliki ramalan tertentu yang tidak bisa dipenuhi di tempat lain. Saudari-saudarimu, mereka... pasti sudah mengantisipasi ini."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog06"
    }
    {
      Id = "Moros_0436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu sangat mungkin, bahkan masuk akal. Namun, sepanjang sejarah, saudari-saudariku tidak banyak memiliki kesabaran bagi mereka yang mengabaikan ramalan. Barangkali mereka sedang membuat pengecualian."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog06"
    }
    {
      Id = "Melinoe_4751"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atau barangkali aku justru mengundang konsekuensi yang mengerikan. Meskipun jika Chronos tidak melanggar ramalan mereka, aku pun tidak akan melanggarnya."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog06"
    }
    {
      Id = "Moros_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berdasarkan pengalamanku, sebaiknya hindari terlalu memikirkan hal-hal seperti itu. Bahkan diriku pun tidak selalu bisa melihat pola dalam jalan pikiran saudari-saudariku, dan kupikir mereka memang sengaja begitu."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog06"
    }
    {
      Id = "Melinoe_4752"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Supaya kepala kita pusing?"
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog06"
    }
    {
      Id = "Moros_0438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemungkinan besar, ya."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog06"
    }
    {
      Id = "Moros_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau... akhir-akhir ini jarang melihat ke Daftar Takdir. Selama berhari-hari, aku menantikan kepulanganmu dengan selamat, lalu menyaksikanmu memenuhi satu demi satu ramalan. Sekarang kau melewatkannya begitu saja hanya untuk berbicara denganku."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog07"
    }
    {
      Id = "Melinoe_4760"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Moros, tanpa bermaksud meremehkan saudari-saudarimu, aku merasa dirimu jauh lebih menarik daripada sekumpulan ramalan kecil. Yah, sebagian besar dari mereka... Aku juga tidak punya banyak ramalan tersisa saat ini."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog07"
    }
    {
      Id = "Moros_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah melakukannya dengan sangat baik. Atau lebih tepatnya kau telah melakukan apa yang pasti akan terjadi... meskipun aku lebih suka berpikir bahwa hasil ini terwujud berkat tekad kuat dari dirimu."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog07"
    }
    {
      Id = "Melinoe_4761"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang terjadi jika sudah tidak ada lagi ramalan yang bisa kupenuhi?"
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog07"
    }
    {
      Id = "Moros_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin setelah itu akan ada ramalan lain untukku... untuk meneruskan Daftar Takdir kepada orang lain."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog07"
    }
    {
      Id = "Melinoe_4762"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau harus pergi?"
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog07"
    }
    {
      Id = "Moros_0442"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tidak tahu."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog07"
    }
    {
      Id = "Melinoe_4783"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak ada lagi ramalan kecil yang tersisa untukku yang belum menjadi kenyataan. Sudah lama aku tidak melihat yang baru muncul, dan... sepertinya aku tidak perlu berharap akan ada lagi dalam waktu dekat..."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog08"
    }
    {
      Id = "Moros_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika itu benar, maka tujuanku sendiri datang ke Persimpangan ini telah tercapai. Namun sekarang aku tidak tahu bagaimana harus melangkah, tanpa bimbingan dari saudari-saudariku maupun dari Daftar itu."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog08"
    }
    {
      Id = "Melinoe_4784"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari-saudarimu sempat mengisyaratkan bahwa kau mungkin punya tujuan lain di sini, selain memastikan Daftar Takdir aman dan segala sesuatu di dalamnya terpenuhi."
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog08"
    }
    {
      Id = "Moros_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan apa gerangan tujuan itu, berulang kali melanggar kehendak mereka selagi menjalin kedekatan denganmu? Saudari-saudariku memang gemar bersiasat, tapi tidak sejauh itu."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog08"
    }
    {
      Id = "Melinoe_4785"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tidak sedang terburu-buru untuk pergi, kan?"
      Speaker = "Melinoe"
      Event = "MorosAboutQuestLog08"
    }
    {
      Id = "Moros_0445"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaliknya, aku ingin bersamamu di sini selama yang kubisa."
      Speaker = "Moros"
      Event = "MorosAboutQuestLog08"
    }
    {
      Id = "Moros_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Batu Hitam Kelam sudah ada di sini selama ini, dan aku gagal mendeteksinya. Aku khawatir aku mulai melakukan kekeliruan lebih sering daripada yang bisa dimaklumi."
      Speaker = "Moros"
      Event = "MorosAboutBountyBoard01"
    }
    {
      Id = "Melinoe_3119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Batu itu baru saja terdiam membisu, Yang Mulia Moros. Sampai nenek moyangmu memberiku ide tentang cara melihat berbagai kemungkinan di dalamnya. Meskipun begitu, mungkin seharusnya aku meminta izinmu terlebih dahulu. Kau tampak gelisah..."
      Speaker = "Melinoe"
      Event = "MorosAboutBountyBoard01"
    }
    {
      Id = "Moros_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, hanya saja... Chaos dan para saudariku tidak selalu akur. Chaos ingin segalanya serba memungkinkan... sementara para Takdir ingin segala sesuatunya berjalan menurut jalur tertentu. Namun, mereka semua pasti setuju bahwa kau berhak menggunakan Batu itu sesukamu."
      Speaker = "Moros"
      Event = "MorosAboutBountyBoard01"
    }
    {
      Id = "Melinoe_3120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang bisa menyatukan keluarga seperti Batu Hitam Pekat, bukan?"
      Speaker = "Melinoe"
      Event = "MorosAboutBountyBoard01"
    }
    {
      Id = "Moros_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar juga."
      Speaker = "Moros"
      Event = "MorosAboutBountyBoard01"
    }
    {
      Id = "Moros_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sumpah Para Tak Kasatmata ada di sekitar sini, benarkah begitu, Tuan Putri...? Hawa yang dipancarkannya... sudah lama tak kurasakan sejak sebelum semua kekacauan ini terjadi. Kupikir Sumpah itu hilang bersama Ibu Nyx, tapi ternyata dijaga oleh Yang Mulia Hecate."
      Speaker = "Moros"
      Event = "MorosAboutShrine01"
    }
    {
      Id = "Melinoe_3121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kini benda itu berada di bawah pengawasanku sendiri. Kehendak Malam harus tetap terlaksana apa pun yang terjadi, bukankah begitu? Kau ada di sini bersama Para Tak Kasatmata; kau tahu betul tugas kita."
      Speaker = "Melinoe"
      Event = "MorosAboutShrine01"
    }
    {
      Id = "Moros_0314"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sumpah itu jelas berada di tangan yang tepat."
      Speaker = "Moros"
      Event = "MorosAboutShrine01"
    }
    {
      Id = "Moros_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang sungguh mengerikan. Di saat-saat seperti inilah biasanya Tiga Takdir dan aku menghasilkan karya-karya terbaik kami, kurasa."
      Speaker = "Moros"
      Event = "MorosAboutShrine02"
    }
    {
      Id = "Melinoe_4763"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu dengan mengantar manusia fana menuju ajal yang tak terduga, tapi sudah sepantasnya mereka terima? Apakah hal itu melibatkan Sumpah Para Tak Kasatmata?"
      Speaker = "Melinoe"
      Event = "MorosAboutShrine02"
    }
    {
      Id = "Moros_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemungkinan besar, ya. Aku sendiri tak mengucapkan sumpah-sumpah itu, tetapi aku merasakan sebagian hasilnya. Ketika manusia fana tewas dengan cara yang dramatis, mereka cenderung menjadi Arwah yang patuh dan penuh rasa hormat."
      Speaker = "Moros"
      Event = "MorosAboutShrine02"
    }
    {
      Id = "Melinoe_4764"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masuk akal juga."
      Speaker = "Melinoe"
      Event = "MorosAboutShrine02"
    }
    {
      Id = "Melinoe_4767"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau familier dengan Anugerah Selubung, Yang Mulia Moros? Diberikan kepada Kesatria Malam atas pengabdian tanpa henti kepada alam ini, setelah bersumpah mengikat banyak Janji."
      Speaker = "Melinoe"
      Event = "MorosAboutTrophyQuest01"
    }
    {
      Id = "Moros_0505"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja aku sangat mengenalnya. Saudariku sendirilah yang menenun Anugerah itu; menganggapnya sebagai salah satu mahakarya mereka. Mengapa kau bertanya?"
      Speaker = "Moros"
      Event = "MorosAboutTrophyQuest01"
    }
    {
      Id = "Melinoe_4768"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya penasaran. Dan saat kau bilang mereka {#Emph}menenun {#Prev}Anugerah itu, maksudmu bukan memahat, menempa logam, atau semacamnya, kan?"
      Speaker = "Melinoe"
      Event = "MorosAboutTrophyQuest01"
    }
    {
      Id = "Moros_0506"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, Tuan Putri. Arah pembicaraanmu ini membuatku agak cemas. Apakah terjadi sesuatu pada Anugerah itu?"
      Speaker = "Moros"
      Event = "MorosAboutTrophyQuest01"
    }
    {
      Id = "Melinoe_4769"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, tidak sama sekali! Kurasa."
      Speaker = "Melinoe"
      Event = "MorosAboutTrophyQuest01"
    }
    {
      Id = "Melinoe_0880"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salam, Yang Mulia Moros. Bagaimana caramu beradaptasi sejauh ini? Apakah ada yang bisa kami bantu agar kau merasa lebih nyaman tinggal di sini?"
      Speaker = "Melinoe"
      Event = "MorosAboutCrossroads01"
    }
    {
      Id = "Moros_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak perlu, Tuan Putri, aku baik-baik saja, dan sedang membiasakan diri, seperti katamu. Aku belum pernah mendatangi tempat seperti ini sebelumnya! Dan aku berusaha sekuat tenaga agar tidak merepotkan siapa pun di sini."
      Speaker = "Moros"
      Event = "MorosAboutCrossroads01"
    }
    {
      Id = "Melinoe_0693"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau diterima di sini dan kau aman."
      Speaker = "Melinoe"
      Event = "MorosAboutCrossroads01"
    }
    {
      Id = "Moros_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pencatat Rekod di kedai minum itu pasti pernah mengabdi pada ayahmu. Dan sang Bijak itu tampaknya punya pengalaman luas soal ramalan. Kau berhasil mengumpulkan pengikut yang luar biasa."
      Speaker = "Moros"
      Event = "MorosAboutTavernaShades01"
    }
    {
      Id = "Melinoe_4770"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang selalu akrab dengan para Arwah. Terkadang aku merasa lebih memahami mereka daripada makhluk yang masih hidup. Mereka lebih mudah kubaca."
      Speaker = "Melinoe"
      Event = "MorosAboutTavernaShades01"
    }
    {
      Id = "Moros_0508"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku biasanya menyimpulkan situasi sosial dari perpaduan tutur kata, baik nada maupun intinya, serta gerak-gerik kecil sang pembicara. Pada para Arwah, aku sama sekali tak bisa menangkap hal-hal itu."
      Speaker = "Moros"
      Event = "MorosAboutTavernaShades01"
    }
    {
      Id = "Melinoe_4771"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja butuh latihan."
      Speaker = "Melinoe"
      Event = "MorosAboutTavernaShades01"
    }
    {
      Id = "Moros_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua perabotan yang tertata apik di dekat sini... terima kasih, Tuan Putri. Rekanmu Dora menanyakan berbagai hal tentang seleraku, tapi aku tak menyangka kau akan menyediakannya untukku sampai seperti ini."
      Speaker = "Moros"
      Event = "MorosAboutFurnishings01"
    }
    {
      Id = "Melinoe_4765"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena kau sudah tinggal bersama kami beberapa waktu, sudah sepantasnya kau merasa sedikit nyaman di sini. Meski tentu saja ini tak ada apa-apanya dibanding tempatmu saat melayani para Takdir."
      Speaker = "Melinoe"
      Event = "MorosAboutFurnishings01"
    }
    {
      Id = "Moros_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tempat tinggalku dulu lebih ditata sesuai selera saudariku. Walaupun mengingat betapa aku kini menyukai gelendong benang dan tirai-tirai kain, mungkin selera kami tak jauh berbeda."
      Speaker = "Moros"
      Event = "MorosAboutFurnishings01"
    }
    {
      Id = "Melinoe_4766"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tiap orang punya selera masing-masing!"
      Speaker = "Melinoe"
      Event = "MorosAboutFurnishings01"
    }
    {
      Id = "Melinoe_0881"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang biasanya kau kerjakan, Yang Mulia Moros? Maksudku, sebelum semua ini terjadi. Aku hanya tahu gambarannya secara samar."
      Speaker = "Melinoe"
      Event = "MorosAboutDoom01"
    }
    {
      Id = "Moros_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku melayani saudariku, Tiga Takdir, baik sebagai pembela maupun pelindung mereka. Para Takdir menentukan kapan kehidupan manusia fana harus berakhir, dan terkadang juga {#Emph}bagaimana {#Prev}caranya. Aku bertugas menyaksikan tenunan-tenunan takdir yang lebih spesifik itu..."
      Speaker = "Moros"
      Event = "MorosAboutDoom01"
    }
    {
      Id = "Melinoe_0882"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum fana pasti sangat menghargai ketekunanmu. Apakah ada orang lain yang menggantikan tanggung jawabmu sejak saat itu?"
      Speaker = "Melinoe"
      Event = "MorosAboutDoom01"
    }
    {
      Id = "Moros_0044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak pernah berhak memutuskan mengapa nyawa seorang manusia fana harus mendadak dicabut. Namun, aku berhak memilih {#Emph}bagaimana {#Prev}caranya. Mengetahui masa depan bisa jadi pekerjaan yang sangat membosankan, jadi saudariku dan aku mencoba membuat segalanya tetap... menarik."
      Speaker = "Moros"
      Event = "MorosAboutDoom01"
    }
    {
      Id = "Melinoe_0883"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Arwah di sekitar sini... Aku tahu mereka menghindarimu, Yang Mulia Moros. Sebagian ketakutan. Sebagian lagi mencibir penuh benci. Kaulah yang mencabut nyawa mereka?"
      Speaker = "Melinoe"
      Event = "MorosAboutDoom02"
    }
    {
      Id = "Moros_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah berhak memutuskan mengapa nyawa seorang manusia fana harus mendadak dicabut. Namun, aku berhak memilih {#Emph}bagaimana {#Prev}caranya. Mengetahui masa depan bisa jadi pekerjaan yang sangat membosankan, jadi saudariku dan aku mencoba membuat segalanya tetap... menarik."
      Speaker = "Moros"
      Event = "MorosAboutDoom02"
    }
    {
      Id = "Melinoe_0884"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mendatangkan penderitaan bagi manusia fana hanya karena merasa bosan?"
      Speaker = "Melinoe"
      Event = "MorosAboutDoom02"
    }
    {
      Id = "Moros_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak bangga akan hal itu. Terlebih lagi saat kau mengungkapkannya dengan cara {#Emph}seperti itu{#Prev}. Dan aku sangat menyesal telah menimbulkan perpecahan di barisanmu."
      Speaker = "Moros"
      Event = "MorosAboutDoom02"
    }
    {
      Id = "Melinoe_0885"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar aku yang urus."
      Speaker = "Melinoe"
      Event = "MorosAboutDoom02"
    }
    {
      Id = "Moros_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebelumnya kau pernah mengatakan sesuatu kepadaku, Tuan Putri. Tentang kaum fana. Bahwa mereka pasti {#Emph}menghargai ketekunanku{#Prev}, karena aku menemani saat-saat terakhir hidup mereka. Kenyataannya, mereka membenciku; sebagian besar dari mereka. Baik dalam hidup, maupun mati."
      Speaker = "Moros"
      Event = "MorosAboutDoom03"
    }
    {
      Id = "Melinoe_0886"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menghargai kejujuranmu. Apa yang kau katakan sejalan dengan beberapa desas-desus yang kudengar dari para Bayangan yang setia pada kita. Tapi ini aneh, Yang Mulia Moros. Reputasimu adalah satu hal; tapi {#Emph}dirimu{#Prev}, tampaknya, sama sekali berbeda."
      Speaker = "Melinoe"
      Event = "MorosAboutDoom03"
    }
    {
      Id = "Moros_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh! {#Prev}Dari dirimu, Tuan Putri, kuanggap itu sebagai sebuah pujian."
      Speaker = "Moros"
      Event = "MorosAboutDoom03"
    }
    {
      Id = "Melinoe_0887"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu {#Emph}memang {#Prev}pujian."
      Speaker = "Melinoe"
      Event = "MorosAboutDoom03"
    }
    {
      Id = "Melinoe_4772"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa saja contoh pekerjaan favorit yang pernah kau dan para saudarimu lakukan? Kematian yang digubah dengan sangat kreatif dan teatrikal, atau semacamnya?"
      Speaker = "Melinoe"
      Event = "MorosAboutDoom04"
    }
    {
      Id = "Moros_0679"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, harus mulai dari mana, ya? Anak-anak yang membantai orang tua mereka adalah trik lama andalan kami; aku agak segan memilih yang terbaik. Lalu ada juga perang saat aku pertama kali memperhatikan Tuan Odysseus. Perang itu membuahkan beberapa mahakarya."
      Speaker = "Moros"
      Event = "MorosAboutDoom04"
    }
    {
      Id = "Melinoe_4773"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagian saat kaum fana tewas dalam cengkeraman rasa sakit dan ketakutan luar biasa, meninggalkan orang-orang tercinta yang meratapi kepergian mereka dengan getir... kau sama sekali tak tergerak oleh semua itu?"
      Speaker = "Melinoe"
      Event = "MorosAboutDoom04"
    }
    {
      Id = "Moros_0680"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami memikul tanggung jawab terhadap alam baka yang jauh lebih penting. Dan lagipula, kaum fana tidak menyadari bahwa pada akhirnya semuanya akan baik-baik saja bagi sebagian besar dari mereka."
      Speaker = "Moros"
      Event = "MorosAboutDoom04"
    }
    {
      Id = "Melinoe_4774"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kita kurang mempromosikan cara kerja Dunia Bawah. Atau setidaknya cara kerjanya yang dulu."
      Speaker = "Melinoe"
      Event = "MorosAboutDoom04"
    }
    {
      Id = "Moros_0681"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Asalkan kaum fana tetap takut pada kita."
      Speaker = "Moros"
      Event = "MorosAboutDoom04"
    }
    {
      Id = "Moros_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suaramu merdu sekali, Tuan Putri. Salah satu dari Tiga Moirai suka bersenandung sambil menenun, tapi suaranya sama sekali tak seperti suaramu."
      Speaker = "Moros"
      Event = "MorosAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_4755"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian besar itu suara Artemis yang menggema begitu lantang di tanah lapang ini, tapi terima kasih. Kami terkadang bernyanyi seperti ini untuk bersiap menyambut malam."
      Speaker = "Melinoe"
      Event = "MorosAboutArtemisSinging01"
    }
    {
      Id = "Moros_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang dewi perburuan dan dirimu tampaknya cukup akrab. Dengan dewa-dewi Olimpus lainnya tidak begitu, benarkah?"
      Speaker = "Moros"
      Event = "MorosAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_4756"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selain Yang Mulia Hermes, aku bertemu sebagian besar dari mereka satu per satu sekitar waktu kau pertama kali muncul."
      Speaker = "Melinoe"
      Event = "MorosAboutArtemisSinging01"
    }
    {
      Id = "Moros_0495"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Banyak kenalan baru, rupanya."
      Speaker = "Moros"
      Event = "MorosAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_0899"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu kau tahu segala hal yang akan terjadi, bukan, Yang Mulia Moros? Sampai belum lama ini, dari yang kudengar. Aku tak bisa membayangkan rasanya..."
      Speaker = "Melinoe"
      Event = "MorosAboutForesight01"
    }
    {
      Id = "Moros_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, bayangkan saja betapa membosankannya itu, selalu tahu apa yang akan terjadi. Tapi sekarang aku tidak berbeda denganmu. Bagaimana kau... bisa bertahan seperti ini? Banyak kejutan yang tak diharapkan, tapi bisa juga ada kejutan yang menyenangkan, kan?"
      Speaker = "Moros"
      Event = "MorosAboutForesight01"
    }
    {
      Id = "Melinoe_0900"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa itu terbantu karena aku memang tak pernah merasakan cara lain. Ini pasti sangat berat bagimu."
      Speaker = "Melinoe"
      Event = "MorosAboutForesight01"
    }
    {
      Id = "Moros_0058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah! {#Prev}Ya, memang."
      Speaker = "Moros"
      Event = "MorosAboutForesight01"
    }
    {
      Id = "Melinoe_0901"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada masalah, Yang Mulia Moros? Kau tampak lebih gelisah dari biasanya. Jika ada kabar buruk lain yang bebas kau ceritakan, aku siap mendengarkan."
      Speaker = "Melinoe"
      Event = "MorosAboutForesight02"
    }
    {
      Id = "Moros_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}haha! {#Prev}Bukan hal seperti itu, setidaknya untuk saat ini, Tuan Putri. Hanya saja... perasaan ketidakpastian ini. Bukan hanya dalam gambaran besar, bahkan dari satu malam ke malam berikutnya... Aku masih belum terbiasa."
      Speaker = "Moros"
      Event = "MorosAboutForesight02"
    }
    {
      Id = "Melinoe_0902"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa ada keindahan dalam hal yang tak terduga. Namun mereka yang tak pernah memiliki karunia penglihatan masa depan pun bergulat dengan hal yang sama sepertimu. Bagiku, memusatkan pikiran pada masa kini sangat membantu. Berada di sini, saat ini juga."
      Speaker = "Melinoe"
      Event = "MorosAboutForesight02"
    }
    {
      Id = "Moros_0060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masa kini... terima kasih, Tuan Putri..."
      Speaker = "Moros"
      Event = "MorosAboutForesight02"
    }
    {
      Id = "Moros_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah mencoba saranmu sebelumnya, untuk memusatkan pikiran pada masa kini. Ternyata cukup sulit, karena... pikiranku selalu saja melayang ke berbagai kemungkinan hasil yang buruk."
      Speaker = "Moros"
      Event = "MorosAboutForesight03"
    }
    {
      Id = "Melinoe_0903"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham betul perasaan itu. Kita juga harus mempertimbangkan kemungkinan hasil yang baik secara berdampingan, lalu merencanakannya. Kemudian, pada titik tertentu, yang bisa kita lakukan hanyalah berharap..."
      Speaker = "Melinoe"
      Event = "MorosAboutForesight03"
    }
    {
      Id = "Moros_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berharap... Aku jauh lebih menyukai kepastian. Rasanya aneh mengingat bagi orang lain, para saudariku, Sang Takdir, melambangkan kebetulan belaka. Hal-hal di luar kendali seseorang. Padahal bagiku, mereka membuat segalanya begitu jelas... Aku lebih suka memercayai kepastian daripada sekadar berharap."
      Speaker = "Moros"
      Event = "MorosAboutForesight03"
    }
    {
      Id = "Melinoe_0904"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bisa melakukan keduanya."
      Speaker = "Melinoe"
      Event = "MorosAboutForesight03"
    }
    {
      Id = "Moros_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada begitu banyak hal yang harus kupelajari di sini! Nyonya Hecate cukup bermurah hati untuk mengajariku sedikit tentang ramuan herbal dan sihir kalian. Sebuah pencarian abadi! Aku memulainya agak terlambat."
      Speaker = "Moros"
      Event = "MorosAboutWitchcraft01"
    }
    {
      Id = "Melinoe_0905"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ingin menjadi penyihir, Yang Mulia Moros? Mungkin kapan-kapan aku bisa memberimu beberapa petunjuk."
      Speaker = "Melinoe"
      Event = "MorosAboutWitchcraft01"
    }
    {
      Id = "Moros_0064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, dengan senang hati aku menerimanya."
      Speaker = "Moros"
      Event = "MorosAboutWitchcraft01"
    }
    {
      Id = "Moros_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau tidak keberatan aku bertanya, Tuan Putri: Apakah kau pernah mati sebelumnya? Bukan dalam artian kaum fana, hanya saja... kau tampak memiliki kegigihan luar biasa pada saat-saat yang bahkan tak sanggup dihadapi sebagian besar dewa."
      Speaker = "Moros"
      Event = "MorosAboutDeath01"
    }
    {
      Id = "Melinoe_2076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak boleh kehilangan kesadaranku di luar sana. Kepala Sekolah mengajariku untuk selalu kembali ke dalam bayang-bayang dengan sisa tenaga terakhirku. Aku mempelajarinya dengan cara yang berat, tapi aku berhasil memahaminya."
      Speaker = "Melinoe"
      Event = "MorosAboutDeath01"
    }
    {
      Id = "Moros_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu terlihat jelas. Sungguh luar biasa, bisa bertemu seseorang yang sama-sama terbiasa dengan kematian maupun kehidupan. Aku benar-benar bisa melihatnya dari matamu."
      Speaker = "Moros"
      Event = "MorosAboutDeath01"
    }
    {
      Id = "Melinoe_2077"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan masalah besar."
      Speaker = "Melinoe"
      Event = "MorosAboutDeath01"
    }
    {
      Id = "Melinoe_2087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Moros, Anda pasti tahu sesuatu tentang Senjata Nokturnal. Jadi, ibu dan saudari-saudari Anda bekerja sama menciptakan senjata-senjata ini hanya untuk digunakan di saat genting? Dan mempercayakannya kepada Kepala Sekolah?"
      Speaker = "Melinoe"
      Event = "MorosAboutWeapons01"
    }
    {
      Id = "Moros_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Nyx paham betul sifat para dewa Olympus yang plinplan serta senjata tempaan Takdir yang mereka pakai untuk menyegel para Titan. Beliau menginginkan tandingannya yang hanya akan bangkit jika alam ini benar-benar dilanda kekacauan."
      Speaker = "Moros"
      Event = "MorosAboutWeapons01"
    }
    {
      Id = "Melinoe_2088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa seharusnya ada set senjata lain yang ditempa untuk mengawasi senjata-senjata ini. Lalu satu set lagi untuk mengawasi senjata {#Emph}itu{#Prev}, dan seterusnya."
      Speaker = "Melinoe"
      Event = "MorosAboutWeapons01"
    }
    {
      Id = "Moros_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang Anda sedang melawak, Tuan Putri."
      Speaker = "Moros"
      Event = "MorosAboutWeapons01"
    }
    {
      Id = "Melinoe_2089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tidak bercanda."
      Speaker = "Melinoe"
      Event = "MorosAboutWeapons01"
    }
    {
      Id = "Melinoe_3155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir Anda tahu sedikit tentang Senjata Nokturnal, Lord Moros. Tapi hubungan Anda dengan Ygnium, sungguh tak kusangka sama sekali. Anda sendiri pernah memegang Api Bayangan! Aku mengungkap suatu Aspek dari senjata itu yang tak diragukan lagi adalah milik Anda."
      Speaker = "Melinoe"
      Event = "MorosAboutMorosAspect01"
    }
    {
      Id = "Moros_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Putri, kurasa Anda tidak mengatakan ini hanya untuk berkelakar, jadi tolong percayalah bahwa aku belum pernah menggunakan Api tersebut sebelumnya; aku hanya mengetahuinya dari reputasinya. Bisakah Anda yakin bahwa Aspek itu milikku? Saudaraku ada banyak..."
      Speaker = "Moros"
      Event = "MorosAboutMorosAspect01"
    }
    {
      Id = "Melinoe_3156"
      InheritFrom = "BaseNarrative"
      DisplayName = "A... ya, kupikir memang begitu! Senjata Nokturnal terikat dengan para penggunanya sedemikian rupa sehingga ikatan mereka dengan pengguna lain menjadi hampir seperti ingatan bersama. Meski..."
      Speaker = "Melinoe"
      Event = "MorosAboutMorosAspect01"
    }
    {
      Id = "Moros_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Meski, sekilas ingatan ini bisa berasal dari pengguna di masa lalu, maupun masa depan, benar begitu? Jadi mungkin saja aku akan memegang Api itu di era lain saat alam ini membutuhkannya. Aku... percaya para Takdir pasti ingin aku mengetahuinya lebih awal."
      Speaker = "Moros"
      Event = "MorosAboutMorosAspect01"
    }
    {
      Id = "Melinoe_3157"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, {#Emph}ehm... {#Prev}kejutan...!"
      Speaker = "Melinoe"
      Event = "MorosAboutMorosAspect01"
    }
    {
      Id = "Melinoe_4775"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kapan Anda ingin mulai belajar menggunakan Api Bayangan, Lord Moros? Mungkin kita bisa latihan bersama suatu saat nanti."
      Speaker = "Melinoe"
      Event = "MorosAboutMorosAspect02"
    }
    {
      Id = "Moros_0688"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terdengar sangat menarik, tapi kurasa aku tak pantas meminjam Senjata Malam. Aku tak ingin membiasakan diri membangkang saudari-saudariku, meski mereka sedang tidak ada di sini."
      Speaker = "Moros"
      Event = "MorosAboutMorosAspect02"
    }
    {
      Id = "Melinoe_4776"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, menurut Anda apa alasan aku akhirnya menyerahkan Api itu kepada Anda nanti? Atau mungkin bukan aku yang memberikannya..."
      Speaker = "Melinoe"
      Event = "MorosAboutMorosAspect02"
    }
    {
      Id = "Moros_0689"
      InheritFrom = "BaseNarrative"
      DisplayName = "Situasi yang mirip dengan Anda; orang-orang yang kupedulikan sedang dalam bahaya, dan Api itu ada di hadapanku. Aku akan mengangkatnya tanpa ragu."
      Speaker = "Moros"
      Event = "MorosAboutMorosAspect02"
    }
    {
      Id = "Melinoe_4777"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan datang menyelamatkanku!"
      Speaker = "Melinoe"
      Event = "MorosAboutMorosAspect02"
    }
    {
      Id = "Moros_0690"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan itu maksudku."
      Speaker = "Moros"
      Event = "MorosAboutMorosAspect02"
    }
    {
      Id = "Moros_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artefak yang kuberikan kepada Anda... itu bisa menunda hal yang tak terelakkan. Mirip seperti {#Emph}Penangkal Keniscayaan{#Prev}... hanya saja, cara kerjanya berlawanan. Terlepas dari kerumitan teknis itu, kuharap benda tersebut bisa memberi manfaat."
      Speaker = "Moros"
      Event = "MorosAboutKeepsake01"
    }
    {
      Id = "Melinoe_2090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yakin pasti sangat berguna. Terkadang yang kubutuhkan hanyalah sedikit waktu tambahan. Jadi jika aku menggunakan Semat milik Anda, Anda bisa menemaniku di malam-malam perjalananku?"
      Speaker = "Melinoe"
      Event = "MorosAboutKeepsake01"
    }
    {
      Id = "Moros_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayangnya hanya di saat-saat terakhir malam Anda. Tentu saja, kita juga punya malam-malam di sini..."
      Speaker = "Moros"
      Event = "MorosAboutKeepsake01"
    }
    {
      Id = "Melinoe_2091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu sampai jumpa lagi nanti."
      Speaker = "Melinoe"
      Event = "MorosAboutKeepsake01"
    }
    {
      Id = "Moros_0380"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mulai sangat menghargai kebersamaan kita, Tuan Putri, jadi ada sesuatu yang harus Anda ketahui tentang diriku jika kelak ini menyangkut kita... Para Takdir telah menjodohkanku dengan yang lain."
      Speaker = "Moros"
      Event = "MorosAboutArrangement01"
    }
    {
      Id = "Melinoe_4597"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dijodohkan dengan yang lain, maksudnya, Anda sudah bertunangan? Kalau begitu, kurasa selamat pantas diucapkan! Tapi dengan siapa, kalau boleh kutahu...? Jika para Takdir sempat membocorkannya."
      Speaker = "Melinoe"
      Event = "MorosAboutArrangement01"
    }
    {
      Id = "Moros_0381"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, tanpa bermaksud terlalu blak-blakan, aku menyimpulkan bahwa dia bukanlah Anda. Para Takdir mendeskripsikannya bagai fajar pagi, yang kilaunya menembus kegelapan dan menyingkap keindahan dunia. Anda... yah, berbeda dari itu."
      Speaker = "Moros"
      Event = "MorosAboutArrangement01"
    }
    {
      Id = "Melinoe_4598"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh... kurasa itu mungkin Eos. Aku cukup mengenal saudarinya, Selene sang Rembulan, tapi tidak begitu akrab dengan Sang Fajar. Apakah Anda diharuskan mencarinya?"
      Speaker = "Melinoe"
      Event = "MorosAboutArrangement01"
    }
    {
      Id = "Moros_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepertinya aku tidak tahu. Dia dan aku ditakdirkan bertemu suatu saat nanti, tapi tampaknya belum saatnya. Saat pertama kali Anda dan aku bertemu, kupikir mungkin... aku bisa menemukannya di tempat ini."
      Speaker = "Moros"
      Event = "MorosAboutArrangement01"
    }
    {
      Id = "Melinoe_4599"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di sini gelap gulita; kurasa Anda tak akan menemukannya."
      Speaker = "Melinoe"
      Event = "MorosAboutArrangement01"
    }
    {
      Id = "Moros_0383"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku menyadarinya sekarang."
      Speaker = "Moros"
      Event = "MorosAboutArrangement01"
    }
    {
      Id = "Melinoe_4627"
      InheritFrom = "BaseNarrative"
      DisplayName = "Soal dewi yang dijodohkan dengan Anda itu. Jika dia benar-benar Eos sang penjelmaan Fajar, mungkin aku bisa memfasilitasi perkenalan kalian lewat saudarinya, jika Anda mau?"
      Speaker = "Melinoe"
      Event = "MorosAboutArrangement02"
    }
    {
      Id = "Moros_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}ehm{#Prev}, yah, aku tak ingin merepotkan Anda, ataupun Selene. Anda memiliki tugas yang amat penting, dan aku tahu Sang Rembulan sendiri sedang membantu Anda."
      Speaker = "Moros"
      Event = "MorosAboutArrangement02"
    }
    {
      Id = "Melinoe_4628"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi, Anda bilang sempat mengira bisa menemukannya di sini. Mungkin Tiga Takdir tahu bahwa Anda akhirnya akan mendatangi kami, dan bahwa akulah yang akan menuntun Anda menemui pujaan hati Anda?"
      Speaker = "Melinoe"
      Event = "MorosAboutArrangement02"
    }
    {
      Id = "Moros_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Putri, jika ramalan tentang diriku dan sosok yang dijanjikan kepadaku itu belum muncul di Daftar Takdir, maka sungguh Anda tak perlu ikut campur."
      Speaker = "Moros"
      Event = "MorosAboutArrangement02"
    }
    {
      Id = "Melinoe_4629"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anda terdengar sama sekali tidak bersemangat. Apakah Anda tidak ingin bertemu dengan dewi itu suatu hari nanti?"
      Speaker = "Melinoe"
      Event = "MorosAboutArrangement02"
    }
    {
      Id = "Moros_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami {#Emph}terikat {#Prev}untuk bertemu; apakah aku menginginkannya atau tidak, itu sama sekali tak ada bedanya."
      Speaker = "Moros"
      Event = "MorosAboutArrangement02"
    }
    {
      Id = "Melinoe_4630"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi... ya terserah Anda."
      Speaker = "Melinoe"
      Event = "MorosAboutArrangement02"
    }
    {
      Id = "Moros_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anda menaruh perhatian pada dewi yang konon terikat denganku itu, dengan anggapan bahwa dia adalah Eos, sang penjelmaan Fajar. Sejujurnya, saat para Takdir pertama kali memberitahuku tentangnya, aku malah merasa cukup frustrasi."
      Speaker = "Moros"
      Event = "MorosAboutArrangement03"
    }
    {
      Id = "Melinoe_4631"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mungkin juga akan merasa frustrasi. Apa saudarimu meramalkan ikatan ini, atau sengaja mengaturnya? Mungkin mereka ingin menyatukan keluargamu yang perkasa dengan kaum Titaness."
      Speaker = "Melinoe"
      Event = "MorosAboutArrangement03"
    }
    {
      Id = "Moros_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seperti biasa, mereka hanya membeberkan sedikit. Tapi dari cara mereka terus-menerus mendeskripsikan sang dewi, atau Titaness ini, dan memberitahuku betapa bahagianya diriku nanti... itulah pertama kalinya aku meragukan kebijaksanaan mereka. Tentu saja bukan secara {#Emph}terang-terangan{#Prev}."
      Speaker = "Moros"
      Event = "MorosAboutArrangement03"
    }
    {
      Id = "Melinoe_4632"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin niat mereka baik, tapi... apa yang ingin kaulakukan sekarang?"
      Speaker = "Melinoe"
      Event = "MorosAboutArrangement03"
    }
    {
      Id = "Moros_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika takdirku memang harus bersama Sang Fajar, biarlah terjadi. Tapi aku takkan memaksakan hasil itu terwujud sekarang. Aku jauh lebih memilih untuk tetap di sini... jika kau berkenan menerimaku."
      Speaker = "Moros"
      Event = "MorosAboutArrangement03"
    }
    {
      Id = "Melinoe_4633"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pilihan itu sudah sepatutnya berada di tanganmu."
      Speaker = "Melinoe"
      Event = "MorosAboutArrangement03"
    }
    {
      Id = "Moros_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salam, Tuan Putri. Aku, {#Emph}um. {#Prev}Kuharap obrolan kita baru-baru ini tidak membuatmu merasa, {#Emph}eh{#Prev}, begitulah..."
      Speaker = "Moros"
      Event = "MorosAboutRelationship00"
    }
    {
      Id = "Melinoe_4624"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa sebenarnya, Tuan Moros? Akhir-akhir ini aku sangat menikmati percakapan kita, jadi kau tak perlu khawatir. Aku pasti akan berterus terang jika merasa ada yang salah. Kuharap kau juga bersikap sama."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship00"
    }
    {
      Id = "Moros_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti akan kulakukan... hanya saja, dalam hal ini, kurasa aku telah salah menangkap sesuatu... Kukira {#Emph}kau {#Prev}mungkin berpikir begitu, karena, harus kuakui aku masih cukup canggung dalam urusan semacam ini."
      Speaker = "Moros"
      Event = "MorosAboutRelationship00"
    }
    {
      Id = "Melinoe_4625"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengalamanku sendiri dalam hal seperti ini juga sangat minim. Selama kita menjalaninya bersama dan saling belajar, kurasa tak masalah."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship00"
    }
    {
      Id = "Moros_0419"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa begitu juga. {#Emph}Um{#Prev}, semoga malammu menyenangkan."
      Speaker = "Moros"
      Event = "MorosAboutRelationship00"
    }
    {
      Id = "Melinoe_4626"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship00"
    }
    {
      Id = "Moros_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku terus memikirkan perkataanmu waktu di kedai minum, Tuan Putri. Soal menemukan sumber motivasi diri, baik lewat hasil yang membesarkan hati maupun lewat cobaan berat. Atau lewat lebih banyak Ambrosia."
      Speaker = "Moros"
      Event = "MorosAboutRelationship01"
    }
    {
      Id = "Melinoe_4634"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, soal Ambrosia tadi aku cuma bercanda. Hanya saja, terkadang aku takjub betapa cobaan dan kepahitan justru lebih membakar semangatku ketimbang ungkapan keyakinan dan dukungan."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship01"
    }
    {
      Id = "Moros_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Sebagai perwujudan dari cobaan dan kepahitan itu sendiri, aku menghargai keterbukaan pikiranmu. Tapi sejujurnya Ambrosia juga pendorong semangat yang luar biasa. Kuharap kita bisa menikmatinya bersama lagi suatu saat nanti."
      Speaker = "Moros"
      Event = "MorosAboutRelationship01"
    }
    {
      Id = "Melinoe_2073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah pasti."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship01"
    }
    {
      Id = "Moros_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada pertanyaan yang agak canggung, Tuan Putri... seperti apa adat di sini untuk menyatakan perasaan kasih sayang? Aku sempat mencoba bertanya pada Dora duluan, tapi sarannya sama sekali tak praktis."
      Speaker = "Moros"
      Event = "MorosAboutRelationship02"
    }
    {
      Id = "Melinoe_2074"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Emm... {#Prev}pernyataan kasih sayang... Sayangnya kabar buruk, tak ada tradisi semacam itu di sini. Kau tinggal memilih saat yang tepat untuk mencurahkannya, lalu berharap perasaanmu terbalaskan."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship02"
    }
    {
      Id = "Moros_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu, ya. Kalau begitu, aku harus memilih momennya dengan sangat berhati-hati. Terima kasih atas informasinya, dan juga kesabaranmu."
      Speaker = "Moros"
      Event = "MorosAboutRelationship02"
    }
    {
      Id = "Melinoe_2075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh. Sama-sama, kapan pun!"
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship02"
    }
    {
      Id = "Melinoe_4619"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Moros... {#Emph}emm{#Prev}, bagaimana kabarmu malam ini?"
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship03"
    }
    {
      Id = "Moros_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Putri, aku... tadinya hendak menanyakan hal yang sama. Bagiku, rasanya... yah, seolah-olah aku sedang berada di dalam mimpi. Jenis mimpi indah yang sesekali pernah kudengar kisahnya. Tapi, bagaimana denganmu...?"
      Speaker = "Moros"
      Event = "MorosAboutRelationship03"
    }
    {
      Id = "Melinoe_4620"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabarku sangat baik. Mimpi-mimpiku... sering kali menghantuiku. Walau terkadang aku juga pernah merasakan mimpi indah. Dan kau benar, rasanya mirip seperti saat ini... hanya saja perasaan itu biasanya tak pernah bertahan lama."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship03"
    }
    {
      Id = "Moros_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Barangkali itulah yang akan membedakan apa yang kita miliki; bahwa ini {#Emph}bisa {#Prev}bertahan lama. Jika kau menghendakinya, tentu saja."
      Speaker = "Moros"
      Event = "MorosAboutRelationship03"
    }
    {
      Id = "Melinoe_4621"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita lihat saja nanti bersama-sama."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship03"
    }
    {
      Id = "Moros_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Putri! Aku... tadinya mau menanyakan hal yang sama padamu. Kabarku sendiri... baik, tergantung pada bagaimana jawabanmu nanti. Bagaimanapun juga, aku sangat bersyukur kita sempat mengobrol seperti kemarin."
      Speaker = "Moros"
      Event = "MorosAboutRelationship03_B"
    }
    {
      Id = "Melinoe_4622"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga bersyukur. Jadi... kita tetap berteman dekat, kan?"
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship03_B"
    }
    {
      Id = "Moros_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja. Meski, dengan pekerjaanku selama ini, aku tak punya banyak teman dekat, jadi... maafkan aku jika nanti bersikap canggung."
      Speaker = "Moros"
      Event = "MorosAboutRelationship03_B"
    }
    {
      Id = "Melinoe_4623"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita usahakan yang terbaik."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship03_B"
    }
    {
      Id = "Melinoe_4694"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pernah bilang saudarimu Klotho menyingkapkan bahwa kita akan bertemu, meski kau sudah tahu dirimu telah dijodohkan dengan sosok lain. Kurasa aku telah membuat segalanya rumit bagimu..."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship04"
    }
    {
      Id = "Moros_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku sangat bersyukur kau melakukannya. Awalnya aku tak berharap apa-apa dari pertemuan kita, tapi sejujurnya, aku sudah tertarik padamu sejak awal. Tepatnya bahkan sebelum kita menghabiskan... katakanlah, lima botol Nektar."
      Speaker = "Moros"
      Event = "MorosAboutRelationship04"
    }
    {
      Id = "Melinoe_4695"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya karena kau tertarik padaku, bukan berarti kau takkan terpikat juga pada Eos saat kalian akhirnya bertemu nanti. Dari segala yang kudengar, terbitnya Sang Fajar itu luar biasa jelita."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship04"
    }
    {
      Id = "Moros_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Putri, jangan kita bicarakan soal Sang Fajar itu lagi. Mungkin saudariku tahu apa yang akan menimpaku kelak, tapi aku semakin curiga bahwa mereka sebenarnya tidak tahu apa-apa. Lagipula, mereka sama sekali tak memperingatkanku soal kecantikan{#Emph}mu{#Prev}."
      Speaker = "Moros"
      Event = "MorosAboutRelationship04"
    }
    {
      Id = "Melinoe_4696"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah{#Prev}, kejutan, kan!"
      Speaker = "Melinoe"
      Event = "MorosAboutRelationship04"
    }
    {
      Id = "Moros_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Putri, kurasa perlu kukatakan, aku tahu ada sosok-sosok lain yang dekat denganmu, dan kurasa kau sudah mengenal mereka jauh lebih lama dariku. Sebaliknya, aku tak punya siapa-siapa lagi. Tinggal bersama saudariku membuatku hampir tak punya kesempatan untuk itu."
      Speaker = "Moros"
      Event = "MorosAboutRelationships01"
    }
    {
      Id = "Melinoe_4749"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa memahaminya. Banyak dewi atau dewa di luar sana yang pasti sangat bahagia jika memilikimu di sisi mereka, Moros. Tapi jika untuk sekarang aku bisa memilikimu seorang diri, aku sungguh tak keberatan."
      Speaker = "Melinoe"
      Event = "MorosAboutRelationships01"
    }
    {
      Id = "Moros_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku senang kau tidak keberatan."
      Speaker = "Moros"
      Event = "MorosAboutRelationships01"
    }
    {
      Id = "Melinoe_3146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih sudah mengunjungiku tadi malam, Yang Mulia Moros. Jadi, secara hipotetis, seandainya aku menyelesaikan mantra tertentu yang entah bagaimana melonggarkan cengkeraman Tiga Fates atas hak kelahiranku... seberapa marahnya mereka?"
      Speaker = "Melinoe"
      Event = "MorosAboutSurfacePenaltyCure01"
    }
    {
      Id = "Moros_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong dipahami, Putri, bahwa aku tidak berwenang memberikan saran mengenai hal-hal semacam itu, bahkan secara hipotetis sekali pun. Kuharap penyampaianku ini sudah cukup gamblang?"
      Speaker = "Moros"
      Event = "MorosAboutSurfacePenaltyCure01"
    }
    {
      Id = "Melinoe_3147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan kata lain, kita sama sekali tidak boleh membicarakan hal ini, dan aku menanggung seluruh risiko atas tindakanku terkait mantra terlarang apa pun yang telah kupelajari."
      Speaker = "Melinoe"
      Event = "MorosAboutSurfacePenaltyCure01"
    }
    {
      Id = "Moros_0300"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, tepat seperti itu."
      Speaker = "Moros"
      Event = "MorosAboutSurfacePenaltyCure01"
    }
    {
      Id = "Moros_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putri, secara resmi aku tidak dapat membenarkan tindakanmu. Kunjunganmu ke permukaan melanggar ketentuan yang telah ditetapkan Fates bagi garis keturunan ayahmu, dan kau menanggung risiko apa pun yang mereka anggap setimpal."
      Speaker = "Moros"
      Event = "MorosAboutSurfacePenaltyCure02"
    }
    {
      Id = "Melinoe_3148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, tapi secara {#Emph}tidak{#Prev} resmi, bagaimana, Yang Mulia Moros? Jika kau mengizinkan dirimu membicarakannya kali ini saja. Ataukah kita hanya boleh berbicara jujur saat aku berada di ambang kematian?"
      Speaker = "Melinoe"
      Event = "MorosAboutSurfacePenaltyCure02"
    }
    {
      Id = "Moros_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percakapan kita sudah pasti jauh lebih aman dengan cara seperti itu, tapi secara {#Emph}tidak{#Prev} resmi... Aku kagum dengan pencapaianmu. Barangkali tinggal begitu dekat dengan permukaan membuatmu terbiasa, tapi tetap saja... Aku sempat ragu hal itu mungkin dilakukan."
      Speaker = "Moros"
      Event = "MorosAboutSurfacePenaltyCure02"
    }
    {
      Id = "Melinoe_3149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga Fates mengampuni pelanggaranku."
      Speaker = "Melinoe"
      Event = "MorosAboutSurfacePenaltyCure02"
    }
    {
      Id = "Moros_0303"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pula denganku..."
      Speaker = "Moros"
      Event = "MorosAboutSurfacePenaltyCure02"
    }
    {
      Id = "Moros_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sejauh mana kau berhasil melangkah tadi malam, Putri? Kau pergi cukup lama. Aku merasakan ketakutan dan kegemparan yang kian memuncak di udara, bahkan sempat mendengar desas-desusnya."
      Speaker = "Moros"
      Event = "MorosAboutChronosBossW01"
    }
    {
      Id = "Melinoe_3150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika desas-desus itu mengatakan bahwa aku mencapai kedalaman Tartarus, menyusup ke Griya ayahku yang dirampas, menghadapi Chronos di sana, dan menundukkannya dalam pertempuran, berarti kau mendengarnya dengan benar. Jauh dari kemenangan akhir, memang, tapi tetap sebuah kemajuan."
      Speaker = "Melinoe"
      Event = "MorosAboutChronosBossW01"
    }
    {
      Id = "Moros_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pasti akan menentang siapa pun selain dirimu yang meremehkan kemenangan seperti itu. Bukankah ini bagian yang teramat penting dari tugas yang diamanatkan kepadamu?"
      Speaker = "Moros"
      Event = "MorosAboutChronosBossW01"
    }
    {
      Id = "Melinoe_3151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, memang benar, tapi..."
      Speaker = "Melinoe"
      Event = "MorosAboutChronosBossW01"
    }
    {
      Id = "Moros_0308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu selamat, dan semoga Fates meridai langkahmu selanjutnya."
      Speaker = "Moros"
      Event = "MorosAboutChronosBossW01"
    }
    {
      Id = "Moros_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos tunduk lagi di hadapanmu, hanya itu yang kudengar. Itu pencapaian yang mengesankan, walau... kau bermaksud membunuhnya, padahal dia abadi. Ini tampak seperti paradoks."
      Speaker = "Moros"
      Event = "MorosAboutChronosBossW02"
    }
    {
      Id = "Melinoe_4697"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar. Kematian fana bukanlah akhir segalanya, tapi bangsa fana sering menganggapnya begitu. Saat kami menyerukan {#Emph}Kematian bagi Chronos{#Prev}, kami mengartikannya dalam kemutlakan yang nyata. Betapapun mustahilnya hal itu terdengar."
      Speaker = "Melinoe"
      Event = "MorosAboutChronosBossW02"
    }
    {
      Id = "Moros_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, menaklukkannya setidaknya adalah satu langkah menuju akhir tersebut. Apa yang akan terjadi pada segalanya jika kau berhasil dan Sang Waktu benar-benar tewas? Dunia tanpa Sang Waktu..."
      Speaker = "Moros"
      Event = "MorosAboutChronosBossW02"
    }
    {
      Id = "Melinoe_4698"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dunia tanpa kehancuran dan kebusukan; dunia kita sudah ada sebelum Waktu tercipta dan dapat tetap ada tanpanya."
      Speaker = "Melinoe"
      Event = "MorosAboutChronosBossW02"
    }
    {
      Id = "Moros_0435"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebuah paradoks lainnya, namun tak mustahil benar adanya."
      Speaker = "Moros"
      Event = "MorosAboutChronosBossW02"
    }
    {
      Id = "Moros_0469"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemenangan lain di kedalaman Tartarus... hanya saja sekarang, pertarunganmu menuntutmu melampaui ruang dan waktu, tentu saja dengan bantuan kakekmu. Benar begitu...?"
      Speaker = "Moros"
      Event = "MorosAboutPostEndingChronosBossW01"
    }
    {
      Id = "Melinoe_4808"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, setahu yang kupahami, Yang Mulia Moros. Kepala Sekolah sudah memberitahumu tentang detail baru ini, ya? Nada bicaramu sama sekali tidak terdengar terkejut."
      Speaker = "Melinoe"
      Event = "MorosAboutPostEndingChronosBossW01"
    }
    {
      Id = "Moros_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku meyakinkanmu bahwa ketidakmampuanku untuk terdengar terkejut bukan berarti aku tidak merasakannya. Masih banyak pertempuran semacam ini yang harus kau jalani?"
      Speaker = "Moros"
      Event = "MorosAboutPostEndingChronosBossW01"
    }
    {
      Id = "Melinoe_4809"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapan pun waktu mengizinkan."
      Speaker = "Melinoe"
      Event = "MorosAboutPostEndingChronosBossW01"
    }
    {
      Id = "Moros_0471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, demi banyak kemenanganmu yang akan datang."
      Speaker = "Moros"
      Event = "MorosAboutPostEndingChronosBossW01"
    }
    {
      Id = "Melinoe_0891"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang Mulia Moros... Aku tahu kau tidak bisa membeberkan tenunan takdir para Fates. Tapi, bisakah kau menceritakan sedikit seperti apa watak mereka bertiga?"
      Speaker = "Melinoe"
      Event = "MorosAboutFates01"
    }
    {
      Id = "Moros_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari-saudariku. Mereka... yah, masing-masing adalah dewi yang punya kehendak sendiri. Clotho sang pemintal adalah yang paling banyak bicara dan tegas. Lachesis sedikit lebih ramah; dia yang mengukur panjang benang. Dan Atropos, dia hanya fokus memotongnya."
      Speaker = "Moros"
      Event = "MorosAboutFates01"
    }
    {
      Id = "Melinoe_0892"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti rasanya agak gentar, mengetahui bahwa saudarimu sendiri yang menentukan jalannya setiap kehidupan. Bahkan jalan hidupmu sendiri?"
      Speaker = "Melinoe"
      Event = "MorosAboutFates01"
    }
    {
      Id = "Moros_0052"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan jalan hidupku sendiri."
      Speaker = "Moros"
      Event = "MorosAboutFates01"
    }
    {
      Id = "Melinoe_2998"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tugasku dimulai tepat setelah beredar kabar bahwa Chronos menemukan cara untuk unggul atas Olympus. Kami hanya tidak tahu cara seperti apa. Tapi, kurasa sekarang aku tahu: saudarimu, Tiga Fates... dia berhasil menangkap mereka, kan? Itukah alasanmu berada di sini?"
      Speaker = "Melinoe"
      Event = "MorosAboutFates02"
    }
    {
      Id = "Moros_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau bertanya sembari menegaskan kepadaku bahwa kau sebenarnya sudah tahu. Seharusnya aku ada di sana saat hal itu terjadi. Mungkin Fates tahu aku tidak punya kekuatan untuk melindungi mereka; jadi mereka yang melindungiku."
      Speaker = "Moros"
      Event = "MorosAboutFates02"
    }
    {
      Id = "Melinoe_0894"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa dia menemukan mereka? Apa yang dia inginkan dari mereka?"
      Speaker = "Melinoe"
      Event = "MorosAboutFates02"
    }
    {
      Id = "Moros_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak tahu bagaimana dia menemukan mereka. Hanya segelintir makhluk yang mengetahui keberadaan mereka. Mengenai apa yang dia inginkan dari mereka... dan ini murni dugaanku sendiri... dia pasti berniat memengaruhi tenunan takdir mereka mulai sekarang."
      Speaker = "Moros"
      Event = "MorosAboutFates02"
    }
    {
      Id = "Melinoe_0895"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh..."
      Speaker = "Melinoe"
      Event = "MorosAboutFates02"
    }
    {
      Id = "Melinoe_0896"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang Mulia Moros, kau tadi bilang Chronos akan memengaruhi tenunan para Fates. Maksudmu dia akan mencoba mengubah masa depan? Memaksakan hasil yang menguntungkannya?"
      Speaker = "Melinoe"
      Event = "MorosAboutFates03"
    }
    {
      Id = "Moros_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya. Kurasa dia memang sudah mulai mencoba melakukannya. Sial baginya, Tiga Fates itu agak keras kepala. Aku yakin mereka akan sangat sulit diatur sebagai tawanan."
      Speaker = "Moros"
      Event = "MorosAboutFates03"
    }
    {
      Id = "Melinoe_0897"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa membayangkan Chronos menoleransi pembangkangan, entah dari saudarimu atau siapa pun. Betapa dia membenci mereka! Dulu saat dia digulingkan, itu adalah hasil ramalan takdir..."
      Speaker = "Melinoe"
      Event = "MorosAboutFates03"
    }
    {
      Id = "Moros_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Kalau sekarang, aku merasa tak ada tenunan yang dibuat sama sekali. Tak ada masa depan baru yang diramalkan. Chronos percaya tak ada ramalan yang perlu dia takuti. Tapi, kuyakini ini kesempatan bagimu. Untuk mewujudkan masa depan yang lebih baik bagi kita semua."
      Speaker = "Moros"
      Event = "MorosAboutFates03"
    }
    {
      Id = "Moros_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluargamu sudah menjadi perhatian besar bagi para Fates sejak dulu, bukan? Tepatnya sejak Chronos tahu bahwa dia ditakdirkan digulingkan oleh anak-anaknya sendiri."
      Speaker = "Moros"
      Event = "MorosAboutFates04"
    }
    {
      Id = "Melinoe_2064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebuah ramalan yang justru terwujud hanya karena Chronos mengetahuinya, lalu mati-matian berusaha mencegahnya terjadi. Mungkin aku akan lebih mudah menyelesaikan Daftar Takdir jika aku terus berusaha menggagalkannya setiap saat."
      Speaker = "Melinoe"
      Event = "MorosAboutFates04"
    }
    {
      Id = "Moros_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sarankan jangan terlalu berspekulasi. Kemudian ayah dan paman-pamanmu mengundi untuk membagi kekuasaan dunia. Secara {#Emph}kebetulan{#Prev}, ayahmu malah mendapatkan bagian yang paling tidak diinginkan, bukan?"
      Speaker = "Moros"
      Event = "MorosAboutFates04"
    }
    {
      Id = "Melinoe_2065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin Underworld memang paling cocok untuknya. Jadi sekarang giliran{#Emph}ku{#Prev} untuk memastikan kehendak para Fates terwujud? Itu pun kalau mereka memang merencanakannya sampai sejauh ini."
      Speaker = "Melinoe"
      Event = "MorosAboutFates04"
    }
    {
      Id = "Moros_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka {#Emph}sudah{#Prev} tertangkap, jadi semua ini tak mungkin sepenuhnya sesuai rencana mereka. Namun mereka sangat mengandalkan bantuanmu."
      Speaker = "Moros"
      Event = "MorosAboutFates04"
    }
    {
      Id = "Melinoe_2066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku menghargai kepercayaan mereka."
      Speaker = "Melinoe"
      Event = "MorosAboutFates04"
    }
    {
      Id = "Melinoe_2069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kau bisa begitu yakin tak ada lagi tenunan yang dibuat? Bahwa alih-alih para Fates menentukan jalan hidup kita, pola itu sudah sirna... hanya menyisakan kebetulan yang acak dan membabi buta?"
      Speaker = "Melinoe"
      Event = "MorosAboutFates05"
    }
    {
      Id = "Moros_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah bilang aku yakin... hanya saja aku tak lagi merasakan karya saudariku, dan instingku soal itu terbilang cukup tajam. Tapi, aku juga belum pernah terpisah dari saudariku seperti ini. Rasanya... seperti terombang-ambing tanpa pegangan."
      Speaker = "Moros"
      Event = "MorosAboutFates05"
    }
    {
      Id = "Melinoe_2070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seolah kau tak tahu hendak ke mana. Bagiku, semuanya terasa sama seperti biasa. Tak peduli bagaimana situasinya sekarang. Seberapa besar kendali yang sebenarnya dimiliki para Fates?"
      Speaker = "Melinoe"
      Event = "MorosAboutFates05"
    }
    {
      Id = "Moros_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengaruh mereka luar biasa besar, itu yang bisa kukatakan. Tapi apakah mereka bisa memaksakan setiap tindakanmu, setiap pikiranmu? Tentu saja tidak. Kau memiliki kesadaran. Berbicara denganku barusan adalah pilihanmu sendiri."
      Speaker = "Moros"
      Event = "MorosAboutFates05"
    }
    {
      Id = "Melinoe_2071"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi para Fates tahu kita akan bertemu."
      Speaker = "Melinoe"
      Event = "MorosAboutFates05"
    }
    {
      Id = "Moros_0160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali."
      Speaker = "Moros"
      Event = "MorosAboutFates05"
    }
    {
      Id = "Melinoe_4820"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu ingin menanyakan ini tentang para Fates, Tuan Moros... kenapa harus {#Emph}menenun?{#Prev} Dari sekian banyak cara untuk meramalkan masa depan... maksudku kenapa tidak menggubah balada, atau melukis vas?"
      Speaker = "Melinoe"
      Event = "MorosAboutWeaving01"
    }
    {
      Id = "Moros_0693"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti mengira aku tahu jawabannya, Tuan Putri, tapi berat bagiku untuk mengakui... aku tak pernah sekalipun memikirkannya. Menenun memang hal yang biasa mereka lakukan. Lagi pula tak banyak kegiatan yang pas dilakukan bertiga. Mungkin {#Emph}karena itulah{#Prev}."
      Speaker = "Moros"
      Event = "MorosAboutWeaving01"
    }
    {
      Id = "Melinoe_4821"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya mereka bisa membuat ramalan jauh lebih cepat jika memilih keahlian yang lebih sederhana."
      Speaker = "Melinoe"
      Event = "MorosAboutWeaving01"
    }
    {
      Id = "Moros_0694"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya jangan beri mereka ide apa-apa."
      Speaker = "Moros"
      Event = "MorosAboutWeaving01"
    }
    {
      Id = "Melinoe_0888"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti mengenal Tiga Fates lebih baik dari siapa pun, selain mungkin Nyx sendiri! {#Emph}Ehm{#Prev}, tapi, maafkan aku karena mengungkit tentangnya..."
      Speaker = "Melinoe"
      Event = "MorosAboutNyx01"
    }
    {
      Id = "Moros_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak apa-apa. Para Fates, aku sangat mengenal mereka, tapi Ibu Nyx...? Kami jarang sekali melihatnya. Tugas kami sedemikian rupa sampai-sampai dia sendiri hampir tak pernah ikut campur. Lagipula, ada banyak anak lain yang harus dia urus."
      Speaker = "Moros"
      Event = "MorosAboutNyx01"
    }
    {
      Id = "Melinoe_0889"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku turut sedih mendengarnya. Ibuku seorang Ratu. Kami bahkan belum pernah bertemu sejak aku masih bayi. Kalau dipikir-pikir, sepertinya tak ada seorang pun di sini yang mengenal ibu kandung mereka!"
      Speaker = "Melinoe"
      Event = "MorosAboutNyx01"
    }
    {
      Id = "Moros_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, kita tak bisa menyalahkan para ibu. Kita sebagai anak-anak {#Emph}memang{#Prev} terkadang menyebalkan."
      Speaker = "Moros"
      Event = "MorosAboutNyx01"
    }
    {
      Id = "Melinoe_0890"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heh. {#Prev}Benar juga."
      Speaker = "Melinoe"
      Event = "MorosAboutNyx01"
    }
    {
      Id = "Melinoe_3116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seberapa dekat kau mengenal leluhurmu, Tuan Moros? Aku tak menyangka akan bertemu Chaos Purba, dari sekian banyak entitas. Tapi mereka memanggilku ke wilayah mereka, dan... aku tak begitu paham apa yang mereka inginkan dariku."
      Speaker = "Melinoe"
      Event = "MorosAboutChaos01"
    }
    {
      Id = "Moros_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chaos memanggilmu...? Itu hal yang tak biasa, meski bukan berarti tak pernah terjadi sebelumnya. Dan untuk kali ini, aku bisa membayangkan alasannya. Bagaimanapun juga, Chaos dan Ibu Nyx cukup dekat."
      Speaker = "Moros"
      Event = "MorosAboutChaos01"
    }
    {
      Id = "Melinoe_3117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Chaos sedang mencari putrinya. Mereka memang sempat menyinggung tentang sebuah dilema."
      Speaker = "Melinoe"
      Event = "MorosAboutChaos01"
    }
    {
      Id = "Moros_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini bukan kali pertama mereka menaruh minat pada keluargamu. Atau mengambil tindakan yang kemungkinan besar tak pernah ditakdirkan oleh para Fates sendiri. Menurutku, kau baru saja mendapatkan sekutu baru."
      Speaker = "Moros"
      Event = "MorosAboutChaos01"
    }
    {
      Id = "Melinoe_3118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuharap perkiraanmu benar."
      Speaker = "Melinoe"
      Event = "MorosAboutChaos01"
    }
    {
      Id = "Melinoe_3152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah tahu apa yang terjadi pada para Fates, Tuan Moros. Atau lebih tepatnya, bagaimana Chronos menemukan tempat mereka. Chaos yang menuntun Chronos ke sana. Chaos, tentu saja, kini tampak menyesalinya, dan kurasa tak ada niat buruk di baliknya..."
      Speaker = "Melinoe"
      Event = "MorosAboutChaos02"
    }
    {
      Id = "Moros_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh. Banyak sekali informasi yang harus kucerna. Tapi itu memang cukup masuk akal. Chronos, yang leluasa di Kediaman ayahmu, akhirnya menemukan jalan menuju Chaos, lalu memancing informasi penting itu dari mereka. Kemudian, dia menyergap para Fates, sebagai bagian dari rencana penaklukannya."
      Speaker = "Moros"
      Event = "MorosAboutChaos02"
    }
    {
      Id = "Melinoe_3153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menanggapi semua ini lebih tenang dari dugaanku. Kalau dipikir-pikir, aku belum pernah melihatmu marah."
      Speaker = "Melinoe"
      Event = "MorosAboutChaos02"
    }
    {
      Id = "Moros_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sedang melihatnya sekarang. Hanya saja, amarahku biasanya tak mengubah apa-apa. Jadi sekarang Chaos berusaha memperbaiki kerusakan yang telah terjadi? Chronos berhasil menyingkirkan satu ancaman berupa para Fates, tapi malah memicu ancaman baru. Barangkali itu pertukaran yang ceroboh."
      Speaker = "Moros"
      Event = "MorosAboutChaos02"
    }
    {
      Id = "Melinoe_3154"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Membuat Chaos geram terdengar sangat ceroboh bagiku!"
      Speaker = "Melinoe"
      Event = "MorosAboutChaos02"
    }
    {
      Id = "Moros_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan jika aku lancang, Tuan Putri. Hanya saja... kurasa kau dan Nemesis tidak selalu akur..."
      Speaker = "Moros"
      Event = "MorosAboutNemesis01"
    }
    {
      Id = "Melinoe_0931"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang membuatmu berpikiran begitu, Yang Mulia Moros? Mungkin karena pertengkaran tiada henti kami soal hal-hal sepele?"
      Speaker = "Melinoe"
      Event = "MorosAboutNemesis01"
    }
    {
      Id = "Moros_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan hal sepele jika menyangkut dirimu, atau dalam hal ini, menyangkut dirinya. Aku paham ada perselisihan soal tugasmu. Kau yang terpilih, sementara dia tidak. Benar begitu?"
      Speaker = "Moros"
      Event = "MorosAboutNemesis01"
    }
    {
      Id = "Melinoe_0932"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar. Nemesis berlatih keras, begitu pula aku. Pilihan itu tak pernah berada di tanganku, namun dialah yang menyalahkanku."
      Speaker = "Melinoe"
      Event = "MorosAboutNemesis01"
    }
    {
      Id = "Moros_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepengetahuanku tentang Nemesis, dia sebenarnya menyalahkan dirinya sendiri. Meski begitu, dia melampiaskannya padamu, aku bisa melihatnya. Kalau mau menyalahkan, seharusnya dia menyalahkan Tiga Takdir..."
      Speaker = "Moros"
      Event = "MorosAboutNemesis01"
    }
    {
      Id = "Melinoe_0933"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupikir juga begitu."
      Speaker = "Melinoe"
      Event = "MorosAboutNemesis01"
    }
    {
      Id = "Moros_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan Nemesis belakangan ini tampak berinteraksi dengan cara yang lebih produktif. Kalau boleh tahu, apa yang berubah di antara kalian berdua?"
      Speaker = "Moros"
      Event = "MorosAboutNemesis02"
    }
    {
      Id = "Melinoe_2082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa kami mulai makin terbiasa dengan peran masing-masing dalam semua ini. Dan mungkin Nemesis akhirnya mulai sedikit percaya pada kemampuanku."
      Speaker = "Melinoe"
      Event = "MorosAboutNemesis02"
    }
    {
      Id = "Moros_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu rupanya... meski kurasa ada hal lain. Rasa hormatnya padamu sepertinya bukan hal yang baru tumbuh."
      Speaker = "Moros"
      Event = "MorosAboutNemesis02"
    }
    {
      Id = "Melinoe_2083"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi bagiku sama sekali tak kelihatan."
      Speaker = "Melinoe"
      Event = "MorosAboutNemesis02"
    }
    {
      Id = "Moros_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadinya aku ingin bertanya apa yang dilakukan saudariku Eris di sini, tapi ada pepatah yang mengatakan, {#Emph}ke mana pun Malapetaka pergi, Perselisihan mengekor di belakangnya. {#Prev}Atau sebaliknya, suka ataupun tidak. Apa dia sudah lama di sini?"
      Speaker = "Moros"
      Event = "MorosAboutEris01"
    }
    {
      Id = "Melinoe_3158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia datang dan pergi sesekali, biasanya setelah pertempuran berdarah antara pasukan Chronos dan Olimpus. Kami pertama kali bertemu beberapa waktu lalu. Sempat berlatih bersama sebentar, meski Kepala Sekolah segera menyerah menghadapinya, sesabar apa pun beliau."
      Speaker = "Melinoe"
      Event = "MorosAboutEris01"
    }
    {
      Id = "Moros_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiga Takdir pun menyerah menghadapinya. Mereka memerintahkan agar kami tak pernah berinteraksi, agar aku tak membereskan kekacauannya lagi; meski terkadang dia memancingku untuk bicara. Kuharap dia tidak terlalu mempersulit hidup kalian?"
      Speaker = "Moros"
      Event = "MorosAboutEris01"
    }
    {
      Id = "Melinoe_3159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami masih bisa mengatasinya."
      Speaker = "Melinoe"
      Event = "MorosAboutEris01"
    }
    {
      Id = "Melinoe_3160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris langsung menyerangku saat aku hendak mendekati Gunung Olimpus. Lagipula, siapa yang memberinya Rel Adamas? Senjata yang dulu digunakan untuk membantai para Titan, kini berbalik melawan para dewa..."
      Speaker = "Melinoe"
      Event = "MorosAboutEris02"
    }
    {
      Id = "Moros_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rel Adamas {#Emph}pernah {#Prev}berbalik melawan para dewa sebelumnya. Hanya Tiga Takdir yang tahu tujuan sejati dan akhirnya... namun Eris memilikinya atas titah {#Emph}mereka {#Prev}sendiri. Mungkin sebagai mainan agar dia tetap sibuk."
      Speaker = "Moros"
      Event = "MorosAboutEris02"
    }
    {
      Id = "Melinoe_3161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rupanya agar membuat {#Emph}aku {#Prev}sibuk. Membuatku bertanya-tanya apakah Tiga Takdir benar-benar ingin Chronos dihentikan atau tidak. Apakah kau dan Eris dulu pernah bertarung seperti ini?"
      Speaker = "Melinoe"
      Event = "MorosAboutEris02"
    }
    {
      Id = "Moros_0320"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, tentu saja. Padahal aku sudah berusaha sekuat tenaga untuk menghindarinya."
      Speaker = "Moros"
      Event = "MorosAboutEris02"
    }
    {
      Id = "Moros_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku perhatikan Hypnos sudah tak ada lagi di tempatnya, meski entah sudah sejak kapan. Mungkin Odysseus memindahkannya ke suatu tempat agar dengkurannya tidak terlalu mengganggu."
      Speaker = "Moros"
      Event = "MorosAboutHypnos01"
    }
    {
      Id = "Melinoe_4812"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh bukan, aku yang membangunkannya. Membutuhkan serangkaian proses alkimia yang kian rumit dan penjelajahan alam mimpi, tapi berhasil. Dia langsung bergegas menuju Kediaman Hades dengan agak panik."
      Speaker = "Melinoe"
      Event = "MorosAboutHypnos01"
    }
    {
      Id = "Moros_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali aku melewatkannya! Dari apa yang kuketahui tentang ayahmu, beliau memang sangat menghargai ketepatan waktu. Dan dari apa yang kuketahui tentang saudaraku sang Tidur, dia pasti menyapamu dengan penuh semangat."
      Speaker = "Moros"
      Event = "MorosAboutHypnos01"
    }
    {
      Id = "Melinoe_4813"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa dibilang begitu."
      Speaker = "Melinoe"
      Event = "MorosAboutHypnos01"
    }
    {
      Id = "Moros_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sedang berusaha menahan rasa kagumku pada pahlawan manusia yang terhormat di sebelah sana, Putri. Lawan kita mungkin licik, namun Odysseus tersohor karena kecerdikan siasatnya di atas segalanya!"
      Speaker = "Moros"
      Event = "MorosAboutOdysseus01"
    }
    {
      Id = "Melinoe_2084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pantas saja kau mengenali Sang Ahli Taktik Ulung! Kemungkinan besar dia pernah lolos darimu sekali atau dua kali semasa hidupnya, jika kisah-kisahnya bisa dipercaya."
      Speaker = "Melinoe"
      Event = "MorosAboutOdysseus01"
    }
    {
      Id = "Moros_0174"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, semuanya bisa dipercaya, aku bisa bersaksi."
      Speaker = "Moros"
      Event = "MorosAboutOdysseus01"
    }
    {
      Id = "Moros_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Temanmu Dora... dia sosok yang ceria. Terutama untuk seusianya. Sebagian besar orang mati menjadi sangat lesu seiring berjalannya waktu. Meski kurasa akhir-akhir ini suasananya memang lebih ramai."
      Speaker = "Moros"
      Event = "MorosAboutDora01"
    }
    {
      Id = "Melinoe_2078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dora tampaknya cukup tertarik padamu, Yang Mulia Moros. Anggap saja rasa penasaran yang tak wajar. Kau menyebut soal usianya... dia tampaknya sama sekali tak ingat rincian semacam itu. Tapi, kau bisa langsung mengetahuinya?"
      Speaker = "Melinoe"
      Event = "MorosAboutDora01"
    }
    {
      Id = "Moros_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya caraku sendiri. Dora itu... yah, dia memang bukan yang tertua di sini, namun dia sudah ada lebih lama daripada kebanyakan orang. Hanya sebatas itu yang aman untuk kubocorkan."
      Speaker = "Moros"
      Event = "MorosAboutDora01"
    }
    {
      Id = "Melinoe_2079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu ya."
      Speaker = "Melinoe"
      Event = "MorosAboutDora01"
    }
    {
      Id = "Moros_0490"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya sesuatu telah terjadi pada temanmu Dora. Dia belakangan ini tak begitu bersemangat melontarkan celetukan atau merasuki barang-barangku. Apa dia baik-baik saja?"
      Speaker = "Moros"
      Event = "MorosAboutDoraMemories01"
    }
    {
      Id = "Melinoe_4753"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, kurasa begitu. Ada sesuatu yang mengganjal pikirannya selama beberapa waktu yang akhirnya mulai ia selesaikan. Mungkin dia akan menceritakan lebih banyak kepadamu nanti."
      Speaker = "Melinoe"
      Event = "MorosAboutDoraMemories01"
    }
    {
      Id = "Moros_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku mungkin sudah tahu. Yah, dia memang jiwa yang tua namun kuat. Dan beruntung memiliki kawan sepertimu. Apa menurutmu ada sesuatu yang bisa kulakukan untuk membantu?"
      Speaker = "Moros"
      Event = "MorosAboutDoraMemories01"
    }
    {
      Id = "Melinoe_4754"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berpura-puralah ketakutan saat dia mengganggumu. Dia sangat suka itu."
      Speaker = "Melinoe"
      Event = "MorosAboutDoraMemories01"
    }
    {
      Id = "Moros_0492"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia memang sudah sering membuatku terkejut sebelumnya..."
      Speaker = "Moros"
      Event = "MorosAboutDoraMemories01"
    }
    {
      Id = "Melinoe_2085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengingat kau tampaknya mengenal Odysseus dengan baik, kau pasti juga mengenal Komandan Schelemeus yang pemberani, bukan? Pemberani dan rendah hati, sebab aku nyaris tak tahu apa-apa tentang masa lalunya."
      Speaker = "Melinoe"
      Event = "MorosAboutSkelly01"
    }
    {
      Id = "Moros_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Schelemeus{#Prev}, katamu...? Aku tak kenal siapa pun dengan nama itu. Dan ingatanku tak pernah salah. Mungkin dia berasal dari negeri yang jauh, yang dinaungi oleh dewanya sendiri yang aneh..."
      Speaker = "Moros"
      Event = "MorosAboutSkelly01"
    }
    {
      Id = "Melinoe_2086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak, itu mustahil..."
      Speaker = "Melinoe"
      Event = "MorosAboutSkelly01"
    }
    {
      Id = "Moros_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah bersayap yang kau ajak bicara di beberapa malam itu... Aku ingat perkaranya, dan aku terkejut seorang pemuda lugu yang mati terlalu cepat bisa sampai ke mari. Apakah dia berguna bagi perjuanganmu?"
      Speaker = "Moros"
      Event = "MorosAboutIcarus01"
    }
    {
      Id = "Melinoe_4757"
      InheritFrom = "BaseNarrative"
      DisplayName = "Icarus bukan sekadar pion pembantu. Dia murid Daedalus yang agung, sekaligus sosok yang berharga bagiku. Kurasa dia mungkin masih mengingatmu juga."
      Speaker = "Melinoe"
      Event = "MorosAboutIcarus01"
    }
    {
      Id = "Moros_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kematian manusia fana kerap membuat mereka melupakanku, meski tak selalu begitu. Aku lega Icarus tidak membiarkan cara kematiannya menentukan sisa keberadaannya. Apa kau menyarankan agar aku menyapanya?"
      Speaker = "Moros"
      Event = "MorosAboutIcarus01"
    }
    {
      Id = "Melinoe_4758"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin lebih baik biarkan dia sendiri saja."
      Speaker = "Melinoe"
      Event = "MorosAboutIcarus01"
    }
    {
      Id = "Moros_0498"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memang biasanya selalu begitu."
      Speaker = "Moros"
      Event = "MorosAboutIcarus01"
    }
    {
      Id = "Melinoe_2080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Moros, aku punya teman yang tinggal di hutan bernama Arachne. Ceritanya panjang, tapi dia terkena kutukan dahsyat yang... mengubahnya menjadi laba-laba. Apakah kau berurusan dengan hal semacam kutukan?"
      Speaker = "Melinoe"
      Event = "MorosAboutArachne01"
    }
    {
      Id = "Moros_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingat perkara Arachne. Aku tidak tahu apa yang terjadi padanya setelah metamorfosis itu, jadi... menarik rasanya mengetahui kalian berteman. Tapi sayangnya... kutukan bukanlah keahlianku."
      Speaker = "Moros"
      Event = "MorosAboutArachne01"
    }
    {
      Id = "Melinoe_2081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyebutnya {#Emph}perkara Arachne. {#Prev}Dia dianggap penenun terhebat di dunia, melampaui para dewa... bahkan melampaui para {#Emph}Fates? {#Prev}Mungkin saingan yang tidak diharapkan...?"
      Speaker = "Melinoe"
      Event = "MorosAboutArachne01"
    }
    {
      Id = "Moros_0170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Bisa jadi."
      Speaker = "Moros"
      Event = "MorosAboutArachne01"
    }
    {
      Id = "Melinoe_3599"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti kenal Titan Prometheus. Aku menghadapinya di Olympus. Tak heran sekarang dia melawan para dewa, setelah menemui ajalnya lalu hidup kembali... tak seperti kaum fana yang konon sangat dia sayangi."
      Speaker = "Melinoe"
      Event = "MorosAboutPrometheus01"
    }
    {
      Id = "Moros_0337_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prometheus... Aku sama sekali tak senang melihat penderitaannya. Para dewa memang tahu betul cara memberi pelajaran keras. Sekarang dia berniat membalas dendam? Pola yang sangat digemari dalam tenunan para Fates."
      Speaker = "Moros"
      Event = "MorosAboutPrometheus01"
    }
    {
      Id = "Melinoe_3600"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setelah kau menyinggungnya, pengetahuannya tentang masa depan terasa mirip dengan saudari-saudarimu. Apa kau menduga dia memihak Chronos karena tahu Chronos pada akhirnya akan menang?"
      Speaker = "Melinoe"
      Event = "MorosAboutPrometheus01"
    }
    {
      Id = "Moros_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak ingin berspekulasi, Tuan Putri. Yang kutahu, sang Titan Penglihatan Masa Depan tak pernah menjadi sosok yang gemar kekerasan. Masa-masa penahanannya... pasti telah mengubahnya."
      Speaker = "Moros"
      Event = "MorosAboutPrometheus01"
    }
    {
      Id = "Melinoe_3601"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku terpaksa harus mengubahnya lebih jauh lagi."
      Speaker = "Melinoe"
      Event = "MorosAboutPrometheus01"
    }
    {
      Id = "Moros_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di saat-saat terlemahku... Aku sempat iri pada Prometheus, walau tahu penderitaannya. Sebab dia dicintai oleh kaum fana setelah memberikan anugerah api dari Olympus. Sedangkan {#Emph}aku{#Prev}, malah {#Emph}dibenci. {#Prev}Seharusnya aku tak peduli... tapi nyatanya itu menyakitkan."
      Speaker = "Moros"
      Event = "MorosAboutPrometheus02"
    }
    {
      Id = "Melinoe_3602"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahlah, Tuan Moros. Apa yang dipikirkan kaum fana tentang kita bukanlah masalah. Kalaupun berpengaruh, lebih baik dibenci daripada menjadi pengkhianat. Prometheus hanya memikirkan kaum fana dan dirinya sendiri. Aku heran Chronos mau memercayakan apa pun padanya."
      Speaker = "Melinoe"
      Event = "MorosAboutPrometheus02"
    }
    {
      Id = "Moros_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski kubilang tak ingin berspekulasi, aku... tak bisa menepis firasat bahwa Chronos menghargainya {#Emph}karena {#Prev}banyak kaum fana yang memujanya. Zaman Keemasan baru yang ingin ia wujudkan... zaman untuk kaum fana, bukan untuk para dewa..."
      Speaker = "Moros"
      Event = "MorosAboutPrometheus02"
    }
    {
      Id = "Melinoe_3603"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti semua masalah kaum fana bakal tuntas..."
      Speaker = "Melinoe"
      Event = "MorosAboutPrometheus02"
    }
    {
      Id = "Moros_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari-saudariku pernah memberitahuku tentang suatu ramalan yang bahkan kupikir tak akan pernah terjadi... bahwa Olympus sekali lagi akan menghadapi murka Sang Bapak Segala Monster, dan pertempuran mereka akan mengguncang dunia hingga ke akarnya. Dan kini ramalan itu menjadi kenyataan..."
      Speaker = "Moros"
      Event = "MorosAboutTyphon01"
    }
    {
      Id = "Melinoe_3924"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu kau {#Emph}tahu {#Prev}bahwa serangan Typhon adalah kemungkinan nyata? Mengapa kau tidak memperingatkan kami? Kita bisa bersiap-siap!"
      Speaker = "Melinoe"
      Event = "MorosAboutTyphon01"
    }
    {
      Id = "Moros_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... tidak diizinkan memperingatkanmu. Andaikan kulakukan, itu hanya akan mempercepat takdir yang kini kusadari memang pasti terjadi. Namun mungkin tuduhanmu benar, dan ini {#Emph}memang {#Prev}semua salahku..."
      Speaker = "Moros"
      Event = "MorosAboutTyphon01"
    }
    {
      Id = "Melinoe_3925"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Bagaimana bisa ini semua salahmu? Kecuali jika kau membantu Chronos membangkitkan monster paling terkutuk yang pernah dihadapi para dewa, kurasa {#Emph}kau {#Prev}sama sekali tak ada hubungannya dengan ini."
      Speaker = "Melinoe"
      Event = "MorosAboutTyphon01"
    }
    {
      Id = "Moros_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mengurai Ikatan Takdir. {#Prev}Aku membantu rencanamu untuk mencapai permukaan. Bangkitnya Typhon... mungkin ini sebuah hukuman... dan pengingat untuk jangan pernah menentang para Fates. Tuan Putri, kumohon maafkan aku."
      Speaker = "Moros"
      Event = "MorosAboutTyphon01"
    }
    {
      Id = "Melinoe_3926"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Omong kosong. {#Emph}Chronos {#Prev}yang melakukannya, bukan kau."
      Speaker = "Melinoe"
      Event = "MorosAboutTyphon01"
    }
    {
      Id = "Melinoe_4589"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ramalan tentang bangkitnya kembali Typhon... apa yang membuatmu berpikir itu tak akan pernah terjadi? Kukira tenunan saudari-saudarimu selalu pasti terwujud."
      Speaker = "Melinoe"
      Event = "MorosAboutTyphon02"
    }
    {
      Id = "Moros_0375"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Fates tak selalu lugas. Ramalan mereka ditampilkan dalam bentuk gambaran, bukan tertulis secara terperinci... setidaknya untuk ramalan-ramalan besar. Kupikir penafsiranku tentang kembalinya Typhon mungkin keliru."
      Speaker = "Moros"
      Event = "MorosAboutTyphon02"
    }
    {
      Id = "Melinoe_4590"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi para Fates menenun wujud monster mengerikan yang memanjat Olympus sementara para dewa mati-matian berusaha melawan, dan kau mengira maknanya apa?"
      Speaker = "Melinoe"
      Event = "MorosAboutTyphon02"
    }
    {
      Id = "Moros_0376"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, tidak persis seperti itu gambarannya, meski jika diingat-ingat lagi, aku memang tidak memahaminya secara harfiah sebagaimana mestinya. Kukira itu hanya meramalkan bahwa kaum Olympian harus bersatu menghadapi semacam ancaman eksistensial..."
      Speaker = "Moros"
      Event = "MorosAboutTyphon02"
    }
    {
      Id = "Melinoe_4591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, tebakanmu tidak salah juga!"
      Speaker = "Melinoe"
      Event = "MorosAboutTyphon02"
    }
    {
      Id = "Melinoe_4594"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ramalan tentang kembalinya Typhon... apakah penafsiranmu menunjukkan bahwa para dewa akan menang atau tidak? Atau adakah detail yang kau ingat yang bisa kita manfaatkan?"
      Speaker = "Melinoe"
      Event = "MorosAboutTyphon03"
    }
    {
      Id = "Moros_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu itu ada kilat, yang kuanggap melambangkan Zeus; bumi tampak berguncang, mengingatkan pada Poseidon; dan sebilah tombak merah mirip kepunyaan ayahmu, menembus badai. Namun detail-detail khusus ini pun sepertinya tidak berkaitan dengan persoalan kita saat ini."
      Speaker = "Moros"
      Event = "MorosAboutTyphon03"
    }
    {
      Id = "Melinoe_4595"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak, kurasa juga begitu..."
      Speaker = "Melinoe"
      Event = "MorosAboutTyphon03"
    }
    {
      Id = "Melinoe_4596"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tombak merah, ya...?"
      Speaker = "Melinoe"
      Event = "MorosAboutTyphon03"
    }
    {
      Id = "Melinoe_4592"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira, apakah tenunan para Fates meramalkan bahwa aku akan melempar Sang Bapak Segala Monster jatuh dari gunung tadi malam? Paling tidak, dia sama sekali tak menyangkanya."
      Speaker = "Melinoe"
      Event = "MorosAboutTyphonW01"
    }
    {
      Id = "Moros_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, tidak seperti itu. Tenunan Takdir cenderung tidak merinci dengan tepat, yang kusadari memang bisa sedikit membingungkan. Namun kuucapkan selamat atas kemenanganmu, Putri! Aku ingin percaya bahwa aku telah meramalkannya, sekalipun para Takdir tidak."
      Speaker = "Moros"
      Event = "MorosAboutTyphonW01"
    }
    {
      Id = "Melinoe_4593"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tahu aku akan mengalahkan Typhon?"
      Speaker = "Melinoe"
      Event = "MorosAboutTyphonW01"
    }
    {
      Id = "Moros_0378"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Firasatku mengatakan demikian."
      Speaker = "Moros"
      Event = "MorosAboutTyphonW01"
    }
    {
      Id = "Moros_0472"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah usahamu mendaki gunung para dewa setidaknya sudah berkurang kesulitannya, sekarang dibanding sebelumnya? Berakhirnya perang melawan Chronos semestinya mendatangkan sedikit kelegaan."
      Speaker = "Moros"
      Event = "MorosAboutPostEndingTyphonW01"
    }
    {
      Id = "Melinoe_4810"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah untuk urusan itu, belum banyak yang berubah. Tampaknya kebuntuan antara legiun Titan dan Olympus sengaja dibiarkan berlanjut, demi kelancaran upaya pembersihan kami."
      Speaker = "Melinoe"
      Event = "MorosAboutPostEndingTyphonW01"
    }
    {
      Id = "Moros_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi perjuanganmu berlanjut seperti sebelumnya, hanya saja tanpa dendam membara demi keluargamu yang memacumu. Lantas apa faktor pendorongnya sekarang?"
      Speaker = "Moros"
      Event = "MorosAboutPostEndingTyphonW01"
    }
    {
      Id = "Melinoe_4811"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, mulai dari mana, ya... Ada beberapa urusan yang ingin kuselesaikan. Dan, kurasa cuma ingin melihat apa yang akan terjadi!"
      Speaker = "Melinoe"
      Event = "MorosAboutPostEndingTyphonW01"
    }
    {
      Id = "Moros_0474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku pun kian berhasrat untuk menyaksikan hal itu."
      Speaker = "Moros"
      Event = "MorosAboutPostEndingTyphonW01"
    }
    {
      Id = "Moros_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu benar, bukan? Kau menyapu bersih Typhon dari dunia ini. Nubuat yang kulihat pastilah... bukan cuma soal kebangkitannya, melainkan {#Emph}pemusnahannya. {#Prev}Bagaimana kau melakukannya, jika aku boleh tahu?"
      Speaker = "Moros"
      Event = "MorosAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_4786"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mantra rumit dari Kepala Sekolah, beserta esensi Gigaros, tombak ayahku yang ia gunakan setelah Chronos pertama kali digulingkan. Semuanya berjalan lancar."
      Speaker = "Melinoe"
      Event = "MorosAboutTyphonDeath01"
    }
    {
      Id = "Moros_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tombak ayahmu... dalam penglihatanku, sebuah tombak terlihat menembus badai. Kalau begitu itu pastilah {#Emph}dirimu. {#Prev}Dan rupanya, para Takdir benar-benar {#Emph}telah {#Prev}mengantisipasi kemenanganmu."
      Speaker = "Moros"
      Event = "MorosAboutTyphonDeath01"
    }
    {
      Id = "Melinoe_4787"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah mereka juga mengantisipasi bahwa aku akan membantai Chronos berikutnya?"
      Speaker = "Melinoe"
      Event = "MorosAboutTyphonDeath01"
    }
    {
      Id = "Moros_0448"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Andai saja aku tahu..."
      Speaker = "Moros"
      Event = "MorosAboutTyphonDeath01"
    }
    {
      Id = "Moros_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sesuatu yang tak lazim terjadi, Putri. Gulungan Takdir bergulir ke titik yang menarik perhatianku. Kalimat yang tertera kurang masuk akal bagiku, meski aku terdorong untuk menyampaikannya padamu: {#Emph}Kulihat jiwamu berkilauan laksana logam di bawah Bumi."
      Speaker = "Moros"
      Event = "MorosGrantsHiddenAspect01"
    }
    {
      Id = "Melinoe_4370"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kulihat jiwamu berkilauan laksana logam di bawah Bumi. {#Prev}Itu terdengar sangat mirip frasa pembangun! Kepala Sekolah menceritakannya padaku saat meminjamkan Senjata Malam. Ketika memikirkannya, apa yang kau lihat...?"
      Speaker = "Melinoe"
      Event = "MorosGrantsHiddenAspect01"
    }
    {
      Id = "Moros_0370"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semacam daimon. Wajah menyerupai topeng, di dalam bayang-bayang, semacam alam malam, belum tentu milik kita. Siapakah ini?"
      Speaker = "Moros"
      Event = "MorosGrantsHiddenAspect01"
    }
    {
      Id = "Melinoe_4371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa kita akan segera mengetahuinya. Kemungkinan seorang penyandang Senjata Malam, namun apakah dari masa lalu atau masa depan, aku tak bisa memastikan."
      Speaker = "Melinoe"
      Event = "MorosGrantsHiddenAspect01"
    }
    {
      Id = "Moros_0371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin aku baru saja memenuhi bagian dari suatu nubuat dengan menyampaikan kata-kata itu. Kuharap semua itu membawa manfaat, bukan celaka?"
      Speaker = "Moros"
      Event = "MorosGrantsHiddenAspect01"
    }
    {
      Id = "Melinoe_4372"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupikir begitu. {#Emph}Kulihat jiwamu berkilauan laksana logam di bawah Bumi..."
      Speaker = "Melinoe"
      Event = "MorosGrantsHiddenAspect01"
    }
    {
      Id = "Melinoe_4586"
      InheritFrom = "BaseNarrative"
      DisplayName = "Frasa yang kau sampaikan berhasil mengungkap Aspek baru dari Kobaran Bayangan, dewa kegelapan yang dikenal sebagai Supay. Apakah nama itu terdengar familier bagimu?"
      Speaker = "Melinoe"
      Event = "MorosAboutHiddenAspect01"
    }
    {
      Id = "Moros_0372_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum pernah sampai sekarang. Para Takdir tampaknya memilih setiap penyandang Senjata Malam. Para penyandang itu mungkin tidak terikat darah, tapi tetap terhubung. Dan sepertinya aku ditakdirkan menjadi penghubungmu dengan Supay ini..."
      Speaker = "Moros"
      Event = "MorosAboutHiddenAspect01"
    }
    {
      Id = "Melinoe_4587"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa ada dewa Underworld yang tak satu pun dari kita kenal? Sebagian besar pasti dari pihak ibumu."
      Speaker = "Melinoe"
      Event = "MorosAboutHiddenAspect01"
    }
    {
      Id = "Moros_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entahlah. Barangkali kelak akan ada Underworld lain selain milik kita. Atau mungkin sudah ada."
      Speaker = "Moros"
      Event = "MorosAboutHiddenAspect01"
    }
    {
      Id = "Melinoe_4588"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu terlalu mengada-ada."
      Speaker = "Melinoe"
      Event = "MorosAboutHiddenAspect01"
    }
    {
      Id = "Moros_0374"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar juga."
      Speaker = "Moros"
      Event = "MorosAboutHiddenAspect01"
    }
    {
      Id = "Moros_0503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu untukmu, Putri. Di tempat tinggalku, Kegelapan semacam ini sangat lumrah, namun mungkin tidak lagi sekarang. Terimalah, sekiranya kau membutuhkannya."
      Speaker = "Moros"
      Event = "MorosGrantsMixer6Common"
    }
    {
      Id = "Melinoe_4635"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, terima kasih, Tuan Moros! Di Persimpangan ini cahaya bulan {#Emph}cukup {#Prev}terang sehingga Kegelapan seperti ini hampir tak pernah terlihat. {#Emph}Tunggu... {#Prev}apa barusan kau menuntaskan sebuah nubuat?"
      Speaker = "Melinoe"
      Event = "MorosGrantsMixer6Common"
    }
    {
      Id = "Moros_0504"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tetap akan memberikannya padamu sekalipun tidak."
      Speaker = "Moros"
      Event = "MorosGrantsMixer6Common"
    }
    {
      Id = "Moros_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku belum melihat sang Penyihir Persimpangan akhir-akhir ini, Putri. Kau tahu dia mungkin berada di mana?"
      Speaker = "Moros"
      Event = "MorosAboutHecateKidnapped01"
    }
    {
      Id = "Melinoe_4788"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku punya firasat, ya. Aku harus pergi."
      Speaker = "Melinoe"
      Event = "MorosAboutHecateKidnapped01"
    }
    {
      Id = "Moros_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugasmu akhirnya selesai...! Para Takdir mungkin tahu kau akan berhasil, tetapi aku sendiri tak selalu bisa yakin. Kendati aku tetap menggenggam apa yang bisa disebut sebagai harapan."
      Speaker = "Moros"
      Event = "MorosPostTrueEnding01"
    }
    {
      Id = "Melinoe_4789"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan dukunganmu yang menjadikannya nyata, Tuan Moros. Salah satunya, jika kau tak turun tangan saat aku berusaha mencapai permukaan, Typhon mungkin sudah meratakan Olympus menjadi puing-puing."
      Speaker = "Melinoe"
      Event = "MorosPostTrueEnding01"
    }
    {
      Id = "Moros_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kiamat berhasil dicegah...! Kami anak-anak Nyx telah mendengar bahwa Ibu tak lagi terbelenggu di Tartarus; rasa terima kasih kami yang terdalam untukmu, terutama dariku. Kalau begitu... apa yang terjadi sekarang?"
      Speaker = "Moros"
      Event = "MorosPostTrueEnding01"
    }
    {
      Id = "Melinoe_4790"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kurasa aku harus pergi memastikan semuanya beres. Ayahku mulai merenovasi Underworld, dan aku mengajukan diri untuk membantu beres-beres. Permukaan juga membutuhkannya."
      Speaker = "Melinoe"
      Event = "MorosPostTrueEnding01"
    }
    {
      Id = "Moros_0453"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berarti sepertinya kita akan segera bertemu lagi?"
      Speaker = "Moros"
      Event = "MorosPostTrueEnding01"
    }
    {
      Id = "Melinoe_4791"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Melinoe"
      Event = "MorosPostTrueEnding01"
    }
    {
      Id = "Moros_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kelanjutan usahamu untuk membersihkan semua kekacauan yang diperbuat Chronos? Kuharap tugas baru ini tidak sepenuhnya dibebankan kepadamu seorang."
      Speaker = "Moros"
      Event = "MorosPostTrueEnding02"
    }
    {
      Id = "Melinoe_4792"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, semuanya ikut membantu, bahkan Chronos... kakekku sendiri. Kau sudah dengar apa yang terjadi padanya, kan? Dirinya yang baru tampaknya jauh lebih bisa dihadapi dibanding sebelumnya."
      Speaker = "Melinoe"
      Event = "MorosPostTrueEnding02"
    }
    {
      Id = "Moros_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mati Chronos... {#Prev}bagi dirinya yang lama. Aku tak tahu bagaimana kau berhasil melakukannya, Tuan Putri. Bahkan mungkin saudari-saudariku pun tak mengetahuinya, di mana pun mereka berada."
      Speaker = "Moros"
      Event = "MorosPostTrueEnding02"
    }
    {
      Id = "Melinoe_4793"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita harus mencari tahu ke mana mereka diasingkan, dan kurasa Chronos tidak bisa begitu saja memberi tahu kita. Bagaimana denganmu, mungkinkah keadaannya sudah cukup berubah hingga kau bisa melacak keberadaan mereka?"
      Speaker = "Melinoe"
      Event = "MorosPostTrueEnding02"
    }
    {
      Id = "Moros_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sering mencari di kehampaan tempat kita pertama kali bertemu, karena para Takdir terkadang pergi ke sana juga. Namun tempat itu begitu luas..."
      Speaker = "Moros"
      Event = "MorosPostTrueEnding02"
    }
    {
      Id = "Melinoe_4794"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita akan terus mencari."
      Speaker = "Melinoe"
      Event = "MorosPostTrueEnding02"
    }
    {
      Id = "Moros_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau pergi tadi, Daftar Takdir... mendadak bergetar, lalu bergulir ke sebuah ramalan yang belum pernah kulihat sebelumnya, dan sudah tergenapi. Kurasa ada hal lain di balik ini, tapi..."
      Speaker = "Moros"
      Event = "MorosAboutEpilogueProgress01"
    }
    {
      Id = "Melinoe_4796"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak boleh memberi tahuku lebih dari itu, aku paham. Kurasa aku punya gambaran tentang apa isi ramalan itu, karena Daftar Takdir juga telah mengungkap beberapa hal kepadaku."
      Speaker = "Melinoe"
      Event = "MorosAboutEpilogueProgress01"
    }
    {
      Id = "Moros_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sedang mencoba memahami apa yang memicu perubahan seperti itu. Kau akan mengikuti ke mana Daftar itu menuntunmu, kan?"
      Speaker = "Moros"
      Event = "MorosAboutEpilogueProgress01"
    }
    {
      Id = "Melinoe_4797"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pegang kata-kataku."
      Speaker = "Melinoe"
      Event = "MorosAboutEpilogueProgress01"
    }
    {
      Id = "Moros_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari-saudariku... mereka baik-baik saja! Tadinya aku ingin mengucap {#Emph}syukur pada Takdir{#Prev}, tapi dalam hal ini, Tuan Putri? Aku hanya bisa berucap {#Emph}terima kasih kepadamu. {#Prev}Meski sebaiknya kau tak menceritakan bagaimana caramu melakukannya, kumohon ceritakan bagaimana rasanya akhirnya bisa bertemu mereka..."
      Speaker = "Moros"
      Event = "MorosPostEpilogue01"
    }
    {
      Id = "Melinoe_4798"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu percakapan yang sangat menarik! Dan mereka tampak baik-baik saja, sejauh yang bisa kukatakan. Kau pasti juga sudah tahu tentang ramalan besar baru yang mereka sampaikan."
      Speaker = "Melinoe"
      Event = "MorosPostEpilogue01"
    }
    {
      Id = "Moros_0461"
      InheritFrom = "BaseNarrative"
      DisplayName = "Datangnya sebuah zaman baru! Mereka sudah memberitahuku. Mungkin itu cara mereka untuk mencegah upaya lebih lanjut dalam menyiasati kehendak mereka. Itu pun jika zaman ini {#Emph}benar-benar {#Prev}tiba."
      Speaker = "Moros"
      Event = "MorosPostEpilogue01"
    }
    {
      Id = "Melinoe_4799"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi apa artinya ini bagimu, Moros? Aku merasa saudari-saudarimu belum punya rencana dalam waktu dekat untuk melanjutkan tenunan mereka seperti biasa."
      Speaker = "Melinoe"
      Event = "MorosPostEpilogue01"
    }
    {
      Id = "Moros_0462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa itu artinya kaum fana akan terbebas dariku untuk sementara waktu, mungkin cukup lama. Dan aku harus mencari kesibukan lain..."
      Speaker = "Moros"
      Event = "MorosPostEpilogue01"
    }
    {
      Id = "Melinoe_4800"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa tetap tinggal di sini bersama kami. Membantu merawat Crossroads. Mempelajari sihir kami."
      Speaker = "Melinoe"
      Event = "MorosPostEpilogue01"
    }
    {
      Id = "Moros_0463"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku akan sangat menyukainya."
      Speaker = "Moros"
      Event = "MorosPostEpilogue01"
    }
    {
      Id = "Melinoe_4801"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama denganku."
      Speaker = "Melinoe"
      Event = "MorosPostEpilogue01"
    }
    {
      Id = "Melinoe_4802"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zaman baru yang digambarkan oleh saudari-saudarimu... menurutmu mungkinkah Prometheus sudah mengantisipasinya? Kalau kuingat-ingat kembali perkataannya..."
      Speaker = "Melinoe"
      Event = "MorosPostEpilogue02"
    }
    {
      Id = "Moros_0464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu sang Titan Pandangan Masa Depan sudah tahu para Takdir pada akhirnya akan membuat pilihan ini, bahkan sebelum {#Emph}mereka {#Prev}sendiri mengetahuinya? {#Emph}Hm. {#Prev}Mungkin mereka semua bersekongkol demi mencapai tujuan bersama..."
      Speaker = "Moros"
      Event = "MorosPostEpilogue02"
    }
    {
      Id = "Melinoe_4803"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tuanku Moros! {#Prev}Aku terkejut kau bisa berpikiran sejauh itu! Bersekongkol melawan para dewa, {#Emph}dan {#Prev}Chronos pula!"
      Speaker = "Melinoe"
      Event = "MorosPostEpilogue02"
    }
    {
      Id = "Moros_0465"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya mencari kemungkinan lain selain anggapan bahwa saudari-saudariku bukanlah yang pertama tahu. Berarti Prometheus berhasil memperjuangkan nasib kaum fana pada akhirnya. Atau akan berhasil, saat zaman itu tiba."
      Speaker = "Moros"
      Event = "MorosPostEpilogue02"
    }
    {
      Id = "Melinoe_4804"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memikirkan rencana sejauh itu..."
      Speaker = "Melinoe"
      Event = "MorosPostEpilogue02"
    }
    {
      Id = "Moros_0466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang aku tak tahu lagi harus berbuat apa dengan diriku, Tuan Putri. Kupikir jika kau berhasil menuntaskan tugasmu, aku akan kembali ke tanggung jawabku. Namun kini tampaknya tidak."
      Speaker = "Moros"
      Event = "MorosPostEpilogue03"
    }
    {
      Id = "Melinoe_4805"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu betul perasaan itu. Aku begitu terpaku pada tujuanku sampai-sampai tak sempat memikirkan apa langkah selanjutnya... tapi kita masih di sini, kan? Tugas itu bukanlah akhir segalanya."
      Speaker = "Melinoe"
      Event = "MorosPostEpilogue03"
    }
    {
      Id = "Moros_0467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu apa yang {#Emph}harus {#Prev}kita lakukan? Aku ini Perwujudan Takdir Kematian; aku takkan pernah dikenal karena keahlian memancingku, misalnya. Aku khawatir... mungkin pencapaian terbaikku sudah berlalu."
      Speaker = "Moros"
      Event = "MorosPostEpilogue03"
    }
    {
      Id = "Melinoe_4806"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga mengkhawatirkan hal yang sama, meski itu omong kosong. Sisa keabadian masih terbentang luas di depan kita. Kaum fana hanya punya waktu sekejap mata."
      Speaker = "Melinoe"
      Event = "MorosPostEpilogue03"
    }
    {
      Id = "Moros_0468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nasib kita memang jauh lebih beruntung dibanding kaum fana, tentu saja."
      Speaker = "Moros"
      Event = "MorosPostEpilogue03"
    }
    {
      Id = "Melinoe_4807"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kasihan mereka."
      Speaker = "Melinoe"
      Event = "MorosPostEpilogue03"
    }
    {
      Id = "Melinoe_4780"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berapa banyak saudaramu yang kau kenal? Selain yang pernah kutemui. Aku sudah mendengar banyak nama lain... Momus, para Keres, Oizys... dia sepertinya sosok yang merepotkan."
      Speaker = "Melinoe"
      Event = "MorosAboutRelatives01"
    }
    {
      Id = "Moros_0701"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku pernah bertemu sebagian besar dari mereka, pada satu waktu atau lainnya. Kami sangat jarang berkumpul bersama keluarga, sebuah gagasan yang Ibu Nyx putuskan untuk {#Emph}coba {#Prev}setelah Olympus dan ayahmu mencoba menjadikannya tradisi serupa. Tapi itu berakhir kacau."
      Speaker = "Moros"
      Event = "MorosAboutRelatives01"
    }
    {
      Id = "Melinoe_4781"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa begitu? Tunggu, aku tahu jawabannya. Kalau begitu, beri tahu aku: Siapa yang paling nakal dan bikin onar {#Emph}selain {#Prev}Strife?"
      Speaker = "Melinoe"
      Event = "MorosAboutRelatives01"
    }
    {
      Id = "Moros_0702"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... kau sudah menyebut beberapa kandidat terkuatnya barusan."
      Speaker = "Moros"
      Event = "MorosAboutRelatives01"
    }
    {
      Id = "Melinoe_4782"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ooh..."
      Speaker = "Melinoe"
      Event = "MorosAboutRelatives01"
    }
    {
      Id = "Moros_0695"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hujan di sini terasa cukup menyegarkan, dan unik. Tak pernah ada hujan di tempat asalku. Kurasa ini anugerah dari nenekmu demi menjaga Persimpangan Jalan tetap subur."
      Speaker = "Moros"
      Event = "MorosAboutRain01"
    }
    {
      Id = "Melinoe_4778"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru tahu punya hubungan darah dengan Yang Mulia Demeter saat masih kecil, dan selalu teringat padanya setiap kali hujan turun. Beliau dan ibuku tampak sangat bertolak belakang. Penasaran bagaimana hubungan mereka dulu."
      Speaker = "Melinoe"
      Event = "MorosAboutRain01"
    }
    {
      Id = "Moros_0696"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengingat rumitnya hubungan antargenerasi di keluarga kita, wajar bila mereka tak begitu akur. Tapi setahuku, setidaknya ibumu dulu rutin berkunjung."
      Speaker = "Moros"
      Event = "MorosAboutRain01"
    }
    {
      Id = "Melinoe_4779"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan berusaha melakukan hal yang sama."
      Speaker = "Melinoe"
      Event = "MorosAboutRain01"
    }
    {
      Id = "Moros_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terus terang saja, Tuan Odysseus, aku ini bisa dibilang pengagummu. Awalnya, kau terasa {#Emph}luar biasa {#Prev}menjengkelkan bagiku, karena kau begitu lihai meloloskan diri dari Takdir Kematian yang pasti. Namun perlahan, meski mungkin agak segan, aku jadi amat terkesan."
      Speaker = "Moros"
      Event = "MorosWithOdysseus01"
    }
    {
      Id = "Odysseus_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}hah{#Prev}, aku... tersanjung sekaligus lega mendengarnya, sungguh baik kau menyampaikannya padaku, terutama setelah... sekian lama berlalu..."
      Speaker = "Odysseus"
      Event = "MorosWithOdysseus01"
    }
    {
      Id = "Moros_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya ini cukup menggelikan. Selama kau masih bernapas dulu, tak pernah sekalipun aku sempat mengatakannya padamu!"
      Speaker = "Moros"
      Event = "MorosWithOdysseus01"
    }
    {
      Id = "Odysseus_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa {#Emph}begitu, {#Prev}memang cukup menggelikan, Tuanku! Aku tak bermaksud menyinggung perasaanmu dengan terus menghindarimu, kau tentu tahu itu, kan? Sekadar naluri manusia fana saat nyawa terancam."
      Speaker = "Odysseus"
      Event = "MorosWithOdysseus01"
    }
    {
      Id = "Moros_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aksimu sungguh luar biasa disaksikan! Mulai dari Raksasa Laestrygonian, Charybdis, dan jangan lupakan... perang Ilium...!"
      Speaker = "Moros"
      Event = "MorosWithOdysseus01"
    }
    {
      Id = "Odysseus_0168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan pernah melupakannya...!"
      Speaker = "Odysseus"
      Event = "MorosWithOdysseus01"
    }
    {
      Id = "Moros_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Lantas... pernahkah kau merasa benar-benar yakin ajalmu akhirnya tiba? Ataukah kau sungguh yakin selalu ada celah untuk meloloskan diri, segenting apa pun keadaannya?"
      Speaker = "Moros"
      Event = "MorosWithOdysseus02"
    }
    {
      Id = "Odysseus_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, jujur saja padamu, Moros—bolehkah aku menyapamu santai begini? Bagian tersulit bukanlah melepaskan diri dari situasi di ambang maut, melainkan dari pelukan dewi-dewi tertentu... kalau kuingat-ingat lagi, itulah kelemahan terbesarku..."
      Speaker = "Odysseus"
      Event = "MorosWithOdysseus02"
    }
    {
      Id = "Moros_0196_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, begitu rupanya... tapi bagaimana bisa itu dianggap kelemahan? Setahuku, istrimu Penelope selalu setia mendampingimu... Kuharap aku tak lancang; aku tahu ini bisa jadi topik sensitif bagi mereka yang berasal dari permukaan."
      Speaker = "Moros"
      Event = "MorosWithOdysseus02"
    }
    {
      Id = "Odysseus_0701"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, Penelope tetap mendampingiku, setelah menghabiskan masa-masa terbaiknya menanti seorang pria yang tak selalu terburu-buru untuk pulang. Setelah kami sama-sama wafat, kami bertemu kembali di Underworld, tapi... kami butuh waktu masing-masing."
      Speaker = "Odysseus"
      Event = "MorosWithOdysseus02"
    }
    {
      Id = "Moros_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu rupanya. Setelah semua yang kalian lalui, apakah hubungan kalian berakhir secara baik-baik, setidaknya?"
      Speaker = "Moros"
      Event = "MorosWithOdysseus02"
    }
    {
      Id = "Odysseus_0702"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan berakhir, melainkan {#Emph}berubah wujud{#Prev}, tapi... ya, begitulah."
      Speaker = "Odysseus"
      Event = "MorosWithOdysseus02"
    }
    {
      Id = "Moros_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kuda kayu itu tipu muslihat yang luar biasa indah. Menyerahkan Takdir Kematianmu sendiri yang tak terelakkan kepada musuh-musuhmu yang lengah! Sungguh langkah jenius. Tapi favorit pribadiku tentu saja insiden Polyphemus..."
      Speaker = "Moros"
      Event = "MorosWithOdysseus03"
    }
    {
      Id = "Odysseus_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menceritakannya seolah itu cuma dongeng laga masa lampau. Bajingan raksasa itu membantai awak kapalku. Jantungku serasa mau copot saat melewatinya, dan {#Emph}sekarang {#Prev}dia berulah lagi dengan sang Dewi di sana."
      Speaker = "Odysseus"
      Event = "MorosWithOdysseus03"
    }
    {
      Id = "Moros_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, tapi aku yakin berkat bimbinganmu, sang Putri akan mengelabui Kiklops itu {#Emph}lagi {#Prev}dan {#Emph}lagi. {#Prev}Sebagai ganjaran setimpal atas kesulitan yang pernah dia timbulkan padamu!"
      Speaker = "Moros"
      Event = "MorosWithOdysseus03"
    }
    {
      Id = "Odysseus_0227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengar itu, Dewi?"
      Speaker = "Odysseus"
      Event = "MorosWithOdysseus03"
    }
    {
      Id = "Moros_0691"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Oh, kami sangat sibuk pada masa itu, begitu pula dirimu, Tuan Odysseus. Menghimpun bala tentara, mengecoh para panglima musuh... kau bertarung begitu garang kala itu!"
      Speaker = "Moros"
      Event = "MorosWithOdysseus04"
    }
    {
      Id = "Odysseus_0703"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, begitulah... aku bersyukur sekarang bisa menjalankan tugasku dari balik meja. Sulit menjalani hidup penuh pertumpahan darah terlalu lama. Terutama bagi manusia fana, karena mereka bisa mati."
      Speaker = "Odysseus"
      Event = "MorosWithOdysseus04"
    }
    {
      Id = "Moros_0692"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sungguh angkat topi atas segala pencapaian dan aksi pelarianmu yang nekat! Nyonya Hecate tak mungkin bisa memilih Arwah yang lebih baik."
      Speaker = "Moros"
      Event = "MorosWithOdysseus04"
    }
    {
      Id = "Odysseus_0704"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah{#Prev}, apalagi bila kau sendiri yang mengatakannya begitu!"
      Speaker = "Odysseus"
      Event = "MorosWithOdysseus04"
    }
    {
      Id = "Moros_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kendati demikian, rasanya aku seharusnya ada di sana, Saudaraku. Mungkin aku bisa melindungi mereka sebagaimana tugasku. Memikirkan bahwa Tiga Dewi Takdir sendiri mungkin telah melarangku untuk mencoba... sungguh merisaukan karena aku mungkin takkan pernah tahu jawabannya."
      Speaker = "Moros"
      Event = "MorosWithCharon01"
    }
    {
      Id = "Charon_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Keeehhhh, hraaauuggghhh...!"
      Speaker = "Charon"
      Event = "MorosWithCharon01"
    }
    {
      Id = "Moros_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhak untuk marah. Aku pun merasakan amarah yang sama. Meski begitu, aku bersyukur jalan kita dipertemukan kembali. Berhati-hatilah, Charon."
      Speaker = "Moros"
      Event = "MorosWithCharon01"
    }
    {
      Id = "Moros_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Charon... kau, Nemesis, bahkan Hypnos. Siapa lagi, Eris? Tampaknya aku termasuk yang terakhir tahu soal Persimpangan Jalan ini di antara anak-anak Nyx. Barangkali aku seharusnya menjaga komunikasi lebih baik."
      Speaker = "Moros"
      Event = "MorosWithCharon02"
    }
    {
      Id = "Charon_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mrrnngggghhh, hnnnn...{#Prev}"
      Speaker = "Charon"
      Event = "MorosWithCharon02"
    }
    {
      Id = "Melinoe_2096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahlah, Yang Mulia Charon, saudaramu adalah tamu kita. Dan meski kalian sempat terpisah, kini kalian ada di sini bersama-sama. Menyambut masa depan."
      Speaker = "Melinoe"
      Event = "MorosWithCharon02"
    }
    {
      Id = "Moros_0191"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, bagaimana caramu...? Sudahlah, lupakan."
      Speaker = "Moros"
      Event = "MorosWithCharon02"
    }
    {
      Id = "Hypnos_0006_C"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzzz, zzzz{#Prev}..."
      Speaker = "Hypnos"
      Event = "MorosWithHypnos01"
    }
    {
      Id = "Moros_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aneh rasanya bertemu saudaraku yang satu ini di sini. Jadi dia benar-benar tak bergerak sama sekali?"
      Speaker = "Moros"
      Event = "MorosWithHypnos01"
    }
    {
      Id = "Melinoe_0907"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak sekali pun. Kepala Sekolah Hecate bilang Hypnos sudah tertidur lelap saat beliau menyelamatkannya dari Kediaman ayahku. Kau tak pernah mengunjunginya di sana sebelumnya?"
      Speaker = "Melinoe"
      Event = "MorosWithHypnos01"
    }
    {
      Id = "Moros_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan tempatku untuk berada di sana. Kita berdua sama-sama berasal dari keluarga besar, bukan? Keluarga yang ganjil. Kau pasti paham bagaimana rasanya."
      Speaker = "Moros"
      Event = "MorosWithHypnos01"
    }
    {
      Id = "Melinoe_0908"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mulai merasakannya, ya."
      Speaker = "Melinoe"
      Event = "MorosWithHypnos01"
    }
    {
      Id = "Moros_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sadarilah, Eris. Kau sama sekali tidak diuntungkan dengan menghalangi kehendak Para Moirai. Pernahkah kau mendengar ada satu saja kejadian di mana hal itu berakhir baik?"
      Speaker = "Moros"
      Event = "MorosWithEris01"
    }
    {
      Id = "Eris_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak tuh! {#Prev}Tapi selalu ada kali pertama untuk segalanya, dan aku nggak sudi mendengar ancaman terselubung dari mereka lewat {#Emph}kamu. {#Prev}Kalau mereka memang sebegitu pedulinya dengan apa yang kulakukan, kenapa mereka nggak hubungi aku {#Emph}sendiri?"
      Speaker = "Eris"
      Event = "MorosWithEris01"
    }
    {
      Id = "Moros_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu bukan begitu caranya. Apa kau benar-benar sudah memutuskan untuk melawan... yah, {#Emph}semua orang? Ugh{#Prev}, bahkan {#Emph}aku {#Prev}sebenarnya tidak boleh berbicara denganmu..."
      Speaker = "Moros"
      Event = "MorosWithEris01"
    }
    {
      Id = "Eris_0175"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah akulah mau ngapain, {#Emph}Moros."
      Speaker = "Eris"
      Event = "MorosWithEris01"
    }
    {
      Id = "Eris_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ayolah{#Prev}, sobat! Kasih tahu dong kenapa kamu sebenarnya ada di {#Emph}sini! {#Prev}Tiga Nenek itu nggak bakal mengutusmu ke {#Emph}tugas {#Prev}panjang begini tanpa alasan! Tunggu... apa gara-gara {#Emph}dia?"
      Speaker = "Eris"
      Event = "MorosWithEris02"
    }
    {
      Id = "Moros_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupohon, Eris. Sang Tuan Putri patut dipanggil sebagaimana mestinya. Dan jangan sampai kau lupa, rincian kedatanganku bukanlah wewenangku untuk dibeberkan. Pasti ada hal lain yang bisa kita bicarakan."
      Speaker = "Moros"
      Event = "MorosWithEris02"
    }
    {
      Id = "Eris_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, aku bisa memikirkan {#Emph}banyak {#Prev}hal. Aku mau tahu ada apa sebenarnya di antara kalian berdua. Kulihat caramu menatapnya saat dia melintas. Jangan-jangan Tiga Nenek itu mengutusmu ke sini buat {#Emph}menjodohkan kalian...?"
      Speaker = "Eris"
      Event = "MorosWithEris02"
    }
    {
      Id = "Moros_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sedang mencoba mempermalukanku... itu tidak akan mempan. Lagipula, kita berdua tahu Para Moirai punya hal yang jauh lebih penting untuk ditenun daripada hal-hal semacam itu."
      Speaker = "Moros"
      Event = "MorosWithEris02"
    }
    {
      Id = "Eris_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Masa sih? {#Prev}Kukira kerjaan mereka cuma mencampuri detail terkecil dalam hidup semua orang! {#Emph}Tapi ya{#Prev}, kamu mestinya lebih tahu dariku."
      Speaker = "Eris"
      Event = "MorosWithEris02"
    }
    {
      Id = "Moros_0326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku cukup tahu untuk tidak terpancing provokasi murahan seperti ini..."
      Speaker = "Moros"
      Event = "MorosWithEris02"
    }
    {
      Id = "Eris_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hm!"
      Speaker = "Eris"
      Event = "MorosWithEris02"
    }
    {
      Id = "Moros_0477"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Oh ya, aku tentu mengingatmu. Apakah bisa sedikit menenangkan jika kau tahu bahwa Para Moirai sudah memutuskan sejak awal bahwa sayapmu akan gagal, dan kau akan jatuh?"
      Speaker = "Moros"
      Event = "MorosWithIcarus01"
    }
    {
      Id = "Icarus_0472"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehm{#Prev}, nggak terlalu menenangkan sih, nggak sama sekali. Pertama, itu bikin Tiga Takdir kedengaran agak, yah, kau tahu... {#Emph}jahat. {#Prev}Dulu aku cuma seorang bocah, dan bocah yang {#Emph}terpenjara! {#Prev}Kenapa harus mengincar {#Emph}aku? {#Prev}Dan yang kedua, apa maksudmu aku sebenarnya nggak punya pilihan sama sekali?"
      Speaker = "Icarus"
      Event = "MorosWithIcarus01"
    }
    {
      Id = "Moros_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah pertama-tama, para saudariku harus bersikap adil dan menjaga jarak yang sehat dari pekerjaan mereka. Jarang sekali hal itu bersifat pribadi. Mengenai pilihan yang kau buat... itu tetap pilihanmu, hanya saja... hasil akhirnya kemungkinan besar akan tetap sama bagaimanapun caranya."
      Speaker = "Moros"
      Event = "MorosWithIcarus01"
    }
    {
      Id = "Icarus_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu kalau aku nggak terbang ke atas seperti orang bodoh dan melelehkan sayapku, sayap itu bakal patah begitu saja atau semacamnya nanti, dan aku bakal tetap tercebur ke laut...?"
      Speaker = "Icarus"
      Event = "MorosWithIcarus01"
    }
    {
      Id = "Moros_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak selalu persis seperti itu... tapi ya, kurang lebih begitu."
      Speaker = "Moros"
      Event = "MorosWithIcarus01"
    }
    {
      Id = "Icarus_0474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, {#Emph}menenangkan {#Prev}sekali, ya!"
      Speaker = "Icarus"
      Event = "MorosWithIcarus01"
    }
    {
      Id = "Moros_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Selama ini tidak merepotkan, Yang Mulia Hecate. Aku tahu Anda memiliki tanggung jawab yang jauh lebih besar daripada mengurus anak Nyx yang lain. Terlebih lagi saat Nyx sendiri telah kembali."
      Speaker = "Moros"
      Event = "MorosWithHecate01"
    }
    {
      Id = "Hecate_0879"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketika Melinoë pertama kali memanggilmu, kukatakan kau boleh tinggal untuk saat ini, dan sekarang masih tetap {#Emph}saat ini{#Prev}, bukan? Kau tampak seperti tipe yang bisa berguna tanpa merepotkan atau menghalangi langkah kami. Hanya itu yang kubutuhkan."
      Speaker = "Hecate"
      Event = "MorosWithHecate01"
    }
    {
      Id = "Moros_0483"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, aku akan melakukannya sebaik mungkin sesuai kemampuanku. Mohon beri tahu aku jika Anda merasa kinerjaku kurang memuaskan dalam hal apa pun."
      Speaker = "Moros"
      Event = "MorosWithHecate01"
    }
    {
      Id = "Hecate_0880"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Astaga {#Prev}dewa-dewi, kau persis seperti dia."
      Speaker = "Hecate"
      Event = "MorosWithHecate01"
    }
    {
      Id = "Moros_0484"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seperti siapa...?"
      Speaker = "Moros"
      Event = "MorosWithHecate01"
    }
    {
      Id = "Moros_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kubersyukur pada Takdir kau selamat bersama kami, Tuan Putri."
      Speaker = "Moros"
      Event = "MorosChat01"
    }
    {
      Id = "Moros_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti senang mendengar bahwa untuk saat ini, aku tidak punya kabar buruk tambahan untuk disampaikan."
      Speaker = "Moros"
      Event = "MorosChat02"
    }
    {
      Id = "Moros_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga Para Moirai berpihak padamu pada percobaan berikutnya."
      Speaker = "Moros"
      Event = "MorosChat03"
    }
    {
      Id = "Moros_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir aku mulai terbiasa dengan Persimpangan ini!"
      Speaker = "Moros"
      Event = "MorosChat04"
    }
    {
      Id = "Moros_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baik-baik saja, Tuan Putri, meski semua ini terasa sangat asing bagiku."
      Speaker = "Moros"
      Event = "MorosChat05"
    }
    {
      Id = "Moros_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa yang tahu apa yang telah disiapkan Para Moirai untuk kita sekarang..."
      Speaker = "Moros"
      Event = "MorosChat06"
    }
    {
      Id = "Moros_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Moirai telah mempercayakan begitu banyak hal kepadamu, Tuan Putri..."
      Speaker = "Moros"
      Event = "MorosChat07"
    }
    {
      Id = "Moros_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan berusaha sebaik mungkin agar bisa berguna di sekitar sini."
      Speaker = "Moros"
      Event = "MorosChat08"
    }
    {
      Id = "Moros_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang bertemu denganmu lagi, seperti biasa, Tuan Putri."
      Speaker = "Moros"
      Event = "MorosChat09"
    }
    {
      Id = "Moros_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku turut menyesal atas hambatan yang kau hadapi, tapi setidaknya kau ada di sini."
      Speaker = "Moros"
      Event = "MorosChat10"
    }
    {
      Id = "Moros_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong jangan ragu untuk memberitahuku jika ada sesuatu yang bisa kubantu."
      Speaker = "Moros"
      Event = "MorosChat11"
    }
    {
      Id = "Moros_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga kau bersiap dengan baik untuk apa pun yang akan terjadi."
      Speaker = "Moros"
      Event = "MorosChat12"
    }
    {
      Id = "Moros_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingatlah bahwa masa depan masih belum terajut, Tuan Putri."
      Speaker = "Moros"
      Event = "MorosChat13"
    }
    {
      Id = "Moros_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih banyak yang harus kupelajari tentang cara hidup seperti ini..."
      Speaker = "Moros"
      Event = "MorosChat14"
    }
    {
      Id = "Moros_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beri tahu aku jika ada yang bisa kulakukan untuk meringankan bebanmu, walau hanya sedikit."
      Speaker = "Moros"
      Event = "MorosChat15"
    }
    {
      Id = "Moros_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuyakini tugasmu kini sudah semakin mendekati akhir, Tuan Putri."
      Speaker = "Moros"
      Event = "MorosChat16"
    }
    {
      Id = "Moros_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya beberapa Arwah di sini masih belum menyukaiku, sayang sekali..."
      Speaker = "Moros"
      Event = "MorosChat17"
    }
    {
      Id = "Moros_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira apa yang diinginkan Sang Takdir untuk kulakukan selanjutnya, ya..."
      Speaker = "Moros"
      Event = "MorosChat18"
    }
    {
      Id = "Moros_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih sudah membuatku merasa disambut di sini, Tuan Putri."
      Speaker = "Moros"
      Event = "MorosChat19"
    }
    {
      Id = "Moros_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika ada satu hal yang kupelajari dari Sang Takdir, hidup kita bisa berbelok ke arah yang paling tak terduga..."
      Speaker = "Moros"
      Event = "MorosChat20"
    }
    {
      Id = "Moros_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jaga dirimu baik-baik, Putri Melinoë, dan semoga saudariku selalu berpihak kepadamu."
      Speaker = "Moros"
      Event = "MorosChat21"
    }
    {
      Id = "Moros_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan berbincang denganmu, Tuan Putri. Tapi, tolong... jangan sampai aku menahanmu."
      Speaker = "Moros"
      Event = "MorosChat22"
    }
    {
      Id = "Moros_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuatkanlah hatimu, ketahuilah bahwa Sang Takdir sendiri percaya kau akan berhasil."
      Speaker = "Moros"
      Event = "MorosChat23"
    }
    {
      Id = "Moros_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergilah dan bawakan lebih banyak kabar buruk dari kita untuk para musuh itu."
      Speaker = "Moros"
      Event = "MorosChat24"
    }
    {
      Id = "Moros_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putri Melinoë. Semoga kebinasaan menimpa musuh-musuhmu."
      Speaker = "Moros"
      Event = "MorosChat25"
    }
    {
      Id = "Moros_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku jarang sekali bisa berkata {#Emph}kita bertemu lagi{#Prev}, namun di sinilah kita sekarang, Tuan Putri."
      Speaker = "Moros"
      Event = "MorosChat26"
    }
    {
      Id = "Moros_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka kita ditakdirkan untuk bertemu dalam keadaan seperti ini..."
      Speaker = "Moros"
      Event = "MorosChat27"
    }
    {
      Id = "Moros_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yakin kau punya urusan yang jauh lebih mendesak daripada sekadar menemaniku."
      Speaker = "Moros"
      Event = "MorosChat28"
    }
    {
      Id = "Moros_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maafkan aku, Tuan Putri. A... aku butuh waktu untuk berpikir sejenak."
      Speaker = "Moros"
      Event = "MorosChat29"
    }
    {
      Id = "Moros_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk saat ini tak ada kabar buruk tambahan, aku senang mengatakannya, Tuan Putri."
      Speaker = "Moros"
      Event = "MorosChat30"
    }
    {
      Id = "Moros_0670"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga pertempuranmu berikutnya melintasi ruang dan waktu berjalan semulus yang sebelumnya."
      Speaker = "Moros"
      Event = "MorosChat31"
    }
    {
      Id = "Moros_0671"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau butuh waktu tambahan di luar sana, ingatlah kau membawa Sematan Berukir itu."
      Speaker = "Moros"
      Event = "MorosChat32"
    }
    {
      Id = "Moros_0672"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan terus mengawasi Daftar Takdir, kalau-kalau ada perubahan mendadak."
      Speaker = "Moros"
      Event = "MorosChat33"
    }
    {
      Id = "Moros_0673"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau menuju ke permukaan, mungkin aku bisa sedikit memperlambat Eris..."
      Speaker = "Moros"
      Event = "MorosChat34"
    }
    {
      Id = "Moros_0674"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau sudah melaluinya sekali dua kali, namun tolong tetaplah berhati-hati."
      Speaker = "Moros"
      Event = "MorosChat35"
    }
    {
      Id = "Moros_0675"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap kali melihatmu, aku selalu teringat pada pandangan pertama kita, Melinoë."
      Speaker = "Moros"
      Event = "MorosChat36"
    }
    {
      Id = "Moros_0676"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin aku harus mulai belajar menenun sendiri setelah semua ini."
      Speaker = "Moros"
      Event = "MorosChat37"
    }
    {
      Id = "Moros_0677"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mulai cemas kawanmu Dora berniat menyelinap dan mengagetkanku..."
      Speaker = "Moros"
      Event = "MorosChat38"
    }
    {
      Id = "Moros_0678"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang akan terjadi, aku senang bisa berada di Persimpangan Jalan ini bersama kalian semua."
      Speaker = "Moros"
      Event = "MorosChat39"
    }
    {
      Id = "Moros_0539"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bolehkah aku mengunjungimu malam ini begitu kau kembali? Jika kau tak berkeberatan..."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChat01"
    }
    {
      Id = "Melinoe_5896"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Mungkin saja. Kau tahu di mana mencariku."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChat01"
    }
    {
      Id = "Moros_0541"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin menemuimu lagi petang ini, setelah urusanmu selesai tentunya."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChat02"
    }
    {
      Id = "Melinoe_5897"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kupikir hal itu bisa diatur."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChat02"
    }
    {
      Id = "Moros_0543"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak boleh terlalu mengganggu perjalananmu malam ini... tapi, bolehkah aku menemuimu setelahnya?"
      Speaker = "Moros"
      Event = "MorosBecomingCloserChat03"
    }
    {
      Id = "Melinoe_5898"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tentu, kau sangat boleh berkunjung."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChat03"
    }
    {
      Id = "Moros_0545"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya langkahmu malam ini membawamu pada kejatuhan yang terlalu dini, mungkin aku bisa berada di sana untuk menyambutmu."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChat04"
    }
    {
      Id = "Melinoe_5899"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Silakan dicoba saja."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChat04"
    }
    {
      Id = "Moros_0547"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu apakah kau ada waktu luang malam ini setelah tugasmu selesai?"
      Speaker = "Moros"
      Event = "MorosBecomingCloserChat05"
    }
    {
      Id = "Melinoe_5900"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Oh, kupikir ada, ya."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChat05"
    }
    {
      Id = "Moros_0549"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau kembali ke bayang-bayang nanti, aku ingin menemanimu lagi, jika kau mengizinkanku."
      Speaker = "Moros"
      Event = "MorosBecomingCloserChat06"
    }
    {
      Id = "Melinoe_5901"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku juga ingin begitu."
      Speaker = "Melinoe"
      Event = "MorosBecomingCloserChat06"
    }
    {
      Id = "Melinoe_0909"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Moros, sebagai tamu kehormatan kami, {#Emph}ehm{#Prev}, kami ingin memberikan ini padamu. Agar kau merasa sedikit lebih nyaman di sini."
      Speaker = "Melinoe"
      Event = "MorosGift01"
    }
    {
      Id = "Moros_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar para dewa! Terima kasih, Tuan Putri. Aku... belum pernah menerima persembahan sebelumnya. Tapi aku suka bersiap sedia. Jadi ini! Dari aku untukmu."
      Speaker = "Moros"
      Event = "MorosGift01"
    }
    {
      Id = "Moros_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Huh! {#Prev}Harus kuakui aku tidak terbiasa dengan sanjungan seperti ini. Maafkan aku, aku tidak tahu harus berkata apa, selain... terima kasih."
      Speaker = "Moros"
      Event = "MorosGift02"
    }
    {
      Id = "Melinoe_0910"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama-sama! Tapi, aku tidak bermaksud {#Emph}menyanjung{#Prev}, ini cuma.... Sudahlah, lupakan saja, ya?"
      Speaker = "Melinoe"
      Event = "MorosGift02"
    }
    {
      Id = "Moros_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau begitu baik padaku, Tuan Putri. Aku tiba di Crossroads ini dalam keadaan putus asa. Aku tidak menyangka akan disambut dengan baik di sini."
      Speaker = "Moros"
      Event = "MorosGift03"
    }
    {
      Id = "Melinoe_0911"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku juga tidak menyangka akan berhadapan langsung dengan Sang Takdir Kematian, apalagi sosoknya ternyata sangat menyenangkan. Tapi di sinilah kita sekarang!"
      Speaker = "Melinoe"
      Event = "MorosGift03"
    }
    {
      Id = "Moros_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, terima kasih banyak untuk ini, sungguh, meski kau tidak perlu repot-repot demi aku. Kau begitu dermawan. Maaf kalau aku lancang bertanya, tapi... ini bukan karena ramalan di Daftar Takdir, kan?"
      Speaker = "Moros"
      Event = "MorosGift04"
    }
    {
      Id = "Melinoe_0912"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bukan! {#Prev}Tentu saja bukan, Tuan Moros! Walau sebenarnya, andai pun iya, tugaskulah untuk tidak memberitahumu, bukan?"
      Speaker = "Melinoe"
      Event = "MorosGift04"
    }
    {
      Id = "Moros_0073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heh! {#Prev}Benar juga."
      Speaker = "Moros"
      Event = "MorosGift04"
    }
    {
      Id = "Moros_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suatu kehormatan bagiku menerimanya, Tuan Putri Melinoë. Saat Sang Tiga Takdir pertama kali mengisyaratkan bahwa kita akan bertemu, kutanyakan pada mereka seperti apa dirimu nanti. Clotho hanya tersenyum dan berkata, {#Emph}kau akan tahu sendiri. {#Prev}Kupikir mereka sedang mempermainkanku!"
      Speaker = "Moros"
      Event = "MorosGift05"
    }
    {
      Id = "Melinoe_0913"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mendengarnya membuatku bersyukur tidak punya saudari perempuan, Tuan Moros. Jadi, apa yang akan kau katakan andai berada di posisi Clotho?"
      Speaker = "Melinoe"
      Event = "MorosGift05"
    }
    {
      Id = "Moros_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh! Mungkin aku akan mengatakan... dia penyihir agung yang luar biasa memikat. Tuan Putri Dunia Bawah, putri dari dewi musim semi dan penguasa kematian. Namun sehebat apa pun kau membayangkannya... kenyataannya jauh lebih memesona."
      Speaker = "Moros"
      Event = "MorosGift05"
    }
    {
      Id = "Melinoe_0914"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Boleh juga jawabannya."
      Speaker = "Melinoe"
      Event = "MorosGift05"
    }
    {
      Id = "Moros_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar para dewa ini, sungguh... kemewahan yang luar biasa. Bersama saudari-saudariku, aku menjalani hidup yang cukup sederhana. Kini mendapati diriku di tempat seperti ini, terlebih lagi bersamamu... tak ada ramalan yang sanggup mempersiapkanku untuk ini."
      Speaker = "Moros"
      Event = "MorosGift06"
    }
    {
      Id = "Melinoe_4601"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sepertinya benar-benar menyukai tempat ini. Kurasa kebutuhan kita memang tercukupi di sini, tapi jarang sekali aku mendengar Crossroads digambarkan sebagai tempat yang mewah. Apa memang di tempat asalmu segalanya begitu berbeda?"
      Speaker = "Melinoe"
      Event = "MorosGift06"
    }
    {
      Id = "Moros_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, di sana tempat yang luar biasa untuk menenun. Namun hampir tak ada kegiatan santai lainnya, apalagi teman mengobrol. Aku khawatir aku bisa jadi terlena dengan semua kenikmatan ini..."
      Speaker = "Moros"
      Event = "MorosGift06"
    }
    {
      Id = "Melinoe_4602"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa kau belum berada dalam bahaya terlena sampai segitunya."
      Speaker = "Melinoe"
      Event = "MorosGift06"
    }
    {
      Id = "Melinoe_4603"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin memberikan ini padamu, Tuan Moros, karena sepertinya kau menikmatinya tempo hari. Ambrosia mungkin mengalir bebas di Olympus, tapi kita para dewa chthonic juga pantas mendapat bagian, bukankah begitu?"
      Speaker = "Melinoe"
      Event = "MorosGift07"
    }
    {
      Id = "Moros_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Kupikir pertanyaan itu lebih cocok untuk Nemesis. Bukan urusanku untuk menilai apakah kita {#Emph}pantas {#Prev}menerima hal semacam itu. Dan Sang Takdir tidak pernah memberiku petunjuk apakah aku boleh menerima hadiah seperti ini. Lagipula aku juga tak pernah terpikir untuk menanyakannya..."
      Speaker = "Moros"
      Event = "MorosGift07"
    }
    {
      Id = "Melinoe_4604"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya aneh aku sampai mengatakan ini, tapi jangan terlalu dipikirkan pusing-pusing. Berhubung Sang Takdir tidak ada di sini untuk mendiktemu, kau selalu bisa mendengarkan isi hatimu dalam situasi begini...?"
      Speaker = "Melinoe"
      Event = "MorosGift07"
    }
    {
      Id = "Moros_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hatiku... tidak mengatakan apa-apa, Tuan Putri. Tapi... detaknya berpacu lebih cepat dari biasanya, padahal aku sedang tenang dan merasa nyaman, hampir seluruhnya. {#Emph}Sangat {#Prev}nyaman! {#Emph}Ah{#Prev}, aku tidak bermaksud bersikap tidak sopan, jadi terima kasih banyak."
      Speaker = "Moros"
      Event = "MorosGift07"
    }
    {
      Id = "Melinoe_4605"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama-sama, Tuan Moros."
      Speaker = "Melinoe"
      Event = "MorosGift07"
    }
    {
      Id = "Melinoe_4606"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika ada satu hal yang kupelajari, latihan akan membawa kesempurnaan, atau setidaknya mendekatinya. Jadi, bagaimana kalau kita berlatih mendengarkan isi hati kita sedikit lagi? Ini, terimalah."
      Speaker = "Melinoe"
      Event = "MorosGift08"
    }
    {
      Id = "Moros_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... aku sedang berusaha mendengarkan isi hatiku sekarang, Tuan Putri. Namun jika memang ia bisa bicara, sayangnya ia berbisik terlalu cepat, sampai-sampai aku tidak bisa memahaminya atau tahu apa yang harus kulakukan... rasanya seolah aku terjerat salah satu mantra pengikatmu."
      Speaker = "Moros"
      Event = "MorosGift08"
    }
    {
      Id = "Melinoe_4607"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau aku duluan yang mulai, dan saat aku menawarkan Ambrosia padamu berikutnya, kau bisa lebih siap. Untuk sekarang, isi hatiku berkata... aku merasa nyaman di dekatmu. Meski kau memperlakukanku bak bangsawan terhormat, yang kalau dipikir-pikir, aku tidak keberatan sama sekali."
      Speaker = "Melinoe"
      Event = "MorosGift08"
    }
    {
      Id = "Moros_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "A... aku sangat berterima kasih untuk itu, Tuan Putri. Aku senang kau menilaiku sebaik itu. Dan, lain kali, seperti katamu, aku... akan lebih siap untuk mengungkapkan perasaanku secara bergantian."
      Speaker = "Moros"
      Event = "MorosGift08"
    }
    {
      Id = "Melinoe_4759"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutunggu saat itu."
      Speaker = "Melinoe"
      Event = "MorosGift08"
    }
    {
      Id = "Melinoe_4608"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, Tuan Moros, siap membiarkan hatimu berbicara kali ini? Karena ini ada sesuatu yang ingin kuberikan padamu. Kehadiranmu yang tenang dan penuh perhatian di Crossroads ini sangat berarti bagiku, jadi terima kasih banyak."
      Speaker = "Melinoe"
      Event = "MorosGift09"
    }
    {
      Id = "Moros_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya aku yang berterima kasih padamu, Tuan Putri. Bukan hanya untuk hadiah seindah ini... tapi juga karena kau telah memberiku hal lain untuk diperjuangkan, selain panggilan yang digariskan oleh Takdir."
      Speaker = "Moros"
      Event = "MorosGift09"
    }
    {
      Id = "Melinoe_4609"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hal lain untuk diperjuangkan? Maksudmu Nektar dan Ambrosia? Enak, kan? Aku bisa mencarikannya lagi untukmu!"
      Speaker = "Melinoe"
      Event = "MorosGift09"
    }
    {
      Id = "Moros_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu aku akan menerimanya dengan senang hati, meski bukan itu maksudku. Maksudku... menyadari bahwa kau bisa menghabiskan waktumu dengan siapa saja, aku ingin berusaha agar waktu yang kau lalui bersamaku menjadi sangat berharga. Membahagiakan bagimu sebagaimana hal itu membahagiakanku."
      Speaker = "Moros"
      Event = "MorosGift09"
    }
    {
      Id = "Melinoe_4610"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi waktu yang kita lalui bersama selama ini sudah terasa sangat berarti bagiku. Aku tak ingin kau berpikir sebaliknya, atau mengubah sikapmu kepadaku. Aku suka perasaanku saat sedang bersamamu."
      Speaker = "Melinoe"
      Event = "MorosGift09"
    }
    {
      Id = "Moros_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau tak tahu betapa leganya aku mendengarnya. Yah, aku hanya menyampaikan apa yang kuyakini disuarakan oleh hatiku, setelah mendengarkannya lebih saksama. Mungkin sebaiknya kusimpan saja isi hatiku itu..."
      Speaker = "Moros"
      Event = "MorosGift09"
    }
    {
      Id = "Melinoe_4611"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak, tentu saja jangan. Aku justru senang."
      Speaker = "Melinoe"
      Event = "MorosGift09"
    }
    {
      Id = "Melinoe_0915"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Moros? Bagaimanapun juga aku ingin memberikan ini kepadamu, tapi jika saat ini kau sedang tidak terlalu sibuk, maukah menikmatinya bersamaku di kedai? Aku tahu ini mendadak, hanya saja... aku benar-benar butuh istirahat sejenak..."
      Speaker = "Melinoe"
      Event = "MorosTaverna01"
    }
    {
      Id = "Moros_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putri Melinoë, dengan senang hati. Maukah kau memimpin jalannya?"
      Speaker = "Moros"
      Event = "MorosTaverna01"
    }
    {
      Id = "Melinoe_0916"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jadi, beban itu tentu {#Emph}bisa {#Prev}terasa luar biasa berat. Entah mana sumber motivasi yang lebih baik: mereka yang amat yakin aku pasti berhasil dalam segala hal, atau mereka yang amat yakin kalau aku pasti gagal."
      Speaker = "Melinoe"
      Event = "MorosTaverna01"
    }
    {
      Id = "Moros_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Pikiranku pun sering kali berjalan ke arah yang sama. Tiga Morai, mereka bisa mengantisipasi hasil dari segala jerih payahku dan terkadang memarahiku karena kesalahan sepele yang bahkan belum kuperbuat. Itu tidak selalu membangkitkan semangat seperti yang diharapkan."
      Speaker = "Moros"
      Event = "MorosTaverna01"
    }
    {
      Id = "Melinoe_0917"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu, dari mana kau mendapatkan kekuatan? Tanggung jawabmu terdengar sangat berat."
      Speaker = "Melinoe"
      Event = "MorosTaverna01"
    }
    {
      Id = "Moros_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua itu pada akhirnya sekadar menjadi kekuatan dari sebuah kebiasaan. Kau melatih suatu keahlian hingga mahir, lalu takut untuk melepaskannya... takut kau tak akan pernah bisa sehebat itu dalam hal lain..."
      Speaker = "Moros"
      Event = "MorosTaverna01"
    }
    {
      Id = "Melinoe_0918"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak menyangka sang Takdir Kematian sendiri menyimpan keraguan semacam itu."
      Speaker = "Melinoe"
      Event = "MorosTaverna01"
    }
    {
      Id = "Moros_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah! Mungkin seharusnya aku terlahir sebagai dewa {#Emph}Rasa Takut! {#Prev}Lalu menurutmu, dari mana datangnya hal itu? Sumber motivasimu untuk menjalankan tugasmu."
      Speaker = "Moros"
      Event = "MorosTaverna01"
    }
    {
      Id = "Melinoe_3353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir motivasiku datang dari angan-angan untuk menemukan lebih banyak Ambrosia ini di luar sana; ini {#Emph}enak sekali!"
      Speaker = "Melinoe"
      Event = "MorosTaverna01"
    }
    {
      Id = "Moros_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat menikmati kebersamaan denganmu, Putri, dan terima kasih atas minumannya. Kuharap kita akan punya lebih banyak kesempatan seperti ini, bukan?"
      Speaker = "Moros"
      Event = "MorosTaverna01"
    }
    {
      Id = "Melinoe_0920"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuharap demikian juga."
      Speaker = "Melinoe"
      Event = "MorosTaverna01"
    }
    {
      Id = "Melinoe_4612"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf jika lancang, tapi akhir-akhir ini kau tampak agak tegang, Tuan Moros. Bagaimana jika kita berbagi sebotol minuman bersama di kedai? Sudah cukup lama sejak terakhir kali."
      Speaker = "Melinoe"
      Event = "MorosTaverna02"
    }
    {
      Id = "Moros_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang lebih menyenangkan bagiku selain itu, Putri... hanya saja, aku tak ingin membebanimu, dan aku menyesal telah membiarkan kekhawatiranku—yang sebenarnya sepele—terlihat olehmu. Jadi tolong, jangan sampai merepotkan dirimu demi diriku."
      Speaker = "Moros"
      Event = "MorosTaverna02"
    }
    {
      Id = "Melinoe_4613"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak merasa direpotkan. Dan jika kau sungguh ingin waktu yang kita lalui bersama terasa berarti, kau bisa memulainya dengan memanfaatkan kesempatan yang ada di hadapanmu."
      Speaker = "Melinoe"
      Event = "MorosTaverna02"
    }
    {
      Id = "Moros_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Alasanmu sangat meyakinkan. Kalau begitu, suatu kehormatan bagiku untuk menemanimu. Mari kita ke sana?"
      Speaker = "Moros"
      Event = "MorosTaverna02"
    }
    {
      Id = "Moros_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Terkadang aku memang tertarik pada orang lain, ya. Tapi, aku cukup tahu diri untuk tidak membiarkan hatiku terikat. Jika hatiku mulai berbisik, aku selalu bisa membungkamnya."
      Speaker = "Moros"
      Event = "MorosTaverna02"
    }
    {
      Id = "Melinoe_4614"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya dalam hal itu, kita cukup mirip... pandai membungkam isi hati. Tapi jika ada satu hal yang kupelajari dari Dewi Afrodit, itu adalah bahwa hasrat kita tak melulu harus ditekan."
      Speaker = "Melinoe"
      Event = "MorosTaverna02"
    }
    {
      Id = "Moros_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maksudmu, Putri? Hasrat macam apa yang mungkin kau tekan, mengingat semua pencapaian yang telah kau raih sejauh ini?"
      Speaker = "Moros"
      Event = "MorosTaverna02"
    }
    {
      Id = "Melinoe_4615"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, salah satunya, bahkan keberadaanku di sini bersamamu... diriku yang dulu tak akan pernah punya kejernihan pikiran untuk mengajakmu, kurasa. Pikiranku pasti sudah membujuk hatiku agar mengurungkan niat itu."
      Speaker = "Melinoe"
      Event = "MorosTaverna02"
    }
    {
      Id = "Moros_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, aku sangat bersyukur hatimu mulai lebih sering memenangkan perdebatan itu. Kupikir itu justru membuatmu kian kuat, dan... mungkin ini pengaruh Ambrosia, tapi... aku sangat menyukai hal itu. Menyukai seluruh dirimu seutuhnya, sungguh."
      Speaker = "Moros"
      Event = "MorosTaverna02"
    }
    {
      Id = "Melinoe_4616"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh...! Mumpung kita sedang berterus terang... aku juga mulai menyukaimu... tapi, jika kau sudah dijodohkan dengan yang lain, aku tak ingin mencampuri urusan itu."
      Speaker = "Melinoe"
      Event = "MorosTaverna02"
    }
    {
      Id = "Moros_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak mengenal dewi lain yang dijodohkan denganku itu, dan aku pun tak berniat mengenalnya. Lagi pula aku sudah melanggar kehendak para Morai; kita berdua sudah melakukannya. Ke mana pun semua ini berujung, aku ingin {#Emph}kau {#Prev}yang ada di sampingku."
      Speaker = "Moros"
      Event = "MorosTaverna02"
    }
    {
      Id = "Moros_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat menikmati waktu kita bersama, Putri, dan aku akan selalu menantikan saat kita bisa bersama lagi. Kuharap segera."
      Speaker = "Moros"
      Event = "MorosTaverna02"
    }
    {
      Id = "Melinoe_4618"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku merasakan hal yang sama."
      Speaker = "Melinoe"
      Event = "MorosTaverna02"
    }
    {
      Id = "Moros_0524"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putri, dengan senang hati aku akan berbagi Ambrosia denganmu."
      Speaker = "Moros"
      Event = "MorosTavernaRepeatable01[1]"
    }
    {
      Id = "Moros_0527"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asalkan kau tak mengira kehadiranku di sana bakal tak diharapkan, terlebih bersamamu."
      Speaker = "Moros"
      Event = "MorosTavernaRepeatable01[1]"
    }
    {
      Id = "Moros_0530"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir rehat sejenak dari Daftar Takdir adalah ide yang bagus, mumpung kau menyinggungnya."
      Speaker = "Moros"
      Event = "MorosTavernaRepeatable01[1]"
    }
    {
      Id = "Moros_0525"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Arwah-arwah lain sepertinya masih agak tegang saat aku berada di dekat mereka..."
      Speaker = "Moros"
      Event = "MorosTavernaRepeatable01[2]"
    }
    {
      Id = "Moros_0528"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ini benar-benar salah satu tradisi favoritku di sini. Demi kemenanganmu yang berkelanjutan!"
      Speaker = "Moros"
      Event = "MorosTavernaRepeatable01[2]"
    }
    {
      Id = "Moros_0531"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Pada saat-saat seperti ini, aku jadi teringat pada para saudariku. Tanpa mereka, kita tak akan pernah bertemu."
      Speaker = "Moros"
      Event = "MorosTavernaRepeatable01[2]"
    }
    {
      Id = "Moros_0526"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas kebersamaannya. Kuharap kau menikmatinya sama seperti diriku."
      Speaker = "Moros"
      Event = "MorosTavernaRepeatable01[3]"
    }
    {
      Id = "Moros_0529"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa rasa Ambrosia selalu terasa berbeda dan luar biasa setiap saat?"
      Speaker = "Moros"
      Event = "MorosTavernaRepeatable01[3]"
    }
    {
      Id = "Moros_0532"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku penasaran apakah Sang Tiga Takdir tahu kita akan melewati masa-masa seperti ini."
      Speaker = "Moros"
      Event = "MorosTavernaRepeatable01[3]"
    }
    {
      Id = "Moros_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih untuk itu! Waktu yang kuhabiskan bersamamu tadi sangat menyenangkan."
      Speaker = "Moros"
      Event = "MorosTavernaRepeatable01[3]"
    }
    {
      Id = "Melinoe_3555"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku terpikir untuk pergi ke pemandian air panas dan mengira Paduka mungkin berminat."
      Speaker = "Melinoe"
      Event = "MorosBathHouseDecline01"
    }
    {
      Id = "Moros_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan segala hormat, Tuan Putri, ada peristiwa masa lalu yang perlu kudokumentasikan, jadi sebaiknya aku tidak ikut dulu. Mungkin lain kali?"
      Speaker = "Moros"
      Event = "MorosBathHouseDecline01"
    }
    {
      Id = "Melinoe_0921"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa Paduka sudah mencoba pemandian air panas kami, Lord Moros? Airnya menyegarkan raga dan pikiran. Aku baru mau ke sana, berminat bergabung?"
      Speaker = "Melinoe"
      Event = "MorosBathHouse01"
    }
    {
      Id = "Moros_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, a-aku... kurasa tak ada salahnya! Aku pernah melihat dan mendengar tentang pemandian seperti itu, meski belum pernah ke sana."
      Speaker = "Moros"
      Event = "MorosBathHouse01"
    }
    {
      Id = "Moros_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tak kusangka tempat seperti ini tersembunyi di sini..."
      Speaker = "Moros"
      Event = "MorosBathHouse01"
    }
    {
      Id = "Melinoe_0923"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, apa yang Paduka dan Sang Takdir lakukan untuk hiburan di tempat asalmu dulu?"
      Speaker = "Melinoe"
      Event = "MorosBathHouse01"
    }
    {
      Id = "Moros_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa sudah kusebutkan kalau mereka suka menenun? Menenun adalah pekerjaan sekaligus {#Emph}hasrat {#Prev}mereka. Aku sendiri tak pernah begitu mahir, dan mereka bertiga saja sudah cukup, jadi..."
      Speaker = "Moros"
      Event = "MorosBathHouse01"
    }
    {
      Id = "Melinoe_0924"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kenal seorang pemintal ulung yang mungkin bisa membantu teknikmu. Lalu apa yang Paduka lakukan saat mereka sibuk memintal benang?"
      Speaker = "Melinoe"
      Event = "MorosBathHouse01"
    }
    {
      Id = "Moros_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku menjelajahi dunia! Menyaksikan manusia fana di detik-detik terakhir mereka. Menatap wajah mereka tepat saat mereka tewas... sering kali dalam kengerian..."
      Speaker = "Moros"
      Event = "MorosBathHouse01"
    }
    {
      Id = "Melinoe_0925"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Paduka melakukan itu untuk hiburan?"
      Speaker = "Melinoe"
      Event = "MorosBathHouse01"
    }
    {
      Id = "Moros_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sifat tugasku menyisakan sedikit sekali waktu senggang. Dan hanya itu yang bisa kulakukan demi membuat saat-saat terakhir itu bermartabat... walau kurasa niat baik itu tak selalu tersampaikan."
      Speaker = "Moros"
      Event = "MorosBathHouse01"
    }
    {
      Id = "Moros_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya sudah lama sekali aku tidak sesegar ini... yah, sudah sekian waktu berlalu. Sekali lagi, terima kasih."
      Speaker = "Moros"
      Event = "MorosBathHouse01"
    }
    {
      Id = "Melinoe_0922"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lord Moros, bersediakah Paduka menemaniku ke pemandian lagi kapan-kapan? Dan maksudku kapan-kapan itu... apa Paduka sedang senggang sekarang?"
      Speaker = "Melinoe"
      Event = "MorosBathHouse02"
    }
    {
      Id = "Moros_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira Tuan Putri takkan pernah mengajakku lagi! Aku merindukan kehangatan air pemandian sejak kunjungan terakhir kita."
      Speaker = "Moros"
      Event = "MorosBathHouse02"
    }
    {
      Id = "Moros_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku pasti bisa terbiasa dengan ini..."
      Speaker = "Moros"
      Event = "MorosBathHouse02"
    }
    {
      Id = "Melinoe_0927"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hubunganmu dengan Sang Takdir terdengar cukup rumit. Paduka tak pernah hidup sendirian sebelumnya, ya?"
      Speaker = "Melinoe"
      Event = "MorosBathHouse02"
    }
    {
      Id = "Moros_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum pernah. Mereka adalah saudari-saudariku, sekaligus para tetuaku. Aku tumbuh di bawah pengawasan mereka, dan aku lebih dari sekadar saudara; aku adalah pelindung mereka. Namun pada akhirnya, aku gagal melindungi mereka. Mungkin mereka sudah tahu aku akan mengecewakan mereka, tapi tetap menyayangiku."
      Speaker = "Moros"
      Event = "MorosBathHouse02"
    }
    {
      Id = "Melinoe_0928"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan berpikir seperti itu. Paduka memikul salah satu tanggung jawab terpenting di dunia. Sang Takdir maha tahu segalanya, bukan? Jadi sudah sewajarnya tak ada orang yang lebih tepat untuk tugas itu selain Paduka."
      Speaker = "Melinoe"
      Event = "MorosBathHouse02"
    }
    {
      Id = "Moros_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tuan Putri? Bisakah kau membiarkanku larut dalam kepedihanku sebentar saja? {#Emph}Ah... {#Prev}tidak, tunggu. Lupakan. Rasanya sudah hilang. Barusan itu mantra penghibur yang luar biasa darimu."
      Speaker = "Moros"
      Event = "MorosBathHouse02"
    }
    {
      Id = "Melinoe_0929"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Heh{#Prev}, sudahlah. Aku tahu Paduka menyayangi saudari-saudarimu, tapi... mengingat situasinya sekarang, mungkin sedikit jarak akan berdampak baik bagimu."
      Speaker = "Melinoe"
      Event = "MorosBathHouse02"
    }
    {
      Id = "Moros_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin.... Tapi pemandian ini berdampak baik bagiku, aku sama sekali tak meragukannya."
      Speaker = "Moros"
      Event = "MorosBathHouse02"
    }
    {
      Id = "Moros_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku benar-benar membutuhkannya. Dan ditemani olehmu selalu terasa menyenangkan."
      Speaker = "Moros"
      Event = "MorosBathHouse02"
    }
    {
      Id = "Melinoe_4814"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita ke pemandian lagi, Moros? Aku sedang tidak buru-buru sekarang, kalau kau juga senggang."
      Speaker = "Melinoe"
      Event = "MorosBathHouse03"
    }
    {
      Id = "Moros_0682"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan sangat senang. Di sana begitu damai... hampir mirip saat kita berjumpa tepat ketika kau kembali."
      Speaker = "Moros"
      Event = "MorosBathHouse03"
    }
    {
      Id = "Melinoe_4815"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kupikir ada kemungkinan Sang Takdir yang mengatur semua ini. Antara kita berdua. Dan maksudku {#Emph}semuanya. {#Prev}Pernahkah itu terlintas di benakmu?"
      Speaker = "Melinoe"
      Event = "MorosBathHouse03"
    }
    {
      Id = "Moros_0684"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin sedikit, tapi itu sesuatu yang enggan kupercayai. Mengapa Sang Takdir menjodohkanku dengan yang lain jika mereka ingin aku bersamamu? Itu sama sekali tak masuk akal."
      Speaker = "Moros"
      Event = "MorosBathHouse03"
    }
    {
      Id = "Melinoe_4816"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu, hanya saja... terkadang untuk membuat seseorang melakukan sesuatu, cara terbaik adalah memaksa mereka melakukan hal sebaliknya yang {#Emph}tidak {#Prev}mereka inginkan. Mereka justru akan melakukan apa yang sebenarnya kita inginkan sebagai bentuk pembangkangan. Trik manipulasi psikologis sederhana."
      Speaker = "Melinoe"
      Event = "MorosBathHouse03"
    }
    {
      Id = "Moros_0685"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi aku selalu patuh. Mereka tak punya alasan untuk berpikir aku akan membangkang... tidak, aku tak bisa menerima bahwa kita dijebak ke dalam semua ini. Pertemuan kita mungkin bukan kebetulan, tapi tetap saja. Saudari-saudariku punya urusan yang jauh lebih penting."
      Speaker = "Moros"
      Event = "MorosBathHouse03"
    }
    {
      Id = "Melinoe_4817"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa itu tak begitu penting lagi sekarang. Tapi jika mereka memang mentakdirkan kita harus bertemu, aku bersyukur. Mereka bisa saja memilihkan orang lain yang jauh kurang pantas."
      Speaker = "Melinoe"
      Event = "MorosBathHouse03"
    }
    {
      Id = "Moros_0686"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka selalu punya cara tersendiri. Dan aku tak pernah merasa lebih bersyukur daripada ini, kepada mereka, maupun kepadamu."
      Speaker = "Moros"
      Event = "MorosBathHouse03"
    }
    {
      Id = "Moros_0687"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Fyuuh! {#Prev}Kurasa aku siap menghadapi apa pun yang telah dipersiapkan Sang Takdir nanti. Sampai jumpa, Melinoë."
      Speaker = "Moros"
      Event = "MorosBathHouse03"
    }
    {
      Id = "Moros_0509"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan sangat menyambut ajakan pergi ke pemandian bersamamu lagi."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[1]"
    }
    {
      Id = "Moros_0512"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang lebih kuinginkan selain menemanimu ke pemandian lagi."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[1]"
    }
    {
      Id = "Moros_0515"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keinginanmu saat ini sama persis denganku. Mari, kita ke pemandian air panas!"
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[1]"
    }
    {
      Id = "Moros_0637"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat takut kau tak akan mengajakku lagi."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[1]"
    }
    {
      Id = "Moros_0640"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan senang hati aku akan menerimanya."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[1]"
    }
    {
      Id = "Moros_0643"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu akan terasa sangat menyenangkan saat ini. Bisa kita berangkat?"
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[1]"
    }
    {
      Id = "Moros_0646"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setelah kau mengatakannya, rasanya aku sangat menginginkannya."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[1]"
    }
    {
      Id = "Moros_0510"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Berada di sini jauh lebih menenangkan daripada di dalam kegelapan di luar ruang dan waktu."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[3]"
    }
    {
      Id = "Moros_0513"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ini tempat yang tepat untuk melenyapkan segala beban pikiran yang kita bawa."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[3]"
    }
    {
      Id = "Moros_0516"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kehangatan dan kenyamanan air ini tak pernah berhenti membuatku takjub."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[3]"
    }
    {
      Id = "Moros_0638"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Semoga segala kekhawatiran kita hanyut untuk sementara waktu."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[3]"
    }
    {
      Id = "Moros_0641"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Suhu air di sini selalu sempurna."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[3]"
    }
    {
      Id = "Moros_0644"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Rasanya aku bisa berendam di sini sepanjang malam."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[3]"
    }
    {
      Id = "Moros_0647"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Membersihkan raga sama halnya dengan menyucikan pikiran."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[3]"
    }
    {
      Id = "Moros_0511"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh menyegarkan, dan benar-benar menyenangkan."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[4]"
    }
    {
      Id = "Moros_0514"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tenagaku serasa pulih sepenuhnya, dan seperti biasa, selalu menyenangkan bersamamu."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[4]"
    }
    {
      Id = "Moros_0517"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fyuuh! {#Prev}Rasanya aku bisa tinggal di sana sepanjang malam tadi."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[4]"
    }
    {
      Id = "Moros_0639"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan setiap saat, Tuan Putri."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[4]"
    }
    {
      Id = "Moros_0642"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepertinya aku memang sangat membutuhkannya. Terima kasih."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[4]"
    }
    {
      Id = "Moros_0645"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, tadi itu sangat menyegarkan, bukan?"
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[4]"
    }
    {
      Id = "Moros_0648"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat menikmatinya, dan selalu bersyukur atas kehadiranmu."
      Speaker = "Moros"
      Event = "MorosBathHouseRepeatable01[4]"
    }
    {
      Id = "Melinoe_3501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maukah kau menemaniku sebentar di dermaga pemancingan, Tuan Moros? Kupikir kita bisa memakai Umpan Kembar ini."
      Speaker = "Melinoe"
      Event = "MorosFishingDecline01"
    }
    {
      Id = "Moros_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah! {#Prev}Aku khawatir penghuni sungai tak mau mendekat malam ini jika aku ada di sana, terkadang mereka bisa merasakan kehadiranku. Maafkan aku."
      Speaker = "Moros"
      Event = "MorosFishingDecline01"
    }
    {
      Id = "Melinoe_0937"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bolehkah kutanya, Tuan Moros, apakah kau bersedia menemaniku ke tepi sungai? Firasatku berkata kehadiranmu mungkin bisa membantu tangkapan malam ini."
      Speaker = "Melinoe"
      Event = "MorosFishing01"
    }
    {
      Id = "Moros_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cukup pandai menghadapi berbagai makhluk fana, jadi ya, aku akan menemanimu."
      Speaker = "Moros"
      Event = "MorosFishing01"
    }
    {
      Id = "Moros_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan aku, tapi aku tak pernah benar-benar mengerti dorongan untuk menarik makhluk air keluar dari habitat aslinya. Aku tahu bagi kaum fana itu terkadang kebutuhan pokok, meski yang lain melakukannya demi kesenangan semata. Mengapa?"
      Speaker = "Moros"
      Event = "MorosFishing01"
    }
    {
      Id = "Melinoe_3239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagi kaum fana, tampaknya itu kesempatan untuk menegaskan dominasi mereka atas alam liar. Meski aku tak akan bangga mengelabui makhluk seperti itu andai aku jadi mereka. Bagi kita... kita menjaga habitat bagi semua spesies yang kita temukan."
      Speaker = "Melinoe"
      Event = "MorosFishing01"
    }
    {
      Id = "Moros_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya itu tanggung jawab yang cukup memberatkan untuk makhluk yang seharusnya bisa mengurus diri mereka sendiri."
      Speaker = "Moros"
      Event = "MorosFishing01"
    }
    {
      Id = "Melinoe_3240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kurasa ada alasan lain di baliknya. Salah satunya adalah suasana yang menenangkan, kan? Artinya kita bisa sedikit membicarakan hal-hal di luar tanggung jawab berat kita {#Emph}sendiri{#Prev}."
      Speaker = "Melinoe"
      Event = "MorosFishing01"
    }
    {
      Id = "Moros_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagian itu tentu sangat kuhargai. Dan sekarang kita menunggu..."
      Speaker = "Moros"
      Event = "MorosFishing01"
    }
    {
      Id = "Moros_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin ada baiknya membiarkan pikiran berkelana sesekali ke hal-hal seperti ini."
      Speaker = "Moros"
      Event = "MorosFishing01"
    }
    {
      Id = "Moros_0518"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, selama kau tidak keberatan jika aku membuat takut semua yang ada di sungai."
      Speaker = "Moros"
      Event = "MorosFishingRepeatable01[1]"
    }
    {
      Id = "Moros_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Peringatan dulu, kau takkan mendapat keuntungan curang dariku untuk memikat ikan-ikan malang itu."
      Speaker = "Moros"
      Event = "MorosFishingRepeatable01[1]"
    }
    {
      Id = "Moros_0520"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rupanya sudah waktunya bagi satu atau dua penghuni sungai."
      Speaker = "Moros"
      Event = "MorosFishingRepeatable01[1]"
    }
    {
      Id = "Moros_0522"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita mungkin harus menahan ejekan dari Eris, tapi tak ada salahnya mencoba."
      Speaker = "Moros"
      Event = "MorosFishingRepeatable01[1]"
    }
    {
      Id = "Moros_0519"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tak tahu apa dari diriku yang membuat ikan-ikan itu merasa begitu terintimidasi..."
      Speaker = "Moros"
      Event = "MorosFishingRepeatable01[2]"
    }
    {
      Id = "Moros_0521"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku cukup menikmati waktu di tepi sungai. Terima kasih atas ajakannya."
      Speaker = "Moros"
      Event = "MorosFishingRepeatable01[2]"
    }
    {
      Id = "Moros_0523"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kunjungan yang sangat membuahkan hasil, dan malam ini baru saja dimulai!"
      Speaker = "Moros"
      Event = "MorosFishingRepeatable01[2]"
    }
    {
      Id = "Melinoe_1150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Moros sedang pergi..."
      Speaker = "Melinoe"
      Event = "NPC_Moros_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_1151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di mana Tuan Moros?"
      Speaker = "Melinoe"
      Event = "NPC_Moros_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_1149"
      InheritFrom = "BaseSubtitle"
