    }
    {
      Id = "Chronos_1406"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekian lama waktu... terbuang sia-sia. Mungkin Sang Takdir sendiri selalu tahu rencanaku akan digagalkan lagi."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRemembranceVoiceLines"
    }
    {
      Id = "Chronos_1519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah ini... masa depan...? Ataukah masa lalu...? Bukan cuma milikku... melainkan milikmu juga, Cucu Perempuan...? Dan semua orang di Wangsa ini...?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosBetterPastVoiceLines"
    }
    {
      Id = "Chronos_1408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiga... dua... {#Emph}satu...!"
