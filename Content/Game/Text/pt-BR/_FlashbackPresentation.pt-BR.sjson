      Event = "SetupFlashback03.voiceLines"
    }
    {
      Id = "Chronos_1409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siap atau tidak, kini aku melangkah..."
      Speaker = "Chronos"
      Event = "SetupFlashback03.voiceLines"
    }
    {
      Id = "MelinoeField_5132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Haha! {#Prev}Hore!"
