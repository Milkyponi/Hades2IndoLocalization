      Event = "GlobalVoiceLines.MemorySequenceVoiceLines"
    }
    {
      Id = "MelinoeField_5137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak tahu apakah itu benar-benar {#Emph}diriku..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MemorySequenceVoiceLines"
    }
    {
      Id = "MelinoeField_5138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akhirnya aku menang!"
