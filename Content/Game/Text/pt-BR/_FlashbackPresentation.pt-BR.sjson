      Event = "GlobalVoiceLines.MemorySequenceVoiceLines"
    }
    {
      Id = "MelinoeField_5133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasakan itu!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MemorySequenceVoiceLines"
    }
    {
      Id = "MelinoeField_5134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Silakan lewat sini!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MemorySequenceVoiceLines"
    }
    {
      Id = "MelinoeField_5135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lalu apa yang terjadi...?"
