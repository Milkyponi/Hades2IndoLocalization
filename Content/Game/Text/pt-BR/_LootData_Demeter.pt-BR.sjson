{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _LootData_Demeter.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_0647"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lambang es beku..."
      Speaker = "Melinoe"
      Event = "DemeterUpgrade.FirstSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Brr... dinginnya..."
      Speaker = "Melinoe"
      Event = "DemeterUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nenek..."
      Speaker = "Melinoe"
      Event = "DemeterUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Demeter_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dahulu kala, saat saudari-saudariku, saudara-saudara angkatku, dan aku menggulingkan Chronos, umur kami tak jauh dari umur{#Emph}mu {#Prev}sekarang, kuncup mudaku. Kini kami menua, yang semestinya membuat kami kian bijak... meski pertengkaran sepele dan sikap pasif kami belakangan ini justru menunjukkan sebaliknya."
      Speaker = "Demeter"
      Event = "DemeterWithZeus01"
    }
    {
      Id = "Zeus_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga kita ini sama-sama berpendirian keras, dan kau tahu betul soal itu, Yang Mulia Demeter. Kita harus melangkah maju serempak! Membangun kesepakatan semacam itu tak pernah mudah; kendati demikian, kita masing-masing bisa turut mempercepatnya."
      Speaker = "Zeus"
      Event = "DemeterWithZeus01"
    }
    {
      Id = "Demeter_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini, bahkan adik perempuanku yang jelita pun terpaksa mengotori tangan halusnya demi pekerjaan lapangan yang tak ada habisnya. Tampaknya ia bahkan mulai terbiasa... bukan begitu, Hera Ratu kami?"
      Speaker = "Demeter"
      Event = "DemeterWithHera01"
    }
    {
      Id = "Hera_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, Demeter. Tangan ini sudah melewati cobaan lebih dari yang kau tahu! Aku hanya tak suka mengumbar derita yang kutanggung. Seseorang {#Emph}bisa {#Prev}sekukuh batu karang tanpa harus menjadi sekasar permukaannya."
      Speaker = "Hera"
      Event = "DemeterWithHera01"
    }
    {
      Id = "Demeter_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cucuku, Poseidon di sini baru saja membanggakan masa-masa ketika lautannya menenggelamkan separuh daratan! {#Emph}Ahh{#Prev}, sungguh air bah yang luar biasa! Barangkali kekuatan kita bisa disatukan kembali..."
      Speaker = "Demeter"
      Event = "DemeterWithPoseidon01"
    }
    {
      Id = "Poseidon_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tak ada kata {#Emph}barangkali{#Prev}, Demeter! Badai ini pasti sanggup kita lewati! Aku malah tak sabar ingin menciptakan banjir bandang raksasa lagi demi bernostalgia melawan si {#Emph}Waktu {#Prev}tengik itu, hanya saja... manusia fana zaman sekarang sudah terlalu banyak!"
      Speaker = "Poseidon"
      Event = "DemeterWithPoseidon01"
    }
    {
      Id = "Demeter_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kan, kuncup mudaku, betapa manusia fana selalu berusaha menjadi seperti kita? Namun lucunya, mereka malah meniru sifat-sifat buruk kita. Barangkali ini salah Yang Mulia Apollo, karena teladan yang ia pasang terlalu tinggi!"
      Speaker = "Demeter"
      Event = "DemeterWithApollo01"
    }
    {
      Id = "Apollo_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa aku menyinggungmu tanpa sengaja, Yang Mulia Demeter? Aku tahu situasi sekarang memang begitu kejam, tapi bukankah lebih baik kita arahkan kekejaman itu pada musuh-musuh kita, daripada saling melempar sindiran di sini?"
      Speaker = "Apollo"
      Event = "DemeterWithApollo01"
    }
    {
      Id = "Demeter_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bantuan dari Olympus bisa hadir dalam berbagai wujud... mengingat tak semua dari kita siap atau bahkan {#Emph}diciptakan {#Prev}untuk menghadapi cobaan berat. Contohnya saja, si cantik jelita Aphrodite di sebelahku ini..."
      Speaker = "Demeter"
      Event = "DemeterWithAphrodite01"
    }
    {
      Id = "Aphrodite_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, Yang Mulia Demeter, kau tahu perkataanmu itu {#Emph}sama sekali {#Prev}keliru! Aku mungkin lebih suka bercinta daripada berperang, tapi bukan berarti aku tak sudi meremukkan wajah musuh-musuh kita jika itu satu-satunya cara membuat mereka {#Emph}tahu diri! {#Prev}Sekarang, bagaimana kalau kita buktikan pada cucumu betapa rukunnya kita?"
      Speaker = "Aphrodite"
      Event = "DemeterWithAphrodite01"
    }
    {
      Id = "Demeter_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan {#Emph}aku {#Prev}pun terkadang butuh sedikit hawa panas, kuncup mudaku, dan perapian Hephaestus di sini menyediakannya dengan baik. Anggap saja sebagai pelipur atas dinginnya hubungan dan ketiadaan {#Emph}kehangatan {#Prev}antaranggota keluarga kita."
      Speaker = "Demeter"
      Event = "DemeterWithHephaestus01"
    }
    {
      Id = "Hephaestus_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, coba {#Emph}dengar {#Prev}kata Yang Mulia Demeter! Semua orang di puncak gunung ini merasa diri mereka {#Emph}paling tajam{#Prev}, tapi dewi yang {#Emph}satu ini? {#Prev}Dia tumpul dan hantam langsung bagai paluku. Dan terkadang, beberapa urusan memang butuh hantaman palu godam, bukan?"
      Speaker = "Hephaestus"
      Event = "DemeterWithHephaestus01"
    }
    {
      Id = "Demeter_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi Buyutmu Hestia tak sepenuhnya seperti yang {#Emph}kelihatan. {#Prev}Zaman dahulu, ia sudah cukup puas membiarkan apinya berpendar tenang di dalam tungku perapian rumah kaum fana. Akui saja, Saudari: Kau sudah berubah."
      Speaker = "Demeter"
      Event = "DemeterWithHestia01"
    }
    {
      Id = "Hestia_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau sendiri, Demeter, kau sama sekali tak {#Emph}berubah! Tak satu pun {#Prev}dari kalian berubah! Makanya sekarang kalian kena {#Emph}masalah {#Prev}besar—atau lebih tepatnya, {#Emph}kita {#Prev}semua. Untung saja cucumu ini datang menyelamatkan kita!"
      Speaker = "Hestia"
      Event = "DemeterWithHestia01"
    }
    {
      Id = "Demeter_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang dewi perapian dan aku, kami berdua telah melalui begitu banyak hal bersama... tapi itu dulu sekali. Jadi bagaimana, Hestia? Apa nyalimu sudah cukup berani untuk menetap kembali di Olympus secara permanen?"
      Speaker = "Demeter"
      Event = "DemeterWithHestia02"
    }
    {
      Id = "Hestia_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita selesaikan dulu kekacauan ini sampai tuntas, barulah kupertimbangkan tawaran itu, Saudari! Kalian semua ini terkadang bikin pusing kepala kalau kau belum sadar, jadi aku belum memutuskan apa-apa."
      Speaker = "Hestia"
      Event = "DemeterWithHestia02"
    }
    {
      Id = "Demeter_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, Ares. Bahkan dewa perang kita yang paling bernafsu pun tak mampu menghentikan sekejap mata segala petaka yang tengah mendera keluarga kita. Sesedikit itukah kendalimu atas kuasamu sendiri?"
      Speaker = "Demeter"
      Event = "DemeterWithAres01"
    }
    {
      Id = "Ares_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita semua hanya mengupayakan yang terbaik, wahai Demeter. Bagianku adalah memastikan perang disulut saat dibutuhkan, dan hasil yang semestinya tercapai. Namun aku tak bisa menjamin durasi maupun intensitasnya secara pasti, sebab kekerasan adalah entitas liar yang punya kehendak sendiri."
      Speaker = "Ares"
      Event = "DemeterWithAres01"
    }
    {
      Id = "Melinoe_0648"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Guru bercerita banyak tentangmu, dan akhirnya kita bertemu juga. {#Emph}Atas nama Hades! Olympus, kuterima pesan ini!"
      Speaker = "Melinoe"
      Event = "DemeterFirstPickUp"
    }
    {
      Id = "Demeter_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau sungguh mirip ibumu. Aku takkan sudi kehilangannya lagi. Akan kubekukan seluruh neraka jika itu satu-satunya cara untuk membawanya pulang. Kau mau membantuku, kan, Cucuku?"
      Speaker = "Demeter"
      Event = "DemeterFirstPickUp"
    }
    {
      Id = "Demeter_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kau terluka! Darah mortalmu yang mengalir itu penyebabnya. Dan ini juga salahku, karena pernah jatuh hati pada pemuda desa biasa..."
      Speaker = "Demeter"
      Event = "DemeterLowHealth01"
    }
    {
      Id = "Demeter_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang terjadi, Cucuku? Semoga para bedebah yang melukaimu itu menderita seribu kali lipat atas perbuatan mereka."
      Speaker = "Demeter"
      Event = "DemeterLowHealth02"
    }
    {
      Id = "Demeter_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru mulai sudah cedera...! Ketahuilah bahwa rasa sakit yang kita derita adalah jalan bagi kita untuk bertumbuh. Dan musuh-musuh kita sebentar lagi akan merasakan penderitaan yang {#Emph}jauh lebih dahsyat."
      Speaker = "Demeter"
      Event = "DemeterLowHealth03"
    }
    {
      Id = "Demeter_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menumpahkan darahmu setiap malam demi menebus kesalahan kami. Aku tak bisa menyembuhkan lukamu dari kejauhan, tapi aku {#Emph}bisa {#Prev}membuat musuh-musuhmu remuk menjadi {#Emph}serpihan es{#Prev}, jika itu cukup menghiburmu."
      Speaker = "Demeter"
      Event = "DemeterLowHealth04"
    }
    {
      Id = "Demeter_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau memulai perjuangan berikutnya menantang hal yang mustahil ini, ketahuilah bahwa aku akan menyertaimu hingga akhir pahit itu tiba. Setidaknya, dalam wujud berkatku."
      Speaker = "Demeter"
      Event = "DemeterRunStart01"
    }
    {
      Id = "Demeter_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Majulah ke cobaan berikutnya dengan berkat dariku, Cucuku. Firasatku mengatakan malam ini akan menjadi malam yang amat sangat dingin bagi musuh-musuh kita..."
      Speaker = "Demeter"
      Event = "DemeterRunStart02"
    }
    {
      Id = "Demeter_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan seandainya malam ini membawamu bolak-balik menembus neraka, aku akan dengan senang hati mendampingimu. Namun, hanya ini bantuan terbaik yang bisa kuberikan dari sini."
      Speaker = "Demeter"
      Event = "DemeterRunStart03"
    }
    {
      Id = "Demeter_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ramalan cuaca malam ini memperkirakan penurunan suhu yang drastis. Tapi kau sudah sangat terbiasa dengan hawa dingin, kan?"
      Speaker = "Demeter"
      Event = "DemeterRunStart04"
    }
    {
      Id = "Demeter_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus. Alihkan fokusmu pada Titan Chronos, atau sisa-sisa wujud hinanya yang masih bercokol di kedalaman Dunia Bawah. Aku sudah tak sabar menyongsong masa ketika kita membinasakan mereka semua."
      Speaker = "Demeter"
      Event = "DemeterRunStartUnderworld01"
    }
    {
      Id = "Demeter_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku selalu menanti ibumu bangkit keluar dari Dunia Bawah dan kembali ke puncak gunung kami, persis seperti yang sedang kauupayakan saat ini. Kau dan dia punya kemiripan dalam beberapa hal, hanya saja ia selalu memiliki amarah yang begitu berapi-api..."
      Speaker = "Demeter"
      Event = "DemeterRunStartSurface01"
    }
    {
      Id = "Demeter_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat merindukan ibumu, begitu pula kakakmu. Dia dulu adalah tunas kecilku. Chronos pasti menyekapnya bersama yang lain di kediaman ayahmu, dasar bedebah tak tahu diampuni..."
      Speaker = "Demeter"
      Event = "DemeterAboutZagreus01"
    }
    {
      Id = "Demeter_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakakmu Zagreus, yah, kurasa ia bukan tunas kecilku lagi sekarang, melainkan telah tumbuh menjadi Pangeran Dunia Bawah yang luhur. Mengetahui kalian berdua akhirnya saling mengenal sungguh menghangatkan hati tuaku ini."
      Speaker = "Demeter"
      Event = "DemeterAboutZagreus02"
    }
    {
      Id = "Demeter_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë... Tadinya kupikir kau telah tiada. Baru saja lahir, tapi langsung direnggut oleh Chronos bersama putriku dan orang-orang terdekatnya. Namun sang Penyihir Persimpangan Jalan berhasil menyelamatkanmu dari sana, bukan? Beraninya dia tak mengirim kabar sedikit pun...?"
      Speaker = "Demeter"
      Event = "DemeterAboutMelinoe01"
    }
    {
      Id = "Demeter_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat Apollo yang cerah mengumpulkan kami dan mengabarkan bahwa saudari kembarnya, kala berburu musuh-musuh kita, tak sengaja mendapati kerabat kami yang telah lama hilang bersama sang Penyihir Persimpangan Jalan, yah... hatiku dipenuhi luapan sukacita sekaligus amarah yang membara..."
      Speaker = "Demeter"
      Event = "DemeterAboutMelinoe02"
    }
    {
      Id = "Demeter_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa saja memberi tahu kami; memberi tahu {#Emph}aku{#Prev}, selagi kau bertumbuh molek dan perkasa di bawah asuhan sang Penyihir. Namun mengenal watak Hecate... dia pasti menganggap risikonya terlalu besar. Aku paham. Aku akan mencoba memahaminya..."
      Speaker = "Demeter"
      Event = "DemeterAboutMelinoe03"
    }
    {
      Id = "Demeter_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertama kali ibumu hilang dariku... sang Penyihir Persimpangan Jalan muncul dari kegelapan demi menerangi jalanku, kala aku mencarinya hingga ke pelosok Bumi. Kami tak menemukan apa pun; namun setidaknya saat itu aku tidak sendirian..."
      Speaker = "Demeter"
      Event = "DemeterAboutHecate01"
    }
    {
      Id = "Demeter_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, aku selalu merasa memiliki ikatan batin dengan Hecate, meski kami jarang sekali bertemu. Dia sepertinya tak pernah berhasrat memiliki anak kandung sendiri. Namun bagaimanapun juga, Para Takdir telah menitipkanmu kepadanya."
      Speaker = "Demeter"
      Event = "DemeterAboutHecate02"
    }
    {
      Id = "Demeter_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum lama ini aku menghubungi sang Penyihir Persimpangan Jalan... untuk berterima kasih kepadanya, karena telah membuat keputusan sulit demi menyembunyikanmu sekian lama. Aku tahu dia melakukannya demi keselamatanmu... dan demi memperbesar peluang kemenangan kita."
      Speaker = "Demeter"
      Event = "DemeterAboutHecate03"
    }
    {
      Id = "Demeter_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}sangat membenci {#Prev}Chronos bahkan sejak masa mudaku. Nyaris sama besarnya dengan kebencianku pada ayah Titanku sendiri. Namun kami membalaskan dendam kami; pada Chronos, Hyperion, dan sisanya. Betapa bodohnya diriku dulu karena mengira kami takkan pernah melihat mereka lagi..."
      Speaker = "Demeter"
      Event = "DemeterAboutChronos01"
    }
    {
      Id = "Demeter_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita telah terkunci dalam konflik melawan Chronos begitu lama hingga kita mulai ragu apakah ada hal yang benar-benar bisa membawa perubahan. Aku bertanya-tanya, bungaku... bisakah kau sungguh-sungguh membebaskan kita dari malapetaka ini?"
      Speaker = "Demeter"
      Event = "DemeterAboutChronos02"
    }
    {
      Id = "Demeter_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutebak Chronos masih bepergian ke mana-mana dengan sabit emas norak miliknya itu? Dia sok menganggap dirinya sebagai penuai, berlagak bicara soal panen dan pembusukan; padahal dia hanya bicara dalam teka-teki, sementara {#Emph}akulah {#Prev}yang berkuasa atas bidang tersebut."
      Speaker = "Demeter"
      Event = "DemeterAboutChronos03"
    }
    {
      Id = "Demeter_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika benar kau berhasil mencapai dasar Dunia Bawah dan membantai Titan jahanam itu di sana, maka {#Emph}baguslah. {#Prev}Tentu dibutuhkan lebih dari itu, aku paham, tapi setidaknya kau pasti telah menanamkan rasa sakit, dan mungkin rasa takut padanya. Itu permulaan yang baik."
      Speaker = "Demeter"
      Event = "DemeterAboutChronosBossW01"
    }
    {
      Id = "Demeter_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil mengalahkan Chronos lagi, kan, bungaku? Kita sudah tahu dia bisa ditundukkan; aku sendiri pernah melakukannya. Namun bisakah dia dihancurkan seutuhnya? Sang Penyihir Persimpangan Jalan {#Emph}pasti {#Prev}tahu caranya..."
      Speaker = "Demeter"
      Event = "DemeterAboutChronosBossW02"
    }
    {
      Id = "Demeter_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prometheus mencuri api dari kami bukan demi umat fana, melainkan karena hasratnya sendiri demi kepentingannya pribadi. Lalu apa gunanya kekuatan itu baginya sekarang, di atas puncak gunung yang sedingin es ini?"
      Speaker = "Demeter"
      Event = "DemeterAboutPrometheus01"
    }
    {
      Id = "Demeter_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa saja memadamkan kobaran api milik Prometheus itu... namun jika kulakukan, seluruh umat fana kemungkinan besar akan mati membeku. Aku belum siap melangkah {#Emph}sejauh {#Prev}itu, kendati aku bisa saja terdorong untuk melakukannya."
      Speaker = "Demeter"
      Event = "DemeterAboutPrometheus02"
    }
    {
      Id = "Demeter_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Muslihat licik yang dirancang Chronos untuk menyibukkan kita semua... bahkan Prometheus pun masih saja menjadi duri dalam daging seperti dulu! Segera kabari kami jika kau mencurigai adanya tipu muslihat."
      Speaker = "Demeter"
      Event = "DemeterAboutPrometheus03"
    }
    {
      Id = "Demeter_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyusupan monster terkutuk Typhon itu... bukan sekadar ancaman, melainkan sebuah {#Emph}penghinaan! Akulah {#Prev}yang mengendalikan musim, namun berani-beraninya ia {#Emph}menyelimuti {#Prev}gunung kami dengan badai busuknya?"
      Speaker = "Demeter"
      Event = "DemeterAboutTyphon01"
    }
    {
      Id = "Demeter_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika benar Chronos berada di balik bangkitnya kembali Typhon, maka dia bukan cuma arogan, melainkan sudah gila. Menjanjikan Zaman Keemasan yang baru, namun menimpakan monster mengerikan seperti itu pada dunia ini?"
      Speaker = "Demeter"
      Event = "DemeterAboutTyphon02"
    }
    {
      Id = "Demeter_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salju kembali turun perlahan di Olympus seperti sedia kala, tak ada lagi bekas badai busuk Typhon yang tersisa... pun tiada sisa dari {#Emph}tubuhnya{#Prev}. Namun apakah kau masih bisa melawannya di suatu tempat di luar sana...?"
      Speaker = "Demeter"
      Event = "DemeterAboutTyphon03"
    }
    {
      Id = "Demeter_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zeus berujar bahwa kau sangat berjasa dalam menaklukkan Typhon di puncak gunung kami. Terima kasih untuk itu, bungaku, namun sayangnya aku tak bisa hadir di pelataran Istana untuk menyampaikannya langsung. Musuh kami sangat banyak, dan mereka tak henti-hentinya mendesak."
      Speaker = "Demeter"
      Event = "DemeterAboutTyphonW01"
    }
    {
      Id = "Demeter_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Monster Typhon itu rupanya belum sadar bahwa baik dia maupun Chronos takkan sanggup menghentikan kita. Namun kita akan {#Emph}memaksanya {#Prev}sadar, dan kehadiranmu di sini mungkin menjadi penentu yang kita butuhkan."
      Speaker = "Demeter"
      Event = "DemeterAboutTyphonW02"
    }
    {
      Id = "Demeter_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kini Sang Titan Chronos adalah satu-satunya tujuan kita. Jangan tunjukkan belas kasihan kepadanya, sama seperti monster yang dia lepaskan takkan berbelas kasihan kepada kita. Namun tetaplah berhati-hati; kupastikan kau harus kembali dengan selamat."
      Speaker = "Demeter"
      Event = "DemeterAboutTyphonDeath01"
    }
    {
      Id = "Demeter_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski aku begitu menikmati kemenangan kita atas Typhon, bisa bertemu denganmu secara langsung adalah segalanya bagiku, bungaku. Maafkan jika aku tak dikenal sebagai sosok yang ceria, terlebih akhir-akhir ini. Semoga kita dapat berjumpa lagi."
      Speaker = "Demeter"
      Event = "DemeterAboutTyphonDeath02"
    }
    {
      Id = "Demeter_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir Circe yang kau kenal itu. Dia putri jauh dari saudaraku sesama Titan, Helios sang Matahari, yang tak berani menampakkan batang hidungnya. Hasratnya pada tanah dan gandum hampir terasa berlebihan... meski aku tetap menghargai niat di baliknya."
      Speaker = "Demeter"
      Event = "DemeterAboutCirce01"
    }
    {
      Id = "Demeter_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak sekali hal yang ingin kubicarakan denganmu, Melinoë... namun sekarang bukan waktu yang tepat atau pun lewat perantara begini. Setidaknya kau bisa mendengar {#Emph}suaraku{#Prev}, bukan? Dan aku bisa merasakan kehadiranmu, kendati samar dan begitu jauh."
      Speaker = "Demeter"
      Event = "DemeterAboutBlessings01"
    }
    {
      Id = "Demeter_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hera, Hestia, dan diriku memiliki pembawaan yang teramat bertolak belakang sehingga kami tidak terlalu akrab sebagai saudari. Meski perang melawan Chronos ini membuat kami {#Emph}sedikit {#Prev}lebih dekat, kurasa..."
      Speaker = "Demeter"
      Event = "DemeterAboutSisters01"
    }
    {
      Id = "Demeter_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudari-saudariku masing-masing menjadi begitu menyukaimu, bungaku. Kesepakatan yang amat langka di antara kami! Hestia, dia memang tidak sesulit yang lain, tapi {#Emph}Hera? {#Prev}Zeus sendiri pasti mengakui bahwa Ratu kita tidak mudah dibuat terkesan."
      Speaker = "Demeter"
      Event = "DemeterAboutSisters02"
    }
    {
      Id = "Demeter_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemahamanku selama ini adalah garis keturunanmu hampir mustahil bertahan hidup di luar jangkauan Dunia Bawah. Namun di sanalah kau berada, melangkah ke sana kemari seolah tak terikat oleh takdir ayahmu. Bagaimana ini bisa terjadi...?"
      Speaker = "Demeter"
      Event = "DemeterAboutSurface01"
    }
    {
      Id = "Demeter_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil melesat keluar dari kegelapan pekat itu menuju ke permukaan dunia kita, bukan begitu, bungaku? Jika kau berniat mengunjungi gunung kami, ikuti saja jalur kehancuran yang membentang lurus menuju tempat kami..."
      Speaker = "Demeter"
      Event = "DemeterAboutSurface02"
    }
    {
      Id = "Demeter_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pijakan tanah di bawah kaki kami mulai berguncang, dan firasatku ini pertanda buruk. Apa lagi yang direncanakan oleh si keparat Chronos itu sekarang, meruntuhkan seluruh gunung kita ke Bumi?"
      Speaker = "Demeter"
      Event = "DemeterAboutSurfaceThreat01"
    }
    {
      Id = "Demeter_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan cemaskan puncak gunung ini, jangan pula cemaskan Bumi; karena ia jauh lebih tangguh daripada kita semua. Musuh-musuh kita boleh saja melenyapkan {#Emph}setiap jejak {#Prev}eksistensi kita, namun Ibu Gaia akan tetap bertahan, dan pulih kembali."
      Speaker = "Demeter"
      Event = "DemeterAboutEarth01"
    }
    {
      Id = "Demeter_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebun yang asri harus dirawat dengan saksama. Demikian pula hendaknya dengan Dunia Bawahmu menurut pandanganku, bungaku. Jika masih tersisa pengaruh dari Chronos di sana, mari kita cabut hingga ke akar-akarnya."
      Speaker = "Demeter"
      Event = "DemeterAboutUnderworld01"
    }
    {
      Id = "Demeter_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku pernah berkunjung ke Dunia Bawah untuk waktu yang cukup lama, kau tahu. Tepat di kediaman tempat tinggal orang tuamu! Kami memang jarang membicarakannya setelah itu, tapi sekarang... kenangan itu terasa cukup menyenangkan. Barangkali kita semua bisa berkumpul lagi suatu saat nanti."
      Speaker = "Demeter"
      Event = "DemeterAboutUnderworld02"
    }
    {
      Id = "Demeter_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedang apa kau di kedalaman payau itu, bungaku? Bahkan Poseidon sekalipun memalingkan wajah dari kengerian yang bersemayam di sudut lautan itu. Apakah jalan semacam itu benar-benar mengarah semakin dalam ke neraka?"
      Speaker = "Demeter"
      Event = "DemeterAboutOceanus01"
    }
    {
      Id = "Demeter_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjalananmu membawamu melintasi Ladang Ratapan. Aku pernah melihat tempat itu... benar-benar {#Emph}mengerikan{#Prev}, sungguh! Ladang gandum di sana, itu... Tadinya kupikir mungkin pemandangan itu bisa menghadirkan sedikit penghiburan..."
      Speaker = "Demeter"
      Event = "DemeterAboutFields01"
    }
    {
      Id = "Demeter_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjalanan turunmu tempo hari membawamu melangkah lebih dalam daripada akar-akarku yang terdalam, begitu dekat dengan persemayaman Titan Chronos saat ini... yang menawan ibumu beserta yang lainnya. Apakah tiada cara untuk mengabari kami tentang apa yang sebenarnya terjadi di sana?"
      Speaker = "Demeter"
      Event = "DemeterAboutTartarus01"
    }
    {
      Id = "Demeter_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada satu pun yang hidup di kota Ephyra. Dan akan kupastikan tetap begitu sampai kawanan jahanam yang tertatih-tatih di sana berhasil ditumpas! Tapi, kau tak perlu memikirkan tetek bengeknya; kami sudah menugaskan seseorang untuk menanganinya."
      Speaker = "Demeter"
      Event = "DemeterAboutEphyra01"
    }
    {
      Id = "Demeter_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau sedang dalam perjalanan kemari menuju kami, bungaku? Perjalanan yang dulu sering ditempuh ibumu tiap musim semi... tapi di masa yang berbeda, saat tidak dikepung oleh para pengikut keji dari Titan terkutuk itu."
      Speaker = "Demeter"
      Event = "DemeterAboutEphyra02"
    }
    {
      Id = "Demeter_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pamanmu Poseidon yang menciptakan jurang berair di hadapanmu itu. Rasanya ingin kubekukan saja jurang itu, meski aku khawatir musuh-musuh kita tetap bisa menyeberanginya, dan perjalananmu malah akan semakin berat."
      Speaker = "Demeter"
      Event = "DemeterAboutThessaly01"
    }
    {
      Id = "Demeter_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Celah Thessaly itu bisa dengan mudah kubekukan jadi es, kau tahu. Ingin sekali kulihat armada musuh berlayar di atasnya {#Emph}saat itu juga! {#Prev}Tapi aku diberitahu bahwa kita harus menahan bencana alam untuk sementara waktu... para fana dan segala {#Emph}rengekan {#Prev}mereka."
      Speaker = "Demeter"
      Event = "DemeterAboutThessaly02"
    }
    {
      Id = "Demeter_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan dalam gelapnya bulan baru, saat Selene sendiri tak berani melintasi dinginnya langit malam, aku berhasil menemukanmu di sana... dan akan kuberikan seluruh kekuatan yang bisa kuluangkan untukmu."
      Speaker = "Demeter"
      Event = "DemeterAboutMoon01"
    }
    {
      Id = "Demeter_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Guyuran hujan di sana mungkin berguna untukmu; membersihkan segala kotoran, menumbuhkan tunas baru. Kau kira Zeus sendiri yang menurunkan hujan itu, atau Poseidon? Coba tebak sekali lagi..."
      Speaker = "Demeter"
      Event = "DemeterAboutRain01"
    }
    {
      Id = "Demeter_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemurahan Bumi... kehidupan tetap bersemi bahkan di tempatmu bernaung, di tengah segala kematian itu. Bunga, akar, tanaman herba, dan benih; kau memahami kekuatan tersembunyi mereka. Kubiarkan mereka tumbuh untukmu."
      Speaker = "Demeter"
      Event = "DemeterAboutResources01"
    }
    {
      Id = "Demeter_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memetik bunga Moly begitu banyak... tanaman mungil yang bersahaja, bukan? Tak jauh berbeda dari {#Emph}dirimu{#Prev}, karena mereka pun menyimpan kekuatan yang melampaui wujudnya."
      Speaker = "Demeter"
      Event = "DemeterAboutResources02"
    }
    {
      Id = "Demeter_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa banyak bibit kecil itu... masing-masing menyimpan misteri. Begitu mungil, namun berpotensi menjadi sesuatu yang elok dan berkuasa... dengan kata lain, untuk hidup. Aku tahu kau akan merawatnya dengan baik."
      Speaker = "Demeter"
      Event = "DemeterAboutMysterySeeds01"
    }
    {
      Id = "Demeter_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian besar orang bahkan takkan menyadari beragam tanaman yang telah kau temukan, tapi kau memiliki bakat istimewa. Di bawah asuhanmu, mereka melayani tujuan yang lebih agung daripada sekadar hidup; meski untuk hidup saja sudah merupakan pencapaian tersendiri."
      Speaker = "Demeter"
      Event = "DemeterAboutPlants01"
    }
    {
      Id = "Demeter_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagaimana tunas pohon yang berjuang untuk tumbuh, begitu pula kita harus memacu diri demi menemukan potensi sejati kita. Saksikanlah kekuatanku atas hidup dan mati; semoga kau menemukan kekuatanmu."
      Speaker = "Demeter"
      Event = "DemeterLegendaryPickUp01"
    }
    {
      Id = "Demeter_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musim adalah siklus pembusukan dan pembaruan yang tiada akhir... kendati ada saat-saat di mana musim-musim itu menegaskan kuasanya jauh lebih garang dari biasanya; saat-saat seperti {#Emph}sekarang ini."
      Speaker = "Demeter"
      Event = "DemeterLegendaryPickUp02"
    }
    {
      Id = "Demeter_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sentuhan cahaya bulan di sekelilingmu, bungaku, seakan Selene yang menerangi jalanmu. Andaikan sang Rembulan lebih peduli pada hal lain selain lintasannya melintasi langit..."
      Speaker = "Demeter"
      Event = "DemeterAboutSelene01"
    }
    {
      Id = "Demeter_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan tanda Chaos ada padamu... jadi, kekuatan purba yang sedemikian dingin dan tak peduli itu pun menaruh perhatian pada prahara yang sedang kita hadapi ini? Barangkali hanya sekadar penasaran."
      Speaker = "Demeter"
      Event = "DemeterAboutChaos01"
    }
    {
      Id = "Demeter_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepupumu yang rupawan, Apollo, mengendalikan cahaya yang begitu dipuja para fana, sebab itu memberi mereka kehangatan dan mencairkan saljuku. Atas izinku, tentu saja! Kekuatannya hanya akan membantumu seperlunya."
      Speaker = "Demeter"
      Event = "DemeterAboutApollo01"
    }
    {
      Id = "Demeter_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zeus yang agung dan cerdik itu membantumu secara langsung, sekarang? Kalau begitu, kau pasti salah satu harapan terbaik kita yang tersisa untuk menggagalkan rencana sang Titan... sebab Zeus pantang memohon bantuan, ataupun menawarkannya."
      Speaker = "Demeter"
      Event = "DemeterAboutZeus01"
    }
    {
      Id = "Demeter_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, kau membawa berkah Poseidon! Tentu dewa yang begitu lantang dan gembar-gembor itu punya kekuatan yang lebih dari cukup untuk membuktikannya, bukan?"
      Speaker = "Demeter"
      Event = "DemeterAboutPoseidon01"
    }
    {
      Id = "Demeter_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Poseidon kembali turun tangan membantumu! Baguslah, dan semoga dia terbukti berguna. Kalau begitu, akan kutahan dulu ancamanku untuk membekukan samuderanya, untuk saat ini."
      Speaker = "Demeter"
      Event = "DemeterAboutPoseidon02"
    }
    {
      Id = "Demeter_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau bahkan berhasil membuat dewa tempaan yang sukar ditemui itu merangkak keluar dari guanya. Sungguh tak disangka, pertikaian mengerikan dengan leluhur kita inilah yang akhirnya mempererat keluarga kita."
      Speaker = "Demeter"
      Event = "DemeterAboutHephaestus01"
    }
    {
      Id = "Demeter_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rupanya kau berhasil meraih restu saudariku, Hera! Dan kau bahkan tak perlu berkomitmen pada pasangan atau melahirkan anak, kurasa. Hatinya pasti mulai melunak!"
      Speaker = "Demeter"
      Event = "DemeterAboutHera01"
    }
    {
      Id = "Demeter_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Hestia memberimu anugerah kobaran apinya? Biasanya si tua pelit itu tak mau berurusan dengan siapa pun di antara kita, bahkan dengan saudari-saudarinya sendiri. Tapi masa-masa luar biasa memang menuntut tindakan yang luar biasa."
      Speaker = "Demeter"
      Event = "DemeterAboutHestia01"
    }
    {
      Id = "Demeter_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biasanya, kuasa Aphrodite yang molek atas keindahan selalu memberikan hiburan tanpa henti, tentu saja. Namun aku tak paham bagaimana berkahnya bisa banyak berguna dalam situasi genting seperti yang kita hadapi."
      Speaker = "Demeter"
      Event = "DemeterAboutAphrodite01"
    }
    {
      Id = "Demeter_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga Ares yang haus perang itu takkan tahan untuk tidak menaruh perhatian pribadinya pada konflik kita ini. Meski kurasa dia takkan membantu mengakhirinya, karena dia sangat menikmati kekacauan ini."
      Speaker = "Demeter"
      Event = "DemeterAboutAres01"
    }
    {
      Id = "Demeter_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Langkahmu cepat sekali, bungaku! Kupikir kau baru saja diberkahi oleh Hermes yang gesit itu, hanya saja dia pasti terlalu sibuk mengawasi musuh-musuh kita sampai tak sempat membantumu."
      Speaker = "Demeter"
      Event = "DemeterAboutHermes01"
    }
    {
      Id = "Demeter_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin aku salah menilai sepupumu yang suka menjelajah hutan itu, Artemis. Tak kusangka dia berhasil menemukanmu! Tadinya kuyakin dia cuma sibuk bersenang-senang dengan para sahabat Nimfa-nya alih-alih berbuat sesuatu yang berguna."
      Speaker = "Demeter"
      Event = "DemeterAboutArtemis01"
    }
    {
      Id = "Demeter_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terakhir kuperiksa, pemabuk Dionysus itu menolak mengangkat senjata melawan keluarganya sendiri, seolah-olah {#Emph}Chronos {#Prev}pantas dianggap keluarga. Seharusnya kubuat busuk saja semua tanamannya..."
      Speaker = "Demeter"
      Event = "DemeterAboutDionysus01"
    }
    {
      Id = "Demeter_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kebijaksanaan Athena yang tersohor itu sesuai dengan reputasinya, bungaku? Kupikir ahli strategi ulung kita itu tak perlu sampai turun tangan mempertahankan garis depan sendirian. Tapi yah, tahu apa aku ini?"
      Speaker = "Demeter"
      Event = "DemeterAboutAthena01"
    }
    {
      Id = "Demeter_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu itu pemurung dan menyusahkan bahkan sejak ia masih muda, sejujurnya. Apa yang dilihat putriku dalam dirinya, aku pun tak habis pikir. Namun Kore-ku, begitulah kupanggil dia... selalu tampak lebih ceria saat berada di dekatnya..."
      Speaker = "Demeter"
      Event = "DemeterAboutHades01"
    }
    {
      Id = "Demeter_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar sampai ke telinga kami bahwa kau telah menemukan Hades, bungaku! Betapa murkanya dia, terbelenggu di dalam ceruk keputusasaan itu, meski setidaknya dia masih utuh. Bagaimana dengan ibumu, masih belum ada kabar...?"
      Speaker = "Demeter"
      Event = "DemeterAboutHades02"
    }
    {
      Id = "Demeter_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu dia takkan sudi mengakuinya... tapi ayahmu telah melewati cobaan yang luar biasa berat. Bahkan mungkin lebih buruk dari kita semua. Namun dia dan ibumu pernah melewati masa-masa sulit sebelumnya, dan setiap kali mereka selalu tumbuh semakin kuat."
      Speaker = "Demeter"
      Event = "DemeterAboutHades03"
    }
    {
      Id = "Demeter_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mewarisi rambut pirang keemasan ibumu, dan agaknya juga keteguhan tekadnya. Tetumbuhan hijau akan mekar merekah demi dia... orang mati pun akan bangkit jika mereka sanggup. Di sudut hatiku yang belum membeku, aku tahu dia masih selamat."
      Speaker = "Demeter"
      Event = "DemeterAboutPersephone01"
    }
    {
      Id = "Demeter_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibumu dulu biasa mengunjungi kami selama berbulan-bulan, namun kini... mengetahui bahwa dia baik-baik saja dan kembali bertahta di Dunia Bawah, aku tak bisa meminta lebih dari itu. Setidaknya untuk saat ini."
      Speaker = "Demeter"
      Event = "DemeterAboutPersephone02"
    }
    {
      Id = "Demeter_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang para penenun takdir pun rupanya telah sirna, dan tak berbuat apa-apa untuk menjaga andil mereka di masa depan kita? Begitulah desas-desus di atas gunung ini, Cucuku. Jadi kita benar-benar sendirian... tapi kita sanggup bertahan sendiri."
      Speaker = "Demeter"
      Event = "DemeterAboutFates01"
    }
    {
      Id = "Demeter_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos berdalih bahkan dia sendiri tak tahu di mana Tiga Takdir berada saat ini, padahal dialah yang membuang mereka? Jarang sekali kudengar kebodohan semacam itu. Tak kusangka orang sebodoh itu bisa hampir menggulingkan kita!"
      Speaker = "Demeter"
      Event = "DemeterAboutFates02"
    }
    {
      Id = "Demeter_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakekmu yang satu adalah sang Titan kejam, Chronos... dan yang satunya lagi hanyalah seorang anak petani fana pemujaku. Entah aku mencintainya atau mengasihaninya, aku pun tak bisa memastikannya. Setidaknya ibumu terlahir abadi..."
      Speaker = "Demeter"
      Event = "DemeterAboutFarmBoy01"
    }
    {
      Id = "Demeter_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cucuku, ke mana saja kau selama ini? Ke ceruk terdalam alam ayahmu, barangkali! Menghantam tepat di jantung musuh kita. Setidaknya, itulah yang kuharapkan."
      Speaker = "Demeter"
      Event = "DemeterUnderworldRunCleared01"
    }
    {
      Id = "Demeter_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kusampaikan terima kasih, bungaku, karena kau telah memporak-porandakan musuh kita di gunung ini. Bahkan kini mereka mencoba menyusun barisan kembali, tapi dengan kegigihanmu, kita pasti bisa memukul mereka mundur."
      Speaker = "Demeter"
      Event = "DemeterSurfaceRunCleared01"
    }
    {
      Id = "Demeter_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu yang meresahkan malam ini... seolah ada kehendak dahsyat yang menganga bangkit dari palung terdalam Chaos. Tapi {#Emph}kau {#Prev}tentu tak tahu apa-apa soal ini, bukan?"
      Speaker = "Demeter"
      Event = "DemeterAboutPackageBounty01"
    }
    {
      Id = "Demeter_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh aneh kau sudah melangkah sejauh ini dalam perjalanan malammu, bungaku, namun... entah bagaimana firasatku berkata akan menemukanmu di sini. Mungkin karena ikatan batin yang kita bagi, atau ada kekuatan lain yang sedang bermain."
      Speaker = "Demeter"
      Event = "DemeterAboutPackageBountyLateStart01"
    }
    {
      Id = "Demeter_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang sungguh mencekam! Udaranya begitu pekat dengan kematian dan pembusukan dari alam ayahmu, serta kehampaan yang kutumpahkan ke bumi. Bahkan rembulan pucat pun nyaris tak sanggup menembusnya..."
      Speaker = "Demeter"
      Event = "DemeterAboutShrine01"
    }
    {
      Id = "Demeter_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang tak beres malam ini... firasat buruk menggantung pekat di udara. Aku enggan berspekulasi tentang apa yang membuat musuh-musuh kita mendadak kalap murka. Tapi aku takkan heran bila pemicunya berasal dari alam {#Emph}milikmu{#Prev}, bukan dari sini."
      Speaker = "Demeter"
      Event = "DemeterAboutShrine02"
    }
    {
      Id = "Demeter_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lihat serpihan-serpihan mungil yang melayang turun dari kahyangan ke bumi itu? Kusebut itu salju; indah dipandang namun menusuk dingin. Seharusnya kita para dewa bersikap seperti salju itu."
      Speaker = "Demeter"
      Event = "DemeterAboutSnow01"
    }
    {
      Id = "Demeter_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku penasaran apakah buah delima yang menjijikkan itu masih tumbuh subur di Dunia Bawahmu. Buah itu menyimpan kekuatan di sana yang tak bisa kutoleransi; sesesap bijinya yang serupa darah itu saja bisa luar biasa berbahaya."
      Speaker = "Demeter"
      Event = "DemeterAboutPom01"
    }
    {
      Id = "Demeter_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keterikatan kita tak ubahnya seperti Seikat Jelai yang kau bawa itu. Tiap tangkainya memang rapuh dan mudah patah, namun saat disatukan, ia menjadi begitu kokoh! Masing-masing berbeda, namun sejatinya begitu serupa."
      Speaker = "Demeter"
      Event = "DemeterAboutKeepsake01"
    }
    {
      Id = "Demeter_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihatlah bagaimana Seikat Jelai yang kuberikan padamu telah tumbuh subur! Menjadi kian tegar berkat perhatian dan kasih sayangmu. Ikatan kita berdua pun serupa... sebuah kebenaran sederhana yang terlalu sering dilupakan."
      Speaker = "Demeter"
      Event = "DemeterAboutKeepsake02"
    }
    {
      Id = "Demeter_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada kilau terpancar di sana... Delima Permata, dari ibumu? Dulu ia membawakanku buah serupa sebagai tanda mata kala melawat ke mari dari Dunia Bawah. Jagalah baik-baik, bungaku; dan semoga beliau pun selalu menyertai kita."
      Speaker = "Demeter"
      Event = "DemeterAboutHadesAndPersephoneKeepsake01"
    }
    {
      Id = "Demeter_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang telah kau {#Emph}perbuat? {#Prev}Titan Chronos itu seharusnya dibinasakan, bukan ditampung! Kebusukan telah merasuk ke dasar jiwanya dan takkan bisa disucikan! Tapi... putriku, ia mengirim kabar bahwa ia baik-baik saja, dan... {#Emph}aduh{#Prev}, bagaimana harus {#Emph}kusikapi {#Prev}semua ini..."
      Speaker = "Demeter"
      Event = "DemeterPostTrueEnding01"
    }
    {
      Id = "Demeter_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, Cucuku... entah apa jadinya diriku tanpamu. Bahwa gunung ini masih berdiri tegak adalah satu hal, tapi kemudian... kau berhasil mempertemukan kembali kami berdua. Kebaikanmu takkan sanggup kubalas... hanya curahan kasih sayang yang kumiliki yang bisa kuberikan padamu."
      Speaker = "Demeter"
      Event = "DemeterPostTrueEnding02"
    }
    {
      Id = "Demeter_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan sudi memaafkan Chronos, apalagi menatap rupa wajahnya yang hina dina itu lagi. Namun bila mantra apa pun yang kau rapalkan padanya telah sungguh-sungguh melayukan ambisinya, biarlah begitu. Barangkali memang tiada jalan lain..."
      Speaker = "Demeter"
      Event = "DemeterPostTrueEnding03"
    }
    {
      Id = "Demeter_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para pemintal takdir itu bermunculan kembali dari dalam bumi! Tepat sekali munculnya setelah kita menumpas pemberontakan sang Titan tanpa {#Emph}mereka {#Prev}harus turun tangan. Dari dulu kita memang tak pernah {#Emph}bisa {#Prev}mengandalkan Fates..."
      Speaker = "Demeter"
      Event = "DemeterPostEpilogue01"
    }
    {
      Id = "Demeter_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dahulu kala sewaktu aku bersama saudariku serta ayahmu dan saudara-saudaranya pertama kali membantai Chronos, itu kemenangan yang berdarah dan keji, namun mengantarkan era baru tempat Olympus berdaulat. Kini tampaknya zaman baru menjelang... dan aku belum pernah menyaksikan zaman yang benar-benar sempurna."
      Speaker = "Demeter"
      Event = "DemeterPostEpilogue02"
    }
    {
      Id = "Demeter_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui bahwa kaum fana terlampau menderita dalam kemelut ini... begitu banyak jerit doa memohon ampunan yang terabaikan. Tapi apa lagi yang bisa kita perbuat? Bahkan Fates sekalipun tak bisa campur tangan... atau barangkali tak berani."
      Speaker = "Demeter"
      Event = "DemeterPostEpilogue03"
    }
    {
      Id = "Demeter_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak banyak alasan untuk bergembira di Olympus belakangan ini, terutama bagiku. Tapi melihat {#Emph}dirimu{#Prev}, bungaku? Itu membayar lunas segala kepedihan. Aku tahu mungkin butuh waktu sebelum kita bersua lagi, tapi aku tahu pasti kita {#Emph}akan {#Prev}bertemu kembali."
      Speaker = "Demeter"
      Event = "DemeterAboutPalace01"
    }
    {
      Id = "Demeter_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hera dan Zeus terlampau memikirkan siasat gila yang mungkin bisa menghentikan Typhon, tapi dipastikan akan meruntuhkan gunung kita dalam prosesnya. Kegilaan yang lahir dari keputusasaan! Kita tak boleh mengambil risiko segegabah itu."
      Speaker = "Demeter"
      Event = "DemeterAboutLastResort01"
    }
    {
      Id = "Demeter_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semacam tengkorak yang kau bawa itu... salah satu Senjata Malam, kutahu itu, namun... {#Emph}bentuknya... {#Prev}ada sesuatu darinya yang... mengingatkanku bukan pada Nyx, melainkan... pada {#Emph}putriku? Ah{#Prev}, sudahlah, jangan hiraukan racauan orang tua ini. Lanjutkan perjalananmu."
      Speaker = "Demeter"
      Event = "DemeterAboutPersephoneAspect01"
    }
    {
      Id = "Demeter_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pusaka yang kau genggam itu... dingin yang memancar darinya begitu menusuk hingga auranya teraba olehku dari kejauhan sini. Dari mana pun asal mula embun beku maut itu, yang pasti bukan berasal dari alam ini..."
      Speaker = "Demeter"
      Event = "DemeterAboutHelAspect01"
    }
    {
      Id = "Demeter_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang aku cemas diriku telah menjelma jadi sosok yang dingin dan getir, tapi urusan ini terasa begitu meremajakan jiwaku... tepatnya semenjak aku mengenalmu. Barangkali aku sudah terlalu lama tertidur pulas."
      Speaker = "Demeter"
      Event = "DemeterPostGift01"
    }
    {
      Id = "Demeter_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh memuakkan membayangkan Chronos secara silsilah adalah kakekmu, sebagaimana aku adalah nenekmu. Kita tak punya pertalian batin sedikit pun, namun pohon silsilah keluarga kita ini telah tumbuh selama berabad-abad hingga dahannya kini terpilin bengkok..."
      Speaker = "Demeter"
      Event = "DemeterAboutFamilyTree01"
    }
    {
      Id = "Demeter_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini aku kerap kehabisan kata-kata, bungaku. Seusai segala kemelut melelahkan ini... tutur bahasaku mungkin akan sedikit layu dan kaku untuk sementara. Namun restu abadiku akan selalu menyertaimu selama kau membutuhkannya."
      Speaker = "Demeter"
      Event = "DemeterAboutSayingLittle01"
    }
    {
      Id = "Demeter_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dendam yang dingin berakar kuat di lubuk hati kita; biarkan ia bersemi untuk sementara waktu."
      Speaker = "Demeter"
      Event = "DemeterChat01"
    }
    {
      Id = "Demeter_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pernah menjagal Titan sekali dua kali di masa lalu; sekarang giliranmu yang mendapat kehormatan itu, tampaknya."
      Speaker = "Demeter"
      Event = "DemeterChat02"
    }
    {
      Id = "Demeter_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan beristirahat sebelum ibumu, sang Ratu, dipulihkan ke singgasana hak miliknya."
      Speaker = "Demeter"
      Event = "DemeterChat03"
    }
    {
      Id = "Demeter_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biarlah Chronos menggigil ketakutan, sadar sepenuhnya bahwa kejahatannya takkan luput dari ganjaran."
      Speaker = "Demeter"
      Event = "DemeterChat04"
    }
    {
      Id = "Demeter_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terimalah berkatku, Cucuku. Kau bagaikan hembusan semilir angin musim dingin yang menyegarkan."
      Speaker = "Demeter"
      Event = "DemeterChat05"
    }
    {
      Id = "Demeter_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mewarisi ketegaran ibumu. Rengkuhlah kekuatanku pula."
      Speaker = "Demeter"
      Event = "DemeterChat06"
    }
    {
      Id = "Demeter_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Barangkali kau bisa merasakan hawa dingin yang menusuk bahkan dari tempatmu berdiri."
      Speaker = "Demeter"
      Event = "DemeterChat07"
    }
    {
      Id = "Demeter_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita memang tengah berada di tengah musim yang kelam, cucuku tersayang..."
      Speaker = "Demeter"
      Event = "DemeterChat08"
    }
    {
      Id = "Demeter_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebinasaan mutlak bagi siapa pun yang berpihak pada para Titan untuk melawan kita."
      Speaker = "Demeter"
      Event = "DemeterChat09"
    }
    {
      Id = "Demeter_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang bisa kulakukan demi mendukung perjuanganmu, pasti kulakukan, bungaku."
      Speaker = "Demeter"
      Event = "DemeterChat10"
    }
    {
      Id = "Demeter_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa kau rasakan gigilan dingin di udara, Cucuku? Hawa dingin itu akan kian dahsyat demi membantumu."
      Speaker = "Demeter"
      Event = "DemeterChat11"
    }
    {
      Id = "Demeter_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak sekali pengkhianat yang berani menentang kita sekarang, namun sebentar lagi mereka semua akan binasa dan membusuk."
      Speaker = "Demeter"
      Event = "DemeterChat12"
    }
    {
      Id = "Demeter_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melalui pergantian musim kubawa kehidupan sekaligus kematian; manakah yang kau kehendaki kali ini?"
      Speaker = "Demeter"
      Event = "DemeterChat13"
    }
    {
      Id = "Demeter_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan ikor yang mengalir di pembuluh darah Titan sekalipun bisa dibuat membeku sedingin es."
      Speaker = "Demeter"
      Event = "DemeterChat14"
    }
    {
      Id = "Demeter_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hari-hari kian menggelap, meski barangkali titik terang akan segera menyingsing..."
      Speaker = "Demeter"
      Event = "DemeterChat15"
    }
    {
      Id = "Demeter_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagi fana, hidup begitu berharga karena amat singkat. Kita para dewi bisa memadamkannya semudah membalikkan telapak tangan..."
      Speaker = "Demeter"
      Event = "DemeterChat16"
    }
    {
      Id = "Demeter_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tumbuh kian perkasa, Bunga Kecilku, dan itu menghangatkan hatiku yang beku."
      Speaker = "Demeter"
      Event = "DemeterChat17"
    }
    {
      Id = "Demeter_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan biarkan siapa pun menghalangi ambisimu, Cucuku."
      Speaker = "Demeter"
      Event = "DemeterChat18"
    }
    {
      Id = "Demeter_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kematian dan kebusukan bagi musuh-musuh Olympus."
      Speaker = "Demeter"
      Event = "DemeterChat19"
    }
    {
      Id = "Demeter_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka yang lancang menentang Olympus akan langsung dibumihanguskan."
      Speaker = "Demeter"
      Event = "DemeterChat20"
    }
    {
      Id = "Demeter_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keangkuhan dan amarah mengalir kental dalam darah keluarga kita, Cucuku."
      Speaker = "Demeter"
      Event = "DemeterChat21"
    }
    {
      Id = "Demeter_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak peduli Chronos itu sedarah dengan kita; tiada ikatan yang tak bisa putus."
      Speaker = "Demeter"
      Event = "DemeterChat22"
    }
    {
      Id = "Demeter_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga kau mengenyam masa-masa damai seiring bertambahnya usiamu, tapi untuk saat ini..."
      Speaker = "Demeter"
      Event = "DemeterChat23"
    }
    {
      Id = "Demeter_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadilah sosok yang paripurna dan pantang menyerah bak dinginnya musim salju, Melinoë."
      Speaker = "Demeter"
      Event = "DemeterChat24"
    }
    {
      Id = "Demeter_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, roda kematian dan kelahiran kembali yang abadi! Bukankah itu sangat elok, dari sudut pandang tertentu?"
      Speaker = "Demeter"
      Event = "DemeterChat25"
    }
    {
      Id = "Demeter_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap permukaan menawarkan cuaca yang lebih bersahabat, Bunga Kecilku, tapi sayang; belum saatnya."
      Speaker = "Demeter"
      Event = "DemeterChat26"
    }
    {
      Id = "Demeter_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita pastikan bersama bahwa Chronos menuai apa yang telah ia tabur."
      Speaker = "Demeter"
      Event = "DemeterChat27"
    }
    {
      Id = "Demeter_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tumbuhlah dengan perkasa dan mekarlah sebagaimana yang kuyakini, Melinoë."
      Speaker = "Demeter"
      Event = "DemeterChat28"
    }
    {
      Id = "Demeter_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa saat ini musuh-musuh kita sudah cukup matang untuk dipanen."
      Speaker = "Demeter"
      Event = "DemeterChat29"
    }
    {
      Id = "Demeter_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat apa yang kupetik khusus untukmu malam ini, Bunga Kecilku."
      Speaker = "Demeter"
      Event = "DemeterChat30"
    }
    {
      Id = "Demeter_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini cuaca buruk akan melanda, sebaiknya musuh-musuh kita bersiap membungkus diri rapat-rapat."
      Speaker = "Demeter"
      Event = "DemeterChat31"
    }
    {
      Id = "Demeter_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena kau cucuku, silakan nikmati segala limpahan berkah ini."
      Speaker = "Demeter"
      Event = "DemeterChat32"
    }
    {
      Id = "Demeter_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bumi akan mereguk dalam-dalam darah musuh kita; setidaknya bagi mereka yang {#Emph}bisa {#Prev}berdarah."
      Speaker = "Demeter"
      Event = "DemeterChat33"
    }
    {
      Id = "Demeter_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hawa dingin tak lazim masih menyelimuti dataran atas, Bunga Kecilku. Namun kau tampak tak keberatan."
      Speaker = "Demeter"
      Event = "DemeterChat34"
    }
    {
      Id = "Demeter_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan ragu melenyapkan sisa kehangatan yang tersisa di Bumi, jika memang itu yang diperlukan."
      Speaker = "Demeter"
      Event = "DemeterChat35"
    }
    {
      Id = "Demeter_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiada yang lebih paham dariku mengenai betapa kejamnya pergantian musim itu."
      Speaker = "Demeter"
      Event = "DemeterChat36"
    }
    {
      Id = "Demeter_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan kukuras habis sisa kehidupan dari musuh-musuh kita yang masih memilikinya."
      Speaker = "Demeter"
      Event = "DemeterChat37"
    }
    {
      Id = "Demeter_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan di tengah kehancuran sedahsyat yang telah kita saksikan, kehidupan tetap bisa bertahan, dan bertunas kembali."
      Speaker = "Demeter"
      Event = "DemeterChat38"
    }
    {
      Id = "Demeter_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari abu peperangan ini, semoga kita bisa bersemi kembali seiring berjalannya waktu."
      Speaker = "Demeter"
      Event = "DemeterChat39"
    }
    {
      Id = "Demeter_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu mengancam merenggut segalanya dari kita, tapi kita tetap bertahan, dan akan selalu begitu."
      Speaker = "Demeter"
      Event = "DemeterChat40"
    }
    {
      Id = "Demeter_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dunia ini sudah muak dengan perang tanpa akhir antara para Titan dan dewa-dewi..."
      Speaker = "Demeter"
      Event = "DemeterChat41"
    }
    {
      Id = "Demeter_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga perjuanganmu di bawah perut Bumi selalu membuahkan hasil yang ranum."
      Speaker = "Demeter"
      Event = "DemeterChat42"
    }
    {
      Id = "Demeter_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Alam tempatmu bernaung, yang begitu hampa tanpa secuil pun kehidupan... tak jauh berbeda dari musim dingin di sini..."
      Speaker = "Demeter"
      Event = "DemeterChat43"
    }
    {
      Id = "Demeter_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini akan terasa dingin dan pekat... namun kau pernah menerjang yang lebih buruk."
      Speaker = "Demeter"
      Event = "DemeterChat44"
    }
    {
      Id = "Demeter_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musim boleh saja memburuk, namun di baliknya selalu tersimpan harapan pasti."
      Speaker = "Demeter"
      Event = "DemeterChat45"
    }
    {
      Id = "Demeter_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selama kau percaya Chronos akan terus menjalankan perannya, aku akan menoleransinya; tidak lebih."
      Speaker = "Demeter"
      Event = "DemeterChat46"
    }
    {
      Id = "Demeter_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kematian dan pembusukan di mana-mana... dunia atas dan Dunia Bawah kini sudah tak ada bedanya."
      Speaker = "Demeter"
      Event = "DemeterChat47"
    }
    {
      Id = "Demeter_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih banyak hal di dunia ini yang belum kau lihat, Cucuku; dan sebagian di antaranya sungguh indah."
      Speaker = "Demeter"
      Event = "DemeterChat48"
    }
    {
      Id = "Demeter_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hakikat kehidupan adalah perjuangan untuk bertahan hidup. Bahkan kami para dewa pun tidak kebal dari hal itu."
      Speaker = "Demeter"
      Event = "DemeterChat49"
    }
    {
      Id = "Demeter_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehangatan musim semi pada akhirnya akan kembali lagi, walau mungkin tidak dalam waktu dekat."
      Speaker = "Demeter"
      Event = "DemeterChat50"
    }
    {
      Id = "Demeter_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak terlalu menyukai kejutan, kuncup bungaku. Dan mungkin dalam hal itu kita serupa. Namun ada kejutan langka yang cukup menyenangkan... bagai hembusan angin sejuk di malam musim gugur."
      Speaker = "Demeter"
      Event = "DemeterBlindBox01"
    }
    {
      Id = "Demeter_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh memalukan, bahkan Berkah kami pun harus disamarkan... agar kami tidak berisiko membocorkan terlalu banyak rencana dan pertahanan kami kepada musuh."
      Speaker = "Demeter"
      Event = "DemeterBlindBox02"
    }
    {
      Id = "Demeter_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh hina kita sekarang harus menggunakan tipu muslihat rendahan, membuat surat-menyurat kita diselundupkan ke sana kemari oleh mantan Pendayung Orang Mati."
      Speaker = "Demeter"
      Event = "DemeterLootBought01"
    }
    {
      Id = "Demeter_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Koin sang Titan yang kau tukarkan demi pesan ini... kami akan mengumpulkan semuanya, meleburnya, dan mengembalikan Emas itu ke tempat asalnya."
      Speaker = "Demeter"
      Event = "DemeterLootBought02"
    }
    {
      Id = "Demeter_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya saja kau bisa melihat ladangku di bawah mentari pagi... bersinar jauh lebih terang daripada Emas mana pun yang pernah kau temukan. Logam seperti itu seharusnya tetap terkubur di dalam Bumi."
      Speaker = "Demeter"
      Event = "DemeterLootBought03"
    }
    {
      Id = "Demeter_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus merendahkan diri memilih sesembahan yang begitu menyedihkan! Seharusnya kau tinggal di sini menikmati kemegahan Olympus, di mana segala yang kau inginkan ada di depan mata... hampir segalanya."
      Speaker = "Demeter"
      Event = "DemeterLootBought04"
    }
    {
      Id = "Demeter_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berani mencampakkan {#Emph}nenekmu {#Prev}sendiri? Mungkin di tempat kau dibesarkan, tata krama yang pantas bukanlah sebuah prioritas."
      Speaker = "Demeter"
      Event = "DemeterRejection01"
    }
    {
      Id = "Demeter_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan di saat-saat genting seperti ini, kami para dewa dan dewi tetap memiliki harga diri; lain kali berpikirlah lebih bijak sebelum melukai harga diriku seperti ini."
      Speaker = "Demeter"
      Event = "DemeterRejection02"
    }
    {
      Id = "Demeter_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ini keturunan langsung dariku, dan kau {#Emph}tetap saja {#Prev}mencampakkanku seperti ini?"
      Speaker = "Demeter"
      Event = "DemeterRejection03"
    }
    {
      Id = "Demeter_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemurkaan yang kurasakan begitu besar, Melinoë, sampai-sampai ada banyak yang tersisa, bahkan untuk {#Emph}dirimu."
      Speaker = "Demeter"
      Event = "DemeterRejection04"
    }
    {
      Id = "Demeter_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya kau tumbuh besar di dalam Griya ayahmu, kau pasti sudah diajari arti {#Emph}rasa hormat."
      Speaker = "Demeter"
      Event = "DemeterRejection05"
    }
    {
      Id = "Demeter_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pahamilah bahwa belakangan ini, aku sedang tidak punya kesabaran untuk tingkah konyol semacam itu, Cucuku."
      Speaker = "Demeter"
      Event = "DemeterRejection06"
    }
    {
      Id = "Demeter_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan memilih untuk menentangku bahkan dalam lelucon sekalipun, Cucuku; Apollo boleh saja menganggap remeh, tapi bukan aku."
      Speaker = "Demeter"
      Event = "DemeterRejection07"
    }
    {
      Id = "Demeter_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memangnya kenapa kalau Hestia {#Emph}secara teknis {#Prev}lebih tua dariku? Dia bahkan nyaris tidak memedulikan Olympus sama sekali!"
      Speaker = "Demeter"
      Event = "DemeterRejection08"
    }
    {
      Id = "Demeter_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berani menyia-nyiakan berkah dariku, padahal kau tahu seluruh dunia mendambakannya?"
      Speaker = "Demeter"
      Event = "DemeterRejection09"
    }
    {
      Id = "Demeter_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak bangga dengan apa yang akan kulakukan, Melinoë. Tapi bagaimana lagi caramu untuk belajar?"
      Speaker = "Demeter"
      Event = "DemeterRejection10"
    }
    {
      Id = "Demeter_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika ini adalah upayamu untuk melucu, ketahuilah bahwa leluconmu sama sekali tidak mempan padaku."
      Speaker = "Demeter"
      Event = "DemeterRejection11"
    }
    {
      Id = "Demeter_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau bertanya-tanya apakah hawa dingin menusuk yang kau rasakan di udara ini berasal dariku, {#Emph}memang benar."
      Speaker = "Demeter"
      Event = "DemeterRejection12"
    }
    {
      Id = "Demeter_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah tidak marah lagi padamu, Cucuku; hanya sedikit kecewa saja saat ini..."
      Speaker = "Demeter"
      Event = "DemeterMakeUp01"
    }
    {
      Id = "Demeter_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku tidak bisa terus-terusan kesal padamu, kuncup bungaku. Aku lebih suka kau memandangku dengan kasih sayang daripada dengan cibiran."
      Speaker = "Demeter"
      Event = "DemeterMakeUp02"
    }
    {
      Id = "Demeter_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Mendesah> {#Prev}Suasana hatiku seburuk cuaca belakangan ini... maafkan atas luapan amarah tadi, kuncup bungaku."
      Speaker = "Demeter"
      Event = "DemeterMakeUp03"
    }
    {
      Id = "Demeter_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil melewati badai itu, walau sebenarnya kau bisa menghindarinya sama sekali, tentu saja..."
      Speaker = "Demeter"
      Event = "DemeterMakeUp04"
    }
    {
      Id = "Demeter_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak perlu ada ketegangan di antara kita, Cucuku. Maafkan aku. Tadi aku terlalu gegabah."
      Speaker = "Demeter"
      Event = "DemeterMakeUp05"
    }
    {
      Id = "Demeter_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga ini, dan {#Emph}harga diri {#Prev}terkutuk kita! Pertengkaran tiada henti dengan sanak keluarga sendiri! {#Emph}Cih."
      Speaker = "Demeter"
      Event = "DemeterMakeUp06"
    }
    {
      Id = "Demeter_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibumu dulu sering membuatku murka dengan cara persis seperti ini, dan lihat ke mana {#Emph}hal itu {#Prev}membawanya."
      Speaker = "Demeter"
      Event = "DemeterMakeUp07"
    }
    {
      Id = "Demeter_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita lupakan saja. Provokasimu seharusnya tidak perlu memicu amarahku sampai sebesar itu."
      Speaker = "Demeter"
      Event = "DemeterMakeUp08"
    }
    {
      Id = "Demeter_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perselisihan kecil tidak akan melukai siapa pun. Kita {#Emph}seharusnya {#Prev}berfokus pada pertempuran yang {#Emph}sesungguhnya."
      Speaker = "Demeter"
      Event = "DemeterMakeUp09"
    }
    {
      Id = "Demeter_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak marah padamu, Cucuku; dan kuakui tindakanku tadi agak keterlaluan."
      Speaker = "Demeter"
      Event = "DemeterMakeUp10"
    }
    {
      Id = "Demeter_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, Melinoë, kita tidak boleh bertengkar! Bukan saling melawan, melainkan bertarung berdampingan."
      Speaker = "Demeter"
      Event = "DemeterMakeUp11"
    }
    {
      Id = "Demeter_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, seharusnya aku {#Emph}mengubur {#Prev}dorongan emosi yang membuatku bertindak berdasarkan amarah, bukan akal sehat."
      Speaker = "Demeter"
      Event = "DemeterMakeUp12"
    }
    {
      Id = "Melinoe_0961"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak disangka sang dewi musim sendiri adalah nenekku. Merupakan suatu kehormatan bisa mengenalmu!"
      Speaker = "Melinoe"
      Event = "DemeterGift01"
    }
    {
      Id = "Demeter_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat Penyihir Persimpangan Jalan tidak hanya mengajarimu kekuatan, tetapi juga keanggunan! Dengan ini kuterima persembahanmu, dan aku punya sesuatu untukmu juga."
      Speaker = "Demeter"
      Event = "DemeterGift01"
    }
    {
      Id = "Melinoe_0962"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bunda Demeter! Aku sangat bersyukur atas kekuatanmu. Ini mungkin tak seberapa sebagai balasan, tapi terimalah."
      Speaker = "Melinoe"
      Event = "DemeterGift02"
    }
    {
      Id = "Demeter_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya kaum muda masa kini masih ada yang tahu cara menghormati generasiku. Aku senang cucuku sendiri menjadi salah satu teladannya."
      Speaker = "Demeter"
      Event = "DemeterGift02"
    }
    {
      Id = "MelinoeField_1769"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagi dewi yang kekuatannya sungguh menjadi urat nadi dunia kita! Berkat kemurahan hatimulah persembahan Nektar seperti ini bisa ada."
      Speaker = "Melinoe"
      Event = "DemeterGift03"
    }
    {
      Id = "Demeter_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, Bunga Kecilku, bukankah ada hal lain yang jauh lebih membebani pundakmu saat ini, daripada repot-repot menghormati orang tua dengan cara adat begini? Meski begitu, aku sungguh berterima kasih atas ini."
      Speaker = "Demeter"
      Event = "DemeterGift03"
    }
    {
      Id = "MelinoeField_1770"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nenek, ada banyak waktu yang terlewatkan dan harus kita tebus untuk saling mengenal. Aku yakin kita akan bisa melakukannya segera, tapi untuk saat ini, terimalah ini."
      Speaker = "Melinoe"
      Event = "DemeterGift04"
    }
    {
      Id = "Demeter_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aneh rasanya... sebesar apa pun rasa sayangku pada ibumu, dia tak pernah menghormatiku seperti ini. Mungkin dulu aku terlalu memanjakannya, atau mungkin generasimu memang jauh lebih peduli pada para pendahulu."
      Speaker = "Demeter"
      Event = "DemeterGift04"
    }
    {
      Id = "MelinoeField_3726"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa membayangkan semua yang Nenek lakukan untuk dunia ini. Seluruh makhluk hidup bergantung padamu dan apa yang dihadirkan setiap musim. Bahwa Nenek masih meluangkan waktu untukku di tengah semua itu adalah sesuatu yang takkan pernah kusia-siakan."
      Speaker = "Melinoe"
      Event = "DemeterGift05"
    }
    {
      Id = "Demeter_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuterima persembahanmu, meski biasanya hal seperti ini membuatku dingin. Belakangan ini dari bangsa fana, isinya cuma memelas, merengek minta belas kasihan, tak ada yang lain. {#Emph}Tumbuhkanlah tanamanku, Bunda Demeter. Selamatkanlah panenku, Bunda Demeter! {#Prev}Sungguh memuakkan..."
      Speaker = "Demeter"
      Event = "DemeterGift05"
    }
    {
      Id = "MelinoeField_3727"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di tempat asalku, kami serbakekurangan, tapi tak pernah benar-benar kelaparan. Dan aku tahu itu sedikit banyak berkat Nenek. Kepala sekolahku sangat menyanjungmu, dan aku bisa paham alasannya sejak pertama kali kita berjumpa begini."
      Speaker = "Melinoe"
      Event = "DemeterGift06"
    }
    {
      Id = "Demeter_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin aku sendiri yang seharusnya lebih banyak bersyukur. Aku terlalu sering meratapi luka dan kekuranganku... bagaimana bisa tidak? Namun kini aku memilikimu, rumah di puncak gunung ini, dan banyak lagi. Andaikan saja beban dari semua ini bisa sedikit terangkat."
      Speaker = "Demeter"
      Event = "DemeterGift06"
    }
    {
      Id = "MelinoeField_4167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hadiah Ambrosia untuk Nenek! Semoga ini bisa sedikit menyemarakkan suasana, karena mestinya ada banyak perayaan di masa mendatang. Tapi yang terutama, aku hanya ingin Nenek menerimanya, atas segala harapan yang telah Nenek berikan padaku."
      Speaker = "Melinoe"
      Event = "DemeterGift07"
    }
    {
      Id = "Demeter_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bilang {#Emph}aku {#Prev}memberimu {#Emph}harapan? Tadinya tekadku bulat untuk melawan sang Titan apa pun taruhannya. Tapi setelah bertemu denganmu... aku mulai memikirkan kemungkinan bahwa kita bisa menang. Lalu aku bisa membayangkan wajah lembut putriku, dan wajah putri{#Emph}nya. {#Prev}Tak ada alasan yang lebih berharga dari itu."
      Speaker = "Demeter"
      Event = "DemeterGift07"
    }
    {
      Id = "MelinoeField_4168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nenek, kau selalu mendampingiku sejak pertama kali kita bertemu, dan aku merasakan ikatan batin kita sejak awal. Semoga Ambrosia ini tak hanya mengenang masa lalu kita, tapi juga menyongsong masa depan kita. Karena aku merasa masih banyak yang perlu kupelajari tentangmu, dan kupelajari darimu."
      Speaker = "Melinoe"
      Event = "DemeterGift08"
    }
    {
      Id = "Demeter_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan kuterima ini, tapi cukup sampai di sini saja. Ketahuilah bahwa ibumu dan aku selalu punya perselisihan, Bunga Kecilku. Barulah saat dia menjalani hidupnya sendiri alih-alih menuruti kehendakku, ikatan kami yang sempat layu mulai pulih kembali. Semoga hubunganmu dan hubunganku bisa tumbuh jauh melampaui masa-masa sulit itu."
      Speaker = "Demeter"
      Event = "DemeterGift08"
    }
    {
      Id = "Melinoe_1736"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hadiah dari Nenek..."
      Speaker = "Melinoe"
      Event = "DemeterUpgrade.GiftGivenVoiceLines"
    }
    {
      Id = "Demeter_0245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menggigil dan membusuklah!"
      Speaker = "Demeter"
      Event = "DemeterUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Demeter_0247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dingin yang melumpuhkan!"
      Speaker = "Demeter"
      Event = "DemeterUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Demeter_0246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Membekulah selamanya!"
      Speaker = "Demeter"
      Event = "DemeterUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Demeter_0248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Inikah yang benar-benar kau inginkan?!"
      Speaker = "Demeter"
      Event = "DemeterUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Demeter_0249"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mirip sekali kau dengan ibumu!"
      Speaker = "Demeter"
      Event = "DemeterUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Demeter_0250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah katamu, Cucuku!"
      Speaker = "Demeter"
      Event = "DemeterUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dingin yang tak wajar...!"
      Speaker = "Chronos"
      Event = "DemeterUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hawa {#Emph}dingin {#Prev}di kedalaman {#Emph}jurang ini?"
      Speaker = "Chronos"
      Event = "DemeterUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zagreus_0358"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nenek...?"
      Speaker = "Zagreus"
      Event = "DemeterUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zagreus_0359"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rupanya beliau punya anak emas!"
      Speaker = "Zagreus"
      Event = "DemeterUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Demeter_0117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Habis sudah kesabaranku menghadapi kelancangan; tiada pengecualian, bahkan untukmu sekalipun."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Demeter_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan bikin aku murka lagi, Bunga Kecilku, atau akan kubuat kau {#Emph}layu."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Demeter_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian dewi-dewi muda ini semuanya sama saja..."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Demeter_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini bukan pengkhianatan, Cucuku; ini murni sebuah pelajaran."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Demeter_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Demeter_0140"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, tentu saja."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Demeter_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kuturuti."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Demeter_0142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pilihanmu."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Demeter_0143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, beres."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Demeter_0144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sesuai kehendakmu."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Demeter_0145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Demeter_0146"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Untukmu."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Demeter_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo, bungaku!"
      Speaker = "Demeter"
      Event = "DemeterUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Demeter_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini aku."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Demeter_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam dariku."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Demeter_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cucuku?"
      Speaker = "Demeter"
      Event = "DemeterUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Demeter_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang kita punya di sini?"
      Speaker = "Demeter"
      Event = "DemeterUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Demeter_0138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sungguh sebuah kejutan!"
      Speaker = "Demeter"
      Event = "DemeterUpgrade.BlindBoxOpenedVoiceLines"
    }
    {
      Id = "Demeter_0181"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihatlah."
      Speaker = "Demeter"
      Event = "DemeterUpgrade.BlindBoxOpenedVoiceLines"
    }
  ]
