{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Eris.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_2693"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, Perselisihan."
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.InteractVoiceLines"
    }
    {
      Id = "Eris_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam balik!"
      Speaker = "Eris"
      Event = "NPC_Eris_01.InteractVoiceLines"
    }
    {
      Id = "Eris_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bantai mereka semua."
      Speaker = "Eris"
      Event = "NPC_Eris_01.InteractVoiceLines"
    }
    {
      Id = "Eris_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak butuh!"
      Speaker = "Eris"
      Event = "NPC_Eris_01.InteractVoiceLines"
    }
    {
      Id = "Eris_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bakal cari jalanku sendiri."
      Speaker = "Eris"
      Event = "NPC_Eris_01.InteractVoiceLines"
    }
    {
      Id = "Eris_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bakal butuh ini."
      Speaker = "Eris"
      Event = "NPC_Eris_01.InteractVoiceLines"
    }
    {
      Id = "Eris_0140"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Boleh juga, deh!"
      Speaker = "Eris"
      Event = "NPC_Eris_01.InteractVoiceLines"
    }
    {
      Id = "Eris_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada apa, Sayang?"
      Speaker = "Eris"
      Event = "NPC_Eris_01.InteractVoiceLines"
    }
    {
      Id = "Eris_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kangen aku nggak, Bikin Onar? Kupikir bakal asyik mampir lagi ke wilayahmu, lagian aku kan masih {#Emph}disambut di sini dan aman {#Prev}dan segalanya. Lagi sibuk apa akhir-akhir ini?"
      Speaker = "Eris"
      Event = "ErisFirstMeeting"
    }
    {
      Id = "Melinoe_2419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya biasa saja, Eris! Jadi, ada angin apa kau kembali? Sempat terpikir kalau kau benar-benar pergi untuk selamanya kali ini."
      Speaker = "Melinoe"
      Event = "ErisFirstMeeting"
    }
    {
      Id = "Eris_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak enak sih bikin kecewa, tapi aku nggak bisa jauh-jauh! Apalagi di tengah-tengah kekacauan seru yang lagi kita hadapi sekarang. {#Emph}Kau {#Prev}lagi {#Emph}sibuk {#Prev}banget ya akhir-akhir ini, {#Emph}kan?"
      Speaker = "Eris"
      Event = "ErisFirstMeeting"
    }
    {
      Id = "Melinoe_2653"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa pun yang kau dengar, tolong rahasiakan itu."
      Speaker = "Melinoe"
      Event = "ErisFirstMeeting"
    }
    {
      Id = "Eris_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kangen aku, Bikin Onar? Kupikir bakal asyik mampir sebentar lagi, dan lihat kabar semuanya, lagian aku kan {#Emph}disambut di sini dan masih aman{#Prev}, bukan? Meski memang {#Emph}sudah {#Prev}agak lama sih."
      Speaker = "Eris"
      Event = "ErisFirstMeeting_B"
    }
    {
      Id = "Melinoe_3122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum cukup lama. Padahal aku berharap kau sudah berhenti bersikap kekanak-kanakan, Eris, tapi rasanya kau kembali bukan karena alasan lain selain untuk melanjutkannya."
      Speaker = "Melinoe"
      Event = "ErisFirstMeeting_B"
    }
    {
      Id = "Eris_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, kau nggak bisa bayangkan kalau aku cuma mau menengok kakak perempuanku, kalau bukan dirimu? Aku paham kok, kau masih marah karena kuperlambat langkahmu waktu itu, tapi... aku nggak bakal mengulanginya lagi, sumpah. Jadi, gencatan senjata?"
      Speaker = "Eris"
      Event = "ErisFirstMeeting_B"
    }
    {
      Id = "Melinoe_3213"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita lihat nanti."
      Speaker = "Melinoe"
      Event = "ErisFirstMeeting_B"
    }
    {
      Id = "Eris_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gencatan senjata!"
      Speaker = "Eris"
      Event = "ErisFirstMeeting_B"
    }
    {
      Id = "Eris_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kan alasan aku {#Emph}sebenarnya {#Prev}kembali, bukan begitu, Bikin Onar? Karena semuanya {#Emph}akhirnya {#Prev}mulai jadi {#Emph}menarik. {#Prev}Tapi kau malah berniat menghentikannya...!"
      Speaker = "Eris"
      Event = "ErisAboutTask01"
    }
    {
      Id = "Melinoe_2421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan membiarkanmu meragukan tugasku. Bukankah lebih baik kau gunakan energimu untuk hal lain daripada ini, dan membuang semua sampahmu ke mana-mana?"
      Speaker = "Melinoe"
      Event = "ErisAboutTask01"
    }
    {
      Id = "Eris_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu apa {#Emph}kau {#Prev}soal itu? Aku punya {#Emph}hak penuh {#Prev}berada di sini, dan kau takkan pernah bisa menyingkirkanku! Dan kau juga takkan pernah bisa menyingkirkan Chronos. Segalanya takkan bisa {#Emph}kembali {#Prev}seperti {#Emph}semula!"
      Speaker = "Eris"
      Event = "ErisAboutTask01"
    }
    {
      Id = "Melinoe_2422"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita melangkah maju, bukan mundur."
      Speaker = "Melinoe"
      Event = "ErisAboutTask01"
    }
    {
      Id = "Eris_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jujur saja, aku nggak paham jalan pikiran kalian. Bersikeras membuat semuanya kembali seperti dulu kala. {#Emph}Kau{#Prev}, terutama! Kau bahkan nggak tahu apa yang kau lewatkan!"
      Speaker = "Eris"
      Event = "ErisAboutPurpose01"
    }
    {
      Id = "Melinoe_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami berusaha membenahi segalanya, bukan mengembalikannya persis seperti dulu. Tapi, sebenarnya apa maksudmu, Eris?"
      Speaker = "Melinoe"
      Event = "ErisAboutPurpose01"
    }
    {
      Id = "Eris_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudku apa? Maksud {#Emph}kamu {#Prev}apa? Kalian semua {#Emph}terlalu {#Prev}terobsesi harus ada {#Emph}Tujuan {#Prev}untuk segalanya. Kau sadar kan kalau itu semua nggak ada artinya? Nggak bisa ya bersenang-senang dan lepas kendali sedikit saja?"
      Speaker = "Eris"
      Event = "ErisAboutPurpose01"
    }
    {
      Id = "Melinoe_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dalam keadaan sekarang ini, tidak bisa."
      Speaker = "Melinoe"
      Event = "ErisAboutPurpose01"
    }
    {
      Id = "Melinoe_2654"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris, kau... kau tadi bilang aku bahkan tidak tahu apa yang kulewatkan. Apa maksudmu?"
      Speaker = "Melinoe"
      Event = "ErisAboutHeart01"
    }
    {
      Id = "Eris_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jelas bukan maksudku soal {#Emph}keluargamu{#Prev}! Ayolah, coba lihat dirimu sendiri. Kau belum pernah benar-benar {#Emph}hidup {#Prev}sepanjang {#Emph}hidupmu! {#Prev}Jantung yang berdegup di dadamu itu? Kau pikir itu cuma buat memompa darahmu! Cuma sekadar gumpalan otot!"
      Speaker = "Eris"
      Event = "ErisAboutHeart01"
    }
    {
      Id = "Melinoe_2655"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jantung {#Emph}memang {#Prev}otot. Lalu apa, aku harus berfoya-foya di luar sana? Saat Olympus sedang terancam bahaya, dan Dunia Bawah luluh lantak kacau balau?"
      Speaker = "Melinoe"
      Event = "ErisAboutHeart01"
    }
    {
      Id = "Eris_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja! Tapi kau maunya segalanya rapi, teratur, mudah ditebak, dan {#Emph}membosankan."
      Speaker = "Eris"
      Event = "ErisAboutHeart01"
    }
    {
      Id = "Melinoe_2656"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu tidak benar."
      Speaker = "Melinoe"
      Event = "ErisAboutHeart01"
    }
    {
      Id = "Eris_0030"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yakin nih...?"
      Speaker = "Eris"
      Event = "ErisAboutHeart01"
    }
    {
      Id = "Melinoe_2657"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar... kau memang benar aku tidak pernah tahu seperti apa masa-masa sebelum Chronos bangkit kembali. Kau terus menyindir bahwa masa itu lebih buruk daripada sekarang. Memangnya kenapa?"
      Speaker = "Melinoe"
      Event = "ErisAboutPast01"
    }
    {
      Id = "Eris_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kan sudah kubilang tadi, Sayang! Ayahmu, ibuku, seluruh lingkaran dalam mereka... mereka tuh puas banget kalau bisa memerintah semua orang semaunya! Nggak memberiku ruang buat bebas mengepakkan sayap. Sekumpulan peniru Olympus, tapi pakai {#Emph}pencahayaan temaram!"
      Speaker = "Eris"
      Event = "ErisAboutPast01"
    }
    {
      Id = "Melinoe_2658"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jadi kau lebih memilih hidup dalam kekacauan total dan huru-hara tiada henti daripada hidup di bawah tatanan aturan yang berprinsip?"
      Speaker = "Melinoe"
      Event = "ErisAboutPast01"
    }
    {
      Id = "Eris_0032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat sekali caramu menggambarkannya!"
      Speaker = "Eris"
      Event = "ErisAboutPast01"
    }
    {
      Id = "Eris_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar ingin tahu bagaimana keadaan zaman dulu, Biang Masalah? Coba pikirkan apa pun yang membuatmu keluar dari tendamu malam demi malam. Yang membuatmu {#Emph}bersemangat! {#Prev}Apa yang terlintas di benakmu?"
      Speaker = "Eris"
      Event = "ErisAboutPast02"
    }
    {
      Id = "Melinoe_2662"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja. Orang-orang yang kupedulikan mengandalkanku. Dan, aku ingin belajar; tumbuh kuat dalam raga, pikiran, dan jiwa."
      Speaker = "Melinoe"
      Event = "ErisAboutPast02"
    }
    {
      Id = "Eris_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sangat menginspirasi. Sekarang, bayangkan memiliki segalanya yang kau inginkan... sampai-sampai kau tidak lagi menginginkan apa pun...."
      Speaker = "Eris"
      Event = "ErisAboutPast02"
    }
    {
      Id = "Melinoe_2663"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, aku tidak bisa membayangkannya. Jadi, semua orang selain dirimu dulu suka berleha-leha dan tidak punya motivasi? Tapi sekarang perannya terbalik, kurasa?"
      Speaker = "Melinoe"
      Event = "ErisAboutPast02"
    }
    {
      Id = "Eris_0037"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tidak paham. Terserahlah."
      Speaker = "Eris"
      Event = "ErisAboutPast02"
    }
    {
      Id = "Eris_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wou, haha! {#Prev}Kau mengagetkanku, Biang Masalah! Mengendap-endap seperti itu, hampir saja kutembak kau. Kau harus lebih berhati-hati!"
      Speaker = "Eris"
      Event = "ErisAboutWeaponGun01"
    }
    {
      Id = "Melinoe_2667"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak suka caramu mengacung-acungkan benda itu ke mana-mana. Senjata tetap dilarang di luar area latihan, kalau-kalau kau belum tahu."
      Speaker = "Melinoe"
      Event = "ErisAboutWeaponGun01"
    }
    {
      Id = "Eris_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Senjata? Ah-ha! Halo{#Prev}, yang sedang kau bicarakan ini Rel Adamant. Si manis ini dulu pernah menumbangkan para {#Emph}Titan! {#Prev}Ini adalah karya seni. Dan {#Emph}tidak ada yang boleh {#Prev}merebutnya dariku!"
      Speaker = "Eris"
      Event = "ErisAboutWeaponGun01"
    }
    {
      Id = "Melinoe_2668"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berniat memberitahuku bagaimana kau bisa mendapatkannya sejak awal? Benda itu seharusnya berada di bawah pengawasan {#Emph}ayahku... {#Prev}tapi, entah bagaimana sekarang ada di tangan{#Emph}mu."
      Speaker = "Melinoe"
      Event = "ErisAboutWeaponGun01"
    }
    {
      Id = "Eris_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ternyata dia tidak begitu hebat dalam melindungi miliknya sendiri!"
      Speaker = "Eris"
      Event = "ErisAboutWeaponGun01"
    }
    {
      Id = "Eris_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh, {#Prev}ada {#Emph}apa lagi, sih? {#Prev}Rel Adamant kembali normal! Aku pasti memencet tombol rahasia atau semacamnya, tapi... benda ini bahkan tidak {#Emph}berfungsi {#Prev}di sini, apalagi bertransformasi!"
      Speaker = "Eris"
      Event = "ErisAboutAltFight01"
    }
    {
      Id = "Melinoe_4275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pahamilah petunjuk itu, Eris. Kau mungkin pemegang Rel untuk saat ini, tapi ia tidak tunduk padamu semata. Sekalipun ia membiarkanmu membidik dan menembak."
      Speaker = "Melinoe"
      Event = "ErisAboutAltFight01"
    }
    {
      Id = "Eris_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya saja ia membiarkanku membidik dan menembak sekarang {#Emph}juga! {#Prev}Kau sebaiknya bukan dalang di balik ini, Biang Masalah, atau kalau itu memang {#Emph}ulahmu... {#Prev}kembalikan seperti {#Emph}semula! {#Prev}Aku lebih suka bentuk yang satunya!"
      Speaker = "Eris"
      Event = "ErisAboutAltFight01"
    }
    {
      Id = "Melinoe_4276"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benda itu bisa mendengarmu, lho."
      Speaker = "Melinoe"
      Event = "ErisAboutAltFight01"
    }
    {
      Id = "Melinoe_2669"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang mendorongmu memenuhi tempat ini dengan sampahmu, Eris? Apakah kau ingin disambut di sini hanya sebatas formalitas?"
      Speaker = "Melinoe"
      Event = "ErisAboutTrash01"
    }
    {
      Id = "Eris_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Um{#Prev}, sejak kapan aku harus peduli apa kata orang? Kalian semua gembar-gembor soal meminjam dari bumi. Aku cuma mengembalikan sesuatu padanya!"
      Speaker = "Eris"
      Event = "ErisAboutTrash01"
    }
    {
      Id = "Melinoe_2670"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu... {#Emph}ihh..."
      Speaker = "Melinoe"
      Event = "ErisAboutTrash01"
    }
    {
      Id = "Melinoe_2671"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya benda apa yang selalu kau buang sembarangan di sini? {#Emph}Dendeng Cyclops? {#Prev}Apa kau kebetulan menemukan persediaan tanpa batas?"
      Speaker = "Melinoe"
      Event = "ErisAboutTrash02"
    }
    {
      Id = "Eris_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, kenyataannya memang iya! Dan kau takkan pernah bisa menebak dari mana asalnya. Makanan ini {#Emph}sangat bikin ketagihan {#Prev}begitu kau mencicipinya! Mau coba?"
      Speaker = "Eris"
      Event = "ErisAboutTrash02"
    }
    {
      Id = "Melinoe_2672"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak."
      Speaker = "Melinoe"
      Event = "ErisAboutTrash02"
    }
    {
      Id = "Eris_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak perlu memunguti sampahku, tahu. {#Emph}Aku {#Prev}juga tadinya mau membereskannya! Ngomong-ngomong, mau kau {#Emph}apakan {#Prev}semua itu?"
      Speaker = "Eris"
      Event = "ErisAboutTrash03"
    }
    {
      Id = "Melinoe_4231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memberikannya pada Pialang Malang, agar apa pun yang tidak kita perlukan lagi bisa kembali ke Bumi. Kau sendiri bisa melakukannya...! Pialangnya ada di sana..."
      Speaker = "Melinoe"
      Event = "ErisAboutTrash03"
    }
    {
      Id = "Eris_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, tidak usah repot-repot. Aku tak mau merepotkan! Walau mungkin aku akan mengacak-acak barang-barang{#Emph}mu {#Prev}lain kali saat kau pergi, dan meminta sang Pialang mengembalikan {#Emph}semuanya {#Prev}ke Bumi!"
      Speaker = "Eris"
      Event = "ErisAboutTrash03"
    }
    {
      Id = "Melinoe_4232"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan berani-berani."
      Speaker = "Melinoe"
      Event = "ErisAboutTrash03"
    }
    {
      Id = "Melinoe_4897"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris, aku ingin meminta bantuan, meski ini lebih mirip permohonan: Bisakah kau {#Emph}tolong{#Prev}, tolong berhenti membuang sampahmu di tanah? Kau bisa menaruhnya di keranjang persis di dekat situ!"
      Speaker = "Melinoe"
      Event = "ErisAboutTrash04"
    }
    {
      Id = "Eris_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, entahlah, sayang! Aku ingat betul waktu memintamu menjodohkanku dengan Ares dan itu tidak berjalan sesuai keinginanku. Jadi kenapa {#Emph}aku {#Prev}harus melakukan sesuatu untuk{#Emph}mu?"
      Speaker = "Eris"
      Event = "ErisAboutTrash04"
    }
    {
      Id = "Melinoe_4898"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir memintaku menarik perhatian sang dewa perang tidaklah setara dengan sekadar membersihkan sampahmu sendiri saat kau pada dasarnya adalah tamu. Tapi kalau kau memang berniat dengki, terserah."
      Speaker = "Melinoe"
      Event = "ErisAboutTrash04"
    }
    {
      Id = "Eris_0353"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja, aku memang berniat begitu!"
      Speaker = "Eris"
      Event = "ErisAboutTrash04"
    }
    {
      Id = "Eris_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Awalnya kukira kau tersesat ke sini tanpa sengaja. Tapi {#Emph}kau {#Prev}terus-menerus muncul. Ada yang mau kau katakan padaku, sayang?"
      Speaker = "Eris"
      Event = "ErisAboutAlley01"
    }
    {
      Id = "Melinoe_2673"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, aku... hanya terpikat ke sini, ke arahmu. Oleh jejak sampahmu! Kau sengaja memancingku, kan."
      Speaker = "Melinoe"
      Event = "ErisAboutAlley01"
    }
    {
      Id = "Eris_0047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sasaran yang mudah."
      Speaker = "Eris"
      Event = "ErisAboutAlley01"
    }
    {
      Id = "Melinoe_4906"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, terima kasih, Eris! Kau tidak melempar sampahmu ke arahku saat aku mendekat... itu pasti tidak mudah bagimu."
      Speaker = "Melinoe"
      Event = "ErisAboutAlley02"
    }
    {
      Id = "Eris_0366"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu {#Emph}mudah{#Prev}, Biang Masalah, soalnya aku lupa! Pikiranku lagi penuh, oke? Jadi jangan langsung memojokkanku begitu aku khilaf pada hal sekecil apa pun."
      Speaker = "Eris"
      Event = "ErisAboutAlley02"
    }
    {
      Id = "Melinoe_4907"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak memojokkanmu, aku tadinya benar-benar senang, tapi rupanya aku salah besar. Apa kau sungguh berharap aku terus memunguti sampahmu selamanya?"
      Speaker = "Melinoe"
      Event = "ErisAboutAlley02"
    }
    {
      Id = "Eris_0367"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya lagipula tidak mungkin Moros yang bakal melakukannya! Selain itu, bagaimana lagi caranya aku memancingmu ke tempat di mana aku bisa memilikimu seorang diri?"
      Speaker = "Eris"
      Event = "ErisAboutAlley02"
    }
    {
      Id = "Melinoe_4908"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah {#Emph}kuduga {#Prev}kau sengaja memancingku!"
      Speaker = "Melinoe"
      Event = "ErisAboutAlley02"
    }
    {
      Id = "Eris_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan kau masih saja memakan umpannya!"
      Speaker = "Eris"
      Event = "ErisAboutAlley02"
    }
    {
      Id = "Melinoe_2674"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya untuk apa kau di sini, Eris? Jangan bilang Chronos yang menyuruhmu. Kau sudah menegaskan tak ingin melihatku berhasil."
      Speaker = "Melinoe"
      Event = "ErisAboutLoyalty01"
    }
    {
      Id = "Eris_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang, aku hampir sakit hati, lho! Kau sama sekali tak memahamiku, ya? Hanya karena aku tak mendukung{#Emph}mu{#Prev}, bukan berarti aku mendukung si orang {#Emph}tua itu{#Prev}."
      Speaker = "Eris"
      Event = "ErisAboutLoyalty01"
    }
    {
      Id = "Melinoe_2675"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lantas siapa yang sebenarnya kau dukung, coba beri tahu aku?"
      Speaker = "Melinoe"
      Event = "ErisAboutLoyalty01"
    }
    {
      Id = "Eris_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar kau tebak sendiri saja deh."
      Speaker = "Eris"
      Event = "ErisAboutLoyalty01"
    }
    {
      Id = "Melinoe_2681"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris, kenapa kau selalu menyendiri di sini? Kau tak pernah terkesan pendiam bagiku, dan tampaknya kau menikmati berinteraksi dengan orang lain, dengan caramu sendiri...."
      Speaker = "Melinoe"
      Event = "ErisAboutSolitude01"
    }
    {
      Id = "Eris_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, Sayang, penjelasannya agak aneh, dan kau pasti takkan suka kalau kuberi tahu. Yang mana bikin aku {#Emph}sangat {#Prev}ingin menceritakannya padamu! Tapi kemudian aku terpikir betapa penasarannya dirimu, yang akhirnya bikin aku {#Emph}enggan {#Prev}memberi tahumu lagi."
      Speaker = "Eris"
      Event = "ErisAboutSolitude01"
    }
    {
      Id = "Melinoe_2682"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cukup yakin kau ini bukan sekadar khayalan imajinasiku. Suara kecil di kepalaku yang terus menyesatkanku."
      Speaker = "Melinoe"
      Event = "ErisAboutSolitude01"
    }
    {
      Id = "Eris_0057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selama kau tak {#Emph}benar-benar {#Prev}yakin!"
      Speaker = "Eris"
      Event = "ErisAboutSolitude01"
    }
    {
      Id = "Melinoe_2683"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah menyaksikan sendiri penderitaan di luar sana, akibat perang tanpa henti antara Chronos dan para dewa. Tapi kau sama sekali tak tergerak?"
      Speaker = "Melinoe"
      Event = "ErisAboutDisorder01"
    }
    {
      Id = "Eris_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa bilang aku tak {#Emph}tergerak? {#Prev}Malahan, itu bikin perasaanku campur aduk secara {#Emph}emosional! {#Prev}Aku sedang berusaha menikmati momen saat ini dan segalanya, tapi... aku yakin suatu saat akan mengenang ini dan berpikir, {#Emph}itulah masa-masa terbaikku."
      Speaker = "Eris"
      Event = "ErisAboutDisorder01"
    }
    {
      Id = "Melinoe_2684"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terbaik bagimu; bukan bagi yang lain."
      Speaker = "Melinoe"
      Event = "ErisAboutDisorder01"
    }
    {
      Id = "Eris_0059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, lantas kenapa...?"
      Speaker = "Eris"
      Event = "ErisAboutDisorder01"
    }
    {
      Id = "Eris_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak tahu betapa beruntungnya dirimu, Biang Onar. Aku tumbuh dikelilingi saudara-saudari yang semuanya merasa lebih hebat dariku. Ada si congkak {#Emph}Pembalasan{#Prev}, di sana! Lalu {#Emph}Kematian{#Prev}, dan {#Emph}Malapetaka! {#Prev}Tak ada yang mau berurusan dengan {#Emph}Perselisihan."
      Speaker = "Eris"
      Event = "ErisAboutStrife01"
    }
    {
      Id = "Melinoe_2685"
      InheritFrom = "BaseNarrative"
      DisplayName = "Moros bisa memahamimu lebih dari yang kau tahu. Kalian anak-anak Nyx memang ditakuti banyak orang, tapi lantas kenapa? Kau tak butuh banyak teman. Cukup beberapa teman baik saja. Dan makna sesungguhnya dari {#Emph}Perselisihan {#Prev}itu terserah {#Emph}dirimu {#Prev}yang menentukan, bukan?"
      Speaker = "Melinoe"
      Event = "ErisAboutStrife01"
    }
    {
      Id = "Eris_0061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maksudku, ya {#Emph}mungkin saja..."
      Speaker = "Eris"
      Event = "ErisAboutStrife01"
    }
    {
      Id = "Eris_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan benci aku ya, Sayang, oke? Ini bukan salahku kalau aku terus membohongimu, memanipulasimu, menembakmu pakai Rail, menyuruhmu beres-beres sisa kekacauanku, menjelek-jelekkanmu di belakangmu..."
      Speaker = "Eris"
      Event = "ErisAboutStrife02"
    }
    {
      Id = "Melinoe_3131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski rasanya ini kegagalan pribadiku, terlepas dari segalanya, aku {#Emph}tidak {#Prev}membencimu, Eris. Tidak sepenuhnya. Walaupun... kesalahan siapa {#Emph}semua itu{#Prev}, kalau bukan dirimu sendiri?"
      Speaker = "Melinoe"
      Event = "ErisAboutStrife02"
    }
    {
      Id = "Eris_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salah {#Emph}ibuku! {#Prev}Ini salah Nyx, tahu! Karena dialah yang membentukku jadi seperti ini, dan selamanya akan begini. Aku kan bisa saja menjadi dewi {#Emph}Usia Senja{#Prev}, atau {#Emph}Persahabatan! {#Prev}Tapi, tidak! Dan aku tak bisa mengubah kodratku. Tak peduli {#Emph}sekeras {#Prev}apa pun aku mencoba."
      Speaker = "Eris"
      Event = "ErisAboutStrife02"
    }
    {
      Id = "Melinoe_3132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan, kira-kira sekeras apa usahamu itu selama ini?"
      Speaker = "Melinoe"
      Event = "ErisAboutStrife02"
    }
    {
      Id = "Eris_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudku, aku belum {#Emph}benar-benar {#Prev}mencobanya, sih! Tapi kali ini aku bakal berusaha, sumpah!"
      Speaker = "Eris"
      Event = "ErisAboutStrife02"
    }
    {
      Id = "Melinoe_3133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan aku sangat mendukungmu."
      Speaker = "Melinoe"
      Event = "ErisAboutStrife02"
    }
    {
      Id = "Eris_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}heboh sekali {#Prev}soal perang ini, seolah ini urusan {#Emph}yang sangat besar. {#Prev}Olimpus itu {#Emph}suka {#Prev}perang yang seru! Mereka sering melakukannya di atas sana, bahkan punya satu {#Emph}dewa {#Prev}khusus untuk itu dan segalanya. Tahu betapa {#Emph}mudahnya {#Prev}bikin mereka saling serang?"
      Speaker = "Eris"
      Event = "ErisAboutWar01"
    }
    {
      Id = "Melinoe_2688"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, Eris, tolong beri tahu aku. Seberapa mudahnya membuat para kerabatku terjerumus ke dalam kekerasan dan kehancuran yang biadab?"
      Speaker = "Melinoe"
      Event = "ErisAboutWar01"
    }
    {
      Id = "Eris_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu itu pernah, mereka semua ribut setengah mati cuma gara-gara satu Apel Emas. Persembahan misterius, yang ditujukan untuk {#Emph}sang jelita yang paling rupawan! {#Prev}Mereka berselisih soal siapa yang dimaksud si pengagum rahasia itu, lalu merembet ke mana-mana, dan {#Emph}booom!"
      Speaker = "Eris"
      Event = "ErisAboutWar01"
    }
    {
      Id = "Melinoe_2689"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya seperti kesalahpahaman biasa, kalau bukan sekadar lelucon jahil. Tapi kau bilang itu berkembang jadi perang skala penuh? Apa yang terjadi setelahnya?"
      Speaker = "Melinoe"
      Event = "ErisAboutWar01"
    }
    {
      Id = "Eris_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Yah{#Prev}, ceritanya panjang..."
      Speaker = "Eris"
      Event = "ErisAboutWar01"
    }
    {
      Id = "Eris_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagai orang yang cukup berpengalaman dalam memicu perang, harus kuakui... hanya karena aku tak bekerja untuk Chronos, bukan berarti aku tak menghargai apa yang berhasil ia capai."
      Speaker = "Eris"
      Event = "ErisAboutWar02"
    }
    {
      Id = "Melinoe_2686"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris... itu salah satu kalimat paling buruk yang pernah kudengar."
      Speaker = "Melinoe"
      Event = "ErisAboutWar02"
    }
    {
      Id = "Eris_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba lihat apa yang telah ia perbuat, secara objektif, dan buktikan kalau aku salah!"
      Speaker = "Eris"
      Event = "ErisAboutWar02"
    }
    {
      Id = "Melinoe_2687"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak, terima kasih..."
      Speaker = "Melinoe"
      Event = "ErisAboutWar02"
    }
    {
      Id = "Eris_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu apa masalahmu, Biang Onar? Kau terlalu naif. Kurang makan asam garam kehidupan untuk memilah mana kebenaran dari apa pun omong kosong yang dicekokkan padamu."
      Speaker = "Eris"
      Event = "ErisAboutTruth01"
    }
    {
      Id = "Melinoe_2717"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas masukannya, Eris. Kau memberiku banyak bahan renungan. Maaf saja hidup kita di perkemahan yang terkepung ini rasanya kurang sengsara buatmu."
      Speaker = "Melinoe"
      Event = "ErisAboutTruth01"
    }
    {
      Id = "Eris_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Terperangah> {#Prev}Sarkasme! Bagus, aku suka. Ada bakat jahat di dalam dirimu, aku tahu betul itu, Sayang. Dan aku tak mau kau menyimpannya untuk {#Emph}dirimu sendiri! {#Prev}Bagikan bakatmu itu ke seluruh dunia!"
      Speaker = "Eris"
      Event = "ErisAboutTruth01"
    }
    {
      Id = "Melinoe_2718"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah katamu..."
      Speaker = "Melinoe"
      Event = "ErisAboutTruth01"
    }
    {
      Id = "Eris_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Cih! {#Prev}Bukan! Terserah kata{#Emph}mu!"
      Speaker = "Eris"
      Event = "ErisAboutTruth01"
    }
    {
      Id = "Eris_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu rasanya disingkirkan. Semua orang {#Emph}tersenyum {#Prev}di depanmu lalu {#Emph}menusuk {#Prev}dari belakang. Yah, sekadar tahu saja... aku nggak percaya sepatah kata pun omongan mereka tentangmu."
      Speaker = "Eris"
      Event = "ErisAboutRumors01"
    }
    {
      Id = "Melinoe_2719"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu. Dan siapa tepatnya yang kau maksud, serta bisakah kau sebutkan contoh kata-kata yang konon mereka katakan itu?"
      Speaker = "Melinoe"
      Event = "ErisAboutRumors01"
    }
    {
      Id = "Eris_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, cuma... Odysseus dan Hecate. Aku nggak habis pikir mereka mengira kau bakal {#Emph}gagal{#Prev}, bahwa kau tak punya {#Emph}kemampuan...! {#Prev}Maksudku, aku memang nggak mau kau berhasil, tapi... aku nggak pernah berpura-pura sebaliknya!"
      Speaker = "Eris"
      Event = "ErisAboutRumors01"
    }
    {
      Id = "Melinoe_2720"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sedang mencoba mengadu domba."
      Speaker = "Melinoe"
      Event = "ErisAboutRumors01"
    }
    {
      Id = "Eris_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku cuma berusaha membantu!"
      Speaker = "Eris"
      Event = "ErisAboutRumors01"
    }
    {
      Id = "Eris_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau naik ke atas! Sempat menghirup udara segar permukaan. Ada angin apa sampai kau melakukan hal semacam itu? Kukira kau cuma fokus memburu Chronos!"
      Speaker = "Eris"
      Event = "ErisAboutSurface01"
    }
    {
      Id = "Melinoe_2721"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir tak ada salahnya mencari sedikit suasana baru. Tapi, aku heran kau sendiri tak berada di atas sana, mengingat situasinya seperti sekarang."
      Speaker = "Melinoe"
      Event = "ErisAboutSurface01"
    }
    {
      Id = "Eris_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya memang seru banget! Tapi, aku mungkin cuma bakal menghalangi. Dari yang kudengar, Ares memegang kendali penuh di atas sana. {#Emph}Bayangkan {#Prev}jadi dewa perang saat ini. Pasti bakal {#Emph}girang setengah mati!"
      Speaker = "Eris"
      Event = "ErisAboutSurface01"
    }
    {
      Id = "Melinoe_2722"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seluruh keluargamu sedang dalam bahaya besar."
      Speaker = "Melinoe"
      Event = "ErisAboutSurface01"
    }
    {
      Id = "Eris_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Terus?"
      Speaker = "Eris"
      Event = "ErisAboutSurface01"
    }
    {
      Id = "Eris_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu! Semua kunjunganmu ke permukaan itu. {#Emph}Kau {#Prev}sedang mencoba pergi ke {#Emph}Olympus! {#Prev}Datang menyelamatkan keluarga! Mengakhiri perang di atas sana, begitu kan?"
      Speaker = "Eris"
      Event = "ErisAboutSurface02"
    }
    {
      Id = "Melinoe_2723"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku naik ke sana cuma untuk mengumpulkan reagen segar, sungguh. Lumut, serpihan perunggu. Benda-benda yang berguna! Para dewa Olympus sangat mampu menjaga diri mereka sendiri."
      Speaker = "Melinoe"
      Event = "ErisAboutSurface02"
    }
    {
      Id = "Eris_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja mereka mampu. Dan mereka terlalu gengsi untuk minta tolong. Asal jangan merusak kesenangan Ares saja saat kau di atas sana sibuk {#Emph}memetik Lumut. {#Prev}Dia lagi gacor-gacornya belakangan ini!"
      Speaker = "Eris"
      Event = "ErisAboutSurface02"
    }
    {
      Id = "Melinoe_2724"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya kau dan sang dewa perang masih sangat akrab. Dia pasti sangat sibuk akhir-akhir ini, bukan?"
      Speaker = "Melinoe"
      Event = "ErisAboutSurface02"
    }
    {
      Id = "Eris_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pastinya!"
      Speaker = "Eris"
      Event = "ErisAboutSurface02"
    }
    {
      Id = "Eris_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, {#Emph}um{#Prev}, Cantik? Aku punya sesuatu buatmu... nggak bermaksud melebih-lebihkannya atau apa, jadi... ini! Karena kau selalu baik."
      Speaker = "Eris"
      Event = "ErisPostGift01"
    }
    {
      Id = "Melinoe_2804"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebotol Nektar... terima kasih, Eris. Tapi, kita melanggar tradisi di sini. Bagaimana jika kita terus saling melempar botol yang sama ini bolak-balik, lalu bagaimana?"
      Speaker = "Melinoe"
      Event = "ErisPostGift01"
    }
    {
      Id = "Eris_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bakal jadi anarki {#Emph}total!"
      Speaker = "Eris"
      Event = "ErisPostGift01"
    }
    {
      Id = "Melinoe_3124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengkhianat! Beraninya kau menentangku dan perjuangan kita? Dan, beraninya kau menunjukkan mukamu lagi di sini! Kau akan diusir atas perbuatanmu!"
      Speaker = "Melinoe"
      Event = "ErisFoughtAgainstHer01"
    }
    {
      Id = "Eris_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sori, Cantik, tapi aku nggak ke mana-mana. Berterima kasihlah pada Nyx dan Hecate beserta {#Emph}sumpah tak terpatahkan {#Prev}mereka! Lagipula, kau salah paham tentangku."
      Speaker = "Eris"
      Event = "ErisFoughtAgainstHer01"
    }
    {
      Id = "Melinoe_3125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh? Mungkin aku cuma salah mengiramu sebagai salah satu putri Nyx yang {#Emph}lain{#Prev}, yang begitu bersemangat menembakiku menggunakan Rel Adamant!"
      Speaker = "Melinoe"
      Event = "ErisFoughtAgainstHer01"
    }
    {
      Id = "Eris_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, itu memang aku, dan tadi itu {#Emph}seru banget! {#Prev}Tapi aku tersinggung dengan sebutan {#Emph}pengkhianat{#Prev}. Rasanya sudah kuperjelas kalau aku nggak berada di pihakmu."
      Speaker = "Eris"
      Event = "ErisFoughtAgainstHer01"
    }
    {
      Id = "Melinoe_3126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu kau mengabdi pada Chronos!"
      Speaker = "Melinoe"
      Event = "ErisFoughtAgainstHer01"
    }
    {
      Id = "Eris_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ahahaha{#Prev}, tentu saja!"
      Speaker = "Eris"
      Event = "ErisFoughtAgainstHer01"
    }
    {
      Id = "Eris_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh{#Prev}, Cantik, tahu nggak? Kau memberi perlawanan yang lebih sengit di luar sana daripada yang kubayangkan! Rel itu sampai panas banget disentuh, aku nyaris tak sanggup {#Emph}menahannya!"
      Speaker = "Eris"
      Event = "ErisFoughtAgainstHer02"
    }
    {
      Id = "Melinoe_3127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang bisa menjadi hiburan bagimu. Jadi cuma ini arti semua ini bagimu? Kau mempertaruhkan kelangsungan hidup kita, hanya demi kesenangan murahan?"
      Speaker = "Melinoe"
      Event = "ErisFoughtAgainstHer02"
    }
    {
      Id = "Eris_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan sok bersikap seolah nggak ada bagian dari dirimu yang merasakan sedikit {#Emph}sensasi seru {#Prev}di luar sana. Dan sekarang setelah mencicipinya, kau menginginkan {#Emph}lebih{#Prev}, kan?"
      Speaker = "Eris"
      Event = "ErisFoughtAgainstHer02"
    }
    {
      Id = "Melinoe_3128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin kau enyah dari Persimpangan ini, dan enyah dari jalanku yang terkutuk ini."
      Speaker = "Melinoe"
      Event = "ErisFoughtAgainstHer02"
    }
    {
      Id = "Eris_0122"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Yah{#Prev}, sayang sekali kita nggak bisa mendapatkan segalanya..."
      Speaker = "Eris"
      Event = "ErisFoughtAgainstHer02"
    }
    {
      Id = "Melinoe_3129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Inikah yang kau inginkan, Eris? Bertarung tanpa tujuan, hanya untuk kemudian saling mencibir di sini, lagi dan lagi? Sungguh tujuan yang sangat mulia."
      Speaker = "Melinoe"
      Event = "ErisFoughtAgainstHer03"
    }
    {
      Id = "Eris_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memangnya siapa {#Emph}kau {#Prev}bisa menentukan mana tujuan yang mulia? Karena, {#Emph}ya! {#Prev}Kebetulan aku sangat menikmati {#Emph}semuanya! {#Prev}Beneran seru gila, tahu!"
      Speaker = "Eris"
      Event = "ErisFoughtAgainstHer03"
    }
    {
      Id = "Melinoe_3130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sungguh tak masuk akal."
      Speaker = "Melinoe"
      Event = "ErisFoughtAgainstHer03"
    }
    {
      Id = "Eris_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makasih, Pembuat Onar!"
      Speaker = "Eris"
      Event = "ErisFoughtAgainstHer03"
    }
    {
      Id = "Eris_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kamu beneran bakal mengalahkanku waktu itu, Sayang, tapi... kayaknya nggak. Mungkin lain kali. Kamu pasti dongkol banget ya nggak bisa membalasku sekarang?"
      Speaker = "Eris"
      Event = "ErisAboutCloseMatch01"
    }
    {
      Id = "Melinoe_3214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku takkan mengacaukan kedamaian di sini andai aku bisa sekalipun, Eris. Tapi kau benar-benar menguji kesabaranku. Saat kita bertemu lagi di tepi Celah nanti, aku takkan menahan diri."
      Speaker = "Melinoe"
      Event = "ErisAboutCloseMatch01"
    }
    {
      Id = "Eris_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ooh{#Prev}, dia {#Emph}marah! {#Prev}Persis seperti yang kusuka."
      Speaker = "Eris"
      Event = "ErisAboutCloseMatch01"
    }
    {
      Id = "Eris_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berhasil menumbangkanku secara adil lagi, Biang Masalah. Malah sudah berkali-kali! Aku mulai mikir jangan-jangan kemampuanku mulai tumpul, tahu nggak?"
      Speaker = "Eris"
      Event = "ErisAboutRematches01"
    }
    {
      Id = "Melinoe_3215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, kasihan sekali dirimu. Sini, biar kuberi semangat, supaya nanti kau bisa melawanku lebih sengit lagi dari sebelumnya."
      Speaker = "Melinoe"
      Event = "ErisAboutRematches01"
    }
    {
      Id = "Eris_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ejek saja aku selagi aku rapuh, terserah. Tapi jangan harap bisa menangis di pundak {#Emph}ini {#Prev}kalau urusan{#Emph}mu {#Prev}mulai berantakan. Enyah dari hadapan{#Emph}ku!"
      Speaker = "Eris"
      Event = "ErisAboutRematches01"
    }
    {
      Id = "Melinoe_3216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mencibir>"
      Speaker = "Melinoe"
      Event = "ErisAboutRematches01"
    }
    {
      Id = "Eris_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak habis pikir kamu tega mencampakkanku semalam, Biang Masalah! Kamu tahu betapa {#Emph}memalukannya {#Prev}harus menunggumu di pantai, tengah malam buta, sendirian {#Emph}pula?"
      Speaker = "Eris"
      Event = "ErisAboutNotFighting01"
    }
    {
      Id = "Melinoe_4236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Seingatku kita tak punya janji temu apa pun, kalau ada tentu sudah kupenuhi. Kau benar-benar berharap aku menelantarkan tujuan utama tugasku, hanya demi bertarung denganmu lagi dan lagi?"
      Speaker = "Melinoe"
      Event = "ErisAboutNotFighting01"
    }
    {
      Id = "Eris_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kita punya keterikatan khusus, itu saja... kukira kebersamaan kita di pantai sedikit lebih berarti bagimu daripada tugas membosankanmu itu. Tapi sepertinya aku keliru..."
      Speaker = "Eris"
      Event = "ErisAboutNotFighting01"
    }
    {
      Id = "Melinoe_4237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dugaanmu tepat sekali."
      Speaker = "Melinoe"
      Event = "ErisAboutNotFighting01"
    }
    {
      Id = "Eris_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah agak lama nggak melihatmu di permukaan, Sayang. Tadinya aku nggak mau ambil pusing, tapi lama-lama rasanya mulai agak {#Emph}menusuk hati{#Prev}, tahu nggak?"
      Speaker = "Eris"
      Event = "ErisAboutNotFighting02"
    }
    {
      Id = "Melinoe_4238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris, pernahkah terpikir olehmu kemungkinan bahwa saat aku menjalankan tugasku di Dunia Bawah, dirimu sama sekali tak pernah terlintas di benakku?"
      Speaker = "Melinoe"
      Event = "ErisAboutNotFighting02"
    }
    {
      Id = "Eris_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua orang juga bakal beralasan begitu. Tahu apa yang {#Emph}aku {#Prev}pikirkan? Kamu itu {#Emph}takut. {#Prev}Bukan cuma takut menghadapiku, tapi takut menghadapi perasaanmu sendiri. Ya sudah! Kabur saja lagi ke Dunia Bawah sana."
      Speaker = "Eris"
      Event = "ErisAboutNotFighting02"
    }
    {
      Id = "Melinoe_4239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenapa juga aku repot-repot meladenimu?"
      Speaker = "Melinoe"
      Event = "ErisAboutNotFighting02"
    }
    {
      Id = "Eris_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cuma bikin kita berdua makin tersiksa..."
      Speaker = "Eris"
      Event = "ErisAboutNotFighting02"
    }
    {
      Id = "Eris_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kerja bagus semalam, Sayang! {#Prev}Itu yang mau kamu dengar? Maaf ya, karena kamu nggak bakal mendengarnya dari mulut{#Emph}ku. {#Prev}Kecuali yang barusan itu."
      Speaker = "Eris"
      Event = "ErisAboutRunCleared01"
    }
    {
      Id = "Melinoe_4205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski mungkin aku akan sedikit menghargai dorongan semangat darimu setelah kau mengungkitnya barusan, Eris, aku tahu itu bukan tabiatmu. Aku cuma ingin memeriksa keadaanmu saja."
      Speaker = "Melinoe"
      Event = "ErisAboutRunCleared01"
    }
    {
      Id = "Eris_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh, terima kasih banyak! {#Prev}Tiap kali kamu meraih pencapaian penting, rasanya seperti kamu menancapkan {#Emph}pisau {#Prev}tepat di jantungku. Tapi, senang juga tahu kamu sudi mampir untuk menengok {#Emph}bangkai{#Prev}ku!"
      Speaker = "Eris"
      Event = "ErisAboutRunCleared01"
    }
    {
      Id = "Melinoe_4206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, jangan terlalu mendramatisir keadaan."
      Speaker = "Melinoe"
      Event = "ErisAboutRunCleared01"
    }
    {
      Id = "Eris_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Diam!"
      Speaker = "Eris"
      Event = "ErisAboutRunCleared01"
    }
    {
      Id = "Eris_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Orang-orang bilang kamu mengalahkan Typhon sendirian semalam. Selangkah lebih dekat untuk memulihkan segalanya seperti sedia kala, ya?"
      Speaker = "Eris"
      Event = "ErisAboutSurfaceRunCleared01"
    }
    {
      Id = "Melinoe_4207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak menaklukkan Typhon sendirian, tapi kami memang berhasil mengalahkannya, ya. Meski kurasa kau tak perlu cemas keadaan akan lekas normal kembali dalam waktu dekat..."
      Speaker = "Melinoe"
      Event = "ErisAboutSurfaceRunCleared01"
    }
    {
      Id = "Eris_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kamu berusaha menenangkanku, tapi perasaanku nggak bisa {#Emph}dibohongi! {#Prev}Mestinya aku menikmati semua kekacauan ini selagi masih {#Emph}berlangsung! {#Prev}Masa depan mungkin bakal membosankan setengah mati, tapi sekarang? Semuanya masih lumayan asyik."
      Speaker = "Eris"
      Event = "ErisAboutSurfaceRunCleared01"
    }
    {
      Id = "Melinoe_4208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keadaannya sama sekali tidak baik-baik saja."
      Speaker = "Melinoe"
      Event = "ErisAboutSurfaceRunCleared01"
    }
    {
      Id = "Melinoe_4362"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris, ada apa denganmu? Apa kau... habis menangis?"
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship01"
    }
    {
      Id = "Eris_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak! {#Prev}Dan... kalaupun iya memangnya kenapa, {#Emph}hah? {#Prev}Bukan berarti kamu peduli padaku! Kamu ataupun siapa pun di seluruh tempat terkutuk ini tak ada yang peduli."
      Speaker = "Eris"
      Event = "ErisAboutRelationship01"
    }
    {
      Id = "Melinoe_4363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahlah, hentikan. Andaikan kau berusaha sedikit saja agar tidak menjadi benalu di Persimpangan ini, mungkin kau akan punya lebih banyak kawan. Bodohnya aku yang terus percaya bahwa kau bisa berubah."
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship01"
    }
    {
      Id = "Eris_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu bukan kawanku. Nggak ada yang jadi kawanku! Nggak ada yang dekat denganku... nggak ada yang bisa kuandalkan... buat berbagi rahasia..."
      Speaker = "Eris"
      Event = "ErisAboutRelationship01"
    }
    {
      Id = "Melinoe_4364"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar... aku takkan mengkhianati kepercayaanmu seandainya kau butuh seseorang untuk berkeluh kesah. Asalkan apa yang kau ceritakan tak membahayakan orang-orang yang kupedulikan."
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship01"
    }
    {
      Id = "Eris_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cih... {#Prev}orang-orang yang kamu pedulikan. Kamu mau menyamakanku dengan {#Emph}mereka? {#Prev}Ayolah, Sayang, hubungan kita ini cuma sebatas saling {#Emph}hajar! {#Prev}Yang tentu saja sama sekali nggak keberatan bagiku! Tapi sebuah hubungan itu jauh lebih dari sekadar itu."
      Speaker = "Eris"
      Event = "ErisAboutRelationship01"
    }
    {
      Id = "Melinoe_4365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah berulang kali kubilang agar kau bicara terus terang padaku. Hubungan macam apa yang kau harapkan di antara kita saat seluruh tindakanmu hanyalah merintangiku?"
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship01"
    }
    {
      Id = "Eris_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu kadang-kadang bebal banget! Dengar, perasaanku ini nggak bisa kukendalikan, dan aku juga bukan penilai watak yang baik. Apa pun yang rusak dalam diriku, aku tahu itu nggak bakal pernah bisa diperbaiki."
      Speaker = "Eris"
      Event = "ErisAboutRelationship01"
    }
    {
      Id = "Melinoe_4366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana mungkin kau bisa seyakin itu?"
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship01"
    }
    {
      Id = "Eris_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pokoknya aku {#Emph}tahu!"
      Speaker = "Eris"
      Event = "ErisAboutRelationship01"
    }
    {
      Id = "Melinoe_4369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Eris...!"
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship02"
    }
    {
      Id = "Melinoe_4502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, soal malam itu, apa kita... maksudku, kau baik-baik saja dengan semuanya? Entahlah, aku bingung mau bilang apa..."
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship03"
    }
    {
      Id = "Eris_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang, {#Emph}berhenti. {#Prev}Kau sendiri yang bilang tak pernah menyesal dekat denganku. Mungkin kau cuma membohongi diri sendiri, tapi bodo amat. Kita sudah bersenang-senang, lalu kenapa?"
      Speaker = "Eris"
      Event = "ErisAboutRelationship03"
    }
    {
      Id = "Melinoe_4503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin aku belum terbiasa dengan apa yang kau anggap {#Emph}bersenang-senang. {#Prev}Banyak hal lain yang harus kupikirkan."
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship03"
    }
    {
      Id = "Eris_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau akan {#Emph}selalu {#Prev}begitu! Tapi kalau tak memberi ruang untuk kekacauan dalam hidupmu, semuanya bakal membosankan sekali. Sumpah deh."
      Speaker = "Eris"
      Event = "ErisAboutRelationship03"
    }
    {
      Id = "Melinoe_4504"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekacauan? Tadi kita bicara soal bersenang-senang."
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship03"
    }
    {
      Id = "Eris_0288"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama saja."
      Speaker = "Eris"
      Event = "ErisAboutRelationship03"
    }
    {
      Id = "Eris_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang, berhenti. Meskipun aku suka mempermainkan pikiranmu, aku paling muak melihatmu bersikap menyedihkan begini. Kenapa, takut melukai perasaan rapuhku, atau kau cuma ragu-ragu?"
      Speaker = "Eris"
      Event = "ErisAboutRelationship03_B"
    }
    {
      Id = "Melinoe_4505"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih condong ke yang pertama. Jika aku entah bagaimana berhasil meraih sedikit kepercayaanmu, aku tak ingin merusaknya, terlepas dari segala hal yang terjadi."
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship03_B"
    }
    {
      Id = "Eris_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu kau cuma perlu tutup mulut soal itu! Ini baru jadi masalah besar kalau kau sendiri yang membesar-besarkannya, benar kan?"
      Speaker = "Eris"
      Event = "ErisAboutRelationship03_B"
    }
    {
      Id = "Melinoe_4506"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar juga."
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship03_B"
    }
    {
      Id = "Eris_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar jadi pusat perhatian di sini, sayang. Kulihat sendiri bagaimana Nemmie dan Moros menatapmu! Menurutmu bagaimana, mungkin sudah saatnya kita memberi tahu mereka tentang {#Emph}kita?"
      Speaker = "Eris"
      Event = "ErisAboutRelationship04"
    }
    {
      Id = "Melinoe_4507"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hentikan, Eris. Tanpa komitmen serius, bukan? Kau kebetulan memang berasal dari keluarga yang rupawan, dan waktu kita masih sangat panjang. Terutama begitu semua urusan ini selesai."
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship04"
    }
    {
      Id = "Eris_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kurasa begitu! Itu pun kalau hal ini {#Emph}benar-benar {#Prev}bisa selesai suatu saat nanti, atau kalau tidak ada hal yang lebih buruk muncul! Lagipula aku cuma mempermainkan pikiranmu. Aku suka melihatmu begitu polos...!"
      Speaker = "Eris"
      Event = "ErisAboutRelationship04"
    }
    {
      Id = "Melinoe_4510"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa maksudmu?"
      Speaker = "Melinoe"
      Event = "ErisAboutRelationship04"
    }
    {
      Id = "Eris_0293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, barusan itu {#Emph}contohnya!"
      Speaker = "Eris"
      Event = "ErisAboutRelationship04"
    }
    {
      Id = "Eris_0414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang, aku tak menyangka kau membawakan sesuatu untuk tempat rahasia kita! Manis {#Emph}banget! {#Prev}Harusnya kau tak perlu repot-repot."
      Speaker = "Eris"
      Event = "ErisAboutRug01"
    }
    {
      Id = "Melinoe_4937"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar, harusnya aku tak repot-repot. Kau pasti akan mencari cara untuk mengungkit ini demi menyudutkanku nanti, kan?"
      Speaker = "Melinoe"
      Event = "ErisAboutRug01"
    }
    {
      Id = "Eris_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nanti juga kau tahu sendiri! Dan tenang saja, kalau ada yang tanya, kubilang saja ini rahasia kecil kita."
      Speaker = "Eris"
      Event = "ErisAboutRug01"
    }
    {
      Id = "Melinoe_4938"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harus sekali ya?"
      Speaker = "Melinoe"
      Event = "ErisAboutRug01"
    }
    {
      Id = "Eris_0416"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harus dong."
      Speaker = "Eris"
      Event = "ErisAboutRug01"
    }
    {
      Id = "Eris_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar memasang rambu peringatan tentangku, sayang? Rasanya agak kekanak-kanakan, bahkan untuk standarmu. Bagaimana kalau kulakukan hal serupa kepadamu, bagaimana rasanya menurut{#Emph}mu?"
      Speaker = "Eris"
      Event = "ErisAboutSign01"
    }
    {
      Id = "Melinoe_4899"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku... mungkin takkan suka, Eris. Maafkan aku. Kupikir rambu-rambu itu cuma membantuku tahu kapan bisa mengunjungimu di sini... Aku tak menyangka itu dianggap kejam."
      Speaker = "Melinoe"
      Event = "ErisAboutSign01"
    }
    {
      Id = "Eris_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu {#Emph}memang {#Prev}kejam! Padahal aku sempat kagum! Tapi sekarang kau malah memohon-mohon minta maaf, kurasa aku terlalu melebih-lebihkanmu. Kau takkan mencopot{#Emph}nya{#Prev}, kan?"
      Speaker = "Eris"
      Event = "ErisAboutSign01"
    }
    {
      Id = "Melinoe_4900"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kedengarannya kau tak ingin aku mencopotnya, jadi... mungkin akan kucopot saja."
      Speaker = "Melinoe"
      Event = "ErisAboutSign01"
    }
    {
      Id = "Eris_0356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Awas saja kalau berani!"
      Speaker = "Eris"
      Event = "ErisAboutSign01"
    }
    {
      Id = "Eris_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar menyingkirkan rambu-rambu bergambar wajahku! Ternyata kau punya sisi jahat juga! {#Emph}Sayang! Aku bangga sekali padamu!"
      Speaker = "Eris"
      Event = "ErisAboutSign02"
    }
    {
      Id = "Melinoe_4901"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Apa? {#Prev}Sebenarnya kau ingin rambu peringatanmu dipasang atau tidak? Mana pun pilihanmu, aku akan melakukan hal yang sebaliknya, karena itulah yang biasa kau lakukan padaku!"
      Speaker = "Melinoe"
      Event = "ErisAboutSign02"
    }
    {
      Id = "Eris_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau {#Emph}berapi-api {#Prev}sekali sekarang! Apa aku mau rambu-rambu itu {#Emph}dipasang {#Prev}atau {#Emph}dicopot? {#Prev}Kau takkan pernah tahu, karena aku bersumpah takkan pernah mengungkitnya lagi."
      Speaker = "Eris"
      Event = "ErisAboutSign02"
    }
    {
      Id = "Melinoe_4902"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Bagaimana bisa kau sejahat ini?"
      Speaker = "Melinoe"
      Event = "ErisAboutSign02"
    }
    {
      Id = "Eris_0359"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bakat alami!"
      Speaker = "Eris"
      Event = "ErisAboutSign02"
    }
    {
      Id = "Eris_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong-omong, ada apa sebenarnya antara kau dan Chronos? Kau terus {#Emph}mengalahkannya {#Prev}tapi dia terus saja {#Emph}bangkit! {#Prev}Aku suka melihat betapa sia-sianya hal itu, tapi... pasti ada sesuatu di balik semua ini, kan?"
      Speaker = "Eris"
      Event = "ErisAboutChronos01"
    }
    {
      Id = "Melinoe_4357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Eris. Aku takkan membocorkan rincian penting tugasku, terutama kepada orang yang punya banyak kesempatan untuk ikut serta sejak awal tapi malah menolak. Urus saja urusanmu sendiri."
      Speaker = "Melinoe"
      Event = "ErisAboutChronos01"
    }
    {
      Id = "Eris_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau beri aku sedikit bocoran saja. Apa rencanamu memanfaatkan kekuatannya sendiri untuk melawannya? Membebaskan anggota keluarga kita satu per satu? Semacam itu?"
      Speaker = "Eris"
      Event = "ErisAboutChronos01"
    }
    {
      Id = "Melinoe_4358"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Takkan kuberi tahu!"
      Speaker = "Melinoe"
      Event = "ErisAboutChronos01"
    }
    {
      Id = "Eris_0249"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Jahat banget!"
      Speaker = "Eris"
      Event = "ErisAboutChronos01"
    }
    {
      Id = "Eris_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kayaknya semalam ada keributan gede di Olimpus! Dan aku bahkan nggak ada di sana, gara-gara kamu. Gimana jadinya?"
      Speaker = "Eris"
      Event = "ErisAboutTyphon01"
    }
    {
      Id = "Melinoe_4359"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus banget, malahan! Nyaris dimakan sama Bapak Segala Monster waktu mencoba mengalihkan perhatiannya biar nggak menghancurkan segalanya! Kamu harusnya ada di sana."
      Speaker = "Melinoe"
      Event = "ErisAboutTyphon01"
    }
    {
      Id = "Eris_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu tahu, Sayang, kalau ada orang yang kelewatan momen seru, harusnya kamu {#Emph}kecil-kecilin{#Prev}, kayak, {#Emph}ah nggak seru-seru amat kok. {#Prev}Biar mereka nggak merasa {#Emph}bersalah {#Prev}karena nggak bisa {#Emph}ikutan!"
      Speaker = "Eris"
      Event = "ErisAboutTyphon01"
    }
    {
      Id = "Melinoe_4360"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu {#Emph}memang harusnya {#Prev}merasa bersalah."
      Speaker = "Melinoe"
      Event = "ErisAboutTyphon01"
    }
    {
      Id = "Eris_0252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah sekarang, aku {#Emph}nggak {#Prev}merasa begitu tuh!"
      Speaker = "Eris"
      Event = "ErisAboutTyphon01"
    }
    {
      Id = "Melinoe_2659"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu begitu meremehkan apa yang sedang kami perjuangkan. Kamu bersikap seolah-olah tak ada yang hilang. Apa kamu tak ingin bertemu Nyx lagi? Atau Thanatos?"
      Speaker = "Melinoe"
      Event = "ErisAboutNyx01"
    }
    {
      Id = "Eris_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa aku mau ketemu ibuku lagi, atau kakak laki-laki entah-nomor-berapa? {#Emph}Cih, hahaha{#Prev}, nggak sudi. Mereka jauh lebih angkuh dari kamu. {#Emph}Nggak bermaksud menyinggung, lho."
      Speaker = "Eris"
      Event = "ErisAboutNyx01"
    }
    {
      Id = "Melinoe_2660"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bagaimana bisa kamu bicara seperti itu tentang keluargamu sendiri? Apa mereka memperlakukanmu lebih kejam dari ini?"
      Speaker = "Melinoe"
      Event = "ErisAboutNyx01"
    }
    {
      Id = "Eris_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyx selalu mau semuanya berjalan sesuai kehendak-{#Emph}nya{#Prev}. Kenapa dia, atau siapa pun, berhak punya kuasa sebesar itu atas {#Emph}diriku? {#Prev}Cuma karena dia yang {#Emph}melahirkan{#Prev}ku? Dia nggak minta izinku {#Emph}dulu{#Prev}. Dan aku juga nggak butuh izin darinya."
      Speaker = "Eris"
      Event = "ErisAboutNyx01"
    }
    {
      Id = "Melinoe_2661"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku turut menyesal..."
      Speaker = "Melinoe"
      Event = "ErisAboutNyx01"
    }
    {
      Id = "Eris_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi gimana pendapatmu soal Nyx? Kamu ketemu dia, 'kan? Sekarang kamu tahu dari mana Nemmie mewarisi penampilannya, dan dari mana {#Emph}aku {#Prev}mewarisi sifatku."
      Speaker = "Eris"
      Event = "ErisAboutNyx02"
    }
    {
      Id = "Melinoe_4924"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Aku hampir tak mengenalnya, tapi tetap saja, Nyx sama sekali tak terlihat sepertimu. Beliau sangat anggun."
      Speaker = "Melinoe"
      Event = "ErisAboutNyx02"
    }
    {
      Id = "Eris_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aww{#Prev}, makasih lho, Sayang. Tapi di balik sikap dinginnya itu dia punya sisi liar, sumpah deh. Kalau {#Emph}nggak{#Prev}, kenapa coba dia bisa punya anak sebanyak itu sendirian? Dia sudah {#Emph}gila!"
      Speaker = "Eris"
      Event = "ErisAboutNyx02"
    }
    {
      Id = "Melinoe_4925"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atau mungkin cuma kamu yang gila."
      Speaker = "Melinoe"
      Event = "ErisAboutNyx02"
    }
    {
      Id = "Melinoe_2664"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu bahkan sudah tidak bicara lagi dengan Kepala Sekolah, kan? Hubungannya dengan Nemesis jadi kelihatan jauh lebih harmonis kalau dibandingkan denganmu."
      Speaker = "Melinoe"
      Event = "ErisAboutHecate01"
    }
    {
      Id = "Eris_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia bicara {#Emph}banyak {#Prev}hal buruk soal aku, Sayang. Dan nggak cuma di depanku doang. Semuanya gara-gara aku nggak {#Emph}sesuai standarnya {#Prev}sebagai {#Emph}murid teladan! {#Prev}Aku harus move on. Intinya, aku nggak butuh orang kayak gitu di hidupku."
      Speaker = "Eris"
      Event = "ErisAboutHecate01"
    }
    {
      Id = "Melinoe_2665"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris, kamu berulang kali mencuri darinya, terus-terusan memakai kuali untuk bikin peledak, menjadikan tendaku sasaran latihan menembak, mencoreng-coreng Hypnos yang sedang tidur, menabur garam di kebun, dan tiada henti mengusik Arwah soal cara mati mereka..."
      Speaker = "Melinoe"
      Event = "ErisAboutHecate01"
    }
    {
      Id = "Eris_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya ampun, Nona Sempurna, aku kan cuma bikin beberapa kekhilafan kecil! Bukan berarti Hecate berhak menceramahiku secara {#Emph}tertutup{#Prev}, di mana aku bahkan nggak bisa pamer atas hal-hal yang sudah kubuat. Kamu nggak tahu apa-apa!"
      Speaker = "Eris"
      Event = "ErisAboutHecate01"
    }
    {
      Id = "Melinoe_2666"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beliau memasang jimat pembungkam padamu, ya?"
      Speaker = "Melinoe"
      Event = "ErisAboutHecate01"
    }
    {
      Id = "Eris_0040"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kayaknya iya deh..."
      Speaker = "Eris"
      Event = "ErisAboutHecate01"
    }
    {
      Id = "Eris_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini kamu {#Emph}benar-benar {#Prev}bikin Nemmie naik darah! Kulihat dia kabur sambil mencak-mencak, {#Emph}kelentang-kelenting{#Prev}, nggak lama setelah ngobrol sama kamu. Kamu ngomong apa sampai dia begitu sewot? Bakal kumasukkan ke dalam senjataku, nih."
      Speaker = "Eris"
      Event = "ErisAboutNemesis01"
    }
    {
      Id = "Melinoe_2677"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entahlah. Kami sesekali membicarakan tugasku, dan dia ingin membantu semampunya. Kurasa dia hanya sangat bertekad agar rencana kita berhasil."
      Speaker = "Melinoe"
      Event = "ErisAboutNemesis01"
    }
    {
      Id = "Eris_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, aku paham! Baiklah. Penyihir nggak pernah membocorkan rahasianya, gitu kan? Pokoknya, hati-hati saja sama Mbak Nem, itu pesanku. Dia nggak bakal membiarkan {#Emph}siapa pun {#Prev}berada terlalu jauh di depannya!"
      Speaker = "Eris"
      Event = "ErisAboutNemesis01"
    }
    {
      Id = "Melinoe_2678"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah pasti."
      Speaker = "Melinoe"
      Event = "ErisAboutNemesis01"
    }
    {
      Id = "Eris_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat siapa di sana, Charon rupanya! Aku dengar suara napas beratnya, dan tebakanku tepat. Kamu bikin dia tunduk patuh seperti binatang-binatang lain di sekitar sini, {#Emph}ya."
      Speaker = "Eris"
      Event = "ErisAboutCharon01"
    }
    {
      Id = "Melinoe_4903"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sikapmu yang sama sekali tak menghormati salah satu pelayan paling setia di alam ini—sekaligus {#Emph}kakak kandungmu sendiri{#Prev}—sudah kucatat baik-baik, Eris. Namun asal kamu tahu, Charon ada di sini atas kehendaknya sendiri."
      Speaker = "Melinoe"
      Event = "ErisAboutCharon01"
    }
    {
      Id = "Eris_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, kayak bagaimana {#Emph}kamu {#Prev}juga ada di sini atas kehendakmu sendiri? Diculik sejak bayi, nggak boleh melihat dunia luar sedikit pun sampai kamu selesai dilatih jadi pembunuh. {#Emph}Pilihanmu banget!"
      Speaker = "Eris"
      Event = "ErisAboutCharon01"
    }
    {
      Id = "Melinoe_4904"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada yang memaksaku melakukan ini."
      Speaker = "Melinoe"
      Event = "ErisAboutCharon01"
    }
    {
      Id = "Eris_0362"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Masa, sih."
      Speaker = "Eris"
      Event = "ErisAboutCharon01"
    }
    {
      Id = "Eris_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, bisa tolong minta teman rimba-mu di sebelah sana buat agak {#Emph}tenang? {#Prev}Saking berisiknya sampai aku nggak bisa {#Emph}mikir!"
      Speaker = "Eris"
      Event = "ErisAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_4909"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin itu karena memang tidak pernah ada pikiran berbobot yang terlintas di kepalamu. Kamu benar-benar berharap aku menyuruh Artemis berhenti bernyanyi demi dirimu? Lakukan sendiri!"
      Speaker = "Melinoe"
      Event = "ErisAboutArtemisSinging01"
    }
    {
      Id = "Eris_0370"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus, mungkin bakal kulakukan! Atau mungkin aku bakal terus merajuk dan mengeluh soal ini! Belum kuputuskan."
      Speaker = "Eris"
      Event = "ErisAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_4910"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pikirkanlah sesukamu."
      Speaker = "Melinoe"
      Event = "ErisAboutArtemisSinging01"
    }
    {
      Id = "Eris_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau aku harus mendengar obrolanmu dengan Moros sekali lagi, aku bakal muntah. Tapi tenang, pasti bakal kamu bersihkan juga, 'kan?"
      Speaker = "Eris"
      Event = "ErisAboutMoros01"
    }
    {
      Id = "Melinoe_2676"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak boleh menguping obrolan pribadiku. Terlebih kalau hal itu membuatmu mual! Lebih baik kau bicara langsung dengan saudaramu sendiri sesekali."
      Speaker = "Melinoe"
      Event = "ErisAboutMoros01"
    }
    {
      Id = "Eris_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku lebih penasaran seberapa lama dia bakal terus pura-pura aku nggak ada di sini."
      Speaker = "Eris"
      Event = "ErisAboutMoros01"
    }
    {
      Id = "Melinoe_4233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah lama kembali tapi masih terus mengasingkan diri. Saudaramu lebih berusaha untuk membaur, meski dia juga kesulitan... kalian mungkin punya lebih banyak kesamaan daripada yang kau kira."
      Speaker = "Melinoe"
      Event = "ErisAboutMoros02"
    }
    {
      Id = "Eris_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, ya? Mungkin aku bakal ke sana dan bilang kalau kau ngomong begitu! Apa, kau pikir cuma karena sebagian besar dunia membenci {#Emph}dia{#Prev} sama seperti membenciku, berarti kami {#Emph}mirip?"
      Speaker = "Eris"
      Event = "ErisAboutMoros02"
    }
    {
      Id = "Melinoe_4234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku tidak bermaksud mengatakannya seperti itu... meski kurasa kalian berdua memang kerap disalahpahami dengan cara masing-masing."
      Speaker = "Melinoe"
      Event = "ErisAboutMoros02"
    }
    {
      Id = "Eris_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang nggak dipahami? Aku ini {#Emph}Perselisihan{#Prev}; dia {#Emph}Kematian{#Prev}. Itu konsep sederhana, Sayang! Yah, meski harus kuakui, sebagian besar dunia ini {#Emph}memang{#Prev} kelewat bodoh..."
      Speaker = "Eris"
      Event = "ErisAboutMoros02"
    }
    {
      Id = "Melinoe_4235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak seharusnya berkata seperti itu."
      Speaker = "Melinoe"
      Event = "ErisAboutMoros02"
    }
    {
      Id = "Eris_0195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maksudmu, berkata jujur?"
      Speaker = "Eris"
      Event = "ErisAboutMoros02"
    }
    {
      Id = "Eris_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Yaaah{#Prev}, Hypnos {#Emph}hilang? {#Prev}Padahal aku punya rencana besar buat dia, pakai sekarung kucing dan dua botol Nektar yang kau kasih."
      Speaker = "Eris"
      Event = "ErisAboutHypnosWakeUp01"
    }
    {
      Id = "Melinoe_4939"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berarti aku telah menyelamatkannya dari nasib buruk. Mungkin suatu saat nanti dia akan berterima kasih dengan layak padaku, karena tadi dia pergi terburu-buru."
      Speaker = "Melinoe"
      Event = "ErisAboutHypnosWakeUp01"
    }
    {
      Id = "Eris_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana kalau kau biarkan aku membunuhmu lain kali saat kita di Celah sana? Kemungkinan besar kau bakal hanyut ke Sungai Styx, dan berakhir tepat di depannya lagi. Dia penyambut tamu di Kediaman Hades, kan?"
      Speaker = "Eris"
      Event = "ErisAboutHypnosWakeUp01"
    }
    {
      Id = "Melinoe_4940"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia bukan {#Emph}penyambut tamu. {#Prev}Dia memegang jabatan kehormatan yang tinggi."
      Speaker = "Melinoe"
      Event = "ErisAboutHypnosWakeUp01"
    }
    {
      Id = "Eris_0419"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Selamat datang di Kediaman Hades! {#Prev}Dia itu penyambut tamu, Sayang."
      Speaker = "Eris"
      Event = "ErisAboutHypnosWakeUp01"
    }
    {
      Id = "Eris_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Herakles itu memang {#Emph}sesuatu{#Prev}, ya? Sayang sekali isi kepalanya kopong. Kulit singa yang suka dia pamerkan ke sana kemari itu kayaknya lebih pintar daripada {#Emph}dia."
      Speaker = "Eris"
      Event = "ErisAboutHeracles01"
    }
    {
      Id = "Melinoe_2679"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa kau bicara begitu? Selain karena kebiasaanmu yang memang gemar menjelek-jelekkan orang lain. Bagiku Herakles tidak sebodoh itu; mungkin hanya agak kecewa pada dunia."
      Speaker = "Melinoe"
      Event = "ErisAboutHeracles01"
    }
    {
      Id = "Eris_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gada besinya yang mikir buat dia, dan kebanyakan juga yang ngomong buat dia. {#Emph}Ehh{#Prev}, kalian berdua sama-sama gampang dibodohi! Mungkin itu sebabnya kau menganggap dia hebat. Atau, mungkin dia memang tipemu?"
      Speaker = "Eris"
      Event = "ErisAboutHeracles01"
    }
    {
      Id = "Melinoe_2680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Mencibir> {#Prev}Bukan...!"
      Speaker = "Melinoe"
      Event = "ErisAboutHeracles01"
    }
    {
      Id = "Eris_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Uff{#Prev}, aku masih geregetan gara-gara semalam. Kapan sih kau jadi sekuat ini? Aku nggak berkutik lagi di depanmu. Hei, mau ikut ke suatu tempat denganku, melampiaskan kekesalan?"
      Speaker = "Eris"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Melinoe_4491"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak yakin ingin ikut. Di kedai setidaknya ada banyak saksi kalau-kalau kau berniat macam-macam."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Eris_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo dong, takut apa sih? Bukan berarti kau nggak bisa mengalahkanku dalam {#Emph}pertarungan! {#Prev}Lagipula, tempatnya nggak jauh kok. Sumpah."
      Speaker = "Eris"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Melinoe_4493"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tunggu, cuma di sini? Kau tak bercanda saat bilang tempatnya tidak jauh. Apa istimewanya tempat ini?"
      Speaker = "Melinoe"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Eris_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku suka di sini, itu saja. Nggak ada kodok berisik, nggak ada Arwah berkeliaran... nggak ada yang bakal mergoki kalau kita mau main-main sebentar..."
      Speaker = "Eris"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Melinoe_4494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu main-main sebentar itu... {#Emph}oh{#Prev}, astaga. Eris, dengar, aku belum siap untuk komitmen serius apa pun di sini."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Eris_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang, aku seumur {#Emph}hidup{#Prev} nggak pernah bikin komitmen serius. Aku cuma ingin bersenang-senang sebentar sesekali setelah malam yang berat mencoba memberondongmu sampai hancur! Gimana?"
      Speaker = "Eris"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Melinoe_4496"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tolong jangan."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Eris_0281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Yaaah..."
      Speaker = "Eris"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Melinoe_4501"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fiuh..."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Melinoe_4495"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat menghargai ajakanmu, karena aku tahu tidak mudah untuk mendekati siapa pun di sini. Tapi ini bukan hal yang kucari sekarang. Hubungan apa pun yang ada di antara kita saat ini... aku menyukainya apa adanya."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Eris_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu juga yang {#Emph}kurasakan! {#Prev}Dan aku paham, asalkan kau melakukan apa yang {#Emph}kau{#Prev} inginkan, bukan apa yang orang lain mau. Tapi, boleh nggak kalau aku tetap bilang ke semua orang kalau kita tadi main-main di sini?"
      Speaker = "Eris"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Melinoe_4497"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Meskipun aku mungkin seharusnya menyesali banyak hal tentang hubungan kita, sejujurnya, aku tidak pernah menyesalinya. Lagipula... aku suka belajar dari kesalahanku."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Melinoe_4498"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah! Kurasa aku belajar banyak malam ini, secara keseluruhan. Tapi sepertinya aku harus segera kembali. Kalau ada yang bertanya, kita tadi ada di dermaga pemancingan."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Eris_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita {#Emph}memang{#Prev} lagi di dermaga pemancingan, Sayang. Dan peduli amat kalau ada yang nanya? Siapa yang {#Emph}peduli? {#Prev}Kita cuma lagi bersenang-senang! Nggak dilarang di sini, kan?"
      Speaker = "Eris"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Melinoe_4499"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak dilarang, memang. Jadi kurasa sekarang kau akan kembali berusaha memberondongku sampai hancur malam demi malam seolah tak terjadi apa-apa?"
      Speaker = "Melinoe"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Eris_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali! Apa, kau beneran ngira aku bakal jatuh cinta sebegitunya sampai membuang semua hal yang menjadikanku {#Emph}diriku? {#Prev}Nggak mungkin lah. Nggak ada komitmen serius, ingat?"
      Speaker = "Eris"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Melinoe_4500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingat. Dan aku tak bermaksud berpikir seperti manusia fana, hanya saja... terkadang aku tak memahamimu, Eris. Bisa begitu... santai tanpa beban."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Eris_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kubocorkan sebuah rahasia kecil ya, Sayang: Kita menyukai apa yang tidak kita pahami atau tidak bisa kita miliki. Bagaimanapun, itu selalu jadi alasan{#Emph}ku! {#Prev}Sampai jumpa lagi!"
      Speaker = "Eris"
      Event = "ErisBecomingCloser01"
    }
    {
      Id = "Eris_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuperingatkan ya, sebaiknya hentikan semua ini, Biang Onar. Mengacaukan urusan {#Emph}Chronos{#Prev}, mengacaukan urusan {#Emph}Typhon{#Prev}, mengacaukan segalanya{#Emph}! {#Prev}Itu kan harusnya {#Emph}tugasku!"
      Speaker = "Eris"
      Event = "ErisAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_4911"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau jelas-jelas sudah menyelesaikan tugasmu. Dan sekarang tugaskulah untuk membereskannya kembali. Kurang lebih seperti caraku sering membersihkan sampah yang kau tinggalkan di sini."
      Speaker = "Melinoe"
      Event = "ErisAboutUltimateProgress01"
    }
    {
      Id = "Eris_0380"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kau takkan bisa. Dan andai kau {#Emph}bisa {#Prev}pun, kau bakal mengenang masa-masa ini dan berharap semuanya kembali se-{#Emph}menarik {#Prev}sekarang!"
      Speaker = "Eris"
      Event = "ErisAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_4912"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak keberatan kalau sekali-kali suasananya agak membosankan."
      Speaker = "Melinoe"
      Event = "ErisAboutUltimateProgress01"
    }
    {
      Id = "Eris_0381"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi {#Emph}aku {#Prev}keberatan!"
      Speaker = "Eris"
      Event = "ErisAboutUltimateProgress01"
    }
    {
      Id = "Eris_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan itu tidak benar, Biang Onar! Kabar soal Chronos yang kudengar itu? Dia benar-benar menyerah? Dan dia membebaskan Nyx beserta yang lainnya? A-apa yang sudah kau {#Emph}perbuat {#Prev}padanya?!"
      Speaker = "Eris"
      Event = "ErisPostTrueEnding01"
    }
    {
      Id = "Melinoe_4913"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bekerja sama dengan kakakku di masa lampau, kami membanjiri pikiran kakek kami dengan luapan ingatan baru tentang keluarga yang baru disadarinya selalu ada, hingga memicu perubahan mendalam yang tiba-tiba padanya. Memangnya ada apa, kenapa kau risau?"
      Speaker = "Melinoe"
      Event = "ErisPostTrueEnding01"
    }
    {
      Id = "Eris_0383"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Risauku {#Prev}itu karena kau sudah merusak segalanya! Jadi {#Emph}sekarang {#Prev}kita semua bakal hidup damai sentosa, reuni bahagia, saling minta maaf, saling berjanji takkan membiarkan hal semacam ini terjadi {#Emph}lagi?! Ungh!"
      Speaker = "Eris"
      Event = "ErisPostTrueEnding01"
    }
    {
      Id = "Melinoe_4914"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pernah bertemu keluarga kita tidak sih, Eris? Urusannya takkan pernah sesederhana itu."
      Speaker = "Melinoe"
      Event = "ErisPostTrueEnding01"
    }
    {
      Id = "Eris_0384"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Baguslah {#Prev}kalau begitu, kalau tidak, aku {#Emph}takkan pernah {#Prev}memaafkanmu!"
      Speaker = "Eris"
      Event = "ErisPostTrueEnding01"
    }
    {
      Id = "Eris_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagipula, apa sih yang masih kau {#Emph}lakukan {#Prev}di tempat kumuh ini? Kalau ayah dan ibumu sudah berkuasa lagi, kau harusnya hidup mewah bersama mereka di bawah sana, di Tartarus. Apa mereka se-{#Emph}buruk {#Prev}itu?"
      Speaker = "Eris"
      Event = "ErisPostTrueEnding02"
    }
    {
      Id = "Melinoe_4915"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tidak! {#Prev}Aku mungkin lahir di Tartarus, tapi rumahku ada di sini, begitu pula tanggung jawabku. Dan Persimpangan Jalan ini {#Emph}bukan {#Prev}tempat kumuh, atau setidaknya takkan jadi kumuh kalau kau bisa menjaga sampahmu sendiri."
      Speaker = "Melinoe"
      Event = "ErisPostTrueEnding02"
    }
    {
      Id = "Eris_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Terserah! {#Prev}Tapi setidaknya ada satu hal baik dari semua ini. Kukira aku benar-benar bakal kehilanganmu, Sayang."
      Speaker = "Eris"
      Event = "ErisPostTrueEnding02"
    }
    {
      Id = "Melinoe_4916"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menyentuh sekali."
      Speaker = "Melinoe"
      Event = "ErisPostTrueEnding02"
    }
    {
      Id = "Eris_0387"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku serius, tahu!"
      Speaker = "Eris"
      Event = "ErisPostTrueEnding02"
    }
    {
      Id = "Eris_0388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa sih kau harus terus melakukan semua ini? Kukira kau sudah {#Emph}menang! {#Prev}Tapi, kau masih terus bertarung! {#Emph}Kita {#Prev}masih terus bertarung! Aku sampai terus berkata pada diri sendiri kalau ini {#Emph}terlalu {#Prev}indah untuk jadi kenyataan...!"
      Speaker = "Eris"
      Event = "ErisPostTrueEnding03"
    }
    {
      Id = "Melinoe_4917"
      InheritFrom = "BaseNarrative"
      DisplayName = "Singkatnya, masih ada beberapa urusan tertunda yang harus diselesaikan, yang membutuhkan kelanjutan dari proses yang membawa kita ke titik ini. Jadi selamat, ya! Suasananya bakal tetap kacau balau untuk beberapa waktu ke depan."
      Speaker = "Melinoe"
      Event = "ErisPostTrueEnding03"
    }
    {
      Id = "Eris_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti cuma {#Emph}bercanda! {#Prev}Kau cuma sengaja membuatku {#Emph}berharap! {#Prev}Yah, tenang saja. Apa pun rencanamu, cepat atau lambat aku pasti bakal ikut campur."
      Speaker = "Eris"
      Event = "ErisPostTrueEnding03"
    }
    {
      Id = "Melinoe_4918"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sudah belajar untuk selalu mengantisipasi hal itu."
      Speaker = "Melinoe"
      Event = "ErisPostTrueEnding03"
    }
    {
      Id = "Melinoe_4921"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, sepadankah semua itu, Eris? Menghalangiku, mempersulit tugasku di setiap langkah? Kau sama sekali tak mencegah hasil akhirnya... kau sebenarnya bisa saja membantuku seperti yang lain."
      Speaker = "Melinoe"
      Event = "ErisPostTrueEnding04"
    }
    {
      Id = "Eris_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan untuk apa juga aku mau melakukan itu? Walau sejujurnya aku {#Emph}agak {#Prev}kecewa pada diriku sendiri sih. Kalau dipikir-pikir lagi, harusnya aku bisa menciptakan {#Emph}jauh {#Prev}lebih banyak kekacauan di sepanjang jalan..."
      Speaker = "Eris"
      Event = "ErisPostTrueEnding04"
    }
    {
      Id = "Melinoe_4922"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat dirimu, merenungi bagaimana cara meningkatkan kemampuanmu! Meski tujuannya cuma untuk memperburuk keadaan bagi orang lain."
      Speaker = "Melinoe"
      Event = "ErisPostTrueEnding04"
    }
    {
      Id = "Eris_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sendiri yang mengajariku soal itu, tahu, Biang Onar? Bukannya aku benar-benar belajar sih, tapi... kalau aku tidak tetap sigap, mungkin suatu saat nanti, segalanya bakal berakhir {#Emph}baik-baik saja..."
      Speaker = "Eris"
      Event = "ErisPostTrueEnding04"
    }
    {
      Id = "Melinoe_4923"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita tak boleh membiarkan hal {#Emph}itu {#Prev}terjadi."
      Speaker = "Melinoe"
      Event = "ErisPostTrueEnding04"
    }
    {
      Id = "Eris_0394"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tentu tidak."
      Speaker = "Eris"
      Event = "ErisPostTrueEnding04"
    }
    {
      Id = "Melinoe_4919"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, waktu aku baru memulai semua ini, aku sangat kesal saat kau menimpakan kutukan terkutuk itu padaku. Aku mungkin bisa menyelesaikan urusan dengan Chronos jauh lebih cepat!"
      Speaker = "Melinoe"
      Event = "ErisAboutCurse01"
    }
    {
      Id = "Eris_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kenapa juga aku menginginkan hal {#Emph}itu? {#Prev}Omong-omong, makasih sudah mengingatkan, aku hampir lupa kalau aku bisa mengutukmu tiap malam. Itu mungkin bakal bekerja jauh lebih ampuh daripada Rail!"
      Speaker = "Eris"
      Event = "ErisAboutCurse01"
    }
    {
      Id = "Melinoe_4920"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau sampai berani mencobanya, akan kucabuti setiap helai bulu di sayapmu, satu demi satu."
      Speaker = "Melinoe"
      Event = "ErisAboutCurse01"
    }
    {
      Id = "Eris_0391"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Iya, iya, santai dong!"
      Speaker = "Eris"
      Event = "ErisAboutCurse01"
    }
    {
      Id = "Eris_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini ada yang aneh denganmu, Sayang! Tapi karena kau takkan mau cerita, aku tebak-tebak saja ya. Apa ini soal Hecate? Pasti benar, soalnya akhir-akhir ini sikap{#Emph}nya {#Prev}juga agak aneh."
      Speaker = "Eris"
      Event = "ErisPostEpilogue01"
    }
    {
      Id = "Melinoe_4926"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan apa-apa, hanya saja... aku belum sempat bicara panjang lebar dengan Kepala Sekolah sejak semua peristiwa ini berakhir. Ada... banyak hal yang perlu kami selesaikan. Dan sampai sekarang pun masih belum."
      Speaker = "Melinoe"
      Event = "ErisPostEpilogue01"
    }
    {
      Id = "Eris_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, kasihan {#Emph}sekali! {#Prev}Bahkan setelah semua masalah mengerikan yang kalian hadapi sebagian besar sudah beres, ternyata kalian berdua masih punya segudang masalah lain. Rasanya masalah kalian tak pernah mau {#Emph}hilang!"
      Speaker = "Eris"
      Event = "ErisPostEpilogue01"
    }
    {
      Id = "Melinoe_4927"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya kau tidak punya masalah apa pun, Eris."
      Speaker = "Melinoe"
      Event = "ErisPostEpilogue01"
    }
    {
      Id = "Eris_0399"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak ada satu pun."
      Speaker = "Eris"
      Event = "ErisPostEpilogue01"
    }
    {
      Id = "Eris_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Moros kelihatan girang banget belakangan ini, setidaknya untuk ukuran {#Emph}dia{#Prev}. Jadi kamu akhirnya berhasil nemuin saudari-saudarinya, ya? {#Emph}Kamu {#Prev}kudu merasa {#Emph}beruntung! {#Prev}Mereka kan saudari-saudari{#Emph}ku {#Prev}juga, padahal kami bahkan belum pernah {#Emph}ketemu{#Prev}."
      Speaker = "Eris"
      Event = "ErisPostEpilogue02"
    }
    {
      Id = "Melinoe_4928"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin aku melihat sedikit kepribadian{#Emph}mu {#Prev}pada diri mereka, Eris. Menilik karya-karya masa lalu mereka, tampaknya mereka sangat menghargai spontanitas... berimprovisasi seiring berjalannya waktu."
      Speaker = "Melinoe"
      Event = "ErisPostEpilogue02"
    }
    {
      Id = "Eris_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aneh banget{#Prev}, kan? Maksudku, kenapa harus begitu kalau kamu bisa merencanakan setiap {#Emph}detail {#Prev}kecilnya dari awal secara teliti?"
      Speaker = "Eris"
      Event = "ErisPostEpilogue02"
    }
    {
      Id = "Melinoe_4929"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka itu penenun... mereka {#Emph}memang {#Prev}harus berencana. Itu dan spontanitas bukan berarti bertolak belakang. Ngomong-ngomong soal itu, kamu pasti sudah dengar kalau mereka berencana libur panjang."
      Speaker = "Melinoe"
      Event = "ErisPostEpilogue02"
    }
    {
      Id = "Eris_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berarti {#Emph}kita {#Prev}bisa berimprovisasi sesuka hati, buat variasi sesekali!"
      Speaker = "Eris"
      Event = "ErisPostEpilogue02"
    }
    {
      Id = "Melinoe_4930"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita lihat saja nanti bagaimana jadinya..."
      Speaker = "Melinoe"
      Event = "ErisPostEpilogue02"
    }
    {
      Id = "Eris_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makasih sarannya, Nyonya, tapi aku bakal terus nongkrong di sini se{#Emph}lama {#Prev}yang kumau. Terakhir kuingat, Anda nggak bisa ngapa-ngapain soal itu, kan?"
      Speaker = "Eris"
      Event = "ErisWithHecate01"
    }
    {
      Id = "Hecate_0603"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memang {#Emph}benar{#Prev}, Eris, aku tak bisa melarangmu pergi ke mana pun sesukamu. Namun, aku {#Emph}bisa {#Prev}membuat hidupmu sengsara luar biasa, dengan cara-cara yang bahkan tak terbayangkan olehmu... Aku menahan diri semata-mata demi sumpahku pada ibumu."
      Speaker = "Hecate"
      Event = "ErisWithHecate01"
    }
    {
      Id = "Eris_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau nggak bakal bisa nakut-nakutiku. Nyx pernah coba dulu, dan lihat sendiri gimana nasibnya {#Emph}sekarang{#Prev}!"
      Speaker = "Eris"
      Event = "ErisWithHecate01"
    }
    {
      Id = "Melinoe_5962"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya kamu lagi mencari Masalah, Eris."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat01"
    }
    {
      Id = "Eris_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Udah agak lama ya sejak terakhir kali kita melampiaskan unek-unek, bener kan, Cantik?"
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat01"
    }
    {
      Id = "Eris_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuh kan, aku nggak selamanya jahat. Kadang-kadang aku malah {#Emph}mengerikan{#Prev}."
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat01"
    }
    {
      Id = "Melinoe_5655"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}...Fiuh. {#Prev}Nggak bakal kubantah."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat01"
    }
    {
      Id = "Melinoe_5963"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang mengganjal di pikiranmu, Strife?"
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat02"
    }
    {
      Id = "Eris_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau pergi dari sini? Dan maksudku pergi ke sebelah {#Emph}sana{#Prev}."
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat02"
    }
    {
      Id = "Eris_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan bisa ngerusuh bersamamu, Sayang!"
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat02"
    }
    {
      Id = "Melinoe_5656"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sama-sama, Eris."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat02"
    }
    {
      Id = "Melinoe_5964"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu mau sesuatu, kan?"
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat03"
    }
    {
      Id = "Eris_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pengin menghilang sebentar, dan kamu ikut denganku."
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat03"
    }
    {
      Id = "Eris_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Nona Masalah, kamu bebas pergi sekarang. Sana cabut dari sini, bisa kan?"
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat03"
    }
    {
      Id = "Melinoe_5657"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Iya, iya, baiklah."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat03"
    }
    {
      Id = "Melinoe_5965"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang bisa kubantu malam ini?"
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat04"
    }
    {
      Id = "Eris_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana kalau kita pergi ngecek apakah dermaga pemancingan tua itu baik-baik aja?"
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat04"
    }
    {
      Id = "Eris_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Inspeksi selesai! Mau pergi laporin temuan terbaru kita?"
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat04"
    }
    {
      Id = "Melinoe_5658"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sebaiknya kita simpan sendiri saja."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat04"
    }
    {
      Id = "Eris_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh halo lagi di sana, Sayang. Bisa tebak apa yang lagi kupikirkan?"
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat05"
    }
    {
      Id = "Melinoe_5966"
      InheritFrom = "BaseNarrative"
      DisplayName = "Halo lagi, Eris. Dan ya, kurasa aku bisa menebaknya."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat05"
    }
    {
      Id = "Eris_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah! Kamu bener-bener makin jago baca pikiran, ya."
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat05"
    }
    {
      Id = "Melinoe_5659"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Yah, aku berusaha."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat05"
    }
    {
      Id = "Melinoe_5967"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu yang ingin kaubahas denganku?"
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat06"
    }
    {
      Id = "Eris_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang kamu butuhkan, Sayang, aku selalu ada buatmu. Kadang-kadang."
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat06"
    }
    {
      Id = "Eris_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dan kurasa itu membereskan urusan yang {#Emph}itu{#Prev}, setidaknya untuk sekarang!"
      Speaker = "Eris"
      Event = "ErisBecomingCloserChat06"
    }
    {
      Id = "Melinoe_5660"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku setuju."
      Speaker = "Melinoe"
      Event = "ErisBecomingCloserChat06"
    }
    {
      Id = "Eris_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Merasa ada tempat yang terlewat di belakang sana, Nona Masalah?"
      Speaker = "Eris"
      Event = "ErisChat01"
    }
    {
      Id = "Eris_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terusin aja, apa pun yang kamu rasa perlu kamu buktikan itu!"
      Speaker = "Eris"
      Event = "ErisChat02"
    }
    {
      Id = "Eris_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngapain buru-buru amat? Kita punya banyak waktu di dunia ini!"
      Speaker = "Eris"
      Event = "ErisChat03"
    }
    {
      Id = "Eris_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, tempat ini lama-lama jadi tempat pembuangan sampah..."
      Speaker = "Eris"
      Event = "ErisChat04"
    }
    {
      Id = "Eris_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang banget ya sama apa yang terjadi di antara kita akhir-akhir ini, Si Bikin Onar."
      Speaker = "Eris"
      Event = "ErisChat05"
    }
    {
      Id = "Eris_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau ketemu Nemmie, bilangin ke dia kalau aku {#Emph}benar-benar {#Prev}mau ngomong sama dia, ya?"
      Speaker = "Eris"
      Event = "ErisChat06"
    }
    {
      Id = "Eris_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hidup berjalan cepat banget ya, bahkan buat dewi yang abadi sepertimu, {#Emph}kan{#Prev}, Si Bikin Onar?"
      Speaker = "Eris"
      Event = "ErisChat07"
    }
    {
      Id = "Eris_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, jangan pasang muka begitu. {#Emph}Aku {#Prev}juga pantas ada di sini sama seperti {#Emph}kamu."
      Speaker = "Eris"
      Event = "ErisChat08"
    }
    {
      Id = "Eris_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau nggak bakal ke mana-mana, Sayang. Kita semua juga nggak!"
      Speaker = "Eris"
      Event = "ErisChat09"
    }
    {
      Id = "Eris_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mending kau urus urusanmu sendiri, Si Bikin Onar, dan biarkan aku mengurus urusanku."
      Speaker = "Eris"
      Event = "ErisChat10"
    }
    {
      Id = "Eris_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waduh, dia datang! Mending aku kabur dan ngumpet!"
      Speaker = "Eris"
      Event = "ErisChat11"
    }
    {
      Id = "Eris_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma kepikiran mampir lagi dan mengecek semuanya, tahu kan?"
      Speaker = "Eris"
      Event = "ErisChat12"
    }
    {
      Id = "Eris_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti merasa {#Emph}sangat {#Prev}berpengaruh di luar sana, ya?"
      Speaker = "Eris"
      Event = "ErisChat13"
    }
    {
      Id = "Eris_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh{#Prev}, semuanya terasa agak berlebihan belakangan ini, tahu kan?"
      Speaker = "Eris"
      Event = "ErisChat14"
    }
    {
      Id = "Eris_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lewat saja sana, Si Bikin Onar, aku lagi nggak kepengin ngomong sama kamu sekarang."
      Speaker = "Eris"
      Event = "ErisChat15"
    }
    {
      Id = "Eris_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah{#Emph}{#Prev}, Sayang! Kau tahu rumor bakal langsung menyebar kalau mereka melihat kita begini!"
      Speaker = "Eris"
      Event = "ErisChat16"
    }
    {
      Id = "Eris_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eugh{#Prev}, tampaknya {#Emph}kau {#Prev}baru saja bangun! Sudah nggak sabar mau ketemu aku lagi, ya?"
      Speaker = "Eris"
      Event = "ErisChat17"
    }
    {
      Id = "Eris_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengawasimu, Si Bikin Onar. Jadi mending jangan macam-macam."
      Speaker = "Eris"
      Event = "ErisChat18"
    }
    {
      Id = "Eris_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua tekanan ini nggak bikin kamu stres kan, Sayang?"
      Speaker = "Eris"
      Event = "ErisChat19"
    }
    {
      Id = "Eris_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngapain ngomong sama aku? Lakukan sesukamu! {#Emph}Nggak ada {#Prev}yang peduli!"
      Speaker = "Eris"
      Event = "ErisChat20"
    }
    {
      Id = "Eris_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma nggak paham apa salahnya menikmati saat semuanya jadi kacau balau."
      Speaker = "Eris"
      Event = "ErisChat21"
    }
    {
      Id = "Eris_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Awas saja kalau kau sampai membereskan segalanya dalam waktu dekat, dengar nggak, Si Bikin Onar?"
      Speaker = "Eris"
      Event = "ErisChat22"
    }
    {
      Id = "Eris_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh{#Prev}, kau benar-benar menghajarku di Celah tadi malam, Sayang!"
      Speaker = "Eris"
      Event = "ErisChat23"
    }
    {
      Id = "Eris_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti menghitung setiap kali kau berhasil mengalahkanku, ya kan?"
      Speaker = "Eris"
      Event = "ErisChat24"
    }
    {
      Id = "Eris_0461"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mampirlah ke Celah lagi kapan-kapan! Di sini kan aku nggak bisa menembakmu."
      Speaker = "Eris"
      Event = "ErisChat25"
    }
    {
      Id = "Eris_0462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Balapan ke Celah yuk, Sayang! Siapa yang sampai terakhir bakal jadi orang pertama yang kena tembak!"
      Speaker = "Eris"
      Event = "ErisChat26"
    }
    {
      Id = "Eris_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eh{#Prev}, aku lagi agak sibuk mengurus hal lain sekarang, oke?"
      Speaker = "Eris"
      Event = "ErisChat27"
    }
    {
      Id = "Eris_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lewat saja sana, Si Bikin Onar!"
      Speaker = "Eris"
      Event = "ErisChat28"
    }
    {
      Id = "Eris_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo kita semua cuma berdiri diam di sini!"
      Speaker = "Eris"
      Event = "ErisChat29"
    }
    {
      Id = "Eris_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu aku nggak bisa menerima ini sekarang. Nggak setelah semua yang {#Emph}terjadi {#Prev}di antara kita. Mending kita... lanjut menjalani hidup masing-masing saja, ya?"
      Speaker = "Eris"
      Event = "ErisGiftDecline01"
    }
    {
      Id = "Melinoe_2692"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah? {#Prev}Dan, apa persisnya yang terjadi di antara kita, kalau boleh tahu, seandainya kau harus menyimpulkannya...? Kau cuma... mengejekku seperti biasa, kan..."
      Speaker = "Melinoe"
      Event = "ErisGiftDecline01"
    }
    {
      Id = "Eris_0069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga {#Emph}<mengendus> {#Prev}hidupmu bahagia selalu!"
      Speaker = "Eris"
      Event = "ErisGiftDecline01"
    }
    {
      Id = "Melinoe_2690"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, aku... memang ingin kau merasa disambut dan aman di sini. Ini bukan sekadar basa-basi. Semoga hadiah Nektar ini membuktikan bahwa perkataanku tulus."
      Speaker = "Melinoe"
      Event = "ErisGift01"
    }
    {
      Id = "Eris_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah... {#Prev}dibuat dari Apel Emas asli! {#Emph}Makasih{#Prev}, Sayang. Cuma kau satu-satunya yang benar-benar berusaha mengajakku bergabung! Omong-omong, ambillah ini! Memang nggak seberapa, tapi kusimpan terus buat jaga-jaga kalau dapat teman..."
      Speaker = "Eris"
      Event = "ErisGift01"
    }
    {
      Id = "Eris_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi, kau kan sudah memberikanku yang seperti ini. Nggak ada yang lain, apa? {#Emph}Mmhmhmhm{#Prev}, bercanda doang kok, Sayang! Kapan-kapan bakal kubalas ini ya, oke?"
      Speaker = "Eris"
      Event = "ErisGift02"
    }
    {
      Id = "Melinoe_2801"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong jangan... Maksudku, aku cuma ingin memberikannya karena tahu kau menyukainya, tapi barang begini makin susah dicari. Pokoknya begitulah...!"
      Speaker = "Melinoe"
      Event = "ErisGift02"
    }
    {
      Id = "Eris_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang, nggak pernah ada yang memberiku barang seperti ini! Kecuali beberapa kali terakhir saat kau memberiku barang yang persis sama. Tapi aduh, aku jadi merasa nggak enak karena nggak punya apa-apa buat {#Emph}kamu!"
      Speaker = "Eris"
      Event = "ErisGift03"
    }
    {
      Id = "Melinoe_2802"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini cuma hadiah kok, biar perasaanmu agak lebih baik, bukan tambah buruk! Tak perlu sungkan, nikmati saja... Tapi tolong, jangan buang botol kosongnya sembarangan di tanah."
      Speaker = "Melinoe"
      Event = "ErisGift03"
    }
    {
      Id = "Eris_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma penasaran pengin lihat reaksiku dapat yang beginian lagi, kan? Kamu bilang cuma hadiah, tapi {#Emph}pasti {#Prev}kamu mencatat {#Emph}rapi-rapi {#Prev}tiap Nektar yang kamu bagi-bagikan. Berharap siapa pun yang {#Emph}dapat {#Prev}bakal makin suka padamu sedikit demi sedikit."
      Speaker = "Eris"
      Event = "ErisGift04"
    }
    {
      Id = "Melinoe_2803"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat ya, kamu berhasil bikin momen ini jadi aneh, Eris... Baguslah, kamu berhasil membongkarku! Aku memang {#Emph}sangat butuh {#Prev}pujian dan kasih sayang darimu. Darimu dan dari semua orang! Memangnya {#Emph}begitu {#Prev}yang ada di pikiranmu?"
      Speaker = "Melinoe"
      Event = "ErisGift04"
    }
    {
      Id = "Eris_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu sendiri yang bilang lho, Sayang, bukan aku. Sudahlah, jangan pasang muka begitu. Tapi, kalau kamu bisa jaga rahasia...? Kayaknya aku {#Emph}memang {#Prev}makin suka sedikit padamu, sih."
      Speaker = "Eris"
      Event = "ErisGift04"
    }
    {
      Id = "Eris_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal kamu tahu, aku pernah coba bikin Nektar sendiri. Bahannya lengkap kok, cuma entah kenapa racikanku rasanya enggak pernah pas! Enggak seenak barang yang berhasil {#Emph}kamu {#Prev}dapatkan."
      Speaker = "Eris"
      Event = "ErisGift05"
    }
    {
      Id = "Melinoe_4288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar selalu terasa paling nikmat saat berupa pemberian. Pernah coba minta orang lain mencicipi buatanmu? Siapa tahu rasanya lebih enak dari yang kamu kira."
      Speaker = "Melinoe"
      Event = "ErisGift05"
    }
    {
      Id = "Eris_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, {#Emph}enggaklah{#Prev}, soalnya... buat begitu kan aku butuh seorang {#Emph}teman. {#Prev}Walau aku {#Emph}bisa {#Prev}saja sih {#Emph}menjebak {#Prev}orang buat meminumnya..."
      Speaker = "Eris"
      Event = "ErisGift05"
    }
    {
      Id = "Melinoe_4289"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Eris!"
      Speaker = "Melinoe"
      Event = "ErisGift05"
    }
    {
      Id = "Eris_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pas banget waktu kamu melangkah ke arahku, aku baru saja berharap kamu bawa Nektar lagi, soalnya punyaku habis. Dan, {#Emph}simsalabim! {#Prev}Kamu seperti bisa {#Emph}membaca pikiran... {#Prev}atau {#Emph}penenun mimpi!"
      Speaker = "Eris"
      Event = "ErisGift06"
    }
    {
      Id = "Melinoe_4290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Teknik tingkat tinggi yang belum kukuasai. Lagipula, intuisi murni masih menjadi alat paling ampuh dalam hal semacam ini! Aku cuma punya firasat kamu lagi ingin sebotol lagi."
      Speaker = "Melinoe"
      Event = "ErisGift06"
    }
    {
      Id = "Eris_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gayamu kayak menganggapku bahan eksperimen besar saja! Terus {#Emph}mencolek {#Prev}dan {#Emph}mendesak {#Prev}sampai pertahananku runtuh dan kamu bisa lihat jati diriku yang {#Emph}sebenarnya? {#Prev}Ya inilah {#Emph}aku. {#Prev}Dan tahu {#Emph}apa? {#Prev}Aku enggak sudi lagi terima Nektarmu."
      Speaker = "Eris"
      Event = "ErisGift06"
    }
    {
      Id = "Melinoe_4291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Termasuk yang baru saja kuberikan ini?"
      Speaker = "Melinoe"
      Event = "ErisGift06"
    }
    {
      Id = "Eris_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Enggak, yang ini kusimpan."
      Speaker = "Eris"
      Event = "ErisGift06"
    }
    {
      Id = "Melinoe_4476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katamu kamu tak mau Nektarku lagi, tapi kamu tidak menyinggung soal Ambrosia, Eris... jadi, bagaimana kalau kita mampir ke kedai lagi?"
      Speaker = "Melinoe"
      Event = "ErisGift07"
    }
    {
      Id = "Eris_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku bakal ke kedai, terima kasih! Tapi kali ini aku bakal pergi sendiri. Jangan tersinggung ya, tapi... kayaknya kita sebaiknya enggak terlihat berduaan lagi."
      Speaker = "Eris"
      Event = "ErisGift07"
    }
    {
      Id = "Melinoe_4477"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa, karena kamu takut rumor tak beralasan bakal menyebar? Kupikir Sang Perselisihan tidak peduli omongan orang lain."
      Speaker = "Melinoe"
      Event = "ErisGift07"
    }
    {
      Id = "Eris_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini demi kebaikanmu sendiri. Kamulah yang punya reputasi untuk dijaga. Sementara bagiku, gampang banget memenuhi reputasiku. Aku tinggal menyuruhmu enyah dari {#Emph}hadapanku!"
      Speaker = "Eris"
      Event = "ErisGift07"
    }
    {
      Id = "Melinoe_4478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu yakin tak mau ikut denganku ke kedai lagi? Tetap kupersembahkan Ambrosia ini untukmu. Kamu akan tahu dari rasanya bahwa niatku tulus."
      Speaker = "Melinoe"
      Event = "ErisGift08"
    }
    {
      Id = "Eris_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, begitu deh! Enggak bakal tahu kalau enggak pernah {#Emph}kucicipi! {#Prev}Gimana kalau botolnya langsung kuhantamkan ke tanah sekarang juga? Mau bilang {#Emph}apa {#Prev}kamu kalau begitu?"
      Speaker = "Eris"
      Event = "ErisGift08"
    }
    {
      Id = "Melinoe_4479"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin aku tinggal menawarimu botol yang lain. Kamu selalu saja memancing emosiku; Nemesis sendiri pasti bilang adil saja kalau sesekali aku memancing emosimu juga."
      Speaker = "Melinoe"
      Event = "ErisGift08"
    }
    {
      Id = "Eris_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sesekali? {#Prev}Sayang, kamu sudah memancing {#Emph}emosiku {#Prev}hampir sepanjang waktu sejak aku kembali. Aku enggak bakal termakan tipu muslihatmu!"
      Speaker = "Eris"
      Event = "ErisGift08"
    }
    {
      Id = "Melinoe_4480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tipu muslihat apa...?"
      Speaker = "Melinoe"
      Event = "ErisGift08"
    }
    {
      Id = "Melinoe_4481"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk menambah persediaan Ambrosiamu, Perselisihan. Entah kamu memilih menikmatinya di kedai bersamaku, bersama orang lain, atau dalam kesendirian yang tenang."
      Speaker = "Melinoe"
      Event = "ErisGift09"
    }
    {
      Id = "Eris_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu mestinya tahu lebih baik agar enggak macam-macam denganku begini. Kamu tahu {#Emph}persis {#Prev}siapa diriku. Kebetulan saja aku agak menyukaimu, tapi... aku bisa bikin hidupmu {#Emph}begitu {#Prev}menderita, sampai kamu enggak bisa bayangkan."
      Speaker = "Eris"
      Event = "ErisGift09"
    }
    {
      Id = "Melinoe_4482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin ini karena pengaruhmu terhadapku, tapi aku siap menanggung risikonya. Untuk apa lagi aku terus bicara denganmu di sini? Menganggapnya sebagai lelucon yang bertele-tele?"
      Speaker = "Melinoe"
      Event = "ErisGift09"
    }
    {
      Id = "Eris_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku enggak {#Emph}tahu {#Prev}kenapa, tapi makin manis sikapmu padaku, makin {#Emph}bodohlah {#Prev}kamu di mataku, dan aku makin {#Emph}curiga! {#Prev}Dan dari tadi kamu bersikap {#Emph}manis sekali. {#Prev}Soal ajakan ke kedai ini, bisa enggak... tanyai aku secara {#Emph}normal {#Prev}lain kali?!"
      Speaker = "Eris"
      Event = "ErisGift09"
    }
    {
      Id = "Melinoe_4483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Paling tidak, bolehkah aku minta kembali Ambrosia itu?"
      Speaker = "Melinoe"
      Event = "ErisGift09"
    }
    {
      Id = "Eris_0268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Enggak boleh!"
      Speaker = "Eris"
      Event = "ErisGift09"
    }
    {
      Id = "Melinoe_3474"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong jangan bikin aku menyesalinya, Eris, tapi... mau ikut denganku ke pemandian air panas sebentar? Bisa bantu meredakan ketegangan."
      Speaker = "Melinoe"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Eris_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, mata airnya sudah disucikan lagi? Aku ketinggalan kabar, nih! Kaget juga aku dapat undangan lagi setelah yang terakhir kali, tapi... {#Emph}oke deh!"
      Speaker = "Eris"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Eris_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ungh{#Prev}, jadi {#Emph}begini {#Prev}caramu bersantai sekarang? Panasnya sudah kayak magma di dalam sini! Boleh keluar sekarang, belum?"
      Speaker = "Eris"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Melinoe_3475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Izin ditolak. Sebentar lagi kamu juga bakal terbiasa dengan panasnya. Coba pusatkan pikiran pada ketegangan apa pun yang kamu rasakan, dan biarkan air ini membasuhnya."
      Speaker = "Melinoe"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Eris_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketegangan, {#Emph}aku? {#Prev}Sayang. Aku enggak perlu {#Emph}direbus hidup-hidup {#Prev}begini cuma buat melepas penat. Tapi baguslah kalau kamu sudah nemu cara buat meredam ketegangan. Gimana jadinya kalau air ini diminum?"
      Speaker = "Eris"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Melinoe_3476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mata air ini murni sebagian berkat Garam yang kami gunakan. Tapi tetap saja, aku tak menyarankanmu untuk meminumnya. Tahu-tahu, bisa-bisa {#Emph}kamu {#Prev}juga ikut disucikan."
      Speaker = "Melinoe"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Eris_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku enggak cemas soal itu! Dari sananya diriku memang sudah begini sampai ke tulang sumsum. Dan kalau {#Emph}kamu {#Prev}enggak suka, lalu membawaku kemari berharap mandi air panas cukup buat mengubahku, yah... maaf saja bikin kecewa."
      Speaker = "Eris"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Melinoe_3477"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepertinya air ini belum bisa menghilangkan keteganganmu...! Terkadang pemandian air panas hanyalah pemandian air panas, Eris. Tak semua hal merupakan serangan terhadap prinsipmu."
      Speaker = "Melinoe"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Eris_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan kalian semua, aku tak pernah bisa yakin. Tapi, ini lebih menyenangkan daripada waktu itu, dan panasnya tak terlalu buruk sekarang, kurasa..."
      Speaker = "Eris"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Eris_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Eugh{#Prev}... kurasa tadi aku minum {#Emph}terlalu banyak{#Prev} air mandi. Apa seperti ini rasanya disucikan? {#Emph}Fiuh!"
      Speaker = "Eris"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Melinoe_3479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, Eris..."
      Speaker = "Melinoe"
      Event = "ErisBathHouse01"
    }
    {
      Id = "Melinoe_4292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, bagaimana kalau mengunjungi pemandian air panas lagi? Kamu tampak menikmatinya tempo hari, dan kurasa itu benar-benar manjur."
      Speaker = "Melinoe"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Eris_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, selama itu {#Emph}manjur! {#Prev}Dengar ya, aku tak sudi membasahi sayapku untuk sembarang {#Emph}orang{#Prev}, Sayang, tapi kamu istimewa. Jadi, berangkat?"
      Speaker = "Eris"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Melinoe_4293"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Bagaimana rasanya punya begitu banyak saudara? Saudaraku cuma satu dan aku bahkan tak mengenalnya saat tumbuh dewasa. Walau begitu, aku sering curhat padanya, seperti punya teman khayalan."
      Speaker = "Melinoe"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Eris_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semakin banyak saudara yang kamu punya, semakin besar potensi dirimu jadi biang kekecewaan! Dan memalukan sekali kalau sampai lupa {#Emph}nama {#Prev}mereka. Lihat saja bagaimana kami anak-anak Nyx berinteraksi. Satu-satunya keluarga yang lebih bobrok dari keluargaku adalah {#Emph}keluargamu!"
      Speaker = "Eris"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Melinoe_4294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu para Olimpus. Bagaimana bisa kau menyimpulkannya begitu? Mereka memang punya perselisihan. Tapi mereka tetap bekerja sama menjaga tatanan alami seluruh alam."
      Speaker = "Melinoe"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Eris_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bekerja {#Emph}sama? {#Prev}Yang {#Emph}benar saja{#Prev}, mereka hampir tak tahan satu sama lain, dari yang paling atas sampai ke bawah! Mereka seharusnya tak pernah mengurus bisnis bersama. Selalu terjepit di antara ikatan darah dan urusan tugas!"
      Speaker = "Eris"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Melinoe_4295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak menampik bahwa keluarga menambah kerumitan tanggung jawab mereka. Tapi itu juga sumber solidaritas dan kekuatan. Lihat mereka sekarang, bersatu menghadapi musuh bersama. {#Emph}Inilah {#Prev}Olimpus yang dicintai dan ditakuti manusia fana."
      Speaker = "Melinoe"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Eris_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf ya, aku tak terkesan. Katanya keluarga adalah ikatan yang tak pernah bisa diputus, tapi... seperti yang sering terjadi, mereka {#Emph}keliru. {#Prev}Hanya karena seseorang punya hubungan darah denganmu, bukan berarti mereka {#Emph}istimewa {#Prev}atau pantas dihormati."
      Speaker = "Eris"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Melinoe_4296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu apa yang {#Emph}bisa {#Prev}membuatmu menaruh hormat pada seseorang, Eris?"
      Speaker = "Melinoe"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Eris_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya aku bahkan tak tahu jawabannya sekarang. Tapi, duduk telanjang bersamaku di air yang hampir mendidih ini cukup membantu!"
      Speaker = "Eris"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Eris_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asyik banget tadi, Sayang. Dan lihat betapa {#Emph}bersihnya {#Prev}sayapku sekarang! Memang tak bakal bertahan lama, sih, tapi... lumayanlah."
      Speaker = "Eris"
      Event = "ErisBathHouse02"
    }
    {
      Id = "Melinoe_4931"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berpikir, bagaimana kalau kita rehat sejenak dari pertarungan sia-sia ini dan mampir ke pemandian air panas lagi. Bagaimana menurutmu?"
      Speaker = "Melinoe"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Eris_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh! Aku suka mendengarkan apa pun ocehan yang melintas di kepalamu sambil menatapmu sampai kamu salah tingkah. Yuk berangkat!"
      Speaker = "Eris"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Eris_0409"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku bukan temanmu, asal kamu tahu. Sedekat apa pun kamu pikir hubungan kita sekarang, aku cuma sedang menyiapkan panggung agar bisa membuatmu benar-benar kecewa."
      Speaker = "Eris"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Melinoe_4932"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau memang begitu, kenapa repot-repot memperingatkanku? Kamu pasti langsung melakukannya, bukannya malah berusaha mengusirku. Yah, aku tak akan ke mana-mana. Terlebih lagi tanpa pakaianku."
      Speaker = "Melinoe"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Eris_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu bakal menyesal nanti. Semua orang selalu begitu. Aku bisa membuat segalanya jadi {#Emph}jauh {#Prev}lebih buruk! Dan semakin banyak waktu yang kauberikan padaku, semakin besar kemungkinan hal itu terjadi. Kamu pikir aku cuma menggertak?"
      Speaker = "Eris"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Melinoe_4933"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, kurasa kamu bersungguh-sungguh. Tapi bagiku, aku tak ingin pernah merasa terlalu nyaman. Di saat itulah aku merasa paling gelisah. Dan selama ada kamu, kurasa aku tak akan pernah bisa santai."
      Speaker = "Melinoe"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Eris_0411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu mungkin hal termanis yang pernah dikatakan seseorang kepadaku... tapi itu tak mengubah apa pun, tak pernah ada yang bisa. Hei, kalau kamu tak mau terlalu nyaman, lalu apa yang kamu lakukan di {#Emph}sini?"
      Speaker = "Eris"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Melinoe_4934"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memulihkan diri dari saat terakhir kamu menjadikanku sasaran tembak dengan Adamant Rail. Aku sudah terbiasa dengan risiko tertentu jika berada di dekatmu, Eris."
      Speaker = "Melinoe"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Eris_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya saja jangan {#Emph}terlalu {#Prev}terbiasa, paham, Biang Rusuh? Tapi setidaknya kamu sadar tak ada cara untuk menyingkirkanku."
      Speaker = "Eris"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Eris_0413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah! Kelihatannya kamu sudah siap untuk dijadikan sasaran tembak lagi setelah ini. Kamu tahu harus mencariku di mana."
      Speaker = "Eris"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Melinoe_4936"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti."
      Speaker = "Melinoe"
      Event = "ErisBathHouse03"
    }
    {
      Id = "Eris_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ke pemandian air panas, cuma berdua? Aduh, {#Emph}Sayang!"
      Speaker = "Eris"
      Event = "ErisBathHouseRepeatable01[1]"
    }
    {
      Id = "Eris_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari semua orang di Persimpangan kecilmu, kamu memilih {#Emph}aku? {#Prev}Aku tersanjung, Sayang!"
      Speaker = "Eris"
      Event = "ErisBathHouseRepeatable01[1]"
    }
    {
      Id = "Eris_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah kotor sekali sejak terakhir kali kita ke pemandian air panas, jadi tak ada salahnya!"
      Speaker = "Eris"
      Event = "ErisBathHouseRepeatable01[1]"
    }
    {
      Id = "Eris_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tak peduli sebanyak apa air ini kuminum, rasanya tak pernah bisa membersihkan bagian dalam tubuhku!"
      Speaker = "Eris"
      Event = "ErisBathHouseRepeatable01[3]"
    }
    {
      Id = "Eris_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Hubungan kita canggung sekali, ya? Tapi kalau ini berarti kita bisa lebih sering ke pemandian air panas, masa bodohlah!"
      Speaker = "Eris"
      Event = "ErisBathHouseRepeatable01[3]"
    }
    {
      Id = "Eris_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jaga tanganmu agar tetap terlihat olehku, Sayang. Jangan sampai kamu merasa terlalu nyaman!"
      Speaker = "Eris"
      Event = "ErisBathHouseRepeatable01[3]"
    }
    {
      Id = "Eris_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh! {#Prev}Aku santai sekali sampai-sampai rasanya sudah tak ingin membunuhmu lagi!"
      Speaker = "Eris"
      Event = "ErisBathHouseRepeatable01[4]"
    }
    {
      Id = "Eris_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya {#Emph}enak{#Prev}, 'kan? Itulah satu-satunya alasan untuk melakukan {#Emph}apa pun{#Prev}, Biang Rusuh!"
      Speaker = "Eris"
      Event = "ErisBathHouseRepeatable01[4]"
    }
    {
      Id = "Eris_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm! {#Prev}Lain kali mungkin aku tak akan membiarkanmu menyeretku keluar secepat itu."
      Speaker = "Eris"
      Event = "ErisBathHouseRepeatable01[4]"
    }
    {
      Id = "Melinoe_3553"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei... bagaimana kalau kita pergi ke pemandian air panas, untuk membersihkan dirimu dari segala perbuatan kotormu? Dan aku dari perbuatanku?"
      Speaker = "Melinoe"
      Event = "ErisBathHouseDecline01"
    }
    {
      Id = "Eris_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}haha{#Prev}, yah... asal tahu saja, aku bakal merasa canggung sekali kalau ke sana bersama orang lain. Maaf, ya!"
      Speaker = "Eris"
      Event = "ErisBathHouseDecline01"
    }
    {
      Id = "Melinoe_4905"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak apa-apa kalau kau tak bisa, tapi apa kau berminat pergi ke pemandian air panas bersamaku? Mungkin bisa membantu menenangkan pikiran kita."
      Speaker = "Melinoe"
      Event = "ErisBathHouseDecline02"
    }
    {
      Id = "Eris_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hal terakhir yang kuinginkan itu menenangkan diri, Sayang. Lagipula, pemandiannya ada di {#Emph}ujung sana{#Prev}, dan aku sudah asyik dengan urusanku sendiri {#Emph}di sini! {#Prev}Sebaiknya kau juga urus urusanmu sendiri."
      Speaker = "Eris"
      Event = "ErisBathHouseDecline02"
    }
    {
      Id = "Melinoe_4277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu saja menyendiri di pojokan ini. Ayo mampir sebentar ke taverna! Kita bisa {#Emph}bersenang-senang dan melepas penat{#Prev}, seperti katamu. Aku bawa sebotol Ambrosia, nih."
      Speaker = "Melinoe"
      Event = "ErisTaverna01"
    }
    {
      Id = "Eris_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang, tumben sekali kau bersikap se-{#Emph}spontan {#Prev}ini! Mana mungkin aku bisa menolaknya{#Emph}? {#Prev}Asalkan aku masih boleh masuk ke sana setelah apa yang {#Emph}terjadi..."
      Speaker = "Eris"
      Event = "ErisTaverna01"
    }
    {
      Id = "Eris_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh! {#Prev}Minuman ini memang terasa {#Emph}nikmat! {#Prev}Mau nambah lagi, tidak? Dan {#Emph}kerja bagus {#Prev}sudah merapikan tempat ini! Kelihatannya kalian benar-benar sudah memperbaiki segalanya!"
      Speaker = "Eris"
      Event = "ErisTaverna01"
    }
    {
      Id = "Melinoe_4278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seluruh area ini sempat ditutup cukup lama. Butuh ritual penyucian yang agak rumit dan usaha dari banyak Arwah untuk memulihkannya, jadi... yah, aku tak akan mengungkitnya."
      Speaker = "Melinoe"
      Event = "ErisTaverna01"
    }
    {
      Id = "Eris_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah, aku senang kau tak mengungkitnya! Artinya kita {#Emph}benar-benar {#Prev}mulai saling mengenal. Tapi, apa kau tidak khawatir dengan apa yang bakal dikatakan para Arwah itu? Maksudku, tentang kita...?"
      Speaker = "Eris"
      Event = "ErisTaverna01"
    }
    {
      Id = "Melinoe_4279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, aku tidak terpikir bahwa pertemuan kita ini bisa disalahartikan; walau kalau dipikir-pikir lagi, aku cukup ceroboh. Memangnya menurutmu mereka bakal bilang apa?"
      Speaker = "Melinoe"
      Event = "ErisTaverna01"
    }
    {
      Id = "Eris_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}kau {#Prev}tahu sendiri, kan! Mereka melihat caramu bicara padaku, membereskan kekacauanku, mengajakku ke pemandian air panas, memberiku Nektar, bahkan Ambrosia. Maksudku, {#Emph}heh{#Prev}, ayolah! Mereka itu tidak {#Emph}bodoh!"
      Speaker = "Eris"
      Event = "ErisTaverna01"
    }
    {
      Id = "Melinoe_4280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Eris, semua hal itu bukan berarti... pergi ke taverna bukanlah semacam... {#Emph}uhh. {#Prev}Ini murni kesempatan agar kita bisa mengobrol lebih panjang sesekali."
      Speaker = "Melinoe"
      Event = "ErisTaverna01"
    }
    {
      Id = "Eris_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benci harus mengecewakanmu, tapi aku ke sini bukan untuk {#Emph}mengobrol. {#Prev}Sekarang tuangkan! Waktuku tidak banyak dan Ambrosia ini {#Emph}terlalu {#Prev}pahit kalau cuma disesap sedikit-sedikit."
      Speaker = "Eris"
      Event = "ErisTaverna01"
    }
    {
      Id = "Eris_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Manis sekali kau mau mengajakku ke sini! Dan tak ada satu pun perabotan yang hancur! Senang kita bisa melakukan ini."
      Speaker = "Eris"
      Event = "ErisTaverna01"
    }
    {
      Id = "Melinoe_4282"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku juga..."
      Speaker = "Melinoe"
      Event = "ErisTaverna01"
    }
    {
      Id = "Melinoe_4484"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Emm{#Prev}, Eris? Mau menemaniku ke taverna untuk istirahat sejenak? Kalau kau sedang tidak sibuk."
      Speaker = "Melinoe"
      Event = "ErisTaverna02"
    }
    {
      Id = "Eris_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, Sayang, apa kau sedang mengajakku kencan? Setelah {#Emph}semua hal {#Prev}yang kita lalui bersama, kau {#Emph}masih {#Prev}mencoba memulai lembaran baru denganku."
      Speaker = "Eris"
      Event = "ErisTaverna02"
    }
    {
      Id = "Melinoe_4485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terakhir kali kau menyarankan agar aku mengajakmu secara wajar, jadi aku mencobanya. Sekarang, apa kita jadi minum atau tidak?"
      Speaker = "Melinoe"
      Event = "ErisTaverna02"
    }
    {
      Id = "Eris_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja! Aku... tertarik kalau kau juga mau, meskipun... aku tak paham apa tujuannya."
      Speaker = "Eris"
      Event = "ErisTaverna02"
    }
    {
      Id = "Eris_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fyuuh! {#Prev}Sekarang tuangkan satu lagi, ayolah. Malam ini kita berdua punya urusan penting, jadi ayo kita percepat!"
      Speaker = "Eris"
      Event = "ErisTaverna02"
    }
    {
      Id = "Melinoe_4486"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, hanya saja... Ambrosia itu lebih ditujukan untuk disesap dan dinikmati, bukan diteguk habis sekaligus dalam satu tarikan napas."
      Speaker = "Melinoe"
      Event = "ErisTaverna02"
    }
    {
      Id = "Eris_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa kau berpikir aku peduli? Aku tak akan merasakan {#Emph}apa pun {#Prev}kalau cuma minum sesap demi sesap. Sekarang saja aku hampir tak merasakan apa-apa!"
      Speaker = "Eris"
      Event = "ErisTaverna02"
    }
    {
      Id = "Melinoe_4487"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau hanya belum mencobanya dengan cara yang benar. Angkat ke bibirmu seperti ini. Hirup aromanya sejenak, nikmati wanginya, lalu minumlah. Tapi sedikit saja."
      Speaker = "Melinoe"
      Event = "ErisTaverna02"
    }
    {
      Id = "Eris_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Oh. {#Emph}Ohhh. {#Prev}Rasanya berbeda, ya. Aku... bahkan tidak tahu kalau cara menikmatinya seperti itu. Kenapa kau {#Emph}bisa {#Prev}bersikap sebaik ini padaku?"
      Speaker = "Eris"
      Event = "ErisTaverna02"
    }
    {
      Id = "Melinoe_4488"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun tidak begitu yakin. Hanya ingin melihat apa yang akan terjadi, kurasa? Sebelumnya kau bilang kalau kau agak menyukaiku. Aku juga agak menyukaimu! Meskipun aku tahu seharusnya tidak..."
      Speaker = "Melinoe"
      Event = "ErisTaverna02"
    }
    {
      Id = "Eris_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku merasa kasihan padamu, Sayang. Sungguh. Kita selalu menginginkan apa yang tak pernah bisa kita miliki. Sekarang tunjukkan lagi bagaimana caramu menyesap minuman ini! Bukankah biasanya kau harus mengucapkan sesuatu dulu?"
      Speaker = "Eris"
      Event = "ErisTaverna02"
    }
    {
      Id = "Eris_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dengar, tadi itu memang menyenangkan, tapi saat melihatmu lagi di Retakan Thessaly nanti, aku akan tetap menghajarmu habis-habisan! Dan awas saja kalau kau tidak muncul."
      Speaker = "Eris"
      Event = "ErisTaverna02"
    }
    {
      Id = "Melinoe_4490"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku memang berniat ke sana. Jangan pernah berubah, Eris."
      Speaker = "Melinoe"
      Event = "ErisTaverna02"
    }
    {
      Id = "Melinoe_4283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita pergi ke taverna sebentar? Kelihatannya kau tidak terlalu sibuk dan sepertinya kita perlu bicara..."
      Speaker = "Melinoe"
      Event = "ErisTavernaDecline01"
    }
    {
      Id = "Eris_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kau menyingkir dari {#Emph}hadapanku {#Prev}sebentar? Aku sedang malas melihatmu dan tatapan menghakimi para Arwah itu, terima kasih."
      Speaker = "Eris"
      Event = "ErisTavernaDecline01"
    }
    {
      Id = "Eris_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setelah semua yang terjadi, aku benar-benar butuh minum. Ayo pergi sekarang juga!"
      Speaker = "Eris"
      Event = "ErisTavernaRepeatable01[1]"
    }
    {
      Id = "Eris_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa sudah agak lama kita tidak pergi ke taverna, jadi kenapa tidak? Kau duluan, Sayang!"
      Speaker = "Eris"
      Event = "ErisTavernaRepeatable01[1]"
    }
    {
      Id = "Eris_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, mumpung kau mengungkitnya, aku benar-benar ingin minum Ambrosia sekarang!"
      Speaker = "Eris"
      Event = "ErisTavernaRepeatable01[1]"
    }
    {
      Id = "Eris_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau lihat para Arwah di sebelah sana? Aku terus-terusan melototi mereka. Kelihatannya mereka terlalu takut sampai tidak berani bergerak!"
      Speaker = "Eris"
      Event = "ErisTavernaRepeatable01[2]"
    }
    {
      Id = "Eris_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Rasa minuman ini benar-benar terasa berbeda tiap kali diminum. Jadi, kita bersulang untuk apa? Ah, tak usah dijawab, tuangkan saja."
      Speaker = "Eris"
      Event = "ErisTavernaRepeatable01[2]"
    }
    {
      Id = "Eris_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau nggak tahu betapa penginnya aku membalikkan semua meja ini, jadi mending kita buruan minum."
      Speaker = "Eris"
      Event = "ErisTavernaRepeatable01[2]"
    }
    {
      Id = "Eris_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fyuuh! {#Prev}Kayaknya aku bener-bener butuh itu tadi! Tapi sekarang aku malah agak sedih."
      Speaker = "Eris"
      Event = "ErisTavernaRepeatable01[3]"
    }
    {
      Id = "Eris_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, lucu ya. Aku nggak begitu benci tempat itu kayak dulu lagi."
      Speaker = "Eris"
      Event = "ErisTavernaRepeatable01[3]"
    }
    {
      Id = "Eris_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, mereka nggak bakal ngelihat aku balik ke {#Emph}sana {#Prev}dalam waktu dekat!"
      Speaker = "Eris"
      Event = "ErisTavernaRepeatable01[3]"
    }
    {
      Id = "Melinoe_4284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita ke dermaga pemancingan sebentar? Tempatnya nggak jauh kok, sekadar mencari suasana baru."
      Speaker = "Melinoe"
      Event = "ErisFishing01"
    }
    {
      Id = "Eris_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Boleh{#Prev}, aku mah gampang, Sayang! Ya kecuali pas lagi nggak, tapi sekarang aku lagi mau ngapain {#Emph}aja! {#Prev}Bahkan bengong nungguin ikan nyamber!"
      Speaker = "Eris"
      Event = "ErisFishing01"
    }
    {
      Id = "Eris_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tahu nggak apa yang paling aku benci di dunia ini? Disuruh diam mematung tanpa bersuara sedikit pun. Dosa apa aku sampai harus disiksa begini, {#Emph}hah?!"
      Speaker = "Eris"
      Event = "ErisFishing01"
    }
    {
      Id = "Melinoe_4285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu ini berat, makanya sesekali perlu dilakukan... pusatkan saja pikiranmu untuk mengenali dirimu dan menikmati momen ini. Dermaga pancingan ini sebenarnya cuma sarana."
      Speaker = "Melinoe"
      Event = "ErisFishing01"
    }
    {
      Id = "Eris_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fokus pada momen ini, yang {#Emph}bener {#Prev}aja! Mana mungkin orang nggak {#Emph}selalu {#Prev}melakukan itu? Mending di momen lain aku ngelakuin apa yang aku {#Emph}mau. {#Prev}Bukannya tunduk sama semua kemauanmu!"
      Speaker = "Eris"
      Event = "ErisFishing01"
    }
    {
      Id = "Melinoe_4286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau merasa ini sama sekali tak berguna, kau tak perlu mengulanginya lagi. Tapi mumpung kita sudah di sini, kenapa tak kita coba apakah bisa menangkap sesuatu?"
      Speaker = "Melinoe"
      Event = "ErisFishing01"
    }
    {
      Id = "Eris_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu-satunya hal yang bakal {#Emph}kau {#Prev}tangkap itu {#Emph}tinju {#Prev}di {#Emph}muka {#Prev}kalau terus-terusan mengoceh, Sayang! Eh tunggu, {#Emph}diam dulu! {#Prev}Kayaknya barusan ada yang lewat!"
      Speaker = "Eris"
      Event = "ErisFishing01"
    }
    {
      Id = "Eris_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang, tadi itu {#Emph}bener-bener {#Prev}seru banget, {#Emph}sumpah! {#Prev}Dan, kamu sama sekali nggak {#Emph}bau!"
      Speaker = "Eris"
      Event = "ErisFishing01"
    }
    {
      Id = "Melinoe_4692"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pula dirimu."
      Speaker = "Melinoe"
      Event = "ErisFishing01"
    }
    {
      Id = "Melinoe_3554"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dermaga pemancingan lagi sepi seperti yang kaulihat... berminat menghabiskan waktu di sana sebentar?"
      Speaker = "Melinoe"
      Event = "ErisFishingDecline01"
    }
    {
      Id = "Eris_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mmm{#Prev}, pergi ke kolam pancing butuh ketenangan dan kesabaran ekstra yang kayaknya nggak sanggup kuhadapi sekarang, makasih ya."
      Speaker = "Eris"
      Event = "ErisFishingDecline01"
    }
    {
      Id = "Eris_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, jangan ini lagi dong. Tapi ya sudahlah, siapa peduli? Berangkat!"
      Speaker = "Eris"
      Event = "ErisFishingRepeatable01[1]"
    }
    {
      Id = "Eris_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm! {#Prev}Kayaknya aku bisa bikin sedikit kekacauan di air biar ikannya pada nyamber, cuma ada satu cara buat membuktikannya!"
      Speaker = "Eris"
      Event = "ErisFishingRepeatable01[1]"
    }
    {
      Id = "Eris_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku jauh lebih suka mengacau bersamamu daripada sama gerombolan ikan tak berotak, tapi kayaknya aku bisa ngelakuin dua-duanya sekaligus!"
      Speaker = "Eris"
      Event = "ErisFishingRepeatable01[1]"
    }
    {
      Id = "Eris_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Udah lebih dari cukup buat adegan diam dan tenangnya untuk malam ini."
      Speaker = "Eris"
      Event = "ErisFishingRepeatable01[2]"
    }
    {
      Id = "Eris_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita {#Emph}nggak bakal {#Prev}pernah sama lagi, kuharap kau tahu itu, Si Biang Masalah."
      Speaker = "Eris"
      Event = "ErisFishingRepeatable01[2]"
    }
    {
      Id = "Eris_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah cukup konsentrasi dan merenung di sininya untuk satu malam!"
      Speaker = "Eris"
      Event = "ErisFishingRepeatable01[2]"
    }
    {
      Id = "Melinoe_1158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Eris sudah pergi..."
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_2854"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa lagi yang direncanakan Eris sekarang..."
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.MissingDistanceTrigger.VoiceLines"
    }
    {
      Id = "Melinoe_2691"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, ini sebenarnya tak perlu, tapi, {#Emph}ehm{#Prev}... terima kasih."
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.GiftGivenVoiceLines"
    }
    {
      Id = "MelinoeField_1709"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pergi... {#Emph}sana!"
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_1710"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuperingatkan kau!"
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_1711"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak sudi bicara denganmu!"
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_1712"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Argh!"
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.OnHitVoiceLines"
    }
    {
      Id = "ErisField_0019"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, satu hal terakhir..."
      Speaker = "Eris"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "ErisField_0032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ups!"
      Speaker = "Eris"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "ErisField_0033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa nanti!"
      Speaker = "Eris"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "ErisField_0034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dadah!"
      Speaker = "Eris"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "ErisField_0035"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tugasku di sini selesai!"
      Speaker = "Eris"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "ErisField_0036"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mati kau, {#Emph}Chronos!"
      Speaker = "Eris"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "ErisField_0037"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke, cabut dulu!"
      Speaker = "Eris"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_1703"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang dia lakukan padaku...?"
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_1704"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Eugh{#Prev}, baguslah..."
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_1705"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutukan sialan..."
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_1706"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mencoba memperlambat langkahku..."
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_1707"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini lagi?"
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_1708"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sama sekali tak suka ini, Eris...!"
      Speaker = "Melinoe"
      Event = "NPC_Eris_01.ExitVoiceLines"
    }
    {
      Id = "ErisField_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kau {#Prev}jauh sekali dari Persimpangan, Biang Masalah! Jadi, di sinilah keseruan yang sebenarnya terjadi, {#Emph}ya? {#Prev}Bukannya kau seharusnya masih latihan?"
      Speaker = "Eris"
      Event = "ErisGrantsCurse01"
    }
    {
      Id = "MelinoeField_1698"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keadaan berubah, Eris...! Kau tahu sendiri 'kan bagaimana kelanjutannya. Sekarang, permisi, ada urusan mendesak yang harus kuselesaikan."
      Speaker = "Melinoe"
      Event = "ErisGrantsCurse01"
    }
    {
      Id = "ErisField_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu saja terburu-buru! Aku benci banget kalau harus memperlambatmu, tapi kapan-kapan kita nongkrong bareng ya, oke? Semoga malammu menyenangkan."
      Speaker = "Eris"
      Event = "ErisGrantsCurse01"
    }
    {
      Id = "MelinoeField_1699"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemari mau menaruh kutukan lain padaku, Eris? Dari sekian banyak {#Emph}keanehanmu{#Prev}, tak pernah kusangka kau seorang pengkhianat."
      Speaker = "Melinoe"
      Event = "ErisGrantsCurse02"
    }
    {
      Id = "ErisField_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bukan pengkhianat, {#Emph}sumpah! {#Prev}Hanya saja... {#Emph}ugh{#Prev}, kau takkan pernah paham. Padahal aku ingin ini jadi {#Emph}momen istimewa{#Prev}, tapi kau malah datang dan {#Emph}merusaknya{#Prev}!"
      Speaker = "Eris"
      Event = "ErisGrantsCurse02"
    }
    {
      Id = "MelinoeField_1700"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lagi. Kenapa, khawatir tugasku kurang sulit? Terlalu lancar jaya ya bagimu?"
      Speaker = "Melinoe"
      Event = "ErisGrantsCurse03"
    }
    {
      Id = "ErisField_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya {#Emph}iya{#Prev}, aku agak khawatir soal itu. Kau berhasil melewati para {#Emph}Siren! {#Prev}Lalu apa lagi, kau bakal pergi membunuh Chronos, terus setelah itu apa? Ayolah, Sayang. Jangan gegabah begitu."
      Speaker = "Eris"
      Event = "ErisGrantsCurse03"
    }
    {
      Id = "MelinoeField_1701"
      InheritFrom = "BaseNarrative"
      DisplayName = "Minggir dari jalanku, Eris! Aku tak mau buang-buang napas lagi meladenimu selama kau terus melestarikan omong kosong ini."
      Speaker = "Melinoe"
      Event = "ErisGrantsCurse04"
    }
    {
      Id = "ErisField_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak pernah memahamiku, Biang Masalah. Ya sudah! Tak usah paham juga tak apa. Cuma ingat ya, aku melakukan ini demi kebaikanmu sendiri. Dan sebenarnya, demi kebaikanku juga!"
      Speaker = "Eris"
      Event = "ErisGrantsCurse04"
    }
    {
      Id = "ErisField_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya ada keributan apa sih, {#Emph}hah? {#Prev}Chronos mulai menyerang Olimpus lagi, ya sudah jelas. Tapi bukan berarti kau harus memburunya sekarang juga, 'kan?"
      Speaker = "Eris"
      Event = "ErisGrantsCurse05"
    }
    {
      Id = "MelinoeField_1702"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percayalah padaku, aku jauh lebih memilih mengobrol santai denganmu daripada mengotori tanganku dengan darah Titan. Tapi kau punya pilihan, Eris. Kau bisa membantuku menuntaskan ini, bukannya malah menghalangiku."
      Speaker = "Melinoe"
      Event = "ErisGrantsCurse05"
    }
    {
      Id = "ErisField_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, Sayang... kalau kau benar, ya kau {#Emph}benar. {#Prev}Banyak hal yang kau berikan untuk kupikirkan masak-masak. Sekarang giliranmu menelan mentah-mentah kutukan {#Emph}ini."
      Speaker = "Eris"
      Event = "ErisGrantsCurse05"
    }
    {
      Id = "MelinoeField_1925"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang kau lakukan di Tartarus? Mustahil kau bisa masuk ke tempat ini, kecuali..."
      Speaker = "Melinoe"
      Event = "ErisGrantsCurse06"
    }
    {
      Id = "ErisField_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kecuali kalau aku bisa, kayak, {#Emph}terbang? {#Prev}Ayolah, Sayang, isi kepalamu itu {#Emph}terlalu {#Prev}penuh prasangka. Sepertinya kau juga bakal terjebak di sini selamanya!"
      Speaker = "Eris"
      Event = "ErisGrantsCurse06"
    }
  ]
}
