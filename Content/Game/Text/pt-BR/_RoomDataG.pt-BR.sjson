{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _RoomDataG.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "MelinoeField_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pada antre buat apa sih ini...?"
      Speaker = "Melinoe"
      Event = "ObstacleData[617546].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke sini mau nonton konser?"
      Speaker = "Melinoe"
      Event = "ObstacleData[617546].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertunjukannya sebentar lagi mulai..."
      Speaker = "Melinoe"
      Event = "ObstacleData[617546].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku punya tiket musiman."
      Speaker = "Melinoe"
      Event = "ObstacleData[617546].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_0261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku punya akses belakang panggung."
      Speaker = "Melinoe"
      Event = "ObstacleData[617546].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah nyanyian yang tak henti-hentinya bergema memaksa sang Putri pembawa mimpi buruk untuk terus melangkah, menuju keindahan, kian dalam ke palung kegelapan."
      Speaker = "Storyteller"
      Event = "Inspect_G_PreBoss_01"
    }
    {
      Id = "MelinoeField_3820"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat mengarah ke panggungnya Scylla..."
      Speaker = "Melinoe"
      Event = "Inspect_G_PreBoss_01"
    }
    {
      Id = "Melinoe_0855"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cantik sekali..."
      Speaker = "Melinoe"
      Event = "Inspect_G_PreBoss_01"
    }
    {
      Id = "MelinoeField_1717"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertunjukan selesai, semuanya."
      Speaker = "Melinoe"
      Event = "ObstacleData[595279].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1718"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekian pertunjukan untuk malam ini."
      Speaker = "Melinoe"
      Event = "ObstacleData[595279].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1719"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Besok malam kita bakal tampil lagi."
      Speaker = "Melinoe"
      Event = "ObstacleData[595279].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1720"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan sekian penampilan kami malam ini!"
      Speaker = "Melinoe"
      Event = "ObstacleData[595279].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1721"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertunjukan selesai. Terjadi kendala teknis."
      Speaker = "Melinoe"
      Event = "ObstacleData[595279].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1722"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lagi-lagi kendala teknis, mohon maaf ya."
      Speaker = "Melinoe"
      Event = "ObstacleData[595279].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0474"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nyanyian Siren yang memikat akhirnya memudar menjadi kesunyian, menyisakan sang Putri Kematian merenungi jalanan yang menghujam kian dalam menuju penjuru terlarang alam baka."
      Speaker = "Storyteller"
      Event = "Inspect_G_Boss01_02"
    }
    {
      Id = "MelinoeField_3821"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita hampir sampai di Fields."
      Speaker = "Melinoe"
      Event = "Inspect_G_Boss01_02"
    }
    {
      Id = "Storyteller_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di tempat yang dulunya bergaung alunan musik memukau para Siren, kini hanya keheningan mutlak yang tersisa; namun berapa lama para biduanita abadi itu akan terbungkam?"
      Speaker = "Storyteller"
      Event = "Inspect_G_Boss01_01"
    }
    {
      Id = "MelinoeField_0222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pastinya cuma sampai percobaan berikutnya..."
      Speaker = "Melinoe"
      Event = "Inspect_G_Boss01_01"
    }
    {
      Id = "Storyteller_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Meski diperkuat oleh Charybdis raksasa, Scylla dan para biduanita monster dari laut jurang terdalam tetap tak mampu menuntaskan aksi maut mereka."
      Speaker = "Storyteller"
      Event = "Inspect_G_Boss02_01"
    }
    {
      Id = "MelinoeField_3613"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pada akhirnya, cuma malam biasa buat mereka."
      Speaker = "Melinoe"
      Event = "Inspect_G_Boss02_01"
    }
    {
      Id = "Storyteller_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Dengan pertunjukan semeriah itu yang berakhir begitu mendadak, para Arwah penonton ditinggalkan bertanya-tanya apakah harus menunggu aksi tambahan, atau pengembalian tiket."
      Speaker = "Storyteller"
      Event = "Inspect_G_Boss02_02"
    }
    {
      Id = "MelinoeField_3653"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa tiketnya tak bisa dikembalikan..."
      Speaker = "Melinoe"
      Event = "Inspect_G_Boss02_02"
    }
    {
      Id = "Storyteller_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di dalam ruangan bernuansa hijau yang telah dikuasai para Siren bersuara melengking itu, sebuah jalan setapak menghujam dalam ke pinggiran tak dikenal di Alam Baka."
      Speaker = "Storyteller"
      Event = "Inspect_G_PostBoss_01"
    }
    {
      Id = "MelinoeField_0815"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi ini sarang kecilnya Scylla, ya?"
      Speaker = "Melinoe"
      Event = "Inspect_G_PostBoss_01"
    }
    {
      Id = "Storyteller_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Koleksi karya Scylla sang pembantai pelaut dan para Siren-nya tampak berserakan di sana-sini, pembalasan dendam terakhir bagi kewarasan siapa pun yang berani melihatnya lebih dekat."
      Speaker = "Storyteller"
      Event = "Inspect_G_PostBoss_02"
    }
    {
      Id = "MelinoeField_1326"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Gaun kecilmu, kotor tak karuan... {#Prev}ya ampun, dewa-dewi..."
      Speaker = "Melinoe"
      Event = "Inspect_G_PostBoss_02"
    }
    {
      Id = "MelinoeField_0983"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terowongan pertama di kananku..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0984"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ruang tunggu para Siren..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0985"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada Siren, syukurlah..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0986"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lebih baik lekas pergi sebelum Scylla kembali."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0987"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepian Oceanus..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0988"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dasar laut yang paling dalam..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0989"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bau sekali di sini..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0990"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah tak ada kerumunan lagi..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, kembali ke Fields..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0991"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Curam sekali..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0992"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makin dekat..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0993"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menuju Padang Asphodel..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0994"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tarik napas>"
      Speaker = "Melinoe"
      Event = "G_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0995"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluar dari sini."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0996"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jauh juga turunnya..."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0997"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktunya mengeringkan diri."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0998"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menuju pijakan yang lebih kokoh."
      Speaker = "Melinoe"
      Event = "G_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "Storyteller_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di dalam palung Oceanus yang basah kuyup dan teramat kelam, bersemayam kengerian yang bahkan tak sanggup dilukiskan oleh para pujangga fana maupun baka terhebat sekalipun."
      Speaker = "Storyteller"
      Event = "Inspect_G_Intro_01"
    }
    {
      Id = "Melinoe_0854"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan merendah begitu, Homer."
      Speaker = "Melinoe"
      Event = "Inspect_G_Intro_01"
    }
    {
      Id = "Melinoe_0151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan cari jalan."
      Speaker = "Melinoe"
      Event = "Inspect_G_Intro_01"
    }
    {
      Id = "Storyteller_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Dunia Bawah terhunjam lebih dalam daripada samudra terdalam; namun ada tempat-tempat bertemunya tepian antara keduanya."
      Speaker = "Storyteller"
      Event = "Inspect_G_Intro_02"
    }
    {
      Id = "MelinoeField_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dua jurang kegelapan yang saling bersisian..."
      Speaker = "Melinoe"
      Event = "Inspect_G_Intro_02"
    }
    {
      Id = "MelinoeField_5026"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, para Moirae, di mana kalian...?"
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_5692"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan takut, kalian bertiga... kami akan menemukan kalian..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4601"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa ini lagu yang berbeda...?"
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4602"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nada yang asing..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4600"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Belum pernah dengar yang ini sebelumnya..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_0802"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nyanyian itu..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_0803"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lagu itu lagi..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Latihan terus saja sana, Scylla..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepian Oceanus..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bau air asin itu..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Udaranya pekat..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bau tengik itu lagi..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya kakiku jadi bersih..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Brr{#Prev}, dingin sekali..."
      Speaker = "Melinoe"
      Event = "G_Intro.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bahkan arus sungai paling tenang sekalipun di Dunia Bawah senantiasa tunduk mengantar sang Pendayung Jiwa... ke mana pun ia hendak pergi."
      Speaker = "Storyteller"
      Event = "Inspect_G_Shop01_01"
    }
    {
      Id = "MelinoeField_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Syukurlah dia bersedia datang kemari."
      Speaker = "Melinoe"
      Event = "Inspect_G_Shop01_01"
    }
    {
      Id = "Storyteller_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Segala yang melata, merembes, dan merayap, semuanya berkembang biak di tengah udara busuk dan tekanan dahsyat di dekat dasar samudra."
      Speaker = "Storyteller"
      Event = "Inspect_G_MiniBoss01_01"
    }
    {
      Id = "MelinoeField_0223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Udaranya jelas makin pengap di bawah sini..."
      Speaker = "Melinoe"
      Event = "Inspect_G_MiniBoss01_01"
    }
    {
      Id = "Storyteller_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bagaikan tikus-tikus permukaan yang lari dari kapal karam, begitu pula hama Dunia Bawah mencari sudut-sudut yang lebih gelap di alam mereka, di tengah kekacauan zaman ini."
      Speaker = "Storyteller"
      Event = "Inspect_G_MiniBoss_02_01"
    }
    {
      Id = "MelinoeField_0224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Susah juga jadi hewan pengerat..."
      Speaker = "Melinoe"
      Event = "Inspect_G_MiniBoss_02_01"
    }
    {
      Id = "Storyteller_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ada makhluk-makhluk yang terlahir dari mimpi buruk dan lautan, yang terapung abadi menuju kematian dan pembusukan, hingga tak ayal selalu bermuara tepat di tempat ini."
      Speaker = "Storyteller"
      Event = "Inspect_G_MiniBoss03_01"
    }
    {
      Id = "MelinoeField_3260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya aku baru saja menginjak salah satunya..."
      Speaker = "Melinoe"
      Event = "Inspect_G_MiniBoss03_01"
    }
    {
      Id = "Storyteller_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di samudra Oceanus yang hitam dan kelam di balik perbatasan Dunia Bawah, air busuk disucikan kembali, seolah menegaskan bahwa di sana, Poseidon tak berkuasa sama sekali.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_G_Reprieve01_01"
    }
    {
      Id = "MelinoeField_0226"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selama Berkah miliknya masih bekerja, kurasa bukan masalah..."
      Speaker = "Melinoe"
      Event = "Inspect_G_Reprieve01_01"
    }
    {
      Id = "Storyteller_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kilau bak cermin dari air tenang di sekeliling menampakkan wujud asli para penghuni Oceanus seutuhnya; entah membuat mereka ngeri, atau justru girang.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_G_Story01_01"
    }
    {
      Id = "MelinoeField_0227"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pemandangan ini sungguh tidak sedap dipandang..."
      Speaker = "Melinoe"
      Event = "Inspect_G_Story01_01"
    }
  ]
}
