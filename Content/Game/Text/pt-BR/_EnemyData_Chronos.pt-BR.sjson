    }
    {
      Id = "Chronos_1486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarilah dan selesaikan apa yang dimulai ayahmu, Cucu Perempuan!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1487"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan coba perhatikan sekelilingmu baik-baik..."
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tanyakan pada dirimu... menurutmu di mana kau berada sekarang?"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atau mungkin pertanyaan yang lebih tepat adalah {#Emph}kapan?"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1490"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebenarnya apa yang menurutmu sedang kau lihat?"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1491"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menurutmu siapa sebenarnya diriku ini? Kau pikir aku siapa?!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1492"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan bagaimana bisa kau {#Emph}berpikir {#Prev}bahwa {#Emph}kau {#Prev}mampu membawa kehancuran bagiku?!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1493"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi silakan saja, {#Emph}cobalah{#Prev}! Atau {#Emph}lakukan {#Prev}saja sekalian, itu lebih baik!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1494"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hentikan seisi dunia terkutuk ini hingga menjerit kaku!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1495"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lebih baik begitu daripada membiarkan dunia ini di tangan orang-orang ceroboh!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1496"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau justru memberikanku suatu {#Emph}kebaikan!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1497"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan meringankan bebanku dari begitu banyak kerepotan."
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1498"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, {#Emph}hentikan {#Prev}aku!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1499"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi pahamilah satu hal..."
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1500"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan {#Emph}selalu {#Prev}berada selangkah di depanmu!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1501"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di depan kalian {#Emph}semua!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1502"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan ingatlah selalu..."
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1503"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu adalah satu-satunya hal dalam hidup ini... yang sekali disia-siakan..."
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_1504"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}tak akan pernah bisa kembali!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_0988"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kesabaranku... ada {#Emph}batasnya!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_0989"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku... sudah... {#Emph}cukup muak!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_0990"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu... takkan bisa... {#Emph}dihentikan!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_0991"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah... benar-benar... {#Emph}cukup!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_0992"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gadis... kurang ajar... {#Emph}bodoh!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_0993"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua... akan kembali... jadi {#Emph}debu!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_0994"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini... sungguh tak... {#Emph}mungkin!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_0995"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Inilah... akhir... {#Emph}segalanya!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "Chronos_0996"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mau melihat Akhir Waktu? {#Emph}Rasakan {#Prev}ini!"
      Speaker = "Chronos"
      Event = "Chronos.NextPhaseVoiceLines"
    }
    {
      Id = "MelinoeField_5577"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hasil akhir ini bukan lagi sekadar mimpi belaka."
      Speaker = "Melinoe"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "MelinoeField_5578"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenangan sepahit ini akan memudar seiring berjalannya waktu..."
      Speaker = "Melinoe"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0275"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu... takkan bisa... dihentikan...!"
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1451"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ingat... baik-baik... kata-kataku..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0277"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi, Waktu... takkan bisa... dihentikan..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1447"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tinggalkan... aku... sendiri..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1450"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kelak... kau... akan lihat..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1454"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa... maksud dari... semua ini...?"
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1457"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masa depan... keluarga... aku..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0276"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu... takkan bisa... dihentikan..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0278"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau... takkan pernah... berhasil..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0279"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah, haha, hahah..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0280"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hahaha, hah, hah..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan... selalu... kembali..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0283"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana ini... bisa terjadi...?"
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0284"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan... gegabah mengira... kau menang..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0285"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pikir... kau sudah... unggul...?"
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0286"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terkutuklah... semua... keturunanku...!"
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0288"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hal ini... takkan pernah... kulupakan..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0289"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekali lagi... kau mengalahkanku..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0290"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan... kuingat... ini..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0282"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada dewa... yang sanggup... menaklukkanku..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutuklah dirimu... beserta semua... dewa-dewi itu..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nrrraaaaauugggghhhh...!"
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1365"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang sedang terjadi padaku...?"
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Penyusup keparat! {#Prev}Bagaimana bisa kau..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1367"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa, aku... merasa... sangat aneh..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu... tak mungkin... bisa..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang telah kau perbuat padaku...?"
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sengatan dari sabit milikku sendiri..."
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_1371"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau, yang melakukan ini padaku, bagaimana...?"
      Speaker = "Chronos"
      Event = "Chronos.DefeatedVoiceLines"
    }
    {
      Id = "Chronos_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masuk seenaknya sendiri, rupanya. Lewat selokan? Keluarga ini memang tidak pernah punya tata krama! Meski aku sedang berusaha membenahinya di dalam Griya ini, jika kau sudi memaklumi semua {#Emph}debu {#Prev}ini. Kami baru saja melakukan sedikit {#Emph}renovasi {#Prev}di sekitar sini."
      Speaker = "Chronos"
      Event = "ChronosBossFirstMeeting"
    }
    {
      Id = "MelinoeField_1311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berdiri. Singkirkan pantatmu dari singgasana curian itu! Kau tahu siapa diriku, dan kau tahu tujuanku ke sini."
      Speaker = "Melinoe"
      Event = "ChronosBossFirstMeeting"
    }
    {
      Id = "Chronos_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga tanpa martabat, dan tanpa kesantunan pula. Bukankah sudah kuperjelas padamu bahwa usahamu untuk mencelakaiku hanya akan sia-sia? Aku adalah seorang {#Emph}Titan {#Prev}abadi. Kau hanyalah seorang {#Emph}gadis kecil {#Prev}malang yang tersesat."
      Speaker = "Chronos"
      Event = "ChronosBossFirstMeeting"
    }
    {
      Id = "MelinoeField_1312"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Dengarkan aku, hai musuh Malam dan Kegelapan; \n {#Emph}Atas segala dosamu, kini ajal menunggumu; \n {#Emph}Di bawah doktrin cthonic, ini kuikrarkan! \n {#Emph}Karena tiada yang lolos dari Takdir di bawah langit biru."
      Speaker = "Melinoe"
      Event = "ChronosBossFirstMeeting"
    }
    {
      Id = "Chronos_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jaga mulutmu! {#Prev}Mengutuk dilarang keras di Griya ini. Mengingat hal itu, {#Emph}berkelahi {#Prev}pun sama terlarangnya. Tapi khusus untukmu, gadis kecil? Kita terpaksa membuat pengecualian. {#Emph}Waktunya {#Prev}bagimu untuk {#Emph}enyah."
      Speaker = "Chronos"
      Event = "ChronosBossFirstMeeting"
    }
    {
      Id = "Chronos_0456"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saksikanlah!"
      Speaker = "Chronos"
      Event = "ChronosBossFirstMeeting"
    }
    {
      Id = "MelinoeField_1313"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mampuslah Chronos!"
      Speaker = "Melinoe"
      Event = "ChronosBossFirstMeeting"
    }
    {
      Id = "Chronos_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakanlah, siapa gerangan dirimu, gadis kecil? Sudah lama aku tidak menerima tamu belakangan ini. Barangkali setelah Griya ini sedikit lebih layak pandang... meski untuk saat ini, kau harus maklum dengan semua debu ini. Kami baru saja melakukan sedikit {#Emph}renovasi {#Prev}di sekitar sini."
      Speaker = "Chronos"
      Event = "ChronosBossFirstMeeting_B"
    }
    {
      Id = "Chronos_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, kejutan yang luar biasa. Cucu perempuanku! Satu-satunya urusan tersisa yang luput kutuntaskan, kini sudah dewasa seutuhnya, hampir. Ada begitu banyak pertanyaan yang ingin kuajukan, jika kau tak keberatan. Bagaimana kabarmu? Dan bagaimana persisnya kau bisa menemukanku di sini?"
      Speaker = "Chronos"
      Event = "ChronosBossFirstMeeting_B"
    }
    {
      Id = "Chronos_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seorang tamu, tiba secepat ini! Sudah lama aku tidak menerima tamu belakangan ini. Barangkali setelah Griya ini sedikit lebih layak pandang... meski untuk saat ini, kau harus maklum dengan semua debu ini. Kami baru saja melakukan sedikit {#Emph}renovasi {#Prev}di sekitar sini."
      Speaker = "Chronos"
      Event = "ChronosBossFirstMeeting_C"
    }
    {
      Id = "Chronos_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, Cucu Perempuan. Tak perlu terburu-buru begitu! Kau sudah menempuh perjalanan sejauh ini. Dan aku punya begitu banyak pertanyaan. Bagaimana kabarmu? Dan bagaimana persisnya kau bisa menemukanku di sini?"
      Speaker = "Chronos"
      Event = "ChronosBossFirstMeeting_C"
    }
    {
      Id = "Chronos_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sempat lolos dari genggamanku sebelumnya, hanya untuk kembali dan memberiku kesempatan lain untuk menambahkanmu ke dalam koleksiku? Apakah Athena benar-benar memborong semua kebijaksanaan di keluarga kita?"
      Speaker = "Chronos"
      Event = "ChronosBossLostAgainstHim01"
    }
    {
      Id = "MelinoeField_1314"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Koleksimu... {#Prev}kau menganggap darah dagingmu sendiri bagai barang pajangan. Para dewa seharusnya memajang {#Emph}dirimu {#Prev}setelah mencincangmu berkeping-keping, bukannya membuangmu begitu saja layaknya kotoran tak berguna."
      Speaker = "Melinoe"
      Event = "ChronosBossLostAgainstHim01"
    }
    {
      Id = "Chronos_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, aku masih agak kesal mengingat hal itu. Kupikir anak-anakku akan berbeda; bahwa mereka akan menunjukkan sedikit rasa hormat pada orang tua. Tapi nyatanya tidak. Dan batas kesabaranku... ada batasnya."
      Speaker = "Chronos"
      Event = "ChronosBossLostAgainstHim01"
    }
    {
      Id = "Chronos_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Matamu tidak salah lihat; aku masih bugar dan sebugar yang kubisa! Perasaan hampa yang pasti kau rasakan setelah pertemuan kita sebelumnya? Ketakutan akan kesia-siaan mutlak dari seluruh usahamu ini? Sekarang kau tahu bahwa itu nyata."
      Speaker = "Chronos"
      Event = "ChronosBossWonAgainstHim01"
    }
    {
      Id = "MelinoeField_1315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang tak pernah berencana menghancurkanmu hanya dalam satu bentrokan. Kau, lebih dari siapa pun, seharusnya tahu bahwa hasil yang berharga itu butuh waktu."
      Speaker = "Melinoe"
      Event = "ChronosBossWonAgainstHim01"
    }
    {
      Id = "Chronos_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, jadi kau berniat membiasakan diri muncul tanpa tata krama seperti {#Emph}ini! {#Prev}Seolah-olah semua itu akan membuahkan hasil pada akhirnya. Baiklah. Dari sisiku sendiri, terkadang aku memang butuh sedikit meregangkan otot-ototku."
      Speaker = "Chronos"
      Event = "ChronosBossWonAgainstHim01"
    }
    {
      Id = "Chronos_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau seharusnya melihat betapa mengerikannya rupa tempat ini saat aku pertama kali tiba! Atau, kurasa kau {#Emph}sempat {#Prev}melihatnya, tapi masih terlalu kecil untuk mengingatnya. Kupikir sekarang tempat ini sudah sedikit lebih layak pandang. Namun kau malah menerobos masuk, mengotori lantai dengan jejak darah dan debu busuk."
      Speaker = "Chronos"
      Event = "ChronosBossAboutHouse01"
    }
    {
      Id = "MelinoeField_1316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kusampaikan permintaan maafku pada staf kebersihanmu. Lain kali, aku akan berusaha tampil sedikit lebih rapi saat tiba."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutHouse01"
    }
    {
      Id = "Chronos_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau meluapkan ironi yang getir; tapi lihatlah dirimu sendiri! Datang menghadapku dalam kondisi yang lebih pantas disebut mati daripada hidup. Yah, semakin cepat aku melemparmu keluar, semakin cepat pula {#Emph}staf kebersihanku {#Prev}bisa mulai berbenah."
      Speaker = "Chronos"
      Event = "ChronosBossAboutHouse01"
    }
    {
      Id = "Chronos_0609"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau menikmati sesi renangmu? Sungai Styx dulunya mengalir melintasi tempat ini bagaikan darah. Sisa-sisa busuknya masih tertinggal di Padang di atas sana, tapi sekarang di sekelilingku, semuanya hanyalah butiran emas murni."
      Speaker = "Chronos"
      Event = "ChronosBossAboutStyx01"
    }
    {
      Id = "MelinoeField_2021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sampai mengubah Sungai Styx itu sendiri hanya demi memuaskan seleramu? Atau mungkin telingaku yang salah dengar. Barangkali masih terlalu banyak butiran emasmu yang menyumbat telingaku."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutStyx01"
    }
    {
      Id = "Chronos_0610"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pantas saja kau kesulitan mendengarkanku. Kendati demikian, aku yakin apa yang hendak kusampaikan sekarang akan terdengar sangat lantang dan jelas."
      Speaker = "Chronos"
      Event = "ChronosBossAboutStyx01"
    }
    {
      Id = "Chronos_0603"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sibuk sekali di permukaan, bukan begitu? Menyaksikan sendiri armada perkasa yang berlayar menuju kemenangan mutlak, dan kehancuran gunung para dewa."
      Speaker = "Chronos"
      Event = "ChronosBossAboutThessaly01"
    }
    {
      Id = "MelinoeField_1951"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu-satunya armada yang kulihat di atas sana hanyalah rongsokan reyot yang awaknya bahkan nyaris tak sanggup berdiri, apalagi bertarung. Pantas saja kau masih gagal merebut Olympus sampai sekarang."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutThessaly01"
    }
    {
      Id = "Chronos_0604"
      InheritFrom = "BaseNarrative"
      DisplayName = "Armadaku mungkin tidak sesuai dengan standarmu, gadis kecil; tapi mereka punya satu sifat penting yang sama sekali tidak dimiliki para dewa: Mereka setia kepada-{#Emph}ku {#Prev}sampai titik darah penghabisan. Akhir mana pun yang {#Emph}kukehendaki!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutThessaly01"
    }
    {
      Id = "Chronos_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlalu muda untuk memahami bagaimana keadaannya dulu. Sebelum para dewa merombak dunia menjadi seperti ini. Manusia fana tak perlu mati dalam penderitaan dan membusuk di dalam {#Emph}jurang nista {#Prev}ini. Zaman yang jauh lebih sederhana, dan segalanya jauh lebih baik karenanya."
      Speaker = "Chronos"
      Event = "ChronosBossAboutGoldenAge01"
    }
    {
      Id = "MelinoeField_1318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jauh lebih baik, hanya karena kau mengendalikan setiap jengkalnya, begitu maksudmu? Kau tak tahan melihat orang lain punya pandangan berbeda dari dirimu sendiri. Kau mengobarkan perang melawan anak-anak kandungmu sendiri! Bahkan setelah menelan mereka bulat-bulat, begitu kata orang."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutGoldenAge01"
    }
    {
      Id = "Chronos_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Orang-orang membual banyak hal! {#Emph}Merekalah {#Prev}yang mengobarkan perang terhadap-{#Emph}ku. {#Prev}Keturunanku dan tanggunganku yang lain tak selalu mempan diberi disiplin; terlalu banyak yang harus kuawasi untuk meladeni kelancangan satu per satu dari mereka. Dan {#Emph}kau{#Prev}, gadis kecil, sama sekali tak berhak mendapatkan perlakuan lebih."
      Speaker = "Chronos"
      Event = "ChronosBossAboutGoldenAge01"
    }
    {
      Id = "Chronos_0501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang kau pasti sudah melihat sebagian dari dunia ini. Renungkanlah apa yang telah diperbuat para dewa: perang, kelaparan, pengkhianatan! Di Zaman Keemasanku, tiada kekhawatiran semacam itu. Zaman itu sungguh damai... sampai para dewa memutuskan untuk merebut kekuasaan secara paksa!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutGoldenAge02"
    }
    {
      Id = "MelinoeField_1504"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kekuasaanmu tidaklah sesempurna yang kau koar-koarkan. Mungkin kehadiranmu begitu mencekik anak-anakmu dan generasi mereka, hingga mereka tak punya pilihan lain selain menyingkirkanmu."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutGoldenAge02"
    }
    {
      Id = "Chronos_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, mereka {#Emph}gagal! {#Prev}Dan inilah kesempatan emas untuk memberi {#Emph}anak-anakku dan generasi mereka {#Prev}sebuah pelajaran paling berharga tentang menanggung konsekuensi atas perbuatan mereka!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutGoldenAge02"
    }
    {
      Id = "Chronos_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasukanku kini mengenalmu dengan baik; segala kekacauan yang kau perbuat. Namun hanya pengikutku yang paling setia yang boleh menumpahkan darah mereka di dalam aulaniku."
      Speaker = "Chronos"
      Event = "ChronosBossAboutSatyrs01"
    }
    {
      Id = "MelinoeField_1500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Satir pemujamu ini pasti merasa sangat terhormat menjadi yang pertama mati di sini. Meski begitu, mereka bukan makhluk yang paling bijak, bukan?"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutSatyrs01"
    }
    {
      Id = "Chronos_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum bijak tidak mengekor; kaum bijak {#Emph}memimpin. {#Prev}Para Satir ini tak punya rasa takut fana akan kematian, mereka percaya bahwa pengorbanan mereka akan memberiku kekuatan dan mereka akan hidup abadi. Mari kita {#Emph}kabulkan {#Prev}keinginan mereka."
      Speaker = "Chronos"
      Event = "ChronosBossAboutSatyrs01"
    }
    {
      Id = "Chronos_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Alur sejarah adalah kuasaku untuk ditempa. Namun kau terus menggangguku, seolah-olah ingin melakukannya menggantikanku. Baiklah, maumu apa? Apa aku harus langsung menyerahkan takhta sahku ini?"
      Speaker = "Chronos"
      Event = "ChronosBossAboutHistory01"
    }
    {
      Id = "MelinoeField_1403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tidak menentukan alur sejarah... kau adalah Waktu. Kau hanyalah batu pijakan yang kami lewati di sepanjang jalan. Alih-alih membalas dendam pada para dewa, kau sebenarnya membalas dendam pada para Moira, yang tahu tempatmu yang semestinya dalam semua ini."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutHistory01"
    }
    {
      Id = "Chronos_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya, aku memang punya urusan dengan para Moira. Meskipun mereka tak semestinya menjadi urusan{#Emph}mu{#Prev}, atau urusan siapa pun. Bayangkan, kini kau bebas mengambil keputusan sendiri, tapi malah mendambakan beban kuk mereka di punggungmu! Betapa {#Emph}menyedihkan."
      Speaker = "Chronos"
      Event = "ChronosBossAboutHistory01"
    }
    {
      Id = "Chronos_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa depan belum terajut; serba tak pasti. Bahkan para Moira sendiri tak bisa menduga bagaimana semua ini akan berakhir, atau {#Emph}kapan. {#Prev}Namun kau terus memaksakan diri."
      Speaker = "Chronos"
      Event = "ChronosBossAboutFuture01"
    }
    {
      Id = "MelinoeField_1502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kau selalu mengagungkan keniscayaan. Entah akhir dari semua ini sudah diramalkan atau belum, aku akan menuntaskannya. Anggap saja ini rasa penasaran yang wajar."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutFuture01"
    }
    {
      Id = "Chronos_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kusebut itu kenekatan belaka, tak lebih. Kau gagal mempertimbangkan sekian banyak kemungkinan di mana kau terbukti tak mampu menikmati buah jerih payahmu..."
      Speaker = "Chronos"
      Event = "ChronosBossAboutFuture01"
    }
    {
      Id = "Chronos_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu saat berlalu... lalu satu lagi, dan satu lagi. Aku punya nama untuk setiap ukurannya, kau tahu? Yang teramat singkat. Yang terasa berlarut-larut..."
      Speaker = "Chronos"
      Event = "ChronosBossAboutTime01"
    }
    {
      Id = "MelinoeField_1503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau sudah selesai mengoceh, kuusahakan tidak memakan waktu lebih dari beberapa momen singkat yang kausebut tadi."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutTime01"
    }
    {
      Id = "Chronos_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham perlunya memotong {#Emph}Waktu {#Prev}menjadi kepingan-kepingan yang lebih kecil, sungguh. Jam, dipotong menjadi menit. Menit, dipotong menjadi detik. Karena keseluruhannya, Gadisku... {#Emph}terlalu luar biasa untuk dipahami."
      Speaker = "Chronos"
      Event = "ChronosBossAboutTime01"
    }
    {
      Id = "Chronos_0503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benda {#Emph}mencolok {#Prev}apa {#Emph}gerangan {#Prev}yang kaupakai untuk mencoba melukaiku itu? Jangan-jangan itu semacam {#Emph}perkakas {#Prev}yang diharapkan para Moira secara sia-sia dapat melenyapkanku!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutWeapons01"
    }
    {
      Id = "MelinoeField_1505"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah harapan mereka {#Emph}sia-sia {#Prev}atau tidak, masih belum terbukti. Senjata ini mungkin bukan senjata yang dulu dipakai para dewa untuk menjatuhkanmu, tapi khasiatnya akan tetap sama. Perhatikan saja."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutWeapons01"
    }
    {
      Id = "Chronos_0504"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kami akan melakukan lebih dari sekadar {#Emph}memperhatikan{#Prev}, aku dan Hrodreptus. Sabit milikku ini bukan sekadar untuk memotong gandum di Padang Kedukaan, sembari memulangkan sang Anjing Neraka..."
      Speaker = "Chronos"
      Event = "ChronosBossAboutWeapons01"
    }
    {
      Id = "Chronos_0901"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang benda aneh {#Emph}apa {#Prev}lagi yang kaurakit dan kaupakai itu? Sayang sekali bahkan {#Emph}aku {#Prev}pun tak sanggup mengimbangi kalian para bocah bau kencur dengan tren busana yang membingungkan ini."
      Speaker = "Chronos"
      Event = "ChronosBossAboutSuit01"
    }
    {
      Id = "MelinoeField_3325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, ini Mantel Hitam. Aku memakainya bukan demi gaya, meski kau memang benar soal takkan mampu mengimbanginya."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutSuit01"
    }
    {
      Id = "Chronos_0902"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu percaya diri dengan kemampuanmu, atau pada rancangan para Moira. Tapi ketahuilah, persenjataan baru yang aneh seperti itu takkan bisa menandingi yang klasik."
      Speaker = "Chronos"
      Event = "ChronosBossAboutSuit01"
    }
    {
      Id = "Chronos_1384"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benda berkilau emas apa yang kaubawa itu? Astaga, itu milik{#Emph}ku! {#Prev}Salah satu Mahakarya Waktu terbaikku...! Dasar {#Emph}pencuri! {#Prev}Dan kini kau begitu lancang membawanya ke mari?"
      Speaker = "Chronos"
      Event = "ChronosBossAboutKeepsake01"
    }
    {
      Id = "MelinoeField_5027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku bukan {#Emph}pencuri{#Prev}. Ini sebuah {#Emph}hadiah! {#Prev}Tapi tak perlu kita perdebatkan. Waktuku tidak banyak malam ini. Begitu pula dirimu."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutKeepsake01"
    }
    {
      Id = "Chronos_1385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh kelancangan yang mencengangkan. Waktuku di dunia ini melimpah ruah! Namun {#Emph}kau{#Prev}, Gadisku, {#Emph}waktumu hampir habis."
      Speaker = "Chronos"
      Event = "ChronosBossAboutKeepsake01"
    }
    {
      Id = "Chronos_0607"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mengenali bilah yang kaubawa itu: Sabit milik Kematian itu sendiri! Sayang sekali ia sedang tak memegangnya saat aku menjebaknya dalam perangkapku, bersama para penghuni Rumah ini sebelumnya."
      Speaker = "Chronos"
      Event = "ChronosBossAboutThanatosAspect01"
    }
    {
      Id = "MelinoeField_1953"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin telah menawan sang Kematian, namun ajal telah tiba menjemputmu. Alangkah adilnya jika kau menemui ajalmu di ujung Zorephet."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutThanatosAspect01"
    }
    {
      Id = "Chronos_0608"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemungkinannya sangat kecil, kupikir. Kalau begitu mari kita adu sekarang, sabit lawan sabit! Zorephet milikmu melawan Hrodreptus milikku. Dan sebentar lagi kita akan menyaksikan siapa yang menuai, dan siapa yang menyemai."
      Speaker = "Chronos"
      Event = "ChronosBossAboutThanatosAspect01"
    }
    {
      Id = "MelinoeField_1506"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf aku terlambat, aku harus berurusan dengan beberapa cecunguk. Kukira kau melepaskan semua orang, terlepas dari kesalahan mereka di masa lalu."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutWretches01"
    }
    {
      Id = "Chronos_0505"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku melepaskan hampir semua orang, ya. Namun kau mungkin akan terkejut saat mengetahui bahwa sebagian dari kaum yang disebut {#Emph}cecunguk {#Prev}itu sebenarnya tidak begitu menyukai Hades. Mereka sangat antusias untuk melayaniku sebagai gantinya, saat kuminta baik-baik. Kalau denganmu, aku bahkan tak sudi repot-repot memintanya."
      Speaker = "Chronos"
      Event = "ChronosBossAboutWretches01"
    }
    {
      Id = "MelinoeField_1508"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau begitu membenci generasi ayahku. Lalu bagaimana dengan generasimu? Aku tak melihat banyak rekan sezamanmu yang bersatu demi perjuanganmu, atau demi hal lain apa pun."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutTitans01"
    }
    {
      Id = "Chronos_0507"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kau tahu sendiri, sebagian besar Titan lainnya telah tewas, sama sepertiku dulu. Ulah perbuatan ayahmu dan {#Emph}generasinya! {#Prev}Mungkin jika semua ini sudah beres, aku akan mengurus kebangkitan rekan-rekan sezamanku! Ya, beberapa dari mereka."
      Speaker = "Chronos"
      Event = "ChronosBossAboutTitans01"
    }
    {
      Id = "MelinoeField_1509"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bangkitlah, cecunguk. Titan. {#Emph}Paduka Tuan Chronos. {#Prev}Terserah apa pun mereka memanggilmu sekarang. Sudah {#Emph}waktunya{#Prev}, seperti yang biasa kaukatakan."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutOrigin01"
    }
    {
      Id = "Chronos_0508"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang sudah waktunya. Dan mereka telah memanggilku dengan banyak sebutan; banyak nama, di zaman purba kala. Ada orang-orang yang menganggapku tak lebih dari sekadar keturunan Langit dan Bumi, berani-beraninya mereka {#Emph}berpikir begitu. {#Prev}Dan kau bahkan jauh lebih tidak sopan daripada {#Emph}mereka."
      Speaker = "Chronos"
      Event = "ChronosBossAboutOrigin01"
    }
    {
      Id = "Chronos_0550"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernahkah sesekali kau mengagumi roda-roda gigi yang terus berputar di Tartarus? Sumbangsih kecilku bagi rancangan Dunia Bawah; sarana yang ajek untuk menggerakkan segalanya. Kusebut itu {#Emph}mesin jam. {#Prev}Siklus tiada akhir! Mirip seperti pergantian musim."
      Speaker = "Chronos"
      Event = "ChronosBossAboutClockwork01"
    }
    {
      Id = "MelinoeField_1594"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ke sini bukan untuk bertamasya. {#Emph}Mesin jam {#Prev}itu jelas hanya bisa berasal dari {#Emph}dirimu. {#Prev}Pemandangan yang menyakitkan mata, tak bertujuan, dan terus mengerang sepanjang jalan."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutClockwork01"
    }
    {
      Id = "Chronos_0551"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak {#Emph}bertujuan? {#Prev}Seseorang yang memiliki kemampuan sihir semestinya punya pemahaman yang lebih mendalam tentang dunia ini! Kita selalu bergerak menuju {#Emph}suatu tempat; {#Prev}menuju {#Emph}masa depan{#Prev}, Gadisku! Menuju {#Emph}masa depan."
      Speaker = "Chronos"
      Event = "ChronosBossAboutClockwork01"
    }
    {
      Id = "Chronos_0554"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau mencatat Waktu dengan saksama; hal-hal seperti itu tentu saja terbaca jelas olehku. Namun alasan di baliknya, hampir tak bisa kutebak. Mungkinkah untuk mengukur, seberapa cepat kau akan tumbang?"
      Speaker = "Chronos"
      Event = "ChronosBossAboutGameplayTimer01"
    }
    {
      Id = "MelinoeField_1596"
      InheritFrom = "BaseNarrative"
      DisplayName = "Antara aku atau dirimu. Jadi, berapa banyak waktu yang kita butuhkan di sini malam ini? Dengan segala kebijaksanaanmu, kau pasti mengetahuinya."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutGameplayTimer01"
    }
    {
      Id = "Chronos_0555"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kurasa ini hanya butuh waktu {#Emph}sekejap mata!{#Prev} Belum menjadi tolok ukur resmi, meski mungkin itu pun akan segera berubah..."
      Speaker = "Chronos"
      Event = "ChronosBossAboutGameplayTimer01"
    }
    {
      Id = "Chronos_0556"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhenti mengukur seberapa cepat kita bisa menyelesaikan perselisihan kita. Apa itu terlalu berat bagimu? Menyadari betapa tak terhindarkannya langkahmu menuju ketidakpastian?"
      Speaker = "Chronos"
      Event = "ChronosBossAboutGameplayTimer02"
    }
    {
      Id = "MelinoeField_1597"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku dewi abadi Dunia Bawah. Waktu tak ada artinya bagiku. Aku bisa meladeni ini selamanya."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutGameplayTimer02"
    }
    {
      Id = "Chronos_0557"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah begitu? {#Emph}Selamanya {#Prev}adalah waktu yang amat panjang. Kita harus membuat ini berjalan lambat dan menyiksa, demi memuaskan nafsu rakusmu yang tak pernah puas..."
      Speaker = "Chronos"
      Event = "ChronosBossAboutGameplayTimer02"
    }
    {
      Id = "Chronos_0601"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memiliki kuasa yang lumayan atas Waktu, sampai-sampai bisa membalikkan kekuatanku sendiri untuk melawanku! {#Prev}Mungkin bakatmu ini hanyalah sifat bawaan keluarga yang tersembunyi."
      Speaker = "Chronos"
      Event = "ChronosBossAboutPausing01"
    }
    {
      Id = "MelinoeField_1950"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan menghinaku, dan jangan membohongi dirimu sendiri. Saat kau merenggut keluargaku, kau menanamkan hasrat seumur hidup dalam diriku untuk menghancurkanmu. Jadi, aku hanya bersiap."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutPausing01"
    }
    {
      Id = "Chronos_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hasrat seumur hidup. Hidupmu{#Prev}, Nak, hanyalah sekejap mata bagiku! {#Prev}Tak ada yang bisa meraih kemampuan seperti milikmu hanya lewat tekad belaka. Lagipula kau bukan sekadar {#Emph}dewa{#Prev}; kau adalah seorang {#Emph}penyihir."
      Speaker = "Chronos"
      Event = "ChronosBossAboutPausing01"
    }
    {
      Id = "Chronos_0905"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang sungguh di luar dugaan! Pasukanku bertarung begitu sengit melawanmu, namun entah bagaimana tetap gagal membendungmu... Sepertinya aku harus menegur mereka."
      Speaker = "Chronos"
      Event = "ChronosBossAboutShrine01"
    }
    {
      Id = "MelinoeField_3327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka tetap akan lebih takut kepadaku daripada kepadamu. Melewati semua rintangan yang kau tebar ini, kekuatanku kian bertambah. Dan saat kau binasa nanti, kehendak Sang Malam akhirnya akan terpenuhi."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutShrine01"
    }
    {
      Id = "Chronos_0906"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bicara persis seperti pengikut tanpa otak. Gadis kecil, kau tak ada bedanya dengan para cecunguk yang selalu gagal menjalankan perintahku... dan kau akan kuperlakukan dengan cara yang sama."
      Speaker = "Chronos"
      Event = "ChronosBossAboutShrine01"
    }
    {
      Id = "Chronos_1237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengaruh buruk Chaos ada di sini... benar-benar tak masuk akal! Jadi, apa kau telah memengaruhi Sang Pencipta Purba hingga mengira aku mencuranginya dalam kesepakatan kami? Nyx dan Tiga Fates, sia-sia belaka!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutRandomBounties1"
    }
    {
      Id = "MelinoeField_3807"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chaos memang menunjukkan rasa tidak senangnya. Tapi efek yang kau rasakan itu tidak menguntungkanku lebih banyak daripada dirimu. Kita sedang membicarakan entitas yang benar-benar netral."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutRandomBounties1"
    }
    {
      Id = "Chronos_1238"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Netral{#Prev}, katamu? Makhluk berakal takkan pernah bisa netral! Begitu Chaos mulai memikirkan sesuatu, mereka menanggalkan kenetralan itu untuk selamanya! Dan yang pasti, mereka sama sekali tidak berpihak {#Emph}padaku."
      Speaker = "Chronos"
      Event = "ChronosBossAboutRandomBounties1"
    }
    {
      Id = "Chronos_1273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau tiba-tiba sampai di sini? Aku bukan tipe yang mudah dikejutkan, kecuali... kehendak Chaos ikut campur dalam hal ini. Berani-beraninya kau bersekutu dengan entitas seperti itu!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutRandomBounties02"
    }
    {
      Id = "MelinoeField_4127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh yang kau ciptakan sangatlah kuat, Titan. Masih banyak kejutan serupa yang menantimu, atas semua perbuatan yang telah kau lakukan."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutRandomBounties02"
    }
    {
      Id = "Chronos_1274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, begitu pula sebaliknya, Cucu Perempuan! Meneroboslah sesukamu. Kau tak mencapai apa pun selain menuruti kehendak Chaos semata!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutRandomBounties02"
    }
    {
      Id = "Chronos_1386"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kau{#Prev}, dengan segala dendam di kepalamu, mengaku tak peduli pada keluarga yang kurenggut darimu! {#Emph}Bagus{#Prev}, karena kau {#Emph}memang {#Prev}tidak melewatkan banyak hal! Mereka pun sama sekali tak peduli pada {#Emph}keluarga kita!{#Prev} Membiarkanku {#Emph}membusuk! {#Prev}Kau {#Emph}tak ada bedanya!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily01"
    }
    {
      Id = "MelinoeField_5043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya kau yang peduli mendalam pada keluarga kita, begitu maksudmu? Ayolah. Mereka membiarkanmu membusuk karena kau sendiri yang memberi mereka alasan untuk membencimu."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutFamily01"
    }
    {
      Id = "Chronos_1401"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cuih! {#Prev}Mereka mengincar kekuatan yang enggan kubagi. Mereka tidak berjuang untuk itu! Seandainya mereka meminta baik-baik, semua ini takkan terjadi. Tapi kesalahan masa lalu tak bisa ditarik kembali."
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily01"
    }
    {
      Id = "Chronos_1436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau seharusnya tak pernah terlibat dalam semua ini, Cucu Perempuan! Kau pasti masih bayi merah saat pertama kali aku tiba di sini, sayang sekali kita terlambat bertemu. Tapi bahkan sampai sekarang, kau masih terlalu muda untuk mengerti."
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily02"
    }
    {
      Id = "MelinoeField_5083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pasti sudah ikut dipenjara bersama yang lain. Tapi coba jelaskan padaku... hal apa yang masih belum kupahami karena aku terlalu muda?"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutFamily02"
    }
    {
      Id = "Chronos_1437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlalu muda untuk memahami rasa kecewa dan campak dicampakkan yang hanya bisa diberikan oleh keluarga. Namun semakin banyak dari kami yang kau temui... semakin kau mengenal kami... kau akan memahaminya lebih cepat."
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily02"
    }
    {
      Id = "Chronos_1438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, aku tidak terbiasa menerima kunjungan yang begitu sering dari sanak saudaraku! Mungkin jika Hades dan yang lainnya sudi bertandang sesering ini, hubungan kami takkan serenggang ini."
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily03"
    }
    {
      Id = "MelinoeField_5084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kunjunganku bukan kunjungan semacam itu. Tapi aku baru tahu kalau kau ternyata cuma kesepian! Apa para pemuja Satyr-mu kurang menghibur sebagai tamu di Graha ini?"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutFamily03"
    }
    {
      Id = "Chronos_1439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka itu pemuja, bukan darah dagingku! Sayang sekali kau terjebak di tengah-tengah perselisihan ini, sampai tidak tahu bedanya punya keluarga di sisimu atau tidak."
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily03"
    }
    {
      Id = "MelinoeField_5085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua ini gara-gara {#Emph}dirimu! {#Prev}Dan gara-gara {#Emph}perselisihanmu {#Prev}ini! Sekarang kau akan binasa atas apa yang telah kau perbuat. Apa semua ini sepadan?"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutFamily03"
    }
    {
      Id = "Chronos_1440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kalau kau menyatakannya {#Emph}seperti itu{#Prev}, {#Emph}tentu tidak! {#Prev}Andai saja aku tak membuat kesalahan, kita takkan berada di sini {#Emph}sekarang{#Prev}, bukan? Jelas bukan sebagai musuh bebuyutan! Namun di sinilah kita, masing-masing menanggung akibat dari masa lalu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily03"
    }
    {
      Id = "MelinoeField_5086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tadi bicara soal akibat dari masa lalu... tentang kesalahanmu sendiri. Namun {#Emph}begini {#Prev}caramu memperbaikinya? Seluruh keluargamu menentangmu...!"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutFamily04"
    }
    {
      Id = "Chronos_1441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang selalu begitu! Satu-satunya perbedaan sekarang adalah jumlah kalian kian {#Emph}banyak{#Prev}, semuanya berbaris menentangku. Kau mau mendepakku dari keluargaku sendiri? Kalau begitu, baiklah! Tapi {#Emph}inilah {#Prev}akibatnya!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily04"
    }
    {
      Id = "MelinoeField_5087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bahkan tidak berniat menguasai Dunia Bawah ataupun permukaan, kan? Kau cuma ingin membalas dendam pada anak-anakmu. Sungguh picik... dan menyedihkan."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutFamily04"
    }
    {
      Id = "Chronos_1442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap generasi berikutnya, selalu lebih cepat menghakimi dibanding sebelumnya! Apa aku ini {#Emph}ayah yang sempurna? {#Prev}Tidak. Kalau iya, anak-anakku pasti sudah sempurna juga! Dan sekarang, kau pun ikut terjerat dalam lingkaran setan ini!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily04"
    }
    {
      Id = "Chronos_1443"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aku {#Prev}tahu kenapa kau terus kembali! Kau mengincar {#Emph}lebih {#Prev}dari sekadar obrolan kita ini, tapi juga Cermin di kamar kumuh di ujung lorong itu... satu-satunya artefak yang tak bisa kugeser sedikit pun! Tapi benda itu {#Emph}tak berguna {#Prev}tanpa kehadiran Sang Malam itu sendiri!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily05"
    }
    {
      Id = "MelinoeField_5206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ke sini bukan demi perabotan lama Graha ini. Asal kau tahu, setidaknya ada satu kerabatmu yang akan sangat terpukul jika kau dihancurkan. Hanya kau yang bisa mencegahnya... jika kau mau mengakhiri semua ini."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutFamily05"
    }
    {
      Id = "Chronos_1458_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, aku berniat mengakhirinya! Tapi kita sudah melangkah terlalu jauh untuk sekadar mencegah kesedihan kerabat {#Emph}antah-berantah {#Prev}yang kau maksud itu! Apa yang sudah terjadi biarlah terjadi, tak ada jalan untuk kembali, persetan dengan penyesalan: itulah {#Emph}hakikat {#Prev}dari Waktu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutFamily05"
    }
    {
      Id = "Chronos_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau melihat ayahmu di luar sana, kan? Dia butuh perlakuan istimewa. Selama berabad-abad, dia memenjarakan jiwa yang tak terhitung jumlahnya di tempat ini; belum lagi {#Emph}aku. {#Prev}Rasanya sangat pantas bila dia membusuk perlahan seperti itu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutHades01"
    }
    {
      Id = "MelinoeField_1317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membungkusnya dengan dalih moralitas, padahal dendam saja sudah cukup jadi alasanmu. Tapi karena kau merasa sangat berhak, atas dasar apa kau menyandera anggota keluargaku yang lain? Nyx dan semua yang tersisa?"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutHades01"
    }
    {
      Id = "Chronos_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja karena mereka menentangku. Hanya saja, kau punya bakat menyebalkan untuk menolak beberapa sihir pusakaku... sifat bawaan keluarga yang terpendam, mungkin. Sayangnya saudaramu... tidak seberuntung itu. Namun, kau pun pasti akan hancur... tak lama lagi."
      Speaker = "Chronos"
      Event = "ChronosBossAboutHades01"
    }
    {
      Id = "Chronos_0495"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hades memakai sisa tenaganya yang sekarat untuk menyemangatimu! Bahkan saat terbelenggu rantai yang tak bisa dihancurkan dewa mana pun, ayahmu masih saja jadi hama pengganggu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutHades02"
    }
    {
      Id = "MelinoeField_1501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah menyiksa dan mempermalukannya. Kau berkoar-koar ingin membangkitkan masa kejayaan yang lampau, tapi dendam picik tampaknya menjadi urusan utamamu."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutHades02"
    }
    {
      Id = "Chronos_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masalahnya, Gadisku, aku bisa mendapatkan {#Emph}keduanya. {#Prev}Seharusnya kau melihat cara kejam dan bengis yang ayahmu pakai untuk menyiksa jiwa fana! Jadi, aku menegakkan semacam keadilan untuk {#Emph}dirinya{#Prev}, dan untuk {#Emph}dirimu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutHades02"
    }
    {
      Id = "Chronos_0547"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}cukup {#Prev}berbahaya, harus kuakui. Kau berulang kali menerobos masuk ke Tartarus, dan ke Rumah ini; hal yang mustahil jika bukan karena garis keturunanmu yang terkutuk! Dan kau sanggup menahan sihirku. Boleh aku bertanya sopan sekali lagi, {#Emph}bagaimana {#Prev}caranya?"
      Speaker = "Chronos"
      Event = "ChronosBossAboutMelinoe01"
    }
    {
      Id = "MelinoeField_1592"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sebut itu {#Emph}sopan? {#Prev}Kau bahkan tidak mengucapkan kata tolong. Tapi karena kau begitu ingin tahu... aku datang dari masa depan. Nanti kau akan menyadari kesalahanmu, lalu mengajariku cara menghentikanmu sebelum kau berbuat lebih banyak kerusakan."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutMelinoe01"
    }
    {
      Id = "Chronos_0548"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hahaha! {#Prev}Oh, dongeng yang sangat imajinatif. Sebuah komedi, karena premis yang kelewat konyol itu benar-benar tak masuk akal! Gadisku, tak seorang pun bisa mundur melintasi {#Emph}Waktu! {#Prev}Waktu selalu berderap maju; dan hanya aku yang menentukan seberapa cepat lajunya."
      Speaker = "Chronos"
      Event = "ChronosBossAboutMelinoe01"
    }
    {
      Id = "Chronos_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ini benar-benar bikin pusing, terus-menerus membebaskan anjing kampung berkepala tiga milik ayahmu yang celaka itu! Tak habis pikir bagaimana binatang buas semacam itu dulu dipelihara di balik dinding-dinding ini."
      Speaker = "Chronos"
      Event = "ChronosBossAboutCerberus01"
    }
    {
      Id = "MelinoeField_1402"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau terus membuang Cerberus yang malang ke Padang Ratapan, membiarkannya mengamuk sendirian. Dari sekian banyak dosamu yang tak terampuni..."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutCerberus01"
    }
    {
      Id = "Chronos_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu kau mau aku berbuat apa? Aku tak butuh dia untuk menjaga gerbang ke alam ini, karena gerbangnya terbuka lebar. Dan aku jelas tak butuh bulunya berceceran di mana-mana. Meski kalau ceceran {#Emph}darah{#Prev}, kuterima dengan senang hati."
      Speaker = "Chronos"
      Event = "ChronosBossAboutCerberus01"
    }
    {
      Id = "Chronos_0605"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pekerjaanku jadi jauh lebih mudah berkat banyaknya musuh yang dikumpulkan Olympus. Dari kaum Satir, Harpy, sampai Polyphemus si Cyclops dan masih banyak lagi! Bukan aku seorang yang menginginkan kejatuhan para dewa."
      Speaker = "Chronos"
      Event = "ChronosBossAboutPolyphemus01"
    }
    {
      Id = "MelinoeField_1952"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau mengumpulkan ampas-ampas yang haus kekuasaan atau balas dendam! Begitu rupanya kawan-kawanmu. Aku sudah cukup mengenal Polyphemus itu... kesetiaannya sudah pasti bisa dibeli."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutPolyphemus01"
    }
    {
      Id = "Chronos_0606"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, tentu saja {#Emph}bisa. Kesetiaan {#Prev}itu antara diraih atau dibeli, dan hasilnya tak jauh berbeda. Polyphemus punya keterbatasan, itu pasti. Tapi dia bukan {#Emph}kasus tanpa harapan."
      Speaker = "Chronos"
      Event = "ChronosBossAboutPolyphemus01"
    }
    {
      Id = "Chronos_0711"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa kau tak henti-hentinya menyerang gembalaku yang rendah hati, Polyphemus, yang hanya ingin menggembalakan ternaknya dengan damai? Setidaknya kau memberinya sedikit waktu istirahat dengan berada di {#Emph}sini."
      Speaker = "Chronos"
      Event = "ChronosBossAboutPolyphemus02"
    }
    {
      Id = "MelinoeField_2552"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gembalamu yang rendah hati itu tak sudi membiarkanku keluar dari kota Ephyra secara damai, jadi aku melangkah keluar sendiri. Asal tahu saja, dia sering tidur saat bertugas..."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutPolyphemus02"
    }
    {
      Id = "Chronos_0712"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelakuan yang pantas dihukum, jika memang benar! Tentu saja, bayaranku untuk Cyclops itu hampir tidak ada. Dan ada rupa ada harga, Gadisku..."
      Speaker = "Chronos"
      Event = "ChronosBossAboutPolyphemus02"
    }
    {
      Id = "Chronos_0903"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat pertama kali aku datang ke Rumah ini, ayahmu dan para pelayannya sama sekali tak memberi perlawanan berarti. Nyx sendiri pun tidak berkutik! Walau sejujurnya, aku memang menyerang mereka secara tiba-tiba."
      Speaker = "Chronos"
      Event = "ChronosBossAboutNyx01"
    }
    {
      Id = "MelinoeField_3326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang kau harap bisa kau capai dengan menawan Sang Inkarnasi Malam, di samping semua tawanan lainnya? Pengaruhnya tidak akan bisa sirna begitu saja."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutNyx01"
    }
    {
      Id = "Chronos_0904"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuakui tempat ini jadi agak terlalu gelap semenjak kepergian sementara Nyx. Kendati demikian, aku memang lebih suka suasana yang bersih dari sosok-sosok yang menyebalkan. Tak tersisa satu pun, tepatnya."
      Speaker = "Chronos"
      Event = "ChronosBossAboutNyx01"
    }
    {
      Id = "MelinoeField_1590"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, aku nyaris kagum. Bukan cuma menjarah wilayah kekuasaan ayahku dan mengibarkan perang terhadap Olympus, kau bahkan nekat mengelabui Khaos Purba! Butuh nyali besar untuk itu."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutChaos01"
    }
    {
      Id = "Chronos_0545"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, terima kasih, Gadisku! Harus kuakui, kukira Khaos tipe yang pandai tawar-menawar, karena aku bersedia menukar putrinya, Nyx, dengan Tiga Takdir. Tapi sekarang, aku menguasai semuanya!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutChaos01"
    }
    {
      Id = "MelinoeField_1591"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menganggap para dewa chthonic bagai sekumpulan orang bodoh... kekuatan tertua dan terhebat yang pernah ada. Pilihan sembrono semacam itu bisa berbalik menghantuimu."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutChaos01"
    }
    {
      Id = "Chronos_0546"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, buktinya {#Emph}kau {#Prev}berulang kali kembali untuk menghantuiku di sini. Kau, jagoan terbaik yang bisa ditawarkan dewa-dewi Bawah Tanah dan Olympus. {#Emph}Cuih!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutChaos01"
    }
    {
      Id = "MelinoeField_1507"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu apa yang sudah kau lakukan pada Tiga Takdir? Kau berani memancing murka seluruh dewa chthonic, seolah murka seisi Olympus masih belum cukup bagimu..."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutFates01"
    }
    {
      Id = "Chronos_0506"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kubuang mereka! Ke mana, aku tak tahu, atau {#Emph}kapan. {#Prev}Bagaimanapun juga, mereka tak lagi merepotkan kita dengan tenunan takdir manipulatif mereka. Tidak, apa yang terjadi sekarang... sepenuhnya ada di tangan {#Emph}kita."
      Speaker = "Chronos"
      Event = "ChronosBossAboutFates01"
    }
    {
      Id = "Chronos_0552"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku benar-benar dibikin pusing oleh sosok si {#Emph}Tukang Perahu {#Prev}di luar sana, yang lancang mendayung perahu kecilnya tepat ke depan ambang pintuku! Kaum Satir bahkan lebih takut padanya {#Emph}ketimbang {#Prev}padamu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutCharon01"
    }
    {
      Id = "MelinoeField_1595"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya kau sendiri takut padanya. Yang Mulia Charon mengenali setiap batu di Dunia Bawah... setiap tetes di lima sungai. Kau bilang kau tak bisa dihentikan? Begitu pula dia."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutCharon01"
    }
    {
      Id = "Chronos_0553"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Si penjual rongsokan itu, seenaknya menjajakan barang jarahan kepada segelintir pelanggannya yang mengenaskan! Dan menimbun begitu banyak Emas yang kubuat dengan murah hati. Sekutu yang sungguh mulia bagimu!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutCharon01"
    }
    {
      Id = "Chronos_0707"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau baru saja menonton pertunjukan musik akbar di dasar Oceanus! Menembus seluruh jaringan pipa neraka hanya demi tontonan itu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutScylla01"
    }
    {
      Id = "MelinoeField_2550"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, bukan masalah sama sekali. Minat di sana terhadap seni panggung begitu bergairah! Kau harusnya lebih sering mampir."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutScylla01"
    }
    {
      Id = "Chronos_0708"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang berniat ke sana, dan merebut kendali atas tempat terkutuk itu sebagai wilayah kekuasaanku yang sah! Untuk sekarang, aku cuma mensponsori beberapa acara hiburan menyenangkan yang kau nikmati setiap malam!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutScylla01"
    }
    {
      Id = "Chronos_0709"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meskipun aku sendiri belum pernah menontonnya langsung, kudengar penampilan Scylla dan gerombolan Siren-nya sering kali sangat mengecewakan. Mungkin sebaiknya kucabut saja dukunganku..."
      Speaker = "Chronos"
      Event = "ChronosBossAboutScylla02"
    }
    {
      Id = "MelinoeField_2551"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku malah khawatir mereka itu investasi bodong. Kulihat segelintir pendengar setia yang sama di antara penonton mereka malam demi malam, tanpa ada tanda-tanda perkembangan berarti."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutScylla02"
    }
    {
      Id = "Chronos_0710"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, Gadisku, penonton setia yang sedikit bukanlah hal yang patut dicemooh! Aku sendiri memulainya hanya dengan segelintir pengikut Satyr, dan lihat seberapa jauh aku melangkah!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutScylla02"
    }
    {
      Id = "MelinoeField_1593"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir semua dewa chthonic menentangmu secara terang-terangan. Tapi dari semua makhluk, kau malah menghasut {#Emph}Eris{#Prev} ke pihakmu! Aliansi yang menggelikan, meski tak buruk untuk menebar lebih banyak kehancuran dan perselisihan."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutEris01"
    }
    {
      Id = "Chronos_0549"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pantas dipuji atas banyak hal luar biasa, Gadisku; tapi bukan atas aliansi semacam itu dengan sang Perselisihan! Untuk apa aku mengurus anak anjing bungsu Nyx? Walau mungkin dia tidak sebodoh itu, jika dia memang berhimpun di bawah panjiku seperti katamu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutEris01"
    }
    {
      Id = "Chronos_0703"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah bagaimana kau berhasil mencapai gunung para dewa. Bahkan bentrok dengan Prometheus sendiri, begitu pengakuannya! Jalur mana pun yang kau pilih... kami para Titan akan selalu ada di sana."
      Speaker = "Chronos"
      Event = "ChronosBossAboutPrometheus01"
    }
    {
      Id = "MelinoeField_2548"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus. Kalau begitu aku punya segala kesempatan untuk membantai kalian semua. Jadi, kau membebaskan tawanan Olympus itu demi perbudakannya? Kudengar Prometheus dulunya punya integritas."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutPrometheus01"
    }
    {
      Id = "Chronos_0704"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, tapi dia masih memilikinya! Itulah alasan dia bergabung dengan perjuanganku. Lagipula... siapa yang lebih pantas memimpin pasukan serbuku melawan Olympus selain sosok yang begitu dizalimi oleh para dewa? Karena aku tak bisa melakukan {#Emph}semuanya{#Prev} sendirian!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutPrometheus01"
    }
    {
      Id = "Chronos_0705"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Titan Tahu-Masa-Depan mengaku bahwa kau sanggup menahan murkanya. Yang kutanggapi dengan, {#Emph}Prometheus, Sahabat Baikku! Jika kau tahu ini akan terjadi, mengapa kau tidak memperingatkanku? Dan mengapa tidak kau cegah?{#Prev}"
      Speaker = "Chronos"
      Event = "ChronosBossAboutPrometheus02"
    }
    {
      Id = "MelinoeField_2549"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau melebih-lebihkan kekuatan sang Titan Penglihatan Masa Depan untuk melihat masa depan dengan jelas. Termasuk kekuatannya."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutPrometheus02"
    }
    {
      Id = "Chronos_0706"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia berdalih merahasiakan rincian masa depan... agar tidak mengubah hasil yang diinginkan. Alasan yang sangat nyaman! Tak perlu seorang genius sepertinya untuk tahu bahwa pada akhirnya akulah yang akan menang!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutPrometheus02"
    }
    {
      Id = "Chronos_0893"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar upaya sombong terbarumu untuk merebut kembali Olympus bagi para dewa berakhir gagal. Mungkin pada saat kau menyaksikan Bapak Segala Monster dalam seluruh perawakannya yang mengerikan, kau akhirnya menyadari kebodohanmu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphon01"
    }
    {
      Id = "MelinoeField_3320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membangkitkan monster keji itu lalu menyebut {#Emph}aku{#Prev} sombong? Typhon takkan sudi menerima perintah darimu ataupun {#Emph}siapa pun!{#Prev} Takkan ada apa pun yang tersisa untuk kau kuasai jika dia bertindak sesukanya!"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutTyphon01"
    }
    {
      Id = "Chronos_0894"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, kalian para {#Emph}dewa{#Prev} yang takkan punya apa pun lagi untuk dikuasai jika dia bertindak sesukanya. Dan aku, {#Emph}milikku!{#Prev} Typhon mungkin bukan tipe yang suka bernegosiasi; tapi kita tak butuh kesepakatan untuk mengejar hasil yang sama."
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphon01"
    }
    {
      Id = "Chronos_0997"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar upaya sombong terbarumu untuk merebut kembali Olympus membuahkan hasil! Mungkin pada saat kau menyaksikan Bapak Segala Monster dalam seluruh perawakannya yang mengerikan, naluri purba dalam dirimu bangkit menguasai."
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphon01_B"
    }
    {
      Id = "MelinoeField_3321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan sesuatu padaku, sebelum kubuat kau kembali menjadi debu. Jika Typhon menghancurkan Gunung Olympus seperti yang kau dambakan, menurutmu ke mana dia akan pergi setelah itu? Kembali tidur?"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutTyphon02"
    }
    {
      Id = "Chronos_0895"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, itu bukan urusanku. Dunia kita ini luas, dan {#Emph}dalam!{#Prev} Typhon bebas pergi ke mana pun dia suka. Mungkin dia akan menguasai lautan menggantikan Poseidon!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphon02"
    }
    {
      Id = "MelinoeField_3322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pembohong. Kau berencana mengkhianatinya. Mengirimnya melolong kembali ke jurang maut setelah kegunaannya bagimu selesai. Bahkan {#Emph}kau{#Prev} pun tidak sebodoh itu untuk mengabaikannya sebagai ancaman."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutTyphon02"
    }
    {
      Id = "Chronos_0896"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa depan akan terkendali dengan baik, itu bisa kupastikan, Cucu Perempuan. Lebih baik fokus pada masa kini, dan banyak kesulitan yang harus kita tanggung."
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphon02"
    }
    {
      Id = "Chronos_0897"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, berhasil menjatuhkan Typhon dari puncak gunung itu... tentu saja itu bukan sesuatu yang bisa kau lakukan sendirian, tapi tetap saja! Betapa {#Emph}bangganya{#Prev} perasaanmu saat itu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphon03"
    }
    {
      Id = "MelinoeField_3323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasakan secercah kepuasan, ya. Tapi kau pasti tahu perasaan apa yang jauh lebih hebat daripada menggagalkan Bapak Segala Monster, bukan?"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutTyphon03"
    }
    {
      Id = "Chronos_0898"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau menyindir bahwa mengalahkanku dalam pertempuran adalah sensasi yang setara dengan menundukkan sang Penghancur Agung Olympus, kau terlalu memujiku, Gadisku. Silakan coba... bahkan saat Typhon mulai menggeliat kembali."
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphon03"
    }
    {
      Id = "Chronos_0899"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hmhmhm{#Prev}, marah seperti biasanya! Apa kau ingin tahu persisnya bagaimana aku membangkitkan Typhon, Gadisku? Atau bagaimana aku melakukannya tanpa kalian para dewa menyadari apa yang telah kupersiapkan?"
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphon04"
    }
    {
      Id = "MelinoeField_3324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakanlah, Kakek. Karena aku sangat menikmati dongeng-dongengmu."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutTyphon04"
    }
    {
      Id = "Chronos_0900"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau takkan pernah percaya jika kau mengetahuinya. Karena pikiranmu picik, kau dan semua dewa itu! Aku telah {#Emph}mengakali{#Prev} kalian... dan aku juga akan menaklukkan kalian dengan kekuatan."
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphon04"
    }
    {
      Id = "Chronos_0985"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang telah kau perbuat... terhadap Bapak Segala Monster, apa yang telah kau {#Emph}lakukan?!{#Prev} Karena dia... lenyap tak berbekas...!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_3879"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rincian seperti itu bukan urusanmu, bajingan. Ketahuilah bahwa kaulah berikutnya. Semoga saat-saat terakhirmu penuh dengan penderitaan."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutTyphonDeath01"
    }
    {
      Id = "Chronos_0986"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bicara padaku soal rasa sakit... Aku bisa menguncimu bersamanya selamanya. Kau akan memahaminya jauh lebih baik daripada aku!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_3662"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aneh. Semua ini terlihat persis sama, begitu pula denganmu, Titan. Kukira malam ini akan menyuguhkan sesuatu yang baru untukku."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutAltFight01"
    }
    {
      Id = "Chronos_1063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, jangan terdengar begitu kecewa, Cucu Perempuan. Jika kau ingin aku mengerahkan trik baru milikku demi memeriahkan prosesi ini, dengan senang hati kulayani..."
      Speaker = "Chronos"
      Event = "ChronosBossAboutAltFight01"
    }
    {
      Id = "Chronos_1331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengira dirimu cukup pintar dan paling tangguh karena telah bertahan dari Akhir Waktu, tapi kau tak mencapai apa-apa sama sekali! Karena aku ada di sini seperti biasa, sementara kau tetap tertahan tepat di {#Emph}sana{#Prev}."
      Speaker = "Chronos"
      Event = "ChronosBossAboutAltFight02"
    }
    {
      Id = "MelinoeField_4563"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau juga mengira mustahil bagiku untuk memusnahkanmu, apalagi di tempat Akhir Waktu itu. Kau ternyata lebih rentan salah daripada yang kau sadari."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutAltFight02"
    }
    {
      Id = "Chronos_1332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, {#Emph}kau{#Prev} yang rentan salah, Gadisku, karena Waktu pada hakikatnya sangat presisi, dan selalu benar. Tapi jika kau ingin menguji anggapanmu itu, silakan saja."
      Speaker = "Chronos"
      Event = "ChronosBossAboutAltFight02"
    }
    {
      Id = "Chronos_1333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir Waktu ternyata tidak sesuai seleramu, ya, {#Emph}hm?{#Prev} Wah, andai kau ingin aku bersikap sedikit lebih {#Emph}lunak{#Prev}, Gadisku, kau cukup memintanya saja..."
      Speaker = "Chronos"
      Event = "ChronosBossAboutAltFight03"
    }
    {
      Id = "MelinoeField_4564"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ke sini untuk melihatmu hancur lebur, Titan, bukan untuk berpelesir di tempat-tempat hambar yang mencerminkan sifatmu itu. Kurasa akan jauh lebih efisien jika diselesaikan begini."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutAltFight03"
    }
    {
      Id = "Chronos_1334"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Efisien!{#Prev} Sekarang kau benar-benar terdengar seperti cucu perempuanku. Kalau begitu, mari kita tuntaskan perselisihan kita sekali lagi, tapi kali ini dengan sesegera mungkin."
      Speaker = "Chronos"
      Event = "ChronosBossAboutAltFight03"
    }
    {
      Id = "Chronos_1329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah terbiasa dengan {#Emph}bau busuk{#Prev} bangsa Olympian beserta {#Emph}yang katanya{#Prev} berkah mereka di tubuhmu, jadi kesempatan ini adalah kelegaan yang amat kusambut. Tanpa kekuatan {#Emph}mereka{#Prev}, murni hanya kekuatan{#Emph}mu{#Prev}!"
      Speaker = "Chronos"
      Event = "ChronosBossAboutNoBoons01"
    }
    {
      Id = "MelinoeField_4562"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatanku kurasa sudah lebih dari cukup. Walau semakin kau meremehkanku, kurasa justru semakin bagus. Mau mulai sekarang?"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutNoBoons01"
    }
    {
      Id = "Chronos_1330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau mulai {#Emph}apa? {#Prev}Mau membiarkan para pemujaku kaum Satir dan diriku menyingkirkan penyusup paling menyebalkan ini {#Emph}lagi {#Prev}dan {#Emph}lagi? {#Prev}Kalau begitu, {#Emph}tentu saja."
      Speaker = "Chronos"
      Event = "ChronosBossAboutNoBoons01"
    }
    {
      Id = "Chronos_0976"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau panggil apa penyihir tua yang tampaknya sangat kau pedulikan itu? {#Emph}Kepala sekolahmu? {#Prev}Beri tahu aku sekarang juga siapa dia sebenarnya, jika kau masih sedikit saja peduli pada keselamatannya."
      Speaker = "Chronos"
      Event = "ChronosBossAboutHecateKidnapped01"
    }
    {
      Id = "MelinoeField_3877"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dia cuma pelayan ibuku, tak lebih. Saat kau menyerang Kediaman ayahku, dialah yang membawaku kabur. Begitu beranjak dewasa, aku bersumpah untuk menghentikanmu; meski dia sudah berusaha keras membujukku agar mengurungkan niat. Lepaskan dia."
      Speaker = "Melinoe"
      Event = "ChronosBossAboutHecateKidnapped01"
    }
    {
      Id = "Chronos_0977"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Awalnya kupikir kau mungkin anak Zeus ketimbang Hades, tapi kemampuan berbohongmu payah sekali, Cucu Perempuan. Sekarang rasakan akibat dari perbuatanmu... atau sang {#Emph}pelayan {#Prev}yang akan menanggungnya sebagai gantimu."
      Speaker = "Chronos"
      Event = "ChronosBossAboutHecateKidnapped01"
    }
    {
      Id = "MelinoeField_3878"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Jangan berani-berani menyentuhnya!"
      Speaker = "Melinoe"
      Event = "ChronosBossAboutHecateKidnapped01"
    }
    {
      Id = "Chronos_0978"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala sekolahmu itu sejauh ini terbukti sama sekali tidak berguna dalam memberi informasi. Tentu saja, aku bisa bersikap jauh lebih persuasif jika memang diperlukan. Tapi pertama-tama, mari selesaikan urusan kita dulu..."
      Speaker = "Chronos"
      Event = "ChronosBossAboutHecateKidnapped02"
    }
    {
      Id = "Chronos_1049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gadis kurang ajar. Aku tak tahu bagaimana caramu lolos dariku terakhir kali, tapi kau telah membuat kesalahan fatal dengan kembali menginjakkan kaki di aula ini, memberi {#Emph}aku {#Prev}kesempatan kedua."
      Speaker = "Chronos"
      Event = "ChronosBossPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini bukan kesempatan keduamu, Titan, melainkan kesempatan terakhirmu. Kau itu anomali dan bahkan tidak seharusnya ada, apalagi di sini dan menjadi seperti ini."
      Speaker = "Melinoe"
      Event = "ChronosBossPostTrueEnding01"
    }
    {
      Id = "Chronos_1050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh kupotong sebentar? {#Emph}Ehem{#Prev}, salam! Kalau-kalau kemiripan ini masih kurang jelas, aku adalah {#Emph}dirimu! {#Prev}Namun aku juga adalah {#Emph}diriku. {#Prev}Aku tahu ini pasti sulit diterima, tapi cucuku sama sekali tidak salah..."
      Speaker = "Chronos"
      Event = "ChronosBossPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakek, biar aku yang urus ini. Mengetahui watak{#Emph}mu {#Prev}yang dulu, dia tidak akan mau mendengarkan akal sehat sekarang."
      Speaker = "Melinoe"
      Event = "ChronosBossPostTrueEnding01"
    }
    {
      Id = "Chronos_1051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebodohan macam apa ini, lelucon... {#Emph}menjijikkan apa ini?! {#Prev}Kau berani membingungkanku dengan ilusi murahan seperti ini, sementara kau lancang menceramahi{#Emph}ku {#Prev}tentang apa yang pantas ada atau tidak? {#Emph}Enyahlah!"
      Speaker = "Chronos"
      Event = "ChronosBossPostTrueEnding01"
    }
    {
      Id = "Chronos_1271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melihat sendiri bahwa aku takkan lenyap selamanya. Bertarunglah denganku sesuka hatimu! Apa pun hasilnya, tetap {#Emph}kau {#Prev}yang akhirnya terlempar dari tempat ini. Atau kau ke sini cuma ingin mengobrak-abrik barang-barang lama keluargamu yang sudah tak berguna itu?"
      Speaker = "Chronos"
      Event = "ChronosBossPostTrueEnding02"
    }
    {
      Id = "MelinoeField_3871"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak butuh barang-barang milik mereka. Hanya kepalamu yang kuinginkan."
      Speaker = "Melinoe"
      Event = "ChronosBossPostTrueEnding02"
    }
    {
      Id = "Chronos_1272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang itu takkan bisa kau dapatkan, Gadis Kecil, karena aku masih membutuhkannya untuk memimpin dunia ini dengan kebijaksanaan yang tak pernah dimiliki anak-anakku yang durhaka itu. Dan kau, tampaknya, malah punya jauh lebih sedikit."
      Speaker = "Chronos"
      Event = "ChronosBossPostTrueEnding02"
    }
    {
      Id = "Chronos_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekali lagi kau berhasil lolos dari cengkeramanku hingga sampai ke sini, seolah-olah kau hanya sudi mati di tanganku."
      Speaker = "Chronos"
      Event = "ChronosBossMiscStart01"
    }
    {
      Id = "Chronos_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesabaranku tak terbatas untuk meladeni segala polah konyolmu ini, Gadis Kecil."
      Speaker = "Chronos"
      Event = "ChronosBossMiscStart02"
    }
    {
      Id = "Chronos_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menghabiskan waktu berabad-abad terkubur di kedalaman terdalam; gangguan kecil dari kelancanganmu ini sama sekali tak patut kurisaukan."
      Speaker = "Chronos"
      Event = "ChronosBossMiscStart03"
    }
    {
      Id = "Chronos_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertikaian kecil denganmu ini jelas takkan pernah bisa diselesaikan dengan cara yang lebih beradab..."
      Speaker = "Chronos"
      Event = "ChronosBossMiscStart04"
    }
    {
      Id = "Chronos_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah terlalu lama aku bertakhta di singgasana ini; sedikit olah tubuh yang sengit agaknya akan berdampak baik bagiku."
      Speaker = "Chronos"
      Event = "ChronosBossMiscStart05"
    }
    {
      Id = "Chronos_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh tak kusangka gabungan kekuatan pasukanku ternyata tak cukup untuk membendung seorang gadis ingusan."
      Speaker = "Chronos"
      Event = "ChronosBossMiscStart06"
    }
    {
      Id = "Chronos_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memang terencana, kuakui itu. Tapi aku harus merenggut lebih banyak hal darimu."
      Speaker = "Chronos"
      Event = "ChronosBossMiscStart07"
    }
    {
      Id = "Chronos_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak bisa berada di dua tempat sekaligus. Sementara kau menyerang membabi buta tanpa hasil di sini, Olympus sedang berkobar..."
      Speaker = "Chronos"
      Event = "ChronosBossMiscStart08"
    }
    {
      Id = "Chronos_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu bisa berlalu sekejap mata, atau terasa bagai keabadian. Untuk kali ini, mari kita selesaikan dengan cepat."
      Speaker = "Chronos"
      Event = "ChronosBossMiscStart09"
    }
    {
      Id = "Chronos_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Takdir sendiri pun tak mampu menghalangi hakku untuk berkuasa; lantas harapan apa yang kau punya?"
      Speaker = "Chronos"
      Event = "ChronosBossMiscStart10"
    }
    {
      Id = "Chronos_1485"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Mencibir> {#Prev}...Kau ingin mengakhiri Sang Waktu...? Kalau begitu, {#Emph}saksikanlah... {#Prev}karena akan kutunjukkan padamu... walau hanya {#Emph}sekilas...!"
      Speaker = "Chronos"
      Event = "ChronosBossPreTrueEndingFinalPhase01"
    }
    {
      Id = "Chronos_0987"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku telah bertahan menghadapi para dewa... bahkan Sang Takdir sekalipun! Namun kau begitu lancang mencoba menumbangkanku. Berani-{#Emph}beraninya {#Prev}kau. Berani-{#Emph}beraninya {#Prev}kau?!"
      Speaker = "Chronos"
      Event = "ChronosBossR2Outro01"
    }
    {
      Id = "Chronos_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Nngh! {#Prev}Audiensi ini sudah berlangsung terlalu lama. Kau tak berhak {#Emph}menerobos {#Prev}ke dalam Kediaman ini, dan membuang-buang waktu{#Emph}ku! {#Prev}Aku {#Emph}adalah {#Prev}Waktu itu sendiri. Dan aku bisa membuat setiap detik hidupmu terasa bagai di {#Emph}neraka."
      Speaker = "Chronos"
      Event = "ChronosR1FirstWin"
    }
    {
      Id = "Chronos_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Nrgh{#Prev}, dasar anak keparat...! Buah memang jatuh tak jauh dari pohonnya, bukan...?"
      Speaker = "Chronos"
      Event = "ChronosR1Win01"
    }
    {
      Id = "Chronos_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau tak pantas berada di sini... kau sama sekali tak pantas berada di {#Emph}mana pun..."
      Speaker = "Chronos"
      Event = "ChronosR1Win02"
    }
    {
      Id = "Chronos_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cih...! {#Prev}Dulu butuh enam dewa perkasa untuk menumbangkanku... bukan cuma seorang {#Emph}bocah ingusan!"
      Speaker = "Chronos"
      Event = "ChronosR1Win03"
    }
    {
      Id = "Chronos_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Heh heh... {#Prev}jadi, kau mewarisi sebagian dari kekuatan ayahmu. Atau lebih tepatnya, kekuatan{#Emph}ku..."
      Speaker = "Chronos"
      Event = "ChronosR1Win04"
    }
    {
      Id = "Chronos_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Augh... {#Prev}Aku mulai muak dengan tempat yang suram ini..."
      Speaker = "Chronos"
      Event = "ChronosR1Win05"
    }
    {
      Id = "Chronos_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "...{#Emph}Ungh... {#Prev}mungkin... berganti suasana adalah pilihan terbaik..."
      Speaker = "Chronos"
      Event = "ChronosR1Win06"
    }
    {
      Id = "Chronos_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Terperanjat> {#Prev}Kupikir... {#Emph}tak ada yang {#Prev}bisa melawan gerusan Sang Waktu... tapi, {#Emph}kau? Bagaimana mungkin...?"
      Speaker = "Chronos"
      Event = "ChronosBossOutro01"
    }
    {
      Id = "MelinoeField_1404"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau takkan dapat jawaban apa pun dariku, begitu pula belas kasihan. Sekarang {#Emph}matilah{#Prev}. Dan aku akan mengambil ikhor dari nadimu. Atau cairan apa pun yang mengalir di dalamnya."
      Speaker = "Melinoe"
      Event = "ChronosBossOutro01"
    }
    {
      Id = "Chronos_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah, hah, hah! {#Prev}Apa arti kematian bagi yang abadi? Sekadar gangguan kecil! Griya ini {#Emph}milikku. {#Prev}Begitu aku lenyap... kau akan terlempar pergi."
      Speaker = "Chronos"
      Event = "ChronosBossOutro01"
    }
    {
      Id = "MelinoeField_1405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga. Dan kau akan bangkit lagi di atas takhta sebelum aku sempat kembali. Tapi aku {#Emph}pasti {#Prev}kembali. Dan aku akan membunuhmu lagi, lagi, dan {#Emph}lagi{#Prev}, jika memang harus."
      Speaker = "Melinoe"
      Event = "ChronosBossOutro01"
    }
    {
      Id = "Chronos_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan jika, dengan berbuat begitu, artinya kau takkan pernah melihat keluarga tuamu tersayang lagi? Karena belas kasihan yang kutunjukkan pada mereka sejauh ini mungkin harus kutinjau ulang."
      Speaker = "Chronos"
      Event = "ChronosBossOutro01"
    }
    {
      Id = "MelinoeField_1406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga {#Emph}kita{#Prev}. Dan masa bodoh bagiku. Aku bahkan tak mengenal mereka. Tapi aku {#Emph}tahu {#Prev}sebentar lagi kau pasti mati di sini; ada pesan terakhir?"
      Speaker = "Melinoe"
      Event = "ChronosBossOutro01"
    }
    {
      Id = "Chronos_0892"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Untukmu, Gadisku...? Sekadar pengingat... tak lebih..."
      Speaker = "Chronos"
      Event = "ChronosBossOutro01"
    }
    {
      Id = "Chronos_1402"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Argh... {#Prev}keluarga macam apa {#Emph}kalian {#Prev}ini! Teruslah mencoba mengusirku seperti dulu! Lihat apa hasilnya nanti!"
      Speaker = "Chronos"
      Event = "ChronosBossOutroUltimateProgress01"
    }
    {
      Id = "MelinoeField_5044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti kulakukan. Tapi kalau kau begitu ingin menjadi bagian dari keluarga, mungkin kau tak seharusnya mengobarkan perang melawan mereka."
      Speaker = "Melinoe"
      Event = "ChronosBossOutroUltimateProgress01"
    }
    {
      Id = "Chronos_1403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melawan {#Emph}mereka{#Prev}, katamu! Bukan {#Emph}kita! {#Prev}Kau juga makhluk buangan, putri Hades! Selamanya akan begitu, dan takkan pernah berubah!"
      Speaker = "Chronos"
      Event = "ChronosBossOutroUltimateProgress01"
    }
    {
      Id = "Chronos_1404"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Gah... {#Prev}kalian para dewa tak pernah belajar dari masa lalu! Sembarangan mengubah segalanya sesuka hati!"
      Speaker = "Chronos"
      Event = "ChronosBossOutroUltimateProgress02"
    }
    {
      Id = "MelinoeField_5045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaulah yang tak pernah belajar. Padahal punya banyak waktu untuk memikirkannya."
      Speaker = "Melinoe"
      Event = "ChronosBossOutroUltimateProgress02"
    }
    {
      Id = "Chronos_1405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, justru sebaliknya... Aku tahu perubahan itu tak terelakkan, bersama Waktu... satu-satunya pertanyaan hanyalah... perubahan macam apa..."
      Speaker = "Chronos"
      Event = "ChronosBossOutroUltimateProgress02"
    }
    {
      Id = "Chronos_1445"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Augh...! {#Prev}Keluargaku sendiri pernah memperlakukanku lebih buruk dari ini... yah, sekarang aku jauh lebih kuat! Makin kuat di setiap malam yang berlalu...!"
      Speaker = "Chronos"
      Event = "ChronosBossOutroUltimateProgress03"
    }
    {
      Id = "MelinoeField_5089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah tua dan lelah. Kau bahkan tak tahu lagi kenapa kau bertarung. Demi membuktikan sesuatu pada anak-anakmu?"
      Speaker = "Melinoe"
      Event = "ChronosBossOutroUltimateProgress03"
    }
    {
      Id = "Chronos_1446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka merampas {#Emph}segalanya {#Prev}dariku! Segalanya dan lebih banyak lagi. Sekarang mereka menyuruhmu mengambil {#Emph}sisanya. {#Prev}Keluarga yang sungguh terkutuk..."
      Speaker = "Chronos"
      Event = "ChronosBossOutroUltimateProgress03"
    }
    {
      Id = "Chronos_1448"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Gah...! {#Prev}Yah, pertarungan yang sangat menyenangkan, Cucu Perempuan. Mau coba lagi besok malam, mungkin...?"
      Speaker = "Chronos"
      Event = "ChronosBossOutroUltimateProgress04"
    }
    {
      Id = "MelinoeField_5090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin. Jadi beri tahu aku, Titan... apakah {#Emph}seperti ini {#Prev}rasanya punya keluarga? Pertikaian sengit dan cemoohan sinis?"
      Speaker = "Melinoe"
      Event = "ChronosBossOutroUltimateProgress04"
    }
    {
      Id = "Chronos_1449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}ya! {#Prev}Hanya sebatas itu! Aku mungkin telah merampasnya darimu... tapi sebenarnya aku berbuat {#Emph}kebaikan {#Prev}padamu! Kau akan menyadarinya nanti..."
      Speaker = "Chronos"
      Event = "ChronosBossOutroUltimateProgress04"
    }
    {
      Id = "Chronos_1452"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nrgh...! {#Prev}Kau sungguh mengira... kalian para {#Emph}dewa... {#Prev}lebih pantas menguasai dunia ini daripada aku...?"
      Speaker = "Chronos"
      Event = "ChronosBossOutroUltimateProgress05"
    }
    {
      Id = "MelinoeField_5091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berdua tahu persoalannya {#Emph}bukan {#Prev}itu, Titan. Dan segala petaka di dunia ini takkan membaik selama kita terus melanjutkannya."
      Speaker = "Melinoe"
      Event = "ChronosBossOutroUltimateProgress05"
    }
    {
      Id = "Chronos_1453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau bukan soal dunia ini, Gadisku... lalu menurutmu ini soal {#Emph}apa{#Prev}...?"
      Speaker = "Chronos"
      Event = "ChronosBossOutroUltimateProgress05"
    }
    {
      Id = "MelinoeField_5092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pelayan ibuku... kembalikan dia. Sekarang juga."
      Speaker = "Melinoe"
      Event = "ChronosBossOutroAfterHecateKidnapped01"
    }
    {
      Id = "Chronos_1455"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Urgh...! {#Prev}Kau begitu peduli... pada si {#Emph}penyihir-pelayanmu {#Prev}itu. Seandainya saja ada satu kerabatku... yang menunjukkan secuil kepedulian padaku...!"
      Speaker = "Chronos"
      Event = "ChronosBossOutroAfterHecateKidnapped01"
    }
    {
      Id = "MelinoeField_5093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk apa mereka peduli? Lihat apa yang sudah kau perbuat! Kau mencoba merebut {#Emph}segalanya {#Prev}dari kami! Masa depan kami!"
      Speaker = "Melinoe"
      Event = "ChronosBossOutroAfterHecateKidnapped01"
    }
    {
      Id = "Chronos_1456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita ini {#Emph}keluarga... {#Prev}kita tidak merebut, kita {#Emph}berbagi! {#Prev}Kalau begitu, hancurkan aku! Jika memang kau punya kekuatan itu. Dan lihat {#Emph}masa depan {#Prev}macam apa yang akan kau wujudkan..."
      Speaker = "Chronos"
      Event = "ChronosBossOutroAfterHecateKidnapped01"
    }
    {
      Id = "Chronos_1275"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}...Gah. Hah, hah! {#Prev}Lagi-lagi kau menumbangkanku. Dan lagi-lagi kau membuang-buang {#Emph}waktumu. {#Prev}Aku tahu apa yang kau cari..."
      Speaker = "Chronos"
      Event = "ChronosBossOutroPreTrueEnding01"
    }
    {
      Id = "MelinoeField_5207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja kau tahu. Kurasa sekarang kita berdua sudah memperjelas keinginan masing-masing."
      Speaker = "Melinoe"
      Event = "ChronosBossOutroPreTrueEnding01"
    }
    {
      Id = "Chronos_1529"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergilah kalau begitu... dan tataplah Cermin itu lekat-lekat selagi kau meronta tak berdaya! Cepatlah... karena aku takkan lenyap... terlalu lama."
      Speaker = "Chronos"
      Event = "ChronosBossOutroPreTrueEnding01"
    }
    {
      Id = "Chronos_1277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh mengira... kekuatan yang kau pakai pada Typhon bisa digunakan melawanku? Buktikan kalau begitu! Aku ingin melihatmu {#Emph}mencobanya!"
      Speaker = "Chronos"
      Event = "ChronosBossOutroPreTrueEnding01_B"
    }
    {
      Id = "Chronos_1052"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nraugh... {#Prev}tapi kupikir... tak ada yang bisa melawan kejamnya Waktu... tapi, {#Emph}kau? Bagaimana mungkin...?"
      Speaker = "Chronos"
      Event = "ChronosBossOutroPostTrueEnding01"
    }
    {
      Id = "Chronos_1053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau, sisa bayanganku, sayangnya takkan pernah tahu. Sekarang maafkan dosa orang tua ini..."
      Speaker = "Chronos"
      Event = "ChronosBossOutroPostTrueEnding01"
    }
    {
      Id = "Chronos_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ungh...! {#Prev}Ini tak ada artinya... rencanaku sudah... berjalan lancar..."
