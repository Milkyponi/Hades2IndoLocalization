      Event = "GlobalVoiceLines.ChronosPreAttackVoiceLines"
    }
    {
      Id = "Chronos_0458"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukatakan, enyahlah!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosPreAttackVoiceLines"
    }
    {
      Id = "Chronos_0423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarilah, para rakyatku, tumpahkan darah kalian demi diriku!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0424"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Haaalo{#Prev}, mana bala bantuannya?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0425"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bala bantuan, {#Emph}sekarang juga?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0426"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kupanggil para rakyatku, {#Emph}sekarang!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita undang beberapa tamu!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0428"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, lihat! Ada teman datang!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maju semua, jangan malu-malu!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0509"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Legiun Zaman Keemasan, majulah!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0510"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Legiun Zaman Keemasan, penuhi panggilanku!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0511"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarilah, Legiun Zaman Keemasan!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0512"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarilah, rakyatku, buktikan baktimu padaku!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0513"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Majulah, rakyatku!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0514"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekuatanku ada pada jumlah, jangan sampai kau lupa!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0515"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rakyatku sudah lama menanti saat-saat ini!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0516"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pascukanku tak terhitung, bagaikan butiran pasir!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mustahil menaklukkan legiunku seorang diri!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0518"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu luas bala tentara yang siap menuruti setiap titahku!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih banyak tamu lain yang kuingin kau temui!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0860"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Legiunku akan menjadi saksi kejatuhanmu!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0861"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa kau tak ingin bertemu lebih banyak {#Emph}tamu-tamuku{#Prev}?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0862"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa ruangan ini masih sanggup menampung lebih banyak {#Emph}tamu{#Prev}!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0863"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terasa hampa sekali di sini tanpa legiunku di sisiku!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0864"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih banyak rakyatku di sini yang siap meladeni tantanganmu!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0865"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Betapa sunyinya tempat ini tanpa kehadiran para tamu!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0866"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bergabunglah bersama kami, wahai para tamu kehormatan, dan maafkan debu yang bertebaran ini!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0867"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasukan mana pun yang siap sedia, menghadap padaku sekarang juga!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0868"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau menentang seluruh legiunku, bukan hanya {#Emph}aku{#Prev} seorang!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0869"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Banyak sekali dari rakyatku yang mendambakan pertarungan satu lawan satu denganmu!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0870"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh {#Emph}lihatlah{#Prev}, ini dia rakyatku yang lain sudah berdatangan!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSummonVoiceLines"
    }
    {
      Id = "Chronos_0871"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biasanya legiunku jauh lebih tepat waktu dari ini!"
