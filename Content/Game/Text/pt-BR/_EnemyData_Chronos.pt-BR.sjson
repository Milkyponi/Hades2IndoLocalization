    {
      Id = "Chronos_0598"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bagaimana bisa...?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSpellResistVoiceLines"
    }
    {
      Id = "Chronos_0599"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekuatan sebesar ini..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSpellResistVoiceLines"
    }
    {
      Id = "Chronos_0687"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, kau {#Emph}menemukan {#Prev}sesuatu rupanya!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosGatherReactionVoiceLines"
    }
    {
      Id = "Chronos_0688"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dasar maling picisan!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosGatherReactionVoiceLines"
    }
    {
      Id = "Chronos_0689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembalikan barang itu ke {#Emph}tempatnya."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosGatherReactionVoiceLines"
    }
    {
      Id = "Chronos_0690"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu {#Emph}bukan {#Prev}milikmu."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosGatherReactionVoiceLines"
    }
    {
      Id = "Chronos_0954"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu tadi {#Emph}milikku."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosGatherReactionVoiceLines"
    }
    {
      Id = "Chronos_0955"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembalikan sekarang juga!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosGatherReactionVoiceLines"
    }
    {
      Id = "Chronos_0956"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maling kecil tak tahu diri."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosGatherReactionVoiceLines"
    }
    {
      Id = "Chronos_0957"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu milikku!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosGatherReactionVoiceLines"
    }
    {
      Id = "Chronos_0647"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berniat mengulur {#Emph}Waktu?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosTimerOnReactionVoiceLines"
    }
    {
      Id = "Chronos_0648"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hitunglah sisa waktu yang kau punya."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosTimerOnReactionVoiceLines"
    }
    {
      Id = "Chronos_0649"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua ini akan berakhir dalam sekejap mata."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosTimerOnReactionVoiceLines"
    }
    {
      Id = "Chronos_0650"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Akulah {#Prev}yang menilai kemampuanmu, bukan sebaliknya!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosTimerOnReactionVoiceLines"
    }
    {
      Id = "Chronos_0560"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Haruskah aku merasa {#Emph}terkesan?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosTimerOnReactionVoiceLines"
    }
    {
      Id = "Chronos_0651"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Namun Waktu tetap saja berlalu."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosTimerOffReactionVoiceLines"
    }
    {
      Id = "Chronos_0652"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Takut pada hal yang tak terelakkan?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosTimerOffReactionVoiceLines"
    }
    {
      Id = "Chronos_0558"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pasti bercanda."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosTimerOffReactionVoiceLines"
    }
    {
      Id = "Chronos_0559"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang kenapa pula kau melakukan hal {#Emph}itu?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosTimerOffReactionVoiceLines"
    }
    {
      Id = "Chronos_0561"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu lepas dari genggamanmu."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosTimerOffReactionVoiceLines"
    }
    {
      Id = "Chronos_1124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hahaha{#Prev}, oh, apa kau mengharapkan kedatangan orang lain, Cucu Kecilku?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau menurutmu {#Emph}ini {#Prev}merepotkan, tunggu sampai kau lihat trikku berikutnya!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayang sekali, cuaca buruk menyebabkan beberapa penundaan!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Putraku tersayang, Zeus, saat ini sedang sibuk mengurus perkara yang jauh lebih genting daripada urusanmu!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Andai saja putraku Zeus dan seluruh golongannya bisa melihatmu sekarang, Cucu Kecilku!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para dewa itu sendiri telah menelantarkanmu, Cucu Perempuan...!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak begitu berdaya tanpa sambaran petir Paduka Pamanmu, bukan?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana perginya putraku yang tak berguna itu saat kau membutuhkannya, {#Emph}hm?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bukan main{#Prev}, pemandangan dari atas sini sungguh luar biasa megahnya, Cucu Kecilku!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayang sekali Paduka Pamanmu tak bisa berada di sini bersama kita!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Coba {#Emph}lihat aku{#Prev}, aku malah bersantai-santai selagi Sang Ayah dari Segala Monster menuntaskan pekerjaannya!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dum-dum-dum-dummm, dum-dum-dum-dummmm..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hmm-hmm-hmm-hmmm, hmm-hmm-hmm-hmmmm...."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...atau mungkin cuma terlambat!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.SkipZeusVoiceLines"
    }
    {
      Id = "Chronos_1138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak secepat itu."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak! Belum saatnya."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1140"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja tidak."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita belum selesai!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali ke sini, monster!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, {#Emph}ayolah{#Prev}, Typhon...!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo{#Emph}lah{#Prev}, Typhon...!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bangkit {#Emph}lagi{#Prev}, monster!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1146"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, {#Emph}bangunlah{#Prev}, Typhon..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1147"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Monster macam apa {#Emph}dia {#Prev}itu..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hrr..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Augh..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tertawa>"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tertawa>"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PreBabalityVoiceLines"
    }
    {
      Id = "Chronos_1153"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kembalilah!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.BabalityVoiceLines"
    }
    {
      Id = "Chronos_1154"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kembalilah!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.BabalityVoiceLines"
    }
    {
      Id = "Chronos_1155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kubilang {#Emph}mundur{#Prev}!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.BabalityVoiceLines"
    }
    {
      Id = "Chronos_1156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mundur...!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.BabalityVoiceLines"
    }
    {
      Id = "Chronos_1157"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mundur."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.BabalityVoiceLines"
    }
    {
      Id = "Chronos_1158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mundur...?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.BabalityVoiceLines"
    }
    {
      Id = "Chronos_1159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mundur {#Prev}saja...!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.BabalityVoiceLines"
    }
    {
      Id = "Chronos_1160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenapa kau tidak mau {#Emph}mundur?!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.BabalityVoiceLines"
    }
    {
      Id = "MelinoeField_3787"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aaah!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.BabalityVoiceLines"
    }
    {
      Id = "MelinoeField_3794"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pikir ini lucu, Titan?!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.BabalityDreamRunVoiceLines"
    }
    {
      Id = "MelinoeField_3795"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau telah membuat kesalahan penilaian yang fatal."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.BabalityDreamRunVoiceLines"
    }
    {
      Id = "MelinoeField_3796"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan menderita begitu kupatahkan mantra ini."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.BabalityDreamRunVoiceLines"
    }
    {
      Id = "MelinoeField_3797"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan ada akibat karena telah mempermalukanku."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.BabalityDreamRunVoiceLines"
    }
    {
      Id = "MelinoeField_3798"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan segera tahu bahwa aku bukan lagi gadis kecil seperti dulu."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.BabalityDreamRunVoiceLines"
    }
    {
      Id = "MelinoeField_3799"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tertawalah sepuasmu, dasar kalian para bajingan hina."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.BabalityDreamRunVoiceLines"
    }
    {
      Id = "MelinoeField_3789"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan membayarnya, Titan! Kubersumpah!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.BabalityDreamRunVoiceLines"
    }
    {
      Id = "Chronos_1173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, bukankah dia {#Emph}menggemaskan{#Prev}, Typhon? Lihat kaki mungilnya {#Emph}itu {#Prev}saat dia berlari kian kemari!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1174"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau berusaha mematahkan mantraku! Sungguh {#Emph}cerdik{#Prev}, apalagi untuk anak yang begitu {#Emph}muda!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1175"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, riang gembiranya masa muda tanpa beban! Bukankah kau merindukan masa lalu itu, Gadis Cilik?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1176"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan terlalu {#Emph}kasar {#Prev}padanya, Typhon! Dia hanyalah seorang gadis kecil yang malang dan {#Emph}tak berdaya."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Larilah, gadis kecil, cobalah! Tapi tak ada lagi tempat bagimu untuk lari, dan mimpi buruk ini takkan {#Emph}pernah {#Prev}berakhir."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1179"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, Typhon, jika kau bahkan tak mampu menghentikan gadis kecil tak berdaya, aku kehabisan kata-kata untukmu..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bagus sekali! {#Prev}Jika Sang Bapak Segala Monster dan aku bahkan tak mampu menghentikan bocah kecil manis ini, mungkin kita memang tak pantas memerintah!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1181"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hentikan perlawananmu yang sia-sia itu sekarang juga! Apa yang sebenarnya ingin kau capai?!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1182"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Meski sangatlah tak pantas melampiaskan amarah pada anak-anak kecil, kau tak memberiku pilihan lain!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wujud yang amat cocok untuk makhluk berpikiran sempit sepertimu! Meski Typhon di sini bahkan menganggapmu tak cukup jadi sekadar {#Emph}camilan!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihatlah kita, Typhon. Harus memukuli seorang gadis kecil! Sungguh memalukan...!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1178"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Larilah, gadis kecil! Menghindarlah sesekali jika bisa! Hanya itu yang mampu kau lakukan!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau hanyalah bocah yang menyedihkan. Camkanlah itu baik-baik, jika kau entah bagaimana sanggup bertahan dari apa yang sebentar lagi akan terjadi."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ingatlah selalu betapa kecil dan ketakutannya dirimu di masa lalu. Jauh di dalam lubuk hatimu, kau {#Emph}tetaplah {#Prev}gadis malang yang sama."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada jalan untuk memutar balik Waktu. Tapi aku bisa membuat pengecualian sesuka hati... karena akulah yang {#Emph}membuat semua aturan keparat itu!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuingatkan kembali betapa kecil dan lemahnya dirimu yang sebenarnya. Kita semua menua, memang, tapi tak ada seorang pun dari kita yang berubah seutuhnya."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1166"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak kusangka, andai dulu aku sedikit lebih teliti, aku sudah bisa menyeret {#Emph}dirimu {#Prev}bersama seluruh keluarga tersayangmu; dan tak perlu repot-repot mengurus masalah {#Emph}ini!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bocah kecil {#Emph}keras kepala! Cuma itu {#Prev}kemampuanmu. Lihatlah dirimu, begitu rapuh dalam masa mudamu. Hanya inilah dirimu yang {#Emph}sesungguhnya."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sadari betapa remehnya dirimu, Bocah! Berlarilah kian kemari sesuka hatimu. Aku sama sekali {#Emph}tak peduli!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1169"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayang sekali kau dibesarkan tanpa bimbingan orang tua yang benar, sampai-sampai tata krama paling mendasar pun kau tak punya, bahkan untuk ukuran bocah kurang ajar."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau jelas tak pernah diajari mendengarkan orang yang lebih tua, Nak, jadi {#Emph}baiklah! {#Prev}Aku sudah muak mencoba bersikap {#Emph}masuk akal {#Prev}padamu."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ibumu {#Prev}pasti akan sangat {#Emph}bangga {#Prev}melihat gadis kecil manis seperti dirimu dulu! {#Emph}Yah{#Prev}, sudahlah."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "Chronos_1172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Gadis kecil yang malang{#Prev}, apa kau mau {#Emph}menangis? {#Prev}Atas semua {#Emph}penderitaan {#Prev}yang telah kau lalui?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.PostBabalityVoiceLines"
    }
    {
      Id = "MelinoeField_3800"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lepaskan {#Emph}aku!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "MelinoeField_3801"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cukup, ini sudah {#Emph}keterlaluan!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "MelinoeField_3802"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sekarang giliran{#Emph}ku!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "MelinoeField_3803"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kubuat kau {#Emph}membayarnya!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "MelinoeField_3804"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kurang ajar!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "MelinoeField_3805"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Cukup sudah!!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau berhasil lolos..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau... bertambah besar..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mantramu...!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana bisa kau...?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1189"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana mungkin ini—"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini tidak mungkin—"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1191"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, sial..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1193"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali ke wujud aslimu?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka tumbuh begitu cepat..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan lagi..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ClearedBabalityVoiceLines"
    }
    {
      Id = "Chronos_1203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, baiklah, kau {#Emph}menang{#Prev}, dasar bocah..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Typhon! Tunggu! {#Emph}Augh..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini benar-benar {#Emph}penghinaan! Augh!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1197"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia punya {#Emph}keluarga{#Prev}, dasar monster!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Coba lihat Waktu sekarang...?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Yah, sebaiknya aku segera kembali..."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para Takdir sialan itu pasti bersekongkol denganmu!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya segitu saja kehebatan Sang Ayah Segala Monster!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, ini benar-benar tidak berjalan sesuai rencana...!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, kau menang lagi, {#Emph}senang sekarang?!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa kau sudah merasa sangat {#Emph}puas {#Prev}sekarang?!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosRunClearVoiceLines"
    }
    {
      Id = "Chronos_1206"
      InheritFrom = "BaseSubtitle"
