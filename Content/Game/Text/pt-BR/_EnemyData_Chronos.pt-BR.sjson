      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSpellResistVoiceLines"
    }
    {
      Id = "Chronos_0637"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu takkan berhenti untuk {#Emph}dirimu."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSpellResistVoiceLines"
    }
    {
      Id = "Chronos_0638"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lagi-lagi percobaan sia-sia ini?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosSpellResistVoiceLines"
    }
    {
      Id = "Chronos_0639"
      InheritFrom = "BaseSubtitle"
