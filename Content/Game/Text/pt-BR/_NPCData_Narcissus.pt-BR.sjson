{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Narcissus.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "MelinoeField_0719"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga air ini tetap jernih mengalir."
      Speaker = "Melinoe"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_0720"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Damai bersamamu, Narsisos."
      Speaker = "Melinoe"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0031"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa jadi!"
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0024"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa?"
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei."
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam kenal."
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama."
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0146"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makasih."
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0147"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke."
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa jadi."
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hah?"
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, bolehlah."
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "Narcissus_0151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Uh-huh."
      Speaker = "Narcissus"
      Event = "NPC_Narcissus_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_1987"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oh! Um{#Prev}, terima kasih!"
      Speaker = "Melinoe"
      Event = "NPC_Narcissus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_2848"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sana, bicaralah dengannya."
      Speaker = "Melinoe"
      Event = "NPC_Narcissus_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Narcissus_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat siapa ini. Satu lagi calon pemuja yang menempuh perjalanan jauh dan melelahkan, cuma demi memandangiku—bukan berarti aku menyalahkanmu, sih... dan berujung ditolak mentah-mentah! {#Emph}Terserahlah. {#Prev}Tatap saja sepuasmu kalau memang {#Emph}harus."
      Speaker = "Narcissus"
      Event = "NarcissusFirstMeeting"
    }
    {
      Id = "Melinoe_2047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau salah paham. Aku tidak sedang mencari pasangan. Bahkan aku tidak tahu kau ini siapa."
      Speaker = "Melinoe"
      Event = "NarcissusFirstMeeting"
    }
    {
      Id = "Narcissus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Aku Narsisos, bodoh! {#Emph}Sang {#Prev}Narsisos! Dan kalau kau bukan calon pemuja... kenapa kau tidak membantuku menyingkirkan salah satu dari sekian banyak hadiah pemberian orang-orang itu yang sia-sia? {#Emph}Habis itu, pergilah."
      Speaker = "Narcissus"
      Event = "NarcissusFirstMeeting"
    }
    {
      Id = "Narcissus_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eh, {#Emph}astaga{#Prev}, kau kenapa? Masuk ke sini dengan penampilan seperti itu. Kau tidak butuh {#Emph}aku{#Prev}, bodoh. Kau butuh dokter, atau {#Emph}penyembuh{#Prev}, atau semacamnya."
      Speaker = "Narcissus"
      Event = "NarcissusLowHealth01"
    }
    {
      Id = "MelinoeField_1162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, yah, sosok seperti itu agak sulit ditemukan di sekitar sini. Tapi di sisi lain, tidak kekurangan monster mirip ikan yang bertekad membuatkan sepasang insang di leherku."
      Speaker = "Melinoe"
      Event = "NarcissusLowHealth01"
    }
    {
      Id = "Narcissus_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, itu yang selalu mereka katakan. Dengar, mungkin ada air mancur atau semacamnya di dekat sini. Cuci lukamu, kembali ke sini, baru kita {#Emph}bicara."
      Speaker = "Narcissus"
      Event = "NarcissusLowHealth01"
    }
    {
      Id = "Narcissus_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah, {#Prev}kau tidak akan pernah menemukan pasangan kalau penampilanmu penuh cakaran begitu, berdarah-darah di mana-mana. Mungkin aku punya sesuatu yang bisa kau pakai untuk menambal tubuhmu, asalkan kau mau lekas pergi."
      Speaker = "Narcissus"
      Event = "NarcissusLowHealth02"
    }
    {
      Id = "Narcissus_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menyerobot antrean, ya! Siapa pun kau, setidaknya kau punya nyali lebih besar ketimbang semua calon pemujaku di belakang sana. Meski begitu, kau tetap saja tidak punya {#Emph}peluang."
      Speaker = "Narcissus"
      Event = "NarcissusAboutSuitors01"
    }
    {
      Id = "MelinoeField_3503"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Arwah itu pasti sangat terpikat padamu saat masih hidup, mengingat mereka masih berkerumun di sini. Tapi aku tidak bermaksud menyerobot antrean, hanya ingin berterima kasih atas hadiahmu tempo hari."
      Speaker = "Melinoe"
      Event = "NarcissusAboutSuitors01"
    }
    {
      Id = "Narcissus_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku tahu semua trik pendekatan murahan, dan dalih {#Emph}'hanya ingin berterima kasih' {#Prev}adalah salah satu yang paling klasik. Pura-pura malu begitu! Yah, aku tahu apa yang sebenarnya kau inginkan, dan kau takkan mendapatkannya. Cuma {#Emph}ini."
      Speaker = "Narcissus"
      Event = "NarcissusAboutSuitors01"
    }
    {
      Id = "Narcissus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aturanku cuma satu, yaitu {#Emph}boleh pandang, jangan sentuh{#Prev}, oke? Malah, kenapa kau tidak mundur sedikit ke belakang, dan jelaskan kenapa kau terus bermunculan seperti ini?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutLooks01"
    }
    {
      Id = "Melinoe_2048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada beberapa urusan yang harus kuselesaikan di bagian bawah Dunia Bawah. Kupikir aku bisa lewat rute yang cukup indah ini, melintasi ruanganmu."
      Speaker = "Melinoe"
      Event = "NarcissusAboutLooks01"
    }
    {
      Id = "Narcissus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, ini bukan ruanganku. Hanya saja air di sini sangat jernih dan pantulannya sempurna, lalu calon pemuja di sini jauh lebih sedikit dibanding di Asfodel. Ingat untuk mengambil hadiah sebelum pergi!"
      Speaker = "Narcissus"
      Event = "NarcissusAboutLooks01"
    }
    {
      Id = "Narcissus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang aku bertanya-tanya, bagaimana jadinya kalau aku tidak begitu menawan luar biasa? Beberapa hal mungkin bakal lebih mudah... tidak perlu membuat semua orang jatuh cinta padaku... mungkin belajar berhitung..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutLooks02"
    }
    {
      Id = "Melinoe_2049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau cemas kalau ketampananmu malah merugikan dirimu sendiri...? Yah, kalau ini bisa membuatmu merasa lebih baik, menurutku kau sama sekali tidak begitu menarik..."
      Speaker = "Melinoe"
      Event = "NarcissusAboutLooks02"
    }
    {
      Id = "Narcissus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku tahu kau tidak bermaksud begitu. Tapi kuapresiasi usahamu menghiburku. {#Emph}Sebagai teman."
      Speaker = "Narcissus"
      Event = "NarcissusAboutLooks02"
    }
    {
      Id = "Narcissus_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tempat ini menyenangkan sekali, kan? Udaranya lembap, airnya sebening kristal. Dan tidak ada hujan! Aku sama sekali tidak bisa melihat wajahku kalau sedang hujan."
      Speaker = "Narcissus"
      Event = "NarcissusAboutChamber01"
    }
    {
      Id = "MelinoeField_3505"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang mendengar bahwa pelosok terluar Dunia Bawah yang terabaikan ini melampaui harapanmu. Tentunya Tuan Hades ingin semua rakyatnya terfasilitasi dengan baik di sini."
      Speaker = "Melinoe"
      Event = "NarcissusAboutChamber01"
    }
    {
      Id = "Narcissus_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, aku tahu tidak semua orang bisa mendapatkan tempat seindah {#Emph}ini. {#Prev}Tempat terbaik di seluruh Dunia Bawah hanya diberikan kepada mereka yang berhak atas jasanya saat masih hidup, kan? Yah, tidak heran kalau aku di sini!"
      Speaker = "Narcissus"
      Event = "NarcissusAboutChamber01"
    }
    {
      Id = "Narcissus_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu dia datang, Daun Salam, atau siapa pun namanya itu. Aku baru saja memikirkan saat pertama kali kami bertemu. Kutatap ke bawah ke permukaan air yang berkilauan... dan dia ada di sana. Mata kami saling bertatapan; seolah dia bisa melihat {#Emph}jiwaku. {#Prev}Sejak saat itu kami selalu bersama."
      Speaker = "Narcissus"
      Event = "NarcissusAboutBeauty01"
    }
    {
      Id = "MelinoeField_1160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, sepertinya aku belum pernah bertemu orang yang begitu terpesona pada dirinya sendiri sepertimu, Narcissus. Aku agak iri. Saat melihat diriku sendiri... ada begitu banyak kekurangan."
      Speaker = "Melinoe"
      Event = "NarcissusAboutBeauty01"
    }
    {
      Id = "Narcissus_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, aku paham maksudmu. Tak semua orang terlahir dengan kulit sehalus sutra... rambut berkilau... paket lengkap tanpa cela. Tapi setiap orang kan indah dengan caranya sendiri! {#Emph}Termasuk dirimu."
      Speaker = "Narcissus"
      Event = "NarcissusAboutBeauty01"
    }
    {
      Id = "MelinoeField_1992"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sulit dipercaya kau bisa sebegitu jatuh cintanya pada dirimu sendiri. Apa kau tidak pernah... merenungkan kesalahan yang pernah kau perbuat, atau cara agar kau bisa lebih baik lagi? Atau bahkan... cara agar {#Emph}tidak {#Prev}menjadi lebih baik?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutLove01"
    }
    {
      Id = "Narcissus_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, bercanda ya? Mana mungkin ada yang bisa menyempurnakan kesempurnaan {#Emph}ini? {#Prev}Tapi, aku paham maksudmu. Setidaknya untuk kasusmu."
      Speaker = "Narcissus"
      Event = "NarcissusAboutLove01"
    }
    {
      Id = "MelinoeField_1993"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu barusan ejekan, atau sebenarnya kau punya kritik dan masukan berharga tentang diriku yang mau kau bagikan?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutLove01"
    }
    {
      Id = "Narcissus_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau tidak puas dengan dirimu yang sekarang, kenapa tidak, ya, tinggal {#Emph}berubah saja? {#Prev}Atau kalau tidak bisa... ya sudahlah pasrah saja, entahlah."
      Speaker = "Narcissus"
      Event = "NarcissusAboutLove01"
    }
    {
      Id = "Narcissus_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, aku sempat berpikir... kalau kau tidak jatuh cinta pada{#Emph}ku{#Prev}, artinya kau pasti lagi kepincut berat sama orang lain! Jadi, siapa pria atau wanita atau siapa pun itu yang beruntung?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutLove02"
    }
    {
      Id = "MelinoeField_2852"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan urusanmu... tapi, kau sudah mau terbuka padaku. Dengar, caraku jatuh cinta tidak seperti yang kau bayangkan. Kisah-kisah tentang orang yang mabuk kepayang... aku sama sekali tak bisa memahaminya."
      Speaker = "Melinoe"
      Event = "NarcissusAboutLove02"
    }
    {
      Id = "Narcissus_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tidak apa-apa! Aku juga tidak paham urusan cinta orang lain. Lagipula, yang penting kau punya alasan untuk terus melangkah! Dan karena kau terus muncul ke sini, {#Emph}sepertinya kau memang punya alasan itu."
      Speaker = "Narcissus"
      Event = "NarcissusAboutLove02"
    }
    {
      Id = "Narcissus_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu banyak pemujaku yang bilang mereka cuma mau berteman, tapi... nyatanya mereka masih tergila-gila padaku. Terpaksa kuputus kontak. Kenapa ya, berteman itu rasanya jauh lebih susah daripada jatuh cinta?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutLove03"
    }
    {
      Id = "MelinoeField_2853"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin karena... jika menyangkut rasa kasmaran, butuh usaha keras untuk mengusirnya, {#Emph}bukan {#Prev}untuk merasakannya. Tapi merawat pertemanan... itu butuh kerja keras."
      Speaker = "Melinoe"
      Event = "NarcissusAboutLove03"
    }
    {
      Id = "Narcissus_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin juga. Dulu kupikir aku tak butuh teman karena aku tak pernah merasa kesepian, tapi ya... sesekali menyenangkan juga! Punya teman ngobrol tentang berbagai hal. Seperti Echo, dan seperti {#Emph}kamu!"
      Speaker = "Narcissus"
      Event = "NarcissusAboutLove03"
    }
    {
      Id = "Narcissus_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku masih sering heran kenapa banyak orang yang tidak bisa sekadar jadi teman saja? Maksudku, apa {#Emph}salahnya {#Prev}sih? Harus banget ya dibikin romantis lalu merusak semuanya!"
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship01"
    }
    {
      Id = "MelinoeField_2854"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin mereka hanya berjuang agar tidak merasa kesepian. Kita tak selalu bisa mengendalikan perasaan, atau bahkan mengetahui apa penyebabnya. Sehingga perasaan itu mengaburkan apa yang terbaik untuk kita."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship01"
    }
    {
      Id = "Narcissus_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sih tidak begitu! Tapi mungkin orang lain iya. Lagipula, pertemanan sejati hanyalah bentuk lain dari cinta, dan pasti sanggup melewati masa-masa sulit dari waktu ke waktu."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship01"
    }
    {
      Id = "Narcissus_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei tunggu, sekarang kau sudah semacam {#Emph}teman{#Prev}ku, kan? Kecuali kalau kau sedang pasang strategi jangka panjang... bikin aku lengah lalu langsung melancarkan {#Emph}serangan maut! {#Prev}Menjadi {#Emph}pemuja ulung..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship02"
    }
    {
      Id = "MelinoeField_3508"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham kenapa kau harus selalu waspada saat begitu banyak orang mencoba memikat hatimu meski kau sudah menegaskan tidak tertarik. Tapi aku bukan salah satu dari mereka."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship02"
    }
    {
      Id = "Narcissus_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zaman sekarang harus serba hati-hati. Jadi ya, jangan bikin gerakan tiba-tiba atau semacamnya, oke? Kalau kau ke sini bukan untukku... pasti mau salah satu dari {#Emph}ini."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship02"
    }
    {
      Id = "Narcissus_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku mau kau tahu, aku sudah mengambil kesimpulan kalau kau memang tidak berniat memikat hatiku. Justru, kesimpulan yang kudapat ini... {#Emph}jauh lebih meresahkan."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship03"
    }
    {
      Id = "MelinoeField_3509"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Lebih {#Prev}meresahkan? Baiklah, aku sudah bersiap. Apa kesimpulanmu tentang diriku, Narcissus? Setelah sekian lama ini."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship03"
    }
    {
      Id = "Narcissus_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesimpulanku adalah, kau cuma mengincar hadiah-hadiah gratis yang terus kubagikan padamu tanpa pamrih. Andaikan aku tidak sedermawan ini, tak bakal ada orang yang menyukaiku... apa {#Emph}adanya."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship03"
    }
    {
      Id = "MelinoeField_3510"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidakkah kau berpikir aku bisa menghargai kehadiranmu sama besarnya dengan menghargai hadiahmu? Kemurahan hatimu adalah bagian dari dirimu. Lagipula, kenapa tidak diuji saja kalau kau ragu?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship03"
    }
    {
      Id = "Narcissus_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}...Tidak! {#Prev}Tidak, atau... mungkin iya. Dengarkan, aku belum pernah mempertimbangkan itu sebelumnya. Konsekuensinya, {#Emph}aargh! {#Prev}Tolong tinggalkan aku sendiri agar bisa memikirkan artinya. Tapi sebelumnya..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship03"
    }
    {
      Id = "Narcissus_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kali ini aku tidak memberimu hadiah apa pun, apa pendapatmu soal itu, {#Emph}hah? {#Prev}Kuperingatkan ya, aku berani melakukannya!"
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship04"
    }
    {
      Id = "MelinoeField_3511"
      InheritFrom = "BaseNarrative"
      DisplayName = "Silakan saja, kalau itu membuatmu merasa lebih baik atau menepis segala keraguanmu! Lagipula saat ini aku juga jarang membutuhkan barang-barang yang kau tawarkan."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship04"
    }
    {
      Id = "Narcissus_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau cuma {#Emph}menggertak! {#Prev}Kau {#Emph}ingin {#Prev}aku menganugerahkan salah satu persembahanku yang melimpah ini. Nah, biar kutunjukkan padamu! Aku benar-benar akan melakukannya! Kali ini... kau dapat... {#Emph}nihil! {#Prev}Bagaimana rasanya? {#Emph}Rasakan itu!"
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship04"
    }
    {
      Id = "MelinoeField_3649"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak masalah sama sekali. Sampai jumpa lagi!"
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship04"
    }
    {
      Id = "Narcissus_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Mau apa kau ke sini, Laurel? Aku tidak sedang mencari pasangan, aku sudah tidak bagi-bagi barang lagi, dan aku sadar diriku tak pantas jadi bahan pertemanan. Biarkan aku {#Emph}sendiri..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship05"
    }
    {
      Id = "MelinoeField_3512"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kekhawatiran barumu adalah ingin pantas dijadikan teman, kau bisa memulainya dengan mengingat namaku dengan benar. Namaku Melinoë. Walaupun, lama-lama aku mulai terbiasa dipanggil Laurel..."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship05"
    }
    {
      Id = "Narcissus_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Dan gara-gara omonganmu {#Emph}itu{#Prev}, kali {#Emph}ini {#Prev}kau tidak dapat hadiah dariku lagi! Hebat sekali caraku berteman, kan? Sekarang biarkan aku kembali mencurahkan perhatian penuhku kepada satu-satunya sosok yang {#Emph}benar-benar {#Prev}kupedulikan."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship05"
    }
    {
      Id = "MelinoeField_3650"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah kau saja."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship05"
    }
    {
      Id = "Narcissus_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau memang teman yang baik, sobat. Bahkan jauh lebih dari itu. Selalu ada untukku, kan? Kecuali waktu airnya mendadak jadi keruh, tapi untungnya Laurel, um... {#Emph}Melinoë... {#Prev}dia benar-benar menolong kita berdua."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship06"
    }
    {
      Id = "MelinoeField_3513"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi sekarang kau malah mengabaikanku, hanya karena entah mengapa kau merasa mustahil percaya bahwa aku menghargai kehadiranmu, bukan cuma tumpukan hadiah yang sebenarnya tak kuinginkan."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship06"
    }
    {
      Id = "Narcissus_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak dengar, tak dengar! Dan kalau memang hadiah-hadiahku tidak kauinginkan, kurasa kau takkan keberatan kalau aku tak pernah memberimu hadiah apa pun lagi {#Emph}selamanya."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship06"
    }
    {
      Id = "MelinoeField_3651"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja, aku tidak keberatan."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship06"
    }
    {
      Id = "Narcissus_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kadang aku kepikiran gimana kabarnya si Echo... gimana kabar {#Emph}kamu{#Prev}, maksudnya {#Emph}kamu{#Prev}, bukan {#Emph}aku... {#Prev}terus aku mulai mikir, apa kamu juga mikirin kabar {#Emph}aku{#Prev}. Aneh banget rasanya."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship07"
    }
    {
      Id = "MelinoeField_3514"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupastikan itu wajar-wajar saja. Tapi kamu tak perlu menerka-nerka apa yang kupikirkan; tanya saja langsung! Lagipula aku akan terus mampir sesekali, selama kau tak keberatan."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship07"
    }
    {
      Id = "Narcissus_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu bakal tetap mampir meski aku udah berhenti ngasih kamu hadiah, jadi satu-satunya alasanmu singgah cuma buat melihatku?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship07"
    }
    {
      Id = "MelinoeField_3515"
      InheritFrom = "BaseNarrative"
      DisplayName = "Antara melihatmu, atau Ular Laut, atau hal semacamnya."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship07"
    }
    {
      Id = "Narcissus_0279"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Iya sih..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship07"
    }
    {
      Id = "Narcissus_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal tahu ya, semenjak aku berhenti ngasih kamu pilihan hadiah yang tak kuinginkan itu, barang-barangnya jadi numpuk banget... Ada beberapa yang lumayan {#Emph}bagus{#Prev} juga di belakang sana..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship08"
    }
    {
      Id = "MelinoeField_3516"
      InheritFrom = "BaseNarrative"
      DisplayName = "Barang-barang itu dimaksudkan untuk{#Emph}mu{#Prev} dan bukan orang lain, Narcissus. Aku yakin para pemujamu lebih suka kamu yang menyimpannya."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship08"
    }
    {
      Id = "Narcissus_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, lucunya soal itu, beberapa Arwah ini kayaknya pernah dengar tentangmu! Tapi mereka {#Emph}terlalu{#Prev} minder buat ngasih langsung ke kamu, jadi... mereka titipin ke {#Emph}aku{#Prev}."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship08"
    }
    {
      Id = "MelinoeField_3517"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Jadi sebagian dari Sampel Kesuburan, Persembahan Leluhur, dan semacamnya itu... sedari awal memang untukku?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship08"
    }
    {
      Id = "Narcissus_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin sebagian besar yang belakangan ini, tapi aku jelas lupa jumlahnya. Pokoknya begitulah, {#Emph}eh... {#Prev}nih."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship08"
    }
    {
      Id = "Narcissus_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, makasih udah mampir. Kukira kamu pasti bakal pergi pas aku berhenti ngasih barang gratisan. Apalagi sebagian besar barangnya itu punyamu. Tapi kamu nggak ninggalin aku gitu aja."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship09"
    }
    {
      Id = "MelinoeField_3518"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau hanya terlihat seperti sedang melewati suatu masa yang sulit, dan bukan jenis masalah yang bisa diringankan oleh mantra. Memang benar aku tak selalu menganggapmu sebagai teman, Narcissus; tapi sekarang iya."
      Speaker = "Melinoe"
      Event = "NarcissusAboutFriendship09"
    }
    {
      Id = "Narcissus_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lucu ya, aku... {#Emph}percaya kata-katamu{#Prev}. Dan karena teman itu saling bantu, mending kamu pilih salah satu dari ini. Para Arwah di belakang sana bawain banyak banget buat kita berdua."
      Speaker = "Narcissus"
      Event = "NarcissusAboutFriendship09"
    }
    {
      Id = "Melinoe_2050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau tak kesepian duduk di sini, memandangi perairan itu terus? Terlebih lagi di tempat seperti ini."
      Speaker = "Melinoe"
      Event = "NarcissusAboutSolitude01"
    }
    {
      Id = "Narcissus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesepian? Aku bahkan nggak tahu arti kata itu. Aku ditemani oleh sosok terbaik yang pernah ada: {#Emph}Diriku sendiri!{#Prev}"
      Speaker = "Narcissus"
      Event = "NarcissusAboutSolitude01"
    }
    {
      Id = "MelinoeField_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukankah makhluk-makhluk ganas yang mencemari ruangan-ruangan ini membuat tempat ini agak terlalu berbahaya untuk bermalas-malasan?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutDanger01"
    }
    {
      Id = "Narcissus_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku sudah menegaskan ke mereka kalau mereka nggak punya peluang sama sekali denganku. Di posisiku sekarang, nggak baik memberi harapan palsu. Demi kebaikan pemujaku... dan juga demi {#Emph}diriku sendiri{#Prev}."
      Speaker = "Narcissus"
      Event = "NarcissusAboutDanger01"
    }
    {
      Id = "Narcissus_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin ini kutukan... hal yang kumiliki ini. Semua orang langsung jatuh hati begitu melihatku, maksudku, aku {#Emph}paham{#Prev} sih! Tapi ya tetap saja. Mereka bahkan nggak mengenalku...."
      Speaker = "Narcissus"
      Event = "NarcissusAboutCurse01"
    }
    {
      Id = "MelinoeField_2851"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya sekadar tergila-gila yang berkedok cinta... namun ada benarnya juga, para pemujamu sebaiknya memeriksa kembali perasaan mereka sesekali. Serta menghargai privasimu."
      Speaker = "Melinoe"
      Event = "NarcissusAboutCurse01"
    }
    {
      Id = "Narcissus_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, Arwah-Arwah di sekitar sini nggak seburuk itu kurasa. Mereka tahu batasan! Waktu aku sempat hilang arah di perairan ini... mereka menemaniku. Sama sepertimu{#Emph}{#Prev}."
      Speaker = "Narcissus"
      Event = "NarcissusAboutCurse01"
    }
    {
      Id = "MelinoeField_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Narcissus, bagaimana ceritanya kau bisa menemukan tempat ini? Aku tak menyangka bisa mengobrol santai di pinggiran Dunia Bawah begini."
      Speaker = "Melinoe"
      Event = "NarcissusAboutOceanus01"
    }
    {
      Id = "Narcissus_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu tahu seluk-beluk sungai dan lautan. Setelah mati, aku sempat terdampar di Asphodel sebentar. Di sana terlalu {#Emph}kering{#Prev}. Jadi begitu Dunia Bawah terbuka, aku langsung berenang ke sini. Tempat yang {#Emph}sejuk{#Prev}."
      Speaker = "Narcissus"
      Event = "NarcissusAboutOceanus01"
    }
    {
      Id = "Narcissus_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kamu ini kenapa sih? Selalu terburu-buru lewat sini kayak orang dikejar waktu. Kamu harus belajar {#Emph}santai{#Prev}."
      Speaker = "Narcissus"
      Event = "NarcissusAboutOceanus02"
    }
    {
      Id = "MelinoeField_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya kau ada di sana saat Dunia Bawah terbuka. Seharusnya itu tidak pernah terjadi."
      Speaker = "Melinoe"
      Event = "NarcissusAboutOceanus02"
    }
    {
      Id = "Narcissus_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Loh kenapa? Kalau nggak gitu, aku masih kisut kepanasan di Asphodel! Tapi ya sudahlah, lupakan saja pertanyaanku. Kamu merusak suasana hatiku saja."
      Speaker = "Narcissus"
      Event = "NarcissusAboutOceanus02"
    }
    {
      Id = "Narcissus_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tenang saja, kawan, dia nggak seburuk itu, dia nggak bakal lama di sini. Sebentar lagi tinggal kita berdua lagi... bareng semua {#Emph}Arwah{#Prev} di belakang sana."
      Speaker = "Narcissus"
      Event = "NarcissusAboutReflection01"
    }
    {
      Id = "MelinoeField_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf menyela, Narcissus. Apa kau baru saja... berbicara pada bayanganmu sendiri?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutReflection01"
    }
    {
      Id = "Narcissus_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka selalu cepat menghakimi, kan? Dengar ya, Laurel, atau siapa pun namamu: Kamu nggak akan pernah paham apa yang kumiliki. Jangan coba-coba {#Emph}sok tahu{#Prev}."
      Speaker = "Narcissus"
      Event = "NarcissusAboutReflection01"
    }
    {
      Id = "Narcissus_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Menurutmu apa kelebihan terbaikmu, kalau harus memilih? Satu hal yang paling kamu kagumi... yang bikin semua orang di sekitarmu sampai {#Emph}tergila-gila{#Prev}...?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutReflection02"
    }
    {
      Id = "MelinoeField_1157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, a-aku, {#Emph}um... {#Prev}yah... kurasa aku cukup perhatian. Jika kau memberitahuku sesuatu, kau tak perlu mengulanginya dua kali! Kemungkinan besar aku akan langsung mengingatnya. Tapi, kenapa kau bertanya?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutReflection02"
    }
    {
      Id = "Narcissus_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Pff{#Prev}, mulai deh, ikut campur obrolan pribadi orang! Aku tahu kelebihan terbaikmu, kawan: {#Emph}wajahmu{#Prev}. Siapa pun yang bilang tampang bukan segalanya itu orang bodoh. Kayak cewek yang satu ini nih! Kasih saja dia hadiah, biar dia pergi dan nggak ganggu kita lagi!"
      Speaker = "Narcissus"
      Event = "NarcissusAboutReflection02"
    }
    {
      Id = "Narcissus_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Harus kuakui, rambutmu kelihatan {#Emph}keren banget{#Prev} belakangan ini, tahu nggak? Gaya basah alami gitu! Pasti gara-gara udara lembap dan uap air garam. {#Emph}Pertahankan ya{#Prev}."
      Speaker = "Narcissus"
      Event = "NarcissusAboutReflection03"
    }
    {
      Id = "MelinoeField_1158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku baru saja ingin berterima kasih atas pujianmu itu, sampai akhirnya aku tersadar kalau kau kemungkinan besar cuma berbicara pada dirimu sendiri lagi. Kalau begitu, maaf sudah menyela!"
      Speaker = "Melinoe"
      Event = "NarcissusAboutReflection03"
    }
    {
      Id = "Narcissus_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Santai saja. Waktuku buat diriku sendiri masih banyak. Tapi kamu cuma bisa melihatku, apa, paling sehari sekali? Mending daripada nggak sama sekali, meski {#Emph}masih sangat kurang{#Prev}."
      Speaker = "Narcissus"
      Event = "NarcissusAboutReflection03"
    }
    {
      Id = "Narcissus_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Hei, ingat nggak waktu kamu lagi asyik mengagumi diri sendiri, terus ada lebah yang hinggap tepat di mukamu, langsung kamu tepuk, {#Emph}plak! {#Prev}Matamu bengkak sampai nggak bisa melek semingguan. Waktu itu kamu kelihatan {#Emph}jelek banget{#Prev}, sumpah!"
      Speaker = "Narcissus"
      Event = "NarcissusAboutReflection04"
    }
    {
      Id = "MelinoeField_1159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf, Narcissus. Kedengarannya itu pengalaman yang sangat mengerikan. Apakah cintamu pada dirimu sendiri sempat goyah saat bayangan yang menatapmu balik punya kelopak mata yang bengkak besar?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutReflection04"
    }
    {
      Id = "Narcissus_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak lah! {#Prev}Maksudku... nggak juga. Tapi cinta ini lebih dalam dari sekadar fisik. Meski aku tak bisa menatap diriku... aku masih bisa ngobrol dengan diriku... dan andai aku tak bisa melakukannya pun, aku selalu bisa {#Emph}memikirkan {#Prev}diriku, paham kan? Dan {#Emph}kamu {#Prev}juga bisa."
      Speaker = "Narcissus"
      Event = "NarcissusAboutReflection04"
    }
    {
      Id = "Narcissus_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi ada aroma harum banget di sekitar sini... seperti wangi lilac terbawa angin musim panas, atau semacamnya. Aku {#Emph}kira {#Prev}itu dari kamu. Ternyata cuma hadiah yang kuberikan padamu tempo hari. {#Emph}Barang bagus itu."
      Speaker = "Narcissus"
      Event = "NarcissusAboutKeepsake01"
    }
    {
      Id = "MelinoeField_1161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Botol Aromatik yang kauberikan ini memang wangi sekali, ya? Aku nyaris tak menyadarinya di tengah bau amis dan air asin di sekitar sini. Meski tampaknya itu sama sekali tidak mengganggumu."
      Speaker = "Melinoe"
      Event = "NarcissusAboutKeepsake01"
    }
    {
      Id = "Narcissus_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku abaikan saja. Sama seperti hal-hal lainnya. Perhatian penuhku kuberikan... untuk {#Emph}diriku... {#Prev}dan kurasa sebagian kecil untukmu, tapi berhubung kamu tak lama-lama di sini, jadi nggak masalah."
      Speaker = "Narcissus"
      Event = "NarcissusAboutKeepsake01"
    }
    {
      Id = "Narcissus_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah{#Prev}, ternyata cuma kamu. Akhir-akhir ini makin ramai saja, banyak yang ajak ngobrol dan si {#Emph}siapa-lah-namanya {#Prev}yang jalan sambil menghentak-hentak kaki itu... setidaknya kamu bukan {#Emph}dia."
      Speaker = "Narcissus"
      Event = "NarcissusAboutNemesis01"
    }
    {
      Id = "MelinoeField_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa-lah-namanya, kedengarannya seperti Nemesis. Tatapan mencemooh, rambut gelap, dan memakai zirah? Memangnya ada masalah apa kamu dengannya?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutNemesis01"
    }
    {
      Id = "Narcissus_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bawaannya bikin {#Emph}bad mood. {#Prev}Suka bikin ribut, bikin heboh semuanya. Ada yang aneh dari dia, entahlah. Kepalaku jadi pusing, jangan dibahas lagi ya?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutNemesis01"
    }
    {
      Id = "MelinoeField_1145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu baik-baik saja? Nemesis memang bisa agak ketus. Dia tidak menyakitimu atau berbuat kasar, kan?"
      Speaker = "Melinoe"
      Event = "NemesisWithNarcissus01_FollowUp"
    }
    {
      Id = "Narcissus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi dia bilang sesuatu... katanya aku {#Emph}terjebak selamanya bersama seorang badut bodoh. {#Prev}Masa maksudnya... nggak mungkin lah. Dia cuma cemburu. Dia {#Emph}suka {#Prev}padaku! Dan sok jual mahal. Nggak seperti {#Emph}orang-orang tertentu {#Prev}yang terlalu agresif."
      Speaker = "Narcissus"
      Event = "NemesisWithNarcissus01_FollowUp"
    }
    {
      Id = "MelinoeField_2033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa Nemesis tidak sedang jual mahal. Dia hanya ingin memastikan kamu tidak kelewat beruntung! Untunglah, kurasa dia bakal membiarkanmu tenang setelah ini."
      Speaker = "Melinoe"
      Event = "NemesisWithNarcissus02_FollowUp"
    }
    {
      Id = "Narcissus_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa sih? Atau kamu cuma mau menyingkirkannya supaya bisa menikmati diriku {#Emph}sendirian? {#Prev}Mengharapkan perlakuan khusus cuma gara-gara kamu membantuku soal air itu, {#Emph}ihh!"
      Speaker = "Narcissus"
      Event = "NemesisWithNarcissus02_FollowUp"
    }
    {
      Id = "MelinoeField_2034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Aku sama sekali tak mengharapkan perlakuan khusus darimu! Meski... aku rasa aku mulai terbiasa dengan hadiah-hadiah yang kauberikan setiap kali aku berkunjung. Betapa mudahnya kita terbiasa akan suatu hal."
      Speaker = "Melinoe"
      Event = "NemesisWithNarcissus02_FollowUp"
    }
    {
      Id = "Narcissus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya sudahlah, {#Emph}aku {#Prev}malah terbiasa pusing tiap kali kamu bahas hal-hal begini. Aku bakal tetap kasih ini padamu karena kasihan... dan karena aku {#Emph}nggak mau menyimpannya."
      Speaker = "Narcissus"
      Event = "NemesisWithNarcissus02_FollowUp"
    }
    {
      Id = "MelinoeField_1991"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernah menonton pertunjukan lokal di sekitar sini? Scylla dan The Sirens terus bernyanyi malam demi malam, padahal kuharap mereka sudah pindah ke panggung berikutnya untuk tur mereka sekarang..."
      Speaker = "Melinoe"
      Event = "NarcissusAboutSirens01"
    }
    {
      Id = "Narcissus_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu-satunya musik yang kusukai cuma {#Emph}suaraku sendiri. {#Prev}Suara lain itu terlalu berisik, sampai bikin riak di permukaan air. Dan apa pun yang mengganggu permukaan air... {#Emph}mengganggu diriku."
      Speaker = "Narcissus"
      Event = "NarcissusAboutSirens01"
    }
    {
      Id = "MelinoeField_1990"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang bisa mengusikmu! Perang berkecamuk antara Titan Kronos dan para dewa, tapi kamu bahkan tak menunjukkan kekhawatiran sedikit pun. Apa rahasiamu?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutChronos01"
    }
    {
      Id = "Narcissus_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku nggak punya rahasia, Laurel. Cuma ya... {#Emph}aku nggak peduli. {#Prev}Kalau nggak ada sangkut pautnya denganku, ya bukan urusanku. Masalahku sendiri sudah numpuk... contohnya, cara terbaik menyingkirkan semua barang {#Emph}ini."
      Speaker = "Narcissus"
      Event = "NarcissusAboutChronos01"
    }
    {
      Id = "Narcissus_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jarang lihat kamu belakangan ini. Kukira kamu sudah move on. Tapi kupikir-pikir lagi, mustahil lah. {#Emph}Mereka pasti selalu kembali."
      Speaker = "Narcissus"
      Event = "NarcissusAboutSurface01"
    }
    {
      Id = "MelinoeField_3504"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada beberapa urusan yang harus kuselesaikan di permukaan akhir-akhir ini, jadi aku menghabiskan lebih banyak malam di atas sana. Tapi terima kasih sudah menyadari ketidakhadiranku."
      Speaker = "Melinoe"
      Event = "NarcissusAboutSurface01"
    }
    {
      Id = "Narcissus_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma sadar hadiah-hadiah tak terpakai makin menumpuk! Singkirkan salah satunya buatku, bisa kan? Mungkin kenalanmu ada yang butuh... nun jauh di {#Emph}atas sana."
      Speaker = "Narcissus"
      Event = "NarcissusAboutSurface01"
    }
    {
      Id = "Melinoe_2051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fokusmu luar biasa. Sangat berpusat pada diri sendiri. Sampai-sampai kebal terhadap nyanyian tiada henti yang selalu menggema di lorong-lorong ini."
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho01"
    }
    {
      Id = "Narcissus_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak usah bawa-bawa Gema ini atau Gema itu di depanku, paham? Echo sama sekali nggak berarti buatku dan dia saja yang salah paham. Dan kamu juga {#Emph}jangan {#Prev}berpikiran yang aneh-aneh."
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho01"
    }
    {
      Id = "MelinoeField_2032"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak usah bawa-bawa gema{#Prev}, apa maksudmu...? Aku sedang membicarakan lagunya Scylla. Entah bagaimana kamu bisa mengabaikannya, padahal... astaga, kurasa aku mulai menyukainya..."
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho01"
    }
    {
      Id = "Narcissus_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana kalau aku mulai mengabaikan {#Emph}kamu! {#Prev}Pakai {#Emph}ini."
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho01"
    }
    {
      Id = "MelinoeField_1144"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Echo sama sekali nggak berarti buatmu{#Prev}, apa maksudmu... Aku tadi membicarakan nyanyian Scylla dan caramu mengabaikannya. Kalau dipikir-pikir, sekarang aku juga tak terlalu mendengarnya."
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho01B"
    }
    {
      Id = "Narcissus_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar ya, aku tahu kamu susah move on. Mungkin kamu sebaiknya meluangkan waktu di Ladang sana. Menjernihkan pikiran, menyusun kembali serpihan hatimu, dan sebagainya?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho02"
    }
    {
      Id = "MelinoeField_1146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau yang kaumaksud Mourning Fields, kurasa itu bukan tempat pemulihan. Arwah di sana tenggelam dalam rasa iba diri dan keputusasaan bisu. Meski begitu, ada satu sosok yang menirukan apa pun yang kukatakan padanya..."
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho02"
    }
    {
      Id = "Narcissus_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menirukan apa pun yang kamu katakan! Dulu aku kenal Nimfa seperti itu. Cewek baik sih. Tapi dia nggak memahamiku! Cuma pernah ngomongin tentang {#Emph}dirinya sendiri. {#Prev}Terpaksa ku-cut off dia."
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho02"
    }
    {
      Id = "MelinoeField_1147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kamu kenal Echo, Nimfa Gunung itu! Bahkan sampai sekarang dia merana di Ladang Duka. Tampaknya gara-gara dirimu. Aku bahkan hampir tak bisa mengajaknya bicara normal..."
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho02"
    }
    {
      Id = "Narcissus_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, sayang sekali ya. Yah, bilang padanya Narcissus sangat mendoakan yang terbaik untuknya. Kecuali kalau yang terbaik itu {#Emph}aku. {#Prev}Tapi bagian itu nggak usah dibilang, ya."
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho02"
    }
    {
      Id = "MelinoeField_1492"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bicara pada Echo tentangmu. Kubilang kamu tidak bermaksud menyakitinya, walau mungkin seharusnya tak kukatakan. Dia menjawab dengan gayanya yang biasa, tapi aku tahu ada sesuatu yang terjadi. Kau patahkan hatinya?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho03"
    }
    {
      Id = "Narcissus_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia mematahkan hatinya {#Emph}sendiri! {#Prev}Mereka selalu jatuh cinta pada orang yang nggak bisa membalas perasaannya. Lagian, aku yakin dia bakal nemu orang yang menganggapnya... {#Emph}keren. {#Prev}Masih banyak ikan... {#Emph}di laut!"
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho03"
    }
    {
      Id = "MelinoeField_1149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, aku sudah melihatnya sendiri. Jadi, apa pernah ada orang yang berhenti mencintaimu? Ataukah mereka semua berakhir di Mourning Fields, merindukanmu untuk selamanya?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho03"
    }
    {
      Id = "Narcissus_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang kutahu, nggak ada yang pernah mencintaiku sebesar {#Emph}diriku sendiri. {#Prev}Mereka semua terlalu sibuk mengasihani diri sendiri sampai nggak sempat peduli sungguhan, paham kan? Mana bisa mencintai orang lain... kalau nggak bisa mencintai {#Emph}diri sendiri."
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho03"
    }
    {
      Id = "Narcissus_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, coba beri tahu aku. Apa Echo benar-benar tidak baik-baik saja? Aku sempat memikirkan ucapanmu soal dia yang sendirian di Padang Ratapan... bagaimana bisa aku menyakiti seseorang tanpa sengaja, tahu?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho04"
    }
    {
      Id = "MelinoeField_1150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Narcissus, jangan tersinggung, tapi aku kagum kau sempat memikirkan orang lain. Soal Echo, tampaknya dia baik-baik saja. Ada yang ingin kau sampaikan padanya kalau aku berpapasan dengannya lagi?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho04"
    }
    {
      Id = "Narcissus_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu, {#Emph}um... {#Prev}katakan saja padanya kalau aku berharap dia menemukan seseorang yang mencintainya sebesar aku mencintai {#Emph}diriku sendiri. {#Prev}Tapi jangan bilang itu dariku, dia bisa salah paham dan hatinya bakal hancur... lagi."
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho04"
    }
    {
      Id = "MelinoeField_1988"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu, apa kau akan mengunjungi Echo lagi di Padang Ratapan? Tampaknya kau tidak kesulitan bolak-balik ke sana."
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho05"
    }
    {
      Id = "Narcissus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa jadi, sih! Tapi di sana agak terlalu ramai, dan aku suka di sini. Jadi dipikir-pikir lagi, mungkin tidak usah! Hubungan kami sudah selesai baik-baik. Kenapa harus merusak sesuatu yang {#Emph}sudah sempurna?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho05"
    }
    {
      Id = "Narcissus_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, hal aneh baru saja terjadi belakangan ini... Aku mendapati diriku memikirkan Echo... sebagai seorang teman. Kau bilang kami terkutuk, tapi aku {#Emph}suka {#Prev}kutukanku. Ini {#Emph}berkah! {#Prev}Tapi bagaimana dengan dia?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho06"
    }
    {
      Id = "MelinoeField_2849"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertanyaan bagus! Kenapa tidak kau kunjungi dia lagi dan tanyakan sendiri? Kau bicara soal pertemanan padanya. Teman saling berbagi beban, bukan?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho06"
    }
    {
      Id = "Narcissus_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mirip seperti caramu berbagi beban persediaan hadiah tanpa batas ini, kan? Tapi masalahnya begini: rasanya aku tidak bisa meninggalkan tempat ini lagi... mumpung airnya sudah jernih."
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho06"
    }
    {
      Id = "MelinoeField_2850"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau cuma pergi sebentar saja. Dan cinta sejatimu akan selalu bersamamu, meski kau tidak selalu bisa menatap matanya dalam-dalam."
      Speaker = "Melinoe"
      Event = "NarcissusAboutEcho06"
    }
    {
      Id = "Narcissus_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, ya, {#Emph}baiklah{#Prev}, jangan memaksaku terus! Tapi kalau kau bertemu Echo, beri tahu kalau {#Emph}temannya {#Prev}ini titip salam, oke?"
      Speaker = "Narcissus"
      Event = "NarcissusAboutEcho06"
    }
    {
      Id = "Narcissus_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau lagi. Dengar, aku... mau kau tinggalkan aku sendiri, oke? Soalnya aku sedang berkabung. Dan satu-satunya yang boleh melihatku seperti ini... cuma {#Emph}aku."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters01"
    }
    {
      Id = "MelinoeField_1151"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Berkabung{#Prev}, tunggu. Ada apa dengan air di sini...? Keruh sekali. Astaga! Kau tidak bisa melihat bayanganmu lagi..."
      Speaker = "Melinoe"
      Event = "NarcissusAboutWaters01"
    }
    {
      Id = "Narcissus_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak usah diperjelas begitu, bodoh! Lagipula kau juga tidak bisa berbuat apa-apa. Banyak hal yang memburuk seiring waktu. Jadi tolong biarkan aku meratapi apa yang telah hilang dariku..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters01"
    }
    {
      Id = "Narcissus_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak sadar kau masuk. Soalnya aku sudah tidak bisa melihat apa-apa lagi di sini... Tapi aku yakin airnya bakal jernih lagi! Yah, setidaknya aku {#Emph}pikir {#Prev}aku yakin..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters01_2"
    }
    {
      Id = "MelinoeField_2844"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang tidak beres. Pencemaran seperti ini biasanya tidak bertahan lebih dari satu atau dua malam. Sudah coba periksa tempat lain? Air di tempat lain tidak seperti ini."
      Speaker = "Melinoe"
      Event = "NarcissusAboutWaters01_2"
    }
    {
      Id = "Narcissus_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau cuma mengarang alasan agar aku pergi supaya kau bisa merebut tempatku! Dan sejak kapan {#Emph}kau {#Prev}jadi pakar penyaringan air? {#Emph}Tidak usah repot{#Prev}, masalah begini biasanya akan {#Emph}beres dengan sendirinya."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters01_2"
    }
    {
      Id = "Narcissus_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, aku sudah berpikir panjang, dan... sepertinya air ini memang tidak akan jernih lagi. Aku bahkan sudah memeriksa tempat lain, dan benar saja... {#Emph}sama saja."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters01_3"
    }
    {
      Id = "MelinoeField_2845"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lupakan soal airnya sejenak, ada sesuatu yang terjadi padamu. Entah kau menyumpahi dirimu sendiri atau ulah orang lain, aku tak bisa memastikan. Apa kau terus-menerus memendam rasa bersalah, dendam, atau semacamnya?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutWaters01_3"
    }
    {
      Id = "Narcissus_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jelas tidak! {#Prev}Keadaanku {#Emph}jauh {#Prev}lebih baik dari biasanya! Kecuali fakta bahwa airnya tidak lagi jernih. Aku tidak pernah merasa bersalah atau dendam seumur hidupku. Yah, kecuali kalau maksudmu... hm... {#Emph}yah."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters01_3"
    }
    {
      Id = "MelinoeField_1152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Airnya masih saja kotor. Aku tahu berbagai macam ritual penyucian. Kau sudah sering membantuku, setidaknya aku bisa membantu membereskan masalah ini."
      Speaker = "Melinoe"
      Event = "NarcissusAboutWaters02"
    }
    {
      Id = "Narcissus_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan apa rencanamu, menyiram sebongkah sabun? Mana mempan. Lautan di luar sana luas sekali! {#Emph}Tidak{#Prev}, kurasa... kurasa aku harus merelakannya saja."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters02"
    }
    {
      Id = "MelinoeField_2846"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin itu jalan keluarnya! Tadi kau bilang ingin meratapi apa yang telah hilang. Kau bisa mencobanya di Padang Ratapan di bawah, tempat Echo bersemayam sekarang. Jika kau bisa berdamai dengan masa lalumu bersamanya, mungkin auramu bisa disucikan kembali."
      Speaker = "Melinoe"
      Event = "NarcissusAboutWaters02"
    }
    {
      Id = "Narcissus_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu mengobrol dengan Echo bakal menjernihkan masalah ini? Yah... tidak ada salahnya dicoba, kurasa. Dan mereka memujaku di Padang Ratapan! Begini saja. Aku akan... {#Emph}memikirkannya..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters02"
    }
    {
      Id = "Narcissus_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, hei. Ya, aku masih di sini. Walau sempat terlintas untuk berkunjung ke Padang Ratapan suatu hari nanti... atau malam nanti? Entahlah."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters03"
    }
    {
      Id = "MelinoeField_1154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunakan waktumu sebanyak yang kau butuhkan. Aku tahu ini pasti berat, dan perjalanannya berbahaya. Kau bisa pergi bersamaku kalau mau?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutWaters03"
    }
    {
      Id = "Narcissus_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terdengar seperti kencan, {#Emph}tidak{#Prev}, terima kasih. Aku bisa pergi sendiri tanpa masalah. Tapi untuk saat ini... aku masih bisa melihat sedikit {#Emph}paras rupawanku {#Prev}di sini kalau memicingkan mata kuat-kuat. {#Emph}Tetap tampan..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters03"
    }
    {
      Id = "Narcissus_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah bicara dengan Echo seperti saranmu. Terus {#Emph}kenapa? {#Prev}Tempat ini masih sama saja! Kupikir kau bakal membereskan semuanya."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters04"
    }
    {
      Id = "MelinoeField_2847"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penjelasanku sepertinya kurang jelas. {#Emph}Kaulah {#Prev}yang harus membereskan semuanya, bukan aku. Kau dan Echo sama-sama terkutuk, dan kutukan kalian kini saling terikat. Masih ada hal yang harus kalian bicarakan dan selesaikan bersama."
      Speaker = "Melinoe"
      Event = "NarcissusAboutWaters04"
    }
    {
      Id = "Narcissus_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu aku terkutuk bagaimana, {#Emph}kaulah {#Prev}yang terkutuk, maksudku aku punya {#Emph}segalanya! {#Prev}Kau tidak tahu apa-apa...! Kecuali kalau kau memang benar..."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters04"
    }
    {
      Id = "Narcissus_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah bicara lagi dengannya seperti yang kau minta, tapi tidak ada yang berubah di sini. Walaupun perasaanku agak berbeda, sih. Kurasa aku harus puas dengan hasil ini."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters04_2"
    }
    {
      Id = "MelinoeField_1155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan khawatir, aku selalu menepati sumpahku; ritual penyuciannya belum kuselesaikan. Aku menghargai keberanianmu menemui Echo, meski itu demi kepentinganmu sendiri."
      Speaker = "Melinoe"
      Event = "NarcissusAboutWaters04_2"
    }
    {
      Id = "Narcissus_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, begitulah cinta, kan? Sepertinya aku akan... santai di sini saja sampai kau menyelesaikan urusanmu. Padang Ratapan memang bagus, tapi... terlalu banyak pengagum yang mengantre di sana."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters04_2"
    }
    {
      Id = "MelinoeField_1989"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau masih saja meratapi nasib berusaha melihat bayanganmu di genangan lumpur ini. Kenapa tidak pindah saja? Air di tempat lain tidak sekeruh ini."
      Speaker = "Melinoe"
      Event = "NarcissusAboutStillDirtyWaters01"
    }
    {
      Id = "Narcissus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku tidak akan pernah meninggalkanmu, sobat. Aku yang membuat kita begini, aku juga yang akan mencari jalan keluarnya, oke? Jangan menyerah dulu! Kita pasti bisa mencari caranya, kita cuma perlu fokus. Tidak boleh ada gangguan!"
      Speaker = "Narcissus"
      Event = "NarcissusAboutStillDirtyWaters01"
    }
    {
      Id = "Narcissus_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Laurel, lihat! Airnya sudah jernih semua! Kau tidak tahu betapa senangnya aku bisa melihat diriku {#Emph}lagi. {#Prev}Kau pasti sudah menyelesaikan {#Emph}ritualmu! {#Prev}Ingin rasanya kupeluk dirimu, tapi... aku tidak mau kau sampai salah paham."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters05"
    }
    {
      Id = "MelinoeField_1156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah. Berarti pemurniannya berhasil. Echo pasti benar-benar meresapi perkataanmu. Mungkin kau tidak seputus asa yang kutakutkan soal narsisme ini."
      Speaker = "Melinoe"
      Event = "NarcissusAboutWaters05"
    }
    {
      Id = "Narcissus_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Ngomong apa tadi? Sori, aku tadi cuma... ya ampun, {#Emph}lihat {#Prev}ini, lekukan {#Emph}dagu{#Prev} ini, garis {#Emph}pipi {#Prev}ini... apa kau pernah melihat mahakarya seperti ini? Sampaikan salamku ke Echo ya. Tapi cuma sebatas {#Emph}teman."
      Speaker = "Narcissus"
      Event = "NarcissusAboutWaters05"
    }
    {
      Id = "Narcissus_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bingung harus berterima kasih bagaimana soal penjernihan air ini. Sangat jernih dan {#Emph}bening! {#Prev}Aku bisa melihat setiap lekuk sempurna di wajah tampan ini. Kau punya masa depan cerah di bidang sanitasi air!"
      Speaker = "Narcissus"
      Event = "NarcissusGrantsReward01"
    }
    {
      Id = "MelinoeField_1986"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kejernihan pantulan itu bisa membantumu mulai memperhatikan hal lain selain dirimu sendiri. Efek pemurniannya akan bertahan lebih lama jika kau melakukannya."
      Speaker = "Melinoe"
      Event = "NarcissusGrantsReward01"
    }
    {
      Id = "Narcissus_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Intinya begini, aku sudah memutuskan untuk memberimu hadiah terhebat dari semua hadiah yang pernah kuterima. Nih, terimalah sesuatu dari {#Emph}koleksi pribadiku!!"
      Speaker = "Narcissus"
      Event = "NarcissusGrantsReward01"
    }
    {
      Id = "Narcissus_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang aku terkesima sendiri melihat betapa tampannya diriku, lalu terhanyut dalam pesona yang tak mudah dipatahkan. Jangankan olehmu, oleh {#Emph}diriku sendiri {#Prev}pun tidak bisa."
      Speaker = "Narcissus"
      Event = "NarcissusAboutLittleToSay01"
    }
    {
      Id = "MelinoeField_4472"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terdengar sangat familier. Memangnya apa bedanya hal itu dengan apa yang biasa kulihat setiap kali menemuimu, Narcissus?"
      Speaker = "Melinoe"
      Event = "NarcissusAboutLittleToSay01"
    }
    {
      Id = "Narcissus_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tenang saja, Kawan, kita abaikan saja semuanya. Seolah-olah hal yang ada di dunia ini cuma kau dan aku. Cuma {#Emph}kita berdua."
      Speaker = "Narcissus"
      Event = "NarcissusAboutLittleToSay01"
    }
    {
      Id = "Narcissus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak bisa memiliki ketampananku, tapi kau boleh memiliki {#Emph}ini."
      Speaker = "Narcissus"
      Event = "NarcissusChat01"
    }
    {
      Id = "Narcissus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukannya mau tidak sopan, tapi aku sedang sibuk mengagumi sesuatu di sini, tahu?"
      Speaker = "Narcissus"
      Event = "NarcissusChat02"
    }
    {
      Id = "Narcissus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Langkahnya pelan-pelan, ya? Aku suka kalau air di sini tenang tanpa riak."
      Speaker = "Narcissus"
      Event = "NarcissusChat03"
    }
    {
      Id = "Narcissus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang aku bertanya-tanya... mungkinkah ada wajah yang bisa lebih rupawan dari {#Emph}ini?"
      Speaker = "Narcissus"
      Event = "NarcissusChat04"
    }
    {
      Id = "Narcissus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa orang ke sini untuk berkaca merenung... tapi tak ada yang bisa berkaca lebih memesona daripada {#Emph}aku."
      Speaker = "Narcissus"
      Event = "NarcissusChat05"
    }
    {
      Id = "Narcissus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk ukuran orang yang bukan pengagum rahasia, kau lumayan sering mampir ke sini."
      Speaker = "Narcissus"
      Event = "NarcissusChat06"
    }
    {
      Id = "Narcissus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Mata itu... rahang tegas itu... rambutnya... ya ampun, rambutnya..."
      Speaker = "Narcissus"
      Event = "NarcissusChat07"
    }
    {
      Id = "Narcissus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Wah, kau benar-benar kelihatan luar biasa malam ini, Kawan..."
      Speaker = "Narcissus"
      Event = "NarcissusChat08"
    }
    {
      Id = "Narcissus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan khawatir, aku yakin suatu saat nanti kau bakal menemukan seseorang yang mencintaimu."
      Speaker = "Narcissus"
      Event = "NarcissusChat09"
    }
    {
      Id = "Narcissus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau lagi. Ambil saja sesukamu, dan serahkan sisanya pada{#Emph}ku."
      Speaker = "Narcissus"
      Event = "NarcissusChat10"
    }
    {
      Id = "Narcissus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang mau menolongmu kalau kau tak menolong {#Emph}dirimu sendiri."
      Speaker = "Narcissus"
      Event = "NarcissusChat11"
    }
    {
      Id = "Narcissus_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua yang kubutuhkan sudah ada di sini. Ditambah setumpuk barang ini yang silakan kau bawa pergi!"
      Speaker = "Narcissus"
      Event = "NarcissusChat12"
    }
    {
      Id = "Narcissus_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hatiku sudah ada yang punya, tapi barang-barang ini bebas diperebutkan {#Emph}siapa saja."
      Speaker = "Narcissus"
      Event = "NarcissusChat13"
    }
    {
      Id = "Narcissus_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Senang melihat wajahmu lagi, Kawan! Abaikan saja dia."
      Speaker = "Narcissus"
      Event = "NarcissusChat14"
    }
    {
      Id = "Narcissus_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Lihatlah dirimu, Kawan! Kau terlalu sempurna untuk orang-orang dungu ini."
      Speaker = "Narcissus"
      Event = "NarcissusChat15"
    }
    {
      Id = "Narcissus_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ambil salah satu dari ini, siapa tahu bisa membantumu memikat penggemarmu {#Emph}sendiri."
      Speaker = "Narcissus"
      Event = "NarcissusChat16"
    }
    {
      Id = "Narcissus_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasakan tatapan tajam tertuju padaku lagi, dan sudah kuduga itu {#Emph}kau."
      Speaker = "Narcissus"
      Event = "NarcissusChat17"
    }
    {
      Id = "Narcissus_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Air ini jernih sekali, benar-benar memancarkan pesona terbaikku."
      Speaker = "Narcissus"
      Event = "NarcissusChat18"
    }
    {
      Id = "Narcissus_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu mencariku! Dan kau berhasil menemukanku. Jadi, {#Emph}kerja bagus."
      Speaker = "Narcissus"
      Event = "NarcissusChat19"
    }
    {
      Id = "Narcissus_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat karena berhasil menemukanku lagi! Sekarang ambil hadiahmu, dan {#Emph}pergilah."
      Speaker = "Narcissus"
      Event = "NarcissusChat20"
    }
    {
      Id = "Narcissus_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tinggallah selama yang kaukaukan! Atau lebih baik lagi, pilih salah satu dari ini lalu {#Emph}pergilah."
      Speaker = "Narcissus"
      Event = "NarcissusChat21"
    }
    {
      Id = "Narcissus_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ambil yang kaumau, tapi satu saja. Aku tidak pilih kasih di sini."
      Speaker = "Narcissus"
      Event = "NarcissusChat22"
    }
    {
      Id = "Narcissus_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa tidak kauambil saja salah satu barang ini dariku, lalu {#Emph}pergilah menjauh."
      Speaker = "Narcissus"
      Event = "NarcissusChat23"
    }
    {
      Id = "Narcissus_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cari kolam cerminmu {#Emph}sendiri dan dapatkan pilihan hadiah gratis!"
      Speaker = "Narcissus"
      Event = "NarcissusChat24"
    }
    {
      Id = "Narcissus_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, tumpukan barang yang harus kubagikan ini masih belum berkurang sama sekali..."
      Speaker = "Narcissus"
      Event = "NarcissusChat25"
    }
    {
      Id = "Narcissus_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}hei! Uh, {#Prev}berhubung kau bukan calon pelamar, silakan saja {#Emph}menyerobot antrean."
      Speaker = "Narcissus"
      Event = "NarcissusChat26"
    }
    {
      Id = "Narcissus_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada kabar apa, Daun Salam, masih seperti biasa? Oke, senang melihatmu, dadah!"
      Speaker = "Narcissus"
      Event = "NarcissusChat27"
    }
    {
      Id = "Narcissus_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau masih agak terobsesi denganku, tapi ya aku paham kok, percayalah, aku {#Emph}sangat {#Prev}paham."
      Speaker = "Narcissus"
      Event = "NarcissusChat28"
    }
    {
      Id = "Narcissus_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Lihatlah lekukan dagu itu... rona matanya... lengkungan bibirnya..."
      Speaker = "Narcissus"
      Event = "NarcissusChat29"
    }
    {
      Id = "Narcissus_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Saat mata kita bertatapan seperti ini, hal lain tak lagi penting... dan kita {#Emph}sering sekali {#Prev}bertatapan seperti ini."
      Speaker = "Narcissus"
      Event = "NarcissusChat30"
    }
    {
      Id = "Narcissus_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tataplah selama yang kau mau, lalu ambil salah satu dari {#Emph}ini."
      Speaker = "Narcissus"
      Event = "NarcissusChat31"
    }
    {
      Id = "Narcissus_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cintaku tak bisa kau miliki, tapi aku punya banyak hadiah lain yang bisa kubagikan."
      Speaker = "Narcissus"
      Event = "NarcissusChat32"
    }
    {
      Id = "Narcissus_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma lagi mikirin betapa hebatnya diriku, tahu kan? Hal itu terlintas terus sepanjang waktu."
      Speaker = "Narcissus"
      Event = "NarcissusChat33"
    }
    {
      Id = "Narcissus_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sedang memandangi sosok tiada duanya... dan kurasa sekarang aku juga harus memandangi diriku sendiri."
      Speaker = "Narcissus"
      Event = "NarcissusChat34"
    }
    {
      Id = "Narcissus_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku terlahir tidak semenarik ini... ah, bercanda deh, aku memang semenarik ini sejak lahir."
      Speaker = "Narcissus"
      Event = "NarcissusChat35"
    }
    {
      Id = "Narcissus_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lama tak melihatmu di sini... bukan berarti aku bakal peduli juga sih."
      Speaker = "Narcissus"
      Event = "NarcissusChat36"
    }
    {
      Id = "Narcissus_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau muncul terus, ya... yah, kalau aku jadi dirimu, aku juga pasti bakal begitu."
      Speaker = "Narcissus"
      Event = "NarcissusChat37"
    }
    {
      Id = "Narcissus_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak hal yang patut disukai dari tempat ini... dan kau sedang memandanginya sekarang juga."
      Speaker = "Narcissus"
      Event = "NarcissusChat38"
    }
    {
      Id = "Narcissus_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berusaha berkedip sesedikit mungkin, agar tak kehilangan pandangan dari hal yang paling berharga..."
      Speaker = "Narcissus"
      Event = "NarcissusChat39"
    }
    {
      Id = "Narcissus_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Hei tampan... sepertinya kau kedatangan tamu... beri dia hadiah sana, ya?"
      Speaker = "Narcissus"
      Event = "NarcissusChat40"
    }
    {
      Id = "Narcissus_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih belum bisa melihat diriku. Apa aku masih di sini? Apa ada dari {#Emph}kita {#Prev}yang benar-benar ada di sini? Ya ampun..."
      Speaker = "Narcissus"
      Event = "NarcissusSadChat01"
    }
    {
      Id = "Narcissus_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ugh{#Prev}, kenapa hal ini harus menimpaku? Menimpa {#Emph}kita? {#Prev}Ini sungguh {#Emph}tidak adil!"
      Speaker = "Narcissus"
      Event = "NarcissusSadChat02"
    }
    {
      Id = "Narcissus_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong biarkan aku larut dalam duka. Tapi ambillah hadiah cuma-cuma ini sebelum kau pergi!"
      Speaker = "Narcissus"
      Event = "NarcissusSadChat03"
    }
    {
      Id = "Narcissus_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya ampun... ini adalah hal terburuk yang pernah menimpa {#Emph}siapa pun..."
      Speaker = "Narcissus"
      Event = "NarcissusSadChat04"
    }
    {
      Id = "Narcissus_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih tak bisa melihat apa-apa di sini... tapi kalau aku {#Emph}menyipitkan mata, atau memiringkan kepalaku begini..."
      Speaker = "Narcissus"
      Event = "NarcissusSadChat05"
    }
    {
      Id = "Narcissus_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sedang menghadapi krisis besar di sini, jadi ambil saja apa yang kau mau, lalu {#Emph}pergilah."
      Speaker = "Narcissus"
      Event = "NarcissusSadChat06"
    }
    {
      Id = "Melinoe_2053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena kau tak berusaha memenggal kepalaku dari pundak tak seperti makhluk lain yang berkeliaran di sini, aku terdorong untuk memberikan ini. Sekadar sebagai kenalan biasa, biar jelas saja."
      Speaker = "Melinoe"
      Event = "NarcissusGift01"
    }
    {
      Id = "Narcissus_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mau memberiku tanda kasih seperti ini, padahal tahu betul aku sudah punya banyak dan, yang lebih penting, hatiku sudah ada yang punya? Baiklah! Ini sesuatu agar kau bisa mengingatku."
      Speaker = "Narcissus"
      Event = "NarcissusGift01"
    }
    {
      Id = "Narcissus_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah{#Prev}, sebuah {#Emph}kado{#Prev}, kau perhatian sekali dan seterusnya. Aku bukannya bermaksud kasar... hanya saja jangan salah paham, ya?"
      Speaker = "Narcissus"
      Event = "NarcissusGift02"
    }
    {
      Id = "Melinoe_2054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika aku terus mengambil dari timbunan hadiahmu yang melimpah itu, rasanya adil jika sesekali aku memberikan sesuatu sebagai balasannya."
      Speaker = "Melinoe"
      Event = "NarcissusGift02"
    }
    {
      Id = "Narcissus_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! Perhatian sekali{#Prev}, dan seterusnya. Tapi kau bodoh juga, ya! Apa kau tak sadar kalau ini cuma bakal kutumpuk bersama barang-barang lainnya, lalu akhirnya diambil oleh pemujaku yang lain?"
      Speaker = "Narcissus"
      Event = "NarcissusGift03"
    }
    {
      Id = "MelinoeField_0735"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, ini hadiah! Kau bebas memutuskan mau diapakan. Mungkin salah satu pemuja lain itu akan menyukainya, jika memang itu maumu."
      Speaker = "Melinoe"
      Event = "NarcissusGift03"
    }
    {
      Id = "Narcissus_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh wah, untuk{#Emph}ku{#Prev}, perhatian sekali. Dengar: Usahakan semaumu, aku tak bisa membalas {#Emph}cintamu. {#Prev}Kupikir aku sudah bicara sejernih air ini, untuk berjaga-jaga kalau kau salah paham {#Emph}lagi."
      Speaker = "Narcissus"
      Event = "NarcissusGift04"
    }
    {
      Id = "MelinoeField_0736"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak semua gestur harus diartikan memiliki nada-nada romantis, kan? Kau sudah memperjelas perasaanmu tanpa keraguan, dan aku menghargai itu. {#Emph}Sebagai teman."
      Speaker = "Melinoe"
      Event = "NarcissusGift04"
    }
    {
      Id = "Narcissus_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, ada Nektar, perhatian sekali! Dulu aku bersungguh-sungguh saat mengatakannya, tapi... ada saatnya ketika kau menerima begitu banyak hadiah sampai kau bingung harus bilang apa lagi. Tapi ya tetap saja berucap {#Emph}perhatian sekali{#Prev}..."
      Speaker = "Narcissus"
      Event = "NarcissusGift05"
    }
    {
      Id = "MelinoeField_2247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam keluargaku, memberi adalah adat sosial, dan sekadar menunjukkan kesopanan jika bukan hal lainnya. Hadiah itu memang {#Emph}sepatutnya {#Prev}penuh perhatian, seperti katamu. Tapi kurasa bisa juga menjadi sekadar refleks."
      Speaker = "Melinoe"
      Event = "NarcissusGift05"
    }
    {
      Id = "Narcissus_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah?"
      Speaker = "Narcissus"
      Event = "NarcissusGift05"
    }
    {
      Id = "Narcissus_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar ingin mendengarku mengatakannya lagi, ya? Baiklah, {#Emph}ya sudah! {#Prev}Perhatian sekali! {#Emph}Perhatian. Sekali!! {#Prev}Itu kan {#Emph}kata-kataku! {#Prev}Tapi tahu tidak? Aku mulai berpikir kalau {#Emph}dirimu {#Prev}sebenarnya sama sekali tidak perhatian!"
      Speaker = "Narcissus"
      Event = "NarcissusGift06"
    }
    {
      Id = "MelinoeField_2248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Narcissus, tolonglah, aku tak bermaksud menyinggungmu. Kau tak perlu mengambil Nektar itu kalau memang tak mau. Aku hanya memperhatikan sepertinya kau tak punya banyak barang itu di sini! Apa kau bahkan pernah mencobanya?"
      Speaker = "Melinoe"
      Event = "NarcissusGift06"
    }
    {
      Id = "Narcissus_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maksudmu mencobanya? Mencoba {#Emph}bagaimana? {#Prev}Satu-satunya hal yang kucoba lakukan, Laurel, hanyalah memandangi sepasang mata penuh kerinduan ini dengan {#Emph}tenang. {#Prev}Meskipun begitu, kuambil Nektarmu ini, kali ini saja, untuk yang terakhir kali, paham?"
      Speaker = "Narcissus"
      Event = "NarcissusGift06"
    }
    {
      Id = "MelinoeField_3519"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau bilang tak tertarik lagi dengan Nektar, tapi aku ingin memberikan {#Emph}ini {#Prev}untukmu. Demi persahabatan kita yang terus berlanjut, dan atas semua bantuanmu untukku selama bermalam-malam ini!"
      Speaker = "Melinoe"
      Event = "NarcissusGift07"
    }
    {
      Id = "Narcissus_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini Ambrosia, {#Emph}wah... {#Prev}benda ini kan untuk para dewa, bukan untuk roh sungai, tak peduli betapa luar biasa tampannya mereka! Apa {#Emph}pamrihnya?"
      Speaker = "Narcissus"
      Event = "NarcissusGift07"
    }
    {
      Id = "MelinoeField_3520"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu-satunya {#Emph}syaratnya {#Prev}adalah kau harus berhenti salah mengartikan niatku setiap kali aku sesekali memberimu sesuatu. Jauh lebih jarang daripada kau memberiku barang, perlu kutambahkan!"
      Speaker = "Melinoe"
      Event = "NarcissusGift07"
    }
    {
      Id = "Narcissus_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, entahlah... tapi setelah kupikir-pikir lagi, akan kuterima. Tapi kali ini saja, oke? Mungkin ini akan kubagi... dengan {#Emph}diriku sendiri."
      Speaker = "Narcissus"
      Event = "NarcissusGift07"
    }
    {
