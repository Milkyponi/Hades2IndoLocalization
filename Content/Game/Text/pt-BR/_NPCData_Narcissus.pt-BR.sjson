    {
      Id = "Narcissus_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Srat> {#Prev}Aduh, Sob... kayak... sialan... maksudku... aku kudu gimana coba? Rasanya tuh, kayak..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh... {#Prev}Aku bener-bener gak bisa... kayak... maksudku, gak sanggup lagi... {#Emph}<Srat> {#Prev}Apa yang terjadi sama kita, Sob? Aku..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Becek banget... {#Emph}akh{#Prev}, gak begitu kelihatan... mata bukan sih? Atau hidung? {#Emph}Ugh..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi, {#Emph}ng... {#Prev}ya, kurasa... kayak... udahlah ya... coba kulihat dulu..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Hela napas> {#Prev}Rasanya tuh... aku masih ingat paras elokmu dulu, cuma... aku {#Emph}kangen {#Prev}kamu, Sob..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin mending aku... cabut, ya? {#Emph}Ke tempat {#Prev}lain gitu? Tapi aku gak tega {#Emph}ninggalin {#Prev}kamu, Sob...!"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0019"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah... {#Emph}ck... {#Prev}Maksudku, ayolah, kayak... {#Emph}akh...!"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0020"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kayak... {#Emph}gitu banget! {#Prev}Aku tuh... {#Emph}ugh{#Prev}, maksudku... {#Emph}ya kan{#Prev}, bener gak...?"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0021"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sob... kamu tuh bener-bener... {#Emph}ugh! {#Prev}Paham kan maksudku...?"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0022"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}Fufh{#Prev}, kayak... {#Emph}ya ampun...! {#Prev}Bener-bener, {#Emph}parah banget cantiknya{#Prev}, maksudku... ya kan?"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi tuh... maksudku... {#Emph}iya{#Prev}, beneran... {#Emph}ugh! {#Prev}Paham kan? {#Emph}Kamu {#Prev}pasti paham, {#Emph}kan! {#Prev}Pasti {#Emph}pahamlah..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mm, {#Prev}iya, cakep banget... iya, jelas, {#Emph}jadi, {#Prev}kayak... {#Emph}ugh...! {#Prev}Maksudku, sumpah demi apa pun..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yap, makin ganteng aja, Sob. Kamu... bener-bener {#Emph}kece badai. {#Prev}Kayak kamu gak sadar aja! Pura-pura gak tahu kan, hayo?"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa-bisanya kamu se-... {#Emph}ugh{#Prev}, rambutnya, bibirnya, matanya. Sorot {#Emph}mata {#Prev}itu lho, Sob! Paham kan maksudku?"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayang banget sama kamu, Sob. Udah pernah kubilang belum? {#Emph}Haha{#Prev}, oh iya, pernah kok. Kamu {#Emph}tahu {#Prev}pasti. Kamu tahu aku cinta mati."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi, kayak, ya ampun... semuanya tuh, {#Emph}ugh. {#Prev}Udah kelewat {#Emph}sempurna! {#Prev}Gak bakal pernah bikin puas. {#Emph}Haha{#Prev}, paham kan?"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, kamu kelihatan... kelihatan {#Emph}luar biasa{#Prev}, Sob. Cuma mau ngingetin aja. Soalnya itu yang lagi {#Emph}kupikirkan{#Prev}, paham kan?"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi lagi ada apa lagi nih, Sob? Pasti ada sesuatu yang lagi kamu pikirkan, kan? Nggak ada ya...?"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terus aku mikir, {#Emph}mustahil banget. {#Prev}Tapi habis itu, bentar... {#Emph}gimana kalau...? {#Prev}Inget yang itu gak, Sob? Tahu lah ya pastinya!"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei Sob, coba jujur, bisa jaga rahasia gak? Soalnya aku gak tahan: {#Emph}Aku cinta kamu. {#Prev}Iya, beneran. Kamu denger sendiri kan..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maksudku, lihat dirimu deh, rasanya tuh, {#Emph}bener-bener... wah. {#Prev}Tahu kan? Gak sanggup berkata-kata lagi..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia lagi? Beneran dia. Tenang aja, Sob, ini gak bakal lama kok. Bener-bener sebentar aja."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Yah{#Prev}, palingan cuma Laurel yang balik lagi buat terpesona sama ketampananmu, ya kan Sob...?"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gimana kabarnya Echo ya, Sob? Di Padang sana! Di sana tempatnya lapang dan sejuk. Ya..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusMutteringLines"
    }
    {
      Id = "Narcissus_0179"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kelihatannya kamu udah nemu tandinganmu."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusExorcismReactionVoiceLines"
    }
    {
      Id = "Narcissus_0180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fufh{#Prev}, aku berutang budi padamu kali ini."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusExorcismReactionVoiceLines"
    }
    {
      Id = "Narcissus_0181"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Singkirkan mereka dari sini."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusExorcismReactionVoiceLines"
    }
    {
      Id = "Narcissus_0182"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak suka yang tadi itu."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusExorcismReactionVoiceLines"
    }
    {
      Id = "Narcissus_0183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Da-{#Emph}dah!"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusExorcismReactionVoiceLines"
    }
    {
      Id = "Narcissus_0184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukira mereka nggak bakal pergi-pergi."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusExorcismReactionVoiceLines"
    }
    {
      Id = "Narcissus_0185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Akhirnya!"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.NarcissusExorcismReactionVoiceLines"
    }
    {
      Id = "Narcissus_0027"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Puas-puasin deh."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0028"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang kalau kau tak keberatan."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0029"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang kau boleh pergi."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0030"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semuanya buatmu."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang pergilah, ya?"
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ambil aja sesukamu."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam hangat."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0126"
