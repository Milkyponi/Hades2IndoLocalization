    }
    {
      Id = "Narcissus_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buatmu."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0129"
