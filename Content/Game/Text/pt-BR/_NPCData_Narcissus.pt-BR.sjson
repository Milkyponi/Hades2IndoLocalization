      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuh."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ambillah..."
      Speaker = "Narcissus"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Narcissus"
    }
    {
      Id = "Narcissus_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga yang terbaik untukmu."
      Speaker = "Narcissus"
