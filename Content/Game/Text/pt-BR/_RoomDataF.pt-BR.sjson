  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Storyteller_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di balik Erebus yang bagaikan labirin berselimut kabut, bersemayam jiwa-jiwa tak terhitung banyaknya, menanti penghakiman yang takkan pernah tiba."
      Speaker = "Storyteller"
      Event = "F_OpeningInspect01"
    }
    {
      Id = "Melinoe_0034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebentar lagi mereka akan diadili."
      Speaker = "Melinoe"
      Event = "F_OpeningInspect01"
    }
    {
      Id = "Storyteller_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hampir seluruh jalur tak berujung di Erebus yang mencekik berujung pada jalan buntu, dan amat langka mereka yang mampu menavigasinya."
      Speaker = "Storyteller"
      Event = "F_Opening02_Inspect01"
    }
    {
      Id = "Melinoe_1433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cuma butuh seumur hidupku untuk memahaminya."
      Speaker = "Melinoe"
      Event = "F_Opening02_Inspect01"
    }
    {
      Id = "Storyteller_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bahkan mereka yang mampu memasuki Crossroads sesuka hati pun takkan bisa sepenuhnya menebak jalur mana dari tiga jalan tersembunyi yang akan menjadi pintu keluar mereka."
      Speaker = "Storyteller"
      Event = "F_Opening03_Inspect01"
    }
    {
      Id = "MelinoeField_4599"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku masih tahu jalannya..."
      Speaker = "Melinoe"
      Event = "F_Opening03_Inspect01"
    }
    {
      Id = "Storyteller_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Para Arwah Erebus yang tak pernah tenang hampir tak menemukan kedamaian di sana, selain dekapan berduri dari dahan-dahan bengkok di hutan yang menggeliat itu."
      Speaker = "Storyteller"
      Event = "Inspect_F_MiniBoss01_01"
    }
    {
      Id = "Melinoe_1690"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebenarnya aku sedang melawan para Arwah, atau hutan ini?"
      Speaker = "Melinoe"
      Event = "Inspect_F_MiniBoss01_01"
    }
    {
      Id = "Storyteller_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kegelapan yang begitu pekat dan tak tertembus mengepung sang Putri Dunia Bawah, hingga mata nerakanya pun tak sanggup mengenali kengerian apa yang mengintai di sana."
      Speaker = "Storyteller"
      Event = "Inspect_F_MiniBoss02_01"
    }
    {
      Id = "Melinoe_1691"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau tak bisa melihat menembus bayang-bayang, akan kutebas saja."
      Speaker = "Melinoe"
      Event = "Inspect_F_MiniBoss02_01"
    }
    {
      Id = "Storyteller_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bayangan pembunuh yang mengendap-endap itu kini telah sirna, agaknya setelah hanyut dari jalanan Ephyra yang runtuh demi mencari mangsa yang teramat penting untuk dilewatkan di sini."
      Speaker = "Storyteller"
      Event = "Inspect_F_MiniBoss03_01"
    }
    {
      Id = "MelinoeField_3661"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Si Pembunuh itu memang mengincarku."
      Speaker = "Melinoe"
      Event = "Inspect_F_MiniBoss03_01"
    }
    {
      Id = "Melinoe_1612"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jiwa-jiwa yang tersesat. Sang Titan harus membayarnya."
      Speaker = "Melinoe"
      Event = "F_Combat01.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sungai Cocytus meliuk-liuk menembus lorong berkabut tanpa akhir, ratapan jiwa-jiwa di airnya yang tenang merana karena direnggut peristirahatan abadi mereka."
      Speaker = "Storyteller"
      Event = "Inspect_Cocytus_01"
    }
    {
      Id = "Melinoe_0856"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mengingatkanku pada rumah!"
      Speaker = "Melinoe"
      Event = "Inspect_Cocytus_01"
    }
    {
      Id = "Storyteller_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Dunia Bawah milik Hades menyimpan lebih dari sekadar jiwa-jiwa orang mati: kekayaan di luar nalar; bahkan sisa-sisa para Titan yang abadi."
      Speaker = "Storyteller"
      Event = "Inspect_VastRiches_01"
    }
    {
      Id = "Melinoe_1681"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka semua akan kembali ke tempat asal mereka."
      Speaker = "Melinoe"
      Event = "Inspect_VastRiches_01"
    }
    {
      Id = "Storyteller_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kendati jemari lentur sang Rembulan pucat nyaris tak sanggup menyentuh Erebus yang berduka, sang dewi perburuan dapat melintasi hutan itu tanpa susah payah."
      Speaker = "Storyteller"
      Event = "InspectArtemis01"
    }
    {
      Id = "Melinoe_1429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia memang hebat, kuakui itu."
      Speaker = "Melinoe"
      Event = "InspectArtemis01"
    }
    {
      Id = "Storyteller_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di depan sana, sang Putri Dunia Bawah akan kembali berhadapan dengan sosok yang membesarkannya, dan yang telah mengajarinya cara untuk meraih kemenangan..."
      Speaker = "Storyteller"
      Event = "Inspect_F_PreBoss01_01"
    }
    {
      Id = "Melinoe_1431"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selalu ada hal baru untuk dipelajari."
      Speaker = "Melinoe"
      Event = "Inspect_F_PreBoss01_01"
    }
    {
      Id = "Storyteller_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di bawah tepi luar Erebus, terbentang wilayah tersembunyi Dunia Bawah, yang hanya diketahui segelintir orang, dan bahkan lebih sedikit lagi yang mampu menjelajahinya."
      Speaker = "Storyteller"
      Event = "Inspect_F_Boss01_01"
    }
    {
      Id = "Melinoe_0859"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga saja begitu."
      Speaker = "Melinoe"
      Event = "Inspect_F_Boss01_01"
    }
    {
      Id = "Storyteller_0419"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Setelah membagikan lebih banyak pengalaman luasnya, sang Penyihir Crossroads meninggalkan sang Putri Orang Mati untuk merenungkan batas-batas pengetahuan yang telah ia peroleh."
      Speaker = "Storyteller"
      Event = "Inspect_F_Boss02_01"
    }
    {
      Id = "MelinoeField_3612"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pengetahuannya pasti luas sekali..."
      Speaker = "Melinoe"
      Event = "Inspect_F_Boss02_01"
    }
    {
      Id = "Storyteller_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mungkin hanya sang Rembulan sendiri yang sanggup melihat hutan kecil tersembunyi di perbatasan Erebus ini, tempat para praktisi sihir kuno dapat mengasah kemampuan mereka hingga paripurna."
      Speaker = "Storyteller"
      Event = "Inspect_F_Boss02_02"
    }
    {
      Id = "MelinoeField_3652"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bisa melihatnya dengan jelas, kok."
      Speaker = "Melinoe"
      Event = "Inspect_F_Boss02_02"
    }
    {
      Id = "MelinoeField_4269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggulah, Kepala Sekolah..."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4584"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menapaki kembali langkah masa laluku..."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jalan menuju ke bawah..."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akhirnya..."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluar dari Erebus..."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada siapa-siapa di sini..."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semuanya sunyi..."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fiuh."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "Chronos_0940"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurang ajar..."
      Speaker = "Chronos"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "Chronos_0941"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Baiklah."
      Speaker = "Chronos"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "Chronos_0942"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan berani-berani mengabaikanku!"
      Speaker = "Chronos"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "Chronos_0943"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Abaikan saja sesukamu."
      Speaker = "Chronos"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "Chronos_0944"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali ke sini...!"
      Speaker = "Chronos"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "Chronos_0945"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pergilah sana, gadis tengik!"
      Speaker = "Chronos"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat tinggal, Erebus."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktunya turun ke bawah."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Turun ke bawah."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0122"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mulai masuk."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memulai penurunan."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menuju kedalaman."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maju terus."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semakin dekat ke Tartarus..."
      Speaker = "Melinoe"
      Event = "F_PostBoss01.ExitVoiceLines"
    }
    {
      Id = "Storyteller_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jauh di bawah sana, di sudut terdalam Dunia Bawah, musuh kuno sang dewi bercadar jingga, Melinoë, telah menanti."
      Speaker = "Storyteller"
      Event = "Inspect_F_PostBoss01_01"
    }
    {
      Id = "Melinoe_0405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau akan membantuku menemukannya."
      Speaker = "Melinoe"
      Event = "Inspect_F_PostBoss01_01"
    }
    {
      Id = "Storyteller_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Pendayung Charon, yang dulunya mengurus arwah orang mati, kini mengayuh sampan menyusuri sungai-sungai Dunia Bawah demi membantu mereka yang masih menentang sang Raja Titan."
      Speaker = "Storyteller"
      Event = "Inspect_F_Shop01_01"
    }
    {
      Id = "Melinoe_1430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa jadinya kita tanpa dirinya?"
      Speaker = "Melinoe"
      Event = "Inspect_F_Shop01_01"
    }
    {
      Id = "Storyteller_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jauh di dalam lebatnya belantara Erebus yang tak berujung, tersembunyi tanah lapang rahasia yang mustahil ditemukan kecuali melalui cara-cara gaib."
      Speaker = "Storyteller"
      Event = "Inspect_F_Reprieve01_01"
    }
    {
      Id = "Melinoe_0860"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu kita pasti menemukan tempat ini."
      Speaker = "Melinoe"
      Event = "Inspect_F_Reprieve01_01"
    }
    {
      Id = "Storyteller_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebagian besar bangunan megah kuno yang dulunya menampung arwah-arwah penanti penghakiman di Erebus, kini telah ditelan oleh hutan rimba, atau runtuh termakan zaman."
      Speaker = "Storyteller"
      Event = "Inspect_F_Reprieve01_02"
    }
    {
      Id = "Melinoe_1686"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dulu pasti sangat megah..."
      Speaker = "Melinoe"
      Event = "Inspect_F_Reprieve01_02"
    }
    {
      Id = "Storyteller_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Pintalan sutra laba-laba yang begitu rumit dan menyelimuti pelosok sudut remang di Erebus ini, memiliki mutu yang bahkan mampu menyaingi tenunan para dewa itu sendiri."
      Speaker = "Storyteller"
      Event = "Inspect_F_Story01_01"
    }
    {
      Id = "Melinoe_0857"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Arachne memang sangat ahli di bidangnya."
      Speaker = "Melinoe"
      Event = "Inspect_F_Story01_01"
    }
    {
      Id = "Arachne_0336"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mm!"
      Speaker = "Arachne"
      Event = "Inspect_F_Story01_01"
    }
  ]
}
