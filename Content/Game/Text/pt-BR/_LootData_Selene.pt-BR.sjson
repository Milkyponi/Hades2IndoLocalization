    }
    {
      Id = "MelinoeField_1935"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kupanggil sang Rembulan, dan kutarik engkau turun!"
      Speaker = "Melinoe"
      Event = "SpellDrop.PickupVoiceLines"
    }
    {
      Id = "MelinoeField_1937"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mari kita bersinar bersama malam ini, wahai Rembulan!"
      Speaker = "Melinoe"
      Event = "SpellDrop.PickupVoiceLines"
    }
    {
      Id = "MelinoeField_1938"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kuharapkan engkau bersinar untukku lagi malam ini!"
      Speaker = "Melinoe"
      Event = "SpellDrop.PickupVoiceLines"
    }
    {
      Id = "MelinoeField_5664"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisakah cahaya rembulan menuntunku bahkan di dalam mimpiku?"
      Speaker = "Melinoe"
      Event = "SpellDrop.PickupVoiceLines"
    }
    {
      Id = "MelinoeField_5665"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Selene, biarkan aku memanifestasikan cahayamu!"
      Speaker = "Melinoe"
      Event = "SpellDrop.PickupVoiceLines"
    }
    {
      Id = "MelinoeField_5666"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ini semua cuma mimpi, Selene, jadi kuserahkan padamu!"
      Speaker = "Melinoe"
      Event = "SpellDrop.PickupVoiceLines"
    }
    {
      Id = "Melinoe_0026"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cahaya rembulan..."
      Speaker = "Melinoe"
      Event = "SpellDrop.FirstSpawnVoiceLines"
    }
    {
      Id = "Melinoe_0027"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saudari Selene..."
      Speaker = "Melinoe"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_0189"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tetes Rembulan..."
      Speaker = "Melinoe"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "Selene_0116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam."
      Speaker = "Selene"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "Selene_0117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kusambut kehadiranmu."
      Speaker = "Selene"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "Selene_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku telah kembali."
      Speaker = "Selene"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "Selene_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita berjumpa lagi."
      Speaker = "Selene"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "Selene_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada sesuatu untukmu."
      Speaker = "Selene"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "Selene_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini untukmu."
      Speaker = "Selene"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "Selene_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini untukmu."
      Speaker = "Selene"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "Selene_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bangkitkan kekuatan sejatimu."
      Speaker = "Selene"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "Selene_0399"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu kamu rupanya."
      Speaker = "Selene"
      Event = "SpellDrop.OnSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_3529"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kulihat engkau membawa kebahagiaan dan kehancuran dalam rengkuhan tanganmu..."
      Speaker = "Melinoe"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0438"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seorang dewa mungkin akan melintasi Jalurmu..."
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seorang dewi mungkin akan melintasi Jalurmu..."
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saksikanlah."
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentukan pilihanmu."
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0178"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pandanglah ke depan."
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0179"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pilihan ada di tanganmu."
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mana yang cocok untukmu?"
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0181"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang..."
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0182"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pilihanmu?"
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saksikanlah cahayaku."
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Selene_0480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi kejayaan para Saudari Perak, bintang kecilku."
      Speaker = "Selene"
      Event = "SpellDrop.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_1934"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia menyimpang dari jalurnya... \n\n {#Emph}Wahai Titaness Agung, sang Mata Malam, \n {#Emph}Kutarik engkau turun; pinjamkanlah kekuatanmu padaku!"
      Speaker = "Melinoe"
      Event = "SeleneFirstPickUp"
    }
    {
      Id = "Selene_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat malam untukmu, bintang kecilku. Siklus kita kini saling bertaut, karena aku tak bisa lagi tinggal diam hanya untuk menonton. Ancaman apa pun yang kita hadapi, aku bersumpah akan bersinar untukmu."
      Speaker = "Selene"
      Event = "SeleneFirstPickUp"
    }
    {
      Id = "Selene_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menyesal pertemuan kita selalu tergesa-gesa, dan kita tak bisa berbincang saat bersua seperti ini. Aku dinantikan tinggi di angkasa agar disaksikan semua orang. Hubungan kita harus tetap tersembunyi layaknya Persimpangan Jalan. Kita harus bergerak di balik bayang-bayang."
      Speaker = "Selene"
      Event = "SeleneAboutTask01"
    }
    {
      Id = "Selene_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolahmu dan aku telah bekerja sama semenjak Ibu Nyx meminta kami menjaga ranah kami masing-masing, sementara beliau mengawasi Dunia Bawah. Dua Titaness, dipersatukan oleh Malam."
      Speaker = "Selene"
      Event = "SeleneAboutHecate01"
    }
    {
      Id = "Selene_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bintang kecil, kekuatan dan pengetahuanmu bertumbuh begitu pesat. Betapa bangganya Kepala Sekolahmu melihatmu akhirnya mampu melampauinya. Namun, kami tahu betapa berat beban yang kau pikul."
      Speaker = "Selene"
      Event = "SeleneAboutHecate02"
    }
    {
      Id = "Selene_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baru-baru ini, Kepala Sekolahmu bertanya kepadaku, apakah perjalanan melintasi langit malam tidak terasa menjemukan? Aku tersenyum mendengar kelakarnya. Setiap malam selalu berbeda dari malam-malam yang pernah kukenal."
      Speaker = "Selene"
      Event = "SeleneAboutHecate03"
    }
    {
      Id = "Selene_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah sekian lama aku menjadi Mata Malam, menyaksikanmu tumbuh dan berlatih dalam rahasia; mengetahui bahwa pada suatu malam seperti ini, kita Para Saudari Perak akan bangkit melawan. Mari kita mulai?"
      Speaker = "Selene"
      Event = "SeleneBackstory01"
    }
    {
      Id = "Selene_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua makhluk berjuang untuk saling memahami. Aku belajar dari Nyx cara mengekspresikan diri, sebagaimana kau belajar dari Kepala Sekolahmu. Tutur kata kita berakar pada masa lalu; ikatan kita, begitu rapuh."
      Speaker = "Selene"
      Event = "SeleneAboutSpeech01"
    }
    {
      Id = "Selene_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sama sekali tak mengingat Nyx? Sang Malam sendirilah yang menemukanku, terbuang dan tak diinginkan, lalu membesarkanku sejak belia. Namun saat Titan Chronos merebut Graha Hades, beliau ada di sana. Aku masih sangat merindukannya."
      Speaker = "Selene"
      Event = "SeleneAboutNyx01"
    }
    {
      Id = "Selene_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di malam segelap ini, aku hanya bisa memikirkan Nyx. Beliau memimpin Dunia Bawah di Graha ayahmu. Dan beliau merawatku, di antara begitu banyak jiwa lainnya. Beliau tahu aku mendambakan cakrawala. {#Emph}Pergilah{#Prev}, sabda beliau. {#Emph}Dan tolong tetaplah mengawasi untukku dari atas sana."
      Speaker = "Selene"
      Event = "SeleneAboutNyx02"
    }
    {
      Id = "Selene_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Nyx, dalam segala kemuliaannya, mulai memanggilku sang Mata Malam, karena aku sanggup melihat bahkan di tempat yang tak terjangkau olehnya. Kehormatan ini memacuku hingga kini, persis seperti aku memacu kereta kudaku. Kita akan menuntut balas untuk beliau, bintang kecil."
      Speaker = "Selene"
      Event = "SeleneAboutNyx03"
    }
    {
      Id = "Selene_0058_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Nyx, dalam segala kemuliaannya, mulai memanggilku sang Mata Malam, karena aku sanggup melihat bahkan di tempat yang tak terjangkau olehnya. Kehormatan ini memacuku hingga kini, persis seperti aku memacu kereta kudaku."
      Speaker = "Selene"
      Event = "SeleneAboutNyx03_B"
    }
    {
      Id = "Selene_0368"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyx akhirnya telah kembali pada kita, dan mungkin seiring berjalannya waktu, kau akan mengenalnya sebaik aku. Kendati pengaruhnya tak pernah pudar, aku sangat merindukan kebijaksanaan dan kehadirannya. Dan kepadamulah aku berterima kasih atas pertemuan ini."
      Speaker = "Selene"
      Event = "SeleneAboutNyxReturn01"
    }
    {
      Id = "Selene_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Titan Chronos, dia adalah Waktu itu sendiri. Maka secara hakiki, kita takkan pernah bisa benar-benar siap menghadapinya. Dia menginginkan keruntuhan Olympus, namun bagaimana caranya secara pasti, kita masih belum tahu."
      Speaker = "Selene"
      Event = "SeleneAboutChronos01"
    }
    {
      Id = "Selene_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah turun ke Tartarus, dan pasti melihat apa yang Chronos perbuat pada tempat paling suci itu. Aku tahu pertarunganmu tak berjalan sesuai harapan, namun ini adalah malam yang baru. Dan kau kini jauh lebih siap."
      Speaker = "Selene"
      Event = "SeleneAboutChronosBossL01"
    }
    {
      Id = "Selene_0366"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku menyimpan kebencian mendalam pada Titan Chronos, atas segala hal yang telah dia perbuat; atas segala penderitaan yang kau lalui. Namun kini dia sendiri berusaha membatalkan kehancuran yang disebabkannya? Sungguh kekuatan luar biasa yang kau miliki, hingga sanggup melahirkan perubahan sebesar ini."
      Speaker = "Selene"
      Event = "SeleneAboutGoodChronos01"
    }
    {
      Id = "Selene_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan bodoh itu. Dia telah membangkitkan Typhon, monster paling mengerikan yang pernah ada. Aku masih menyimpan bekas luka dari benturan pertama kami di masa yang amat lampau. Bersama-sama, kami pernah menundukkannya dulu; kita harus sanggup melakukannya lagi."
      Speaker = "Selene"
      Event = "SeleneAboutTyphon01"
    }
    {
      Id = "Selene_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Monster Typhon itu, dia pernah mengecap kekalahan sebelumnya. Sejak saat itu ukuran, kekuatan, dan amarahnya kian membesar, namun aku menaruh keyakinan penuh bahwa kaulah yang akan keluar sebagai pemenang melawannya, bintang kecil."
      Speaker = "Selene"
      Event = "SeleneAboutTyphon02"
    }
    {
      Id = "Selene_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan monster semengerikan Typhon pun tak mampu menahanmu, bintang kecil. Kepala Sekolahmu dan aku selalu tahu potensi yang kau miliki. Kini, aku telah menyaksikanmu membuktikannya, bahkan melampauinya."
      Speaker = "Selene"
      Event = "SeleneAboutTyphonW01"
    }
    {
      Id = "Selene_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat ini, monster Typhon itu pasti kembali teringat pahitnya kekalahan, namun dia tak kunjung menyerah. Maka dia tak memberi kita pilihan lain selain mencari cara untuk melenyapkannya sehabis-habisnya, bintang kecil."
      Speaker = "Selene"
      Event = "SeleneAboutTyphonW02"
    }
    {
      Id = "Selene_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mendengar dari Kepala Sekolahmu perihal penglihatanmu saat Chronos menemukan dan menangkap Tiga Moerae. Ini pasti bagian penting dari siasatnya... namun, hal itu {#Emph}tidak {#Prev}mengubah siasat kita. Para Saudari Perak pantang menyerahkan kendali."
      Speaker = "Selene"
      Event = "SeleneAboutFates01"
    }
    {
      Id = "Selene_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyx sering memuji kakakmu di depanku, bintang kecil. Hubunganku pun merenggang dengan saudaraku Helios, sang Mentari. Terkadang aku memperlambat kudaku demi mencuri pandang ke arahnya saat dia menyinari daratan. Rasanya tak banyak yang bisa kami bicarakan berdua."
      Speaker = "Selene"
      Event = "SeleneAboutHelios01"
    }
    {
      Id = "Selene_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin pada suatu fajar di daratan, kau akhirnya bisa melihat Eos, bintang kecil. Dia luar biasa jelita, begitu rupawan hingga manusia fana mengaguminya. Namun aku tak pernah mengenalnya begitu dekat. Dia hanya singgah sekejap, lalu lenyap begitu saja."
      Speaker = "Selene"
      Event = "SeleneAboutEos01"
    }
    {
      Id = "Selene_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memegang Kobaran Ygnium, namun dalam rupa Eos. Saudariku itu, dalam kepolosan masa mudanya, tak tahu-menahu perihal ini. Semoga dia menikmati perjalanannya setiap fajar hingga masa yang amat jauh."
      Speaker = "Selene"
      Event = "SeleneAboutEosAspect01"
    }
    {
      Id = "Selene_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pandanglah Aspek Xinth yang dulu pernah kutempa dan kugunakan, bintang kecil; barangkali kelak akan kupegang lagi di masa mendatang. Dulu cahayaku amat ditakuti, hingga pendekatan yang lebih hening kurasa paling pas untukku. Namun kau tak perlu menahan diri."
      Speaker = "Selene"
      Event = "SeleneAboutSeleneAspect01"
    }
    {
      Id = "Selene_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagai pemegang Aspek Jubah Hitam milikku, kau secara naluriah tahu cara menggunakan Kutukan Langit Runtuh; kekuatan rahasiaku, yang cahayanya bisa kau ubah setiap malam lewat Jalur Para Bintang."
      Speaker = "Selene"
      Event = "SeleneAboutSeleneAspect02"
    }
    {
      Id = "Selene_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa cemerlangnya Aspek Jubah Hitam milikku bersinar, karena kulihat ia telah mencapai puncak kekuatannya di bawah rawatanmu. Begitu dahsyat kehancuran yang sanggup disebarkannya hingga aku sendiri masih merasa gentar."
      Speaker = "Selene"
      Event = "SeleneAboutSeleneAspect03"
    }
    {
      Id = "Selene_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyandang Aspek-ku, Arkana-ku, dan Sorot Rembulanku sekaligus? {#Emph}Aduh{#Prev}, bintang kecil, jadilah dirimu sendiri dan tak perlu berusaha menjadi sepertiku. Meski begitu, barangkali kuda-kudaku akan menyambut penunggang baru suatu saat nanti."
      Speaker = "Selene"
      Event = "SeleneAboutAllSelene01"
    }
    {
      Id = "Selene_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aspek Ibu Nyx pada Jubah Hitam... Aku tahu beliau dulu pernah memegang Xinth sendiri walau tak pernah menyaksikannya, sebab beliau bahkan sanggup membelokkan cahaya {#Emph}milikku{#Prev}. Sungguh suatu kehormatan bahwa Aspeknya berkenan menunjukkan diri kepadamu."
      Speaker = "Selene"
      Event = "SeleneAboutNyxAspect01"
    }
    {
      Id = "Selene_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aspek tersembunyi dari Senjata Malam... Kupahami semuanya berasal dari dewa dan dewi kegelapan yang amat jauh... serba samar, beberapa bahkan mungkin pemilik di masa depan. Barangkali ada pola yang jauh lebih mendalam yang mempersatukan mereka..."
      Speaker = "Selene"
      Event = "SeleneAboutHiddenAspects01"
    }
    {
      Id = "Selene_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita bernapas, kita berdarah, kita beristirahat, kita mengulang dari awal. Apakah kita yang menciptakan siklus ini, ataukah kita sekadar bagian darinya? Terkadang aku bertanya-tanya pada diriku sendiri di tengah pacuan kuda."
      Speaker = "Selene"
      Event = "SeleneAboutLunarCycle01"
    }
    {
      Id = "Selene_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita mulai siklus yang lain, bintang kecil. Setiap perputaran punya kejutannya masing-masing, namun di balik pola agung semesta, tersimpan kenikmatan tersendiri, bukan?"
      Speaker = "Selene"
      Event = "SeleneAboutLunarCycle02"
    }
    {
      Id = "Selene_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak manusia fana gentar menyongsong datangnya kegelapan, namun bagaimana dengan kita? Kegelapan adalah ranah tempat kita berkarya. Majulah, bintang kecil, dan mari kita bersinar bersama menembus kegelapan malam ini."
      Speaker = "Selene"
      Event = "SeleneAboutDarkness01"
    }
    {
      Id = "Selene_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sorot Rembulanku sama tak terhitungnya dengan bintang-bintang, dan kau hanya memegang satu; namun itu adalah yang kupilihkan secara khusus untukmu, dan akan memastikan ikatan kita tetap terjalin erat."
      Speaker = "Selene"
      Event = "SeleneAboutKeepsake01"
    }
    {
      Id = "Selene_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selama kau memegang Sorot Rembulanku, aku bisa melacak keberadaanmu secepat mungkin; dan sejak saat itu, malam akan menjadi milik kita seutuhnya. Tentukan sekarang cara yang kau pilih untuk meraih kemenangan."
      Speaker = "Selene"
      Event = "SeleneAboutKeepsake02"
    }
    {
      Id = "Selene_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memegang seberkas Sorot Rembulan yang kuberikan sebagai lambang ikatan dan gabungan kekuatan kita. Sebentar lagi kau akan bersinar sepertiku, dan musuh-musuhmu takkan punya tempat lagi untuk bersembunyi."
      Speaker = "Selene"
      Event = "SeleneAboutKeepsake03"
    }
    {
      Id = "Selene_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sorot Rembulan milikmu itu telah berpendar luar biasa benderang di bawah asuhanmu. Ia akan menerangi jalanmu untuk selamanya; kekuatannya berada di titik puncak. Dan kapan pun kau membutuhkanku, aku akan selalu ada di sisimu."
      Speaker = "Selene"
      Event = "SeleneAboutKeepsake04"
    }
    {
      Id = "Selene_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kerap kali kulihat sepasang Belati Bersaudari berkilau dalam genggamanmu. Aku tahu pada akhirnya mereka akan terbangun kembali dan menerimamu sebagai tuannya. Semoga kelincahannya sanggup melumat habis lawan-lawanmu."
      Speaker = "Selene"
      Event = "SeleneAboutDagger01"
    }
    {
      Id = "Selene_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengayunkan Kapak Batu Bulan, bilah lebarnya berkilau oleh cahayaku. Maka kau pasti mendengar kidung yang dinyanyikannya. Kekuatan yang begitu dahsyat, menyatu dengan kekuatanmu."
      Speaker = "Selene"
      Event = "SeleneAboutAxe01"
    }
    {
      Id = "Selene_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Api Bayang sangat cocok untukmu... sungguh serupa dengan obor kembar Kepala Sekolahmu, meski sudah setua apa pun itu. Dalam bentuk apa pun, cahaya penuntun selalu menjadi teman yang disambut baik."
      Speaker = "Selene"
      Event = "SeleneAboutTorch01"
    }
    {
      Id = "Selene_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau kini menguasai Tengkorak Perak Revaal... pengingat abadi bahwa Kematian dan Ketakutan selayaknya selalu bersekutu demi tujuan kita. Celakalah siapa pun yang bertatapan dengannya."
      Speaker = "Selene"
      Event = "SeleneAboutLob01"
    }
    {
      Id = "Selene_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mantel Hitam... selubung Malam sekaligus pertahanan pamungkas, kini menjadi milikmu. Kau memikul tanggung jawab besar untuk menggunakannya dengan benar... atau memicu kehancuran yang mampu menelan sang Surya."
      Speaker = "Selene"
      Event = "SeleneAboutSuit01"
    }
    {
      Id = "Selene_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap kali kau memanggilku seperti ini, kutuntun kuda-kudaku mendekati bumi, sejauh yang berani mereka tapaki. Kupikir, mereka mulai semakin berani. Kini gunakanlah dengan baik kekuatan yang kubangkitkan dalam dirimu."
      Speaker = "Selene"
      Event = "SeleneAboutSteeds01"
    }
    {
      Id = "Selene_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjalananku melintasi langit cenderung amat sunyi. Memang, aku punya kuda-kudaku untuk diajak bicara. Namun tidaklah sama dengan saat aku memiliki kesempatan untuk berbincang denganmu."
      Speaker = "Selene"
      Event = "SeleneAboutSteeds02"
    }
    {
      Id = "Selene_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah terlalu lama sejak terakhir kali aku melihatmu. Kuda-kudaku sempat kelelahan karena perjalanan kami. Di manakah aku tanpanya? Lebih dekat denganmu, memang, tetapi... di sinilah tempat kami yang semestinya."
      Speaker = "Selene"
      Event = "SeleneAboutSteeds03"
    }
    {
      Id = "Selene_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melangkah jauh sejak pertemuan terakhir kita... apalagi bagi seseorang yang tak memiliki tunggangan. Karenanya kuapresiasi dirimu, dan semoga semua upayamu kelak senantiasa berhasil."
      Speaker = "Selene"
      Event = "SeleneRunCleared01"
    }
    {
      Id = "Selene_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah menghadapi sang Titan di kedalaman terkelam... hal itu sudah kuketahui sebelum Kepala Sekolahmu memastikan bahwa kau berhasil menundukkannya, persis seperti keyakinanku padamu. Jika daya hidupnya ibarat butiran pasir, maka kau baru mengambil sebutir; suatu saat nanti, {#Emph}semuanya."
      Speaker = "Selene"
      Event = "SeleneRunCleared02"
    }
    {
      Id = "Selene_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kematian bagi Chronos. {#Prev}Kurasakan kau semakin dekat mewujudkan kenyataan yang telah lama kita impikan. Semoga kau kelak menguras habis secercah cahaya yang masih tersisa dalam dirinya."
      Speaker = "Selene"
      Event = "SeleneRunCleared03"
    }
    {
      Id = "Selene_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah memberanikan diri ke permukaan dan menembus beratnya perjalanan menuju gunung para dewa, lalu entah bagaimana mampu bertahan menghadapi monster purba yang bangkit dari masa lalu... kau bahkan melebihi bayanganku, bintang kecil."
      Speaker = "Selene"
      Event = "SeleneSurfaceRunCleared01"
    }
    {
      Id = "Selene_0370"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menundukkan Chronos di masa yang lain...? Atau {#Emph}dari {#Prev}masa yang lain, dan dengan bantuan sang Titan itu sendiri. Benar-benar misterius kekuatannya. Namun jika ini yang diperlukan agar waktu kita mengalir bebas ke depan, mari kita pastikan hal itu tuntas."
      Speaker = "Selene"
      Event = "SelenePostTrueEndingRunCleared01"
    }
    {
      Id = "Selene_0371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ancaman Typhon kini sirna bagi kita, namun kau memastikannya bersama Titan Chronos agar kemungkinan ancaman semacam itu takkan pernah bisa ada? Maka jadilah demikian; sebagai Saudari Perak, kita menjaga alam ini dengan segala daya kita."
      Speaker = "Selene"
      Event = "SelenePostTrueEndingRunCleared02"
    }
    {
      Id = "Selene_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalaulah kau bisa menyaksikan dunia dari tempatku memacu kereta. Suatu malam nanti, mungkin? Aku tahu betul seberapa banyak keburukan di sana. Namun, semuanya tampak tersamarkan dari kejauhan."
      Speaker = "Selene"
      Event = "SelenePostGift01"
    }
    {
      Id = "Selene_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan suatu beban menarikku ke arah Persimpangan baru-baru ini, dan kusadari itu adalah Batu Hitam Pekat. Rupanya benda itu telah bangkit... mirip seperti sebuah Mata, namun jauh lebih tua dariku, dan mengintai dari jurang tak terhingga."
      Speaker = "Selene"
      Event = "SeleneAboutBountyBoard01"
    }
    {
      Id = "Selene_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sensasi aneh ini... aku ingat apa ini: kehendak Chaos, memengaruhi sekitar kita meski secara samar. Aku percaya ini terjadi berkat tindakanmu, bukan kebetulan belaka."
      Speaker = "Selene"
      Event = "SelenePackageBountyIntro01"
    }
    {
      Id = "Selene_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan ada yang janggal malam ini... seakan-akan aku tidak menemukanmu atas kehendakku sendiri. Batu Hitam Pekat... begitu rupanya, tentu saja. Itu adalah beban bagi segala hal yang kita amati."
      Speaker = "Selene"
      Event = "SeleneAboutPackageBounty02"
    }
    {
      Id = "Selene_0476"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan pengaruh Chaos yang lebih besar malam ini, sehingga perjalanan menuju tujuanmu mungkin akan berbelok tak terduga. Semoga cahayaku tetap dapat menjadi penuntun bahkan saat ini."
      Speaker = "Selene"
      Event = "SeleneAboutRandomBounties01"
    }
    {
      Id = "Selene_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menghabiskan seluruh hidupmu di Erebus yang berkabut... dunia ini jauh lebih luas daripada tempat itu. Kau akan melihat lebih banyak lagi, kurasa, sebelum tugasmu purna."
      Speaker = "Selene"
      Event = "SeleneAboutErebus01"
    }
    {
      Id = "Selene_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak seharusnya berada di sini, bintang kecil. Darah terkutukmu akan menentang tiap langkahmu. Namun Nyx sendiri pasti memahami pergulatan yang kau hadapi. Beliau pun pernah menggagalkan suratan para Moirai..."
      Speaker = "Selene"
      Event = "SeleneAboutSurfaceCurse01"
    }
    {
      Id = "Selene_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasakan dirimu kian mendekati cahayaku. Kau berhasil menekan kutukan para Moirai yang membelenggumu di alammu. Sempat ragu aku hal semacam itu mungkin dilakukan... namun kau cukup sering mengejutkanku, bintang kecil."
      Speaker = "Selene"
      Event = "SeleneAboutSurfaceCurse02"
    }
    {
      Id = "Selene_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau melenyapkan bangsal gerbang permukaan Persimpangan... melintasi tabir antara dunia yang kau kenal dan dunia yang kupandangi tiap malam ini. Barangkali rencana kita memang membutuhkan tahap baru ini..."
      Speaker = "Selene"
      Event = "SeleneAboutSurfaceWards01"
    }
    {
      Id = "Selene_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kusambut dirimu di permukaan dunia kita, bintang kecil. Aku tahu kau akan menemukan jalan ke mari. Jika kau merasa tersesat, kau hanya perlu menengadah padaku. Dan aku akan selalu mengawasimu."
      Speaker = "Selene"
      Event = "SeleneAboutSurface01"
    }
    {
      Id = "Selene_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya kusambut dirimu lebih resmi di permukaan dunia kita, bintang kecil. Sebagian diriku tahu kau pasti menemukan jalan ke mari. Jika kau merasa tersesat, cukup tengadahkan pandanganmu ke atas."
      Speaker = "Selene"
      Event = "SeleneAboutSurface01_B"
    }
    {
      Id = "Selene_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kota Ephyra telah menyaksikan begitu banyak pertikaian. Andai saja kau sempat menyaksikannya saat penduduknya masih memuja ibu dan ayahmu. Kita akan membalaskan dendam mereka semua."
      Speaker = "Selene"
      Event = "SeleneAboutSurface02"
    }
    {
      Id = "Selene_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di sini cahayaku tak memberikan kekuatan yang lebih besar daripada yang kau rasakan di bawah sana, sebab kuberikan semua yang aman kuberikan di mana pun kau berada. Menjadi andalan dan selalu teguh adalah tugasku."
      Speaker = "Selene"
      Event = "SeleneAboutSurface03"
    }
    {
      Id = "Selene_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami membutuhkanmu di tempatmu berada. Pertarunganmu melintasi Dunia Bawah sangat berpengaruh terhadap perang yang berkecamuk di sini. Namun serahkan permukaan kepada para dewa, dan diriku. Jangan sampai teralihkan oleh gerbang Persimpangan yang tersegel menuju ke atas."
      Speaker = "Selene"
      Event = "SeleneAboutSurfaceWar01"
    }
    {
      Id = "Selene_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutemukan dirimu, meski cahayaku hanyalah kelap-kelip di kedalaman ini. Kau menapaki jalan rahasia antara alam Poseidon dan ayahmu. Apa pun yang mengintai di sini tak menaruh kasih pada keduanya."
      Speaker = "Selene"
      Event = "SeleneAboutOceanus01"
    }
    {
      Id = "Selene_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biasanya tak secercah pun cahayaku menembus wilayah suram ini, tetapi demi dirimu, bintang kecil? Aku takkan ragu menembus surga maupun bumi sekaligus. Bersama-sama, mari kita raih kemenangan."
      Speaker = "Selene"
      Event = "SeleneAboutFields01"
    }
    {
      Id = "Selene_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari sudut pandangmu, perairan itu pasti tampak tiada ujungnya. Tetapi perairan itu {#Emph}ada {#Prev}ujungnya, dan kau punya cara untuk membelahnya dengan cepat. Aku akan menyaksikanmu berlayar dan membantumu bergegas."
      Speaker = "Selene"
      Event = "SeleneAboutThessaly01"
    }
    {
      Id = "Selene_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di atas langit ini, aku kebal dari masalah duniawi, seperti harus berbagi tempat tinggal dengan dewi pembalasan. Nemesis tak pernah memperlakukanku layaknya saudari. Ia hanya mewarisi kekuatan ibunya."
      Speaker = "Selene"
      Event = "SeleneAboutNemesis01"
    }
    {
      Id = "Selene_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah berdamai dengan Nemesis, bahkan lebih dari itu; barangkali di balik perangainya, ia bukanlah dewi seperti yang selama ini tampak. Jika kau menganggapnya pantas, bintang kecil, itu sudah cukup bagiku."
      Speaker = "Selene"
      Event = "SeleneAboutNemesis02"
    }
    {
      Id = "Selene_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau makin sering berbincang dengan sang Takdir Buruk sendiri; putra Nyx yang tak begitu dekat denganku. Aku akan mempercayai nalurimu tentangnya, karena naluriku sendiri belum berkata banyak sejauh ini."
      Speaker = "Selene"
      Event = "SeleneAboutMoros01"
    }
    {
      Id = "Selene_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tetap merasa risau akan putra Nyx yang tertidur lelap selamanya di Persimpanganmu. Baik Kepala Sekolahmu maupun diriku sejauh ini tak mampu membangunkannya. Namun setiap penyakit pasti ada obatnya..."
      Speaker = "Selene"
      Event = "SeleneAboutHypnos01"
    }
    {
      Id = "Selene_0465"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengalamanmu berkembang begitu pesat menggunakan ilmumu sampai-sampai kau berhasil membangunkan Hypnos yang tertidur abadi dari mimpinya? Bunda Nyx telah mengabariku bahwa ia kini kembali bertugas, meski tumpukan pekerjaannya luar biasa banyak..."
      Speaker = "Selene"
      Event = "SeleneAboutHypnosWakeUp01"
    }
    {
      Id = "Selene_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir Medea pernah belajar cara meredupkan cahayaku, menciptakan gerhana kapan pun ia mau. Kami sempat berbincang setelah itu, dan segalanya membaik di antara kami sejak saat itu. Di antara kutukannya dan Kutukan Sihirku, kau akan menjadi sosok yang ditakuti."
      Speaker = "Selene"
      Event = "SeleneAboutMedea01"
    }
    {
      Id = "Selene_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lama penyihir Circe memahami bahwa aku melakukan lebih dari sekadar melintasi langit. Ia merapal mantra-mantranya selaras dengan fase-fase cahayaku; kau bisa mengandalkan kekuatan yang ia anugerahkan."
      Speaker = "Selene"
      Event = "SeleneAboutCirce01"
    }
    {
      Id = "Selene_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh tak biasa melihat sayap Icarus membubung melintasi langit. Aku ingat bagaimana kau mendorongnya untuk mengatasi rasa takutnya dan mulai terbang. Aku akan terus mengawasinya untuk memastikan ia tetap melayang tinggi."
      Speaker = "Selene"
      Event = "SeleneAboutIcarus01"
    }
    {
      Id = "Selene_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku melihat kau berhadapan dengan Herakles. Berhati-hatilah pada pria itu, ia menciptakan banyak musuh demi melayani para dewa. Ia bahkan pernah menzalimiku sekali, dan masih saja melangkah tanpa rasa malu di bawah cahayaku."
      Speaker = "Selene"
      Event = "SeleneAboutHeracles01"
    }
    {
      Id = "Selene_0462"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulit singa yang kini dikenakan Herakles, ia rampas dari makhluk yang sangat kusayangi. Dulu aku membencinya, meski ia hanya bertindak atas perintah para dewa yang ingin menguji kesetiaannya. Sejak saat itu, aku telah belajar untuk membuang jauh-jauh amarahku."
      Speaker = "Selene"
      Event = "SeleneAboutHeracles02"
    }
    {
      Id = "Selene_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kiklop Polifemus yang kau hadapi itu, pernah bersembunyi di dalam gua yang bahkan tak bisa dijangkau oleh cahaya perak{#Emph}ku{#Prev}. Sekarang ia berpihak pada Kronos. Terlalu banyak yang memberontak melawan para dewa..."
      Speaker = "Selene"
      Event = "SeleneAboutPolyphemus01"
    }
    {
      Id = "Selene_0461"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh aneh melihat Polifemus yang canggung dan Medea bekerja sama, sekalipun Sumpah Para Pesaing adalah penyebabnya. Namun yang lebih aneh lagi, Kiklop itu adalah gembala kedua yang kukenal dengan kebiasaan tidur panjang yang teramat pulas..."
      Speaker = "Selene"
      Event = "SeleneAboutPolyphemus02"
    }
    {
      Id = "Selene_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris bersayap hitam telah menjadi rintangan; terkadang ia terbang melintasi jalanku dan mengejutkan kuda-kudaku. Aku adalah Mata Sang Malam, namun aku hampir tak melihat nilai apa pun di dalam dirinya..."
      Speaker = "Selene"
      Event = "SeleneAboutEris01"
    }
    {
      Id = "Selene_0464"
      InheritFrom = "BaseNarrative"
      DisplayName = "Awalnya aku meragukan pertemananmu dengan Eris, namun kini aku sadar kau pasti melihat sesuatu di dalam dirinya, sesuatu yang bahkan tak bisa kulihat. Kau sungguh luar biasa sabar sampai bisa menerima sosok seperti dirinya."
      Speaker = "Selene"
      Event = "SeleneAboutEris02"
    }
    {
      Id = "Selene_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Titan tak pernah bersatu, bahkan ketika para dewa dan Kronos pertama kali berperang dahulu kala. Prometheus... ia memihak Zeus saat itu, tapi sekarang? Tujuannya bersinggungan dengan tujuan kita. Satu lagi musuh dari bangsaku sendiri..."
      Speaker = "Selene"
      Event = "SeleneAboutPrometheus01"
    }
    {
      Id = "Selene_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan Kronos dan Prometheus telah menjalin persekutuan, namun mereka berdua tak begitu serupa. Prometheus mendambakan dunia di mana manusia fana tak perlu tunduk pada para dewa? Dari semua makhluk, ia seharusnya paling tahu bahwa hal itu takkan pernah terwujud."
      Speaker = "Selene"
      Event = "SeleneAboutPrometheus02"
    }
    {
      Id = "Selene_0463"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Titan Peramal sedang bersekongkol dengan Herakles. Barangkali kecintaan mereka pada umat manusia yang menyatukan mereka; itu, atau hubungan mereka dengan para dewa. Kupikir mereka berdua yang akan saling bersaing, bukan malah menjadi sainganmu."
      Speaker = "Selene"
      Event = "SeleneAboutPrometheus03"
    }
    {
      Id = "Selene_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada yang luput dari pandangan Saudari Perak: Aku, di surga; sang dewi perburuan, di permukaan; kau, di bawah bumi; dan Penyihir Persimpangan Jalan, di antara alam-alam. Sekarang kita tak lagi sekadar mengamati, melainkan bertindak."
      Speaker = "Selene"
      Event = "SeleneAboutSilverSisters01"
    }
    {
      Id = "Selene_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tugas kita sebagai Saudari Perak adalah bekerja dalam bayang-bayang demi menegakkan kehendak Sang Malam. Olympus tak mengetahui keberadaan kita; bahwa Dewi Perburuan mereka sendiri adalah bagian dari kita; bahwa Utusan mereka sendiri juga mengabdi pada kita. Mari biarkan tetap seperti ini."
      Speaker = "Selene"
      Event = "SeleneAboutMission01"
    }
    {
      Id = "Selene_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artemis telah membeberkan pada Olympus apa yang perlu mereka ketahui tentangmu, dan kini ia tengah menjelajahi hutanmu. Setelah segala kemelut kita mereda, semoga kita segenap Saudari Perak bisa bersukacita."
      Speaker = "Selene"
      Event = "SeleneAboutObscurity01"
    }
    {
      Id = "Selene_0483"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasakan pengaruh Arcana yang diasosiasikan denganku meresap dalam dirimu. Maka biarkanlah sihir itu mengalir melaluimu, dan semoga Kutukan Sihir mana pun yang kau wujudkan menuntunmu menuju kejayaan."
      Speaker = "Selene"
      Event = "SeleneAboutArcana01"
    }
    {
      Id = "Selene_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah melihat Jalur Para Bintang, dan merasakan hubungannya dengan kekuatanku serta kekuatanmu. Walau Jalur kita terkadang bercabang, sering kali mereka bermuara pada satu titik yang sama."
      Speaker = "Selene"
      Event = "SeleneAboutTalentDrop01"
    }
    {
      Id = "Selene_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingatlah, bintang kecil: Sihir yang dibangkitkan oleh cahayaku di dalam dirimu membutuhkan fokus aktif darimu; kekuatan itu hampa tanpa niatmu. Di saat-saat kau membutuhkannya, jangan pernah ragu."
      Speaker = "Selene"
      Event = "SeleneAboutMagick01"
    }
    {
      Id = "Selene_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anugerah sihir ini tidak berasal dariku, melainkan dari dalam dirimu. Namun, benar juga bahwa binar cahayaku membangkitkan potensi alami tersebut. Suatu rahasia umum yang bahkan diketahui oleh manusia fana di permukaan."
      Speaker = "Selene"
      Event = "SeleneAboutMagick02"
    }
    {
      Id = "Selene_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjalananku yang tak terhitung jumlahnya melintasi langit memberiku banyak waktu untuk memahami cahayaku. Sekarang, aku memiliki Kutukan Sihir untuk setiap peristiwa, setiap fase. Dan kau pun akan memilikinya."
      Speaker = "Selene"
      Event = "SeleneAboutHexes01"
    }
    {
      Id = "Selene_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah semakin terbiasa dengan Kutukan Sihirku, bintang kecil. Sekarang kau pasti punya satu atau dua favorit tertentu. Barangkali kau akan terus menemukan dimensi baru di dalam semuanya."
      Speaker = "Selene"
      Event = "SeleneAboutHexes02"
    }
    {
      Id = "Selene_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya kau menatap Sumpah Kaum Tak Kasat Mata... karena malam ini sungguh tiada duanya dibandingkan malam mana pun yang pernah kualami selama berabad-abad. Seolah Kegelapan menyelimuti {#Emph}segalanya..."
      Speaker = "Selene"
      Event = "SeleneAboutShrine01"
    }
    {
      Id = "Selene_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau boleh memberlakukan Wasiat Sang Malam malam ini, sesulit apa pun untuk mengatasi Ketakutan yang terus membuncah dan menyebar bersama setiap Ikrar yang diucapkan. Aku akan menjadi saksimu."
      Speaker = "Selene"
      Event = "SeleneAboutShrine02"
    }
    {
      Id = "Selene_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini telah menjadi luar biasa kelam, dan Ketakutan telah merasuk ke setiap sudut alam; ini perbuatanmu melalui Sumpah itu, bukan? Maka berhati-hatilah, bintang kecil, karena tak ada yang bisa menyelamatkanmu dari pilihan-pilihan yang kau buat sendiri."
      Speaker = "Selene"
      Event = "SeleneAboutShrine03"
    }
    {
      Id = "Selene_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Awalnya, kukira inderaku telah memperdayaiku, namun aku semakin yakin seiring berlalunya malam demi malam... kau telah menuntaskan seluruh Wasiat di dalam Sumpah itu...! Dan untuk saat ini, kehendak Sang Malam benar-benar terpenuhi. Aku sungguh kagum pada keteguhanmu."
      Speaker = "Selene"
      Event = "SeleneAboutShrineComplete01"
    }
    {
      Id = "Selene_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau beruntung bisa belajar dari sang pengelana Odysseus. Dulu aku sering mengamati seluruh perjuangannya sebagai manusia fana, mulai dari peperangannya hingga pelayarannya. Beberapa kisah tentangnya memang dibesar-besarkan, tapi tidak semuanya. Ia pria yang menarik."
      Speaker = "Selene"
      Event = "SeleneAboutOdysseus01"
    }
    {
      Id = "Selene_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Andai kekuatan Olympus sudah cukup, para dewa pasti sudah mengakhiri kemelut mereka sejak lama. Waktu itu sendiri menentang kita, namun justru inilah saat yang telah kita persiapkan bersama para Saudari Perak."
      Speaker = "Selene"
      Event = "SeleneAboutOlympus01"
    }
    {
      Id = "Selene_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olympus tak tahu seberapa besar kekuatanku yang sesungguhnya, ataupun kekuatanmu. Tapi itu justru lebih baik. Kita paling berbahaya saat kita tak tersorot; saat kita diremehkan. Tidakkah kau setuju?"
      Speaker = "Selene"
      Event = "SeleneAboutOlympus02"
    }
    {
      Id = "Selene_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita akan memastikan bahwa Ratu dan Raja Bawah Tanah yang sah merebut kembali takhta mereka. Ayahmu hanya kukenal dari penuturan Nyx, meski aku sering melihat ibumu saat ia berkunjung ke Olympus. Kau mewarisi keanggunan ningratnya, bintang kecil."
      Speaker = "Selene"
      Event = "SeleneAboutPersephone01"
    }
    {
      Id = "Selene_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bentangan langit malam yang luas memberiku sudut pandang yang sangat menguntungkan, dan aku melihat jelas perjuanganmu. Ketahuilah bahwa kesulitan yang kau tanggung ini hanyalah sebuah fase. Temukanlah keindahan di dalam ritme perputarannya."
      Speaker = "Selene"
      Event = "SeleneAboutPhases01"
    }
    {
      Id = "Selene_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masing-masing dari kita mengalami fase yang berbeda di sepanjang hidup kita. Aku hanya mengalami fase-fase itu jauh lebih teratur, dan jauh lebih sering daripada kebanyakan makhluk... karena aku selalu menghargai keteguhan, dalam keberadaan yang satu-satunya kepastian hanyalah perubahan."
      Speaker = "Selene"
      Event = "SeleneAboutPhases02"
    }
    {
      Id = "Selene_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sepenuhnya terselubung sekarang; bulan baru, untuk permulaan yang baru. Gunakan naungan kegelapanku untuk melangkah maju menuju tujuanmu."
      Speaker = "Selene"
      Event = "SeleneAboutNewMoon01"
    }
    {
      Id = "Selene_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah kehilangan banyak darah kehidupanmu. Kalau begitu mungkin aku terlambat kali ini. Namun selagi kau masih bisa berdiri, kau masih bisa memanfaatkan kekuatan agung yang kupancarkan di dalam dirimu."
      Speaker = "Selene"
      Event = "SeleneLowHealth01"
    }
    {
      Id = "Selene_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luka yang begitu parah telah kau derita, bintang kecil. Rasa sakit, tampaknya, telah tertanam dalam siklus hidup kita. Aku tak bisa melenyapkannya; namun kau bisa belajar untuk mengesampingkannya jauh-jauh."
      Speaker = "Selene"
      Event = "SeleneLowHealth02"
    }
    {
      Id = "Selene_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terluka; cahayamu meredup, bintang kecil. Jangan berkecil hati. Cahaya kita tak pernah padam. Bulan baru akan selalu terbit."
      Speaker = "Selene"
      Event = "SeleneLowHealth03"
    }
    {
      Id = "Selene_0468"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh-musuhmu telah membuatmu menumpahkan terlalu banyak darah malam ini. Sebentar lagi semuanya akan pulih kembali, namun hingga saat itu tiba, jangan tumpahkan setetes pun lagi dan berjuanglah demi bertahan hidup."
      Speaker = "Selene"
      Event = "SeleneLowHealth04"
    }
    {
      Id = "Selene_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu lagi malam yang penuh dengan kemungkinan. Aku melaju dari Fajar dan tak bisa tinggal lama; kulihat perjalanan malammu sendiri telah dimulai, jadi mari kita bersinar bersama, kini dan selamanya."
      Speaker = "Selene"
      Event = "SeleneRunStartIntro01"
    }
    {
      Id = "Selene_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gelapnya malam telah dimulai, begitu pula tugasmu. Dan aku di sini untuk mengantarmu ke dalam kegelapan itu, menuju kemenangan yang tak terelakkan, serta kematian."
      Speaker = "Selene"
      Event = "SeleneRunStart01"
    }
    {
      Id = "Selene_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah tiba untuk menemanimu di awal siklus ini, menerangi setiap langkah di sepanjang jalanmu. Jalur ini hanya tampak familier di mata, jadi berhati-hatilah."
      Speaker = "Selene"
      Event = "SeleneRunStart02"
    }
    {
      Id = "Selene_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kala siang memudar di permukaan, kita mulai bersinar. Aku akan mengalihkan perhatian musuh-musuhmu, selagi kau mendesak kian dekat menuju penuntasan yang telah disumpahkan oleh para Saudari Perak."
      Speaker = "Selene"
      Event = "SeleneRunStart03"
    }
    {
      Id = "Selene_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam lain kini memanggil, dan aku akan menebarkan bayang-bayang yang membawa kekuatan serta ketenangan secara bergantian. Pilihlah dengan bijak sihir magis mana yang paling bermanfaat bagimu."
      Speaker = "Selene"
      Event = "SeleneRunStart04"
    }
    {
      Id = "Selene_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos bisa menunggu, karena dialah Sang Waktu itu sendiri. Alih-alih terburu-buru, kau curahkan tenagamu untuk menghadapi pasukannya di permukaan, dan dengan begitu kau bisa memperlambatnya. Sembari dirimu terus bertambah kuat."
      Speaker = "Selene"
      Event = "SeleneAboutSwitchToSurface01"
    }
    {
      Id = "Selene_0469"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah begitu terbiasa mencarimu di dalam Dunia Bawah sampai-sampai terkadang masih terkejut mendapati dirimu berada di atas tanah. Ini memang lebih mudah bagiku, namun lebih sulit bagimu, bukan?"
      Speaker = "Selene"
      Event = "SeleneAboutSwitchToSurface02"
    }
    {
      Id = "Selene_0470"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya kau kembali ke alam bayang-bayang setelah bermalam-malam di bawah bintang-gemintang terbuka. Demi apa yang harus dituntaskan, lebih baik kau berada di habitat alamimu daripada aku di habitat alamiku."
      Speaker = "Selene"
      Event = "SeleneAboutSwitchToUnderworld01"
    }
    {
      Id = "Selene_0471"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham apa yang kini sedang kauupayakan. Dengan Titan Chronos yang masih terhuyung akibat kekalahan terakhirnya, ini adalah kesempatan bagus untuk menolong Olympus dalam kesulitannya. Bersinarlah terang demi para dewa."
      Speaker = "Selene"
      Event = "SeleneRunSwitchPostClear01"
    }
    {
      Id = "Selene_0473"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memiliki kekuatan yang sanggup mengimbangi monster sekelas Typhon sekalipun, dan Titan Chronos pasti menyadari betul hal itu sekarang. Mungkin kini giliran dia yang merasakan ketakutan menantikan kehadiranmu."
      Speaker = "Selene"
      Event = "SeleneRunSwitchPostClear02"
    }
    {
      Id = "Selene_0474"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya kau terbukti berhasil menjadi pengalih perhatian yang sangat baik bagi Typhon semalam. Kau akan memiliki kesempatan lain untuk menumpasnya, mungkin setelah Titan Chronos bertekuk lutut di hadapanmu malam ini."
      Speaker = "Selene"
      Event = "SeleneRunSwitchPostLoss01"
    }
    {
      Id = "Selene_0475"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam demi malam, kemenanganmu kian bertumpuk, dan aku ingin melihatmu meraih satu kemenangan lagi segera. Mungkin dengan cahayaku, kau bisa lebih mudah memastikan hasil akhir yang kita dambakan."
      Speaker = "Selene"
      Event = "SeleneAboutWinStreak01"
    }
    {
      Id = "Selene_0482"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum fana sering memandang kita dengan rasa takzim yang luar biasa atau justru dengan ketakutan; karena itulah mereka saling bertukar cerita, menggambarkan kita lebih hebat dari yang sebenarnya, atau sebaliknya. Aku sudah tak lagi menyalahkan mereka, lagipula apa lagi yang bisa mereka perbuat?"
      Speaker = "Selene"
      Event = "SeleneAboutMortals01"
    }
    {
      Id = "Selene_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Raja agung para Penghuni Olympus telah melimpahkan kepadamu sebagian dari kekuatannya yang menggelegar. Seharusnya itu sudah lebih dari cukup, namun jangan biarkan apa pun bergantung pada keberuntungan semata."
      Speaker = "Selene"
      Event = "SeleneAboutZeus01"
    }
    {
      Id = "Selene_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Merupakan hal langka bisa mendapatkan Berkah dari Ratu Hera. Dulu ia terkadang mencurahkan isi hatinya kepadaku saat sedang mandi. Belakangan ini ia menjadi jauh lebih tertutup... sama seperti kita semua."
      Speaker = "Selene"
      Event = "SeleneAboutHera01"
    }
    {
      Id = "Selene_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan sang dewa laut telah mengalir dalam dirimu? Poseidon berkeras bahwa dialah satu-satunya penguasa pasang surut air laut. Untuk hal ini aku tak bisa menyalahkannya. Dia memang tak tahu ataupun memahami pengaruh kekuatanku."
      Speaker = "Selene"
      Event = "SeleneAboutPoseidon01"
    }
    {
      Id = "Selene_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat kau telah bersinar dengan cahaya yang lain. Pasti ulah Dewa Apollo, kurasa. Jangan takut; kekuatannya selaras dengan milikku. Cahaya akan selalu menyelimuti cahaya, tak pernah saling menolak."
      Speaker = "Selene"
      Event = "SeleneAboutApollo01"
    }
    {
      Id = "Selene_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya kau bertemu dengan sang dewi musim, yang kekuatannya begitu dahsyat hingga kerap membentuk jalur perjalananku di malam hari. Bersama Demeter, kau memiliki pendukung yang tangguh dan setia, aku bisa merasakannya."
      Speaker = "Selene"
      Event = "SeleneAboutDemeter01"
    }
    {
      Id = "Selene_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menyaksikan Dewi Aphrodite mencarimu. Darinya aku belajar sedikit tentang cara memikat hati. Namun itu hanya bisa kulakukan saat kekuatanku berada di puncaknya, dan bahkan saat itu pun, aku khawatir pesonaku masih kalah bersinar dibanding dirinya."
      Speaker = "Selene"
      Event = "SeleneAboutAphrodite01"
    }
    {
      Id = "Selene_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebuah Berkah dari Sang Pandai Besi Hephaestus sangat didambakan oleh para pejuang di seluruh penjuru dunia. Kepadamu ia memberikannya tanpa ragu, tahu betul bahwa Penghuni Olympus saja takkan sanggup menghentikan apa yang telah dimulai."
      Speaker = "Selene"
      Event = "SeleneAboutHephaestus01"
    }
    {
      Id = "Selene_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi api Hestia selalu terbukti sulit untuk dilacak, namun ia rela menampakkan dirinya di hadapanmu? Antara reputasimu yang kian tersohor, atau keputusasaan para dewa yang kian memuncak."
      Speaker = "Selene"
      Event = "SeleneAboutHestia01"
    }
    {
      Id = "Selene_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang dewa perang memutuskan bahwa campur tangannya sangat dibutuhkan, dan telah menganugerahimu sebagian dari kekuatannya yang ganas. Memang tampak sulit untuk memercayai Ares, namun aku mendapati bahwa motifnya selalu terpampang sangat jelas."
      Speaker = "Selene"
      Event = "SeleneAboutAres01"
    }
    {
      Id = "Selene_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada satu dewa yang kecepatannya jauh melampaui tunggangan mana pun. Dan kulihat ia telah membagikan sebagian dari kecepatannya itu kepadamu. Aku peringatkan agar jangan {#Emph}terlalu {#Prev}terburu-buru. Keteguhan hati adalah kunci sejati menuju kemenangan."
      Speaker = "Selene"
      Event = "SeleneAboutHermes01"
    }
    {
      Id = "Selene_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami belum mendengar kabar apa pun dari Hermes yang gesit sejak ia memberitahu kami tentang pergerakan musuh. Maka dari itu kami menyerang, seraya tetap percaya bahwa suatu malam nanti ia akan kembali membawakan berita tentang rencana lain apa yang disiapkan oleh Titan Chronos."
      Speaker = "Selene"
      Event = "SeleneAboutHermesMission01"
    }
    {
      Id = "Selene_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadinya aku yakin tugasmu takkan memerlukan kehadiranmu di atas, melainkan hanya di bawah sana. Namun Hermes mengabarkan bahwa ancaman di permukaan kini jauh lebih besar dari perkiraan kita. Maka naiklah ke tempat kami; kapan pun Sang Waktu mengizinkan."
      Speaker = "Selene"
      Event = "SeleneAboutHermesMission02"
    }
    {
      Id = "Selene_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyandang lambang Chaos, bintang kecilku. Entitas paling purba di alam semesta ini telah kehilangan seorang anak akibat musuh bersama kita. Maka dari itu, sang pencipta agung kini menjadi sang penghancur agung, melalui dirimu."
      Speaker = "Selene"
      Event = "SeleneAboutChaos01"
    }
    {
      Id = "Selene_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Pendayung Charon sangat memahami setiap jalur berliku di dunia ini. Meski demikian, aku tetap menyediakan cahayaku untuknya. Dia tak perlu selalu meraba jalannya seorang diri."
      Speaker = "Selene"
      Event = "SeleneLootBought01"
    }
    {
      Id = "Selene_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak begitu suka melihat kilauan koin emas yang diambil Charon darimu. Kilauannya teramat mirip dengan terang siang hari, sesuatu yang bagiku juga hanya bisa kutoleransi sejenak saja."
      Speaker = "Selene"
      Event = "SeleneLootBought02"
    }
    {
      Id = "Selene_0466"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih suka jika kau tak perlu mengorbankan apa pun demi menggunakan kekuatanku, bintang kecilku. Namun jika segenggam koin emas bisa membantuku menemukan lokasimu dengan lebih pasti, maka biarlah begitu adanya."
      Speaker = "Selene"
      Event = "SeleneLootBought03"
    }
    {
      Id = "Selene_0467"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di antara anak-anak Nyx, Charon selalu menjadi salah satu yang paling pendiam dan penyendiri. Ikatan kekerabatan yang kau miliki dengannya bukanlah pemandangan biasa, bintang kecilku."
      Speaker = "Selene"
      Event = "SeleneLootBought04"
    }
    {
      Id = "Selene_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kini setelah takhta ayahmu dipulihkan dan Ibu Nyx telah bebas, mungkin Charon akan kembali mengantar Arwah orang mati ke tempat peristirahatan abadi mereka. Walau kurasa ia tetap akan memastikan persediaanmu terpenuhi dengan baik."
      Speaker = "Selene"
      Event = "SeleneLootBought05"
    }
    {
      Id = "Selene_0477"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah semakin mahir meracik Debu Bulan di kawah manjurmu, bintang kecilku. Ingin rasanya kuserahkan jauh lebih banyak lagi kepadamu, namun itu semua takkan ada gunanya tanpa niat tekadmu yang istimewa."
      Speaker = "Selene"
      Event = "SeleneAboutCardUpgradePoints01"
    }
    {
      Id = "Selene_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah mulai memahami rahasia dari Jubah Hitam. Ada satu yang bisa kubagi; sebuah frasa pembangun yang harus diucapkan di dekat Kolam Perak: {#Emph}Kulihat kau membawa kebahagiaan dan kehancuran dalam rengkuhan tanganmu. {#Prev}Ingatlah itu, dan ucapkanlah, bintang kecilku."
      Speaker = "Selene"
      Event = "SeleneGrantsHiddenAspect01"
    }
    {
      Id = "Selene_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahkah kau membisikkan frasa pembangun yang kubagikan sebelumnya ke hadapan Kolam Perak? Resapilah kata-katanya ke dalam hati: {#Emph}Kulihat kau membawa kebahagiaan dan kehancuran dalam rengkuhan tanganmu."
      Speaker = "Selene"
      Event = "SeleneAboutHiddenAspectProgress01"
    }
    {
      Id = "Selene_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyandang Aspek yang kubukakan untukmu sebelumnya. Aku tak tahu banyak tentang sosok Shiva ini selain reputasinya sebagai penghancur segala hal. Mungkin Jubah Hitam itu turut andil, walau itu terserah padamu untuk menyingkapnya sekarang."
      Speaker = "Selene"
      Event = "SeleneAboutHiddenAspect01"
    }
    {
      Id = "Selene_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kerabatmu di Gunung Olympus tentu sangat menyadari keberadaanku. Dari berbagai sisi, kini aku bisa membantumu secara terang-terangan, bahkan mereka sendiri mungkin menganugerahimu kekuatan lebih besar menggunakan cahayaku. Biarkan mereka percaya bahwa kekuatan itu murni milik mereka sendiri."
      Speaker = "Selene"
      Event = "SeleneGrantsOlympianDuos01"
    }
    {
      Id = "Selene_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perkara dengan sang Titan Chronos ini adalah salah satu cobaan terberat yang pernah dihadapi Para Saudari Perak, namun melalui semuanya, kau tetap berdiri teguh. Aku tahu masih banyak yang harus diselesaikan, tapi kau setidaknya pantas mendapatkan istirahat sejenak di fase bulan baru."
      Speaker = "Selene"
      Event = "SelenePostTrueEnding01"
    }
    {
      Id = "Selene_0367"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Asuhmu menceritakan lebih banyak kepadaku tentang tugasmu saat ini; memastikan waktu kita mengalir bebas ke depan mulai sekarang. Aku paham tugas baru ini mungkin tak berujung, jadi kuingatkan agar kau menjaga tempo langkahmu."
      Speaker = "Selene"
      Event = "SelenePostTrueEnding02"
    }
    {
      Id = "Selene_0481"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang sungguh membahagiakan ketika kau, Ibu Asuhmu, sang dewi perburuan, dan diriku berkuda bersama di atas kereta kudaku. Kini kita masing-masing telah kembali ke tempat semestinya, tapi Para Saudari Perak takkan pernah benar-benar terpisah."
      Speaker = "Selene"
      Event = "SelenePostTrueEnding03"
    }
    {
      Id = "Selene_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibu Asuhmu memberitahuku bahwa kau akhirnya menemukan Tiga Dewi Takdir...? Kalau begitu semuanya akhirnya kembali pada tempatnya, walau aku merasa seperti sebelumnya... mungkin mereka ingin melihat apa yang akan terjadi jika kita terus merajut jalan hidup kita masing-masing."
      Speaker = "Selene"
      Event = "SelenePostEpilogue01"
    }
    {
      Id = "Selene_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pada Ikrar Yang Tak Terlihat, ada satu Sumpah yang mengatasi segalanya. Menjadi tugasku sebagai Mata Malam untuk menjadi saksinya, jika kau memilih untuk mengucap Sumpah Para Rival ini. Singkap batas terjauhnya, dan taklukkan musuh-musuh terkuatmu."
      Speaker = "Selene"
      Event = "SeleneAboutAltFightQuest01"
    }
    {
      Id = "Selene_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau mengucap Sumpah Para Rival pada Ikrar Yang Tak Terlihat. Kalau begitu kau akan segera berhadapan dengan Ibu Asuhmu dalam segenap kemuliaan kegelapannya; betapa ia mendambakan kau meraih kekuatan untuk menghadapinya seperti itu."
      Speaker = "Selene"
      Event = "SeleneAboutAltFightQuest02"
    }
    {
      Id = "Selene_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah melampaui kedua rintangan awal yang dihadirkan oleh Sumpah Para Rival, dengan demikian kau meraih wawasan untuk memicu Rasa Takut yang lebih besar lagi menggunakan Sumpah ini. Aku akan terus mengawasi, karena kau sudah siap."
      Speaker = "Selene"
      Event = "SeleneAboutAltFightQuest03"
    }
    {
      Id = "Selene_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Penjaga kedua yang menghalangi jalanmu telah tunduk di hadapanmu meski Sumpah Para Rival menganugerahi mereka kekuatan dari Sang Malam sendiri. Namun berhati-hatilah: Pengaruh Sumpah ini akan semakin berat mulai dari sini."
      Speaker = "Selene"
      Event = "SeleneAboutAltFightQuest04"
    }
    {
      Id = "Selene_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah menaklukkan Cerberus sang anjing neraka serta Titan Wawasan Masa Depan beserta sekutunya, kendati Sumpah Para Rival mengisi mereka dengan kekuatan sebesar itu. Namun aku khawatir, kekuatan penuh dari Sumpah ini akan nyaris mustahil untuk ditaklukkan..."
      Speaker = "Selene"
      Event = "SeleneAboutAltFightQuest05"
    }
    {
      Id = "Selene_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak pernah kusangka aku akan menyaksikan apa yang kau capai menggunakan Ikrar Yang Tak Terlihat. Titan Chronos dan Typhon yang mengerikan, masing-masing telah ditundukkan, segenap rivalmu terlampaui. {#Emph}Kaulah {#Prev}teror di dalam Malam, bukan mereka."
      Speaker = "Selene"
      Event = "SeleneAboutAltFightQuest06"
    }
    {
      Id = "Selene_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ikrar Yang Tak Terlihat menuntutmu melampaui keterbatasanmu, namun jangan menyerah pada godaan untuk menebar Rasa Takut yang lebih besar daripada yang sanggup kau tanggung. Sumpah Para Rival bukan sekadar tentang kekuatan, melainkan ketabahan."
      Speaker = "Selene"
      Event = "SeleneAboutAltFightQuestL01"
    }
    {
      Id = "Selene_0479"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keyakinan kita pada satu sama lain tak membutuhkan kata-kata. Sebagaimana kita telah melewati banyak fase bersama, aku lebih memilih untuk tak banyak bicara saat kita bertemu, dan membiarkan heningnya malam merengkuh kita."
      Speaker = "Selene"
      Event = "SeleneAboutSayingLittle01"
    }
    {
      Id = "Selene_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga cahayaku menuntun langkahmu, dan membutakan musuh-musuhmu."
      Speaker = "Selene"
      Event = "SeleneChat01"
    }
    {
      Id = "Selene_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kini aku bersinar hanya untukmu, bintang kecilku."
      Speaker = "Selene"
      Event = "SeleneChat02"
    }
    {
      Id = "Selene_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersama-sama, bintang kecilku, kita akan selalu bersinar."
      Speaker = "Selene"
      Event = "SeleneChat03"
    }
    {
      Id = "Selene_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hingga Para Saudari Perak dapat meletakkan senjata mereka."
      Speaker = "Selene"
      Event = "SeleneChat04"
    }
    {
      Id = "Selene_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar panggilanmu dan kubawakan pendar cahayaku."
      Speaker = "Selene"
      Event = "SeleneChat05"
    }
    {
      Id = "Selene_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akulah Sang Mata Malam, dan aku akan mengawasimu."
      Speaker = "Selene"
      Event = "SeleneChat06"
    }
    {
      Id = "Selene_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah turun, dan cahayaku kembali menjadi milikmu."
      Speaker = "Selene"
      Event = "SeleneChat07"
    }
    {
      Id = "Selene_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahayaku berada di puncak kekuatannya, dan bebas kau gunakan sesukamu."
      Speaker = "Selene"
      Event = "SeleneChat08"
    }
    {
      Id = "Selene_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski cahayaku meredup saat ini, aku masih punya cukup untuk dibagikan."
      Speaker = "Selene"
      Event = "SeleneChat09"
    }
    {
      Id = "Selene_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuda-kudaku sangat gembira bisa beristirahat sejenak saat ini."
      Speaker = "Selene"
      Event = "SeleneChat10"
    }
    {
      Id = "Selene_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memiliki kekuatan tersembunyi yang luar biasa, begitu jelas bagiku..."
      Speaker = "Selene"
      Event = "SeleneChat11"
    }
    {
      Id = "Selene_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam begitu cerah, kuda-kudaku bugar; kekuatan kita, tak tertandingi."
      Speaker = "Selene"
      Event = "SeleneChat12"
    }
    {
      Id = "Selene_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam begitu gelap; kuda-kudaku butuh istirahat. Namun kuberikan sisa kekuatan yang masih kumiliki."
      Speaker = "Selene"
      Event = "SeleneChat13"
    }
    {
      Id = "Selene_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahayaku sedang menyusut saat ini, walau aku selalu menyisihkan sebagian untukmu."
      Speaker = "Selene"
      Event = "SeleneChat14"
    }
    {
      Id = "Selene_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagai sesama Saudari Perak, seluruh kekuatanku adalah milikmu."
      Speaker = "Selene"
      Event = "SeleneChat15"
    }
    {
      Id = "Selene_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terimalah pendar cahayaku sekarang, dan bersinarlah seterang diriku."
      Speaker = "Selene"
      Event = "SeleneChat16"
    }
    {
      Id = "Selene_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuda-kudaku bugar, kekuatanku berada di puncaknya. Dan sebentar lagi, begitu pula dengan kekuatanmu."
      Speaker = "Selene"
      Event = "SeleneChat17"
    }
    {
      Id = "Selene_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjuangan hanyalah sebuah fase; kita akan melaluinya bagaikan melintasi angkasa."
      Speaker = "Selene"
      Event = "SeleneChat18"
    }
    {
      Id = "Selene_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Langit malam yang baru menawarkan awal yang baru, bukan begitu?"
      Speaker = "Selene"
      Event = "SeleneChat19"
    }
    {
      Id = "Selene_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memanggilku, dan kini kecemerlanganku adalah milikmu."
      Speaker = "Selene"
      Event = "SeleneChat20"
    }
    {
      Id = "Selene_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gelapnya malam menyelimuti kita; mari kita pancarkan cahaya kita."
      Speaker = "Selene"
      Event = "SeleneChat21"
    }
    {
      Id = "Selene_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahaya perakku sekali lagi menjadi milikmu untuk kau gunakan sesukamu."
      Speaker = "Selene"
      Event = "SeleneChat22"
    }
    {
      Id = "Selene_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di balik kecemerlanganku, semoga segala niatmu tetap terselubungi."
      Speaker = "Selene"
      Event = "SeleneChat23"
    }
    {
      Id = "Selene_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekali lagi kita bertemu secara rahasia di larutnya malam."
      Speaker = "Selene"
      Event = "SeleneChat24"
    }
    {
      Id = "Selene_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, betapa perakmu berkilau indah saat bermandikan cahayaku."
      Speaker = "Selene"
      Event = "SeleneChat25"
    }
    {
      Id = "Selene_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siklus kita adalah siklus yang tak pernah usai, bukan begitu, Saudari?"
      Speaker = "Selene"
      Event = "SeleneChat26"
    }
    {
      Id = "Selene_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu senang setiap kali kau punya kesempatan untuk memanggilku."
      Speaker = "Selene"
      Event = "SeleneChat27"
    }
    {
      Id = "Selene_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh kita bersemayam dalam kegelapan, namun dia takkan bisa bersembunyi dari kita."
      Speaker = "Selene"
      Event = "SeleneChat28"
    }
    {
      Id = "Selene_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya kau lebih membutuhkan kekuatanku daripada diriku sendiri, bintang kecil."
      Speaker = "Selene"
      Event = "SeleneChat29"
    }
    {
      Id = "Selene_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku melihatmu, bintang kecil, dan aku selalu ada di sini kapan pun kau membutuhkanku."
      Speaker = "Selene"
      Event = "SeleneChat30"
    }
    {
      Id = "Selene_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak perlu kilau cahayaku untuk melihat bahwa Kepala Sekolahmu telah melatihmu dengan sangat baik."
      Speaker = "Selene"
      Event = "SeleneChat31"
    }
    {
      Id = "Selene_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesabaran dan pantang menyerah, Saudari. Nah, terimalah ini."
      Speaker = "Selene"
      Event = "SeleneChat32"
    }
    {
      Id = "Selene_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena rembulanku sedang purnama, aku hampir merasa sedikit iba pada musuh-musuh kita..."
      Speaker = "Selene"
      Event = "SeleneChat33"
    }
    {
      Id = "Selene_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita mulai fase kerja sama kita kali ini, bintang kecil."
      Speaker = "Selene"
      Event = "SeleneChat34"
    }
    {
      Id = "Selene_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam kian menggelap kembali, kendati kau kini menggenggam segenap cahaya yang bisa kuberikan."
      Speaker = "Selene"
      Event = "SeleneChat35"
    }
    {
      Id = "Selene_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan di Erebus yang paling pekat sekalipun, aku mendengar dan melihatmu, bintang kecil."
      Speaker = "Selene"
      Event = "SeleneChat36"
    }
    {
      Id = "Selene_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahaya seperti milikku sanggup menembus langsung dari permukaan, jauh ke tempatmu berada."
      Speaker = "Selene"
      Event = "SeleneChat37"
    }
    {
      Id = "Selene_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kota Ephyra menyambut kepulanganmu, semampu kota itu bertahan."
      Speaker = "Selene"
      Event = "SeleneChat38"
    }
    {
      Id = "Selene_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akan selalu menerangi perjalananmu menuju gunung para dewa."
      Speaker = "Selene"
      Event = "SeleneChat39"
    }
    {
      Id = "Selene_0478"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salam, sesama Saudari Perak, dan saksikanlah kembali cahaya penuntunku."
      Speaker = "Selene"
      Event = "SeleneChat40"
    }
    {
      Id = "Selene_0491"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua yang terjadi, senantiasa kami awasi."
      Speaker = "Selene"
      Event = "SeleneChat41"
    }
    {
      Id = "Selene_0492"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan terbesar kita justru hadir saat kita tetap tersamar."
      Speaker = "Selene"
      Event = "SeleneChat42"
    }
    {
      Id = "Selene_0493"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapan pun kau membutuhkanku, aku akan selalu ada."
      Speaker = "Selene"
      Event = "SeleneChat43"
    }
    {
      Id = "Selene_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita bersinar bersama, kini dan selamanya."
      Speaker = "Selene"
      Event = "SeleneChat44"
    }
    {
      Id = "Selene_0495"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menjadi andalan dan tetap teguh adalah tugasku."
      Speaker = "Selene"
      Event = "SeleneChat45"
    }
    {
      Id = "Selene_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Saudari Perak takkan pernah menyerahkan kendali."
      Speaker = "Selene"
      Event = "SeleneChat46"
    }
    {
      Id = "Selene_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita berjuang bersama demi kemenangan."
      Speaker = "Selene"
      Event = "SeleneChat47"
    }
    {
      Id = "Selene_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita bernapas, kita berdarah, kita beristirahat, lalu kita bangkit kembali."
      Speaker = "Selene"
      Event = "SeleneChat48"
    }
    {
      Id = "Selene_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahaya kita takkan pernah padam; bulan baru akan selalu terbit."
      Speaker = "Selene"
      Event = "SeleneChat49"
    }
    {
      Id = "Selene_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap malam selalu berbeda dari malam-malam lain yang pernah kukenal."
      Speaker = "Selene"
      Event = "SeleneChat50"
    }
    {
      Id = "Selene_0490"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keteguhan hati adalah kunci menuju kemenangan."
      Speaker = "Selene"
      Event = "SeleneChat51"
    }
    {
      Id = "Melinoe_0484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selene, kini kukirimkan Nektar para dewa untukmu, semoga ini menghangatkan perjalananmu melintasi angkasa!"
      Speaker = "Melinoe"
      Event = "SeleneGift01"
    }
    {
      Id = "Selene_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi, bintang kecil, kau mempersembahkan ini untukku? Ikatan yang kita bagi sebagai Saudari Perak sudah lebih dari cukup bagiku. Namun demikian, {#Emph}aku {#Prev}punya sesuatu untuk{#Emph}mu."
      Speaker = "Selene"
      Event = "SeleneGift01"
    }
    {
      Id = "Melinoe_0485"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untukmu, Selene! Aku tak pernah merasa tersesat karena tahu Sang Rembulan sendiri selalu ada membantuku menemukan jalan."
      Speaker = "Melinoe"
      Event = "SeleneGift02"
    }
    {
      Id = "Selene_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh berhati mulia telah menghormatiku seperti ini. Ini pasti akan menguatkan kuda-kudaku dan diriku di malam-malam yang panjang seperti ini. Terimalah rasa terima kasih kami."
      Speaker = "Selene"
      Event = "SeleneGift02"
    }
    {
      Id = "Melinoe_0486"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wahai Rembulan, sahabat setiaku di sepanjang malam-malam ini, kupersembahkan bingkisan sederhana ini untukmu!"
      Speaker = "Melinoe"
      Event = "SeleneGift03"
    }
    {
      Id = "Selene_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berterima kasih atas kemurahan hatimu. Walau ikatan persaudaraan yang kita jalin ini sudah lebih dari cukup, dan membuat malam-malam yang sunyi seakan berlalu begitu cepat."
      Speaker = "Selene"
      Event = "SeleneGift03"
    }
    {
      Id = "Melinoe_0487"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mata Malam yang Agung, yang senantiasa mengawasiku, semoga kecemerlanganmu selalu menyinari seisi dunia."
      Speaker = "Melinoe"
      Event = "SeleneGift04"
    }
    {
      Id = "Selene_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebiasaan saling memberi persembahan di antara para dewa... Aku mulai menyukai tradisi ini. Ternyata beberapa kebiasaan Olympus patut juga untuk ditiru."
      Speaker = "Selene"
      Event = "SeleneGift04"
    }
    {
      Id = "MelinoeField_3674"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua makhluk membutuhkanmu, Kakak, bukan cuma para dewa; mulai dari serigala penyendiri yang melolong di kegelapan malam, hingga pelaut yang mengarungi lautan yang hanya kaulah penerangnya. Engkau benar-benar sumber inspirasi."
      Speaker = "Melinoe"
      Event = "SeleneGift05"
    }
    {
      Id = "Selene_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang kupikir Olympus menganggap kesetiaanku sebagai hal biasa; sebab aku menerima banyak persembahan dari kaum fana, tapi bukan dari para dewa. Meski seharusnya itu tak berpengaruh bagiku, nyatanya tetap saja terasa, bintang kecilku. Terima kasih atas perhatianmu ini."
      Speaker = "Selene"
      Event = "SeleneGift05"
    }
    {
      Id = "MelinoeField_3675"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahaya perakmu tercurah bagi semua orang, tetapi aku jauh lebih beruntung karena mengenal dirimu seutuhnya, Kak Selene. Aku takkan pernah bisa menemukan kekuatanku jika bukan berkat kekuatanmu."
      Speaker = "Melinoe"
      Event = "SeleneGift06"
    }
    {
      Id = "Selene_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu ingin menjadi sosok yang bisa diandalkan, dan kau pasti merasakan hal yang sama. Meski dulu aku selalu menjagamu, keadaan memaksa kita tetap berjarak saat kau tumbuh dan berlatih, tapi sekarang? Kita, Para Saudari Perak, telah kian dekat; seakan-akan kita adalah satu."
      Speaker = "Selene"
      Event = "SeleneGift06"
    }
    {
      Id = "MelinoeField_3639"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kak Selene, Sang Mata Malam, engkau selalu menjagaku sejak aku masih sangat kecil. Namun lebih dari itu, engkau adalah rekan yang selalu bisa diandalkan dan sahabat sejati. Para dewa memberikan persembahan semacam ini kepada mereka yang mereka kasihi, jadi kupersembahkan ini untukmu."
      Speaker = "Melinoe"
      Event = "SeleneGift07"
    }
    {
      Id = "Selene_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di malam yang tak terhitung jumlahnya, kupandangi keluargamu di Olympus berpesta pora, berlimpahkan Ambrosia. Namun, itu bukan tempat untukku, begitu pula kita di Persimpangan Jalan yang tak berpesta seperti itu. Kendati demikian, pemberian darimu ini adalah hadiah yang sangat berharga."
      Speaker = "Selene"
      Event = "SeleneGift07"
    }
    {
      Id = "MelinoeField_3640"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di titik terendahku, saat aku merasa paling tak berdaya dan dipenuhi keraguan, engkau selalu percaya padaku, Kak. Perjalanan siklusmu melintasi langit adalah sumber ketenangan, kekuatan, dan inspirasi yang abadi, karena dirimulah wujud dari semua itu, bahkan lebih."
      Speaker = "Melinoe"
      Event = "SeleneGift08"
    }
    {
      Id = "Selene_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas persembahanmu dan juga kata-katamu. Aku pun tak pernah mengenal orang tua kandungku sewaktu kecil, tetapi Nyx dengan segala kemegahannya sudi merengkuhku. Kupikir, aku melihat diriku sendiri di dalam dirimu, dan kurasa kehadiran seorang kakak perempuan mungkin bisa membantumu..."
      Speaker = "Selene"
      Event = "SeleneGift08"
    }
    {
      Id = "MelinoeField_3641"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga engkau bersinar terang selamanya, Kak Selene, kakak perempuanku, yang melindungiku, membimbingku, dan mengajariku begitu banyak tentang kesabaran serta keanggunan. Persembahan ini takkan pernah cukup untuk mengungkapkan betapa berartinya kehadiranmu dalam hidupku."
      Speaker = "Melinoe"
      Event = "SeleneGift09"
    }
    {
      Id = "Selene_0364"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu memuji setinggi langit begitu, meski aku tetap bersyukur mendengarnya, bintang kecilku. Mengenai Ambrosia ini, akan kusimpan hingga tiba saatnya kita, Para Saudari Perak, bisa menikmatinya bersama. Sama halnya dengan ikatan di antara kita, kualitasnya hanya akan semakin matang seiring berjalannya waktu."
      Speaker = "Selene"
      Event = "SeleneGift09"
    }
    {
