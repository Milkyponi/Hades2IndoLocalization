    }
    {
      Id = "Chronos_1397"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di depan sana!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosLaunchVoiceLines"
    }
    {
      Id = "Chronos_1398"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Majulah, Penjaga Waktuku!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosLaunchVoiceLines"
    }
    {
      Id = "Chronos_1396"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waspadalah terhadap {#Emph}diriku {#Prev}di atas sana!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosLaunchVoiceLines"
    }
    {
      Id = "Chronos_1336"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktunya pergi."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosLaunchVoiceLines"
    }
    {
      Id = "Chronos_1337"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah! Waktunya berangkat."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosLaunchVoiceLines"
    }
    {
      Id = "Chronos_1038"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo! Selamat tinggal!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosLaunchVoiceLines"
    }
    {
      Id = "Chronos_1039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo dan selamat tinggal!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosLaunchVoiceLines"
    }
    {
      Id = "Chronos_1042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu dia!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosLaunchVoiceLines"
    }
    {
      Id = "Chronos_1044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa sebentar lagi!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosLaunchVoiceLines"
    }
