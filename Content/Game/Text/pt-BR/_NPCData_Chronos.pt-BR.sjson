    }
    {
      Id = "Nyx_0156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hmm..."
      Speaker = "Nyx"
      Event = "GlobalVoiceLines.NyxMiscReactionLines"
    }
    {
      Id = "Intercom_0884"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasa Takut yang menyelimuti udara itu... tiada lain berasal dari dirimu sendiri."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0885"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau yang memanggil Sang Malam: Tanggunglah akibatnya."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0886"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasa Takut itu makin menjalar dalam dirimu, bukan?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0887"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau membaktikan dirimu demi perjuangan yang telah terlupakan."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0083"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lemah! Kau takkan pernah bisa menyamai kehebatannya."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gurumu saja tak mampu menumbangkanku; apalagi kau?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0890"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluar dari hutan itu saja kau tak becus?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0891"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu banyak jiwa tersesat di Erebus! Kau hanyalah salah satunya."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0088"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terbuai oleh nyanyian para Siren, ya?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama seperti para pelaut yang bersemayam di dasar samudra..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0713"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga kidung para Siren terus menyiksamu bahkan jauh di luar jangkauan mereka."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0714"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenggelam lagi oleh bisingnya nyanyian para Siren!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0715"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rupanya anjing kampung celaka itu masih ada gunanya juga!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0716"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Monster berkepala tiga itu tak menganggapmu keluarga, begitu pula orang lain."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0717"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya orang bodoh tak berotak yang sudi menjinakkan monster mengerikan seperti itu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0718"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Anjing tua keluargamu yang malang itu cuma ingin dibiarkan tenang."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0719"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan sekali-kali ikut campur antara sang gembala dan kawanannya."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0720"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan Cyclops yang buta pun bisa membaca siasat menyedihkanmu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0721"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau hanyalah secuil camilan bagi Cyclops yang kelaparan, gadis cilik."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0722"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cuma domba sesat lain yang nekat keluar dari barisan."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0723"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana pun kau berlayar, Perselisihan akan selalu membayangi langkahmu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0724"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua ini bisa lekas beres, tapi kau malah memancing Perselisihan."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0725"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin {#Emph}kaulah {#Prev}biang dari segala perselisihan ini, bukan Eris sang Perselisihan itu sendiri?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0726"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sengatan Rail of Adamant neraka itu sungguh {#Emph}menyakitkan{#Prev}, bukan?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0727"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pembalasan dendam seorang Titan adalah api abadi yang takkan pernah padam."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0728"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buat apa bersusah payah kalau Prometheus sendiri sudah meramalkan kegagalanmu?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0729"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Titan Tahu Diri telah memilih pihak pemenang; yaitu pihakku."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0730"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rupanya kau membuat Prometheus kami yang malang sangat kesal lagi."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0888"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Runtuhnya Gunung Olympus tak terelakkan lagi, seperti yang bisa kaulihat sendiri."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0889"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para dewa itu sudah tak lagi secongkak dulu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dunia atas bukan tempat untukmu, gadis kecil."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Andaikata kau berhasil mencapai Olympus, lalu apa?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Zaman para dewa sudah di ambang akhir."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian para dewa terlalu tak becus untuk menguasai dunia ini. Sekali pandang saja sudah terbukti jelas."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0065"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau merenggut segalanya dariku, Hades. Sudah sepantasnya aku membalas perbuatanmu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang terjadi pada putrimu, Hades, {#Emph}hm? {#Prev}Aku hanya akan bertanya baik-baik sekali ini saja."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau dan anak-anakku memang pernah menghentikanku dulu, Hades. Tapi kali ini, aku punya cukup waktu untuk bersiap."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bicara soal keadilan, Hades? Berapa banyak jiwa fana yang telah kausiksa dengan kejam, dan sudah berapa lama?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah kau akan selamanya tersesat di Erebus?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bisa meramalkan setiap upaya sia-siamu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu gigih bertarung, namun masih begitu jauh dari tujuanmu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada secuil pun yang kutakuti dari penyihir sepertimu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0021"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tawa>"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0022"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tawa>"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0036"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau takkan bisa menghentikan Sang Waktu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0037"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menyerah sajalah, bocah."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0038"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampaknya otakmu agak lamban mencerna pelajaran."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu lagi percobaan yang gagal total."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0040"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa kau mulai terbiasa dengan hasil semacam ini?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau meronta tiada henti, tapi untuk apa?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku hampir merasa iba melihat usahamu yang terbuang sia-sia."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0043"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua upayamu, sekali lagi berujung percuma."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0044"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mulai menguji kesabaranku, bocah."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0045"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan pernah bermain-main dengan seorang Titan, bocah."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0046"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harusnya kurantai saja kau di Tartarus."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudahi saja semua percobaan tak berguna ini."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0048"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kegagalanmu sudah digariskan."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semangatmu boleh juga, tapi kau tidak kebal."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0050"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Takdir takkan berbaik hati padamu di kesempatan berikutnya."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya segitu batas kekuatanmu, hm?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_0052"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukira kau bisa berbuat lebih baik dari itu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosDeathTauntVoiceLines"
    }
    {
      Id = "Intercom_1282"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, apa yang terjadi... bagaimana mungkin {#Emph}ini terjadi?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_1283"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau, yang terus membayangiku bagai mimpi buruk... {#Emph}enyahlah!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pikir mau pergi ke mana?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kegigihanmu yang membabi buta itu sungguh tak ada gunanya."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau melangkah masuk ke wilayah kekuasaan-{#Emph}Ku."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu apa yang sedang kau coba capai."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kesabaranku menghadapimu makin menipis."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau ingin melihat wilayah kekuasaan ayahmu, bukan?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Segala usahamu tidak luput dari perhatianku, Cucuku."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin sebaiknya kau kembali di {#Emph}waktu {#Prev}yang lain."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tempat ini tak pernah menjadi milik ayahmu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bicara padaku soal mimpi buruk; inilah dia."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyLocatedVoiceLines[3]"
    }
    {
      Id = "Intercom_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau ingin berkeliaran di alam ini, kalau begitu terimalah! Nikmatilah sepuasnya."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "Intercom_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saksikanlah kemegahan Dunia Bawah milik ayahmu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "Intercom_0112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dunia Bawah yang tak pernah kau kenal! Tapi, kau tak melewatkan banyak hal..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "Intercom_0113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekilas gambaran masa lalu, atau salah satu mimpi burukmu?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "Intercom_0117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makhluk-makhluk malang milik ayahmu di Asphodel sangat membenci penyusup."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "Intercom_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang di padang rumput hijau Asphodel."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "Intercom_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nikmatilah sengatan panas Asphodel yang tak tertahankan ini."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "Intercom_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Inilah alam kekuasaan ayahmu sebagaimana adanya di masa lalu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "MelinoeField_0248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kakek tua itu... itu {#Emph}dia..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "MelinoeField_0190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di mana aku... atau di waktu {#Emph}kapan..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "MelinoeField_0191"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini tidak nyata..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "MelinoeField_0192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terjebak..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "MelinoeField_0193"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hal ini lagi..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "MelinoeField_0194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia mencoba memperlambat langkahku..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "MelinoeField_0195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah ini benar-benar Asphodel...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyEnteredVoiceLines"
    }
    {
      Id = "Intercom_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sihir macam apa ini...?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyCombatBeginsVoiceLines"
    }
    {
      Id = "Intercom_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi, kau bisa melihat jalan keluar..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyCombatBeginsVoiceLines"
    }
    {
      Id = "Intercom_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Padahal kau baru saja tiba..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyCombatBeginsVoiceLines"
    }
    {
      Id = "Intercom_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Haruskah kau pergi secepat ini?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyCombatBeginsVoiceLines"
    }
    {
      Id = "Intercom_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mengapa kau begitu ingin terbangun dari mimpi yang seindah ini?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyCombatBeginsVoiceLines"
    }
    {
      Id = "Intercom_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa yang mengajarimu muslihat semacam itu?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyCombatBeginsVoiceLines"
    }
    {
      Id = "Intercom_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mengerti sedikit tentang Waktu dan Mimpi, rupanya?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalyCombatBeginsVoiceLines"
    }
    {
      Id = "Intercom_0150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tahu cara melawan mantra kecilku..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "Intercom_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lantas kenapa kalau kau tahan menghadapi semua itu..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "Intercom_0121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benarkah ini hal yang sesungguhnya kau perjuangkan?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "Intercom_0122"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bertahan hidup, tapi kau tak belajar apa-apa."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "Intercom_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masa itu, tentu saja, sudah sangat berbeda."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "Intercom_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Zaman bisa berubah, namun sering kali tetap sama."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "Intercom_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau ingin mimpi burukmu jadi kenyataan?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "Intercom_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lanjutkanlah jika kau berani menanggung akibatnya, Cucu Perempuan."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "Intercom_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpi buruk semacam itu pada akhirnya akan melahapmu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "Intercom_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hentikan ini selagi kau masih punya kesempatan."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "Intercom_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan sekarang pun kau masih nekat berlari menuju kebinasaan."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.AnomalySurvivedVoiceLines"
    }
    {
      Id = "MelinoeField_0216"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berhasil kembali..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyConcludedVoiceLines"
    }
    {
      Id = "MelinoeField_0217"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasanya seperti baru bangun dari mimpi..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyConcludedVoiceLines"
    }
    {
      Id = "MelinoeField_0218"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Butuh lebih dari ini untuk menjatuhkanku, Chronos..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyConcludedVoiceLines"
    }
    {
      Id = "MelinoeField_0219"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya sekadar ilusi..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyConcludedVoiceLines"
    }
    {
      Id = "MelinoeField_0220"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali ke kenyataan..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyConcludedVoiceLines"
    }
    {
      Id = "MelinoeField_1410"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya ilusi semata...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.AnomalyConcludedVoiceLines"
    }
    {
      Id = "Chronos_1418"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah-hah!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosHideAndSeekVoiceLines"
    }
    {
      Id = "MelinoeField_5055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ChronosHideAndSeekVoiceLines"
    }
    {
      Id = "Intercom_8294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah{#Prev}, dari {#Emph}dulu {#Prev}aku kepingin bicara ke {#Emph}semua orang {#Prev}di Tartarus lewat corong begini!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "MelinoeField_5558"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Emm{#Prev}, bagus kalau begitu, Yang Mulia Hypnos!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8295"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang di Tartarus! Sampai ketemu lagi kalau kau mati, ya!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih sudah mampir ke dasar Dunia Bawah!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8300"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tartarus yang kuingat sama sekali {#Emph}tidak begini{#Prev} bentuknya!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau orang-orang itu menembakimu, tinggal minggir saja!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mau lihat kau membabat habis orang-orang {#Emph}ini{#Prev}, lalu siapa pun yang muncul berikutnya!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8303"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wah gawat{#Prev}, mereka tahu kau ada di sini! Dan, {#Emph}aku juga tahu!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8304"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biasanya ayahmu bakal mengucapkan sesuatu yang seram di sini!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayahmu biasanya bakal bilang semacam, {#Emph}habisi semua yang bernyawa di sekitar sini!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang kembali di Tartarus! Maaf ya kalau berantakan!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, kau berhasil sampai ke Tartarus! Tartarus {#Emph}alam mimpi!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayang sekali kau tidak bisa minta tolong Charon untuk memberi tumpangan!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, aku {#Emph}tahu betul {#Prev}ini bakal jadi {#Emph}seru!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8296"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sampai di sini lumayan cepat malam ini, ya?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8298"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kakakmu dulu mulai dari Tartarus sini, dan begitu juga dengan {#Emph}dirimu {#Prev}malam ini!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_8299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ayo{#Prev}, ini {#Emph}dia! {#Prev}Kau sudah hampir sampai di ujung!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7352"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa yang mengutak-atik Tartarus?! Oh, ternyata kau, Putriku...!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7353"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para Satir tak tahu sopan santun dan gerombolannya itu akan merasakan akibatnya sekarang."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7354"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semuanya berjalan sesuai rencana."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7355"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para Satir dan kawanannya masih setia mengabdi pada sang Titan."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7356"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Putriku, kau kuizinkan sepenuhnya untuk memorak-porandakan tempat ini."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7357"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Segala yang ada di sekitar sini harus disingkirkan!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7358"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dekorasi pengatur waktu sialan ini tak pernah bisa hancur selamanya!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7359"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami menyambutmu di kedalaman terdalam, Putriku."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7360"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Izin diberikan kepada sang Putri Dunia Bawah."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7361"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lakukan apa pun demi memastikan waktu mengalir bebas mulai dari sekarang..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7362"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para bajingan ini takkan menyambutmu, Putriku, tapi aku menyambutmu."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7363"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan pertama kalinya pertumpahan darah pecah di Tartarus..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7364"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kakakmu dulu terbiasa menghancurkan tempat ini sepuasnya, jadi kenapa kau tidak?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7365"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan bicara empat mata dengan Ayah soal luasnya serbuan ini."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kontribusimu dalam aksi bersih-bersih ini sangat kami hargai, Putriku."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7367"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah cukup lama kami tak melihatmu di sini, Putriku."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari mana saja kau, Melinoë? Yang jelas bukan di Dunia Bawah."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi mereka ini juga sisa-sisa pasukan sang Titan, ya?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan ampuni satu bajingan pun yang berani menghadangmu, Putriku."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_7371"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maju dengan hati-hati, atau dengan cara apa pun yang paling efisien."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "MelinoeField_4583"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kakek yang mengatur semua ini...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0473"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau menyusup ke wilayah pribadi..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati dalam melangkah, gadis manis..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menarik sekali melihatmu bisa bertahan..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0475"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Penyusup telah menembus pertahanan kita...!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0476"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampaknya ada sedikit hama yang masuk ke sini..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0477"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya kita kedatangan tamu tak diundang..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0478"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para pemujaku akan melemahkanmu, kalau tidak langsung menghabisimu di tempat!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin kami tak bisa menemukanmu di Padang Ratapan, tapi di {#Emph}sini?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, Cucuku! Baik sekali kau sudi berkunjung lagi kemari!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0484"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami menyambutmu dengan hangat di kedalaman Tartarus."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0485"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hal apa lagi yang membawamu ke depan pintuku kali ini, gadis manis?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0487"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sangat mudah ditebak, persis seperti putaran roda gerigi di seluruh tempat ini..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa mungkin ada barangmu yang tertinggal saat terakhir kali kau ikut campur?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0490"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Orang berakal sehat pasti akan {#Emph}kabur {#Prev}dari Tartarus, bukannya malah {#Emph}menerobos {#Prev}masuk!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0491"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tempat ini dulunya adalah makamku; akankah kini menjadi makammu?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia telah kembali. Kumpulkan pertahanan kita!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0492"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan menantikan kedatanganmu, Cucuku."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenapa semua orang di keluarga kita harus begitu menjengkelkan?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sialan, kau memang sulit sekali disudutkan..."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampaikan salamku pada Hades jika kau kebetulan bertemu dengannya!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita sudah agak lama tidak melihatmu, gadis kecilku."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "Intercom_0489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia menuju ke Kediaman lagi. Hentikan dia!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "MelinoeField_5557"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Chronos masih berkuasa... jadi ini mimpi {#Emph}buruk{#Prev}."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "MelinoeField_1538"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada lagi sembunyi di balik bayang-bayang...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "MelinoeField_1539"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Coba saja hentikan aku...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "MelinoeField_1540"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Minggir dari jalanku!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "MelinoeField_1541"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Urusanku denganmu belum selesai!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "MelinoeField_1542"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa sebentar lagi, Titan!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
    {
      Id = "MelinoeField_1543"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia bersembunyi di balik cecunguk-cecunguk ini!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.ChronosAlertVoiceLines"
    }
  ]
}
