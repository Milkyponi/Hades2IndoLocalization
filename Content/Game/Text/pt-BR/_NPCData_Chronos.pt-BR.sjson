{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Chronos.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Chronos_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu siapa dirimu. Aku tahu ke mana tujuanmu. Kau takkan pernah sampai ke sana."
      Speaker = "Chronos"
      Event = "ChronosAnomalyIntro01"
    }
    {
      Id = "MelinoeField_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sihir ini... Chronos! Akan kucabik-cabik tubuhmu demi pembalasan ini. Demi segalanya!"
      Speaker = "Melinoe"
      Event = "ChronosAnomalyIntro01"
    }
    {
      Id = "Chronos_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menakutkan sekali. Sayangnya, kita takkan pernah tahu apakah ancamanmu itu cuma gertakan kosong, karena kau akan kukirimi {#Emph}skorsing sejenak{#Prev}. Setidaknya sampai beberapa urusan lain terselesaikan..."
      Speaker = "Chronos"
      Event = "ChronosAnomalyIntro01"
    }
    {
      Id = "MelinoeField_1682"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak!"
      Speaker = "Melinoe"
      Event = "ChronosAnomalyIntro01"
    }
    {
      Id = "Chronos_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya aku harus memintamu menghentikan semua ini sekarang juga..."
      Speaker = "Chronos"
      Event = "ChronosAnomalyIntro01_B"
    }
    {
      Id = "Chronos_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan, siapa gerangan dirimu, gadis kecil? Dan apa yang mendorongmu keluyuran keluar-masuk Erebus?"
      Speaker = "Chronos"
      Event = "ChronosFirstMeeting"
    }
    {
      Id = "Melinoe_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bukan {#Emph}gadis kecilmu{#Prev}, orang tua renta. Nama dan urusanku bukan urusanmu."
      Speaker = "Melinoe"
      Event = "ChronosFirstMeeting"
    }
    {
      Id = "Chronos_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya begitu. Sepertinya kau sangat dikejar waktu. Maafkan kelancangan {#Emph}orang tua renta {#Prev}ini..."
      Speaker = "Chronos"
      Event = "ChronosFirstMeeting"
    }
    {
      Id = "Chronos_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau kembali lagi. Atau mungkin tersesat, di lorong-lorong tak berujung di seberang sana."
      Speaker = "Chronos"
      Event = "ChronosMeeting02"
    }
    {
      Id = "MelinoeField_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu ke mana tujuanku. Siapa kau sebenarnya? Dan apa yang kau sendiri lakukan di tempat semacam ini?"
      Speaker = "Melinoe"
      Event = "ChronosMeeting02"
    }
    {
      Id = "Chronos_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nama dan urusanku bukan urusanmu{#Prev}, bukankah begitu perkataanmu tadi? {#Emph}Aah{#Prev}, betapa lancangnya anak muda zaman sekarang..."
      Speaker = "Chronos"
      Event = "ChronosMeeting02"
    }
    {
      Id = "MelinoeField_0245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu..."
      Speaker = "Melinoe"
      Event = "ChronosMeeting02"
    }
    {
      Id = "Chronos_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tampaknya sangat hafal jalan. Akulah penguasa alam ini, namun {#Emph}aku {#Prev}sendiri takkan pernah sudi menginjakkan kaki ke hutan di seberang sana. Kau bahkan menemukan jalan kembali dari {#Emph}pengalihan rute{#Prev} di Asphodel..."
      Speaker = "Chronos"
      Event = "ChronosReveal01"
    }
    {
      Id = "Melinoe_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keparat kau, Chronos...!"
      Speaker = "Melinoe"
      Event = "ChronosReveal01"
    }
    {
      Id = "Chronos_0020"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Tiga Takdir pun takkan bisa menolongmu sekarang..."
      Speaker = "Chronos"
      Event = "ChronosReveal01"
    }
    {
      Id = "Chronos_0591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, mari kita tunggu..."
      Speaker = "Chronos"
      Event = "ChronosReveal01"
    }
    {
      Id = "Chronos_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau, gadis kecil, sedang mencampuri urusan yang tak kau pahami. Ayahmu telah membuat pilihan tertentu; dia terbelenggu karenanya, tapi kau tidak. Kau tak perlu mengikuti jalan kehancurannya."
      Speaker = "Chronos"
      Event = "ChronosMeeting03"
    }
    {
      Id = "Melinoe_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kehancuran?! Kau yang {#Prev}membawa kehancuran bagi Dunia Bawah dan permukaan! Aku takkan pernah menerima perbuatanmu. Sekarang, cukup basa-basinya!"
      Speaker = "Melinoe"
      Event = "ChronosMeeting03"
    }
    {
      Id = "Chronos_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa {#Emph}sangat {#Prev}bersemangat! Kau sungguh mengira bisa menghentikan Sang Waktu. Baiklah kalau begitu... aku ingin melihatmu mencobanya."
      Speaker = "Chronos"
      Event = "ChronosMeeting03"
    }
    {
      Id = "Melinoe_0164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, lihat ini!"
      Speaker = "Melinoe"
      Event = "ChronosMeeting03"
    }
    {
      Id = "Intercom_0023"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tawa>"
      Speaker = "Intercom"
      Event = "ChronosMeeting03"
    }
    {
      Id = "Chronos_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari balik batu mana kau merangkak keluar, {#Emph}hm? {#Prev}Pasukanku sangat kebingungan! Mereka sama sekali tak tahu di mana kau bersembunyi! Jadi kupikir aku akan {#Emph}mencoba {#Prev}bertanya baik-baik di sini."
      Speaker = "Chronos"
      Event = "ChronosMeeting04"
    }
    {
      Id = "Melinoe_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hidup dalam mimpi burukmu, Titan. Aku bertambah kuat karenanya! Akan kupastikan kau mati, lalu musnah selamanya. Tak peduli berapa lama pun waktu yang dibutuhkan."
      Speaker = "Melinoe"
      Event = "ChronosMeeting04"
    }
    {
      Id = "Chronos_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Berapa lama pun waktu yang dibutuhkan? {#Prev}Kau bicara soal kepastian yang tak terelakkan, bocah cilik. Hal yang kebetulan akulah ahlinya. Dan mengenai siapa pun yang mengirimmu memburuku... Aku pasti akan menemukan mereka."
      Speaker = "Chronos"
      Event = "ChronosMeeting04"
    }
    {
      Id = "Melinoe_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa kita lihat nanti!"
      Speaker = "Melinoe"
      Event = "ChronosMeeting04"
    }
    {
      Id = "Chronos_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau masih bersikeras, terlepas dari niat baikku untuk membujukmu berhenti. Baiklah kalau begitu! Lanjutkanlah peranmu sebagai pengalih perhatian belaka, selagi aku memusatkan perhatian pada perkara yang jauh lebih penting..."
      Speaker = "Chronos"
      Event = "ChronosMeeting05"
    }
    {
      Id = "Chronos_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir aku telah berhasil menyurutkan niatmu, sampai kudengar kabar bahwa kau malah menyusup ke tempat lain. Beraninya kau mendaki ke atas permukaan?"
      Speaker = "Chronos"
      Event = "ChronosPostSurfaceMeeting01"
    }
    {
      Id = "MelinoeField_0494"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah melihat langsung perbuatanmu di atas sana. Membuka segel gerbang neraka itu sendiri! Dan membawa petaka bagi kaum fana yang tak ada sangkut pautnya dengan dendam picikmu."
      Speaker = "Melinoe"
      Event = "ChronosPostSurfaceMeeting01"
    }
    {
      Id = "Chronos_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu kota Ephyra yang compang-camping itu, yang dahulu berdiri sebagai upeti penjilat bagi ayahmu yang congkak. Barangkali kaum fana yang tersisa di sana kelak akan berpikir dua kali sebelum menaruh iman mereka pada para {#Emph}dewa."
      Speaker = "Chronos"
      Event = "ChronosPostSurfaceMeeting01"
    }
    {
      Id = "MelinoeField_0495"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pengecut..."
      Speaker = "Melinoe"
      Event = "ChronosPostSurfaceMeeting01"
    }
    {
      Id = "Chronos_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak bisa menolong dewa-dewa di atas sana, asal kau tahu. Pasukanku amat luas, dan kematian tak lagi berarti apa-apa bagi mereka. Lagipula usahamu di sini juga takkan berdampak banyak."
      Speaker = "Chronos"
      Event = "ChronosPostSurfaceMeeting02"
    }
    {
      Id = "MelinoeField_0496"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasukan permukaanmu bertarung dan mati demi dirimu, sementara kau bersembunyi di balik mereka di sini. Jika kau begitu yakin akan kemenanganmu, kau seharusnya memimpin mereka langsung."
      Speaker = "Melinoe"
      Event = "ChronosPostSurfaceMeeting02"
    }
    {
      Id = "Chronos_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepemimpinan, gadis kecil, bukan berarti harus melakukan segalanya seorang diri. Melainkan memastikan orang lain memeluk cita-cita dan cara kerja yang sama denganmu. Ke mana pun kau melangkah, kupikir kau akan menjumpai banyak pihak yang memeluk sudut pandangku."
      Speaker = "Chronos"
      Event = "ChronosPostSurfaceMeeting02"
    }
    {
      Id = "MelinoeField_0497"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selalu saja ada orang bodoh..."
      Speaker = "Melinoe"
      Event = "ChronosPostSurfaceMeeting02"
    }
    {
      Id = "Chronos_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum ada kemenangan di permukaan sejauh ini? Tampaknya kau memiliki {#Emph}dua {#Prev}tujuan yang sia-sia, bukan hanya satu."
      Speaker = "Chronos"
      Event = "ChronosPostSurfaceMeeting03"
    }
    {
      Id = "MelinoeField_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tujuanku cuma satu, dan ini sama sekali bukan soal harapan. Mungkin sekarang aku belum bisa menghentikanmu, tapi kau juga tak bisa menghentikanku. Kau sudah mencobanya, kan."
      Speaker = "Melinoe"
      Event = "ChronosPostSurfaceMeeting03"
    }
    {
      Id = "Chronos_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}memang {#Prev}jauh lebih gigih daripada {#Emph}sebagian {#Prev}anggota keluargamu yang lain, kuakui itu. Kalau begitu, kita lihat saja ke mana perburuan gilamu ke permukaan, atau ke kedalaman ini, akan membawamu!"
      Speaker = "Chronos"
      Event = "ChronosPostSurfaceMeeting03"
    }
    {
      Id = "MelinoeField_0499"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita berdua akan menyaksikannya."
      Speaker = "Melinoe"
      Event = "ChronosPostSurfaceMeeting03"
    }
    {
      Id = "Chronos_0611"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya kau kembali ke tempat yang lebih familier, Gadis Kecil. Baik para dewa maupun Takdir sama-sama tak sudi melihatmu berkeliaran di permukaan dunia fana! Tapi kau tetap bersikeras bertarung di sana demi mereka."
      Speaker = "Chronos"
      Event = "ChronosPostSurfaceMeeting04"
    }
    {
      Id = "MelinoeField_2022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kedatanganku bakal lebih disambut di rumah ayahku malam nanti? Seperti yang kau lihat, aku juga tak keberatan bertarung di sana."
      Speaker = "Melinoe"
      Event = "ChronosPostSurfaceMeeting04"
    }
    {
      Id = "Chronos_0612"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, tapi perjalananmu masih amat jauh! Terpaksa menempuh jalan kaki bagai manusia fana yang menyedihkan. Pastikan kau sisakan tenagamu untuk {#Emph}jarak pamungkas {#Prev}nanti."
      Speaker = "Chronos"
      Event = "ChronosPostSurfaceMeeting04"
    }
    {
      Id = "MelinoeField_2023"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ugh..."
      Speaker = "Melinoe"
      Event = "ChronosPostSurfaceMeeting04"
    }
    {
      Id = "Chronos_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga bakal menjumpaimu di sini, Nak. Api kemarahan membara di matamu! Keras kepala sekali memang keluarga kita ini. Belum kapok juga kau rupanya dari perjumpaan kita sebelumnya?"
      Speaker = "Chronos"
      Event = "ChronosPostBattleMeeting01"
    }
    {
      Id = "MelinoeField_1400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku belajar banyak sekali, dan aku bernafsu memetik lebih banyak lagi. Jadi mending minggir dari jalanku, karena yang bisa kau perbuat di dalam hutan ini cuma membuang-buang waktuku saja, kan?"
      Speaker = "Melinoe"
      Event = "ChronosPostBattleMeeting01"
    }
    {
      Id = "Chronos_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kehilangan akal sehat, dan kelewat percaya diri. Baiklah kalau begitu! Temui aku kalau memang berani, dan petiklah pelajaran baru. Kau tahu di mana aku bersemayam. Aku tak pernah bersembunyi dari para {#Emph}dewa!"
      Speaker = "Chronos"
      Event = "ChronosPostBattleMeeting01"
    }
    {
      Id = "MelinoeField_1401"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa nanti..."
      Speaker = "Melinoe"
      Event = "ChronosPostBattleMeeting01"
    }
    {
      Id = "Chronos_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gadis cilik, jangan kira gerak-gerikmu luput dari pandanganku! Aku bisa melihatmu dengan sangat jelas di sana. Pelanggaran batas ini pasti akan kau bayar mahal, meski sayangnya, bukan lewat tanganku saat ini. Belum saatnya."
      Speaker = "Chronos"
      Event = "ChronosPostBattleMeeting02"
    }
    {
      Id = "Chronos_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akulah Sang Waktu. Sedangkan kau apa? Cuma budak dari mereka yang menamai dirinya dewa, patuh membabi buta menuruti kehendak mereka. Anak-anakku memang licik... bagi mereka, kau tak lebih dari sekadar perkakas biasa! Dan kelihatannya, perkakas yang tidak terlalu tajam pula."
      Speaker = "Chronos"
      Event = "ChronosPostBattleMeeting03"
    }
    {
      Id = "Chronos_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika ada satu hal yang kusepakati bersama para Takdir terkutuk itu, hal itu adalah: segala sesuatu pada akhirnya pasti akan membusuk. Segalanya bermula dari kehampaan, dan kita semua akan kembali lebur ke dalam Khaos itu. Kau cuma sekadar mempercepat prosesnya."
      Speaker = "Chronos"
      Event = "ChronosPostBattleMeeting04"
    }
    {
      Id = "Chronos_0613"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat siapa yang datang, pembunuh bayangan kita dalam aksi malamnya untuk mencoba melukaiku! Walaupun mungkin kali ini nasib baik takkan berpihak padamu."
      Speaker = "Chronos"
      Event = "ChronosPostWinStreakMeeting01"
    }
    {
      Id = "MelinoeField_2024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebentar lagi juga kita ketahui, bukan? Kuberjanji takkan membuatmu menunggu lama. Seperti yang kaulihat, aku sudah melangkah jauh di jalanku."
      Speaker = "Melinoe"
      Event = "ChronosPostWinStreakMeeting01"
    }
    {
      Id = "Chronos_0614"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu saja {#Emph}bisa {#Prev}kulihat. Kalau begitu, sebaiknya aku lekas pulang dan bersiap-siap! Bagaimanapun juga, kami harus berbenah menyambut kedatanganmu. Sampai jumpa nanti malam."
      Speaker = "Chronos"
      Event = "ChronosPostWinStreakMeeting01"
    }
    {
      Id = "MelinoeField_2025"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sampai nanti."
      Speaker = "Melinoe"
      Event = "ChronosPostWinStreakMeeting01"
    }
    {
      Id = "Chronos_0615"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putraku tersayang, Zeus, sudah menyokongmu malam ini? Sedikit pun aku tak gentar pada kilat kebanggaannya itu, bocah tolol."
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutZeus01"
    }
    {
      Id = "Chronos_0616"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, jadi Poseidon memberimu restunya, ya? Memangnya apa yang mau kau lakukan... mengguyurku dengan air?"
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutPoseidon01"
    }
    {
      Id = "Chronos_0619"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi perapian memberimu restu sekarang? Ketahuilah, tak ada api yang tak bisa dipadamkan oleh {#Emph}Sang Waktu {#Prev}pada saatnya."
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutHestia01"
    }
    {
      Id = "Chronos_0617"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi beku Demeter yang memacumu malam ini? Sayang sekali, tak ada {#Emph}musim {#Prev}di Dunia Bawah."
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutDemeter01"
    }
    {
      Id = "Chronos_0618"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Ratu Para Dewa yang mengaku-ngaku sendiri itu, menganugerahimu Berkahnya? Bukankah sebaiknya dia mengurusi pesta pernikahan kaum fana saja?"
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutHera01"
    }
    {
      Id = "Chronos_0620"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berusahalah semaumu, Gadis Kecil; tapi akhir dari malam ini takkan ada bedanya dengan malam-malam sebelumnya."
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutOlympians01"
    }
    {
      Id = "Chronos_0911"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah Prometheus yang cerdik terlalu tangguh bagimu, sampai-sampai kau mengira bakal bernasib lebih baik saat melawan{#Emph}ku?"
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutPrometheus01"
    }
    {
      Id = "Chronos_0912"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sementara kau masih meronta-ronta melawanku di sini, Prometheus yang lihai telah menyibukkan kerabat-kerabatmu seutuhnya..."
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutPrometheus02"
    }
    {
      Id = "Chronos_0908"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau sudah melihat apa yang bakal menimpa Gunung Olympus, lalu menyerah dari jalan nekat itu... sebentar lagi, jalan yang ini pun akan kutinggalkan."
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutTyphon01"
    }
    {
      Id = "Chronos_0909"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak tahu bagaimana caramu menundukkan Sang Ayah dari Segala Monster, tapi tindakanmu itu cuma membuatnya makin murka."
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutTyphonW01"
    }
    {
      Id = "Chronos_0910"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau aku jadi kau, aku bakal lebih mencemaskan apa yang sedang terjadi di Olympus sekarang. Kudengar Typhon sedang sangat mengamuk..."
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutTyphon02"
    }
    {
      Id = "Chronos_0913"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada kepekatan aneh di udara malam ini... kegelapan semacam ini pastilah ulah{#Emph}mu{#Prev}, tapi takkan banyak membantumu."
      Speaker = "Chronos"
      Event = "ChronosMeetingAboutShrine01"
    }
    {
      Id = "Chronos_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Murka sekali! Mengamuk persis bocah merajuk. Kau ingin bertarung melawanku, kalau begitu mari...!"
      Speaker = "Chronos"
      Event = "ChronosReveal01B"
    }
    {
      Id = "Chronos_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, hentikan. Sungguh memalukan cucuku yang satu ini rupanya lemah dan dungu, meski cukup licin untuk ditangkap. Seharusnya aku berterima kasih pada para Takdir karena akhirnya kita bisa bertatap muka."
      Speaker = "Chronos"
      Event = "ChronosRevealFollowUp"
    }
    {
      Id = "Melinoe_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Takdir tak ada sangkut pautnya dengan ini. Kau yang telah merenggut keluargaku."
      Speaker = "Melinoe"
      Event = "ChronosRevealFollowUp"
    }
    {
      Id = "Chronos_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga {#Emph}kita! {#Prev}Jangan ulangi kebodohan mereka, dan seiring berjalannya waktu, kita pasti bisa melupakan awal hubungan yang kikuk ini. Sampai bertemu lagi."
      Speaker = "Chronos"
      Event = "ChronosRevealFollowUp"
    }
    {
      Id = "Melinoe_0096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu! Kau..."
      Speaker = "Melinoe"
      Event = "ChronosRevealFollowUp"
    }
    {
      Id = "MelinoeField_5149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Awas saja kalau ini sampai gagal."
      Speaker = "Melinoe"
      Event = "NPC_Chronos_Story_01.InteractVoiceLines"
    }
    {
      Id = "Chronos_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ahh{#Prev}, rupanya kau di sana, putraku. Sudah berjanggut lebat dan bertubuh tegap, ya. Dan sekarang kau sudah punya keluargamu sendiri! Betapa penuh gairahnya hidup mereka, terlepas dari lingkungan yang suram ini."
      Speaker = "Chronos"
      Event = "ChronosNightmare01"
    }
    {
      Id = "Hades_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salam, Ayah. Aku... tidak menduga kedatanganmu. Kau... harus memaafkan kami karena Griya ini tidak siap menyambut tamu. Suatu kehormatan apa yang membawa kehadiranmu kemari?"
      Speaker = "Hades"
      Event = "ChronosNightmare01"
    }
    {
      Id = "Chronos_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau tahu sendiri, salah satunya karena kebetulan aku sedang lewat di sekitar sini! Kau mungkin masih ingat saat kau, Zeus, dan bocah-bocah ingusan lainnya mencincangku sampai berkeping-keping? Menyebarkan serpihan tubuhku ke seantero Tartarus?"
      Speaker = "Chronos"
      Event = "ChronosNightmare01"
    }
    {
      Id = "Hades_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah... perang itu {#Emph}kaulah {#Prev}yang memulainya, dan kau tahu betul itu! Kami sama sekali tidak gembira melakukan apa yang terpaksa kami lakukan! Tapi bagaimana mungkin? Kukira kau sudah musnah...!"
      Speaker = "Hades"
      Event = "ChronosNightmare01"
    }
    {
      Id = "Chronos_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan terdengar sekecewa itu! Seharusnya {#Emph}aku {#Prev}yang kecewa di sini, bukan {#Emph}dirimu. {#Prev}Kau kira aku sudah musnah? Memang sempat! Tapi ternyata dendam kesumat adalah pendorong yang sangat dahsyat. Tumbal darah juga sedikit banyak membantu."
      Speaker = "Chronos"
      Event = "ChronosNightmare01"
    }
    {
      Id = "Hades_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa maumu sebenarnya? Dan... apa yang sudah kau perbuat pada yang lain? Kepada keluargaku?!"
      Speaker = "Hades"
      Event = "ChronosNightmare01"
    }
    {
      Id = "Chronos_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jeritanmu sama sekali tak kugubris. Jangan takut, putraku. Mereka belum {#Emph}kutelan {#Prev}atau semacamnya, kok. Aku hanya sekadar... menyingkirkan mereka. Mereka kini terpenjara dalam suatu momen yang takkan pernah berlalu. Urusanku bukan dengan {#Emph}mereka."
      Speaker = "Chronos"
      Event = "ChronosNightmare01"
    }
    {
      Id = "Hades_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Olimpus pasti akan menuntut kepalamu. Kau boleh ambil kepalaku {#Emph}sendiri{#Prev}, persetan dengan itu, {#Emph}terkutuklah kau! {#Prev}Tapi jangan sekali-kali kau {#Emph}berani {#Prev}melukai siapa pun di Griya milikku."
      Speaker = "Hades"
      Event = "ChronosNightmare01"
    }
    {
      Id = "Chronos_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cih! {#Prev}Kau sudah terlalu terbiasa memberi perintah sampai lupa diri. Meskipun begitu, aku punya satu perintah untuk {#Emph}dirimu: {#Prev}Katakan padaku, persisnya, di mana para Moirae bersemayam."
      Speaker = "Chronos"
      Event = "ChronosNightmare01"
    }
    {
      Id = "Hades_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para {#Emph}Moirae? {#Prev}Bagaimana mungkin {#Emph}aku {#Prev}tahu? Bahkan Nyx sendiri tidak tahu di mana putri-putrinya berada! Kenapa kau... malah bertanya {#Emph}padaku...?"
      Speaker = "Hades"
      Event = "ChronosNightmare01"
    }
    {
      Id = "Melinoe_5166"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga sang waktu mengalir bebas ke depan."
      Speaker = "Melinoe"
      Event = "NPC_Chronos_02.InteractVoiceLines"
    }
    {
      Id = "Chronos_1297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayolah..."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.InteractVoiceLines"
    }
    {
      Id = "Chronos_1298"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam..."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.InteractVoiceLines"
    }
    {
      Id = "Chronos_1299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh{#Prev}, ampun..."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.InteractVoiceLines"
    }
    {
      Id = "Chronos_1300"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Untuk diriku yang dulu, begitu?"
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.InteractVoiceLines"
    }
    {
      Id = "Chronos_1301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak keberatan."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.InteractVoiceLines"
    }
    {
      Id = "Chronos_1302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitukah yang kau katakan?"
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.InteractVoiceLines"
    }
    {
      Id = "Chronos_1111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga sang waktu mengalir bebas ke depan..."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.InteractVoiceLines"
    }
    {
      Id = "Chronos_1096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau begitu kesal..."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.OnHitVoiceLines"
    }
    {
      Id = "Chronos_1097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak bisa mengubah masa lalu..."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.OnHitVoiceLines"
    }
    {
      Id = "Chronos_1098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan membalas..."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.OnHitVoiceLines"
    }
    {
      Id = "Chronos_1099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lakukan apa yang harus kau lakukan..."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.OnHitVoiceLines"
    }
    {
      Id = "Chronos_1100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu banyak derita yang kuperbuat..."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.OnHitVoiceLines"
    }
    {
      Id = "Chronos_1101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi masa lalu...?"
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.OnHitVoiceLines"
    }
    {
      Id = "Chronos_1108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga sang waktu mengalir bebas ke depan!"
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga sang waktu mengalir bebas ke depan...!"
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga sang waktu mengalir bebas ke depan."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1054"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga sang waktu mengalir bebas ke depan!"
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga sang waktu mengalir bebas ke depan...!"
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga sang waktu mengalir bebas ke depan."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1057"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga sang waktu mengalir bebas ke depan..."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maafkan aku, kawan tua."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1062"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini sama sekali takkan terasa sakit."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1058"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mati kau Chronos{#Prev}, begitu bunyinya, kan?"
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1059"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Matilah Chronos."
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1060"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Matilah Chronos!"
      Speaker = "Chronos"
      Event = "NPC_Chronos_02.BossFinisherVoiceLines"
    }
    {
      Id = "Chronos_1480"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maukah kau mengizinkan kita sesekali bertemu seperti ini, Cucuku? Aku sadar percakapan kita sebelumnya di Erebus ini penuh ketegangan... tapi mungkin kita masih bisa memulai lembaran baru, di kehidupan kali ini."
      Speaker = "Chronos"
      Event = "NeoChronosAboutErebus01"
    }
    {
      Id = "MelinoeField_4137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus membiasakan diri untuk tidak langsung menyerangmu saat bertemu, tapi mari kita coba. Memangnya ada apa dengan tempat ini sampai begitu istimewa?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutErebus01"
    }
    {
      Id = "Chronos_1481"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, pertama, aku tahu cara menemukannya! Dan kedua, kau biasanya selalu melewatinya! Bagaimanapun juga, kau kini telah menyaksikan berbagai kemungkinan nyata yang mengintai di Olympus dan di bawah sini. Mari kita singkirkan kemungkinan-kemungkinan yang berujung pada kehancuran."
      Speaker = "Chronos"
      Event = "NeoChronosAboutErebus01"
    }
    {
      Id = "MelinoeField_5181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mencegah kehancuran memang keahlianku. Kau akan diawasi ketat oleh Olympus dan Dunia Bawah di setiap langkahmu. Jangan sia-siakan kesempatan yang telah diberikan padamu."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutErebus01"
    }
    {
      Id = "Chronos_1482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku terus mengingatkan diriku sendiri tentang hal yang sama!"
      Speaker = "Chronos"
      Event = "NeoChronosAboutErebus01"
    }
    {
      Id = "Chronos_1085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu dan saudaranya, Zeus, berbaik hati memberiku kesempatan untuk memberikan sedikit baktiku pada Dunia Bawah. Kepulauan Yang Terberkati adalah tempat terindah di seantero Elysium! Dan aku pastikan tempat itu akan tetap seperti itu."
      Speaker = "Chronos"
      Event = "NeoChronosAboutNewJob01"
    }
    {
      Id = "MelinoeField_4139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu kehormatan besar yang diberikan padamu, Kakek! Beberapa pahlawan fana terhebat pasti ada di sana. Apakah tanggung jawab baru ini menyisakan cukup waktu bagimu untuk bertemu seperti ini?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutNewJob01"
    }
    {
      Id = "Chronos_1086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, menurutku ini bakal jauh lebih leluasa dari sebelumnya. Elysium sebenarnya tidak sejauh itu; kau harus berkunjung suatu saat nanti, begitu renovasi Dunia Bawah oleh ayahmu selesai. Yang kurasa mungkin butuh waktu satu zaman lagi."
      Speaker = "Chronos"
      Event = "NeoChronosAboutNewJob01"
    }
    {
      Id = "MelinoeField_4140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayah memang tipe orang yang serba teliti dan menuntut kesempurnaan. Baiklah, semoga sukses dengan peran barumu. Kalau Takdir mengizinkan, sampai jumpa lagi di Tartarus."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutNewJob01"
    }
    {
      Id = "Chronos_1087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Susuri kembali langkahmu dengan hati-hati!"
      Speaker = "Chronos"
      Event = "NeoChronosAboutNewJob01"
    }
    {
      Id = "MelinoeField_5032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada satu hal yang membuatku penasaran, Kakek... mengenai semua kemungkinan yang kita hadapi ini... Aku paham apa yang terjadi jika aku menang, kurang lebih. Tapi jika aku gagal di sana, lalu bagaimana?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutFailure01"
    }
    {
      Id = "Chronos_1390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kemungkinan itu akan tetap ada... tidak lebih dari itu! Jangan terlalu mencemaskan hal tersebut. Kita tahu ada begitu banyak kemungkinan di luar sana! Kau mungkin tak bisa memenangkan semuanya."
      Speaker = "Chronos"
      Event = "NeoChronosAboutFailure01"
    }
    {
      Id = "MelinoeField_5033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah aku akan punya kesempatan lain untuk memperbaiki kesalahanku? Kembali ke kemungkinan yang sama dan membereskannya?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutFailure01"
    }
    {
      Id = "Chronos_1391"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak tahu! Mungkin tidak! Bahkan mungkin {#Emph}kegagalanmu{#Prev}, begitu kau menyebutnya, justru membuahkan hasil yang diharapkan. Ada banyak hal yang belum sepenuhnya kupahami... walau agak memalukan untuk kuakui."
      Speaker = "Chronos"
      Event = "NeoChronosAboutFailure01"
    }
    {
      Id = "MelinoeField_5034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku juga masih terus belajar."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutFailure01"
    }
    {
      Id = "MelinoeField_4141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakek, bagaimana dengan Tiga Dewi Takdir? Kau benar-benar mengasingkan mereka tanpa tahu ke mana perginya?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutFates01"
    }
    {
      Id = "Chronos_1088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, benar. Satu lagi kesalahan fatal yang sangat ingin kuperbaiki. Aku sedang berusaha melacak keberadaan mereka di kedalaman samudra kemungkinan, hanya saja... mereka bisa berada di mana saja di sana."
      Speaker = "Chronos"
      Event = "NeoChronosAboutFates01"
    }
    {
      Id = "MelinoeField_4142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti ada sesuatu yang bisa kita lakukan. Apakah mereka dalam bahaya? Dan tidakkah kau takut akan pembalasan mereka jika kita berhasil menemukannya?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutFates01"
    }
    {
      Id = "Chronos_1089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, aku agak lebih mencemaskan diriku {#Emph}sendiri {#Prev}ketimbang mereka. Tapi upayaku untuk menentang kehendak Takdir tak pernah berhasil di masa lalu. Jika mereka kembali, aku akan menerima apa pun yang telah mereka siapkan untukku..."
      Speaker = "Chronos"
      Event = "NeoChronosAboutFates01"
    }
    {
      Id = "MelinoeField_4143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita pasti akan menemukan jalan keluarnya."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutFates01"
    }
    {
      Id = "MelinoeField_5029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana caramu membangkitkan kembali Typhon, Kakek? Aku selalu penasaran tentang itu. Dan sampai bisa mengejutkan para dewa Olympus dengan makhluk semengerikan itu..."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutTyphon01"
    }
    {
      Id = "Chronos_1387"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, aku... lebih suka tidak membicarakan kenangan pahit seperti itu, tapi... kebangkitan monster itu dalam beberapa hal mirip dengan kebangkitanku, saat Zagreus menemukanku. Dalam skala yang jauh lebih besar, tentu saja."
      Speaker = "Chronos"
      Event = "NeoChronosAboutTyphon01"
    }
    {
      Id = "MelinoeField_5030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu rupanya, dan aku tak akan mendesakmu lebih jauh, tapi... mungkin ini pertanyaan aneh, apakah kau dan Typhon saling mengenal dekat?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutTyphon01"
    }
    {
      Id = "Chronos_1388"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia adalah Ayah dari Segala Monster... tidak peduli sedikit pun pada keturunannya sendiri, apalagi pada orang lain. Dia hanyalah alat untuk mencapai tujuan. Bisa dibilang, kami hanya saling memanfaatkan."
      Speaker = "Chronos"
      Event = "NeoChronosAboutTyphon01"
    }
    {
      Id = "MelinoeField_5031"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mengerti. Cuma itu yang ingin kutanyakan."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutTyphon01"
    }
    {
      Id = "Chronos_1389"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah kalau begitu."
      Speaker = "Chronos"
      Event = "NeoChronosAboutTyphon01"
    }
    {
      Id = "MelinoeField_5035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kau sudah menghubungi Prometheus setelah semua yang terjadi di antara kita? Dia dan aku tidak pernah benar-benar akur. Meski aku mulai merasa dia sebenarnya tidak sepenuhnya berpihak padamu..."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutPrometheus01"
    }
    {
      Id = "Chronos_1392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia memang {#Emph}cerdas{#Prev}, yang satu itu. Bahkan mungkin terlalu cerdas hingga merugikan dirinya sendiri. Aku menyesal kalian berdua terpaksa harus baku hantam. Tapi, dia dan aku sudah tidak lagi saling berhubungan... demi menjaga keadaan agar tetap mendekati seperti sediakala."
      Speaker = "Chronos"
      Event = "NeoChronosAboutPrometheus01"
    }
    {
      Id = "MelinoeField_5036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia menyikapi situasi ini dengan sangat lihai, terlepas dari semua masalah yang ia timbulkan bagi para dewa. Kurasa itu masuk akal, jika dia memang benar-benar bisa mengantisipasi setiap kemungkinan."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutPrometheus01"
    }
    {
      Id = "Chronos_1393"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedengarannya memang sangat mencerminkan Prometheus yang kukenal."
      Speaker = "Chronos"
      Event = "NeoChronosAboutPrometheus01"
    }
    {
      Id = "MelinoeField_5182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terlepas dari segalanya, Kakek... kurasa perang sengit yang kau kobarkan melawan Olympus setidaknya telah membuka mata sebagian dari sanak keluarga kita. Mereka mungkin dewa-dewi... tapi mereka sadar bahwa mereka tidak sempurna."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutGoldenAge01"
    }
    {
      Id = "Chronos_1483"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... kesempurnaan, setahuku, tidak akan pernah bisa dicapai! Hanya bisa diupayakan. Anak-anakku memang bisa sangat keras kepala menyangkut kelemahan mereka, tapi kemungkinan besar mereka mewarisi sifat itu dari{#Emph}ku."
      Speaker = "Chronos"
      Event = "NeoChronosAboutGoldenAge01"
    }
    {
      Id = "MelinoeField_5183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski begitu... dengan berakhirnya perang ini, ada banyak hal yang harus dibenahi di permukaan maupun di sini. Aku mulai menyadari bahwa upaya pemugaran kita di Dunia Bawah ini pada dasarnya mencakup seluruh dunia."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutGoldenAge01"
    }
    {
      Id = "Chronos_1484"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat usiamu sudah setua diriku kelak, mungkin kau pun akan mengenang masa lalu dunia ini dengan penuh kerinduan. Barangkali itulah kutukan menua! Semoga keluarga kita kelak mampu membimbing dunia ini menuju masa-masa yang lebih makmur."
      Speaker = "Chronos"
      Event = "NeoChronosAboutGoldenAge01"
    }
    {
      Id = "MelinoeField_5184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga saja begitu."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutGoldenAge01"
    }
    {
      Id = "MelinoeField_4554"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemungkinan-kemungkinan dirimu yang lain yang kuhadapi... rasanya aneh berbicara dengan mereka seolah-olah semua kejadian ini tak pernah ada."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutChronos01"
    }
    {
      Id = "Chronos_1311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu saja begitu. Namun, justru itulah alasan mereka hanyalah kemungkinan dan tak lebih dari itu. Jadi, silakan saja layani omongan mereka sebelum lanjut ke urusan yang kurang menyenangkan."
      Speaker = "Chronos"
      Event = "NeoChronosAboutChronos01"
    }
    {
      Id = "MelinoeField_4555"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau sama sekali tak terganggu ikut campur dalam hal ini? Melenyapkan sendiri sosok yang berpenampilan persis sepertimu... yang sebenarnya {#Emph}adalah {#Prev}dirimu?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutChronos01"
    }
    {
      Id = "Chronos_1312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun {#Emph}aku {#Prev}adalah diriku. Bukankah kita ini cerminan dari seluruh pengalaman kita, Cucuku? Membuang pikiran dan tabiat lama yang keras kepala... rasanya bisa sangat menyegarkan! Jadi, mari kita lanjutkan."
      Speaker = "Chronos"
      Event = "NeoChronosAboutChronos01"
    }
    {
      Id = "Chronos_1290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau membawa Jam Waktu yang kuberikan padamu. Kukira kau akan langsung melemparnya ke jurang terdalam! Gerakan roda gigi yang berputar tiada henti itu sungguh memikat, bukan?"
      Speaker = "Chronos"
      Event = "NeoChronosAboutKeepsake01"
    }
    {
      Id = "MelinoeField_4369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benda ini memang tak biasa. Apa ini rancangan asli Master Daedalus? Menyatukan semua roda gigi kecil ini hingga bisa bergerak dalam keselarasan yang sempurna..."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutKeepsake01"
    }
    {
      Id = "Chronos_1291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mekanisme yang menggerakkan ruangan Tartarus yang selalu bergeser jelas menjadi sumber inspirasinya. Keselarasan sempurna yang kau sebutkan itu... barangkali hanya bisa terwujud dalam bentuk semacam ini! Namun hal itu {#Emph}bisa {#Prev}diwujudkan."
      Speaker = "Chronos"
      Event = "NeoChronosAboutKeepsake01"
    }
    {
      Id = "MelinoeField_4370"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa aku sepakat."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutKeepsake01"
    }
    {
      Id = "Chronos_1292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, di bawah sana, di Oceanus, kau mungkin akan menjumpai sisa-sisa mantramu yang melemparkanmu ke dalam penglihatan di luar aliran waktu. Aku belum menemukan cara untuk menghentikan yang {#Emph}satu itu{#Prev}..."
      Speaker = "Chronos"
      Event = "NeoChronosAboutAnomaly01"
    }
    {
      Id = "MelinoeField_4371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak bisa mengendalikan sihirmu sendiri? Aku sempat bertanya-tanya apakah itu perbuatanmu, atau salah satu dari dirimu yang kurang ramah."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutAnomaly01"
    }
    {
      Id = "Chronos_1293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa sepenuhnya menyangkal tanggung jawab itu, tapi yang itu memang salah satu dari {#Emph}mereka{#Prev}, ya. Dan kerentananmu itu, wah... barangkali karena ikatan batin yang terjalin di antara kita. Kekebalan dan kepekaan..."
      Speaker = "Chronos"
      Event = "NeoChronosAboutAnomaly01"
    }
    {
      Id = "Chronos_1313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau masih menerima berkat anak-anakku hingga sekarang. Aku lega mereka masih sudi mengulurkan bantuan, mengingat kekacauan yang kubuat, serta nestapa yang kubawa ke kediaman mereka..."
      Speaker = "Chronos"
      Event = "NeoChronosAboutBoons01"
    }
    {
      Id = "MelinoeField_4556"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya kita semua berkomitmen untuk meluruskan masalah ini sebaik mungkin. Lagi pula, para dewa Olympus sudah tak asing dengan pertikaian sesekali, meski mungkin tak sampai separah yang kemarin."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutBoons01"
    }
    {
      Id = "Chronos_1314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, begitulah, jika kita harus tinggal bersama di dunia yang sempit ini untuk selamanya, kita punya alasan kuat untuk meringankan kesengsaraan yang kita buat sendiri... Kuberterima kasih atas dukungan kalian semua."
      Speaker = "Chronos"
      Event = "NeoChronosAboutBoons01"
    }
    {
      Id = "MelinoeField_4559"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakek, Nemesis sempat bilang dia mungkin berpapasan denganmu di Tartarus. Bagaimana kelanjutannya?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutNemesis01"
    }
    {
      Id = "Chronos_1317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, luar biasa lancar! Tadinya kukira hanya {#Emph}dirimu {#Prev}yang sanggup menghadapi jejak-jejak keberadaanku yang tak diinginkan itu, tapi ternyata, {#Emph}Nemesis {#Prev}pun mampu! Dan dia sangat kuat."
      Speaker = "Chronos"
      Event = "NeoChronosAboutNemesis01"
    }
    {
      Id = "MelinoeField_4560"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi dia {#Emph}benar-benar {#Prev}serius! Dia berhadapan dengan salah satu jejak itu berkat bantuanmu, dan berhasil menang? Apa yang dia lakukan, mencincangnya hingga berkeping-keping dengan Bilah Stygian?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutNemesis01"
    }
    {
      Id = "Chronos_1318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku enggan merincikan detailnya, tapi... caranya sangat manjur. Ini pasti hanya dimungkinkan karena sebelumnya dia melangkah begitu dekat dengan jalurmu!"
      Speaker = "Chronos"
      Event = "NeoChronosAboutNemesis01"
    }
    {
      Id = "MelinoeField_4561"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia benar-benar melakukannya..."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutNemesis01"
    }
    {
      Id = "Chronos_1315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada satu hal yang ingin kutanyakan padamu, Cucuku, jika kau berkenan membagikan pandanganmu. Menurutmu, apa sebaiknya aku membiarkan janggutku tumbuh? Supaya bisa lebih membaur dengan anak-anakku, kurasa..."
      Speaker = "Chronos"
      Event = "NeoChronosAboutBeard01"
    }
    {
      Id = "MelinoeField_4557"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}ngg... {#Prev}itu sebenarnya masalah selera. Kalau menurutku, menumbuhkan janggut cuma bakal membuatmu kelihatan lebih tua. Lagipula, ayah dan paman-pamanku tidak menuntutmu untuk {#Emph}menjadi {#Prev}seperti mereka."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutBeard01"
    }
    {
      Id = "Chronos_1316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira perkataanmu ada benarnya. Dari dulu aku memang lebih menyukai raut wajah yang bersih tercukur. Barangkali justru itulah alasan anak-anakku memilih hal yang sebaliknya..."
      Speaker = "Chronos"
      Event = "NeoChronosAboutBeard01"
    }
    {
      Id = "MelinoeField_4558"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa jadi begitu..."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutBeard01"
    }
    {
      Id = "MelinoeField_4372"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar baik, Kakek. Tiga Takdir telah kembali! Dan mereka sama sekali tak menyinggung soal pembalasan kepadamu. Malahan, mereka menjanjikan fajar bagi zaman yang baru..."
      Speaker = "Melinoe"
      Event = "NeoChronosPostEpilogue01"
    }
    {
      Id = "Chronos_1294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, itu kabar yang sangat baik! Terutama bagian tanpa pembalasannya, dan melegakan rasanya mengetahui Ketiganya telah berhasil keluar dari pengasingan sementara. Tapi apa maksudnya soal {#Emph}zaman baru {#Prev}itu?"
      Speaker = "Chronos"
      Event = "NeoChronosPostEpilogue01"
    }
    {
      Id = "MelinoeField_4373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... sepertinya mereka tidak berencana menenun sesering dulu. Dan suatu saat nanti, para dewa tampaknya akan berkurang pengaruhnya atas kehidupan kaum fana..."
      Speaker = "Melinoe"
      Event = "NeoChronosPostEpilogue01"
    }
    {
      Id = "Chronos_1295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi itu terdengar persis seperti Zaman Keemasan saat {#Emph}aku {#Prev}berkuasa dulu...! Tentu saja, setelah hidup melewati sekian banyak eon, kau akan mulai menyadari perputaran pola semacam itu secara terus-menerus. Apa yang usang akan kembali menjadi baru. Bagaimana tanggapan keluarga kita mengenai hal ini?"
      Speaker = "Chronos"
      Event = "NeoChronosPostEpilogue01"
    }
    {
      Id = "MelinoeField_4374"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa kami semua masih harus memikirkannya baik-baik, meski waktu kita masih sangat panjang. Zaman itu mungkin tak akan tiba dalam waktu dekat."
      Speaker = "Melinoe"
      Event = "NeoChronosPostEpilogue01"
    }
    {
      Id = "Chronos_1296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja belum... tapi meski begitu, zaman tersebut bisa saja tiba sebelum kau menyadarinya. Percayalah padaku..."
      Speaker = "Chronos"
      Event = "NeoChronosPostEpilogue01"
    }
    {
      Id = "MelinoeField_4375"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu bisa berlalu begitu cepat..."
      Speaker = "Melinoe"
      Event = "NeoChronosPostEpilogue01"
    }
    {
      Id = "Chronos_1434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu mengagumi kaum fana... Aku senang para Takdir memutuskan memberi mereka kesempatan untuk menjalani hidup dengan cara mereka sendiri. Aku penasaran ingin melihat apa yang akan terjadi nanti."
      Speaker = "Chronos"
      Event = "NeoChronosPostEpilogue02"
    }
    {
      Id = "MelinoeField_5074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pantas saja Prometheus dulu ingin bekerja sama denganmu demi tujuan yang sama itu. Sebagian besar hal yang kutahu tentang kaum fana berasal dari mereka yang sudah mati... apa sebenarnya daya tarik dari mereka yang masih hidup?"
      Speaker = "Melinoe"
      Event = "NeoChronosPostEpilogue02"
    }
    {
      Id = "Chronos_1435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Alasannya sederhana: mereka memahami betul berharganya Waktu... setidaknya sebagian dari mereka. Karena waktu yang mereka miliki teramat singkat selagi mereka masih bernapas. Dalam satu sisi memang memilukan, tapi di sisi lain terasa sangat menginspirasi."
      Speaker = "Chronos"
      Event = "NeoChronosPostEpilogue02"
    }
    {
      Id = "MelinoeField_5075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku memang melihat hal itu pada mereka."
      Speaker = "Melinoe"
      Event = "NeoChronosPostEpilogue02"
    }
    {
      Id = "MelinoeField_5071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakek, apakah Kakek pernah... merasakan kembali kepahitan dan dendam masa lalu...? Terhadap para dewa, tentang Zaman Keemasanmu yang telah sirna, atau hal semacamnya?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutPast01"
    }
    {
      Id = "Chronos_1432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesalahan masa lalu tak bisa diulang kembali. Aku memendam perasaan-perasaan itu sekian lama; mereka takkan pernah sepenuhnya meninggalkanku. Namun kau telah memberiku kesempatan kedua ini."
      Speaker = "Chronos"
      Event = "NeoChronosAboutPast01"
    }
    {
      Id = "MelinoeField_5072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu Kakek tampak begitu kukuh, begitu yakin dengan pendirianmu. Terkadang aku masih sulit percaya kenangan akan masa lalu yang lebih baik sudah cukup untuk mengubah pikiranmu."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutPast01"
    }
    {
      Id = "Chronos_1433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun terperangah. Kenanganku melihatmu tumbuh dewasa... itu hanyalah sekelumit kecil dari keberadaanku. Namun sangatlah bermakna. Perubahan bisa terjadi dalam sekejap mata."
      Speaker = "Chronos"
      Event = "NeoChronosAboutPast01"
    }
    {
      Id = "MelinoeField_5073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga Kakek bisa tetap seperti ini seterusnya."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutPast01"
    }
    {
      Id = "Chronos_1073"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tak kusangka tugas untuk menaklukkanku hampir saja jatuh ke tanganmu! Sungguh beruntung tidak demikian, sebab aku takkan bisa dengan mudah melawan Sang Perwujudan Pembalasan; kurasa takkan ada yang sanggup!"
      Speaker = "Chronos"
      Event = "NeoChronosWithNemesis01"
    }
    {
      Id = "Nemesis_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun sama, jadi jangan coba-coba macam-macam di sini. Dan kalau kau serta sang Putri butuh bantuan lain untuk beres-beres akibat ulahmu, beri tahu aku. Dari kemarin aku ingin ikut andil."
      Speaker = "Nemesis"
      Event = "NeoChronosWithNemesis01"
    }
    {
      Id = "Chronos_1074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu kau sudah mendengar perihal rencana kita saat ini? Ada begitu banyak kemungkinan yang harus disingkirkan satu per satu. Jika kau sungguh bersedia membantu dalam hal ini..."
      Speaker = "Chronos"
      Event = "NeoChronosWithNemesis01"
    }
    {
      Id = "Nemesis_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh juga. Aku sudah bertekad sejak beberapa waktu lalu, dan aku bisa menembus sampai ke Tartarus, hanya saja belum bisa masuk ke dalam Griya."
      Speaker = "Nemesis"
      Event = "NeoChronosWithNemesis01"
    }
    {
      Id = "Chronos_1075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Perkara itu bisa kuatur dengan mudah!"
      Speaker = "Chronos"
      Event = "NeoChronosWithNemesis01"
    }
    {
      Id = "Nemesis_0433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Coba jelaskan lebih lanjut."
      Speaker = "Nemesis"
      Event = "NeoChronosWithNemesis01"
    }
    {
      Id = "Chronos_1030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus, akhirnya kau tiba juga! Berhubung kau sudah menelusuri kembali jalanmu dengan tepat, aku seharusnya bisa memanipulasi arus waktu sedemikian rupa agar kau berada di dalam Griya sementara sisa diriku yang dulu bertahta di singgasana ayahmu. Siap?"
      Speaker = "Chronos"
      Event = "NeoChronosAboutTartarus01"
    }
    {
      Id = "MelinoeField_4128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, belum. Apa yang akan terjadi jika aku berhasil, apalagi jika gagal? Apa Kakek yakin semua ini benar-benar akan {#Emph}berhasil?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutTartarus01"
    }
    {
      Id = "Chronos_1031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja aku cukup yakin! Penglihatan Asphodel yang bisa kubangkitkan; prinsipnya kurang lebih sama! Dan kau pun telah menunjukkan bakat luar biasa dalam melepaskan diri dari kekangan waktu."
      Speaker = "Chronos"
      Event = "NeoChronosAboutTartarus01"
    }
    {
      Id = "MelinoeField_4129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi aku harus masuk ke Griya persis seperti sebelumnya, lalu menghadapi sisa wujud Chronos ini sebagaimana yang kulakukan di masa lalu... kemudian Kakek yang akan mengurus sisanya?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutTartarus01"
    }
    {
      Id = "Chronos_1032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali. Pertama-tama aku akan menciptakan distorsi saat kau masuk, lalu kau lakukan apa yang harus kau lakukan terhadap versi diriku yang tersesat di {#Emph}sana! {#Prev}Kita akan {#Emph}menyingkirkan {#Prev}bahkan sekadar {#Emph}kemungkinan {#Prev}adanya dia!"
      Speaker = "Chronos"
      Event = "NeoChronosAboutTartarus01"
    }
    {
      Id = "MelinoeField_4130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah kalau begitu... aku berangkat!"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutTartarus01"
    }
    {
      Id = "MelinoeField_4131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum tentu. Apakah ini akan berlangsung seperti di puncak Olympus? Cara Kakek membangkitkan penglihatan dari garis waktu yang semestinya bisa terjadi... "
      Speaker = "Melinoe"
      Event = "NeoChronosAboutTartarus01_B"
    }
    {
      Id = "Chronos_1034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku sangat yakin ini akan berlangsung seperti yang kausebutkan! Tentu saja, apa yang menanti di dalam sana mungkin akan sedikit berbeda di setiap kesempatan kita bertualang ke sana..."
      Speaker = "Chronos"
      Event = "NeoChronosAboutTartarus01_B"
    }
    {
      Id = "MelinoeField_4134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah kalau begitu."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutTartarus01_B"
    }
    {
      Id = "Chronos_1046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, gadis manis, ini akan berlangsung persis seperti sebelumnya! Kau melompatlah ke dalam sungai, dan aku akan memastikan kau tiba di aliran yang tepat."
      Speaker = "Chronos"
      Event = "NeoChronosAboutTartarus02"
    }
    {
      Id = "Chronos_1035"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kau rupanya, gadis manis. Karena kau telah menelusuri kembali jalanmu dengan tepat, kini giliranku memindahkanmu ke dimensi waktu lain di mana sisa monster Typhon masih membayangi tempat ini. Siap?"
      Speaker = "Chronos"
      Event = "NeoChronosAboutOlympus01"
    }
    {
      Id = "MelinoeField_4132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi aku harus meluncur ke puncak, di mana pasukan Typhon dari masa lain sudah menungguku, lalu aku hadapi dia seperti dulu, dan Kakek akan mengurus sisanya?"
      Speaker = "Melinoe"
      Event = "NeoChronosAboutOlympus01"
    }
    {
      Id = "Chronos_1036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika segalanya berjalan sesuai rencana, maka ya! Aku akan menciptakan distorsi saat kau melesat; cari monster itu dan bertarunglah, agar kita bisa melenyapkan bahkan sekadar {#Emph}kemungkinan {#Prev}akan keberadaannya."
      Speaker = "Chronos"
      Event = "NeoChronosAboutOlympus01"
    }
    {
      Id = "MelinoeField_4133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum tentu. Apakah ini akan berlangsung seperti di Griya ayahku? Cara Kakek membangkitkan penglihatan dari garis waktu yang semestinya bisa terjadi..."
      Speaker = "Melinoe"
      Event = "NeoChronosAboutOlympus01_B"
    }
    {
      Id = "Chronos_1047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, gadis manis, kau tahu apa yang harus kau hadapi! Melompatlah menuju puncak, selagi aku memastikan kau sampai di aliran yang tepat."
      Speaker = "Chronos"
      Event = "NeoChronosAboutOlympus02"
    }
    {
      Id = "MelinoeField_4204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakek...? Luka yang diderita keluarga kita mungkin takkan pernah benar-benar pulih, tapi... setidaknya Kakek sudah mencoba mengambil langkah-langkah awal. Jadi ini, untuk Kakek."
      Speaker = "Melinoe"
      Event = "NeoChronosGift01"
    }
    {
      Id = "Chronos_1284"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, botol yang sungguh berharga, terima kasih, Cucuku! Nektar dari Olympus... tapi, kelihatannya memang cukup menggiurkan. Tradisinya tetap memberikan hadiah balasan yang sepadan, bukan begitu? Kalau begitu terimalah ini, silakan."
      Speaker = "Chronos"
      Event = "NeoChronosGift01"
    }
    {
      Id = "Chronos_1285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga, kau {#Emph}sungguh {#Prev}dermawan. Griya Hades dulu hanya punya sedikit persediaan ini, tapi karena amarahku, aku... yah, menghancurkan semuanya. Botol yang ini akan kujaga baik-baik."
      Speaker = "Chronos"
      Event = "NeoChronosGift02"
    }
    {
      Id = "MelinoeField_4365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Simpanlah, dan nikmatilah Nektar itu sebagaimana mestinya. Mengenai botol-botol yang lain, isinya pasti sudah meresap ke dalam Bumi, jadi... mungkin Griya sekarang terasa sedikit lebih berseri."
      Speaker = "Melinoe"
      Event = "NeoChronosGift02"
    }
    {
      Id = "Chronos_1286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kilau keemasan botol ini... sungguh, aku tak bisa membayangkan warna yang lebih indah dari ini. Dalam hidup ini, aku tak menyadari Olympus begitu menggemari emas seperti halnya diriku. Kendati kau tampaknya lebih menyukai perak, Cucuku..."
      Speaker = "Chronos"
      Event = "NeoChronosGift03"
    }
    {
      Id = "MelinoeField_4366"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari dulu memang begitu. Kami bekerja di bawah naungan Bulan dan bintang-bintang... kilau perak mengingatkanku pada mereka. Tapi kurasa emas sekarang mengingatkanku pada Apollo, dan dia cukup ramah, kalau-kalau Kakek belum pernah bertemu dengannya."
      Speaker = "Melinoe"
      Event = "NeoChronosGift03"
    }
    {
      Id = "Chronos_1287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apollo, sang musisi itu. Dia tampaknya pemuda yang berbakat..."
      Speaker = "Chronos"
      Event = "NeoChronosGift03"
    }
    {
      Id = "Chronos_1288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat mencicipi Nektar yang sebelumnya kauberikan padaku, dan astaga, rasanya sungguh luar biasa... dan aku pun berpikir, aku sebenarnya belum pantas menerima kebaikan sebesar ini darimu."
      Speaker = "Chronos"
      Event = "NeoChronosGift04"
    }
    {
      Id = "MelinoeField_4367"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini bukan hak istimewa, cuma hadiah sederhana. Bahkan bukan yang bermutu tinggi! Kapan-kapan kakek harus coba Ambrosia, apalagi kakek suka warna emas berkilau begini."
      Speaker = "Melinoe"
      Event = "NeoChronosGift04"
    }
    {
      Id = "Chronos_1289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ambrosia, ya... barangkali suatu saat nanti aku berkesempatan mencicipinya bersama keluarga ini. Namun aku tahu itu butuh waktu yang cukup lama. Cukup untuk sekarang, Cucuku. Jangan saat masih banyak urusan yang belum rampung."
      Speaker = "Chronos"
      Event = "NeoChronosGift04"
    }
    {
      Id = "MelinoeField_4368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lain kali saja kalau begitu."
      Speaker = "Melinoe"
      Event = "NeoChronosGift04"
    }
    {
      Id = "MelinoeField_4205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Alat yang sungguh tak lazim... dan terbuat dari emas. Terima kasih."
      Speaker = "Melinoe"
      Event = "NPC_Chronos_02.GiftGivenVoiceLines"
    }
    {
      Id = "Chronos_1033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.ChronosLaunchVoiceLines"
    }
    {
      Id = "Chronos_1037"
