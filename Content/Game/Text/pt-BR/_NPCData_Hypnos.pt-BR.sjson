{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Hypnos.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_3573"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidurlah yang nyenyak."
      Speaker = "Melinoe"
      Event = "NPC_Hypnos_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_3574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpi yang indah."
      Speaker = "Melinoe"
      Event = "NPC_Hypnos_01.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz, mm-hm, hmm..."
      Speaker = "Hypnos"
      Event = "HypnosFirstMeeting"
    }
    {
      Id = "Melinoe_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami akan menemukan cara untuk membangunkanmu, Sang Tidur. Aku berjanji."
      Speaker = "Melinoe"
      Event = "HypnosFirstMeeting"
    }
    {
      Id = "Hypnos_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz... hmm, zzzz..."
      Speaker = "Hypnos"
      Event = "HypnosAboutPoppies01"
    }
    {
      Id = "Melinoe_3910"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, waktu aku di Tartarus, aku menemukan beberapa benih yang tumbuh menjadi bunga Poppy... mirip seperti yang menghiasi pembaringanmu itu. Bagaimana jika kugunakan bersama... {#Emph}<Gasp> {#Prev}Aku baru saja dapat ide...!"
      Speaker = "Melinoe"
      Event = "HypnosAboutPoppies01"
    }
    {
      Id = "Melinoe_3911"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku berjanji akan berhati-hati."
      Speaker = "Melinoe"
      Event = "HypnosAboutPoppies01"
    }
    {
      Id = "Hypnos_0007_A"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzzz... zzz..."
      Speaker = "Hypnos"
      Event = "HypnosAboutUltimateProgress01"
    }
    {
      Id = "Melinoe_5679"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya aku tak boleh membicarakan ini, Tuan Hypnos, tapi... aku berhasil turun ke palung alam bawah sadar, dan aku menemukan saudaraku di sana...! Terima kasih sudah memantik rasa takjubku pada alam mimpi. Semua yang kuperjuangkan selama ini... semalam terasa begitu dekat!"
      Speaker = "Melinoe"
      Event = "HypnosAboutUltimateProgress01"
    }
    {
      Id = "Hypnos_0006_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... zzzzz..."
      Speaker = "Hypnos"
      Event = "HypnosAboutUltimateProgress02"
    }
    {
      Id = "Melinoe_5680_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah bisa menyelami palung alam bawah sadar bersama {#Emph}dirimu{#Prev}, Sang Tidur. Bersama saudaraku, jalannya begitu jelas...! Baiklah, kita pasti akan menemukan cara lain."
      Speaker = "Melinoe"
      Event = "HypnosAboutUltimateProgress02"
    }
    {
      Id = "Hypnos_0007_B"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz... zzzz..."
      Speaker = "Hypnos"
      Event = "HypnosPostTrueEnding01"
    }
    {
      Id = "Melinoe_5682"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibumu dan yang lainnya sudah selamat, Tuan Hypnos! Mereka pasti menanti kepulanganmu dan mengira kau bakal bangun setelah semua ini, tapi... kau masih tertidur lelap. Yah, jangan cemas... aku sudah berjanji padamu, dan aku berniat menepatinya."
      Speaker = "Melinoe"
      Event = "HypnosPostTrueEnding01"
    }
    {
      Id = "Hypnos_0007_C"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz... zzz... zzzz..."
      Speaker = "Hypnos"
      Event = "HypnosPostTrueEnding02"
    }
    {
      Id = "Melinoe_5747"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingatanku tentangmu dari potensi masa lalu yang kualami di Kediaman Hades... kau... begitu {#Emph}berbeda{#Prev}, Tuan Hypnos. Siapakah kau {#Emph}sebenarnya{#Prev}...? Bagaimana caraku agar akhirnya bisa menjangkaumu...?"
      Speaker = "Melinoe"
      Event = "HypnosPostTrueEnding02"
    }
    {
      Id = "Melinoe_5778"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, sesaat tadi kupikir... aku hampir lupa kalau kau masih ada di sini, seakan-akan... aku bermimpi kau sudah terbangun...? {#Emph}Augh{#Prev}, ngawur sekali. Aku pasti terlalu lelah."
      Speaker = "Melinoe"
      Event = "HypnosAboutStoryReset01"
    }
    {
      Id = "Hypnos_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz, zzzzz..."
      Speaker = "Hypnos"
      Event = "HypnosHideAndSeek01"
    }
    {
      Id = "Melinoe_2272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku pamit dulu untuk sekarang, Tuan Hypnos!"
      Speaker = "Melinoe"
      Event = "HypnosHideAndSeek01"
    }
    {
      Id = "Melinoe_2109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana perginya dia..."
      Speaker = "Melinoe"
      Event = "HypnosHideAndSeek01"
    }
    {
      Id = "Hypnos_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz, zzzz..."
      Speaker = "Hypnos"
      Event = "HypnosSleepingChat01"
    }
    {
      Id = "Hypnos_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz... hm, hm, hm, hm, hm..."
      Speaker = "Hypnos"
      Event = "HypnosSleepingChat03"
    }
    {
      Id = "Hypnos_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz... hm, zzzz..."
      Speaker = "Hypnos"
      Event = "HypnosSleepingChat05"
    }
    {
      Id = "Hypnos_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm-hm, zzzz... hm, zzz, hmhmhm...."
      Speaker = "Hypnos"
      Event = "HypnosSleepingChat06"
    }
    {
      Id = "Hypnos_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... mm, hmm... zzz... hmhm..."
      Speaker = "Hypnos"
      Event = "HypnosWakeUp01"
    }
    {
      Id = "Melinoe_3681"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kumohon berhasillah... {#Prev}Tuan Hypnos, kau sudah terlelap terlalu lama! Aku tahu kau tersesat di alam mimpi, tapi aku akan berusaha sebaik mungkin membimbingmu kembali ke alam nyata ini. Sekarang, tarik napas dalam-dalam!"
      Speaker = "Melinoe"
      Event = "HypnosWakeUp01"
    }
    {
      Id = "Melinoe_3682"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah ini...? Di mana aku?"
      Speaker = "Melinoe"
      Event = "HypnosWakeUp01"
    }
    {
      Id = "Hypnos_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... hmmm, hm-hm..."
      Speaker = "Hypnos"
      Event = "HypnosWakeUp02"
    }
    {
      Id = "Melinoe_4638"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Tuan Hypnos, mari kita coba sekali lagi. Kami harus mengeluarkanmu dari sana, tapi pertama-tama, tarik napas dalam-dalam."
      Speaker = "Melinoe"
      Event = "HypnosWakeUp02"
    }
    {
      Id = "Hypnos_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hmmm... ck, ck, hm... zzz..."
      Speaker = "Hypnos"
      Event = "HypnosWakeUp03"
    }
    {
      Id = "Melinoe_4707"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu caranya, Tuan Hypnos, dan sebaiknya kau menurut karena, kuakui, aku mulai agak tidak sabar di sini. Sekarang, tarik napas dalam-dalam!"
      Speaker = "Melinoe"
      Event = "HypnosWakeUp03"
    }
    {
      Id = "Melinoe_3385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga mimpimu indah selama kau tertidur lelap. Dan jika serta saat kau akhirnya terbangun nanti... ketahuilah bahwa Nektar ini akan menantimu."
      Speaker = "Melinoe"
      Event = "HypnosGift01"
    }
    {
      Id = "Hypnos_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzzz, selamat datang... di keeeh, hm, zzzz..."
      Speaker = "Hypnos"
      Event = "HypnosGift01"
    }
    {
      Id = "Melinoe_3482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, selamat datang di {#Emph}apa...?"
      Speaker = "Melinoe"
      Event = "HypnosGift01"
    }
    {
      Id = "Melinoe_3386"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidurku begitu sering dihantui mimpi buruk... kenangan, mungkin, saat Guru merawatku dulu. Jika mimpimu juga terusik, wahai sang Tidur... setidaknya kau sama sekali tak menunjukkannya."
      Speaker = "Melinoe"
      Event = "HypnosGift02"
    }
    {
      Id = "Hypnos_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... pernahkah... zzz... kau coba... zzzz..."
      Speaker = "Hypnos"
      Event = "HypnosGift02"
    }
    {
      Id = "Melinoe_3483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Barusan dia... pernah coba apa...?"
      Speaker = "Melinoe"
      Event = "HypnosGift02"
    }
    {
      Id = "Hypnos_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz... selamat datang di ke... mana... zzz..."
      Speaker = "Hypnos"
      Event = "HypnosDreamMeeting01"
    }
    {
      Id = "Melinoe_3684"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia bilang {#Emph}ke mana? {#Prev}Dia... mencoba berkomunikasi! Tuan Hypnos, aku Melinoë, putri Hades, dan aku berniat mencari cara untuk membangunkanmu dari tidur lelapmu! Kau bisa mendengarku?"
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting01"
    }
    {
      Id = "Hypnos_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz... ba-bangun, aku bangun, a... haha hm, zzz..."
      Speaker = "Hypnos"
      Event = "HypnosDreamMeeting01"
    }
    {
      Id = "Melinoe_3685"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau tetap tidur, bahkan di dalam mimpi? Apa yang bisa kulakukan untuk membawamu kembali kepada kami? Karena kami membutuhkanmu... saudarimu sendiri bilang padaku bahwa kebijaksanaan dan pengetahuanmu tiada duanya!"
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting01"
    }
    {
      Id = "Hypnos_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz... jadi kau melangkah... zzz... tepat ke dalam... zzz..."
      Speaker = "Hypnos"
      Event = "HypnosDreamMeeting01"
    }
    {
      Id = "Melinoe_3686"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku melangkah tepat ke {#Emph}mana? {#Prev}Tuan Hypnos, aku tidak paham. Sadarlah! Waktuku di sini menipis, dan kalau cara ini tidak berhasil, aku... tidak tahu harus berbuat apa lagi..."
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting01"
    }
    {
      Id = "Hypnos_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... mimpi... jadi... kenyataan... zzz... terima kasih... zzz... sudah mampir... zzz..."
      Speaker = "Hypnos"
      Event = "HypnosDreamMeeting01"
    }
    {
      Id = "Hypnos_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzzz... hmm, ck-ck, hm... zzz..."
      Speaker = "Hypnos"
      Event = "HypnosDreamMeeting01"
    }
    {
      Id = "Melinoe_3688"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, kesadarannya... lepas dari genggamanku. Bagaimana caraku... {#Emph}argh{#Prev}. Aku harus berpikir..."
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting01"
    }
    {
      Id = "Melinoe_3689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Semoga mimpi indah, untuk saat ini..."
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting01"
    }
    {
      Id = "Hypnos_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... selamat datang di... terima kasih... sudah mati..."
      Speaker = "Hypnos"
      Event = "HypnosDreamMeeting02"
    }
    {
      Id = "Melinoe_4641"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu untukmu di sini, tunggu sebentar ya..."
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting02"
    }
    {
      Id = "Melinoe_4710"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lewat saatnya bagimu untuk bangun."
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting03"
    }
    {
      Id = "Hypnos_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... mati... lagi... hm..."
      Speaker = "Hypnos"
      Event = "HypnosWakeUp02_B"
    }
    {
      Id = "Melinoe_4642"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau masih bermimpi bahkan di sini, maka aku harus meminta izin untuk menyelami batinmu lebih dalam lagi, Tuan Hypnos. Membiarkanku masuk atau tidak itu terserah padamu, tapi sekali lagi... tarik napas dalam-dalam."
      Speaker = "Melinoe"
      Event = "HypnosWakeUp02_B"
    }
    {
      Id = "Hypnos_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... daftarku... tak pernah..."
      Speaker = "Hypnos"
      Event = "HypnosWakeUp03_B"
    }
    {
      Id = "Melinoe_4711"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus menyelami batinmu lebih dalam sekali lagi, Tuanku, jadi maafkan kelancanganku, dan... bersiaplah."
      Speaker = "Melinoe"
      Event = "HypnosWakeUp03_B"
    }
    {
      Id = "Hypnos_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... tak ada... jalan kel... hhnnn..."
      Speaker = "Hypnos"
      Event = "HypnosDreamMeeting02_B"
    }
    {
      Id = "Melinoe_4647"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos? Tuan Hypnos! Kau bisa mendengarku? Jawab aku! {#Emph}Apa pun itu? {#Prev}Kedutan mata sedikit saja? Ayolah, {#Emph}kumohon!"
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting02_B"
    }
    {
      Id = "Hypnos_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... tak bakal kejar... mmssllppnnhhh..."
      Speaker = "Hypnos"
      Event = "HypnosDreamMeeting02_B"
    }
    {
      Id = "Melinoe_4648"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia bermimpi tentang... tidur? Atau tentang {#Emph}bermimpi? {#Prev}Aku masih belum bisa memahaminya. Sudah seberapa jauh dia terlelap...?"
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting02_B"
    }
    {
      Id = "Hypnos_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz... kawan lamaku... thanuhtos... sibuk... melulu..."
      Speaker = "Hypnos"
      Event = "HypnosDreamMeeting02_B"
    }
    {
      Id = "Hypnos_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hnn...?! Hhnnnhh..."
      Speaker = "Hypnos"
      Event = "HypnosDreamMeeting02_B"
    }
    {
      Id = "Melinoe_4650"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Augh. {#Prev}Kali ini masuk lebih jauh, tapi... berapa lapis mimpi yang kau {#Emph}alami? {#Prev}Tapi kalau kau memimpikan Sang Maut, mungkin saja... {#Emph}hm..."
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting02_B"
    }
    {
      Id = "Melinoe_4651"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidurlah yang nyenyak untuk saat ini, Tuan."
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting02_B"
    }
    {
      Id = "Melinoe_4714"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau keras kepala sekali, Tuan..."
      Speaker = "Melinoe"
      Event = "HypnosDreamMeeting03_B"
    }
    {
      Id = "Melinoe_4715"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Baiklah, Tuan Hypnos, sekali lagi. Kau masih menyembunyikan sesuatu dariku dan dari dirimu sendiri. Kau pasti masih terjaga di suatu sudut kesadaranmu, jadi mari kita cari kau di sana. Tarik napas dalam-dalam sekali lagi!"
      Speaker = "Melinoe"
      Event = "HypnosWakeUp03_C"
    }
    {
      Id = "Melinoe_4716"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak... tidak, dia.... {#Emph}ungh..."
      Speaker = "Melinoe"
      Event = "HypnosWakeUp03_C"
    }
    {
      Id = "Melinoe_4717"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada apa-apa di sini..."
      Speaker = "Melinoe"
      Event = "HypnosWakeUp03_C"
    }
    {
      Id = "Hypnos_0039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Zzz... kau terus... hm..."
      Speaker = "Hypnos"
      Event = "HypnosWakeUp03_C"
    }
    {
      Id = "Hypnos_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Zzz, hmhmhmhm... zzz, hmm, hmhmhm..."
      Speaker = "Hypnos"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Melinoe_4718"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sialan, Tuan Hypnos, harus bagaimana lagi membangunkannya? Tapi... apa ini, semacam catatan, isinya... dengan tulisan cakar ayam seperti anak kecil, tertulis... {#Emph}Sudah coba suruh bangun belum? {#Prev}Tunggu, {#Emph}apa?"
      Speaker = "Melinoe"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Hypnos_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Tersentak> <Menguaaap>"
      Speaker = "Hypnos"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Melinoe_4719"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia menguap. Tuan Hypnos... bangun. {#Emph}Bangun!"
      Speaker = "Melinoe"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Hypnos_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Menguap> {#Prev}Selamat datang di Griya Ha— aku, {#Emph}eh... {#Prev}tunggu. Di mana aku? Ini {#Emph}apa? {#Prev}Siapa {#Emph}kau?"
      Speaker = "Hypnos"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Melinoe_4720"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, kau... kau {#Emph}sadar! {#Prev}Ini adalah Persimpangan antardunia. Aku Melinoë, putri Tuan Hades dan Ratu Persephone. Selamat datang!"
      Speaker = "Melinoe"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Hypnos_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Menguap> {#Prev}Tunggu, tunggu, tunggu, apa {#Emph}maksudmu {#Prev}kau putrinya Tuan Besar, kau {#Emph}besar banget{#Prev}, maksudku kau tumbuh {#Emph}cepat sekali{#Prev}, maksudku, kau kan baru saja {#Emph}lahir! {#Prev}Kecuali... kecuali, aku, {#Emph}eh..."
      Speaker = "Hypnos"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Melinoe_4721"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah terlelap tidur sangat lama... Tuan. Sejak Titan Chronos merebut Griya ayahku, setahuku. Kami sibuk mengurus masalah itu sejak saat itu."
      Speaker = "Melinoe"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Hypnos_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "...gawat! {#Emph}Aah! AAAAAH! {#Prev}Gawat! Gawat, gawat, mereka bakal... dari mana datangnya semua Nektar ini? Oh, aku takkan pernah jadi pelayan teladan Griya lagi, oh {#Emph}tidaaak...!"
      Speaker = "Hypnos"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Melinoe_4722"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, Tuan Hypnos, tenanglah, {#Emph}kumohon! {#Prev}Semuanya baik-baik saja! Terutama sekarang karena kau sudah kembali bersama kami. Griya sudah membaik! Atau setidaknya sedang menuju ke sana."
      Speaker = "Melinoe"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Hypnos_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak tidak tidak, kau tidak mengerti... aku telat kerja parah. Aku {#Emph}terlambat banget {#Prev}masuk kerja! Aku harus pergi! Aku harus pergi, terima kasih sudah membangunkanku, kalau kau bertemu Zagreus beritahu dia aku segera ke sana!"
      Speaker = "Hypnos"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Hypnos_0047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sayang kamu! Dadah!"
      Speaker = "Hypnos"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Melinoe_4723"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Apa yang barusan terjadi, dia... cuma {#Emph}begitu saja?"
      Speaker = "Melinoe"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "Melinoe_4724"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Benar-benar begitu saja rupanya."
      Speaker = "Melinoe"
      Event = "HypnosFinalDreamMeeting01"
    }
    {
      Id = "MelinoeField_5271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Istirahatlah dengan tenang, Putra Nyx!"
      Speaker = "Melinoe"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_5272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga dirimu baik-baik, Tuan Hypnos."
      Speaker = "Melinoe"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0157"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hai!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Maut itu saudaraku!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makasih!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di mana?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan di sini?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang di Griya Hades?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa, {#Emph}aku?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0166"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.InteractVoiceLines"
    }
    {
      Id = "Hypnos_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh! {#Prev}Hai, {#Emph}emm{#Prev}, aku mau berterima kasih lagi, karena sudah membangunkanku dan semuanya? Ada {#Emph}banyak {#Prev}tumpukan pekerjaan yang harus kukejar, tapi kalau bukan karenamu, pasti bakal {#Emph}jauh lebih banyak lagi!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStart01"
    }
    {
      Id = "MelinoeField_5235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, sama-sama! Aku yakin segalanya jadi lebih baik di Griya setelah kau akhirnya kembali. Tunggu, apa aku sedang tidur? Tapi sekarang malah kau yang menghubungi{#Emph}ku?"
      Speaker = "Melinoe"
      Event = "HypnosDreamRunStart01"
    }
    {
      Id = "Hypnos_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja! Aku terus berpikir, apa yang bisa kulakukan untuk membalas kebaikan putrinya Tuan Besar? Berterima kasih padanya? Sudah! Kasih sayangku? Tak ada harganya. Dan lalu aku berpikir, aku bisa memastikan dia tidur nyenyak di malam hari!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStart01"
    }
    {
      Id = "MelinoeField_5236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu... sangat baik darimu, dan kurasa aku memang butuh tidur nyenyak. Jadi, tidur nyenyak ini melibatkan jiwaku berada di tempat yang aneh ini, dan apa lagi tepatnya?"
      Speaker = "Melinoe"
      Event = "HypnosDreamRunStart01"
    }
    {
      Id = "Hypnos_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, senang sekali kau bertanya, karena kau akan segera tahu: Ini kusebut {#Emph}Selam Mimpi! {#Prev}Pernah coba menaklukkan kecemasan terburukmu? Nah di sini, kau {#Emph}bisa! {#Prev}Pada akhirnya nanti. Tapi pertama-tama, ini ada brosur praktis yang menjelaskan {#Emph}semuanya!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStart01"
    }
    {
      Id = "Hypnos_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selam Mimpi pertamamu pasti berjalan lancar, soalnya kalau tidak, kau takkan kembali kemari! Tidur nyenyak yang satu pantas disusul tidur nyenyak lainnya, kan?"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStart02"
    }
    {
      Id = "MelinoeField_5238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu sebentar, Tuan Hypnos. Terakhir kali kita nyaris tidak mengobrol sebelum kau membawaku ke semacam versi distorsi dari malam-malam yang kulalui. Ini katanya menenangkan?"
      Speaker = "Melinoe"
      Event = "HypnosDreamRunStart02"
    }
    {
      Id = "Hypnos_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tentu saja{#Prev}, begitu kau sudah terbiasa! Setidaknya begitu buat{#Emph}ku! {#Prev}Meskipun aku bisa bersantai di sini selagi kau membantai semuanya. Tapi kurasa itu bagian paling {#Emph}seru{#Prev}, bukan begitu?"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStart02"
    }
    {
      Id = "MelinoeField_5408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku cuma... aku tak percaya mimpi-mimpiku ini begitu spesifik. Apa aku benar-benar sebegitu terikatnya dengan rutinitas harianku, sampai-sampai imajinasi dan alam bawah sadarku terobsesi dengannya?"
      Speaker = "Melinoe"
      Event = "HypnosDreamRunStart02"
    }
    {
      Id = "Hypnos_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa terjadi pada siapa saja! Tapi jangan berkecil hati, karena kalau kau terus melakukan Selam Mimpi, kau akan menaklukkan kecemasan terburukmu, dan merasa segar bugar seperti {#Emph}belum pernah sebelumnya! {#Prev}Nah, sana masuk!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStart02"
    }
    {
      Id = "MelinoeField_5240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin bertanya, Tuan Hypnos, apa sebenarnya Bintang Berkilau yang kuperoleh dari sosok pengganti aneh dari ancaman terbesar yang harus kuhadapi ini?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutDreamPoints01"
    }
    {
      Id = "Hypnos_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, itu tanda kecil kalau kau melakukan pekerjaan yang {#Emph}hebat! {#Prev}Membuat kemajuan dalam menaklukkan kecemasan terburukmu dan bisa merasakan tidur {#Emph}pulas{#Prev}, murni, tanpa gangguan sama sekali."
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutDreamPoints01"
    }
    {
      Id = "MelinoeField_5241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tujuan yang tentu saja sangat menggoda. Dan menurutmu butuh berapa banyak Bintang? Barangkali kau setidaknya bisa mengira-ngira."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutDreamPoints01"
    }
    {
      Id = "Hypnos_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah normalnya sih tiga puluh Bintang Berkilau, tapi kelihatannya kau sudah punya sebanyak itu, {#Emph}ya{#Prev}, yang artinya... {#Emph}emm{#Prev}, aku harus mencarinya dulu dan nanti kukabari lagi!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutDreamPoints01"
    }
    {
      Id = "MelinoeField_5242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyebutkan sesuatu tentang butuh tiga puluh Bintang Berkilau, dan setelah itu kecemasanku akan sembuh. Apa seharusnya sekarang aku sudah merasakan perbedaan tertentu?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutDreamPoints02"
    }
    {
      Id = "Hypnos_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti dong! Kau semestinya merasakan kepuasan pencapaian yang makin bertambah seiring makin banyaknya Bintang Berkilau yang kau dapat. Hubungannya satu-banding-satu! Makin banyak Bintang artinya makin berprestasi, dan itu artinya istirahat makin berkualitas!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutDreamPoints02"
    }
    {
      Id = "MelinoeField_5243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku memang merasa lebih tenang daripada sebelum ini semua, saat kau masih terlelap pulas di Persimpangan..."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutDreamPoints02"
    }
    {
      Id = "Hypnos_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuh kan? {#Emph}Manjur! {#Prev}Dan bisa bekerja {#Emph}jauh lebih baik lagi {#Prev}kalau kau dapat lebih banyak benda-yang-kau-tahu-lah. Sekarang menyelamlah!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutDreamPoints02"
    }
    {
      Id = "MelinoeField_5244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, aku sedang memikirkan... cukup banyak hal, sebenarnya. Tapi, jika aku sudah menaklukkan kekhawatiran terburukku saat ini, kenapa aku terus menghadapi wujud lawan-lawan terkuatku di sini?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutWorries01"
    }
    {
      Id = "Hypnos_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, itu sih gampang: Karena kamu khawatir kekhawatiranmu {#Emph}belum hilang! {#Prev}Maksudku, kekhawatiran itu memang {#Emph}belum {#Prev}hilang karena mereka masih ada {#Emph}di sini! {#Prev}Mungkin kamu sebenarnya {#Emph}suka {#Prev}punya kekhawatiran! Cuma bukan yang jenis paling buruk."
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutWorries01"
    }
    {
      Id = "MelinoeField_5245"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku memang sempat takut bahwa setelah tugasku tuntas dan Griya Hades dipulihkan, aku akan kehilangan tujuan hidup. Maksudmu, aku yang memanifestasikan hal ini?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutWorries01"
    }
    {
      Id = "Hypnos_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja! Aku suka memberi saran! Lagipula, hanya karena kekhawatiran {#Emph}terburukmu {#Prev}sudah ditaklukkan, bukan berarti kamu tidak bisa punya {#Emph}lagi! {#Prev}Dan lakukan lebih banyak Penyelaman Mimpi untuk menyingkirkannya!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutWorries01"
    }
    {
      Id = "MelinoeField_5411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, aku tahu aku tidak semestinya cemas di sini, tapi... apakah aku bisa bermimpi tentang hal lain selain kenyataan yang sudah biasa kuhadapi ini? Masa cuma begini saja..."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutWorries02"
    }
    {
      Id = "Hypnos_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kukira kamu bilang kamu {#Emph}suka {#Prev}Penyelaman Mimpi! Kamu tahu kan kalau kamu bisa berhenti melakukan ini kapan pun kamu mau?"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutWorries02"
    }
    {
      Id = "MelinoeField_5412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang suka, hanya saja... mimpi itu tanpa batas...! Aku ingin menjelajahinya sepuas mungkin! Mengangankan kemustahilan, mengunjungi tempat-tempat yang belum pernah kulihat...!"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutWorries02"
    }
    {
      Id = "Hypnos_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waduh, begini ya, kamu mungkin bakal memimpikan hal lain suatu saat nanti, tapi kamu tidak akan membutuhkanku untuk mimpi-mimpi itu, cuma untuk yang {#Emph}ini! {#Prev}Dan aku sudah berusaha sebaik mungkin, oke? Aku cuma {#Emph}satu orang! {#Prev}Ayo dong."
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutWorries02"
    }
    {
      Id = "Hypnos_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, {#Emph}ngomong-ngomong{#Prev}, kamu belum bilang ke siapa-siapa kalau kita melakukan Penyelaman Mimpi di sini, kan? Soalnya mimpi itu bisa {#Emph}sangat, sangat pribadi. {#Prev}Lagipula aku kan harusnya sedang bekerja."
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutSecrecy01"
    }
    {
      Id = "MelinoeField_5246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, maksudmu kau melalaikan tanggung jawabmu terhadap Griya ayahku, atau bahkan seluruh alam baka, hanya demi mengurus Penyelaman Mimpi ini untukku? Aku tidak mau itu terjadi!"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutSecrecy01"
    }
    {
      Id = "Hypnos_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan, bukan, bukan, {#Emph}tentu saja {#Prev}kamu tidak mau! {#Emph}Siapa juga yang mau? {#Prev}Pekerjaan tetap nomor satu, cuma ya... aku juga senang sekali bisa melakukan ini. Jadi, anggap saja kamu tidak pernah melihatku di sini, ya?"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutSecrecy01"
    }
    {
      Id = "Hypnos_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku lupa bilang, apa pun yang kamu lakukan, kalau kebetulan melihat seseorang yang kamu kenal di tengah Penyelaman Mimpi, {#Emph}jangan {#Prev}bicara dengan mereka... oke?"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutTalking01"
    }
    {
      Id = "MelinoeField_5413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa? Aku sudah bertemu wujud nyata dari kawan-kawan terdekat maupun musuh terbesarku, dan kami sudah saling bertegur sapa. Apa yang telah kuperbuat...?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutTalking01"
    }
    {
      Id = "Hypnos_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Yah, kemungkinan besar {#Prev}tidak apa-apa sih, cuma... biasanya tidak boleh banyak bicara selama Penyelaman Mimpi. Tapi kalau kamu sudah terlanjur dan tidak jadi gila, kupikir semuanya {#Emph}baik-baik saja!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutTalking01"
    }
    {
      Id = "Hypnos_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku tahu Penyelaman Mimpi ini seru, dan juga sehat untukmu, tapi... kupikir kamu perlu tahu, beberapa penghuni Griya Hades mulai {#Emph}agak khawatir {#Prev}karena para Takdir belum juga kembali!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutFates01"
    }
    {
      Id = "MelinoeField_5249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, benar... Kurasa memang kecil kemungkinannya kita bisa menemukan mereka di dalam mimpi berulangku ini. Terima kasih atas peringatan lembutnya."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutFates01"
    }
    {
      Id = "Hypnos_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama-sama! Penyelaman Mimpi ini selalu bisa ditunda sampai kamu menuntaskan urusan yang lebih penting. Tapi untuk sekarang...? Ayo kita selami sekali lagi!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutFates01"
    }
    {
      Id = "Hypnos_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, aku dengar kabar baiknya! {#Emph}Para Takdir sudah kembali! {#Prev}Di mana pun mereka sekarang. Secara pribadi sih, aku tidak pernah melihat mereka, berhubung aku jarang keluar. Kecuali kalau {#Emph}ini {#Prev}bisa dihitung!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutFates02"
    }
    {
      Id = "MelinoeField_5250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lega saudarimu aman dan sehat. Jadi mereka membicarakannya di Griya! Bagaimana suasana di sana? Apakah semua orang masih bersemangat?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutFates02"
    }
    {
      Id = "Hypnos_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}tentu saja! {#Prev}Tapi mereka juga masih sibuk bersih-bersih setelah semua kejadian itu, ya tahu sendirilah, pas aku sedang tidur. Jadi, masih {#Emph}banyak {#Prev}yang perlu dikhawatirkan, makanya kita {#Emph}berdua {#Prev}ada di sini!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutFates02"
    }
    {
      Id = "MelinoeField_5409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya saja kau tidak harus pergi secepat ini, Tuanku. Beberapa saudaramu tinggal bersamaku di Persimpangan, atau setidaknya datang berkunjung... Nemesis, Charon, Moros... bahkan Eris. Mereka pasti ingin melepas kepergianmu."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutSiblings01"
    }
    {
      Id = "Hypnos_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}mereka! {#Prev}Ya, aku ingat mereka, setidaknya Charon. Aku tidak begitu kenal Nemesis, dan Moros, kurasa kita belum pernah bertemu? Atau mungkin itu Eris. Maaf ya aku melewatkan mereka!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutSiblings01"
    }
    {
      Id = "MelinoeField_5410"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus terus mengingatkan diriku sendiri bahwa kalian anak-anak Nyx cenderung tidak terlalu dekat. Kurasa memang begitulah keluarga besar! Aku pun baru bertemu sebagian besar kaum Olympia belum lama ini."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutSiblings01"
    }
    {
      Id = "Hypnos_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku dekat dengan Thanatos! Aku tahu aku punya saudara-saudari lain juga, tapi dia sepertinya yang paling kusukai. Kamu pasti punya yang paling kamu sukai juga! Ibu punya banyak sekali anak. Ah, Ibu...!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutSiblings01"
    }
    {
      Id = "MelinoeField_5251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, kau... tunggu, kau terjaga...! Tapi, kau masih tertidur lelap di Persimpangan, aku... {#Emph}oh. {#Prev}Ini mimpi. Mimpiku, bukan mimpimu."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutStoryReset01"
    }
    {
      Id = "Hypnos_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begini ya, soal mimpi itu, {#Emph}kadang-kadang{#Prev}, memang sama sekali {#Emph}tidak {#Prev}masuk akal. Yah, kamu selalu bisa mencari {#Emph}maknanya {#Prev}kalau kamu {#Emph}memikirkannya {#Prev}cukup lama, tapi... {#Emph}aku {#Prev}sih tidak akan melakukannya kalau jadi kamu."
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutStoryReset01"
    }
    {
      Id = "MelinoeField_5252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku hanya membayangkan apa yang mungkin kau katakan kepadaku. Meski begitu, kubayangkan kau akan sangat berbeda dari ini. Yah, aku tak sabar untuk bertemu denganmu secara nyata segera."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutStoryReset01"
    }
    {
      Id = "Hypnos_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku juga! Nah, bagaimana kalau kita {#Emph}jangan pernah {#Prev}membahas ini lagi, soalnya ini {#Emph}begitu {#Prev}membingungkan sampai kepalaku terasa aneh, dan aku tidak suka itu! Tapi aku {#Emph}suka {#Prev}mengirimmu ke Penyelaman Mimpi!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutStoryReset01"
    }
    {
      Id = "Hypnos_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hei{#Prev}, saudaraku Thanatos, {#Emph}dia {#Prev}punya sabit seperti itu! Tunggu, mungkinkah ini mimpiku {#Emph}sendiri? {#Prev}Tapi kalau begitu kenapa malah {#Emph}kamu {#Prev}yang ada di sini dan bukannya {#Emph}dia?"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutThanatosAspect01"
    }
    {
      Id = "MelinoeField_5253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, kau bahkan tidak yakin apakah ini benar-benar mimpiku {#Emph}sendiri? {#Prev}Aku memang sempat heran kenapa ruang perantara di sini begitu mirip saat aku berada di dalam mimpimu {#Emph}dulu {#Prev}untuk mencoba membangunkanmu."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutThanatosAspect01"
    }
    {
      Id = "Hypnos_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm{#Prev}, kalau dipikir-pikir, Thanatos {#Emph}memang {#Prev}sempat menyinggung soal seseorang yang meminjam sabit tuanya untuk sementara waktu. Padahal mimpi {#Emph}bisa {#Prev}mencerminkan hasrat terdalam kita, jadi melihat benda itu agak membuatku bingung! Tapi tugasku di sini kan membingungkan {#Emph}kamu!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutThanatosAspect01"
    }
    {
      Id = "Hypnos_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah{#Prev}, aku {#Emph}suka {#Prev}gayamu mendandani {#Emph}peliharaanmu! {#Prev}Bintang-Bintang Berkilau yang sudah kamu kumpulkan itu ternyata ada {#Emph}keuntungannya {#Prev}juga! Walau kebanyakan cuma buat pamer."
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutFamiliarCostumes01"
    }
    {
      Id = "MelinoeField_5261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka memang terlihat indah. Kau tahu, sungguh menakjubkan kau tidak hanya bisa terhubung denganku lewat mimpi, tapi juga dengan Hewan Kerabatku! Masih banyak yang harus kupelajari tentang semua ini."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutFamiliarCostumes01"
    }
    {
      Id = "Hypnos_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, iya dong. Mempelajari semua ini butuh waktu yang rasanya {#Emph}selamanya! {#Prev}Tapi {#Emph}setiap {#Prev}makhluk hidup itu bermimpi... begitu {#Emph}pula {#Prev}yang sudah {#Emph}mati! {#Prev}Nah, sekarang pergilah kumpulkan lebih banyak Bintang Berkilau, ya?"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutFamiliarCostumes01"
    }
    {
      Id = "MelinoeField_5414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, sekarang kami punya patung indah untuk menghormatimu, tepat di arena latihan kami. Rasanya seperti kau sedang mengawasiku di sana selama Penyelaman Mimpi ini."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutHypnosStatue01"
    }
    {
      Id = "Hypnos_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, barang {#Emph}tua {#Prev}itu! Syukurlah kamu menemukan tempat untuknya. Kami tidak pernah punya tempat di sini, maksudku di Griya. Tadinya mereka mau membuangnya, sampai aku bilang, kenapa tidak dikirimkan ke {#Emph}kamu {#Prev}saja?"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutHypnosStatue01"
    }
    {
      Id = "MelinoeField_5415"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi, tidak mungkin...! Penggambaran megah Sang Perwujudan Tidur itu sendiri hampir saja disingkirkan begitu saja! Sungguh keterlaluan..."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutHypnosStatue01"
    }
    {
      Id = "Hypnos_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu juga yang {#Emph}kukatakan! {#Prev}Yah, yang kukatakan sebenarnya cuma {#Emph}ah ayolah{#Prev}, tapi maksudku persis seperti yang kamu bilang! Kurasa ini berarti kamu sudah menyelamatkan diriku yang {#Emph}asli {#Prev}sekaligus yang {#Emph}versi patung! {#Prev}Terima kasih!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutHypnosStatue01"
    }
    {
      Id = "Hypnos_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kamu sudah puas mengumpulkan Bintang Berkilau sampai sekarang. Maksudku, kamu sudah kehabisan barang untuk ditukar, kan? Tapi kamu terus saja mengumpulkan {#Emph}lagi{#Prev}, dan {#Emph}lagi{#Prev}, dan {#Emph}lagi!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutCosmetics01"
    }
    {
      Id = "MelinoeField_5416"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah itu menjadi masalah, Tuan Hypnos? Kukira Bintang-Bintang itu terutama dimaksudkan untuk menandakan seberapa mahirnya aku dalam Penyelaman Mimpi ini. Haruskah aku menahan diri?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutCosmetics01"
    }
    {
      Id = "Hypnos_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, tidak, lanjutkan saja kalau mau. Lagipula, kita tidak akan kehabisan Bintang Berkilau dalam waktu dekat, sebanyak apa pun yang kamu dapatkan. Jadi kalau kamu masih mau lagi... silakan saja!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutCosmetics01"
    }
    {
      Id = "Hypnos_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat siapa yang akhirnya muncul! Tadinya aku mulai berpikir kamu tidak mau melihat tempat ini lagi. Atau {#Emph}aku!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutTimePassing01"
    }
    {
      Id = "MelinoeField_5262"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, Tuan Hypnos, tidak, bukan begitu. Aku hanya punya tanggung jawab lain, sama sepertimu. Barangkali kau bisa mengunjungi Persimpangan lagi, dan kita bisa bertemu di sana!"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutTimePassing01"
    }
    {
      Id = "Hypnos_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, mungkin kapan-kapan, boleh juga. Tapi aku sudah pergi terlalu lama sampai-sampai jatah cuti siang-malamku sudah habis terpakai sampai masa depan yang sangat jauh, jadi... mungkin aku cuma bisa melihatmu di sini. Asalkan kamu kembali lagi!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutTimePassing01"
    }
    {
      Id = "Hypnos_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah{#Prev}, menurut daftarku, kamu sudah menyelesaikan Penyelaman Mimpi memakai {#Emph}setiap {#Prev}senjata rahasia yang dibuat ibuku, yang bahkan tidak boleh kuketahui sama sekali. Kerja bagus!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutWeaponsQuest01"
    }
    {
      Id = "MelinoeField_5260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menyanjungku, Tuan Hypnos. Senjata Malam telah melayaniku dengan baik sepanjang tugasku, jadi aku tidak heran jika senjata-senjata itu sama efektifnya di dalam mimpiku."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutWeaponsQuest01"
    }
    {
      Id = "Hypnos_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya! Walau secara pribadi aku {#Emph}agak {#Prev}kaget sih. Ini kan mimpi, jadi kalau {#Emph}aku {#Prev}jadi kamu, aku bakal membayangkan senjata yang {#Emph}jauh {#Prev}lebih kuat dari {#Emph}itu! {#Prev}Aku bakal membabat habis semuanya sekaligus! Tapi ya sudahlah, terserah apa yang cocok buatmu."
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutWeaponsQuest01"
    }
    {
      Id = "MelinoeField_5254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, aku ingin bertanya... seberapa banyak yang kau ingat? Tentang apa yang terjadi pada Griya, dan kita semua."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutMemories01"
    }
    {
      Id = "Hypnos_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}haha{#Prev}, maksudmu urusan ingatan-mimpi yang tidak boleh dibicarakan oleh siapa pun dari kita itu, kan! Jangan khawatir, aku sudah tahu semuanya kok."
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutMemories01"
    }
    {
      Id = "MelinoeField_5255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, kau pasti mengingatku. Hanya itu yang benar-benar ingin kupastikan, karena... yah, aku tadinya tidak yakin."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutMemories01"
    }
    {
      Id = "Hypnos_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu wajar sekali kok, {#Emph}apalagi {#Prev}karena kita sedang bicara di dalam {#Emph}mimpi! {#Prev}Kamu tidak akan pernah bisa terlalu yakin, dan dari situlah kekhawatiran muncul! Dan di situlah Penyelaman Mimpi berguna! Siap?"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutMemories01"
    }
    {
      Id = "MelinoeField_5256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, Tuan Hypnos... tumbuh besar di Persimpangan, sementara kau berada di sana, tertidur lelap sepanjang waktu... aku sering kali memikirkan tentangmu. Dan bertekad untuk melihatmu terbangun."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutRelationship01"
    }
    {
      Id = "Hypnos_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah{#Prev}, terima kasih. Aku sendiri tidak ingat hal-hal itu sama sekali. Cuma serpihan-serpihan dari banyak mimpi yang berserakan! Kebanyakan tentang pekerjaanku, atau saudaraku, atau saudara{#Emph}mu{#Prev}, kadang Dusa, sesekali Megaera... eh, tadi pertanyaanmu apa ya?"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutRelationship01"
    }
    {
      Id = "MelinoeField_5257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku tidak bertanya apa-apa, aku cuma... merenungkan betapa bersyukurnya diriku karena akhirnya bisa bertemu, setelah sekian lama. Dan bahwa kau bersedia mengunjungiku di dalam mimpi-mimpiku yang berkaitan dengan tugas."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutRelationship01"
    }
    {
      Id = "Hypnos_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti dong! Aku {#Emph}suka {#Prev}mimpi! Memimpikannya, membuatnya, apa saja deh! Tapi aku tidak bisa sering-sering membicarakannya di Griya. Pas aku bangun — secara teknis aku masih di sana."
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutRelationship01"
    }
    {
      Id = "MelinoeField_5258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi ini cukup menguntungkan bagi kita berdua. Kau sungguh tidak keberatan kalau kita terus bertemu seperti ini? Aku tidak ingin menjauhkanmu dari tanggung jawabmu."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutRelationship01"
    }
    {
      Id = "Hypnos_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku... tidak punya {#Emph}terlalu {#Prev}banyak tanggung jawab sekarang, berhubung Griya sedang {#Emph}tutup{#Prev}, jadi... kurasa ini {#Emph}bagus sekali! {#Prev}Tapi aku tidak bisa tinggal {#Emph}selamanya{#Prev}, jadi saatnya Selam Mimpi, oke?"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutRelationship01"
    }
    {
      Id = "MelinoeField_5417"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Hypnos, aku tidak bermaksud membuatmu merasa canggung, tapi aku penasaran, saat kau pergi dari Persimpangan, aku ingat kau berkata... {#Emph}Aku cinta kamu. Sampai jumpa. {#Prev}Apa maksudmu dengan itu...?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutLove01"
    }
    {
      Id = "Hypnos_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}haha{#Prev}, ayolah, menurutmu apa {#Emph}maksudku{#Prev}? {#Emph}Aku cinta kamu! {#Prev}Kurasa itu sudah cukup jelas, kan? Cuma {#Emph}tiga kata! {#Prev}Dan aku tidak akan mengatakannya kalau tidak sungguh-sungguh."
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutLove01"
    }
    {
      Id = "MelinoeField_5418"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi, bagaimana mungkin kau mencintaiku? Bahkan sekarang tampaknya kita baru mulai saling mengenal. Cinta itu tumbuh secara bertahap, jika memang ada... bukankah begitu?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutLove01"
    }
    {
      Id = "Hypnos_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Dengar ya, kau mungkin lebih tahu soal itu daripada aku, tapi... kalau bukan karenamu, aku tidak akan {#Emph}ada di sini {#Prev}sekarang! Dan tidak {#Emph}sembarang orang {#Prev}mau melakukan hal semacam itu!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutLove01"
    }
    {
      Id = "Hypnos_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei {#Emph}um{#Prev}, kau tidak keberatan soal perkara {#Emph}aku-cinta-kamu {#Prev}itu, kan? Soalnya sikapmu {#Emph}agak aneh {#Prev}soal itu terakhir kali!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutLove02"
    }
    {
      Id = "MelinoeField_5419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, yah... mungkin aku terlalu memusingkan hal itu. Cinta bukanlah perasaan yang asing, lebih merupakan spektrum perasaan, sebenarnya. Tapi, itu bisa sangat kuat. Meski begitu, aku bersyukur kau mencintaiku, dan... kurasa aku juga mencintaimu, Tuan Hypnos! Dengan cara tertentu."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutLove02"
    }
    {
      Id = "Hypnos_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aw, terima kasih! Aku sampai lupa kapan terakhir kali ada yang bilang begitu padaku! Meski aku sudah menduganya, maksudku, untuk apa lagi kau repot-repot begini hanya demi {#Emph}aku? Dan {#Prev}terus melakukan {#Emph}Selam Mimpi!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutLove02"
    }
    {
      Id = "MelinoeField_5420"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Erm{#Prev}, Tuan Hypnos, sekarang setelah kita memastikan bahwa kita saling mencintai... apa yang harus kita lakukan sekarang?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutLove03"
    }
    {
      Id = "Hypnos_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih banyak Selam Mimpi, entahlah! Memangnya apa yang {#Emph}seharusnya {#Prev}kita lakukan? Dengar, masa seseorang tidak bisa bilang {#Emph}aku cinta kamu {#Prev}tanpa membuat suasananya jadi {#Emph}aneh?"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutLove03"
    }
    {
      Id = "MelinoeField_5421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku... aku juga tidak yakin, tapi... jadi maksudmu ini cinta? Tidak perlu ada yang lebih dari apa yang sudah kita miliki sekarang?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutLove03"
    }
    {
      Id = "Hypnos_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, hubungan kita ini {#Emph}sangat {#Prev}istimewa, kalau kau tanya padaku, maksudku, aku tidak melakukan Selam Mimpi untuk {#Emph}sembarang orang! {#Prev}Sekarang, jangan bicarakan ini lagi, ya? Rasanya membuat perasaanku jadi aneh!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutLove03"
    }
    {
      Id = "MelinoeField_5259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bilang kau tidak punya banyak tanggung jawab saat ini. Apa kau baik-baik saja? Kalau aku, saat tidak punya banyak hal untuk dikerjakan, aku mulai merasa cemas, kurasa."
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutJob01"
    }
    {
      Id = "Hypnos_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku senang kau cemas karena {#Emph}itulah {#Prev}alasannya kau berakhir di {#Emph}sini. {#Prev}Dan aku juga! Dan {#Emph}karena itulah {#Prev}aku baik-baik {#Emph}saja. {#Prev}Tapi... terima kasih sudah bertanya. Jadi, {#Emph}um... {#Prev}dah!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutJob01"
    }
    {
      Id = "Hypnos_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, {#Emph}um{#Prev}, keadaan di Griya mulai sedikit sibuk akhir-akhir ini, yang mana itu hal {#Emph}bagus{#Prev}, {#Emph}tapi... {#Prev}itu artinya aku mungkin tidak akan sering ada di sini. Pekerjaan nomor satu, {#Emph}haha!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_5263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sangat paham, Tuan Hypnos. Apa ini berarti aku harus menghentikan Selam Mimpi ini mulai sekarang, atau apa saranmu?"
      Speaker = "Melinoe"
      Event = "HypnosDreamAboutSayingLittle01"
    }
    {
      Id = "Hypnos_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, saranku {#Emph}banyak {#Prev}sekali! Tapi tidak, kau bisa tetap melakukan Selam Mimpi sebanyak yang kau mau, hanya saja aku tidak bisa terus {#Emph}mengobrol {#Prev}lama-lama denganmu seperti ini! Tapi kita akan sering bertemu, oke? Makasih! Dah!"
      Speaker = "Hypnos"
      Event = "HypnosDreamAboutSayingLittle01"
    }
    {
      Id = "Hypnos_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Punya kekhawatiran yang mengganjal atau mimpi buruk yang bikin murung? Nah, {#Emph}tak lama lagi!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat01"
    }
    {
      Id = "Hypnos_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini dia Selamanmu berikutnya. Usahakan jangan mati kali ini, ya?"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat02"
    }
    {
      Id = "Hypnos_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin melihatmu berhasil sampai {#Emph}ke akhir {#Prev}kali ini! Atau mati di tengah jalan!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat03"
    }
    {
      Id = "Hypnos_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mustahil Selam Mimpi yang {#Emph}ini {#Prev}bakal selancar yang terakhir, kalau kau tanya padaku!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat04"
    }
    {
      Id = "Hypnos_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita lihat apa tidurmu malam ini bisa {#Emph}lebih nyenyak lagi {#Prev}dari sebelumnya, ya?"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat05"
    }
    {
      Id = "Hypnos_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau Selam Mimpi lagi, ya? Yah, untuk itulah aku ada di sini! Untuk itulah kita {#Emph}berdua {#Prev}ada di sini!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat06"
    }
    {
      Id = "Hypnos_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidur malam yang nyenyak menanti! Kau hanya perlu bertarung sekuat tenaga!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat07"
    }
    {
      Id = "Hypnos_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di mana Selam Mimpi ini akan memulaimu? Ayo kita cari tahu!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat08"
    }
    {
      Id = "Hypnos_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sebaiknya aku tidak tidur saat jam kerja sekarang. Pokoknya! Berangkatlah!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat10"
    }
    {
      Id = "Hypnos_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selam Mimpi bisa membawamu ke mana saja! Atau... mungkin cuma delapan tempat, entahlah!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat11"
    }
    {
      Id = "Hypnos_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya {#Emph}kau {#Prev}sudah siap menyelam lagi! Dan aku tahu {#Emph}aku {#Prev}juga siap!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat12"
    }
    {
      Id = "Hypnos_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau mau tidur nyenyak, kau datang ke tempat yang tepat! Yaitu di {#Emph}sini!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat13"
    }
    {
      Id = "Hypnos_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang kau menghabiskan banyak waktu untuk tidur! Karena {#Emph}aku {#Prev}juga begitu!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat14"
    }
    {
      Id = "Hypnos_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakakmu itu sahabatku, dan dia kirim {#Emph}salam! {#Prev}Aku juga kadang bilang begitu..."
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat15"
    }
    {
      Id = "Hypnos_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kau masih memegang sabit saudaraku! Dia tak pernah meminjamkannya pada{#Emph}ku!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat16"
    }
    {
      Id = "Hypnos_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, perasaanku bilang yang satu ini bakal jadi mimpi {#Emph}menyeramkan...!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat17"
    }
    {
      Id = "Hypnos_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Balik lagi, ya? Yah, {#Emph}aku {#Prev}juga tidak pernah merasa cukup tidur!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat18"
    }
    {
      Id = "Hypnos_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan khawatir, aku juga memimpikan hal yang sama terus-menerus!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat19"
    }
    {
      Id = "Hypnos_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah, kau kembali. Ayo segera berangkat! Siap?"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat20"
    }
    {
      Id = "Hypnos_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti sangat menyukai mimpi ini karena terus memimpikannya!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat21"
    }
    {
      Id = "Hypnos_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mimpi kita bisa membawa kita ke {#Emph}mana saja! {#Prev}Atau ke tempat-tempat yang pernah kita datangi!"
      Speaker = "Hypnos"
      Event = "HypnosDreamRunStartChat22"
    }
    {
      Id = "MelinoeField_5247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bolehkah kutawarkan Nektar ini padamu, sebagai lambang ikatan baru kita dan rasa terima kasihku karena bersedia bertemu denganku seperti ini? Kudengar kau tidak punya banyak di Griya!"
      Speaker = "Melinoe"
      Event = "HypnosDreamGift01"
    }
    {
      Id = "Hypnos_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Um, ini kan {#Emph}mimpi? {#Prev}Jadi meski kau memberiku sesuatu yang sangat bagus, barangnya tidak akan ada setelah aku bangun. Antara aku bakal sedih karenanya atau malah melupakan semuanya! Jadi tidak usah, terima kasih."
      Speaker = "Hypnos"
      Event = "HypnosDreamGift01"
    }
    {
      Id = "MelinoeField_5248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Yah, setidaknya kita sudah mencoba."
      Speaker = "Melinoe"
      Event = "HypnosDreamGift01"
    }
    {
      Id = "Hypnos_0189"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, kau berhasil, kau dapat semua bintangnya! {#Emph}Selamat!!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pasti bisa tidur nyenyak setelah semua itu!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan {#Emph}itulah {#Prev}yang dibutuhkan untuk tidur nyenyak!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0169"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, waktu kita habis, jadi selamat malam, dan kerja bagus!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fiuh{#Prev}, kau bakal bangun dengan tubuh segar bugar setelah yang satu ini!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bagus sekali! {#Prev}Kau akan beristirahat penuh sebentar lagi!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku {#Emph}tahu {#Prev}kau pasti bisa! Setidaknya tadinya kupikir mungkin kau bisa!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, kau baru saja berhak mendapatkan tidur malam yang nyenyak!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0174"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Selamat! {#Prev}Kau membantai semuanya di mimpimu!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0176"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, mantap! Kekhawatiran terburukmu sudah tertaklukkan untuk saat ini!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau berhasil! Terima kasih sudah tidak menyerah pada mimpimu!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0178"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja, satu lagi mimpi yang terwujud!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0179"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu lagi Selam Mimpi selesai dan masuk ke daftarku!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0180"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kerja bagus, kamu pantas {#Emph}mendapatkan {#Prev}Bintang-Bintang Berkilau itu malam ini!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0181"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu benar-benar paham seluk-beluk alam mimpi, ya?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0182"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertahankan ini terus dan takkan ada satu pun kekhawatiran tersisa!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0185"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang rasakan istirahat dan relaksasi menyelimuti dirimu..."
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu, sekarang teruslah tarik napas, lalu hembuskan..."
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0187"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus sekali! Sekarang rasakan {#Emph}semua {#Prev}beban pikiranmu {#Emph}meleleh sirna..."
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang biarkan dirimu melayang pergi, seperti kupu-kupu kecil..."
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pencapaian yang luar biasa, aku bakal {#Emph}bangga sekali {#Prev}kalau jadi kamu!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0184"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, kamu hebat, dan {#Emph}jauh {#Prev}lebih baik dari yang kemarin!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0183"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukira kamu bakal mengacaukannya lagi, tapi ternyata tidak!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0191"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu {#Emph}jago banget {#Prev}sampai-sampai Bintang Berkilauku habis! Tapi nanti kucari lagi, deh."
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0175"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, kamu beneran berhasil sampai sejauh ini! {#Emph}Lagi!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kadang susah ya mendapatkan tidur malam yang nyenyak?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0193"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke, sudah cukup gelisah dan bolak-balik badannya untuk malam ini...!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh{#Prev}, yang kali ini susah banget, ya...?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam-malam tertentu memang bikin pengin mati saja, ya?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0197"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah kelihatannya sakit sekali, tapi usaha yang bagus?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0203"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan sedih, mimpi kan biasanya tidak jadi kenyataan!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidur malam yang nyenyak tidak bisa didapat tanpa perjuangan!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukira kali ini kamu bakal berhasil. Apa sih yang kupikirkan {#Emph}tadi?!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Daripada membiarkan mereka memukulmu seperti itu, mendingan kamu menghindar!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo dong, aku tahu kamu bisa bermimpi lebih baik dari {#Emph}itu!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan Selam Mimpi yang {#Emph}paling dalam {#Prev}yang pernah kulihat, tapi ya sudahlah!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu yakin benar-benar mau tidur nyenyak?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan merasa bersalah! Kakakmu dulu juga sering mati dibunuh para penyihir, kok!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dikalahkan oleh sebuah {#Emph}band?! {#Prev}Mimpi memang aneh-aneh saja, ya!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Penyebab kematian, Charybdis... andai aku dapat satu Obol setiap kali melihat yang {#Emph}itu{#Prev}."
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau aku jadi kamu, mending aku mimpi main lempar tangkap sama Cerberus daripada {#Emph}itu!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Waduh{#Prev}, waktu aku memimpikan Rumah Hades, rasanya tidak seperti {#Emph}itu!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh{#Prev}, Cyclops itu {#Emph}benar-benar {#Prev}menginjak-injakmu, ya?"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada seseorang atau sesuatu yang menembakmu sampai mati di sana, {#Emph}ya? {#Prev}Ya sudahlah!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Api tetap terasa sakit bahkan di dalam mimpi, jadi saranku {#Emph}jangan {#Prev}berdiri di atasnya!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0212"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wah{#Prev}, kelihatannya dingin sekali di luar sana! Dan menyakitkan juga!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0213"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah{#Prev}, entah apa yang harus kamu lakukan menghadapi orang {#Emph}itu{#Prev}..."
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hei{#Prev}, kelihatannya mirip seperti sahabat karibku yang membunuhmu tadi!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0215"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu benar-benar tidak boleh membiarkan Cyclops menginjakmu seperti itu!"
      Speaker = "Hypnos"
      Event = "NPC_Hypnos_DreamRun.DeathTauntVoiceLines"
    }
    {
      Id = "Hypnos_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dah-dah!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpi indah!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Teruslah bermimpi!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bermimpilah terus!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Daa!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat tinggal!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidur nyenyak, ya!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa lagi!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai nanti!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kamu pasti bisa!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berangkatlah!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jaga diri, ya!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Santai saja!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih sudah mampir!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "Hypnos_0228"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku menyayangimu! Sampai jumpa!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "MelinoeField_5268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aargh!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "MelinoeField_5269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, Tuanku!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "MelinoeField_5270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamRunStartLines"
    }
    {
      Id = "MelinoeField_5237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}Segala Hal Tentang... Selam Mimpi...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DreamRunInfoReactionLines"
    }
    {
      Id = "Hypnos_0153"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Brosur lama yang sama!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunInfoReactionLines"
    }
    {
      Id = "Hypnos_0154"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Butuh pengingat?"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunInfoReactionLines"
    }
    {
      Id = "Hypnos_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Santai saja!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunInfoReactionLines"
    }
    {
      Id = "Hypnos_0156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Brosur yang bagus, {#Emph}kan?"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.DreamRunInfoReactionLines"
    }
    {
      Id = "MelinoeField_5447"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu mirip Hypnos..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HypnosStandeeSpottedVoiceLines"
    }
    {
      Id = "MelinoeField_5449"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah itu Anda, Tuan Hypnos...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HypnosStandeeSpottedVoiceLines"
    }
    {
      Id = "MelinoeField_5448"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa dibilang, itu Hypnos..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HypnosStandeeSpottedVoiceLines"
    }
    {
      Id = "MelinoeField_5450"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada Hypnos lain di sana..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HypnosStandeeSpottedVoiceLines"
    }
    {
      Id = "MelinoeField_5441"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuali yang agak aneh..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.HypnosStandeeSpottedVoiceLines"
    }
    {
      Id = "Hypnos_0147"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hei...!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.HypnosStandeeOnHitVoiceLines"
    }
    {
      Id = "Hypnos_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, ayolah!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.HypnosStandeeOnHitVoiceLines"
    }
    {
      Id = "Hypnos_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Memangnya apa yang {#Emph}kulakukan?"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.HypnosStandeeOnHitVoiceLines"
    }
    {
      Id = "Hypnos_0150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Santai dulu!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.HypnosStandeeOnHitVoiceLines"
    }
    {
      Id = "Hypnos_0151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Woa, {#Emph}santai!"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.HypnosStandeeOnHitVoiceLines"
    }
    {
      Id = "Hypnos_0152"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Menguap>"
      Speaker = "Hypnos"
      Event = "GlobalVoiceLines.HypnosStandeeOnHitVoiceLines"
    }
    {
      Id = "Intercom_8243"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus sekali, kurasa aksimu {#Emph}hebat!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kerja bagus sejauh ini, tapi masih ada tempat-tempat lain yang harus kau tuju!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada kemajuan bagus! {#Emph}Lanjut terus!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa pun yang kau lakukan, jangan berlama-lama di dalam sana!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu kau pasti bisa! Setidaknya kurasa begitu!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8250"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Coba pertahankan ini! Atau mati selagi mencoba!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau berhasil sampai {#Emph}sejauh {#Prev}ini, tapi apa kau bisa sampai ke akhir?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ya, teruslah bertarung dengan segenap kemampuanmu!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu ke mana tujuanmu berikutnya, tapi aku tak mau memberi tahu!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu sampai kau lihat ke mana Selam Mimpi ini membawamu berikutnya!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpi membawamu ke tempat-tempat paling aneh, ya?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aksimu keren, tapi jangan lengah {#Emph}atau rasakan akibatnya!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh{#Prev}, kau benar-benar dihajar telak tadi, ya?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8249"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, {#Emph}tadi {#Prev}itu hampir saja!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, kau selamat dari babak yang {#Emph}mudah!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, tadi itu {#Emph}tidak {#Prev}terlalu sulit, kan?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Perjalanan masih {#Emph}jauh{#Prev}... tapi kerja bagus!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang di Graha Hades! Ayo jalan terus!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mulai dari sini bakal makin sulit!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tarik napas dulu kalau mau, tapi kurasa kau bakal {#Emph}baik-baik saja!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan {#Emph}terlalu {#Prev}santai, kau {#Emph}belum {#Prev}sampai!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Emm {#Prev}jangan lancang mengaduk-aduk barang di sini, oke?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8264"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tidak tahu ini barang milik siapa, memangnya {#Emph}kau tahu?"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8265"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lanjut terus, kau {#Emph}hampir sampai!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kurasa kau bakal berhasil sampai {#Emph}tuntas!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sudah sejauh ini, dan ini sudah tiga perempat jalan!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bayangkan saja empat Bintang Berkilau yang masih bisa kau dapatkan!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertahankan ini, dan kau bakal dapat empat Bintang Berkilau lagi!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, Penyelamanmu kali ini {#Emph}sungguh {#Prev}dalam!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tinggal satu perhentian lagi lalu Penyelaman ini selesai!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8273"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau berhasil sampai sejauh ini, {#Emph}pertahankan! {#Prev}Atau tidak juga tak apa."
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8274"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah {#Prev}wanita tua tadi sama sekali {#Emph}tak berkutik!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8275"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau aku jadi wanita tua itu, aku bakal terus memanggil lebih banyak penyihir sepanjang waktu!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8276"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kerja bagus sudah membantai band musik tadi!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8277"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Penampilan tadi lumayan keren juga! Maksudku penampilan bandnya!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8278"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, kau mengalahkan anjing Majikan!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8279"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Padahal kukira yang bisa dilakukan Cerberus cuma duduk-duduk santai!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8280"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pria tua yang kau kalahkan tadi lumayan tangguh juga!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu tidak {#Emph}berhenti {#Prev}dalam Selam Mimpi, malah {#Emph}melesat begitu cepat!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8282"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bermimpi memukul Kiklops buta saja aku tak sudi, tapi ya itu kan aku!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8283"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku suka menutup mataku {#Emph}persis {#Prev}seperti si {#Emph}Kiklops {#Prev}tadi. Bedanya {#Emph}mataku {#Prev}ada {#Emph}dua!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8284"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau punya sayap seperti wanita tadi, aku pasti sudah terbang kabur menyingkir!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8285"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Waduh{#Prev}, barusan itu bukan salah satu saudariku yang kau habisi?!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8286"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Orang yang kaulawan tadi tahu {#Emph}segalanya{#Prev}, termasuk {#Emph}cara untuk kalah!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8287"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mengalahkan pria-elang tak bersenjata yang bersimbah darah itu lagi, {#Emph}kerja bagus!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8288"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Woaah{#Prev}, kau melawan dua orang itu sekaligus dan {#Emph}menang?!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8289"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tadi itu mana mungkin Herakles, kan?!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makhluk apa sebenarnya {#Emph}itu {#Prev}barusan, {#Emph}besar sekali!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8290"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bahkan lebih mengerikan daripada monster yang barusan kau kalahkan itu!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak kusangka kau bisa tidur nyenyak melewati semua kegilaan itu!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
    {
      Id = "Intercom_8293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukira kau {#Emph}pasti {#Prev}bakal mati di sana tadi, {#Emph}hebat juga!"
      Speaker = "Intercom"
      Event = "GlobalVoiceLines.HypnosPostBossVoiceLines"
    }
  ]
}
