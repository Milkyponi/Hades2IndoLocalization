      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0645"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ini {#Prev}baru pertarungan yang sesungguhnya!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0646"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nah, {#Prev}ini baru baku hantam!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0647"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pikir bisa mengalahkan{#Emph}ku?!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0650"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak perlu lagi menahan {#Emph}diri!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0651"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah {#Emph}lama sekali {#Prev}aku tidak merasakan ini!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0652"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sensasi darah{#Emph}ku sendiri!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0653"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semua ini akan segera {#Emph}berakhir!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0655"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami {#Emph}takkan pernah {#Prev}tunduk pada dewa mana pun!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0656"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapan kau akan {#Emph}kapok?"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0657"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita belum selesai!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0658"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, penyihir, sekarang kita {#Emph}bertempur!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0659"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terkutuklah kau {#Emph}dan {#Prev}sihirmu, penyihir!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0648"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pikir bisa mengalahkan {#Emph}kami?!"
      Speaker = "Heracles"
      Event = "Heracles.AIStages.StageTransitionVoiceLines"
    }
    {
      Id = "Heracles_0649"
