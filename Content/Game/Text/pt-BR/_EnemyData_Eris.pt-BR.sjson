      Speaker = "Eris"
      Event = "Eris.PlayerInjuredVoiceLines"
    }
    {
      Id = "ErisField_0075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kena kau."
      Speaker = "Eris"
      Event = "Eris.PlayerInjuredVoiceLines"
    }
    {
      Id = "ErisField_0076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau nambah?"
      Speaker = "Eris"
      Event = "Eris.PlayerInjuredVoiceLines"
    }
    {
      Id = "ErisField_0077"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gimana rasanya, hah?"
      Speaker = "Eris"
      Event = "Eris.PlayerInjuredVoiceLines"
    }
    {
      Id = "ErisField_0078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih banyak stok peluruku."
      Speaker = "Eris"
      Event = "Eris.PlayerInjuredVoiceLines"
    }
    {
      Id = "ErisField_0079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tinggal kubur aja lu."
      Speaker = "Eris"
      Event = "Eris.PlayerInjuredVoiceLines"
    }
    {
      Id = "ErisField_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seru banget, 'kan?"
      Speaker = "Eris"
      Event = "Eris.PlayerInjuredVoiceLines"
    }
    {
      Id = "ErisField_0081"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh{#Prev}, kasihan deh!"
      Speaker = "Eris"
      Event = "Eris.PlayerInjuredVoiceLines"
    }
    {
      Id = "ErisField_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih sanggup berdiri, {#Emph}hah?"
      Speaker = "Eris"
      Event = "Eris.LastStandReactionVoiceLines"
    }
    {
      Id = "ErisField_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menyerah {#Emph}saja!"
      Speaker = "Eris"
      Event = "Eris.LastStandReactionVoiceLines"
    }
    {
      Id = "ErisField_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayolah, yang {#Emph}bener aja!"
      Speaker = "Eris"
      Event = "Eris.LastStandReactionVoiceLines"
    }
    {
      Id = "ErisField_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mati saja {#Emph}sana!"
      Speaker = "Eris"
      Event = "Eris.LastStandReactionVoiceLines"
    }
    {
      Id = "ErisField_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lagi?"
      Speaker = "Eris"
      Event = "Eris.LastStandReactionVoiceLines"
    }
    {
      Id = "ErisField_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, {#Emph}serius nih?"
      Speaker = "Eris"
      Event = "Eris.LastStandReactionVoiceLines"
    }
    {
      Id = "ErisField_0342"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kesempatan {#Emph}teraaakhir!"
      Speaker = "Eris"
      Event = "Eris.LastStandReactionVoiceLines"
    }
    {
      Id = "ErisField_0343"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nggak ada kesalahan lagi!"
      Speaker = "Eris"
      Event = "Eris.LastStandReactionVoiceLines"
    }
    {
      Id = "ErisField_0344"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kali ini bakal kuakhiri!"
      Speaker = "Eris"
      Event = "Eris.LastStandReactionVoiceLines"
    }
    {
      Id = "ErisField_0433"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Moros...!"
      Speaker = "Eris"
      Event = "Eris.BlockDeathReactionVoiceLines"
    }
    {
      Id = "ErisField_0434"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tukang curang!"
      Speaker = "Eris"
      Event = "Eris.BlockDeathReactionVoiceLines"
    }
    {
      Id = "ErisField_0435"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jarum sialan itu!"
      Speaker = "Eris"
      Event = "Eris.BlockDeathReactionVoiceLines"
    }
    {
      Id = "ErisField_0436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Padahal {#Emph}sedikit {#Prev}lagi!"
      Speaker = "Eris"
      Event = "Eris.BlockDeathReactionVoiceLines"
    }
    {
      Id = "ErisField_0431"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tembakanku kau bakar semua?!"
      Speaker = "Eris"
      Event = "Eris.ShotsDestroyedReactionVoiceLines"
    }
    {
      Id = "ErisField_0432"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tembakanku nggak bisa tembus?!"
      Speaker = "Eris"
      Event = "Eris.ShotsDestroyedReactionVoiceLines"
    }
    {
      Id = "ErisField_0301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak {#Emph}akan!"
      Speaker = "Eris"
      Event = "Eris.ResistedVoiceLines"
    }
    {
      Id = "ErisField_0302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku nggak bakal pernah tobat!"
      Speaker = "Eris"
      Event = "Eris.ResistedVoiceLines"
    }
    {
      Id = "ErisField_0160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa-apaan nih?!"
      Speaker = "Eris"
      Event = "Eris.OnHitVoiceLines"
    }
    {
      Id = "ErisField_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hei{#Prev}, ada {#Emph}masalah apa sih?"
      Speaker = "Eris"
      Event = "Eris.OnHitVoiceLines"
    }
    {
      Id = "ErisField_0426"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku {#Emph}benci {#Prev}katak!"
