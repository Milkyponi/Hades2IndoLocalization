    }
    {
      Id = "ErisField_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beneran nih!"
      Speaker = "Eris"
      Event = "Eris.LowHealthVoiceLines"
    }
    {
      Id = "ErisField_0098"
      InheritFrom = "BaseSubtitle"
