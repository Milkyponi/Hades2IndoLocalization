      Event = "Eris.CriticalHealthVoiceLines"
    }
    {
      Id = "ErisField_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Sayang!"
      Speaker = "Eris"
      Event = "Eris.CriticalHealthVoiceLines"
    }
    {
      Id = "ErisField_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh!"
      Speaker = "Eris"
      Event = "Eris.CriticalHealthVoiceLines"
    }
    {
      Id = "ErisField_0094"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau..."
      Speaker = "Eris"
      Event = "Eris.CriticalHealthVoiceLines"
    }
    {
      Id = "ErisField_0095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak asyik...!"
      Speaker = "Eris"
      Event = "Eris.CriticalHealthVoiceLines"
    }
    {
      Id = "ErisField_0092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ungh!"
      Speaker = "Eris"
      Event = "Eris.CriticalHealthVoiceLines"
    }
    {
      Id = "ErisField_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Guh!"
      Speaker = "Eris"
      Event = "Eris.CriticalHealthVoiceLines"
    }
    {
      Id = "ErisField_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tega banget kau... se-{#Emph}kejam {#Prev}ini...?"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Jangan! {#Prev}Ngganggangga, ayolah, tunggu dulu!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0115"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aduh jangan lagi, {#Emph}jangan lagi!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, {#Emph}haha! {#Prev}Bakal kubalas kau nanti!!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kira-in kita temenan?!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tega banget kau giniin aku, Sayang?!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0119"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dingin... gelap... {#Emph}ungh..."
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak...! Kau bikin kesalahan besar...!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0346"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Balik ke bayangan... sekarang...?"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0347"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tapi aku nggak mau pergi, aku baru aja {#Emph}sampai!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0348"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak bakal bisa seret aku ke neraka tanpa perlawanan!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0349"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tawa terakhir selalu jadi milikku, Sayang! {#Emph}Hahaha-aduh!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh duh duh duh duh duh DUH!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aku... tinggal... terbang... balik!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0484"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Iya-iya{#Prev}, aku pergi nih. {#Emph}Daaah!"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Augh! {#Prev}Jam yang sama besok lagi, Sayang?"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0482"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh! {#Prev}Bisa nggak kasih aku {#Emph}kesempatan {#Prev}lain kali?"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0483"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ungh{#Prev}, kenapa sih ini selalu {#Emph}menimpaku?"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0485"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gimana bisa... kau jadi secepat itu?"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "ErisField_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masa seranganku nggak kena {#Emph}sekali pun?"
      Speaker = "Eris"
      Event = "Eris.ErisDeathVoiceLines"
    }
    {
      Id = "MelinoeField_1907"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau yang mulai duluan."
      Speaker = "Melinoe"
      Event = "Eris.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1908"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia yang mulai duluan."
      Speaker = "Melinoe"
      Event = "Eris.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1909"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Enyahlah dari sini."
      Speaker = "Melinoe"
      Event = "Eris.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1910"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pergi sana."
      Speaker = "Melinoe"
      Event = "Eris.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1911"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ingat baik-baik itu."
      Speaker = "Melinoe"
      Event = "Eris.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1912"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia memang nggak pernah kapok."
      Speaker = "Melinoe"
      Event = "Eris.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1913"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa, Strife."
      Speaker = "Melinoe"
      Event = "Eris.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_1914"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jauh lebih baik..."
      Speaker = "Melinoe"
      Event = "Eris.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5587"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tak bisa lagi menggangguku seperti dulu."
      Speaker = "Melinoe"
      Event = "Eris.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5588"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selalu menyenangkan berurusan denganmu, Eris versi mimpi."
      Speaker = "Melinoe"
      Event = "Eris.BossKillVoiceLines"
    }
    {
      Id = "ErisField_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Halo, pelaut! Kebetulan banget ya, kita ketemu begini {#Emph}jauh banget {#Prev}dari rumah. Mau ke mana, nih? Kali aja aku bisa kasih tumpangan."
      Speaker = "Eris"
      Event = "ErisBossFirstMeeting"
    }
    {
      Id = "MelinoeField_1806"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu persis ke mana tujuanku. Dan aku bisa ke sana sendiri, terima kasih."
      Speaker = "Melinoe"
      Event = "ErisBossFirstMeeting"
    }
    {
      Id = "ErisField_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yakin nih? Soalnya kelihatannya malammu sejauh ini {#Emph}cukup {#Prev}berat, tuh. Dan bakal makin parah lagi."
      Speaker = "Eris"
      Event = "ErisBossFirstMeeting"
    }
    {
      Id = "MelinoeField_1807"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak peduli dengan sindiranmu, Eris. Bicara yang jelas, atau menyingkir dari jalanku."
      Speaker = "Melinoe"
      Event = "ErisBossFirstMeeting"
    }
    {
      Id = "ErisField_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku bakal terus terang: Kau itu membosankan. Aku {#Emph}nggak suka {#Prev}sama kau. Dan kau nggak berhak ngatur-ngatur aku...!"
      Speaker = "Eris"
      Event = "ErisBossFirstMeeting"
    }
    {
      Id = "ErisField_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, {#Emph}serius nih? {#Prev}Kukira aku udah cukup jelasin ke kau sebelumnya, tapi kau malah nongol lagi seolah nggak terjadi apa-apa, kayak malam biasa aja!"
      Speaker = "Eris"
      Event = "ErisBossAboutObstacles01"
    }
    {
      Id = "MelinoeField_1920"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini {#Emph}memang {#Prev}hanya malam biasa bagiku, Eris. Kau berpihak pada Chronos melawan para dewa, lalu kenapa? Kau cuma rintangan lain di jalanku."
      Speaker = "Melinoe"
      Event = "ErisBossAboutObstacles01"
    }
    {
      Id = "ErisField_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak enak nih ngomongnya, Biang Masalah: Rintangan itu hal yang harusnya kau {#Emph}hindari! {#Prev}Tapi di selat {#Emph}ini{#Prev}, kau bakal terus ketemu aku {#Emph}setiap waktu{#Prev}."
      Speaker = "Eris"
      Event = "ErisBossAboutObstacles01"
    }
    {
      Id = "MelinoeField_3267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa kau mengerahkan seluruh tokomu cuma untuk menghentikanku? Kau itu Perselisihan; harusnya kau tak terduga! Mungkin sekali-kali seranglah pasukan Chronos, biar ada variasi..."
      Speaker = "Melinoe"
      Event = "ErisBossAboutRandomness01"
    }
    {
      Id = "ErisField_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata siapa aku {#Emph}nggak {#Prev}nyerang mereka? Kau bukan pusat alam semesta, Sayang! Dan aku ini udah {#Emph}paling {#Prev}nggak terduga! Nggak tahu juga kenapa aku terus papasan sama kau. Bener-bener {#Emph}random {#Prev}banget!"
      Speaker = "Eris"
      Event = "ErisBossAboutRandomness01"
    }
    {
      Id = "ErisField_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau coba lagi? Kadang aku nggak bisa bedain kau itu keras kepala, atau emang dasarnya... {#Emph}ya {#Prev}begitulah. Nggak penting juga sih."
      Speaker = "Eris"
      Event = "ErisBossAboutMistakes01"
    }
    {
      Id = "MelinoeField_1921"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menghalangi jalanku menuju tujuanku, Eris... atau melayang menghalangi. Intinya, cepat atau lambat, kau akan menyadari bahwa itu sebuah kesalahan."
      Speaker = "Melinoe"
      Event = "ErisBossAboutMistakes01"
    }
    {
      Id = "ErisField_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, tapi kita semua kan bikin kesalahan, iya kan? Kalau nggak, kita berdua nggak bakal ada di sini. Jadi, udah siap belum, nih? Ayo kita {#Emph}senang-senang{#Prev}."
      Speaker = "Eris"
      Event = "ErisBossAboutMistakes01"
    }
    {
      Id = "ErisField_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keren banget kan {#Emph}ini{#Prev}, Biang Masalah? Nah, sebelum kutembak kau sampai hancur lebur, aku cuma mau kita berdua luangkan waktu sebentar buat {#Emph}tarik napas, rileks... {#Prev}bener-bener nikmati apa yang kita punya saat ini."
      Speaker = "Eris"
      Event = "ErisBossAboutRelaxation01"
    }
    {
      Id = "MelinoeField_1922"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertarungan tak berguna denganmu ini... sejujurnya aku sama sekali tak menikmatinya. Tapi, setidaknya Bulan malam ini tampak indah, bukan?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutRelaxation01"
    }
    {
      Id = "ErisField_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nah, gitu {#Prev}dong! Sekarang gimana kalau cahaya pucatnya itu kita lumuri darah dan ikhor, hah? Sekalian biar laut puas menengguknya!"
      Speaker = "Eris"
      Event = "ErisBossAboutRelaxation01"
    }
    {
      Id = "ErisField_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pikir cuma gara-gara kau sok akrab denganku di Persimpangan, aku bakal mengalah padamu di sini? Wah, kau salah besar, Sayang! Aku tahu apa maumu."
      Speaker = "Eris"
      Event = "ErisBossAboutRelationship01"
    }
    {
      Id = "MelinoeField_3075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu tujuanku karena aku sudah berkali-kali menjelaskannya secara gamblang. Namun, kau masih saja berpura-pura seolah ada sesuatu yang jauh lebih rumit di balik ini."
      Speaker = "Melinoe"
      Event = "ErisBossAboutRelationship01"
    }
    {
      Id = "ErisField_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, dan sekarang kau malah coba bikin aku merasa bersalah. Asal tahu aja, aku nggak sudi dengar omong kosongmu itu. Nggak ada yang bisa ngatur-ngatur aku, paham?"
      Speaker = "Eris"
      Event = "ErisBossAboutRelationship01"
    }
    {
      Id = "MelinoeField_3076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu siap dan bernafsu untuk bertarung. Aku belum pernah bertemu orang yang begitu berapi-api, tapi sama sekali tak punya tujuan."
      Speaker = "Melinoe"
      Event = "ErisBossAboutPurpose01"
    }
    {
      Id = "ErisField_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pikiranmu bakal meledak nih, udah siap belum, Sayang? Nggak punya tujuan {#Emph}adalah {#Prev}sebuah tujuan. Pikirin deh itu! Dan sekarang, giliran sisa tubuhmu yang bakal kuledekkan."
      Speaker = "Eris"
      Event = "ErisBossAboutPurpose01"
    }
    {
      Id = "ErisField_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lebih tangguh dari kelihatannya, kuakui itu, Biang Masalah. Dan aku bakal kasih kau hal {#Emph}lain {#Prev}atas apa yang kau perbuat padaku waktu itu."
      Speaker = "Eris"
      Event = "ErisBossAboutConsequences01"
    }
    {
      Id = "MelinoeField_1923"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hasil dari pertemuan kita sebelumnya adalah buah dari provokasi dan kebencianmu sendiri. Malam ini bisa saja berakhir lebih buruk lagi."
      Speaker = "Melinoe"
      Event = "ErisBossAboutConsequences01"
    }
    {
      Id = "ErisField_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, maksudmu pilihan kita punya {#Emph}a-a-akibat...? Ayolah{#Prev}, jangan gampang dibodohi gitu. Pokoknya! Aku bakal mulai nembak sekarang."
      Speaker = "Eris"
      Event = "ErisBossAboutConsequences01"
    }
    {
      Id = "MelinoeField_3082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, terutama bagi seseorang yang mengaku hidup dari kekacauan murni, kau {#Emph}sangat {#Prev}tepat waktu dan konsisten, Eris. Setiap kali aku melintasi Retakan, kau selalu ada di sini."
      Speaker = "Melinoe"
      Event = "ErisBossAboutProblems01"
    }
    {
      Id = "ErisField_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak usah diperjelas juga kali! Dengar ya, aku tahu ini mulai jadi masalah, tapi sumpah, aku bisa mengendalikannya. Janji dulu kau nggak bakal cerita ke siapa-siapa?"
      Speaker = "Eris"
      Event = "ErisBossAboutProblems01"
    }
    {
      Id = "MelinoeField_3083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ingin aku berjanji untuk tidak memberitahu siapa pun bahwa kau orang yang tepat waktu dan konsisten? Kenapa, karena kau tak sudi mereka mulai memandangmu lebih baik untuk sekali saja?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutProblems01"
    }
    {
      Id = "ErisField_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Em, {#Emph}ya iyalah! {#Prev}Meskipun, sejak kapan juga aku peduli sama omongan orang tentangku...? Itu bukan aku banget! Ini semua gara-gara kau yang bikin reputasiku rusak!"
      Speaker = "Eris"
      Event = "ErisBossAboutProblems01"
    }
    {
      Id = "MelinoeField_4060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau belum pernah sekalipun terlambat dalam duel kita — secepat apa pun aku mencapai pantai ini, kau selalu tiba duluan. Tapi bukankah tujuanmu adalah menjadi {#Emph}kurang {#Prev}bisa diandalkan, bukan malah {#Emph}sebaliknya{#Prev}?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutProblems02"
    }
    {
      Id = "ErisField_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tujuanku adalah {#Emph}nggak pernah {#Prev}punya tujuan seumur hidupku! Cuma ya, kayaknya aku lagi lewat fase tertentu aja. Gara-gara persaingan sama kau dan Nemmie, jadinya kebawa begini."
      Speaker = "Eris"
      Event = "ErisBossAboutProblems02"
    }
    {
      Id = "MelinoeField_4061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan menurutmu apa yang sebenarnya sedang {#Emph}kita {#Prev}perebutkan? Siapa yang paling cepat dipaksa kembali ke dasar Dunia Bawah?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutProblems02"
    }
    {
      Id = "ErisField_0438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak pernah kubilang aku saingan sama kau kok, Sayang. Dan kau tahu apa yang kusadari dari semua hal yang kita lakuin ini? Disiplin dan Kekacauan itu berjalan beriringan."
      Speaker = "Eris"
      Event = "ErisBossAboutProblems02"
    }
    {
      Id = "ErisField_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin bukan hal buruk juga sih kalau aku terus nongol tepat waktu. {#Emph}Kau selalu bisa mengandalkan sang Perselisihan! {#Prev}Kedengarannya keren juga, kan?"
      Speaker = "Eris"
      Event = "ErisBossAboutProblems03"
    }
    {
      Id = "MelinoeField_4062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau ingin bisa diandalkan, itu artinya bukan cuma datang tepat waktu, tapi juga berguna dalam beberapa hal. Meski kurasa itu mungkin hal yang mustahil bagimu."
      Speaker = "Melinoe"
      Event = "ErisBossAboutProblems03"
    }
    {
      Id = "ErisField_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka kau hampir membuatku berpikir ada yang salah denganku, cuma gara-gara aku {#Emph}peduli! {#Prev}Tapi tenang saja... setidaknya aku bakal pastikan ada {#Emph}sesuatu {#Prev}yang salah sekarang!"
      Speaker = "Eris"
      Event = "ErisBossAboutProblems03"
    }
    {
      Id = "ErisField_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hampir semua penghuni Olympus memberimu kemampuan terbaik mereka, ya? Kau pasti {#Emph}bangga {#Prev}sekali. Padahal para dewa jarang sekali bisa akur."
      Speaker = "Eris"
      Event = "ErisBossAboutAres01"
    }
    {
      Id = "MelinoeField_3078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang tidak. Tapi saat dibutuhkan, mereka bisa mengesampingkan perbedaan. Sesuatu yang patut kau coba dengan keluargamu sendiri."
      Speaker = "Melinoe"
      Event = "ErisBossAboutAres01"
    }
    {
      Id = "ErisField_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu siapa yang benar-benar paham situasi di atas sana? Ares. Kalau ada yang bisa menyatukan keluarga {#Emph}itu{#Prev}, dialah sang dewa perang. Tujuan {#Emph}dia {#Prev}bahkan bisa kudukung!"
      Speaker = "Eris"
      Event = "ErisBossAboutAres01"
    }
    {
      Id = "MelinoeField_3079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau begitu mengagumi Ares, ketahuilah bahwa dia telah meminjamkan bantuannya padaku; aku mengantongi berkatnya bahkan saat ini. Meski kurasa kau tetap tak akan mau minggir?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutAres02"
    }
    {
      Id = "ErisField_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tebakanmu tepat sekali! Dan anggaplah Ares {#Emph}memang {#Prev}menutupi semua kelemahanmu, itu mungkin karena dia ingin perang ini {#Emph}terus {#Prev}dan {#Emph}terus berlanjut! {#Prev}Dia bisa bantu {#Emph}kau{#Prev}; aku bisa bantu {#Emph}dia."
      Speaker = "Eris"
      Event = "ErisBossAboutAres02"
    }
    {
      Id = "ErisField_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka Ares malah membantu {#Emph}kau{#Prev}, bukan aku. Aku terus mencoba menghubunginya, mengira dia bakal mendengarkanku, tapi badai di Olympus terlalu ribut. Hei, maukah kau...? Kau tahu lah..."
      Speaker = "Eris"
      Event = "ErisBossAboutAres03"
    }
    {
      Id = "MelinoeField_3264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ingin aku meminta dewa perang meminjamkan bantuannya padamu, demi membuat usahaku mendukungnya dan keluarganya dalam pertempuran hampir mustahil melawan Typhon jadi kian sulit?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutAres03"
    }
    {
      Id = "ErisField_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hentikan {#Emph}sarkasmemu{#Prev}, Biang Masalah! Aku cuma minta bantuanmu {#Emph}sekali{#Prev}, tapi... kau malah menjadikannya {#Emph}penghinaan. {#Prev}{#Emph}Baguslah! {#Prev}Aku bisa menarik perhatian sang dewa perang dengan caraku {#Emph}sendiri!"
      Speaker = "Eris"
      Event = "ErisBossAboutAres03"
    }
    {
      Id = "ErisField_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waduh, Biang Masalah, kau jadi {#Emph}raksasa! {#Prev}Kayak anak hasil hubunganmu dengan Nemmie! Yang kalau dipikir-pikir, itu hal paling {#Emph}mengerikan {#Prev}yang pernah kubayangkan. Padahal imajinasiku {#Emph}liar sekali."
      Speaker = "Eris"
      Event = "ErisBossAboutCirce01"
    }
    {
      Id = "MelinoeField_3084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu bayangkan apa yang akan kulakukan padamu dalam wujud ini, persembahan dari Circe sang Penyihir. Andai kau tak begitu bengal, kau bisa saja belajar langsung darinya."
      Speaker = "Melinoe"
      Event = "ErisBossAboutCirce01"
    }
    {
      Id = "ErisField_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu belajar jadi {#Emph}orang aneh{#Prev}? Itulah bedanya kau dan aku: Kau butuh seseorang untuk mengajarimu {#Emph}segalanya{#Prev}, sedangkan {#Emph}aku {#Prev}punya insting murni!"
      Speaker = "Eris"
      Event = "ErisBossAboutCirce01"
    }
    {
      Id = "ErisField_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah, hahaha{#Prev}, kau {#Emph}kecil {#Prev}banget sekarang, Sayang! {#Emph}Lucu {#Prev}amat. Pasti ulah Circe tua itu, ya? Aku pernah terbang melewati pulau kecilnya tempat dia melakukan semua eksperimen gilanya."
      Speaker = "Eris"
      Event = "ErisBossAboutCirce02"
    }
    {
      Id = "MelinoeField_3085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau punya potensi besar sebagai murid, Eris... bahkan sekarang pun kau bisa mengenali karya penyihir berpengalaman dengan mudah. Tapi hanya untuk mencemooh seni kami."
      Speaker = "Melinoe"
      Event = "ErisBossAboutCirce02"
    }
    {
      Id = "ErisField_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seni kalian itu mengubahmu jadi bahan lelucon berjalan! Aku cuma menunjukkan faktanya. Yah, apa pun yang terjadi setelah ini, makasih ya hiburannya!"
      Speaker = "Eris"
      Event = "ErisBossAboutCirce02"
    }
    {
      Id = "ErisField_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu bocah Arwah kurus itu, siapa namanya...? {#Emph}Ick, Icky... Icarus! {#Prev}Kulihat dia curi-curi pandang, terbang kesana-kemari... {#Emph}meniru {#Prev}gayaku! Dari mana dia dapat {#Emph}sayap-sayap {#Prev}itu?"
      Speaker = "Eris"
      Event = "ErisBossAboutIcarus01"
    }
    {
      Id = "MelinoeField_3268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Icarus jelas-jelas tidak menirumu. Ini mungkin mengejutkanmu, tapi ada pihak-pihak yang saat ini berusaha untuk berguna... alih-alih mengacaukan rencana kami."
      Speaker = "Melinoe"
      Event = "ErisBossAboutIcarus01"
    }
    {
      Id = "ErisField_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pikir dia {#Emph}berusaha untuk berguna? Pfft{#Prev}, yang {#Emph}benar saja! {#Prev}Dia cuma bocah aneh. Mungkin dia naksir para {#Emph}Harpy {#Prev}dan berusaha mendekati mereka... tapi ya sudahlah, siapa peduli!"
      Speaker = "Eris"
      Event = "ErisBossAboutIcarus01"
    }
    {
      Id = "ErisField_0358"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aww, lihaaatt! {#Prev}Kau bawa burung kecil jelek bersamamu! Cuma itu yang paling mendekati sayap seperti {#Emph}ini{#Prev}, Sayang. Tapi kau harus berjalan kaki ke mana-mana. Pantas {#Emph}saja {#Prev}kau murung melulu!"
      Speaker = "Eris"
      Event = "ErisBossAboutRavenFamiliar01"
    }
    {
      Id = "MelinoeField_3269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}tidak {#Prev}murung. Dan sebagian besar perjalananku ke sini naik perahu, terima kasih banyak! Malahan beberapa perahu! Dan aku tidak akan membiarkanmu menghina Raki di depan wajahku, atau wajahnya."
      Speaker = "Melinoe"
      Event = "ErisBossAboutRavenFamiliar01"
    }
    {
      Id = "ErisField_0359"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sayang{#Prev}, ayolah.{#Prev} Burung itu pucat sekali sampai-sampai kelihatannya mau {#Emph}mati! {#Prev}Sini, mungkin aku bisa mengakhiri penderitaannya. Dan penderitaan{#Emph}mu{#Prev} juga."
      Speaker = "Eris"
      Event = "ErisBossAboutRavenFamiliar01"
    }
    {
      Id = "ErisField_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah selesai belanjanya, Biang Masalah? Charon kelihatannya punya banyak stok di kapal mewahnya itu! Padahal dia sama sekali belum menjual apa-apa ke {#Emph}aku."
      Speaker = "Eris"
      Event = "ErisBossAboutCharon01"
    }
    {
      Id = "MelinoeField_4065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa dia takkan pernah mau. Yang Mulia Charon setia pada alam baka. Kau tidak. Sesederhana itu, meskipun kau ini saudarinya."
      Speaker = "Melinoe"
      Event = "ErisBossAboutCharon01"
    }
    {
      Id = "ErisField_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Setia pada alam baka. {#Prev}Setidaknya aku bukan penjilat! Tapi kalau kau begitu {#Emph}menyukainya{#Prev}, ini ada sesuatu yang bisa bikin kau merintih kesakitan."
      Speaker = "Eris"
      Event = "ErisBossAboutCharon01"
    }
    {
      Id = "ErisField_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cahaya bulan benar-benar memandu langkahmu malam ini! Sayang sekali Selene tak bisa langsung mengantarmu ke Olympus dengan kereta perangnya itu. Lagipula kenapa dia {#Emph}tak bisa{#Prev}? Bukannya dia temanmu!"
      Speaker = "Eris"
      Event = "ErisBossAboutSelene01"
    }
    {
      Id = "MelinoeField_4066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin Selene tidak begitu saja meninggalkan tanggung jawabnya, meski aku tahu konsep itu sulit kau pahami. Mau mengantarku ke Olympus sebagai gantinya?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutSelene01"
    }
    {
      Id = "ErisField_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nanti dulu deh. Sayap ini mana sanggup mengangkat kita berdua! Meskipun begitu, aku {#Emph}memang {#Prev}punya sesuatu untukmu di sini sebagai gantinya."
      Speaker = "Eris"
      Event = "ErisBossAboutSelene01"
    }
    {
      Id = "ErisField_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa sih dengan Cyclops di dekat dermaga Ephyra itu? Dia hampir mengenaku dengan batu besar waktu aku terbang lewat sana beberapa malam lalu!"
      Speaker = "Eris"
      Event = "ErisBossAboutPolyphemus01"
    }
    {
      Id = "MelinoeField_4064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu Polyphemus. Dia buta, jadi kau tak perlu menganggap lemparan batunya sebagai hinaan pribadi. Kemungkinan besar dia mengincarku."
      Speaker = "Melinoe"
      Event = "ErisBossAboutPolyphemus01"
    }
    {
      Id = "ErisField_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}syukurlah! {#Prev}Aku mengambil beberapa ekor dombanya—kau tak perlu tahu alasannya—dan sempat khawatir dia menyadarinya. Aku dapat ternaknya, {#Emph}kau {#Prev}yang kena amuknya!"
      Speaker = "Eris"
      Event = "ErisBossAboutPolyphemus01"
    }
    {
      Id = "ErisField_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, jadi {#Emph}Prometheus {#Prev}yang seharusnya memegang kendali di tempat aksi sesungguhnya terjadi? Kukira dia sedang sibuk dipatuk sampai sekarat berulang-ulang kali oleh seekor {#Emph}burung."
      Speaker = "Eris"
      Event = "ErisBossAboutPrometheus01"
    }
    {
      Id = "MelinoeField_3080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa kupastikan dia dan burung itu sudah berdamai. Ayolah, kasihani aku, Eris. Aku harus berurusan dengan api dan bulu di sini, dan akan mengalaminya lagi di puncak Olympus."
      Speaker = "Melinoe"
      Event = "ErisBossAboutPrometheus01"
    }
    {
      Id = "ErisField_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Permohonan yang lumayan bagus, Sayang... {#Emph}tapi{#Prev}, sayangnya bagimu, aku ini tak punya hati. Jadi, ayo maju! Ini porsi pertamamu untuk api dan bulu malam ini."
      Speaker = "Eris"
      Event = "ErisBossAboutPrometheus01"
    }
    {
      Id = "ErisField_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kalau kau berhasil meletiku lagi, apa langkahmu berikutnya, Biang Masalah? Belum pernah kulihat orang berjuang {#Emph}sekeras {#Prev}ini cuma demi bertemu keluarga mereka. Kebanyakan dari kita malah berusaha menjauh dari keluarga sendiri!"
      Speaker = "Eris"
      Event = "ErisBossAboutTyphon01"
    }
    {
      Id = "MelinoeField_3081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Awan mengerikan yang menyelimuti puncak Olympus itu menyembunyikan Typhon, kalau-kalau kau belum dengar. Aku heran kau belum pergi melihatnya sendiri! Pokoknya Prometheus berikutnya, {#Emph}baru kemudian {#Prev}Typhon. Tapi kau dulu."
      Speaker = "Melinoe"
      Event = "ErisBossAboutTyphon01"
    }
    {
      Id = "ErisField_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mau bilang kau ke sini untuk cari lawan yang makin lama makin tangguh? {#Emph}Saaayang! {#Prev}Kutahu kita punya kecocokan, tapi ternyata kemiripan kita lebih banyak dari dugaanku! Ayo, maju sini."
      Speaker = "Eris"
      Event = "ErisBossAboutTyphon01"
    }
    {
      Id = "MelinoeField_3265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar takkan pernah menyingkir dari jalanku, kan, Eris? Kau lebih suka Typhon meluluhlantakkan Gunung Olympus. Meskipun pada titik itu, kurasa perang ini akan berakhir."
      Speaker = "Melinoe"
      Event = "ErisBossAboutTyphon02"
    }
    {
      Id = "ErisField_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja! Tapi setelah itu segalanya mungkin takkan terlalu tertib untuk sementara waktu, dan... siapa tahu apa yang bakal Typhon perbuat dari {#Emph}sana? {#Prev}Pikirkan {#Emph}kemungkinannya{#Prev}, Sayang!"
      Speaker = "Eris"
      Event = "ErisBossAboutTyphon02"
    }
    {
      Id = "ErisField_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa di atas Olympus tadi malam, Sayang? Kelihatannya badai sempat reda sebentar. Nyaris saja aku terbang ke sana buat mengintip, tapi... aku benci hawa dingin!"
      Speaker = "Eris"
      Event = "ErisBossAboutTyphon03"
    }
    {
      Id = "MelinoeField_3266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang terjadi adalah, setelah aku melewati{#Emph}mu{#Prev}, aku akhirnya mendaki sampai ke puncak tempat aku menghempaskan sang Ayah Segala Monster, Typhon, jatuh membentur Bumi."
      Speaker = "Melinoe"
      Event = "ErisBossAboutTyphon03"
    }
    {
      Id = "ErisField_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}berhasil? Wah{#Prev}, kau pasti {#Emph}kuat {#Prev}banget, atau Typhon yang kelewat {#Emph}lemah! {#Prev}Dan berhubung kau sudah kembali ke sini, kurasa apa pun yang terjadi tadi tak ada artinya sama sekali!"
      Speaker = "Eris"
      Event = "ErisBossAboutTyphon03"
    }
    {
      Id = "ErisField_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lama tak melihatmu di sini, Sayang. Ngomong-ngomong, apa yang terjadi pada Typhon? Batang hidungnya sama sekali tak kelihatan!"
      Speaker = "Eris"
      Event = "ErisBossAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_4063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon terpaksa angkat kaki dari realitas yang kita kenal. Walau begitu, maaf ya, Eris. Kurasa kau bahkan tak sempat memperkenalkan dirimu padanya, kan?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutTyphonDeath01"
    }
    {
      Id = "ErisField_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang tidak, tapi kalau dia semudah itu disingkirkan, mungkin memang lebih baik begitu! Lantas, untuk apa kau pergi ke Olympus? Jangan bilang ada semacam {#Emph}perjamuan makan. {#Prev}Soalnya aku {#Emph}tidak {#Prev}diundang!"
      Speaker = "Eris"
      Event = "ErisBossAboutTyphonDeath01"
    }
    {
      Id = "ErisField_0372"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terlalu banyak Harpy di sekitar sini, padahal mereka cuma sekumpulan cecunguk lemah. Mereka tahu siapa ratu penguasa udara dan memperlakukanku bak seorang {#Emph}dewi!"
      Speaker = "Eris"
      Event = "ErisBossAboutHarpies01"
    }
    {
      Id = "MelinoeField_3276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}memang {#Prev}seorang dewi, Eris. Sayangnya para Harpy itu tak secepat itu mengenali kedewataanku sendiri..."
      Speaker = "Melinoe"
      Event = "ErisBossAboutHarpies01"
    }
    {
      Id = "ErisField_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin mereka tidak menyukaimu karena kau tak punya sayap? Tapi kalau kasusnya dirimu, {#Emph}sebenarnya {#Prev}bisa jadi karena banyak hal lain sih..."
      Speaker = "Eris"
      Event = "ErisBossAboutHarpies01"
    }
    {
      Id = "ErisField_0370"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cih. {#Emph}Lama {#Prev}banget kau baru sampai ke sini! Cuma untuk tiba dalam keadaan nyaris sama matinya dengan para awak di semua {#Emph}kapal {#Prev}yang menuju ke mari!"
      Speaker = "Eris"
      Event = "ErisBossLowHealth01"
    }
    {
      Id = "MelinoeField_3275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf atas ketidaknyamanannya, Eris. Untungnya ada air mancur yang cukup menyegarkan tak jauh dari sini, yang semestinya mujarab untuk luka-lukaku."
      Speaker = "Melinoe"
      Event = "ErisBossLowHealth01"
    }
    {
      Id = "ErisField_0371"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, kalau begitu kau sudah begitu {#Emph}dekat! {#Prev}Mungkin kau bisa mencoba kabur menerobos. Jalan keluar dari sini ada tepat di belakangku..."
      Speaker = "Eris"
      Event = "ErisBossLowHealth01"
    }
    {
      Id = "ErisField_0374"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh kasihan{#Prev}, sepertinya para pelaut tua jahat di belakang sana berhasil mencabik-cabikmu di sepanjang jalan! Tapi jangan cemas, Sayang. {#Emph}Biar aku {#Prev}yang mengakhiri penderitaanmu!"
      Speaker = "Eris"
      Event = "ErisBossLowHealth02"
    }
    {
      Id = "ErisField_0379"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi kau hampir {#Emph}saja {#Prev}mengalahkanku, Sayang! Sayapku sampai terasa berat... seolah-olah Dunia Bawah memanggilku untuk {#Emph}pulang. {#Prev}Tapi sekarang aku sudah segar bugar!"
      Speaker = "Eris"
      Event = "ErisBossCloseMatch01"
    }
    {
      Id = "MelinoeField_3280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk saat ini. Sebentar lagi kau akan merasakan Dunia Bawah memanggilmu pulang sekali lagi. Dan kau akan pergi ke sana, suka atau tidak."
      Speaker = "Melinoe"
      Event = "ErisBossCloseMatch01"
    }
    {
      Id = "ErisField_0380"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Uuh{#Prev}, aku {#Emph}suka {#Prev}ancaman yang mantap! Kalau begitu, mari kita lihat siapa yang bakal pulang {#Emph}duluan{#Prev}, ya? Mungkin hasilnya bakal sama persis seperti {#Emph}sebelumnya..."
      Speaker = "Eris"
      Event = "ErisBossCloseMatch01"
    }
    {
      Id = "ErisField_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oke, demi neraka jahanam, pakaian {#Emph}apa {#Prev}yang sedang kau kenakan itu, Sayang? Kau memang butuh ganti gaya, tentu saja, tapi yang {#Emph}ini {#Prev}kelewat {#Emph}nyeleneh."
      Speaker = "Eris"
      Event = "ErisBossAboutSuit01"
    }
    {
      Id = "MelinoeField_3077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, maksudmu pasti Mantel Hitam ini. Kau benar kalau ini bukan setelan pilihanku, tapi benda ini bukan dibuat sekadar untuk pamer. Kau akan mengerti sebentar lagi."
      Speaker = "Melinoe"
      Event = "ErisBossAboutSuit01"
    }
    {
      Id = "ErisField_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tunggu, aku ingat Mantel Hitam itu! Jadi {#Emph}seperti itu {#Prev}wujudnya? Kupikir Bedil Adamant sudah kelihatan konyol! Selera Nyx {#Emph}benar-benar {#Prev}buruk."
      Speaker = "Eris"
      Event = "ErisBossAboutSuit01"
    }
    {
      Id = "ErisField_0381"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ih{#Prev}, kau mirip sekali dengan {#Emph}Nyx! {#Prev}Itu masih benda Mantel Hitam yang kau pakai, kan? Hanya saja kau {#Emph}melakukan {#Prev}sesuatu..."
      Speaker = "Eris"
      Event = "ErisBossAboutNyxAspect01"
    }
    {
      Id = "MelinoeField_3315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini adalah Aspek Xinth milik Nyx sendiri, yang menganggapku layak menjadi penyandangnya. Mungkin agar aku bisa mendisiplinkanmu menggantikan ibumu."
      Speaker = "Melinoe"
      Event = "ErisBossAboutNyxAspect01"
    }
    {
      Id = "ErisField_0382"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mendisiplinkanku? {#Prev}Sayang, aku memang sering berkelahi dengan Nyx sepanjang waktu, tapi tidak sampai seperti {#Emph}ini. {#Prev}Ini {#Emph}jauh {#Prev}lebih seru! Ayo, Ibu, tunjukkan jurus terbaikmu."
      Speaker = "Eris"
      Event = "ErisBossAboutNyxAspect01"
    }
    {
      Id = "ErisField_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kembalikan Apel Emas yang kau rampas dariku tempo hari, dan mungkin kali ini kubiarkan kau lewat begitu saja. Bagaimana?"
      Speaker = "Eris"
      Event = "ErisBossAboutGoldenApples01"
    }
    {
      Id = "MelinoeField_1924"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu Apel Emas yang kemungkinan besar kau {#Emph}curi? {#Prev}Konon buah itu hanya tumbuh di satu taman saja, dan aku sangat ragu tempat seperti itu sudi membiarkan{#Emph}mu {#Prev}masuk."
      Speaker = "Melinoe"
      Event = "ErisBossAboutGoldenApples01"
    }
    {
      Id = "ErisField_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hidup bakal terasa {#Emph}jauh {#Prev}lebih menarik begitu kau menerima kenyataan bahwa kau {#Emph}tidak {#Prev}selalu butuh undangan untuk datang. Baiklah! Simpan saja Apel itu. Aku masih punya banyak..."
      Speaker = "Eris"
      Event = "ErisBossAboutGoldenApples01"
    }
    {
      Id = "ErisField_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu tadi telingaku yang berdenging, atau barusan aku mendengar denting Lonceng kecil? {#Emph}Wah{#Prev}, kau membawa {#Emph}Kenang-kenangan{#Prev}ku, ya! Kau pikir benda itu bakal membantumu di {#Emph}sini?"
      Speaker = "Eris"
      Event = "ErisBossAboutKeepsake01"
    }
    {
      Id = "MelinoeField_3086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika benda itu mengganggumu atau membingungkanmu sedikit saja, kuanggap itu sepadan. Aku tahu kau tak mungkin memberi hadiah sederhana tanpa ada niat licik di baliknya."
      Speaker = "Melinoe"
      Event = "ErisBossAboutKeepsake01"
    }
    {
      Id = "ErisField_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedangkan {#Emph}kau {#Prev}selalu memberi hadiah hanya dengan pikiran suci nan murni yang memantul-mantul di dalam kepalamu yang besar dan mudah dibidik itu! Ayolah. Tak ada orang yang sesempurna itu, Sayang. Kau pun tidak."
      Speaker = "Eris"
      Event = "ErisBossAboutKeepsake01"
    }
    {
      Id = "ErisField_0451"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wah gawat{#Prev}, apa kau membawa Mata Iblis milik Nemmie? Kelihatan sekali seberapa adilnya dia dalam berpikir, sampai menyuruhmu memakai benda {#Emph}itu {#Prev}hanya untuk membalasku!"
      Speaker = "Eris"
      Event = "ErisBossAboutNemesisKeepsake01"
    }
    {
      Id = "MelinoeField_4068"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aku {#Prev}yang memilih untuk membawa Mata itu, bukan Nemesis. Walaupun dia {#Emph}adalah {#Prev}Perwujudan Pembalasan Dendam, jadi kurasa dia pasti akan mendukung seandainya dia tahu."
      Speaker = "Melinoe"
      Event = "ErisBossAboutNemesisKeepsake01"
    }
    {
      Id = "ErisField_0452"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak butuh orang genius untuk menebak hal {#Emph}itu{#Prev}, Sayang. {#Emph}Aku {#Prev}ini adik perempuannya! Anak yang paling {#Emph}kerdil {#Prev}di antara keturunan Nyx, yang paling {#Emph}kecil {#Prev}dan paling {#Emph}gampang {#Prev}ditindas. Tapi aku selalu melawan balik... {#Emph}atau {#Prev}menyerang duluan!"
      Speaker = "Eris"
      Event = "ErisBossAboutNemesisKeepsake01"
    }
    {
      Id = "ErisField_0453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti {#Emph}spesial banget {#Prev}buat Moros kalau dia sampai ngasih salah satu Sematan berkilaunya! Mungkin dia pikir kau nggak bakal selamat {#Emph}tanpa {#Prev}dia! Kau {#Emph}kelihatan {#Prev}kayak orang yang butuh diselamatkan, Sayang."
      Speaker = "Eris"
      Event = "ErisBossAboutMorosKeepsake01"
    }
    {
      Id = "MelinoeField_4069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan apa maksudmu bicara begitu? Asal kau tahu, Yang Mulia Moros memberikan Kenang-kenangan ini murni sebagai tanda kesopanan biasa, tidak lebih."
      Speaker = "Melinoe"
      Event = "ErisBossAboutMorosKeepsake01"
    }
    {
      Id = "ErisField_0454"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Uh-huh, terserah katamu, deh{#Prev}. Kalian berdua kadang sama-sama nggak peka, sumpah! Sekarang ayo kita lihat apa Yang Mulia Moros bakal datang menyelamatkanmu..."
      Speaker = "Eris"
      Event = "ErisBossAboutMorosKeepsake01"
    }
    {
      Id = "ErisField_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu hal yang kusuka dari tempat ini, mancing di sini jauh lebih gampang daripada di Persimpangan. Aku hampir merasa {#Emph}kasihan {#Prev}padamu, harus pakai joran kayak manusia fana yang kelaparan."
      Speaker = "Eris"
      Event = "ErisBossAboutFishing01"
    }
    {
      Id = "MelinoeField_4067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kau tidak suka memancing. Kalau sekarang kau menyukainya, seharusnya kau lebih menghargai teknik tradisional."
      Speaker = "Melinoe"
      Event = "ErisBossAboutFishing01"
    }
    {
      Id = "ErisField_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya kalau begitu berarti aku memang {#Emph}nggak suka! {#Prev}Tapi aku baru saja mau menembak ikan yang berenang di dekat pantai itu waktu kau muncul. Sekarang giliran {#Emph}kau {#Prev}yang kena duluan!"
      Speaker = "Eris"
      Event = "ErisBossAboutFishing01"
    }
    {
      Id = "MelinoeField_3277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi bagaimana rasanya diseret paksa kembali ke neraka berkali-kali? Setidaknya kau tahu tempatmu yang sebenarnya."
      Speaker = "Melinoe"
      Event = "ErisBossAboutDeath01"
    }
    {
      Id = "ErisField_0375"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan cuma aku, tapi kau {#Emph}juga{#Prev}, Sayang. Kaulah yang nggak seharusnya {#Emph}ada {#Prev}di atas sini! Kalau soal diseret {#Emph}ke bawah{#Prev}, bukan masalah besar. Aku tinggal terbang balik ke sini!"
      Speaker = "Eris"
      Event = "ErisBossAboutDeath01"
    }
    {
      Id = "MelinoeField_3278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi begitu tenagamu goyah, roh-roh orang mati akan mencengkerammu lagi. Kebanyakan dari mereka mungkin menuntut balas atas apa yang pernah kau perbuat..."
      Speaker = "Melinoe"
      Event = "ErisBossAboutDeath01"
    }
    {
      Id = "ErisField_0376"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus dong, mereka boleh mengambil {#Emph}bagian {#Prev}dari tubuhku dan merasa {#Emph}puas {#Prev}sendiri! Lagian, aku punya {#Emph}banyak {#Prev}hal buat {#Emph}dibagi!"
      Speaker = "Eris"
      Event = "ErisBossAboutDeath01"
    }
    {
      Id = "ErisField_0377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hampir mengira kau nggak bakal muncul! Menggantungkanku semalaman lagi, maksudku... kenapa {#Emph}nggak? {#Prev}Kau kadang {#Emph}ngeselin banget, {#Prev}tahu!"
      Speaker = "Eris"
      Event = "ErisBossAboutUnderworld01"
    }
    {
      Id = "MelinoeField_3279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu, selama aku berada di Dunia Bawah, kau cuma menunggu di sini malam demi malam? Memangnya aku harus melapor padamu dulu ke mana aku akan pergi?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutUnderworld01"
    }
    {
      Id = "ErisField_0378"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itulah yang bakal dilakukan teman sejati, jadi kurasa kau {#Emph}bukan {#Prev}teman! Mungkin lebih baik kau nggak usah balik lagi. Emangnya aku peduli?"
      Speaker = "Eris"
      Event = "ErisBossAboutUnderworld01"
    }
    {
      Id = "ErisField_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini gelap banget di luar sana, {#Emph}ya? {#Prev}Bahkan pelaut mati di Celah itu kelihatan agak ketakutan. Mungkin ada sesuatu yang terjadi...?"
      Speaker = "Eris"
      Event = "ErisBossAboutShrine01"
    }
    {
      Id = "MelinoeField_3270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hawa {#Emph}Ketakutan {#Prev}terasa pekat. Kau sudah terlalu sering menentang kehendak Malam, Eris. Kali ini tujuanku ke sini bukan cuma demi Olympus, tapi demi {#Emph}dirimu."
      Speaker = "Melinoe"
      Event = "ErisBossAboutShrine01"
    }
    {
      Id = "ErisField_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu {#Emph}Nyx {#Prev}yang menyuruhmu melakukan ini? {#Emph}Pff, yang benar saja! {#Prev}Dia nggak pernah peduli padaku, dan dia {#Emph}nggak bakal {#Prev}mulai sekarang."
      Speaker = "Eris"
      Event = "ErisBossAboutShrine01"
    }
    {
      Id = "ErisField_0362"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hawa Ketakutan terasa pekat{#Prev}, katamu terakhir kali suasananya begini. Mungkin kau memang {#Emph}benar-benar {#Prev}mengerjakan tugas kotor Nyx! Kalau begitu, kau {#Emph}jauh {#Prev}lebih bodoh dari dugaanku..."
      Speaker = "Eris"
      Event = "ErisBossAboutShrine02"
    }
    {
      Id = "MelinoeField_3271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau diundang dan diharapkan menjadi bagian dari Kaum Gaib. Tapi kau berpaling bukan cuma dari kami, melainkan dari ibumu, dan Dunia Bawah itu sendiri. Ada harga yang harus dibayar untuk itu."
      Speaker = "Melinoe"
      Event = "ErisBossAboutShrine02"
    }
    {
      Id = "ErisField_0363"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kau datang untuk menagihnya! Sayang sekali aku nggak punya apa-apa untuk diberikan. Kecuali kalau kau mau menerima pembayaran berupa serpihan {#Emph}logam {#Prev}kecil yang dikunyah dan dimuntahkan oleh Senapan ini."
      Speaker = "Eris"
      Event = "ErisBossAboutShrine02"
    }
    {
      Id = "ErisField_0368"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fyuuh{#Prev}, ini baru malam yang {#Emph}kugemari! {#Prev}Pesta pora pembantaian yang sesungguhnya di luar sana, semuanya terasa... {#Emph}jauh... lebih liar. {#Prev}Nggak tahu apa yang terjadi tapi aku {#Emph}suka!"
      Speaker = "Eris"
      Event = "ErisBossAboutShrine03"
    }
    {
      Id = "MelinoeField_3274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak pernah memedulikan Sumpah Kaum Gaib, namun kau tetap menjadi salah satu penerima manfaat utamanya. Mungkin ibumu, Nyx, telah melakukan sesuatu untukmu."
      Speaker = "Melinoe"
      Event = "ErisBossAboutShrine03"
    }
    {
      Id = "ErisField_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu malam-malam kehancuran dan kebejatan total sesekali ini dimaksudkan untuk menebus semua hal yang {#Emph}nggak {#Prev}pernah dilakukan Nyx...? Yah, kurasa lumayanlah untuk permulaan!"
      Speaker = "Eris"
      Event = "ErisBossAboutShrine03"
    }
    {
      Id = "ErisField_0364"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, kau hampir mengalahkanku sampai ke sini malam ini, Biang Masalah! Kau datang {#Emph}jauh {#Prev}lebih cepat dari jadwal! Tapi... {#Emph}hah... {#Prev}Ngomong apa {#Emph}sih aku? Jadwal?! {#Prev}Apa yang terjadi denganku...?"
      Speaker = "Eris"
      Event = "ErisAboutPackagedBounties01"
    }
    {
      Id = "MelinoeField_3272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau merasa agak gelisah malam ini, mungkin itu hanya karena Kekacauan Purba sedang melancarkan pengaruhnya atas realitas yang kita kenal."
      Speaker = "Melinoe"
      Event = "ErisAboutPackagedBounties01"
    }
    {
      Id = "ErisField_0365"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}benar juga{#Prev}, masuk akal! {#Emph}Kekacauan {#Prev}yang menciptakan segalanya. Tapi tahu nggak? Sekarang {#Emph}kita {#Prev}juga bisa bikin kekacauan bersama."
      Speaker = "Eris"
      Event = "ErisAboutPackagedBounties01"
    }
    {
      Id = "ErisField_0366"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil melewati Ephyra dengan {#Emph}sangat {#Prev}cepat, Biang Masalah. Pasti gara-gara {#Emph}Kekacauan Purba yang melancarkan pengaruhnya atas realitas {#Prev}lagi, {#Emph}ya...?"
      Speaker = "Eris"
      Event = "ErisAboutPackagedBounties02"
    }
    {
      Id = "MelinoeField_3273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masalahnya, Eris... Aku bisa bersikap sejujur mungkin padamu, tapi kau tetap selalu menanggapi perkataanku dengan prasangka paling {#Emph}buruk{#Prev}. Jadi apa gunanya aku membalas ucapanmu?"
      Speaker = "Melinoe"
      Event = "ErisAboutPackagedBounties02"
    }
    {
      Id = "ErisField_0367"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, itu dia yang {#Emph}kurasakan {#Prev}— apa {#Emph}peduliku{#Prev}. Mungkin itu penting bagi {#Emph}Kekacauan, kan? {#Prev}Cuma ada {#Emph}satu {#Prev}cara untuk membuktikannya."
      Speaker = "Eris"
      Event = "ErisAboutPackagedBounties02"
    }
    {
      Id = "ErisField_0386"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatan ada yang beda dariku nggak, Sayang? Pastinya nggak! {#Emph}Aku {#Prev}nggak berubah sama sekali, tapi tahu apa yang {#Emph}berubah? {#Prev}Senapan Adamant-ku! Maksudku, {#Emph}lihat {#Prev}saja sendiri!"
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight01"
    }
    {
      Id = "MelinoeField_3487"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu pasti Wujud Senapan milik orang lain. Mungkin kau melakukan atau mengucapkan sesuatu yang membuatnya berubah bentuk... meski ini bisa saja karena perbuatanku juga."
      Speaker = "Melinoe"
      Event = "ErisBossAboutAltFight01"
    }
    {
      Id = "ErisField_0387"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuh kan, selalu saja berusaha mengambil semua pujian buat dirimu sendiri! Dengar ya, Senapan ini nggak tunduk padamu, {#Prev}dia tunduk {#Emph}padaku. {#Prev}Dan aku sudah tahu semua {#Emph}hal baru {#Prev}yang bisa dilakukannya!"
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight01"
    }
    {
      Id = "ErisField_0388"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang perhatikan {#Emph}ini...!"
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight01"
    }
    {
      Id = "ErisField_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi Senapan ini berganti gaya lain lagi secara ajaib. Seolah dia {#Emph}tahu {#Prev}kau sedang menuju ke mari! Aku {#Emph}juga {#Prev}tahu kau sedang dalam perjalanan, gampang banget melihatmu dari atas sana."
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight02"
    }
    {
      Id = "MelinoeField_3488"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau tahu Wujud milik siapa itu sebenarnya, atau kenapa senjata kuno tempaan Takdir milikmu bisa berubah wujud secara magis tanpa pengaruhmu?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutAltFight02"
    }
    {
      Id = "ErisField_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nggak tahu! {#Prev}Bicaramu seolah aku harus takut pada benda ini, padahal kaulah {#Prev}yang sekarang menatap laras penembaknya."
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight02"
    }
    {
      Id = "ErisField_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sialan, {#Prev}dari tadi kutunggu-tunggu Bedil sialan ini ganti ke wujud yang satunya lagi, tapi malah {#Emph}macet! {#Prev}Tetap aja rongsokan tua. Mana sering macet pas di-reload..."
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight03"
    }
    {
      Id = "MelinoeField_3489"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau terus menghinanya seperti itu, dia malah bakal makin enggan menuruti kehendakmu! Aku saja heran kau bisa punya Aspek atas namamu sendiri."
      Speaker = "Melinoe"
      Event = "ErisBossAboutAltFight03"
    }
    {
      Id = "ErisField_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, hidup 'kan penuh kejutan, Biang Masalah! Lagian aku lebih suka Aspek yang ini. Kita lihat apa senjata ini masih mau {#Emph}menurutiku!"
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight03"
    }
    {
      Id = "ErisField_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bedil ini ganti wujud lagi! Hei, gimana kalau {#Emph}ini {#Prev}Aspek asliku yang sebenarnya dan yang satunya lagi buat orang lain? Yang ini bahkan punya {#Emph}wajah {#Prev}mirip denganku, terus ada {#Emph}sayapnya {#Prev}pula!"
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight04"
    }
    {
      Id = "MelinoeField_3490"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, satu-satunya alasan kau sesekali bisa memakai Aspek itu adalah karena Sumpah Para Gaib. Apa kau tak bisa merasakan Teror di malam ini?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutAltFight04"
    }
    {
      Id = "ErisField_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu-satunya yang kurasakan saat ini, Sayang, cuma dorongan kuat buat bikin kau jadi irisan daging garing pakai benda ini. Kau pikir aku peduli soal {#Emph}Sumpah? {#Prev}Memangnya aku ini siapa, {#Emph}Nyx?!"
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight04"
    }
    {
      Id = "ErisField_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terdampar di bagian pantai yang salah, Biang Masalah. Kau lihat bangkai raksasa yang bau busuk di sebelah sana? {#Emph}Kira-kira begitulah {#Prev}wujudmu setelah ini."
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight05"
    }
    {
      Id = "MelinoeField_3491"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ukuranku jelas tak sebesar itu, Eris! Aku juga bukan hewan laut, dan kau sama sekali takkan membunuhku. Tapi harus kuakui, bagian pantai ini memang mengerikan, dan bangkai itu membuatnya makin buruk."
      Speaker = "Melinoe"
      Event = "ErisBossAboutAltFight05"
    }
    {
      Id = "ErisField_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu apa kau soal {#Emph}pantai{#Prev}, atau bangkai? Aku punya Aspek Bedil spesialku di sini, plus {#Emph}semua {#Prev}pemandangan, suara, dan bau laut. Jadi siapa juga yang butuh {#Emph}kau?!"
      Speaker = "Eris"
      Event = "ErisBossAboutAltFight05"
    }
    {
      Id = "Melinoe_4367"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu terakhir kali kita bicara, kau bilang apa pun yang salah dengan dirimu tak bisa diperbaiki. Kenapa kau bicara begitu?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutRelationship02"
    }
    {
      Id = "Eris_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makasih ya atas semua kepedulianmu, tapi itu cuma momen sesaat yang kelewat kau besar-besarkan. Kita semua agak rusak, ya 'kan?"
      Speaker = "Eris"
      Event = "ErisBossAboutRelationship02"
    }
    {
      Id = "Melinoe_4368"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin saja. Tapi kita bisa memperbaiki diri lewat usaha dan disiplin, sebisa mungkin. Atau, kita bisa terus saling menghalangi tanpa akhir."
      Speaker = "Melinoe"
      Event = "ErisBossAboutRelationship02"
    }
    {
      Id = "Eris_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masalahnya, aku nggak mau harus {#Emph}berusaha. {#Prev}Nggak dengan hal {#Emph}ini{#Prev}, nggak juga dengan {#Emph}kau. {#Prev}Aku maunya semuanya {#Emph}gampang{#Prev}, sementara kau maunya semuanya {#Emph}susah. {#Prev}Tapi setidaknya sekarang kita benar-benar saling {#Emph}paham!"
      Speaker = "Eris"
      Event = "ErisBossAboutRelationship02"
    }
    {
      Id = "ErisField_0383"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kembali ke rutinitas biasa! Nggak ada yang ngalahin asyiknya nembakin kau sampai bolong malam demi malam seolah nggak terjadi apa-apa, kan?"
      Speaker = "Eris"
      Event = "ErisBossAboutBecomingCloser01"
    }
    {
      Id = "MelinoeField_3527"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu seharusnya aku tak kaget kau mau melawanku seperti biasa, Eris, tapi... aku sempat berharap kau mulai memandangku dengan cara berbeda. Jadi, cuma segitu saja?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutBecomingCloser01"
    }
    {
      Id = "ErisField_0384"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cuma segitu saja! Dan jangan kepedean deh. Bukannya kita baru saja saling curhat buka-bukaan jiwa! Aku bahkan nggak yakin kalau aku {#Emph}punya {#Prev}jiwa. Pokoknya, jangan harap dapat perlakuan istimewa dariku."
      Speaker = "Eris"
      Event = "ErisBossAboutBecomingCloser01"
    }
    {
      Id = "MelinoeField_3528"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tindakanmu yang selalu repot-repot menghalangi jalanku menuju Olympus itu {#Emph}bukanlah {#Prev}sesuatu yang kau anggap perlakuan istimewa?"
      Speaker = "Melinoe"
      Event = "ErisBossAboutBecomingCloser01"
    }
    {
      Id = "ErisField_0385"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, omonganmu {#Emph}ada {#Prev}benarnya juga, Sayang! Tapi aku ogah mikirin itu dan mending langsung nembakin kau saja, oke?"
      Speaker = "Eris"
      Event = "ErisBossAboutBecomingCloser01"
    }
    {
      Id = "MelinoeField_4070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang setelah kakakku kembali, kau masih tak berniat mengembalikan Bedil Adamant, ya? Padahal senjata itu miliknya sebelum semua ini terjadi."
      Speaker = "Melinoe"
      Event = "ErisBossPostTrueEnding01"
    }
    {
      Id = "ErisField_0455"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atas dasar apa kau pikir dia punya hak lebih besar atas benda ini ketimbang {#Emph}aku, hah{#Prev}, Sayang? Dia bahkan hampir nggak pernah memakainya! Itu cuma sekadar senjata lain buat dia, tapi ini senjata satu-satunya {#Emph}milikku."
      Speaker = "Eris"
      Event = "ErisBossPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengharukan sekali! Aku yakin ibumu bakal memastikan semuanya beres, mengingat beliau juga sudah kembali. Aku penasaran apa beliau memang sudah tahu kau bakal mendapatkan benda itu."
      Speaker = "Melinoe"
      Event = "ErisBossPostTrueEnding01"
    }
    {
      Id = "ErisField_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh, {#Prev}dia {#Emph}tahu kok! {#Prev}Soalnya ini bukan kali pertamaku memegangnya! Dulu aku sempat kehilangan senjata ini, terus malah kakakmu yang nemu... tapi aku {#Emph}selalu {#Prev}mengambil kembali apa yang jadi milikku."
      Speaker = "Eris"
      Event = "ErisBossPostTrueEnding01"
    }
    {
      Id = "ErisField_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah siap tembak nih, jadi buat langkahmu sekarang, Biang Masalah."
      Speaker = "Eris"
      Event = "ErisBossMiscStart01"
    }
    {
      Id = "ErisField_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak bakal ada jalan kembali ke masa lalu, nggak peduli {#Emph}apa pun {#Prev}yang kau lakukan."
      Speaker = "Eris"
      Event = "ErisBossMiscStart02"
    }
    {
      Id = "ErisField_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siap berikan kemampuan terbaikmu, Biang Masalah? Soalnya {#Emph}aku {#Prev}jelas sudah sangat siap!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart03"
    }
    {
      Id = "ErisField_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua orang selalu berusaha buat bikin perubahan. Nggak ada satu pun yang berhasil."
      Speaker = "Eris"
      Event = "ErisBossMiscStart04"
    }
    {
      Id = "ErisField_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pas banget waktu aku mulai bosan, si {#Emph}Biang Masalah malah nongol!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart05"
    }
    {
      Id = "ErisField_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak bakal ada yang berubah! Kecuali jumlah lubang peluru di badanmu."
      Speaker = "Eris"
      Event = "ErisBossMiscStart06"
    }
    {
      Id = "ErisField_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini demi kebaikanmu sendiri, Biang Masalah. Kebaikan buatku juga!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart07"
    }
    {
      Id = "ErisField_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan harap! {#Prev}Jalur ke gunung sudah {#Emph}ditutup{#Prev}, kalau-kalau kau belum dengar kabar terbarunya, Sayang."
      Speaker = "Eris"
      Event = "ErisBossMiscStart08"
    }
    {
      Id = "ErisField_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Balik lagi buat ronde berikutnya? Bagus deh, soalnya amunisiku masih ada {#Emph}ribuan."
      Speaker = "Eris"
      Event = "ErisBossMiscStart09"
    }
    {
      Id = "ErisField_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat kita, terjebak dalam rutinitas begini. Aku {#Emph}benci {#Prev}rutinitas!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart10"
    }
    {
      Id = "ErisField_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya aku malas beginiin kau, Sayang, tapi... ah, ngapain juga pura-pura?"
      Speaker = "Eris"
      Event = "ErisBossMiscStart11"
    }
    {
      Id = "ErisField_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau kelihatan tersesat, Biang Masalah. Sini kubantu cari jalan pulang ke rumah."
      Speaker = "Eris"
      Event = "ErisBossMiscStart12"
    }
    {
      Id = "ErisField_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku nggak butuh alasan buat cari ribut denganmu. Cuma lagi kepengin saja!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart13"
    }
    {
      Id = "ErisField_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, sudah siap kutembak sampai mental balik ke neraka, Biang Masalah?"
      Speaker = "Eris"
      Event = "ErisBossMiscStart14"
    }
    {
      Id = "ErisField_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kamu nggak mabuk laut ya, Sayang. Soalnya {#Emph}kamu {#Prev}bakal {#Emph}kuguncang sampai mampus."
      Speaker = "Eris"
      Event = "ErisBossMiscStart15"
    }
    {
      Id = "ErisField_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba saja kamu bisa terbang, Sayang. Sayangnya nggak bisa! Dan aku nggak bakal biarkan kamu lolos dari sini."
      Speaker = "Eris"
      Event = "ErisBossMiscStart16"
    }
    {
      Id = "ErisField_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang bakal kita lakukan ini, Sayang, bisa kulakoni {#Emph}semalaman penuh... {#Prev}malam {#Emph}demi malam{#Prev}, tanpa henti."
      Speaker = "Eris"
      Event = "ErisBossMiscStart17"
    }
    {
      Id = "ErisField_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin aku memang nggak bisa membunuhmu seutuhnya, Biang Masalah, tapi jelas bakal kucoba sekuat tenaga."
      Speaker = "Eris"
      Event = "ErisBossMiscStart18"
    }
    {
      Id = "ErisField_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berapa kali lagi coba aku harus menembakmu jatuh di sini, Sayang?"
      Speaker = "Eris"
      Event = "ErisBossMiscStart20"
    }
    {
      Id = "ErisField_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu ini {#Emph}nggak waras{#Prev}, Sayang! Kalah berkali-kali sampai {#Emph}bonyok{#Prev}, tapi masih terus maju saja?"
      Speaker = "Eris"
      Event = "ErisBossMiscStart21"
    }
    {
      Id = "ErisField_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mungkin nggak selalu bisa menghentikanmu, tapi aku {#Emph}selalu {#Prev}bisa memperlambat langkahmu."
      Speaker = "Eris"
      Event = "ErisBossMiscStart22"
    }
    {
      Id = "ErisField_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ini sportif, Biang Masalah. Menang atau kalah, sama serunya bagiku."
      Speaker = "Eris"
      Event = "ErisBossMiscStart23"
    }
    {
      Id = "ErisField_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Akhirnya datang juga! {#Prev}Bosan tahu nggak, cuma berdiri bengong melototin ombak melulu!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart24"
    }
    {
      Id = "ErisField_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak pernah kusangka aku bakal punya rutinitas yang teratur begini, tapi {#Emph}lihat aku sekarang{#Prev}, Sayang!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart25"
    }
    {
      Id = "ErisField_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu nggak {#Emph}benar-benar {#Prev}harus manjat gunung tinggi di belakang sana itu kan, Biang Masalah?"
      Speaker = "Eris"
      Event = "ErisBossMiscStart26"
    }
    {
      Id = "ErisField_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo kita senang-senang saja, Sayang! Waktuku nggak banyak semalaman, dan begitu juga kamu."
      Speaker = "Eris"
      Event = "ErisBossMiscStart27"
    }
    {
      Id = "ErisField_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bedanya kamu dan aku itu cuma satu: aku sama sekali {#Emph}nggak peduli {#Prev}soal menang atau kalah."
      Speaker = "Eris"
      Event = "ErisBossMiscStart28"
    }
    {
      Id = "ErisField_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu sebenarnya {#Emph}menikmati {#Prev}ini kan, Biang Masalah? Nggak usah ngomong ke aku. Cukup akui saja ke dirimu sendiri!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart29"
    }
    {
      Id = "ErisField_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku benci jadi gampang ditebak begini, tapi aku suka banget bikin kamu naik darah, jadi... impaslah ya!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart30"
    }
    {
      Id = "ErisField_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan dimasukkan ke hati ya, Sayang, tapi ada beberapa hal yang memang wajib kita selesaikan, tahu kan?"
      Speaker = "Eris"
      Event = "ErisBossMiscStart31"
    }
    {
      Id = "ErisField_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya aku ingin memperlambatmu lewat obrolan manis, tapi kurasa cara {#Emph}ini {#Prev}bakal bekerja {#Emph}jauh lebih manjur."
      Speaker = "Eris"
      Event = "ErisBossMiscStart32"
    }
    {
      Id = "ErisField_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar dulu, {#Emph}heh! {#Prev}Aku tahu hubungan kita agak renggang belakangan ini, tapi... nanti kita juga bakal menertawakan ini bareng-bareng!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart33"
    }
    {
      Id = "ErisField_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Muka kamu kok nggak kelihatan senang melihatku, Sayang? Padahal aku belum {#Emph}ngapa-ngapain{#Prev}, lho..."
      Speaker = "Eris"
      Event = "ErisBossMiscStart34"
    }
    {
      Id = "ErisField_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ungh! {#Prev}Sialan, ini nggak mempan...! Kenapa sih kamu nggak mau berhenti? Harus kuapakan lagi biar kamu kapok, {#Emph}hah?!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart35"
    }
    {
      Id = "ErisField_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu memang benar-benar nggak tahu kapan harus menyerah ya, Biang Masalah? {#Emph}Bagus kalau begitu!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart36"
    }
    {
      Id = "ErisField_0457"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat apa yang {#Emph}berhasil kuambil balik{#Prev} tanpa alasan yang jelas ini, Biang Masalah!"
      Speaker = "Eris"
      Event = "ErisBossMiscStart37"
    }
    {
      Id = "ErisField_0458"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku suka Rail yang lama, tapi yang {#Emph}baru {#Prev}ini jauh lebih gila! Yah, mungkin bukan kabar baik buatmu sih."
      Speaker = "Eris"
      Event = "ErisBossMiscStart38"
    }
    {
      Id = "ErisField_0459"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang sungguh {#Emph}luar biasa! {#Prev}Dapat Aspek Rail baru, {#Emph}plus {#Prev}sasaran empuk buat uji coba tembak."
      Speaker = "Eris"
      Event = "ErisBossMiscStart39"
    }
    {
      Id = "ErisField_0460"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo kerja sama bareng aku, Sayang, biar kita tahu seberapa dahsyat Aspek Rail yang baru ini!"
      Speaker = "Eris"
