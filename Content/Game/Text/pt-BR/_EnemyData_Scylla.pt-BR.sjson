      Event = "ScyllaAboutDiving02"
    }
    {
      Id = "Scylla_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh-hoo-hoo{#Prev}, kami jelas dapet sponsornya, {#Emph}hmhm...! {#Prev}Paling nggak, pada akhirnya nanti. Usut punya usut, sponsor kami dateng cuma buat nonton kami dipukul {#Emph}jatuh! {#Prev}Gara-gara {#Emph}kamu {#Prev}terus-terusan ngacauin {#Emph}pertunjukan {#Prev}kami malam demi malam!"
