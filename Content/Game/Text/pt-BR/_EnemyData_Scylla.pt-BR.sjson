      Event = "ScyllaAboutDiving01"
    }
    {
      Id = "Scylla_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}bener-bener mikir {#Prev}kamu masih punya sedikit rasa {#Emph}tenggang rasa! {#Prev}Dengar ya, kami bakal mulai {#Emph}lagu {#Prev}kami sekarang, sambil nyoba {#Emph}menenggelamkanmu{#Prev}, jadi tolong pikirin baik-baik buat {#Emph}ngalah {#Prev}kali ini demi aku dan anak-anak!"
