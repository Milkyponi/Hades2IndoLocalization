    }
    {
      Id = "Scylla_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mau aku percaya kalau kau yang mempromosikan acara kami? Akhir-akhir ini kami emang lagi viral dari mulut ke mulut, sih, tapi itu {#Emph}sama sekali {#Prev}bukan {#Emph}karena kamu! {#Prev}Kecuali gara-gara kamu {#Emph}pergi!"
      Speaker = "Scylla"
      Event = "ScyllaAboutNoShow01"
    }
    {
      Id = "Scylla_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku dan anak-anak baru aja mutusin, kita butuh {#Emph}lini produk! {#Prev}Cendera mata autentik dari pertunjukan kami yang {#Emph}memukau {#Prev}biar para penggemar bisa membelinya dengan harga terjangkau sehabis konser! Tapi kami nggak bisa jualan kalau {#Emph}kamu {#Prev}terus ngerecokin jalan kami."
