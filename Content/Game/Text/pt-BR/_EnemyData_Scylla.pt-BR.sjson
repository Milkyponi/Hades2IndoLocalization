      Event = "ScyllaAboutMerch01"
    }
    {
      Id = "MelinoeField_3586"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian yang terus menghalangi jalan{#Emph}ku! {#Prev}Aku tak pernah berniat mencari pertarungan ini! Memangnya aku peduli kalau kalian menjual gulungan gambar dan semacamnya kepada penonton yang kelebihan uang?"
