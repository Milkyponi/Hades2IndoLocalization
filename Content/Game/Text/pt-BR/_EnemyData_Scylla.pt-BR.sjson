      Event = "ScyllaAboutDiving01"
    }
    {
      Id = "MelinoeField_3601"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, apa kau berhasil mendapatkan sponsor malam itu? Aku masih merasa malu karena sengaja kalah dari kalian kemarin hanya karena kau memintanya secara agak sopan. Seharusnya ada hasil positifnya."
