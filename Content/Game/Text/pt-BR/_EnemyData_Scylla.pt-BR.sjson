    }
    {
      Id = "Scylla_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, kami takkan membiarkanmu menghabisi kami dengan cepat lagi, Nona! Jadi bagaimana kalau kau {#Emph}santai saja! {#Prev}Nikmati atmosfernya selagi kami {#Emph}menenggelamkanmu di dalamnya!!"
