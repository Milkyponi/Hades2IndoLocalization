      Event = "ScyllaAboutShrineBounty02"
    }
    {
      Id = "Scylla_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Terlupakan? {#Prev}Nama kami nggak pernah {#Emph}sebesar ini! {#Prev}Dan pamor kami makin meroket di setiap penampilan. Dan kami bakal bikin penampilan yang {#Emph}satu ini {#Prev}tak terlupakan!"
      Speaker = "Scylla"
      Event = "ScyllaAboutShrineBounty02"
    }
    {
      Id = "Scylla_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu mending {#Emph}kerja sama {#Prev}sama kita malam ini, Nona! Ada calon sponsor di suatu tempat di tribun penonton, jadi kita {#Emph}harus {#Prev}nampilin {#Emph}pertunjukan spektakuler! {#Prev}Lebih heboh dibanding pas kamu ngalahin kita biasanya."
      Speaker = "Scylla"
      Event = "ScyllaAboutDiving01"
    }
    {
      Id = "MelinoeField_3600"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku di sini bukan untuk menyokong ambisi kelirumu meraih ketenaran, apalagi mencari sponsor. Kau benar-benar berpikir aku akan membiarkanmu menang hanya karena kau memintanya?"
