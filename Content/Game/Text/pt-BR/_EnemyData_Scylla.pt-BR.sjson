    {
      Id = "Scylla_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terakhir kali kau merusuh di konser kami secepat itu sampai penonton {#Emph}cukup kecewa{#Prev}, Nona! Mereka {#Emph}bahkan hampir tak sempat {#Prev}mendengar {#Emph}lagu kami!"
