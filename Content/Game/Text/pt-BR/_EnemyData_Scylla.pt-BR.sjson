    }
    {
      Id = "Scylla_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu nggak membiarkan kami menang, kamu emang beneran {#Emph}kalah! {#Prev}Kamu makin lembek dan makin gampang ditenggelamkan. {#Emph}Kamu {#Prev}nggak punya apa yang {#Emph}dibutuhkan {#Prev}buat sukses di industri ini! Tapi {#Emph}kami {#Prev}punya."
