      Event = "ScyllaAboutShrine02"
    }
    {
      Id = "Scylla_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu cuma ngomong gitu biar bisa nyakitin kami sebelum kami nyakitin {#Emph}kamu! {#Prev}Tugas seorang seniman itu {#Emph}memikat {#Prev}penontonnya... dan kami nggak bakal bisa {#Emph}melakukannya {#Prev}kalau cuma pakai cara lama yang membosankan, {#Emph}bukan?"
      Speaker = "Scylla"
      Event = "ScyllaAboutShrine02"
    }
    {
      Id = "Scylla_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aww{#Prev}, liat deh gengs, penggemar nomor satu kita yang {#Emph}paling obsesif{#Prev}, datang buat ngerusak pertunjukan untuk {#Emph}semua orang! {#Prev}Suatu hari nanti, kita bakal punya tim keamanan {#Emph}raksasa {#Prev}sendiri buat {#Emph}membereskan {#Prev}insiden-insiden kecil kayak begini."
      Speaker = "Scylla"
      Event = "ScyllaAboutShrineBounty01"
    }
    {
      Id = "MelinoeField_3594"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak punya banyak pilihan selain merusak pertunjukan kalian karena kalian menolak menyingkir... meski kali ini setidaknya aku datang demi kamu, Scylla. Kehendak Malam yang menuntutnya."
