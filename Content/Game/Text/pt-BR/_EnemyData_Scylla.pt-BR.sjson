    }
    {
      Id = "MelinoeField_3595"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemungkinan besar kau merasakan Perjanjian Malam; mereka yang mengancam Dunia Bawah harus disingkirkan ke dalam kegelapan yang terlupakan. Begitulah hukumnya."
