      Speaker = "Scylla"
      Event = "ScyllaPostTrueEnding01"
    }
    {
      Id = "Scylla_0443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih belum ada kabar dari Tuan Chronos akhir-akhir ini. Kau melihatnya di suatu tempat, Nona? Soalnya dana sponsor darinya sepertinya sudah menguap... untung saja kami {#Emph}punya {#Prev}sponsor lain."
      Speaker = "Scylla"
      Event = "ScyllaPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini Chronos sedang berada di Kepulauan Diberkahi. Sibuk melakukan hal lain, seperti yang mungkin seharusnya kau lakukan juga. Siapa lagi yang mendanai pertunjukanmu ini?"
      Speaker = "Melinoe"
      Event = "ScyllaPostTrueEnding02"
    }
    {
      Id = "Scylla_0444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan orang yang kau kenal, aku yakin itu! Dan dengan semua perubahan belakangan ini, panggung ini tak menerima penampil baru. Kau terjebak hanya bersama{#Emph}ku, selamanya! {#Prev}Aku dan cewek-cewek ini."
      Speaker = "Scylla"
      Event = "ScyllaPostTrueEnding02"
    }
    {
      Id = "Scylla_0445"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Berhenti! {#Prev}Jangan bicara {#Emph}apa pun{#Prev}, Nona, tidak sopan mengobrol saat pertunjukan berlangsung kalau-kalau kau belum sadar! Lagian aku sudah muak mendengarkan{#Emph}mu! {#Prev}Tapi tentu saja tidak sebaliknya."
      Speaker = "Scylla"
      Event = "ScyllaAboutSayingLittle01"
    }
    {
      Id = "Scylla_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Lihat, cewek-cewek! {#Prev}Kita kedatangan {#Emph}penonton! {#Prev}Oh, mari kita pukau mereka sampai {#Emph}mati{#Prev}, bagaimana menurut kalian?"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart01"
    }
    {
      Id = "Scylla_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah. Baiklah, cewek-cewek, inilah saatnya, ini konser akbar! {#Emph}Kesempatan emas kita. {#Prev}Tepat di sini!!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart02"
    }
    {
      Id = "Scylla_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, hei Nona! Kami sudah {#Emph}berlatih keras! {#Prev}Mau dengar lagu terbaru kami?"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart03"
    }
    {
      Id = "Scylla_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}suka {#Prev}pertunjukan yang bagus, kan, Nona? Dan kami {#Emph}senang {#Prev}memuaskan penggemar kami! Benar kan, cewek-cewek?"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart04"
    }
    {
      Id = "Scylla_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itulah kedahsyatan lagu kita, cewek-cewek! Begitu mereka {#Emph}mendengarnya{#Prev}, mereka takkan bisa berpaling...!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart05"
    }
    {
      Id = "Scylla_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memang tak tahu kapan harus {#Emph}berhenti{#Prev}, Nona. Kami juga! Mainkan, cewek-cewek!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart06"
    }
    {
      Id = "Scylla_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat, cewek-cewek? Oh, kalau lagu kita memang tidak manjur, dia takkan terus kembali, kan?"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart07"
    }
    {
      Id = "Scylla_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami masih melatih lagu terbaru kami, Nona! Jadi kedatanganmu {#Emph}tepat waktu."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart08"
    }
    {
      Id = "Scylla_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo buat {#Emph}musik merdu {#Prev}bersama kami, Nona! Jelas jauh lebih asyik daripada apa pun yang {#Emph}kau {#Prev}lakukan."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart09"
    }
    {
      Id = "Scylla_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau harus mendengar beberapa lagu {#Emph}klasik {#Prev}kami, {#Emph}haha! {#Prev}Oh, tapi sebelumnya: {#Emph}lagu hit terbaru kami..."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart10"
    }
    {
      Id = "Scylla_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm{#Prev}, biasanya kami tak main di acara privat... tapi untukmu, Nona? Kami rela lakukan {#Emph}apa saja..."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart11"
    }
    {
      Id = "Scylla_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami ingin mempersembahkan lagu berikutnya untuk {#Emph}semua penggemar kami! {#Prev}Khususnya {#Emph}untukmu{#Prev}, Nona."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart12"
    }
    {
      Id = "Scylla_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang, Nona, biarkan musik ini {#Emph}memenuhi jiwamu{#Prev}, dan air asin {#Emph}memenuhi paru-parumu!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart13"
    }
    {
      Id = "Scylla_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuperkenalkan Jetty pada dawai, dan Roxy pada perkusi. Siap, cewek-cewek?"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart14"
    }
    {
      Id = "Scylla_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Halo, Oceanus!! {#Prev}Oh, bagaimana kabar kalian semua malam ini? Kalian siap untuk sebuah {#Emph}pertunjukan?"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart15"
    }
    {
      Id = "Scylla_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami cinta penggemar kami! Mereka selalu kembali, apa pun yang terjadi!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart16"
    }
    {
      Id = "Scylla_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau ada yang mau kau bicarakan, Nona, simpan saja sampai konsernya selesai..."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart17"
    }
    {
      Id = "Scylla_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh jangan dimasukkan ke hati ya, Nona, tapi... kami memang harus menenggelamkan para penggemar kami..."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart18"
    }
    {
      Id = "Scylla_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sih mau banget nyeret kamu sampai ke dasar laut... tapi kan kita udah ada di sini."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart19"
    }
    {
      Id = "Scylla_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu di bawah sini gelap, Nona, jadi... ikuti saja {#Emph}suara merduku..."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart20"
    }
    {
      Id = "Scylla_0420"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, kamu {#Emph}tahu {#Prev}kita lagi naik daun kalau penggemar kita terus-terusan balik lagi!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart21"
    }
    {
      Id = "Scylla_0422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jetty, Roxy, dan aku, kita lagi mikir kayaknya bakal coba bersolo karier sehabis ini!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart23"
    }
    {
      Id = "Scylla_0425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Turun dari {#Emph}panggungku{#Prev}, Nona! Kamu bukan bintang di pertunjukan ini, mau {#Emph}apa pun {#Prev}kata orang!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart24"
    }
    {
      Id = "Scylla_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingat ya, Girls, bisa karena terbiasa, kan? Jadi, ayo kita ulangi dari {#Emph}awal! Sekali lagi!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart25"
    }
    {
      Id = "Scylla_0427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku nggak sudi dengerin sepatah kata pun dari mulutmu, Nona! Tapi {#Emph}kamu {#Prev}yang harus dengerin {#Emph}kami!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart26"
    }
    {
      Id = "Scylla_0428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak bisa lepas dari pesona Scylla and the Sirens, ya? Yah, {#Emph}kamu {#Prev}{#Emph}nggak {#Prev}sendirian kok!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart27"
    }
    {
      Id = "Scylla_0429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini penonton kita {#Emph}rame banget{#Prev}, tapi cuma {#Emph}kamu {#Prev}yang dapat tempat duduk {#Emph}terbaik!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart28"
    }
    {
      Id = "Scylla_0430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kamu nggak punya bakat buat bersinar di panggung megah ini, Nona! {#Emph}Biar kubuktikan nanti."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart29"
    }
    {
      Id = "Scylla_0431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bintang tamu istimewa kita bela-belain turun {#Emph}jauh-jauh {#Prev}dari permukaan cuma buat ketemu {#Emph}kamu!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart30"
    }
    {
      Id = "Scylla_0432"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, para penonton pasti bakal {#Emph}suka banget {#Prev}sama yang ini! Kita nggak bakal bisa ada di sini kalau bukan berkat {#Emph}kamu{#Prev}, Nona!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart31"
    }
    {
      Id = "Scylla_0433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana kalau kamu samperin tamu kita, Charybdis, dan kasih dia pelukan {#Emph}hangat {#Prev}sebagai salam pembuka?!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart32"
    }
    {
      Id = "Scylla_0446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat siapa ini, bukankah si penggemar berat nomor satu kita yang {#Emph}obsesif{#Prev}, datang buat ngerusak pertunjukan kayak biasanya!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart33"
    }
    {
      Id = "Scylla_0447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kayaknya ada {#Emph}penonton usil nih{#Prev}, Girls! Mana pihak keamanan kita? {#Emph}Oh! {#Prev}Ada {#Emph}tepat di sini..."
      Speaker = "Scylla"
      Event = "ScyllaMiscStart34"
    }
    {
      Id = "Scylla_0448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap kali kamu nunjukin mukamu di sekitar sini, Nona, standarmu bener-bener makin tenggelam ke titik terendah!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart35"
    }
    {
      Id = "Scylla_0450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami rasa malam ini paling pas dibuka pakai lagu hits pertama kami! Gimana menurutmu, Nona?"
      Speaker = "Scylla"
      Event = "ScyllaMiscStart36"
    }
    {
      Id = "Scylla_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pintu kesuksesan kita udah di depan mata, Girls! Jadi jangan sampai berantakan sekarang!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStartWonAgainstHer01"
    }
    {
      Id = "Scylla_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, sekarang rapatkan barisan dan jangan bikin kacau kayak {#Emph}waktu itu! {#Prev}Paham, Girls?"
      Speaker = "Scylla"
      Event = "ScyllaMiscStartWonAgainstHer02"
    }
    {
      Id = "Scylla_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan bikin kacau penampilan kita lagi ya, Roxy, {#Emph}ngerti?! {#Prev}Sekarang hitung temponya, cepetan!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStartWonAgainstHer03"
    }
    {
      Id = "Scylla_0423"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jetty sama Roxy itu {#Emph}beneran {#Prev}yang terbaik, kan? Tapi aku bakal makin sayang kalau mereka bisa {#Emph}berguna {#Prev}sedikit aja sekali-kali!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStartWonAgainstHer04"
    }
    {
      Id = "Scylla_0424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penonton malam ini susah dipuaskan! Tapi kalau mereka nggak bisa menghargai karya seni kita, bakal kita {#Emph}paksa!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStartWonAgainstHer05"
    }
    {
      Id = "Scylla_0449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini panggung{#Emph}ku{#Prev}, dan ini pertunjukan{#Emph}ku{#Prev}, dan kamu {#Emph}nggak bakal {#Prev}bisa merusaknya {#Emph}lagi!"
      Speaker = "Scylla"
      Event = "ScyllaMiscStartWonAgainstHer06"
    }
