      Event = "ScyllaAboutMerch01"
    }
    {
      Id = "Scylla_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari mana {#Emph}kamu {#Prev}tahu kami nawarin gulungan gambar? {#Emph}Oh, hohohoh! {#Prev}Jangan-jangan kamu udah punya sebagian pernak-pernik kami dan pengin {#Emph}menguasai semuanya sendiri! {#Prev}Ya udah, kalau kamu mau perlakuan khusus, {#Emph}sini maju ambil sendiri!"
      Speaker = "Scylla"
      Event = "ScyllaAboutMerch01"
    }
    {
      Id = "Scylla_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini bakal jadi malam kita! Kalian bisa {#Emph}merasakannya {#Prev}nggak, gengs? Nggak tahu ya sama kalian, tapi {#Emph}aku {#Prev}ngerasa makin {#Emph}tak terhentikan {#Prev}dari biasanya! {#Emph}Ohh{#Prev}, dan pas banget pada {#Emph}waktunya..."
      Speaker = "Scylla"
      Event = "ScyllaAboutShrine01"
    }
    {
      Id = "MelinoeField_3588"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau masih bisa dihentikan, meski kehendak Malam memang membuatmu lebih kuat. Mau kita buktikan sampai sejauh mana?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutShrine01"
    }
    {
      Id = "Scylla_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa dihentikan? {#Emph}Ahaha. Kami? {#Prev}Kamu nggak paham, Nona. Kami nggak pernah absen satu pertunjukan pun, dan kami {#Emph}nggak {#Prev}akan mulai sekarang! {#Emph}Yah{#Prev}, yang namanya penampilan langsung, kan nggak ada yang tahu apa yang bakal terjadi..."
      Speaker = "Scylla"
      Event = "ScyllaAboutShrine01"
    }
    {
      Id = "Scylla_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh! {#Prev}Senang banget kamu nongol malam ini, Nona, soalnya kamu beneran bakal kena batunya! Kami {#Emph}baru aja kelar {#Prev}latihan koreografi {#Emph}terbaik {#Prev}kami dan udah {#Emph}nggak sabar {#Prev}buat mencobanya di panggung konser...!"
