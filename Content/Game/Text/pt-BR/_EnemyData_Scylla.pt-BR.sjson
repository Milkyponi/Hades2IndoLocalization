      Event = "ScyllaAboutShrine02"
    }
    {
      Id = "MelinoeField_3589"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lakukan saja kalau begitu. Meski aku sudah tahu apa saja yang membuat kalian lebih kuat daripada biasanya."
