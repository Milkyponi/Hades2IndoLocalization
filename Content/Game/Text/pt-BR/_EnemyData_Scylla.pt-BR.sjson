      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sialan, lagunya nempel banget di kepala..."
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Konser selesai."
