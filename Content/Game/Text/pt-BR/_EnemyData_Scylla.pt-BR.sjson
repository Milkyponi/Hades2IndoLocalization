      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Canggung sekali tadi..."
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akhirnya..."
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "Melinoe_1103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka benar-benar nggak mau diam..."
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenang dan damai."
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku benci dia."
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Latihan lagi sana!"
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Coba nyanyikan yang {#Emph}itu..."
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5567"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keheningan ini mestinya membantuku tidur nyenyak..."
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_5568"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Enyahlah dari kepalaku, Scylla..."
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "MelinoeField_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasakan itu untuk yang semalam."
      Speaker = "Melinoe"
      Event = "Scylla.BossKillVoiceLines"
    }
    {
      Id = "Scylla_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ohh, {#Emph}hohoho{#Prev}, nggak mungkin! {#Emph}Mustahil. {#Prev}Lihat, teman-teman, ada seorang {#Emph}nona! {#Prev}Nona-nona nggak pernah datang nonton konser kita, kamu pasti beda ya, siapa namamu? Oh, buat dirimu nyaman, kami baru saja mau mulai, kan, teman-teman?"
      Speaker = "Scylla"
      Event = "ScyllaFirstMeeting"
    }
    {
      Id = "Melinoe_0498"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Siren. Seharusnya aku sudah tahu kalianlah sumber nyanyian itu. Menyelinap turun ke Dunia Bawah, ya?"
      Speaker = "Melinoe"
      Event = "ScyllaFirstMeeting"
    }
    {
      Id = "Scylla_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tekanan di bawah sini pas banget tahu! Jauh lebih baik daripada tekanan berkarya saat semua penggemar menonton sambil memohon-mohon, {#Emph}Scylla, mana lagu barumu?!"
      Speaker = "Scylla"
      Event = "ScyllaFirstMeeting"
    }
    {
      Id = "Melinoe_0499"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukannya kamu menenggelamkan yang kamu sebut 'penggemar' itu sampai mati? Apa masih ada yang tersisa?"
      Speaker = "Melinoe"
      Event = "ScyllaFirstMeeting"
    }
    {
      Id = "Scylla_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan {#Emph}pernah {#Prev}bicara begitu tentang para penggemar kami! Hei, teman-teman...? Bagaimana kalau kita beri dia {#Emph}tarian dan nyanyian andalan kita?"
      Speaker = "Scylla"
      Event = "ScyllaFirstMeeting"
    }
    {
      Id = "Scylla_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nikmatilah, Nona! Salah satu sponsor setia kami mewujudkan semua impian kami: panggung {#Emph}yang serbabaru, {#Prev}{#Emph}dan{#Prev}... kolaborasi bareng salah satu nama {#Emph}paling kondang {#Prev}di seantero lautan ini!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight01"
    }
    {
      Id = "MelinoeField_3538"
      InheritFrom = "BaseNarrative"
      DisplayName = "Charybdis, bersamamu di sini...? Ini bukan ulah sponsor, melainkan kehendak Sang Malam. Seiring rasa takut menyebar, begitu pula perwujudan mimpi buruk ini... yang rupanya mimpi burukku sendiri."
      Speaker = "Melinoe"
      Event = "ScyllaAboutAltFight01"
    }
    {
      Id = "Scylla_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jelek-jelekkan saja sponsor kami sesukamu, tapi mereka punya selera tinggi, sedangkan kamu tidak! Berkat mereka, kami merilis singel terbaru, dan tak ada yang bisa kamu perbuat untuk menghentikannya...! Yah, setidaknya bagian awalnya takkan bisa kamu hentikan."
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight01"
    }
    {
      Id = "Scylla_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Datang lagi untuk mencemooh kami, Nona? Usahamu {#Emph}takkan berhasil! {#Prev}Apa pun yang kamu lakukan, penonton mengira itu semua bagian dari pertunjukan. Mereka ke sini bukan cuma demi musik, tapi demi {#Emph}pengalaman seutuhnya!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight02"
    }
    {
      Id = "MelinoeField_3539"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan melihatmu beserta bandmu dihajar habis-habisan berulang kali adalah pengalaman yang ingin kalian sajikan? Kalian para seniman memang benar-benar berkorban demi karya."
      Speaker = "Melinoe"
      Event = "ScyllaAboutAltFight02"
    }
    {
      Id = "Scylla_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat {#Emph}sekali! {#Prev}Aku sudah mengorbankan {#Emph}segalanya {#Prev}demi mencapai titik ini dalam karierku, demi meraih momen {#Emph}ini{#Prev}, di panggung {#Emph}ini! {#Prev}Dan aku siap berkorban lebih banyak lagi... bagaimana dengan {#Emph}kamu?!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight02"
    }
    {
      Id = "Scylla_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kembali ke panggung lama kami yang lebih sempit seperti yang kamu lihat, tapi pasti {#Emph}cuma {#Prev}untuk malam ini saja kok! Sponsor kami pasti akan menepati janji! Menempatkan kami kembali di bawah {#Emph}sorotan lampu panggung {#Prev}tempat kami {#Emph}seharusnya berada, hm! {#Prev}Suatu saat nanti!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight03"
    }
    {
      Id = "MelinoeField_3540"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu siapa sebenarnya sponsor misterius ini, sampai-sampai menentukan lokasi pertarungan kita dan apakah si monster Charybdis itu tampil sebagai bintang tamu?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutAltFight03"
    }
    {
      Id = "Scylla_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus usahamu, Nona. Kamu boleh menerobos masuk panggung kami, tak {#Emph}peduli {#Prev}seberapa ukurannya... kamu boleh mencoba meniru selera gaya kami... {#Emph}bahkan merebut penggemar kami! {#Prev}Tapi kamu takkan {#Emph}pernah {#Prev}bisa merebut {#Emph}sponsor kami!!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight03"
    }
    {
      Id = "Scylla_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kadang kami suka balik lagi ke panggung mungil ini demi bernostalgia! Banyak penggemar kami yang ingin kami tetap setia pada akar musik kami."
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight04"
    }
    {
      Id = "MelinoeField_3541"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kamu menuruti segala permintaan mereka? Mereka terdengar bukan seperti penggemar jika terus memaksakan kehendak mereka padamu."
      Speaker = "Melinoe"
      Event = "ScyllaAboutAltFight04"
    }
    {
      Id = "Scylla_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, perkataan khas dari seseorang yang tak pernah {#Emph}punya {#Prev}penggemar untuk dipuaskan. Kami ada di sini hanya karena penonton begitu {#Emph}mencintai {#Prev}lagu-lagu kami. Jadi ini hubungan saling memberi dan menerima: musik {#Emph}kami, {#Prev}nyawa para {#Emph}pelaut! {#Prev}Dan nyawa {#Emph}kamu!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight04"
    }
    {
      Id = "Scylla_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Inilah kesempatan emas yang telah lama kami {#Emph}tunggu-tunggu! {#Prev}Sudah kubilang pada teman-teman bahwa kami bakal kembali ke panggung megah di bawah sorotan lampu dalam {#Emph}sekejap mata. {#Prev}{#Emph}Oh{#Prev}, tapi semakin {#Emph}terkenal {#Prev}kami... bakal semakin banyak pula {#Emph}pembenci {#Prev}kami..."
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight05"
    }
    {
      Id = "MelinoeField_3542"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lalu apa kamu juga berniat membungkam semua pembencimu sama seperti para penggemarmu? Jika begitu, bagaimana kamu bisa terus menambah lebih banyak massa?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutAltFight05"
    }
    {
      Id = "Scylla_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak usah repot-repot memikirkan hal itu dengan kepala cantikmu itu, Nona! Masalahmu jauh lebih besar, contohnya bintang tamu kami... yang kebetulan sangat jago melahap banyak pembenci sekaligus."
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight05"
    }
    {
      Id = "Scylla_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ramai sekali penonton malam ini, Nona! Oh, kami memang nggak dapat kerumunan sebanyak ini {#Emph}setiap {#Prev}saat, {#Emph}meskipun {#Prev}seharusnya memang selalu begitu! Yah, dengan ketenaran kami yang sebesar ini, wajar saja kalau kami mulai menarik penggemar kasual!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight06"
    }
    {
      Id = "MelinoeField_3543"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak semua Arwah di Dunia Bawah ini bisa meluangkan setiap malam mereka untuk menghadiri konser kalian, Scylla. Lagipula lagumu tak sebanyak itu."
      Speaker = "Melinoe"
      Event = "ScyllaAboutAltFight06"
    }
    {
      Id = "Scylla_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mana mungkin kau tahu?! Kami memang suka bawain lagu-lagu hits kami, tapi persediaan kami masih banyak! Lagu yang kemungkinan besar belum pernah kau dengar, berhubung kau ini cuma penggemar paling {#Emph}biasa {#Prev}dari semuanya!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight06"
    }
    {
      Id = "MelinoeField_3544"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, apa langkah selanjutnya untuk Scylla and the Sirens setelah kalian berhasil terkenal? Panggung yang lebih megah? Lagu yang lebih bagus?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutAltFight07"
    }
    {
      Id = "Scylla_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Panggung yang lebih megah, {#Emph}bisa jadi! {#Prev}Lagu yang lebih bagus, {#Emph}mustahil. {#Prev}Soalnya musik kami {#Emph}sudah yang paling {#Prev}hebat! Kami {#Emph}bisa {#Prev}saja bikin lagu baru kapan pun kami mau, {#Emph}heh! {#Prev}Tapi sekarang, aku dan gengku menginginkan {#Emph}sesuatu yang lebih..."
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight07"
    }
    {
      Id = "Scylla_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali Charybdis tak bisa hadir malam ini, Nona! Padahal harusnya dia datang. Mungkin dia lagi di {#Emph}permukaan{#Prev}, rakus menjejalkan makanan ke mulutnya seperti biasa!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight08"
    }
    {
      Id = "MelinoeField_3545"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa kumaklumi. Pasti butuh banyak asupan makanan untuk menumbuhkan kembali semua tentakel yang terpaksa kutebas itu."
      Speaker = "Melinoe"
      Event = "ScyllaAboutAltFight08"
    }
    {
      Id = "Scylla_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, pertunjukan harus tetap berlanjut! Kami akan membawakan {#Emph}Rock and a Hard Place{#Prev}, ada ataupun tanpa bintang tamu kami! Dan penonton kami yang sedikit tapi setia ini bakal {#Emph}menikmatinya habis-habisan!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAltFight08"
    }
    {
      Id = "Scylla_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sudah kuduga! {#Prev}Dia datang {#Emph}lagi! {#Prev}Kau siap untuk pertunjukan lainnya, Nona? Kami sudah melatih materi kami, latihan tanpa henti, karena suatu hari nanti? Aku bakal jadi {#Emph}bintang besar! {#Prev}Oh, aku dan gengku!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAmbitions01"
    }
    {
      Id = "Melinoe_1042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa hubungannya ambisi bermusikmu dengan tindakan kekerasan tanpa alasan terhadap{#Emph}ku?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutAmbitions01"
    }
    {
      Id = "Scylla_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia cuma tukang cemooh, teman-teman, abaikan dia, dan mulai lagi dari awal, {#Emph}dua, tiga, empat...!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAmbitions01"
    }
    {
      Id = "Scylla_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku selalu ingin bernyanyi di depan kerumunan penonton yang luar biasa besar, kau tahu? Dan bukan cuma sekumpulan pelaut dekil, tapi teater-teater raksasa yang ada di daratan!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAmbitions02"
    }
    {
      Id = "Melinoe_1828"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan bidang keahlianku. Apakah pertunjukan di teater-teater megah itu biasanya melibatkan upaya menenggelamkan para penontonnya?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutAmbitions02"
    }
    {
      Id = "Scylla_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu saja... dan manusia fana berbondong-bondong datang ke sana, meronta-ronta dan berteriak kegirangan cuma demi melihat sekilas, {#Emph}heh! {#Prev}Padahal kau mendapatkan pertunjukan {#Emph}khusus untuk dirimu sendiri!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAmbitions02"
    }
    {
      Id = "Melinoe_1830"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal kau tahu, kupikir kawanan Siren lah yang seharusnya bernyanyi. Tapi malah {#Emph}kau {#Prev}yang terus mengoceh tak henti-hentinya ke arahku, Scylla..."
      Speaker = "Melinoe"
      Event = "ScyllaAboutSirens01"
    }
    {
      Id = "Scylla_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jangan {#Prev}dengarkan dia, teman-teman! Vokal latar kalian adalah tulang punggung pertunjukan ini! Aku punya suaranya, {#Emph}kalian {#Prev}punya musiknya, dan kita punya {#Emph}sihirnya! {#Prev}Ayo kita beri dia sedikit unjuk gigi, {#Emph}ya?"
      Speaker = "Scylla"
      Event = "ScyllaAboutSirens01"
    }
    {
      Id = "Scylla_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hubungan kami memang pasang surut, Jetty, Roxy, dan aku. Cuma pertengkaran kecil biasa! Tapi gara-gara {#Emph}kamu{#Prev}, kami sampai berantem di depan {#Emph}umum! {#Prev}Dan kami {#Emph}nggak bisa {#Prev}biarkan hal itu."
      Speaker = "Scylla"
      Event = "ScyllaAboutSirens02"
    }
    {
      Id = "MelinoeField_2720"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau ini bisa membuatmu merasa lebih baik, kutukan yang kutimpakan pada mereka cuma sementara. Terus terang aku malah kaget kutukan itu mempan pada mereka! Mekar Malam biasanya cuma mempan pada orang mati."
      Speaker = "Melinoe"
      Event = "ScyllaAboutSirens02"
    }
    {
      Id = "Scylla_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini band-ku. Dan kalau sampai ada yang bikin Jetty dan Roxy naik pitam dan saling serang, itu {#Emph}bukan {#Prev}gara-gara {#Emph}kamu! {#Prev}Bener kan, gengs?"
      Speaker = "Scylla"
      Event = "ScyllaAboutSirens02"
    }
    {
      Id = "Scylla_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak bisa lepas dari pesona kami, {#Emph}kan{#Prev}, Nona? Oh, santai saja, semua orang juga begitu, apalagi para pelaut, kami ini memang kelewat {#Emph}keren! {#Prev}Kamu bisa berlayar?"
      Speaker = "Scylla"
      Event = "ScyllaAboutStage01"
    }
    {
      Id = "Melinoe_2040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percaya dirimu patut diacungi jempol, tapi aku kemari cuma karena harus melewati panggung konyol ini. Jadi bagaimana kalau kita lewati saja pertunjukannya."
      Speaker = "Melinoe"
      Event = "ScyllaAboutStage01"
    }
    {
      Id = "Scylla_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku punya ide yang lebih mantap: Gimana kalau kita {#Emph}mulai {#Prev}konsernya? Yang kami butuhkan cuma sedikit penonton, dan posisi {#Emph}kamu {#Prev}sekarang sudah pas banget."
      Speaker = "Scylla"
      Event = "ScyllaAboutStage01"
    }
    {
      Id = "Scylla_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata mereka... lagu-lagu kami itu {#Emph}bikin klepek-klepek sampai mati{#Prev}, tapi akhir-akhir ini kami jarang dapat teman kumpul. Oh, kamu pasti nggak tahu apa-apa soal {#Emph}itu{#Prev}, kan? Soalnya ada {#Emph}seseorang {#Prev}yang mencoreng nama baik kami..."
      Speaker = "Scylla"
      Event = "ScyllaAboutReputation01"
    }
    {
      Id = "Melinoe_1043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Reputasimu adalah urusanmu sendiri, mau kau bangun atau hancurkan. Lagipula, kurasa tak ada seorang pun yang kukenal pernah mendengar tentang kalian."
      Speaker = "Melinoe"
      Event = "ScyllaAboutReputation01"
    }
    {
      Id = "Scylla_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo, gengs! Mari kita {#Emph}tampil habis-habisan {#Prev}lagi sebelum kerumunan penonton datang! Mereka {#Emph}pasti {#Prev}datang! Aku {#Emph}yakin {#Prev}banget!"
      Speaker = "Scylla"
      Event = "ScyllaAboutReputation01"
    }
    {
      Id = "Scylla_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh hai, sebagai salah satu penggemar kami, menurutmu {#Emph}apa {#Prev}hal terbaik dari Scylla and the Sirens, {#Emph}hm? {#Prev}Lagu hit terbaru kami? Atau gaya kami yang tiada tanding?"
      Speaker = "Scylla"
      Event = "ScyllaAboutSurvey01"
    }
    {
      Id = "Melinoe_2039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selera gayamu jelas bukan seleraku, itu yang bisa kupastikan."
      Speaker = "Melinoe"
      Event = "ScyllaAboutSurvey01"
    }
    {
      Id = "Scylla_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh, {#Prev}nggak apa-apa! Nggak semua orang punya {#Emph}selera bagus{#Prev}. Setidaknya kamu cukup bernyali untuk mengakuinya, walau kami tetap akan menghajarmu karena hinaan itu."
      Speaker = "Scylla"
      Event = "ScyllaAboutSurvey01"
    }
    {
      Id = "Scylla_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh, baguslah, {#Prev}kamu datang tepat waktu untuk set lagu kami! Sedang menggarap lagu berjudul {#Emph}Kucakar Habis (Matamu Lalu Kutenggelamkan Sampai Mampus), heh! {#Prev}Berasal dari pengalaman pribadi banget."
      Speaker = "Scylla"
      Event = "ScyllaAboutSongs01"
    }
    {
      Id = "Melinoe_1829"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah lagunya lebih bagus dari yang kudengar saat berjalan kemari?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutSongs01"
    }
    {
      Id = "Scylla_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak, {#Emph}sama sekali nggak! {#Prev}Karena {#Emph}semua {#Prev}lagu kami itu {#Emph}yang terbaik, heh! {#Prev}Masing-masing bagaikan anak kecil yang {#Emph}sempurna! Bukan anak {#Emph}nakal{#Prev}, kayak {#Emph}kamu..."
      Speaker = "Scylla"
      Event = "ScyllaAboutSongs01"
    }
    {
      Id = "Scylla_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana menurutmu lagu terbaru kami, Nona? Jujur saja! Nggak ada jawaban benar {#Emph}atau {#Prev}salah, kok! Kami sangat {#Emph}menghargai {#Prev}masukan dari para penggemar!"
      Speaker = "Scylla"
      Event = "ScyllaAboutSongs02"
    }
    {
      Id = "MelinoeField_2017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau mencari masukan dari para penggemarmu, tanyakan pada {#Emph}mereka. {#Prev}Kalau bagiku, refreinnya cukup terngiang-ngiang, tapi lirik dan tema meresahkannya agak mengganggu konsentrasi."
      Speaker = "Melinoe"
      Event = "ScyllaAboutSongs02"
    }
    {
      Id = "Scylla_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meresahkan? Mengganggu konsentrasi?! {#Emph}Memikat! Begitulah {#Prev}seharusnya musik yang {#Emph}bagus{#Prev}. Begitulah Scylla and the Sirens {#Emph}yang sesungguhnya! {#Prev}Soal lagu kami, {#Emph}hihi! {#Prev}Kamu bakal lebih paham kalau mendengarkannya {#Emph}sekali lagi..."
      Speaker = "Scylla"
      Event = "ScyllaAboutSongs02"
    }
    {
      Id = "MelinoeField_2564"
      InheritFrom = "BaseNarrative"
      DisplayName = "Scylla, aku menyadari lagumu {#Emph}Kucakar Habis {#Prev}mungkin terinspirasi dari kisah nyata. Apakah mencoba menenggelamkanku belum cukup menghibur sampai-sampai aku juga harus jadi bahan ejekanmu?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutSongs03"
    }
    {
      Id = "Scylla_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh, hoho, {#Prev}kok bisa kepedean banget, sih? Aku sudah menggarap lagu itu jauh sebelum {#Emph}kamu {#Prev}muncul. Segala bentuk kemiripan itu murni kebetulan semata!"
      Speaker = "Scylla"
      Event = "ScyllaAboutSongs03"
    }
    {
      Id = "MelinoeField_2565"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah. Menghina rambut dan pakaianku? Mengaku-ngaku kalau aku terobsesi padamu? Tapi kalau bukan aku yang jadi sasaran lagumu, lantas siapa, coba beri tahu?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutSongs03"
    }
    {
      Id = "Scylla_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak usah bawa-bawa urusan pribadi, Nona! Kalau aku harus bagi-bagi {#Emph}setiap {#Prev}detail kehidupan pribadiku ke setiap fans fanatik gila yang nyelonong ke sini, namanya bukan kehidupan {#Emph}pribadi {#Prev}lagi, {#Emph}kan?"
      Speaker = "Scylla"
      Event = "ScyllaAboutSongs03"
    }
    {
      Id = "MelinoeField_2562"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau belum punya materi baru, Scylla? Kau mungkin bakal menggaet penonton yang jauh lebih banyak kalau punya beberapa lagu lagi."
      Speaker = "Melinoe"
      Event = "ScyllaAboutSongs04"
    }
    {
      Id = "Scylla_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Diam {#Emph}kau! {#Prev}Lagu kami lebih banyak dari yang bisa kau {#Emph}hitung! {#Prev}Kau saja yang belum siap mendengarnya. {#Emph}Nggak ada {#Prev}yang siap! {#Emph}Kesempurnaan {#Prev}itu butuh waktu, {#Emph}Nona."
      Speaker = "Scylla"
      Event = "ScyllaAboutSongs04"
    }
    {
      Id = "MelinoeField_2563"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi, kesempurnaan itu mustahil digapai... kalau terus mengejarnya, kau takkan pernah sampai. Kau pasti punya materi yang masih dikerjakan yang bisa kau bawakan daripada lagu basi yang itu-itu melulu."
      Speaker = "Melinoe"
      Event = "ScyllaAboutSongs04"
    }
    {
      Id = "Scylla_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Lagu basi yang itu-itu melulu...? {#Prev}Kalian dengar itu, Teman-teman? Sepertinya maksud dia itu lagu {#Emph}hits terhebat{#Prev}, atau lagu {#Emph}klasik sepanjang masa{#Prev}, iya kan? {#Emph}Heh! {#Prev}Kau memang nggak ngerti seni, Nona. Kami di sini untuk {#Emph}memuaskan penggemar!"
      Speaker = "Scylla"
      Event = "ScyllaAboutSongs04"
    }
    {
      Id = "Scylla_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, lagu terbaru kami yang mana yang paling kau suka, Nona? Sekarang kami punya sajian buat {#Emph}semua orang! {#Prev}Bahkan termasuk kau."
      Speaker = "Scylla"
      Event = "ScyllaAboutSongs05"
    }
    {
      Id = "MelinoeField_3587"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku enggan memilih. Kurasa bentrokan berulang kali dengan kalian jelas berdampak besar pada kemampuanku untuk mengapresiasi nilai musik kalian apa adanya."
      Speaker = "Melinoe"
      Event = "ScyllaAboutSongs05"
    }
    {
      Id = "Scylla_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh, {#Prev}sayang banget! Kalau kau nggak bisa mengapresiasi seni demi seni itu sendiri dan menuntut standar setinggi langit dari kami yang menciptakannya, terus {#Emph}ngapain {#Prev}juga kau ke {#Emph}sini?!"
      Speaker = "Scylla"
      Event = "ScyllaAboutSongs05"
    }
    {
      Id = "MelinoeField_4308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa tadi itu lagu baru yang kudengar saat berjalan ke sini? Soal kilauan harta karun. Lagu lain tentang lautan!"
      Speaker = "Melinoe"
      Event = "ScyllaAboutBallad01"
    }
    {
      Id = "Scylla_0436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}kan bisa {#Prev}bilang, {#Emph}Scylla, aku nggak paham apa pun soal tema lagu, jadi aku nggak bisa mengapresiasi kedalaman karyamu! {#Prev}Tapi {#Emph}ya{#Prev}, itu {#Emph}memang {#Prev}lagu baru! Dan baru bagian pertamanya doang."
      Speaker = "Scylla"
      Event = "ScyllaAboutBallad01"
    }
    {
      Id = "MelinoeField_4309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa bagian keduanya sebentar lagi menyusul. Kau membuat penampilanmu jadi merepotkan tanpa alasan dengan melawanku, tapi itu pilihan yang selalu kau ambil."
      Speaker = "Melinoe"
      Event = "ScyllaAboutBallad01"
    }
    {
      Id = "Scylla_0437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya kami kan harus menenggelamkan {#Emph}seseorang! {#Prev}Dan para pelaut sudah terlalu {#Emph}gampangan{#Prev}, Nona. Kau takkan pernah jadi seniman sejati kalau nggak mendorong diri {#Emph}lebih keras, lebih keras, dan lebih keras lagi...!"
      Speaker = "Scylla"
      Event = "ScyllaAboutBallad01"
    }
    {
      Id = "Scylla_0439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana menurutmu penampilan terbaru kami tadi, Nona? Para kritikus bilang {#Emph}Bewitching Eyes {#Prev}menunjukkan sisi Scylla and the Sirens yang lebih {#Emph}penuh jiwa {#Prev}dan {#Emph}rapuh{#Prev}. Tapi tahu apa sih mereka?"
      Speaker = "Scylla"
      Event = "ScyllaAboutBallad02"
    }
    {
      Id = "MelinoeField_4311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa menyimak liriknya dengan jelas sambil menangkis serangan kalian, tapi kau bernyanyi soal mata memikat berwarna merah dan hijau, ramuan cinta, dan semacamnya. Apa kau benar-benar merasa begitu terhadapku?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutBallad02"
    }
    {
      Id = "Scylla_0440"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cih, ya nggak lah! {#Prev}Ngapain juga aku merasakan hal-hal kayak gitu, apalagi sama {#Emph}kau{#Prev}, Nona? Pernah dengar yang namanya {#Emph}karya fiksi? {#Prev}Lagipula, Jetty yang kebanyakan nulis liriknya."
      Speaker = "Scylla"
      Event = "ScyllaAboutBallad02"
    }
    {
      Id = "MelinoeField_4312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh berharap aku percaya bahwa lagu {#Emph}I Am Gonna Claw {#Prev}maupun {#Emph}Bewitching Eyes {#Prev}tak ada hubungannya dengan pertemuan kita? Walaupun jika kau memang terpikat padaku, caramu menunjukkannya sungguh aneh."
      Speaker = "Melinoe"
      Event = "ScyllaAboutBallad03"
    }
    {
      Id = "Scylla_0441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak mungkin! {#Emph}Kau {#Prev}yang selalu muncul di {#Emph}sini{#Prev}, Nona. Jelas-jelas kau yang terpikat sama {#Emph}aku! {#Prev}Atau sama salah satu dari kami. Jetty tahu itu, Roxy tahu itu, {#Emph}semua orang {#Prev}di Oceanus tahu itu!"
      Speaker = "Scylla"
      Event = "ScyllaAboutBallad03"
    }
    {
      Id = "MelinoeField_4313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang benar saja, Scylla. Kuakui aku tak sebenci itu pada lagu-lagumu seperti sebelumnya, tapi batasku hanya sampai di situ."
      Speaker = "Melinoe"
      Event = "ScyllaAboutBallad03"
    }
    {
      Id = "Scylla_0442"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Uuuh{#Prev}, kalian dengar itu, Teman-teman? Cuma sampai di situ batasnya! Kan sudah {#Emph}kubilang{#Prev}. Sekarang pilihannya antara {#Emph}dia {#Prev}yang turun dari panggung ini, atau {#Emph}kita!"
      Speaker = "Scylla"
      Event = "ScyllaAboutBallad03"
    }
    {
      Id = "Scylla_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku nggak tahu apa yang kau perbuat, Nona, tapi belakangan ini, aku hampir nggak bisa mendengar pikiranku sendiri... apalagi {#Emph}bernyanyi! {#Prev}Aku benci kau, dasar {#Emph}penyihir! {#Prev}Kau {#Emph}harus {#Prev}bertanggung jawab!"
      Speaker = "Scylla"
      Event = "ScyllaAboutSongVolume01"
    }
    {
      Id = "MelinoeField_2719"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau tidak, kau mau apa? Aku akan memakai taktik apa pun yang kuanggap pantas. Tak perlu mendengar ocehan omong kosongmu justru membuatku lebih mudah mengenyahkanmu kembali ke kedalaman malam ini."
      Speaker = "Melinoe"
      Event = "ScyllaAboutSongVolume01"
    }
    {
      Id = "Scylla_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kau menyukai lagu kami. Nggak bisa hidup tanpanya! Dan aku {#Emph}takkan {#Prev}bisa {#Emph}dibungkam! {#Prev}Apa pun yang kau perbuat, aku akan selalu bernyanyi di kepala{#Emph}ku{#Prev}, dan kepala{#Emph}mu!"
      Speaker = "Scylla"
      Event = "ScyllaAboutSongVolume01"
    }
    {
      Id = "Scylla_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh halo Teman-teman, tebak siapa?! Ini dia {#Emph}mangsa yang sempat lolos{#Prev}, itu dia orangnya! {#Emph}Mm{#Prev}, ada satu hal yang perlu kau tahu tentangku, Nona... sekali kutangkap... takkan pernah kulepaskan."
      Speaker = "Scylla"
      Event = "ScyllaAboutChlams01"
    }
    {
      Id = "Melinoe_2037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu sama sekali tidak mengejutkanku. Sebagian makhluk laut memang terkenal suka menempel. Teritip, kerrang..."
      Speaker = "Melinoe"
      Event = "ScyllaAboutChlams01"
    }
    {
      Id = "Scylla_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}bukan {#Prev}kerrang!! Tarik kembali kata-katamu. Bakal {#Emph}kupaksa {#Prev}kau menarik kata-katamu!"
      Speaker = "Scylla"
      Event = "ScyllaAboutChlams01"
    }
    {
      Id = "Melinoe_2038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar dulu! Waktu itu aku tak bermaksud menyinggung, dan tak pernah bilang kau itu {#Emph}benar-benar {#Prev}kerrang. Setidaknya marahlah pada hal yang berdasar kenyataan."
      Speaker = "Melinoe"
      Event = "ScyllaAboutChlams02"
    }
    {
      Id = "Scylla_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar sendiri kan, Teman-teman, dia masih terus mengoceh soal kerrang! Meledek cangkang mungilku ini, ya, {#Emph}hm-hm! {#Prev}Ayo, kita tunjukkan padanya cara kita menghadapi pengacau di {#Emph}tempat ini!"
      Speaker = "Scylla"
      Event = "ScyllaAboutChlams02"
    }
    {
      Id = "Scylla_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hohh, {#Prev}kaget melihat kami lagi, Nona? {#Emph}Heh, {#Prev}soalnya kami nggak bakal ke mana-mana. Lagipula, ini kan tur {#Emph}comeback akbar {#Prev}kami!"
      Speaker = "Scylla"
      Event = "ScyllaAboutComeback01"
    }
    {
      Id = "Melinoe_2042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira aku sudah membereskanmu terakhir kali, tapi kau masih di sini. Apa aku harus mengusirmu kembali ke laut lagi?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutComeback01"
    }
    {
      Id = "Scylla_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entahlah, apa aku harus menyuruh Jetty dan Roxy untuk {#Emph}bermain {#Prev}sepenuh jiwa? {#Emph}Nggak{#Prev}, nggak perlu! Karena memang itulah keahlian mereka! {#Emph}Iya kan{#Prev}, Teman-teman?"
      Speaker = "Scylla"
      Event = "ScyllaAboutComeback01"
    }
    {
      Id = "Scylla_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, kau terus saja mencoba {#Emph}membunuh{#Prev}ku, Nona! Sisi Nimfa Laut di masa laluku bilang {#Emph}lupakan saja {#Prev}dan move on! Tapi, aku sudah malas mendengarkannya."
      Speaker = "Scylla"
      Event = "ScyllaAboutDying01"
    }
    {
      Id = "MelinoeField_2018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Fakta bahwa kau tak mendengarkan dirimu sendiri menjelaskan banyak hal. Aku tahu betul membunuh seorang Oceanid itu sia-sia. Aku hanya ingin kau menyingkir dari jalanku."
      Speaker = "Melinoe"
      Event = "ScyllaAboutDying01"
    }
    {
      Id = "Scylla_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar itu, Teman-teman? Aku jelas-jelas mendengar si Nona bilang {#Emph}aku butuh kau {#Prev}tadi, {#Emph}hoho! {#Prev}Karya seni kami memang mengubah hidup orang! Gimana kalau kita ubah hidup orang yang {#Emph}satu ini {#Prev}sekarang {#Emph}juga...?"
      Speaker = "Scylla"
      Event = "ScyllaAboutDying01"
    }
    {
      Id = "Scylla_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat siapa yang datang kepagian buat konser malam ini! Pintunya belum waktunya dibuka, Nona! Nggak heran sih, kau kan {#Emph}mana peduli {#Prev}sama tata tertib masuk akal di tempat konser ini."
      Speaker = "Scylla"
      Event = "ScyllaAboutPackagedBounties01"
    }
    {
      Id = "MelinoeField_2718"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku sudah paham luar kepala dengan tempat ini sekarang. Dan kalau kalian memang belum siap manggung, baguslah! Lagipula aku juga tak sudi mendengarnya darimu."
      Speaker = "Melinoe"
      Event = "ScyllaAboutPackagedBounties01"
    }
    {
      Id = "Scylla_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, {#Emph}sayang sekali! {#Prev}Karena meski kamu datang kepagian, kamu {#Emph}pas {#Prev}banget tiba buat konser intim {#Emph}pra-tampil {#Prev}yang {#Emph}baru saja mau dimulai!"
      Speaker = "Scylla"
      Event = "ScyllaAboutPackagedBounties01"
    }
    {
      Id = "Scylla_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba kasih tahu aku, Nona, {#Emph}kok bisa {#Prev}kamu seperti tahu semua trik kami? Selain bagian kami terus memainkan aksi yang sama, ya. Padahal biasanya penonton langsung tewas terpukau!"
      Speaker = "Scylla"
      Event = "ScyllaAboutOdysseus01"
    }
    {
      Id = "Melinoe_2041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ahli Taktik Ulung Odysseus menyampaikan salamnya. Dia menceritakan segalanya tentangmu. Kau mengaku tak pernah membiarkan mangsamu lolos, padahal setahuku {#Emph}hampir semua{#Prev} awak kapalnya yang malang berhasil kabur darimu, kecuali enam orang."
      Speaker = "Melinoe"
      Event = "ScyllaAboutOdysseus01"
    }
    {
      Id = "Scylla_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Odysseus, hah! {#Prev}Oh, {#Emph}dia {#Prev}masih nyangkut di mata kail kami! Ikan besar seperti itu cuma {#Emph}butuh waktu agak lama buat ditarik{#Prev}, seperti yang biasa dia katakan. Lagu kami pasti masih terngiang-ngiang di kepalanya yang {#Emph}manis {#Prev}itu! Dan sekarang giliran kepalamu..."
      Speaker = "Scylla"
      Event = "ScyllaAboutOdysseus01"
    }
    {
      Id = "Scylla_0303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami tahu kenapa kamu terus-menerus muncul di sini, iya kan, Nona? Kamu sama saja seperti Odysseus dan yang {#Emph}lainnya! {#Prev}Tapi... apa maksud omong kosong soal {#Emph}Putri Dunia Bawah {#Prev}yang terus dia bicarakan itu?"
      Speaker = "Scylla"
      Event = "ScyllaAboutOdysseus02"
    }
    {
      Id = "MelinoeField_3584"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan hal yang perlu kau khawatirkan saat ini. Jadi kau pikir aku terus kembali karena menyukai musikmu? Kalau begitu, kenapa tidak kunikmati saja lagunya daripada harus bertarung melawanmu?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutOdysseus02"
    }
    {
      Id = "Scylla_0304"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musik live itu pengalaman interaktif. Nggak cuma duduk manis dan {#Emph}mendengarkannya! {#Prev}Kamu harus {#Emph}menyelami {#Prev}musik itu... meresapinya sampai basah kuyup, {#Emph}ahaha! {#Prev}Dan kamu sudah melakukannya lebih banyak daripada {#Emph}siapa pun {#Prev}di sini."
      Speaker = "Scylla"
      Event = "ScyllaAboutOdysseus02"
    }
    {
      Id = "MelinoeField_4354"
      InheritFrom = "BaseNarrative"
      DisplayName = "Scylla, apa kau keberatan jika kuhubungkan dengan kenalan kita bersama? Ini cuma sebentar. {#Emph}Dengarkan suaraku, Odysseus; orang yang kaucari ada di sini!"
      Speaker = "Melinoe"
      Event = "ScyllaAboutOdysseusQuest01"
    }
    {
      Id = "Scylla_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga kamu bakal kembali, wahai pelaut. Sekali mereka mendengar nyanyian kami, mereka pasti {#Emph}selalu kembali! {#Prev}Kecuali kalau mereka tenggelam, dan terkadang bahkan setelah {#Emph}tenggelam pun tetap kembali. Ah{#Prev}, cuma mau dengar sekali lagi, {#Emph}kan?"
      Speaker = "Scylla"
      Event = "ScyllaAboutOdysseusQuest01"
    }
    {
      Id = "Odysseus_0567"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, Scylla, kau dan nyanyian Siren-mu meninggalkan kesan yang teramat mendalam bagiku semasa hidup fana dulu! Dan aku tak mau lagi terus berpura-pura sebaliknya."
      Speaker = "Odysseus"
      Event = "ScyllaAboutOdysseusQuest01"
    }
    {
      Id = "Scylla_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, kalau kamu mau dengar sampai puas, {#Emph}silakan saja! {#Prev}Tak ada yang lebih membahagiakan selain memuaskan penggemar lama kami. {#Emph}Kupikir {#Prev}beberapa mantan anak buahmu sudah ada di antara kerumunan! Korban-korban yang {#Emph}kuhabisi dulu."
      Speaker = "Scylla"
      Event = "ScyllaAboutOdysseusQuest01"
    }
    {
      Id = "Odysseus_0568"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami tak punya pilihan selain berlayar melewatimu, dan orang-orang hebat telah mengorbankan nyawa mereka. Namun kini sang Putri Dunia Bawah akan menyuguhkan tontonan yang takkan pernah mereka lupakan!"
      Speaker = "Odysseus"
      Event = "ScyllaAboutOdysseusQuest01"
    }
    {
      Id = "Scylla_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Putri Dunia Bawah... Nona {#Prev}ini? {#Emph}Hah! {#Prev}Kamu memang selalu jadi perencana licik dan sama sekali belum berubah. Kalau begitu pasang telinga kalian baik-baik, semuanya..."
      Speaker = "Scylla"
      Event = "ScyllaAboutOdysseusQuest01"
    }
    {
      Id = "MelinoeField_4355"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa ada pelaut tertentu yang ingin bicara sebentar lagi! {#Emph}Dengarkan suaraku, Odysseus; orang yang kaucari ada di sini!"
      Speaker = "Melinoe"
      Event = "ScyllaAboutOdysseusQuest02"
    }
    {
      Id = "Scylla_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gimana pertunjukan kami kemarin buatmu, Odysseus, sekeren yang kau ingat? {#Emph}Pasti {#Prev}iya dong, buktinya kau ke mari {#Emph}lagi. {#Prev}Yah, bukannya kau punya banyak pilihan juga sih!"
      Speaker = "Scylla"
      Event = "ScyllaAboutOdysseusQuest02"
    }
    {
      Id = "Odysseus_0569"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ke sini karena dipanggil oleh sang Putri Dunia Bawah, Scylla. Meski bisa mendengar lagumu lagi adalah bonus yang menyenangkan. Aku tak bermaksud menunda pertunjukanmu, jadi aku bakal nonton dari tribun penonton saja, ya?"
      Speaker = "Odysseus"
      Event = "ScyllaAboutOdysseusQuest02"
    }
    {
      Id = "Scylla_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh silakan saja, {#Emph}heh. {#Prev}Kami juga tak sudi panggung ini diserbu sembarang orang! Apalagi si {#Emph}Putri Dunia Bawah {#Prev}ini sudah serakah menyedot semua {#Emph}sorotan lampu panggung!"
      Speaker = "Scylla"
      Event = "ScyllaAboutOdysseusQuest02"
    }
    {
      Id = "MelinoeField_3590"
      InheritFrom = "BaseNarrative"
      DisplayName = "Boleh kutanya, siapa yang membuatmu jadi begini, Scylla? Dari pemahamanku, wujudmu tak selalu... yah, seperti ini."
      Speaker = "Melinoe"
      Event = "ScyllaAboutCurse01"
    }
    {
      Id = "Scylla_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh-hoh{#Prev}, aku sukses berkat usahaku sendiri, {#Emph}terima kasih banyak ya{#Prev}, Nona! Kau pikir aku bakal melimpahkan semua bakat suciku ini ke {#Emph}orang lain? {#Prev}Ke sosok {#Emph}guru vokal tua keriput {#Prev}yang mengajariku segalanya?"
      Speaker = "Scylla"
      Event = "ScyllaAboutCurse01"
    }
    {
      Id = "MelinoeField_3591"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakat musikmu yang alami tidak membuatku terkejut; yang kutanyakan adalah bagaimana kau bisa menjadi monster laut. Bukankah kau korban sebuah kutukan?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutCurse01"
    }
    {
      Id = "Scylla_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! Oh{#Prev}, ada satu hal yang takkan pernah kau mengerti: semakin terkenal dirimu, semakin banyak omong kosong yang mereka sebar tentangmu! Soalnya mereka {#Emph}iri! {#Prev}Aku biarkan semuanya {#Emph}meluncur {#Prev}begitu saja dari cangkangku. Artis hebat takkan membiarkan fitnah murahan atau {#Emph}hinaan {#Prev}mengganggu ketenangannya!"
      Speaker = "Scylla"
      Event = "ScyllaAboutCurse01"
    }
    {
      Id = "MelinoeField_3592"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau kenal dengan sang penyihir Circe? Dia bilang dia mengenalmu sewaktu kalian masih muda... meski, aku tak yakin apakah hubungan kalian akrab."
      Speaker = "Melinoe"
      Event = "ScyllaAboutCirce01"
    }
    {
      Id = "Scylla_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang {#Emph}penyihir {#Prev}Circe? Nggak, nggak kenal tuh! Satu-satunya Circe yang {#Emph}aku {#Prev}tahu cuma anak bawang tak berbakat dan menyedihkan dari keturunan Helios si tua bangka itu! Mau omong apa lagi si Circe {#Emph}gadungan {#Prev}itu, hah?"
      Speaker = "Scylla"
      Event = "ScyllaAboutCirce01"
    }
    {
      Id = "MelinoeField_3593"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia memberiku kesan kalau kau memang selalu berisik dan suka pamer, bahkan sejak dulu. Mungkin saat itu kau sudah mulai melatih lagu-lagu yang kaukira bakal melambungkan namamu."
      Speaker = "Melinoe"
      Event = "ScyllaAboutCirce01"
    }
    {
      Id = "Scylla_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan rahasia lagi kalau dari dulu aku selalu tahu apa impianku, Nona. Selalu tahu apa {#Emph}takdirku! {#Prev}Circe dan begitu banyak pecundang lainnya... bisanya cuma menghalangi {#Emph}jalanku! {#Prev}Sama persis sepertimu."
      Speaker = "Scylla"
      Event = "ScyllaAboutCirce01"
    }
    {
      Id = "Scylla_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, wah, lihat siapa yang datang, si anak manja yang suka pamer koneksi! Mau menemui teman baikmu Tuan Chronos lagi, {#Emph}hm? {#Prev}Dia {#Emph}suka banget {#Prev}sama penampilan kami! Kau harus {#Emph}tenggelam {#Prev}dulu sebelum bisa merebut sponsor dari beliau!"
      Speaker = "Scylla"
      Event = "ScyllaAboutChronos01"
    }
    {
      Id = "MelinoeField_2558"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak berniat mencari sponsor darinya. Dan kami {#Emph}bukan {#Prev}teman. Kami cuma punya urusan yang harus diselesaikan... yang sialnya terus {#Emph}kau {#Prev}halangi malam demi malam."
      Speaker = "Melinoe"
      Event = "ScyllaAboutChronos01"
    }
    {
      Id = "Scylla_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Urusan? {#Prev}Sama {#Emph}beliau? {#Prev}Pasti kau ini anak orang penting, {#Emph}mana mungkin {#Prev}kau punya koneksi kelas atas begitu atas usahamu sendiri! Sadar diri dong, sebagian dari kami harus banting tulang buat {#Emph}meraih {#Prev}sorotan ini, Nona!"
      Speaker = "Scylla"
      Event = "ScyllaAboutChronos01"
    }
    {
      Id = "Scylla_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar kuperjelas ya, Nona. Kami tak bisa membiarkanmu mengganggu Tuan Chronos {#Emph}setiap malam! {#Prev}Beliau tak terlalu peduli dengan panggung konser kami di sini, dan kami mau suasananya {#Emph}tetap {#Prev}aman tenteram begini."
      Speaker = "Scylla"
      Event = "ScyllaAboutChronos02"
    }
    {
      Id = "MelinoeField_2559"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa Chronos sama sekali tak peduli tentang kalian. Jadi bagaimana kalau kau menyingkir dan fokus bikin lagu saja, daripada terus-terusan berusaha mencekik leherku?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutChronos02"
    }
    {
      Id = "Scylla_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, dia beneran gagal paham, gaes! Tapi tenang saja. Mereka {#Emph}takkan pernah {#Prev}bisa membubarkan konser kita, selama kita terus menarik kerumunan spektakuler kayak {#Emph}begini! {#Prev}Ini namanya {#Emph}publisitas emas!"
      Speaker = "Scylla"
      Event = "ScyllaAboutChronos02"
    }
    {
      Id = "Scylla_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang ini, setiap jiwa di Oceanus sudah hafal luar kepala nama panggung kami, Nona! Terutama namaku {#Emph}sendiri! {#Prev}Segala upayamu buat mencemarkan nama kami cuma berakhir bikin kami makin tenar!"
      Speaker = "Scylla"
      Event = "ScyllaAboutNarcissus01"
    }
    {
      Id = "MelinoeField_3606"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukannya mau mendebat detail sepele, tapi aku bertemu setidaknya satu jiwa di Oceanus yang sama sekali tak peduli pada pertunjukanmu. Dia jauh lebih suka memandangi kolam dangkal daripada mendengarkan suaramu."
      Speaker = "Melinoe"
      Event = "ScyllaAboutNarcissus01"
    }
    {
      Id = "Scylla_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Halah{#Prev}, kita tak bisa memuaskan semua orang, 'kan? Mengorbankan {#Emph}integritas seni {#Prev}hanya demi {#Emph}disukai semua orang... {#Prev}yah, sesuatu yang sama sekali {#Emph}tak kaupahami!"
      Speaker = "Scylla"
      Event = "ScyllaAboutNarcissus01"
    }
    {
      Id = "Scylla_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak banget hal keren di sudut Oceanus ini, ya nggak sih? Akustik ruangannya adalah perpaduan {#Emph}sempurna {#Prev}antara {#Emph}daratan {#Prev}dan {#Emph}lautan... {#Prev}dan si tua {#Emph}Poseidon {#Prev}itu sama sekali tak punya kuasa atas {#Emph}tempat ini!"
      Speaker = "Scylla"
      Event = "ScyllaAboutPoseidon01"
    }
    {
      Id = "MelinoeField_3607"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memanfaatkan lokasi ini yang berada di luar batas alam bawah tanah. Kupikir Yang Mulia Poseidon takkan senang mendengarnya, andai kau kembali ke perairannya kelak."
      Speaker = "Melinoe"
      Event = "ScyllaAboutPoseidon01"
    }
    {
      Id = "Scylla_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, andai kami balik ke perairannya {#Emph}dia{#Prev}, nama kami bakal {#Emph}begitu {#Prev}melejit sampai dia takkan {#Emph}berani {#Prev}mengusik kami! Mau dia atau dewa {#Emph}mana pun{#Prev}! Ke mana pun kami pergi, kami bakal jadi {#Emph}bintang utamanya."
      Speaker = "Scylla"
      Event = "ScyllaAboutPoseidon01"
    }
    {
      Id = "Scylla_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami dulu pernah manggung di {#Emph}permukaan{#Prev}, asal tahu saja! Saat itulah kami {#Emph}benar-benar {#Prev}mulai tenar! Bahkan {#Emph}Charybdis {#Prev}pernah jadi band pembuka kami beberapa kali, bisa kau bayangkan?"
      Speaker = "Scylla"
      Event = "ScyllaAboutCharybdis01"
    }
    {
      Id = "MelinoeField_2561"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lantas kenapa? Charybdis juga baru saja 'membuka mulut' untukku kemarin malam. Malahan aku hampir tak bisa membuatnya bungkam!"
      Speaker = "Melinoe"
      Event = "ScyllaAboutCharybdis01"
    }
    {
      Id = "Scylla_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mana mungkin aku percaya {#Emph}itu! {#Prev}Tapi aku yakin kau memang {#Emph}berasal {#Prev}dari atas sana, kan? Kau pikir kau ini musisi bawah tanah macam kami, padahal selamanya kau bakal tetap {#Emph}mainstream!"
      Speaker = "Scylla"
      Event = "ScyllaAboutCharybdis01"
    }
    {
      Id = "MelinoeField_3598"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berbagi panggung tampaknya bukan gayamu, Scylla. Bagaimana caramu menaikkan pamor jika terus berkolaborasi dengan penampil yang lebih tersohor seperti Charybdis?"
      Speaker = "Melinoe"
      Event = "ScyllaAboutCharybdis02"
    }
    {
      Id = "Scylla_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Charybdis memang punya {#Emph}mulut {#Prev}yang lebih lebar, tapi aksi panggung {#Emph}kami {#Prev}jauh berbeda. Para pelaut sering kali tak bisa memutuskan {#Emph}siapa {#Prev}yang lebih mereka sukai di antara kami, jadi... kami pikir: Kenapa tidak suguhkan keduanya saja?"
      Speaker = "Scylla"
      Event = "ScyllaAboutCharybdis02"
    }
    {
      Id = "MelinoeField_3599"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini juga tidak terlihat seperti kolaborasi kreatif yang mudah. Namun kalian tetap bekerja sama, demi memuaskan penonton, atau semata-mata demi menghentikan{#Emph}ku. {#Prev}Aku hampir kagum dibuatnya."
      Speaker = "Melinoe"
      Event = "ScyllaAboutCharybdis02"
    }
    {
      Id = "Scylla_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, kata-kata yang amat sering kami dengar, tapi selalu terasa {#Emph}sangat {#Prev}berarti! Terutama dari para pengkritik {#Emph}terpedas {#Prev}kami! Tentu itu takkan menghentikan kami untuk menenggelamkanmu seperti biasa, Nona... tapi {#Emph}makasih{#Prev}, ya."
      Speaker = "Scylla"
      Event = "ScyllaAboutCharybdis02"
    }
    {
      Id = "Scylla_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang menarik perhatianmu di ruang tunggu kami di bawah sana, {#Emph}hm? {#Prev}Mungkin kau tak melihat papan pengumumannya, tapi itu area {#Emph}pribadi {#Prev}kami tempat penggemar {#Emph}dilarang masuk!"
      Speaker = "Scylla"
      Event = "ScyllaAboutGreenRoom01"
    }
    {
      Id = "MelinoeField_2554"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang kau sebut {#Emph}ruang tunggu {#Prev}itu kebetulan dibangun di atas saluran pembuangan menuju Padang Ratapan di bawah sana. Kau selalu bisa membuang karya burukmu ke {#Emph}sana{#Prev}, tempat yang amat cocok untuknya."
      Speaker = "Melinoe"
      Event = "ScyllaAboutGreenRoom01"
    }
    {
      Id = "Scylla_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, kau lancang menggeledah {#Emph}karya {#Prev}kami! Terus kenapa kalau ada beberapa ide yang tak terpakai di sana-sini? Kalau kau tak {#Emph}memangkasnya... {#Prev}kau takkan pernah dapat materi yang {#Emph}bermutu."
      Speaker = "Scylla"
      Event = "ScyllaAboutGreenRoom01"
    }
    {
      Id = "Scylla_0434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Silakan saja mencemooh kami, Nona! Kami ini band {#Emph}besar{#Prev}, kulit sisik kami tebal! {#Emph}'Suara Scylla mirip gonggongan anjing! Rambut kemilaunya persis sekumpulan kepala ular!' {#Prev}Semuanya sudah pernah kami dengar!"
      Speaker = "Scylla"
      Event = "ScyllaAboutRumors01"
    }
    {
      Id = "MelinoeField_4307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sama sekali tak berniat melontarkan kata-kata semacam itu, yang menurutku sangat aneh. Mungkin jika kau tidak terlalu memusuhi penontonmu, mereka akan lebih bersahabat."
      Speaker = "Melinoe"
      Event = "ScyllaAboutRumors01"
    }
    {
      Id = "Scylla_0435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hinaan mereka membal {#Emph}begitu saja {#Prev}dari tubuh kami! Setidaknya dariku. {#Prev}Aku cuma peduli pada {#Emph}sorak-sorai {#Prev}dan {#Emph}teriakan {#Prev}mereka... yang lama-kelamaan terdengar persis sama saja..."
      Speaker = "Scylla"
      Event = "ScyllaAboutRumors01"
    }
    {
      Id = "Scylla_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, ternyata cuma {#Emph}kau! {#Prev}Bukan salah satu dari pelaut yang belakangan ini makin sering berkeliaran di sini. Lihat {#Emph}kerumunan {#Prev}ini! Kami benar-benar bikin {#Emph}heboh!"
      Speaker = "Scylla"
      Event = "ScyllaAboutThessaly01"
    }
    {
      Id = "MelinoeField_2560"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin para pelaut itu hanyalah sisa-sisa armada karam yang dikirim Chronos untuk melawan para dewa. Aku sempat bentrok dengan mereka baru-baru ini."
      Speaker = "Melinoe"
      Event = "ScyllaAboutThessaly01"
    }
    {
      Id = "Scylla_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh tidak, kurasa bukan begitu, Nona. Ketenaran kami ini murni berkat promosi getok tular dari mulut ke mulut! Dan {#Emph}tak ada {#Prev}yang bisa kau lakukan untuk {#Emph}menghentikannya {#Prev}sekarang!"
      Speaker = "Scylla"
      Event = "ScyllaAboutThessaly01"
    }
    {
      Id = "Scylla_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Roxy, Jetty, dan aku... kami sudah pernah melalui masa-masa yang jauh lebih terpuruk dari ini, Nona. Butuh lebih dari sekadar cemoohanmu untuk memecah-belah {#Emph}kami!"
      Speaker = "Scylla"
      Event = "ScyllaAboutSlump01"
    }
    {
      Id = "MelinoeField_2555"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah kenapa aku masih membuang waktu meladenimu, Scylla. Atau kenapa Roxy dan Jetty mau meladenimu! Kau bahkan belum memberi kesempatan bicara pada salah satu dari mereka."
      Speaker = "Melinoe"
      Event = "ScyllaAboutSlump01"
    }
    {
      Id = "Scylla_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka {#Emph}bicara {#Prev}lewat {#Emph}karya {#Prev}mereka! Lagipula aku bukan cuma vokalis utama, aku ini manajer bakatnya! Dan gadis-gadis ini sedang tidak menerima wawancara, apalagi dari orang macam {#Emph}kau!"
      Speaker = "Scylla"
      Event = "ScyllaAboutSlump01"
    }
    {
      Id = "Scylla_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu rapat bareng gadis-gadis kemarin malam, kami sempat mengobrol, yah {#Emph}sebenarnya aku yang paling banyak omong sih{#Prev}, tapi kami mulai penasaran apa maumu yang {#Emph}sebenarnya? {#Prev}Jetty menduga jangan-jangan kau seorang {#Emph}agen?"
      Speaker = "Scylla"
      Event = "ScyllaAboutAgents01"
    }
    {
      Id = "MelinoeField_2556"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ternyata Jetty cukup peka... karena aku memang agen Sang Malam. Alam ini telah jatuh ke tangan sang Titan; kami akan memastikannya kembali ke penguasa yang sah. Tak peduli siapa pun yang menghalangi jalan kami."
      Speaker = "Melinoe"
      Event = "ScyllaAboutAgents01"
    }
    {
      Id = "Scylla_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mustahil, Jetty, tebakanmu {#Emph}benar? {#Prev}Seorang agen pencari bakat! Nah, pencarianmu berakhir di sini, Nona Agen, karena {#Emph}kau {#Prev}takkan menemukan bakat yang lebih hebat di seantero lautan maupun daratan! Saksikanlah {#Emph}ini!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAgents01"
    }
    {
      Id = "Scylla_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nona Agen, selamat datang {#Emph}kembali! {#Prev}Jadi siapa si {#Emph}Malam {#Prev}yang mempekerjakanmu ini, dan siapa lagi yang sudah dia rekrut? Kedengarannya sangar."
      Speaker = "Scylla"
      Event = "ScyllaAboutAgents01_2"
    }
    {
      Id = "MelinoeField_3605"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang kumaksud adalah Sang Malam yang agung dan tiada tandingan, yang auranya memenuhi Alam Bawah dan permukaan. Dia adalah salah satu kekuatan purba tertua; namun Titan Chronos mengira bisa menghentikannya."
      Speaker = "Melinoe"
      Event = "ScyllaAboutAgents01_2"
    }
    {
      Id = "Scylla_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, kedengarannya ada {#Emph}persaingan sehat! {#Prev}Yah, kalau si Malam ini {#Emph}benar-benar {#Prev}ingin mengontrak kami, tawarannya harus {#Emph}menggiurkan! {#Prev}Kalau tidak, Tuan Chronos bisa saja menyikat habis semua talenta yang ada!"
      Speaker = "Scylla"
      Event = "ScyllaAboutAgents01_2"
    }
    {
      Id = "Scylla_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bukan agen sungguhan, kan, Nona? Kau cuma mempermainkan kami, menerbangkan harapan kami tinggi-tinggi, hanya untuk {#Emph}menghempaskannya {#Prev}ke karang! Tega sekali kau berbuat se{#Emph}rendah {#Prev}itu?"
      Speaker = "Scylla"
      Event = "ScyllaAboutAgents02"
    }
    {
      Id = "MelinoeField_2557"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menerbangkan harapanmu? Dengar baik-baik: Yang kucari adalah {#Emph}Chronos{#Prev}, bukan dirimu. Tapi mungkin kelak kau akan diburu oleh agen lain."
      Speaker = "Melinoe"
      Event = "ScyllaAboutAgents02"
    }
    {
      Id = "Scylla_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kalian percaya, Teman-teman! {#Emph}Nona ini {#Prev}pun tahu mana bintang yang sedang naik daun begitu melihatnya. Begitu dia {#Emph}mendengarnya! {#Prev}Dan dia pasti bakal merekomendasikan kita, {#Emph}kan?"
      Speaker = "Scylla"
      Event = "ScyllaAboutAgents02"
    }
    {
      Id = "Scylla_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga, kau berdarah. Susah mencari tempat ini, ya? Tenang saja, Teman-teman. Suatu hari nanti? Mereka akan membawa kita ke panggung termegah, untuk {#Emph}disaksikan seluruh dunia!"
      Speaker = "Scylla"
      Event = "ScyllaLowHealth01"
    }
    {
      Id = "Melinoe_2043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sedang tidak berminat mendengarkan khayalan tingkat tinggimu saat ini, jadi kenapa tidak langsung kau mulai saja lagu kecilmu itu."
      Speaker = "Melinoe"
      Event = "ScyllaLowHealth01"
    }
    {
      Id = "Scylla_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, mungkin sekarang bagimu ini lagu {#Emph}kecil{#Prev}, Nona. Tapi suatu hari nanti lagu ini bakal meledak. Lihat saja nanti. Kita tunjukkan padanya, kan, Teman-teman?"
      Speaker = "Scylla"
      Event = "ScyllaLowHealth01"
    }
    {
      Id = "Scylla_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Asal kau tahu, ini tempat pertunjukan terhormat, Nona, dan kami {#Emph}memang {#Prev}menerapkan aturan berpakaian di pintu masuk, {#Emph}hm-hm! {#Prev}Tapi kau malah menerobos masuk, dengan penampilan berantakan persis orang kepayahan."
      Speaker = "Scylla"
      Event = "ScyllaLowHealth02"
    }
    {
      Id = "Melinoe_2044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian para penghuni laut tidak begitu ramah terhadap pendatang baru di habitat kalian. Makanya penampilanku agak kusut. Dan kesabaranku pun menipis..."
      Speaker = "Melinoe"
      Event = "ScyllaLowHealth02"
    }
    {
      Id = "Scylla_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mulai ngerasa bakal tenggelam lagi, ya? Kalau gitu jangan bikin dia nunggu lebih lama lagi, gengs! {#Emph}Hajar!"
      Speaker = "Scylla"
      Event = "ScyllaLowHealth02"
    }
    {
      Id = "Scylla_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lautan itu bisa jadi tempat yang berbahaya kalau kau nggak tahu jalannya, Nona! {#Emph}Ohoho! {#Prev}Tapi kayaknya kau udah ngerasain sendiri, ya!"
      Speaker = "Scylla"
      Event = "ScyllaLowHealth03"
    }
    {
      Id = "Melinoe_2045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya basah kuyup dan baunya menusuk ke langit. Dan sekarang aku dipaksa mendengarkan sindiran {#Emph}pedasmu{#Prev}. Ditambah lagu menyebalkanmu juga, kurasa?"
      Speaker = "Melinoe"
      Event = "ScyllaLowHealth03"
    }
    {
      Id = "Scylla_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jelas dong! Dan kami bakal {#Emph}terus {#Prev}mainin lagu kami sampai nadanya {#Emph}sempurna{#Prev}. Namanya juga proses berkarya. Jadi jangan tahan napasmu dulu..."
      Speaker = "Scylla"
      Event = "ScyllaLowHealth03"
    }
    {
      Id = "Scylla_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Duh liat deh, gengs, dia luka! Dia udah terluka {#Emph}parah banget{#Prev}. Mungkin kita bisa mempermudah kematiannya dengan sedikit alunan {#Emph}musik{#Prev}, ya?"
      Speaker = "Scylla"
      Event = "ScyllaLowHealth04"
    }
    {
      Id = "Melinoe_2046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupastikan rasa sakit yang kurasakan saat ini tak ada apa-apanya dibanding rasa sakit yang akan kutimpakan pada{#Emph}mu {#Prev}jika kau terus menghalangiku."
      Speaker = "Melinoe"
      Event = "ScyllaLowHealth04"
    }
    {
      Id = "Scylla_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih punya tenaga buat ngelawan, ya? Bagus deh, soalnya kami benci banget penonton pasif! Ayo dong, masuk ke arena moshing, Nona! Pertunjukannya mau mulai!"
      Speaker = "Scylla"
      Event = "ScyllaLowHealth04"
    }
    {
      Id = "Scylla_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya {#Emph}enak banget {#Prev}nggak ada {#Emph}kamu {#Prev}belakangan ini, Nona! Kami bisa ngebawain {#Emph}seluruh {#Prev}set lagu kami malam demi malam, {#Emph}tanpa {#Prev}kendala teknis! Malah makin banyak {#Emph}pelaut {#Prev}yang berjatuhan kemari!"
      Speaker = "Scylla"
      Event = "ScyllaAboutNoShow01"
    }
    {
      Id = "MelinoeField_3585"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pelaut-pelaut yang berjatuhan itu kemungkinan besar pasukan laut sang Titan yang kubantai di sepanjang Celah Thessaly di atas. Kurasa aku mengenali beberapa dari mereka di tribun penonton."
