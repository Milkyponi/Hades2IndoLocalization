      Event = "ScyllaAboutShrineBounty01"
    }
    {
      Id = "Scylla_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, ya masuk akal sih. Mana bisa sukses besar tanpa bikin beberapa musuh! Yah, penonton kami tetep suka pertunjukan kami {#Emph}apa pun {#Prev}yang terjadi. Kayak penggemar {#Emph}sejati! {#Prev}Jadi {#Emph}tunjukkan kemampuan terburukmu, Nona."
      Speaker = "Scylla"
      Event = "ScyllaAboutShrineBounty01"
    }
    {
      Id = "Scylla_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fiuh{#Prev}, firasatku enak banget buat pertunjukan malam ini, gimana menurut kalian, gengs? Para penonton udah {#Emph}semangat membara! {#Prev}Dan lihat siapa lagi yang datang...!"
