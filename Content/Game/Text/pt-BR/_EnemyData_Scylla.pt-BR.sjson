      Event = "ScyllaAboutDiving02"
    }
    {
      Id = "MelinoeField_3602"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu aku membiarkan kalian mengalahkanku tanpa {#Emph}alasan sama sekali?"
