{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _LootData_Zeus.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_0638"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Segel petir..."
      Speaker = "Melinoe"
      Event = "ZeusUpgrade.FirstSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Paman..."
      Speaker = "Melinoe"
      Event = "ZeusUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu dia..."
      Speaker = "Melinoe"
      Event = "ZeusUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "MelinoeField_5020"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Paman, aku juga punya banyak pertanyaan..."
      Speaker = "Melinoe"
      Event = "ZeusUpgrade.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Zeus_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keponakanku, aku hanya mengharapkan perilaku, tata krama, dan performa terbaik darimu di hadapan istriku tercinta, yang tanpanya aku hanyalah bayang-bayang semu dari keagunganku."
      Speaker = "Zeus"
      Event = "ZeusWithHera01"
    }
    {
      Id = "Hera_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata-kata paling jujur yang pernah kau ucapkan sekian lama, Suamiku! Dan aku lebih dari sekadar istri {#Emph}tercinta{#Prev}, bukan? Mengingat akulah Sang Ratu sialan. Bukannya wewenang{#Emph}mu {#Prev}atau wewenangku ada harganya akhir-akhir ini."
      Speaker = "Hera"
      Event = "ZeusWithHera01"
    }
    {
      Id = "Zeus_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuasaku atas langit tak ada apa-apanya dibanding kekuatan ikatan keluarga kita! Sang Ratu dan aku telah bertahan bersama melalui masa-masa yang lebih buruk dari {#Emph}ini. {#Prev}Benar begitu, Sayang?"
      Speaker = "Zeus"
      Event = "ZeusWithHera02"
    }
    {
      Id = "Hera_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, tentu saja, kita sudah bertahan bersama melalui masa-masa sulit yang tak terhitung jumlahnya! Kurasa kita sudah sangat pantas untuk beristirahat. Mungkin setelah kesulitan kita saat ini akhirnya mereda?"
      Speaker = "Hera"
      Event = "ZeusWithHera02"
    }
    {
      Id = "Zeus_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë, satu hal kecil yang perlu kau ketahui tentang pihak keluarga kita: meski kita mungkin tak sepakat dalam setiap detail, pada akhirnya, kita selalu berada di pihak yang sama dalam setiap tantangan yang kita hadapi. Benar begitu, Saudaraku?"
      Speaker = "Zeus"
      Event = "ZeusWithPoseidon01"
    }
    {
      Id = "Poseidon_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu saja, Paduka Zeus! Pada hakikatnya, klan kita memiliki satu kehendak! Walau kurasa, kau — {#Emph}k-k-kita {#Prev}tidak mengikutsertakan Chronos dalam hitungan itu, kan? Secara teknis dia memang keluarga, tapi sangat bertolak belakang dengan semua prinsip kita!"
      Speaker = "Poseidon"
      Event = "ZeusWithPoseidon01"
    }
    {
      Id = "Zeus_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita ibarat satu keluarga besar di Olympus, dan kita bangga serta merayakan perbedaan kita. Begitu banyak sudut pandang berbeda yang harus diperhitungkan setiap saat! Meski Poseidon di sini, kita selalu bisa sepemikiran, bukan begitu..."
      Speaker = "Zeus"
      Event = "ZeusWithPoseidon02"
    }
    {
      Id = "Poseidon_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu saja {#Emph}begitu{#Prev}, Saudaraku! Tak selalu langsung sepakat, dan ada beberapa kesempatan di mana aku mungkin memutuskan hal lain jika terserah padaku, tapi {#Emph}tetap saja! {#Prev}Pikiranmu selalu melayang di awan, tempat lahirnya ide-ide cerdas!"
      Speaker = "Poseidon"
      Event = "ZeusWithPoseidon02"
    }
    {
      Id = "Zeus_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë, putraku yang cemerlang Apollo, kau bijak jika belajar satu dua hal dari{#Emph}nya! {#Prev}Dia adalah yang terbaik dalam segala hal. Kebanggaan Olympus, hadir untuk menyambutmu, dan mengajarimu, {#Emph}inilah dia!"
      Speaker = "Zeus"
      Event = "ZeusWithApollo01"
    }
    {
      Id = "Apollo_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tersanjung atas pujianmu, Ayah. Meskipun begitu, sepupumu yang elok ini lebih dari mampu untuk menjaga dirinya sendiri. Tetap saja, sedikit perlindungan ekstra dari kahyangan tak ada salahnya, kan?"
      Speaker = "Apollo"
      Event = "ZeusWithApollo01"
    }
    {
      Id = "Zeus_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh-musuh lancang itu akan tercerai-berai ke Empat Penjuru Mata Angin begitu kita selesai dengan mereka! Tantangan kita adalah membasmi mereka sembari meminimalkan kehancuran yang tak terperi. Dan Dewi Demeter {#Emph}selalu bisa {#Prev}menumbuhkan kembali Bumi."
      Speaker = "Zeus"
      Event = "ZeusWithDemeter01"
    }
    {
      Id = "Demeter_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, Paduka Zeus... jauh lebih sulit untuk menumbuhkan kembali tempat di mana tak ada lagi jejak kehidupan yang tersisa. Tapi itu tak penting sekarang. Biarkan semua yang menentang kita {#Emph}layu! {#Prev}Dan kita akan menabur garam di tanah di bawah kaki mereka."
      Speaker = "Demeter"
      Event = "ZeusWithDemeter01"
    }
    {
      Id = "Zeus_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian para penyihir suka memanfaatkan pesona feminin demi memuluskan rencana? Nah, {#Emph}sekarang {#Prev}waktunya mengerahkan segala cara yang kita miliki! Bahkan Aphrodite pun ikut turun tangan, apalagi dengan tombaknya!"
      Speaker = "Zeus"
      Event = "ZeusWithAphrodite01"
    }
    {
      Id = "Aphrodite_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku bukan pemula dengan tombak, Paduka Zeus. Karena {#Emph}memang ada {#Prev}musuh yang bahkan tak mempan oleh {#Emph}pesona feminin{#Prev}ku dibanding tajam dan runcingnya sebilah logam. Kurasa kerabat Bawah Tanah kita mungkin bisa memahaminya!"
      Speaker = "Aphrodite"
      Event = "ZeusWithAphrodite01"
    }
    {
      Id = "Zeus_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika ada satu hal baik dari perang ini, itu adalah fakta bahwa anggota keluarga kita yang paling pendiam pun harus bangkit dan unjuk gigi! Atau sekadar menampakkan batang hidungnya seperti putra baikku Hephaestus di sini, {#Emph}haha!"
      Speaker = "Zeus"
      Event = "ZeusWithHephaestus01"
    }
    {
      Id = "Hephaestus_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah! {#Prev}Satu lagi lelucon apikmu, Ayah, tepat di depan telinga penyihir kecil ini pula! Baru saja kupikir dia mustahil merendahkan diri ke levelku, dia terus saja membuat kejutan."
      Speaker = "Hephaestus"
      Event = "ZeusWithHephaestus01"
    }
    {
      Id = "Zeus_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sudah sangat terbiasa dengan adik iparku Hestia yang menyendiri, sampai-sampai kita tak lagi menyisakan kursi untuknya di istanaku! Tapi dia ada di sini untuk menetap kali ini, kan, Hes?"
      Speaker = "Zeus"
      Event = "ZeusWithHestia01"
    }
    {
      Id = "Hestia_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, Zeus sayang, buang jauh-jauh pikiran bahwa aku akan pergi lagi! Lagipula kau menyambutku dengan sangat hangat, setelah menyingkirkan kursi sialanku itu hanya untuk memasangnya kembali. Tapi, jangan bikin si manis yang berapi-api ini cemas dengan urusan itu!"
      Speaker = "Hestia"
      Event = "ZeusWithHestia01"
    }
    {
      Id = "Zeus_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putra perangkau Ares tak pernah lari dari konflik, tapi kau takkan pernah menyangkanya jika mengobrol dengannya, Nona muda! Ayo, Ares, {#Emph}sapa {#Prev}dia! Dan cobalah untuk bersikap wajar, ya?"
      Speaker = "Zeus"
      Event = "ZeusWithAres01"
    }
    {
      Id = "Ares_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahlah, Paduka Ayah, apa yang harus kita sembunyikan? Apa yang kita anggap wajar mungkin sangat jauh dari kebiasaan Dunia Bawah saat ini. Biarkan kerabat kita melihat siapa diri kita yang sebenarnya."
      Speaker = "Ares"
      Event = "ZeusWithAres01"
    }
    {
      Id = "MelinoeField_1598"
      InheritFrom = "BaseNarrative"
      DisplayName = "Raja para dewa pasti sedang sangat sibuk belakangan ini. {#Emph}Demi Hades! Olympus, kuterima pesan ini!"
      Speaker = "Melinoe"
      Event = "ZeusFirstPickUp"
    }
    {
      Id = "Zeus_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, Nona muda, akhirnya kita bertemu juga! Muncul dari kegelapan itu demi membantu kita menuntaskan dendam lama. Jika kau mewarisi kekuatan ayahmu, maka kita yang memegang kendali! Mari kita serang."
      Speaker = "Zeus"
      Event = "ZeusFirstPickUp"
    }
    {
      Id = "Zeus_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, Melinoë, apa yang terjadi padamu? Kau nyaris tak sanggup bertahan, tapi biar kulihat apakah aku bisa membantumu bangkit kembali."
      Speaker = "Zeus"
      Event = "ZeusLowHealth01"
    }
    {
      Id = "Zeus_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm{#Prev}, kau pasti telah melewati badai yang dahsyat dalam perjalananmu ke sini. Tapi jangan putus asa; kita akan ubah badai itu menjadi sumber kekuatan!"
      Speaker = "Zeus"
      Event = "ZeusLowHealth02"
    }
    {
      Id = "Zeus_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh {#Emph}tidak{#Prev}, Keponakanku, kau terluka! Risiko dari misimu, kurasa, namun tetap saja hatiku pilu melihatnya. Teguhkan hatimu dan teruslah berjuang!"
      Speaker = "Zeus"
      Event = "ZeusLowHealth03"
    }
    {
      Id = "Zeus_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luka yang begitu parah sudah kau alami... namun kau terus maju, sadar betul betapa pentingnya tugas yang kau emban. Kau sungguh menginspirasi, Nona muda!"
      Speaker = "Zeus"
      Event = "ZeusLowHealth04"
    }
    {
      Id = "Zeus_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salam, Keponakanku yang jelita! Sudah kuduga akan mendapati dirimu berangkat dalam petualanganmu yang berikutnya! Dan kuharap ini akan menjadi keberhasilan gemilang, bagimu dan bagi kita semua!"
      Speaker = "Zeus"
      Event = "ZeusRunStart01"
    }
    {
      Id = "Zeus_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, perjalananmu dimulai kembali, Nona muda! Nah, mari kita lihat bagaimana jadinya jika kau mendapatkan berkah tiada taraku sejak awal!"
      Speaker = "Zeus"
      Event = "ZeusRunStart02"
    }
    {
      Id = "Zeus_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kau berangkat lagi malam ini, biar kupastikan kau memulainya dengan langkah yang tepat. Ketahuilah bahwa kami semua mendukungmu, di setiap langkahmu!"
      Speaker = "Zeus"
      Event = "ZeusRunStart03"
    }
    {
      Id = "Zeus_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau baru saja memulai malam ini, kan, Nona muda? Biar kubantu memperlancar jalanmu. Kendalikan petir itu, dan pastikan kemenangan kita!"
      Speaker = "Zeus"
      Event = "ZeusRunStart04"
    }
    {
      Id = "Zeus_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti berada di dekat gerbang menuju alam ayahmu. Jadi kau menuju ke {#Emph}sini {#Prev}lagi, bukannya ke Kediamannya? Yah, apa pun itu, bantuanku adalah milikmu."
      Speaker = "Zeus"
      Event = "ZeusSurfaceRunStart01"
    }
    {
      Id = "Zeus_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih jauh perjalananmu sebelum mencapai Olympus, Keponakanku; dan cuaca belakangan ini agak buruk. Tapi kau tak keberatan dengan sedikit guntur dan kilat, bukan?"
      Speaker = "Zeus"
      Event = "ZeusSurfaceRunStart02"
    }
    {
      Id = "Zeus_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memburu Chronos lagi, kan? Mungkin memang begitu yang terbaik! Barangkali jika kau berhasil mengalahkannya di sana, upaya Typhon di sini entah bagaimana akan ikut terganggu..."
      Speaker = "Zeus"
      Event = "ZeusUnderworldRunStart01"
    }
    {
      Id = "Zeus_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengalihkan perhatianmu kembali ke Dunia Bawah, ya? Kurasa semua keberhasilanmu di sini sudah semestinya membawamu menuju kemenangan lebih lanjut di bawah sana. Hera-ku tersayang pasti akan sangat senang!"
      Speaker = "Zeus"
      Event = "ZeusRunStartPostSurfaceW01"
    }
    {
      Id = "Zeus_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mulai tadi malam, aku memahami ada satu kemungkinan lebih sedikit bahwa sang Titan Waktu bisa menggulingkan kita. Dan sekarang kau beralih ke kemungkinan soal {#Emph}Typhon{#Prev}, begitu rupanya?"
      Speaker = "Zeus"
      Event = "ZeusRunStartPostUnderworldW01"
    }
    {
      Id = "Zeus_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingat betapa bahagianya kami saat tahu ibumu sedang mengandung; namun sayangnya, kami tak pernah mendengar kabarnya lagi. Chronos memanfaatkan kesempatan mengerikan itu untuk menyerang. Bayangkan betapa terkejutnya kami saat kau tiba-tiba melesat keluar dari bayang-bayang ke dalam hidup kami!"
      Speaker = "Zeus"
      Event = "ZeusAboutChronos01"
    }
    {
      Id = "Zeus_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketika kami menyadari Chronos menyerang Kediaman ayahmu, kami takut kau ikut binasa bersama yang lain. Sungguh beruntung sang Penyihir Persimpangan Jalan sempat membawamu kabur! Meski seharusnya dia mengabari kami lebih cepat soal berita sepenting itu..."
      Speaker = "Zeus"
      Event = "ZeusAboutChronos02"
    }
    {
      Id = "Zeus_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami sudah terlalu terbiasa jarang berhubungan dengan ayahmu di Dunia Bawah sampai-sampai Chronos berhasil membangun pijakan di sana sebelum kami menyadarinya. Sejak saat itu kami terkunci dalam pertempuran sengit melawan pasukannya!"
      Speaker = "Zeus"
      Event = "ZeusAboutChronos03"
    }
    {
      Id = "Zeus_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pernah bertarung satu lawan satu melawan Titan Chronos! Sekarang mungkin kau yang akan mendapatkan kehormatan itu menggantikanku, {#Emph}hm? {#Prev}Banyak keluarga yang harus kulindungi, dan aku harus mengawasi rencana kita selagi dijalankan."
      Speaker = "Zeus"
      Event = "ZeusAboutChronos04"
    }
    {
      Id = "Zeus_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiga Takdir sendiri tahu Chronos akan digulingkan oleh darah dagingnya sendiri. Kami sudah pernah melakukannya dulu, dan kami akan melakukannya lagi! Bantuanmu dalam urusan ini sangat dihargai."
      Speaker = "Zeus"
      Event = "ZeusAboutChronos05"
    }
    {
      Id = "Zeus_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu dan aku memang memiliki banyak perbedaan. Namun ikatan persaudaraan yang kami miliki sungguh sangat kuat... lebih kuat daripada kami berdua! Mari kita menangkan perang ini demi menghormatinya."
      Speaker = "Zeus"
      Event = "ZeusAboutHades01"
    }
    {
      Id = "Zeus_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa leganya hatiku mengetahui Hades dan Persephone yang baik kini kembali bersemayam di atas takhta mereka yang sah! Saudaramu Zagreus, dewi Nyx, dan yang lainnya, apakah mereka juga baik-baik saja? Cobaan yang amat berat telah berhasil mereka lalui berkat bantuanmu..."
      Speaker = "Zeus"
      Event = "ZeusAboutHades02"
    }
    {
      Id = "Zeus_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan Chronos mengejutkan kami karena kami sudah terbiasa tidak mendengar kabar dari ayahmu dalam jangka waktu yang sangat lama. Baiklah, kita harus memperbaikinya sekarang! Lagipula, Hades dan aku punya banyak hal untuk diobrolkan."
      Speaker = "Zeus"
      Event = "ZeusAboutHades03"
    }
    {
      Id = "Zeus_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hades menangani proyek renovasinya dengan begitu serius, {#Emph}hah! {#Prev}Ayahmu tak pernah pandai bercanda, tapi dia selalu bisa membuatku tertawa. Karena dia sangat teliti, kurasa pemulihan Dunia Bawah akan memakan waktu yang cukup lama baginya!"
      Speaker = "Zeus"
      Event = "ZeusAboutHades04"
    }
    {
      Id = "Zeus_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau beruntung mewarisi paras ibumu, bukan paras ayahmu, Nona muda! {#Emph}Hah{#Prev}, Hades tua yang malang, betapa berat beban dunia menimpanya. Dia saudara yang baik bagiku, dan pembalasan setimpal akan kita tuntaskan untuknya!"
      Speaker = "Zeus"
      Event = "ZeusAboutMelinoe01"
    }
    {
      Id = "Zeus_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sama gigihnya seperti ayahmu, kan, Keponakanku? Sepertinya urusan dengan Titan Chronos ini {#Emph}tiada habisnya{#Prev}, tapi kita semua harus melanjutkan hidup pada suatu saat nanti! Kau sudah berbuat lebih dari cukup, tak perlu memforsir diri tanpa henti."
      Speaker = "Zeus"
      Event = "ZeusAboutMelinoe02"
    }
    {
      Id = "Zeus_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir Persimpangan Jalan yang penyendiri itu pasti menjadi pengasuh yang terpaksa, dan menjauhkanmu dari keluargamu yang sebenarnya sampai sekarang! Setidaknya Hecate mengajarimu beberapa keterampilan bertahan hidup, dan masih punya cukup akal sehat untuk akhirnya mengenalkan kita!"
      Speaker = "Zeus"
      Event = "ZeusAboutHecate01"
    }
    {
      Id = "Zeus_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Katakan pada Penyihir Persimpangan Jalan itu bahwa aku menuntut laporan tepat waktu darinya mengenai situasi di Dunia Bawah. Sekarang jelas bukan waktunya untuk bersikap mementingkan diri sendiri!"
      Speaker = "Zeus"
      Event = "ZeusAboutHecate02"
    }
    {
      Id = "Zeus_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak menyangka Nemesis yang adil ada di Dunia Bawah bersamamu! Makin jelas alasan mengapa mereka yang berani menentang kita tumbang, karena Sang Pembalasan ada di pihak kita. Dia sama mempesonanya seperti ibunya, Nyx."
      Speaker = "Zeus"
      Event = "ZeusAboutNemesis01"
    }
    {
      Id = "Zeus_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali kau tak pernah sempat mengenal saudaramu, Zagreus, pemuda yang hebat itu. Pemuda yang bertekad baja! Hubungannya dengan ayahmu memang tak selalu mulus, tapi siapa sih yang bisa akur dengannya? Aku yakin dia bertarung melawan Chronos segagah berani yang dia mampu."
      Speaker = "Zeus"
      Event = "ZeusAboutZagreus01"
    }
    {
      Id = "Zeus_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos telah menawan {#Emph}Tiga Takdir?! {#Prev}Mustahil. Provokasi yang tak berguna! Mereka tak tunduk pada dewa maupun Titan mana pun. Itu artinya apa pun yang akan terjadi bukan lagi menjadi keputusan mereka. Kita harus menganggapnya sebagai sebuah {#Emph}peluang!"
      Speaker = "Zeus"
      Event = "ZeusAboutFates01"
    }
    {
      Id = "Zeus_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Melinoë, {#Emph}ehm{#Prev}, ada sesuatu yang mencurigakan di Olympus... gemuruh, namun bahkan Poseidon pun tak tahu dari mana asalnya. Yah, manuver pengecut apa pun yang disiapkan Chronos, kita akan memukulnya mundur! Dengan bantuanmu, barangkali."
      Speaker = "Zeus"
      Event = "ZeusAboutSurfaceThreat01"
    }
    {
      Id = "Zeus_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sebenarnya sudah bisa menyapu bersih semua musuh di permukaan sekarang, tapi Chronos mengklaim mereka masih dibutuhkan; bahwa kau harus menghadapi mereka seperti sebelumnya demi memancing sisa kemungkinan Typhon untuk dihancurkan. Selama kau bersedia, Keponakanku..."
      Speaker = "Zeus"
      Event = "ZeusAboutSurfaceThreat02"
    }
    {
      Id = "Zeus_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar sampai kepadaku bahwa kau bertemu dengan Heracles yang perkasa! Dia orang paling ketus yang pernah kau jumpai; kusarankan kau biarkan saja dia mengurus tugas-tugasnya. Kami tak meminta {#Emph}segalanya{#Prev} darinya, hanya bagian yang adil jika dia ingin menjalani kehidupan sebagai dewa."
      Speaker = "Zeus"
      Event = "ZeusAboutHeracles01"
    }
    {
      Id = "Zeus_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami pernah mencoba mengekang putraku Heracles, tapi dia selalu berhasil melepaskan diri, karena menghancurkan kekang {#Emph}memang{#Prev} keahliannya. Namun dia sepenuhnya setia pada keluarga kita, itu yang kutahu pasti. Dia tak pernah sekalipun gagal memenuhi apa yang kami minta!"
      Speaker = "Zeus"
      Event = "ZeusAboutHeracles02"
    }
    {
      Id = "Zeus_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kiklop Polyphemus tak berguna itu, berani-beraninya memunggungi para dewa! Kaumnya dulu pernah membantu kita melawan para Titan; namun dia berasal dari generasi baru, yang tampaknya tak punya {#Emph}kesetiaan{#Prev}! Tindakannya {#Emph}sama sekali tak bisa{#Prev} dimaafkan."
      Speaker = "Zeus"
      Event = "ZeusAboutPolyphemus01"
    }
    {
      Id = "Zeus_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya saja Poseidon tak gemar mengolok-olok kaum Kiklop, mungkin Polyphemus tua yang buta itu akan berdiri bersama kita, bukannya melawan kita! {#Emph}Ah{#Prev}, tapi kita semua kan pernah berbuat salah, bukan?"
      Speaker = "Zeus"
      Event = "ZeusAboutPolyphemus02"
    }
    {
      Id = "Zeus_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian para dewi dan dewa Dunia Bawah saling mengenal, bukan? Jika kau bisa tolong beritahu putri pengganggu Nyx yang bernama {#Emph}Eris{#Prev} itu bahwa dia dilarang terbang di wilayah perbatasan kami, kami akan sangat berterima kasih!"
      Speaker = "Zeus"
      Event = "ZeusAboutEris01"
    }
    {
      Id = "Zeus_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan pengkhianat Prometheus memimpin garda depan pasukan musuh kita di Olympus. Tampaknya dia sama sekali tak memetik {#Emph}pelajaran{#Prev} apa pun dari hukuman atas kejahatannya di masa lalu! Kita harus memikirkan cara-cara {#Emph}baru{#Prev} untuk membuatnya sadar..."
      Speaker = "Zeus"
      Event = "ZeusAboutPrometheus01"
    }
    {
      Id = "Zeus_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin pernah mendengar tentang tindakan Prometheus yang memicu seluruh murkaku. Dia {#Emph}mencuri{#Prev} dari kita! Merampas kemuliaan kita untuk memberikan api kepada umat manusia dengan cara kita sendiri! Dia memang menderita akibat perbuatannya, tapi itu masih belum seberapa."
      Speaker = "Zeus"
      Event = "ZeusAboutPrometheus02"
    }
    {
      Id = "Zeus_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tadinya sangat berniat menghentikan pemberontakan Prometheus, namun kini aku harus percaya bahwa dia memfasilitasi upayamu yang berkelanjutan demi memastikan bahwa {#Emph}waktu mengalir bebas tanpa hambatan? {#Prev}Yah, jika kau mulai tak memercayai hal ini, cukup beri tahu aku."
      Speaker = "Zeus"
      Event = "ZeusAboutPrometheus03"
    }
    {
      Id = "Zeus_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam seluruh amarahku, tak pernah kusangka Chronos sudah {#Emph}benar-benar{#Prev} gila. Tapi apa lagi yang bisa mendorongnya untuk menggunakan Ayah Segala Monster sebagai senjata? Typhon tak tunduk pada tuan mana pun; kehancuran Olympus takkan pernah memuaskan nafsu laparnya!"
      Speaker = "Zeus"
      Event = "ZeusAboutTyphon01"
    }
    {
      Id = "Zeus_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Monster Typhon itu {#Emph}jauh{#Prev} dari kata kebal, tak peduli bagaimana kelihatannya. Saat dia pertama kali berani menyerang Olympus dahulu kala, aku {#Emph}sendiri{#Prev} yang menumbangkannya! Tapi sekarang, dia tampaknya lebih tahan terhadap petirku daripada sebelumnya..."
      Speaker = "Zeus"
      Event = "ZeusAboutTyphon02"
    }
    {
      Id = "Zeus_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kapan pun kau dengan berani menghadapi Typhon lagi, aku akan menaklukkannya dengan tombak petirku secepat mungkin. Tapi aku tak bisa mengambil risiko meninggalkan Istanaku di sini terlalu lama... Aku hanya bisa melakukannya saat kau mengalihkan perhatiannya terlebih dahulu!"
      Speaker = "Zeus"
      Event = "ZeusAboutTyphon03"
    }
    {
      Id = "Zeus_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, Nona muda, aku sempat ragu saat kau datang sejauh ini untuk mengulurkan bantuan! Kami seharusnya cukup mampu untuk memukul mundur Typhon seorang diri! Namun pertempuran terakhir kita melawannya mungkin akan berakhir berbeda jika bukan karenamu..."
      Speaker = "Zeus"
      Event = "ZeusAboutTyphonW01"
    }
    {
      Id = "Zeus_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon merayap naik kembali menuju puncak kita sekali lagi, terlepas dari bagaimana kita menghajarnya tadi malam berkat bantuanmu. Dia {#Emph}jelas-jelas{#Prev} bukan makhluk yang {#Emph}cerdas{#Prev}, meski begitu barangkali kita akan memberinya pelajaran berharga sebentar lagi!"
      Speaker = "Zeus"
      Event = "ZeusAboutTyphonW02"
    }
    {
      Id = "Zeus_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar salah satu dari {#Emph}kami{#Prev}, Melinoë! Aku menyaksikan sendiri betapa perkasanya kau bertarung! Bahkan di hadapan kebuasan Typhon sekalipun. Ayahmu pasti akan sama bangganya denganku."
      Speaker = "Zeus"
      Event = "ZeusAboutTyphonW03"
    }
    {
      Id = "Zeus_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemenangan terbarumu berarti semakin kecil kemungkinan Typhon menghantui kita, begitu ya? Barangkali inilah berbagai kemungkinan yang selalu diocehkan oleh Prometheus itu. Kalau begitu, teruslah singkirkan kemungkinan-kemungkinan buruk itu satu demi satu!"
      Speaker = "Zeus"
      Event = "ZeusAboutTyphonW04"
    }
    {
      Id = "Zeus_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami semestinya sanggup menghadapi Typhon di sini, tapi kami tak bisa menjangkau Titan Chronos di kedalamannya. Jadi mengapa kau bersikeras menuju ke {#Emph}arah sini{#Prev}? Fokuslah pada Dunia Bawah dan serahkan alamku pada{#Emph}ku{#Prev}."
      Speaker = "Zeus"
      Event = "ZeusAboutTyphonL01"
    }
    {
      Id = "Zeus_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah bertemu sebagian besar anggota keluarga kita sekarang, tapi sayangnya, beberapa sedang pergi. Aku yakin mereka punya alasan-alasan yang paling mengagumkan atas ketidakhadiran mereka dalam situasi genting seperti ini."
      Speaker = "Zeus"
      Event = "ZeusAboutOlympians01"
    }
    {
      Id = "Zeus_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setelah semua ini beres, kau akan bergabung bersama kami di Olympus sini, kan? Tak perlu bersusah payah terus di hutan penyihir itu. Yah, walau kurasa kau mungkin dibutuhkan di Kediaman ayahmu. Bagaimanapun juga, ketahuilah undanganku ini selalu terbuka!"
      Speaker = "Zeus"
      Event = "ZeusAboutOlympus01"
    }
    {
      Id = "Zeus_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melihatnya langsung sekarang: Gunung agung kami terus-menerus dikepung, dan akhir-akhir ini kami tak punya waktu istirahat sedikit pun. Namun ujian ini hanya membuat keluarga kita semakin kuat!"
      Speaker = "Zeus"
      Event = "ZeusAboutOlympus02"
    }
    {
      Id = "Zeus_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hatiku sakit melihat rumah gunung kita masih dalam kondisi yang benar-benar tak layak ini, dan kedatanganmu di sini tak disambut dengan semestinya! Tapi camkan kata-kataku, kau akan menyaksikan Olympus dalam segala kejayaannya begitu masalah kecil ini terselesaikan!"
      Speaker = "Zeus"
      Event = "ZeusAboutOlympus03"
    }
    {
      Id = "Zeus_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum fana, mereka tak lagi menghujani kita dengan persembahan sesering dulu, Nona muda. Lancang sekali mereka sekarang, mengira Chronos adalah semacam juru selamat, agaknya. {#Emph}Cih!"
      Speaker = "Zeus"
      Event = "ZeusAboutMortals01"
    }
    {
      Id = "Zeus_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian kaum fana begitu bodoh hingga terpikat oleh janji Zaman Keemasan yang baru. {#Emph}Saat Chronos berkuasa, zaman itu penuh damai{#Prev}, kata mereka! {#Emph}Tanpa perang atau pertikaian! {#Prev}Dan tanpa kemajuan atau peradaban pula. Jalan kemajuan itu tak dibentangkan begitu saja!"
      Speaker = "Zeus"
      Event = "ZeusAboutMortals02"
    }
    {
      Id = "Zeus_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para pemuja fana kita pernah menderita melalui masa-masa sulit sebelumnya... tapi iman mereka kepada kita akan diganjar, segera setelah semua ini akhirnya tuntas. Kesetiaan adalah sesuatu yang tak boleh kita sia-siakan begitu saja, Keponakanku!"
      Speaker = "Zeus"
      Event = "ZeusAboutMortals03"
    }
    {
      Id = "Zeus_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sabit perak yang kau genggam itu. Tampaknya bukan hanya Senjata Malam yang telah bangkit, mereka kini berada di tanganmu. Dulu aku pernah melawan para Titan dengan tandingannya. Sekarang sepertinya sejarah berulang kembali."
      Speaker = "Zeus"
      Event = "ZeusAboutWeapons01"
    }
    {
      Id = "Zeus_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menyesal kau terseret ke dalam sedikit perselisihan kami di sini, Nona muda. Kami semua ingin menganugerahkan berkah kami, dan tak seharusnya bertengkar soal siapa yang lebih dulu! Namun harga diri kami tak selemah {#Emph}itu{#Prev}, dan pada akhirnya kami selalu berdiri bersama!"
      Speaker = "Zeus"
      Event = "ZeusAboutDevotionTests01"
    }
    {
      Id = "Zeus_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan pertengkaran kami yang terus berlanjut ini, Melinoë! Aku hanya ingin menyarankan bahwa usahamu akan lebih berguna untuk melenyapkan sisa-sisa dari Ayah Segala Monster itu, ketimbang kemungkinan Chronos di Dunia Bawah, seperti yang dipikirkan Ratu Hera kita tercinta. Semua keluarga pasti bertengkar seperti kami!"
      Speaker = "Zeus"
      Event = "ZeusAboutDevotionTests02"
    }
    {
      Id = "Zeus_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti tinggal di suatu tempat di hutan mengerikan di tepi wilayah ayahmu itu. Jadi kau pasti tahu sensasi tetesan hujan, suara guntur di kejauhan. Kekuatan itu sekarang milikmu."
      Speaker = "Zeus"
      Event = "ZeusAboutErebus01"
    }
    {
      Id = "Zeus_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, apa yang kau lakukan di {#Emph}permukaan{#Prev}, Nona muda? Bagaimana kau bisa bertahan hidup? Kau tentu tahu garis keturunanmu terikat di bawah bumi! Tenagamu lebih baik digunakan melawan musuh-musuh kita di {#Emph}bawah sana!"
      Speaker = "Zeus"
      Event = "ZeusAboutSurfaceNoCure01"
    }
    {
      Id = "Zeus_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perjalananmu ke atas sini tampak ceroboh, Melinoë. Kuharap kau punya semacam {#Emph}rencana{#Prev}, kan? Kau dan Penyihir Persimpangan Jalan itu terkadang sulit sekali ditebak!"
      Speaker = "Zeus"
      Event = "ZeusAboutSurfaceNoCure02"
    }
    {
      Id = "Zeus_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang berbeda darimu, Keponakanku. Kau tampak begitu hidup... di permukaan sini pula! Kau berhasil menyembuhkan kutukanmu entah bagaimana? Mustahil..."
      Speaker = "Zeus"
      Event = "ZeusAboutSurface01"
    }
    {
      Id = "Zeus_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak tahu bagaimana kau mengakali kutukan yang mengikatmu ke Dunia Bawah, Nona muda; tapi aku {#Emph}tahu{#Prev} ini mengubah segalanya! Kau bisa membantu kami mempertahankan puncak gunung ini! Bantuan yang sangat kami butuhkan, bahkan {#Emph}aku{#Prev} pun harus mengakuinya..."
      Speaker = "Zeus"
      Event = "ZeusAboutSurface02"
    }
    {
      Id = "Zeus_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perhatikan ulah Chronos di sekelilingmu di sana! Kota Ephyra yang dulunya makmur, hancur lebur; gerbang Dunia Bawah, terhempas terbuka! Tindakan biadab, yang harus diganjar akibat mengerikan!"
      Speaker = "Zeus"
      Event = "ZeusAboutSurface03"
    }
    {
      Id = "Zeus_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya kacau balau di permukaan sini, Nona muda. Tanah di bawah kakimu terus berguncang, entah karena gempa Poseidon, atau karena rekayasa apa pun yang dirancang Chronos. Kau tahu ke mana harus melangkah, meski jalurnya tak pasti."
      Speaker = "Zeus"
      Event = "ZeusAboutSurface04"
    }
    {
      Id = "Zeus_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masalah di Olympus terkendali dengan baik di tangan kami, Nona muda! Aku lebih suka kau tetap fokus pada musuh bersama kita di wilayah ayahmu. Walau begitu, kau akan tetap menerima berkahku!"
      Speaker = "Zeus"
      Event = "ZeusAboutSurface05"
    }
    {
      Id = "Zeus_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sedikit perbedaan pendapat di sini mengenai di mana usahamu akan memberikan manfaat terbesar. Kami akan menjaga urusan di Olympus tetap terkendali, tapi kami tak bisa mencapai Chronos di alam ayahmu semudah dirimu!"
      Speaker = "Zeus"
      Event = "ZeusAboutRouteChoice01"
    }
    {
      Id = "Zeus_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos punya armada yang begitu gigih di Celah Thessaly sana! Kapal-kapal yang sarat dengan pasukan dan perbekalan. Pintar sekali dirimu, menyusup diam-diam demi mengacaukan garis pertahanan musuh!"
      Speaker = "Zeus"
      Event = "ZeusAboutThessaly01"
    }
    {
      Id = "Zeus_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di dalam wilayah ayahmu terdapat roda-roda emas kuno yang aneh, tanpa henti menggeser ruang-ruang Dunia Bawah ke sana kemari. Ternyata itu ulah Chronos! Dan dia berhasil memperluas pengaruh busuknya hingga ke permukaan pula..."
      Speaker = "Zeus"
      Event = "ZeusAboutChronosClockwork01"
    }
    {
      Id = "Zeus_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku pun terkadang bisa naik darah; tapi aku menahan diri agar tak memporak-porandakan permukaan dengan badaiku, mengetahui bahwa kaum fana yang memihak Chronos hanyalah korban tipu dayanya. Begitu semua ini berakhir, mereka akan kembali ke jalan terang."
      Speaker = "Zeus"
      Event = "ZeusAboutStorms01"
    }
    {
      Id = "Zeus_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, di mana sebenarnya kau {#Emph}berada{#Prev}, Nona muda? Di pinggiran wilayah Poseidon, tampaknya. Kau berniat mengitari wilayah kekuasaan ayahmu! Mengapa harus menghadapi pasukan Chronos secara langsung jika kau bisa memutarinya... langkah yang cerdik!"
      Speaker = "Zeus"
      Event = "ZeusAboutOceanus01"
    }
    {
      Id = "Zeus_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh tak pantas kau harus bersusah payah melintasi perbatasan di antara alam saudara-saudaraku! Walau jika ini bisa menghiburmu, monster-monster air yang kau hadapi itu akan segera merasakan sengatan kejut yang nyata!"
      Speaker = "Zeus"
      Event = "ZeusAboutOceanus02"
    }
    {
      Id = "Zeus_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagian terdalam dari Dunia Bawah pasti sudah banyak berubah; suram, dengan cara-cara yang serbabaru! Mengingat Chronos menjadikan Tartarus sebagai bentengnya, tempat di mana dulu kami menguburnya..."
      Speaker = "Zeus"
      Event = "ZeusAboutTartarus01"
    }
    {
      Id = "Zeus_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah cukup lama, Nona muda! Kabar sampai kepadaku bahwa kau telah membuat kemajuan pesat akhir-akhir ini, dan memajukan perjuangan agung kita. Maka aku memujimu, dan tentu saja, aku juga memberikan berkahku kepadamu!"
      Speaker = "Zeus"
      Event = "ZeusUnderworldRunCleared01"
    }
    {
      Id = "Zeus_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana tepatnya caramu mengalahkan Chronos, seseorang harus menjelaskannya padaku suatu saat nanti! Ilmu sihirmu akan membantumu menang di saat kami gagal, {#Emph}hm? {#Prev}Setidaknya dia belum memenjarakanmu bersama para kerabatmu yang lain!"
      Speaker = "Zeus"
      Event = "ZeusUnderworldRunCleared02"
    }
    {
      Id = "Zeus_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar burung menyebutkan bahwa kau berhasil menggagalkan Chronos tadi malam? Walau aku masih agak sangsi, karena pasukannya masih terus melancarkan serangan, dan Typhon sama sekali tak menunjukkan tanda-tanda mereda. Kita harus menghentikan semua ini..."
      Speaker = "Zeus"
      Event = "ZeusUnderworldRunCleared03"
    }
    {
      Id = "Zeus_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bapa Chronos mengklaim kau melenyapkan satu kemungkinan lagi bahwa masa lalunya bisa menguasai Olympus dan alam bawah. Kau diminta terus melawan Sang Titan Waktu seolah-olah dia {#Emph}masih {#Prev}mengancam kita seperti sebelumnya? Konyol sekali..."
      Speaker = "Zeus"
      Event = "ZeusUnderworldRunCleared04"
    }
    {
      Id = "Zeus_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang terjadi padamu dalam perjalananmu menuju puncak gunung kami, Keponakanku? Kami kehilangan kontak denganmu di suatu tempat di perjalanan, tepat ketika kau tampak sudah begitu dekat. Yah, jangan putus asa, dan jangan menyerah pula!"
      Speaker = "Zeus"
      Event = "ZeusSurfaceRunCleared01"
    }
    {
      Id = "Zeus_0315"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak tahu apa yang kau perbuat pada Chronos, Keponakanku, tapi dia bukan lagi dirinya yang dulu... praktis mengemis belas kasihan di sini! Dan memohon bantuan kita untuk memastikan waktu mengalir bebas ke depan, atau omong kosong semacamnya. Apakah {#Emph}ini {#Prev}alasanmu berniat menelusuri kembali langkahmu...?"
      Speaker = "Zeus"
      Event = "ZeusPostTrueEnding01"
    }
    {
      Id = "Zeus_0316"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lama saudara-saudara lelaki dan saudara-saudara angkat perempuanku berperang melawan Titan Chronos, namun {#Emph}sekarang {#Prev}kita harus mengadakan {#Emph}gencatan senjata? {#Prev}Aku tak akan memercayainya dalam waktu dekat... kau hanya perlu memberi aba-aba, dan kami akan menyegelnya untuk selama-lamanya."
      Speaker = "Zeus"
      Event = "ZeusPostTrueEnding02"
    }
    {
      Id = "Zeus_0317"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuperhatikan bahwa ayahmu dan diriku memikirkan sesuatu yang cocok untuk Chronos, karena aku jelas tak menginginkannya berada di {#Emph}sini. {#Prev}Dia akan memimpin Kepulauan Para Pemberkah, di dekat Elysium di wilayah kekuasaan{#Emph}mu! {#Prev}Jabatan kehormatan yang sangat pantas bagi sosok berpengalaman sepertinya."
      Speaker = "Zeus"
      Event = "ZeusPostTrueEnding03"
    }
    {
      Id = "Zeus_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa rencanamu selanjutnya, Nona muda, setelah tugas agung yang kauemban ini rampung? Tentu kita masih punya cukup banyak kekacauan yang harus dibereskan, tapi setelah itu. Apa pun yang kauputuskan nanti, semoga itu mendatangkan kepuasan dan kejayaan."
      Speaker = "Zeus"
      Event = "ZeusAboutFuture01"
    }
    {
      Id = "Zeus_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiga Fates akhirnya ditemukan, begitulah kabar gembira dari kurir kita! Aku yakin mereka akan kembali menjaga kedaulatan kita mulai saat ini... meski itu berarti harus sedikit menarik benang takdir dari waktu ke waktu. Harga kecil yang sepadan!"
      Speaker = "Zeus"
      Event = "ZeusPostEpilogue01"
    }
    {
      Id = "Zeus_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita bangsa Olympian, yang ditunjuk oleh Fates sendiri untuk menguasai dunia ini, diramalkan untuk sekadar... {#Emph}mundur teratur? {#Prev}Memerintah dengan {#Emph}sentuhan yang lebih lembut! Huh. {#Prev}Maka begitulah kehendaknya, pantang mempertanyakan ketiga wanita itu. Meski aku ragu manusia fana akan menyukai perubahan ini."
      Speaker = "Zeus"
      Event = "ZeusPostEpilogue02"
    }
    {
      Id = "Zeus_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakekmu rupanya belum sepenuhnya menyerah pada gagasannya tentang Zaman Keemasan yang lain. Berhubung perangainya lumayan patuh, kami setuju untuk mendengarkan usulannya. Zaman jelas telah berubah... mari kita pastikan semua ini demi kebaikan bersama."
      Speaker = "Zeus"
      Event = "ZeusPostEpilogue03"
    }
    {
      Id = "Zeus_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, Melinoë... tekadmu dalam menuntaskan tugas ini jauh lebih besar dari dugaanku. Keturunanku sendiri biasanya mudah patah arang. Sungguh melegakan melihat keturunan kakak sulungku tidak berwatak selemah itu."
      Speaker = "Zeus"
      Event = "ZeusPostGift01"
    }
    {
      Id = "Zeus_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali kau masih lajang, setidaknya begitulah yang kudengar. Latihanmu yang tiada henti, hidup di rerimbunan tersembunyi... {#Emph}pantas saja {#Prev}belum ada sosok istimewa di hidupmu! Namun jangan cemas, kau pasti akan sibuk menepis para pelamar dari kiri dan kanan begitu namamu tersiar luas!"
      Speaker = "Zeus"
      Event = "ZeusPostGift02"
    }
    {
      Id = "Zeus_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahi sengatan-sengatan {#Emph}kecil {#Prev}itu, Keponakanku! Suasana hatiku sedang pemurah, jadi seluruh kekuatan petirku bebas kaukendalikan sesukamu! Yah, tak sepenuhnya {#Emph}semua, {#Prev}tapi jelas lebih dari cukup, kuyakin itu!"
      Speaker = "Zeus"
      Event = "ZeusLegendaryPickUp01"
    }
    {
      Id = "Zeus_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku muak dengan kebuntuan yang berlarut-larut ini! Ambillah kekuatanku sekarang, Nona muda, dan terjanglah barisan musuh bagaikan sambaran petir di tengah malam gulita!"
      Speaker = "Zeus"
      Event = "ZeusLegendaryPickUp02"
    }
    {
      Id = "Zeus_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, istriku yang jelita telah melimpahkan restunya padamu, Melinoë? Dia sangat waspada, wanita itu, jadi kau berada di tangan yang tepat! Tangan yang terampil, tangguh, dan sangat {#Emph}penuh pengawasan..."
      Speaker = "Zeus"
      Event = "ZeusAboutHera01"
    }
    {
      Id = "Zeus_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikul berbagai cobaan berat bersama Hera-ku yang setia di sisiku! Dia sungguh {#Emph}penyabar{#Prev}, dan bijaksana, ya ampun, dia adalah sandaranku! Aku akan selalu berpegang teguh padanya, bagai batu karang kokoh tempatku bertumpu!"
      Speaker = "Zeus"
      Event = "ZeusAboutHera02"
    }
    {
      Id = "Zeus_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengar, Melinoë, begitu kau berumah tangga selama aku dan Hera, kau pun akan melewati rintangan yang tak terhitung jumlahnya. Pernikahan kami justru kian {#Emph}kokoh {#Prev}berkat setiap khilaf kecil yang terlewati di sepanjang jalan!"
      Speaker = "Zeus"
      Event = "ZeusAboutHera03"
    }
    {
      Id = "Zeus_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pancaran terang putraku yang rupawan, Apollo, telah menerangimu di dalam kegelapan, walau hanya sekejap, wahai Nona muda! Kuharap semua kerabatku memiliki bakat yang setara dengannya!"
      Speaker = "Zeus"
      Event = "ZeusAboutApollo01"
    }
    {
      Id = "Zeus_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apollo yang berkilau telah menawarkan bantuannya lagi kepadamu, ya? Dia unggul dalam hampir segala hal yang ditekuni pikiran dan raganya, anak itu! Walaupun dia sendiri belakangan ini agak kewalahan menghadapi semua kemelut ini!"
      Speaker = "Zeus"
      Event = "ZeusAboutApollo02"
    }
    {
      Id = "Zeus_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah menyandang berkat samudra milik Saudaraku Poseidon, bukan, Nona muda? Terang saja kukatakan: Kau bakal butuh bantuan lebih dari sekadar {#Emph}itu{#Prev}, jadi terimalah ini."
      Speaker = "Zeus"
      Event = "ZeusAboutPoseidon01"
    }
    {
      Id = "Zeus_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi sumpahku, Nona muda! Keanggunanmu sungguh memukau sampai-sampai aku hampir mengiramu sebagai Aphrodite nan jelita. Dia sudah menemuimu, hal itu terpampang jelas. Kalian para dewi, kalian menghunus kecantikan bagaikan sebilah {#Emph}pedang!"
      Speaker = "Zeus"
      Event = "ZeusAboutAphrodite01"
    }
    {
      Id = "Zeus_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak tahu betapa hebatnya pencapaianmu hingga bisa membuat Hestia tua turut andil dalam tugasmu! Perangainya bisa sangat keras kepala, dan enggan ikut serta dalam urusan keluarga kami. Namun jika menyangkut {#Emph}dirimu{#Prev}, dia benar-benar berkobar-kobar!"
      Speaker = "Zeus"
      Event = "ZeusAboutHestia01"
    }
    {
      Id = "Zeus_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pada diri Yang Mulia Demeter, kau punya pendukung yang garang, Nona muda! Dia sudah memberkatimu, tak diragukan lagi. Wataknya tak ubahnya musim dingin abadi, wanita {#Emph}itu! {#Prev}Namun pertemuannya dengan sang cucu sepertinya telah mengingatkannya pada musim-musim yang lebih hangat."
      Speaker = "Zeus"
      Event = "ZeusAboutDemeter01"
    }
    {
      Id = "Zeus_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hephaestus si pekerja keras telah menawarkan jasanya padamu, ya? Kami butuh dentangan palunya di gudang persenjataan kami di {#Emph}sini{#Prev}, meski kurasa membantumu secara langsung juga memajukan perjuangan kita. Jelas tak pernah ada kata sepi bagi mahakarya {#Emph}buatannya {#Prev}belakangan ini!"
      Speaker = "Zeus"
      Event = "ZeusAboutHephaestus01"
    }
    {
      Id = "Zeus_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tiba di sini cukup lekas, sungguh berbeda dengan si berandal Hermes itu, harus kuakui. Akhir-akhir ini batang hidungnya tak pernah tampak saat dibutuhkan! Jika dia berniat membuat dirinya berguna dalam semua ini, semoga saja dia bisa lebih diandalkan di hadapanmu."
      Speaker = "Zeus"
      Event = "ZeusAboutHermes01"
    }
    {
      Id = "Zeus_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berkilau bagaikan bermandikan cahaya rembulan, Nona muda! Nyaris seolah-olah Selene nan elok sendiri yang meminyakimu. Sayang sekali, dia harus melintasi angkasa malam, sementara kau dibiarkan berjuang sendiri di daratan."
      Speaker = "Zeus"
      Event = "ZeusAboutSelene01"
    }
    {
      Id = "Zeus_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, Nona muda, kau sedikit mengingatkanku pada putriku yang selalu waspada, Athena! Tangannya sedang penuh belakangan ini, merancang strategi demi menghalau serangan tanpa henti ini. Aku menantikan saat kalian bisa saling bersua nanti!"
      Speaker = "Zeus"
      Event = "ZeusAboutAthena01"
    }
    {
      Id = "Zeus_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ke mana perginya Artemis yang gemar keluyuran itu di tengah kemelut ini? Putriku semestinya bisa membantumu, tapi dia malah asyik bersenang-senang dengan Peri Hutan, sepertinya! Seandainya saja semua anak-anakku bertanggung jawab sepertimu."
      Speaker = "Zeus"
      Event = "ZeusAboutArtemis01"
    }
    {
      Id = "Zeus_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau belum sempat berjumpa dengan putraku yang satu itu, sang dewa perang yang tersohor? Tadinya kukira Ares bakal bersuka ria bukan kepalang melihat semua pertumpahan darah belakangan ini! Berani-beraninya dia menghilang di saat seperti ini. Dia dan aku sudah saatnya menggelar {#Emph}obrolan {#Prev}serius."
      Speaker = "Zeus"
      Event = "ZeusAboutAres01"
    }
    {
      Id = "Zeus_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Putraku si pencinta damai, Dionysus, dia sama sekali enggan campur tangan dalam kemelut ini, bisa-bisanya dia bersikap {#Emph}begitu? {#Prev}Dia sungguh percaya bahwa {#Emph}anggur {#Prev}adalah jalan keluar dari segala persoalan hidup! {#Emph}Heh! {#Prev}Dia bakal kehabisan minuman dalam waktu dekat jika mempertahankan sikap semacam itu."
      Speaker = "Zeus"
      Event = "ZeusAboutDionysus01"
    }
    {
      Id = "Zeus_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedamaian baru kita semestinya bisa memancing Dionysus si pemuja anggur keluar, namun aku masih belum melihat tanda-tanda keberadaannya... selain fakta bahwa persediaan Nektar dan Ambrosia kita menipis secara mengkhawatirkan! Barangkali memang yang terbaik jika semua pesta pora kita ditunda dulu."
      Speaker = "Zeus"
      Event = "ZeusAboutDionysus02"
    }
    {
      Id = "Zeus_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar sampai ke telingaku bahwa lorong-lorong purba mulai bermunculan di permukaan kita, yang konon mengarah ke kedalaman Chaos. Tembus sampai ke sini? Pasti hasil sihirmu yang bekerja, kuyakin... atau jalinan persekutuan kuno..."
      Speaker = "Zeus"
      Event = "ZeusAboutChaos01"
    }
    {
      Id = "Zeus_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihan bijak mengenakan Gelang Mendung milikku, Keponakanku! Betapa mudahnya aku menemukanmu berkat benda itu, sehingga aku bisa melimpahkan berkatku saat kau paling membutuhkannya! Sekarang {#Emph}pilihlah{#Prev}, dan hancurkan musuh-musuh kita sebagaimana yang kulakukan sendiri andai aku berada di sana!"
      Speaker = "Zeus"
      Event = "ZeusAboutKeepsake01"
    }
    {
      Id = "Zeus_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, Gelang Mendung yang kuberikan padamu itu sudah terisi penuh! Lagipula, siapa yang sanggup menolak kedahsyatan kekuatan langit itu sendiri? Tentu saja kebanyakan dari mereka tak mendapat kesempatan; aku tak membagikannya sembarangan!"
      Speaker = "Zeus"
      Event = "ZeusAboutKeepsake02"
    }
    {
      Id = "Zeus_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang sungguh mencekam, suasana kelam yang sudah sekian lama tak pernah kurasakan! Namun kau dan sang Penyihir Simpang Tiga itu, kalian pasti menikmati ketakutan dan kegelapan yang menyesakkan dada ini, bukan? Majulah dan tebarkan teror pada musuh-musuh kita!"
      Speaker = "Zeus"
      Event = "ZeusAboutShrine01"
    }
    {
      Id = "Zeus_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, kaum fana pasti luar biasa ketakutan pada malam yang penuh badai dan pekat seperti {#Emph}ini! {#Prev}Entah karena kita para dewa sedang murka dan gusar, atau barangkali hanya musuh-musuh kita saja yang gemetar."
      Speaker = "Zeus"
      Event = "ZeusAboutShrine02"
    }
    {
      Id = "Zeus_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu bisa merasakan jika ada sesuatu yang tak beres, dan malam ini, kekuatan aneh sedang bergolak. Barangkali Tiga Fates sendiri yang memastikan kau bakal menjumpaiku seperti ini..."
      Speaker = "Zeus"
      Event = "ZeusAboutPackageBounty01"
    }
    {
      Id = "Zeus_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian para dewa Dunia Bawah dan tata cara kuno kalian... yang kutahu pasti, kau telah melakukan {#Emph}sesuatu {#Prev}untuk mengubah jalannya malam ini, sebab aku bisa {#Emph}merasakannya {#Prev}di udara. Semoga saja ini membawa keuntungan bagi kita!"
      Speaker = "Zeus"
      Event = "ZeusPackageBountyIntro01"
    }
    {
      Id = "Zeus_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasanya seolah kita pernah bersua sebelumnya pada malam yang persis seperti ini... tapi karena kita sudah memerangi Chronos sekian lama, pemahaman kita akan waktu bisa sama menipunya dengan musuh kita!"
      Speaker = "Zeus"
      Event = "ZeusPackageBountyIntro02"
    }
    {
      Id = "Zeus_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jalan aneh macam apa yang kautempuh ini, Keponakanku? Kami nyaris tak mampu melacak keberadaanmu! Tampaknya ada yang tidak beres malam ini, kekuatan asing bahkan di luar kendali {#Emph}kami..."
      Speaker = "Zeus"
      Event = "ZeusAboutRandomBounties01"
    }
    {
      Id = "Zeus_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan ikatan suci keluarga pun bisa terputus, Nona muda."
      Speaker = "Zeus"
      Event = "ZeusChat01"
    }
    {
      Id = "Zeus_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingatlah baik-baik, tak ada dewa belas kasihan di Olympus, Melinoë."
      Speaker = "Zeus"
      Event = "ZeusChat02"
    }
    {
      Id = "Zeus_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat semua ini berakhir, kupastikan kau akan diganjar hadiah yang amat berlimpah."
      Speaker = "Zeus"
      Event = "ZeusChat03"
    }
    {
      Id = "Zeus_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu untuk menyelesaikan masalah pelik ini secara damai sudah lama berlalu."
      Speaker = "Zeus"
      Event = "ZeusChat04"
    }
    {
      Id = "Zeus_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tegakkan kepalamu, Nona muda, karena kita adalah {#Emph}dewa! {#Prev}Kita semua!"
      Speaker = "Zeus"
      Event = "ZeusChat05"
    }
    {
      Id = "Zeus_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersama-sama, kita bisa membebaskan dunia ini dari Chronos dan pengaruh jahatnya."
      Speaker = "Zeus"
      Event = "ZeusChat06"
    }
    {
      Id = "Zeus_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagai dewa, dunia ini adalah hak mutlak kita. Dan kita akan mempertahankannya, bukan?"
      Speaker = "Zeus"
      Event = "ZeusChat07"
    }
    {
      Id = "Zeus_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa musuh-musuh kita akan segera menerima kejutan yang menyengat!"
      Speaker = "Zeus"
      Event = "ZeusChat08"
    }
    {
      Id = "Zeus_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cepat atau lambat kita akan mengakhiri pemberontakan kecil ini, {#Emph}hm?"
      Speaker = "Zeus"
      Event = "ZeusChat09"
    }
    {
      Id = "Zeus_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baktimu terhadap keluarga ini takkan luput dari perhatian, Nona muda."
      Speaker = "Zeus"
      Event = "ZeusChat10"
    }
    {
      Id = "Zeus_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menghadapi cecunguk kurang ajar dan orang-orang bodoh hanyalah bagian dari kedewaan, sayangnya."
      Speaker = "Zeus"
      Event = "ZeusChat11"
    }
    {
      Id = "Zeus_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olympus berdiri kokoh, dan kau akan bantu memastikannya tetap seperti itu, kan?"
      Speaker = "Zeus"
      Event = "ZeusChat12"
    }
    {
      Id = "Zeus_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita pasti akan membalikkan keadaan, Melinoë! Majulah sekarang dengan secuil kekuatanku."
      Speaker = "Zeus"
      Event = "ZeusChat13"
    }
    {
      Id = "Zeus_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian para penyihir memang punya percikan alami tersendiri, aku tahu, tapi terimalah! Ini percikan dariku."
      Speaker = "Zeus"
      Event = "ZeusChat14"
    }
    {
      Id = "Zeus_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong beri musuh-musuh kita pengalaman yang benar-benar menyengat untukku, ya?"
      Speaker = "Zeus"
      Event = "ZeusChat15"
    }
    {
      Id = "Zeus_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos bisa diakali dan dikalahkan. Kita pasti akan menghabisinya, Keponakanku!"
      Speaker = "Zeus"
      Event = "ZeusChat16"
    }
    {
      Id = "Zeus_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu pasti akan sangat bangga, aku yakin itu. Kami semua pun begitu!"
      Speaker = "Zeus"
      Event = "ZeusChat17"
    }
    {
      Id = "Zeus_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lawan kita memang penuh murka, ya; tapi kita pun punya cara tersendiri, Melinoë..."
      Speaker = "Zeus"
      Event = "ZeusChat18"
    }
    {
      Id = "Zeus_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau akan membantu kita membalikkan keadaan demi kemenangan, bukan, Nona muda?"
      Speaker = "Zeus"
      Event = "ZeusChat19"
    }
    {
      Id = "Zeus_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yakin semua kekacauan ini akan segera berlalu dalam sekejap mata, {#Emph}hm?"
      Speaker = "Zeus"
      Event = "ZeusChat20"
    }
    {
      Id = "Zeus_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita akan segera membuat Chronos berharap dia tetap meringkuk di dasar Tartarus yang terdalam, tempatnya yang pantas!"
      Speaker = "Zeus"
      Event = "ZeusChat21"
    }
    {
      Id = "Zeus_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadilah seperti petir, Keponakanku, dan sambarlah musuh-musuh kita sebelum mereka menyadari apa yang menghantam mereka!"
      Speaker = "Zeus"
      Event = "ZeusChat22"
    }
    {
      Id = "Zeus_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tak berhasil menguasai dunia ini dengan meremehkan musuh, keponakanku."
      Speaker = "Zeus"
      Event = "ZeusChat23"
    }
    {
      Id = "Zeus_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada urusan mendesak yang harus kutangani, jadi tolong urus segalanya di bawah sana untukku, ya?"
      Speaker = "Zeus"
      Event = "ZeusChat24"
    }
    {
      Id = "Zeus_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selalu menyenangkan bisa bertemu denganmu, Melinoë! Bahkan di masa-masa seperti ini sekalipun..."
      Speaker = "Zeus"
      Event = "ZeusChat25"
    }
    {
      Id = "Zeus_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Badai kita ini akan terus berkecamuk selama yang kita kehendaki, bukan begitu, keponakanku?"
      Speaker = "Zeus"
      Event = "ZeusChat26"
    }
    {
      Id = "Zeus_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga kita memang pernah mengalami masa-masa suram dari zaman ke zaman, tapi kita selalu bangkit kembali!"
      Speaker = "Zeus"
      Event = "ZeusChat27"
    }
    {
      Id = "Zeus_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hawa menggelenyar di udara itu adalah pertanda pasti bahwa kemenangan sudah di depan mata!"
      Speaker = "Zeus"
      Event = "ZeusChat28"
    }
    {
      Id = "Zeus_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku dan seluruh anggota klan lainnya selalu mendukung setiap langkahmu, Nona muda."
      Speaker = "Zeus"
      Event = "ZeusChat29"
    }
    {
      Id = "Zeus_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua orang yang berani menentang Olympus akan langsung disambar tanpa ampun."
      Speaker = "Zeus"
      Event = "ZeusChat30"
    }
    {
      Id = "Zeus_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan jejak terkecil dari ancaman Chronos dan Typhon pun takkan dibiarkan membayangi kita."
      Speaker = "Zeus"
      Event = "ZeusChat31"
    }
    {
      Id = "Zeus_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketahuilah bahwa baktimu yang tiada henti pada Olympus amatlah dihargai, Keponakanku."
      Speaker = "Zeus"
      Event = "ZeusChat32"
    }
    {
      Id = "Zeus_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika sisa-sisa Typhon yang jadi sasaranmu, mungkin kita akan bersua saat tiba waktunya untuk menyerang!"
      Speaker = "Zeus"
      Event = "ZeusChat33"
    }
    {
      Id = "Zeus_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selama ancaman Typhon masih membebani kita, kita pasti akan mengambil tindakan!"
      Speaker = "Zeus"
      Event = "ZeusChat34"
    }
    {
      Id = "Zeus_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Majulah dan pastikan Dunia Bawah tetap berada di bawah kendali penuh keluargamu!"
      Speaker = "Zeus"
      Event = "ZeusChat35"
    }
    {
      Id = "Zeus_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu mungkin memang sulit dihubungi, tapi aku selalu bisa menjangkaumu!"
      Speaker = "Zeus"
      Event = "ZeusChat36"
    }
    {
      Id = "Zeus_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan Olympus berdiri kokoh di belakangmu dalam apa pun langkahmu selanjutnya, Melinoë."
      Speaker = "Zeus"
      Event = "ZeusChat37"
    }
    {
      Id = "Zeus_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari sekian banyak cobaan yang dihadapi keluarga kita, belum pernah ada satu pun yang gagal kita taklukkan."
      Speaker = "Zeus"
      Event = "ZeusChat38"
    }
    {
      Id = "Zeus_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sedikit pencegahan ancaman sudah sepantasnya memastikan keluarga kita bisa beristirahat dengan tenang di mana pun kita berada."
      Speaker = "Zeus"
      Event = "ZeusChat39"
    }
    {
      Id = "Zeus_0368"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, perjalananmu dimulai kembali, nona muda!"
      Speaker = "Zeus"
      Event = "ZeusChat41"
    }
    {
      Id = "Zeus_0369"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuasaku atas langit tak ada apa-apanya dibandingkan eratnya ikatan keluarga kita."
      Speaker = "Zeus"
      Event = "ZeusChat42"
    }
    {
      Id = "Zeus_0370"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kuduga aku akan mendapati dirimu berangkat lagi untuk aksi nekatmu berikutnya!"
      Speaker = "Zeus"
      Event = "ZeusChat43"
    }
    {
      Id = "Zeus_0371"
      InheritFrom = "BaseNarrative"
      DisplayName = "Urusan di Olympus sudah kami kendalikan dengan sangat baik, nona muda!"
      Speaker = "Zeus"
      Event = "ZeusChat44"
    }
    {
      Id = "Zeus_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti sudah merasakan bahwa berkahkulah yang akan kau terima, nona muda! Energi itu, {#Emph}sengatan listrik {#Prev}itu... yah, kurasa hal semacam itu memang mustahil disembunyikan!"
      Speaker = "Zeus"
      Event = "ZeusBlindBox01"
    }
    {
      Id = "Zeus_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuyakini ini adalah berkah terselubung yang sesungguhnya! Bisa saja tadi yang datang adalah anggota keluarga yang lain... jadi kau sungguh sangat beruntung!"
      Speaker = "Zeus"
      Event = "ZeusBlindBox02"
    }
    {
      Id = "Zeus_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap pesan ini sampai saat keadaanmu baik-baik saja! Kita harus tetap menjalin komunikasi sebaik mungkin, meski itu berarti harus menggunakan jasa Tukang Perahu Bawah Tanahmu sesekali."
      Speaker = "Zeus"
      Event = "ZeusLootBought01"
    }
    {
      Id = "Zeus_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Charon tua pasti punya banyak waktu luang sekarang, karena dia tak lagi sibuk mengantar jiwa-jiwa ke peristirahatan abadi mereka. Kendati demikian, aku yakin kita bisa membuatnya tetap sibuk mengabdi kepada kita di sini!"
      Speaker = "Zeus"
      Event = "ZeusLootBought02"
    }
    {
      Id = "Zeus_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh tinggi hati si Chronos itu mencetak semua koin emas tersebut dengan wajahnya sendiri! Janji akan tibanya {#Emph}Zaman Keemasan {#Prev}baru, begitulah kata beberapa manusia fana, {#Emph}cih! {#Prev}Zaman itu sudah lama berlalu. Dan tak ada logam berkilau sebanyak apa pun yang bisa mengembalikannya."
      Speaker = "Zeus"
      Event = "ZeusLootBought03"
    }
    {
      Id = "Zeus_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah, haha! {#Prev}Tak kusangka berkahku bisa ditukar hanya dengan sekeping koin murahan. Ketahuilah bahwa si Tukang Perahu menjadi perantara transaksi ini semata-mata hanya demi {#Emph}dirimu! {#Prev}Bantuan kami tidak pernah untuk diperjualbelikan."
      Speaker = "Zeus"
      Event = "ZeusLootBought04"
    }
    {
      Id = "Zeus_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berapa banyak lagi koin Chronos terkutuk seperti ini di luar sana, keponakanku? Menurut Kakekmu, takkan ada lagi yang dicetak mulai sekarang, tapi jumlahnya masih berlimpah ruah saja!"
      Speaker = "Zeus"
      Event = "ZeusLootBought05"
    }
    {
      Id = "Zeus_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akulah penguasa dan panglima tertinggi perjuangan kita di sini! Dan rantai komando harus dipatuhi."
      Speaker = "Zeus"
      Event = "ZeusRejection01"
    }
    {
      Id = "Zeus_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak membagikan berkahku begitu saja; ketika kutawarkan, kuharap kau menerimanya."
      Speaker = "Zeus"
      Event = "ZeusRejection02"
    }
    {
      Id = "Zeus_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memang tak bisa menyenangkan semua orang setiap saat, tapi kau sungguh tak perlu mengecewakan {#Emph}aku {#Prev}seperti ini."
      Speaker = "Zeus"
      Event = "ZeusRejection03"
    }
    {
      Id = "Zeus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya ampun! Standar rasa hormat dan sopan santun tampaknya terlalu rendah di tempat kau dibesarkan."
      Speaker = "Zeus"
      Event = "ZeusRejection04"
    }
    {
      Id = "Zeus_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya {#Emph}kau {#Prev}yang ditolak mentah-mentah, di posisiku {#Emph}sekarang{#Prev}, kau pasti akan bertindak persis seperti yang akan kulakukan ini."
      Speaker = "Zeus"
      Event = "ZeusRejection05"
    }
    {
      Id = "Zeus_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meskipun aku menyukai kelakar cerdas sama seperti dewa lainnya, lelucon barusan ini sungguh sangat tidak berkelas."
      Speaker = "Zeus"
      Event = "ZeusRejection06"
    }
    {
      Id = "Zeus_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ini Raja Olympus! Apakah sedikit kepatuhan itu sungguh tuntutan yang berlebihan?"
      Speaker = "Zeus"
      Event = "ZeusRejection07"
    }
    {
      Id = "Zeus_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau punya tabiat membangkang, nona muda! Sebaiknya sifat itu kau kendalikan baik-baik."
      Speaker = "Zeus"
      Event = "ZeusRejection08"
    }
    {
      Id = "Zeus_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau merongrong kewibawaanku, kau akan menanggung akibatnya. Sesederhana itu."
      Speaker = "Zeus"
      Event = "ZeusRejection09"
    }
    {
      Id = "Zeus_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir Persimpangan Jalan itu mungkin mengajarimu cara bertarung, tapi di mana sopan santunmu?"
      Speaker = "Zeus"
      Event = "ZeusRejection10"
    }
    {
      Id = "Zeus_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita memang keluarga, itu benar; namun jika situasi mendesak, kata akhir tetap ada padaku."
      Speaker = "Zeus"
      Event = "ZeusRejection11"
    }
    {
      Id = "Zeus_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan menguji batas kesabaranku; belakangan ini kesabaranku sedang sangat tipis."
      Speaker = "Zeus"
      Event = "ZeusRejection12"
    }
    {
      Id = "Zeus_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biasanya aku menyarankanmu untuk selalu berpihak pada Ratu Hera dalam segala hal. Tapi tidak untuk kali ini!"
      Speaker = "Zeus"
      Event = "ZeusRejection13"
    }
    {
      Id = "Zeus_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hera tercintaku dan aku mungkin sesekali berselisih paham, tapi kau tak usah ikut campur!"
      Speaker = "Zeus"
      Event = "ZeusRejection14"
    }
    {
      Id = "Zeus_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lebih memilih saudaraku ketimbang diriku sendiri? Nona muda, kukira kau cukup {#Emph}berakal sehat!"
      Speaker = "Zeus"
      Event = "ZeusRejection15"
    }
    {
      Id = "Zeus_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kesabaranku belakangan ini ada batasnya, nona muda. Kusalurkan saran agar kau tak terus-menerus mengujinya."
      Speaker = "Zeus"
      Event = "ZeusMakeUp01"
    }
    {
      Id = "Zeus_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemurkaan Olympus itu tiada batasnya. Sebaiknya jangan mengundangnya kembali menimpamu."
      Speaker = "Zeus"
      Event = "ZeusMakeUp02"
    }
    {
      Id = "Zeus_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan kita paling baik dikerahkan melawan musuh bersama kita. Tapi sadarilah posisimu lain kali."
      Speaker = "Zeus"
      Event = "ZeusMakeUp03"
    }
    {
      Id = "Zeus_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, cukup sudah! Kita harus tetap menjaga tata krama, bahkan di masa-masa pelik seperti ini."
      Speaker = "Zeus"
      Event = "ZeusMakeUp04"
    }
    {
      Id = "Zeus_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah berhasil melewati badai ini, namun perhatikan baik-baik agar tak terperangkap lagi di dalamnya lain kali."
      Speaker = "Zeus"
      Event = "ZeusMakeUp05"
    }
    {
      Id = "Zeus_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertengkaran picik begini! Kesabaranku belakangan ini memang sedang menipis, seperti yang bisa kau lihat."
      Speaker = "Zeus"
      Event = "ZeusMakeUp06"
    }
    {
      Id = "Zeus_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saling bertengkar begini takkan ada hasilnya! Mari kita arahkan amarah yang tertahan ini kepada {#Emph}musuh-musuh {#Prev}kita!"
      Speaker = "Zeus"
      Event = "ZeusMakeUp07"
    }
    {
      Id = "Zeus_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anggap saja dirimu sudah ditegur, Melinoë. Sekarang, mari kembali ke urusan utama kita!"
      Speaker = "Zeus"
      Event = "ZeusMakeUp08"
    }
    {
      Id = "Zeus_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tidak boleh saling bertikai seperti ini! Yah, setidaknya kita menyudahinya dengan cepat!"
      Speaker = "Zeus"
      Event = "ZeusMakeUp09"
    }
    {
      Id = "Zeus_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prioritasku selalu keluarga, Keponakanku! Sekalipun terkadang itu menuntut pilihan-pilihan yang berat."
      Speaker = "Zeus"
      Event = "ZeusMakeUp10"
    }
    {
      Id = "Zeus_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih suka tidak memperpanjang perselisihan yang tak perlu ini, saat ada musuh sejati yang harus kita hadapi."
      Speaker = "Zeus"
      Event = "ZeusMakeUp11"
    }
    {
      Id = "Zeus_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu selalu punya selera humor yang sinis dan datar, dan tampaknya kau pun begitu."
      Speaker = "Zeus"
      Event = "ZeusMakeUp12"
    }
    {
      Id = "Melinoe_0954"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk Paman Zeus yang perkasa, penakluk para Titan! Kekuatanmu telah menyelamatkan keluarga kita sebelumnya. Paman sungguh bermurah hati karena sudi membaginya denganku saat ini."
      Speaker = "Melinoe"
      Event = "ZeusGift01"
    }
    {
      Id = "Zeus_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini jelas bukan saat yang tepat untuk memberiku persembahan. Namun justru karena itulah aku sangat menghargainya, Keponakanku! Dan sesuai adat keluarga kita, aku pun telah menyiapkan sesuatu untukmu!"
      Speaker = "Zeus"
      Event = "ZeusGift01"
    }
    {
      Id = "Melinoe_0955"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Zeus, Raja Olympus, sungguh sebuah kehormatan bisa mengabdi kepadamu! Aku bersumpah akan menggunakan kekuatan petirmu demi kemaslahatan keluarga kita."
      Speaker = "Melinoe"
      Event = "ZeusGift02"
    }
    {
      Id = "Zeus_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan di masa-masa seperti ini, kau tetap menunjukkan rasa hormat kepada pamanmu, keponakanku yang berbudi pekerti. Ketahuilah, sebagai balasannya, kau mendapatkan rasa terima kasihku!"
      Speaker = "Zeus"
      Event = "ZeusGift02"
    }
    {
      Id = "Melinoe_0956"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Paman Zeus yang murah hati, aku punya persembahan lain untukmu, meski nilainya tak seberapa! Semoga Paman segera berkesempatan menikmatinya dalam damai."
      Speaker = "Melinoe"
      Event = "ZeusGift03"
    }
    {
      Id = "Zeus_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah sering dihujani persembahan semacam ini, kau tahu. Namun, jika datang dari orang sepertimu, maknanya jauh lebih berarti bagiku dibanding yang lain. Anak-anakku yang lain harus banyak belajar darimu!"
      Speaker = "Zeus"
      Event = "ZeusGift03"
    }
    {
      Id = "MelinoeField_1763"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Paman, tanda penghargaan dariku! Meski aku sudah tahu tentang kemurahan hatimu jauh sebelum kita akhirnya bertemu, aku tak menyangka Paman akan terus meluangkan waktu untukku berkali-kali seperti ini."
      Speaker = "Melinoe"
      Event = "ZeusGift04"
    }
    {
      Id = "Zeus_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakakmu dulu juga sama murah hatinya kepadaku! Aku sering bertanya-tanya siapa yang mengajarinya rasa hormat sebesar itu. Si tua {#Emph}Hades {#Prev}jelas bukan orangnya, {#Emph}itu {#Prev}pasti!"
      Speaker = "Zeus"
      Event = "ZeusGift04"
    }
    {
      Id = "MelinoeField_3672"
      InheritFrom = "BaseNarrative"
      DisplayName = "Atas segala kepemimpinanmu yang kokoh, kurebahkan persembahan ini ke hadapanmu, Paduka Paman Zeus. Setelah semua ini berakhir, semoga Paman dan Ratu Hera bertakhta dalam damai dan kemakmuran abadi."
      Speaker = "Melinoe"
      Event = "ZeusGift05"
    }
    {
      Id = "Zeus_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rasa hormat kepada orang tua tidak datang dengan sendirinya, aku sangat tahu soal itu. Ketahuilah bahwa aku tak pernah menganggap remeh ketulusan semacam ini, dan aku sangat menghargainya. Jiwamu sungguh dermawan!"
      Speaker = "Zeus"
      Event = "ZeusGift05"
    }
    {
      Id = "MelinoeField_3673"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paman memiliki keluarga yang luar biasa untuk dilindungi, Paduka Paman Zeus, belum lagi langit dan bumi. Namun Paman selalu bersikap bermartabat dan gagah berani, terlepas dari beratnya beban yang dipikul! Terima kasih karena tak pernah goyah."
      Speaker = "Melinoe"
      Event = "ZeusGift06"
    }
    {
      Id = "Zeus_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya banyak putra dan putri; keponakan pun jauh lebih banyak lagi. Dan sebuah kehormatan bisa mengenal mereka satu per satu. Aku selalu berusaha tak pilih kasih, tapi... bicara rahasia antara kita berdua saja, Nona muda? Kau pengecualiannya."
      Speaker = "Zeus"
      Event = "ZeusGift06"
    }
    {
      Id = "MelinoeField_3825"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebuah bingkisan demi merayakan kemenangan kita, Paduka Paman! Kita takkan pernah bisa meraih ini jika bukan karena kepemimpinan, keyakinanmu yang tak tergoyahkan, dan petir-petirmu! Semoga Ambrosia ini bisa mempererat hubungan kita di masa damai."
      Speaker = "Melinoe"
      Event = "ZeusGift07"
    }
    {
      Id = "Zeus_0314"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ambrosia seperti ini seharusnya mengalir melimpah lagi di Olympus, dan kuyakin sebentar lagi pasti akan terwujud. Demi menuju hari itu, kontribusimu jauh lebih besar daripada sekadar sebotol minuman ini, Keponakanku. Aku dan kita semua sangat berterima kasih melebihi kata-kata."
      Speaker = "Zeus"
      Event = "ZeusGift07"
    }
    {
      Id = "Melinoe_1739"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Paman sungguh bermurah hati, Paduka Paman."
      Speaker = "Melinoe"
      Event = "ZeusUpgrade.GiftGivenVoiceLines"
    }
    {
      Id = "Chronos_1278"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ini {#Prev}pasti akan sangat {#Emph}mengejutkan!"
      Speaker = "Chronos"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1279"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Badai {#Prev}akan segera datang!"
      Speaker = "Chronos"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1280"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Lihatlah, aku ini anak manja!"
      Speaker = "Chronos"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Halo, akulah Paman Zeus-mu!"
      Speaker = "Chronos"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zeus_0349"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana kalau sedikit sengatan ekstra?"
      Speaker = "Zeus"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zeus_0350"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa yang berani melawan keponakanku?"
      Speaker = "Zeus"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zeus_0351"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kilat petirku milikmu!"
      Speaker = "Zeus"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zeus_0246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja!"
      Speaker = "Zeus"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zeus_0248"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Enyahlah dari gunung ini!"
      Speaker = "Zeus"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zeus_0251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluar kalian semua!"
      Speaker = "Zeus"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zeus_0352"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lancang sekali kau, Nona muda!"
      Speaker = "Zeus"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zeus_0353"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pikir aku ini siapa?"
      Speaker = "Zeus"
      Event = "ZeusUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zeus_0354"
      InheritFrom = "BaseSubtitle"
