      Event = "ZeusUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Zeus_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menentangku secara terang-terangan berarti memaksaku untuk menjadikanmu sebagai peringatan."
      Speaker = "Zeus"
      Event = "ZeusUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Zeus_0270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saat kita bertemu lagi nanti, aku akan melupakan penghinaan ini; tapi {#Emph}kau{#Prev} jangan sampai lupa."
      Speaker = "Zeus"
      Event = "ZeusUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Zeus_0121"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tindakanmu barusan sungguh tidak bijak."
