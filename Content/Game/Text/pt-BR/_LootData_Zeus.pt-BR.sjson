    }
    {
      Id = "Zeus_0267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akulah kepala keluarga ini, dan aku menuntut tingkat kepatuhan tertentu."
      Speaker = "Zeus"
      Event = "ZeusUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Zeus_0268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siapa pun yang berani menentang{#Emph}ku{#Prev} biasanya bernasib jauh lebih buruk daripada dirimu barusan."
