{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _RoomDataQ.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "MelinoeField_2927"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Badai... ini...!"
      Speaker = "Melinoe"
      Event = "Q_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fiuh... {#Prev}aku kembali."
      Speaker = "Melinoe"
      Event = "Q_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_5724"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, Kakek... mari kita uji teorimu..."
      Speaker = "Melinoe"
      Event = "Q_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2928"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang terjadi di sini..."
      Speaker = "Melinoe"
      Event = "Q_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2929"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Puncak tertinggi gunung ini..."
      Speaker = "Melinoe"
      Event = "Q_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fiuh... {#Prev}badai milik Typhon..."
      Speaker = "Melinoe"
      Event = "Q_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_4200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fiuh... {#Prev}kemungkinan yang lain..."
      Speaker = "Melinoe"
      Event = "Q_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2930"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, Typhon..."
      Speaker = "Melinoe"
      Event = "Q_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2931"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Typhon sudah menunggu..."
      Speaker = "Melinoe"
      Event = "Q_Intro.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sepintas, badai yang kini menelan puncak Olympus mungkin tampak seperti ciptaan para dewa demi pertahanan diri; namun keganasannya menyembunyikan hakikat yang jauh lebih keji."
      Speaker = "Storyteller"
      Event = "Inspect_Q_Intro_01"
    }
    {
      Id = "MelinoeField_3251"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo cari sumbernya."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Intro_01"
    }
    {
      Id = "MelinoeField_3252"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Typhon."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Intro_01"
    }
    {
      Id = "Storyteller_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Benteng Para Dewa berguncang hebat menghadapi amarah tiada tara dari Typhon, Bapa Segala Monster, Raksasa Badai, yang entah bagaimana mengintai di suatu tempat yang sangat dekat..."
      Speaker = "Storyteller"
      Event = "Inspect_Q_Intro_02"
    }
    {
      Id = "MelinoeField_3253"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita yang akan menemukan {#Emph}dia{#Prev}, atau sebaliknya..."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Intro_02"
    }
    {
      Id = "Storyteller_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Typhon sang pembawa kiamat, penguasa dan bapa segala monster, pernah ditumbangkan oleh para dewa di masa lampau; dan atas kekalahan pahit purba itu, kini ia menuntut tebusan yang amat mengerikan."
      Speaker = "Storyteller"
      Event = "Inspect_Q_Intro_03"
    }
    {
      Id = "MelinoeField_3254"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia akan segera ditumbangkan para dewa lagi."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Intro_03"
    }
    {
      Id = "Storyteller_0521"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Badai Typhon, yang tak lagi merundung Olympus, sekali lagi menelan sang Putri Orang Mati... karena ada kemungkinan-kemungkinan di mana Bapa Segala Monster masih hidup."
      Speaker = "Storyteller"
      Event = "Inspect_Q_Intro_04"
    }
    {
      Id = "MelinoeField_5024"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, tak akan lama lagi."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Intro_04"
    }
    {
      Id = "Storyteller_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sedikit pasokan langka yang diantarkan Hermes dengan mempertaruhkan nyawa adalah satu-satunya bantuan yang akhirnya bisa diberikan para dewa kepada sang Putri Orang Mati, kini setelah puncak Olympus terbentang di hadapannya."
      Speaker = "Storyteller"
      Event = "Inspect_Q_PreBoss01_01"
    }
    {
      Id = "MelinoeField_3255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kumanfaatkan apa pun yang bisa kudapat..."
      Speaker = "Melinoe"
      Event = "Inspect_Q_PreBoss01_01"
    }
    {
      Id = "Storyteller_0360"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kengerian tanpa akhir yang dimuntahkan Typhon beraneka ragam bentuk dan ukurannya, termasuk monster-monster yang lebih bengis dan bertubuh lebih besar yang baru saja binasa di tangan amarah sang Putri Dunia Bawah."
      Speaker = "Storyteller"
      Event = "Inspect_Q_MiniBoss02_01"
    }
    {
      Id = "MelinoeField_3262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kubantai mereka semua."
      Speaker = "Melinoe"
      Event = "Inspect_Q_MiniBoss02_01"
    }
    {
      Id = "MelinoeField_2956"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wabah monster lagi..."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss03.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3231"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku sedang diawasi..."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss03.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3232"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Ada sesuatu di sini..."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss03.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku tahu tempat ini..."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss03.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3234"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Saatnya menghadapi sang Ekor..."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss03.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Ruang Ekor..."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss03.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Salah satu ekor serupa ular milik Typhon, penguasa dan bapa segala monster, menerobos dan merobek lantai demi lantai benteng tempat para dewa Olympus berlindung dari badainya."
      Speaker = "Storyteller"
      Event = "Inspect_Q_MiniBoss03_01"
    }
    {
      Id = "MelinoeField_3256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia akan menghancurkan benteng ini berkeping-keping..."
      Speaker = "Melinoe"
      Event = "Inspect_Q_MiniBoss03_01"
    }
    {
      Id = "MelinoeField_3257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku adalah hal terakhir yang akan dia lihat."
      Speaker = "Melinoe"
      Event = "Inspect_Q_MiniBoss03_01"
    }
    {
      Id = "MelinoeField_5686"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Indah sekali matamu itu, Typhon..."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss04.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3685"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, apa-apaan {#Emph}ini..."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss04.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3686"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan begitu cara kerja mata!"
      Speaker = "Melinoe"
      Event = "Q_MiniBoss04.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3687"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat baik-baik, Typhon."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss04.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3688"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat ini, Monster."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss04.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3690"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rupanya ada yang sedang mengawasiku."
      Speaker = "Melinoe"
      Event = "Q_MiniBoss04.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mau kehilangan {#Emph}satu mata lagi{#Prev}?"
      Speaker = "Melinoe"
      Event = "Q_MiniBoss04.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Musuh-musuh Typhon yang mahamelihat mustahil dapat lolos dari dendam kesumatnya, sebab matanya tersebar di sekujur tubuhnya, merah padam oleh amarah, terus mengintai tiada henti, dan menusuk relung jiwa yang terdalam.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_MiniBoss04_01"
    }
    {
      Id = "Storyteller_0361"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Keturunan keji Typhon sang pembawa badai merayap melalui retakan-retakan dinding batu Benteng Para Dewa yang kian melebar, seakan hendak mengguncang gunung itu hingga ke dasarnya.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_MiniBoss05_01"
    }
    {
      Id = "MelinoeField_3263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya perhatikan langkahku."
      Speaker = "Melinoe"
      Event = "Inspect_Q_MiniBoss05_01"
    }
    {
      Id = "MelinoeField_5010"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, Zagreus... Gigaros..."
      Speaker = "Melinoe"
      Event = "Q_Boss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_3453"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cukup sudah tempat ini..."
      Speaker = "Melinoe"
      Event = "Q_Boss01.ExitVoiceLines"
    }
    {
      Id = "Storyteller_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Akhirnya, badai mengerikan yang mencabik-cabik Benteng Para Dewa mulai mereda, barangkali karena biang keladi monster itu telah lenyap entah ke mana.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_Boss01_01"
    }
    {
      Id = "MelinoeField_3258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya untuk saat ini..."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Boss01_01"
    }
    {
      Id = "Storyteller_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ancaman mengerikan dari Typhon, yang dilemparkan oleh sang Putri Dunia Bawah dalam raungan kembali ke Bumi tempat ia terlahir dalam amarah, kini mereda; namun hanya untuk malam ini.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_Boss01_02"
    }
    {
      Id = "MelinoeField_3259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluarga kami bisa beristirahat sejenak."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Boss01_02"
    }
    {
      Id = "Storyteller_0522"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sekali lagi, tiada jejak tersisa dari monster paling mengerikan di dunia kita. Dan kemungkinan bahwa ia bisa mendatangkan malapetaka lebih lanjut di puncak gunung ini pun kian sirna.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_Boss01_03"
    }
    {
      Id = "MelinoeField_5025"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita tak boleh lengah barang sedetik pun."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Boss01_03"
    }
    {
      Id = "MelinoeField_5381"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Istananya tertutup rapat. Ayo pulang."
      Speaker = "Melinoe"
      Event = "ObstacleData[779914].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_5382"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Urusan kita selesai di sini... ayo pulang."
      Speaker = "Melinoe"
      Event = "ObstacleData[779914].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0426"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bahkan sang Waktu sendiri tak mampu menghentikan Putri pemberani ini dari menumpas monster purba yang begitu gigih menyerang gunung para dewa malam demi malam tanpa henti.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_Boss02_01"
    }
    {
      Id = "MelinoeField_3619"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sudah paham trik mereka."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Boss02_01"
    }
    {
      Id = "Storyteller_0461"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Meski bersatu dalam amarah yang pekat, sang ayah para dewa dan Sang Ayah Segala Monster tetap saja tak mampu menguasai gunung suci ini ataupun meratakannya dengan tanah.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_Boss02_02"
    }
    {
      Id = "MelinoeField_3659"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan akan kami pastikan tetap seperti itu."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Boss02_02"
    }
    {
      Id = "MelinoeField_3456"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gerbang aether...?"
      Speaker = "Melinoe"
      Event = "ObstacleData[792642].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0415"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hanya segelintir yang pernah melihat kemegahan Istana Raja para Dewa Olimpus, sebab hanya mereka yang dianggap layak yang boleh masuk, atau bahkan sekadar menemukannya di antara puncak-puncak gunung.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_PostBoss_01"
    }
    {
      Id = "MelinoeField_3608"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, ini dia..."
      Speaker = "Melinoe"
      Event = "Inspect_Q_PostBoss_01"
    }
    {
      Id = "Storyteller_0418"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di hadapannya terbentang Istana Raja dan Ratu seluruh dewa yang tersembunyi dan terjaga ketat, benteng pertahanan tempat Olimpus membalas serangan dari begitu banyak musuh mengerikan.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_PostBoss_02"
    }
    {
      Id = "MelinoeField_3611"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bertahanlah..."
      Speaker = "Melinoe"
      Event = "Inspect_Q_PostBoss_02"
    }
    {
      Id = "MelinoeField_4245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengan tewasnya Typhon, berkurang satu ancaman."
      Speaker = "Melinoe"
      Event = "Inspect_Q_PostBoss_02"
    }
    {
      Id = "MelinoeField_5011"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Badai ini pasti berlalu..."
      Speaker = "Melinoe"
      Event = "Q_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3454"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hampir... sampai..."
      Speaker = "Melinoe"
      Event = "Q_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3455"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jalan menuju Istana..."
      Speaker = "Melinoe"
      Event = "Q_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0416"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Istana Zeus yang megah berdiri kokoh dan tangguh, sebab gabungan kekuatan para dewa berhasil menjaga takhta kekuasaan itu tetap aman, bahkan dari musuh-musuh seseram yang mereka hadapi.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_Story_01"
    }
    {
      Id = "MelinoeField_3609"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini pasti baru pelataran istananya..."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Story_01"
    }
    {
      Id = "Storyteller_0417"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Alunan musik yang menenangkan gubahan Apollo yang piawai bergema ke seantero pelataran istana, menembus pekatnya suasana bagaikan sebilah anak panah cahaya murni.{#Prev}"
      Speaker = "Storyteller"
      Event = "Inspect_Q_Story_02"
    }
    {
      Id = "MelinoeField_3610"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Boleh juga permainannya..."
      Speaker = "Melinoe"
      Event = "Inspect_Q_Story_02"
    }
    {
      Id = "MelinoeField_3468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah itu...?"
      Speaker = "Melinoe"
      Event = "Q_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Musik..."
      Speaker = "Melinoe"
      Event = "Q_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3470"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Raja dan Ratu..."
      Speaker = "Melinoe"
      Event = "Q_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka ada di sini..."
      Speaker = "Melinoe"
      Event = "Q_Story01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_3834"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tidak terbiasa berada di sisi sini! Kulihat... Erebus, sepertinya. Tunggu, Kepala Sekolah, itukah {#Emph}Anda? {#Prev}Bisa dengar suaraku?"
      Speaker = "Melinoe"
      Event = "PalaceBoonExit01"
    }
    {
      Id = "HecateField_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Atas nama Hades. Olimpus, kuterima pesan ini! {#Prev}...Melinoë? Jika kau bisa mendengarku dari seberang sana, kuminta kau segera kembali. Ada hal yang harus kita bicarakan."
      Speaker = "Hecate"
      Event = "PalaceBoonExit01"
    }
    {
      Id = "MelinoeField_3835"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku harus pergi sekarang, semuanya. Tolong jaga diri baik-baik, dan sampaikan permohonan maafku pada yang lain karena melewatkan mereka. Aku pasti kembali!"
      Speaker = "Melinoe"
      Event = "PalaceBoonExit01"
    }
    {
      Id = "MelinoeField_3926"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sekarang giliran Chronos. Aku mengandalkan berkat kalian semua!"
      Speaker = "Melinoe"
      Event = "PalaceBoonExitTyphonDestroyed01"
    }
    {
      Id = "MelinoeField_5022"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Sepertinya aku belum bisa berkunjung lagi dalam waktu dekat, jadi... terima kasih semuanya, dan tolong sampaikan salam hangatku pada yang lain. Mari tetap saling berkabar lewat Berkah!"
      Speaker = "Melinoe"
      Event = "PalaceBoonExitPostTrueEnding01"
    }
    {
      Id = "MelinoeField_3927"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Senang sekali bisa melihat kalian semua! Sampai jumpa untuk sekarang!"
      Speaker = "Melinoe"
      Event = "PalaceBoonExit02"
    }
    {
      Id = "MelinoeField_3923"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Selamat tinggal untuk sekarang, semuanya! Semoga kalian tetap aman dan sehat saat kita bersua lagi nanti."
      Speaker = "Melinoe"
      Event = "PalaceBoonExitRepeatable01"
    }
    {
      Id = "MelinoeField_3925"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kita semakin dekat, semuanya. Tolong tetap berhati-hati!"
      Speaker = "Melinoe"
      Event = "PalaceBoonExitRepeatable02"
    }
    {
      Id = "MelinoeField_3924"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Jika Typhon bangkit kembali, aku pasti akan kembali!"
      Speaker = "Melinoe"
      Event = "PalaceBoonExitRepeatable03"
    }
  ]
}
