    }
    {
      Id = "Chronos_0731"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Maaf? {#Prev}Waktu tidak berhenti atas kehendakmu, waktu hanya berhenti atas kehendakku! {#Emph}Oh{#Prev}, tapi silakan saja, selesaikan urusan mendesak apa pun yang membuatmu harus menunda pertarungan kita, dasar kau {#Emph}pemalas."
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0732"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Waktu {#Prev}bisa dihentikan oleh{#Emph}ku{#Prev}, bukan oleh{#Emph}mu."
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0733"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aku {#Prev}yang memegang kendali, bukan {#Emph}kamu. {#Prev}Tapi {#Emph}ya sudahlah."
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0734"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Anehnya aku merasa berkewajiban untuk menurut..."
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0735"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan berbaik hati untuk urusan yang satu ini."
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0736"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Silakan saja, ambil seluruh {#Emph}Waktu {#Prev}yang kau butuhkan!"
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0737"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ingatlah bahwa {#Emph}Waktu {#Prev}tidak berhenti semata-mata untukmu."
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0738"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kuizinkan kali ini, tapi di lain malam, belum tentu..."
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0739"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin kau butuh sedikit ruang untuk bernapas?"
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0740"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah konfrontasi kita ini belum cukup mendesak bagimu?"
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0741"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan menunggu {#Emph}kepulanganmu yang selamat."
      Speaker = "Chronos"
      Event = "PauseMenuTakeOverAllowPause.VoiceLines"
    }
    {
      Id = "Chronos_0742"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau butuh sedikit {#Emph}Waktu? {#Prev}Tentu saja."
      Speaker = "Chronos"
