    }
    {
      Id = "Charon_0116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hrrmmm...{#Prev}"
      Speaker = "Charon"
      Event = "NPC_Charon_01.InteractVoiceLines"
    }
    {
      Id = "Charon_0117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hrreehh...{#Prev}"
      Speaker = "Charon"
      Event = "NPC_Charon_01.InteractVoiceLines"
    }
    {
      Id = "Charon_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mmnnnggghhhhhh...{#Prev}"
      Speaker = "Charon"
      Event = "CharonWithHecate01"
    }
    {
      Id = "Hecate_0641"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kiriman pasokan ini akan sangat berharga bagi kita. Kami selamanya berutang budi padamu, Charon. Semoga Hermes yang lincah mempercepat pelayaranmu melintasi alam-alam ini, di mana pun ia berada. Dan sampai kita berjumpa lagi, semoga bayang-bayang menyembunyikanmu."
      Speaker = "Hecate"
      Event = "CharonWithHecate01"
    }
    {
      Id = "Melinoe_2918"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih atas pasokannya, Tuanku...!"
      Speaker = "Melinoe"
      Event = "CharonWithHecate01"
    }
    {
      Id = "Charon_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrraauuggh, naaaauugggghh...{#Prev}"
      Speaker = "Charon"
      Event = "CharonFirstMeeting"
    }
    {
      Id = "MelinoeField_1581"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hamba berutang budi padamu, Tuan Charon. Perbekalan ini pasti akan membuat perbedaan besar dalam tugasku. Emas apa pun yang kutemukan adalah milikmu."
      Speaker = "Melinoe"
      Event = "CharonFirstMeeting"
    }
    {
      Id = "Melinoe_1197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua Emas tercemar ini... engkau akan memastikan benda itu disingkirkan dengan benar, kan, Tuan Charon?"
      Speaker = "Melinoe"
      Event = "CharonAboutGold01"
    }
    {
      Id = "Charon_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kkkkhhhrrrssssshhh...{#Prev}"
      Speaker = "Charon"
      Event = "CharonAboutGold01"
    }
    {
      Id = "Melinoe_1198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hamba mendambakan malam itu tiba."
      Speaker = "Melinoe"
      Event = "CharonAboutGold01"
    }
    {
      Id = "Charon_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sssshhhhhhh...{#Prev}"
      Speaker = "Charon"
      Event = "CharonAboutGold02"
    }
    {
      Id = "Melinoe_1196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu, Tuan Charon. Engkau akan mendapatkan semua Emas yang hamba temukan, karena hamba butuh pasokan apa pun yang bisa engkau luangkan."
      Speaker = "Melinoe"
      Event = "CharonAboutGold02"
    }
    {
      Id = "MelinoeField_4512"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat kita bertemu lagi di Tartarus nanti, bolehkah hamba memberikan sisa Emas yang kumiliki setelah berbelanja? Anggap saja sebagai uang persenan atas jasamu. Kalau tidak, semuanya akan lenyap begitu saja..."
      Speaker = "Melinoe"
      Event = "CharonAboutTipping01"
    }
    {
      Id = "Charon_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nnngggghhh, mmmm...{#Prev}"
      Speaker = "Charon"
      Event = "CharonAboutTipping01"
    }
    {
      Id = "MelinoeField_4513"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada barang, tak ada Emas. Mengerti."
      Speaker = "Melinoe"
      Event = "CharonAboutTipping01"
    }
    {
      Id = "Charon_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Haaaa{#Prev}, hrrrnnnnggghhh..."
      Speaker = "Charon"
      Event = "CharonAboutSmuggling01"
    }
    {
      Id = "Melinoe_1199"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah! {#Prev}Kita lihat saja seberapa besar Chronos masih mencintai Emasnya setelah semua ini. Hal bagus tentang para pengkhianat adalah kesetiaan mereka bisa dibeli..."
      Speaker = "Melinoe"
      Event = "CharonAboutSmuggling01"
    }
    {
      Id = "Charon_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrnnnaaauuggghh...{#Prev}"
      Speaker = "Charon"
      Event = "CharonGrantsMailbox01"
    }
    {
      Id = "MelinoeField_0733"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penawaran khusus, Tuanku? Hamba sudah mengembalikan Emas sebanyak mungkin, tetapi hamba sangat paham tidaklah mudah bagimu untuk mengadakan barang-barang yang kau sediakan ini."
      Speaker = "Melinoe"
      Event = "CharonGrantsMailbox01"
    }
    {
      Id = "Melinoe_0842_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, terima kasih banyak...!"
      Speaker = "Melinoe"
      Event = "CharonGrantsMailbox01"
    }
    {
      Id = "Charon_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Rrnnngghh, huuaaahhh...{#Prev}"
      Speaker = "Charon"
      Event = "CharonAboutCharonPoints01"
    }
    {
      Id = "MelinoeField_4505"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sesuatu tentang Imbalan Emas milikmu... yang membuatku mencapai status Perak sekarang? Oh, terima kasih banyak, Tuanku! Hamba bangga menjadi pelanggan setiamu."
      Speaker = "Melinoe"
      Event = "CharonAboutCharonPoints01"
    }
    {
      Id = "Charon_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mmmm, {#Emph}hrrrrmmmm{#Prev}..."
      Speaker = "Charon"
      Event = "CharonAboutSpeaking01"
    }
    {
      Id = "Melinoe_1200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali kita punya begitu sedikit waktu untuk berbincang, Tuan Charon. Meski begitu hamba bersyukur bisa lebih sering berjumpa denganmu akhir-akhir ini."
      Speaker = "Melinoe"
      Event = "CharonAboutSpeaking01"
    }
    {
      Id = "MelinoeField_4515"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertemuan kita sudah punya ritmenya sendiri, ya? Namun, apakah ada hal lain yang bisa hamba bantu, Tuanku? Selain menyetorkan semua Emas dan sesekali mengobrol."
      Speaker = "Melinoe"
      Event = "CharonAboutSayingLittle01"
    }
    {
      Id = "Charon_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Grrrrnnhhhhnnn..."
      Speaker = "Charon"
      Event = "CharonAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_4516"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedengarannya seperti tidak..."
      Speaker = "Melinoe"
      Event = "CharonAboutSayingLittle01"
    }
    {
      Id = "Charon_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hrrrnn, {#Emph}nrraauugggghhhhrrrrhhhh..."
      Speaker = "Charon"
      Event = "CharonAboutDanger01"
    }
    {
      Id = "Melinoe_1201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti, Tuanku. Sampai saat itu tiba, kita masing-masing punya tugas yang harus diselesaikan."
      Speaker = "Melinoe"
      Event = "CharonAboutDanger01"
    }
    {
      Id = "MelinoeField_1584"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku membawa hadiah yang dengan murah hati Kauberikan kepadaku. Sebuah Kenang-kenangan pembawa keberuntungan di malam-malam seperti ini. Keadaan mulai membaik!"
      Speaker = "Melinoe"
      Event = "CharonAboutKeepsake01"
    }
    {
      Id = "Charon_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Rraaauuggggghhhh..."
      Speaker = "Charon"
      Event = "CharonAboutKeepsake01"
    }
    {
      Id = "MelinoeField_1585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, tak ada salahnya mencoba..."
      Speaker = "Melinoe"
      Event = "CharonAboutKeepsake01"
    }
    {
      Id = "MelinoeField_2837"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kantong Emas yang Kauberikan sebelumnya... tiap malam selalu kupapati penuh koin... yang secara teknis berarti aku berutang budi padamu."
      Speaker = "Melinoe"
      Event = "CharonAboutKeepsake02"
    }
    {
      Id = "Charon_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nnnaauuugghh, hrrnnn..."
      Speaker = "Charon"
      Event = "CharonAboutKeepsake02"
    }
    {
      Id = "MelinoeField_2838"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah katamu saja, Tuanku."
      Speaker = "Melinoe"
      Event = "CharonAboutKeepsake02"
    }
    {
      Id = "Charon_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aauugggh{#Prev}, hhrrrrmm..."
      Speaker = "Charon"
      Event = "CharonAboutHermesKeepsake01"
    }
    {
      Id = "MelinoeField_3372"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kecepatan...? {#Prev}Maksudmu Tetesan Logam yang kubawa ini, Tuanku. Hadiah langsung dari Dewa Hermes! Tak ada cara yang lebih baik untuk segera mencapai barang dagangan terbaikmu."
      Speaker = "Melinoe"
      Event = "CharonAboutHermesKeepsake01"
    }
    {
      Id = "Charon_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hrraahhh..."
      Speaker = "Charon"
      Event = "CharonAboutHermesKeepsake01"
    }
    {
      Id = "Charon_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Rnnggghhh, ggraagghhh...?"
      Speaker = "Charon"
      Event = "CharonAboutWellShops01"
    }
    {
      Id = "MelinoeField_2839"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemunculan kembali Sumur-sumurmu jelas bukan suatu kebetulan, Tuanku. Cuma butuh mantra yang tepat! Sedikit demi sedikit, kita akan memulihkan tatanan lama."
      Speaker = "Melinoe"
      Event = "CharonAboutWellShops01"
    }
    {
      Id = "Charon_0095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hhhaaughh..."
      Speaker = "Charon"
      Event = "CharonAboutWellShops01"
    }
    {
      Id = "MelinoeField_2842"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuil-Kuil Dewa Hermes yang kulihat di sekitar permukaan... Aku perhatikan mereka juga menerima persembahan Emas. Berarti kalian berdua sudah kembali berbisnis, ya?"
      Speaker = "Melinoe"
      Event = "CharonAboutSurfaceShops01"
    }
    {
      Id = "Charon_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hrrrrmmm, {#Emph}nnrrrraaauggghh..."
      Speaker = "Charon"
      Event = "CharonAboutSurfaceShops01"
    }
    {
      Id = "MelinoeField_2843"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, semoga bisnismu lancar."
      Speaker = "Melinoe"
      Event = "CharonAboutSurfaceShops01"
    }
    {
      Id = "MelinoeField_1757"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senjata Nokturnal mempercayakan Aspek-Aspek lain dari diri mereka kepadaku, termasuk yang satu ini yang kurasa milikmu, Tuanku. Apakah Kau... merelakan Kapak Batu Bulan ini karena tahu akulah pewaris berikutnya?"
      Speaker = "Melinoe"
      Event = "CharonAboutCharonAspect01"
    }
    {
      Id = "Charon_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nrrraaauuuggghh, krrrnnhhh..."
      Speaker = "Charon"
      Event = "CharonAboutCharonAspect01"
    }
    {
      Id = "MelinoeField_1758"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kupergunakan sebaik mungkin semampuku."
      Speaker = "Melinoe"
      Event = "CharonAboutCharonAspect01"
    }
    {
      Id = "Charon_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Guuhhhh, raauuugggghh..."
      Speaker = "Charon"
      Event = "CharonAboutThanatosAspect01"
    }
    {
      Id = "MelinoeField_4514"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu sabit ini... Kau mengenalinya sebagai milik saudaramu, ya, Tuanku. Yah, aku mungkin bukan Sang Kematian itu sendiri, tapi aku akan mengayunkan bilahnya semahir mungkin demi menghormatinya."
      Speaker = "Melinoe"
      Event = "CharonAboutThanatosAspect01"
    }
    {
      Id = "Charon_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mmmm..."
      Speaker = "Charon"
      Event = "CharonAboutThanatosAspect01"
    }
    {
      Id = "Charon_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrnnnaauggghh, haaauuggh..."
      Speaker = "Charon"
      Event = "CharonAboutShrine01"
    }
    {
      Id = "MelinoeField_1589"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, Tuanku; aku sudah mengucapkan Sumpah itu, jika itu yang Kaumaksud. Maka dalam bayang-bayang aku mengabdi; dan ke bayang-bayang pula aku kembali, sebelum terbitnya fajar."
      Speaker = "Melinoe"
      Event = "CharonAboutShrine01"
    }
    {
      Id = "Charon_0082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hrrnnngghh..."
      Speaker = "Charon"
      Event = "CharonAboutShrine01"
    }
    {
      Id = "Charon_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hooaaaaahhh, hrrmm..."
      Speaker = "Charon"
      Event = "CharonAboutShrine02"
    }
    {
      Id = "MelinoeField_3373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa Kau bisa merasakan Wasiat Malam, Tuanku. Agar pengaruh ibumu, Nyx, takkan pernah pudar, baik di Dunia Bawah maupun di luarnya."
      Speaker = "Melinoe"
      Event = "CharonAboutShrine02"
    }
    {
      Id = "Charon_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nrrrhhh..."
      Speaker = "Charon"
      Event = "CharonAboutShrine02"
    }
    {
      Id = "Charon_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Krraaahhhh, hhrrrnn..."
      Speaker = "Charon"
      Event = "CharonAboutPackagedBounties01"
    }
    {
      Id = "MelinoeField_3374"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau merasakannya juga, kan? Hawa aneh di udara... pengaruh Khaos di sekeliling kita. Aku bahkan sedang diuji saat ini. Mungkin kita semua juga..."
      Speaker = "Melinoe"
      Event = "CharonAboutPackagedBounties01"
    }
    {
      Id = "Charon_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mmmmmnn..."
      Speaker = "Charon"
      Event = "CharonAboutPackagedBounties01"
    }
    {
      Id = "Melinoe_1202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berlayar jauh sekali dari jalur biasamu, Tukang Perahu. Bukan semata-mata demi kepentinganku saja, kan?"
      Speaker = "Melinoe"
      Event = "CharonAboutTravel01"
    }
    {
      Id = "Charon_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ssshhh, {#Emph}hrrrraaauuuggghhh..."
      Speaker = "Charon"
      Event = "CharonAboutTravel01"
    }
    {
      Id = "Melinoe_2274"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bantuan murah hatimu sangat kuhargai, Yang Mulia."
      Speaker = "Melinoe"
      Event = "CharonAboutTravel01"
    }
    {
      Id = "Melinoe_1205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau datang untuk membantuku bahkan sampai ke sini, Tuan Charon? Meski kurasa kau pun tak bisa berlayar lebih jauh lagi, ke tempat tujuanku..."
      Speaker = "Melinoe"
      Event = "CharonAboutSurface01"
    }
    {
      Id = "Charon_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nnnn, {#Emph}nnrrrggghhhhh..."
      Speaker = "Charon"
      Event = "CharonAboutSurface01"
    }
    {
      Id = "Melinoe_1206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kebaikanmu takkan pernah kulupakan."
      Speaker = "Melinoe"
      Event = "CharonAboutSurface01"
    }
    {
      Id = "MelinoeField_2840"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil mencapai puncak gunung para dewa, Tuan! Tapi aku merindukan kehadiranmu di sana. Tak pernah kusangka akan melihat tempat yang tak bisa kau capai dengan perahu."
      Speaker = "Melinoe"
      Event = "CharonAboutOlympus01"
    }
    {
      Id = "Charon_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Grrnnnggghh{#Prev}, hrreehhhh..."
      Speaker = "Charon"
      Event = "CharonAboutOlympus01"
    }
    {
      Id = "MelinoeField_2841"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Distributormu rupanya andal sekali."
      Speaker = "Melinoe"
      Event = "CharonAboutOlympus01"
    }
    {
      Id = "MelinoeField_1926"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan, inikah kapalmu? Mengagumkan sekali, walau aku cemas dengan banyaknya kapal musuh di mana-mana, kapalnya bisa rusak... atau bahkan membahayakanmu."
      Speaker = "Melinoe"
      Event = "CharonAboutThessaly01"
    }
    {
      Id = "Charon_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Grrnn, neehhhhhhhh..."
      Speaker = "Charon"
      Event = "CharonAboutThessaly01"
    }
    {
      Id = "MelinoeField_1927"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga pelayaranmu tetap tenang tanpa rintangan."
      Speaker = "Melinoe"
      Event = "CharonAboutThessaly01"
    }
    {
      Id = "Melinoe_1300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti menjengkelkan sekali, Tuan Charon. Melihat arwah-arwah Erebus terkatung-katung di sini tanpa tujuan. Tapi kau pasti akan mengantarkan mereka pada waktunya."
      Speaker = "Melinoe"
      Event = "CharonAboutErebus01"
    }
    {
      Id = "Charon_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Grrnngghh, {#Emph}hrraaauuuggghh...!"
      Speaker = "Charon"
      Event = "CharonAboutErebus01"
    }
    {
      Id = "Melinoe_0055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai saat itu tiba."
      Speaker = "Melinoe"
      Event = "CharonAboutErebus01"
    }
    {
      Id = "Melinoe_3257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil mencapai Graha Hades mendahuluiku, Tuan. Tak heran jalur terakhir tadi begitu lengang. Kau pasti sudah tahu aku gagal menang. Kita hanya perlu mencobanya sekali lagi, bukan...?"
      Speaker = "Melinoe"
      Event = "CharonAboutTartarus01"
    }
    {
      Id = "Charon_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrrnn, haaaaahhhh..."
      Speaker = "Charon"
      Event = "CharonAboutTartarus01"
    }
    {
      Id = "Melinoe_3258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih atas segala dukunganmu."
      Speaker = "Melinoe"
      Event = "CharonAboutTartarus01"
    }
    {
      Id = "Melinoe_3259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya kita berhasil menumbangkannya, Tuan Charon! Sang Titan ternyata bisa dibunuh... setidaknya untuk mengacaukan rencananya sejenak, sampai kita bisa melenyapkannya untuk selamanya."
      Speaker = "Melinoe"
      Event = "CharonAboutChronosBossW01"
    }
    {
      Id = "Charon_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nrrghhh, hrrrnnn..."
      Speaker = "Charon"
      Event = "CharonAboutChronosBossW01"
    }
    {
      Id = "Melinoe_3260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar. Takhta ayahku pasti akan dipulihkan."
      Speaker = "Melinoe"
      Event = "CharonAboutChronosBossW01"
    }
    {
      Id = "Melinoe_4240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku akhirnya sampai di puncak Olimpus... mereka sedang bertarung melawan Typhon sendiri! Mungkin kau sudah mengetahuinya..."
      Speaker = "Melinoe"
      Event = "CharonAboutTyphon01"
    }
    {
      Id = "Charon_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hreeeehh, hrrmmm..."
      Speaker = "Charon"
      Event = "CharonAboutTyphon01"
    }
    {
      Id = "Melinoe_4241"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia luar biasa raksasa, ya."
      Speaker = "Melinoe"
      Event = "CharonAboutTyphon01"
    }
    {
      Id = "Charon_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hraaaauugghhh, haaaahhh...!"
      Speaker = "Charon"
      Event = "CharonAboutTyphon02"
    }
    {
      Id = "Melinoe_4242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami berhasil menundukkan Typhon, setidaknya untuk malam ini, Tuan! Hermes memastikan perbekalanku sangat cukup. Banyak sekali Emas untukmu belakangan ini!"
      Speaker = "Melinoe"
      Event = "CharonAboutTyphon02"
    }
    {
      Id = "Charon_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Graauuggghh..."
      Speaker = "Charon"
      Event = "CharonAboutTyphon02"
    }
    {
      Id = "Charon_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ssshhhaaaahhh...?"
      Speaker = "Charon"
      Event = "CharonAboutSelene01"
    }
    {
      Id = "Melinoe_2009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang bertemu dengannya, Tuan. Dan aku bersyukur pada Takdir karena cahaya Selene bisa tembus ke Erebus, sebab aku tahu pancarannya takkan sampai lebih jauh melewati perbatasan alam ini."
      Speaker = "Melinoe"
      Event = "CharonAboutSelene01"
    }
    {
      Id = "Charon_0055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mrrrrnnnnggghhh..."
      Speaker = "Charon"
      Event = "CharonAboutSelene01"
    }
    {
      Id = "Melinoe_2010"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan terima kasih juga untukmu."
      Speaker = "Melinoe"
      Event = "CharonAboutSelene01"
    }
    {
      Id = "Melinoe_1814"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bertemu salah satu saudaramu, Tuan Charon. Moros. Dia menyerahkan sebuah artefak padaku, lalu menghilang begitu saja. Apa kau tahu soal {#Emph}Daftar Suratan Takdir{#Prev}?"
      Speaker = "Melinoe"
      Event = "CharonAboutMoros01"
    }
    {
      Id = "Charon_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hhhhhoooohhhhh..."
      Speaker = "Charon"
      Event = "CharonAboutMoros01"
    }
    {
      Id = "Melinoe_1815"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benda itu pernah dirawat oleh keluargaku sebelumnya...? Namun, bagaimana dengan Moros? Ke mana kiranya dia pergi di tengah semua kekacauan ini?"
      Speaker = "Melinoe"
      Event = "CharonAboutMoros01"
    }
    {
      Id = "Charon_0047"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nnnggghhhh..."
      Speaker = "Charon"
      Event = "CharonAboutMoros01"
    }
    {
      Id = "Melinoe_1816"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin aku bisa melacak keberadaannya lagi nanti."
      Speaker = "Melinoe"
      Event = "CharonAboutMoros01"
    }
    {
      Id = "Melinoe_2007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Charon, Moros sudah kembali! Dia bergabung dengan kita di Persimpangan. Sekarang setidaknya ada {#Emph}tiga {#Prev}putra perkasa Nyx di pihak kita. Meski harus kuakui, yang satunya tidur melulu..."
      Speaker = "Melinoe"
      Event = "CharonAboutMoros02"
    }
    {
      Id = "Charon_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Huunnnnnggghhhh..."
      Speaker = "Charon"
      Event = "CharonAboutMoros02"
    }
    {
      Id = "Melinoe_2008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan aku, sepertinya aku salah paham. Hypnos justru lebih berguna kalau tidur begini...?"
      Speaker = "Melinoe"
      Event = "CharonAboutMoros02"
    }
    {
      Id = "Charon_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hmm, hmm..."
      Speaker = "Charon"
      Event = "CharonAboutMoros02"
    }
    {
      Id = "Charon_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrmmmm, nnnrrraaauggghhh..."
      Speaker = "Charon"
      Event = "CharonAboutOlympians01"
    }
    {
      Id = "Melinoe_3263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, Tuanku, aku sudah bertemu Apollo, Nenek, Paman Poseidon... Aku sudah lama mengenal Artemis dan Hermes, dan aku takjub mereka bisa menjaga rahasiaku dari yang lain selama ini."
      Speaker = "Melinoe"
      Event = "CharonAboutOlympians01"
    }
    {
      Id = "Charon_0088"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Grrrnhhh..."
      Speaker = "Charon"
      Event = "CharonAboutOlympians01"
    }
    {
      Id = "Melinoe_3261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih belum ada tanda-tanda dari Hermes, Tuanku...? Maafkan ketidaksabaranku, aku tahu menyusup ke barisan musuh dan mencari tahu rencana penaklukan Olympus adalah tugas yang sangat berisiko..."
      Speaker = "Melinoe"
      Event = "CharonAboutHermesMission01"
    }
    {
      Id = "Charon_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrmmmnnngggggghhhhh..."
      Speaker = "Charon"
      Event = "CharonAboutHermesMission01"
    }
    {
      Id = "Melinoe_3262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku yakin dia akan segera kembali malam ini atau malam-malam berikutnya."
      Speaker = "Melinoe"
      Event = "CharonAboutHermesMission01"
    }
    {
      Id = "Charon_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrrmmmmmm..."
      Speaker = "Charon"
      Event = "CharonAboutHermes01"
    }
    {
      Id = "Melinoe_1817"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yakin dia baik-baik saja, Tuanku. Ini Hermes yang kita bicarakan! Takkan ada yang bisa menangkapnya, andai dia dalam bahaya sekalipun."
      Speaker = "Melinoe"
      Event = "CharonAboutHermes01"
    }
    {
      Id = "Charon_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nrrgghhh..."
      Speaker = "Charon"
      Event = "CharonAboutHermes01"
    }
    {
      Id = "Melinoe_2011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya aku mendengar kabar dari Hermes, Tuanku! Dia tak menceritakan secara rinci apa yang ditemukannya, tapi mungkin Anda tahu lebih banyak."
      Speaker = "Melinoe"
      Event = "CharonAboutHermes02"
    }
    {
      Id = "Charon_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Auugggghhh..."
      Speaker = "Charon"
      Event = "CharonAboutHermes02"
    }
    {
      Id = "Melinoe_2012"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mengerti. Aku tak bermaksud mencampuri urusan ini."
      Speaker = "Melinoe"
      Event = "CharonAboutHermes02"
    }
    {
      Id = "Melinoe_1203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hermes menitip salam {#Emph}halo {#Prev}untuk Anda, Tuanku. Pesan yang pasti akan dia sampaikan sendiri jika sempat. Tapi tampaknya dia baik-baik saja."
      Speaker = "Melinoe"
      Event = "CharonAboutHermes03"
    }
    {
      Id = "Charon_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hhhrrrrrmmmm..."
      Speaker = "Charon"
      Event = "CharonAboutHermes03"
    }
    {
      Id = "Melinoe_1204"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja, Tuanku."
      Speaker = "Melinoe"
      Event = "CharonAboutHermes03"
    }
    {
      Id = "Melinoe_4243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sempat berpapasan dengan Tuan Hermes di puncak Olympus, sedang bersiap melawan Typhon bersama yang lainnya. Apa Anda sempat bertemu dengannya?"
      Speaker = "Melinoe"
      Event = "CharonAboutHermes04"
    }
    {
      Id = "Charon_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrrmmm, mmrrrrngghhh..."
      Speaker = "Charon"
      Event = "CharonAboutHermes04"
    }
    {
      Id = "Melinoe_4244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi, cuma sebentar saja, ya."
      Speaker = "Melinoe"
      Event = "CharonAboutHermes04"
    }
    {
      Id = "Melinoe_1296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anda tidak terlalu dekat dengan saudara-saudari Anda, ya? Saat Anda kebetulan berkunjung, Nemesis malah hampir sepenuhnya mengabaikan Anda..."
      Speaker = "Melinoe"
      Event = "CharonAboutNemesis01"
    }
    {
      Id = "Charon_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nrrrmmm, {#Emph}hhaaaaahhhh..."
      Speaker = "Charon"
      Event = "CharonAboutNemesis01"
    }
    {
      Id = "Melinoe_1297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu, hanya saja..."
      Speaker = "Melinoe"
      Event = "CharonAboutNemesis01"
    }
    {
      Id = "MelinoeField_1587"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu Anda sempat melihat Nemesis berkeliaran. Harusnya dia berjaga di posnya, tapi... kurasa Anda pasti bisa mengerti. Demi keluarga dan dunia kita, apa pun akan dilakukan, kan?"
      Speaker = "Melinoe"
      Event = "CharonAboutNemesis02"
    }
    {
      Id = "Charon_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Rrrrauuggh, heehhhh..."
      Speaker = "Charon"
      Event = "CharonAboutNemesis02"
    }
    {
      Id = "MelinoeField_1588"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga langkahnya tak terendus siapa pun."
      Speaker = "Melinoe"
      Event = "CharonAboutNemesis02"
    }
    {
      Id = "MelinoeField_3375"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat Anda kedatangan pelanggan lain, Tuanku. Yang datang duluan yang dilayani, ya?"
      Speaker = "Melinoe"
      Event = "CharonAboutNemesisShopping01"
    }
    {
      Id = "Charon_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrrraauugghhh, haaahhh..."
      Speaker = "Charon"
      Event = "CharonAboutNemesisShopping01"
    }
    {
      Id = "MelinoeField_3376"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku akan bergegas."
      Speaker = "Melinoe"
      Event = "CharonAboutNemesisShopping01"
    }
    {
      Id = "MelinoeField_3377"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menjual barang kepada Heracles yang perkasa! Terkadang aku bertanya-tanya siapa lagi yang Anda layani, Tuanku. Bukan berarti Anda bakal memberitahuku, sih."
      Speaker = "Melinoe"
      Event = "CharonAboutHeraclesShopping01"
    }
    {
      Id = "Charon_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nnnrrrraaauuuggghhh..."
      Speaker = "Charon"
      Event = "CharonAboutHeraclesShopping01"
    }
    {
      Id = "Melinoe_0423_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh."
      Speaker = "Melinoe"
      Event = "CharonAboutHeraclesShopping01"
    }
    {
      Id = "MelinoeField_1586"
      InheritFrom = "BaseNarrative"
      DisplayName = "Anda bisa merasakannya, bukan, Tuanku? Tanda dari Chaos Purba. Tampaknya aku mendapat penyokong baru dari barisan dewa-dewi khtonik."
      Speaker = "Melinoe"
      Event = "CharonAboutChaos01"
    }
    {
      Id = "MelinoeField_1582"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris kembali ke Persimpangan Jalan, Tuanku. Maafkan aku bila menjelek-jelekkan salah satu saudaramu, tapi... aku selalu mencemaskan hal terburuk tiap kali dia ada di dekat kami. Mungkinkah dia bersekongkol melawan kita?"
      Speaker = "Melinoe"
      Event = "CharonAboutEris01"
    }
    {
      Id = "Charon_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mnngghghhhhh..."
      Speaker = "Charon"
      Event = "CharonAboutEris01"
    }
    {
      Id = "MelinoeField_1583"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Andai saja dia lebih mirip denganmu."
      Speaker = "Melinoe"
      Event = "CharonAboutEris01"
    }
    {
      Id = "Melinoe_1294"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibundamu, Nyx, Tuanku... Belakangan ini aku melihatnya dalam mimpi buruk atau bunga tidur. Beliau sangat jelita... dan sepertinya tak terluka."
      Speaker = "Melinoe"
      Event = "CharonAboutNyx01"
    }
    {
      Id = "Charon_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mrmmm, {#Emph}nrruuunnngghhh..."
      Speaker = "Charon"
      Event = "CharonAboutNyx01"
    }
    {
      Id = "Melinoe_1295"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita pasti akan menemukannya. Aku bersumpah."
      Speaker = "Melinoe"
      Event = "CharonAboutNyx01"
    }
    {
      Id = "Melinoe_1298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah tahu, bukan, Tuanku? Soal Sang Tiga Fates. Bahwa Chronos telah memperbudak para saudarimu. Setidaknya Tuan Moros aman bersama kami."
      Speaker = "Melinoe"
      Event = "CharonAboutFates01"
    }
    {
      Id = "Charon_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kkhhh, {#Emph}kkhhrrrraaauugggghhhh..."
      Speaker = "Charon"
      Event = "CharonAboutFates01"
    }
    {
      Id = "Melinoe_1299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa kau sungguh berpikir begitu...?"
      Speaker = "Melinoe"
      Event = "CharonAboutFates01"
    }
    {
      Id = "Melinoe_1818"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lega rasanya tahu Artemis mengawasi keadaan di sekitar sini belakangan ini, Tuanku. Perbekalannya tampaknya melimpah tak seperti biasanya..."
      Speaker = "Melinoe"
      Event = "CharonAboutArtemis01"
    }
    {
      Id = "Charon_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hhrrraaauuggghhh..."
      Speaker = "Charon"
      Event = "CharonAboutArtemis01"
    }
    {
      Id = "Melinoe_1819"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenang saja, aku takkan memberitahu siapa-siapa."
      Speaker = "Melinoe"
      Event = "CharonAboutArtemis01"
    }
    {
      Id = "Melinoe_2013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu apakah Arachne akan baik-baik saja menghadapi semua ini, Tuanku? Permukaan sudah tak lagi ramah ataupun aman untuknya. Dan kini, aku khawatir Erebus pun tak jauh lebih baik..."
      Speaker = "Melinoe"
      Event = "CharonAboutArachne01"
    }
    {
      Id = "Charon_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mmrrrnnnggghhh..."
      Speaker = "Charon"
      Event = "CharonAboutArachne01"
    }
    {
      Id = "Melinoe_2014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar. Dia dua kali lipat lebih banyak akal dibanding siapa pun. {#Emph}Empat {#Prev}kali lipat malah! Hanya saja... tolong jaga dia baik-baik, ya?"
      Speaker = "Melinoe"
      Event = "CharonAboutArachne01"
    }
    {
      Id = "Charon_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Shaaaauugghh..."
      Speaker = "Charon"
      Event = "CharonGrantsHiddenAspect01"
    }
    {
      Id = "MelinoeField_3501"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Charon, apa ini kau berikan padaku? Corak di perkamen ini... Tanda Malam, singa berkepala tiga, dan kata-kata ini... {#Emph}Kulihat kau menimbun jasad musuhmu yang hancur lebur. {#Prev}Ini mantra pembangkit, untuk Zorephet?"
      Speaker = "Melinoe"
      Event = "CharonGrantsHiddenAspect01"
    }
    {
      Id = "Charon_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Rrrraauugghh, hrrrrn..."
      Speaker = "Charon"
      Event = "CharonGrantsHiddenAspect01"
    }
    {
      Id = "MelinoeField_3502"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memercayakannya padaku. Baiklah, jika kau rasa aku sudah siap, aku akan mengucapkannya di Kolam Perak pada kesempatan berikutnya. Terima kasih, Tuanku."
      Speaker = "Melinoe"
      Event = "CharonGrantsHiddenAspect01"
    }
    {
      Id = "MelinoeField_3806"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kulihat kau menimbun jasad musuhmu yang hancur lebur."
      Speaker = "Melinoe"
      Event = "CharonGrantsHiddenAspect01"
    }
    {
      Id = "MelinoeField_3530"
      InheritFrom = "BaseNarrative"
      DisplayName = "Inilah dia, Tuanku! Aspek tersembunyi Nergal yang takkan pernah bisa kubangkitkan jika bukan karenamu. Apakah ini sosok dewa perang dari negeri nun jauh, atau dari zaman lain?"
      Speaker = "Melinoe"
      Event = "CharonAboutHiddenAspect01"
    }
    {
      Id = "Charon_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nrrrggghhh, haaaa..."
      Speaker = "Charon"
      Event = "CharonAboutHiddenAspect01"
    }
    {
      Id = "MelinoeField_3531"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu mungkin keduanya..."
      Speaker = "Melinoe"
      Event = "CharonAboutHiddenAspect01"
    }
    {
      Id = "MelinoeField_5037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tuan Charon, kenapa kau tak bilang apa-apa soal Kontrak Neraka yang mulai kulihat itu? Aku sampai tanpa sengaja beradu tanding melawan Zagreus!"
      Speaker = "Melinoe"
      Event = "CharonAboutZagreusFight01"
    }
    {
      Id = "Charon_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Graaahhh, hrrrmmm...?"
      Speaker = "Charon"
      Event = "CharonAboutZagreusFight01"
    }
    {
      Id = "MelinoeField_5038"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, kau tahu maksudku. Dan tidak, aku {#Emph}kalah!"
      Speaker = "Melinoe"
      Event = "CharonAboutZagreusFight01"
    }
    {
      Id = "MelinoeField_5039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, kau tahu maksudku. Dan ya, aku {#Emph}menang!"
      Speaker = "Melinoe"
      Event = "CharonAboutZagreusFight01"
    }
    {
      Id = "Charon_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nnnnn... haaaaahh, hrhrrnngghhh..."
      Speaker = "Charon"
      Event = "CharonPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4506"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita memang menang, Tuanku, dan itu sebagian besar berkat semua bantuanmu. Aku yakin Nyx sudah menjengukmu. Tapi, bagaimana dengan semua Emas yang tersisa?"
      Speaker = "Melinoe"
      Event = "CharonPostTrueEnding01"
    }
    {
      Id = "Charon_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Grrrnn, hraaauggghh..."
      Speaker = "Charon"
      Event = "CharonPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4507"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, itu semua milikmu!"
      Speaker = "Melinoe"
      Event = "CharonPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4508"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa aku sama sekali tak heran kau masih di sini menjajakan daganganmu, bahkan setelah semua yang terjadi belakangan ini, Tuanku? Kau takkan berhenti sampai Bawah Tanah sepenuhnya pulih."
      Speaker = "Melinoe"
      Event = "CharonPostTrueEnding02"
    }
    {
      Id = "Charon_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrraaaugggghhh!!"
      Speaker = "Charon"
      Event = "CharonPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4509"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan sesudah itu pun tidak, paham!"
      Speaker = "Melinoe"
      Event = "CharonPostTrueEnding02"
    }
    {
      Id = "Charon_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kkhhhrrnn, aaauugggghhhh...!"
      Speaker = "Charon"
      Event = "CharonPostEpilogue01"
    }
    {
      Id = "MelinoeField_4510"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Maksudmu saudarimu para Takdir... kau tahu mereka akan baik-baik saja? Aku tak pernah menyangka bisa bertemu langsung dengan mereka. Salah satu dari mereka, dia... yah, dia sedikit mengingatkanku pada {#Emph}dirimu."
      Speaker = "Melinoe"
      Event = "CharonPostEpilogue01"
    }
    {
      Id = "Charon_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Guuuhhhhh..."
      Speaker = "Charon"
      Event = "CharonPostEpilogue01"
    }
    {
      Id = "MelinoeField_4511"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yah, itu baru kesan pertama saja sih..."
      Speaker = "Melinoe"
      Event = "CharonPostEpilogue01"
    }
    {
      Id = "Charon_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mmmm, {#Emph}mmmmrrnnnn..."
      Speaker = "Charon"
      Event = "CharonAboutArtemisSinging01"
    }
    {
      Id = "Melinoe_4184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu yang tepat sekali untuk mengantarkan barang daganganmu, Tuanku. Itu Artemis sedang bernyanyi di dekat sini! Walaupun mungkin musik seperti itu bukan seleramu."
      Speaker = "Melinoe"
      Event = "CharonAboutArtemisSinging01"
