  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_1878"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga cahaya bulan membimbingmu, Tuanku."
      Speaker = "Melinoe"
      Event = "NPC_Charon_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2273"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang kembali di Persimpangan, Tuanku."
      Speaker = "Melinoe"
      Event = "NPC_Charon_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2275"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga engkau tetap tak kasat mata di luar sana, Tuanku."
      Speaker = "Melinoe"
      Event = "NPC_Charon_01.InteractVoiceLines"
    }
    {
      Id = "Melinoe_2276"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pintu kami selalu terbuka dan engkau selalu aman di sini, Tuan Charon."
      Speaker = "Melinoe"
      Event = "NPC_Charon_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_4517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, Kapten."
      Speaker = "Melinoe"
      Event = "NPC_Charon_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_4518"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, Kapten... kalau hamba boleh memanggilmu begitu, Tuanku?"
      Speaker = "Melinoe"
      Event = "NPC_Charon_01.InteractVoiceLines"
    }
    {
      Id = "Charon_0112"
