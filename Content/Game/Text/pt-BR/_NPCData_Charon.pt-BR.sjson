      Event = "CharonChat18"
    }
    {
      Id = "Charon_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hhrrrrmmmmm...?"
      Speaker = "Charon"
      Event = "CharonChat19"
    }
    {
      Id = "Charon_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aaaauuuuggghhh..."
      Speaker = "Charon"
      Event = "CharonChat20"
    }
    {
      Id = "Melinoe_1301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maukah kau meluangkan waktu sejenak untukku, Tukang Perahu? Kalau kita berniat memulihkan tatanan lama di sekitar sini, kupikir kenapa tidak memulainya seperti ini?"
      Speaker = "Melinoe"
      Event = "CharonGift01"
    }
    {
      Id = "Charon_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hhhhrrrrnnnngggghhh...?"
      Speaker = "Charon"
      Event = "CharonGift01"
    }
    {
      Id = "Charon_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oooohhhhhh..."
      Speaker = "Charon"
      Event = "CharonGift02"
    }
    {
      Id = "Melinoe_1208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, Tuan Charon. Semoga kita bisa segera memulihkan adat lama antarkeluarga kita, dan menyongsong era kemakmuran yang baru."
      Speaker = "Melinoe"
      Event = "CharonGift02"
    }
    {
      Id = "Charon_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Auuggggghhhhhh..."
      Speaker = "Charon"
      Event = "CharonGift03"
    }
    {
      Id = "Melinoe_3383"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau hanya membutuhkan Emas, Tuanku. Namun, aku ingin memberimu sesuatu yang lebih! Aku selalu mengagumi dedikasimu terhadap alam baka dan juga keteguhan tugasmu."
      Speaker = "Melinoe"
      Event = "CharonGift03"
    }
    {
      Id = "Charon_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nrrrghhhhh, hauuuugghhhh..."
      Speaker = "Charon"
      Event = "CharonGift04"
    }
    {
      Id = "Melinoe_3384"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kegigihanlah yang membawa kita sampai ke titik ini, Tuanku. Semoga tekadmu tak pernah goyah! Setiap kali tekadku goyah, aku merasa tenang mengetahui ada sekutu yang begitu bisa diandalkan sepertimu."
      Speaker = "Melinoe"
      Event = "CharonGift04"
    }
    {
      Id = "Charon_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Nraaauuggh, guhhh..."
      Speaker = "Charon"
      Event = "CharonGift05"
    }
    {
      Id = "Melinoe_5438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar harus mencobanya sesekali, Tuanku! Nektar adalah salah satu hal yang disukai hampir semua orang di Olimpus, dan itu pasti ada alasannya, kan?"
      Speaker = "Melinoe"
      Event = "CharonGift05"
    }
    {
      Id = "Charon_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hrrnnnmm, nnrrrr...{#Prev}"
      Speaker = "Charon"
      Event = "CharonGift06"
    }
    {
      Id = "Melinoe_5439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu Tuan tak pernah memanjakan diri sendiri, tapi... Tuan pantas menerima lebih dari sekadar koin receh sebagai imbalan atas semua jasa Tuan! Yah, mungkin Nektar ini hanyalah tanda terima kasih kecil lainnya."
      Speaker = "Melinoe"
      Event = "CharonGift06"
    }
    {
      Id = "Charon_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ehhh...{#Prev}"
      Speaker = "Charon"
      Event = "CharonGift06"
    }
    {
      Id = "Melinoe_5440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar di masa lampau, Tuan diam-diam menyelundupkan kiriman Ambrosia hingga jauh ke kedalaman Tartarus. Dan mengenal Tuan, Tuan tak akan pernah mencicipi barang dagangan sendiri, jadi terimalah ini. Ini hadiah, bukan barang kiriman."
      Speaker = "Melinoe"
      Event = "CharonGift07"
    }
    {
      Id = "Charon_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hoohhhhh, hrrrnnnn...{#Prev}"
      Speaker = "Charon"
      Event = "CharonGift07"
    }
    {
      Id = "Melinoe_5441"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga masa-masa itu segera tiba..."
      Speaker = "Melinoe"
      Event = "CharonGift07"
    }
    {
      Id = "Melinoe_5442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini, Tuan. Jika Tuan berniat menyimpan botol Ambrosia yang satunya sebagai cadangan, mungkin Tuan bisa membagikan yang ini bersama rekan kerja Tuan. Tak perlu disimpan-simpan lagi."
      Speaker = "Melinoe"
      Event = "CharonGift08"
    }
    {
      Id = "Charon_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Auuugggghh, mmmm...? Kkrrnnn...{#Prev}"
      Speaker = "Charon"
      Event = "CharonGift08"
    }
    {
      Id = "Melinoe_5443"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku hanya berusaha memahami Tuan lebih baik, tahu betul ini tak pernah tentang kata-kata atau hadiah. Tuan adalah Sang Pendayung Dunia Bawah... putra Nyx yang perkasa... dan rekan paling tepercaya yang pernah kuharapkan."
      Speaker = "Melinoe"
      Event = "CharonGift08"
    }
    {
      Id = "Charon_0138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Nnnnhhh...{#Prev}"
      Speaker = "Charon"
      Event = "CharonGift08"
    }
