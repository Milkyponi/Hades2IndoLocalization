      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0501"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...entah apa pun benda {#Emph}ini{#Prev}..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0502"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...benda usang ini..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0146"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...satu yang ini..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0147"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...sedikit yang ini..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0148"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...sepercik saja..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0149"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...aduk perlahan..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0150"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}Mmm{#Prev}, mari kita lihat..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0151"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...apa lagi, ya..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0499"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...biarkan meresap..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0500"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...sebuah bisikan niat..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0503"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...ada lagi...?"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0504"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...oh, ini juga..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0505"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...{#Emph}dan...{#Prev}"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0152"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...dan, selesai."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronWrapUpLines"
    }
    {
      Id = "Medea_0153"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...dan sekarang tinggal menunggu..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronWrapUpLines"
    }
    {
      Id = "Medea_0155"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...dan, cukup sudah...!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronWrapUpLines"
    }
    {
      Id = "Medea_0506"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...tak butuh yang lain."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronWrapUpLines"
    }
    {
      Id = "Medea_0507"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...tiada lagi."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronWrapUpLines"
    }
    {
      Id = "Medea_0508"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...dan telah usai."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronWrapUpLines"
    }
    {
      Id = "Medea_0509"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...terwujudlah kehendak ini...!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronWrapUpLines"
    }
    {
      Id = "Medea_0156"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Wahai arwah gentayangan yang merindukan kedamaian,}{#Prev"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0157"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kuserukan agar kau menyimak suaraku lumat-lumat.}{#Prev"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Saat ketika hayat fana telah sirna ditelan zaman,}{#Prev"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bukanlah saat meratap pilu, melainkan bersukacita penuh nikmat!}{#Prev"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Karena kan kutuntun engkau menuju haribaan sejatimu,}{#Prev"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Jauh di bawah bumi tempat Maut dan Lelap bersemayam,}{#Prev"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Cukup berbakti padaku demi sebuah kidung restu,}{#Prev"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pasrahkan dirimu pada kehendak Sang Tak Kasatmata."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kepada seluruh musuh Hades, dekat maupun jauh,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0166"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga gagak mencabik daging dan melumat matamu,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Seluruh anggota tubuhmu ditaruh di dalam toples acar yang kumuh,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dan kumbang-kumbang memuntahkan diri dari dusta bibirmu."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0169"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Entah kau bernaung di atas permukaan atau di bawah tanah,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tiap jengkal langkahmu kan tersengat derita menghujam."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tak ada damai atau belas kasih yang sudi menjamah,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hingga kau bertobat, dan mati berulang kali di kegelapan kelam."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0464"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bagi mereka yang memandangku hina, ini persembahanku:"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0465"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kuali bergolak penuh herba beracun mematikan,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0466"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Taring berbisa, onak berduri, serta sebuah kecupan halu,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Serta sumpah serapah keji dan mantra yang mengerikan."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Semoga rontok seluruh rambutmu dan menggidik kulitmu"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oleh borok-borok perih dan gigitan serangga melata;"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0470"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kenangan terindahmu akan kujadikan budak belengguku,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Tenggorokanmu kan kutebas, namun tuntaskan dulu ritual petaka."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0472"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...Maka terjadilah."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0473"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hecate yang agung, kupuja segala jalanmu,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kau terangi tapak langkahku menembus pekatnya malam,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0475"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Pertama kali kujumpai dirimu di tengah kabut kelamku,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0476"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Dan kau pulihkan kembali hasrat bertarungku yang sempat tenggelam."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0477"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Akan kuabdikan diriku pada apa yang kau ajarkan,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0478"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Meski cara-caraku sendiri yang selalu kuutamakan,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kebijaksanaanmu kan selalu melampaui batas pengetahuanku,"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0480"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kau hanya perlu memberiku sesuatu untuk kuhancurkan."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0481"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}...Maka terjadilah."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaIncantationLines"
    }
    {
      Id = "Medea_0079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar mereka merasakannya."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutukan menimpa mereka semua."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0081"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, aku suka yang itu."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sesuai kehendakmu."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0083"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukira kau takkan pernah memintanya."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maka terjadilah."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sungguh luar biasa...!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengan senang hati kulakukan."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Itulah yang kau dapatkan."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kataskion aski!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Askion kataski!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0538"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sempurna..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0539"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pilihan yang berkelas."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0540"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika itu yang kau sukai..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0541"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga ini membawamu melangkah jauh..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0542"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ambillah salah satu dari ini..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0543"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seharusnya tidak ada efek samping..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0544"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengan senang hati."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0545"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0546"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seperti di atas, demikian pula di bawah."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0547"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nikmatilah..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0088"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terjadilah demikian."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terjadilah demikian...!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "MelinoeField_5651"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpi dan kutukan saling berkelindan..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "MelinoeField_0255"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berterima kasih, Nyonya."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "MelinoeField_0256"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga Malam melindungi kita..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiscEndVoiceLines_Medea"
    }
    {
      Id = "Medea_0301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bumi selalu menyediakan..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGatherReactionVoiceLines"
    }
    {
