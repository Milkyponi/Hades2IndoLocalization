      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...bawang bombai..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0140"
      InheritFrom = "BaseSubtitle"
