{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Medea.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "MelinoeField_5650"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hypnos mungkin masih terlelap andai bukan karena Nyonya Medea..."
      Speaker = "Melinoe"
      Event = "NPC_Medea_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_3500"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kulihat kau kumpulkan arwah yang tak terhitung jumlahnya di wilayah yang dingin nan gulita...{#Prev}"
      Speaker = "Melinoe"
      Event = "NPC_Medea_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_4334"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja. {#Emph}Petaka bagi yang Tersiksa{#Prev}, benarkah?"
      Speaker = "Melinoe"
      Event = "NPC_Medea_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_4339"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedengarannya... sangat berkhasiat."
      Speaker = "Melinoe"
      Event = "NPC_Medea_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_3814"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, Nyonya Medea."
      Speaker = "Melinoe"
      Event = "NPC_Medea_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_3950"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti."
      Speaker = "Melinoe"
      Event = "NPC_Medea_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_5234"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami berhasil melaluinya."
      Speaker = "Melinoe"
      Event = "NPC_Medea_01.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "MelinoeField_0492"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga rembulan menuntunmu, Nyonya."
      Speaker = "Melinoe"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_0493"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kematian bagi Chronos, Nyonya."
      Speaker = "Melinoe"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersama, kita bersinar."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam yang sungguh terkutuk."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga kegelapan menuntunmu."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam hangat kembali untukmu."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0102"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia pasti akan menderita."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0103"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pun dirimu."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atas rahmat Selene."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak ragu dia pasti bersedia."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu, atau aroma anyir darah."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku yakin pasti begitu."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sesuai kehendakmu, wahai penyihir."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau menyanjungku."
      Speaker = "Medea"
      Event = "NPC_Medea_01.InteractVoiceLines"
    }
    {
      Id = "Medea_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salam, wahai penyihir! Selamat datang di Ephyra. Penderitaan merajalela ke mana pun matamu memandang, dan di malam yang begitu busuk ini. Sungguh mengerikan, bukan?"
      Speaker = "Medea"
      Event = "MedeaFirstMeeting"
    }
    {
      Id = "MelinoeField_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tepat sekali, Nyonya Medea. Sayangnya, aku hanya bisa menikmati penderitaan ini sejenak, karena Olympus memanggil. Namun, bagaimana perkembangan risetmu?"
      Speaker = "Melinoe"
      Event = "MedeaFirstMeeting"
    }
    {
      Id = "Medea_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku sudah {#Emph}mati-matian {#Prev}ingin memperlihatkannya padamu! Udara di sini {#Emph}benar-benar {#Prev}beracun. Kondisinya? Sungguh memprihatinkan! Saksikan apa yang telah kuciptakan..."
      Speaker = "Medea"
      Event = "MedeaFirstMeeting"
    }
    {
      Id = "Medea_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, sang penyihir kembali. Masih belum puas dengan atmosfer busuk ini? Atau sekadar belum berhasil mendobrak kepungan sang Titan?"
      Speaker = "Medea"
      Event = "MedeaAboutFoes01"
    }
    {
      Id = "MelinoeField_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum berhasil. Chronos bisa memulihkan pasukannya secepat Olympus memukul mundur mereka. Apa kau menemukan kelemahan di barisan mereka?"
      Speaker = "Melinoe"
      Event = "MedeaAboutFoes01"
    }
    {
      Id = "Medea_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka tak bisa dibunuh selamanya, nyaris kebal terhadap racunku yang paling mematikan, dan kesetiaan mereka pada sang Raja Titan tak tergoyahkan. Adakah dari semua itu yang terdengar seperti kelemahan?"
      Speaker = "Medea"
      Event = "MedeaAboutFoes01"
    }
    {
      Id = "Medea_0587"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wasiat Malam menuntut agar sang Cyclops ditundukkan, bukan? Terpaksa aku harus mempersulit usahamu itu."
      Speaker = "Medea"
      Event = "MedeaAboutShrine01"
    }
    {
      Id = "MelinoeField_4740"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham dan memakluminya. Walau terkadang aku bertanya-tanya apakah Polyphemus mengerti soal semua ini."
      Speaker = "Melinoe"
      Event = "MedeaAboutShrine01"
    }
    {
      Id = "Medea_0588"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia memang bukan tipe yang berpikir rumit, tapi instingnya terasah sangat tajam. Mengutip kata-katanya sendiri, dia tahu kapan ada yang tak beres. Sepertinya kita akan segera berjumpa lagi?"
      Speaker = "Medea"
      Event = "MedeaAboutShrine01"
    }
    {
      Id = "MelinoeField_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah berapa lama kau menetap di sini, Nyonya Medea? Kukira seluruh pasukan kita kabur saat kota ini jatuh, tapi kau tampak begitu nyaman."
      Speaker = "Melinoe"
      Event = "MedeaAboutEphyra01"
    }
    {
      Id = "Medea_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, ya! Segala kematian dan kepanikan menyisakan banyak tempat kosong. Aku menyusup lewat bayang-bayang sesaat setelah kota ini runtuh, lalu menetap, berlatih, mengamati.... Hecate Agung punya mata di permukaan di {#Emph}mana-mana...{#Prev}"
      Speaker = "Medea"
      Event = "MedeaAboutEphyra01"
    }
    {
      Id = "Medea_0579"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Cyclops memberitahuku bahwa kau melintasi Celah Thessaly untuk mencapai gunung itu malam demi malam, benarkah begitu? {#Emph}Hih{#Prev}, aku sama sekali tak punya kenangan manis tentang malam-malamku di laut..."
      Speaker = "Medea"
      Event = "MedeaAboutThessaly01"
    }
    {
      Id = "MelinoeField_4718"
      InheritFrom = "BaseNarrative"
      DisplayName = "Armada sang Titan memang secara tak sengaja membantuku menyeberang dari sini ke sana. Apa gerangan yang membuatmu membenci perjalanan laut? Aku bisa membayangkan banyak kemungkinan."
      Speaker = "Melinoe"
      Event = "MedeaAboutThessaly01"
    }
    {
      Id = "Medea_0580"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sejujurnya, sebagian besar karena para awak kapal yang berlayar bersamaku. Sebagian Arwah mereka mungkin masih berkeliaran di Elysium... meski masa tinggal mereka di sana mungkin tak seindah yang dinikmati yang lain."
      Speaker = "Medea"
      Event = "MedeaAboutThessaly01"
    }
    {
      Id = "Medea_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam masih panjang dan kau sudah sampai di sini! Senang sekali kau mampir ke sudut kecil Ephyra ini sebagai salah satu perhentian pertamamu selagi berusaha kabur dari jalanan terkutuk ini."
      Speaker = "Medea"
      Event = "MedeaAboutEarlyArrival01"
    }
    {
      Id = "MelinoeField_4732"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, {#Emph}anu{#Prev}, tentu saja. Sebagian besar jalanan lain dan semacamnya tak punya hal berguna bagiku... hanya orang-orang mati nan malang yang tak punya tujuan lagi."
      Speaker = "Melinoe"
      Event = "MedeaAboutEarlyArrival01"
    }
    {
      Id = "Medea_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah {#Prev}ya sudah, selera orang kan beda-beda! Aku sendiri cukup menikmati menjelajahi berbagai jalan buntu, meski akhir-akhir ini aku jadi berlama-lama di sini. Bahan riset yang kukumpulkan sudah lebih dari cukup."
      Speaker = "Medea"
      Event = "MedeaAboutEarlyArrival01"
    }
    {
      Id = "Medea_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah terlalu banyak malam terlewat sejak terakhir kali kita bersua, wahai penyihir! Ada urusan yang jauh lebih mendesak di Alam Bawah, begitu?"
      Speaker = "Medea"
      Event = "MedeaAboutTimePassing01"
    }
    {
      Id = "MelinoeField_4736"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, bisa dibilang begitu. Bagaimana kabarmu? Ada perkembangan baru yang harus kuketahui?"
      Speaker = "Melinoe"
      Event = "MedeaAboutTimePassing01"
    }
    {
      Id = "Medea_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kabarku sebaik yang bisa diharapkan, bahkan mungkin lebih. Peluang riset di sini masih sangat berlimpah. Semoga perjalananmu juga membuahkan segala yang kau dambakan."
      Speaker = "Medea"
      Event = "MedeaAboutTimePassing01"
    }
    {
      Id = "Medea_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus berterima kasih padamu, wahai penyihir! Setelah amukan terakhirmu di seantero kota ini, aku berhasil mengambil sampel darahmu. Oh, khasiatnya sangat mujarab!"
      Speaker = "Medea"
      Event = "MedeaAboutBlood01"
    }
    {
      Id = "MelinoeField_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehm{#Prev}, terima kasih kembali, Nyonya Medea. Tapi lain kali, tolong minta izinku dulu sebelum memakai darah hidupku untuk bahan eksperimenmu."
      Speaker = "Melinoe"
      Event = "MedeaAboutBlood01"
    }
    {
      Id = "Medea_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau tetap kupakai tapi tidak akan pernah kubahas lagi di depanmu? Jangan cemas, aku hanya memakainya demi tujuan bersama yang sama-sama kita inginkan...!"
      Speaker = "Medea"
      Event = "MedeaAboutBlood01"
    }
    {
      Id = "Medea_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sangat luas cakupan seni sihir kita, bukan, wahai penyihir? Meski kau belajar giat bersama Yang Mulia Hekate, kurasa kau nyaris tak tahu apa pun soal bidang keahlian{#Emph}ku{#Prev}..."
      Speaker = "Medea"
      Event = "MedeaAboutPoisons01"
    }
    {
      Id = "MelinoeField_0334"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar bahwa pengalamanku tak sebanding denganmu, Nyonya Medea. Aku jarang sekali menghabiskan waktu bersama kaum fana... maksudku, yang masih hidup."
      Speaker = "Melinoe"
      Event = "MedeaAboutPoisons01"
    }
    {
      Id = "Medea_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini, aku sendiri juga jarang berurusan dengan mereka yang masih bernapas. Kebanyakan sangat mudah termakan hasutan, atau setidaknya gampang diracun lewat makanan atau minuman mereka."
      Speaker = "Medea"
      Event = "MedeaAboutPoisons01"
    }
    {
      Id = "MelinoeField_0330"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Arwah di sekitar tempat ini... mereka terjebak di dalam jasad fana mereka yang membusuk, bukan? Tak mampu melangkah menuju alam ayahku."
      Speaker = "Melinoe"
      Event = "MedeaAboutUndead01"
    }
    {
      Id = "Medea_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luar biasa, kan? Ini adalah sebuah {#Emph}revolusi {#Prev}dalam seni nekromansi! Raga-raga ringkih yang berjalan gontai, terjebak persis di ambang kematian... Aku bisa meneliti mereka berbulan-bulan tanpa henti!"
      Speaker = "Medea"
      Event = "MedeaAboutUndead01"
    }
    {
      Id = "MelinoeField_0328"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bekerja tanpa kenal lelah demi keahlianmu, Nyonya Medea. Kalau boleh tahu, dari mana kau mendapatkan tekad sebesar itu malam demi malam?"
      Speaker = "Melinoe"
      Event = "MedeaAboutVengeance01"
    }
    {
      Id = "Medea_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sangat sederhana, wahai penyihir. Aku hanya ingin membalas semua orang yang pernah berbuat salah padaku, setimpal dengan penderitaan yang mereka timbulkan. Tapi tak usah takut, namamu tidak ada di daftarku!"
      Speaker = "Medea"
      Event = "MedeaAboutVengeance01"
    }
    {
      Id = "MelinoeField_0329"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kau sudah begitu sering dizalimi sampai-sampai butuh lebih dari satu daftar nama pendosa? Apa yang akan terjadi kalau kau sudah mengutuk mereka semua?"
      Speaker = "Melinoe"
      Event = "MedeaAboutVengeance01"
    }
    {
      Id = "Medea_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Daftar-daftarku disusun berdasarkan kategori penghinaan; mulai dari ketidaksukaan remeh, hingga pengkhianatan paling keji. Soal apa yang terjadi setelah tujuanku tercapai... nanti kupikirkan lagi setelah semuanya tuntas."
      Speaker = "Medea"
      Event = "MedeaAboutVengeance01"
    }
    {
      Id = "MelinoeField_4714"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernahkah kau merasa kutukanmu meninggalkan rasa hampa di dalam hatimu, Nyonya Medea? Tiap kali aku membiarkan pikiran gelap menguasaiku, setelah luapan emosi mereda, aku jarang menyukai perasaan hampa yang tertinggal."
      Speaker = "Melinoe"
      Event = "MedeaAboutEmptiness01"
    }
    {
      Id = "Medea_0601"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lho, justru merasa hampa adalah inti utama dari seluruh racikan ramuan ini, wahai penyihir. Menjadi hampa berarti benar-benar damai. Itulah hal paling dekat yang bisa kita capai menuju kematian fana."
      Speaker = "Medea"
      Event = "MedeaAboutEmptiness01"
    }
    {
      Id = "MelinoeField_4715"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku paham maksudmu, tapi... aku lebih memilih merasa puas, atau bahagia, atau bersemangat, bukan cuma... tidak merasakan apa-apa. Rasa dan intuisi kitalah yang menggerakkan kita."
      Speaker = "Melinoe"
      Event = "MedeaAboutEmptiness01"
    }
    {
      Id = "Medea_0602"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perasaan itu justru menggerakkan kita untuk memusnahkannya. Aku menyingkirkan perasaan setiap saat; dendam? Kutuk saja. Lapar? Makan. Nafsu? Dan seterusnya. Untuk setiap penyakit, selalu ada obat penawarnya."
      Speaker = "Medea"
      Event = "MedeaAboutEmptiness01"
    }
    {
      Id = "Medea_0589"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Tempo hari kau bilang kau mulai memercayaiku. Aku hanya ingin kau tahu bahwa kata-katamu itu sangat berarti. Tak ada yang bicara begitu padaku belakangan ini... bahkan Yang Mulia Hekate pun memilih menjaga jarak denganku."
      Speaker = "Medea"
      Event = "MedeaAboutTrust01"
    }
    {
      Id = "MelinoeField_4720"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyonya Medea, kebiasaanmu meneliti sendirian tentu ada pengaruhnya dalam hal ini. Kau akan selalu disambut dan aman di Persimpangan kalau kau ingin bergabung bersama kami di sana."
      Speaker = "Melinoe"
      Event = "MedeaAboutTrust01"
    }
    {
      Id = "Medea_0590"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak usah, aku tidak kekurangan teman bicara. Membayangkan diriku dikelilingi oleh yang hidup maupun yang mati saja sudah membuat isi perutku mual. Tapi aku tidak keberatan dengan{#Emph}mu{#Prev}, tak seperti orang-orang lain itu."
      Speaker = "Medea"
      Event = "MedeaAboutTrust01"
    }
    {
      Id = "MelinoeField_0335"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, di tengah semua kengerian dan keputusasaan ke mana pun aku melangkah, kehadiranmu kini menjadi pemandangan yang melegakan, Nyonya Medea. Aku senang bisa mengenalmu lebih dekat."
      Speaker = "Melinoe"
      Event = "MedeaAboutReputation01"
    }
    {
      Id = "Medea_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan berlagak mengenalku, wahai penyihir. Kau hanya tahu reputasiku, lalu merasa heran karena aku tidak tampak sekejam yang kau dengar. Padahal, kekejaman terbesar justru sering kali terselubung dengan rapi..."
      Speaker = "Medea"
      Event = "MedeaAboutReputation01"
    }
    {
      Id = "MelinoeField_0336"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bermaksud menyinggungmu. Aku sama sekali tak merasa paling mengenalmu, aku hanya ingin bilang bahwa aku selalu menantikan pertemuan kita. Soal reputasimu, aku tak peduli apa kata orang lain tentang mereka yang seperti kita."
      Speaker = "Melinoe"
      Event = "MedeaAboutReputation01"
    }
    {
      Id = "Medea_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau harus lebih peduli, sebab kita ini memang pantas untuk ditakuti. Dan ada orang-orang yang tega mengkhianati kita, mencemari nama baik kita, atau bahkan lebih buruk lagi. Jaga baik-baik kepercayaanmu, itulah nasihatku untukmu."
      Speaker = "Medea"
      Event = "MedeaAboutReputation01"
    }
    {
      Id = "MelinoeField_0332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutukan-kutukanmu sangat membantu, Nyonya Medea. Seandainya saja aku seoptimis dirimu. Kau selalu tersenyum, bahkan di tempat semacam ini sekalipun."
      Speaker = "Melinoe"
      Event = "MedeaAboutOptimism01"
    }
    {
      Id = "Medea_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagian mana yang tidak menyenangkan? Darah untuk risetku melimpah ruah di sini, dan orang-orang mati pun cukup waras untuk menyingkir dari jalanku. Nah, mari kita rapalkan kutukan lain dan kau akan kembali segar bugar bak bangkai!"
      Speaker = "Medea"
      Event = "MedeaAboutOptimism01"
    }
    {
      Id = "Medea_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa banyak hal yang berubah seiring waktu. Kini semakin jarang kulihat wajah-wajah yang kukenal sepertimu, atau bahkan tatapan penuh kebencian sekalipun. Terlalu banyak orang yang gagal memahami jalan hidup kita."
      Speaker = "Medea"
      Event = "MedeaAboutWitchcraft01"
    }
    {
      Id = "MelinoeField_0333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sepertinya selalu punya cara agar mereka paham, Nyonya Medea. Tapi, apakah kau merasa rindu hidup di antara kaum fana?"
      Speaker = "Melinoe"
      Event = "MedeaAboutWitchcraft01"
    }
    {
      Id = "Medea_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mencari subjek hidup untuk risetku dulu memang jauh lebih mudah, tapi selain urusan itu, tentu tidak. Punya segelintir kawan sejati jauh lebih baik daripada seribu orang asing yang cuma pura-pura ramah."
      Speaker = "Medea"
      Event = "MedeaAboutWitchcraft01"
    }
    {
      Id = "MelinoeField_0338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu sendirian, Nyonya Medea. Apakah tak ada anggota keluarga atau orang terkasih yang bisa menemanimu dalam... eksperimenmu ini?"
      Speaker = "Melinoe"
      Event = "MedeaAboutSolitude01"
    }
    {
      Id = "Medea_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, mereka bersamaku, secara tak langsung; arwah atau kenangan mereka. Tapi kenapa menganggap kesendirian butuh penawar? Memang ada kalanya seseorang butuh teman, tapi dorongan semacam itu bisa dipuaskan, sesuai situasinya."
      Speaker = "Medea"
      Event = "MedeaAboutSolitude01"
    }
    {
      Id = "MelinoeField_0339"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti tahu banyak soal kaum fana. Cara mereka hidup, menderita, dan mati. Setidaknya, apa kau pernah menemukan cara untuk meringankan kematian mereka?"
      Speaker = "Melinoe"
      Event = "MedeaAboutSuffering01"
    }
    {
      Id = "Medea_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk apa aku melakukan hal semacam itu? Hecate Agung sendiri yang berkata bahwa guru terbaik ada di luar {#Emph}sana. {#Prev}Menderita berarti belajar! Aku sendiri hanya ingin menjadi seorang guru yang baik."
      Speaker = "Medea"
      Event = "MedeaAboutSuffering01"
    }
    {
      Id = "MelinoeField_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jeritan kepedihan dan keputusasaan kaum fana sama sekali tak menggugah rasa welas asihmu, atau setidaknya belas kasihan? Bagiku suara-suara itu cukup meresahkan."
      Speaker = "Melinoe"
      Event = "MedeaAboutSuffering01"
    }
    {
      Id = "Medea_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau akan belajar menutup hatimu dari semua itu. Tak ada manusia fana yang berhak hidup lama! Tentu ada orang-orang yang keahliannya meringankan penderitaan; aku hanya berusaha memahami penyebabnya."
      Speaker = "Medea"
      Event = "MedeaAboutSuffering01"
    }
    {
      Id = "MelinoeField_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang membuat mantra-mantramu begitu kuat, Nyonya Medea? Begitu banyak kutukan yang dampaknya tak kasatmata, tapi milikmu menusuk layaknya sebilah pedang..."
      Speaker = "Melinoe"
      Event = "MedeaAboutCurses01"
    }
    {
      Id = "Medea_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutukan yang diracik dengan baik membutuhkan bahan-bahan yang sesuai, serta niat murni tanpa kompromi. Keraguan sedikit pun, kebimbangan apa pun, akan melemahkan dampak buruknya."
      Speaker = "Medea"
      Event = "MedeaAboutCurses01"
    }
    {
      Id = "MelinoeField_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu aku paham... niat murni untuk mendatangkan kemalangan itulah yang sulit kuraih. Bagaimana seseorang bisa mengharapkan celaka seburuk itu pada orang lain, tanpa membayangkan sebagian darinya berbalik arah?"
      Speaker = "Melinoe"
      Event = "MedeaAboutCurses01"
    }
    {
      Id = "Medea_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dengan latihan, penyihir! Niat buruk memang mengancam berbalik kepada diri sendiri, sering kali dengan daya yang lebih dahsyat. Namun dengan niat yang paling kelam... tak ada apa pun yang bisa dipantulkan kembali."
      Speaker = "Medea"
      Event = "MedeaAboutCurses01"
    }
    {
      Id = "MelinoeField_4716"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang membuat kutukan begitu memikat bagimu, Nyonya Medea? Aku tak pernah bisa terpaku pada satu cabang seni sihir kita saja... Terkadang aku takut takkan menguasai satu pun darinya."
      Speaker = "Melinoe"
      Event = "MedeaAboutCurses02"
    }
    {
      Id = "Medea_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong kosong, penyihir. Kau selalu memiliki kecenderungan nekromansi, dan sependengaranku, bakat alami terhadap mimpi. Kalau soal kutukan... kurasa aku suka betapa intimnya hal itu."
      Speaker = "Medea"
      Event = "MedeaAboutCurses02"
    }
    {
      Id = "MelinoeField_4717"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kutukan yang kau tawarkan padaku setiap malam cenderung menyebar luas ke segenap barisan musuh kita... rasanya kutukan itu tak {#Emph}tampak {#Prev}terlalu intim."
      Speaker = "Melinoe"
      Event = "MedeaAboutCurses02"
    }
    {
      Id = "Medea_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutukan semacam itu {#Emph}bukanlah {#Prev}yang paling memikatku, melainkan kutukan yang bisa kuracik sebagai hasilnya. Kau tahu dewi Nemesis; dengan kutukan, aku bisa menggunakan kekuatannya untuk diriku sendiri. Tapi jangan ucapkan sepatah kata pun soal ini padanya, atau awas saja..."
      Speaker = "Medea"
      Event = "MedeaAboutCurses02"
    }
    {
      Id = "MelinoeField_4730"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengingat kau sangat ahli dalam hal kutukan, Nyonya Medea, aku ingin tahu apakah aku boleh bertanya tentang kutukan yang sedang mengganggu seorang temanku."
      Speaker = "Melinoe"
      Event = "MedeaAboutCuringCurses01"
    }
    {
      Id = "Medea_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja tidak. Kecuali jika kau mengira itu kutukan yang kutimpakan sendiri. Kutukan bermutu tinggi tidak boleh dibicarakan, kecuali tentu saja kau adalah Hecate Agung sendiri. Sisanya dari kita tak boleh sekali-kali berani."
      Speaker = "Medea"
      Event = "MedeaAboutCuringCurses01"
    }
    {
      Id = "MelinoeField_4731"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi, apa kau yakin? Kutukan yang kumaksud ini mungkin tak seburuk dugaanmu."
      Speaker = "Melinoe"
      Event = "MedeaAboutCuringCurses01"
    }
    {
      Id = "Medea_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa jadi justru lebih buruk daripada yang {#Emph}kau {#Prev}duga. Jika kau menghormati keahlianku soal kutukan, maka hormati juga pendirianku dalam hal ini, penyihir. Aku takkan pernah menanggung kutukan orang lain."
      Speaker = "Medea"
      Event = "MedeaAboutCuringCurses01"
    }
    {
      Id = "MelinoeField_0500"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih lagi atas hadiahnya, Nyonya Medea. Sejumput bulu wol ini luar biasa, bukan... dan sangat lembut!"
      Speaker = "Melinoe"
      Event = "MedeaAboutKeepsake01"
    }
    {
      Id = "Medea_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa gumpalan bulu wol hitam yang kuberikan padamu! Dulunya itu berkilau keemasan bagai matahari. Tapi kurasa pantas untuk memodifikasi khasiatnya, agar lebih berguna bagi penyihir seperti kita..."
      Speaker = "Medea"
      Event = "MedeaAboutKeepsake01"
    }
    {
      Id = "Medea_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam masih terlalu dini agar sejumput Bulu Wol Hitam itu bisa berguna bagimu, asal kau tahu. Tapi, kalau kau cuma berusaha membuatku terkesan dengan membawanya kembali... kau {#Emph}berhasil!"
      Speaker = "Medea"
      Event = "MedeaAboutKeepsake02"
    }
    {
      Id = "MelinoeField_4729"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah lama ingin menanyakannya padamu, dan bagaimana bulu itu bisa memiliki daya sehebat itu. Tak ada binatang yang pernah kudengar memiliki bulu seperti {#Emph}ini."
      Speaker = "Melinoe"
      Event = "MedeaAboutKeepsake02"
    }
    {
      Id = "Medea_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupilih kita tak mengungkit rentetan panjang peristiwa yang akhirnya membuat bulu domba ini menjadi seperti ini. Yang perlu kautahu hanyalah ini akan berguna jika kau menumpahkan sedikit darah. Sekarang bawalah pergi."
      Speaker = "Medea"
      Event = "MedeaAboutKeepsake02"
    }
    {
      Id = "Medea_0577"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu yang {#Emph}mengerikan {#Prev}di udara, dan maksudku bukan dalam artian bagus. {#Emph}Ah{#Prev}, kau membawa salah satu Patung Kristal milik Bibi Circe. Tepatnya, sihir kuno yang menyelimutinya."
      Speaker = "Medea"
      Event = "MedeaAboutCirceKeepsake01"
    }
    {
      Id = "MelinoeField_4739"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, maafkan aku, tapi... ya, ini kenang-kenangan yang kudapat darinya. Haruskah aku tak membawanya kemari?"
      Speaker = "Melinoe"
      Event = "MedeaAboutCirceKeepsake01"
    }
    {
      Id = "Medea_0578"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak peduli dan takkan mengungkitnya lagi. Bagiku, karyanya tak pernah ada yang beres. Tapi jika itu ada manfaatnya untukmu, aku tak bisa menyangkalnya. Walau kalau aku sendiri, sudah kuhancurkan di bawah kakiku."
      Speaker = "Medea"
      Event = "MedeaAboutCirceKeepsake01"
    }
    {
      Id = "Medea_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar burung paling {#Emph}keterlaluan {#Prev}berembus ditiup angin belakangan ini, tentang apa yang menimpa gunung para dewa! Kau sedang menuju ke arah sana... apa yang sebenarnya terjadi?"
      Speaker = "Medea"
      Event = "MedeaAboutTyphon01"
    }
    {
      Id = "MelinoeField_3808"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kabar burung itu tentang monster purba nan raksasa yang hendak meremukkan Olympus berkeping-keping, dengan asumsi legiun sang Titan belum melakukannya lebih dulu... itu bukan kabar burung."
      Speaker = "Melinoe"
      Event = "MedeaAboutTyphon01"
    }
    {
      Id = "Medea_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga. Kalau begitu aku tahu monster mana yang kaumaksud. Dan kau berniat menantangnya beserta yang lainnya? Kau benar-benar gila, penyihir...! Tapi seisi dunia pun demikian."
      Speaker = "Medea"
      Event = "MedeaAboutTyphon01"
    }
    {
      Id = "Medea_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, menghadapi masa-masa bencana dahsyat begini, beserta seluruh tragedi ini! Benar-benar malam-malam yang tak terlupakan. Bagaimana kelanjutan perjalananmu ke tempat terkutuk yang disebut rumah oleh para dewa itu?"
      Speaker = "Medea"
      Event = "MedeaAboutOlympus01"
    }
    {
      Id = "MelinoeField_3935"
      InheritFrom = "BaseNarrative"
      DisplayName = "Singkat kata, penuh gejolak! Racikanmu sangat berguna di sepanjang jalan. Dulu kukira sihir semacam itu hanya berfokus pada satu korban dalam satu waktu."
      Speaker = "Melinoe"
      Event = "MedeaAboutOlympus01"
    }
    {
      Id = "Medea_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Capailah tingkatan tertentu, maka dunia ini sendiri bisa menjadi target tunggal dari amarahmu. Teruslah berlatih, penyihir! Kita tak pernah kekurangan musuh untuk menerapkan keahlian kita."
      Speaker = "Medea"
      Event = "MedeaAboutOlympus01"
    }
    {
      Id = "Medea_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewa-dewi Olympus pasti mengerahkan para pembela terkuat mereka ke medan tempur. Tapi sependengaranku, mereka masih terlalu bergantung pada Otomaton demi kebaikan mereka sendiri."
      Speaker = "Medea"
      Event = "MedeaAboutTalos01"
    }
    {
      Id = "MelinoeField_4735"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang kau dengar terdengar seperti apa yang akan kukatakan. Otomaton Gunung Olympus menutupi ketiadaan kecerdasan berpikir mereka dengan kekuatan adamantin yang luar biasa. Yang bernama Talos adalah yang terburuk di antara mereka."
      Speaker = "Melinoe"
      Event = "MedeaAboutTalos01"
    }
    {
      Id = "Medea_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka masih punya Talos setelah sekian lama? Kemungkinan besar sudah diperbaiki sejak terakhir kali kami bertemu; dulu tak banyak yang tersisa dari dirinya."
      Speaker = "Medea"
      Event = "MedeaAboutTalos01"
    }
    {
      Id = "Medea_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kabar Hecate Agung di tengah malam-malam yang penuh pertanda buruk ini? Akhir-akhir ini dia jarang sekali punya kesempatan untuk menerangi tempat ini..."
      Speaker = "Medea"
      Event = "MedeaAboutHecate01"
    }
    {
      Id = "MelinoeField_0337"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kepala Sekolah tampak baik-baik saja. Aku belum pernah melihat kesulitan membuatnya goyah. Tapi ya, mungkin beliau mengenakan cadar itu agar tidak pernah memperlihatkan secuil pun keraguan."
      Speaker = "Melinoe"
      Event = "MedeaAboutHecate01"
    }
    {
      Id = "Medea_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita semua mengenakan cadar, bukan begitu, Penyihir? Hecate yang Agung hanya menanggalkan segala kepura-puraan tentang hal itu. Yah, syukurlah kalau beliau masih seperti yang kukenal. Dan aku tetap menjadi pelayannya yang setia di sini."
      Speaker = "Medea"
      Event = "MedeaAboutHecate01"
    }
    {
      Id = "MelinoeField_4727"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau kebetulan melihat Nona Artemis di sekitar sini? Beliau berburu di hutan kami maupun di Ephyra ini, meski akhir-akhir ini aku belum melihatnya di permukaan."
      Speaker = "Melinoe"
      Event = "MedeaAboutArtemis01"
    }
    {
      Id = "Medea_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir-pikir, baru-baru ini aku memang mencium aroma makhluk hidup, dengan wangi yang, bagaimana mengatakannya ya, semacam aroma gembala. Kukira itu Kiklops Penggembala, tapi mungkin saja itu sang dewi perburuan!"
      Speaker = "Medea"
      Event = "MedeaAboutArtemis01"
    }
    {
      Id = "MelinoeField_4728"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nona Medea, terlepas dari ketajaman inderamu terhadap yang hidup dan yang mati, kau tak bisa membedakan Artemis kita yang anggun dengan Kiklops dekil itu?"
      Speaker = "Melinoe"
      Event = "MedeaAboutArtemis01"
    }
    {
      Id = "Medea_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak bisa, Penyihir... karena mereka berdua sama-sama merasa pantas menyelimuti diri dari ujung kepala sampai ujung kaki dengan bulu binatang, yang membuat mereka bau apek. Kau pasti akan menyadarinya mulai sekarang setelah kukatakan ini."
      Speaker = "Medea"
      Event = "MedeaAboutArtemis01"
    }
    {
      Id = "Medea_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tukang Perahu Charon menyediakan segala macam perbekalan untukmu, aku tahu itu, tapi sejauh ini aku belum berhasil membujuknya agar mau berbagi denganku. Dari sesama penyihir... ada saran?"
      Speaker = "Medea"
      Event = "MedeaAboutCharon01"
    }
    {
      Id = "MelinoeField_4733"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bukan orang pertama yang kesulitan berkomunikasi dengannya, tapi entah kenapa, beliau dan aku tampaknya punya semacam ikatan. Aku bisa memohonkan sesuatu padanya atas namamu?"
      Speaker = "Melinoe"
      Event = "MedeaAboutCharon01"
    }
    {
      Id = "Medea_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu akan sangat memalukan, {#Emph}jangan! {#Prev}Aku lebih rela hidup membujang seperti pertapa daripada merendahkan diri dengan mengemis bantuan. Aku pasti akan menemukan cara untuk menembus pertahanannya."
      Speaker = "Medea"
      Event = "MedeaAboutCharon01"
    }
    {
      Id = "Medea_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahukah kau, akhirnya aku berhasil membujuk Tukang Perahu Charon untuk memberiku jatah dari perbekalannya! Dia benar-benar makhluk yang keras kepala."
      Speaker = "Medea"
      Event = "MedeaAboutCharon02"
    }
    {
      Id = "MelinoeField_4734"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, syukurlah kalau begitu. Aku tak begitu paham kenapa beliau menahan barang dagangannya darimu sejak awal. Bagaimana caramu membujuknya?"
      Speaker = "Melinoe"
      Event = "MedeaAboutCharon02"
    }
    {
      Id = "Medea_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, begitulah, aku sebenarnya tak boleh mengatakannya. Dan lagipula {#Emph}dia {#Prev}juga takkan membocorkannya! Kau tak benar-benar memahaminya, kan...?"
      Speaker = "Medea"
      Event = "MedeaAboutCharon02"
    }
    {
      Id = "Medea_0595"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mulai sekarang mestinya bakal lebih mudah untuk memenuhi kewajiban kita terhadap kehendak Malam, karena Nyx sendiri akhirnya telah kembali bersama kita. Kudengar semua itu berkat dirimu?"
      Speaker = "Medea"
      Event = "MedeaAboutNyx01"
    }
    {
      Id = "MelinoeField_4721"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nyx disandera di Istana Hades bersama keluarga intiku dan yang lainnya. Sebuah kehormatan bisa bertemu dengannya secara langsung... kami berutang budi begitu banyak padanya."
      Speaker = "Melinoe"
      Event = "MedeaAboutNyx01"
    }
    {
      Id = "Medea_0596"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, tanpa bermaksud lancang pada dewa, menurutku dia yang berutang {#Emph}padamu {#Prev}sekarang, Penyihir. Namun, memang benar bila bukan karenanya, tak banyak hasil risetku yang bisa membuahkan hasil."
      Speaker = "Medea"
      Event = "MedeaAboutNyx01"
    }
    {
      Id = "Medea_0582"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat cahaya itu pada dirimu; kekuatan Selene. Aku ingin memperjelas bahwa aku sama sekali tak punya masalah dengannya. Beliau tak perlu menyambarku dan merusak semua pekerjaanku."
      Speaker = "Medea"
      Event = "MedeaAboutSelene01"
    }
    {
      Id = "MelinoeField_4719"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah ada perselisihan di antara kalian berdua yang perlu kuketahui, Nona Medea? Aku bekerja sama erat dengan Saudari Selene, jadi beri tahu jika ada yang bisa kubantu."
      Speaker = "Melinoe"
      Event = "MedeaAboutSelene01"
    }
    {
      Id = "Medea_0583"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kecuali kau bisa membujuknya meredupkan cahaya yang—harus kuakui—cukup mencolok itu, maka kurasa tidak ada yang bisa kaulakukan. Terkadang aku iri pada kenalan-kenalanmu yang hidup di bawah Tanah..."
      Speaker = "Medea"
      Event = "MedeaAboutSelene01"
    }
    {
      Id = "Medea_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ngomong-ngomong, aku ingin memperingatkanmu agar tidak berurusan dengan pria kekar berambut surai singa yang kadang berkeliaran di jalanan sana..."
      Speaker = "Medea"
      Event = "MedeaAboutHeracles01"
    }
    {
      Id = "MelinoeField_0331"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maksudmu pasti Heracles. Kami sudah bertemu, dan kusimpulkan memang sebaiknya aku menjaga jarak. Dia bilang dia melayani para dewa, tapi... apa dia ancaman?"
      Speaker = "Melinoe"
      Event = "MedeaAboutHeracles01"
    }
    {
      Id = "Medea_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, dia cuma perusak suasana! Aku menyembuhkan luka-lukanya tapi dia terus menambah luka baru, dan bahkan {#Emph}aku {#Prev}pun belum memiliki kekuatan untuk menyembuhkan jiwanya. Orang mati saja lebih ceria daripada pria macam dia. Nah, kemarilah! Ada kutukan yang harus kuracik."
      Speaker = "Medea"
      Event = "MedeaAboutHeracles01"
    }
    {
      Id = "Medea_0591"
      InheritFrom = "BaseNarrative"
      DisplayName = "Heracles yang selalu bermuram durja itu terus mengamuk ke sana kemari. Dia tidak membuatmu terlalu repot, kan? Aku bisa menimpakan lebih banyak kutukan padanya jika kau mau, meski aku khawatir khasiatnya makin berkurang."
      Speaker = "Medea"
      Event = "MedeaAboutHeracles02"
    }
    {
      Id = "MelinoeField_4741"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa aku masih bisa mengatasinya, tapi terima kasih atas tawarannya. Kedengarannya kalian berdua saling mengenal dengan cukup baik."
      Speaker = "Melinoe"
      Event = "MedeaAboutHeracles02"
    }
    {
      Id = "Medea_0592"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau kan sudah bertemu kami, Penyihir! Dia dan aku sedekat Bulan dengan Bumi. Tapi dengan menjaga jarak, kami justru menjadi lebih dekat dengan cara tersendiri. Karena Bulan pun harus beristirahat pada waktunya."
      Speaker = "Medea"
      Event = "MedeaAboutHeracles02"
    }
    {
      Id = "Medea_0593"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sesuatu yang semula kukira burung pemangsa raksasa ternyata adalah Roh Arwah dengan sayap buatan! Aku hampir tak memercayai mataku sendiri. Pernahkah kau menemui makhluk semacam itu di luar sana?"
      Speaker = "Medea"
      Event = "MedeaAboutIcarus01"
    }
    {
      Id = "MelinoeField_4742"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir yang kaumaksud adalah Icarus, jadi ya; dan dia ada di pihak kita! Dia sering membantuku saat menjelajahi Celah. Dan dia adalah murid Daedalus sendiri!"
      Speaker = "Melinoe"
      Event = "MedeaAboutIcarus01"
    }
    {
      Id = "Medea_0594"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau terdengar sangat bersemangat tentangnya! Untunglah aku sempat ragu sebelum mengutuk sayapnya sampai membusuk. Kubayangkan kau pasti tidak akan setuju."
      Speaker = "Medea"
      Event = "MedeaAboutIcarus01"
    }
    {
      Id = "Medea_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa konyolnya gagasan tentang keluarga, Penyihir. Bahwa kita konon memiliki ikatan batiniah dengan orang-orang yang berbagi darah dengan kita! Kau sudah bertemu Bibiku Circe; apa menurutmu kami berdua ada mirip-miripnya?"
      Speaker = "Medea"
      Event = "MedeaAboutCirce01"
    }
    {
      Id = "MelinoeField_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "Madame Circe tampak sangat berdedikasi pada ilmu sihir kita dengan caranya sendiri. Hanya saja, tidak sama sepertimu, Nona Medea. Apakah kau begitu enggan mengira bahwa kalian berdua mungkin memiliki kesamaan?"
      Speaker = "Melinoe"
      Event = "MedeaAboutCirce01"
    }
    {
      Id = "Medea_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Circe tak pernah mau memaksakan ilmu kita hingga batas terdalam yang bisa dicapainya. Dia cuma mengubah manusia fana menjadi ternak; sementara {#Emph}aku {#Prev}mengubah mereka jadi mayat. Perbedaan pendekatan saja, mungkin..."
      Speaker = "Medea"
      Event = "MedeaAboutCirce01"
    }
    {
      Id = "MelinoeField_4737"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bila kau tak keberatan kutanya, apakah kau dan Nona Circe tak lagi saling berkomunikasi sama sekali? Aku tahu jalan menuju pulaunya, seandainya kau ingin mengunjunginya untuk suatu urusan."
      Speaker = "Melinoe"
      Event = "MedeaAboutCirce02"
    }
    {
      Id = "Medea_0575"
      InheritFrom = "BaseNarrative"
      DisplayName = "Alasanku mengunjungi Bibiku di habitat anehnya itu bukanlah hal yang sudi kujelaskan. Mengapa pikiran semacam itu sampai terlintas di benakmu?"
      Speaker = "Medea"
      Event = "MedeaAboutCirce02"
    }
    {
      Id = "MelinoeField_4738"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedengarannya kalian berdua memang tidak terlalu akur. Aku bersyukur bisa mengenal paman-pamanku dan yang lainnya di Olympus, jadi kupikir... mungkin ada baiknya kau bertemu bibimu lagi."
      Speaker = "Melinoe"
      Event = "MedeaAboutCirce02"
    }
    {
      Id = "Medea_0576"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepanjang hidupku, orang lain selalu sok tahu apa yang terbaik untukku, termasuk dirinya. Kusarankan kau jangan sampai melakukan kesalahan yang sama. Aku tak merasa punya kewajiban apa pun pada keluarga sedarah; aku sendirilah yang memilih kepada siapa hatiku terikat."
      Speaker = "Medea"
      Event = "MedeaAboutCirce02"
    }
    {
      Id = "MelinoeField_3813"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mau bilang, Tuan Hypnos masih tertidur lelap di Persimpangan. Aku sudah mencoba Uap Mimpi padanya tapi tak ada hasil. Apa kau terpikir sesuatu yang lebih manjur, mungkin?"
      Speaker = "Melinoe"
      Event = "MedeaGrantsHypnosSpell01"
    }
    {
      Id = "Medea_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku tahu cara membuat Uap Mimpi {#Emph}jauh lebih {#Prev}mujarab, wahai penyihir! Khasiatnya bahkan sanggup membangkitkan orang mati. Soal putra Nyx yang tertidur lelap itu, entahlah, siapa yang tahu? Tapi tak ada ruginya mencoba!"
      Speaker = "Medea"
      Event = "MedeaGrantsHypnosSpell01"
    }
    {
      Id = "MelinoeField_3948"
      InheritFrom = "BaseNarrative"
      DisplayName = "Uap Mimpimu yang lebih kuat membantuku menembus lebih dalam ke sukma Tuan Hypnos, tapi sayangnya belum cukup dalam. Dia masih tertidur pulas. Ada hal lain yang bisa kucoba?"
      Speaker = "Melinoe"
      Event = "MedeaGrantsHypnosSpell02"
    }
    {
      Id = "Medea_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, selalu ada cara. Mengacak-acak isi pikirannya, barangkali? Kau sudah coba menikamnya berkali-kali?"
      Speaker = "Medea"
      Event = "MedeaGrantsHypnosSpell02"
    }
    {
      Id = "MelinoeField_3949"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lebih memikirkan keterhubungannya dengan saudaranya, sang penjelmaan Kematian. Adakah cara untuk meresapkan esensi kematian ke dalam Uap Mimpi?"
      Speaker = "Melinoe"
      Event = "MedeaGrantsHypnosSpell02"
    }
    {
      Id = "Medea_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja bisa, sifat Tidur dan Kematian memang selalu berjalan beriringan. Kurasa aku bisa mengarahkanmu ke jalan yang benar soal itu! Ceritakan hasilnya nanti padaku, ya...?"
      Speaker = "Medea"
      Event = "MedeaGrantsHypnosSpell02"
    }
    {
      Id = "MelinoeField_4231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku berhasil membangunkannya, Nyonya Medea! Maksudku, Tuan Hypnos. Terima kasih atas semua petunjukmu mengenai Uap Mimpi. Wangsa Hades berutang budi besar padamu."
      Speaker = "Melinoe"
      Event = "MedeaAboutHypnos01"
    }
    {
      Id = "Medea_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar gembira seperti itulah yang ingin kudengar! Yang kupinta sebagai imbalannya hanyalah agar gerbang Dunia Bawah tetap terbuka untuk beberapa waktu ke depan. Banyak hal yang masih harus kujelajahi bersama para arwah..."
      Speaker = "Medea"
      Event = "MedeaAboutHypnos01"
    }
    {
      Id = "Medea_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah! {#Prev}Kau membawa cahaya dari Apollo sendiri! Ingat saja, dia bukan satu-satunya sosok yang sanggup menebarkan wabah mematikan di sekitar sini."
      Speaker = "Medea"
      Event = "MedeaAboutApollo01"
    }
    {
      Id = "MelinoeField_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakat Apollo memang luar biasa luas. Jadi, dia terkadang menjatuhkan wabah pada umat manusia? Apa kau tahu alasannya?"
      Speaker = "Melinoe"
      Event = "MedeaAboutApollo01"
    }
    {
      Id = "Medea_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengapa para dewa melakukan apa pun? Tentu saja karena mereka bisa! Lagi pula, sesekali menebar wabah bagus untuk menertibkan rakyat jelata."
      Speaker = "Medea"
      Event = "MedeaAboutApollo01"
    }
    {
      Id = "Medea_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hera yang agung memilih meminjamkan kekuatannya padamu, jika inderaku tak keliru. Kau keluarganya, dan datang membela dirinya. Barangkali dia akan berbaik hati padamu!"
      Speaker = "Medea"
      Event = "MedeaAboutHera01"
    }
    {
      Id = "MelinoeField_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sejauh ini memang begitu. Aku tahu para dewa bisa menjaga diri mereka sendiri, tapi sepertinya kami saling memahami dan punya kepentingan yang sama saat ini."
      Speaker = "Melinoe"
      Event = "MedeaAboutHera01"
    }
    {
      Id = "Medea_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pragmatis sekali. Tapi memang itulah sikap yang tepat di hadapan para dewa, menurutku! Kau tak perlu meragukan bantuanku. Hecate Agung menghendakinya, maka bantuan ini akan menjadi milikmu."
      Speaker = "Medea"
      Event = "MedeaAboutHera01"
    }
    {
      Id = "Medea_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, bukankah itu Wujud Tengkorak Perak Revaal milikku sendiri? Sudah lama sekali sejak terakhir kali kukerahkan amarah liarnya yang dahsyat. Apakah dia bersikap patuh padamu hampir setiap saat?"
      Speaker = "Medea"
      Event = "MedeaAboutMedeaAspect01"
    }
    {
      Id = "MelinoeField_3936"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, tapi... Tengkorak Perak itu, kau membicarakannya seolah dia adalah makhluk hidup, bukan sekadar senjata atau alat. Bahkan sampai sekarang, aku terkadang masih menyamakan keduanya dengan Senjata Malam."
      Speaker = "Melinoe"
      Event = "MedeaAboutMedeaAspect01"
    }
    {
      Id = "Medea_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senjata-senjata itu dikenal dengan banyak sebutan berbeda, dan kurasa mereka tak peduli mana yang kau pilih. Mereka mendambakan {#Emph}jiwa{#Prev}, bukan etika tutur kata. Jadi, tolong manjakan dia untukku."
      Speaker = "Medea"
      Event = "MedeaAboutMedeaAspect01"
    }
    {
      Id = "Medea_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artefak yang kau bawa itu... Revaal sendiri! Tapi dalam rupa sosok yang hadir di mimpiku. Kalau begitu kalimat yang kuberitahukan padamu membuahkan hasil... apa lagi yang berhasil kau singkap?"
      Speaker = "Medea"
      Event = "MedeaAboutHiddenAspect01"
    }
    {
      Id = "MelinoeField_3937"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini adalah Wujud dari sesosok dewi bernama Hel, yang berkuasa atas alam kematian nan jauh yang diselimuti putihnya embun beku. Bagaimana bisa dia akhirnya menyandang Revaal, aku tak tahu."
      Speaker = "Melinoe"
      Event = "MedeaAboutHiddenAspect01"
    }
    {
      Id = "Medea_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi Hel ini rupanya punya selera tinggi! Barangkali di suatu malam yang dingin membeku, {#Emph}akulah {#Prev}yang pertama kali akan mengenalkannya pada kekuatan memabukkan Tengkorak Perak...! Atau mungkin {#Emph}kau!"
      Speaker = "Medea"
      Event = "MedeaAboutHiddenAspect01"
    }
    {
      Id = "Medea_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para arwah begitu tertarik padamu, wahai penyihir; kulihat itu dengan jelas! Bahkan Tengkorak Revaal pasti memuja tanah tempatmu berpijak! Sebenarnya, baru-baru ini aku memimpikannya..."
      Speaker = "Medea"
      Event = "MedeaGrantsHiddenAspect01"
    }
    {
      Id = "MelinoeField_3498"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari semua Senjata Malam, ikatan Revaal dengan orang mati barangkali adalah yang terkuat. Apa yang terjadi dalam mimpimu?"
      Speaker = "Melinoe"
      Event = "MedeaGrantsHiddenAspect01"
    }
    {
      Id = "Medea_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu membuat bulu kudukku meremang. Aku berada di Dunia Bawah, tapi bukan yang kita kenal! Tempat itu begitu dingin... dan di sana duduk seorang Ratu yang garang; bukan ibumu, tentu saja. Lalu dia melantunkan, {#Emph}Kulihat kau kumpulkan arwah tak terhitung di alam nan dingin dan gulita."
      Speaker = "Medea"
      Event = "MedeaGrantsHiddenAspect01"
    }
    {
      Id = "MelinoeField_3499"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kulihat kau kumpulkan arwah tak terhitung di alam nan dingin dan gulita. {#Prev}Dia pasti memberimu kalimat pembangun! Apa dia mengira kau masih menjadi penyandang Tengkorak Perak?"
      Speaker = "Melinoe"
      Event = "MedeaGrantsHiddenAspect01"
    }
    {
      Id = "Medea_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa tidak... karena sosok yang kami lihat menyandang Tengkorak itu adalah {#Emph}kau{#Prev}, bukan {#Emph}aku. {#Prev}Waktuku bersamanya sudah usai untuk saat ini. Waktumu, tampaknya, baru saja dimulai..."
      Speaker = "Medea"
      Event = "MedeaGrantsHiddenAspect01"
    }
    {
      Id = "Medea_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengenai mimpiku tentang tengkorak Revaal... sudahkah kau mencoba menggunakan mantra yang kuberi tahu tempo hari?"
      Speaker = "Medea"
      Event = "MedeaAboutHiddenAspectProgress01"
    }
    {
      Id = "MelinoeField_3946"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum, Nyonya Medea... Aku ragu mengucapkannya di depan Kolam Perak sebelum yakin dampak apa yang akan ditimbulkannya."
      Speaker = "Melinoe"
      Event = "MedeaAboutHiddenAspectProgress01"
    }
    {
      Id = "Medea_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuatkan nyalimu, wahai penyihir. Eksperimen membutuhkan kesiapan menghadapi hasil yang tak terduga. Sekarang ingat baik-baik ucapannya, {#Emph}Kulihat kau kumpulkan arwah tak terhitung di alam nan dingin dan gulita. {#Prev}Pasti akan baik-baik saja!"
      Speaker = "Medea"
      Event = "MedeaAboutHiddenAspectProgress01"
    }
    {
      Id = "MelinoeField_3811"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada keperluan apa Menara Tiang ini berserakan di mana-mana, Nyonya Medea? Benda-benda itu mengendalikan pembatas di depan dermaga, itu sudah jelas. Mungkin legiun Titan menggunakannya untuk mengoordinasikan serangan."
      Speaker = "Melinoe"
      Event = "MedeaAboutPylons01"
    }
    {
      Id = "Medea_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benda-benda itu adalah buah karya dari pikiran yang sangat sakit. Mengurung begitu banyak Arwah di wadah sekecil itu demi menguras habis Sukma mereka! Bisa kau bayangkan, wahai penyihir?"
      Speaker = "Medea"
      Event = "MedeaAboutPylons01"
    }
    {
      Id = "MelinoeField_3812"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mengerikan sekali! Aku tak menyangka Menara Tiang bekerja seperti itu. Tapi siapa yang terus memperbaikinya? Kau bahkan punya satu di {#Emph}sini!"
      Speaker = "Melinoe"
      Event = "MedeaAboutPylons01"
    }
    {
      Id = "Medea_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benda menjijikkan itu menolak untuk {#Emph}lenyap! {#Prev}Terus memadat kembali hampir setiap malam! Tapi karena aku begitu sibuk dengan kualiku, aku jarang memedulikannya..."
      Speaker = "Medea"
      Event = "MedeaAboutPylons01"
    }
    {
      Id = "Medea_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhir-akhir ini hujan turun cukup sering. Sangat bagus untuk menyebarkan sedikit wabah ke mana-mana. Kecuali jika cuaca begini bukan seleramu, wahai penyihir?"
      Speaker = "Medea"
      Event = "MedeaAboutRain01"
    }
    {
      Id = "MelinoeField_4726"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak keberatan; dengan hujan ini, maksudku. Aku malah sering tak menyadarinya. Dan cuaca di sini benar-benar tenang jika dibandingkan dengan kondisi di puncak Olimpus saat ini."
      Speaker = "Melinoe"
      Event = "MedeaAboutRain01"
    }
    {
      Id = "Medea_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap aku bisa menyaksikannya sendiri. Mengenai penelitianku, semakin tak layak huni kondisi di sekitarku, semakin lekas aku memperoleh hasil."
      Speaker = "Medea"
      Event = "MedeaAboutRain01"
    }
    {
      Id = "Medea_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat ada makhluk hidup lain selain dirimu! Mereka cukup langka di kota ini belakangan ini, tentu saja di luar burung-burung pemangsa. Kuduga kau punya lebih dari satu Hewan Akrab?"
      Speaker = "Medea"
      Event = "MedeaAboutFamiliars01"
    }
    {
      Id = "MelinoeField_4725"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, jadi kumohon jauhkan yang satu ini dari eksperimenmu, Nyonya Medea. Aku kadang bertanya-tanya mengapa kau sendiri tak punya Familiar, ya walau hanya untuk sekadar teman."
      Speaker = "Melinoe"
      Event = "MedeaAboutFamiliars01"
    }
    {
      Id = "Medea_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, aku pernah mencoba memikat salah satu Burung Paruh Tembaga yang mematuki bangkai di luar sana, tapi hubungan itu tak bertahan lama. Mengurus makhluk hidup bisa jadi beban yang merepotkan..."
      Speaker = "Medea"
      Event = "MedeaAboutFamiliars01"
    }
    {
      Id = "Medea_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana rasanya berada di Kediaman ayahmu, aku selalu penasaran, wahai penyihir? Dia bisa memilih siapa pun sesuka hati dari barisan orang mati... Arwah Orpheus yang membawakan lagu-lagu dan semacamnya!"
      Speaker = "Medea"
      Event = "MedeaAboutHouse01"
    }
    {
      Id = "MelinoeField_4743"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kediaman itu masih dalam tahap pemugaran, tapi kemegahannya tetap tiada tara. Dan Ayah memang mempekerjakan banyak Arwah mulia... pahlawan Achilles, pengawal kerajaannya; Theseus yang pemberani, sang juara Elysium..."
      Speaker = "Melinoe"
      Event = "MedeaAboutHouse01"
    }
    {
      Id = "Medea_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Achilles yang perkasa...! Aku selalu mendambakan untuk bertemu dengannya, tapi kalau Theseus muda... sepertinya aku pernah meracuni hubungan itu beberapa waktu silam. Ah, sudahlah!"
      Speaker = "Medea"
      Event = "MedeaAboutHouse01"
    }
    {
      Id = "Medea_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hecate Agung memberitahuku bahwa kau sering melintasi Padang Ratapan. Ada sesuatu yang ingin kuminta, meski ini agak membebaniku; demi sebuah ramuan yang sangat ingin kuselesaikan."
      Speaker = "Medea"
      Event = "MedeaAboutConcoctionQuest01"
    }
    {
      Id = "MelinoeField_4332"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu tak ada salahnya meminta, Nyonya Medea. Apa yang kau cari, dan untuk tujuan apa?"
      Speaker = "Melinoe"
      Event = "MedeaAboutConcoctionQuest01"
    }
    {
      Id = "Medea_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku butuh uap dari Air Mata yang ditumpahkan oleh jiwa-jiwa malang yang merana di tempat itu. Jika kau berkenan mengumpulkan beberapa Air Mata, meniatkannya untukku, lalu mengambil sari rebusannya dari Belangamu, aku akan sangat berterima kasih."
      Speaker = "Medea"
      Event = "MedeaAboutConcoctionQuest01"
    }
    {
      Id = "MelinoeField_4333"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan ramuan macam apa yang bisa tercipta, setelah kau memiliki sari-sari kesedihan itu?"
      Speaker = "Melinoe"
      Event = "MedeaAboutConcoctionQuest01"
    }
    {
      Id = "Medea_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ramuan yang akan membawa manfaat luar biasa bagi kita berdua. Kau tak perlu sampai bersusah payah berlebihan, tentu saja."
      Speaker = "Medea"
      Event = "MedeaAboutConcoctionQuest01"
    }
    {
      Id = "Medea_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah, kau datang tepat waktu. Air Mata yang kau bawakan adalah sentuhan akhir yang kucari untuk sesuatu yang telah lama kuteliti. Aku dengan senang hati menawarkan sampelnya padamu sekarang, jika kau berminat?"
      Speaker = "Medea"
      Event = "MedeaAboutConcoctionQuestComplete01"
    }
    {
      Id = "Medea_0581"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan takut pada apa pun, penyihir, setidaknya bukan dariku di sini. Di luar gerbang kota, aku akan menguji tekadmu setiap kali kau mengucap Sumpah; tapi di apotek ini—begitu aku menyebutnya—aku hanya menguji kemujaraban ramuanku dan semacamnya."
      Speaker = "Medea"
      Event = "MedeaAboutAltFight01"
    }
    {
      Id = "MelinoeField_3809"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kau bertarung melawanku dengan dendam kesumat seperti itu, Nyonya Medea. Jika ada perselisihan di antara kita, aku ingin tahu apa penyebabnya."
      Speaker = "Melinoe"
      Event = "MedeaAboutAltFight01"
    }
    {
      Id = "Medea_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Buang jauh-jauh pikiran itu! Aku hanya ingin kau tak lengah terhadap {#Emph}siapa pun. {#Prev}Lagipula, tak ada istilah darah kotor bagi kaum dengan kecenderungan seperti {#Emph}kita. {#Prev}Semua darah ada gunanya."
      Speaker = "Medea"
      Event = "MedeaAboutAltFight01"
    }
    {
      Id = "Medea_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehendak Malam memanggilku sekali lagi... sungguh {#Emph}memuakkan{#Prev}, aku harus mengutuk musuh-musuh kita, hanya untuk berdiri di barisan mereka bersama Cyclops mengerikan itu tak lama kemudian!"
      Speaker = "Medea"
      Event = "MedeaAboutAltFight02"
    }
    {
      Id = "MelinoeField_3810"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutukan yang kau tawarkan padaku ini mungkin berdampak buruk padanya... tapi kurasa tidak bagimu. Namun, bukankah kutukan sering kali berbalik menyerang pembuatnya?"
      Speaker = "Melinoe"
      Event = "MedeaAboutAltFight02"
    }
    {
      Id = "Medea_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutukan dari seorang amatir, sudah pasti, tapi kutukan {#Emph}milikku? Hmhmhmhmhmhm{#Prev}, tentu tidak. Yah, setidaknya ini akan sangat mendidik! Sampai jumpa lagi di luar gerbang nanti."
      Speaker = "Medea"
      Event = "MedeaAboutAltFight02"
    }
    {
      Id = "Medea_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebenarnya apa pangkal perselisihan antara dirimu dan Cyclops Polyphemus itu, wahai penyihir? Ada sensasi tersendiri melihat kalian bertarung, tapi aku lebih suka mengetahui riwayatnya."
      Speaker = "Medea"
      Event = "MedeaAboutAltFight03"
    }
    {
      Id = "MelinoeField_3933"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada riwayat apa pun! Malam pertama aku mencoba meninggalkan kota, dia sudah ada di sana. Sejak itu dia selalu berusaha memangsaku. Dia pasti bekerja untuk Chronos... atau pernah, pada suatu masa."
      Speaker = "Melinoe"
      Event = "MedeaAboutAltFight03"
    }
    {
      Id = "Medea_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia hanyalah seorang gembala. Barangkali kalian bertemu saat perutnya sedang kosong, itu bisa membuat siapa saja naik darah. Tapi, lakukan apa yang harus kau lakukan! Aku hanya akan turun tangan jika Sumpah menuntutnya."
      Speaker = "Medea"
      Event = "MedeaAboutAltFight03"
    }
    {
      Id = "Medea_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memutuskan untuk mencabut Ikrar Persaingan untuk saat ini? Aku sama sekali tak menyalahkanmu. Meski itu sangat mendebarkan bagiku, aku menghargai keheningan tanpa gangguan di sini."
      Speaker = "Medea"
      Event = "MedeaAboutAltFight04"
    }
    {
      Id = "MelinoeField_3934"
      InheritFrom = "BaseNarrative"
      DisplayName = "Polyphemus pasti merindukan kehadiranmu. Aku masih terkejut melihat kalian berdua tampak sangat akrab... Aku tak habis pikir apa kesamaan kalian."
      Speaker = "Melinoe"
      Event = "MedeaAboutAltFight04"
    }
    {
      Id = "Medea_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, kurasa kau takkan paham... tapi, dia tak perlu melihatku terus-menerus. Dia seorang gembala, jadi tipenya cukup penyabar. Kau kemungkinan besar akan mengucap Sumpah itu lagi, dan kita semua akan {#Emph}bercengkerama kembali."
      Speaker = "Medea"
      Event = "MedeaAboutAltFight04"
    }
    {
      Id = "Medea_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan tatapanku yang kurang ajar, penyihir, tapi kau jelas-jelas menderita dalam perjalananmu... bolehkah aku mengambil sedikit sampel darahmu?"
      Speaker = "Medea"
      Event = "MedeaLowHealth01"
    }
    {
      Id = "MelinoeField_3947"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, terima kasih, Nyonya Medea. Malamku sudah dimulai dengan cukup buruk. Selama aku masih bisa menyelamatkannya entah bagaimana."
      Speaker = "Melinoe"
      Event = "MedeaLowHealth01"
    }
    {
      Id = "Medea_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, terserah padamu. Dan jika ini bisa membuatmu merasa lebih baik, musuh-musuh kita sebentar lagi akan menderita penyakit yang jauh lebih parah."
      Speaker = "Medea"
      Event = "MedeaLowHealth01"
    }
    {
      Id = "Medea_0585"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku nyaris mengiramu tumpukan bangkai berjalan melihat betapa banyaknya darah kehidupan yang telah hilang darimu! Baiklah, biarkan aku membantumu menuntut balas setidaknya."
      Speaker = "Medea"
      Event = "MedeaLowHealth02"
    }
    {
      Id = "Medea_0586"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau terlihat mengerikan sekali, maafkan keterus-teranganku, wahai penyihir! Apa yang telah dilakukan oleh para cecunguk membusuk di luar sana kepadamu?"
      Speaker = "Medea"
      Event = "MedeaLowHealth03"
    }
    {
      Id = "Medea_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebagian besar praktisi ilmu kita pasti sudah mengecam eksperimenku, atau setidaknya memalingkan hidung mereka dengan jijik. Tapi bukan dirimu, wahai penyihir. Kupuji keteguhan nyalimu."
      Speaker = "Medea"
      Event = "MedeaAboutExperiments01"
    }
    {
      Id = "MelinoeField_3940"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eksperimenmu, sebagaimana kau menyebutnya, bukanlah hakku untuk menghakiminya. Itu hanya akan membuatku tak ada bedanya dengan orang lain yang salah memahami hakikat dari apa yang kita lakukan."
      Speaker = "Melinoe"
      Event = "MedeaAboutExperiments01"
    }
    {
      Id = "Medea_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, aku cukup menikmati betapa hampir tak ada yang berani mendekati kita karena takut kita akan murka. Mungkin bukan hal yang baik untuk jangka panjang, tapi untuk saat ini? Aku bisa bereksperimen dengan tenang. Meski begitu, kau selalu diterima di sini."
      Speaker = "Medea"
      Event = "MedeaAboutExperiments01"
    }
    {
      Id = "Medea_0584"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, syukurlah suasananya nyaman dan gelap untuk saat ini! Bulan baru adalah saat favoritku setiap bulannya... awal yang baru, peluang baru... dan sangat sedikit cahaya."
      Speaker = "Medea"
      Event = "MedeaAboutMoon01"
    }
    {
      Id = "Medea_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hecate Agung sendiri berbaik hati memberitahuku tentang sepak terjang terbarumu, penyihir. Dan aku takkan percaya sepatah kata pun andai kabar itu datang dari makhluk {#Emph}lain {#Prev}selain dirinya. Jadi, Sang Penguasa Titan benar-benar sudah ditundukkan?"
      Speaker = "Medea"
      Event = "MedeaPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya begitu, Nyonya Medea. Dan monster mengerikan yang membayangi Olympus juga sudah lenyap. Beberapa sisa ancaman keduanya masih ada, tapi kurasa kami bisa mengatasinya."
      Speaker = "Melinoe"
      Event = "MedeaPostTrueEnding01"
    }
    {
      Id = "Medea_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau rupanya bisa mengatasi {#Emph}apa pun. {#Prev}Satu-satunya kekhawatiranku adalah ini berarti kita mungkin takkan sering bertemu seperti sebelumnya, dan... apakah aku akan terpaksa meninggalkan Ephyra segera? Supaya kaum fana bisa merampas watak asli kota ini..."
      Speaker = "Medea"
      Event = "MedeaPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan masalah mendesak untuk sekarang. Dunia Bawah tidak akan kembali seperti semula dalam waktu dekat; orang-orang mati masih harus terpuruk lebih lama lagi."
      Speaker = "Melinoe"
      Event = "MedeaPostTrueEnding01"
    }
    {
      Id = "Medea_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, sungguh {#Emph}sangat mengerikan! {#Prev}Tapi itu hanya untuk orang mati. Kalau untukku sendiri, ya ampun... {#Emph}aku {#Prev}bahkan tak tahu harus {#Emph}mengutuk {#Prev}siapa!"
      Speaker = "Medea"
      Event = "MedeaPostTrueEnding01"
    }
    {
      Id = "Medea_0599"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hekate Agung masih belum memberitahuku bagaimana tepatnya kau berhasil memicu semacam kebangkitan kembali pada diri Sang Penguasa Titan. Itu jelas bukan kutukan biasa... masih banyak sekali yang belum dia ajarkan padaku."
      Speaker = "Medea"
      Event = "MedeaPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4723"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Guru terhebat ada di luar sana{#Prev}, dia selalu berkata begitu, bukan? Tapi, aku merasakan hal yang sama. Selama aku mengenal Kepala Sekolah, ada begitu banyak hal tentang dirinya yang bahkan tak sanggup kupahami."
      Speaker = "Melinoe"
      Event = "MedeaPostTrueEnding02"
    }
    {
      Id = "Medea_0600"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berdiam dalam bayang-bayang; sudah semestinya begitu. Namun aku merasa tenang mengetahui jika aku benar-benar merasa kesepian, dalam arti menyedihkan dan melumpuhkan seperti yang fana sebut sebagai penelantaran... maka aku selalu bisa memanggilnya, atau dirimu."
      Speaker = "Medea"
      Event = "MedeaPostTrueEnding02"
    }
    {
      Id = "Medea_0597"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau melihat sisa-sisa jejak ancaman besar yang kita hadapi masih ada. Bagaimana kelanjutan usahamu untuk melenyapkan semuanya? Beritahu jika ada hal lain yang bisa kulakukan."
      Speaker = "Medea"
      Event = "MedeaPostTrueEnding03"
    }
    {
      Id = "MelinoeField_4722"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kurasa perkembangannya cukup baik, terima kasih atas kutukan-kutukanmu! Aku tidak tahu seberapa dekat kita dengan penyelesaiannya. Aku masih belum terbiasa dengan tugas-tugas yang urgensinya tidak terlalu diprioritaskan."
      Speaker = "Melinoe"
      Event = "MedeaPostTrueEnding03"
    }
    {
      Id = "Medea_0598"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketidaksabaran, ketergesaan, urgensi... menurutku itu sebagian besar adalah dorongan kaum fana. Tangan yang mantap dan waktu yang dinantikan dengan sabar, nah, {#Emph}itulah {#Prev}ranah kaum dewa. Aku selalu siap membantumu, penyihir."
      Speaker = "Medea"
      Event = "MedeaPostTrueEnding03"
    }
    {
      Id = "Medea_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menyenangkan juga, ya? Kita bisa berbincang seperti ini. Tapi sesama penyihir, terkadang membuang-buang napas itu menyebalkan sekali! Belakangan ini, setidaknya, aku sedang enggan bicara banyak."
      Speaker = "Medea"
      Event = "MedeaAboutSayingLittle01"
    }
    {
      Id = "MelinoeField_4724"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sapaan singkat sudah cukup untuk menghidupkan malam-malamku, Nyonya Medea. Atau mematikannya, tergantung pilihanmu. Kita tak perlu mengobrol panjang lebar."
      Speaker = "Melinoe"
      Event = "MedeaAboutSayingLittle01"
    }
    {
      Id = "Medea_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus. Semakin dalam aku menyelami risetku, semakin enggan aku membicarakannya. Namun aku memang senang membagikan hasilnya."
      Speaker = "Medea"
      Event = "MedeaAboutSayingLittle01"
    }
    {
      Id = "Medea_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kini jauh lebih banyak Bayangan orang mati yang berkeliaran di sini! Dan aroma tanah ini, sangat berbeda dari sebelumnya. Persimpangan ini telah berubah sejak terakhir kali kukunjungi!"
      Speaker = "Medea"
      Event = "MedeaHubFirstMeeting01"
    }
    {
      Id = "Melinoe_2510"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang kembali di kediaman kami, Nyonya Medea. Apa yang membawamu kemari, dan apakah kau akan tinggal bersama kami sebentar?"
      Speaker = "Melinoe"
      Event = "MedeaHubFirstMeeting01"
    }
    {
      Id = "Medea_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, aku adalah mata Hekate Agung di permukaan. Tapi malam masih panjang, dan aku punya urusan dengan Makelar di sana; kelebihan Tulang untuk ditukarkan. Sampai jumpa di atas dan di bawah, penyihir."
      Speaker = "Medea"
      Event = "MedeaHubFirstMeeting01"
    }
    {
      Id = "Melinoe_1256_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa."
      Speaker = "Melinoe"
      Event = "MedeaHubFirstMeeting01"
    }
    {
      Id = "Medea_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tempat ini benar-benar dipenuhi kehidupan...! Sejujurnya ini agak terlalu berlebihan bagiku. Apa kau terbiasa dengan semua ini?"
      Speaker = "Medea"
      Event = "MedeaHubMeeting02"
    }
    {
      Id = "Melinoe_4871"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, tentu saja! Atau setidaknya aku mulai terbiasa, Nyonya Medea. Beritahu aku jika ada yang bisa kami lakukan untuk membuat kunjunganmu di sini lebih nyaman."
      Speaker = "Melinoe"
      Event = "MedeaHubMeeting02"
    }
    {
      Id = "Medea_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh tidak, kurasa aku takkan tinggal lama di sini. Begitu semua urusanku dengan Makelar selesai, aku akan langsung pergi. Tapi sampai jumpa di Ephyra dalam waktu dekat, ya?"
      Speaker = "Medea"
      Event = "MedeaHubMeeting02"
    }
    {
      Id = "Melinoe_0769"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Melinoe"
      Event = "MedeaHubMeeting02"
    }
    {
      Id = "Medea_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sungguh disayangkan jika kutukan yang mengerikan menimpa musuh-musuh kita malam ini..."
      Speaker = "Medea"
      Event = "MedeaChat01"
    }
    {
      Id = "Medea_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka yang berniat jahat pada kita tidak pantas mendapatkan belas kasihan sedikit pun, penyihir."
      Speaker = "Medea"
      Event = "MedeaChat02"
    }
    {
      Id = "Medea_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita tidak selalu bisa memberi musuh kita kematian yang menyiksa, tapi kita bisa mengusahakannya."
      Speaker = "Medea"
      Event = "MedeaChat03"
    }
    {
      Id = "Medea_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemalangan datang dalam berbagai bentuk; kau tinggal memilihnya."
      Speaker = "Medea"
      Event = "MedeaChat04"
    }
    {
      Id = "Medea_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di malam yang sunyi seperti ini, ramuan dengan khasiat tertentu sudah pasti sangat dibutuhkan."
      Speaker = "Medea"
      Event = "MedeaChat05"
    }
    {
      Id = "Medea_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau akan mulai menyukai racun-racunku pada waktunya, penyihir."
      Speaker = "Medea"
      Event = "MedeaChat06"
    }
    {
      Id = "Medea_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari bersama-sama kita kutuk musuh-musuh kita malam ini, hingga ke alam baka."
      Speaker = "Medea"
      Event = "MedeaChat07"
    }
    {
      Id = "Medea_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang diperlukan untuk membuat musuh-musuh kita bertekuk lutut? Mari kita cari tahu."
      Speaker = "Medea"
      Event = "MedeaChat08"
    }
    {
      Id = "Medea_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau berniat menyebarkan rasa sakit dan penderitaan, kau datang ke tempat yang tepat."
      Speaker = "Medea"
      Event = "MedeaChat09"
    }
    {
      Id = "Medea_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perlindungan terbaik melawan kutukan adalah dengan melancarkan kutukan buatan sendiri."
      Speaker = "Medea"
      Event = "MedeaChat10"
    }
    {
      Id = "Medea_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh-musuh kita akan segera memahami esensi sejati dari rasa takut itu sendiri."
      Speaker = "Medea"
      Event = "MedeaChat11"
    }
    {
      Id = "Medea_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Udara yang kita hirup ini akan menjadi racun bagi semua orang yang menentang kita."
      Speaker = "Medea"
      Event = "MedeaChat12"
    }
    {
      Id = "Medea_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehendak dan pengaruh kita akan menyebar luas bagaikan wabah penyakit."
      Speaker = "Medea"
      Event = "MedeaChat13"
    }
    {
      Id = "Medea_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kusarankan agar kau tidak berlama-lama di sini; efek sampingnya sangat buruk."
      Speaker = "Medea"
      Event = "MedeaChat14"
    }
    {
      Id = "Medea_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketidaksenangan terwujud dalam berbagai rupa, dan aku berniat menguasai semuanya."
      Speaker = "Medea"
      Event = "MedeaChat15"
    }
    {
      Id = "Medea_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini benar-benar {#Emph}memohon {#Prev}terjadinya semacam {#Emph}kekejaman {#Prev}nyata, bukan?"
      Speaker = "Medea"
      Event = "MedeaChat16"
    }
    {
      Id = "Medea_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang kembali di nekropolis, dan semoga persinggahanmu di sini berlangsung singkat serta menyenangkan."
      Speaker = "Medea"
      Event = "MedeaChat17"
    }
    {
      Id = "Medea_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya sebuah ide yang {#Emph}benar-benar {#Prev}mengerikan dan sangat ingin kucoba, kalau kau berkenan melayaninya?"
      Speaker = "Medea"
      Event = "MedeaChat18"
    }
    {
      Id = "Medea_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita pergi dan menyebarkan lebih banyak petaka, setuju?"
      Speaker = "Medea"
      Event = "MedeaChat19"
    }
    {
      Id = "Medea_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi meraih sesuatu yang berharga, pengorbanan selalu mutlak diperlukan, wahai penyihir."
      Speaker = "Medea"
      Event = "MedeaChat20"
    }
    {
      Id = "Medea_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga kutukan menimpa musuh-musuh kita... bahkan mereka yang sekadar tidak kita sukai."
      Speaker = "Medea"
      Event = "MedeaChat21"
    }
    {
      Id = "Medea_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya beberapa kekejian terlarang lagi yang menentang alam untukmu di sini."
      Speaker = "Medea"
      Event = "MedeaChat22"
    }
    {
      Id = "Medea_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semakin besar kebencian yang kita simpan untuk musuh kita, semakin kuat pula kutukan kita nantinya."
      Speaker = "Medea"
      Event = "MedeaChat23"
    }
    {
      Id = "Medea_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau boleh saja diberkati para dewa di atas sana, tapi aku bisa menawarkan sesuatu yang tak mampu mereka beri."
      Speaker = "Medea"
      Event = "MedeaChat24"
    }
    {
      Id = "Medea_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hecate Agung telah mengajarimu dengan baik, tapi jika ada yang berani menyentuhmu walau seujung jari, akan kubuat mereka menderita."
      Speaker = "Medea"
      Event = "MedeaChat25"
    }
    {
      Id = "Medea_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Udaranya {#Emph}benar-benar {#Prev}busuk malam ini; aku hampir tidak mendengar langkahmu masuk, wahai penyihir!"
      Speaker = "Medea"
      Event = "MedeaChat26"
    }
    {
      Id = "Medea_0564"
      InheritFrom = "BaseNarrative"
      DisplayName = "Orang mati akan merindukan kenyamanan liang lahad mereka setelah kita {#Emph}selesai {#Prev}dengan mereka."
      Speaker = "Medea"
      Event = "MedeaChat27"
    }
    {
      Id = "Medea_0565"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bulan redup, malam dingin membeku, orang mati menggeliat di dalam Bumi; aku tak punya keluhan sama sekali!"
      Speaker = "Medea"
      Event = "MedeaChat28"
    }
    {
      Id = "Medea_0566"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hujan deras ini buruk bagi ramuanku, tapi harus kuakui ini memberi nuansa nestapa yang pas."
      Speaker = "Medea"
      Event = "MedeaChat29"
    }
    {
      Id = "Medea_0567"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang {#Emph}benar-benar {#Prev}mengerikan! Sulit kubayangkan bagaimana kondisi kerjaku bisa lebih sempurna dari ini."
      Speaker = "Medea"
      Event = "MedeaChat30"
    }
    {
      Id = "Medea_0568"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apotek kecilku persediaannya terbatas, sebab aku hanya menyediakan bahan-bahan yang paling segar..."
      Speaker = "Medea"
      Event = "MedeaChat31"
    }
    {
      Id = "Medea_0569"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hati-hati dan jaga punggungmu di luar sana, jangan sampai ada yang menusuknya telak, wahai penyihir."
      Speaker = "Medea"
      Event = "MedeaChat32"
    }
    {
      Id = "MelinoeField_4338"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini mestinya yang kau cari: sebotol uap Air Mata dari Mourning Fields. Semoga kau bisa memanfaatkannya dengan baik."
      Speaker = "Melinoe"
      Event = "MedeaGiftTears01"
    }
    {
      Id = "Medea_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, tepat sekali! Tak terbayang betapa pekatnya duka lara yang terkonsentrasi di sini. Aku akan segera mengolahnya. Terima kasih {#Emph}banyak{#Prev}!"
      Speaker = "Medea"
      Event = "MedeaGiftTears01"
    }
    {
      Id = "Melinoe_3303"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hampir merasa iba pada musuh kita, menyadari kau akan membuat mereka menyesali setiap malam mereka berani melawan kita, Nyonya Medea. Terimalah, aku ingin kau memilikinya."
      Speaker = "Melinoe"
      Event = "MedeaGift01"
    }
    {
      Id = "Medea_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nektar para dewa! Wah, ini akan sangat berguna untuk karyaku. Sebab kutukan terkuat selalu terlahir dari kata-kata semanis madu! Kemarilah, biar kubalas kebaikanmu ini setimpal."
      Speaker = "Medea"
      Event = "MedeaGift01"
    }
    {
      Id = "Medea_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebotol Nektar lagi yang kau sisihkan untukku? Oh, ini akan menjadi paduan sempurna dengan beberapa bahan yang jauh lebih menjijikkan, yang aromanya harus disamarkan oleh ini!"
      Speaker = "Medea"
      Event = "MedeaGift02"
    }
    {
      Id = "Melinoe_3300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bergidik membayangkan ramuan apa yang kau rencanakan, walau aku yakin kau akan memanfaatkannya demi perjuangan kita."
      Speaker = "Melinoe"
      Event = "MedeaGift02"
    }
    {
      Id = "Medea_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bakatmu selalu terlihat jelas bagi siapa pun, wahai penyihir; tapi sejujurnya, kukira kelembutan hatimu akan menjadi beban. Namun mungkin... aku keliru soal itu."
      Speaker = "Medea"
      Event = "MedeaGift03"
    }
    {
      Id = "Melinoe_3301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bersyukur atas kepercayaanmu padaku. Hatiku tak pernah terlalu mendominasi hingga menyesatkanku. Setidaknya, itulah yang selalu kuyakinkan pada diriku..."
      Speaker = "Melinoe"
      Event = "MedeaGift03"
    }
    {
      Id = "Medea_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa Olympus tidak selalu bersikap ramah. Namun kau, kerabat sedarah mereka, bersedia berbuat baik padaku hanya demi sumpahku pada Hecate Agung? Sungguh tak perlu; yang bisa kubalas hanyalah kutukan."
      Speaker = "Medea"
      Event = "MedeaGift04"
    }
    {
      Id = "Melinoe_3302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau jauh lebih berharga dari sekadar kutukanmu, Nyonya Medea. Mungkin para dewa Olympus dan orang mati tak pernah mengatakannya padamu, tapi aku yakin itu benar adanya."
      Speaker = "Melinoe"
      Event = "MedeaGift04"
    }
    {
      Id = "Medea_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Teruslah mempermanis suasana ini dan itu bisa mulai merusak keahlian sihirku...! Aku tak bisa berdiri di depan kualiku sambil memikirkan hal-hal menyenangkan semacam itu. Bayangkan apa jadinya!"
      Speaker = "Medea"
      Event = "MedeaGift05"
    }
    {
      Id = "MelinoeField_3938"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tentu bisa membayangkannya. Kau adalah salah satu praktisi ilmu sihir terhebat yang pernah kukenal. Kedalaman ilmumu tak tertandingi, dan cakupannya pun pasti tanpa batas."
      Speaker = "Melinoe"
      Event = "MedeaGift05"
    }
    {
      Id = "Medea_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebaikan yang berulang-ulang biasanya memicu kecurigaan terdalam atau amarahku, tapi dalam kasusmu... sedikit motif tersembunyi yang kurasakan tampaknya cukup tulus. Dan sekarang Nektarku sudah lebih dari cukup untuk keperluanku, terima kasih."
      Speaker = "Medea"
      Event = "MedeaGift06"
    }
    {
      Id = "MelinoeField_3939"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sama-sama. Aku pun selalu dituntut untuk waspada, karena musuh kita ada di mana-mana. Jadi saat aku mulai memercayai seseorang, aku ingin mereka mengetahuinya."
      Speaker = "Melinoe"
      Event = "MedeaGift06"
    }
    {
      Id = "Medea_0235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku sangat menghargai niatmu itu."
      Speaker = "Medea"
      Event = "MedeaGift06"
    }
    {
      Id = "MelinoeField_3941"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi baktimu pada perjuangan kita, Nyonya Medea! Kau mungkin sudah punya semua Nektar yang kau butuhkan, tapi aku ingin kau memiliki ini juga. Meski mungkin ini tak cocok untuk ramuanmu."
      Speaker = "Melinoe"
      Event = "MedeaGift07"
    }
    {
      Id = "Medea_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memperlakukanku layaknya dewi dari kahyangan dengan hadiah seberharga ini. Seandainya kau mengenalku lebih dekat, kau pasti langsung membatalkan niatmu saat ini juga. Ini sungguh tak perlu, wahai penyihir; seperti katamu, aku tak bisa menggunakannya juga."
      Speaker = "Medea"
      Event = "MedeaGift07"
    }
    {
      Id = "MelinoeField_3942"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bisa menikmatinya...? Mungkin bersamaku atau orang lain. Atau cukup simpan saja."
      Speaker = "Melinoe"
      Event = "MedeaGift07"
    }
    {
      Id = "Medea_0239"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin... ya, terima kasih."
      Speaker = "Medea"
      Event = "MedeaGift07"
    }
    {
      Id = "MelinoeField_3943"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena rasa Ambrosia begitu nikmat sampai membuatmu mendambakannya lagi, aku ingin memberikan ini padamu. Sebagai tanda terima kasih karena kau mungkin pemandangan paling menenteramkan di seantero Ephyra."
      Speaker = "Melinoe"
      Event = "MedeaGift08"
    }
    {
      Id = "Medea_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mendapat berkah dari orang sepertimu, setelah sekian banyak yang kukutuk—meski mereka memang pantas menerimanya... Aku sekadar menjalankan tugasku pada Hekate Agung dengan membantumu, sang penyihir. Kau tak perlu memberiku imbalan lebih."
      Speaker = "Medea"
      Event = "MedeaGift08"
    }
    {
      Id = "MelinoeField_3944"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini bukan imbalan, sekadar hadiah. Masa lalumu adalah urusanmu; yang kukenal hanyalah Nyonya Medea yang kutemui dan kupahami sekarang. Sosok penyihir yang selama ini sangat ingin kuteladani... meski dengan sedikit porsi kutukan, tapi tetap saja."
      Speaker = "Melinoe"
      Event = "MedeaGift08"
    }
    {
      Id = "Medea_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau masih begitu belia saat pertama kali kita bersua... Kupikir seiring bertambahnya usiamu, hatimu akan mengeras dan semakin kejam, seperti kebanyakan dari kita. Namun kau terbukti cukup kebal terhadapnya, dan sebaliknya... kau pun membuatku lebih kebal terhadap hal itu. Aku sungguh berterima kasih."
      Speaker = "Medea"
      Event = "MedeaGift08"
    }
    {
      Id = "MelinoeField_3945"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama-sama, dengan senang hati."
      Speaker = "Melinoe"
      Event = "MedeaGift08"
    }
    {
      Id = "Melinoe_3299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari sesama penyihir, terima kasih."
      Speaker = "Melinoe"
      Event = "NPC_Medea_01.GiftGivenVoiceLines"
    }
    {
      Id = "Medea_0092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lain kali saja."
      Speaker = "Medea"
      Event = "NPC_Medea_01.OnHitVoiceLines"
    }
    {
      Id = "Medea_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan senjatamu."
      Speaker = "Medea"
      Event = "NPC_Medea_01.OnHitVoiceLines"
    }
    {
      Id = "Medea_0094"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita benar-benar tak boleh melakukannya di sini."
      Speaker = "Medea"
      Event = "NPC_Medea_01.OnHitVoiceLines"
    }
    {
      Id = "Medea_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, jangan sekarang."
      Speaker = "Medea"
      Event = "NPC_Medea_01.OnHitVoiceLines"
    }
    {
      Id = "Medea_0514"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau takkan bisa menembus tabir ini."
      Speaker = "Medea"
      Event = "NPC_Medea_01.OnHitVoiceLines"
    }
    {
      Id = "Medea_0515"
      InheritFrom = "BaseSubtitle"
      DisplayName = " Penangkal kutukan ini cukup kokoh."
      Speaker = "Medea"
      Event = "NPC_Medea_01.OnHitVoiceLines"
    }
    {
      Id = "Medea_0516"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan tanganmu!"
      Speaker = "Medea"
      Event = "NPC_Medea_01.OnHitVoiceLines"
    }
    {
      Id = "Medea_0517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah, sudah..."
      Speaker = "Medea"
      Event = "NPC_Medea_01.OnHitVoiceLines"
    }
    {
      Id = "Medea_0242"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuangkat topi atas pencapaian agungmu."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang penyihir!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenanglah, sang penyihir."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh...!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, selamat datang."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali lagi ke kediamanku."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seorang tamu!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia kembali."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi kegelapan...!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mendekatlah..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0077"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan takut..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau kembali."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0534"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang di apotek ramuanku."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0535"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, rupanya {#Emph}kau."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0536"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0537"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, sang penyihir."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0532"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah agak lama tak melihat{#Emph}mu{#Prev}!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0533"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah terlalu lama!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Melinoe_3296"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nyonya Medea..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Melinoe_3297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Penyihir..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Melinoe_3298"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, sang Penyihir."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MedeaGreetingLines"
    }
    {
      Id = "Medea_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...abu tulang..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
