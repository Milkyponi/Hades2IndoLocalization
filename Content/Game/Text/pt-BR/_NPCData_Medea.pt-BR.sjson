      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0141"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...kulit ular..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...tetesan air mata..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...ekor kadal..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.MedeaCauldronLines"
    }
    {
      Id = "Medea_0144"
      InheritFrom = "BaseSubtitle"
