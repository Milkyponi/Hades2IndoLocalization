    {
      Id = "Hecate_0379"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita lihat apa yang bisa kita perbuat."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Hecate_0380"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau aku pribadi, jauh lebih suka pakai tombak..."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Hecate_0381"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo keluar, dasar makhluk-makhluk licin menyebalkan..."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Dora_0084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Uuggh{#Prev}, ini pasti bakal {#Emph}seru {#Prev}banget..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Dora_0085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mulai paham kenapa kamu benci banget sama ikan..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Dora_0086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kayaknya repot banget cuma demi ikan aneh..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Dora_0679"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, Mel, tunjukin kemampuanmu."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Dora_0680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Awas ya kalau nggak dapat satu buatku."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Dora_0681"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Coba kita lihat apa yang bisa kaulakukan dengan benda itu."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Dora_0682"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jelas beda banget suasananya dibanding di tenda..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Dora_0683"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terus, sekarang kita nunggu...?"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Odysseus_0069"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lebih susah mengakali bajingan-bajingan kecil itu dari yang kukira..."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Odysseus_0070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ikan-ikan ini takkan mempermalukan kita lagi selama aku masih sanggup bertindak!"
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Odysseus_0071"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Poseidon tak bisa membantumu di sini, ikan kecil..."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Odysseus_0759"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita lihat apa yang bisa kita dapatkan..."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Odysseus_0760"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada sesuatu yang bergerak di sana, tepat di bawah permukaan..."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Odysseus_0761"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunjukkan pada mereka kehebatan kita, Dewi."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Nemesis_0175"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama persis seperti tugas jaga..."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Nemesis_0176"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini yang kaucari?"
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Nemesis_0177"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadikan pertarungan yang adil."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Moros_0345"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kesabaran adalah keahlian yang sangat dibutuhkan dalam kegiatan ini..."
      Speaker = "Moros"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Moros_0346"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin ada hal yang bisa kupelajari dari teknikmu."
      Speaker = "Moros"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Moros_0347"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang bersembunyi di dasar Sungai Cocytus...?"
      Speaker = "Moros"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Eris_0221"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bakal ada ikan malang yang malamnya hancur lebur sebentar lagi."
      Speaker = "Eris"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Eris_0222"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahu nggak bakal secepat apa urusan ini kalau aku boleh pakai Rail?"
      Speaker = "Eris"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Eris_0223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau ikannya nggak mau mematuk, kuperingatkan ya, {#Emph}aku {#Prev}yang bakal mematuk."
      Speaker = "Eris"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Icarus_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau melempar kailnya ke air semudah itu..."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Icarus_0208"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Agak mirip seperti mencari target dari langit..."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
      Id = "Icarus_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti ini lebih sulit daripada kelihatannya..."
      Speaker = "Icarus"
      Event = "GlobalVoiceLines.AboutToFishVoiceLines"
    }
    {
