{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _LootData_Aphrodite.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_0641"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lambang hati itu..."
      Speaker = "Melinoe"
      Event = "AphroditeUpgrade.FirstSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1476"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aphrodite..."
      Speaker = "Melinoe"
      Event = "AphroditeUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1477"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia kembali."
      Speaker = "Melinoe"
      Event = "AphroditeUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Aphrodite_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cinta menyatukan kita semua, dan mengilhami kita meraih pencapaian yang mustahil kita lakukan sendirian! Dan jangan hanya percaya kata-kata{#Emph}ku{#Prev} saja, Cantik. Pamanmu yang {#Emph}bijak{#Prev} dan {#Emph}adil{#Prev}... dia tahu betul segalanya soal menebarkan cinta ke mana-mana!"
      Speaker = "Aphrodite"
      Event = "AphroditeWithZeus01"
    }
    {
      Id = "Zeus_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar sekali, Aphrodite sayang, karena kekuasaanku berlandaskan pada cinta keluarga dan juga umat fana. Untuk apa lagi kita bertarung, kalau bukan demi cara hidup di mana hasrat kita menjadi daya penggeraknya?"
      Speaker = "Zeus"
      Event = "AphroditeWithZeus01"
    }
    {
      Id = "Aphrodite_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jaga sikapmu {#Emph}sebaik-baiknya{#Prev} sekarang, Cantik! Karena kupersembahkan kepadamu Ratu kita yang paling anggun mempesona. Tiada asing dengan liku-liku peperangan, atau memadamkan kebejatan yang membusuk di hati kaum durjana! Sambutlah, {#Emph}Yang Mulia Ratu Hera!"
      Speaker = "Aphrodite"
      Event = "AphroditeWithHera01"
    }
    {
      Id = "Hera_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa kita tak butuh kemegahan berlebihan seperti itu, Aphrodite. Tapi ya, lebih banyak dewi semestinya paham pentingnya menjaga citra bahkan di masa-masa sulit... {#Emph}terutama{#Prev} di masa-masa sulit."
      Speaker = "Hera"
      Event = "AphroditeWithHera01"
    }
    {
      Id = "Aphrodite_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu kupikir Yang Mulia Pamanmu Poseidon hanyalah orang dungu yang kasar dan tak berguna... tapi, setelah melihat langsung kehebatannya bertarung di perang ini, kusadar betapa kelirunya aku! Dia sama sekali tak bisa dibilang tak berguna!"
      Speaker = "Aphrodite"
      Event = "AphroditeWithPoseidon01"
    }
    {
      Id = "Poseidon_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih banyak, Aphrodite! Karena kutahu betapa sulitnya bagimu untuk memahami seutuhnya kekuatanku yang dahsyat, yah mari akui saja, kau kan bukan dewi kebijaksanaan! {#Emph}Aku juga bukan!{#Prev} Dan kita punya kesamaan lain, dalam {#Emph}keindahan samudra!"
      Speaker = "Poseidon"
      Event = "AphroditeWithPoseidon01"
    }
    {
      Id = "Aphrodite_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada begitu banyak keindahan di Olympus, Sayang! Contohnya {#Emph}aku{#Prev}, atau Apollo yang berkilau, {#Emph}hm?{#Prev} Sepupumu, bukan? Boleh kubilang aku melihat sedikit kemiripan!"
      Speaker = "Aphrodite"
      Event = "AphroditeWithApollo01"
    }
    {
      Id = "Apollo_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setelah kau menyebutnya, Yang Mulia Aphrodite, rambut pirang keemasanku ini memang agak mirip dengan kemilau pucat dari surai sepupuku yang terurai. Pasti ada banyak keindahan pula di alamnya!"
      Speaker = "Apollo"
      Event = "AphroditeWithApollo01"
    }
    {
      Id = "Aphrodite_0148"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan Nenekmu Demeter, kalian pasti punya {#Emph}begitu{#Prev} banyak hal untuk diceritakan! Barangkali kau bahkan punya kekuatan untuk meluluhkan senyum ketus membeku yang sering kutakutkan sudah terpatri {#Emph}permanen{#Prev}, walau... kulihat dia ingin menyapamu langsung sekarang!"
      Speaker = "Aphrodite"
      Event = "AphroditeWithDemeter01"
    }
    {
      Id = "Demeter_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak usah hiraukan Aphrodite, Kembangku. Dia lebih merisaukan lekukan wajahku ketimbang melakukan hal yang berguna. Namun soal kita punya banyak hal untuk dibicarakan, dia memang benar..."
      Speaker = "Demeter"
      Event = "AphroditeWithDemeter01"
    }
    {
      Id = "Aphrodite_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pahit rasanya mengakui bahwa ada kalanya cinta bukanlah jalan keluar, dan sedikit hunusan logam tajam bisa menuntaskan segalanya jauh lebih cepat. Dalam urusan itu, Hephaestus-ku bisa membantu, bukan begitu, Sayang?"
      Speaker = "Aphrodite"
      Event = "AphroditeWithHephaestus01"
    }
    {
      Id = "Hephaestus_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi kau, Aph? {#Emph}Kapan pun siap. {#Prev}Dan buat penyihir kecil di sini, {#Emph}hampir{#Prev} setiap waktu! Nah {#Emph}ayolah. {#Prev}Bahkan saat keadaannya butuh hunusan logam tajam, kau tahu cara menancapkan maksudmu tepat sasaran!"
      Speaker = "Hephaestus"
      Event = "AphroditeWithHephaestus01"
    }
    {
      Id = "Aphrodite_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita harus melindungi hal-hal yang kita cintai, bukan begitu, Manisku? Kalau tidak, kita bisa saja kehilangan mereka. Untungnya, aku punya perlindungan terbaik yang pernah ada, tepat di sini."
      Speaker = "Aphrodite"
      Event = "AphroditeWithHephaestus02"
    }
    {
      Id = "Hephaestus_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurasa dia maksud baju zirahkan buatanku, Penyihir Cilik! Pas banget lagi ngepas ukuran, lalu mikir, wah, kita kenal seseorang yang butuh bantalan ekstra di bagian yang penting! Jadi, nih, terimalah!"
      Speaker = "Hephaestus"
      Event = "AphroditeWithHephaestus02"
    }
    {
      Id = "Aphrodite_0146"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sifat keindahan yang fana itulah yang membuat kita begitu {#Emph}merindukannya!{#Prev} Namun bahkan bagi mereka yang telah ditinggalkan oleh kecantikan {#Emph}luar{#Prev}, sering kali ada keindahan {#Emph}dalam{#Prev} yang menyala terang benderang! Bukankah kau sepakat, Hestia sayang?"
      Speaker = "Aphrodite"
      Event = "AphroditeWithHestia01"
    }
    {
      Id = "Hestia_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hati-hati dengan jalan pikiranmu itu, Aphrodite. Kau sendiri tak punya banyak keindahan batin yang bisa dibanggakan, dan kecantikan {#Emph}luarmu{#Prev} bisa kulelehkan dalam {#Emph}sekejap mata. {#Prev}Dan menumbuhkan kembali semua rambut indah berkilau itu bakal butuh waktu lama, seingatku..."
      Speaker = "Hestia"
      Event = "AphroditeWithHestia01"
    }
    {
      Id = "Aphrodite_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ini selalu punya jiwa pejuang, seperti yang diketahui Yang Mulia Ares di sini. Tapi selalu kukatakan padanya, penaklukan akbar dalam cinta jauh lebih mendebarkan daripada penaklukan akbar dalam perang!"
      Speaker = "Aphrodite"
      Event = "AphroditeWithAres01"
    }
    {
      Id = "Ares_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang menikmati pertarungan sengit yang berkepanjangan, Yang Mulia Dewi Aphrodite. Bagiku, penaklukan tetaplah penaklukan; tak peduli di medan perang ataupun di relung hati, itu sama saja. Dan aku merasa semuanya begitu menggugah sukma."
      Speaker = "Ares"
      Event = "AphroditeWithAres01"
    }
    {
      Id = "Aphrodite_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk memenangkan hati seseorang, kita harus berjuang! Dan kita juga bisa meremukkan hati seseorang dengan cara yang sama. Yang Mulia Ares di sini paham {#Emph}segalanya{#Prev} tentang cara kerjanya."
      Speaker = "Aphrodite"
      Event = "AphroditeWithAres02"
    }
    {
      Id = "Ares_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tentu saja, dan aku sangat bersyukur atas ajaranmu, Yang Mulia Aphrodite; pengetahuanku dulunya sungguh tak lengkap, hingga kau berkenan membagikan ilmumu."
      Speaker = "Ares"
      Event = "AphroditeWithAres02"
    }
    {
      Id = "Melinoe_0642"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak diragukan lagi sosok ini mengenal rasa benci, bukan hanya cinta. {#Emph}Atas nama Hades! Olympus, kuterima pesan ini!"
      Speaker = "Melinoe"
      Event = "AphroditeFirstPickUp"
    }
    {
      Id = "Aphrodite_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, {#Emph}halo{#Prev}, Cantik! {#Emph}Kau{#Prev} kelihatannya bisa mematahkan hati siapa pun bahkan {#Emph}tanpa{#Prev} bantuanku! Oh, saudaramu pasti akan sangat bangga, tahu kau berjuang demi sanak saudaramu!"
      Speaker = "Aphrodite"
      Event = "AphroditeFirstPickUp"
    }
    {
      Id = "Aphrodite_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, kasihan sekali kau, apa yang terjadi di perjalananmu? Pasti ada sesuatu yang bisa kulakukan untuk menolong keadaanmu yang menyedihkan ini!"
      Speaker = "Aphrodite"
      Event = "AphroditeLowHealth01"
    }
    {
      Id = "Aphrodite_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm{#Prev}, kau terlihat seperti baru saja melewati malam yang benar-benar mengerikan. Pernah kualami juga kok, Cantik; hanya saja aku pandai menyembunyikannya!"
      Speaker = "Aphrodite"
      Event = "AphroditeLowHealth02"
    }
    {
      Id = "Aphrodite_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, Molek, kau {#Emph}terluka! {#Prev}Sungguh tak bisa dimaafkan. Siapa pun yang berani lancang, kuyakin kau sudah mengakhiri hidup mereka dengan menyakitkan!"
      Speaker = "Aphrodite"
      Event = "AphroditeLowHealth03"
    }
    {
      Id = "Aphrodite_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}terluka{#Prev}, Sayang! Andaikan saja aku bisa menjangkaumu lebih cepat. Tapi jangan putus asa! Jantungmu masih berdegup, kan?"
      Speaker = "Aphrodite"
      Event = "AphroditeLowHealth04"
    }
    {
      Id = "Aphrodite_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Halo, halo lagi untukmu, Cantik! Aku sudah tak sabar lagi ingin melihatmu, jadi kupikir sebaiknya kali ini kutemani dirimu sejak awal mula. Kau siap menyambutku, {#Emph}hm?"
      Speaker = "Aphrodite"
      Event = "AphroditeRunStart01"
    }
    {
      Id = "Aphrodite_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Firasatku mengatakan kau baru saja hendak berangkat untuk tugas pentingmu yang lain, dan aku ingin jadi yang pertama melepas kepergianmu serta memberikan yang terbaik dariku untukmu!"
      Speaker = "Aphrodite"
      Event = "AphroditeRunStart02"
    }
    {
      Id = "Aphrodite_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam masih panjang, dan ada perang yang harus kita menangkan, Cantik! Kupikir aku bisa menemanimu begitu kau melangkah maju. Bagaimana menurutmu?"
      Speaker = "Aphrodite"
      Event = "AphroditeRunStart03"
    }
    {
      Id = "Aphrodite_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahan di situ, Manisku! Kau tak boleh begitu saja melangkah ke dalam gelapnya malam tanpa bantuanku, untuk membuatmu tetap {#Emph}hangat dan berdebar-debar{#Prev}, dan musuh kita {#Emph}mati terkubur!"
      Speaker = "Aphrodite"
      Event = "AphroditeRunStart04"
    }
    {
      Id = "Aphrodite_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Alangkah indahnya andai kita semua bisa mengejar hasrat tanpa memikirkan akibatnya! Tapi kita para dewa, terkadang kita bertindak gegabah tanpa berpikir panjang, dan berakhir dalam situasi yang paling memalukan..."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutPassions01"
    }
    {
      Id = "Aphrodite_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga ini memang tak pandai mengikhlaskan, bukan? Setelah berzaman-zaman makmur sentosa, semua yang kita bangun bersama terancam hancur berantakan, cuma gara-gara {#Emph}sedikit{#Prev} perselisihan darah! {#Emph}Hmph!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutFamily01"
    }
    {
      Id = "Aphrodite_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami para dewi selalu saja terseret ke dalam urusan keluarga ini tanpa kesalahan kami sedikit pun. {#Emph}Aku {#Prev}sendiri tadinya tak ada masalah dengan Chronos, tapi lihatlah diriku sekarang, ikut berperang melawannya!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutChronos01"
    }
    {
      Id = "Aphrodite_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rahasia di antara kita, ya? Usiaku sebenarnya {#Emph}jauh {#Prev}lebih tua daripada penampilanku. Apa yang disebut sebagai {#Emph}Zaman Keemasan {#Prev}yang ingin dipulihkan Chronos itu... adalah masa-masa paling membosankan yang takkan pernah kau {#Emph}bayangkan!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutChronos02"
    }
    {
      Id = "Aphrodite_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar {#Emph}terisolasi {#Prev}di sana, manisku! Astaga, manusia fana bahkan tak tahu {#Emph}namamu! {#Prev}Tak ada satu pun kuil yang dibangun demi {#Emph}menghormatimu! {#Prev}Setidaknya {#Emph}belum{#Prev}, jadi tetaplah bersama denganku!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutMelinoe01"
    }
    {
      Id = "Aphrodite_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau punya seseorang yang {#Emph}istimewa {#Prev}dalam hidupmu? Murid kesayangan Sang Penyihir Persimpangan pastilah {#Emph}sangat {#Prev}sibuk, ya, mungkin jawabannya tidak. Begitu maju dalam beberapa hal, namun begitu tertinggal dalam hal lainnya..."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutLove01"
    }
    {
      Id = "Aphrodite_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Percayalah padaku, jika kau ragu apakah kau pernah jatuh cinta atau belum, artinya kau belum merasakannya. Rasanya seperti debaran yang menyelimutimu, lalu menetap dengan manisnya, lama setelahnya. Semoga kau menemukannya berulang kali!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutLove02"
    }
    {
      Id = "Aphrodite_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bertarung dengan keganasan seseorang yang cintanya sedang dipertaruhkan! Namun bukan itu yang mendorongmu, bukan? Tidak, kau menemukan sumber motivasi dari hal lain! Kira-kira apa {#Emph}gerangan?"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutLove03"
    }
    {
      Id = "Aphrodite_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bisa paham kenapa kau jadi murid kesayangan Sang Penyihir Persimpangan, manisku... karena kau telah belajar banyak tentang cinta dalam waktu singkat, dan hanya dengan {#Emph}sedikit {#Prev}bimbingan! Hatimu jelas berada di tempat yang tepat."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutLove04"
    }
    {
      Id = "Aphrodite_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cinta sejati mungkin abadi, walau gairah cenderung meredup. Begitu pula dengan berkah yang kami anugerahkan! Sebagaimana cinta butuh dirawat, keyakinan kami padamu pun harus diperkuat, seperti ini!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutBoons01"
    }
    {
      Id = "Aphrodite_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat dirimu, di bawah terangnya sinar rembulan! {#Emph}Selamat datang{#Prev}, jelita, di permukaan dunia kita yang elok! Silakan, tinggallah sesukamu! Atau semampumu. Akhir-akhir ini, keadaannya agak kacau..."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutSurface01"
    }
    {
      Id = "Aphrodite_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau yakin lebih baik berada di atas sini? Kudengar bangsamu... maksudku, para penghuni Bawah Tanah, tak sanggup berlama-lama di permukaan. Kumohon, {#Emph}jangan {#Prev}memaksakan diri demi kami!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutSurface02"
    }
    {
      Id = "Aphrodite_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Manisku, astaga, kau tampak sepenuhnya {#Emph}seperti biasa! {#Prev}Di permukaan sini, maksudku! Kukira kau takkan tahan di tempat ini, tapi lihatlah, melangkah gagah melintasi negeri yang terkoyak perang ini seolah semuanya memang milikmu!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutSurface03"
    }
    {
      Id = "Aphrodite_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali kota terkutuk Ephyra harus menjadi perkenalan pertamamu dengan kemegahan permukaan, sayang. Kota itu dulunya berdiri sebagai penghormatan bagi ibunda dan ayahandamu, sampai Chronos merusaknya! Aku masih merasa kesal setiap kali mengingatnya."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutSurface04"
    }
    {
      Id = "Aphrodite_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin mengajakmu berkunjung ke tempat kami, tapi berhubung kami sedang dikepung dan segalanya, mungkin tak sepadan dengan perjalanannya. Olympus jelas terasa sangat berbeda saat kau {#Emph}terjebak{#Prev}. Kami telah banyak mengurangi pesta pora dan bersenang-senang. Oh, betapa aku merindukan masa-masa itu..."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutOlympus01"
    }
    {
      Id = "Aphrodite_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Betapa menyenangkannya, kau telah melihat gunung kami secara langsung! Walau memalukan sekali menyambut tamu di saat seperti ini; kami terlalu sibuk menyambut para musuh!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutOlympus02"
    }
    {
      Id = "Aphrodite_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelak aku yakin kau akan menyadari bahwa Olympus adalah tempat yang benar-benar megah. Segala kenikmatan yang ditawarkan dunia ini berlimpah ruah! Dan, demi napas hidupku, tempat ini tak sedingin yang dibicarakan orang-orang."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutOlympus03"
    }
    {
      Id = "Aphrodite_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, jelita, aku nyaris tak bisa melihatmu lagi! Dan betapa meruginya diriku {#Emph}ini{#Prev}. Omong-omong, di mana sebenarnya kau berada? Terjebak di suatu tempat di bawah lautan?! Alam kekuasaan ayahmu memang amat sangat luas."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutOceanus01"
    }
    {
      Id = "Aphrodite_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aah{#Prev}, kau sudah sampai di celah retakan yang ditebas oleh Yang Mulia Poseidon yang {#Emph}penuh perhatian {#Prev}itu melintasi pedesaan permai kita... membuat musuh-musuh kita bisa berkumpul menyerang kita bahkan jauh lebih {#Emph}cepat {#Prev}daripada berjalan kaki! Pokoknya, lekaslah ke mari, {#Emph}ya?"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutThessaly01"
    }
    {
      Id = "Aphrodite_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seekor burung kecil membisikkanku bahwa sesuatu telah terjadi pada Tiga Dewi Takdir... mereka tak ada lagi untuk merumitkan hidup kita? Pantas saja hari-hariku jadi begitu {#Emph}mudah ditebak! {#Prev}Namun jika Chronos benar-benar dalang di balik ini, mungkin kita patut cemas..."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutFates01"
    }
    {
      Id = "Aphrodite_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan jadi apa gunung permai kita ini nanti, sayang? Baru saja kami merasakan guncangan hebat yang belum pernah kurasakan sebelumnya. Awalnya kukira Poseidon yang kembali mengguncang bumi, tapi begitu melihat {#Emph}wajahnya{#Prev}, aku tahu bukan dia pelakunya..."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutSurfaceThreat01"
    }
    {
      Id = "Aphrodite_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti tak menyenangkan merayap menembus sudut-sudut terdalam Bawah Tanah malam demi malam. Tapi, keindahan selalu bisa ditemukan dalam segala hal! Yah, {#Emph}sebagian besar {#Prev}hal. Di tempatmu berada sekarang, aku tak berani jamin."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutUnderworld01"
    }
    {
      Id = "Aphrodite_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, aku tahu {#Emph}makin {#Prev}banyak hal {#Emph}tentangmu{#Prev}, sayang. Burung-burung kecilku menceritakan {#Emph}segalanya! {#Prev}Mereka ada di {#Emph}mana-mana{#Prev}, dan paling suka memberiku kabar terbaru. {#Emph}Mereka {#Prev}senang saat {#Emph}aku {#Prev}senang, dan aku senang mengetahui segalanya!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutBirdies01"
    }
    {
      Id = "Aphrodite_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, perang bukannya tanpa saat-saat yang mendebarkan! Sudah terlalu lama sejak terakhir kali aku turun ke medan laga, menyilaukan musuh-musuhku dalam segenap keagunganku saat menembus jantung mereka, mengisi saat-saat terakhir mereka dengan keindahan dan {#Emph}penderitaan! {#Prev}Meski begitu, perang juga benar-benar mengacaukan segalanya..."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutWar01"
    }
    {
      Id = "Aphrodite_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mewarisi kegarangan ayahmu, bukan, sayang? Bukannya aku mengenalnya dengan baik, sih! Atau mendengar terlalu banyak cerita tentangnya, kalau dipikir-pikir... dia memang bukan tipe yang suka bicara."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutHades01"
    }
    {
      Id = "Aphrodite_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi {#Emph}kaulah {#Prev}murid kesayangan Hecate yang agung! Seekor burung kecil membisikkanku bahwa dia melatih seorang jenius sejati. Bayangkan betapa terkejutnya aku saat tahu bahwa itu adalah Sang Putri Bawah Tanah yang hilang! Sungguh benar-benar {#Emph}menghebohkan!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutHecate01"
    }
    {
      Id = "Aphrodite_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seekor burung kecil membisikkanku bahwa {#Emph}Sang Kehancuran sendiri {#Prev}muncul di tempat tinggalmu...? Walau itu pertanda buruk bagimu, dan mungkin bagi kita semua... setidaknya dia pria yang sangat tampan, kan?"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutMoros01"
    }
    {
      Id = "Aphrodite_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, kau dan Kehancuran sangat lihai menyembunyikan apa pun yang sedang terjalin di antara kalian. Burung-burung kecilku {#Emph}nyaris {#Prev}tak melihat jejaknya sama sekali! Namun firasatku tentang kalian berdua tetap ada, dan firasatku {#Emph}tak pernah {#Prev}keliru."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutMoros02"
    }
    {
      Id = "Aphrodite_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau punya rekan yang luar biasa pada diri Nemesis, jelita! Dia tinggi tegap, dia lancang, dia adalah segalanya yang bukan dirimu! Aku lega kalian saling mendukung alih-alih saling menggorok leher!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutNemesis01"
    }
    {
      Id = "Aphrodite_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku begitu senang kau dan Nemesis menyelesaikan perselisihan kalian! {#Emph}Oh {#Prev}tak ada yang memberitahuku, jelita, ini semua pengetahuan yang kudapat semata-mata karena siapa diriku! Dan selama kalian berdua tetap menjadi diri sendiri, kupikir kalian akan saling melengkapi."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutNemesis02"
    }
    {
      Id = "Aphrodite_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tinggal di Erebus, kan, manisku? Terakhir kudengar, sang penenun sutra Arachne tinggal di bawah sana. Kain-kain begitu indah buatannya, tapi dia tak pernah lagi menampakkan diri di atas sini setelah dia dan Athena bertengkar kecil!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutArachne01"
    }
    {
      Id = "Aphrodite_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali apa yang terjadi antara Arachne dan Athena. Burung-burung kecilku menceritakan segalanya. Namun keindahan selalu ada dalam {#Emph}setiap {#Prev}wujud, bahkan pada seekor laba-laba mungil yang anggun! Mungkin suatu saat dia akan menerimanya seperti halnya {#Emph}dirimu{#Prev}!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutArachne02"
    }
    {
      Id = "Aphrodite_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah bertemu {#Emph}begitu {#Prev}banyak orang di puncak gunung ini, tapi kalau dipikir-pikir, belakangan ini aku tak melihat batang hidung Artemis kecil sama sekali! Jangan-jangan dewi perburuan itu terlalu sibuk mengintai binatang hutan tua sampai tak sudi bergabung di saat kita butuh bantuan?"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutArtemis01"
    }
    {
      Id = "Aphrodite_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakakmu itu dulunya pria yang begitu manis, sayang! Lalu tiba-tiba suatu hari, dia berhenti membalas semua pesan dariku! Apa aku melakukan kesalahan yang menyinggungnya? Bayangkan betapa leganya aku saat tahu belakangan kalau Chronos-lah dalangnya!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutZagreus01"
    }
    {
      Id = "Aphrodite_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira apa yang sebenarnya dilakukan Chronos sampai mengisolasi kakakmu dan seluruh keluargamu, ya? Mungkinkah dia {#Emph}mengikat mereka! {#Prev}Bagaimanapun juga, jangan terlalu khawatir. Mereka kan dewa! Kemungkinan besar mereka baik-baik saja."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutZagreus02"
    }
    {
      Id = "Aphrodite_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakak dewa kecilmu itu, kudengar dia baik-baik saja! Dan kembali bertempur keluar dari neraka yang ia sebut rumah itu, atau setidaknya {#Emph}sebagian {#Prev}sampai Bawah Tanah dipulihkan. Kuharap kau bisa bertemu dengannya lagi {#Emph}segera!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutZagreus03"
    }
    {
      Id = "Aphrodite_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah bertemu Hephaestus, dan mendengar cerita-cerita tentangnya, tak diragukan lagi. Yah, dia punya hati yang rupawan. Tentu bukan cuma aku yang bisa melihatnya, kan? Dari sekian banyak pelamarku, hanya dia yang rela membiarkanku menjadi diriku sendiri."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutHephaestusRelationship01"
    }
    {
      Id = "Aphrodite_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah bertemu banyak dari kami sekarang, tapi belum bersua dengan Athena yang angkuh, dugaanku benar? Rupanya dia terlalu sibuk mempertahankan garis depan kita. Jangan dimasukkan ke hati; lagipula, dia bukanlah dewi tata krama."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutAthena01"
    }
    {
      Id = "Aphrodite_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah menyaksikan beberapa kemunculan dramatis Athena di medan laga. Sejujurnya, dia tidak seburuk itu dalam hal bergaya! Mungkin karena dia punya begitu banyak kesempatan berlatih melawan semua tamu tak diundang kita!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutAthena02"
    }
    {
      Id = "Aphrodite_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu hal yang pasti, pesta di Olympus sudah {#Emph}jauh {#Prev}terlalu langka akhir-akhir ini! Kasihan Dionysus sampai tidak seperti dirinya yang biasa. Biasanya dia yang paling pertama menyambutmu!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutDionysus01"
    }
    {
      Id = "Aphrodite_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kasihan Dionysus melewatkan semua kesenangannya! Mungkin dia mengira perangnya belum usai, berhubung semua pertempuran ini masih berkecamuk. Bagaimanapun juga dia tidak akan percaya apa yang telah terjadi!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutDionysus02"
    }
    {
      Id = "Aphrodite_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Burung kecil memberitahuku bahwa kau berhadapan dengan para Siren di dasar samudra? Aku mengenal mereka dan nyanyian memikat mereka luar dalam. Mereka pasti sudah bosan menenggelamkan para pelaut ke kegelapan samudra!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutSirens01"
    }
    {
      Id = "Aphrodite_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para Siren di bawah sana tempat {#Emph}kau {#Prev}berada sungguh bernyanyi sepenuh jiwa! Mungkin mereka sudah menemukan sumber inspirasi lain selain para pelaut yang amat mereka sukai itu."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutSirens02"
    }
    {
      Id = "Aphrodite_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Burung kecil memberitahuku kau telah bertemu dengan si rupawan Narcissus, bukan? Kau pasti mengira dia adalah teladan gemilang dari segala hal yang kujunjung... yah, tidak begitu! Sebab cinta yang paling agung itu adalah yang {#Emph}dibagi{#Prev}, bukan ditimbun untuk diri sendiri."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutNarcissus01"
    }
    {
      Id = "Aphrodite_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap demi kebaikanmu sendiri kau menghindari si Narcissus tak berguna itu. Para pemujanya {#Emph}memohon-mohon {#Prev}padaku agar berbuat sesuatu tentang kegilaannya pada bayangannya sendiri, tapi apalah dayaku untuk merusak hubungan seharmonis itu? Menurut pandanganku, dia akhirnya menemukan tandingan yang sepadan!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutNarcissus02"
    }
    {
      Id = "Aphrodite_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, cantik, kau beruntung mewarisi bagian terbaik dari ibumu! Tentu saja {#Emph}ayahmu {#Prev}juga selalu punya pesona tertentu. Memikirkannya kembali, kau adalah bukti hidupnya!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutPersephone01"
    }
    {
      Id = "Aphrodite_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Burung kecil bilang Eris yang {#Emph}menyebalkan itu {#Prev}berkeliaran ke sana kemari, mencampuri urusan orang lain alih-alih mengurus dirinya sendiri! Kami bahkan sudah berhenti mengundangnya ke pesta {#Emph}apa pun {#Prev}di atas sini sejak sebelum semua ini terjadi!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutEris01"
    }
    {
      Id = "Aphrodite_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}suka {#Prev}adanya Perselisihan dalam hidupmu, {#Emph}hm? {#Prev}Makin sering kau bertarung melawan Eris, makin jelas bagiku bahwa ada {#Emph}sesuatu {#Prev}di antara kalian, dan dugaanku tepat! Dia sama sekali tak terlihat seperti tipemu, tapi begitulah {#Emph}tepatnya {#Prev}cara cinta bekerja!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutEris02"
    }
    {
      Id = "Aphrodite_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah pemuda gagah bersayap indah itu, apakah Icarus namanya? Aku hampir salah mengiranya sebagai salah satu burung kecilku! Dia tidak sempat mencicipi banyak cinta semasa bernapas, tapi tak ada kata terlambat...!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutIcarus01"
    }
    {
      Id = "Aphrodite_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}sangat {#Prev}senang atas apa yang telah kau lakukan untuk Icarus! {#Emph}Oh{#Prev}, perasaannya serasa melayang ke langit ketujuh, dan siapa yang bisa menyalahkannya? Dia bisa benar-benar {#Emph}merasakan... {#Prev}kebanyakan manusia fana tak seberuntung itu, apalagi sebagian besar {#Emph}Arwah!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutIcarus02"
    }
    {
      Id = "Aphrodite_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, si bongsor Heracles yang tua itu mengamuk di bawah sana, menumpuk jasad-jasad orang mati atas nama para dewa, ya? Yang satu itu temperamennya sebuas banteng, dan baunya mungkin jauh lebih busuk. Setidaknya kita punya bala bantuan yang {#Emph}bagus {#Prev}untuk diandalkan!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutHeracles01"
    }
    {
      Id = "Aphrodite_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meski kuakui aku punya sedikit kelemahan pada pria tinggi, gelap, dan penuh amarah yang membara, Prometheus benar-benar membuatku {#Emph}muak. {#Prev}Dia merusak {#Emph}gunung {#Prev}kita yang indah! Memangnya dia ingin memikat siapa?"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutPrometheus01"
    }
    {
      Id = "Aphrodite_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika Prometheus tidak lebih berhati-hati, dia bisa hangus terbakar oleh segala amarahnya yang {#Emph}membara! {#Prev}Dia terus bilang betapa dia tak {#Emph}peduli {#Prev}pada satu pun dewi atau dewa di antara kita, tapi menurut{#Emph}ku{#Prev}, dia cuma sok jual mahal!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutPrometheus02"
    }
    {
      Id = "Aphrodite_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Enak sekali Prometheus bisa terus melampiaskan amarahnya pada kita semua seolah-olah itu pekerjaan {#Emph}resminya. {#Prev}Lagipula kenapa dia mengira kita begitu jahat pada kaum fana? Memang ada hati yang kupatahkan, tapi jauh lebih banyak yang kupenuhi!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutPrometheus03"
    }
    {
      Id = "Aphrodite_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang harus kita lakukan terhadap puncak gunung kita yang malang ini? Typhon yang buruk rupa itu berhasil mendaki sampai ke sini, dan dia mengacaukan {#Emph}segalanya. {#Prev}Tentu saja kita {#Emph}tidak {#Prev}akan membiarkannya menginjak-injak kita semaunya."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutTyphon01"
    }
    {
      Id = "Aphrodite_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hih{#Prev}, Typhon yang buruk rupa itu! Tak cuma mencuri semua perhatian akhir-akhir ini, dia bahkan kebal terhadap semua {#Emph}pesonaku. {#Prev}Hal seperti itu {#Emph}tak pernah {#Prev}terjadi! Tapi yang dia inginkan hanyalah gunung ini, dan sama sekali bukan dengan cara penuh cinta."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutTyphon02"
    }
    {
      Id = "Aphrodite_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sedikit pengakuan tentang Typhon yang buruk rupa itu... saat bumi mulai bergejolak, aku {#Emph}mungkin {#Prev}sempat membantunya terbebas sedikit... tapi demi membela diri, aku tak tahu makhluk apa dia {#Emph}sebenarnya! {#Prev}Aku hanya melihat sesuatu yang berkilau, dan membatin, {#Emph}ooh!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutTyphon03"
    }
    {
      Id = "Aphrodite_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau melihat pelataran Istana kita yang indah lagi! Maaf aku melewatkanmu, tapi monster-monster buruk rupa takkan pernah bisa menerobos ke sana selama {#Emph}aku {#Prev}bisa mencegahnya. Meski mereka {#Emph}memang {#Prev}mulai mendekat. Mereka {#Emph}sama sekali {#Prev}tak paham isyarat!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutTyphonW01"
    }
    {
      Id = "Aphrodite_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar berhasil, cantik! Monster buruk rupa itu akhirnya lenyap! Aku tak pernah tahu apakah dia punya hati, karena tak ada secuil pun cinta dalam dirinya, hanya niat dan hasrat terburuk. Musnah sudah {#Emph}semua itu!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutTyphonDeath01"
    }
    {
      Id = "Aphrodite_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Zeus sudah mencarimu lebih dulu, {#Emph}hm? {#Prev}Keluarga atau bukan, jika dia menawarkan berkatnya padamu, dia pasti mengharapkan imbalan. Dia paling enggan meminta bantuan secara langsung, itu saja masalahnya."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutZeus01"
    }
    {
      Id = "Aphrodite_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah berkenalan dengan Ratu Hera, kulihat! Dia dan aku sering bekerja sama dan memiliki kesepahaman tersendiri. Bagaimanapun juga, dewi-dewi rupawan harus saling mendukung."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutHera01"
    }
    {
      Id = "Aphrodite_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar Poseidon membual telah memberkatimu dengan kekuatannya. Nah, andaikata masih ada yang merasa kurang bahkan setelah semua {#Emph}itu{#Prev}, ambillah ini."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutPoseidon01"
    }
    {
      Id = "Aphrodite_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apollo yang cemerlang sudah menghubungimu, {#Emph}hm? {#Prev}Cepat sekali dia mengulurkan tangan pada dewi rupawan. Padahal, batang hidungnya sama sekali tak terlihat sewaktu saudaramu butuh bantuan!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutApollo01"
    }
    {
      Id = "Aphrodite_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Hestia tua yang berapi-api itu tertarik padamu, {#Emph}hm? {#Prev}Kau pantas sangat bangga, karena biasanya dia tak acuh. Dan dia mustahil dibuat terkesan."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutHestia01"
    }
    {
      Id = "Aphrodite_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lega sekali rasanya kau dan nenekmu yang dingin itu akhirnya berkesempatan untuk bertemu! Jika tak ada yang lain, setidaknya mungkinkah Demeter sekarang bisa sedikit lebih lunak pada kami semua?"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutDemeter01"
    }
    {
      Id = "Aphrodite_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah bertemu dengan Hephaestus-ku yang berlengan kekar, {#Emph}hm? {#Prev}Cemoohan tak sedap yang dikatakan tentang kami berdua, sama sekali tak dipedulikannya! Andai saja kulit{#Emph}ku {#Prev}bisa setebal kulit{#Emph}nya{#Prev}..."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutHephaestus01"
    }
    {
      Id = "Aphrodite_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar banyak pahlawan berujar bahwa berkah Hephaestus adalah hal terbaik kedua setelah senjata buatannya! Meski kurasa mereka semua lebih mendambakan berkahku."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutHephaestus02"
    }
    {
      Id = "Aphrodite_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di antara semua kerabat Paduka Zeus, kau masih belum bersua dengan Ares, {#Emph}hm? {#Prev}Sang dewa perang sedang amat sibuk dengan segala kemelut akhir-akhir ini. Ada pihak yang mempertanyakan motifnya, tapi bukan aku. Aku hanya ingin tahu di mana dia berada."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutAres01"
    }
    {
      Id = "Aphrodite_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paduka Ares akhirnya kembali! Tak ada yang meresmikan sebuah perang selain kedatangan{#Emph}nya{#Prev}. Keadaan tak selalu menguntungkan kita saat kita bertarung bersama, tapi kali ini hampir {#Emph}semuanya {#Prev}berkumpul di sini!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutAres02"
    }
    {
      Id = "Aphrodite_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lebih sering akhir-akhir ini, Hermes yang lincah tak tentu rimbanya. Setidaknya tidak ada di sini, tapi... mungkinkah di suatu tempat di alam{#Emph}mu{#Prev}, {#Emph}hm?"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutHermes01"
    }
    {
      Id = "Aphrodite_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Demi Rembulan, kau sungguh {#Emph}memesona {#Prev}malam ini! Sang Rembulan sendiri {#Emph}memang {#Prev}ikut andil dalam hal itu, bukan? Aku bisa mengetahuinya. Rahasiamu aman bersamaku!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutSelene01"
    }
    {
      Id = "Aphrodite_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hih{#Prev}, ada sesuatu yang sangat {#Emph}aneh {#Prev}malam ini, dan {#Emph}tentu saja {#Prev}kota Ephyra yang buruk rupa itu sama sekali tak membantu. Namun antara Hephaestus-ku tersayang, Paduka Ares, dan diriku, kurasa kau akan lebih dari mampu melewatinya."
      Speaker = "Aphrodite"
      Event = "AphroditePackageBountyIntro01"
    }
    {
      Id = "Aphrodite_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berlayar bisa terasa begitu romantis, tapi suasana malam ini {#Emph}benar-benar {#Prev}kacau... bagaimana bisa kau {#Emph}sampai {#Prev}sejauh ini begitu {#Emph}cepat? {#Prev}Yah, meski kondisi kita sedang tidak prima, kita tetap harus {#Emph}tampil {#Prev}sempurna!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutPackageBounty01"
    }
    {
      Id = "Aphrodite_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang rasanya tak ada lagi yang masuk akal, dan segalanya campur aduk. Tapi ya, begitulah hidup... kita tak bisa memilih apa yang kita dapatkan, kita hanya harus menjalaninya sebaik mungkin!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutRandomBounties01"
    }
    {
      Id = "Aphrodite_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Uuh{#Prev}, bulu kudukku baru saja meremang, dan ini sama sekali bukan sensasi yang {#Emph}menyenangkan{#Prev}, melainkan karena membayangkan kengerian yang mengintai di dalam kegelapan... di luar sana begitu gelap dan mencekam, jadi berjanjilah kau akan berhati-hati, sayang!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutShrine01"
    }
    {
      Id = "Aphrodite_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penyihir memahami malam lebih baik daripada siapa pun, jadi mungkin {#Emph}kau {#Prev}bisa menjelaskan apa yang membuat semua musuh kita begitu mengamuk? Keadaan di luar sangat mengerikan sekarang, rasanya aku lebih memilih berdiam diri di dalam rumah!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutShrine02"
    }
    {
      Id = "Aphrodite_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak pemuja yang bisa dipilih, {#Emph}hm? {#Prev}Ingatlah, kau sama sekali tak perlu memilih, kecuali jika kau dan mereka memang sama-sama menginginkannya. Hatimu, hubunganmu. Jalani saja sesukamu!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutRelationship01"
    }
    {
      Id = "Aphrodite_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau membawa Cermin Cantik milikku! Kau akan selalu tampak memukau di dalamnya, tapi kekuatan aslinya adalah membantuku menemukanmu dengan cepat. Dan melimpahkan yang terbaik yang kubisa untukmu!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutKeepsake01"
    }
    {
      Id = "Aphrodite_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mm{#Prev}, kau membawa Hembusan Eros bersamamu, jika inderaku tak salah! Bukankah indah rasanya mengetahui bahwa Cinta adalah salah satu kekuatan paling {#Emph}kuno {#Prev}di seluruh penjuru dunia ini? Hidup {#Emph}bukan apa-apa {#Prev}tanpanya!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutEros01"
    }
    {
      Id = "Aphrodite_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, bukankah itu kilauan Apel Emas yang kau bawa, sayang? Sudah kuduga seleramu sangat berkelas. Manfaatnya jauh lebih banyak dari yang bisa kau bayangkan! Meracik Nektar terlezat, mengalihkan perhatian saingan yang jelita, memicu perang besar, apa saja!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutApples01"
    }
    {
      Id = "Aphrodite_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, aku sempat bilang kalau Apel Emas bisa diolah jadi Nektar, tapi belum memberitahu {#Emph}caranya! {#Prev}Nanti kukirimkan resepnya. Yang kau butuhkan hanyalah kuali mendidih, beberapa rempah wangi sesuai seleramu, dan mantra yang tepat. Kau pasti bisa, kau kan penyihir!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutNectar01"
    }
    {
      Id = "Aphrodite_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, apa kau sudah mencoba resep Nektarku, manis? Aku yakin ramuan itu bisa memikat siapa saja jika berada di tanganmu yang {#Emph}lihai{#Prev}. Tak usah repot-repot memberi tahuku hasilnya, aku selalu punya caraku sendiri untuk mencari tahu!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutNectar02"
    }
    {
      Id = "Aphrodite_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Astaga, kobaran {#Emph}api {#Prev}menawan apa yang sedang kau gunakan itu? Nyalanya seolah bersinar laksana fajar pertama; tadinya kukira itu tak akan cocok dengan gayamu, tapi kau {#Emph}benar-benar {#Prev}bisa membawakannya!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutEosAspect01"
    }
    {
      Id = "Aphrodite_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, selain kepuasan batin tersendiri dari menghajar Titan tua bangka itu, apakah ada rencana yang lebih besar tentang apa yang akan kita lakukan nanti? Adik dewa kecilmu itu, apakah dia akan baik-baik saja...?"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutChronosBossW01"
    }
    {
      Id = "Aphrodite_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lama sekali, sayang, sampai-sampai aku sempat merasa sedikit {#Emph}cemas! {#Prev}Tapi kemudian seekor burung kecil memberi tahuku bahwa kau telah melangkah jauh ke dasar sana, bahkan meraih sejumlah keberhasilan? Tak sabar rasanya mendengar semua cerita serunya!"
      Speaker = "Aphrodite"
      Event = "AphroditeUnderworldRunCleared01"
    }
    {
      Id = "Aphrodite_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar menghajarnya, bukan, jelita? Seekor burung kecil memberi tahuku {#Emph}semuanya{#Prev}, tentang bagaimana kau bertempur sampai ke kedalaman busuk itu, dan berhasil {#Emph}menumbangkan {#Prev}Chronos! Meski begitu, dia sudah bangkit lagi dan jauh lebih murka dari sebelumnya, bukan...?"
      Speaker = "Aphrodite"
      Event = "AphroditeUnderworldRunCleared02"
    }
    {
      Id = "Aphrodite_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terakhir kali, kau benar-benar membawa perubahan besar di sini, tahu! Seharusnya aku tak terkejut, namun tetap saja, seorang dewi sendirian melakukan pekerjaan sebanyak itu? Kau sungguh sebuah inspirasi, sayang! Sekaligus {#Emph}mengerikan{#Prev}!"
      Speaker = "Aphrodite"
      Event = "AphroditeSurfaceRunCleared01"
    }
    {
      Id = "Aphrodite_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tampak sesegar embun malam ini, jelita! Baru saja memanjakan diri di pemandian air panas, {#Emph}hm? {#Prev}Tak ada yang menandingi nikmatnya berendam air hangat, {#Emph}terutama {#Prev}saat bersama teman yang menyenangkan."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutBathHouse01"
    }
    {
      Id = "Aphrodite_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, kau pasti baru saja mengunjungi pemandian air panas lagi! Aura menyegarkan itu begitu terpancar darimu, sayang. Kira-kira dengan siapa kau berendam, ya? Aku yakin seekor burung kecil akan segera membisikkannya padaku."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutBathHouse02"
    }
    {
      Id = "Aphrodite_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, apakah itu semacam makhluk mungil yang menggemaskan bersamamu, jelita? Kalau begitu pengagummu datang dalam segala bentuk dan rupa, ya! Kalau aku sendiri, biasanya hanya memikat dewa dan manusia fana."
      Speaker = "Aphrodite"
      Event = "AphroditeAboutFamiliars01"
    }
    {
      Id = "Aphrodite_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pakaian apa yang sedang kau {#Emph}kenakan {#Prev}itu, jelita? Gaun sutra yang begitu indah, buatan Arachne jika mataku tak salah! Kau dan laba-laba kecil itu pasti {#Emph}benar-benar {#Prev}sangat akrab!"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutOutfits01"
    }
    {
      Id = "Aphrodite_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gairah berkobar di saat-saat yang paling tak terduga, mendorong kita melampaui batas yang kita ketahui! Kumohon sambutlah itu sepertiku, dan melangkahlah dengan segenap berkatku, dari lubuk hatiku yang terdalam!"
      Speaker = "Aphrodite"
      Event = "AphroditeLegendaryPickUp01"
    }
    {
      Id = "Aphrodite_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu kan, jelita, aku suka bila segala sesuatunya berjalan sesuai keinginanku. Dan saat ini, aku ingin kau membabat habis jalan berdarah ini melewati setiap bajingan dan pengkhianat yang berani menghalangimu. {#Emph}Bisa, kan?"
      Speaker = "Aphrodite"
      Event = "AphroditeLegendaryPickUp02"
    }
    {
      Id = "Aphrodite_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jelita, kau memenangkan {#Emph}perang {#Prev}ini untuk kita! Setidaknya kurasa kita menang? Mungkin juga belum jika Satir-satir buruk rupa itu dan anteknya belum mau pergi, tapi kau jelas-jelas telah melakukan {#Emph}sesuatu! Ah{#Prev}, semua ini sungguh luar biasa {#Emph}banyaknya!"
      Speaker = "Aphrodite"
      Event = "AphroditePostTrueEnding01"
    }
    {
      Id = "Aphrodite_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos bermuka dua itu sekarang berpihak pada kita? Melawan versi dirinya di masa lalu yang menjijikkan, dan serpihan gaib Typhon yang tak perlu {#Emph}terlalu {#Prev}kita takuti tapi tetap harus diwaspadai. Memang bukan situasi teraneh yang pernah kuhadapi, tapi sudah {#Emph}hampir {#Prev}mendekati!"
      Speaker = "Aphrodite"
      Event = "AphroditePostTrueEnding02"
    }
    {
      Id = "Aphrodite_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kau tak akan terus menuju ke mari setelah urusan kita dengan Typhon selesai, tapi kau belum benar-benar selesai dengannya, kan? Tolong sampaikan salam hangat dariku jika kau bertemu dengannya, {#Emph}ya?"
      Speaker = "Aphrodite"
      Event = "AphroditePostTrueEndingAboutTyphon01"
    }
    {
      Id = "Aphrodite_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa dewa lain bertanya-tanya mengapa kau tak memilih untuk menetap saja di Griya besarmu yang megah di Tartarus itu, tapi mereka tak paham kalau kita butuh kebebasan! Mana ada orang yang mau kembali tinggal bersama orang tua setelah berhasil angkat kaki?"
      Speaker = "Aphrodite"
      Event = "AphroditePostTrueEndingAboutHouse01"
    }
    {
      Id = "Aphrodite_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ohh{#Prev}, Tiga Dewi Takdir {#Emph}akhirnya {#Prev}memutuskan untuk menampakkan diri, tepat saat kita mulai terbiasa tanpa kehadiran mereka. Ramalan agung apa lagi yang mereka siapkan untuk kita sekarang, {#Emph}hm? {#Prev}Apa pun itu, aku yakin kita pasti bisa mengatasinya!"
      Speaker = "Aphrodite"
      Event = "AphroditePostEpilogue01"
    }
    {
      Id = "Aphrodite_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika zaman baru memang benar-benar akan datang, maka kuhadapi dengan tangan terbuka! Cinta sejati takkan pernah pudar atau lekang oleh waktu, tak peduli seberapa banyak hal lain yang berubah. Tetaplah bersamaku dan kita akan {#Emph}baik-baik saja!"
      Speaker = "Aphrodite"
      Event = "AphroditePostEpilogue02"
    }
    {
      Id = "Aphrodite_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahasa cinta melampaui segala batas... kita bahkan tak perlu bertukar kata untuk saling memahami perasaan dan hasrat masing-masing. Bagaimana kalau kita mencobanya sebentar, {#Emph}hm?"
      Speaker = "Aphrodite"
      Event = "AphroditeAboutSayingLittle01"
    }
    {
      Id = "Aphrodite_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang sekali bisa bertemu dengan{#Emph}mu {#Prev}lagi, jelita!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat01"
    }
    {
      Id = "Aphrodite_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau tampak benar-benar {#Emph}memesona {#Prev}di bawah siraman cahaya perak itu!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat02"
    }
    {
      Id = "Aphrodite_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rahasia sesama dewi, kuharap kau habisi {#Emph}siapa saja {#Prev}yang berani menghalangi jalanmu!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat03"
    }
    {
      Id = "Aphrodite_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selama kau menyimpan cinta di dalam hatimu, segalanya pasti akan baik-baik saja!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat04"
    }
    {
      Id = "Aphrodite_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang begitu indah untuk tugas sekotor yang harus kau lakukan!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat05"
    }
    {
      Id = "Aphrodite_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan di saat-saat kelam sekalipun, kita selalu bisa menemukan {#Emph}sesuatu {#Prev}untuk dicintai!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat06"
    }
    {
      Id = "Aphrodite_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hidup akan terasa begitu membosankan jika kita tak punya masalah pribadi, {#Emph}bukan?"
      Speaker = "Aphrodite"
      Event = "AphroditeChat07"
    }
    {
      Id = "Aphrodite_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, andai saja {#Emph}tatapan {#Prev}bisa membunuh, jelita!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat08"
    }
    {
      Id = "Aphrodite_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Senang sekali {#Prev}bisa bertemu denganmu lagi, manis!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat09"
    }
    {
      Id = "Aphrodite_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku {#Emph}benar-benar {#Prev}menikmati jalan-jalan malam kita ini!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat10"
    }
    {
      Id = "Aphrodite_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak pertarungan dan pertumpahan darah, semua demi keluarga kita!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat11"
    }
    {
      Id = "Aphrodite_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti ada {#Emph}sesuatu {#Prev}yang bisa kubantu, bukan begitu, sayang?"
      Speaker = "Aphrodite"
      Event = "AphroditeChat12"
    }
    {
      Id = "Aphrodite_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semakin mereka teralihkan olehmu, semakin mudah mereka untuk dihabisi!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat13"
    }
    {
      Id = "Aphrodite_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, betapa aku mendambakan kedatanganmu, rupawan!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat14"
    }
    {
      Id = "Aphrodite_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita hanyalah dua dewi menawan yang sedang menikmati malam bersama!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat15"
    }
    {
      Id = "Aphrodite_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekeras apa pun usaha mereka, {#Emph}jangan pernah {#Prev}biarkan mereka menyentuhmu, manis."
      Speaker = "Aphrodite"
      Event = "AphroditeChat16"
    }
    {
      Id = "Aphrodite_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kutemukan dirimu lagi, jelita! Oh, ini {#Emph}selalu {#Prev}menyenangkan!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat17"
    }
    {
      Id = "Aphrodite_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah {#Emph}rupawan {#Prev}apa adanya. Meski begitu, {#Emph}aku {#Prev}masih bisa menyempurnakannya, tentu saja!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat18"
    }
    {
      Id = "Aphrodite_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siapa pun yang cari gara-gara {#Emph}denganmu{#Prev}, sayang, berarti mereka berurusan {#Emph}denganku {#Prev}juga."
      Speaker = "Aphrodite"
      Event = "AphroditeChat19"
    }
    {
      Id = "Aphrodite_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian para penyihir bisa {#Emph}sangat {#Prev}sulit ditangkap, tapi aku tahu {#Emph}persis {#Prev}di mana menemukanmu!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat20"
    }
    {
      Id = "Aphrodite_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begini terus, kau bisa mematahkan hati lebih banyak orang daripada {#Emph}aku!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat21"
    }
    {
      Id = "Aphrodite_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mmm{#Prev}, kalian para penyihir menikmati {#Emph}semua {#Prev}kesenangannya, ya?"
      Speaker = "Aphrodite"
      Event = "AphroditeChat22"
    }
    {
      Id = "Aphrodite_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tolong luangkan sedikit perhatian untukku, yang terkurung seperti biasa di puncak gunung ini..."
      Speaker = "Aphrodite"
      Event = "AphroditeChat23"
    }
    {
      Id = "Aphrodite_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Akhirnya! {#Prev}Kupikir kau mencampakkanku, jelita!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat24"
    }
    {
      Id = "Aphrodite_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku sudah mendambakan ini sejak kencan kecil kita yang terakhir!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat25"
    }
    {
      Id = "Aphrodite_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kali ini aku punya sesuatu yang {#Emph}sangat pas {#Prev}untukmu, manis!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat26"
    }
    {
      Id = "Aphrodite_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, {#Emph}halo{#Prev}, rupawan! Semoga berkat termanisku selalu menyertaimu."
      Speaker = "Aphrodite"
      Event = "AphroditeChat27"
    }
    {
      Id = "Aphrodite_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ke mana pun kau pergi, selalu ada {#Emph}drama {#Prev}yang menantimu, bukan begitu?"
      Speaker = "Aphrodite"
      Event = "AphroditeChat28"
    }
    {
      Id = "Aphrodite_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga berkatku mengangkat jiwamu bak bisikan manis yang mesra di telingamu."
      Speaker = "Aphrodite"
      Event = "AphroditeChat29"
    }
    {
      Id = "Aphrodite_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiba-tiba saja aku sangat ingin melihatmu lagi, dan akhirnya, kau ada di sini!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat30"
    }
    {
      Id = "Aphrodite_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita hadapi ini bersama, manis, dan jangan sampai kau melupakannya, {#Emph}ya?"
      Speaker = "Aphrodite"
      Event = "AphroditeChat31"
    }
    {
      Id = "Aphrodite_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ingatlah, perang kita melawan keburukan rupa takkan pernah berakhir! Sekarang, ayo bertarung!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat32"
    }
    {
      Id = "Aphrodite_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa pun yang layak dilakukan, layak dilakukan dengan penuh gairah! Jadi ayolah, cerialah sedikit!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat33"
    }
    {
      Id = "Aphrodite_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktunya bersenang-senang lagi di malam yang {#Emph}menggairahkan{#Prev}! Tunjukkan jalannya, jelita!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat34"
    }
    {
      Id = "Aphrodite_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan kita buat lutut mereka semua lemas tak berdaya. Dan seluruh tubuh mereka juga, untuk memastikan."
      Speaker = "Aphrodite"
      Event = "AphroditeChat35"
    }
    {
      Id = "Aphrodite_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak keindahan di dunia ini, dan jika bukan kita yang melindunginya, siapa lagi?"
      Speaker = "Aphrodite"
      Event = "AphroditeChat36"
    }
    {
      Id = "Aphrodite_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku mencintai apa yang kulakukan, terutama saat aku turun tangan langsung."
      Speaker = "Aphrodite"
      Event = "AphroditeChat37"
    }
    {
      Id = "Aphrodite_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kembali ke kenyamanan Dunia Bawah malam ini? Akan kita percantik tempat itu dalam sekejap!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat38"
    }
    {
      Id = "Aphrodite_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menuju ke arah {#Emph}kami {#Prev}lagi! Membayangkannya saja sudah membuat jantungku berdegup kencang!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat39"
    }
    {
      Id = "Aphrodite_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkinkah malam ini berjalan lebih indah dari semalam? Mari kita cari tahu!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat40"
    }
    {
      Id = "Aphrodite_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam kemarin mungkin bukan yang terbaik bagi kita, tapi semua itu akan segera berbalik!"
      Speaker = "Aphrodite"
      Event = "AphroditeChat41"
    }
    {
      Id = "Aphrodite_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku ingin ini menjadi kejutan, sayang! Siapa yang bisa meminta kejutan lebih baik daripada membuka kantong usang, lalu menemukan {#Emph}aku {#Prev}menunggu di sana dengan tangan terbuka lebar?"
      Speaker = "Aphrodite"
      Event = "AphroditeBlindBox01"
    }
    {
      Id = "Aphrodite_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau tadi mengharapkan seseorang yang jauh kurang jelita, atau entah bagaimana kau sudah tahu ini {#Emph}aku? {#Prev}Mungkin kau bisa mendengar detak jantungku dari tempat {#Emph}kau {#Prev}berada!"
      Speaker = "Aphrodite"
      Event = "AphroditeBlindBox02"
    }
    {
      Id = "Aphrodite_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tukang Perahu-mu di sana punya pekerjaan yang sungguh {#Emph}buruk{#Prev}, harus menyelundupkan berkah-berkah kecil seperti ini ke tempat {#Emph}paling terpuruk{#Prev}... tapi kami membayarnya dengan sangat pantas, jangan cemaskan itu."
      Speaker = "Aphrodite"
      Event = "AphroditeLootBought01"
    }
    {
      Id = "Aphrodite_0137"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, menjadi bantuan darurat di medan perang yang diantarkan langsung oleh si Tukang Perahu yang ditakuti itu, {#Emph}hah! {#Prev}Ayolah, kita semua punya fantasi, cantik!"
      Speaker = "Aphrodite"
      Event = "AphroditeLootBought02"
    }
    {
      Id = "Aphrodite_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau punya hubungan saling mengerti yang sungguh mendalam dengan Tukang Perahu itu, ya? Jiwanya begitu menyendiri. Kasar... tinggi... bertubuh kekar. {#Emph}Hm!"
      Speaker = "Aphrodite"
      Event = "AphroditeLootBought03"
    }
    {
      Id = "Aphrodite_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Charon yang tepercaya akhirnya berhasil menemuimu, dan tepat pada waktunya untuk menghadapi ancaman paling mematikan di jalanmu. Semoga berkahku membawakanmu kemenangan!"
      Speaker = "Aphrodite"
      Event = "AphroditeLootBought04"
    }
    {
      Id = "Aphrodite_0150"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dunia kita ini bisa jadi tempat yang begitu buruk! Dipenuhi kesalahpahaman mengerikan yang bisa menutupi kecantikan yang begitu sering {#Emph}kurang kita hargai."
      Speaker = "Aphrodite"
      Event = "AphroditeRejection01"
    }
    {
      Id = "Aphrodite_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, cantik. Jika rasa bangga dan kesombongan sungguh sebuah kelemahan, maka aku akan membiarkan diriku begitu rapuh di hadapanmu saat ini..."
      Speaker = "Aphrodite"
      Event = "AphroditeRejection02"
    }
    {
      Id = "Aphrodite_0152"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira kita sesama wanita punya ikatan khusus, tapi kau malah berbuat begitu dan membuatku merasa ragu! Serta sedikit kesal."
      Speaker = "Aphrodite"
      Event = "AphroditeRejection03"
    }
    {
      Id = "Aphrodite_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menawarkan berkahku bukan agar bisa kau simpan untuk nanti seperti semacam camilan! Kau ingin yang lain, baiklah! Kau boleh {#Emph}mengambilnya{#Prev}."
      Speaker = "Aphrodite"
      Event = "AphroditeRejection04"
    }
    {
      Id = "Aphrodite_0154"
      InheritFrom = "BaseNarrative"
      DisplayName = "Meskipun sudah kucoba sekuat tenaga, aku tetap saja merasa sakit hati karena dicampakkan. Dan aku tidak menyukainya, tidak sama sekali. Jadi sekarang aku harus membalas menyengatmu!"
      Speaker = "Aphrodite"
      Event = "AphroditeRejection05"
    }
    {
      Id = "Aphrodite_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin ada orang yang bisa berdamai saat disingkirkan, tapi itu bukan hal yang bisa {#Emph}kulakukan{#Prev}, manis! Tak peduli seberapa keras aku mencoba."
      Speaker = "Aphrodite"
      Event = "AphroditeRejection06"
    }
    {
      Id = "Aphrodite_0156"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, jangan suka {#Emph}menggodaku {#Prev}seperti itu! Saat aku melimpahkan berkahku, terimalah dengan anggun lain kali. Tapi sekarang...?"
      Speaker = "Aphrodite"
      Event = "AphroditeRejection07"
    }
    {
      Id = "Aphrodite_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang kupikir kami tak seharusnya memaksamu pilih kasih, tapi tentu saja ada banyak hal yang tak seharusnya kami lakukan! Seperti marah padamu {#Emph}misalnya!"
      Speaker = "Aphrodite"
      Event = "AphroditeRejection08"
    }
    {
      Id = "Aphrodite_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lebih memilih Hephaestus tersayang daripada {#Emph}aku? {#Prev}Pasti ada kesalahan di sini, manis! Yang artinya pasti harus ada semacam {#Emph}hukuman..."
      Speaker = "Aphrodite"
      Event = "AphroditeRejection09"
    }
    {
      Id = "Aphrodite_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau {#Emph}bisa saja {#Prev}tidak ikut campur dalam pertengkaran kecil yang jarang terjadi ini antara aku dan Hephaestus-ku yang pekerja keras. Tapi jika kau {#Emph}benar-benar {#Prev}ingin terlibat, wah, {#Emph}silakan saja!"
      Speaker = "Aphrodite"
      Event = "AphroditeRejection10"
    }
    {
      Id = "Aphrodite_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sungguh tak terbiasa ditolak, dan {#Emph}tidak akan pernah {#Prev}terbiasa hanya gara-gara {#Emph}dirimu!"
      Speaker = "Aphrodite"
      Event = "AphroditeRejection11"
    }
    {
      Id = "Aphrodite_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mendahulukan yang tua daripada yang jelita, begitu? Karena aku tak bisa memikirkan penjelasan lain atas apa yang baru saja kau lakukan!"
      Speaker = "Aphrodite"
      Event = "AphroditeRejection12"
    }
    {
      Id = "Aphrodite_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Emosi kita tadi sempat {#Emph}agak {#Prev}memanas, ya... Aku masih bisa merasakan jantungku {#Emph}berdegup kencang{#Prev}, dan jika dugaanku tak salah, jantungmu {#Emph}juga begitu!"
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp01"
    }
    {
      Id = "Aphrodite_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, mari kita berbaikan, bagaimana menurutmu, cantik? Dengan segala hal yang terjadi belakangan ini, kupikir kita semua jadi agak mudah terpancing!"
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp02"
    }
    {
      Id = "Aphrodite_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu, aku jadi teringat satu hal yang menyatukan kita bahkan di saat-saat terburuk, yaitu kita semua punya {#Emph}sedikit {#Prev}sifat pemarah di sini!"
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp03"
    }
    {
      Id = "Aphrodite_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan rahasia lagi kalau aku ini mudah tersulut gairah dan amarah, dan aku tak ingin menjadi orang lain. Tapi kau {#Emph}bisa {#Prev}mengambil pilihan berbeda lain kali!"
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp04"
    }
    {
      Id = "Aphrodite_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, tadi itu memang pertarungan yang {#Emph}kumulai{#Prev}, sayang. Meski begitu, tiap kali gairah kita meluap, kurasa hubungan kita justru menjadi semakin intim karenanya!"
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp05"
    }
    {
      Id = "Aphrodite_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Fyuuh! {#Prev}Nah, bukankah kita sekarang merasa lebih lega? Kita tak boleh memendam perasaan, meski itu artinya sesekali kita harus meledak-ledak."
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp06"
    }
    {
      Id = "Aphrodite_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang mari kita redam emosi dan tenangkan detak jantung kita! Aku sudah tidak marah lagi, meski masih agak jengkel..."
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp07"
    }
    {
      Id = "Aphrodite_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm{#Prev}, yah, jika memang ada alasan bagus untuk menolak berkahku, apalagi demi kerabatku yang pencemburu itu, aku belum pernah mendengarnya!"
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp08"
    }
    {
      Id = "Aphrodite_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setiap hubungan pasti melibatkan sedikit pertengkaran sesekali. Selama kita bisa tumbuh semakin dewasa karenanya!"
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp09"
    }
    {
      Id = "Aphrodite_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau tak sanggup menghadapi amarah dariku, maka kau memang tak pantas mendapatkan diriku sedari awal!"
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp10"
    }
    {
      Id = "Aphrodite_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ditolak itu tak pernah terasa mudah, apalagi bagi dewi paling memikat di seluruh dunia!"
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp11"
    }
    {
      Id = "Aphrodite_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, kau telah memikat hatiku dengan betapa beraninya kau bertarung tadi! Semuanya telah kumaafkan. Untuk saat ini."
      Speaker = "Aphrodite"
      Event = "AphroditeMakeUp12"
    }
    {
      Id = "Melinoe_0948"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aphrodite yang Agung! Engkau pasti mendapatkan persembahan lebih banyak daripada gabungan semua dewa dan dewi lainnya. Namun, yang satu ini khusus datang dariku!"
      Speaker = "Melinoe"
      Event = "AphroditeGift01"
    }
    {
      Id = "Aphrodite_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, ini sungguh {#Emph}luar biasa{#Prev}, dan cukup mengesankan kau sudah mengetahui adat kita! Aku {#Emph}harus {#Prev}membalas budi, jadi kumohon, terimalah {#Emph}ini. {#Prev}Aku {#Emph}memaksa!"
      Speaker = "Aphrodite"
      Event = "AphroditeGift01"
    }
    {
      Id = "Melinoe_0949"
      InheritFrom = "BaseNarrative"
      DisplayName = "Engkau membuatku tidak lagi sering meragukan diriku sendiri, Nyonya Aphrodite. Engkau tidak keberatan menerima persembahan lain, kan?"
      Speaker = "Melinoe"
      Event = "AphroditeGift02"
    }
    {
      Id = "Aphrodite_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Persembahanmu ini {#Emph}sangat {#Prev}kusambut dengan hangat, sayang! Lagipula kalau dipikir-pikir, sudah terlalu lama sejak terakhir kali ada yang menghujaniku dengan pujian!"
      Speaker = "Aphrodite"
      Event = "AphroditeGift02"
    }
    {
      Id = "Melinoe_0950"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih begitu awam soal urusan hati. Pasti ada banyak sekali yang bisa kupelajari darimu, Nyonya Aphrodite. Sebuah kehormatan bisa bertemu denganmu."
      Speaker = "Melinoe"
      Event = "AphroditeGift03"
    }
    {
      Id = "Aphrodite_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, manis, kehormatan ini {#Emph}sepenuhnya {#Prev}milikku! Untuk urusan hati, kuncinya adalah keterbukaan. Jadi jalanmu sudah sangat tepat menuju pemahaman yang kau dambakan itu!"
      Speaker = "Aphrodite"
      Event = "AphroditeGift03"
    }
    {
      Id = "MelinoeField_1766"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebaikanmu begitu berarti bagiku, Nona Aphrodite. Seandainya saja ada cara untuk membalasnya! Bahkan di saat-saat paling kelam sekalipun, kau selalu memberiku kekuatan dan harapan."
      Speaker = "Melinoe"
      Event = "AphroditeGift04"
    }
    {
      Id = "Aphrodite_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belahan jiwaku, kau {#Emph}benar-benar {#Prev}istimewa, tahu tidak? Kau murah hati, tutur katamu tertata rapi, dan kau juga {#Emph}rupawan{#Prev}! Aku sampai bingung harus merasa tersanjung atau sedikit iri!"
      Speaker = "Aphrodite"
      Event = "AphroditeGift04"
    }
    {
      Id = "MelinoeField_1767"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aphrodite yang agung! Parasmu sungguh memikat, namun keberanian dan rasa percaya dirimu jauh lebih menginspirasiku. Aku merasa rendah hati berada di hadapanmu, dan beruntung bisa layak menerima berkahmu."
      Speaker = "Melinoe"
      Event = "AphroditeGift05"
    }
    {
      Id = "Aphrodite_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Awalnya aku tak tahu harus mengharapkan apa darimu. Rekan seperjuangan, paling banter? Aku pun nyaris tak mengenalmu, selain dari sekilas pandang lewat pesan-pesan ini, tapi terlepas dari semua itu... kini kuanggap kau sebagai seorang sahabat! Seseorang yang bisa kuajak bicara. Terima kasih ya, Sayang!"
      Speaker = "Aphrodite"
      Event = "AphroditeGift05"
    }
    {
      Id = "MelinoeField_1768"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku selalu memandang dunia ini indah... keindahan itu ada di sekeliling kita, bahkan di tengah pergolakan sekalipun. Dan aku tahu itu semua berkat {#Emph}dirimu{#Prev}, Aphrodite. Terima kasih telah membantuku menyadari semuanya."
      Speaker = "Melinoe"
      Event = "AphroditeGift06"
    }
    {
      Id = "Aphrodite_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemberian Nektar darimu pasti terasa jauh lebih manis dari yang lain! Jadi ketika awan gelap mulai membayangi di atas sana, dan secercah harapanku mulai sirna, aku akan bersulang untuk kita berdua. Dan semangatku pasti langsung kembali membara!"
      Speaker = "Aphrodite"
      Event = "AphroditeGift06"
    }
    {
      Id = "MelinoeField_4347"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aphrodite, antusiasmemu yang tulus bahkan di tengah penderitaan seperti ini adalah alasan utama yang membuatmu begitu jelita dan tiada tanding menginspirasi. Rasanya Ambrosia semacam ini melambangkan seluruh cinta yang kau curahkan."
      Speaker = "Melinoe"
      Event = "AphroditeGift07"
    }
    {
      Id = "Aphrodite_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, kau {#Emph}manis {#Prev}sekali! Meski pujian seperti ini takkan pernah membosankan. Aku memang sudah {#Emph}terbiasa {#Prev}melihat semua orang memuja {#Emph}paras ayuku! {#Prev}Namun jika kau bisa melihat melampaui itu, ke {#Emph}kecantikan batin {#Prev}yang kumiliki, berarti kau memahami cinta dan keindahan {#Emph}jauh {#Prev}lebih dalam daripada {#Emph}kebanyakan orang{#Prev}."
      Speaker = "Aphrodite"
      Event = "AphroditeGift07"
    }
    {
      Id = "Melinoe_1738"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mustahil bagiku menolak hadiah seindah ini."
      Speaker = "Melinoe"
      Event = "AphroditeUpgrade.GiftGivenVoiceLines"
    }
    {
      Id = "Aphrodite_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mm-{#Emph}hmm!"
      Speaker = "Aphrodite"
      Event = "AphroditeUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Aphrodite_0106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengan senang hati."
      Speaker = "Aphrodite"
      Event = "AphroditeUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Aphrodite_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ikuti kata hatimu."
      Speaker = "Aphrodite"
      Event = "AphroditeUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Aphrodite_0168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beres!"
      Speaker = "Aphrodite"
      Event = "AphroditeUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Aphrodite_0169"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja!"
      Speaker = "Aphrodite"
      Event = "AphroditeUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Aphrodite_0170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti!"
      Speaker = "Aphrodite"
      Event = "AphroditeUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Aphrodite_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini untukmu!"
      Speaker = "Aphrodite"
      Event = "AphroditeUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Aphrodite_0172"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa pun demi kamu!"
      Speaker = "Aphrodite"
      Event = "AphroditeUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Aphrodite_0173"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja, Sayang!"
      Speaker = "Aphrodite"
      Event = "AphroditeUpgrade.RarityUpgradeVoiceLines"
    }
    {
      Id = "Aphrodite_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka pasti bakal menyukai yang {#Emph}ini!"
      Speaker = "Aphrodite"
      Event = "AphroditeUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Aphrodite_0100"
      InheritFrom = "BaseSubtitle"
