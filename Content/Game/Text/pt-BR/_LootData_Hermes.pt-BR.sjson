  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_1884"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Hermes, tetaplah tak kasat mata."
      Speaker = "Melinoe"
      Event = "HermesUpgrade.InteractVoiceLines"
    }
    {
      Id = "Hermes_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau juga!"
      Speaker = "Hermes"
      Event = "HermesUpgrade.InteractVoiceLines"
    }
    {
      Id = "Hermes_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei hei!"
      Speaker = "Hermes"
      Event = "HermesUpgrade.InteractVoiceLines"
    }
    {
      Id = "Hermes_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei!"
      Speaker = "Hermes"
      Event = "HermesUpgrade.InteractVoiceLines"
    }
    {
      Id = "Hermes_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gahar!"
      Speaker = "Hermes"
      Event = "HermesUpgrade.InteractVoiceLines"
    }
    {
      Id = "Hermes_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersulang!"
      Speaker = "Hermes"
      Event = "HermesUpgrade.InteractVoiceLines"
    }
    {
      Id = "Hermes_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama!"
      Speaker = "Hermes"
      Event = "HermesUpgrade.InteractVoiceLines"
    }
    {
      Id = "Hermes_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yoi!"
      Speaker = "Hermes"
      Event = "HermesUpgrade.InteractVoiceLines"
    }
    {
      Id = "Hermes_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja!"
      Speaker = "Hermes"
      Event = "HermesUpgrade.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_2002"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hermes...!"
      Speaker = "Melinoe"
      Event = "HermesUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Olympus membutuhkanku... di permukaan?"
      Speaker = "Melinoe"
      Event = "HermesUpgrade.UpgradeMenuOpenVoiceLines"
    }
    {
      Id = "Hermes_0158"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ups!"
      Speaker = "Hermes"
      Event = "TextLinesEndEvents.VoiceLines"
    }
    {
      Id = "Hermes_0159"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oke!"
      Speaker = "Hermes"
      Event = "TextLinesEndEvents.VoiceLines"
    }
    {
      Id = "Hermes_0160"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Eh!"
      Speaker = "Hermes"
      Event = "TextLinesEndEvents.VoiceLines"
    }
    {
      Id = "Hermes_0161"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...dan, ya."
      Speaker = "Hermes"
      Event = "TextLinesEndEvents.VoiceLines"
    }
    {
      Id = "Hermes_0162"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hap!"
      Speaker = "Hermes"
      Event = "TextLinesEndEvents.VoiceLines"
    }
    {
      Id = "Hermes_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ehm!"
      Speaker = "Hermes"
      Event = "TextLinesEndEvents.VoiceLines"
    }
    {
      Id = "Hermes_0164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hm!"
      Speaker = "Hermes"
      Event = "TextLinesEndEvents.VoiceLines"
    }
    {
      Id = "Hermes_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oh!"
      Speaker = "Hermes"
      Event = "TextLinesEndEvents.VoiceLines"
    }
    {
      Id = "Hermes_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya kau kena sedikit rintangan di perjalananmu ke sana, M! Perhatikan langkahmu, ya, meski aku tahu menjaga langkah saat bergerak secepat itu memang sulit!"
      Speaker = "Hermes"
      Event = "HermesLowHealth01"
    }
    {
      Id = "Hermes_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Medan di luar sana kasar sekali malam ini, ya, M? Kalau begitu bertahanlah, dan mungkin salah satu dari {#Emph}ini {#Prev}bisa membantumu melangkah sedikit lebih jauh, {#Emph}lebih cepat!"
      Speaker = "Hermes"
      Event = "HermesLowHealth02"
    }
    {
      Id = "Hermes_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, tidak! Kau terluka! Ada apa denganmu, M? Kakek tua pasti sudah mendahuluiku menghajarmu! Bagaimana bisa hal itu terjadi...?"
      Speaker = "Hermes"
      Event = "HermesLowHealth03"
    }
    {
      Id = "Hermes_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan tempat paling aman untuk pelesir, ya, M? Yah, kau dapat satu-dua lecet, lalu kenapa! Sekarang saatnya kau memacu kecepatan!"
      Speaker = "Hermes"
      Event = "HermesLowHealth04"
    }
    {
      Id = "Hermes_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, M! Kudengar kau berangkat lagi, kupikir sebaiknya aku mampir sebentar dan melepas kepergianmu! Semoga perjalananmu aman, dan segala tetek bengeknya!"
      Speaker = "Hermes"
      Event = "HermesRunStart01"
    }
    {
      Id = "Hermes_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih jauh perjalanan dari sana, kan, M? Kalau begitu mari kita lihat apakah kita bisa memangkas sedikit waktu tempuh ke tujuanmu berikutnya!"
      Speaker = "Hermes"
      Event = "HermesRunStart02"
    }
    {
      Id = "Hermes_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir aku bisa menyusulmu tepat saat kau bersiap pergi! Perjalanan memang bisa jadi pengalaman yang memuaskan, tapi terkadang, kau cuma ingin cepat sampai di tujuan!"
      Speaker = "Hermes"
      Event = "HermesRunStart03"
    }
    {
      Id = "Hermes_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perlombaan lain menuju garis akhir dimulai kembali, ya, M? Kalau begitu, {#Emph}bersiaplah{#Prev}, karena kami akan membuatmu tiba di sana secepat kilat! Asalkan kau selamat dari rintangan dan segalanya..."
      Speaker = "Hermes"
      Event = "HermesRunStart04"
    }
    {
      Id = "Hermes_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "M, aku sama sekali tak bermaksud memperlambatmu, terutama saat kau baru memulai aksi malam ini! Jadi pilihlah satu berkat, lalu segera enyah {#Emph}keluar {#Prev}dari sana!"
      Speaker = "Hermes"
      Event = "HermesRunStart05"
    }
    {
      Id = "Hermes_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira kau bisa menyelinap keluar dari sana tanpa menerima Berkatku? Kau salah besar, M! Dan sekarang kau juga akan bergerak jauh lebih gesit!"
      Speaker = "Hermes"
      Event = "HermesRunStart06"
    }
    {
      Id = "Hermes_0088"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah cukup menghirup udara permukaan untuk saat ini, aku paham, M. Jalur yang lebih familier memang sering kali jadi yang terbaik! Bagaimanapun juga, jalani ini dengan tokomu sendiri. Jangan biarkan siapa pun memburumu! Kecuali aku."
      Speaker = "Hermes"
      Event = "HermesUnderworldStart01"
    }
    {
      Id = "Hermes_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pesan dari Olympus, M! Isinya begini: {#Emph}Kenapa kau bersusah payah di Dunia Bawah? Kami benar-benar membutuhkanmu di atas sini, hanya saja gengsi kami terlalu tinggi untuk memintanya! {#Prev}Tapi {#Emph}aku {#Prev}tidak segengsi itu."
      Speaker = "Hermes"
      Event = "HermesUnderworldStreak01"
    }
    {
      Id = "Hermes_0086"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menunjukkan pada Kakek tua siapa bosnya! {#Emph}Kerja bagus, M! {#Prev}Itu pasti membuatnya tersandung sejenak. Saat yang tepat untuk naik ke atas dan bantu kami mengusir pasukannya dari daerah kekuasaan {#Emph}kami{#Prev}. Bagaimana menurutmu?"
      Speaker = "Hermes"
      Event = "HermesRunStartSurface01"
    }
    {
      Id = "Hermes_0087"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak heran Kakek tua adalah lawan yang tangguh, tapi maaf dia sempat menghajarmu semalam. Dan terima kasih sudah menuju ke arah {#Emph}sini{#Prev}! {#Emph}Waktu {#Prev}belum akan lari ke mana-mana, tapi gunung ini mungkin saja runtuh!"
      Speaker = "Hermes"
      Event = "HermesRunStartSurface02"
    }
    {
      Id = "Hermes_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagus sekali, kau menuju ke arah sini dan belum pergi terlalu jauh! Kupikir kau bisa mencatat rekor waktu yang bagus dalam perjalanan ke sini, meski pilihan tetap ada di tanganmu!"
      Speaker = "Hermes"
      Event = "HermesRunStartSurface03"
    }
    {
      Id = "Hermes_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau tidak bisa menghirup udara permukaan kami selamanya, M, jadi untunglah aku berhasil menemuimu tepat saat kau baru mulai! Kita akan membuatmu tiba di puncak gunung ini praktis dalam sekejap mata."
      Speaker = "Hermes"
      Event = "HermesRunStartSurface04"
    }
    {
      Id = "Hermes_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pesan dari Olympus, M! Katanya, {#Emph}Terima kasih banyak atas segala bantuannya akhir-akhir ini, kami tahu kau bisa saja memilih bertarung melawan Kakek di Tartarus sana. {#Prev}Itu kata-kata Athena, ya, bukan kataku!"
      Speaker = "Hermes"
      Event = "HermesRunSurfaceStreak01"
    }
    {
      Id = "Hermes_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "M, aku tahu ini bukan perjalanan yang mudah, atau bahkan mungkin mustahil bagimu saat ini, mendaki jauh sampai ke atas sini. Tapi bayangkan betapa beratnya bagi keluarga kita untuk menelan harga diri dan meminta bantuan! Keadaannya segenting itu!"
      Speaker = "Hermes"
      Event = "HermesAboutReachingSurface01"
    }
    {
      Id = "Hermes_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi masa-masa genting nih, M, dan kami butuh kau di dasar Dunia Bawah, {#Emph}sekaligus {#Prev}di puncak Olympus! Berada di dua tempat sekaligus, aku turut prihatin. Tapi {#Emph}kuncinya {#Prev}adalah bergerak sangat, amat cepat!"
      Speaker = "Hermes"
      Event = "HermesAboutRouteChoice01"
    }
    {
      Id = "Hermes_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil melangkah cukup jauh di bawah sana sebelumnya! Kerja bagus yang mengesankan, aku tahu kau pasti bisa, M! Tapi Kakek masih belum mau mundur juga, kan? Yah, setidaknya mungkin dia mulai berpikir dua kali!"
      Speaker = "Hermes"
      Event = "HermesUnderworldRunCleared01"
    }
    {
      Id = "Hermes_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang kau hadapi tadi malam itu bukan Kakek yang asli, melainkan semacam anomali probabilitas yang terjadi gara-gara caramu mengalahkannya di awal? Aku sudah melihat banyak hal gila, M, tapi yang ini baru pertama kali!"
      Speaker = "Hermes"
      Event = "HermesUnderworldRunCleared02"
    }
    {
      Id = "Hermes_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi malam menandai tumbangnya satu lagi si Chronos tua yang menyebalkan itu! Kedengarannya masih banyak versi dirinya yang harus kita basmi, tapi aku yakin kita bakal mulai membereskan mereka makin lama makin cepat!"
      Speaker = "Hermes"
      Event = "HermesUnderworldRunCleared03"
    }
    {
      Id = "Hermes_0065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar membantu membalikkan keadaan di sini! Berhasil menerobos kepungan dan memberi para kerabat kita waktu sejenak untuk bernapas lega. Memang belum selesai, perlu diingat, tapi kurasa kita bisa segera menuntaskannya!"
      Speaker = "Hermes"
      Event = "HermesSurfaceRunCleared01"
    }
    {
      Id = "Hermes_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita benar-benar berhasil menghajarnya, M! Si Typhon itu maksudku! Kulihat dia tergelincir jatuh dari sisi gelap gunung sampai ke dasarnya dan berbunyi {#Emph}duarrr! {#Prev}Lalu tak lama kemudian kulihat dia bangkit perlahan, dan meraung jauh lebih murka dari sebelumnya, tapi ya sudahlah!"
      Speaker = "Hermes"
      Event = "HermesSurfaceRunCleared02"
    }
    {
      Id = "Hermes_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bakal percaya kau memburu sisa-sisa wujud Typhon kalau tidak melihat seluruh kejadian itu dengan mata kepalaku sendiri! Waktu memang bekerja dengan cara yang aneh! Dan sepertinya kau memang bisa menghentikannya. Yah, sebagian darinya!"
      Speaker = "Hermes"
      Event = "HermesSurfaceRunCleared03"
    }
    {
      Id = "Hermes_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam berganti, satu lagi Typhon tumbang, tapi masih ada banyak lagi dari tempat asalnya, begitukah pemahamanmu, M? Syukurlah para Typhon itu tidak sampai bikin masalah buat kami di sini!"
      Speaker = "Hermes"
      Event = "HermesSurfaceRunCleared04"
    }
    {
      Id = "Hermes_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olympus sudah pernah dikepung sebelumnya! Biasanya, itu bukan masalah besar. Tapi Kakek punya rencana lain kali ini. Sampai-sampai beberapa orang di sini dibuat ketakutan setengah mati!"
      Speaker = "Hermes"
      Event = "HermesAboutOlympusSiege01"
    }
    {
      Id = "Hermes_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau lihat kan kami menyembunyikan beberapa perbekalan untukmu di atas puncak gunung, ya kan M? Memang agak sedikit di luar rute biasa bagi rekan profesionalku itu, tapi kami akan pastikan pasokanmu tetap aman!"
      Speaker = "Hermes"
      Event = "HermesAboutOlympusSiege02"
    }
    {
      Id = "Hermes_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah kenal Hec cukup lama, dan aku tidak iri pada kalian berdua. Dia tak bisa begitu saja mengirimmu untuk menghadapi Kakek sebelum kau benar-benar siap! Kau pasti {#Emph}benci {#Prev}setengah mati karena harus menunggu. Aku pun begitu!"
      Speaker = "Hermes"
      Event = "HermesAboutHecate01"
    }
    {
      Id = "Hermes_0040"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hec selalu bilang kau orangnya cepat belajar, tahu tidak? Dan benar saja, setiap kali aku mampir, kau selalu berada di depan kuali, merapal sihir baru. Nah, {#Emph}inilah saatnya! {#Prev}Waktumu untuk mengeluarkan sihir demi kepentingan kita semua!"
      Speaker = "Hermes"
      Event = "HermesAboutMelinoe01"
    }
    {
      Id = "Hermes_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bukan main pelanggannya, Sang Titan Waktu! Aku belum pernah bertemu Kakek sebelumnya, meski aku bisa membayangkan seperti apa sosoknya. Dulu aku sering heran kenapa ayahku dan saudara-saudaranya terkadang begitu licik. Sekarang aku tahu dari mana mereka mewarisinya!"
      Speaker = "Hermes"
      Event = "HermesAboutChronos01"
    }
    {
      Id = "Hermes_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir Titan Waktu tak bakal sebegini terjebaknya di masa lalu, terobsesi dengan gagasannya soal {#Emph}Zaman Keemasan {#Prev}ketika {#Emph}dia {#Prev}berkuasa dulu, dan para manusia fana hidup tanpa beban pikiran? Menurutku punya rasa peduli itu bukan hal buruk!"
      Speaker = "Hermes"
      Event = "HermesAboutChronos02"
    }
    {
      Id = "Hermes_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mustahil kau sudah bisa menghentikan Kakek sekarang, tapi dengan memburunya tepat di waktu yang kau lakukan, kau memberi kami waktu untuk mengacaukan sedikit rencananya. Jadi, {#Emph}terima kasih banyak!"
      Speaker = "Hermes"
      Event = "HermesAboutChronosPlan01"
    }
    {
      Id = "Hermes_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cyclops yang mencegatmu saat keluar dari kota itu? Sudah cukup lama nongkrong di sana, kukira lama-lama dia bakal pergi, ternyata tidak juga! Kakek pasti yang menyuruhnya..."
      Speaker = "Hermes"
      Event = "HermesAboutPolyphemus01"
    }
    {
      Id = "Hermes_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa dewa mengira Eris muncul di dekat gunung kita dan bikin onar lagi gara-gara kau! Mereka tak tahu kalau aku yang praktis {#Emph}memohon-mohon {#Prev}padamu agar datang menyelamatkan kami di sini. Mereka kira Hec yang memberimu perintah! Masalah kita makin runyam sekarang..."
      Speaker = "Hermes"
      Event = "HermesAboutEris01"
    }
    {
      Id = "Hermes_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masalah Titan kita ternyata lebih banyak dari perkiraan, M. Kalau Kakek saja bisa mengajak Prometheus memihaknya, siapa yang tahu siapa lagi berikutnya. Kita sudah memancing terlalu banyak amarah, bukan?"
      Speaker = "Hermes"
      Event = "HermesAboutPrometheus01"
    }
    {
      Id = "Hermes_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prometheus dan Heracles, ternyata mereka akrab, ya? Keributan kecilmu dengan mereka terselubung oleh kegelapan, tapi aku sempat melihat kilasan-kilasannya di sana-sini. Aku perlu tahu hal-hal semacam ini, tapi bukan berarti bakal kubocorkan!"
      Speaker = "Hermes"
      Event = "HermesAboutPrometheusAltFight01"
    }
    {
      Id = "Hermes_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau hampir saja mencapai puncak tertingginya saat itu, dan meski aku tak bermaksud merusak kejutan, kau {#Emph}harus {#Prev}tahu bahwa kita sekarang berurusan dengan si Typhon tua yang terhormat, Bapa Segala Monster! Asyik sekali, kan...? Kami butuh kau kembali ke sini, M."
      Speaker = "Hermes"
      Event = "HermesAboutTyphonReveal01"
    }
    {
      Id = "Hermes_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar baiknya kita sekarang bisa memastikan apa yang direncanakan Kakek untuk kita, tapi kabar buruknya, itu Typhon, dan dia berukuran raksasa. Tapi ayahku pernah menghentikannya sekali, jadi seberapa sulitkah itu jadinya...?"
      Speaker = "Hermes"
      Event = "HermesAboutTyphon01"
    }
    {
      Id = "Hermes_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menurutmu siapa yang bisa sampai ke puncak Gunung Olympus lebih dulu, M, kau atau si Typhon tua? Perjalananmu memang lebih jauh, tentu saja, tapi kau jelas lebih cepat! Atau setidaknya sebentar lagi bakal begitu!"
      Speaker = "Hermes"
      Event = "HermesAboutTyphon02"
    }
    {
      Id = "Hermes_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon lenyap untuk selamanya?! Ayahku saja masih belum percaya, tapi memang tak ada tanda-tanda monster itu lagi di atas sini semenjak terakhir kali kau melawannya! Tapi kenapa {#Emph}aku {#Prev}harus kaget? Aku sudah menduga kalau ada yang bisa melakukan hal sehebat itu, orangnya pasti {#Emph}kau!"
      Speaker = "Hermes"
      Event = "HermesAboutTyphonDeath01"
    }
    {
      Id = "Hermes_0084"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hec bilang padaku kalau Moros, putra Nyx, menginap bersamamu untuk sementara di bawah sana? Kukira dia selalu menempel dengan Tiga Morai. Ada sesuatu yang sedang terjadi, dan aku punya firasat buruk, M."
      Speaker = "Hermes"
      Event = "HermesAboutMoros01"
    }
    {
      Id = "Hermes_0085"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menemukan ayahmu di bawah sana, M! Aku sendiri tak pernah bisa mendekat cukup dekat, semoga dia baik-baik saja. Kuharap {#Emph}semua orang {#Prev}baik-baik saja! Kita akan membawa mereka kembali, teruslah lakukan semua yang kau bisa."
      Speaker = "Hermes"
      Event = "HermesAboutHades01"
    }
    {
      Id = "Hermes_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sempat berpapasan dengan Nyonya Circe di perjalananmu tadi malam, kan, M? Bakatnya luar biasa dalam urusan mantra sihir. Suka sekali mengubah manusia fana jadi segala macam rupa! Agak {#Emph}jahat {#Prev}sih kalau menurutku!"
      Speaker = "Hermes"
      Event = "HermesAboutCirce01"
    }
    {
      Id = "Hermes_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "Secara resmi, aku bertugas mengawasimu, kau tidak boleh tahu soal ini, sekadar informasi saja. Aku memberi tahu Olympus {#Emph}semua {#Prev}perkembangan terbaru, bukan yang terlalu pribadi, tentu saja; lalu aku memberi tahu {#Emph}kau {#Prev}lebih banyak lagi! Anggap saja aku mengawasi semua orang!"
      Speaker = "Hermes"
      Event = "HermesAboutMission01"
    }
    {
      Id = "Hermes_0083"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa malam terakhir ini semenjak kau mulai beraksi, yang berhasil kupastikan cuma fakta bahwa Kakek berhasil menggandeng seseorang yang dia yakini bisa memberinya keunggulan. Sekarang dia sedang menyiapkan tahap berikutnya dari rencananya untuk meruntuhkan gunung ini! Aku harus bergegas."
      Speaker = "Hermes"
      Event = "HermesAboutMission02"
    }
    {
      Id = "Hermes_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ibumu dulu sering bepergian bolak-balik antara Olympus dan Kediaman ayahmu, dan {#Emph}aku {#Prev}mendapat kehormatan untuk menemaninya! Suatu hari, dia tidak muncul. Saat itu juga aku langsung tahu ada yang tidak beres..."
      Speaker = "Hermes"
      Event = "HermesAboutPersephone01"
    }
    {
      Id = "Hermes_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua ini mengingatkanku saat aku mendukung saudaramu ketika dia mencari ibumu! Memang ada kepentingan tersendiri dengan hasilnya, pasti. Tapi tanpa kusadari, aku benar-benar mulai peduli! Kita pasti menemukan cara untuk membantu mereka, kan, M?"
      Speaker = "Hermes"
      Event = "HermesAboutZagreus01"
    }
    {
      Id = "Hermes_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat saudaramu sudah kembali dan keadaannya baik-baik saja, syukurlah! Dia memang tipe orang yang tangguh, aku sudah menduga dia bakal selamat. Siapa tahu, mungkin suatu malam nanti dia yang bakal mengeluarkan {#Emph}dirimu {#Prev}dari kesulitan!"
      Speaker = "Hermes"
      Event = "HermesAboutZagreus02"
    }
    {
      Id = "Hermes_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suatu malam nanti, mungkin kau bisa mengajari saudaramu caramu bernapas di atas sini supaya dia bisa berkunjung menemui kita semua juga? Maksudku nanti, setelah kita selesai membereskan kekacauan yang dibuat Kakek. Keluarga ini selalu ingin Zag mampir ke sini."
      Speaker = "Hermes"
      Event = "HermesAboutZagreus03"
    }
    {
      Id = "Hermes_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Artemis dan aku dulunya tidak terlalu dekat, masing-masing sibuk dengan urusan sendiri. Tapi bekerja sama denganmu dan Hec membuat kami lebih akrab! Kami terlalu sibuk mengendap-endap ke mana-mana, rasanya lega tahu kami tak perlu saling sembunyi-sembunyi lagi!"
      Speaker = "Hermes"
      Event = "HermesAboutArtemis01"
    }
    {
      Id = "Hermes_0100"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah ketemu Artemis, bagus, bagus! Dia dan aku jarang ngobrol santai, maklum sama-sama sibuk lari ke sana kemari dan harus sembunyi-sembunyi. Tapi sesekali kami saling lempar tatapan paham, kok!"
      Speaker = "Hermes"
      Event = "HermesAboutArtemis02"
    }
    {
      Id = "Hermes_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang rasanya melihatmu dan Artemis lebih sering beraksi di luar sana! Busurnya memang dahsyat, tapi dia selalu butuh seseorang yang bisa menarik perhatian lawan agar dia bisa membidik dengan leluasa!"
      Speaker = "Hermes"
      Event = "HermesAboutArtemis03"
    }
    {
      Id = "Hermes_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau kau kebetulan bertemu Tukang Perahu Bawah Tanah tertentu yang lagi mendayung, tolong sampaikan salamku padanya, ya? Kami sudah jarang bekerja sama seperti dulu gara-gara semua kekacauan belakangan ini. Kangen juga masa-masa itu!"
      Speaker = "Hermes"
      Event = "HermesAboutCharon01"
    }
    {
      Id = "Hermes_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi si Tukang Perahu baik-baik saja, ya? Syukurlah! Aku tahu dia sudah lama menjaga Hek dan kalian semua, tapi tolong gantian jaga dia juga, ya?"
      Speaker = "Hermes"
      Event = "HermesAboutCharon02"
    }
    {
      Id = "Hermes_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketemu si raksasa tua Herakles, ya? Ibu tiriku mengirimnya untuk tugas berat lainnya. Firasatku bilang dia sudah tidak sepenuh hati lagi menjalaninya. Tapi hei, dia tangguh! Dan kita sangat butuh bantuannya."
      Speaker = "Hermes"
      Event = "HermesAboutHeracles01"
    }
    {
      Id = "Hermes_0079"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Kakek Tua entah bagaimana berhasil menangkap Tiga Moirai! Itu gawat, aku tak yakin apa yang bisa kita lakukan, M. Setidaknya sekarang semua orang di Olympus sudah tahu, kurasa memang sudah saatnya! Bikin kita agak tegang, meski kita pintar menyembunyikannya!"
      Speaker = "Hermes"
      Event = "HermesAboutFates01"
    }
    {
      Id = "Hermes_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya sekarang keluarga besar tahu tentang keberadaanmu! Dari dulu aku ingin berteriak, {#Emph}Pesan untuk Olympus! Persefone dan Hades punya anak lagi! Dan dia luar biasa! {#Prev}Tapi Hek tahu kita harus menunggu, dan wawasannya luas sekali! Jadi mulutku terpaksa terkunci rapat."
      Speaker = "Hermes"
      Event = "HermesAboutFamily01"
    }
    {
      Id = "Hermes_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak kusangka dulu hari-hariku dihabiskan dengan mengantar arwah fana yang baru mati ke alam ayahmu! Sejujurnya aku malah mulai menyukainya, jadi bahkan setelah Kakek Tua muncul, aku tetap mampir ke sana kalau ada kesempatan menyelinap!"
      Speaker = "Hermes"
      Event = "HermesAboutPast01"
    }
    {
      Id = "Hermes_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil sampai ke atas sini, M! Aku ingin mempercepat langkahmu, tapi cuaca di sini bakal {#Emph}berat{#Prev}. Dasar kalian orang Bawah Tanah dan udara permukaan! Pasti ada cara untuk mengatasinya, kan...?"
      Speaker = "Hermes"
      Event = "HermesAboutSurface01"
    }
    {
      Id = "Hermes_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, perjalanan di permukaan memang berat bagimu, aku paham, tapi jangan menyerah dulu pada kami, M. Aku tahu kau {#Emph}takkan pernah {#Prev}begitu, tenang saja. Paling-paling kau cuma sedang mencari bahan-bahan sihir yang kau butuhkan, semacam itu, kan?"
      Speaker = "Hermes"
      Event = "HermesAboutSurfaceCurse01"
    }
    {
      Id = "Hermes_0081"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, M! Tak tahu pasti apa yang kau lakukan, atau mungkin ulah Hek, tapi kau tampak jauh lebih bugar dibanding saat terakhir kita bertemu. Bagus sekali! Karena untuk sampai sejauh ini, kau bakal butuh {#Emph}seluruh {#Prev}kekuatanmu. Dan {#Emph}kecepatan!"
      Speaker = "Hermes"
      Event = "HermesAboutSurface02"
    }
    {
      Id = "Hermes_0082"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, M! Kau di sini! Keren! Hek bilang kau bahkan sudah mengatasi kutukan darah Bawah Tanahmu, jadi kau siap untuk lari jarak jauh. Waspadai saja rintangan di sepanjang jalan, tapi ayo kita lewati secepat kilat kalau bisa!"
      Speaker = "Hermes"
      Event = "HermesAboutSurface02B"
    }
    {
      Id = "Hermes_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para arwah di seluruh Ephyra seharusnya beristirahat dengan tenang dalam naungan ayahmu, tapi Kakek Tua mengacaukan segalanya, mendobrak gerbang Bawah Tanah, dan begitulah akhirnya. Kalau aku mati, aku juga pasti murka."
      Speaker = "Hermes"
      Event = "HermesAboutSurface03"
    }
    {
      Id = "Hermes_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akhirnya kau melihat sendiri seperti apa keadaan di atas sini! Sebagian besar dari kami bertahan di puncak Olympus, dan {#Emph}kaulah {#Prev}bala bantuannya. Jadi, kembalilah kemari saat kau bisa, oke?"
      Speaker = "Hermes"
      Event = "HermesAboutOlympus01"
    }
    {
      Id = "Hermes_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengambil rute memutar yang indah untuk turun ke Kediaman ayahmu! Kakek Tua sudah mengunci wilayah-wilayah utama Bawah Tanah, jadi... kalau dipikir-pikir, pilihanmu masuk akal juga!"
      Speaker = "Hermes"
      Event = "HermesAboutOceanus01"
    }
    {
      Id = "Hermes_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seandainya saja aku bisa membawamu melesat menyeberangi palung laut yang dibelah Poseidon. Tapi kita {#Emph}tidak boleh {#Prev}terlihat bekerja sama terlalu dekat. Lagipula, kau membantu kami di setiap geladak yang kau bersihkan! Jadi {#Emph}semangat!"
      Speaker = "Hermes"
      Event = "HermesAboutThessaly01"
    }
    {
      Id = "Hermes_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kakek Tua mengirim pasukannya ke Olympus, kita bisa pulangkan mereka ke tempat asal semudah membalik telapak tangan. Tapi dia punya rencana lain, dan apa pun itu, ini rencana besar. Kalau tahu sesuatu, segera beri tahu Hek."
      Speaker = "Hermes"
      Event = "HermesAboutSurfaceThreat01"
    }
    {
      Id = "Hermes_0098"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah dapat kabar dari ayahku malam ini, M? Dia memang dewa yang sangat sibuk, tapi tidak pernah kehabisan tenaga. Sekarang setelah kau punya kekuatan petirnya, bagaimana kalau ditambah dengan {#Emph}kecepatan {#Prev}kilat sekalian?"
      Speaker = "Hermes"
      Event = "HermesAboutZeus01"
    }
    {
      Id = "Hermes_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, kurasa ibu tiriku cukup menyukaimu! Jangan disia-siakan! Terlepas dari keahliannya, firasatku mengatakan Ratu Hera kita tidak terlalu suka anak-anak."
      Speaker = "Hermes"
      Event = "HermesAboutHera01"
    }
    {
      Id = "Hermes_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berkah Paman Poseidon sudah banyak membantumu malam ini? Dia memang suka sesumbar itu bakal membuatmu nyaris kebal, tapi ini ada sedikit asuransi perjalanan buat jaga-jaga!"
      Speaker = "Hermes"
      Event = "HermesAboutPoseidon01"
    }
    {
      Id = "Hermes_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apollo menyinari hidupmu? Hal yang paling dia benci adalah mengotori tangannya sendiri, tapi sekarang, dengan situasi seperti ini, kurasa dia tidak punya banyak pilihan!"
      Speaker = "Hermes"
      Event = "HermesAboutApollo01"
    }
    {
      Id = "Hermes_0099"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terlepas dari semua yang terjadi, aku senang kau akhirnya bertemu Demeter, meski hanya lewat Berkah. Caranya menunjukkannya terkadang memang aneh, tapi dia {#Emph}selalu {#Prev}sangat menyayangi ibumu. Dia akan bertarung demi membawanya kembali, sampai titik darah penghabisan."
      Speaker = "Hermes"
      Event = "HermesAboutDemeter01"
    }
    {
      Id = "Hermes_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dapat berkah dari Afrodit, M? Hebat juga, kemurahan hatinya sedang {#Emph}sangat {#Prev}banyak diincar! Meski dia suka mencampuri urusan pribadi orang lain, urusanmu jelas kasus istimewa!"
      Speaker = "Hermes"
      Event = "HermesAboutAphrodite01"
    }
    {
      Id = "Hermes_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil membuat Hefaistos keluar dari cangkangnya! Yang kudapat darinya cuma perintah kerja, {#Emph}bawakan aku lebih banyak perunggu {#Prev}dan semacamnya! Senang melihatmu bisa memanfaatkan hasil kerja kerasnya dengan baik!"
      Speaker = "Hermes"
      Event = "HermesAboutHephaestus01"
    }
    {
      Id = "Hermes_0097"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hefaistos membuat set zirah yang {#Emph}luar biasa{#Prev}, dan tahu tidak? Dia juga membuat sandal yang mantap. Aku pakai sandalku terus! {#Emph}Alas kaki{#Prev}, M! Yakin bakal jadi tren masa depan!"
      Speaker = "Hermes"
      Event = "HermesAboutHephaestus02"
    }
    {
      Id = "Hermes_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Hestia sudah menyapamu duluan, ya? Dia lincah sekali terlepas dari usianya. Dan suka bermain api juga! Jiwanya masih seperti anak-anak... anak kecil yang agak menyeramkan, tentunya!"
      Speaker = "Hermes"
      Event = "HermesAboutHestia01"
    }
    {
      Id = "Hermes_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah bertemu Ares, M? Setiap kali ada pertumpahan darah dan amarah membara, dia akan melakukan apa saja untuk memperpanjangnya! Ini pasti dilema yang cukup berat buat dia."
      Speaker = "Hermes"
      Event = "HermesAboutAres01"
    }
    {
      Id = "Hermes_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Athena sedang di luar sana mengatur strategi pertahanan garis depan dan sejenisnya. Kami berdua kebanyakan tidak saling mengganggu urusan masing-masing. Dia selalu berkepala dingin di saat-saat genting seperti ini, kuakui itu!"
      Speaker = "Hermes"
      Event = "HermesAboutAthena01"
    }
    {
      Id = "Hermes_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Beberapa kerabat kita tidak suka terlibat. Dionisos, dia pasti datang ke setiap pesta, tapi takkan pernah mau ikut perang! {#Emph}Kenapa kita tidak rukun saja sih{#Prev}, katanya. Tapi kalau dipikir-pikir... bukan ide yang buruk juga!"
      Speaker = "Hermes"
      Event = "HermesAboutDionysus01"
    }
    {
      Id = "Hermes_0095"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, bagus! Selene sudah menghubungimu, M! Sudut pandang Mata Malam memang tiada duanya! Selalu menjaga kau dan kita semua. Kuda-kudanya juga lumayan gesit!"
      Speaker = "Hermes"
      Event = "HermesAboutSelene01"
    }
    {
      Id = "Hermes_0093"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang memesan Pengiriman Kilat Premium, hei, M? Ini yang {#Emph}terbaik {#Prev}yang kupunya, dan bakal membawamu melesat jauh dan cepat! Ada {#Emph}jaminan {#Prev}dariku!"
      Speaker = "Hermes"
      Event = "HermesLegendaryPickUp01"
    }
    {
      Id = "Hermes_0094"
      InheritFrom = "BaseNarrative"
      DisplayName = "Segar dari puncak tertinggi Olympus, inilah {#Emph}Pengiriman Kilat Premium! {#Prev}Berkah terbaik dan tercepat, khusus untuk pelanggan paling istimewa. Yaitu {#Emph}kamu!"
      Speaker = "Hermes"
      Event = "HermesLegendaryPickUp02"
    }
    {
      Id = "Hermes_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, dengar itu, M? Wah, itulah bunyi deru {#Emph}Pengiriman Kilat Premium{#Prev}! Selalu mengantarkan yang terbaik hanya untuk{#Emph}mu{#Prev}. Jadi, manfaatkan sebaik-baiknya, ya?"
      Speaker = "Hermes"
      Event = "HermesLegendaryPickUp03"
    }
    {
      Id = "Hermes_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kali ini kupunya pilihan terbaik untukmu, M, meski kau {#Emph}selalu {#Prev}bisa mengharapkan mutu terbaik dariku! Cuma kebetulan stok barang bagusku lagi melimpah ruah sekarang!"
      Speaker = "Hermes"
      Event = "HermesLegendaryPickUp04"
    }
    {
      Id = "Hermes_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini benar-benar mencekam, kau ada sangkut pautnya dengan ini kan, M? Jantungku berdegup kencang tanpa henti! Apa pun yang sedang kau rencanakan di Persimpangan Jalan sana, semoga berhasil!"
      Speaker = "Hermes"
      Event = "HermesAboutShrine01"
    }
    {
      Id = "Hermes_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata Hec kau mengikrarkan Sumpah Yang Tak Kasatmata, jadi kurasa kita siap beraksi, ya, M? Yang lain mungkin tak tahu apa yang sedang terjadi, cuma mengira ini malam menyeramkan biasa, tapi kau lakukan apa yang harus kau lakukan. Kehendak Sang Malam terwujud dan semacamnya."
      Speaker = "Hermes"
      Event = "HermesAboutShrine02"
    }
    {
      Id = "Hermes_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bukan tipe yang gampang mundur dari tantangan apa pun, ya, M. Kalau begitu Sumpah Yang Tak Kasatmata itu mungkin {#Emph}segalanya {#Prev}yang kau dambakan! Kenapa harus santai-santai kalau bisa tancap gas?"
      Speaker = "Hermes"
      Event = "HermesAboutShrine03"
    }
    {
      Id = "Hermes_0101"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mencatat rekor waktu terbaikmu, itu baru gaya yang kusuka! Ambil hal apa pun yang berharga untuk dilakukan, lalu lakukan sama baiknya dengan sedikit lebih cepat, dan {#Emph}sedikit {#Prev}lebih cepat lagi, dan tak lama, kau bakal seperti {#Emph}aku! Hampir!"
      Speaker = "Hermes"
      Event = "HermesAboutGameplayTimer01"
    }
    {
      Id = "Hermes_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kulihat kau tak lagi mencatat waktumu, dan M? Itu bikin hatiku hancur. Cuma bercanda, sih. Temukan saja kecepatanmu sendiri, tapi tetap saja! Kalau mau tahu seberapa cepat dirimu, cuma ada satu cara untuk mengetahuinya."
      Speaker = "Hermes"
      Event = "HermesAboutGameplayTimer02"
    }
    {
      Id = "Hermes_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei, kau sampai di garis akhir lebih cepat dari sebelumnya tempo hari! Aku mungkin suka memantau—namanya juga tugasku—dan mungkin kau takkan {#Emph}selalu {#Prev}memecahkan rekor terbaikmu, tapi saat itu terjadi, rasanya {#Emph}pasti {#Prev}mantap sekali!"
      Speaker = "Hermes"
      Event = "HermesAboutNewRecord01"
    }
    {
      Id = "Hermes_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba tebak, semalam kau sampai ke akhir dalam waktu rekor, {#Emph}lagi! {#Prev}Kalau terus makin cepat seperti itu, kau bakal segera menyaingi {#Emph}kecepatanku{#Prev}, meski aku takkan membiarkan itu terjadi, dengar tidak, M?"
      Speaker = "Hermes"
      Event = "HermesAboutNewRecord02"
    }
    {
      Id = "Hermes_0090"
      InheritFrom = "BaseNarrative"
      DisplayName = "Firasatku bilang aku bakal menjumpaimu di sini pada suatu malam, tahu tidak? Seperti ada sesuatu di udara. Aku sangat bersemangat, cuma ingin menuntaskan segalanya se{#Emph}mega{#Prev}-cepat mungkin!"
      Speaker = "Hermes"
      Event = "HermesAboutPackageBounty01"
    }
    {
      Id = "Hermes_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada yang aneh malam ini meski aku tak bisa memastikan apa itu, M. Padahal kata Hec belakangan ini kau mengutak-atik Batu Hitam Pekat milikmu itu, yang selalu membuatku merasa agak {#Emph}begini!"
      Speaker = "Hermes"
      Event = "HermesAboutPackageBounty02"
    }
    {
      Id = "Hermes_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergerakanmu mulus sekali di sana, M! Membantu sekali membawa Tetesan Logam itu bersamamu setiap saat. Setidaknya sampai khasiatnya habis untuk malam ini! Kita tak bisa lari dengan kecepatan penuh selamanya, tapi {#Emph}kita berusaha!"
      Speaker = "Hermes"
      Event = "HermesAboutKeepsake01"
    }
    {
      Id = "Hermes_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebetulan sekali, ini kau, dan kau {#Emph}sudah {#Prev}cepat! Tapi kau selalu bisa sedikit lebih cepat lagi! Yah, kalau aku sih sudah mentok cepatnya."
      Speaker = "Hermes"
      Event = "HermesAboutKeepsake02"
    }
    {
      Id = "Hermes_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau bergerak luar biasa cepat, dan tentu saja, kau membawa Tetesan dariku itu! Kau pasti sudah sangat terbiasa memakainya, dan benda itu bakal terus bekerja malam demi malam, kujamin!"
      Speaker = "Hermes"
      Event = "HermesAboutKeepsake03"
    }
    {
      Id = "Hermes_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau mengira Apollo yang bakal datang, M, dan dia memang cepat! Tapi aku lebih cepat, dan bisa mendahuluinya menemuimu {#Emph}setiap saat {#Prev}kalau saja aku sedikit lebih kekanak-kanakan dari ini! Dia bakal segera menyusul."
      Speaker = "Hermes"
      Event = "HermesAboutApolloKeepsake01"
    }
    {
      Id = "Hermes_0089"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tongkat ular yang bagus di sana, M, pasti lagi tren ya! Ular-ular {#Emph}milikku {#Prev}ini pemberian Apollo, membantu mengingatkanku pada keluarga, kau tahu kan? Lengket terus, gampang tersinggung, kadang mendesis marah... tapi tetap kusayangi."
      Speaker = "Hermes"
      Event = "HermesAboutMomusAspect01"
    }
    {
      Id = "Hermes_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menemukan Kuil khusuku, bagus, bagus! Sebagian manusia fana berdoa padaku demi perjalanan aman dan barang gratisan. {#Emph}Hampir {#Prev}gratis, sih. Ingat, ada sedikit biaya tambahan! Rekan kerjaku harus dapat bagiannya juga."
      Speaker = "Hermes"
      Event = "HermesAboutSurfaceShop01"
    }
    {
      Id = "Hermes_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Langkah bijak membawa hewan pendamping! Aku punya kelemahan pada tipe-tipe pendiam yang mandiri. Kura-kura kecilku, Chellen, selalu merasa nyaman di rumah ke mana pun kami pergi!"
      Speaker = "Hermes"
      Event = "HermesAboutFamiliars01"
    }
    {
      Id = "Hermes_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata Hec kau makin dekat dengan terobosan di sana, soal Kakek dan Typhon dan tetek bengeknya. Bukannya mau mendesakmu, M, tapi ini kan {#Emph}aku! {#Prev}Kadang aku tak bisa menahan diri."
      Speaker = "Hermes"
      Event = "HermesAboutUltimateProgress01"
    }
    {
      Id = "Hermes_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau bilang aku tak percaya kau berhasil, M, tapi itu berarti aku meragukan kemampuanmu, padahal aku {#Emph}yakin{#Prev}, jadi aku {#Emph}takkan bilang begitu! {#Prev}Tapi aku {#Emph}akan {#Prev}bilang: Terima kasih untuk {#Emph}semuanya! {#Prev}Aku tahu urusan kita mungkin belum sepenuhnya selesai, tapi kalau tekanannya sudah agak berkurang sekarang, baguslah."
      Speaker = "Hermes"
      Event = "HermesPostTrueEnding01"
    }
    {
      Id = "Hermes_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sejauh ini aku {#Emph}jauh {#Prev}lebih menyukai Kakek baru kita ini daripada Chronos tua yang jahat dulu. Kapan-kapan kau harus cerita bagaimana kau bisa membalikkan dunianya sampai dia jadi seperti ini. Hec tak bilang apa-apa sama sekali!"
      Speaker = "Hermes"
      Event = "HermesPostTrueEnding02"
    }
    {
      Id = "Hermes_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu sudah kembali ke tempat asalnya, ibumu juga, aku sangat lega mereka aman dan bersama lagi, M. Kau harus menebus waktu yang hilang bersama mereka, dan kau bakal bisa melakukannya mulai sekarang!"
      Speaker = "Hermes"
      Event = "HermesPostTrueEnding03"
    }
    {
      Id = "Hermes_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih ada urusan Tiga Takdir yang harus dibereskan. Jadi Kakek mengasingkan mereka begitu saja lalu kehilangan jejak sepenuhnya? Bagaimana cara {#Emph}kita {#Prev}menemukan mereka kalau {#Emph}dia {#Prev}saja tak bisa...?"
      Speaker = "Hermes"
      Event = "HermesAboutFatesQuest01"
    }
    {
      Id = "Hermes_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menemukan mereka, M! Sang Dewi Takdir! Mereka sendiri yang memberitahuku, kupikir aku harus menyebarkan kabarnya, namanya juga dewa pembawa pesan, dan tahu tidak? Mereka {#Emph}benar! {#Prev}Sepertinya waktu pengasingan itu membuat pikiran mereka berubah..."
      Speaker = "Hermes"
      Event = "HermesPostEpilogue01"
    }
    {
      Id = "Hermes_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Takdir katanya takkan lagi menentukan apa yang bakal terjadi mulai sekarang? Kecuali hal-hal besar, seperti era baru dan semacamnya? Entah {#Emph}bagaimana {#Prev}kita bisa membedakannya, apakah segalanya sudah direncanakan oleh {#Emph}mereka {#Prev}atau terserah keputusan kita..."
      Speaker = "Hermes"
      Event = "HermesPostEpilogue02"
    }
    {
      Id = "Hermes_0389"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi semacam era baru bakal menanti kita, kurasa kau sudah dengar semuanya langsung dari sumbernya, M. Tebakanku ini bakal tiba sebelum kita menyadarinya, namanya juga hal semacam itu! Kita bakal siap, dan kalaupun tidak, kita akan bertindak cepat."
      Speaker = "Hermes"
      Event = "HermesPostEpilogue03"
    }
    {
      Id = "Hermes_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hal yang membuatku takut, M, adalah pemikiran bahwa Waktu mungkin bahkan lebih cepat daripada {#Emph}aku{#Prev}. Ingat kan waktu kau masih kecil dulu! Tahu-tahu {#Emph}bam! {#Prev}Kau sudah {#Emph}dewasa {#Prev}sekarang, secepat {#Emph}itu!"
      Speaker = "Hermes"
      Event = "HermesAboutTime01"
    }
    {
      Id = "Hermes_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waktu memang aneh, bukan begitu, M? Tak heran bahkan Kakek sendiri tidak sepenuhnya memahaminya. Aku cuma tak suka saat Waktu terasa berlarut-larut terlalu lama, jadi {#Emph}ayo bergerak!"
      Speaker = "Hermes"
      Event = "HermesAboutTime02"
    }
    {
      Id = "Hermes_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "Langgananku banyak, tapi rahasia kita berdua saja, yang {#Emph}ini {#Prev}adalah favoritku, M. Orang-orang Dunia Bawah sepertimu cenderung tidak banyak menuntut, dan kau jelas dengan apa yang kau inginkan. Aku suka itu darimu!"
      Speaker = "Hermes"
      Event = "HermesAboutClients01"
    }
    {
      Id = "Hermes_0390"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih lagi untuk Ambrosia-nya, M. Memang belum banyak waktu luang, tapi aku dan rekan profesional-ku sempat menikmati sebotol berdua baru-baru ini. Istirahat sejenak, tapi itu yang sangat kubutuhkan!"
      Speaker = "Hermes"
      Event = "HermesAboutAmbrosia01"
    }
    {
      Id = "Hermes_0391"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar pelanggan yang baik bagi rekan profesionalku, atau begitulah kabarnya, M! Aku cuma mendengar bunyi {#Emph}hrrrrnggh{#Prev}, sih, tapi kulihat betapa banyak Hadiah Emas darinya yang sudah kau kumpulkan, dan itu {#Emph}memang {#Prev}banyak sekali!"
      Speaker = "Hermes"
      Event = "HermesAboutCharonPoints01"
    }
    {
      Id = "Hermes_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kadang suka mengobrol tapi aku {#Emph}selalu {#Prev}suka bergerak cepat, jadi bagaimana kalau kita buat obrolan singkat kita ini tetap ringkas dan padat mulai sekarang? Untuk sebagian besarnya!"
      Speaker = "Hermes"
      Event = "HermesAboutLittleToSay01"
    }
    {
      Id = "Hermes_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berdua punya urusan masing-masing, jadi ayo segera lanjutkan perjalananmu!"
      Speaker = "Hermes"
      Event = "HermesChat01"
    }
    {
      Id = "Hermes_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir aku mau mengecek keadaanmu, semuanya aman? Bagus kalau begitu!"
      Speaker = "Hermes"
      Event = "HermesChat02"
    }
    {
      Id = "Hermes_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Situasi kelihatannya tidak terlalu bagus sekarang, tapi itu bisa berubah dalam sekejap!"
      Speaker = "Hermes"
      Event = "HermesChat03"
    }
    {
      Id = "Hermes_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang, Waktu berlalu cepat! Tapi kurasa kita bakal sanggup mengejarnya!"
      Speaker = "Hermes"
      Event = "HermesChat04"
    }
    {
      Id = "Hermes_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kebetulan sekali lewat sini sambil bawa beberapa pilihan berkat!"
      Speaker = "Hermes"
      Event = "HermesChat05"
    }
    {
      Id = "Hermes_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cepat dan senyap, M! Kau pasti bisa, kan?"
      Speaker = "Hermes"
      Event = "HermesChat06"
    }
    {
      Id = "Hermes_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lagi buru-buru nih, M, jadi ayo kita langsung tancap gas, ya?"
      Speaker = "Hermes"
      Event = "HermesChat07"
    }
    {
      Id = "Hermes_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kiriman kilat khusus buat Putri Dunia Bawah!"
      Speaker = "Hermes"
      Event = "HermesChat08"
    }
    {
      Id = "Hermes_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei M, butuh tumpangan kilat? Kebetulan aku bawa satu. Tiga, malahan!"
      Speaker = "Hermes"
      Event = "HermesChat09"
    }
    {
      Id = "Hermes_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih bisa bertahan. Kau juga? Kalau begitu mari kita gas terus sampai tuntas!"
      Speaker = "Hermes"
      Event = "HermesChat10"
    }
    {
      Id = "Hermes_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata orang jangan terburu-buru, tapi memangnya mereka tahu apa, ya kan?"
      Speaker = "Hermes"
      Event = "HermesChat11"
    }
    {
      Id = "Hermes_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hidup cepat atau tidak sama sekali, benar kan, M? Sekarang pilih salah satu!"
      Speaker = "Hermes"
      Event = "HermesChat12"
    }
    {
      Id = "Hermes_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bakal langsung melesat lagi dalam sekejap mata!"
      Speaker = "Hermes"
      Event = "HermesChat13"
    }
    {
      Id = "Hermes_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah kutebak kau pasti bakal tiba di sini sekitar jam-jam segini!"
      Speaker = "Hermes"
      Event = "HermesChat14"
    }
    {
      Id = "Hermes_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nggak usah kebanyakan mikir, tinggal sambar satu dan langsung cabut!"
      Speaker = "Hermes"
      Event = "HermesChat15"
    }
    {
      Id = "Hermes_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya malam sibuk lainnya sudah menanti kita!"
      Speaker = "Hermes"
      Event = "HermesChat16"
    }
    {
      Id = "Hermes_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Cepat, M, sebelum terlambat! {#Prev}Suka banget deh ngomong begitu."
      Speaker = "Hermes"
      Event = "HermesChat17"
    }
    {
      Id = "Hermes_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bawa sesuatu yang dijamin bikin langkahmu makin lincah melenting!"
      Speaker = "Hermes"
      Event = "HermesChat18"
    }
    {
      Id = "Hermes_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, M, mari kita beri {#Emph}kau {#Prev}sedikit suntikan kecepatan!"
      Speaker = "Hermes"
      Event = "HermesChat19"
    }
    {
      Id = "Hermes_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh hei! Kupikir mending mampir sebentar buat ngasih bingkisan kecil ini untukmu!"
      Speaker = "Hermes"
      Event = "HermesChat20"
    }
    {
      Id = "Hermes_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sedang berpacu melawan Waktu, dan demi apa pun, kita pasti akan menang!"
      Speaker = "Hermes"
      Event = "HermesChat21"
    }
    {
      Id = "Hermes_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang pas buat lari-lari kecil, benar begitu kan, M?"
      Speaker = "Hermes"
      Event = "HermesChat22"
    }
    {
      Id = "Hermes_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei! Ada kiriman kilat istimewa nih buatmu, M!"
      Speaker = "Hermes"
      Event = "HermesChat23"
    }
    {
      Id = "Hermes_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hanya layanan terbaik dan tercepat untuk pelanggan setiaku!"
      Speaker = "Hermes"
      Event = "HermesChat24"
    }
    {
      Id = "Hermes_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menuju ke atas? Mungkin nanti kita bakal ketemu lagi di jalan!"
      Speaker = "Hermes"
      Event = "HermesChat25"
    }
    {
      Id = "Hermes_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mau bergerak lebih gesit? Pas banget, aku bawa barangnya!"
      Speaker = "Hermes"
      Event = "HermesChat26"
    }
    {
      Id = "Hermes_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Banyak urusan! Seharian ini sudah lari mondar-mandir semalaman suntuk!"
      Speaker = "Hermes"
      Event = "HermesChat27"
    }
    {
      Id = "Hermes_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Serangan bencana apa pun pada keluarga kita takkan sanggup memperlambat langkah kita!"
      Speaker = "Hermes"
      Event = "HermesChat28"
    }
    {
      Id = "Hermes_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada beberapa hal yang harus kuperiksa, tapi sebelum itu, ambil ini!"
      Speaker = "Hermes"
      Event = "HermesChat29"
    }
    {
      Id = "Hermes_0410"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei hei, M! Salah satu hei-nya itu titipan dari Artemis."
      Speaker = "Hermes"
      Event = "HermesChat30"
    }
    {
      Id = "Hermes_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei hei, M! Salah satu hei-nya itu titipan dari Selene."
      Speaker = "Hermes"
      Event = "HermesChat31"
    }
    {
      Id = "Hermes_0392"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo jaga temponya dan babat habis setiap kemungkinan buruk yang tersisa!"
      Speaker = "Hermes"
      Event = "HermesChat32"
    }
    {
      Id = "Hermes_0393"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam yang super sibuk, tapi buatmu aku selalu sempatkan mampir!"
      Speaker = "Hermes"
      Event = "HermesChat33"
    }
    {
      Id = "Hermes_0394"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira kau bisa melibas Typhon persis seperti waktu itu, M?"
      Speaker = "Hermes"
      Event = "HermesChat34"
    }
    {
      Id = "Hermes_0395"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berapa pun kemungkinan Typhon yang tersisa, ayo kita kurangi satu lagi!"
      Speaker = "Hermes"
      Event = "HermesChat35"
    }
    {
      Id = "Hermes_0396"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih ada Chronos tua bangka menyebalkan yang harus dihadapi, jadi takkan kubuat kau menunggu, M!"
      Speaker = "Hermes"
      Event = "HermesChat36"
    }
    {
      Id = "Hermes_0397"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilih cepat M, {#Emph}kalau tidak...! {#Prev}Paling cuma kutungguin, sih. Tapi jujur, mending jangan lama-lama!"
      Speaker = "Hermes"
      Event = "HermesChat37"
    }
    {
      Id = "Hermes_0398"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan cuma ingin cepat, tapi {#Emph}jadilah {#Prev}cepat! Termasuk saat memilih!"
      Speaker = "Hermes"
      Event = "HermesChat38"
    }
    {
      Id = "Hermes_0399"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu yang kupikir berguna buatmu, plus beberapa cadangan buat jaga-jaga!"
      Speaker = "Hermes"
      Event = "HermesChat39"
    }
    {
      Id = "Hermes_0400"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunakan sejenak waktumu buat menentukan pilihan, M, tapi jangan lebih dari sejenak ya!"
      Speaker = "Hermes"
      Event = "HermesChat40"
    }
    {
      Id = "Hermes_0401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makin sibuk kita, makin banyak yang bisa kita selesaikan, dan waktu pun bakal berlalu makin cepat!"
      Speaker = "Hermes"
      Event = "HermesChat41"
    }
    {
      Id = "Hermes_0402"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bulan mati, artinya Selene dapat waktu istirahat, tapi kau tahu siapa yang tidak?"
      Speaker = "Hermes"
      Event = "HermesChat42"
    }
    {
      Id = "Hermes_0403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makin cepat kita selesaikan ini, makin cepat kita lanjut ke urusan berikutnya, dan seterusnya, dan seterusnya!"
      Speaker = "Hermes"
      Event = "HermesChat43"
    }
    {
      Id = "Hermes_0404"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan bikin aku menunggu, M, kecuali kau mau membunuhku—kalau begitu kita tidak bisa berteman lagi!"
      Speaker = "Hermes"
      Event = "HermesChat44"
    }
    {
      Id = "Hermes_0405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu maunya kau selalu ada di permukaan, meski belakangan ini di mana pun kau berada bagiku sama saja!"
      Speaker = "Hermes"
      Event = "HermesChat45"
    }
    {
      Id = "Hermes_0406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menemukanmu secepat kilat, jadi sisa malam ini bisa kau pakai buat buru-buru!"
      Speaker = "Hermes"
      Event = "HermesChat46"
    }
    {
      Id = "Hermes_0407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu, masalah terburuk kita sudah lewat untuk sekarang, tapi kenapa harus memperlambat tempo?"
      Speaker = "Hermes"
      Event = "HermesChat47"
    }
    {
      Id = "Hermes_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, belakangan ini makin susah menyelinap ke Underworld! Untunglah aku kenal seorang ahli di bidang itu. Dan kulihat, {#Emph}kau{#Prev} pun mengenalnya!"
      Speaker = "Hermes"
      Event = "HermesLootBought01"
    }
    {
      Id = "Hermes_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih atas transaksimu, mewakili mantan rekan kerjaku di sana! Senang rasanya bisa bekerja sama dengannya lagi, bilang padanya aku titip salam: {#Emph}hrrnnggh!"
      Speaker = "Hermes"
      Event = "HermesLootBought02"
    }
    {
      Id = "Hermes_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tukang perahu itu selalu minta ongkos, memang sudah aturannya begitu! Tapi manfaatnya {#Emph}jauh {#Prev}lebih berharga daripada harganya, kujamin itu!"
      Speaker = "Hermes"
      Event = "HermesLootBought03"
    }
    {
      Id = "Hermes_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kira-kira apa yang dilakukan rekan kerjaku itu dengan koin sebanyak itu, ya? Dia masih bungkam seribu bahasa. Kurasa dia cuma sedang menghilangkan jejak supaya Kakek Tua tak bisa melacaknya!"
      Speaker = "Hermes"
      Event = "HermesLootBought04"
    }
    {
      Id = "Hermes_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berapa lama menurutmu waktu yang dibutuhkan untuk melenyapkan semua Emas Chronos itu, satu atau dua {#Emph}zaman {#Prev}lagi? Bukan berarti gerakanmu lambat, lho, tapi dia kelewat cepat mencetak koin sebanyak itu!"
      Speaker = "Hermes"
      Event = "HermesLootBought05"
    }
    {
      Id = "Melinoe_0957"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku senang kau ada di sini, Hermes, dan suatu kehormatan akhirnya bisa bekerja sama denganmu. Demi kemenangan kita yang kilat!"
      Speaker = "Melinoe"
      Event = "HermesGift01"
    }
    {
      Id = "Hermes_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, hei! Sudah lama sekali aku tidak dapat persembahan! Terima kasih, M, meski kau tak perlu repot-repot. Tapi ini, aku punya sesuatu yang pas untukmu!"
      Speaker = "Hermes"
      Event = "HermesGift01"
    }
    {
      Id = "Melinoe_0958"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hermes, jika ada orang di luar sana yang bisa membantuku mengungguli Sang Waktu, itu adalah kau. Terimalah ini, atas bantuanmu yang gesit dan andal."
      Speaker = "Melinoe"
      Event = "HermesGift02"
    }
    {
      Id = "Hermes_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sungguh berhati mulia, M, cuma saja aku {#Emph}benar-benar {#Prev}harus segera tancap gas, jadi bagaimana kalau langsung kita bagi berkatnya saja?"
      Speaker = "Hermes"
      Event = "HermesGift02"
    }
    {
      Id = "MelinoeField_2005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika bukan karena kecepatan dan keberanianmu, kita tidak akan pernah punya kesempatan melawan musuh kita, Hermes. Kurasa kami takkan bisa segera membalas jasamu, tapi aku akan mencobanya!"
      Speaker = "Melinoe"
      Event = "HermesGift03"
    }
    {
      Id = "Hermes_0091"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sangat ramah darimu, M, meski aku tak terlalu memikirkan persenan dan urusan kita masih menumpuk, bukan begitu? Tapi jujur saja, aku menghargainya."
      Speaker = "Hermes"
      Event = "HermesGift03"
    }
    {
      Id = "MelinoeField_2006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu kau luar biasa sibuk akhir-akhir ini, tapi bolehkah aku menyela sejenak untuk memberimu persembahan kecil ini? Memang tak seberapa, tapi di bawah sini inilah yang terbaik yang kami punya."
      Speaker = "Melinoe"
      Event = "HermesGift04"
    }
    {
      Id = "Hermes_0092"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak tahu bagaimana kau bisa punya {#Emph}waktu {#Prev}di saat-saat begini, tapi aku berterima kasih kau memikirkanku seperti ini! Sekarang langsung ke urusan bisnis, ya? Banyak yang harus {#Emph}dibereskan!"
      Speaker = "Hermes"
      Event = "HermesGift04"
    }
    {
      Id = "MelinoeField_3722"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan jadi apa kami tanpamu, Tuan Hermes? Kau telah berbuat begitu banyak untuk mempersiapkan kami menghadapi masa-masa sulit ini. Aku tahu jerih payahmu terkadang tak kasatmata, tapi tidak bagi Kaum Tak Kasatmata."
      Speaker = "Melinoe"
      Event = "HermesGift05"
    }
    {
      Id = "Hermes_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang sekali bisa bekerja sama denganmu, M. Salah satu titik terang di tengah semua kekacauan ini, malah! Aku selalu mendongak apa pun yang terjadi, harus lihat jalan di depan, kan? Terima kasih sudah membuat segalanya jadi mudah!"
      Speaker = "Hermes"
      Event = "HermesGift05"
    }
    {
      Id = "MelinoeField_3723"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagi dewa yang paling gesit, dan salah satu kawan terlama sekaligus terdekatku. Tuan Hermes, kau telah melayani Olympus maupun Underworld, dan telah menyaksikan segalanya. Seluruh keluarga kita bisa belajar banyak darimu. Aku pun demikian."
      Speaker = "Melinoe"
      Event = "HermesGift06"
    }
    {
      Id = "Hermes_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang banyak lari ke sana kemari. Pergi ke banyak tempat, bertemu berbagai macam orang, tapi kau tahu? Bagiku kau tetap yang terbaik, sumpah, M. Kau bukan yang {#Emph}tercepat{#Prev}, tentu saja! Mana bisa punya segalanya. Tapi kau dan aku? Kecepatanmu beda-beda tipis denganku."
      Speaker = "Hermes"
      Event = "HermesGift06"
    }
    {
      Id = "MelinoeField_4212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kiriman khusus untukmu, Tuan Hermes! Kau telah membantuku berkali-kali tanpa henti, dan menyemangatiku di setiap langkah. Tanpamu, aku takkan pernah bisa melangkah sejauh ini secepat ini."
      Speaker = "Melinoe"
      Event = "HermesGift07"
    }
    {
      Id = "Hermes_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hei! Ambrosia! Persis seperti yang selalu kuinginkan! Sudah lama aku tak melihatnya belakangan ini, begitu pula pesta pora yang menyertainya. Tapi kalau begini terus, kita mungkin akan segera dapat lebih banyak! Maksudku {#Emph}pesta{#Prev}, yang pastinya untuk merayakan jasamu."
      Speaker = "Hermes"
      Event = "HermesGift07"
    }
    {
      Id = "MelinoeField_4213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk Utusan kami yang terhormat, dan sahabatku yang luar biasa! Kau bukan hanya menjaga ikatan antara Underworld dan Olympus agar tak terputus, tapi kau melakukannya dengan gesit dan senyap. Kau praktis sudah seperti dewa ktonik sendiri!"
      Speaker = "Melinoe"
      Event = "HermesGift08"
    }
    {
      Id = "Hermes_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata-katamu sungguh berarti, terima kasih, M. Kau tahu aku suka serbacepat, tapi satu hal yang {#Emph}lebih {#Prev}kukai adalah bekerja dengan baik. Kami para dewa tak selalu harus banting tulang, tapi ayahmu selalu melakukannya, begitu pula dirimu. Aku senang ternyata aku tak sendirian."
      Speaker = "Hermes"
      Event = "HermesGift08"
    }
    {
      Id = "MelinoeField_0643"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada yang menandingi pertukaran hadiah kilat seperti ini!"
      Speaker = "Melinoe"
      Event = "HermesUpgrade.GiftGivenVoiceLines"
    }
  ]
}
