    }
    {
      Id = "Odysseus_0053"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah... {#Prev}terasa meresap sampai ke tulang..."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Odysseus_0054"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mm{#Prev}, rasanya hampir seperti hidup kembali, {#Emph}haha..."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Odysseus_0050"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada yang memulihkan tenaga sebaik pemandian air panas..."
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Odysseus_0051"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuharap suhunya pas untukmu, kan?"
      Speaker = "Odysseus"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Nemesis_0205"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak terlalu panas, tidak terlalu dingin..."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Nemesis_0206"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang sedang {#Emph}kau {#Prev}lihat?"
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Nemesis_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah, nikmati saja berendamnya..."
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Nemesis_0210"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Menghela napas>"
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Nemesis_0211"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi, ada apa?"
      Speaker = "Nemesis"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Nemesis_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar-benar tak boleh {#Emph}terlalu {#Prev}nyaman di sini..."
