    }
    {
      Id = "MelinoeField_4946"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fyuuh{#Prev}, nikmatnya..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "MelinoeField_4947"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Fyuuh{#Prev}, terasa lebih baik..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Dora_0064"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beruap banget di sini, harus kuakui!"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Dora_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Yap{#Prev}, ini baru namanya hidup...!"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Dora_0067"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ahhh {#Prev}aku sama sekali tidak peduli apa pun sekarang."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Dora_0068"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kutebak airnya pasti nyaman banget!"
      Speaker = "Dora"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Dora_0601"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lelehkan saja aku jadi Psyche..."
      Speaker = "Dora"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Hecate_0801"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah{#Prev}, tapi ini tidak buruk..."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Hecate_0245"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita pulihkan kekuatan kita..."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Hecate_0246"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Air ini sepertinya selalu mujarab..."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Hecate_0247"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Alangkah baiknya jika hanya ini yang perlu kita lakukan..."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.EnteredBathVoiceLines"
    }
    {
      Id = "Hecate_0559"
      InheritFrom = "BaseSubtitle"
