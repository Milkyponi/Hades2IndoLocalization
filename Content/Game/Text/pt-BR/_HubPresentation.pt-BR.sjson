      Event = "GlobalVoiceLines.BathHouseResponseVoiceLines"
    }
    {
      Id = "Odysseus_0660"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Benar sekali! Sangat menyenangkan, memang."
