    }
    {
      Id = "Moros_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Haha! {#Prev}Benar sekali."
      Speaker = "Moros"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_4617"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, demi menemukan jalan kita bersama."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Moros_0402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi menemukan jalan kita."
      Speaker = "Moros"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_3730"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aah...! Hahaha!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_3890"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi mengungkap kebenaran!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_5027"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih semuanya karena telah setia berdiri di sisiku!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_5090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rencana bagus...! {#Emph}Hei{#Prev}, bolehkah kami minta perhatian kalian semua?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_4281"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, kalau begitu, bersulang!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_4489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja boleh: {#Emph}Demi semua hal yang tak pernah bisa kita miliki."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_4553"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, mari bersulang untuk Para Arwah Persimpangan!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_5879"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi Persimpangan ini, rumah kita!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_5876"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi Para Arwah Persimpangan!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_5878"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi Sang Rembulan di atas sana atas segala bimbingannya!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_5881"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi masa-masa damai yang akan datang!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.LoungeRevelryVoiceLines"
    }
    {
      Id = "Melinoe_5882"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku salut pada kalian semua!"
