  lang = "pt-BR"
  Texts = [
    {
      Id = "MelinoeField_2116"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mencari beberapa titik berbeda..."
      Speaker = "Melinoe"
      Event = "BaseH.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_2117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada beberapa hal yang harus dicari..."
      Speaker = "Melinoe"
      Event = "BaseH.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tempat ini luas sekali..."
      Speaker = "Melinoe"
      Event = "BaseH.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0850"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Firasatku bilang lewat sini..."
      Speaker = "Melinoe"
      Event = "BaseH.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0851"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Minggir dari jalanku."
      Speaker = "Melinoe"
      Event = "BaseH.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0852"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beri aku jalan."
      Speaker = "Melinoe"
      Event = "BaseH.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0853"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mau lewat, menyingkirlah."
      Speaker = "Melinoe"
      Event = "BaseH.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0854"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Buka jalannya."
      Speaker = "Melinoe"
      Event = "BaseH.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0855"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku harus pergi sekarang."
      Speaker = "Melinoe"
      Event = "BaseH.ExitVoiceLines"
    }
    {
      Id = "Storyteller_0056"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hamparan luas tak berujung merayap di pinggiran Dunia Bawah, tempat para Arwah nestapa pasrah memudar, dan Roh-Roh pilu memangsa duka lara mereka."
      Speaker = "Storyteller"
      Event = "Inspect_H_Intro_01"
    }
    {
      Id = "Melinoe_1115"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tempat yang sungguh mengerikan..."
      Speaker = "Melinoe"
      Event = "Inspect_H_Intro_01"
    }
    {
      Id = "Storyteller_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di tengah belantara liar dekat dasar terdalam Dunia Bawah, bersemayam jiwa-jiwa tak terhitung yang mencengkeram sisa-sisa cinta dan harapan yang telah lama sirna."
      Speaker = "Storyteller"
      Event = "Inspect_H_Intro_02"
    }
    {
      Id = "MelinoeField_0816"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cukup suram di bawah sini..."
      Speaker = "Melinoe"
      Event = "Inspect_H_Intro_02"
    }
    {
      Id = "MelinoeField_1055"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan sampai tersesat di sini, Mel..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1056"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada jalan yang jelas terlihat..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_0808"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ke mana arah dari sini..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "Melinoe_0809"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mourning Fields..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0834"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tempat ini sangat... {#Emph}ihh..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0835"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, Mel..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0836"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan menyerah..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0837"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan berdiam lama-lama di sini..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0838"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Langkah demi langkah..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0839"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cari penanda jalannya..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0840"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya di sini agak lebih kering..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_0841"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Begitu banyak kesedihan..."
      Speaker = "Melinoe"
      Event = "H_Intro.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah jurang curam di Mourning Fields menganga bagaikan luka sayat di jantung Dunia Bawah; bahkan roh-roh penuh dengki pun tahu untuk menjauhinya."
      Speaker = "Storyteller"
      Event = "Inspect_H_Bridge_01"
    }
    {
      Id = "MelinoeField_0817"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harus terus merangsek maju, keluar dari sini..."
      Speaker = "Melinoe"
      Event = "Inspect_H_Bridge_01"
    }
    {
      Id = "Storyteller_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Jumlah orang mati tak terhitung bagaikan bulir gandum di Mourning Fields, namun mereka bukanlah santapan paling memuaskan bagi monster-monster keji di dalamnya."
      Speaker = "Storyteller"
      Event = "Inspect_H_MiniBoss01_01"
    }
    {
      Id = "MelinoeField_1215"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Orang-orang mati sudah cukup menderita..."
      Speaker = "Melinoe"
      Event = "Inspect_H_MiniBoss01_01"
    }
    {
      Id = "Storyteller_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di dalam luasnya hamparan Mourning Fields, bersemayam tak terhitung Arwah penebar duka, serta Daemon yang memangsa penderitaan mereka tanpa henti."
      Speaker = "Storyteller"
      Event = "Inspect_H_MiniBoss02_01"
    }
    {
      Id = "MelinoeField_1214"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekalian saja bikin nama ular jadi jelek..."
      Speaker = "Melinoe"
      Event = "Inspect_H_MiniBoss02_01"
    }
    {
      Id = "Storyteller_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aliran Sungai Styx yang berdenyut dan berliku membelah tepian Padang Penuh Duka, menghubungkan jalurnya ke kedalaman Tartarus di bawah."
      Speaker = "Storyteller"
      Event = "Inspect_H_PreBoss_01"
    }
    {
      Id = "MelinoeField_0818"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini benar-benar Styx... berarti aku sudah dekat sekali...!"
      Speaker = "Melinoe"
      Event = "Inspect_H_PreBoss_01"
    }
    {
      Id = "Storyteller_0173"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di balik sana menanti sang Monster Anjing Neraka, tak lagi menjaga gerbang Dunia Bawah, melainkan dicekam keputusasaan untuk kembali kepada majikannya yang muram, di mana pun ia berada."
      Speaker = "Storyteller"
      Event = "Inspect_H_PreBoss_02"
    }
    {
      Id = "MelinoeField_0819"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kasihan Cerberus..."
      Speaker = "Melinoe"
      Event = "Inspect_H_PreBoss_02"
    }
    {
      Id = "Storyteller_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bahkan para penghuni Padang Ratapan yang nestapa pun lebih memilih merana di sana lebih lama daripada terperosok makin dalam ke jurang kehampaan, tempat bersemayamnya para Arwah yang paling terkutuk."
      Speaker = "Storyteller"
      Event = "Inspect_H_Boss_02"
    }
    {
      Id = "MelinoeField_0821"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya yang paling terkutuk, yang mengabdi pada Chronos..."
      Speaker = "Melinoe"
      Event = "Inspect_H_Boss_02"
    }
    {
      Id = "Storyteller_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Usai meredam amukan Cerberus, monster mengerikan berkepala tiga, sang Putri Kematian bersiap melangkah jauh ke dasar Tartarus, tempat musuh bebuyutannya menanti."
      Speaker = "Storyteller"
      Event = "Inspect_H_Boss_01"
    }
    {
      Id = "MelinoeField_0820"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita sudah sangat dekat, bukan...?"
      Speaker = "Melinoe"
      Event = "Inspect_H_Boss_01"
    }
    {
      Id = "MelinoeField_0946"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hampir sampai..."
      Speaker = "Melinoe"
      Event = "H_Boss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0947"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat tinggal, Padang Ratapan..."
      Speaker = "Melinoe"
      Event = "H_Boss01.ExitVoiceLines"
    }
    {
      Id = "MelinoeField_0948"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akhirnya keluar juga dari sini..."
      Speaker = "Melinoe"
      Event = "H_Boss01.ExitVoiceLines"
    }
    {
      Id = "Storyteller_0421"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Iblis-iblis besar penebar teror yang merasuki Cerberus telah kocar-kacir ke ceruk-ceruk gelap, agaknya gentar melihat kedahsyatan kekuatan sang Putri."
      Speaker = "Storyteller"
      Event = "Inspect_H_Boss02_01"
    }
    {
      Id = "MelinoeField_3614"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bahkan tak terlalu keberatan dengan panasnya."
      Speaker = "Melinoe"
      Event = "Inspect_H_Boss02_01"
    }
    {
      Id = "Storyteller_0456"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Api neraka pemusnah yang menjadi ciri khas Cerberus, monster berkepala tiga itu, melalap bagian Padang nestapa ini; Rasa Takut yang masih menyelimuti udara kian mengobarkan apinya."
      Speaker = "Storyteller"
      Event = "Inspect_H_Boss02_02"
    }
    {
      Id = "MelinoeField_3654"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kudengar Asphodel memang bisa meluap seperti ini."
      Speaker = "Melinoe"
      Event = "Inspect_H_Boss02_02"
    }
    {
      Id = "MelinoeField_3507"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kolam Penyucian itu sudah dipulihkan."
      Speaker = "Melinoe"
      Event = "H_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aula dinas yang lama..."
      Speaker = "Melinoe"
      Event = "H_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berhasil kembali ke sini..."
      Speaker = "Melinoe"
      Event = "H_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Debunya tebal sekali..."
      Speaker = "Melinoe"
      Event = "H_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya sudah keluar dari Padang Ratapan..."
      Speaker = "Melinoe"
      Event = "H_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Khusus petugas berwenang..."
      Speaker = "Melinoe"
      Event = "H_PostBoss01.EnterVoiceLines"
    }
    {
      Id = "MelinoeField_1262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terselubung rapat sepenuhnya..."
      Speaker = "Melinoe"
      Event = "ObstacleData[566246].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak bisa putar balik."
      Speaker = "Melinoe"
      Event = "ObstacleData[566246].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1264"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan ke sana tujuanku."
      Speaker = "Melinoe"
      Event = "ObstacleData[566246].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1265"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jalur menuju Asphodel..."
      Speaker = "Melinoe"
      Event = "ObstacleData[566246].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah kuduga, tersegel rapat."
      Speaker = "Melinoe"
      Event = "ObstacleData[566285].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan lewat sini..."
      Speaker = "Melinoe"
      Event = "ObstacleData[566285].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di baliknya terbentang Tartarus..."
      Speaker = "Melinoe"
      Event = "ObstacleData[566285].DistanceTriggers.VoiceLines"
    }
    {
      Id = "MelinoeField_1269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak bisa keluar lewat sini..."
      Speaker = "Melinoe"
      Event = "ObstacleData[566285].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Legiun-legiun yang setia kepada sang Titan Waktu masih menjaga jalur-jalur utama Dunia Bawah, namun mereka tetap tidak menyadari cara rahasia tertentu untuk turun jauh ke dasar alam ini."
      Speaker = "Storyteller"
      Event = "Inspect_H_PostBoss_01"
    }
    {
      Id = "MelinoeField_0822"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rahasia dari Yang Kasatmata..."
      Speaker = "Melinoe"
      Event = "Inspect_H_PostBoss_01"
    }
    {
      Id = "Storyteller_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Usai sang Titan Waktu yang penuh perhitungan merebut kendali Dunia Bawah, ia menyegel rapat jalur nadi utama dari Tartarus; namun sang Putri Kematian mengetahui sebuah jalan pintas rahasia di dalamnya."
      Speaker = "Storyteller"
      Event = "Inspect_H_PostBoss_02"
    }
    {
      Id = "MelinoeField_1428"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rahasia dari Yang Kasatmata..."
      Speaker = "Melinoe"
      Event = "Inspect_H_PostBoss_02"
    }
    {
      Id = "Storyteller_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Putri yang haus pembalasan sekali lagi berada di lorong resmi menuju Tartarus yang berderit tua; mungkin inilah tempat yang digunakan oleh sang Titan musuhnya untuk meloloskan diri dari kurungan selama berabad-abad."
      Speaker = "Storyteller"
      Event = "Inspect_H_PostBoss_03"
    }
    {
      Id = "MelinoeField_1429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Merangkak naik dari dasar terdalam, rupanya...?"
      Speaker = "Melinoe"
      Event = "Inspect_H_PostBoss_03"
    }
  ]
}
