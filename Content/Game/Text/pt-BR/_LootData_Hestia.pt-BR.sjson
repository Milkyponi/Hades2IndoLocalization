      Event = "HestiaUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Hestia_0170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan bermain api kalau masih sayang nyawa, Nak."
      Speaker = "Hestia"
      Event = "HestiaUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Hestia_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Zaman aku bisa ditindas sudah lama lewat, Sayang!"
      Speaker = "Hestia"
      Event = "HestiaUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Hestia_0172"
      InheritFrom = "BaseSubtitle"
