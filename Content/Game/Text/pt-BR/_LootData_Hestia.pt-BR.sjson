{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _LootData_Hestia.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_0644"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lambang api itu..."
      Speaker = "Melinoe"
      Event = "HestiaUpgrade.FirstSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1478"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini Bibi Buyut..."
      Speaker = "Melinoe"
      Event = "HestiaUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Melinoe_1479"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hestia..."
      Speaker = "Melinoe"
      Event = "HestiaUpgrade.OnSpawnVoiceLines"
    }
    {
      Id = "Hestia_0145"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zaman dulu, Bibi tak pernah mengira si Zeus muda nan gagah ini tipe pria yang mau berumah tangga, dan Bibi sempat dongkol waktu dia memilih Hera saudariku yang malang itu jadi istrinya! Tapi kau sudah jadi suami yang amat baik untuknya, kan, Zeus?"
      Speaker = "Hestia"
      Event = "HestiaWithZeus01"
    }
    {
      Id = "Zeus_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Terkadang aku mengasihanimu, Hestia, karena tak pernah merasakan indahnya bahtera pernikahan. Masalah pasti selalu ada dalam hubungan semacam itu, tapi bersama pasangan tercinta, kau pasti menemukan jalan keluar! Kuncinya cuma saling kompromi dan kerja sama."
      Speaker = "Zeus"
      Event = "HestiaWithZeus01"
    }
    {
      Id = "Hestia_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi memang tak selalu peduli urusan keluarga, tapi ada pengecualian untuk adik perempuanku ini. Di antara semua dewi, dialah yang paling banyak makan hati di tempat ini, dan itu bahkan belum menghitung semua kekacauan Chronos ini. Bagaimana caramu menghadapinya, {#Emph}Wahai Ratu?"
      Speaker = "Hestia"
      Event = "HestiaWithHera01"
    }
    {
      Id = "Hera_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuhadapi malam demi malam satu per satu, Saudariku! Barangkali kita memang harus membumihanguskan dunia lama ini dan memulainya dari awal, tapi... menurutku {#Emph}tak ada {#Prev}yang lebih pantas melakukannya dibanding dirimu, jika memang saatnya tiba."
      Speaker = "Hera"
      Event = "HestiaWithHera01"
    }
    {
      Id = "Hestia_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima berkat kami tapi {#Emph}jangan {#Prev}tiru kelakuan kami, begitu kata Bibi, Sayang. Contoh nyatanya si muka ikan Poseidon di sebelah ini! Selalu berusaha keras bikin gebrakan heboh, {#Emph}sama sekali tak peduli {#Prev}siapa yang bakal kena cipratan basahnya. Betul begitu kan, dasar raksasa dungu?"
      Speaker = "Hestia"
      Event = "HestiaWithPoseidon01"
    }
    {
      Id = "Poseidon_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malah sebaliknya, Hestia tersayang! Rasanya kau keliru setidaknya dalam dua hal: Pertama, aku tak pernah perlu {#Emph}berusaha keras {#Prev}untuk membuat gebrakan heboh! Semuanya kulakukan dengan sangat mudah setiap saat. Dan kedua, jangan panggil aku {#Emph}si muka ikan{#Prev}, dasar nenek sihir keriput cerewet, {#Emph}ha-hah!"
      Speaker = "Poseidon"
      Event = "HestiaWithPoseidon01"
    }
    {
      Id = "Hestia_0151"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Sayang, ayo kita nyalakan kobaran api yang sesungguhnya! Tak usah repot-repot lagi bermain dengan letupan percikan kecil semata. Hei, {#Emph}Apollo? {#Prev}Cepat seret pantatmu ke mari sekarang juga, Bibi butuh pemantik!"
      Speaker = "Hestia"
      Event = "HestiaWithApollo01"
    }
    {
      Id = "Apollo_0096"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ehm{#Prev}, segera, Yang Mulia Nyonya Hestia! Tapi, bisakah kita lebih berhati-hati kali ini agar tidak membakar separuh puncak gunung lagi...?"
      Speaker = "Apollo"
      Event = "HestiaWithApollo01"
    }
    {
      Id = "Hestia_0153"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa percaya tidak, Gadis Membara? Bibi dengar dari sumber terpercaya bahwa {#Emph}seseorang {#Prev}di sekitar sini mengaku-ngaku sebagai {#Emph}Yang Tertua di Olympus. {#Prev}Hei, Demeter? Mau menjelaskan perihal {#Emph}itu?"
      Speaker = "Hestia"
      Event = "HestiaWithDemeter01"
    }
    {
      Id = "Demeter_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hestia, kau dulu telah {#Emph}menelantarkan {#Prev}kami! Menjadi seorang Olympian bukan semata hak lahiriah, melainkan sebuah {#Emph}ikrar sumpah; {#Prev}baik untuk keluarga ini, maupun untuk gunung ini. Pulihkan kedudukan sucimu, dan bergabunglah denganku sekarang untuk membantu cucuku!"
      Speaker = "Demeter"
      Event = "HestiaWithDemeter01"
    }
    {
      Id = "Hestia_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sayang sekali untuk saat ini yang bisa Bibi lakukan cuma menghujanimu dengan Berkah dan semacamnya, Gadis Membara. Bibi tadi baru saja bernostalgia bersama Demeter tentang bagaimana kami dulu turun tangan langsung menyelesaikan urusan semacam ini!"
      Speaker = "Hestia"
      Event = "HestiaWithDemeter02"
    }
    {
      Id = "Demeter_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau ingin bertarung langsung lagi, tak ada yang melarangmu, Hestia terkasih. Kendati kita sudah lama melepaskan senjata yang memberi kita kemenangan akbar pertama dulu, dengan perpaduan embun bekuku dan kobaran apimu, kurasa kita sanggup mengatasinya."
      Speaker = "Demeter"
      Event = "HestiaWithDemeter02"
    }
    {
      Id = "Hestia_0155"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo, lekas beraksi, Gadis Membara! Mumpung parasmu masih menawan! Tak mungkin si Aphrodite di sini bakal membiarkanmu mempertahankan pesonamu selamanya. Dia paling benci saingan, percayalah pada Bibi soal yang satu itu."
      Speaker = "Hestia"
      Event = "HestiaWithAphrodite01"
    }
    {
      Id = "Aphrodite_0147"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hestia manis, apa maksud perkataanmu {#Emph}barusan? {#Prev}Aku orang pertama yang mengakui bahwa rupa menawan itu bukanlah {#Emph}segalanya. {#Prev}Siapa juga yang butuh rupa semata? Tapi di sisi lain, kita sungguh diberkati memiliki sosok dengan kebijaksanaan dan pengalaman seluas dirimu di pihak kita!"
      Speaker = "Aphrodite"
      Event = "HestiaWithAphrodite01"
    }
    {
      Id = "Hestia_0157"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau ada satu hal yang kupelajari dari keponakanku yang berlengan kekar ini, Sayang, itu adalah kau harus selalu menempa selagi besinya masih panas membara. Nah, {#Emph}ayo{#Prev}, {#Emph}lekas beraksi{#Prev}, Hephaestus jagoanku!"
      Speaker = "Hestia"
      Event = "HestiaWithHephaestus01"
    }
    {
      Id = "Hephaestus_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah beraksi kok, sudah beraksi, Nyonya, {#Emph}augh! {#Prev}Tapi kalau kau terus-terusan menaikkan suhu panas di sini, seluruh {#Emph}tempat tempaan {#Prev}ini bakal meledak, dan ikut melenyapkan sisa gunung terkutuk ini {#Emph}juga! {#Prev}Lalu apa lagi yang tersisa untuk diperjuangkan si penyihir kecil?"
      Speaker = "Hephaestus"
      Event = "HestiaWithHephaestus01"
    }
    {
      Id = "Hestia_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum fana yang malang itu sudah banyak sekali menderita, gara-gara si Ares ini. Setidaknya untuk kali ini dia disibukkan oleh urusan kita sendiri, kan, Nak? Dengan begitu orang-orang lain di bawah sana bisa bernapas lega sejenak."
      Speaker = "Hestia"
      Event = "HestiaWithAres01"
    }
    {
      Id = "Ares_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi Nyonya Hestia tersayang, masalah kita ini menyangkut hal yang jauh lebih besar daripada sekadar nasib kaum fana! Milik kita ini adalah konflik kasta tertinggi, yang tak terelakkan memanggil kita masing-masing untuk mengambil bagian."
      Speaker = "Ares"
      Event = "HestiaWithAres01"
    }
    {
      Id = "Melinoe_0645"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira sang dewi perapian tak pernah mau ikut campur? {#Emph}Atas nama Hades! Olympus, kuterima pesan ini!"
      Speaker = "Melinoe"
      Event = "HestiaFirstPickUp"
    }
    {
      Id = "Hestia_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat dirimu, Gadis Membara! Datang membantu orang tua, {#Emph}ah {#Prev}anak pintar kau ini. Padahal Bibi tadi sudah bersiap membumihanguskan seluruh tempat terkutuk ini sendirian! Nah, ini sedikit {#Emph}pemanasan {#Prev}untukmu..."
      Speaker = "Hestia"
      Event = "HestiaFirstPickUp"
    }
    {
      Id = "Hestia_0071"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, Sayang, penampilanmu tampak {#Emph}mengenaskan{#Prev}, apa yang terjadi padamu di sana? Yah, mungkin kau bisa mengeluarkan racunnya lewat keringat atau semacamnya. Seandainya saja Bibi bisa membakar menutup luka-lukamu itu!"
      Speaker = "Hestia"
      Event = "HestiaLowHealth01"
    }
    {
      Id = "Hestia_0072"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ck, aduh{#Prev}, lukamu bukan cuma sekadar lecet-lecet kecil, ya? {#Emph}Augh{#Prev}, ya begitulah hidup! Tahan rasa sakitnya dan teruslah maju, begitu cara kita sampai ke tempat yang lebih baik."
      Speaker = "Hestia"
      Event = "HestiaLowHealth02"
    }
    {
      Id = "Hestia_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, kelihatannya kau baru saja melewati {#Emph}banyak cobaan berat! {#Prev}Nah, kalau kau mendapati dirimu di situasi yang buruk, terjang saja terus ke depan! Atau bumihanguskan segala hal di sekitarmu kalau memang terpaksa."
      Speaker = "Hestia"
      Event = "HestiaLowHealth03"
    }
    {
      Id = "Hestia_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh Sayang, kalau kau babak belur dari ujung kepala sampai ujung kaki begini, kau jelas tak dalam kondisi prima untuk babak adu tembak berikutnya! Jadi kuatkan dirimu, {#Emph}ya?"
      Speaker = "Hestia"
      Event = "HestiaLowHealth04"
    }
    {
      Id = "Hestia_0077"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah halo, Sayang, sedang bersiap-siap untuk petualanganmu berikutnya di sana? Untuk sekarang kau masih berupa bara api kecil yang berpijar, jadi bagaimana kalau kita buat kau berkobar menyala-nyala?"
      Speaker = "Hestia"
      Event = "HestiaRunStart01"
    }
    {
      Id = "Hestia_0117"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, jangan keluyuran ke dalam kegelapan tanpa penerangan yang layak! Dan maksudku bukan penerangan murahan yang ditawarkan Apollo, walau mungkin Bibi masih bisa mentolerir sang Rembulan. Sudahlah, tak masalah, {#Emph}ambil ini!"
      Speaker = "Hestia"
      Event = "HestiaRunStart02"
    }
    {
      Id = "Hestia_0118"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pikir bisa menyelinap keluar selarut ini tanpa ketahuan oleh Bibi? Yah, biasanya sih bisa, tapi tidak kali ini! Dan hukumanmu adalah serentetan Berkah penghangat tungku yang istimewa ini!"
      Speaker = "Hestia"
      Event = "HestiaRunStart03"
    }
    {
      Id = "Hestia_0119"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti tinggal di sekitar daerah itu, kan, Sayang? Nah, berhubung di luar sana malam ini tampak agak dingin, kenapa kita tidak membuat sedikit {#Emph}penyesuaian suhu {#Prev}di sini..."
      Speaker = "Hestia"
      Event = "HestiaRunStartUnderworld01"
    }
    {
      Id = "Hestia_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bertahan hidup saja sudah cukup susah, tapi kalian bangsa Bawah Tanah memang tidak seharusnya berada di permukaan sama sekali! Tak heran kau memilih kembali ke bawah sana, Bibi pun pasti bakal melakukan hal yang sama tanpa pikir panjang!"
      Speaker = "Hestia"
      Event = "HestiaRunStartUnderworld02"
    }
    {
      Id = "Hestia_0120"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi, kau menuju ke atas sini lagi? Bibi sih sama sekali tak keberatan! Tak yakin juga apa suaraku bisa terdengar sampai ke bawah sana, kalau dipikir-pikir. Pokoknya, ayo kita bikin kau {#Emph}hangat membara!"
      Speaker = "Hestia"
      Event = "HestiaRunStartSurface01"
    }
    {
      Id = "Hestia_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memutuskan untuk naik mencari udara segar lagi, Gadis Membara? Tentu, Dunia Bawah pasti punya banyak pemandangan dan kegiatan, tapi dengan segala hormat! Jelas tak ada apa-apanya dibanding semua yang kita miliki di atas sini."
      Speaker = "Hestia"
      Event = "HestiaRunStartSurface02"
    }
    {
      Id = "Hestia_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Untuk setiap lilin yang kau nyalakan, untuk setiap kuali yang kau rebus, itulah kobaran api {#Emph}milikku {#Prev}yang merajut sihirnya sendiri untukmu, Sayang! Jadi, ingatlah Bibi setiap kali ada percikan api yang menyala."
      Speaker = "Hestia"
      Event = "HestiaAboutFlame01"
    }
    {
      Id = "Hestia_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hal yang unik tentang api, Sayang, dia hangat dan cantik, bukan? Tapi bisa membunuhmu hanya dengan beberapa jilatan. Benar-benar bikin berpikir! Dan benar-benar bikin kamu gosong terpanggang kalau tidak hati-hati..."
      Speaker = "Hestia"
      Event = "HestiaAboutFlame02"
    }
    {
      Id = "Hestia_0103"
      InheritFrom = "BaseNarrative"
      DisplayName = "Coba tebak, gadis berapi, Bibi Buyutmu kembali lagi untuk mengubah musuh-musuhmu jadi abu! Cara terbaik agar mereka tak mengganggumu lagi, meski beres-beresnya agak merepotkan..."
      Speaker = "Hestia"
      Event = "HestiaAboutSoot01"
    }
    {
      Id = "Hestia_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hih{#Prev}, puncak gunung ini. Aku merelakan kursiku di sini, tahu. Dulu aku ingin melihat dunia, bukannya melihat saudari-saudari menyebalkan itu setiap hari! Tapi sekarang aku malah terjebak di sini bersama mereka semua. Rasanya panas membara bahkan hanya dengan memikirkannya!"
      Speaker = "Hestia"
      Event = "HestiaAboutSisters01"
    }
    {
      Id = "Hestia_0052"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terbiasa hidup dalam kegelapan, kan? Di atas sini, kegelapan sangat ditakuti. Bahkan dalam hangatnya cahaya apiku, mereka kaget melihat bayangan, manusia fana dan terkadang para dewa juga! Menurutku mereka terlalu memercayai mata mereka yang lemah itu."
      Speaker = "Hestia"
      Event = "HestiaAboutDarkness01"
    }
    {
      Id = "Hestia_0044"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sendirian selama ini, ya? Yah, mungkin kau lebih beruntung begitu. Kuharap aku tak pernah kenal ayah dan ibu sialanku {#Emph}itu{#Prev}! Mereka tak mengajariku hal apa pun yang tak bisa kupelajari sendiri dengan lebih baik."
      Speaker = "Hestia"
      Event = "HestiaAboutParents01"
    }
    {
      Id = "Hestia_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Api perapian gunung ini mulai agak redup setelah Typhon memutuskan untuk muncul. Sejak saat itu apinya menyala terang dan panas, tapi aku sering merawatnya, sekadar berjaga-jaga."
      Speaker = "Hestia"
      Event = "HestiaAboutHearth01"
    }
    {
      Id = "Hestia_0253"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat, mereka punya patung-patung diriku di atas sini sekarang, Sayang? Dulu tidak ada, tapi yang lain berusaha membawaku kembali ke pelukan keluarga, memberiku penghormatan, niat yang manis! Tapi aku tak mau melihat wajahku sendiri sepanjang waktu!"
      Speaker = "Hestia"
      Event = "HestiaAboutHestiaStatue01"
    }
    {
      Id = "Hestia_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kenapa kau tidak tinggal di Griya Hades bersama ayah dan ibumu? Pasti menyenangkan dan nyaman di sana, jauh di dalam Bumi. Yah, sebuah Griya belum tentu jadi rumah. Barangkali kau lebih suka hutanmu..."
      Speaker = "Hestia"
      Event = "HestiaAboutHouse01"
    }
    {
      Id = "Hestia_0045"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu apa masalah keluarga ini, Sayang? Terlalu besar! Yang lain bersikap seolah mengasihaniku, {#Emph}Hestia malang yang tak punya anak{#Prev}, kata mereka! Padahal mereka semua merindukan masa-masa tanpa anak, aku bisa melihatnya dari mata mereka."
      Speaker = "Hestia"
      Event = "HestiaAboutOlympians01"
    }
    {
      Id = "Hestia_0046"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hampir merasa kasihan padamu, Sayang, terseret ke dalam urusan kami! Kau tak tahu betapa keras usahaku untuk menghindarinya sendiri. Haruskah kita selalu memihak dalam segala hal? Tapi kita para dewa memang suka sekali pertarungan yang sengit..."
      Speaker = "Hestia"
      Event = "HestiaAboutOlympians02"
    }
    {
      Id = "Hestia_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupikir kita bisa memanfaatkanmu, Sayang, bukan kejutan besar. Tapi, aku tak menyangka kami akan {#Emph}menyukaimu{#Prev}, maksudku kau masih muda, punya kebiasaan yang berbeda dan semacamnya. Kami ini susah diajak akur! Tapi kau {#Emph}berhasil melakukannya{#Prev}!"
      Speaker = "Hestia"
      Event = "HestiaAboutOlympians03"
    }
    {
      Id = "Hestia_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Titan, dewa, sampai sekarang aku masih tak tahu apa bedanya! Kelihatannya tak jauh berbeda, suaranya tak jauh berbeda. Bukan soal usia, {#Emph}itu {#Prev}bisa kupastikan! Itu cuma cara mudah untuk melabeli musuh kita."
      Speaker = "Hestia"
      Event = "HestiaAboutTitans01"
    }
    {
      Id = "Hestia_0038"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ooh{#Prev}, aku ini hebat di masa jayaku. Banyak pelamar. {#Emph}Cih! {#Prev}Dulu tembakanku jitu dengan Rel Adamant. Pernah dengar tentang itu? Benda yang mengerikan, sudah kutinggalkan. Meninggalkan perang sama sekali! Sampai sekarang, tampaknya!"
      Speaker = "Hestia"
      Event = "HestiaBackstory01"
    }
    {
      Id = "Hestia_0042"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, gairah masa muda! Aku sudah meredup, tak lagi sedap dipandang saat ini. Tak apa. Tapi {#Emph}kau? {#Prev}Masih berupa ranting penyulut api. Namun, kelak kami akan membuatmu jadi api yang berkobar hebat!"
      Speaker = "Hestia"
      Event = "HestiaBackstory02"
    }
    {
      Id = "Hestia_0041"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi kau ini seorang penyihir, ya? Yah, aku bukan! Sudah terjebak dengan keluarga {#Emph}ini{#Prev}, aku tak tahu kenapa aku harus menginginkan yang lain. Tapi kurasa aku paham daya tariknya. Ada banyak lilin dan api di dalamnya, kan?"
      Speaker = "Hestia"
      Event = "HestiaAboutWitchcraft01"
    }
    {
      Id = "Hestia_0053"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seharusnya kita lebih ramah kepada manusia fana, sungguh. Kalau begitu, Chronos akan lebih sulit memaksa orang mati untuk bangkit melawan kita! Aku selalu berusaha menjaga yang hidup. Tapi keluarga kita paling dikenal hanya peduli pada diri sendiri."
      Speaker = "Hestia"
      Event = "HestiaAboutMortals01"
    }
    {
      Id = "Hestia_0054"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu manusia fana sering memberi kami persembahan, merelakan makanan mereka sendiri dan semacamnya. Mereka selalu memujaku lebih dulu di antara para dewa, karena apikulah yang mereka pakai saat berkorban. Manis sekali!"
      Speaker = "Hestia"
      Event = "HestiaAboutMortals02"
    }
    {
      Id = "Hestia_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang lain tak setuju denganku soal ini, Sayang, tapi kau masih muda, mungkin mudah terpengaruh, jadi... yah, {#Emph}menurutku {#Prev}manusia fana pantas mendapatkan dari kita sedikit lebih banyak daripada yang kita berikan. Kalau Takdir bilang itu akan terjadi kelak, syukurlah!"
      Speaker = "Hestia"
      Event = "HestiaAboutMortals03"
    }
    {
      Id = "Hestia_0105"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hecate tua itu gurumu, kan? Mengenalnya sejak usiaku mungkin sebaya {#Emph}dirimu{#Prev}, wanita yang amat tangguh! Sudah terlalu lama sejak terakhir kali kami bertemu, kalau dipikir-pikir. {#Emph}Yah{#Prev}, mau bagaimana lagi? Dia membenci semua orang, aku pun membenci semua orang."
      Speaker = "Hestia"
      Event = "HestiaAboutHecate01"
    }
    {
      Id = "Hestia_0047"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat dirimu, gadis berapi, kau berhasil sampai ke permukaan juga! Sudah kuduga kau bisa. Di sini mungkin lebih dingin daripada di bawah sana, tapi {#Emph}hal itu{#Prev}, setidaknya, kurasa bisa langsung kita atasi!"
      Speaker = "Hestia"
      Event = "HestiaAboutSurface01"
    }
    {
      Id = "Hestia_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "Manusia fana beralih dari memuja api menjadi takut padanya. Sebagaimana mestinya! Api perapian di setiap rumah di kota terkutuk tempat tinggalmu itu, semuanya padam. Bukannya aku marah, oh tentu tidak."
      Speaker = "Hestia"
      Event = "HestiaAboutSurface02"
    }
    {
      Id = "Hestia_0036"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kasihan sekali, terkurung di dalam Dunia Bawah itu, ya? Ada dunia luar yang begitu luas untuk dilihat, begitu urusanmu selesai. Beri tahu aku, aku bisa menyarankan beberapa tempat luar biasa yang tak jauh dari sini!"
      Speaker = "Hestia"
      Event = "HestiaAboutSurface03"
    }
    {
      Id = "Hestia_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kota Ephyra terbakar, tapi itu bukan sepenuhnya salahku! Kobaran api itu seperti alat perkakas, kurasa... salah satu hal yang butuh kehati-hatian dari pemiliknya. Kehilangan sesuatu dalam kebakaran, maaf saja! Aku tak bisa membantumu soal itu!"
      Speaker = "Hestia"
      Event = "HestiaAboutEphyra01"
    }
    {
      Id = "Hestia_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak seharusnya ada di atas sini, kan? Kurasa ayahmu tak diizinkan kembali ke atas, setidaknya. Tapi kau seorang penyihir, pasti kau punya obat untuk segala hal di bawah matahari!"
      Speaker = "Hestia"
      Event = "HestiaAboutSurfacePenalty01"
    }
    {
      Id = "Hestia_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan biarkan kami terus mempermainkanmu, oke? Mula-mula kami menyuruhmu memburu Chronos, sekarang kami menyuruhmu datang ke sini untuk membela kami, {#Emph}sialan! {#Prev}Meski sekadar berjaga-jaga kalau belum ada yang mengatakannya, kami {#Emph}benar-benar {#Prev}menghargai bantuanmu."
      Speaker = "Hestia"
      Event = "HestiaAboutRouteChoice01"
    }
    {
      Id = "Hestia_0049"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di kedalaman mana {#Emph}kau {#Prev}berada, Sayang, di bawah laut?! Sulit menyalakan api yang membara saat ada air di mana-mana, tapi kalau kau bisa menahan tekanan di bawah sana, aku bisa memberikan panasnya!"
      Speaker = "Hestia"
      Event = "HestiaAboutOceanus01"
    }
    {
      Id = "Hestia_0111"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah berhasil turun sejauh itu ke Padang Ratapan sebelumnya? Tempat yang mengerikan, begitu kudengar, dan dipenuhi semak kering sejauh mata memandang. Nah, lain kali kau ke sana, bakar jalanmu untuk lewat! Dengar aku, gadis berapi?"
      Speaker = "Hestia"
      Event = "HestiaAboutFields01"
    }
    {
      Id = "Hestia_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suatu hari nanti aku ingin melihat Sungai Phlegethon yang kalian miliki di Dunia Bawah! Sungai yang penuh {#Emph}api... {#Prev}pernah kucoba membuat hal seperti itu di pihak kita, tapi manusia fana jadi panik, dan para dewa juga tak begitu menyukainya..."
      Speaker = "Hestia"
      Event = "HestiaAboutPhlegethon01"
    }
    {
      Id = "Hestia_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bahkan tak diajak berkeliling Istana, kata Hera. {#Emph}Aduh{#Prev}, Sayang, andai saja aku bisa ada di sana untuk mengajakmu berkeliling alih-alih merawat perapian kita. Tapi dipikir-pikir lagi, kau melihat satu pilar megah kami, mungkin kau sudah melihat semuanya."
      Speaker = "Hestia"
      Event = "HestiaAboutPalace01"
    }
    {
      Id = "Hestia_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih ingat rasanya ketika kami menunjukkan kepada Chronos seperti apa kemampuan generasi muda kami! Sekarang {#Emph}kaulah {#Prev}generasi muda itu, Sayang, menghadapi masalah lama yang sama dan bahkan lebih buruk. Memang ada hal-hal yang tak pernah berubah!"
      Speaker = "Hestia"
      Event = "HestiaAboutChronosBossW01"
    }
    {
      Id = "Hestia_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau dan Hecate tua, kalian pasti sedang mencari cara agar Chronos itu tak bisa pulih kembali, kalau tidak kalian takkan terus memburunya seperti ini! Sudah mulai menemukan titik terang?"
      Speaker = "Hestia"
      Event = "HestiaAboutChronosBossW02"
    }
    {
      Id = "Hestia_0113"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kabar burung bilang kau memberinya hadiah dari kita semua! Chronos, maksudku. {#Emph}Bogem mentah {#Prev}gaya lama yang pantas diterimanya! Pasti rasanya hangat dan memuaskan, bukan? Bikin kau ingin melakukannya lagi dan {#Emph}lagi!"
      Speaker = "Hestia"
      Event = "HestiaUnderworldRunCleared01"
    }
    {
      Id = "Hestia_0114"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menghajar Titan sialan itu, kan? Jangan berkecil hati kau tak bisa menghabisinya sama sekali, bukan berarti kami yang lain mampu melakukannya, seperti yang bisa kau lihat sendiri. Sebagai gantinya, barangkali tendang saja dia saat dia {#Emph}terkapar! {#Prev}Senang bisa membantu untuk urusan {#Emph}yang itu!"
      Speaker = "Hestia"
      Event = "HestiaUnderworldRunCleared02"
    }
    {
      Id = "Hestia_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami sudah mengasingkan Chronos ke tempat santai yang nyaman di Kepulauan Diberkahi, betapa baiknya untuk dia, aku paham itu. Tapi kau masih bekerja sama dengannya untuk melawannya demi menghentikannya berkuasa, {#Emph}ya? {#Prev}Yah, kurasa aku paham itu juga!"
      Speaker = "Hestia"
      Event = "HestiaUnderworldRunCleared03"
    }
    {
      Id = "Hestia_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami dengar kau membereskan satu lagi Chronos jahat tadi malam! Rupanya masih banyak yang jahat tersisa. Yang harus kita hadapi ini mungkin aneh, meski kurasa aku lega kau tak harus meledakkan {#Emph}dirinya{#Prev}."
      Speaker = "Hestia"
      Event = "HestiaUnderworldRunCleared04"
    }
    {
      Id = "Hestia_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah berapa banyak Chronos keparat yang kau habisi, Jagoan? Pasti puas rasanya melihat seringai tua pongahnya berubah kecut berulang kali!"
      Speaker = "Hestia"
      Event = "HestiaUnderworldRunCleared05"
    }
    {
      Id = "Hestia_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membantu kami {#Emph}menghajar monster keparat itu{#Prev} sampai terkapar! {#Emph}Ah{#Prev}, andai saja aku bisa menyaksikannya! Kau benar-benar luar biasa, Jagoan! Tentu saja kawan baik kita si Typhon sudah mulai merangkak naik lagi. Kita tinggal bikin jalannya makin sengsara..."
      Speaker = "Hestia"
      Event = "HestiaSurfaceRunCleared01"
    }
    {
      Id = "Hestia_0115"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih sudah membantu menjernihkan suasana di atas sini! Memberi kami waktu sejenak untuk pulih dan mengatur barisan. Sekarang semuanya kembali bersemangat membara untuk mendobrak kepungan! {#Emph}Aduh{#Prev}, tapi dengarkan aku ini! Ikut-ikutan gila perang seperti yang lainnya..."
      Speaker = "Hestia"
      Event = "HestiaSurfaceRunCleared02"
    }
    {
      Id = "Hestia_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar kupastikan dulu apa aku paham: Meski kau menyingkirkan Typhon demi kami, sekarang kau malah disuruh memburu sisa-sisa dirinya di suatu tempat di luar dunia fana ini? {#Emph}Oh{#Prev}, kau benar-benar tak dikasih {#Emph}napas{#Prev}, ya, Jagoan! Tapi tenang, Bibi selalu mendukungmu."
      Speaker = "Hestia"
      Event = "HestiaSurfaceRunCleared03"
    }
    {
      Id = "Hestia_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tahu tidak, agak ngeri juga membayangkan sekarang kita berhadapan dengan apa yang mungkin berjumlah ribuan Typhon... {#Emph}kemungkinan-kemungkinan {#Prev}Typhon, kurasa itu istilahnya. Setidaknya kita cuma perlu membereskan mereka satu demi satu!"
      Speaker = "Hestia"
      Event = "HestiaSurfaceRunCleared04"
    }
    {
      Id = "Hestia_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luar biasa, Sayang, menghajar Chronos keparat lalu menghabisi Typhon berturut-turut! Kau membuatnya tampak begitu gampang. Mungkin aku harus mencobanya sendiri sesekali?"
      Speaker = "Hestia"
      Event = "HestiaAboutWinStreak01"
    }
    {
      Id = "Hestia_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, kau benar-benar sedang membara tanpa henti, Jagoan! Pantas saja Bibi selalu memanggilmu begitu, {#Emph}kan? {#Prev}Tiap malam kau selalu pulang membawa hasil jarahan, pertahankan itu!"
      Speaker = "Hestia"
      Event = "HestiaAboutWinStreak02"
    }
    {
      Id = "Hestia_0055"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dapat Arang Bara di situ, ya? Memang bukan barang berkilau, tapi itu kuat, sumber api yang bagus! Kebanyakan dewa dan manusia fana cuma peduli pada pernak-pernik gemerlap. Tapi sebagian penyihir seperti kalian tahu betul kualitas barang!"
      Speaker = "Hestia"
      Event = "HestiaAboutCinder01"
    }
    {
      Id = "Hestia_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memborong banyak Arang Bara, ya? Dari sini pun bisa kucium baunya... jenis istimewa dari obor yang sangat kukenal. Sisa-sisa pertarunganmu dengan Hecate? Ah, kalian tak mungkin sungguhan bertarung. Paling cuma olahraga malam!"
      Speaker = "Hestia"
      Event = "HestiaAboutCinder02"
    }
    {
      Id = "Hestia_0249"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau punya banyak Abu, ya? Sisa-sisa dari masa lalu. Membuat rendah hati membayangkan bahwa monumen termegah, hutan lebat, dan segalanya bisa luluh lantak menjadi {#Emph}itu."
      Speaker = "Hestia"
      Event = "HestiaAboutAsh01"
    }
    {
      Id = "Hestia_0112"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang lain, dengan cara masing-masing, suka sekali dijadikan bahan dongeng dan tembang oleh kaum fana. Kalau aku, {#Emph}ogah! {#Prev}Dalam hal ini, menurutku kalian para dewa Bawah Tanah yang benar. Paling baik urus urusan keparat kita sendiri!"
      Speaker = "Hestia"
      Event = "HestiaAboutMyths01"
    }
    {
      Id = "Hestia_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin bertanya-tanya, {#Emph}Bibi Buyut Hestia, kapan pertempuran ini bakal berakhir? {#Prev}Coba bayangkan saat aku masih seumuranmu... sedikit lebih ramping, sedikit lebih beringas, tapi kurang lebih sama saja. Kami sudah bertarung sejak zaman itu."
      Speaker = "Hestia"
      Event = "HestiaAboutFighting01"
    }
    {
      Id = "Hestia_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang kau bawa itu, Ygnium, ya? Mengingatkanku pada obor kembar yang selalu dibawa si tua Hecate. Kalau senjata itu mirip punyanya, apinya takkan pernah padam. Tapi untuk berjaga-jaga, mari kita buat makin panas membara!"
      Speaker = "Hestia"
      Event = "HestiaAboutTorch01"
    }
    {
      Id = "Hestia_0251"
      InheritFrom = "BaseNarrative"
      DisplayName = "Api yang aneh kau bawa malam ini, kalau itu memang bisa disebut api. Jadi itu salah satu senjata Nyx, {#Emph}ya? {#Prev}Bisa berganti wujud seperti Senjata Kegelapan zaman dulu."
      Speaker = "Hestia"
      Event = "HestiaAboutMorosAspect01"
    }
    {
      Id = "Hestia_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa dengan Kobaran Aipmu itu? Sekarang bersinar hampir seperti fajar menyingsing. Mungkinkah si Eos yang berjari lentik itu memutuskan untuk ikut urun bantuan? Padahal kita paling segan mengganggu satu-satunya jadwal hariannya..."
      Speaker = "Hestia"
      Event = "HestiaAboutEosAspect01"
    }
    {
      Id = "Hestia_0250"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihatlah api mewah yang kaubawa itu, memercikkan bunga api tak terkendali ke mana-mana! Itu bahaya kebakaran, Sayang. Dulu saat aku menembakkan api ke musuh-musuhku, jelas tak otomatis seperti itu. Bocah-bocah zaman sekarang hidupnya serba {#Emph}gampang!{#Prev}"
      Speaker = "Hestia"
      Event = "HestiaAboutSupayAspect01"
    }
    {
      Id = "Hestia_0254"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perkakas aneh yang kaurakit untuk meledakkan segalanya! Dulu aku juga dipandangi aneh saat masih memegang Bedil Adamant, tapi senapan itu bisa membuat mereka langsung buang muka seketika."
      Speaker = "Hestia"
      Event = "HestiaAboutSuit01"
    }
    {
      Id = "Hestia_0076"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami bisa bertahan di atas sini melawan si Chronos dan pasukannya, tapi ada sesuatu yang janggal sedang terjadi, oh Bibi bisa merasakannya. Apa pun yang disiapkan sang Titan, bagaimanapun juga, kutebak itu tetap bisa {#Emph}terbakar...{#Prev}"
      Speaker = "Hestia"
      Event = "HestiaAboutChronosPlan01"
    }
    {
      Id = "Hestia_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami tak tahu pasti apa yang sedang direncanakan Chronos untuk kami, tapi kami menduga bentrokan kecil baru-baru ini di lereng gunung kami belum seberapa. Sejujurnya kami tak sudi cari tahu."
      Speaker = "Hestia"
      Event = "HestiaAboutChronosPlan02"
    }
    {
      Id = "Hestia_0102"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi Bibi merasakan dorongan aneh untuk mencarimu, Sayang! Seolah-olah bukan Bibi sendiri yang memutuskannya! Mengutak-atik kekuatan purba kosmis atau semacamnya? Kalau kau mau menatap jurang kehampaan yang dingin, Bibi akan membuatmu tetap hangat."
      Speaker = "Hestia"
      Event = "HestiaAboutPackageBounty01"
    }
    {
      Id = "Hestia_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah bagaimana kau bisa sampai sejauh ini begitu cepat malam ini, Jagoan, tapi kau tak boleh melangkah lebih jauh sebelum bersiap matang-matang. Harus bawa banyak {#Emph}panas {#Prev}ke tempat tujuanmu!"
      Speaker = "Hestia"
      Event = "HestiaAboutPackageBounty02"
    }
    {
      Id = "Hestia_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih tak habis pikir bagaimana kau bisa melesat sejauh itu hanya dalam sekejap mata sesekali. Mungkin sihir penyihirmu! Asal apimu jangan padam sebelum sampai di tujuan akhir."
      Speaker = "Hestia"
      Event = "HestiaAboutPackageBountyLateStart01"
    }
    {
      Id = "Hestia_0039"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, Bibi suka gadis yang siap menyingsingkan lengan baju, mengotori tangannya dan semacamnya. Terlalu banyak orang yang cuma menunggu orang lain membersihkan kekacauan mereka, sialan memang. Ngomong-ngomong, bagaimana kalau kau pergi dan {#Emph}meledakkan {#Prev}sesuatu demi Bibi, eh?"
      Speaker = "Hestia"
      Event = "HestiaPostGift01"
    }
    {
      Id = "Hestia_0074"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sudah membara terang di Olympus entah sudah berapa lama, Sayang. Mungkinkah masa kejayaan kita sudah lewat? Mungkin kita lebih mirip manusia fana daripada yang mau kita akui. Yah, kehancuran apa pun yang menanti, kuhadapi dengan tangan terbuka!"
      Speaker = "Hestia"
      Event = "HestiaPostGift02"
    }
    {
      Id = "Hestia_0075"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau ini benar-benar unik, Jagoan. Awalnya kukira kau agak angkuh, mirip beberapa orang lain yang kebetulan kukenal terlalu baik. Tapi kau sungguh-sungguh berkomitmen meluruskan kesalahan dari zaman sebelum kau lahir ini, kan?"
      Speaker = "Hestia"
      Event = "HestiaPostGift03"
    }
    {
      Id = "Hestia_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi tahu kau sibuk mengurus urusan Chronos ini, tapi Bibi ingin bilang, Bibi sangat menghargai usahamu membuat rumahmu jadi lebih nyaman dan hangat. Hangatkan tempat itu, dan Hestia tua ini pasti bisa merasakannya!"
      Speaker = "Hestia"
      Event = "HestiaAboutCosmetics01"
    }
    {
      Id = "Hestia_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Belum pernah ke tempat tinggalmu, tapi Bibi bisa tahu saat seseorang membuat rumah yang hangat dan bahagia, sebisa yang mereka mampu. Dekorasi, sentuhan kecil yang memberi rasa disambut, itu baru mantap! Tak semua orang paham, tapi {#Emph}kau {#Prev}paham betul."
      Speaker = "Hestia"
      Event = "HestiaAboutCosmetics02"
    }
    {
      Id = "Hestia_0057"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi pun mengakui gemeretak perapian yang tenang tak selalu cukup menyelesaikan masalah. Terkadang, yang kita butuhkan adalah kobaran api raksasa, neraka jahanam tingkat tinggi! Bagaimana kalau kita buat sekarang?"
      Speaker = "Hestia"
      Event = "HestiaLegendaryPickUp01"
    }
    {
      Id = "Hestia_0058"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perapian berada di jantung rumah manusia fana, Sayang, menjaga apiku tetap tenang di tempatnya. Tapi Bibi bisa memicu kebakaran liar hanya dalam {#Emph}sekejap! {#Prev}Dan saat Bibi marah, {#Emph}tepat {#Prev}itulah yang Bibi lakukan."
      Speaker = "Hestia"
      Event = "HestiaLegendaryPickUp02"
    }
    {
      Id = "Hestia_0037"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu dan aku akur-akur saja, secara relatif, kurasa. Namun setelah kami menundukkan para Titan ke tempat semestinya, dia turun ke Bawah Tanah, dan aku melayang pergi, seperti percikan dari nyala api..."
      Speaker = "Hestia"
      Event = "HestiaAboutHades01"
    }
    {
      Id = "Hestia_0110"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu dan aku, kami punya banyak kesamaan, kurasa. Dua dewa yang {#Emph}secara teknis bukan Olympian! {#Prev}Setidaknya aku bisa berkunjung kapan pun kumau, sedangkan Hades yang malang, begitu dia dibebani Dunia Bawah, mereka tak pernah lagi menganggapnya sebagai bagian dari kaum mereka!"
      Speaker = "Hestia"
      Event = "HestiaAboutHades02"
    }
    {
      Id = "Hestia_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi benar-benar lega mendengar ayahmu baik-baik saja. Dia dan ibumu, kakakmu, semua orang dari Graha miliknya itu. Semoga mereka semua hangat dan nyaman bersama di sana."
      Speaker = "Hestia"
      Event = "HestiaAboutHades03"
    }
    {
      Id = "Hestia_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keadaan sedang tak berpihak pada kita, Sayang. Terutama jika kabar yang kudengar tentang para Moirai itu benar. Terlepas dari pantas atau tidaknya kita berkuasa, merekalah yang menempatkan kita di sini... dan sekarang mereka lenyap bagai kepulan asap?"
      Speaker = "Hestia"
      Event = "HestiaAboutFates01"
    }
    {
      Id = "Hestia_0043"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harusnya kau lihat, Sayang, saat kami merobohkan Chronos tua dulu! Butuh enam orang dari kami, paling tidak, tapi kami berhasil menghajarnya! Tak heran dia masih dendam kesumat sampai sekarang. Kali ini kita harus melenyapkannya lebih tuntas! {#Emph}Kremasi{#Prev}, mungkin?"
      Speaker = "Hestia"
      Event = "HestiaAboutChronos01"
    }
    {
      Id = "Hestia_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena Typhon bangkit lagi, Bibi cuma mau bilang {#Emph}senang mengenalmu, Sayang! {#Prev}Bukannya kami mau menyerah tanpa perlawanan, tapi cuma jaga-jaga saja. Dulu saja kami nyaris tewas melawannya saat pertama kali menumbangkan Chronos zaman dulu! Dan sekarang dia sudah tumbuh jauh lebih {#Emph}besar!{#Prev}"
      Speaker = "Hestia"
      Event = "HestiaAboutTyphon01"
    }
    {
      Id = "Hestia_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi agak heran bagaimana kita bisa menahan Typhon agar tidak meratakan seluruh puncak gunung ini jadi abu. Pasti berkat petir, kobaran api, banjir bandang, gempa bumi, dan semacamnya! Kalau kau punya ide cemerlang, langsung saja naik ke sini!"
      Speaker = "Hestia"
      Event = "HestiaAboutTyphon02"
    }
    {
      Id = "Hestia_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Monster jahanam itu sudah tumbang dan tamat? Maksudku benar-benar lenyap selamanya, sampai-sampai kita tidak bisa menemukan jejaknya {#Emph}sama sekali! {#Prev}Orang-orang bilang kau mengubah Typhon jadi {#Emph}abu{#Prev}, Sayang! Itu baru namanya dahsyat dan mengerikan...!"
      Speaker = "Hestia"
      Event = "HestiaAboutTyphonDeath01"
    }
    {
      Id = "Hestia_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Artemis yang mengendus keberadaanmu, ya? Kebetulan yang luar biasa besar rasanya, tapi kita ini dewa, hal begini sudah biasa terjadi! Yang jelas Bibi senang dia menemukanmu tepat pada waktunya."
      Speaker = "Hestia"
      Event = "HestiaAboutArtemis01"
    }
    {
      Id = "Hestia_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, selagi kau di atas sini, hati-hatilah pada Herakles, orang bertubuh kekar besar itu, tahu kan? Salah satu prajurit terbaik kita, tapi terkadang terlihat seolah dia sudah muak dengan tugasnya. Padahal bagaimana bisa begitu, Bibi benar-benar tidak paham!"
      Speaker = "Hestia"
      Event = "HestiaAboutHeracles01"
    }
    {
      Id = "Hestia_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi baru saja mengobrol dengan Hera—dengan {#Emph}Ratu Hera{#Prev}, semestinya—tentang bagaimana kita bisa bersikap lebih lunak pada Herakles setelah semua ini berlalu. Dia pantas menaruh gada besarnya itu dan duduk beristirahat sepuasnya!"
      Speaker = "Hestia"
      Event = "HestiaAboutHeracles02"
    }
    {
      Id = "Hestia_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Arwah bocah Ikarus itu terbang ke sana-kemari di sekitar sini, ya? Berguna juga ada dia di dekat sini, membubung tinggi seperti burung. Dan sayap barunya itu kelihatannya mustahil meleleh!"
      Speaker = "Hestia"
      Event = "HestiaAboutIcarus01"
    }
    {
      Id = "Hestia_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau bertarung sengit dengan Polifemos! Bibi ingat jelas bagaimana dia kehilangan sebelah matanya itu. Katakan saja {#Emph}api {#Prev}memegang peran penting di sana, cukup sampai di situ saja. Hampir saja kasihan pada anak itu, tapi nyatanya dia bisa bertahan hidup. Dan kini malah menghalangi jalanmu..."
      Speaker = "Hestia"
      Event = "HestiaAboutPolyphemus01"
    }
    {
      Id = "Hestia_0073"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sempat berurusan dengan Eris si biang onar dalam perjalananmu ke sini, ya? {#Emph}Bagus sekali{#Prev}, kini Sang Perselisihan sendiri terang-terangan menentang kita! Ditambah lagi jari-jemari kotornya menyentuh Rail of Adamant milikku... Seharusnya kusimpan saja benda itu dulu."
      Speaker = "Hestia"
      Event = "HestiaAboutEris01"
    }
    {
      Id = "Hestia_0116"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau berhasil menjatuhkan Eris yang menyebalkan itu dari langit! Nah, rasakan itu! Meski kita tidak akan pernah bisa mengusirnya pergi untuk selamanya. Padahal dia salah satu anak {#Emph}Nyx{#Prev}! Melahirkan anak sebanyak itu sekaligus, wajar saja kalau ada satu yang cacat watak."
      Speaker = "Hestia"
      Event = "HestiaAboutEris02"
    }
    {
      Id = "Hestia_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Eris itu masih saja terus menghalangi jalanmu, padahal Khronos sendiri sudah mundur dan Typhon sudah binasa? Yah, sifat keras kepalanya benar-benar menyaingi {#Emph}kita{#Prev}, Bibi sampai hampir kagum dibuatnya!"
      Speaker = "Hestia"
      Event = "HestiaAboutEris03"
    }
    {
      Id = "Hestia_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Titan Tinjauan Masa Depan itu lolos dari belenggunya dan sekarang melawan kita! Sayang sekali. Hubungannya merenggang dengan kita sejak dia tertangkap basah membawa kabur apiku. Mencuri api demi umat fana! Padahal kalau minta baik-baik kan bisa kuberi!"
      Speaker = "Hestia"
      Event = "HestiaAboutPrometheus01"
    }
    {
      Id = "Hestia_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Prometheus, seingat Bibi kepalanya tidak pernah kekurangan akal. Dulunya dia orang yang sangat berkepala dingin, tapi sekarang? Dia malah mengabdi pada Khronos, menimbulkan kekacauan bagi kita di sini! Katanya dia bisa melihat masa depan, jadi dia pasti tahu dirinya takkan lolos begitu saja..."
      Speaker = "Hestia"
      Event = "HestiaAboutPrometheus02"
    }
    {
      Id = "Hestia_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi rasa begitu kita berhadapan dengan Khronos, Prometheus takkan jauh di belakangnya, merindukan masa-masa saat hatinya jadi santapan elang. Bibi tahu dia memang biang masalah, tapi... Bibi tidak tega melihatnya mengalami siksaan itu lagi. Entah kenapa Bibi merasa begitu..."
      Speaker = "Hestia"
      Event = "HestiaAboutPrometheus03"
    }
    {
      Id = "Hestia_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi tahu Prometheus konon bisa melihat apa yang akan terjadi nanti, tapi Bibi sulit percaya dia bisa meramalkan semua {#Emph}ini! {#Prev}Bibi rasa Bibi harusnya lebih murka padanya, tapi... setidaknya dia tampaknya masih peduli pada kaum fana."
      Speaker = "Hestia"
      Event = "HestiaAboutPrometheus04"
    }
    {
      Id = "Hestia_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kudengar kau dipulangkan paksa oleh Prometheus. Yah, kalau kau kena luka bakar darinya, jangan ditempeli es, tak peduli apa pun kata Demeter. Kalian para penyihir pasti punya salep dan ramuan semacamnya..."
      Speaker = "Hestia"
      Event = "HestiaAboutPrometheusL01"
    }
    {
      Id = "Hestia_0059"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau diselimuti pancaran cahaya rembulan Selene, ya? Bibi tidak memungkiri kalau itu punya pesona dan kekuatan tersendiri... tapi cahaya yang begitu dingin dan jauh, dibanding kobaran api yang membara? Jelas tidak ada tandingannya!"
      Speaker = "Hestia"
      Event = "HestiaAboutSelene01"
    }
    {
      Id = "Hestia_0060"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah sempat bersua dengan saudariku, Hera, ya? Dia memang lebih terbiasa mengurusi anak-anak muda sepertimu, tapi sekali lagi, urusan keluarganya sendiri saja sudah menumpuk. Jadi kenapa tidak ikut Bibi saja?"
      Speaker = "Hestia"
      Event = "HestiaAboutHera01"
    }
    {
      Id = "Hestia_0050"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ratu muda kita, Hera, selalu berpesan agar perasaan harus dipendam rapat-rapat dan dikendalikan baik-baik. Lihat ke mana sikap itu membawanya! Kalau kata Bibi, lepaskan saja amarah dan murkamu. Tumpahkan {#Emph}semuanya!{#Prev}"
      Speaker = "Hestia"
      Event = "HestiaAboutHera02"
    }
    {
      Id = "Hestia_0061"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, sang penguasa agung Olympus memberimu secuil dari {#Emph}kedahsyatan petirnya{#Prev}, begitu ya? Yah, itu saja takkan membawamu terlalu jauh, jadi biar Bibi tambahkan {#Emph}sedikit daya tembak ekstra {#Prev}di sini."
      Speaker = "Hestia"
      Event = "HestiaAboutZeus01"
    }
    {
      Id = "Hestia_0062"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah diberkati oleh dewa penguasa bumi dan lautan yang perkasa, ya? Kekuatan Poseidon dan milikku jarang bisa menyatu, tapi ya, Bibi dan dia pun sama saja tak pernah cocok, kau bisa pegang kata-kata Bibi soal itu, Sayang."
      Speaker = "Hestia"
      Event = "HestiaAboutPoseidon01"
    }
    {
      Id = "Hestia_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, dewa cahaya yang suka pamer itu memberimu sedikit {#Emph}kilau{#Prev}, ya? Bersinar terang layaknya matahari, begitulah Apollo, {#Emph}jelas sekali! {#Prev}Tapi ada banyak cara lain untuk menerangi suatu tempat, kau tahu."
      Speaker = "Hestia"
      Event = "HestiaAboutApollo01"
    }
    {
      Id = "Hestia_0064"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa anugerah dari Afrodit, bukan? Kau tahu, usianya jauh, {#Emph}jauh {#Prev}lebih tua dari penampilannya. Penampilan luar adalah segalanya bagi dia, sementara Bibi, Bibi membawa kehangatan dan pesona yang jauh berbeda..."
      Speaker = "Hestia"
      Event = "HestiaAboutAphrodite01"
    }
    {
      Id = "Hestia_0104"
      InheritFrom = "BaseNarrative"
      DisplayName = "Adik kecilku yang berhati dingin, Demeter, sudah menghubungimu ya, Bibi bisa tahu! Nenekmu itu menganggap dirinya {#Emph}yang tertua di Olympus{#Prev}, sombong sekali! Itu hanya benar karena Bibi biasanya tidak berada di sini. Mungkin dia membuatmu kedinginan, jangan cemas, Bibi punya obat yang {#Emph}paling tepat!{#Prev}"
      Speaker = "Hestia"
      Event = "HestiaAboutDemeter01"
    }
    {
      Id = "Hestia_0051"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kasihan adik kecilku, Demeter. Dia hanya melahirkan satu anak, seorang putri, Sayang. Persefone, ibumu! Namun meski begitu, anak itu memberinya duka yang sama banyaknya dengan suka. Tentu ini bukan salah ibumu. Dia gadis yang jelita, dengan rambut yang persis sepertimu."
      Speaker = "Hestia"
      Event = "HestiaAboutDemeter02"
    }
    {
      Id = "Hestia_0067"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi senang mengetahui kau dan Hefaistos bisa akrab. Anak itu sering kali menyendiri, seakan kobaran apiku adalah satu-satunya teman yang ia butuhkan. Dia bukan orang terburuk yang ada di kalangan para dewa."
      Speaker = "Hestia"
      Event = "HestiaAboutHephaestus01"
    }
    {
      Id = "Hestia_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah kenal Ares sekarang, kan, Sayang? Dia memang lebih berkepala dingin dibanding sebagian dari kita, tentu saja, tapi menurut Bibi ada yang tidak beres dengannya. Satu-satunya kehangatan yang {#Emph}dia {#Prev}pedulikan hanyalah dari tumpahan darah segar dan api pertempuran semacamnya."
      Speaker = "Hestia"
      Event = "HestiaAboutAres01"
    }
    {
      Id = "Hestia_0066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Langkah kakimu terasa lincah sekali kalau Bibi tidak salah lihat, Sayang! Pasti buah karya Hermes yang gesit itu. Kau tahu apa lagi yang bisa bergerak sangat cepat? Sini, biar kuberi sedikit petunjuk!"
      Speaker = "Hestia"
      Event = "HestiaAboutHermes01"
    }
    {
      Id = "Hestia_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi merasakan sesuatu yang berbeda pada dirimu di sana, Sayang. Mirip tanda berkah ilahi kita, tapi yang jelas ini bukan milik siapa pun di sini. Hawa kekuatannya luar biasa purba, bahkan jika dibandingkan dengan Bibi! Kau punya teman lama yang tidak kami ketahui?"
      Speaker = "Hestia"
      Event = "HestiaAboutChaos01"
    }
    {
      Id = "Hestia_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kami tidak terlalu khawatir saat ini karena Athena sedang menjaga benteng pertahanan. Sikapnya bisa sedikit merepotkan kalau kalian berdua bertemu nanti, tapi dari semua orang di sini, dialah orang pertama yang kupilih untuk melindungi punggungku."
      Speaker = "Hestia"
      Event = "HestiaAboutAthena01"
    }
    {
      Id = "Hestia_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi bahkan tak ingin tahu lagi apa yang sedang terjadi dengan Dionisos. Semakin memburuk situasinya, semakin ingin dia bersenang-senang dan mabuk kepayang! Seluruh dunia terkutuk ini terbakar pun dia pasti membiarkannya saja! Tapi anggurnya boleh juga kalau ada sekarang..."
      Speaker = "Hestia"
      Event = "HestiaAboutDionysus01"
    }
    {
      Id = "Hestia_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawa Bara Api Abadi milikku, kan? Kerlip nyalanya masih bisa terlihat samar dari sini. Caramu memberi tanda pada Bibi Buyut Hestia, dan yang lainnya, bahwa kau mendambakan Berkah yang diberi {#Emph}sedikit bumbu {#Prev}pedas!"
      Speaker = "Hestia"
      Event = "HestiaAboutKeepsake01"
    }
    {
      Id = "Hestia_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihat bagaimana Bara Api Abadi itu terus menyala? Namanya saja sudah Abadi, Sayang! Senang melihat benda itu berguna untukmu, itu artinya Bibi bisa tetap aktif di usia setua ini!"
      Speaker = "Hestia"
      Event = "HestiaAboutKeepsake02"
    }
    {
      Id = "Hestia_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu dari malam ini yang benar-benar membuat bulu kuduk Bibi meremang, Manis. Kegelapannya begitu pekat, sampai terasa menyesakkan dada! Masalahnya, api mustahil menyala tanpa udara. Hati-hati, ya?"
      Speaker = "Hestia"
      Event = "HestiaAboutShrine01"
    }
    {
      Id = "Hestia_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "Luar sana benar-benar terasa mencekam; nyaris tak ada yang bisa terlihat. Tapi kau tahu? Di mana ada api, di situ ada cahaya. Jadi tetaplah bersama Bibi! Bersama-sama, kita bisa melalui masa-masa tergelap ini."
      Speaker = "Hestia"
      Event = "HestiaAboutShrine02"
    }
    {
      Id = "Hestia_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada apa sebenarnya dengan Khronos, {#Emph}ya? {#Prev}Satu saat situasinya masih perang sengit seperti biasa, lalu berikutnya, dia mendadak muncul di gunung kami dengan penuh rasa bersalah! Bibi tahu kalian para penyihir bisa bertindak nekat, tapi yang satu ini jauh di luar dugaan Bibi!"
      Speaker = "Hestia"
      Event = "HestiaPostTrueEnding01"
    }
    {
      Id = "Hestia_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemarin aku terlalu heboh sampai lupa mengucapkan selamat padamu, Sayang! Diberkatilah kau atas segalanya! Kau mendapati kami di tengah kekacauan parah dan berhasil menyelamatkan kami. Tentu kami juga membantu dan sebagainya, tapi kaulah yang memasaknya, dan masakanmu sungguh mantap."
      Speaker = "Hestia"
      Event = "HestiaPostTrueEnding02"
    }
    {
      Id = "Hestia_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Zeus dan Hera punya rencana konyol untuk menghentikan Typhon, melibatkan Hephaestus beserta tempat tempaannya dan hanya sedikit percikan apiku untuk memulainya. Seluruh daratan ini patut bersyukur kita tidak memakai rencana {#Emph}itu."
      Speaker = "Hestia"
      Event = "HestiaPostTrueEnding03"
    }
    {
      Id = "Hestia_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berhasil menemukan saudari-saudari penenun kecil itu, ya? Tepat saat kukira mereka telah meninggalkan kita semua untuk selamanya! Entah apa maksud dari ramalan baru mereka itu, tapi waktu pada akhirnya akan selalu membuktikannya."
      Speaker = "Hestia"
      Event = "HestiaPostEpilogue01"
    }
    {
      Id = "Hestia_0252"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ketika semua ini usai, sepertinya aku bakal lanjut mengembara ke sana kemari. Melihat bagaimana nasib kaum fana dan dunia fana saat ini, hal itu tidak bisa dilakukan semudah itu dari tempat tinggi. Olympus mungkin tempat yang menyenangkan untuk dikunjungi, tapi aku sendiri tak pernah berminat tinggal di sini."
      Speaker = "Hestia"
      Event = "HestiaPostEpilogue02"
    }
    {
      Id = "Hestia_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, aku benar-benar lelah sekarang, tahu tidak? Menghanguskan ini dan itu, terus-menerus, lama-lama melelahkan juga! Aku akan terus mendukungmu, Sayang, tapi mungkin takkan banyak mengobrol untuk sementara waktu."
      Speaker = "Hestia"
      Event = "HestiaAboutSayingLittle01"
    }
    {
      Id = "Hestia_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ah{#Prev}, mari kita {#Emph}bakar habis {#Prev}semuanya, bagaimana menurutmu, Sayang?"
      Speaker = "Hestia"
      Event = "HestiaChat01"
    }
    {
      Id = "Hestia_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita akan mengubah percikan kecil di langkahmu itu menjadi kobaran api yang membara!"
      Speaker = "Hestia"
      Event = "HestiaChat02"
    }
    {
      Id = "Hestia_0005"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita buat api unggun kecil yang nyaman, lalu lemparkan semua musuh kita ke dalamnya?"
      Speaker = "Hestia"
      Event = "HestiaChat03"
    }
    {
      Id = "Hestia_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kelihatannya malam yang sangat panas menanti kita di depan sana!"
      Speaker = "Hestia"
      Event = "HestiaChat04"
    }
    {
      Id = "Hestia_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya bakal tertutup jelaga begitu kita selesai!"
      Speaker = "Hestia"
      Event = "HestiaChat05"
    }
    {
      Id = "Hestia_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan biarkan api di dalam hatimu padam, paham?"
      Speaker = "Hestia"
      Event = "HestiaChat06"
    }
    {
      Id = "Hestia_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hoh{#Prev}, mari kita lihat dan buat dirimu bersemangat dan berkobar lagi, Sayang!"
      Speaker = "Hestia"
      Event = "HestiaChat07"
    }
    {
      Id = "Hestia_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, Gadis Berapi! Kita naikkan suhunya sampai membara kalau begitu!"
      Speaker = "Hestia"
      Event = "HestiaChat08"
    }
    {
      Id = "Hestia_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah terlalu lama kita tidak menghanguskan barang-barang bersama-sama, bukan?"
      Speaker = "Hestia"
      Event = "HestiaChat09"
    }
    {
      Id = "Hestia_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkadang, kau hanya perlu {#Emph}membakar {#Prev}rata segalanya dengan tanah dan mulai dari nol lagi, Gadis Berapi."
      Speaker = "Hestia"
      Event = "HestiaChat10"
    }
    {
      Id = "Hestia_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu segalanya memang sedang kacau, tapi rahasia sesama wanita saja ya, aku sudah lama tidak merasa sehidup ini!"
      Speaker = "Hestia"
      Event = "HestiaChat11"
    }
    {
      Id = "Hestia_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kata orang jangan pernah bermain api, Sayang. Tapi kuizinkan kau untuk {#Emph}langsung {#Prev}melakukannya!"
      Speaker = "Hestia"
      Event = "HestiaChat12"
    }
    {
      Id = "Hestia_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saatnya menyetel panasnya sampai maksimal, bukan begitu, Sayang?"
      Speaker = "Hestia"
      Event = "HestiaChat13"
    }
    {
      Id = "Hestia_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sedikit pemanasan lagi untukmu di sini, Gadis Berapi!"
      Speaker = "Hestia"
      Event = "HestiaChat14"
    }
    {
      Id = "Hestia_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti dingin sekali di tempatmu sana... tapi takkan lama lagi!"
      Speaker = "Hestia"
      Event = "HestiaChat15"
    }
    {
      Id = "Hestia_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku kembali lagi, Sayang, jadi hangatkan dirimu karena kita akan bersenang-senang sampai segalanya {#Emph}meledak!"
      Speaker = "Hestia"
      Event = "HestiaChat16"
    }
    {
      Id = "Hestia_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Api tua ini takkan pernah bisa padam, dan jangan pernah lupakan itu, Sayang!"
      Speaker = "Hestia"
      Event = "HestiaChat17"
    }
    {
      Id = "Hestia_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, andai saja aku bisa memanggang lebih banyak musuh keparat itu sendiri!"
      Speaker = "Hestia"
      Event = "HestiaChat18"
    }
    {
      Id = "Hestia_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salam terhangat untukmu, Sayang, dan sedikit hadiah tambahan di sampingnya!"
      Speaker = "Hestia"
      Event = "HestiaChat19"
    }
    {
      Id = "Hestia_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Suatu malam nanti, mungkin kau akan menetap dan menjalani hidup yang nyaman, tapi {#Emph}ohh{#Prev}, bukan malam ini!"
      Speaker = "Hestia"
      Event = "HestiaChat20"
    }
    {
      Id = "Hestia_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pengorbanan terkadang memang harus dilakukan, Sayang. Jadi kumpulkan mereka dan serahkan pada kobaran api!"
      Speaker = "Hestia"
      Event = "HestiaChat21"
    }
    {
      Id = "Hestia_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini kita akan melalui sesuatu yang {#Emph}sangat panas{#Prev}, oh, aku sudah bisa merasakannya!"
      Speaker = "Hestia"
      Event = "HestiaChat22"
    }
    {
      Id = "Hestia_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah membara panas bahkan tanpa bantuanku, tapi {#Emph}dengan {#Prev}bantuanku, {#Emph}oh, ho-ho-ho!"
      Speaker = "Hestia"
      Event = "HestiaChat23"
    }
    {
      Id = "Hestia_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa yang sedang kita masak malam ini, Sayang? Apa pun yang kita mau, itu sudah jelas!"
      Speaker = "Hestia"
      Event = "HestiaChat24"
    }
    {
      Id = "Hestia_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, kurasa sekarang saatnya mengipasi apinya sedikit, bukan begitu?"
      Speaker = "Hestia"
      Event = "HestiaChat25"
    }
    {
      Id = "Hestia_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah memasak sesuatu yang istimewa khusus untuk{#Emph}mu{#Prev}, Gadis Berapi!"
      Speaker = "Hestia"
      Event = "HestiaChat26"
    }
    {
      Id = "Hestia_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah ada sesuatu yang terbakar di sana, Sayang? Yah, sebentar lagi pasti ada!"
      Speaker = "Hestia"
      Event = "HestiaChat27"
    }
    {
      Id = "Hestia_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mari kita jaga api abadi itu tetap hidup dan menyala, bagaimana menurutmu, Gadis Berapi?"
      Speaker = "Hestia"
      Event = "HestiaChat28"
    }
    {
      Id = "Hestia_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setidaknya kita hidup di masa-masa yang seru, harus kuakui itu!"
      Speaker = "Hestia"
      Event = "HestiaChat29"
    }
    {
      Id = "Hestia_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita tambahkan sedikit minyak ke dalam api yang sedang berkobar ini, ayolah?"
      Speaker = "Hestia"
      Event = "HestiaChat30"
    }
    {
      Id = "Hestia_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau manusia fana saja tak bisa bersantai dengan nyaman, maka menurutku, {#Emph}tak ada {#Prev}yang boleh!"
      Speaker = "Hestia"
      Event = "HestiaChat31"
    }
    {
      Id = "Hestia_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita sebenarnya bisa duduk santai di dekat perapian sambil menyesap Nektar atau semacamnya, tapi {#Emph}malah begini!"
      Speaker = "Hestia"
      Event = "HestiaChat32"
    }
    {
      Id = "Hestia_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau selalu berpakaian pas untuk suhu hangat karena tahu betul Bibi Buyutmu ini takkan jauh-jauh!"
      Speaker = "Hestia"
      Event = "HestiaChat33"
    }
    {
      Id = "Hestia_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saatnya kita mulai membakar lagi, Nona Manis, selagi malam masih panjang dan segalanya!"
      Speaker = "Hestia"
      Event = "HestiaChat34"
    }
    {
      Id = "Hestia_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana kalau kita terangi malam ini, Sayang, pakai kayu bakar apa pun yang ada di dekat kita?"
      Speaker = "Hestia"
      Event = "HestiaChat35"
    }
    {
      Id = "Hestia_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah banyak sekali hal buruk yang kulihat sepanjang hidupku, tapi semua kekacauan akhir-akhir ini, harus kuakui ini agak baru bagiku!"
      Speaker = "Hestia"
      Event = "HestiaChat36"
    }
    {
      Id = "Hestia_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan pernah biarkan api di dalam jiwamu padam, Sayang, tapi jangan biarkan membakar terlalu panas juga!"
      Speaker = "Hestia"
      Event = "HestiaChat37"
    }
    {
      Id = "Hestia_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan biarkan semua ini membebanimu karena badai ini pasti segera berlalu, ya selalu begitu."
      Speaker = "Hestia"
      Event = "HestiaChat38"
    }
    {
      Id = "Hestia_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saatnya membiarkan percikan api beterbangan lagi, {#Emph}ya? Oh, {#Prev}aku siap kapan pun kau siap!"
      Speaker = "Hestia"
      Event = "HestiaChat39"
    }
    {
      Id = "Hestia_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pergi ke puncak tertinggi gunung kita lagi? Kalau begitu ayo kita pastikan kau takkan masuk angin."
      Speaker = "Hestia"
      Event = "HestiaChat40"
    }
    {
      Id = "Hestia_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau mereka mau aku tak ikut campur, harusnya mereka tak mengusik rumah kami!"
      Speaker = "Hestia"
      Event = "HestiaChat41"
    }
    {
      Id = "Hestia_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tetap tinggal di bawah tanah bukan ide yang buruk! Kau sepertinya lebih baik hidup di bawah sana."
      Speaker = "Hestia"
      Event = "HestiaChat42"
    }
    {
      Id = "Hestia_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menjejalkan Berkahku ke dalam karung kumal tanpa tanda, sungguh {#Emph}keterlaluan! {#Prev}Aku agak heran karungnya tak terbakar tembus. Terkadang memang tak mudah menghubungimu, tahu!"
      Speaker = "Hestia"
      Event = "HestiaBlindBox01"
    }
    {
      Id = "Hestia_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti sudah bisa menebak ini Berkahku dari semua hawa panas yang mengepul dari bungkusan itu! Ajaib juga bungkusannya tak langsung hangus terbakar!"
      Speaker = "Hestia"
      Event = "HestiaBlindBox02"
    }
    {
      Id = "Hestia_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti punya koin emas berlebih yang disebarkan Chronos ke penjuru negeri. Pasti untuk menggoda manusia fana yang paling serakah! Atau yang paling miskin. Tapi bukan urusanku untuk menghakimi!"
      Speaker = "Hestia"
      Event = "HestiaLootBought01"
    }
    {
      Id = "Hestia_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tukang Perahu itu pintar menyampaikan pesan, kan? Mirip seperti mengangkut jasad-jasad ke Dunia Bawah zaman dulu. {#Emph}Yah{#Prev}, tak banyak yang bisa diperbuat untuk mereka akhir-akhir ini... selain di-{#Emph}bakar!"
      Speaker = "Hestia"
      Event = "HestiaLootBought02"
    }
    {
      Id = "Hestia_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau benar-benar harus membayar si Charon itu dalam situasi seperti ini! Aturan konyol macam {#Emph}apa {#Prev}itu? Apa, tak ada berkah untuk orang miskin? Sama sekali tak adil."
      Speaker = "Hestia"
      Event = "HestiaLootBought03"
    }
    {
      Id = "Hestia_0124"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berkahku berhasil menempuh jalan sejauh itu hanya di atas perahu feri kayu yang reyot? Pasti banyak sekali bahaya kebakaran di sana, meski ada banyak air di dekatnya untuk memadamkannya."
      Speaker = "Hestia"
      Event = "HestiaLootBought04"
    }
    {
      Id = "Hestia_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa, tukang perahu itu sedang cuci gudang banting harga? Aku tak mau kau membayar terlalu mahal! Lagipula berkah memang tak semestinya diberi harga."
      Speaker = "Hestia"
      Event = "HestiaLootBought05"
    }
    {
      Id = "Hestia_0125"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa si tua Hecate tak mengajarimu untuk menghormati orang tua sedikit lebih baik dari {#Emph}itu? {#Prev}Nah, ini dia pelajaran kilat untukmu!"
      Speaker = "Hestia"
      Event = "HestiaRejection01"
    }
    {
      Id = "Hestia_0126"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak baik kalau yang lain mengira Hestia tua ini gampang ditindas dalam urusan seperti ini. Jadi terpaksa kubuat kau agak terpanggang!"
      Speaker = "Hestia"
      Event = "HestiaRejection02"
    }
    {
      Id = "Hestia_0127"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak mau berkahku selagi masih panas-panasnya, ya? Kalau begitu {#Emph}ini {#Prev}bisa menghangatkanmu untuk sementara."
      Speaker = "Hestia"
      Event = "HestiaRejection03"
    }
    {
      Id = "Hestia_0128"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak benar-benar marah padamu, Sayang! Tapi aku lagi tak punya tenaga sekarang untuk menentang tradisi konyol kita ini."
      Speaker = "Hestia"
      Event = "HestiaRejection04"
    }
    {
      Id = "Hestia_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Yah{#Prev}, luka bakar mantap seperti tadi pantas dibalas serupa. Cukup adil kan, Nona Manis?"
      Speaker = "Hestia"
      Event = "HestiaRejection05"
    }
    {
      Id = "Hestia_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lihatlah betapa {#Emph}saling ribut{#Prev} dan mengenaskannya kita sekarang! Tapi kita semua harus ikut berjuang, kan?"
      Speaker = "Hestia"
      Event = "HestiaRejection06"
    }
    {
      Id = "Hestia_0131"
      InheritFrom = "BaseNarrative"
      DisplayName = "Padahal aku berniat mengulurkan bantuan, tapi {#Emph}malah begini! {#Prev}Selalu saja ada yang menghalangiku. Pokoknya aku {#Emph}tak sudi!"
      Speaker = "Hestia"
      Event = "HestiaRejection07"
    }
    {
      Id = "Hestia_0132"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo dong, manusia fana saja tahu kalau yang terbaik itu menghormati Hestia tua tercinta lebih dulu dalam urusan semacam ini!"
      Speaker = "Hestia"
      Event = "HestiaRejection08"
    }
    {
      Id = "Hestia_0133"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menolak Berkah Hestia, ya? Nah, bagaimana kalau kuingatkan sedikit cara memberi persembahan yang benar!"
      Speaker = "Hestia"
      Event = "HestiaRejection09"
    }
    {
      Id = "Hestia_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mencoba sekuat tenaga pun, aku tak bisa menahan rasa kesal ini! Dan aku bukanlah tipe orang yang membiarkannya berlalu begitu saja..."
      Speaker = "Hestia"
      Event = "HestiaRejection10"
    }
    {
      Id = "Hestia_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berani-beraninya kau lebih memilih salah satu adik perempuanku daripada diriku, {#Emph}hah?"
      Speaker = "Hestia"
      Event = "HestiaRejection11"
    }
    {
      Id = "Hestia_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pikir langkahmu aman, tapi ternyata tidak. Aku sudah muak disisihkan terus!"
      Speaker = "Hestia"
      Event = "HestiaRejection12"
    }
    {
      Id = "Hestia_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu tadi yang kusebut luka bakar tingkat {#Emph}satu{#Prev}. Anggap saja kau kulepaskan dengan peringatan {#Emph}kecil!"
      Speaker = "Hestia"
      Event = "HestiaMakeUp01"
    }
    {
      Id = "Hestia_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku menyukaimu, Sayang. Jadi aku takkan mengubahmu menjadi abu kali {#Emph}ini{#Prev}. Tapi untuk lain kali, tak ada jaminan."
      Speaker = "Hestia"
      Event = "HestiaMakeUp02"
    }
    {
      Id = "Hestia_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kena jewer juga kan pergelangan tanganmu! Mungkin sebaiknya kau siram pakai air dingin yang segar."
      Speaker = "Hestia"
      Event = "HestiaMakeUp03"
    }
    {
      Id = "Hestia_0138"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Yah{#Prev}, kau baik-baik saja, dan {#Emph}aku {#Prev}sekarang juga baik-baik saja, jadi kurasa {#Emph}semuanya {#Prev}sudah beres."
      Speaker = "Hestia"
      Event = "HestiaMakeUp04"
    }
    {
      Id = "Hestia_0139"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudahlah, tak perlu terlalu lama panas hati gara-gara hal sepele begini. Ayo kita lanjut saja!"
      Speaker = "Hestia"
      Event = "HestiaMakeUp05"
    }
    {
      Id = "Hestia_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tadi aku sempat agak naik darah, tapi sekarang sudah kembali ke diriku yang gampang sewot seperti biasa, terima kasih banyak!"
      Speaker = "Hestia"
      Event = "HestiaMakeUp06"
    }
    {
      Id = "Hestia_0141"
      InheritFrom = "BaseNarrative"
      DisplayName = "Nah, mulai lagi, kan! Kau tahu tidak, orang-orang di sini menganggapku yang paling tenang dan cinta damai?"
      Speaker = "Hestia"
      Event = "HestiaMakeUp07"
    }
    {
      Id = "Hestia_0142"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bermain api, ya bakal terbakar! Sesederhana itu aturannya, kecuali kalau aku berkehendak lain."
      Speaker = "Hestia"
      Event = "HestiaMakeUp08"
    }
    {
      Id = "Hestia_0143"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah, baiklah, mari kita dinginkan kepala sebentar sebelum api-apiku ini jadi {#Emph}benar-benar {#Prev}tak terkendali..."
      Speaker = "Hestia"
      Event = "HestiaMakeUp09"
    }
    {
      Id = "Hestia_0144"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku suka gadis yang tahu cara membalas omongan! Jangan pernah biarkan siapa pun di atas sini menindasmu."
      Speaker = "Hestia"
      Event = "HestiaMakeUp10"
    }
    {
      Id = "Hestia_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah, mari kita turunkan suhunya sedikit kalau kita sudah selesai bertengkar untuk sekarang."
      Speaker = "Hestia"
      Event = "HestiaMakeUp11"
    }
    {
      Id = "Hestia_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dulu aku tidak segampang ini marah, Sayang, jadi ternyata aku belum terlalu tua untuk belajar hal baru!"
      Speaker = "Hestia"
      Event = "HestiaMakeUp12"
    }
    {
      Id = "Melinoe_0951"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi Hestia yang mulia, kuharap Anda sudi menerima persembahan ini. Suatu kehormatan bisa mengenal seseorang dengan kehangatan, kebijaksanaan, dan kekuatan seperti Anda."
      Speaker = "Melinoe"
      Event = "HestiaGift01"
    }
    {
      Id = "Hestia_0068"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, lihat dirimu, memberiku persembahan! Keramahan yang luar biasa, dan meski sebagian besar adat istiadat ingin kulempar saja ke perapian, tradisi saling bertukar hadiah ini tidak terlalu kubenci. Jadi ini, ada sesuatu dariku."
      Speaker = "Hestia"
      Event = "HestiaGift01"
    }
    {
      Id = "Melinoe_0952"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terimalah ini, Bibi Buyut Hestia! Dukungan penuh kemurahan hati darimu sangat berarti bagiku. Aku tahu ada begitu banyak hal yang bisa kupelajari darimu."
      Speaker = "Melinoe"
      Event = "HestiaGift02"
    }
    {
      Id = "Hestia_0069"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayolah, tak banyak yang bisa kuajarkan. Lagipula kau kelihatannya sama penyendirinya denganku, meski kau masih jauh lebih sedap dipandang. Tapi senang sekali bisa berkenalan denganmu."
      Speaker = "Hestia"
      Event = "HestiaGift02"
    }
    {
      Id = "Melinoe_0953"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hestia yang agung, dewi perapian dan api! Semoga percikan apimu selalu berkobar terang. Anda sudah banyak sekali membantuku dalam perjalanan ini!"
      Speaker = "Melinoe"
      Event = "HestiaGift03"
    }
    {
      Id = "Hestia_0070"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aduh, terima kasih banyak untuk itu, Sayang, kau baik sekali. Para manusia fana dulu begitu yakin kalau aku cuma suka sesajen {#Emph}gosong{#Prev}, mereka tak pernah memberiku barang bagus seperti ini."
      Speaker = "Hestia"
      Event = "HestiaGift03"
    }
    {
      Id = "MelinoeField_2244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Penghormatan untuk Yang Mulia Hestia tercinta! Kobaran apimu adalah lentera penuntun, sekaligus petaka bagi semua musuh kita. Namun kebijaksanaan tajam dan semangat membara darimulah yang paling memacuku untuk maju!"
      Speaker = "Melinoe"
      Event = "HestiaGift04"
    }
    {
      Id = "Hestia_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak ada gunanya menjilatku, kau tahu sendiri. Apa, kau pikir aku bakal menahan berkah terbaikku kalau kau tidak melontarkan pujian manis? Aku memang bisa kekanak-kanakan, tentu saja, tapi tidak {#Emph}sepicik {#Prev}itu!"
      Speaker = "Hestia"
      Event = "HestiaGift04"
    }
    {
      Id = "MelinoeField_2245"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bila aku boleh menerima Berkah darimu lagi, Bibi Buyut, kumohon terimalah persembahan Nektar lainnya dariku! Caramu membawa diri dengan begitu santai sangat menginspirasiku. Jika kelak aku bisa menjadi lebih sepertimu beberapa masa lagi, aku akan merasa sangat beruntung."
      Speaker = "Melinoe"
      Event = "HestiaGift05"
    }
    {
      Id = "Hestia_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mau jadi seperti {#Emph}aku? {#Prev}Wah, baru {#Emph}kali ini {#Prev}ada yang bilang begitu! Apa pun rela kuberikan demi memutar balik waktu dan mengulang kembali semuanya dari awal, berbekal pengetahuanku yang sekarang. Tapi kalau dipikir-pikir, bukankah rencana kita memang mau membalikkan Sang Waktu?"
      Speaker = "Hestia"
      Event = "HestiaGift05"
    }
    {
      Id = "MelinoeField_2246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bibi Buyut Hestia! Semakin lama aku semakin bertanya-tanya, bagaimana jadinya bila kau selalu ada dalam hidupku sejak dulu. Mungkinkah aku akan tumbuh dengan pikiran yang lebih cerdik? Atau lebih bahagia! Semoga kita masih bisa saling mengenal layaknya kita sudah saling kenal sejak dulu!"
      Speaker = "Melinoe"
      Event = "HestiaGift06"
    }
    {
      Id = "Hestia_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak pernah ingin punya anak, kau tahu itu, Sayang. Dan kau tak akan bisa membuatku ragu atas apa yang kemungkinan besar merupakan keputusan terpintar dalam hidupku, apalagi setelah caramu mengomel begitu padaku barusan! Sekarang {#Emph}ambil {#Prev}Berkah sialanmu ini dan lekaslah pergi!"
      Speaker = "Hestia"
      Event = "HestiaGift06"
    }
    {
      Id = "MelinoeField_4346"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti Andalah yang menginspirasiku untuk menciptakan rumah yang hangat dan penuh kebahagiaan, Bibi Buyut! Sebagai gantinya, Ambrosia ini adalah untuk dinikmati bersama semua orang yang membuat rumahmu terasa aman dan nyaman, persis seperti yang kurasakan setiap kali Anda memanggil."
      Speaker = "Melinoe"
      Event = "HestiaGift07"
    }
    {
      Id = "Hestia_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Aduh{#Prev}, ini manis sekali darimu, Sayang, dan kau memang benar! Begitu banyak orang ingin terkenal atau sukses dan semacamnya, tapi merasa aman dan nyaman? Tak ada yang bisa mengalahkan itu, dan aku tahu kau memahaminya. {#Emph}Semoga kau selalu merasakannya."
      Speaker = "Hestia"
      Event = "HestiaGift07"
    }
    {
      Id = "Melinoe_1737"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sesuatu dari Bibi Buyut Hestia..."
      Speaker = "Melinoe"
      Event = "HestiaUpgrade.GiftGivenVoiceLines"
    }
    {
      Id = "Hestia_0078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagaimana kalau kita naikkan suhunya?!"
      Speaker = "Hestia"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hestia_0079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka bakal hangus!"
      Speaker = "Hestia"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hestia_0080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar api melahap mereka semua!"
      Speaker = "Hestia"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hestia_0268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo hangatkan diri, semuanya!"
      Speaker = "Hestia"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hestia_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini sedikit pemanasan untuk kalian!"
      Speaker = "Hestia"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hestia_0270"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, {#Emph}sekarang {#Prev}baru mantap membara!"
      Speaker = "Hestia"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hestia_0271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, {#Emph}sekarang {#Prev}kau mau bersikap manis?"
      Speaker = "Hestia"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hestia_0272"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sedang bermain api, Sayang!"
      Speaker = "Hestia"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hestia_0273"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hangus yang mantap, Cantik!"
      Speaker = "Hestia"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sampai repot-repot membangkitkan si tua {#Emph}Hestia!"
      Speaker = "Chronos"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Chronos_1268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rupanya hawa di sini jadi agak panas...!"
      Speaker = "Chronos"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zagreus_0366"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dewi Hestia?!"
      Speaker = "Zagreus"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Zagreus_0367"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hestia, jangan...!"
      Speaker = "Zagreus"
      Event = "HestiaUpgrade.FullSuperActivatedVoiceLines"
    }
    {
      Id = "Hestia_0100"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku paling tidak suka kelakuan seperti itu."
      Speaker = "Hestia"
      Event = "HestiaUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Hestia_0101"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Coba-coba main denganku, kau bakal hangus terbakar."
      Speaker = "Hestia"
      Event = "HestiaUpgrade.DeathTauntVoiceLines"
    }
    {
      Id = "Hestia_0099"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pikir aku ini siapa?"
