{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _NPCData_Selene.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Selene_0108"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ah, bintang kecilku! Selama fase seperti ini, aku tak terlihat di langit malam, dan bisa menikmati istirahat sejenak. Jadi mari kita berbincang sedikit lebih lama, meski aku khawatir bicara terlalu banyak mulai menguras cahayaku. Bagaimana perkembangan tugasmu?"
      Speaker = "Selene"
      Event = "SeleneHome01"
    }
    {
      Id = "Melinoe_0488"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selene yang Agung, suatu kehormatan bagiku atas kehadiranmu di sini. Kurasa tugas ini berjalan sesuai rencana, walau seperti yang kau tahu, masih banyak yang harus kami selesaikan. Aku bersyukur kau terus mengawasiku."
      Speaker = "Melinoe"
      Event = "SeleneHome01"
    }
    {
      Id = "Selene_0109"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku pun bersyukur atas kesempatan ini. Akulah sang Mata Malam, tapi kau, kurasa telah menjadi pedang terhunusnya. Sampai kita bertemu lagi di bawah selubung kegelapannya."
      Speaker = "Selene"
      Event = "SeleneHome01"
    }
    {
      Id = "Melinoe_0489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa nanti."
      Speaker = "Melinoe"
      Event = "SeleneHome01"
    }
    {
      Id = "Selene_0106"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihatmu, Hecate. Aku melihat kebuntuan di Olympus masih berlanjut, meski sang Titan Chronos masih terus mengumpulkan pasukan di Ephyra. Haruskah aku terus mengawasi mereka?"
      Speaker = "Selene"
      Event = "SeleneWithHecate01"
    }
    {
      Id = "Hecate_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, Selene, lakukanlah. Ephyra terkutuk itu adalah jalan keluar terdekat dari sini. Menurutmu, apa mereka siap menghadapi penyusup tunggal yang menerobos barisan mereka?"
      Speaker = "Hecate"
      Event = "SeleneWithHecate01"
    }
    {
      Id = "Selene_0107"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasukan sang Titan agak kacau balau. Jadi tidak, kurasa mereka sama sekali tidak siap menghadapi salah satu dari kita. Namun aku akan terus mengawasi untuk memastikannya. Sekarang aku harus undur diri. Bersama kita bersinar."
      Speaker = "Selene"
      Event = "SeleneWithHecate01"
    }
    {
      Id = "Hecate_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa. Bersama kita bersinar."
      Speaker = "Hecate"
      Event = "SeleneWithHecate01"
    }
    {
      Id = "Selene_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah kembali untuk beristirahat di kediaman yang gelap dan aman ini. Dan tak lama lagi, aku akan melesat kembali."
      Speaker = "Selene"
      Event = "SeleneHomeRepeatable01"
    }
    {
      Id = "Selene_0324"
      InheritFrom = "BaseNarrative"
      DisplayName = "Siklus kita akan segera dimulai kembali, tapi untuk saat ini, aku harus beristirahat."
      Speaker = "Selene"
      Event = "SeleneHomeRepeatable02"
    }
    {
      Id = "Selene_0325"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kekuatan kita takkan pernah mencapai puncaknya jika kita tidak membiarkan diri kita beristirahat."
      Speaker = "Selene"
      Event = "SeleneHomeRepeatable03"
    }
    {
      Id = "Selene_0326"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu siklus telah selesai, kini saatnya merenung dan mempersiapkan diri untuk siklus berikutnya."
      Speaker = "Selene"
      Event = "SeleneHomeRepeatable04"
    }
    {
      Id = "Selene_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di Persimpangan Jalan ini, kekuatanku pulih dengan cepat, dan sebentar lagi aku akan kembali membubung tinggi."
      Speaker = "Selene"
      Event = "SeleneHomeRepeatable05"
    }
    {
      Id = "Nyx_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Mata Malamku yang setia, anakku, terima kasih telah memastikan alam kita tetap aman, dan terus mengawasinya dari atas sana. Aku tak pernah meragukan kesetiaanmu."
      Speaker = "Nyx"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Selene_0372"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi Ibu, andai pengawasan kami lebih cermat, semua ini pasti takkan terjadi..."
      Speaker = "Selene"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Nyx_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa-masa sulit akan selalu datang untuk menguji tekad kita. Dari sanalah kita tumbuh semakin kuat, begitu pula ikatan yang kita jalin. Bahkan saat ini pun, aku bisa merasakan hubungan yang kuat antara dirimu dan sang Putri Dunia Bawah."
      Speaker = "Nyx"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "MelinoeField_5170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Merupakan kehormatan bagiku bisa bekerja sama dengan Saudari Selene, wahai Nyx. Beliau selalu menjadi cahaya penuntunku. Aku sangat bahagia kalian berdua akhirnya bisa bertemu lagi."
      Speaker = "Melinoe"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Nyx_0123"
      InheritFrom = "BaseNarrative"
      DisplayName = "Reuni yang kau wujudkan bersama Hecate dan Kaum Tak Kasat Mata. Jasamu akan selalu dikenang, wahai Putri Melinoë. Sekarang pergilah... masih banyak reuni lain yang menantimu."
      Speaker = "Nyx"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Selene_0373"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Ibu, dan pamit undur diri untuk sekarang."
      Speaker = "Selene"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Nyx_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masa-masa sulit akan selalu datang. Sekarang pergilah, dan setiap kali kau melintasi gelapnya langit malam, ingatlah bahwa aku selalu ada di sana."
      Speaker = "Nyx"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "MelinoeField_5171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, aku tak pernah menyangka kita bisa membawamu turun sejauh ini, Saudari Selene. Kupikir bahkan Kepala Sekolah pun takkan sanggup melakukannya dengan segala pengalamannya!"
      Speaker = "Melinoe"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Selene_0374"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika kau sudah siap, bintang kecilku, mari kita pergi, jangan sampai kita terlalu lama bertegur sapa dan berpamitan. Aku merasa terhormat telah melihat aula-aula ini, dan kembali ke dalam bayang-bayang bersamamu malam ini dalam kemenangan, bukan ketergesaan."
      Speaker = "Selene"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "HecateField_0327"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayo, Melinoë, atas semua alasan yang dikatakan Selene. Selain itu, ada hal penting yang harus kita antarkan."
      Speaker = "Hecate"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "MelinoeField_3903"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}<Helaan napas> {#Prev}Kalau begitu ayo berangkat. Andai saja Artemis ada di sini, ini bisa jadi ajang reuni Saudari Perak yang sesungguhnya, bukan?"
      Speaker = "Melinoe"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Selene_0377"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita melesat menembus kegelapan di atas sana."
      Speaker = "Selene"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Selene_0378"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Dan berpeganganlah erat-erat saat kita berangkat."
      Speaker = "Selene"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Nyx_0034"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa."
      Speaker = "Nyx"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Persephone_0013"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa!!"
      Speaker = "Persephone"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Zagreus_0088"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa!"
      Speaker = "Zagreus"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Hades_0214_C"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat jalan, Putriku."
      Speaker = "Hades"
      Event = "SeleneTrueEnding01"
    }
    {
      Id = "Melinoe_1881"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga cahayamu tak pernah memudar."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Melinoe_1882"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cahaya bulan menu— {#Emph}ugh. {#Prev}Maaf. Kebiasaan."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0233"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Takkan pernah."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0234"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hmm."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0235"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selalu."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0236"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam hangat."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0237"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga kegelapan memandu langkahmu."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0238"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Untuk selama-lamanya."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku berutang budi."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0486"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kematian bagi Chronos."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0487"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Teruslah bersinar."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0488"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Demi Saudari Perak."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebagai gantinya, terimalah berkatku."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneSaluteLines"
    }
    {
      Id = "Selene_0383"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sainganmu telah tumbang."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneVictoryVoiceLines"
    }
    {
      Id = "Selene_0384"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu lagi saingan berhasil kau atasi."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneVictoryVoiceLines"
    }
    {
      Id = "Selene_0385"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sainganmu tak berdaya menghadapimu."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneVictoryVoiceLines"
    }
    {
      Id = "Selene_0386"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saingan terbesarmu, ditaklukkan malam ini."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneVictoryVoiceLines"
    }
    {
      Id = "Selene_0387"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku menjadi saksi atas jatuhnya sainganmu."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneVictoryVoiceLines"
    }
    {
      Id = "Selene_0310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekutu yang menjanjikan."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneExorcismReactionVoiceLines"
    }
    {
      Id = "Selene_0311"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu lagi bergabung ke barisan kita."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneExorcismReactionVoiceLines"
    }
    {
      Id = "Selene_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus sekali."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneExorcismReactionVoiceLines"
    }
    {
      Id = "Selene_0313"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu jiwa tak lagi tersesat."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneExorcismReactionVoiceLines"
    }
    {
      Id = "Selene_0314"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedamaian bagi yang telah tiada..."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneExorcismReactionVoiceLines"
    }
    {
      Id = "Selene_0315"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedamaian abadi..."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneExorcismReactionVoiceLines"
    }
    {
      Id = "Selene_0316"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menuju peristirahatan kita..."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneExorcismReactionVoiceLines"
    }
    {
      Id = "Selene_0317"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kebebasan dalam kematian."
      Speaker = "Selene"
      Event = "GlobalVoiceLines.SeleneExorcismReactionVoiceLines"
    }
