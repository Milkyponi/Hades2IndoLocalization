    }
    {
      Id = "MelinoeField_2572"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebuah kehormatan, Yang Mulia."
      Speaker = "Melinoe"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "MelinoeField_2573"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jayalah Olympus!"
      Speaker = "Melinoe"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam."
      Speaker = "Athena"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Senang bertemu denganmu!"
      Speaker = "Athena"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kematian, atau yang lebih buruk."
      Speaker = "Athena"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Petunjuk yang tepat."
      Speaker = "Athena"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku menentukan jalanku sendiri."
      Speaker = "Athena"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0130"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akulah yang memberi arahan di sini."
      Speaker = "Athena"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0131"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika kau memaksa."
      Speaker = "Athena"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan menumpas musuh-musuh kita."
      Speaker = "Athena"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita tahu jalannya."
      Speaker = "Athena"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Menuju kemenangan."
      Speaker = "Athena"
      Event = "NPC_Athena_01.InteractVoiceLines"
    }
    {
      Id = "Athena_0002"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Putri Kematian yang mulia, akhirnya! Aku sepupumu, Athena, dan bangga bisa menyambutmu di Olympus. Tapi rasa bangga ini bercampur getir, karena tempat ini dulunya tidak semenyedihkan sekarang."
      Speaker = "Athena"
      Event = "AthenaFirstMeeting"
    }
    {
      Id = "MelinoeField_2401"
      InheritFrom = "BaseNarrative"
      DisplayName = "Salam, Lady Athena, senang bertemu denganmu! Panggil saja aku Melinoë. Ke mana amarahku harus diarahkan, agar benteng gunungmu ini bisa kita bebaskan dan kejayaannya kembali pulih?"
      Speaker = "Melinoe"
      Event = "AthenaFirstMeeting"
    }
    {
      Id = "Athena_0003"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang bertemu denganmu juga, Melinoë. Pasukan Titan keparat itu telah menyusup ke tempat paling suci kami. Kepada merekalah amarahmu pantas dilampiaskan; terutama saat kau mendaki menuju puncak, tempat sebagian besar keluarga kita kini berlindung."
      Speaker = "Athena"
      Event = "AthenaFirstMeeting"
    }
    {
      Id = "MelinoeField_2402"
      InheritFrom = "BaseNarrative"
      DisplayName = "Istana Zeus. Lalu bagaimana denganmu, mengapa yang lain tidak bertarung di sisimu di sini?"
      Speaker = "Melinoe"
      Event = "AthenaFirstMeeting"
    }
    {
      Id = "Athena_0004"
      InheritFrom = "BaseNarrative"
      DisplayName = "Karena justru itulah yang dituntut oleh strategi kita, bukankah mereka juga telah membantumu sampai ke mari? Sekarang, mari kita berpencar ke jalan masing-masing, dan semoga berkatku membantumu mendaki."
      Speaker = "Athena"
      Event = "AthenaFirstMeeting"
    }
    {
      Id = "Athena_0158"
      InheritFrom = "BaseNarrative"
      DisplayName = "Waspadalah di depan sana. Titan Prometheus berhasil menghindariku, karena dia tahu perhatianku tersita pada pasukan garda depannya. Namun dia tak punya pilihan selain menghadapimu jika kau terus mendesak maju."
      Speaker = "Athena"
      Event = "AthenaAboutPrometheus01"
    }
    {
      Id = "MelinoeField_2403"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia sang Titan Penglihatan Masa Depan. Dia tahu persis apa yang kita rencanakan, bukan? Dan bisa membalasnya dengan tepat."
      Speaker = "Melinoe"
      Event = "AthenaAboutPrometheus01"
    }
    {
      Id = "Athena_0159"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sampai batas tertentu dia memang tahu apa yang akan terjadi, ya. Namun dia hanya bisa melihat kemungkinan hasil akhir, bukan membaca pikiran. Dan hanya karena dia tahu kau akan datang, bukan berarti dia bisa menghentikanmu."
      Speaker = "Athena"
      Event = "AthenaAboutPrometheus01"
    }
    {
      Id = "MelinoeField_2405"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pernahkah kau berhadapan langsung dengan Prometheus sebelumnya? Tadi kau bilang dia berhasil menghindarimu. Mungkin dia tahu takkan punya peluang menang jika bertarung melawanmu."
      Speaker = "Melinoe"
      Event = "AthenaAboutPrometheus02"
    }
    {
      Id = "Athena_0162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah mengenal Prometheus sebelum semua ini terjadi. Kurasa ketertarikan kami pada hal-hal yang berkaitan dengan akal pikiranlah yang menghubungkan kami. Kau tahu dia mencuri anugerah api untuk umat manusia. Yah... dia juga memberi mereka akal budi, dariku. Yah, setidaknya pada sebagian dari mereka."
      Speaker = "Athena"
      Event = "AthenaAboutPrometheus02"
    }
    {
      Id = "MelinoeField_2406"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bergidik membayangkan seperti apa manusia sebelum mereka punya akal budi. Meski mungkin Prometheus seharusnya menyisakan sedikit akal budi itu untuk dirinya sendiri."
      Speaker = "Melinoe"
      Event = "AthenaAboutPrometheus02"
    }
    {
      Id = "Athena_0163"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin dia merasa sudah melakukannya, atau merasa sudah punya sebanyak yang dia butuhkan. Sayangnya, akal budi cenderung jauh lebih langka daripada yang berani diakui oleh kebanyakan pihak."
      Speaker = "Athena"
      Event = "AthenaAboutPrometheus02"
    }
    {
      Id = "Athena_0160"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahkan jika langkahmu dihalangi oleh sang Titan Prometheus, itu tetap menguntungkan upaya perang kita. Karena jika dia harus berhadapan denganmu, dia tak akan bisa membuat kekacauan di tempat lain."
      Speaker = "Athena"
      Event = "AthenaAboutPrometheusL01"
    }
    {
      Id = "MelinoeField_2404"
      InheritFrom = "BaseNarrative"
      DisplayName = "Hal itu bukan penghiburan besar bagiku, Yang Mulia Athena. Ini bukan kejahatan pertamanya terhadap Olympus dan keluarga kita; karena itu hukumannya nanti harus jauh lebih berat."
      Speaker = "Melinoe"
      Event = "AthenaAboutPrometheusL01"
    }
    {
      Id = "Athena_0161"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan cemaskan soal itu. Hukuman terdahulunya malah memicu pelanggaran yang jauh lebih besar ini, alih-alih penyesalan atas perbuatannya di masa lalu. Untuk saat ini, strategi kita hanya menuntut agar dia tidak menghalangi jalan kita."
      Speaker = "Athena"
      Event = "AthenaAboutPrometheusL01"
    }
    {
      Id = "Athena_0166"
      InheritFrom = "BaseNarrative"
      DisplayName = "Perlu kau ketahui, ayahku sekaligus Paman Bagindamu Zeus agak sangsi dengan kemampuanmu membalikkan hasil perang ini demi keunggulan kita. Beliau percaya kita semestinya mampu membela diri kita sendiri; dan aku pun tak membantahnya."
      Speaker = "Athena"
      Event = "AthenaAboutZeus01"
    }
    {
      Id = "MelinoeField_2408"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang Mulia Athena, bukankah kita seharusnya bersatu padu sebagai sebuah keluarga? Ini bukan saatnya untuk mementingkan gengsi."
      Speaker = "Melinoe"
      Event = "AthenaAboutZeus01"
    }
    {
      Id = "Athena_0167"
      InheritFrom = "BaseNarrative"
      DisplayName = "Soal itu pun, aku tak membantahnya. Kendati demikian, keluarga kita tampaknya tak mampu bersatu dalam waktu yang lama. Andaikan kita bisa... perang ini tak akan pernah dimulai sedari awal."
      Speaker = "Athena"
      Event = "AthenaAboutZeus01"
    }
    {
      Id = "Athena_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dukungan Ibu Tiriku Ratu Hera tidak mudah didapatkan. Perlu kau ketahui bahwa beliaulah yang pertama kali menginginkan bantuanmu di sini. Kau mendapatkan lebih dari sekadar Berkahnya, melainkan juga kepercayaannya; serapuh apa pun itu."
      Speaker = "Athena"
      Event = "AthenaAboutHera01"
    }
    {
      Id = "MelinoeField_2446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku sangat bersyukur untuk itu, tapi... apa kau kebetulan tahu alasannya? Aku tidak tahu apa yang dilihat Paduka Ratu dalam diriku, terlebih karena kami bahkan belum pernah bertemu sebelumnya."
      Speaker = "Melinoe"
      Event = "AthenaAboutHera01"
    }
    {
      Id = "Athena_0236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin karena kau mewakili tindakan yang berbeda dari yang telah kami sepakati sebelumnya, yang datang langsung dari ayahku, Paman Bagindamu Zeus. Tak ada satu pun dari kita yang suka disalahkan, tapi... kita jauh lebih menyukai kemenangan."
      Speaker = "Athena"
      Event = "AthenaAboutHera01"
    }
    {
      Id = "Athena_0198"
      InheritFrom = "BaseNarrative"
      DisplayName = "Harus kuakui, Sepupu... sudah lama aku tidak melihat persatuan seperti ini dari keluarga kita. Hampir semua orang kini berdiri bersama melawan musuh-musuh kita. Meskipun Dionysus, kemungkinan besar dia sedang terkapar mabuk di suatu tempat."
      Speaker = "Athena"
      Event = "AthenaAboutDionysus01"
    }
    {
      Id = "MelinoeField_2431"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika Tuan Dionysus belum mengangkat senjata melawan bala tentara Chronos, pastilah beliau punya alasannya sendiri..."
      Speaker = "Melinoe"
      Event = "AthenaAboutDionysus01"
    }
    {
      Id = "Athena_0199"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, dia pasti punya. Mengapa dia harus mengotori tangannya, jika dia bisa bermalas-malasan sambil berpesta pora? Beruntung baginya, aku punya urusan yang jauh lebih penting daripada harus melacak keberadaannya."
      Speaker = "Athena"
      Event = "AthenaAboutDionysus01"
    }
    {
      Id = "Athena_0200"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saudara tiriku Ares pasti sedang bersenang-senang, di mana pun dia berada saat ini. Dia sangat menikmati perang panjang yang berlarut-larut... buat apa dia bekerja sama dengan kita untuk mengakhirinya?"
      Speaker = "Athena"
      Event = "AthenaAboutAres01"
    }
    {
      Id = "MelinoeField_2432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah kau mencurigai adanya pengkhianatan? Jika Ares tak ada di sini sementara perang terus berkecamuk... mungkinkah dia sedang mengipasi konflik di kubu lawan?"
      Speaker = "Melinoe"
      Event = "AthenaAboutAres01"
    }
    {
      Id = "Athena_0201"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pikiran itu jelas sempat terlintas di benakku, hanya saja... musuh kita sama sekali tidak tertarik pada perang abadi, begitu pula kita. Sedangkan Ares hanya ingin perang ini terus berkecamuk tanpa henti, bukan agar ada pemenang yang muncul."
      Speaker = "Athena"
      Event = "AthenaAboutAres01"
    }
    {
      Id = "MelinoeField_2433"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tahu siapa lagi yang menginginkan hal itu? Eris. Dia pernah menyebut Ares sebelumnya. Menurutmu apakah mereka bekerja sama?"
      Speaker = "Melinoe"
      Event = "AthenaAboutAres01"
    }
    {
      Id = "Athena_0202"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dari yang kuketahui tentang sang Pertikaian, dia bukan tipe yang suka bersekutu. Namun, aku tak bisa mengesampingkan kemungkinan itu. Dia terus menghalangi rute perjalananmu... mungkin saja kelak dia akan membocorkan sesuatu."
      Speaker = "Athena"
      Event = "AthenaAboutAres01"
    }
    {
      Id = "Athena_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Ares akhirnya memutuskan untuk ikut serta dalam urusan keluarga kita. Betapa gemarnya berkompromi! Karena jika perang abadi tak bisa didapatkan, dia rela menerima hasil apa pun asalkan bisa memastikan perang-perang lain akan terus berdatangan."
      Speaker = "Athena"
      Event = "AthenaAboutAres02"
    }
    {
      Id = "MelinoeField_3173"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu pandanganmu tentang perang tak sama dengannya. Tapi aku tak akan menolak kekuatannya hanya karena perbedaan keyakinan. Yang berarti aku pun bersedia berkompromi... jika itu membawa kemenangan."
      Speaker = "Melinoe"
      Event = "AthenaAboutAres02"
    }
    {
      Id = "Athena_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berhati-hatilah dengan pola pikir seperti itu, Sepupu. Berkompromi demi mencapai mufakat adalah satu hal; tapi berkompromi soal keyakinan atau prinsip... soal {#Emph}prinsip idealis? {#Prev}Penalaran semacam itulah yang sering kali {#Emph}memulai {#Prev}perang, bukan sekadar mengakhirinya."
      Speaker = "Athena"
      Event = "AthenaAboutAres02"
    }
    {
      Id = "Athena_0307"
      InheritFrom = "BaseNarrative"
      DisplayName = "Persiapanmu luar biasa matang... dipersenjatai dengan perlengkapan hebat, paham seluk-beluk kelokan di gunung kami, belum lagi cara untuk bisa sampai ke sana. Siapa pun yang merancang rute perjalananmu, dia sangat ahli."
      Speaker = "Athena"
      Event = "AthenaAboutNobody01"
    }
    {
      Id = "MelinoeField_4453"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Yang Mulia Athena. Kami harus tahu betul apa yang akan kami hadapi mengingat gentingnya situasi ini, jadi kami berencana sebaik mungkin."
      Speaker = "Melinoe"
      Event = "AthenaAboutNobody01"
    }
    {
      Id = "Athena_0308"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memang. Kendati demikian, menurutku wawasan strategis seperti itu jarang lahir dari kata {#Emph}kami {#Prev}secara kolektif, melainkan dari satu benak yang jernih dan matang. Tentu saja, itu sepenuhnya urusan pribadimu."
      Speaker = "Athena"
      Event = "AthenaAboutNobody01"
    }
    {
      Id = "Athena_0231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin kau sempat berpapasan dengan Heracles yang perkasa di sepanjang perjalananmu. Dia memiliki kekuatan dan kecakapan yang tiada tara, tapi laporkan padaku jika dia menunjukkan gelagat mencurigakan."
      Speaker = "Athena"
      Event = "AthenaAboutHeracles01"
    }
    {
      Id = "MelinoeField_2445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah bertemu dengannya, dan melihatnya membantai gerombolan musuh kita, meski dia tidak begitu suka diajak bicara. Gelagat mencurigakan seperti apa yang kau maksud?"
      Speaker = "Melinoe"
      Event = "AthenaAboutHeracles01"
    }
    {
      Id = "Athena_0232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersekongkol dengan musuh kita, menentang kehendak kami, atau hal semacam itu. Sebenarnya aku tak punya alasan nyata untuk tidak memercayainya, tapi... aku kini lebih memercayaimu."
      Speaker = "Athena"
      Event = "AthenaAboutHeracles01"
    }
    {
      Id = "Athena_0305"
      InheritFrom = "BaseNarrative"
      DisplayName = "Heracles yang perkasa memilih patuh dalam diam di tengah semua ini, jarang sekali bersuara, yang justru memberitahuku banyak hal. Bagaimana penilaianmu terhadapnya saat ini?"
      Speaker = "Athena"
      Event = "AthenaAboutHeracles02"
    }
    {
      Id = "MelinoeField_4452"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh{#Prev}, aku... yah, kekuatannya memang luar biasa, persis seperti reputasinya, tapi selain itu dia... tampaknya sedang tidak akur dengan Baginda Raja dan Ratu."
      Speaker = "Melinoe"
      Event = "AthenaAboutHeracles02"
    }
    {
      Id = "Athena_0306"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hm. {#Prev}Dia pasti merasa kerugiannya jauh lebih besar jika melanggar titah mereka ketimbang tunduk, tapi... kesatria sepertinya... akan lebih bijak jika kita memastikan dia diperlakukan dengan baik."
      Speaker = "Athena"
      Event = "AthenaAboutHeracles02"
    }
    {
      Id = "Athena_0207"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sang Rembulan sendiri membantumu, aku tahu itu. Kami di sini sering kali memandangnya sebelah mata, mengira tugasnya hanyalah menerangi langit temaram. Tapi aku tahu kemampuannya jauh melampaui itu."
      Speaker = "Athena"
      Event = "AthenaAboutSelene01"
    }
    {
      Id = "MelinoeField_2436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selene mungkin seorang Titaness, tapi dia adalah sekutu setia kita seutuhnya. Dia menjunjung tinggi kehendak sang Malam, sama sepertiku."
      Speaker = "Melinoe"
      Event = "AthenaAboutSelene01"
    }
    {
      Id = "Athena_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehendak Nyx bukanlah urusanku, Sepupu. Tapi tampaknya itu urusanmu, dan Nyx pun pernah menjadi sekutu Olympus di masa lalu. Jika kau memercayai keterlibatan Selene, itu sudah lebih dari cukup."
      Speaker = "Athena"
      Event = "AthenaAboutSelene01"
    }
    {
      Id = "Athena_0215"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada mantra aneh yang memengaruhimu, kau tampak berbeda dari sebelumnya. Jauh... lebih berbobot. Entah itu berkah atau kutukan, aku belum bisa memastikannya."
      Speaker = "Athena"
      Event = "AthenaAboutCirce01"
    }
    {
      Id = "MelinoeField_2442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini berkah, setidaknya kurasa begitu. Karya dari Madam Circe sang Penyihir, yang kutemui dalam perjalananku ke sini."
      Speaker = "Melinoe"
      Event = "AthenaAboutCirce01"
    }
    {
      Id = "Athena_0217"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku ingat dia. Dia pernah menimbulkan masalah pelik bagi seorang pelaut fana yang berniat kulindungi, kurasa kau tak mengenalnya. Sebaiknya kau berhati-hati dengannya."
      Speaker = "Athena"
      Event = "AthenaAboutCirce01"
    }
    {
      Id = "Athena_0216"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada mantra aneh yang memengaruhimu, kau tampak berbeda dari sebelumnya. Apakah kau... menyusut, Sepupu? Entah itu berkah atau kutukan, aku belum bisa memastikannya."
      Speaker = "Athena"
      Event = "AthenaAboutCirce01_B"
    }
    {
      Id = "Athena_0218"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terlihat berbeda dari sebelumnya. Berarti ini berkah tak biasa lainnya dari sang penyihir Circe. Kau yakin dia membantumu, bukannya... mengejekmu?"
      Speaker = "Athena"
      Event = "AthenaAboutCirce02"
    }
    {
      Id = "MelinoeField_2443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Madam Circe tak akan pernah memakai sihir transformasinya untuk mengejek. Ini mantra yang kuat... hanya saja ada efek samping tertentu."
      Speaker = "Melinoe"
      Event = "AthenaAboutCirce02"
    }
    {
      Id = "Athena_0219"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak pernah memakai sihirnya untuk mengejek? Itu sama sekali tak terdengar seperti Circe yang kuingat. Mungkin dia sudah belajar menjaga sikapnya, meski aku belum sepenuhnya yakin..."
      Speaker = "Athena"
      Event = "AthenaAboutCirce02"
    }
    {
      Id = "MelinoeField_2437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lady Athena, jika diizinkan... ada kenalan kita berdua yang ingin kutanyakan, karena... yah... apakah Anda ingat sang penenun Arachne?"
      Speaker = "Melinoe"
      Event = "AthenaAboutArachne01"
    }
    {
      Id = "Athena_0209"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku jarang melupakan apa pun, Sepupu. Terutama manusia fana kurang ajar yang menganggap dirinya setara dengan dewa. Walau kini ia tak bisa dibilang manusia lagi. Ada apa dengannya?"
      Speaker = "Athena"
      Event = "AthenaAboutArachne01"
    }
    {
      Id = "MelinoeField_2438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... dia tinggal di Erebus sekarang, dekat tempat tinggalku, dan... dia sangat merana karena penampilannya, yang kutahu adalah akibat dari kutukan Anda... tentu saja dia pantas mendapatkannya, tapi... kasihanilah dia, Lady Athena. Kumohon."
      Speaker = "Melinoe"
      Event = "AthenaAboutArachne01"
    }
    {
      Id = "Athena_0210"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak manusia fana yang bersujud memohon padaku setiap saat. Tapi seorang dewi? Dan mewakili manusia fana yang terlalu sombong untuk bersujud sendiri? Sepupu, jangan buang-buang waktuku untuk urusan ini."
      Speaker = "Athena"
      Event = "AthenaAboutArachne01"
    }
    {
      Id = "Athena_0211"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wanita fana bernama Arachne itu. Apa kau tahu apa yang telah dia perbuat? Dia menganggap dirinya penenun terhebat di dunia; bahkan lebih unggul dariku, atau bahkan dari para Takdir sendiri. Bukankah sudah menjadi kewajiban kita untuk mengingatkan kaum fana akan kedudukan mereka?"
      Speaker = "Athena"
      Event = "AthenaAboutArachne02"
    }
    {
      Id = "MelinoeField_2440"
      InheritFrom = "BaseNarrative"
      DisplayName = "A... aku tak bisa bilang tahu pasti jawabannya, Lady Athena. Dan aku tak bermaksud mempertanyakan keputusan Anda mengenainya! Aku hanya bertanya apakah masa hukumannya bisa dibuat tidak abadi. Dia sudah merendahkan hati, dan dia sudah belajar dari kesalahannya."
      Speaker = "Melinoe"
      Event = "AthenaAboutArachne02"
    }
    {
      Id = "Athena_0212"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitukah? Sepengalamanku, manusia fana bisa {#Emph}sangat {#Prev}lambat belajar. Dan dia dihukum bukan sebagai pelajaran untuk {#Emph}dirinya{#Prev}, melainkan sebagai pelajaran untuk {#Emph}semua orang. {#Prev}Aku tidak akan menarik kembali keputusanku, Melinoë. Karena aku tak pernah memutuskannya secara sembarangan."
      Speaker = "Athena"
      Event = "AthenaAboutArachne02"
    }
    {
      Id = "Athena_0247"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pikiranmu tentang Arachne membuatmu teralihkan, dan itu pada gilirannya membuat {#Emph}aku {#Prev}juga teralihkan sekarang. Aku ingin mengusulkan cara agar kita bisa menyelesaikan urusan ini dengannya."
      Speaker = "Athena"
      Event = "AthenaAboutArachne03"
    }
    {
      Id = "MelinoeField_4430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benarkah? Tolong beri tahu apa rencanamu, Lady Athena. Arachne adalah sahabatku, dan jika ada cara untuk membantunya, aku pasti bersedia. Aku sudah tahu asal-usul kutukan itu..."
      Speaker = "Melinoe"
      Event = "AthenaAboutArachne03"
    }
    {
      Id = "Athena_0248"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan karena itu kau ingin aku mencabutnya. Dan meski kau tak bisa memaksaku, mungkin Arachne bisa, jika dia memang sudah berubah seperti yang kau katakan. Kau tahu Jimat Gorgon milikku? Tanyakan apakah dia mau bicara denganku lewat benda itu. Jika ya, mungkin aku akan menampakkan diri."
      Speaker = "Athena"
      Event = "AthenaAboutArachne03"
    }
    {
      Id = "MelinoeField_4432"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lady Athena, a... aku tak tahu harus berkata apa, selain... aku sangat menyesali insiden antara Anda dan Arachne. Kupikir dia berniat memohon pengampunan Anda, bukan mencari keributan."
      Speaker = "Melinoe"
      Event = "AthenaAboutArachneQuestComplete01"
    }
    {
      Id = "Athena_0255"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak terlalu terkejut dengan hasilnya, karena aku sudah mengenalnya dari dulu. Mungkin dia memang {#Emph}berniat {#Prev}minta maaf, sampai saat dia melihatku lagi dan seluruh amarahnya meluap kembali. Kendati demikian, yang sudah terjadi biarlah terjadi."
      Speaker = "Athena"
      Event = "AthenaAboutArachneQuestComplete01"
    }
    {
      Id = "MelinoeField_4433"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku paham. Tapi, jika aku boleh bertanya... apa sebenarnya yang dia lakukan hingga mengundang murka Anda? Aku tahu ada kontes menenun yang terlibat, tapi baru mendengar dari sisinya saja."
      Speaker = "Melinoe"
      Event = "AthenaAboutArachneQuestComplete01"
    }
    {
      Id = "Athena_0256"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalah dari seorang manusia fana adalah kehinaan yang tak pernah kubayangkan. Namun arogansi Arachne-lah yang memicu amarahku, bukan karena rasa iri pada bakatnya yang luar biasa. Dia berani-beraninya menyebut karyaku {#Emph}biasa saja."
      Speaker = "Athena"
      Event = "AthenaAboutArachneQuestComplete01"
    }
    {
      Id = "MelinoeField_4434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dia menghina Anda... tindakan itu tentu sangat ceroboh, dan seingatku dia masih sangat muda waktu itu. Seandainya saja dia tahu..."
      Speaker = "Melinoe"
      Event = "AthenaAboutArachneQuestComplete01"
    }
    {
      Id = "Athena_0257"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terakhir kali ini, dia {#Emph}tahu {#Prev}persis. Namun dia menghinaku lagi. Kami tidak berharap banyak dari manusia fana; hanya penyesalan dan tobat. Bagi orang-orang seperti Arachne, hal terbaik yang bisa kita lakukan adalah menjadikannya contoh peringatan. Sekarang, aku tak sudi membahasnya lagi sepatah kata pun."
      Speaker = "Athena"
      Event = "AthenaAboutArachneQuestComplete01"
    }
    {
      Id = "Athena_0213"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membuatku memikirkan tentang umat manusia belakangan ini. Aku pun pernah menaruh perhatian pribadi pada kaum fana dan penderitaan mereka. Berkali-kali. Terutama pada mereka yang berusaha melampaui derajatnya. Dan aku ingin menghargai pemujaan mereka terhadap para dewa lain dan diriku."
      Speaker = "Athena"
      Event = "AthenaAboutMortals01"
    }
    {
      Id = "MelinoeField_2441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun sebelumnya Anda bilang sudah kewajiban kita untuk mengingatkan kedudukan mereka... bahwa mereka pada akhirnya tak berdaya di hadapan kita."
      Speaker = "Melinoe"
      Event = "AthenaAboutMortals01"
    }
    {
      Id = "Athena_0214"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar, karena jumlah mereka jauh melebihi kita, dan banyak yang tumbuh cerdik serta mandiri. Sebagian merasa tidak membutuhkan kita, padahal mereka butuh. Baik dalam hidup maupun mati, seperti yang bisa disaksikan oleh ayahmu. Sebaiknya jangan menjadi {#Emph}terlalu {#Prev}terikat dengan siapa pun dari mereka."
      Speaker = "Athena"
      Event = "AthenaAboutMortals01"
    }
    {
      Id = "MelinoeField_2414"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya Anda harus menghadapi para penyerbu ini sendirian, Lady Athena. Wilayah gunung ini terlampau luas untuk dijaga, sementara sekutu terlalu sedikit..."
      Speaker = "Melinoe"
      Event = "AthenaAboutOlympians01"
    }
    {
      Id = "Athena_0178"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, kami punya {#Emph}dirimu{#Prev}, Sepupu. Mengenai sekutu kami yang {#Emph}lainnya{#Prev}... kami sekeluarga pantang memohon bantuan, atau memohon apa pun. Kepada semua pengikut dan rekan seperjuangan, pesan kami sudah jelas: Kami mengendalikan situasi ini sepenuhnya."
      Speaker = "Athena"
      Event = "AthenaAboutOlympians01"
    }
    {
      Id = "MelinoeField_2415"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apakah itu kenyataannya, atau sekadar gengsi belaka, jika Anda memaafkan kelancangan saya? Kalian jelas-jelas kewalahan."
      Speaker = "Melinoe"
      Event = "AthenaAboutOlympians01"
    }
    {
      Id = "Athena_0179"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sebaliknya, Automaton kami cukup efektif menahan laju banyak musuh. Dan kau serta diriku juga bisa membawa perubahan besar, jika kita tidak membuang waktu."
      Speaker = "Athena"
      Event = "AthenaAboutOlympians01"
    }
    {
      Id = "Athena_0164"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepupu, benarkah kau berhasil mencapai jantung Dunia Bawah ayahmu dan menumbangkan Titan Chronos di sana? Pasukannya tiba-tiba mundur, dan aku tak berani memercayai firasatku mengenai alasannya."
      Speaker = "Athena"
      Event = "AthenaAboutChronosBossW01"
    }
    {
      Id = "MelinoeField_2407"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku memang berhasil mengalahkannya baru-baru ini, ya. Kelak kita akan menyingkirkannya untuk selamanya, namun untuk saat ini, kemenangan-kemenangan kecil sudah cukup."
      Speaker = "Melinoe"
      Event = "AthenaAboutChronosBossW01"
    }
    {
      Id = "Athena_0165"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemenangan sepenting itu bukanlah kemenangan kecil. Namun aku sangat memahami dorongan untuk pantang berpuas diri, dan selalu terus bertempur."
      Speaker = "Athena"
      Event = "AthenaAboutChronosBossW01"
    }
    {
      Id = "Athena_0222"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau sudah melihat apa yang meneror kami di puncak, bukan? Sumber dari semua getaran ini... seolah gunung ini sendiri gemetar ketakutan. Kita butuh rencana..."
      Speaker = "Athena"
      Event = "AthenaAboutTyphon01"
    }
    {
      Id = "MelinoeField_3168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para dewa pernah melawan Typhon sebelumnya. Bukankah sambaran petir yang tepat sasaran dari Zeus yang dulu menumbangkannya?"
      Speaker = "Melinoe"
      Event = "AthenaAboutTyphon01"
    }
    {
      Id = "Athena_0223"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kisah keberanian dan {#Emph}tindakan {#Prev}berani tidak selalu merupakan hal yang sama. Kalau begitu, mari kita pancing Typhon ini menuju puncak, di mana kekuatan kami dipadukan dengan kekuatanmu adalah peluang terbaik yang kita miliki... dan tolong berhati-hatilah, Sepupu."
      Speaker = "Athena"
      Event = "AthenaAboutTyphon01"
    }
    {
      Id = "Athena_0224"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bersyukurlah pada sang Moirai kau berhasil lolos dari amukan Typhon. Dan kau telah membuat pengalihan yang cukup berarti hingga kami dapat memperkuat pertahanan dan menahan monster mengerikan itu untuk sementara waktu."
      Speaker = "Athena"
      Event = "AthenaAboutTyphonL01"
    }
    {
      Id = "MelinoeField_3169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi dia akan kembali. Apa kau sudah menemukan kelemahan penting darinya? Aku ingin melakukan lebih dari sekadar mengalihkan perhatiannya."
      Speaker = "Melinoe"
      Event = "AthenaAboutTyphonL01"
    }
    {
      Id = "Athena_0225"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makhluk sebesar itu tidak akan punya banyak kelemahan... meski tak ada makhluk yang suka matanya dicolok; dan Typhon punya amat banyak mata, entah itu menguntungkan atau merugikan bagi kita. Dan jika kita mengerahkan seluruh kekuatan kita... mungkin kita bisa memukulnya mundur."
      Speaker = "Athena"
      Event = "AthenaAboutTyphonL01"
    }
    {
      Id = "Athena_0226"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita berhasil memukul mundur Typhon yang mengerikan itu berkat bantuanmu! Jadi itu {#Emph}bisa {#Prev}dilakukan! Hanya saja makhluk terkutuk itu lekas pulih dan mulai mendaki sekali lagi..."
      Speaker = "Athena"
      Event = "AthenaAboutTyphonW01"
    }
    {
      Id = "MelinoeField_3170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti ada cara untuk memusnahkan Typhon seutuhnya, bukan hanya memperlambatnya. Tapi jika memperlambatnya adalah hasil terbaik yang bisa kita capai untuk saat ini... biarlah begitu."
      Speaker = "Melinoe"
      Event = "AthenaAboutTyphonW01"
    }
    {
      Id = "Athena_0227"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sosok yang dijuluki {#Emph}Bapak Segala Monster... {#Prev}Aku sudah sering mendengar kisahnya tentu saja, tapi {#Emph}melihatnya {#Prev}langsung... Aku merasa keberanianku hampir goyah; yang mana terasa jauh lebih menakutkan daripada monster itu sendiri..."
      Speaker = "Athena"
      Event = "AthenaAboutTyphonW01"
    }
    {
      Id = "Athena_0228"
      InheritFrom = "BaseNarrative"
      DisplayName = "Typhon itu tampaknya semakin murka setiap kali kita menahan amukannya. Muslihat yang cerdik dari Chronos untuk melepaskan makhluk semacam itu kepada kita... membuat kita sibuk, selagi dia merencanakan langkah berikutnya."
      Speaker = "Athena"
      Event = "AthenaAboutTyphonW02"
    }
    {
      Id = "MelinoeField_3171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Entah cerdik atau ceroboh, aku belum yakin sepenuhnya. Chronos berharap Typhon melampiaskan semua kekejiannya ke Olympus, tapi setelah itu...? Bahkan {#Emph}dia {#Prev}pun takkan bisa mengendalikan kekejian sebesar itu."
      Speaker = "Melinoe"
      Event = "AthenaAboutTyphonW02"
    }
    {
      Id = "Athena_0229"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin Chronos berniat menyegel monster itu kembali setelah kita tak lagi menjadi ancaman. Bagaimanapun juga, kita tidak berniat membiarkan hasil akhir seperti itu terjadi."
      Speaker = "Athena"
      Event = "AthenaAboutTyphonW02"
    }
    {
      Id = "Athena_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sepupu, setelah banyak pertimbangan, kuakui rencana terbaik yang kupunya untuk menghentikan Typhon saat ini... adalah mengandalkan {#Emph}dirimu. {#Prev}Alternatif terbaik berikutnya yang tersedia akan berakibat sangat mengerikan."
      Speaker = "Athena"
      Event = "AthenaAboutTyphonPlan01"
    }
    {
      Id = "MelinoeField_4425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Paman Zeus menyinggung tentang kekuatan tertentu yang berpotensi mengalahkan monster itu, tapi membawa malapetaka besar bagi Olympus dalam prosesnya... itukah alternatif yang kau maksud?"
      Speaker = "Melinoe"
      Event = "AthenaAboutTyphonPlan01"
    }
    {
      Id = "Athena_0242"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar sekali. Tenagaku, seperti yang kau lihat, terfokus untuk memukul mundur pasukan musuh kita di sini. Tapi tampaknya aku juga harus membujuk ayahku agar tidak mengambil jalan yang membawa malapetaka itu, setidaknya untuk mengulur waktumu. Aku mengandalkanmu... kami semua mengandalkanmu."
      Speaker = "Athena"
      Event = "AthenaAboutTyphonPlan01"
    }
    {
      Id = "Athena_0243"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah berkali-kali disebut sebagai juru selamat, dan ada kepuasan tersendiri saat membalikkan keadaan yang nyaris tanpa harapan. Tapi baru-baru ini, harapanku sendirilah yang sempat goyah... sampai {#Emph}kau {#Prev}memulihkannya. Bapak Segala Monster benar-benar telah sirna."
      Speaker = "Athena"
      Event = "AthenaAboutTyphonDeath01"
    }
    {
      Id = "MelinoeField_4426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Olympus adalah milik para dewa... kebinasaan Typhon adalah suatu keharusan. Aku mungkin yang mengantarkannya menuju kehampaan, tapi keberhasilan itu berkat gabungan kekuatan kita bersama."
      Speaker = "Melinoe"
      Event = "AthenaAboutTyphonDeath01"
    }
    {
      Id = "Athena_0244"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalian para dewa khthonik dan kerendahan hati kalian itu. Berbanggalah{#Emph}{#Prev}, Sepupu! Kau telah meraih hasil yang gilang-gemilang, yang mana kami semua sangat berterima kasih. Aku tahu aku {#Emph}harus {#Prev}mempercayaimu. Dan kurasa memang sepatutnya begitu."
      Speaker = "Athena"
      Event = "AthenaAboutTyphonDeath01"
    }
    {
      Id = "Athena_0170"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku harus meminta maaf soal pertarunganmu dengan Automaton yang luar biasa besar dan berbahaya bernama Talos itu. Ia mendeteksi jejak Dunia Bawah padamu, dan, yah..."
      Speaker = "Athena"
      Event = "AthenaAboutTalos01"
    }
    {
      Id = "MelinoeField_2410"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu ciptaan yang luar biasa, dan Tuan Hephaestus patut berbangga... walau, metode yang digunakan para Automaton-nya untuk mendeteksi ancaman mungkin perlu perombakan menyeluruh."
      Speaker = "Melinoe"
      Event = "AthenaAboutTalos01"
    }
    {
      Id = "Athena_0171"
      InheritFrom = "BaseNarrative"
      DisplayName = "Akan kupastikan untuk menyampaikan saran itu. Sayangnya Tuan Hephaestus lebih memprioritaskan sistem perbaikan mandiri pada Talos ketimbang pendeteksian ancaman, jadi mungkin ini masih akan menjadi masalah untuk sekarang."
      Speaker = "Athena"
      Event = "AthenaAboutTalos01"
    }
    {
      Id = "Athena_0168"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih belum yakin Automaton yang kita gunakan untuk pertahanan ini benar-benar bisa diandalkan seutuhnya. Sudah kukatakan pada Hephaestus bahwa aku takkan mentolerir kejanggalan mereka; kau pun juga tidak boleh."
      Speaker = "Athena"
      Event = "AthenaAboutAutomatons01"
    }
    {
      Id = "MelinoeField_2409"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka memang hebat, tapi tampaknya tak mampu membedakan sekutu dari musuhmu dengan baik. Mungkin Hephaestus bisa menyempurnakan rancangan mereka."
      Speaker = "Melinoe"
      Event = "AthenaAboutAutomatons01"
    }
    {
      Id = "Athena_0169"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, itu ada dalam daftar panjang permintaan kami kepadanya. Lagipula kita harus mematikan dan mendaur ulang model-model yang ada untuk upaya itu... jadi jika kau menghancurkan beberapa di sana-sini, itu justru yang terbaik."
      Speaker = "Athena"
      Event = "AthenaAboutAutomatons01"
    }
    {
      Id = "Athena_0185"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aneh sekali rasanya bisa bertemu denganmu secara langsung. Kakakmu Zagreus sudah sering kuajak bicara, meski lewat Kurnia kecuali sekali waktu. Kau pasti tahu dia punya pergulatan sendiri di rumahnya. Sekarang tampaknya giliran keluargamu yang membalas budi pada kami untuk saat itu."
      Speaker = "Athena"
      Event = "AthenaAboutZagreus01"
    }
    {
      Id = "MelinoeField_2424"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika memang ada hutang budi yang harus dibalas, aku tidak mengetahuinya, Putri Athena. Aku di sini karena keluarga kita sedang dalam bahaya, baik keluargaku maupun keluargamu."
      Speaker = "Melinoe"
      Event = "AthenaAboutZagreus01"
    }
    {
      Id = "Athena_0186"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tentu saja, dan aku tidak bermaksud mengesankan sebaliknya. Aku hanya merenungkan perubahan keadaan ini. Baiklah kalau begitu, satu Kurnia pantas dibalas kurnia lainnya."
      Speaker = "Athena"
      Event = "AthenaAboutZagreus01"
    }
    {
      Id = "Athena_0312"
      InheritFrom = "BaseNarrative"
      DisplayName = "Awalnya kau tidak mengingatkanku pada Zagreus, tapi sekarang aku mulai melihat kemiripannya. Aku belum sempat mengirimkan pesan Kurnia lagi kepadanya, begitu pula padamu. Kuharap dia baik-baik saja?"
      Speaker = "Athena"
      Event = "AthenaAboutZagreus02"
    }
    {
      Id = "MelinoeField_4456"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tampaknya dia bersemangat, ya. Meski kami baru bertemu belakangan ini, rasanya aku sudah mengenalnya sejak lama. Ngomong-ngomong, bagaimana kalian berdua pertama kali berhubungan?"
      Speaker = "Melinoe"
      Event = "AthenaAboutZagreus02"
    }
    {
      Id = "Athena_0313"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lewat Dewi Nyx awalnya. Kisah panjang untuk lain waktu, tapi mulanya kukira Nyx adalah ibunya. Kalau dipikir-pikir, kita berdua sama-sama dibesarkan tanpa sosok ibu! Sampaikan salamku untuk segenap keluargamu."
      Speaker = "Athena"
      Event = "AthenaAboutZagreus02"
    }
    {
      Id = "Athena_0187"
      InheritFrom = "BaseNarrative"
      DisplayName = "Setelah kita menyelesaikan masalah tertentu terkait situasi kakakmu di rumah, ibumu Persephone rutin kembali ke Olympus selama beberapa bulan setiap tahunnya. Seharusnya aku percaya pada naluriku saat suatu hari dia tidak kunjung muncul..."
      Speaker = "Athena"
      Event = "AthenaAboutPersephone01"
    }
    {
      Id = "MelinoeField_2425"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemungkinan saat Chronos menyerang. Bukankah hilangnya beliau secara tiba-tiba seharusnya menimbulkan kekhawatiran yang amat besar?"
      Speaker = "Melinoe"
      Event = "AthenaAboutPersephone01"
    }
    {
      Id = "Athena_0188"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau pasti berpikir begitu. Namun, kami tahu ibumu sedang mengandung, dan kesimpulan kami adalah keluarga barumu menginginkan privasi. Jadi kami menunggu dengan sabar, tanpa menyadari Chronos mulai menancapkan pengaruhnya. Kekeliruan perhitungan yang fatal di pihakku..."
      Speaker = "Athena"
      Event = "AthenaAboutPersephone01"
    }
    {
      Id = "MelinoeField_2426"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ayahmu dan ayahku bertarung serta mengalahkan Chronos jauh sebelum kita berdua lahir. Kau tak mungkin menduga bahwa Sang Tuan Titan akan tiba-tiba kembali."
      Speaker = "Melinoe"
      Event = "AthenaAboutPersephone01"
    }
    {
      Id = "Athena_0189"
      InheritFrom = "BaseNarrative"
      DisplayName = "Namun jika aku menyandang gelar ahli strategi di Olympus, maka aku harus mempertimbangkan segala kemungkinan, betapapun mustahilnya, yang dapat mengancam perdamaian kita. Bagaimanapun juga, itu pelajaran yang sangat pahit..."
      Speaker = "Athena"
      Event = "AthenaAboutPersephone01"
    }
    {
      Id = "Athena_0192"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi Artemis menemukanmu di tengah kabut Erebus, di bawah bimbingan Hecate? Sungguh kisah yang luar biasa. Bersediakah kau menceritakan lebih lanjut?"
      Speaker = "Athena"
      Event = "AthenaAboutHecate01"
    }
    {
      Id = "MelinoeField_2428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yang bisa kukatakan hanyalah Kepala Perguruan Hecate berada di bawah perintah ketat untuk tidak membocorkan keberadaanku kepada siapa pun di luar lingkaran terdekatnya. Tidak sampai peluang kita untuk menyerang Chronos tiba."
      Speaker = "Melinoe"
      Event = "AthenaAboutHecate01"
    }
    {
      Id = "Athena_0193"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baiklah kalau begitu. Aku memang tak pernah berilusi bahwa pihak keluargaku dan pihak keluargamu tak saling menyimpan rahasia. Mungkin memang sebaiknya begitu. Tapi, posisiku memang menuntut ketelitian dan rasa ingin tahu tertentu, kau paham kan."
      Speaker = "Athena"
      Event = "AthenaAboutHecate01"
    }
    {
      Id = "Athena_0190"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiga Moirai sendiri telah lenyap, begitu kata Hermes. Situasi kita semakin genting karenanya. Namun... aku tak pernah bisa bergantung pada campur tangan luar demi keberhasilanku; kuharap kau tak tersinggung."
      Speaker = "Athena"
      Event = "AthenaAboutFates01"
    }
    {
      Id = "MelinoeField_2427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak, aku paham maksudmu. Chronos takut ramalan Takdir akan menghancurkannya lagi, seperti saat para ayah kita menggulingkan kekuasaannya. Tapi jika para Dewi Takdir tak lagi menentukan jalannya takdir... kitalah yang akan menentukannya."
      Speaker = "Melinoe"
      Event = "AthenaAboutFates01"
    }
    {
      Id = "Athena_0191"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasti. Karena tujuan dari setiap strategi adalah meminimalkan campur tangan keberuntungan sekecil mungkin. Kita hanya mengandalkan mereka yang terbukti bisa dipercaya, dan di atas segalanya, diri kita sendiri."
      Speaker = "Athena"
      Event = "AthenaAboutFates01"
    }
    {
      Id = "Athena_0196"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pemahamanku dulu adalah saudaramu menderita semacam penyakit yang menguras vitalitasnya setiap kali dia mencoba keluar dari Dunia Bawah. Tapi kau tampaknya tidak punya batasan semacam itu?"
      Speaker = "Athena"
      Event = "AthenaAboutCurse01"
    }
    {
      Id = "MelinoeField_2430"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku hanya menemukan cara untuk memperlambat efeknya, tapi aku bisa merasakan hawa itu mulai merayap sekarang. Jika musuh-musuh kita tak sanggup memaksaku mundur, pada akhirnya penyakit inilah yang akan melakukannya."
      Speaker = "Melinoe"
      Event = "AthenaAboutCurse01"
    }
    {
      Id = "Athena_0197"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa mau dikata? Kau menyembunyikan kesulitanmu dengan sangat baik, Melinoë. Jadi perjuanganmu ini berpacu dengan waktu dalam berbagai arti. Kalau begitu, aku takkan menahanmu lebih lama lagi."
      Speaker = "Athena"
      Event = "AthenaAboutCurse01"
    }
    {
      Id = "Athena_0203"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mengenakan Jimat yang kuberikan. Semoga jimat itu melindungimu dan menebar rasa takut ke dalam hati musuh-musuhmu, setiap kali aku tak berada di dekatmu untuk melakukan hal yang sama."
      Speaker = "Athena"
      Event = "AthenaAboutKeepsake01"
    }
    {
      Id = "MelinoeField_2434"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih, Yang Mulia Athena. Makhluk yang terukir di sini... ini Gorgon, bukan? Semacam pelindung?"
      Speaker = "Melinoe"
      Event = "AthenaAboutKeepsake01"
    }
    {
      Id = "Athena_0204"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, tidak tepatnya begitu. Lebih tepatnya sebagai pengingat keras tentang apa yang terjadi ketika kami, para dewa, ditentang secara terang-terangan. Jangan sampai kehilangan kepalamu di luar sana, Sepupu."
      Speaker = "Athena"
      Event = "AthenaAboutKeepsake01"
    }
    {
      Id = "Athena_0270"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau membawaku ke tempat-tempat paling aneh dengan Jimat Gorgon itu, Sepupu. Aku senang jimat itu memberimu manfaat sebesar ini."
      Speaker = "Athena"
      Event = "AthenaAboutKeepsake02"
    }
    {
      Id = "MelinoeField_4435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku yakin kau sadar betul bahwa berkatmu luar biasa berharga, Yang Mulia Athena. Selama panggilanku yang berulang kali ini tidak terlalu merepotkanmu."
      Speaker = "Melinoe"
      Event = "AthenaAboutKeepsake02"
    }
    {
      Id = "Athena_0271"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat sedang merepotkan, aku takkan muncul. Kalau begitu, mari kita terus merintis jalan aneh ini bersama-sama, bukan sendirian!"
      Speaker = "Athena"
      Event = "AthenaAboutKeepsake02"
    }
    {
      Id = "Athena_0272"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini pasti hutan gelap Erebus, di suatu tempat di dekat markas operasimu. Aku bisa paham kenapa tempat ini begitu membekas bagi Artemis."
      Speaker = "Athena"
      Event = "AthenaAboutErebus01"
    }
    {
      Id = "MelinoeField_4436"
      InheritFrom = "BaseNarrative"
      DisplayName = "Selamat datang, Yang Mulia Athena! Mungkin Artemis merasa betah di hutan jenis apa pun, bahkan yang dihantui oleh Jiwa-Jiwa Tersesat yang tak bisa beristirahat dengan tenang."
      Speaker = "Melinoe"
      Event = "AthenaAboutErebus01"
    }
    {
      Id = "Athena_0273"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini jelas sangat berbeda dari Gunung Olympus. Tapi aku ke sini bukan untuk mengamati medan, jadi cepatlah memilih."
      Speaker = "Athena"
      Event = "AthenaAboutErebus01"
    }
    {
      Id = "Athena_0274"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kedalaman Oceanus... Aku sering melayang atau berlayar di atas perairan ini, tapi jarang melihatnya dari dalam. Jadi begini caramu melewati Elysium."
      Speaker = "Athena"
      Event = "AthenaAboutOceanus01"
    }
    {
      Id = "MelinoeField_4437"
      InheritFrom = "BaseNarrative"
      DisplayName = "Rute tidak langsung menuju tingkatan terbawah, begitulah. Mungkin kau bisa menakut-nakuti beberapa monster ikan mengerikan itu."
      Speaker = "Melinoe"
      Event = "AthenaAboutOceanus01"
    }
    {
      Id = "Athena_0275"
      InheritFrom = "BaseNarrative"
      DisplayName = "Makhluk serendah itu punya sedikit sekali kapasitas rasa takut, tapi kita akan mengajari mereka sebisa kita."
      Speaker = "Athena"
      Event = "AthenaAboutOceanus01"
    }
    {
      Id = "Athena_0276"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ungh... {#Prev}Padang Ratapan ini punya sedikit kemiripan dengan dataran luas di permukaan, tapi udara di sini terasa sangat menyesakkan."
      Speaker = "Athena"
      Event = "AthenaAboutFields01"
    }
    {
      Id = "MelinoeField_4438"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terima kasih telah menemukanku bahkan di tempat seperti ini, Yang Mulia Athena. Aku tak menyarankanmu berlama-lama di sini sekalipun kau mampu."
      Speaker = "Melinoe"
      Event = "AthenaAboutFields01"
    }
    {
      Id = "Athena_0277"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan aku juga tak menyarankan kau tertembus tombakku, namun terkadang itu memang harus dilakukan. Semoga perjalananmu melintasi tempat ini tak memakan waktu lebih lama dari yang seharusnya."
      Speaker = "Athena"
      Event = "AthenaAboutFields01"
    }
    {
      Id = "Athena_0278"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua emas ini... apa yang telah terjadi pada Tartarus? Sang Titan Chronos membuatnya hampir tak bisa dikenali lagi sama sekali..."
      Speaker = "Athena"
      Event = "AthenaAboutTartarus01"
    }
    {
      Id = "MelinoeField_4439"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin lain kali saat aku menggunakan Jimat Gorgon untuk memanggilmu ke sini, kau bisa menanyakannya sendiri kepadanya, Yang Mulia Athena."
      Speaker = "Melinoe"
      Event = "AthenaAboutTartarus01"
    }
    {
      Id = "Athena_0279"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, andai saja aku bisa dan andai Jimat itu lebih kuat lagi. Tapi semua strategi punya keterbatasan. Berkatku, alih-alih kehadiranku langsung, yang harus mencukupimu saat kau mendekati tujuanmu."
      Speaker = "Athena"
      Event = "AthenaAboutTartarus01"
    }
    {
      Id = "Athena_0280"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah, setidaknya di sini tidak bersalju. Kukira kehancuran semacam itu hanya terpusat di Olympus, tapi ternyata sudah menyebar sampai ke Ephyra."
      Speaker = "Athena"
      Event = "AthenaAboutEphyra01"
    }
    {
      Id = "MelinoeField_4440"
      InheritFrom = "BaseNarrative"
      DisplayName = "Legiun sang Titan mungkin menjarah kota ini karena alasan simbolis... mengibarkan panji-panji mereka sambil menghancurkan monumen apa pun untuk Raja dan Ratu Dunia Bawah."
      Speaker = "Melinoe"
      Event = "AthenaAboutEphyra01"
    }
    {
      Id = "Athena_0281"
      InheritFrom = "BaseNarrative"
      DisplayName = "Menjarah tidak memerlukan perencanaan matang atau tujuan strategis, dan hasilnya sudah jelas. Tapi yang gagal kupahami adalah bagaimana cara ini bisa membujuk manusia fana untuk memihak para Titan ketimbang kami."
      Speaker = "Athena"
      Event = "AthenaAboutEphyra01"
    }
    {
      Id = "Athena_0282"
      InheritFrom = "BaseNarrative"
      DisplayName = "Geladak kapal layar yang membusuk ini... kita berada di tengah armada Titan di Celah Dewa Paman Poseidon. Kau menggunakan cara ini untuk mencapai gunung kami setiap malam?"
      Speaker = "Athena"
      Event = "AthenaAboutThessaly01"
    }
    {
      Id = "MelinoeField_4441"
      InheritFrom = "BaseNarrative"
      DisplayName = "Yah... beberapa malam aku pergi ke Dunia Bawah sebagai gantinya, tapi selain itu, {#Emph}ehm{#Prev}, ya. Aku belum terlalu berhasil belajar terbang atau berpindah antaralam."
      Speaker = "Melinoe"
      Event = "AthenaAboutThessaly01"
    }
    {
      Id = "Athena_0283"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupuji kecerdikanmu... kau, atau siapa pun yang merancang rute ini, yang membalikkan pergerakan musuh menjadi keuntungan."
      Speaker = "Athena"
      Event = "AthenaAboutThessaly01"
    }
    {
      Id = "Athena_0284"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kengerian luar biasa telah menimpa puncak kebanggaan kita. Ini tak bisa ditoleransi... Aku bertanya-tanya pada diriku sendiri bagaimana aku bisa mencegahnya."
      Speaker = "Athena"
      Event = "AthenaAboutSummit01"
    }
    {
      Id = "MelinoeField_4442"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak punya jawaban yang bagus, Yang Mulia Athena. Olympus sedang menghadapi serangan terkoordinasi di banyak lini, dari udara, darat, dan laut. Para Automaton-mu hanya bisa berbuat semampu mereka."
      Speaker = "Melinoe"
      Event = "AthenaAboutSummit01"
    }
    {
      Id = "Athena_0285"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tapi kita {#Emph}selalu {#Prev}bisa berbuat lebih banyak sekalipun mesin-mesin tak berotak itu tidak bisa. Seharusnya kita bisa berbuat lebih banyak! Namun untuk saat ini... sebaiknya kita fokus pada jalan keluar, bukan pada penyebabnya."
      Speaker = "Athena"
      Event = "AthenaAboutSummit01"
    }
    {
      Id = "Athena_0286"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jadi ternyata benar, apa yang dikatakan Chronos... kemungkinan bahwa Typhon masih bertahan. Atau jangan-jangan Jimat Gorgon ini membuatku ikut membagikan halusinasimu sekarang."
      Speaker = "Athena"
      Event = "AthenaAboutSummit02"
    }
    {
      Id = "MelinoeField_4443"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semuanya terasa cukup nyata bagiku... terutama setelah menelusuri kembali jalanku sampai ke titik ini. Tapi kita bisa menghentikan ini di sini seperti yang kita lakukan sebelumnya."
      Speaker = "Melinoe"
      Event = "AthenaAboutSummit02"
    }
    {
      Id = "Athena_0287"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, itulah yang akan kita lakukan. Tidak ada alasan untuk mengubah strategi selama hal itu terus membuahkan hasil yang baik."
      Speaker = "Athena"
      Event = "AthenaAboutSummit02"
    }
    {
      Id = "Athena_0205"
      InheritFrom = "BaseNarrative"
      DisplayName = "Malam ini lebih gelap daripada malam-malam belakangan ini, dan musuh-musuh kita tampak semakin berani. Trik baru dari Chronos, atau... mungkin hanya imajinasiku saja karena sudah bertarung sekian lama."
      Speaker = "Athena"
      Event = "AthenaAboutShrine01"
    }
    {
      Id = "MelinoeField_2435"
      InheritFrom = "BaseNarrative"
      DisplayName = "Itu bukan imajinasimu, melainkan kehendak sang Malam itu sendiri, Nona Athena. Dan meski efeknya tampak merugikan kita untuk saat ini, kita akan bertambah kuat karenanya, aku pastikan itu."
      Speaker = "Melinoe"
      Event = "AthenaAboutShrine01"
    }
    {
      Id = "Athena_0206"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jaminan seperti itu biasanya tak berarti banyak bagiku, Sepupu. Tapi kau lebih paham tentang kegelapan daripada aku. Jika ini benar-benar kehendak sang Malam, dan bukan ulah musuh kita, baguslah kalau begitu."
      Speaker = "Athena"
      Event = "AthenaAboutShrine01"
    }
    {
      Id = "Athena_0172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa kau merasakan getaran yang kian membesar saat mendekat ke sini, Sepupu? Aku sama sekali tak menyukainya. Paman Poseidon awalnya bertingkah seolah itu perbuatannya, tapi bahkan dia sendiri tampaknya tak tahu dari mana asalnya..."
      Speaker = "Athena"
      Event = "AthenaAboutSurfaceThreat01"
    }
    {
      Id = "MelinoeField_2411"
      InheritFrom = "BaseNarrative"
      DisplayName = "Di Dunia Bawah, kami merasakan getaran gempa setiap saat, karena Bumi ada di sekeliling kami, hidup dan bernapas. Tapi aku terkejut getaran semacam itu bisa terasa sampai sejauh ini..."
      Speaker = "Melinoe"
      Event = "AthenaAboutSurfaceThreat01"
    }
    {
      Id = "Athena_0289"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin karena ini lebih dari sekadar Bumi yang hidup dan bernapas. Musuh kitalah dalang di balik semua ini, aku yakin sekali."
      Speaker = "Athena"
      Event = "AthenaAboutSurfaceThreat01"
    }
    {
      Id = "Athena_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertama-tama kau menaklukkan Chronos di alam ayahmu, lalu kau berhasil menggulingkan Typhon dari puncak gunung kami. Harus kuakui, aku meremehkanmu saat kita pertama kali bertemu."
      Speaker = "Athena"
      Event = "AthenaAboutUltimateProgress01"
    }
    {
      Id = "MelinoeField_3172"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku telah berlatih seumur hidupku demi kemungkinan ini, Nona Athena. Itulah yang sudah semestinya diharapkan dariku, dan lagi... perang kita belum usai."
      Speaker = "Melinoe"
      Event = "AthenaAboutUltimateProgress01"
    }
    {
      Id = "Athena_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau berlatih bersama Hekate untuk menaklukkan Chronos, aku tahu itu. Tapi Typhon tak pernah menjadi bagian dari menu latihanmu. Kendati demikian, aku pun tak menyukai pujian terutama ketika, seperti katamu, perang kita belum sepenuhnya dimenangkan."
      Speaker = "Athena"
      Event = "AthenaAboutUltimateProgress01"
    }
    {
      Id = "Athena_0220"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau memegang Senjata Malam. Aku sudah menduganya saat pertama kali kita bertemu, tapi sekarang keraguanku hilang. Jika Dunia Bawah terancam, senjata-senjata itu menjadi pilihan terakhir, baiklah. Tapi tampaknya mereka berada jauh di luar yurisdiksinya di sini."
      Speaker = "Athena"
      Event = "AthenaAboutWeapons01"
    }
    {
      Id = "MelinoeField_2444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bahaya yang dihadapi Dunia Bawah ternyata merembet sampai ke gunung ini. Bagiku sendiri, Senjata Nokturnal terbukti sama andalnya, baik di atas permukaan maupun di bawah sana."
      Speaker = "Melinoe"
      Event = "AthenaAboutWeapons01"
    }
    {
      Id = "Athena_0221"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pastikan kau mengendalikan kekuatan mereka dengan baik, begitu juga dengan rasa lapar mereka. Aku jauh lebih suka senjataku tak memiliki kehendak sendiri, tapi tak bisa dipungkiri kehebatannya."
      Speaker = "Athena"
      Event = "AthenaAboutWeapons01"
    }
    {
      Id = "Athena_0174"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kehadiranmu sangat melegakan, Melinoë, karena sudah beberapa malam berlalu sejak terakhir kali kita bertemu di medan tempur seperti ini. Bagaimana jalannya perang di bawah Bumi sana?"
      Speaker = "Athena"
      Event = "AthenaAboutTimePassing01"
    }
    {
      Id = "MelinoeField_2412"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih berkecamuk. Malam demi malam legiun sang Titan berkumpul kembali, sementara dia menegaskan dirinya tak bisa dihentikan. Tapi aku sedang berusaha membuktikan sebaliknya. Lalu bagaimana kabar di sini?"
      Speaker = "Melinoe"
      Event = "AthenaAboutTimePassing01"
    }
    {
      Id = "Athena_0175"
      InheritFrom = "BaseNarrative"
      DisplayName = "Gunung ini masih berdiri, seperti yang kau lihat, dan itulah yang terpenting. Mungkin kehadiranmu dan sedikit penyesuaian strategi akan membawa kita ke titik balik yang kita butuhkan."
      Speaker = "Athena"
      Event = "AthenaAboutTimePassing01"
    }
    {
      Id = "Athena_0309"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sudah lebih lama dari yang kuharapkan, Sepupu! Musuh kita berkerumun, dan belakangan ini aku harus menghadapi lebih banyak dari yang biasa kutangani."
      Speaker = "Athena"
      Event = "AthenaAboutTimePassing02"
    }
    {
      Id = "MelinoeField_4454"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maafkan aku, Nona Athena. Ada urusan yang menyita perhatianku dari Olympus, walau aku yakin kau dan yang lainnya akan tetap bertahan kukuh selagi aku pergi."
      Speaker = "Melinoe"
      Event = "AthenaAboutTimePassing02"
    }
    {
      Id = "Athena_0310"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan kami memang bertahan kukuh. Tapi saat kau berada di sini, kurasa kita bisa bertindak lebih dari sekadar bertahan, dan membalas serangan dengan semestinya."
      Speaker = "Athena"
      Event = "AthenaAboutTimePassing02"
    }
    {
      Id = "Athena_0194"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua peperangan ini menyita waktu kita untuk hal lain. Dulu aku suka menenun, tahu. Permadani megah dan banyak lagi! Semoga aku punya kesempatan untuk menekuninya lagi begitu semua ini usai. Dan kau sendiri, apa lagi yang mengisi waktumu?"
      Speaker = "Athena"
      Event = "AthenaAboutHobbies01"
    }
    {
      Id = "MelinoeField_2429"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku, yah... aku suka berlatih tanding! Mengasah ketajaman indra dan kekuatanku. Serta mendalami keahlianku. Soal ilmu sihir, mereka yang hidup, dan yang mati. Bagaimana semuanya saling terhubung."
      Speaker = "Melinoe"
      Event = "AthenaAboutHobbies01"
    }
    {
      Id = "Athena_0195"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku familier dengan ilmu sihir, ya. Walau begitu, semua itu terdengar seperti persiapan untuk masalah yang sedang kau coba selesaikan sekarang! Tapi kusadari ini bukan saatnya berkhayal, atau bahkan membicarakannya."
      Speaker = "Athena"
      Event = "AthenaAboutHobbies01"
    }
    {
      Id = "Athena_0176"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau terluka, Sepupu... meski aku tak seharusnya heran. Pendakian yang melelahkan untuk sampai ke titik ini, dan kau juga menyeberangi Celah Thessaly. Apa kau baik-baik saja?"
      Speaker = "Athena"
      Event = "AthenaLowHealth01"
    }
    {
      Id = "MelinoeField_2413"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku masih bisa terus maju dalam kondisi begini, Nona Athena. Meski apakah kekuatanku cukup untuk mengungguli Prometheus, apalagi apa pun yang menanti di balik sana... itu tak bisa kujamin."
      Speaker = "Melinoe"
      Event = "AthenaLowHealth01"
    }
    {
      Id = "Athena_0177"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dalam perang tak ada jaminan selain pertumpahan darah, seperti yang pasti ditegaskan oleh Ares, di mana pun ia kini bersuka ria. Sekarang mari kembalikan kondisimu ke kebugaran tempur yang semestinya."
      Speaker = "Athena"
      Event = "AthenaLowHealth01"
    }
    {
      Id = "Athena_0288"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ada sesuatu untukmu di sini, Sepupu. Mengingat kau tetap berperan penting dalam pertahanan gunung kita yang terus berlangsung."
      Speaker = "Athena"
      Event = "AthenaGrantsReward01"
    }
    {
      Id = "MelinoeField_4444"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku merasa terhormat, Nona Athena. Keluarga seperti kita semestinya bersatu di saat-saat genting. Aku hanya ingin menjalankan bagianku."
      Speaker = "Melinoe"
      Event = "AthenaGrantsReward01"
    }
    {
      Id = "Athena_0230"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau telah membuat takjub bukan hanya diriku, tapi segenap kerabat kita; sebagian besar dari mereka, tepatnya. Dan untuk itu, kulimpahkan kekuatan terbesarku padamu. Semoga ini segera mendatangkan kemenangan-kemenangan yang lebih gemilang."
      Speaker = "Athena"
      Event = "AthenaGrantsReward01"
    }
    {
      Id = "Athena_0290"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kita telah meraih kemenangan besar, Sepupu. Kendati pembinasaan musuh bisa menjadi hasil yang berguna dalam perang, penyerahan diri sering kali lebih disukai. Kupikir yang lain sudah menyampaikan rasa terima kasih mereka?"
      Speaker = "Athena"
      Event = "AthenaPostTrueEnding01"
    }
    {
      Id = "MelinoeField_4445"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ya, tentu saja. Dan selamat untuk kalian semua, Nona Athena. Satu-satunya penyesalanku adalah pengepungan ini tidak bisa langsung berhenti seketika, mengingat apa yang masih harus diselesaikan."
      Speaker = "Melinoe"
      Event = "AthenaPostTrueEnding01"
    }
    {
      Id = "Athena_0291"
      InheritFrom = "BaseNarrative"
      DisplayName = "Buang jauh-jauh penyesalan itu, sebab cecunguk yang masih mengotori Olympus bukanlah apa-apa. Mengenai Prometheus, meski aku skeptis terhadap perannya dalam strategi baru ini, aku telah membujuk Ayah untuk menyetujuinya, untuk saat ini..."
      Speaker = "Athena"
      Event = "AthenaPostTrueEnding01"
    }
    {
      Id = "Athena_0292"
      InheritFrom = "BaseNarrative"
      DisplayName = "Sekarang kau harus menghadapi sisa-sisa jejak musuh bebuyutan kita, baik di puncak maupun di Tartarus... menciptakan kembali jalur yang membawamu ke sana, seolah berbagai kemungkinan perlu diselaraskan...?"
      Speaker = "Athena"
      Event = "AthenaPostTrueEnding02"
    }
    {
      Id = "MelinoeField_4446"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kurang lebih begitulah penjelasan kakek kita. Seolah-olah kita sedang mengakali kemungkinan-kemungkinan hasil akhir di mana kita bisa saja gagal karena satu dan lain hal."
      Speaker = "Melinoe"
      Event = "AthenaPostTrueEnding02"
    }
    {
      Id = "Athena_0293"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begitu, kemungkinan hasil semacam itu semestinya sangat sedikit. Karena kita tidak pernah gagal; kita hanya meluangkan waktu yang diperlukan untuk mencapai keberhasilan."
      Speaker = "Athena"
      Event = "AthenaPostTrueEnding02"
    }
    {
      Id = "Athena_0299"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku lega mengetahui keluargamu di Dunia Bawah aman, begitu pula Nyx dan mereka yang mengabdi pada Wangsa Hades. Terlepas dari segala kemelut di sini, setidaknya kita tidak terpecah belah... melebihi biasanya."
      Speaker = "Athena"
      Event = "AthenaPostTrueEnding03"
    }
    {
      Id = "MelinoeField_4450"
      InheritFrom = "BaseNarrative"
      DisplayName = "Chronos melampiaskan murkanya pada ayahku, tapi ibuku dan yang lainnya langsung dikurung dalam sekejap... dibekukan dalam waktu. Mereka terbangun tanpa tahu-menahu soal semua cobaan ini."
      Speaker = "Melinoe"
      Event = "AthenaPostTrueEnding03"
    }
    {
      Id = "Athena_0300"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mungkin merekalah yang paling beruntung di antara kita semua. Meski kita harus bersabar menghadapi rentetan pertanyaan mereka nanti."
      Speaker = "Athena"
      Event = "AthenaPostTrueEnding03"
    }
    {
      Id = "Athena_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "Istana ayahku sekarang ditutup untuk perombakan, kemungkinan besar serupa dengan apa yang sedang berlangsung di alam ayah{#Emph}mu{#Prev}... membuatmu tak punya tempat beristirahat setelah jerih payah semalaman."
      Speaker = "Athena"
      Event = "AthenaAboutPalace01"
    }
    {
      Id = "MelinoeField_4451"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tidak apa-apa, Nona Athena. Aku memang tak boleh berlama-lama di sini, dan pemulihanku jauh lebih cepat di tempat asalku."
      Speaker = "Melinoe"
      Event = "AthenaAboutPalace01"
    }
    {
      Id = "Athena_0302"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau bertarung seolah tanpa beban, tapi aku tahu permukaan ini menguras tenagamu. Sungguh mengagumkan caramu belajar meredam kelemahan garis keturunanmu yang digariskan Takdir ini."
      Speaker = "Athena"
      Event = "AthenaAboutPalace01"
    }
    {
      Id = "Athena_0294"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Aku sempat memikirkan langkah kita seandainya Tiga Dewi Takdir tak pernah ditemukan. Yang tak kuduga adalah mereka {#Emph}berhasil{#Prev} ditemukan, tapi tetap saja lepas tangan dari tanggung jawab mereka... setidaknya begitu kabar yang kudengar."
      Speaker = "Athena"
      Event = "AthenaPostEpilogue01"
    }
    {
      Id = "MelinoeField_4447"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka sudah menenun selama ribuan zaman, mungkin merasa jenuh atau bahkan kurang dihargai. Atau barangkali, mereka menyukai apa yang mereka lihat saat tenunan mereka tertunda. Mereka memang memberi kita ramalan baru yang besar sebagai semacam hadiah perpisahan."
      Speaker = "Melinoe"
      Event = "AthenaPostEpilogue01"
    }
    {
      Id = "Athena_0295"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ramalan tentang zaman baru, bahwa kita para dewa akan menyerahkan kekuasaan pada manusia fana... sulit dipercaya. Tapi tentu saja, hal-hal semacam ini tak pernah terwujud persis seperti apa yang tersurat."
      Speaker = "Athena"
      Event = "AthenaPostEpilogue01"
    }
    {
      Id = "MelinoeField_4448"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benar... lagipula, aku tak bisa memastikan apakah para Moira marah, kecewa, atau semacamnya... sebaliknya, mereka malah tampak bersemangat."
      Speaker = "Melinoe"
      Event = "AthenaPostEpilogue01"
    }
    {
      Id = "Athena_0296"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka adalah penenun, yang permadaninya menyingkap bentangan kisah sejarah nan rumit. Mungkin mereka sekadar ingin mencari hiburan, dan kita hanyalah karakter bidak yang mesti mereka olah."
      Speaker = "Athena"
      Event = "AthenaPostEpilogue01"
    }
    {
      Id = "Athena_0297"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu banyak pertempuran telah dilalui dan masih banyak yang menanti. Namun kita para dewi tak kenal lelah. Kau bisa mengandalkanku selama kau memilih untuk terus maju."
      Speaker = "Athena"
      Event = "AthenaPostEpilogue02"
    }
    {
      Id = "MelinoeField_4449"
      InheritFrom = "BaseNarrative"
      DisplayName = "Memilih untuk maju... terkadang aku merasa ini kewajiban, Nona Athena. Ancaman kemungkinan dari Typhon dan Chronos... siapa lagi yang akan menghentikan mereka jika bukan kita?"
      Speaker = "Melinoe"
      Event = "AthenaPostEpilogue02"
    }
    {
      Id = "Athena_0298"
      InheritFrom = "BaseNarrative"
      DisplayName = "Strategi yang matang menuntut kehati-hatian dalam segala hal, namun juga harus mampu beradaptasi jika situasi mendesak. Mari kita perhitungkan sebanyak mungkin kemungkinan, tapi jangan sampai mengorbankan urusan penting lainnya."
      Speaker = "Athena"
      Event = "AthenaPostEpilogue02"
    }
    {
      Id = "MelinoeField_4455"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang sekali selalu bisa berjumpa denganmu, Nona Athena. Engkau benar-benar tak kenal lelah dalam perjuangan panjang ini."
      Speaker = "Melinoe"
      Event = "AthenaAboutSayingLittle01"
    }
    {
      Id = "Athena_0311"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bisa dibilang bukan beban lagi saat ini, tapi aku pun senang berjumpa denganmu, Sepupu. Pertemuan ini menyajikan selingan yang menenangkan daripada harus membasmi musuh-musuh kita tanpa ampun."
      Speaker = "Athena"
      Event = "AthenaAboutSayingLittle01"
    }
    {
      Id = "Athena_0006"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kupastikan area ini tetap aman untuk sekarang; teruslah merangsek maju!"
      Speaker = "Athena"
      Event = "AthenaChat01"
    }
    {
      Id = "Athena_0007"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lanjutkan pendakianmu, biar kutangani gerombolan yang mengatasnamakan bala tentara sang Titan."
      Speaker = "Athena"
      Event = "AthenaChat02"
    }
    {
      Id = "Athena_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mereka tak pernah kapok, ya? Tapi mereka juga tak pernah berhenti datang."
      Speaker = "Athena"
      Event = "AthenaChat03"
    }
    {
      Id = "Athena_0009"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap pertahanan kami di sini tidak terlalu merepotkan langkahmu."
      Speaker = "Athena"
      Event = "AthenaChat04"
    }
    {
      Id = "Athena_0010"
      InheritFrom = "BaseNarrative"
      DisplayName = "Saat keluarga kita bersatu, tak ada aral rintang yang tak bisa kita lalui."
      Speaker = "Athena"
      Event = "AthenaChat05"
    }
    {
      Id = "Athena_0011"
      InheritFrom = "BaseNarrative"
      DisplayName = "Murkaku masih cukup untuk membabat habis siapa pun yang kau hadapi dalam perjalanan ke puncak."
      Speaker = "Athena"
      Event = "AthenaChat06"
    }
    {
      Id = "Athena_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bergegaslah menuju Istana, Sepupu, dan berkatku menyertaimu."
      Speaker = "Athena"
      Event = "AthenaChat07"
    }
    {
      Id = "Athena_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "Satu lagi kemenangan di depan mata; raihlah, dan aku akan melindungi pergerakanmu."
      Speaker = "Athena"
      Event = "AthenaChat08"
    }
    {
      Id = "Athena_0014"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pertempuran masih berkecamuk di sekeliling kita, Melinoë. Mari kita tuntaskan apa yang dimulai musuh kita."
      Speaker = "Athena"
      Event = "AthenaChat09"
    }
    {
      Id = "Athena_0015"
      InheritFrom = "BaseNarrative"
      DisplayName = "Benteng gunung kita ini takkan pernah runtuh, sekeras apa pun upaya sang Titan."
      Speaker = "Athena"
      Event = "AthenaChat10"
    }
    {
      Id = "Athena_0016"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dakilah terus, Sepupu, dan semoga pijakan kakimu tak pernah goyah di sepanjang jalan."
      Speaker = "Athena"
      Event = "AthenaChat11"
    }
    {
      Id = "Athena_0017"
      InheritFrom = "BaseNarrative"
      DisplayName = "Cepatlah melangkah tapi tetap waspada; ayahku dan yang lainnya menunggumu di puncak."
      Speaker = "Athena"
      Event = "AthenaChat12"
    }
    {
      Id = "Athena_0018"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku bersyukur kau kembali, agar tahap rencana kita berikutnya bisa mulai dijalankan."
      Speaker = "Athena"
      Event = "AthenaChat13"
    }
    {
      Id = "Athena_0019"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaulah bala bantuan terbaik yang kami butuhkan, dan aku selalu bersyukur atas kehadiranmu."
      Speaker = "Athena"
      Event = "AthenaChat14"
    }
    {
      Id = "Athena_0020"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kuharap kita bisa bertarung berdampingan, namun kita meraih hasil lebih banyak dengan berpencar."
      Speaker = "Athena"
      Event = "AthenaChat15"
    }
    {
      Id = "Athena_0021"
      InheritFrom = "BaseNarrative"
      DisplayName = "Musuh mengerumuni kita laksana serangga, dan kita akan membasmi mereka sebagaimana mestinya."
      Speaker = "Athena"
      Event = "AthenaChat16"
    }
    {
      Id = "Athena_0022"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah tahu bisa mengandalkan kehadiranmu malam ini tepat pada waktunya."
      Speaker = "Athena"
      Event = "AthenaChat17"
    }
    {
      Id = "Athena_0023"
      InheritFrom = "BaseNarrative"
      DisplayName = "Masih banyak kemenangan semacam ini yang harus kita raih sebelum perang kita benar-benar usai."
      Speaker = "Athena"
      Event = "AthenaChat18"
    }
    {
      Id = "Athena_0024"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak cukup hanya dengan menundukkan musuh-musuh kita; mari kita jadikan mereka peringatan nyata bagi yang lain."
      Speaker = "Athena"
      Event = "AthenaChat19"
    }
    {
      Id = "Athena_0025"
      InheritFrom = "BaseNarrative"
      DisplayName = "Puncak Olympus menanti; pergilah, dan kupastikan punggungmu tetap aman."
      Speaker = "Athena"
      Event = "AthenaChat20"
    }
    {
      Id = "Athena_0026"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu ada urusan yang harus kautuntaskan di Dunia Bawah, jadi terima kasih sudah hadir di sini."
      Speaker = "Athena"
      Event = "AthenaChat21"
    }
    {
      Id = "Athena_0027"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keahlianmu sendirilah yang membawamu sejauh ini, meski mungkin aku bisa sedikit membantu."
      Speaker = "Athena"
      Event = "AthenaChat22"
    }
    {
      Id = "Athena_0028"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar para musuh menyesali saat-saat mereka berani menentang kami, para dewa."
      Speaker = "Athena"
      Event = "AthenaChat23"
    }
    {
      Id = "Athena_0029"
      InheritFrom = "BaseNarrative"
      DisplayName = "Seolah Sang Rembulan sendirilah yang menuntunku ke posisimu malam ini."
      Speaker = "Athena"
      Event = "AthenaChat24"
    }
    {
      Id = "Athena_0030"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga kita telah bertahan selama berabad-abad; badai ini pun akan berlalu, sama seperti yang lainnya."
      Speaker = "Athena"
      Event = "AthenaChat25"
    }
    {
      Id = "Athena_0031"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semua orang yang berani menentang kita ataupun takhta sah kita takkan diberi ampun."
      Speaker = "Athena"
      Event = "AthenaChat26"
    }
    {
      Id = "Athena_0032"
      InheritFrom = "BaseNarrative"
      DisplayName = "Segeralah menuju Istana dan aku akan melindungimu dari belakang, Melinoë."
      Speaker = "Athena"
      Event = "AthenaChat27"
    }
    {
      Id = "Athena_0033"
      InheritFrom = "BaseNarrative"
      DisplayName = "Apa gunanya siasat brilian tanpa keahlian yang mumpuni untuk mewujudkannya?"
      Speaker = "Athena"
      Event = "AthenaChat28"
    }
    {
      Id = "Athena_0034"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pasukan sang Titan tak mengenal rasa takut, namun kuyakin mereka masih bisa diberi pelajaran."
      Speaker = "Athena"
      Event = "AthenaChat29"
    }
    {
      Id = "Athena_0035"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga Berkah yang kuberikan ini mampu menjadi penentu dalam pertempuran-pertempuran mendatang."
      Speaker = "Athena"
      Event = "AthenaChat30"
    }
    {
      Id = "Athena_0318"
      InheritFrom = "BaseNarrative"
      DisplayName = "Pilihlah lekas, Sepupu, masih ada segerombolan tamu tak diundang yang sebaiknya kuadang."
      Speaker = "Athena"
      Event = "AthenaChat31"
    }
    {
      Id = "Athena_0319"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, ini jelas suasana yang sangat berbeda dari Gunung Olympus, bukan?"
      Speaker = "Athena"
      Event = "AthenaChat32"
    }
    {
      Id = "Athena_0320"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bila suatu saat aku muak dengan Olympus, sekali melihat tempat {#Emph}ini{#Prev} pasti membuatku mendambakannya kembali."
      Speaker = "Athena"
      Event = "AthenaChat33"
    }
    {
      Id = "Athena_0321"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kemenanganmu semalam meramalkan kemenangan lain yang akan segera tiba, terutama karena kini aku ada di sini."
      Speaker = "Athena"
      Event = "AthenaChat34"
    }
    {
      Id = "Athena_0322"
      InheritFrom = "BaseNarrative"
      DisplayName = "Para musuh kita mestinya sudah sadar bahwa mereka sama sekali tak berpeluang melawan kita lagi."
      Speaker = "Athena"
      Event = "AthenaChat35"
    }
    {
      Id = "Athena_0323"
      InheritFrom = "BaseNarrative"
      DisplayName = "Udara terasa mencekam, dan musuh-musuh kita dialiri kekuatan baru. Kita harus waspada."
      Speaker = "Athena"
      Event = "AthenaChat36"
    }
    {
      Id = "Athena_0258"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan sisakan jejak apa pun dari sang Ayah Segala Monster, atas segala derita yang telah ia timbulkan."
      Speaker = "Athena"
      Event = "AthenaChat37"
    }
    {
      Id = "Athena_0259"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika ini cara yang harus kita tempuh demi menegaskan kedigdayaan kita untuk masa-masa mendatang, jadilah demikian."
      Speaker = "Athena"
      Event = "AthenaChat38"
    }
    {
      Id = "Athena_0260"
      InheritFrom = "BaseNarrative"
      DisplayName = "Andai saja aku bisa berada di beberapa tempat sekaligus, namun pilihanku singgah di sini sungguh tepat."
      Speaker = "Athena"
      Event = "AthenaChat39"
    }
    {
      Id = "Athena_0261"
      InheritFrom = "BaseNarrative"
      DisplayName = "Keluarga kita sudah mendekati sempurna, namun marilah berikhtiar agar menjadi kian hebat lagi."
      Speaker = "Athena"
      Event = "AthenaChat40"
    }
    {
      Id = "Athena_0262"
      InheritFrom = "BaseNarrative"
      DisplayName = "Senang melihat wajah yang tak asing. Menghalau legiun sang Titan sendirian bisa terasa begitu hampa."
      Speaker = "Athena"
      Event = "AthenaChat41"
    }
    {
      Id = "Athena_0263"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiap pertempuran seperti ini bukan apa-apa; kendati demikian kita harus pandai mengatur tenaga demi perjuangan panjang."
      Speaker = "Athena"
      Event = "AthenaChat42"
    }
    {
      Id = "Athena_0264"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tentu bisa membereskan semua bajingan keparat itu seorang diri tanpa kesulitan."
      Speaker = "Athena"
      Event = "AthenaChat43"
    }
    {
      Id = "Athena_0265"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu berbasa-basi panjang lebar. Mari kita fokus pada tugas masing-masing."
      Speaker = "Athena"
      Event = "AthenaChat44"
    }
    {
      Id = "Athena_0266"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah menduga kau akan segera kembali. Kuharap urusan di Dunia Bawah berjalan lancar."
      Speaker = "Athena"
      Event = "AthenaChat45"
    }
    {
      Id = "Athena_0267"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak bisa menjangkau Dunia Bawahmu dengan mudah ataupun berlama-lama di sana, tapi kutahu kau bisa mengendalikannya dengan baik."
      Speaker = "Athena"
      Event = "AthenaChat46"
    }
    {
      Id = "Athena_0268"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jangan lupakan Jimat milikku bila kau membutuhkanku di tempat lain, Sepupu."
      Speaker = "Athena"
      Event = "AthenaChat47"
    }
    {
      Id = "Athena_0269"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga semua pihak yang mengancam takhta ilahi kita diganjar derita berlipat sepuluh atas kecongkakan mereka."
      Speaker = "Athena"
      Event = "AthenaChat48"
    }
    {
      Id = "MelinoeField_2416"
      InheritFrom = "BaseNarrative"
      DisplayName = "Lady Athena, selagi ada waktu luang, aku ingin mempersembahkan Nektar ini sebagai tanda terima kasihku. Andai kutahu kita akan bertemu di sini, mungkin aku akan tiba lebih awal."
      Speaker = "Melinoe"
      Event = "AthenaGift01"
    }
    {
      Id = "Athena_0180"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tak perlu merasa bersalah, sebab kuyakin kau menempuh perjalanan ke sini secepat yang kau bisa. Tentu saja kuterima persembahanmu ini, walau akan kusimpan sampai kemenangan kita tercapai. Tapi {#Emph}yang satu ini{#Prev}, mungkin bisa berguna untukmu lebih cepat..."
      Speaker = "Athena"
      Event = "AthenaGift01"
    }
    {
      Id = "Athena_0181"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hah. {#Prev}Meski sudah kupikirkan segala kemungkinan, menikmati Nektar di tengah kecamuk konflik ini rasanya sungguh tak masuk akal. Namun, setidaknya ada hal manis yang patut dinantikan."
      Speaker = "Athena"
      Event = "AthenaGift02"
    }
    {
      Id = "MelinoeField_2418"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bila ini hal yang patut dinantikan, berarti ini hadiah yang jauh lebih berharga dari dugaanku. Meneguk Nektar di kala damai... terdengar begitu menyenangkan."
      Speaker = "Melinoe"
      Event = "AthenaGift02"
    }
    {
      Id = "Athena_0182"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau tak perlu repot-repot bersikap begini. Para manusia fana yang berperang kerap memberiku persembahan demi memohon petunjuk kemenangan. Namun kau dan aku punya satu tujuan yang sama, jadi aku tak membutuhkan iming-iming semacam itu di antara kita."
      Speaker = "Athena"
      Event = "AthenaGift03"
    }
    {
      Id = "MelinoeField_2419"
      InheritFrom = "BaseNarrative"
      DisplayName = "Ini bukan iming-iming, melainkan sekadar ungkapan terima kasih. Karena telah menerimaku, dan mengakui potensi apa pun yang kupunya demi membantu keluarga kita di saat genting."
      Speaker = "Melinoe"
      Event = "AthenaGift03"
    }
    {
      Id = "Athena_0183"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau menghormatiku, dan kuterima terima kasihmu. Nektar ini, sudah menjelajah ke Dunia Bawah dan kembali lagi... bersamamu. Menurut perkiraanku, cita rasanya pasti akan menjadi sangat kaya dan kompleks."
      Speaker = "Athena"
      Event = "AthenaGift04"
    }
    {
      Id = "MelinoeField_2420"
      InheritFrom = "BaseNarrative"
      DisplayName = "Jika botol ini memang berkelana sampai ke ujung dunia sebelum pulang ke rumah, berarti anggur ini kian pantas untuk seseorang dengan kebijaksanaan dan pengalaman sepertimu. Semoga kau bisa menikmatinya begitu kau meletakkan senjatamu kelak."
      Speaker = "Melinoe"
      Event = "AthenaGift04"
    }
    {
      Id = "Athena_0184"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kalau begini terus, suatu hari nanti kita mungkin bisa menggelar pesta pora yang menyaingi pesta buatan Dionisos sendiri! Maka mari kita berjuang sekuat tenaga demi mewujudkan kemungkinan yang memikat itu."
      Speaker = "Athena"
      Event = "AthenaGift05"
    }
    {
      Id = "MelinoeField_2421"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga masa depan di mana kau punya cukup waktu untuk berpesta segera tiba, bukan hanya memikirkan strategi militer. Meski begitu, aku tak ingin melihatmu bertanding melawan Dionisos, bahkan dalam urusan merancang pesta!"
      Speaker = "Melinoe"
      Event = "AthenaGift05"
    }
    {
      Id = "Athena_0237"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kau mungkin mengira dikelilingi keluarga berarti dikelilingi orang-orang yang sepemikiran, tapi nyatanya... tidak banyak penghuni Olimpus yang berpikir seperti diriku. Bahkan tak ada satu pun, berani kukatakan. Namun dirimu... ya, satu perbedaannya adalah, aku tak akan sudi memberikan Nektar di saat-saat genting seperti ini."
      Speaker = "Athena"
      Event = "AthenaGift06"
    }
    {
      Id = "MelinoeField_2422"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dewi Athena, suatu kehormatan bagiku bisa ikut bertarung bersamamu, serta mendapatkan berkat dan kepercayaanmu. Terkadang aku luput mengungkapkan rasa terima kasihku, jadi aku mengandalkan Nektar ini untuk menyampaikannya atas namaku."
      Speaker = "Melinoe"
      Event = "AthenaGift06"
    }
    {
      Id = "Athena_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "Biar sejarah mencatat bahwa kita adalah dewi-dewi yang mengutamakan tindakan, bukan sekadar kata-kata; dan kuterima pemberianmu yang penuh perhatian ini, meski waktunya agak kurang tepat. Tapi, biarlah ini menjadi yang terakhir sampai musuh-musuh kita semua binasa."
      Speaker = "Athena"
      Event = "AthenaGift06"
    }
    {
      Id = "MelinoeField_2423"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja."
      Speaker = "Melinoe"
      Event = "AthenaGift06"
    }
    {
      Id = "MelinoeField_4427"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku punya hadiah yang cukup bermakna untukmu, Dewi Athena, karena aku tahu Ambrosia akan segera mengalir berlimpah lagi di Olimpus. Semoga botol khusus ini bisa menyumbang pemulihan itu, sekaligus mengingatkanmu akan kemenangan kita."
      Speaker = "Melinoe"
      Event = "AthenaGift07"
    }
    {
      Id = "Athena_0245"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tak butuh pengingat akan kemenangan kita, begitu pula kemurahan hatimu tak akan dilupakan selama atau sesudah pemulihan yang pasti akan terwujud nanti. Apa jadinya kami jika bukan karenamu...?"
      Speaker = "Athena"
      Event = "AthenaGift07"
    }
    {
      Id = "MelinoeField_4428"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kaum Olimpus telah berkuasa selama berabad-abad, mengatasi ancaman dan rintangan yang tak terhitung jumlahnya. Semua ini hanyalah ujian lain; kalian pasti akan menemukan jalannya. {#Emph}Terutama {#Prev}dirimu."
      Speaker = "Melinoe"
      Event = "AthenaGift07"
    }
    {
      Id = "Athena_0246"
      InheritFrom = "BaseNarrative"
      DisplayName = "Begitu lihai menepis pujian bahkan tanpa Berkat dariku. Kalau begitu, baiklah! Kurasa lebih baik rendah hati daripada bersikap congkak. Tapi kau mungkin bisa membidik posisi di antara keduanya. Entah itu, atau kamilah yang seharusnya lebih meniru dirimu."
      Speaker = "Athena"
      Event = "AthenaGift07"
    }
    {
      Id = "MelinoeField_4429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita tetap menjadi diri kita masing-masing."
      Speaker = "Melinoe"
      Event = "AthenaGift07"
    }
    {
