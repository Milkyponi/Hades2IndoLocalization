{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _EnemyData_TyphonHead.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Chronos_1065"
      InheritFrom = "BaseNarrative"
      DisplayName = "Maaf mengganggu, Cucu Perempuan, tapi aku datang untuk melihat sendiri hasil kerja rekan monstirku di puncak suci ini. Soalnya selama ini aku cuma dengar ceritanya!"
      Speaker = "Chronos"
      Event = "TyphonBossAltFight01"
    }
    {
      Id = "MelinoeField_3783"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku tahu alasan sebenarnya kenapa kau ada di sini pada malam seperti ini. Yah, aku sudah terbiasa menghadapi dirimu {#Emph}dan {#Prev}Typhon. Meski mungkin tidak secara bersamaan..."
      Speaker = "Melinoe"
      Event = "TyphonBossAltFight01"
    }
    {
      Id = "Chronos_1066"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh jangan takut, karena saat ini aku hanyalah wujud penampakan yang tak berbahaya. {#Emph}Tak berbahaya{#Prev}, dalam artian kau tak bisa melukai {#Emph}diriku {#Prev}sama sekali. Tapi kalau sebaliknya... yah, lihat saja nanti."
      Speaker = "Chronos"
      Event = "TyphonBossAltFight01"
    }
    {
      Id = "Chronos_1231"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana bisa kau begitu yakin punya kemampuan untuk mengatasi kami berdua? Padahal kekuatanku yang luar biasa {#Emph}ini {#Prev}saja tak ada apa-apanya dibanding sang {#Emph}Bapa Segala Monster!"
      Speaker = "Chronos"
      Event = "TyphonBossAltFight02"
    }
    {
      Id = "MelinoeField_3784"
      InheritFrom = "BaseNarrative"
      DisplayName = "Aku sudah pernah mengalahkan kalian masing-masing sebelumnya. Tak ada alasan kenapa aku tak bisa melakukannya lagi. Kalian berdua paling-paling cuma saling menghalangi jalan."
      Speaker = "Melinoe"
      Event = "TyphonBossAltFight02"
    }
    {
      Id = "Chronos_1232"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kukira Typhon takkan merasa {#Emph}terganggu {#Prev}olehku. Tapi soal {#Emph}dirimu{#Prev}, gadis kecil... yah, sebentar lagi akan kita buktikan."
      Speaker = "Chronos"
      Event = "TyphonBossAltFight02"
    }
    {
      Id = "Chronos_1233"
      InheritFrom = "BaseNarrative"
      DisplayName = "Mustahil atau setidaknya benar-benar konyol membayangkan kau entah bagaimana mampu menundukkan monster Typhon di sini, sementara diriku sendiri terus mendesakmu dengan berbagai jurusku! Tapi kau takkan seberuntung itu lagi."
      Speaker = "Chronos"
      Event = "TyphonBossAltFight03"
    }
    {
      Id = "MelinoeField_3785"
      InheritFrom = "BaseNarrative"
      DisplayName = "Dan apa yang membuatmu berpikir begitu? Kau cuma berada di sini karena kehendak Malam membawamu langsung ke hadapanku agar aku bisa membereskan kalian berdua sekaligus."
      Speaker = "Melinoe"
      Event = "TyphonBossAltFight03"
    }
    {
      Id = "Chronos_1234"
      InheritFrom = "BaseNarrative"
      DisplayName = "Omong kosong sihir dan {#Emph}kebohongan! {#Prev}Wujud penampakan yang kau lihat ini ada sepenuhnya karena kehendakku sendiri! Lancang sekali berpikir kau bisa memanggil sosok sepertiku sesuka {#Emph}hatimu!"
      Speaker = "Chronos"
      Event = "TyphonBossAltFight03"
    }
    {
      Id = "Chronos_1235"
      InheritFrom = "BaseNarrative"
      DisplayName = "Berapa kali lagi kau berniat menyeret penampakanku jauh-jauh ke sini? Walau harus kuakui, melakukan ini sama sekali tak membuang tenagaku sedikit pun!"
      Speaker = "Chronos"
      Event = "TyphonBossAltFight04"
    }
    {
      Id = "MelinoeField_3786"
      InheritFrom = "BaseNarrative"
      DisplayName = "Baguslah, lagipula aku tak ingin merepotkanmu, Kakek; di usiamu sekarang kau harusnya santai-santai di suatu tempat. Kudengar Kepulauan Kaum Terberkati sangat nyaman!"
      Speaker = "Melinoe"
      Event = "TyphonBossAltFight04"
    }
    {
      Id = "Chronos_1236"
      InheritFrom = "BaseNarrative"
      DisplayName = "Oh, aku belum berniat pensiun, gadis kecil. Justru {#Emph}kau {#Prev}yang harus mulai memikirkannya baik-baik."
      Speaker = "Chronos"
      Event = "TyphonBossAltFight04"
    }
    {
      Id = "MelinoeField_3790"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sialan kau{#Prev}, Chronos! Begitu aku selesai dengan Typhon, aku akan memburumu, {#Emph}Chronos!"
      Speaker = "Melinoe"
      Event = "TyphonAltFightFinalRound01"
    }
    {
      Id = "MelinoeField_3791"
      InheritFrom = "BaseNarrative"
      DisplayName = "Kembalikan aku seperti semula sekarang juga, atau akan kulenyapkan kau dari muka bumi, Titan!"
      Speaker = "Melinoe"
      Event = "TyphonAltFightFinalRound02"
    }
    {
      Id = "Chronos_1162"
      InheritFrom = "BaseNarrative"
      DisplayName = "Wah, betapa {#Emph}menakutkannya. {#Prev}Tapi sungguh tak pantas bagi seorang anak bicara sekasar itu kepada kakeknya... jadi kau harus {#Emph}dihukum."
      Speaker = "Chronos"
      Event = "TyphonAltFightFinalRound02"
    }
    {
      Id = "MelinoeField_3792"
      InheritFrom = "BaseNarrative"
      DisplayName = "Bagaimana mungkin ini terjadi? Aku bukan lagi anak kecil seperti dulu, tapi..."
      Speaker = "Melinoe"
      Event = "TyphonAltFightFinalRound03"
    }
    {
      Id = "MelinoeField_3793"
      InheritFrom = "BaseNarrative"
      DisplayName = "Terkekehlah bersama monster itu sesukamu, Titan, tapi tawa terakhir akan tetap jadi milikku seorang!"
      Speaker = "Melinoe"
      Event = "TyphonAltFightFinalRound04"
    }
    {
      Id = "MelinoeField_3186"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seranganku menembus tapi..."
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3188"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa ini benar-benar mempan...?"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3192"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa dia mulai melemah...?"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3190"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia kuat tapi {#Emph}tidak {#Prev}kebal...!"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3191"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku harus terus menguras tenaganya...!"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di mana Tuan Zeus...?"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, Tuan Zeus..."
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Zeus harusnya segera sampai..."
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kapan saja boleh{#Prev}, Tuan Zeus...!"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Di mana Paman Zeus...?"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3193"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia semakin marah... atau malah melemah...!"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3194"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia takkan bertahan selamanya..."
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3195"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia melemah, aku bisa merasakannya...!"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3196"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia mulai melemah...!"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3197"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tenaganya mulai terkuras...!"
      Speaker = "Melinoe"
      Event = "TyphonHead.OnHitVoiceLines"
    }
    {
      Id = "MelinoeField_3220"
      InheritFrom = "BaseSubtitle"
