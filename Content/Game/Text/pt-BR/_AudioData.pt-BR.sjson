      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_1127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biasanya aku menyukai ular..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_1134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Telanlah {#Emph}itu{#Prev}."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_1135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Arwah-arwah penasaran, enyahlah..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_1136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berapa banyak manusia fana yang sudah kau siksa?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_1137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mereka takkan pergi lama..."
