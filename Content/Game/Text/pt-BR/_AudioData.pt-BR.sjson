      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_0168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lain kali menetaplah di lautan."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_0169"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makhluk menjijikkan..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_3022"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku juga bisa menyengat."
