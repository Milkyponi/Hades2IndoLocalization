    {
      Id = "MelinoeField_1861"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Masih lapar, Charybdis?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.CharybdisEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_1862"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali dari dasar samudra, rupanya."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.CharybdisEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_1864"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebenarnya berapa banyak tentakel yang dimiliki makhluk ini...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.CharybdisEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_1865"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau takkan bisa menghentikan{#Emph}ku{#Prev}, Charybdis!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.CharybdisEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2466"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wah, kau pasti Talos. Tolong katakan kalau kau lebih pintar dari Otomaton lain di sekitar sini?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TalosEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Anggap saja jawabannya sama sekali tidak!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TalosEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_5682"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bahkan di dalam mimpiku pun kalian para Otomaton tak bisa bersikap baik..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TalosEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ingat aku, Talos? Atau mau langsung menyerangku begitu saja..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TalosEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2470"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku ingin bicara sepatah dua patah kata dengan Tuan Hefaistos tentang dirimu."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TalosEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mungkin tak paham sepatah kata pun yang kuucapkan."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TalosEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2473"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mungkin aku harus memukulmu dulu biar kau sadar."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TalosEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku kembali untuk melumpuhkanmu lagi."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.TalosEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2472"
      InheritFrom = "BaseSubtitle"
