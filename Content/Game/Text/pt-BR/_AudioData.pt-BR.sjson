      Event = "GlobalVoiceLines.SwitchedWeaponUpgradeVoiceLines"
    }
    {
      Id = "Melinoe_2771"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo ikut!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_2772"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersamaku!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_2773"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari berangkat?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_2774"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo jalan."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_0845"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari ikut denganku, si kecil."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_0846"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau menemaniku, si kecil?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_0847"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, si kecil, mari jalan."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_2499"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersama, kita akan melangkah jauh."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_2498"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebuah kehormatan bagiku."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_5625"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Giliranmu."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_5626"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau ikut denganku?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_5627"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mau ikut?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_5628"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersamaku."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_5629"
