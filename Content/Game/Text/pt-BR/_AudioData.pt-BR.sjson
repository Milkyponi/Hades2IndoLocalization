      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_3705"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rencana konyolmu membunuhku malah jadi bumerang."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_3706"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harusnya kau tetap tinggal di permukaan."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mengiraku mangsa yang mudah."
