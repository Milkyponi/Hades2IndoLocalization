    }
    {
      Id = "Melinoe_5631"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Raki."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_5630"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Toula."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_5632"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hecuba."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_5633"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gale."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampaknya kita kedatangan murid baru!"
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seorang murid baru telah bergabung ke barisan kita, bocah!"
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari mana gerangan datangnya binatang mungil itu?"
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Amfibi kecil itu disambut baik di sini."
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi kucing itu bisa dipercaya, ya?"
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bergeraklah gesit layaknya kepakan gagak."
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0674"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jauhkan saja anjing itu dariku."
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0675"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pastikan anjing itu tetap menjauh."
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0676"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Musangmu sudah bersiap."
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0677"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga musangmu melindungimu."
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0678"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bawa pergi kucing itu dari sini..."
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0679"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gagak itu lagi, ya?"
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Skelly_0680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lekas melompat dan beraksi kalau begitu!"
      Speaker = "Skelly"
      Event = "GlobalVoiceLines.FamiliarEquipVoiceLines"
    }
    {
      Id = "Melinoe_5582"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihatlah betapa kuatnya dirimu sekarang."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_5583"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lihat dirimu sekarang, gagak kecil."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_5584"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau kucing yang luar biasa."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_5585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang ratu para anjing pemburu."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_5586"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau berhasil membuktikannya, Gale."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_3874"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Enak, 'kan?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_3875"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para familiar selalu menyukai ini."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_3876"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku jadi tergoda mencobanya sendiri..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_3877"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selalu berhasil setiap saat."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_3878"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selalu manjur."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_3879"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti rasanya lezat sekali..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_5634"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bernutrisi!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_5635"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak pernah puas melahapnya, ya."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_5636"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seenak itu, ya?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_5637"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tumbuh semakin kuat."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.FamiliarPostTreatVoiceLines"
    }
    {
      Id = "Melinoe_5489"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita periksa lebih dekat..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.CardInspectVoiceLines"
    }
    {
