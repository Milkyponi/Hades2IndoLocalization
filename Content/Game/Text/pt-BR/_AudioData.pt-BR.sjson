      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_0471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kota ini milik kaum fana...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_0472"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar ini jadi peringatan untuk tuanmu!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3142"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nah, itu dia pelaut berpengalaman..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3143"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali berlayar lagi, Kapten?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3144"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapal ini kuambil alih!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3145"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tampaknya kau kedatangan penumpang gelap, Kapten!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3146"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kubuat kapal keparat ini karam!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3147"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebentar lagi kau akan berlayar kembali ke neraka."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2616"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seekor Drakon sebesar itu? Mengabdi pada Chronos pula..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2617"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lebih baik gunakan sayapmu itu untuk terbang menjauh, Drakon!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2618"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian para Drakon seharusnya memilih sekutu dengan lebih bijak."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2619"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebentar lagi kau akan takut padaku, Drakon."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2620"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Belum kapok juga denganku, Drakon?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_2957"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itu... demi para dewa...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_5683"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama menjijikkannya seperti di dunia nyata..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3006"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salah satu keturunan Typhon..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3007"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Wajahmu persis sekali dengan ayahmu..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3008"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau salah satu anak Typhon yang lebih besar, ya."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3009"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keturunan itu lagi..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3010"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makhluk itu lagi... atau kembarannya?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_5684"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kenapa aku memimpikan hal-hal seburuk ini...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian berdua tampak kenyang sekali..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dua makhluk ini lagi."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dua makhluk ini lagi? Atau hanya mirip seperti yang lainnya."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian berdua rukun sekali untuk ukuran saudara kembar."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_3136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak menyukai kalian berdua."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterStartVoiceLines"
    }
    {
      Id = "MelinoeField_5694"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keluar dari mimpiku."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_5693"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau masuk ke mimpiku...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_5695"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mimpi ini takkan berakhir di sini."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_5696"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau ini mimpimu, sebentar lagi akan tamat."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_0682"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ah, ya."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_0683"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini lagi."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_0684"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita mulai...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_0685"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo kalau begitu."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_0686"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya kita berdua...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_0687"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku telah kembali."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_0688"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau takkan bisa menghentikanku."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_0689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku kembali."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterMiscStartLines"
    }
    {
      Id = "MelinoeField_5698"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan ganggu tidurku."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_5697"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tepat seperti hasil yang kubayangkan."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_5699"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Aku sedang berusaha untuk tidur."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_5700"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidurlah yang nyenyak. Aku pasti akan begitu."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "Melinoe_1005"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Roh keji."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "Melinoe_1006"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gentayangi saja padang rumput yang lain."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "Melinoe_0999"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kena kau."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "Melinoe_1000"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selesai."
