      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "Melinoe_1643"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Muak sekali melihat makhluk itu..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "Melinoe_1644"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bayang-bayang itu memudar..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_3702"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Dan di sinilah jiwamu akan bersemayam."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_3703"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan tumbang di tangan begundal bayaran."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.MiniBossEncounterEndVoiceLines"
    }
    {
      Id = "MelinoeField_3704"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berapa pun bayaranmu, itu tak sebanding."
