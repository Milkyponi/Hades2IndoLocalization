      Speaker = "Typhon"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Typhon_0038"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#TyphonFormat}BEEENCIII...!"
      Speaker = "Typhon"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Typhon_0039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#TyphonFormat}MAAATIII...!"
      Speaker = "Typhon"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Arachne_0275"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Astaga, temanku, kau pergi ke mana? Kembalilah!"
      Speaker = "Arachne"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Arachne_0276"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, jangan, apa yang terjadi? Tunggu!"
      Speaker = "Arachne"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Arachne_0277"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pupus sudah pengalaman belanja yang menyenangkan..."
      Speaker = "Arachne"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Arachne_0278"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mampir lagi secepatnya, ya? {#Emph}Haha, hah..."
      Speaker = "Arachne"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "MelinoeField_3836"
