    }
    {
      Id = "Melinoe_4400"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kolam itu mestinya punya sesuatu untukku..."
      Speaker = "Melinoe"
      Event = "ObstacleData[558210].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_4401"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekarang tinggal mantra pembangunnya..."
      Speaker = "Melinoe"
      Event = "ObstacleData[558210].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_4402"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebaiknya kucoba mantra pembangunnya..."
      Speaker = "Melinoe"
      Event = "ObstacleData[558210].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_5872"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pangeran Zagreus menyebut tentangmu di Elisium, dan memintaku menyampaikan salamnya padamu!"
      Speaker = "Melinoe"
      Event = "ObstacleData[555807].SendToElysiumVoiceLines"
    }
    {
      Id = "Melinoe_5873"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedengarannya kau dulu pernah mendukungnya."
      Speaker = "Melinoe"
      Event = "ObstacleData[555807].SendToElysiumVoiceLines"
    }
    {
      Id = "Melinoe_5524"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja kau bebas pergi. Mungkin kita akan bertemu di sana!"
      Speaker = "Melinoe"
      Event = "ObstacleData[555807].SendToElysiumVoiceLines"
    }
    {
      Id = "Melinoe_5525"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, dan sampai jumpa."
      Speaker = "Melinoe"
      Event = "ObstacleData[555807].SendToElysiumVoiceLines"
    }
    {
      Id = "Melinoe_0538"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Altarku..."
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2716"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Altarku sudah terisi penuh..."
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0643"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Beri hormat kepada Putri Dunia Bawah kita yang jaya!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0493"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemari kau, anak muda, {#Emph}sekarang {#Prev}juga!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0042"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Boleh kita bicara sebentar?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemarilah, boleh?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0406"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada yang mau kubahas."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0514"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, boleh bicara sepatah dua patah kata?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0230"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Melihat sesuatu yang belum pernah ada di sini sebelumnya, anak muda?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0228_B"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Para murid, per{#Emph}hatian!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0611"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kalian para pemalas mending dengarkan aku sekarang, karena aku sudah jadi staf tetap! {#Emph}Rasakan! {#Prev}— Ups!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0594"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Heheheheh{#Prev}, itu tadi cuma bercanda kok. Lanjutkan tugas!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_4958"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Komandan!"
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0595"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, {#Emph}eh, halo!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0588"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Oh, hohoho. Ah, hahaha!! {#Prev}Kekuatanku {#Emph}telah kembali!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_4954"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Komandan...?"
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0318"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, apa, dia {#Emph}berhasil?! {#Prev}Tapi, mana mung— Oke, dia di sini, tutup {#Emph}mulut kalian!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_3283"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah aku sudah resmi menjadi Jawara Sang Malam...?"
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0313"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hore! {#Prev}Satu lagi kemenangan gilang-gemilang, satu lagi Hadiah yang pantas didapat!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_3278"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hadiah kedua Sang Malam menanti..."
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hadiahmu menanti, dan kejayaan milikmu! Yah, sepertiganya sih."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0301"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saatnya membuktikan dirimu akhirnya tiba!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0302"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jika kau berkenan meluangkan waktu mengobrol sebentar denganku?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0777"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau pingsan atau bagaimana?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0778"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, {#Emph}eh{#Prev}, kau sudah bangun?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0779"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah bisa bangkit lagi, bocah?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0780"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kira ini tempat apa, Bumi {#Emph}Perkemahan{#Prev}?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0782"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau tidur sebentar atau bagaimana?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0783"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau ketiduran di sana tadi?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0784"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kayaknya kita lagi santai-santai sekarang!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0785"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah cukup waktu tidurnya?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0786"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembali ke kenyataan yang pahit..."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0781"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Diam kalian, dia sudah bangun!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0787"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuharap aku juga bisa tidur saat kerja..."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0788"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak apa-apa, kawan-kawan, dia sudah bangun!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0431"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau membawa Gigi andalanku!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0432"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga Gigiku membawakanmu keberuntungan dan ketenaran."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0515"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Mana mungkin dia bisa—oh, {#Emph}halo!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0518"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau aku sih {#Emph}yakin sekali {#Prev}dia bakal menang!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0516"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang Penjagal Titan telah kembali!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0517"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus sekali caramu menghajar si Chronos itu!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0519"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sang penakluk Typhon telah tiba!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0520"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau benar-benar menghajar Typhon itu, ya?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0521"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hore {#Prev}untuk penyelamat Olympus!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0522"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maksudmu dia mengalahkan Typhon {#Emph}lagi?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0223"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kulihat ada beberapa wajah baru hari ini, baru keluar dari Erebus!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0224"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagi kalian yang baru bergabung, selamat datang!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0523"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sebagian dari kalian berhasil sampai dari permukaan, {#Emph}kan?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0671"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau berhasil lolos dari tempat Ephyra itu tanpa lecet sedikit pun, {#Emph}ya?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0670"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sambutlah rekrutan baru kita, langsung dari Celah Thessaly!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0524"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada Arwah yang datang jauh-jauh dari Gunung Olympus ke sini!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0672"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari puncak Olympus, jauh-jauh sampai ke sini, wah..."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0525"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian para Arwah masih baru di sini, jadi kalian harus tunduk pada{#Emph}ku!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0526"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Arwah yang datang jauh-jauh dari Tartarus ada di sini bersama kita!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0527"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Dan demikianlah orientasi singkat kita berakhir. Ada pertanyaan, lempar saja!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0528"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Jadi intinya, kalian cukup berdiri santai saja di sini, paham?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0225"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Batu Perdamaian memang menuntunmu ke sini; tapi akulah yang akan menunjukkan jalannya."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0292"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jumlah kita bertambah, dan begitu pula kekuatan kita!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0293"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami ucapkan selamat datang di garda depan Dunia Bawah!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0294"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seseorang yang baru datang dari Oceanus bergabung dengan barisan kita!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0673"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian Arwah-Arwah dari Oceanus, jangan sampai membuat semuanya basah kuyup!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0295"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada gunanya menangis di Mourning Fields kalau kau bisa bergabung bersama kami di sini!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0507"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei semuanya, lihat siapa yang kembali!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0508"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah, bersikap wajar semuanya, dia sudah kembali!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0509"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kau {#Prev}yang di sana, kembali ke formasi atau {#Emph}tanggung akibatnya!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0510"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jadi, ada yang punya cerita untuk dibagikan atau bagaimana?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0513"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku hafal betul bunyi derap langkah itu!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0037"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Dia sudah sampai, ayo para pemalas, tegakkan badan!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0038"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Ah, akhirnya dia datang lagi."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0039"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...dan demikianlah pelajaran kita untuk hari ini. Istirahat di tempat."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0040"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...dan satu hal lagi... {#Emph}um{#Prev}, berdiri yang tegak!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semuanya, siap grak!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...dan apa yang harus kita lakukan? Hanya berpangku tangan, dan membiarkan sang Titan berbuat semaunya?!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...tapi itu, para muridku, adalah kisah untuk kesempatan lain."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0107"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami ucapkan selamat datang di tempat latihan kita!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0108"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Satu langkah lagi di jalan menuju kesempurnaan!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia sudah tiba, sekarang perhatikan dan pelajari!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0296"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ia selalu kembali, seiring senja menyerah pada malam!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0297"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Si{#Emph}ap grak! {#Prev}Ada Saudari Perak merapat!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0228_C"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia telah {#Emph}kembali!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0298"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tahan, semuanya, Saudari Perak merapat!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0299"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Teruslah berlatih, seolah nyawa kalian masih bergantung padanya!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0005"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ah, aku hafal bunyi derap langkah itu. Kemarilah agar mata tua ini bisa melihatmu."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0511"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Saksikanlah Sang Juara Malam, semuanya!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0512"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sudah selesai dengan Genangan Perak di sebelah sana?"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0024"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...dan itulah, para muridku, arti hidup yang sesungguhnya. Ingat baik-baik!"
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0025"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...dan lalu kukatakan... t-tunggu dulu, ada orang datang."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_0071"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Komandan."
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2919"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Komandan Schelemeus, {#Emph}Tuan!"
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0109"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Anak muda."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Muridku."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Skelly_0110"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bocah."
      Speaker = "Skelly"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2770"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Frinos, kau di sini!"
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_5478"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hai kawan-kawan. Ada yang tertarik dengan penampilan baru?"
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_3244"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Toula, kau berhasil sampai!"
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_3591"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Raki, selamat datang!"
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_3775"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hecuba kembali!"
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_3960"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gale, selamat datang kembali!"
      Speaker = "Melinoe"
      Event = "Hub_PreRun.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0008"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tempat pelatihan Crossroads diawasi oleh sang pelaut pemberani, Schelemeus, yang termasyhur dalam kematian sebagaimana ia termasyhur dalam kehidupannya."
      Speaker = "Storyteller"
      Event = "InspectPreRun01"
    }
    {
      Id = "Melinoe_0033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita tak mungkin gagal jika si jenius ini berada di pihak kita."
      Speaker = "Melinoe"
      Event = "InspectPreRun01"
    }
    {
      Id = "Skelly_0011"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu tidak!"
      Speaker = "Skelly"
      Event = "InspectPreRun01"
    }
    {
      Id = "Storyteller_0013"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di dalam Crossroads yang angker bernaung berbagai macam Arwah dan Roh, sebagian menyerupai wujud fana mereka, dan sebagian lagi, telah lebur menjadi esensi termurni."
      Speaker = "Storyteller"
      Event = "InspectHomerReveal02"
    }
    {
      Id = "Melinoe_1132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau baik-baik saja, Homer?"
      Speaker = "Melinoe"
      Event = "InspectHomerReveal02"
    }
    {
      Id = "Storyteller_0033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Bukan begitu..."
      Speaker = "Storyteller"
      Event = "InspectHomerReveal02"
    }
    {
      Id = "Storyteller_0355"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Barisan di Persimpangan kian dipadati para Arwah yang sempat tersesat, namun kini bersatu demi perjuangan mulia Tuan Putri Melinoë."
      Speaker = "Storyteller"
      Event = "InspectRecruitedShades01"
    }
    {
      Id = "Melinoe_4085"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat datang di barisan Kaum Tak Kasat Mata!"
      Speaker = "Melinoe"
      Event = "InspectRecruitedShades01"
    }
    {
      Id = "Storyteller_0063"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Begitu purbanya Batu Hitam Kelam ini, wujudnya bahkan mendahului Waktu itu sendiri. Permukaannya senantiasa menyerap cahaya dan warna apa pun yang berani singgah di dekatnya."
      Speaker = "Storyteller"
      Event = "InspectBountyBoard01"
    }
    {
      Id = "Melinoe_1117"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kini aku bisa melihat apa yang ada di balik permukaannya..."
      Speaker = "Melinoe"
      Event = "InspectBountyBoard01"
    }
    {
      Id = "Storyteller_0233"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah monumen rahasia bagi Sang Malam, terukir dengan titah dan wasiatnya, menjulang megah di area latihan, menyingkap hakikat aslinya hanya kepada mereka yang berhak."
      Speaker = "Storyteller"
      Event = "InspectPact01"
    }
    {
      Id = "Melinoe_2960"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kini aku telah masuk ke Lingkaran Dalam..."
      Speaker = "Melinoe"
      Event = "InspectPact01"
    }
    {
      Id = "Storyteller_0356"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di ambang gerbang menuju dunia luar Persimpangan, Altar Abu berdenyut dengan daya purba, tiada bertepi laksana para dewa dan pahlawan yang terlukis dalam beragam Arcana."
      Speaker = "Storyteller"
      Event = "InspectUpgradedAltar01"
    }
    {
      Id = "Melinoe_4086"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kekuatan yang bersemayam dalam diri kita semua..."
      Speaker = "Melinoe"
      Event = "InspectUpgradedAltar01"
    }
    {
      Id = "Storyteller_0351"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Pucat pasi kematian kini memancar dari Senjata Malam, setidaknya dari salah satunya; dahaga tempaan Takdir untuk mencabut nyawa abadi kini tersingkap nyata."
      Speaker = "Storyteller"
      Event = "InspectGraveThirst01"
    }
    {
      Id = "Melinoe_4081"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Perkumpulan Belulang Purba..."
      Speaker = "Melinoe"
      Event = "InspectGraveThirst01"
    }
    {
      Id = "Storyteller_0352"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di dalam Kolam Perak kini berenang wujud-wujud bayangan kelam Senjata Malam, dalam rupa yang belum pernah disaksikan oleh sang Putri Dunia Bawah sebelumnya."
      Speaker = "Storyteller"
      Event = "InspectAspectsUnlocked01"
    }
    {
      Id = "Melinoe_4082"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu banyak rupa yang berbeda..."
      Speaker = "Melinoe"
      Event = "InspectAspectsUnlocked01"
    }
    {
      Id = "Storyteller_0357"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Setiap Senjata Malam purba tempaan Takdir kini telah bersatu kembali di bawah naungan sang Putri Dunia Bawah, siap membasmi musuh mana pun dari alam ini tanpa cela."
      Speaker = "Storyteller"
      Event = "InspectAllWeaponsUnlocked01"
    }
    {
      Id = "Melinoe_4087"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu pula denganku."
      Speaker = "Melinoe"
      Event = "InspectAllWeaponsUnlocked01"
    }
    {
      Id = "Storyteller_0349"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Putri Dunia Bawah kini menggenggam kunci gerbang yang dulunya tersegel, jalan menuju ke permukaan dunia ini; namun bagaimanakah nasibnya kelak di alam terlarang tersebut?"
      Speaker = "Storyteller"
      Event = "InspectAltRunDoor01"
    }
    {
      Id = "Melinoe_4079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kita buktikan!"
      Speaker = "Melinoe"
      Event = "InspectAltRunDoor01"
    }
    {
      Id = "Storyteller_0350"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sekawanan Satwa Gaib yang kian bertambah dan setia kini siap melangkah mengiringi sang Putri Kematian menuju kedalaman, atau ke mana pun tugas takdirnya membimbing langkahnya."
      Speaker = "Storyteller"
      Event = "InspectPreRunFamiliars01"
    }
    {
      Id = "Melinoe_4080"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pelindung-pelindung kecilku!"
      Speaker = "Melinoe"
      Event = "InspectPreRunFamiliars01"
    }
    {
      Id = "Storyteller_0347"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di atas sana, Bulan purnama bersinar terang, melimpahkan segala anggun dan kuasanya dari balik kanopi pepohonan fana dan tebing-tebing menjulang yang menyajikan sudut pandang nan murni."
      Speaker = "Storyteller"
      Event = "InspectPreRunFullMoon01"
    }
    {
      Id = "Melinoe_4077"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Persimpangan antar-alam..."
      Speaker = "Melinoe"
      Event = "InspectPreRunFullMoon01"
    }
    {
      Id = "Storyteller_0348"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Malam ini Sang Rembulan tiada menampakkan diri, cahayanya padam hanya untuk sementara, agar segera bersinar terang kembali dengan kekuatan dan kemungkinan yang baru."
      Speaker = "Storyteller"
      Event = "InspectPreRunNewMoon01"
    }
    {
      Id = "Melinoe_4078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Siklus kita dimulai kembali..."
      Speaker = "Melinoe"
      Event = "InspectPreRunNewMoon01"
    }
    {
      Id = "Storyteller_0412"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Kotak pusaka yang kian usang itu kini memuat tanda terima kasih dari banyak dewa dan liyan; pengingat abadi bahwa sang Putri Kematian takkan pernah bertarung seorang diri."
      Speaker = "Storyteller"
      Event = "InspectManyKeepsakes01"
    }
    {
      Id = "Melinoe_4271"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian selalu bersamaku..."
      Speaker = "Melinoe"
      Event = "InspectManyKeepsakes01"
    }
    {
      Id = "Storyteller_0532"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Semacam tempat pemujaan rajutan mimpi kini berdiri nyaman di area latihan, seolah bertanya kepada sang Putri pekerja keras: Apakah Tidurmu sudah cukup nyenyak?"
      Speaker = "Storyteller"
      Event = "InspectDreamRunObject01"
    }
    {
      Id = "Melinoe_5856"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku bakal tidur kalau mau! Mungkin sekarang."
      Speaker = "Melinoe"
      Event = "InspectDreamRunObject01"
    }
    {
      Id = "Storyteller_0533"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebuah piagam berhiaskan taburan bintang memberi selamat kepada sang Putri penjelajah mimpi karena telah menaklukkan ketakutan terkelamnya, dan akhirnya berhasil tidur lelap tanpa beban."
      Speaker = "Storyteller"
      Event = "InspectDreamRunCertificate01"
    }
    {
      Id = "Melinoe_5858"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, aku berhasil? Rasa cemas tiada henti itu sudah sembuh? {#Emph}Hah..."
      Speaker = "Melinoe"
      Event = "InspectDreamRunCertificate01"
    }
    {
      Id = "Storyteller_0353"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ketiga Karunia Cadar, yang ditakdirkan bagi siapa pun yang layak menyandang gelar Ksatria Sang Malam, menantang sang Putri Kematian yang tangguh untuk membuktikan kehebatannya yang tiada tara kepada khalayak."
      Speaker = "Storyteller"
      Event = "InspectSkellyStatuesLocked01"
    }
    {
      Id = "Melinoe_4083"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aduh, entahlah..."
      Speaker = "Melinoe"
      Event = "InspectSkellyStatuesLocked01"
    }
    {
      Id = "Skelly_0580"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, tapi aku {#Emph}tahu {#Prev}pasti!"
      Speaker = "Skelly"
      Event = "InspectSkellyStatuesLocked01"
    }
    {
      Id = "Storyteller_0354"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Oh, um, eh, um-um-um... Sungguh agung perawakan ketiga arca sang Putri Kematian ini, hingga menuntut rasa hormat dari setiap jiwa yang berada di dekatnya."
      Speaker = "Storyteller"
      Event = "InspectSkellyStatues01"
    }
    {
      Id = "Melinoe_4084"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Rasa hormat{#Prev}, ya...?"
      Speaker = "Melinoe"
      Event = "InspectSkellyStatues01"
    }
    {
      Id = "Skelly_0581"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Iya lah{#Prev}, lihat saja sendiri!"
      Speaker = "Skelly"
      Event = "InspectSkellyStatues01"
    }
    {
      Id = "Storyteller_0235"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Di larut malam yang sunyi, dalam belukar berhantu yang temaram oleh sinar bulan di tepi Dunia Bawah. Di sanalah, seorang Putri muda yang terasing memburu mangsanya..."
      Speaker = "Storyteller"
      Event = "HecateHideAndSeekIntro01"
    }
    {
      Id = "Melinoe_2106"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Siap atau tidak, aku datang...!"
      Speaker = "Melinoe"
      Event = "HecateHideAndSeekIntro01"
    }
    {
      Id = "Melinoe_4841"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo, anabul!"
      Speaker = "Melinoe"
      Event = "ObstacleData[783240].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2114"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Halo Arwah, apa Hecate ada di sekitar sini...? Kalian tidak melihatnya, ya?"
      Speaker = "Melinoe"
      Event = "ObstacleData[561454].DistanceTriggers.VoiceLines"
    }
    {
      Id = "Storyteller_0140"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Putri bermata jeli menemukan sederet jejak, menandakan bahwa lawannya baru saja melintasi tanah berdebu ini sesaat yang lalu..."
      Speaker = "Storyteller"
      Event = "InspectHomerReveal01"
    }
    {
      Id = "Melinoe_2105"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Ssst{#Prev}, Homer! Mana bisa aku menangkapnya kalau kau terus-terusan menarasikan setiap gerak-gerikku?"
      Speaker = "Melinoe"
      Event = "InspectHomerReveal01"
    }
    {
      Id = "Storyteller_0149"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Uhhh um-um-um, s, s, saya sama sekali tidak tahu siapa yang Anda maksud... maksud saya, siapa yang dimaksud oleh sang Putri Kematian! Seraya ia melanjutkan pencarian takdirnya."
      Speaker = "Storyteller"
      Event = "InspectHomerReveal01"
    }
    {
      Id = "Melinoe_2269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Berhenti menggodaku dan bantu aku mencari!"
      Speaker = "Melinoe"
      Event = "InspectHomerReveal01"
    }
    {
      Id = "Hecate_0207"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Tapi, Yang Mulia Hades, aku..."
      Speaker = "Hecate"
      Event = "Flashback_DeathAreaBedroomHades.StartUnthreadedEvents.VoiceLines"
    }
    {
      Id = "Hades_0048"
      InheritFrom = "BaseNarrative"
      DisplayName = "...Kau sudah menerima perintahmu. Sekarang kembalilah ke dalam bayangan. Dan, jaga dia. Demi kita semua."
      Speaker = "Hades"
      Event = "HadesWithHecate01"
    }
    {
      Id = "Hecate_0208"
      InheritFrom = "BaseNarrative"
      DisplayName = "Tiada bahaya yang akan menyentuh Melinoë muda, Gusti. Setidaknya dalam hal ini, hamba takkan mengecewakanmu."
      Speaker = "Hecate"
      Event = "HadesWithHecate01"
    }
    {
      Id = "Hecate_0209"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa..."
      Speaker = "Hecate"
      Event = "HadesWithHecate01"
    }
    {
      Id = "Hades_0017"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat jalan, Putriku..."
      Speaker = "Hades"
      Event = "HadesWithHecate01"
    }
    {
      Id = "MelinoeField_3305"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_3306"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_3307"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Apa?!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_3308"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hei!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_3309"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Gah!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_3310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aduh!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "Melinoe_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa—?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "Melinoe_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Augh!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "Melinoe_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Gaah!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_1384"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ungh!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "Melinoe_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ungh{#Prev}, tidak!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_1387"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagai—?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_1389"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tidak!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_1390"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ngh{#Prev}, tidak...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "MelinoeField_1388"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau!!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathVoiceLines"
    }
    {
      Id = "Moros_1020"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak ada apa-apa di sini! {#Emph}Dah!"
      Speaker = "Moros"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Moros_1021"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei! Sana pergi. {#Emph}Pergi dari sini!"
      Speaker = "Moros"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Moros_1022"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bisa urus urusanmu sendiri?"
      Speaker = "Moros"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Moros_1023"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau datang kepagian, sana pergi!"
      Speaker = "Moros"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Hecate_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau harus lebih kuat dari ini, Melinoë."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Hecate_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kembalilah dan beristirahatlah, lalu coba lagi, Melinoë."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Hecate_0139"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Renungkan kesalahan-kesalahan yang kau perbuat, Melinoë."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Hecate_0010"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau jelas-jelas belum siap untuk saat ini."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Hecate_0132"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu kau lebih kuat dari ini."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Hecate_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu kau bisa bertarung lebih baik dari itu."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Hecate_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuharap ada pelajaran yang bisa kaupetik?"
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Hecate_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bulan menjadi saksi pertarungan kita malam ini."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Hecate_0138"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuharap kau tahu, aku sama sekali tak merasa senang melakukan ini."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "HecateField_0074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tumbang di bawah beban semua tekanan ini..."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "HecateField_0075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau hampir mengalahkanku! Sayang, belum cukup."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "HecateField_0076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Begitu dekat, namun masih belum cukup kuat."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "HecateField_0077"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Setidaknya kau bertarung lebih sengit daripada sebelumnya."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "HecateField_0078"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan berkecil hati; kau bertarung dengan baik."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "HecateField_0079"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kali ini kau bahkan nyaris tak bisa menyentuhku."
      Speaker = "Hecate"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Scylla_0134"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kami adalah {#Emph}Scylla and the Sirens{#Prev}, semuanya!!"
      Speaker = "Scylla"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Scylla_0135"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih, semuanya! Selamat malam!"
      Speaker = "Scylla"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Scylla_0136"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Terima kasih, Oceanus!!"
      Speaker = "Scylla"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Scylla_0137"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, {#Emph}terima kasih {#Prev}sudah datang ke konser kami!"
      Speaker = "Scylla"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Scylla_0264"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei tunggu, jangan pergi dulu! Kami baru saja mulai!"
      Speaker = "Scylla"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Scylla_0265"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh tidak apa-apa! Musik terbaru kami memang bukan untuk semua orang."
      Speaker = "Scylla"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Scylla_0266"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan, tunggu! Kami masih punya banyak lagu untuk dibawakan!"
      Speaker = "Scylla"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Scylla_0267"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sana, {#Emph}lari {#Prev}yang jauh! Dan beri tahu {#Emph}semua orang {#Prev}tentang kami!"
      Speaker = "Scylla"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Scylla_0268"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hihihihi! {#Prev}Kan sudah kubilang, dia nggak bakal sanggup menghadapi {#Emph}kita!"
      Speaker = "Scylla"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Scylla_0269"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Datang lagi ya, kami manggung setiap malam!"
      Speaker = "Scylla"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0197"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hasil akhir yang tak terelakkan, tiada yang lebih."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0198"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita harus mengulanginya lagi lain waktu."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0199"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tiada kebaikan yang akan mendatangi mereka yang bersumpah setia kepada para dewa."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0200"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kukira keturunanku sendiri bisa berbuat lebih dari ini."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0201"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang kau harap bisa kau capai di sini?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0202"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktu mungkin menyembuhkan semua luka, atau bisa menorehkannya dengan sama mudahnya."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0468"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya aku yang takkan melupakan jerih payahmu yang sia-sia ini."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0469"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seperti yang kaulihat, aku masih cukup lincah terlepas dari usiaku."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0470"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Seranglah aku sesukamu; aku punya seluruh waktu di dunia ini."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0471"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kaum muda zaman ini kian lembek raga dan pikirannya."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0257"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hasil yang sama dan sudah tertebak, namun kau masih saja bersikeras."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0258"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apa yang kau kira bakal berubah kali ini?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0259"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sekali lagi kau luput dari genggamanku, tapi kelak kau pasti kutangkap."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0260"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lagi-lagi kau mempertaruhkan segalanya, hanya demi kegagalan yang memalukan."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0467"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maka sejarah pun berulang sebagaimana lazimnya."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0472"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Harusnya kau tak mengira akan ada hasil selain ini."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0261"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Itulah ganjaran dari semua kerepotan yang kau timbulkan!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0262"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertarungan kita sebelumnya pun mestinya berakhir demikian!"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0263"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau benar-benar mengira bisa menang melawanku sekali lagi?"
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Chronos_0264"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ah, kekalahan yang pahit! Nah, baru begini seharusnya."
      Speaker = "Chronos"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "MelinoeField_3435"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari kabut ingatan, kembalilah pada bayangan, sekarang...!"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0025"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia lenyap... tinggal aku lagi... hei, kapan aku bangun...?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0450"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku pilih yang kedua saja deh..."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0033"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tentu saja! Aku selalu memikirkan senjata sepanjang waktu!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "MelinoeField_3434"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari kabut ingatan, kembalilah pada bayangan, sekarang..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0041"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hati-hati di luar sana!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "MelinoeField_3436"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dari kabut ingatan, kembalilah pada bayangan, sekarang."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0049"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Dia lenyap lagi. {#Emph}Kakak... aku...?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0061"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, apa itu tadi dia? Ada apa sebenarnya. {#Emph}Melinoë...?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0066"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tunggu, kau di sana? Adikku, apa kau di sana? {#Emph}Augh..."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0104"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kabar baik! Syarat Kontrak Nerakamu sudah terpenuhi!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0105"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku baru saja menghajar adik perempuanku, hadirin sekalian, terima kasih!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0310"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hei, bagaimana caramu melakukan trik menghilang tadi...?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0311"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian para Arwah menikmati pertunjukan kecil kami?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0312"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada penantang lain di luar sana? Tidak ada...?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0313"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku sudah melakukan ini sejak sebelum kau lahir, Adikku!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0317"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bukan tanpa alasan mereka menjadikanku Spesialis Keamanan!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0318"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau memang kuat, Melinoë, tapi ternyata aku juga kuat."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0315"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Gigaros memang sangat ampuh melawan anggota keluarga ini."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0316"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita tidak bisa menyelesaikannya lewat omongan kali ini, Adikku."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0319"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita harus tanding lagi kapan-kapan, ya?"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0320"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Yang ini untukmu di sana, Arwah penggemarku!"
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Zagreus_0314"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nyaris saja kau mengalahkanku, tapi kau tahu sendiri urusannya dengan kata {#Emph}nyaris."
      Speaker = "Zagreus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Medea_0368"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pesta darah segar yang tercurah untukku..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Medea_0369"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus sekali, Kiklops! Kerja sama kita lumayan juga."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Medea_0371"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sampai jumpa di malam lain kalau begitu, penyihir!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Medea_0372"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan dengan demikian, kehendak Sang Malam pun terlaksana sekali lagi."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Medea_0570"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau menghabiskan seluruh darah yang tersisa dalam ragamu..."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Medea_0571"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan meratapi hasil ini. Ambil kekuatannya!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Medea_0572"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pikiranmu sedang kalut malam ini, penyihir."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Medea_0573"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hecate yang agung, kemenangan ini milikku...!"
      Speaker = "Medea"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Medea_0574"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku mungkin tak memiliki keilahianmu, tapi ini sudah lebih dari cukup."
      Speaker = "Medea"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Polyphemus_0089"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Angkat pantatmu dari kotaku."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Polyphemus_0090"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Biar itu jadi pelajaran buatmu."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Polyphemus_0091"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau macam-macam dengan dombaku, aku yang akan membalas{#Emph}mu."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Polyphemus_0092"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Waktunya makan... tunggu, ke mana perginya kau?"
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Polyphemus_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ugh {#Prev}ke mana dia kabur kali ini?"
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Polyphemus_0094"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pertarungan tadi benar-benar bikin nafsu makanku bangkit."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Polyphemus_0095"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan macam-macam sama domba-dombaku."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Polyphemus_0096"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pupus sudah jatah makanku, ya."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Polyphemus_0097"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemari kau, bocah tengil..."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Polyphemus_0098"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kedengarannya urusan kita sudah beres di sini, ya."
      Speaker = "Polyphemus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "ErisField_0122"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kembalilah ke bayangan, sekarang!"
      Speaker = "Eris"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "ErisField_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Kembalilah ke bayangan, sekarang...!"
      Speaker = "Eris"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "ErisField_0124"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus, Nona Sempurna, pulang sana dan {#Emph}menangislah."
      Speaker = "Eris"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "ErisField_0128"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan benci aku dong, Sayang! Aku cuma jadi diriku {#Emph}sendiri!"
      Speaker = "Eris"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "ErisField_0129"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kapan-kapan kita {#Emph}harus {#Prev}ulang lagi ini, oke?"
      Speaker = "Eris"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "ErisField_0125"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Aha, haha! {#Prev}Sudah sejauh ini, ujung-ujungnya tersandung dan jatuh!"
      Speaker = "Eris"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "ErisField_0126"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maaf, Sayang, tapi memang begitulah nasibmu!"
      Speaker = "Eris"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "ErisField_0127"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jam yang sama, tempat yang sama besok malam, Biang Onar?"
      Speaker = "Eris"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Heracles_0403"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersyukurlah aku tak meremukkan setiap tulangmu."
      Speaker = "Heracles"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Heracles_0401"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kena dia, Pencuri Api. Cuma butuh kita berdua."
      Speaker = "Heracles"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Heracles_0404"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau mungkin bisa mengalahkan si Pencuri Api di sana, tapi bukan aku."
      Speaker = "Heracles"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Heracles_0405"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sepertinya dia sudah lenyap, Prometheus. Sekarang bagaimana...?"
      Speaker = "Heracles"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Heracles_0406"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau bilang kita akan kalah, Prometheus. Supaya... membuat kita {#Emph}menang?"
      Speaker = "Heracles"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0476"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kita berhasil mengalahkannya, kawan besar... kerja tentara bayaran yang hebat."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0111"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sama sekali tak ada kehormatan dalam hal ini."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0112"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak punya cara lain untuk memukulmu mundur."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0113"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia sudah pergi untuk saat ini, Aetos, tapi dia akan kembali..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0163"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Akan kucabik-cabik para dewa itu dengan tangan kosongku..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada yang bisa kau perbuat."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0165"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Keangkuhanmu yang tanpa batas takkan bisa menyelamatkanmu lagi."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0474"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ini memang harus dilakukan... Aku tahu kau akan mengerti."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0475"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku takkan pernah mengabdi pada para dewa; hanya pada masa depan."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0477"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus sekali, Aetos... kita sudah memainkan peran kita untuk saat ini."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0166"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu setiap langkahmu; sementara kau tak tahu apa-apa."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0167"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Malam yang berbeda, hasil yang persis sama."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuanku pasti akan sangat puas dengan hasil ini."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0291"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah, hahaha..."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0169"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tahu pada akhirnya aku akan unggul kembali."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0170"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kau sudah terlalu terlena dengan semua kemenanganmu."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Prometheus_0171"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Rasa puas diri cepat atau lambat berujung pada kejatuhan."
      Speaker = "Prometheus"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Typhon_0031"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#TyphonFormat}HAAAAAH..."
      Speaker = "Typhon"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
      Id = "Typhon_0032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#TyphonFormat}HEHHHHH..."
      Speaker = "Typhon"
      Event = "GlobalVoiceLines.DeathReturnVoiceLines"
    }
    {
