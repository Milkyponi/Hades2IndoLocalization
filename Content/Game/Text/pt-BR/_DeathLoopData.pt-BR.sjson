    }
    {
      Id = "Melinoe_2992"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Sial..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_2994"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Baiklah."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4882"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mmm{#Prev}, aku harus terus melatih hal itu. Untuk kedua urusan tersebut."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_1584"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ungh... {#Prev}dia menghilang..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_1871"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ungh... {#Prev}ke mana dia pergi?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4831"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Kakak... aku menemukannya..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_5707"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}Zagreus... aku mengandalkanmu..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_5769"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Menembus neraka dan kembali... berikutnya ke Olympus?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_5766"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Bekerja samalah denganku, Kak..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_5765"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Kata-kataku mulai sampai padanya... kurasa."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_5767"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Mungkin berikutnya pergi ke Olympus...?"
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4833"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Zagreus... berhati-hatilah."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_5725"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Kakak... kita tidak seharusnya saling bertarung..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_5727"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Nah, begitu lebih baik."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4839"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Harusnya aku sudah punya yang kubutuhkan sekarang."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_5768"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Aku merasakannya... aku dibutuhkan di permukaan sekarang."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4836"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Aku harus menemuinya lagi. Tapi ke Olympus dulu."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4832"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Keluar dari jurang maut..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4835"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Kami mengandalkanmu, Kak..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4837"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Sebaiknya melapor ke Kepala Sekolah."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4838"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mm... {#Prev}kembali dari Istana..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_5770"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mm... {#Prev}makin mendekati mantra yang kita butuhkan."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4834"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}...Kita membuat kemajuan..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_5708"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}Bertahanlah terus, semuanya..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_4748"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Tersentak> {#Prev}Oh...! {#Emph}Hm..."
