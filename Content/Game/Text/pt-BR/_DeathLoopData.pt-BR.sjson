    }
    {
      Id = "Melinoe_3649"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Menghela napas> {#Prev}Malam penuh peristiwa lainnya."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_3650"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Menghela napas> {#Prev}Tugas terus berlanjut..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
