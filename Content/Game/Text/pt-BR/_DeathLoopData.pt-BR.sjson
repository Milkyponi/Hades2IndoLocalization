      InheritFrom = "BaseSubtitle"
      DisplayName = "...Sang Takdir berpihak padaku."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_2570"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kali ini aku melakukannya dengan baik..."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_3643"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Mm... {#Prev}sudah cukup bagus."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_3644"
