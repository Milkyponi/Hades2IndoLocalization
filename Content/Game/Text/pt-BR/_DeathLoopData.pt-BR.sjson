    }
    {
      Id = "Melinoe_3647"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Menghela napas> {#Prev}Malam yang tak sia-sia."
      Speaker = "Melinoe"
      Event = "GlobalVoiceLines.EnteredDeathAreaVoiceLines"
    }
    {
      Id = "Melinoe_3648"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}<Menghela napas> {#Prev}Istirahat malam yang nyenyak!"
      Speaker = "Melinoe"
