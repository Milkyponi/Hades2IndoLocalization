{
  /*
  Milky Brain Indonesian Localization Mod for Hades II
  File: _DeathLoopData.pt-BR.sjson
  Generated by Ochi (Head of Modding & Localization)
  */
  lang = "pt-BR"
  Texts = [
    {
      Id = "Melinoe_5736"
      InheritFrom = "BaseNarrative"
      DisplayName = "Semoga semua berakhir demikian pada waktunya, Homer. Meski begitu, kita belum sampai di sana, terutama karena Sang Tiga Takdir masih hilang. Kita telah mencapai sesuatu yang penting, tapi masih banyak yang harus diselesaikan."
      Speaker = "Melinoe"
      Event = "TrueEndingFinaleResponse01"
    }
    {
      Id = "Melinoe_5737"
      InheritFrom = "BaseSubtitle"
      DisplayName = "...Kubilang kita belum selesai!"
      Speaker = "Melinoe"
      Event = "TrueEndingFinaleResponse01"
    }
    {
      Id = "Melinoe_1164"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tegakkan badan dan jangan tunjukkan kelemahan..."
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2950"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Ah! {#Prev}Lanjutkan kegiatan kalian, semuanya. Aku baik-baik saja."
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2425"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Oh, halo...!"
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2426"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tidak apa-apa, sungguh!"
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2427"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak perlu khawatir!"
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2428"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Maaf mengganggu, para Arwah."
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2429"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam semuanya...!"
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2430"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terima kasih sudah menunggu..."
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2431"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayo, ikutlah...!"
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2432"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mari kita lihat-lihat sekeliling."
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2820"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kualinya sudah siap untuk kugunakan sekarang..."
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_1585"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apakah itu...?"
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_4693"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Moros baru saja di sini..."
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_2439"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ada apa dengan semua ini...?"
      Speaker = "Melinoe"
      Event = "Hub_Main.DistanceTriggers.VoiceLines"
    }
    {
      Id = "Melinoe_1900"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Ayolah, Mel. Pintu keluarnya ada di arah sebaliknya..."
      Speaker = "Melinoe"
      Event = "Hub_Main.EnterVoiceLines"
    }
    {
      Id = "Storyteller_0234"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Persimpangan: suaka tersembunyi di antara permukaan dan Alam Bawah, melindungi mereka yang masih setia kepada Tuan Hades, penguasa sah orang-orang mati."
      Speaker = "Storyteller"
      Event = "InspectCrossroads01"
    }
    {
      Id = "Melinoe_2959"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bersama-sama, kita akan merebut kembali wilayah kekuasaan ayahku."
      Speaker = "Melinoe"
      Event = "InspectCrossroads01"
    }
    {
      Id = "Storyteller_0078"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tenda bersahaja milik Putri Melinoë yang tangguh ini tetap tertata rapi dan bersih tanpa cela."
      Speaker = "Storyteller"
      Event = "InspectTent01"
    }
    {
      Id = "Melinoe_0032"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku tak sudi tinggal di tempat jorok."
      Speaker = "Melinoe"
      Event = "InspectTent01"
    }
    {
      Id = "Storyteller_0121"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Putri kegelapan hanya mengungkapkan ketakutan terdalamnya kepada seekor amfibia tua nan tabah, yang dahulu kala melompat masuk ke dalam tendanya, dan ke dalam hatinya."
      Speaker = "Storyteller"
      Event = "InspectTent01"
    }
    {
      Id = "Melinoe_1684"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Hanya ketakutan terdalam untukmu, Frinos!"
      Speaker = "Melinoe"
      Event = "InspectTent01"
    }
    {
      Id = "Storyteller_0340"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang perwujudan Tidur terlelap tiada henti di ceruk belukar pribadinya, sesekali dikunjungi oleh Sang Putri Alam Bawah kala ia membutuhkan waktu untuk berpikir dan menyusun siasat."
      Speaker = "Storyteller"
      Event = "InspectCrossroadsHypnos01"
    }
    {
      Id = "Melinoe_4070"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Atau sekadar memeriksa keadaannya."
      Speaker = "Melinoe"
      Event = "InspectCrossroadsHypnos01"
    }
    {
      Id = "Storyteller_0502"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Setelah bergegas meninggalkan Persimpangan, sang penjelmaan Tidur yang baru saja terbangun dari lelap panjangnya mengirimkan barang-barang tertentu sebagai tanda terima kasih, dan... mungkin lebih dari itu..."
      Speaker = "Storyteller"
      Event = "InspectHypnosGift01"
    }
    {
      Id = "Melinoe_5435"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kuakhiri mimpi-mimpinya, dan dengan suatu cara, dia pun mengakhiri mimpiku."
      Speaker = "Melinoe"
      Event = "InspectHypnosGift01"
    }
    {
      Id = "Storyteller_0341"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Pahatan elok raut wajah sang raja Alam Bawah yang tergulingkan membangkitkan renungan hening dan keteguhan hati bagi siapa pun yang berani menatap mata batu tak melihat itu."
      Speaker = "Storyteller"
      Event = "InspectHadesFountain01"
    }
    {
      Id = "Melinoe_4071"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Lindungilah aku, Ayah..."
      Speaker = "Melinoe"
      Event = "InspectHadesFountain01"
    }
    {
      Id = "Storyteller_0526"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Tiada kesempatan kedua di dunia ini. Titan Chronos pernah berujar bahwa tak ada jalan membatalkan kesalahan masa lalu... hanyalah kemungkinan fana, sirna ditelan Sang Waktu."
      Speaker = "Storyteller"
      Event = "InspectHadesFountain02"
    }
    {
      Id = "Melinoe_5764"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kemungkinan yang semestinya bisa terjadi..."
      Speaker = "Melinoe"
      Event = "InspectHadesFountain02"
    }
    {
      Id = "Storyteller_0012"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Persimpangan menyembunyikan rencana dan pergerakan sang penyihir pembawa mimpi buruk beserta kawan-kawannya, namun untuk berapa lama?"
      Speaker = "Storyteller"
      Event = "InspectCrossroadsPassage01"
    }
    {
      Id = "Melinoe_0403"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Cukup lama."
      Speaker = "Melinoe"
      Event = "InspectCrossroadsPassage01"
    }
    {
      Id = "Storyteller_0345"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Dengan sayap hitamnya, sang perwujudan Perselisihan yang liar melesat ke mana pun ia suka, dan belakangan ini, sering kali merintangi jalan Sang Putri Alam Bawah."
      Speaker = "Storyteller"
      Event = "InspectCrossroadsEris01"
    }
    {
      Id = "Melinoe_4075"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Makasih banyak, Eris..."
      Speaker = "Melinoe"
      Event = "InspectCrossroadsEris01"
    }
    {
      Id = "Eris_0133"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah?"
      Speaker = "Eris"
      Event = "InspectCrossroadsEris01"
    }
    {
      Id = "Storyteller_0080"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Wasiat terakhir Sang Tiga Takdir, para penentu masa depan yang mengasingkan diri itu, kini berada dalam lindungan Sang Putri Alam Bawah."
      Speaker = "Storyteller"
      Event = "InspectFatedList01"
    }
    {
      Id = "Melinoe_1682"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dengan bantuan mereka, kita mungkin punya kesempatan."
      Speaker = "Melinoe"
      Event = "InspectFatedList01"
    }
    {
      Id = "Storyteller_0122"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Bahkan kelicikan dan siasat Odysseus, sang penakluk kota yang banyak akal itu, mungkin takkan cukup untuk menundukkan sang Titan Waktu..."
      Speaker = "Storyteller"
      Event = "InspectOdysseus01"
    }
    {
      Id = "Melinoe_1685"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Orang-orang bilang jangan pernah meremehkan pria itu..."
      Speaker = "Melinoe"
      Event = "InspectOdysseus01"
    }
    {
      Id = "Odysseus_0123"
      InheritFrom = "BaseSubtitle"
      DisplayName = "{#Emph}Hah{#Prev}, yang benar saja."
      Speaker = "Odysseus"
      Event = "InspectOdysseus01"
    }
    {
      Id = "Storyteller_0134"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang dewi pembalasan yang murung melayangkan tatapan menghakimi ke seisi Persimpangan, tempat yang ia jaga demi kewajiban, dan rasa dengki."
      Speaker = "Storyteller"
      Event = "InspectNemesis01"
    }
    {
      Id = "Melinoe_1687"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Jangan sampai cari gara-gara dengan Nem..."
      Speaker = "Melinoe"
      Event = "InspectNemesis01"
    }
    {
      Id = "Nemesis_0120"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Terserah."
      Speaker = "Nemesis"
      Event = "InspectNemesis01"
    }
    {
      Id = "Storyteller_0135"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang perwujudan Malapetaka yang dibenci dan ditakuti banyak orang melangkah ke mana pun Sang Takdir yang terus menenun kehendaki, dan tiada selain mereka yang mampu mengantisipasi kedatangannya."
      Speaker = "Storyteller"
      Event = "InspectMoros01"
    }
    {
      Id = "Melinoe_1688"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dia memang selalu tahu cara membuat kemunculan dramatis..."
      Speaker = "Melinoe"
      Event = "InspectMoros01"
    }
    {
      Id = "Moros_0093"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tuan Putri?"
      Speaker = "Moros"
      Event = "InspectMoros01"
    }
    {
      Id = "Storyteller_0136"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sebagian Roh Orang Mati mengembara tanpa tujuan selamanya, sementara yang lain, bahkan tanpa memiliki tekad sebesar itu, hanya berdiam di satu tempat."
      Speaker = "Storyteller"
      Event = "InspectDora01"
    }
    {
      Id = "Melinoe_1689"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dora memang perlu lebih sering keluar..."
      Speaker = "Melinoe"
      Event = "InspectDora01"
    }
    {
      Id = "Dora_0118"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Nggak bakal."
      Speaker = "Dora"
      Event = "InspectDora01"
    }
    {
      Id = "Storyteller_0344"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Begitu banyak tanggung jawab Hecate, Sang Penyihir Simpang Jalan, pengawas tak kasat mata antardimensi, dan pemegang kunci jalan-jalan yang tersembunyi bahkan dari mata kaum abadi."
      Speaker = "Storyteller"
      Event = "InspectCrossroadsHecate01"
    }
    {
      Id = "Melinoe_4074"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan juga Kepala Sekolah kami."
      Speaker = "Melinoe"
      Event = "InspectCrossroadsHecate01"
    }
    {
      Id = "Storyteller_0346"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Hewan-hewan peliharaan setia Sang Penyihir Simpang Jalan kerap memikat satwa lain untuk mencari suaka dan ketenangan di tempat perlindungan antardimensi ini."
      Speaker = "Storyteller"
      Event = "InspectCrossroadsBeasts01"
    }
    {
      Id = "Melinoe_4076"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Banyak yang bisa kita pelajari dari satwa."
      Speaker = "Melinoe"
      Event = "InspectCrossroadsBeasts01"
    }
    {
      Id = "Storyteller_0129"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Usai Chronos yang penuh muslihat merebut Griya Hades, Roh-roh orang mati yang bersemayam di sana tercerai-berai hingga ke ujung bumi."
      Speaker = "Storyteller"
      Event = "InspectBroker01"
    }
    {
      Id = "Melinoe_1679"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalian para Roh aman dan disambut hangat di sini."
      Speaker = "Melinoe"
      Event = "InspectBroker01"
    }
    {
      Id = "Storyteller_0238"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Banyak hal yang dapat dipetik dari sejarah, asalkan seseorang mau menelaah hikmah di balik catatan-catatannya; suatu pencarian seumur hidup tersendiri."
      Speaker = "Storyteller"
      Event = "InspectLearnedSage01"
    }
    {
      Id = "Melinoe_2961"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tetap saja masa depan tak pernah bisa ditebak..."
      Speaker = "Melinoe"
      Event = "InspectLearnedSage01"
    }
    {
      Id = "Storyteller_0239"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Dahulu kala ada bilik administrasi di Dunia Bawah, tempat para Roh mencatat tiap detail dengan saksama; pekerjaan yang masih digeluti oleh segelintir jiwa."
      Speaker = "Storyteller"
      Event = "InspectRecordKeeper01"
    }
    {
      Id = "Melinoe_2962"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pastinya jerih payah semacam itu diganjar setimpal."
      Speaker = "Melinoe"
      Event = "InspectRecordKeeper01"
    }
    {
      Id = "Storyteller_0301"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Karunia musik, yang dianugerahkan kepada manusia fana oleh Apollo yang cemerlang, memiliki daya untuk menggugah jiwa tiada tara; tak peduli jiwa itu milik yang hidup atau yang mati."
      Speaker = "Storyteller"
      Event = "InspectMusicMaker01"
    }
    {
      Id = "Melinoe_3750"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau begitu, mari kita gugah jiwa-jiwa itu!"
      Speaker = "Melinoe"
      Event = "InspectMusicMaker01"
    }
    {
      Id = "Storyteller_0342"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Sang Rembulan kerap bersinar begitu terang di satu sudut indah Simpang Jalan, tempat sang Putri Dunia Bawah selalu bisa menjernihkan pikiran dan menikmati secuil kedamaian."
      Speaker = "Storyteller"
      Event = "InspectCrossroadsClearing01"
    }
    {
      Id = "Melinoe_4072"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Dan mendengarkan suara katak."
      Speaker = "Melinoe"
      Event = "InspectCrossroadsClearing01"
    }
    {
      Id = "Storyteller_0343"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Suara merdu sang dewi perburuan memenuhi seisi pelataran bagaikan berkas cahaya rembulan, menggetarkan jiwa-jiwa abadi para Roh yang bersemayam di sana."
      Speaker = "Storyteller"
      Event = "InspectCrossroadsArtemis01"
    }
    {
      Id = "Melinoe_4073"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Bagus juga suaranya, kan?"
      Speaker = "Melinoe"
      Event = "InspectCrossroadsArtemis01"
    }
    {
      Id = "Storyteller_0130"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Harapan atau suka cita begitu fana di Simpang Jalan, namun secuil rasa yang merekah kerap berpusat di kedai kecil itu."
      Speaker = "Storyteller"
      Event = "InspectTaverna01"
    }
    {
      Id = "Melinoe_1680"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Tak ada waktu bersantai..."
      Speaker = "Melinoe"
      Event = "InspectTaverna01"
    }
    {
      Id = "Storyteller_0241"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Air mata ratapan mengalir melintasi Sungai Kokitos, namun bahkan di perairan tanpa asa itu, makhluk-makhluk tertentu belajar bertahan hidup dan bertumbuh."
      Speaker = "Storyteller"
      Event = "InspectCrossroadsFishingPoint01"
    }
    {
      Id = "Melinoe_2964"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Aku {#Emph}memang {#Prev}merasakan beberapa dari mereka ingin keluar..."
      Speaker = "Melinoe"
      Event = "InspectCrossroadsFishingPoint01"
    }
    {
      Id = "Storyteller_0240"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Mata air kecil menarik hawa hangatnya dari relung bumi, airnya yang begitu murni dan bening mampu membasuh raga dan jiwa."
      Speaker = "Storyteller"
      Event = "InspectCrossroadsBathHouse01"
    }
    {
      Id = "Melinoe_2963"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Kalau aku berendam di sana, aku mungkin takkan mau beranjak..."
      Speaker = "Melinoe"
      Event = "InspectCrossroadsBathHouse01"
    }
    {
      Id = "Storyteller_0497"
      InheritFrom = "BaseNarrative"
      DisplayName = "{#Emph}Surya dan rembulan: dua sisi yang menyatu, lambang baru persatuan antara Olimpus dan Dunia Bawah, sekaligus karunia untuk Simpang Jalan dari para dewa sendiri."
      Speaker = "Storyteller"
      Event = "InspectSunMoonTimeSculpture01"
    }
    {
      Id = "Melinoe_5168"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Pasti Yang Mulia Hefaistos sendiri yang menempanya."
      Speaker = "Melinoe"
      Event = "InspectSunMoonTimeSculpture01"
    }
    {
      Id = "Melinoe_1710"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Semoga rembulan menuntunmu, Makelar."
      Speaker = "Melinoe"
      Event = "ObstacleData[558096].InteractVoiceLines"
    }
    {
      Id = "Melinoe_3009"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Penjaga Catatan."
      Speaker = "Melinoe"
      Event = "ObstacleData[589467].InteractVoiceLines"
    }
    {
      Id = "Melinoe_3010"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, Penjaga."
      Speaker = "Melinoe"
      Event = "ObstacleData[589467].InteractVoiceLines"
    }
    {
      Id = "Melinoe_3011"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam jumpa, Penjaga Catatan."
      Speaker = "Melinoe"
      Event = "ObstacleData[589467].InteractVoiceLines"
    }
    {
      Id = "Melinoe_3006"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam jumpa, Sang Bijak."
      Speaker = "Melinoe"
      Event = "ObstacleData[589466].InteractVoiceLines"
    }
    {
      Id = "Melinoe_3007"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam, Sang Cendekiawan bijak."
      Speaker = "Melinoe"
      Event = "ObstacleData[589466].InteractVoiceLines"
    }
    {
      Id = "Melinoe_3008"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Selamat malam, Sang Bijak."
      Speaker = "Melinoe"
      Event = "ObstacleData[589466].InteractVoiceLines"
    }
    {
      Id = "Melinoe_3845"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Apollo pasti bangga!"
      Speaker = "Melinoe"
      Event = "ObstacleData[738510].InteractVoiceLines"
    }
    {
      Id = "Melinoe_3846"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Salam hormat, Pemusik."
      Speaker = "Melinoe"
      Event = "ObstacleData[738510].InteractVoiceLines"
    }
    {
      Id = "Melinoe_3677"
      InheritFrom = "BaseSubtitle"
      DisplayName = "Mainkan terus, Pemusik."
      Speaker = "Melinoe"
